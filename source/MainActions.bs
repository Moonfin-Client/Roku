import "pkg:/components/manager/ViewCreator.bs"
import "pkg:/source/api/Items.bs"
import "pkg:/source/api/trailerSearch.bs"
import "pkg:/source/enums/CollectionType.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/ResumePopupAction.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/utils/detailCompatibility.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"

namespace MainAction
    sub onPlayButtonClicked(activeScene as object)
        if not isValid(activeScene) or not isValid(activeScene.itemContent) then return

        ' An album, an artist or a playlist has nothing of its own to stream, so its page plays
        ' what it lists instead
        musicType = LCase(chainLookupReturn(activeScene, "itemContent.json.Type", ""))
        if musicType = "musicalbum" and activeScene.hasField("playAlbumSelected")
            activeScene.playAlbumSelected = not activeScene.playAlbumSelected
            return
        else if musicType = "musicartist" and activeScene.hasField("playArtistSelected")
            activeScene.playArtistSelected = not activeScene.playArtistSelected
            return
        else if musicType = "playlist" and activeScene.hasField("playAll")
            activeScene.playAll = not activeScene.playAll
            return
        end if

        startLoadingSpinner()
        selectPlaybackSource(activeScene.itemContent, chainLookup(activeScene, "selectedVideoStreamId"))

        ' Check if a specific Audio Stream was selected
        activeScene.itemContent.selectedAudioStreamIndex = chainLookup(activeScene, "selectedAudioStreamIndex") ?? 0

        playbackPositionTicks = chainLookup(activeScene, "itemContent.json.userdata.PlaybackPositionTicks") ?? 0

        ' Display playback options dialog
        if playbackPositionTicks > 0
            m.global.queueManager.callFunc("hold", activeScene.itemContent)
            playbackOptionDialog(playbackPositionTicks, activeScene.itemContent.json)
        else
            playItem(activeScene.itemContent, { method: "push", bypassNextPreferredAudioTrackIndexReset: true })
        end if

        if isChainValid(activeScene, "lastFocus.id") and isStringEqual(activeScene.lastFocus.id, "main_group")
            buttons = activeScene.findNode("buttons")
            if isValid(buttons)
                activeScene.lastFocus = activeScene.findNode("buttons")
            end if
        end if

        if isChainValid(activeScene, "lastFocus")
            activeScene.lastFocus.setFocus(true)
        end if
    end sub

    sub onPlayFromBeginningClicked(activeScene as object)
        ' Play from beginning - reset position to 0 and play
        startLoadingSpinner()
        selectPlaybackSource(activeScene.itemContent, chainLookup(activeScene, "selectedVideoStreamId"))

        ' Check if a specific Audio Stream was selected
        activeScene.itemContent.selectedAudioStreamIndex = chainLookup(activeScene, "selectedAudioStreamIndex") ?? 0

        ' Reset playback position to 0
        if isChainValid(activeScene, "itemContent.json.userdata")
            activeScene.itemContent.json.userdata.PlaybackPositionTicks = 0
        end if

        ' Play the item from beginning
        playItem(activeScene.itemContent, { method: "push", bypassNextPreferredAudioTrackIndexReset: true })

        if isChainValid(activeScene, "lastFocus.id") and isStringEqual(activeScene.lastFocus.id, "main_group")
            buttons = activeScene.findNode("buttons")
            if isValid(buttons)
                activeScene.lastFocus = activeScene.findNode("buttons")
            end if
        end if

        if isChainValid(activeScene, "lastFocus")
            activeScene.lastFocus.setFocus(true)
        end if
    end sub

    sub onGoToSeriesClicked(activeScene as object)
        ' Navigate to the parent series from an episode
        if not isChainValid(activeScene, "itemContent.json.SeriesId") then return

        seriesId = activeScene.itemContent.json.SeriesId
        if not isValidAndNotEmpty(seriesId) then return

        itemServerInfo = getServerInfoFromItem(activeScene.itemContent)
        seriesServerData = invalid
        if isValid(itemServerInfo) and isValidAndNotEmpty(itemServerInfo.serverUrl) and isValidAndNotEmpty(itemServerInfo.authToken)
            seriesServerData = {
                serverUrl: itemServerInfo.serverUrl,
                userId: itemServerInfo.userId,
                authToken: itemServerInfo.authToken
            }
        end if

        CreateSeriesDetailsGroup(seriesId, seriesServerData)
    end sub

    sub onPartButtonClicked(activeScene as object)
        if not isValidAndNotEmpty(chainLookup(activeScene, "additionalParts.parts.Items")) then return
        partData = {
            data: [{
                id: chainLookup(activeScene, "additionalParts.masterID"),
                type: "partselect",
                Track: {
                    description: "Part 1"
                }
            }]
        }

        selectedPart = chainLookup(activeScene, "selectedPart.id") ?? string.EMPTY

        i = 2
        for each part in chainLookup(activeScene, "additionalParts.parts.Items")
            part.type = "partselect"
            part.Track = {}
            part.Track.description = `Part ${i}`

            if selectedPart <> string.EMPTY
                if isStringEqual(part.id, selectedPart)
                    part.selected = true
                end if
            end if

            partData.data.push(part)

            i++
        end for

        m.global.sceneManager.callFunc("radioDialog", tr("Select Part"), partData)
        m.global.sceneManager.observeField("returnData", m.port)
    end sub

    sub onTrailerButtonClicked(activeScene as object)
        ' Read before the spinner, whose hidden dialog holds focus while it runs
        returnFocus = activeScene.focusedChild
        while isValid(returnFocus) and not returnFocus.hasFocus()
            returnFocus = returnFocus.focusedChild
        end while
        if not isValid(returnFocus) then returnFocus = activeScene

        startLoadingSpinner()

        itemContent = chainLookup(activeScene, "itemContent")
        trailerItemId = chainLookupReturn(activeScene, "additionalParts.masterID", "")
        if not isValidAndNotEmpty(trailerItemId)
            trailerItemId = chainLookupReturn(itemContent, "id", "")
        end if
        if not isValidAndNotEmpty(trailerItemId)
            stopLoadingSpinner()
            return
        end if

        trailerServerData = invalid
        trailerUserId = currentSessionUserId()
        itemServerInfo = getServerInfoFromItem(itemContent)
        if isValid(itemServerInfo) and isValidAndNotEmpty(itemServerInfo.serverUrl) and isValidAndNotEmpty(itemServerInfo.userId) and isValidAndNotEmpty(itemServerInfo.authToken)
            trailerServerData = {
                serverUrl: itemServerInfo.serverUrl,
                userId: itemServerInfo.userId,
                authToken: itemServerInfo.authToken
            }
            trailerUserId = itemServerInfo.userId
        end if

        ' Look up local trailers on the same server as the detail item.
        trailerParams = {}
        if isValidAndNotEmpty(trailerUserId) then trailerParams.UserId = trailerUserId
        trailerData = api.items.GetLocalTrailers(trailerItemId, trailerParams, trailerServerData)

        ' A remote trailer must carry its server context into the queue as well,
        ' otherwise playback falls back to the active session after lookup succeeds.
        if isValid(trailerServerData) and type(trailerData) = "roArray"
            for each trailer in trailerData
                if type(trailer) = "roAssociativeArray"
                    trailer["_serverUrl"] = trailerServerData.serverUrl
                    trailer["_userId"] = trailerServerData.userId
                    trailer["_authToken"] = trailerServerData.authToken
                end if
            end for
        end if

        choices = []
        if type(trailerData) = "roArray"
            for each trailer in trailerData
                if type(trailer) = "roAssociativeArray" and isValidAndNotEmpty(trailer.LookupCI("Id")) then choices.push(MainAction.localTrailerChoice(trailer, itemContent, trailerServerData))
            end for
        end if
        remoteTrailers = chainLookupReturn(activeScene, "itemContent.json.RemoteTrailers", [])
        if choices.count() = 0 and not isValidAndNotEmpty(remoteTrailers) and trailerSearch.Offers(chainLookupReturn(activeScene, "itemContent.json", invalid)) then remoteTrailers = trailerSearch.Find(activeScene.itemContent.json)
        choices.Append(youtubeTrailer.RemoteChoices(remoteTrailers))
        stopLoadingSpinner()

        if choices.count() = 1
            MainAction.playTrailerChoice(choices[0], activeScene)
        else if choices.count() > 1
            MainAction.openTrailerPicker(activeScene, choices, returnFocus)
        else
            ' Any link left over is a web page this device cant open
            webLink = false
            for each trailer in remoteTrailers
                if toString(chainLookupReturn(trailer, "Url", "")) <> ""
                    webLink = true
                    exit for
                end if
            end for

            if webLink
                dialog = CreateObject("roSGNode", "StandardMessageDialog")
                dialog.id = "OKDialog"
                dialog.title = tr("Trailer Not Available")
                dialog.message = [tr("This trailer is a link to a web page, which cant be opened here.")]
                dialog.buttons = [tr("OK")]
                m.scene.dialog = dialog
                m.scene.dialog.observeField("buttonSelected", m.port)
            else if isChainValid(activeScene, "lastFocus")
                activeScene.lastFocus.setFocus(true)
            end if
        end if
    end sub

    function localTrailerChoice(trailer as object, itemContent as object, serverData as dynamic) as object
        shown = youtubeTrailer.ShownTitle(toString(trailer.LookupCI("Name") ?? ""))
        thumb = toString(chainLookupReturn(itemContent, "backdropURL", ""))
        primaryTag = toString(chainLookupReturn(trailer, "ImageTags.Primary", ""))
        if primaryTag <> "" then thumb = getImageURL(trailer.LookupCI("Id"), "Primary", { maxWidth: 408, maxHeight: 228, Tag: primaryTag }, serverData)
        ticks = chainLookupReturn(trailer, "RunTimeTicks", 0)
        return { item: trailer, videoId: "", title: shown.text, subtitled: shown.subtitled, thumb: thumb, seconds: Int(ticks / 10000000), meta: "" }
    end function

    sub playTrailerChoice(choice as object, activeScene as object)
        if isValid(choice.item)
            playItem([choice.item], { method: "set", bypassNextPreferredAudioTrackIndexReset: true })
            if isChainValid(activeScene, "lastFocus")
                activeScene.lastFocus.setFocus(true)
            end if
            return
        end if

        if inArray([MediaPlaybackState.PLAYING, MediaPlaybackState.PAUSED, MediaPlaybackState.BUFFERING], m.global.audioPlayer.state)
            m.global.audioPlayer.control = VideoControl.STOP
            m.global.audioPlayer.content = invalid
        end if
        overlay = CreateObject("roSGNode", "TrailerOverlay")
        overlay.videoId = choice.videoId
        m.global.sceneManager.callFunc("pushScene", overlay)
    end sub

    sub openTrailerPicker(activeScene as object, choices as object, returnFocus as object)
        picker = CreateObject("roSGNode", "TrailerPicker")
        picker.itemName = toString(chainLookupReturn(activeScene, "itemContent.json.Name", ""))
        picker.trailers = choices
        picker.returnFocus = returnFocus
        picker.observeField("trailerChosen", m.port)
        m.scene.appendChild(picker)
        picker.callFunc("showPicker")
    end sub

    ' The picker has already given focus back, so it can leave the scene before the trailer starts
    sub onTrailerChosen(msg as object)
        picker = msg.getRoSGNode()
        index = msg.getData()
        trailers = picker.trailers
        picker.unobserveField("trailerChosen")
        m.scene.removeChild(picker)
        if index >= 0 and index < trailers.count() then MainAction.playTrailerChoice(trailers[index], m.global.sceneManager.callFunc("getActiveScene"))
    end sub

    sub onWatchedButtonClicked(activeScene as object)
        movie = chainLookup(activeScene, "itemContent")
        if not isChainValid(movie, "watched") or not isValid(movie.id) then return

        if movie.watched
            setPlayed(movie.id, false)
        else
            setPlayed(movie.id, true)
            movieData = movie.json
            movieData.UserData.PlaybackPositionTicks = 0
            movie.json = movieData
        end if
        movie.watched = not movie.watched
    end sub

    sub onMyListButtonClicked(activeScene as object)
        movie = chainLookup(activeScene, "itemContent")
        if not isValid(movie.id) then return

        if activeScene.isInMyList
            MainAction.removeItemFromMyList(movie.id)
        else
            MainAction.addItemToMyList(movie.id)
        end if

        activeScene.isInMyList = not activeScene.isInMyList
    end sub

    sub onPlaylistButtonClicked(activeScene as object)
        startLoadingSpinner()

        movie = chainLookup(activeScene, "itemContent")
        if not isValid(movie.id) then return

        m.LoadPlaylistsTask = createObject("roSGNode", "LoadItemsTask")
        m.LoadPlaylistsTask.itemId = movie.id
        m.LoadPlaylistsTask.itemsToLoad = "playlists"
        m.LoadPlaylistsTask.observeFieldScoped("content", m.port)
        m.LoadPlaylistsTask.control = TaskControl.RUN
    end sub

    sub onFavoriteButtonClicked(activeScene as object)
        movie = chainLookup(activeScene, "itemContent")
        if not isChainValid(movie, "favorite") or not isValid(movie.id) then return

        ' Use task to avoid blocking the UI
        favoriteTask = createObject("roSGNode", "FavoriteItemsTask")
        favoriteTask.itemId = movie.id
        if movie.favorite
            favoriteTask.favTask = "unfavorite"
        else
            favoriteTask.favTask = "favorite"
        end if
        favoriteTask.control = "RUN"

        ' Update local state immediately for UI responsiveness
        movie.favorite = not movie.favorite
    end sub

    sub onGoToSeriesButtonClicked(activeScene as object)
        CreateSeriesDetailsGroup(activeScene.itemContent.showID)
    end sub

    sub onGoToSeasonButtonClicked(activeScene as object)
        CreateSeasonDetailsGroupByID(activeScene.itemContent.LookupCI("showID"), activeScene.itemContent.LookupCI("seasonID"))
    end sub

    sub playItem(item as dynamic, params = {} as object)
        if not isValid(item)
            return
        end if

        startLoadingSpinner()

        playItemParams = {
            method: "push",
            bypassNextPreferredAudioTrackIndexReset: false,
            resetShuffle: false,
            position: -1
        }

        playItemParams.append(params)

        if playItemParams.bypassNextPreferredAudioTrackIndexReset
            m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
        end if

        if playItemParams.resetShuffle
            m.global.queueManager.callFunc("resetShuffle")
        end if

        m.global.queueManager.callFunc("clear")
        m.global.queueManager.callFunc(playItemParams.method, item)

        if playItemParams.position <> -1
            m.global.queueManager.callFunc("setPosition", playItemParams.position)
        end if

        m.global.queueManager.callFunc("playQueue")
    end sub

    ' Check if this is a, "OK" Dialog and close if so
    sub closeOKDialog(msg)
        dialog = msg.getRoSGNode()
        if isStringEqual(dialog.id, "OKDialog")
            dialog.unobserveField("buttonSelected")
            dialog.close = true
        end if
    end sub

    sub setPlayed(itemID as string, isPlayed as boolean)
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group)
            if isStringEqual(group.subtype(), "VisualLibraryScene")
                ' Don't reset selectedItem - this prevents re-selecting the same item
                ' group.selectedItem = invalid
                group.quickPlayNode = invalid
                itemFocused = group.callFunc("getItemFocused")
                itemFocused.callFunc("setWatched", isPlayed)
            end if
        end if

        if isPlayed
            date = CreateObject("roDateTime")
            dateStr = date.ToISOString()
            api.users.MarkPlayed(itemID, { "DatePlayed": dateStr, "PlaybackPositionTicks": 0, userId: m.global.session.user.id })
            return
        end if

        api.users.UnmarkPlayed(itemID, { userId: m.global.session.user.id })
    end sub

    sub addItemToFavorites(itemID as string)
        ' Use task to avoid blocking the UI
        favoriteTask = createObject("roSGNode", "FavoriteItemsTask")
        favoriteTask.itemId = itemID
        favoriteTask.favTask = "favorite"
        favoriteTask.control = "RUN"

        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group)
            if isStringEqual(group.subtype(), "home")
                group.callFunc("refresh")
                return
            end if
            if isStringEqual(group.subtype(), "VisualLibraryScene")
                itemFocused = group.callFunc("getItemFocused")
                if isValid(itemFocused)
                    itemFocused.favorite = true
                end if
            end if
        end if
    end sub

    sub removeItemFromFavorites(itemID as string)
        ' Use task to avoid blocking the UI
        favoriteTask = createObject("roSGNode", "FavoriteItemsTask")
        favoriteTask.itemId = itemID
        favoriteTask.favTask = "unfavorite"
        favoriteTask.control = "RUN"

        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group)
            if isStringEqual(group.subtype(), "home")
                group.callFunc("refresh")
                return
            end if
            if isStringEqual(group.subtype(), "VisualLibraryScene")
                itemFocused = group.callFunc("getItemFocused")
                if isValid(itemFocused)
                    itemFocused.favorite = false
                end if
            end if
        end if
    end sub

    sub addItemToMyList(itemID as string)
        data = api.GetUserViews({ "userId": m.global.session.user.id })
        if not isChainValid(data, "items") then return

        myListPlaylist = invalid

        for each item in data.LookupCI("items")
            if isStringEqual(item.LookupCI("CollectionType"), "playlists")
                myListPlaylist = api.items.Get({
                    "userid": m.global.session.user.id,
                    "includeItemTypes": "Playlist",
                    "nameStartsWith": "|My List|",
                    "parentId": item.LookupCI("id")
                })
                exit for
            end if
        end for

        ' My list playlist exists. Add item to it
        if isValid(myListPlaylist) and isValidAndNotEmpty(myListPlaylist.items)
            api.playlists.Add(myListPlaylist.items[0].LookupCI("id"), {
                ids: itemID,
                userid: m.global.session.user.id
            })

            group = m.global.sceneManager.callFunc("getActiveScene")
            if isValid(group)
                if isStringEqual(group.subtype(), "home")
                    group.callFunc("refresh")
                end if
            end if

            return
        end if

        ' My list playlist does not exist. Create it with this item
        api.playlists.Create({
            name: "|My List|",
            ids: [itemID],
            userid: m.global.session.user.id,
            mediatype: "Unknown",
            users: [
                {
                    userid: m.global.session.user.id,
                    canedit: true
                }
            ],
            ispublic: false
        })

        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group)
            if isStringEqual(group.subtype(), "home")
                group.callFunc("refresh")
            end if
        end if
    end sub

    ' Remove item from user's My List playlist
    sub removeItemFromMyList(itemID as string)

        data = api.GetUserViews({ "userId": m.global.session.user.id })
        if not isChainValid(data, "items") then return

        myListPlaylist = invalid

        for each item in data.LookupCI("items")
            if isStringEqual(item.LookupCI("CollectionType"), "playlists")
                myListPlaylist = api.items.Get({
                    "userid": m.global.session.user.id,
                    "includeItemTypes": "Playlist",
                    "nameStartsWith": "|My List|",
                    "parentId": item.LookupCI("id")
                })
                exit for
            end if
        end for

        ' My list playlist exists. Remove item from it
        if isValid(myListPlaylist) and isValidAndNotEmpty(myListPlaylist.items)
            playlistID = myListPlaylist.items[0].LookupCI("id")
            MainAction.removeItemFromPlaylist(playlistID, MainAction.playlistEntryId(playlistID, itemID))

            group = m.global.sceneManager.callFunc("getActiveScene")
            if isValid(group)
                if isStringEqual(group.subtype(), "home")
                    group.callFunc("refresh")
                end if
            end if
        end if
    end sub

    ' A playlist names each row by its own entry id, which on Emby isnt the item's id. Answers
    ' whether the server took the row out
    function removeItemFromPlaylist(playlistID as string, entryID as string) as boolean
        if not isValidAndNotEmpty(playlistID) or not isValidAndNotEmpty(entryID) then return false

        req = APIRequest(`/Playlists/${playlistID}/Items`, { EntryIds: entryID })
        if not isValid(req) then return false
        status = requestResponse(req, "DELETE").status
        return status >= 200 and status < 300
    end function

    ' The entry id of a title's row in a playlist, or empty when the title isnt in it
    function playlistEntryId(playlistID as string, itemID as string) as string
        data = api.playlists.GetItems(playlistID, { UserId: m.global.session.user.id })
        for each item in chainLookupReturn(data, "Items", [])
            if guidKey(item.LookupCI("Id")) = guidKey(itemID) then return (item.LookupCI("PlaylistItemId") ?? "").ToStr()
        end for
        return ""
    end function
end namespace

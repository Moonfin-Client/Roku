' Timing lines for the Home load, printed on the debug console (port 8085) as "[home <ms>] message".
' <ms> is milliseconds since the app started, the same clock on every thread, so lines from the
' row tasks and the render thread can be read in order. Off unless the manifest's homeLoadLog is true.
namespace homeLoadLog
    sub Log(message as string)
        #if homeLoadLog
            print "[home " + Int(UpTime(0) * 1000).ToStr() + "] " + message
        #end if
    end sub
end namespace

' What the Plex sign in shows, kept apart from the plex.tv requests so the screen stays light

namespace plexLink

    ' plex.tv/link fills in the code from the pin parameter
    function LinkUrl(code as string) as string
        return "https://plex.tv/link/?pin=" + code.EncodeUriComponent()
    end function

    ' The words for a plex.tv or server failure
    function ErrorMessage(status as integer) as string
        if status = 401 or status = 403 then return tr("Invalid username or password.")
        if status >= 500 then return tr("Server error. Please try again later.")
        if status = 0 or status = -28 then return tr("Connection timed out. Check the address and your network.")
        if status < 0 then return tr("Couldn't reach server. Check the address and that the server is running.")
        return tr("Failed to connect. Check the address and try again.")
    end function

end namespace

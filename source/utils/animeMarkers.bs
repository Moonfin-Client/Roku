import "pkg:/source/utils/misc.bs"

' Filler, canon, recap and subbed or dubbed markers for anime, which the Moonfin plugin
' works out on the server. Everything here is pure, so the store, its task and the pills
' can all share it.
namespace animeMarkers

    ' What the store needs to find one item's marker, or invalid when the item cant have one.
    ' An episode is read off its series table and a movie is asked about on its own.
    function LookupFor(json as dynamic) as dynamic
        if type(json) <> "roAssociativeArray" then return invalid

        itemType = LCase(json.LookupCI("Type") ?? "")
        itemId = json.LookupCI("Id") ?? ""
        seriesId = json.LookupCI("SeriesId") ?? ""

        if itemType = "episode"
            if not isValidAndNotEmpty(seriesId) then return invalid
        else if itemType <> "movie"
            return invalid
        end if

        if not isValidAndNotEmpty(itemId) then return invalid

        return {
            itemId: itemId,
            itemType: itemType,
            seriesId: seriesId,
            serverUrl: json.LookupCI("_serverUrl") ?? "",
            userId: json.LookupCI("_userId") ?? "",
            authToken: json.LookupCI("_authToken") ?? ""
        }
    end function

    ' The pills for one marker, in order: what kind of episode it is, then Recap, then the audio
    function PillsFor(marker as dynamic) as object
        entries = []
        if not animeMarkers.HasPills(marker) then return entries

        kindTint = animeMarkers.KindTone(marker.kind)
        if kindTint <> "" then entries.push({ label: animeMarkers.ToneLabel(kindTint), tone: kindTint })

        if (marker.recap ?? false) = true then entries.push({ label: animeMarkers.ToneLabel("recap"), tone: "recap" })

        audioTint = animeMarkers.AudioTone(marker.audio)
        if audioTint <> "" then entries.push({ label: animeMarkers.ToneLabel(audioTint), tone: audioTint })

        return entries
    end function

    ' Checked for every episode of a long series, so it never builds the labels
    function HasPills(marker as dynamic) as boolean
        if type(marker) <> "roAssociativeArray" then return false
        if animeMarkers.KindTone(marker.kind) <> "" then return true
        if (marker.recap ?? false) = true then return true
        return animeMarkers.AudioTone(marker.audio) <> ""
    end function

    ' The tint for each kind of episode the plugin reports, or empty for one with no pill
    function KindTone(kind as dynamic) as string
        if type(kind) <> "roString" and type(kind) <> "String" then return ""

        value = LCase(kind)
        if value = "filler" then return "filler"
        if value = "mixed" then return "mixed"
        if value = "mangacanon" then return "mangaCanon"
        if value = "animecanon" then return "animeCanon"
        return ""
    end function

    function AudioTone(audio as dynamic) as string
        if type(audio) <> "roString" and type(audio) <> "String" then return ""

        value = LCase(audio)
        if value = "subbed" then return "subbed"
        if value = "dubbed" then return "dubbed"
        if value = "subbedanddubbed" then return "dual"
        return ""
    end function

    function ToneLabel(tone as string) as string
        if tone = "filler" then return tr("Filler")
        if tone = "mixed" then return tr("Mixed Canon/Filler")
        if tone = "mangaCanon" then return tr("Manga Canon")
        if tone = "animeCanon" then return tr("Anime Canon")
        if tone = "recap" then return tr("Recap")
        if tone = "subbed" then return tr("Subbed")
        if tone = "dubbed" then return tr("Dubbed")
        return tr("Subbed/Dubbed")
    end function

    ' The label, fill and border colors of each pill
    function ToneColors(tone as string) as object
        if tone = "filler" then return { text: "#FFC48AFF", fill: "#FF8A002E", border: "#FF8A008C" }
        if tone = "mixed" then return { text: "#FFE08AFF", fill: "#FFC10729", border: "#FFC10780" }
        if tone = "mangaCanon" then return { text: "#9CE8B4FF", fill: "#2ECC7129", border: "#2ECC7180" }
        if tone = "animeCanon" then return { text: "#9ECBFFFF", fill: "#3498DB2E", border: "#3498DB8C" }
        if tone = "recap" then return { text: "#D3B4FFFF", fill: "#9B59E82E", border: "#9B59E88C" }
        if tone = "subbed" then return { text: "#A9D8FFFF", fill: "#00A4DC2E", border: "#00A4DC8C" }
        if tone = "dubbed" then return { text: "#FFB3B3FF", fill: "#E74C3C2E", border: "#E74C3C8C" }

        return { text: "#C4C9FFFF", fill: "#7878FF2E", border: "#7878FF8C" }
    end function

end namespace

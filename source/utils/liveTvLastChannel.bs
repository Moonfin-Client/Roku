import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' The channel last tuned on each server and account. The guide opens on it, and Back from a guide
' that has wandered returns to it.

const LIVE_TV_LAST_CHANNEL_SECTION = "liveTvLastChannel"

namespace liveTvLastChannel

    function scopeKey() as string
        server = LCase(chainLookupReturn(m.global.session, "server.url", "").toStr().Trim())
        server = CreateObject("roRegex", "^https?://", "i").Replace(server, "")
        server = CreateObject("roRegex", "/+$", "").Replace(server, "")
        user = chainLookupReturn(m.global.session, "user.id", "")
        if server = "" or not isValidAndNotEmpty(user) then return ""
        return server + "_" + user
    end function

    function Get() as string
        key = liveTvLastChannel.scopeKey()
        if key = "" then return ""
        stored = registry_read(key, LIVE_TV_LAST_CHANNEL_SECTION)
        if not isValidAndNotEmpty(stored) then return ""
        return stored
    end function

    sub Remember(channelId as dynamic)
        key = liveTvLastChannel.scopeKey()
        if key = "" or not isValidAndNotEmpty(channelId) then return
        if liveTvLastChannel.Get() = channelId then return
        registry_write(key, channelId, LIVE_TV_LAST_CHANNEL_SECTION)
    end sub

end namespace

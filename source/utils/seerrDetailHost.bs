import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrDetailItem.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' The Seerr side of a detail screen, shared by the classic and modern ones so both behave the
' same. These run in the host component's scope, so m is whichever screen imported them.

sub onSeerrTargetChanged()
    target = m.top.seerrTarget
    if not isValid(target) or not isValidAndNotEmpty(target.tmdbId) then return

    m.top.seerrOnly = true
    EnsureSeerrPublicSettings()

    m.seerrDetailsTask = CreateObject("roSGNode", "SeerrAPITask")
    m.seerrDetailsTask.request = {
        method: "GET",
        endpoint: `/api/v1/${target.mediaType}/${target.tmdbId}`
    }
    m.seerrDetailsTask.observeField("response", "onSeerrDetailsLoaded")
    m.seerrDetailsTask.control = "RUN"
end sub

sub onSeerrDetailsLoaded(event as object)
    response = event.getData()
    if not response.success or not isValid(response.data)
        stopLoadingSpinner()
        return
    end if

    m.seerrDetails = response.data

    node = seerrDetailItem.NodeFor(response.data, m.top.seerrTarget.mediaType)
    if isValid(node) then m.top.itemContent = node
    updateSeerrSeasonMarkers()
end sub

sub startSeerrRequest(action as string)
    if not isValid(m.seerrRequests)
        m.seerrRequests = CreateObject("roSGNode", "SeerrRequestController")
        m.seerrRequests.observeField("requestCompleted", "onSeerrRequestCompleted")
        m.seerrRequests.observeField("watchlistState", "onSeerrWatchlistToggled")
        m.top.appendChild(m.seerrRequests)
    end if

    m.seerrRequests.tmdbId = seerrTmdbId()
    m.seerrRequests.mediaType = seerrMediaType()
    m.seerrRequests.details = m.seerrDetails
    m.seerrRequests.returnFocus = seerrFocusTarget()
    m.seerrRequests.callFunc("begin", action)
end sub

' The screen root takes no focus, so the flow hands it back to the button it was opened from
function seerrFocusTarget() as object
    if isValid(m.buttonGroups) and isValid(m.currentButtonIndex)
        if m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count()
            return m.buttonGroups[m.currentButtonIndex]
        end if
    end if

    return m.top
end function

function seerrTmdbId() as string
    target = m.top.seerrTarget
    if isValid(target) and isValidAndNotEmpty(target.tmdbId) then return target.tmdbId

    return chainLookupReturn(m.top.itemContent, "json.ProviderIds.Tmdb", "")
end function

' Only the one button changed, so the row is redrawn from the payload already held
sub onSeerrWatchlistToggled(event as object)
    if not isValid(m.seerrDetails) then return

    m.seerrDetails.onUserWatchlist = event.getData()
    m.seerrRequests.details = m.seerrDetails
    m.top.seerrButtonsStale = true
end sub

sub onSeerrRequestCompleted()
    if isValid(m.top.seerrTarget)
        m.top.seerrTarget = m.top.seerrTarget
        return
    end if

    loadLibrarySeerrDetails(GetSeerrTargetFor(m.top.itemContent.json))
end sub

function seerrMediaType() as string
    target = m.top.seerrTarget
    if isValid(target) and isValidAndNotEmpty(target.mediaType) then return target.mediaType
    return isStringEqual(chainLookupReturn(m.top.itemContent, "json.Type", ""), "Series") ? "tv" : "movie"
end function

sub loadSeerrBlock(itemData as object)
    EnsureSeerrPublicSettings()

    target = GetSeerrTargetFor(itemData)
    loadLibrarySeerrDetails(target)

    if not isValid(m.seerrBlock) then return

    m.seerrBlock.mediaType = target.mediaType
    m.seerrBlock.tmdbId = target.tmdbId
    m.seerrBlock.callFunc("loadTarget")
end sub

' The other clients offer the Seerr actions on library titles too, so the payload behind
' them is fetched here rather than only when a title was opened from Seerr
sub loadLibrarySeerrDetails(target as object)
    if isValid(m.top.seerrTarget) then return
    if not isValidAndNotEmpty(target.tmdbId) then return
    if not GetSeerrConfig().enabled then return

    m.librarySeerrTask = CreateObject("roSGNode", "SeerrAPITask")
    m.librarySeerrTask.request = {
        method: "GET",
        endpoint: `/api/v1/${target.mediaType}/${target.tmdbId}`
    }
    m.librarySeerrTask.observeField("response", "onLibrarySeerrDetails")
    m.librarySeerrTask.control = "RUN"
end sub

' The row is already drawn by the time this lands, so the screen is told to draw it
' again with the Seerr entries in
sub onLibrarySeerrDetails(event as object)
    response = event.getData()
    if not response.success or not isValid(response.data) then return

    m.seerrDetails = response.data
    m.top.seerrButtonsStale = true
    updateSeerrSeasonMarkers()
end sub

' Maps season numbers to Seerr availability status (matching Smart-TV and Core)
function GetSeerrSeasonMarkers(seerrDetails as object) as object
    markers = {}
    if not isValid(seerrDetails) or not isChainValid(seerrDetails, "mediaInfo.seasons") then return markers

    for each season in seerrDetails.mediaInfo.seasons
        if isValid(season.seasonNumber)
            status = chainLookupReturn(season, "status", 1)
            status4k = chainLookupReturn(season, "status4k", 1)
            effectiveStatus = status > 1 ? status : status4k
            if effectiveStatus > 1
                markers[season.seasonNumber.toStr()] = effectiveStatus
            end if
        end if
    end for

    if isChainValid(seerrDetails, "mediaInfo.requests")
        for each req in seerrDetails.mediaInfo.requests
            reqStatus = chainLookupReturn(req, "status", 1)
            mappedStatus = reqStatus = 1 ? 2 : 3
            if isValid(req.seasons)
                for each reqSeason in req.seasons
                    if isValid(reqSeason.seasonNumber)
                        key = reqSeason.seasonNumber.toStr()
                        if not markers.doesExist(key)
                            markers[key] = mappedStatus
                        end if
                    end if
                end for
            end if
        end for
    end if

    return markers
end function

' Updates the seerrStatus field on all season items across extras rows, tabs, and tab grids
sub updateSeerrSeasonMarkers()
    if not isValid(m.seerrDetails) then return

    markers = GetSeerrSeasonMarkers(m.seerrDetails)
    hasMarkers = (markers.count() > 0)
    isEnabled = isSeerrAvailabilityBadgesEnabled()

    if isValid(m.extrasGrid) and isValid(m.extrasGrid.content)
        applyMarkersToContent(m.extrasGrid.content, markers, isEnabled, hasMarkers)
    end if

    if isValid(m.sectionItems) and type(m.sectionItems) = "roArray"
        for each section in m.sectionItems
            if isValid(section) and type(section) = "roArray"
                for each item in section
                    applyMarkerToSeasonItem(item, markers, isEnabled, hasMarkers)
                end for
            end if
        end for
    end if

    if isValid(m.tabGrid) and isValid(m.tabGrid.content)
        for i = 0 to m.tabGrid.content.getChildCount() - 1
            applyMarkerToSeasonItem(m.tabGrid.content.getChild(i), markers, isEnabled, hasMarkers)
        end for
    end if
end sub

sub applyMarkersToContent(content as object, markers as object, isEnabled as boolean, hasMarkers as boolean)
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        if isValid(row)
            for j = 0 to row.getChildCount() - 1
                applyMarkerToSeasonItem(row.getChild(j), markers, isEnabled, hasMarkers)
            end for
        end if
    end for
end sub

sub applyMarkerToSeasonItem(item as object, markers as object, isEnabled as boolean, hasMarkers as boolean)
    if not isValid(item) or not isValid(item.json) then return

    itemType = chainLookupReturn(item, "json.Type", "")
    if not isStringEqual(itemType, "Season") then return

    seasonNum = chainLookupReturn(item, "json.IndexNumber", -1)
    status = 0
    if isEnabled and hasMarkers and seasonNum >= 0 and markers.doesExist(seasonNum.toStr())
        status = markers[seasonNum.toStr()]
    end if

    if item.hasField("seerrStatus")
        item.seerrStatus = status
    else
        item.addField("seerrStatus", "integer", false)
        item.seerrStatus = status
    end if
end sub

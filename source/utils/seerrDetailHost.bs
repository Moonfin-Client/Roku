import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/seerrDetailItem.bs"

' The Seerr side of a detail screen, shared by the classic and modern ones so both behave the
' same. These run in the host component's scope, so m is whichever screen imported them.

sub onSeerrTargetChanged()
    target = m.top.seerrTarget
    if not isValid(target) or not isValidAndNotEmpty(target.tmdbId) then return

    m.top.seerrOnly = true

    m.seerrDetailsTask = CreateObject("roSGNode", "SeerrAPITask")
    m.seerrDetailsTask.request = {
        method: "GET",
        endpoint: `/api/v1/${target.mediaType}/${target.tmdbId}`
    }
    m.seerrDetailsTask.observeField("response", "onSeerrDetailsLoaded")
    m.seerrDetailsTask.control = "RUN"
end sub

sub onSeerrDetailsLoaded(event as object)
    response = event.getData()
    if not response.success or not isValid(response.data)
        stopLoadingSpinner()
        return
    end if

    m.seerrDetails = response.data

    node = seerrDetailItem.NodeFor(response.data, m.top.seerrTarget.mediaType)
    if isValid(node) then m.top.itemContent = node
end sub

sub startSeerrRequest(action as string)
    if not isValid(m.seerrRequests)
        m.seerrRequests = CreateObject("roSGNode", "SeerrRequestController")
        m.seerrRequests.observeField("requestCompleted", "onSeerrRequestCompleted")
        m.top.appendChild(m.seerrRequests)
    end if

    m.seerrRequests.tmdbId = seerrTmdbId()
    m.seerrRequests.mediaType = seerrMediaType()
    m.seerrRequests.details = m.seerrDetails
    m.seerrRequests.returnFocus = m.top
    m.seerrRequests.callFunc("begin", action)
end sub

function seerrTmdbId() as string
    target = m.top.seerrTarget
    if isValid(target) and isValidAndNotEmpty(target.tmdbId) then return target.tmdbId

    return chainLookupReturn(m.top.itemContent, "json.ProviderIds.Tmdb", "")
end function

sub onSeerrRequestCompleted()
    if not isValid(m.top.seerrTarget) then return
    m.top.seerrTarget = m.top.seerrTarget
end sub

function seerrMediaType() as string
    target = m.top.seerrTarget
    if isValid(target) and isValidAndNotEmpty(target.mediaType) then return target.mediaType
    return isStringEqual(chainLookupReturn(m.top.itemContent, "json.Type", ""), "Series") ? "tv" : "movie"
end function

sub loadSeerrBlock(itemData as object)
    if not isValid(m.seerrBlock) then return

    target = GetSeerrTargetFor(itemData)
    m.seerrBlock.mediaType = target.mediaType
    m.seerrBlock.tmdbId = target.tmdbId
    m.seerrBlock.callFunc("loadTarget")
end sub

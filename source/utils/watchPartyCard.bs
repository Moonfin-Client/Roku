import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/watchPartyModel.bs"

' A room as its card shows it on Home and in the room list, { title, art }
function wpRoomCard(summary as object) as object
    card = { title: watchPartyModel.ContentTitle(summary), art: "" }
    if card.title = "" then card.title = tr("Picking something to watch")
    contentId = toString(summary.selected_content_id ?? "")
    if contentId = "" then return card
    imageType = "Backdrop"
    if summary.content_type = "Episode" then imageType = "Primary"
    card.art = ImageURL(contentId, imageType, { "maxWidth": 640, "maxHeight": 360 })
    return card
end function

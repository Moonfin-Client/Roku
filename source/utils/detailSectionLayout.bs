import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/misc.bs"

const DETAIL_SECTIONS_HIDDEN_SETTING = "ui.itemdetail.hiddenSections"

' The parts of the Details screen a viewer can switch off, shared with the other clients through
' the plugin as hiddenDetailSectionsTv. Ids are what gets stored, so renaming one brings back
' whatever the viewer had hidden with it. There is no order, since each style lays its sections
' out itself.
namespace detailSectionLayout

    ' Where a section sits on the settings screen. The Seerr group takes the Seerr display name.
    function Groups() as object
        return [
            { id: "header", label: "Header" },
            { id: "sections", label: "Sections" },
            { id: "seerr", label: "" },
            { id: "person", label: "Person pages" }
        ]
    end function

    ' Each style draws only some of these, in its own way, and one switch covers every one of
    ' them. `styles` lists the styles that draw the section themselves.
    function Sections() as object
        classic = "classic"
        modern = "modern"
        spotlight = "spotlight"
        nouveau = "nouveau"
        minimalist = "minimalist"
        allButMinimalist = [classic, modern, spotlight, nouveau]
        return [
            { id: "logo", label: "Logo", subtitle: "Shows the title as text when off", group: "header", styles: [classic, modern, spotlight, nouveau, minimalist] },
            { id: "tagline", label: "Tagline", group: "header", styles: [classic, modern, spotlight] },
            { id: "poster", label: "Poster", group: "header", styles: [classic] },
            { id: "versionBadge", label: "Version badge", group: "header", styles: [spotlight] },
            { id: "upNext", label: "Next Up", group: "header", styles: [classic, modern] },
            { id: "cast", label: "Cast", subtitle: "Also on collection pages", group: "sections", styles: allButMinimalist },
            { id: "crew", label: "Directors & writers", group: "sections", styles: allButMinimalist },
            { id: "studios", label: "Studios", group: "sections", styles: allButMinimalist },
            { id: "chapters", label: "Chapters", group: "sections", styles: [modern, spotlight, nouveau] },
            { id: "extras", label: "Extras", group: "sections", styles: allButMinimalist },
            { id: "collections", label: "Collections", group: "sections", styles: [classic, modern, spotlight] },
            { id: "moreLikeThis", label: "More Like This", subtitle: "Also similar albums and artists", group: "sections", styles: allButMinimalist },
            { id: "moreEpisodes", label: "More episodes", subtitle: "On episode pages", group: "sections", styles: [classic, modern, spotlight] },
            { id: "mediaInfo", label: "Media info", subtitle: "File, streams and Direct Play check", group: "sections", styles: [modern, spotlight, nouveau] },
            { id: "seerrGenresTags", label: "Genres & tags", group: "seerr", styles: allButMinimalist },
            { id: "seerrStats", label: "Stats", group: "seerr", styles: allButMinimalist },
            { id: "seerrRecommendations", label: "Recommendations", group: "seerr", styles: allButMinimalist },
            { id: "seerrSimilar", label: "Similar titles", group: "seerr", styles: allButMinimalist },
            { id: "seerrCollection", label: "Collection banner", group: "seerr", styles: [classic, modern, nouveau] },
            { id: "seerrPersonAppearances", label: "Appearances", subtitle: "On person pages", group: "seerr", styles: allButMinimalist },
            { id: "seerrPersonCrew", label: "Crew credits", subtitle: "On person pages", group: "seerr", styles: allButMinimalist },
            { id: "biography", label: "Biography", group: "person", styles: allButMinimalist },
            { id: "birthplace", label: "Birthplace", group: "person", styles: allButMinimalist },
            { id: "guestAppearances", label: "Guest appearances", group: "person", styles: allButMinimalist },
            { id: "musicVideos", label: "Music videos", group: "person", styles: allButMinimalist }
        ]
    end function

    ' Minimalist only draws video pages and hands every other page to Spotlight, so it also shows
    ' whatever Spotlight does
    function IsAvailableIn(section as object, style as string) as boolean
        return inArray(section.styles, style) or (style = "minimalist" and inArray(section.styles, "spotlight"))
    end function

    ' The sections the settings screen lists for a style. The Seerr ones only make sense once the
    ' server offers Seerr at all
    function Offered(style as string, seerrAvailable as boolean) as object
        listed = []
        for each section in detailSectionLayout.Sections()
            if detailSectionLayout.IsAvailableIn(section, style) and (section.group <> "seerr" or seerrAvailable) then listed.push(section)
        end for
        return listed
    end function

    ' The ids switched off, read once where a screen asks about several so it agrees with itself
    function HiddenIds() as object
        return buttonLayout.HiddenLookup(chainLookupReturn(m.global, "session.user.settings.`" + DETAIL_SECTIONS_HIDDEN_SETTING + "`", invalid))
    end function

    function Shows(id as string) as boolean
        return not detailSectionLayout.HiddenIds().DoesExist(id)
    end function

    ' Other clients store ids this app has no switch for, and those pass through untouched since
    ' a toggle only ever adds or removes its own id
    function Toggle(stored as dynamic, id as string) as object
        kept = []
        found = false
        for each storedId in buttonLayout.ToIds(stored)
            if storedId = id
                found = true
            else
                kept.push(storedId)
            end if
        end for
        if not found then kept.push(id)
        return kept
    end function

end namespace

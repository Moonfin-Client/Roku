import "pkg:/source/utils/misc.bs"

' How the details action row is arranged. The arrangement follows the user
' between devices through the plugin, so the ids here have to match the ones the
' other clients write. Renaming an id drops whatever the user had arranged.
const DETAIL_ORDER_SETTING = "ui.itemdetail.buttonOrder"
const DETAIL_HIDDEN_SETTING = "ui.itemdetail.hiddenButtons"

' The same arrangement for the player controls, kept under the fields the other clients
' already read and write
const OSD_ORDER_SETTING = "ui.osd.buttonOrder"
const OSD_HIDDEN_SETTING = "ui.osd.hiddenButtons"

' How many action buttons stay on screen before the rest move behind More Actions. Zero leaves
' each style to its own default and -1 keeps every button in one row that scrolls sideways.
const DETAIL_MAX_VISIBLE_SETTING = "ui.itemdetail.buttonsMaxVisible"

' Nouveau keeps its row short. On Auto up to three secondary buttons stay out, and past that
' only two do with the rest behind More.
const NOUVEAU_MAX_SECONDARY_WITHOUT_OVERFLOW = 3
const NOUVEAU_VISIBLE_SECONDARY_WITH_OVERFLOW = 2

' An empty clipping rectangle hides everything under it on these sets, so a button row or label
' that fits is given room far past anything it could draw instead
const BUTTON_NO_CLIP = [-4000, -4000, 8000, 8000]

namespace buttonLayout

    ' Play, Resume and Restart are absent on purpose. They are one button wearing
    ' different labels, it always leads the row, and it anchors the focus the
    ' screen hands out. Declaration order matches the other clients, which is
    ' what decides where a button nobody placed ends up.
    function DetailButtons() as object
        return [
            { id: "seerrRequest", label: "Request" },
            { id: "seerrRequest4k", label: "Request 4K" },
            { id: "shuffle", label: "Shuffle" },
            { id: "version", label: "Version" },
            { id: "parts", label: "Parts" },
            { id: "audio", label: "Audio" },
            { id: "subtitles", label: "Subtitle" },
            { id: "trailer", label: "Trailer" },
            { id: "watched", label: "Mark Watched" },
            { id: "favorite", label: "Favorite" },
            { id: "personalRating", label: "Rate" },
            { id: "goToSeries", label: "Series" },
            { id: "playlist", label: "Add to Playlist" },
            { id: "collection", label: "Add to Collection" },
            { id: "deleteFiles", label: "Delete" },
            { id: "artwork", label: "Change Artwork" },
            { id: "seerrWatchlist", label: "Watchlist" },
            { id: "seerrReportIssue", label: "Report Issue" },
            { id: "seerrManage", label: "Manage Requests" },
            { id: "admin", label: "Admin Controls" }
        ]
    end function

    ' Play, pause, seek and item skip are absent on purpose, the player always keeps those.
    ' Declaration order is what decides where a button nobody placed ends up, so it follows
    ' Core's. Zoom, sleep, the quality picker and cast and crew belong between audio and
    ' info once this player can draw them.
    function OsdButtons() as object
        return [
            { id: "speed", label: "Playback Speed" },
            { id: "chapters", label: "Chapters" },
            { id: "subtitles", label: "Subtitles" },
            { id: "audio", label: "Audio" },
            { id: "info", label: "Playback Information" }
        ]
    end function

    ' The Action Buttons on Screen setting, with anything it doesnt know read as Auto
    function MaxVisibleSetting() as integer
        stored = m.global.session.user.settings[DETAIL_MAX_VISIBLE_SETTING]
        if not isValid(stored) then return 0

        limit = stored.ToStr().Trim().ToInt()
        if limit < -1 or limit > 10 then return 0
        return limit
    end function

    ' The viewer's own cap laid over what the style already asked for. Auto leaves the style
    ' alone, All lifts the cap so every button stays in the row, and a number is how many end up
    ' on screen with the rest behind the menu.
    function ApplyButtonLimit(limit as integer, styleCap as object) as object
        if limit = -1 then return { maxVisible: styleCap.maxVisible, overflowAsMenu: styleCap.overflowAsMenu, countCapped: false }
        if limit >= 1 then return { maxVisible: limit + 1, overflowAsMenu: true, countCapped: true }
        return styleCap
    end function

    ' How a capped row splits into the buttons that stay inline and the ones that fold behind
    ' the menu. The total counts the whole row, the leading play slot included, because that slot
    ' takes a place in the row like any other button.
    function CountSplit(totalButtons as integer, styleCap as object) as object
        visibleCount = styleCap.maxVisible - 1
        threshold = styleCap.maxVisible
        if styleCap.overflowAsMenu then threshold = visibleCount
        return { visibleCount: visibleCount, needsOverflow: styleCap.countCapped and totalButtons > threshold }
    end function

    ' Nouveau's own rule, since no cap passed to CountSplit produces its three then two. A count
    ' covers the primary button too, so the secondaries get one fewer than it inline, and one fewer
    ' again where More takes a place in the row as well.
    function NouveauSplit(secondaryCount as integer, limit as integer) as object
        if limit = -1 then return { needsOverflow: false, visibleCount: secondaryCount }

        if limit >= 1
            shown = limit - 2
            if shown < 0 then shown = 0
            return { needsOverflow: secondaryCount > limit - 1, visibleCount: shown }
        end if

        return { needsOverflow: secondaryCount > NOUVEAU_MAX_SECONDARY_WITHOUT_OVERFLOW, visibleCount: NOUVEAU_VISIBLE_SECONDARY_WITH_OVERFLOW }
    end function

    ' Candidates arrive from more than one builder, so with nothing arranged they are put
    ' back into the catalogue's order rather than whatever order they were pushed in.
    ' Two candidates sharing an id keep the order they came in, which is how a cancel
    ' stays beside the request it belongs to.
    function InCatalogueOrder(candidates as object) as object
        position = {}
        index = 0
        for each entry in buttonLayout.DetailButtons()
            position[entry.id] = index
            index++
        end for

        buckets = []
        for i = 0 to index
            buckets.push([])
        end for

        for each candidate in candidates
            rank = position[candidate.id]
            if not isValid(rank) then rank = index
            buckets[rank].push(candidate)
        end for

        sorted = []
        for each bucket in buckets
            for each candidate in bucket
                sorted.push(candidate)
            end for
        end for

        return sorted
    end function

    ' The plugin sends an array, this app stores JSON, and Core stores a comma
    ' joined string, so all three are accepted.
    function ToIds(stored as dynamic) as object
        ids = []
        if not isValidAndNotEmpty(stored) then return ids

        storedType = LCase(type(stored))
        if storedType = "roarray" or storedType = "array"
            for each entry in stored
                if not isValid(entry) then continue for
                text = entry.ToStr().Trim()
                if text <> "" then ids.push(text)
            end for
            return ids
        end if

        if storedType <> "rostring" and storedType <> "string" then return ids

        parsed = ParseJson(stored)
        if isValid(parsed) and LCase(type(parsed)) = "roarray" then return buttonLayout.ToIds(parsed)

        for each part in stored.Split(",")
            text = part.Trim()
            if text <> "" then ids.push(text)
        end for

        return ids
    end function

    ' `all` rearranged into the order the user put the row in. Anything they
    ' never placed follows the placed button it was declared after, so a button
    ' added since they last touched this lands where it belongs.
    function Ordered(all as object, stored as dynamic) as object
        ids = buttonLayout.ToIds(stored)
        if ids.count() = 0 then return all

        placed = {}
        for i = 0 to ids.count() - 1
            placed[ids[i]] = i
        end for

        ' One bucket per placed id, plus a leading one for whatever was declared
        ' before the first id the user placed
        buckets = []
        for i = 0 to ids.count()
            buckets.push([])
        end for

        carried = 0
        for each item in all
            rank = placed[item.id]
            if isValid(rank) then carried = rank + 1
            buckets[carried].push(item)
        end for

        arranged = []
        for each bucket in buckets
            for each item in bucket
                arranged.push(item)
            end for
        end for

        return arranged
    end function

    ' Holds the buttons switched off rather than the ones left on, so a button
    ' the app starts offering later shows up for people who already have a list.
    function HiddenLookup(stored as dynamic) as object
        off = {}
        for each id in buttonLayout.ToIds(stored)
            off[id] = true
        end for

        return off
    end function

    function Arrange(all as object, order as dynamic, hidden as dynamic) as object
        off = buttonLayout.HiddenLookup(hidden)

        visible = []
        for each item in buttonLayout.Ordered(all, order)
            if not isValid(off[item.id]) then visible.push(item)
        end for

        return visible
    end function

    ' A save from here has to carry through the ids this app has no button for.
    ' The other clients offer buttons it doesn't and everyone shares these two
    ' settings, so writing back only what is in the catalogue would erase what
    ' those clients arranged. Each carried id goes behind the id it was stored
    ' after, the same way Ordered places a button nobody arranged.
    function WithUnknownIds(catalogue as object, savedOrder as object, savedHidden as object, storedOrder as dynamic, storedHidden as dynamic) as object
        known = {}
        for each item in catalogue
            known[item.id] = true
        end for

        leading = []
        trailing = {}
        anchor = ""
        for each id in buttonLayout.ToIds(storedOrder)
            if isValid(known[id])
                anchor = id
            else if anchor = ""
                leading.push(id)
            else
                if not isValid(trailing[anchor]) then trailing[anchor] = []
                trailing[anchor].push(id)
            end if
        end for

        order = []
        for each id in leading
            order.push(id)
        end for

        for each id in savedOrder
            order.push(id)
            behind = trailing[id]
            if isValid(behind)
                for each carried in behind
                    order.push(carried)
                end for
            end if
        end for

        hidden = []
        for each id in savedHidden
            hidden.push(id)
        end for
        for each id in buttonLayout.ToIds(storedHidden)
            if not isValid(known[id]) then hidden.push(id)
        end for

        return { order: order, hidden: hidden }
    end function

end namespace

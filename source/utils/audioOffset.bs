' Moving the audio earlier or later. Roku's Video node can't delay audio, so Moonbase makes a stream
' with the audio already moved, starting at a keyframe at or just before where the viewer is. The
' player counts the title's time from where that stream starts, as it does for Silo.

' The device's offset, in milliseconds. Positive plays the audio later than the picture
const AUDIO_OFFSET_SETTING = "playback.audioOffsetMs"
const AUDIO_OFFSET_LIMIT_MS = 2000
const AUDIO_OFFSET_STEP_MS = 50

namespace audioOffset

    ' The stored offset as a number within the limit, and 0 for nothing or anything unreadable
    function FromStored(stored as dynamic) as integer
        if isString(stored) then return Clamp(stored.ToInt())
        if GetInterface(stored, "ifInt") <> invalid then return Clamp(stored)
        return 0
    end function

    ' The offset in seconds to the hundredth, as the audio picker shows it
    function Detail(offsetMs as integer) as string
        if offsetMs = 0 then return tr("None")
        sign = "-"
        if offsetMs > 0 then sign = "+"
        hundredths = Int(Abs(offsetMs) / 10 + 0.5)
        fraction = (hundredths mod 100).ToStr()
        if Len(fraction) < 2 then fraction = "0" + fraction
        return `${sign}${Int(hundredths / 100).ToStr()}.${fraction}s`
    end function

    function Clamp(offsetMs as integer) as integer
        if offsetMs > AUDIO_OFFSET_LIMIT_MS then return AUDIO_OFFSET_LIMIT_MS
        if offsetMs < -AUDIO_OFFSET_LIMIT_MS then return -AUDIO_OFFSET_LIMIT_MS
        return offsetMs
    end function

    ' Whether a title can play through Moonbase's moved stream at all. Only a title from a file on the
    ' signed-in server, whose video the device can play as it is, can be copied into one. Live TV and
    ' Silo make streams of their own.
    function Eligible(live as boolean, fromSilo as boolean, pluginInstalled as boolean, otherServer as boolean, videoPlayable as boolean) as boolean
        if live or fromSilo or otherServer then return false
        return pluginInstalled and videoPlayable
    end function

    ' Whether a load plays through Moonbase's moved stream: an eligible title with an offset set
    function Applies(offsetMs as integer, live as boolean, fromSilo as boolean, pluginInstalled as boolean, otherServer as boolean, videoPlayable as boolean) as boolean
        if offsetMs = 0 then return false
        return Eligible(live, fromSilo, pluginInstalled, otherServer, videoPlayable)
    end function

    ' The server's text subtitles count from the title's start. The ticks in their address make it
    ' count from where the stream starts instead, so they meet the picture on the player's clock.
    function ShiftSubtitleUrl(url as string, startTicks as longinteger) as string
        if url = "" or startTicks <= 0 then return url
        pattern = CreateObject("roRegex", "(/subtitles/\d+/)\d+(/stream\.)", "i")
        return pattern.Replace(url, "\1" + startTicks.ToStr() + "\2")
    end function

    ' Where to begin in a stream that starts streamStart seconds into the title, to land on
    ' wanted. The stream can start a few seconds early, at the keyframe before the asked point.
    ' (A parameter named like this function would read as the function.)
    function PlayStart(wanted as float, streamStart as float) as integer
        startAt = Int(wanted - streamStart + 0.5)
        if startAt < 0 then return 0
        return startAt
    end function

end namespace

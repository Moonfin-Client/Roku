' How the Home Rows editor lays out its list. The enabled rows come first, in the order Home shows
' them, and the disabled ones follow under a header per kind of row that opens and closes.
namespace homeRowGroups

    ' The kinds the disabled rows are grouped by, in the order the groups are listed
    function Order() as object
        return ["general", "collections", "favorites", "genres", "playlists", "seerr", "imdb", "tmdb", "streaming", "mdblist", "justwatch"]
    end function

    function Group(id as string) as string
        lower = LCase(id)
        if lower.Left(20) = "plugindynamic:seerr:" then return "seerr"
        if lower = "collections" or lower.Left(26) = "plugindynamic:collections:" then return "collections"
        if lower = "genres" or lower = "studios" or lower.Left(21) = "plugindynamic:genres:" then return "genres"
        if lower = "favorites" then return "favorites"
        if lower = "playlists" or lower.Left(24) = "plugindynamic:playlists:" then return "playlists"
        if lower.Left(6) = "seerr_" or lower = "radarr_calendar" or lower = "sonarr_calendar" then return "seerr"
        ' The outside lists go by where they come from, with the streaming service charts on their own
        if lower.Left(5) = "imdb_" then return "imdb"
        streaming = { tmdb_netflix: true, tmdb_prime_video: true, tmdb_disney_plus: true, tmdb_hbo_max: true, tmdb_apple_tv: true, tmdb_paramount_plus: true }
        if streaming.DoesExist(lower) then return "streaming"
        if lower.Left(5) = "tmdb_" then return "tmdb"
        if lower.Left(8) = "mdblist_" then return "mdblist"
        if lower.Left(10) = "justwatch_" then return "justwatch"
        return "general"
    end function

    ' Where an outside list comes from, shown under its name in the editor
    function SourceLabel(id as string) as string
        kind = homeRowGroups.Group(id)
        if kind = "imdb" then return "IMDb List"
        if kind = "tmdb" or kind = "streaming" then return "TMDB Lists"
        if kind = "justwatch" then return "JustWatch"
        if kind <> "mdblist" then return ""
        if LCase(id) = "mdblist_watching_now" then return "MDBList"
        return "MDBList Lists"
    end function

    ' An outside list's name in the editor, which leaves the source to its group and subtitle
    function EditorLabel(label as string) as string
        for each prefix in ["IMDb ", "TMDB ", "TMDb "]
            if Left(label, Len(prefix)) = prefix then return Mid(label, Len(prefix) + 1)
        end for
        return label
    end function

    ' The list top to bottom. Each entry names a row by its index in rows, or a group header with
    ' how many rows it holds. A group's rows follow its header only while the group is open, and
    ' the rows named in leftOut aren't listed at all.
    function View(rows as object, openGroups as object, leftOut as object) as object
        entries = []
        members = {}
        for i = 0 to rows.Count() - 1
            if leftOut[rows[i].id] <> true
                if rows[i].enabled
                    entries.push({ row: i })
                else
                    kind = Group(rows[i].id)
                    if not members.DoesExist(kind) then members[kind] = []
                    members[kind].push(i)
                end if
            end if
        end for
        for each kind in Order()
            if members.DoesExist(kind)
                entries.push({ group: kind, total: members[kind].Count() })
                if openGroups[kind] = true
                    for each i in members[kind]
                        entries.push({ row: i })
                    end for
                end if
            end if
        end for
        return entries
    end function

    function Unlisted(rows as object, records as object) as object
        listed = {}
        for each row in rows
            listed[row.id] = true
        end for
        result = []
        for each record in records
            if not listed.DoesExist(record.id) then result.push(record)
        end for
        return result
    end function

    ' A row's id without the item on the end names the list and server it was picked from
    function ListOf(entry as object) as string
        return LCase(Left(entry.id, Len(entry.id) - Len(entry.itemId)))
    end function

    ' Picks whose list came back without them are gone, and the rest take the name their server
    ' gives them now. A list that came back empty proves nothing, since a failed request looks the
    ' same, so its picks are kept.
    function Refreshed(picks as object, fetched as object) as object
        titles = {}
        lists = {}
        for each record in fetched
            titles[record.id] = record.title
            lists[homeRowGroups.ListOf(record)] = true
        end for

        result = { picks: [], gone: [], changed: false }
        for each pick in picks
            if titles.DoesExist(pick.id)
                if pick.title <> titles[pick.id]
                    pick.title = titles[pick.id]
                    result.changed = true
                end if
                result.picks.push(pick)
            else if lists.DoesExist(homeRowGroups.ListOf(pick)) and Left(pick.itemId, 5) <> "type."
                ' A Silo row named by its kind stands for whichever section has it, so it isn't listed
                result.gone.push(pick.id)
                result.changed = true
            else
                result.picks.push(pick)
            end if
        end for
        return result
    end function

    ' A found row that was never turned on isn't saved, so a server with hundreds of collections
    ' doesn't fill the registry with ids that are off
    function ToSave(rows as object, found as object) as object
        records = {}
        for each record in found
            records[record.id] = record
        end for

        result = { order: [], hidden: [], picked: [] }
        for each row in rows
            record = records[row.id]
            if row.enabled or not isValid(record)
                result.order.push(row.id)
                if not row.enabled then result.hidden.push(row.id)
                if row.enabled and isValid(record) then result.picked.push(record)
            end if
        end for
        return result
    end function

end namespace

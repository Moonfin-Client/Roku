' How the Home Rows editor lays out its list. The enabled rows come first, in the order Home shows
' them, and the disabled ones follow under a header per kind of row that opens and closes.
namespace homeRowGroups

    ' The kinds the disabled rows are grouped by, in the order the groups are listed
    function Order() as object
        return ["general", "collections", "favorites", "genres", "playlists", "seerr", "external"]
    end function

    function Group(id as string) as string
        lower = LCase(id)
        if lower = "collections" or lower.Left(26) = "plugindynamic:collections:" then return "collections"
        if lower = "genres" or lower = "studios" or lower.Left(21) = "plugindynamic:genres:" then return "genres"
        if lower = "favorites" then return "favorites"
        if lower = "playlists" or lower.Left(24) = "plugindynamic:playlists:" then return "playlists"
        if lower.Left(6) = "seerr_" or lower = "radarr_calendar" or lower = "sonarr_calendar" then return "seerr"
        if lower.Left(5) = "imdb_" or lower.Left(5) = "tmdb_" then return "external"
        return "general"
    end function

    ' The list top to bottom. Each entry names a row by its index in rows, or a group header with
    ' how many rows it holds. A group's rows follow its header only while the group is open, and
    ' the rows named in leftOut aren't listed at all.
    function View(rows as object, openGroups as object, leftOut as object) as object
        entries = []
        members = {}
        for i = 0 to rows.Count() - 1
            if leftOut[rows[i].id] <> true
                if rows[i].enabled
                    entries.push({ row: i })
                else
                    kind = Group(rows[i].id)
                    if not members.DoesExist(kind) then members[kind] = []
                    members[kind].push(i)
                end if
            end if
        end for
        for each kind in Order()
            if members.DoesExist(kind)
                entries.push({ group: kind, total: members[kind].Count() })
                if openGroups[kind] = true
                    for each i in members[kind]
                        entries.push({ row: i })
                    end for
                end if
            end if
        end for
        return entries
    end function

end namespace

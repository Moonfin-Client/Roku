' Settings sizes at 1080p. The panel is laid out on a canvas 1150 units wide, so a unit is
' 1920 / 1150 pixels here, and the sizes below are in those units.
namespace settingsMetrics
    const PX_PER_DP = 1.66957

    const PANEL_X = 1219
    const PANEL_WIDTH = 701
    const TITLE_BAR_HEIGHT = 93

    ' A line of text is 1.1719 times its font size
    const LINE_RATIO = 1.1719

    function Px(units as float) as float
        return units * settingsMetrics.PX_PER_DP
    end function

    ' Font sizes in pixels, which the pixel theme draws at 60 percent
    function FontSizes(scale as float) as object
        sizes = { title: 14, caption: 12, descSmall: 11, bubble: 11, header: 12, appTitle: 22, hint: 12, lead: 14, dialogTitle: 14 }
        result = {}
        for each name in sizes
            result[name] = Int(settingsMetrics.Px(sizes[name]) * scale + 0.5)
        end for
        return result
    end function

    function LineHeight(fontDp as float, scale as float) as float
        return settingsMetrics.Px(fontDp) * scale * settingsMetrics.LINE_RATIO
    end function

    ' The text column of a row. A title on its own is 56 tall, a line under it makes 72 and a
    ' picker's description makes at least 88. Once either wraps, it's just the text with 8 above
    ' and below.
    function Body(kind as string, titleLines as integer, captionLines as integer, captionDp as float, scale as float) as object
        titleLine = settingsMetrics.LineHeight(14, scale)
        captionLine = settingsMetrics.LineHeight(captionDp, scale)
        if titleLines > 1
            top = settingsMetrics.Px(8)
            return { height: top * 2 + titleLines * titleLine + captionLines * captionLine, titleTop: top, captionTop: top + titleLines * titleLine }
        end if
        if captionLines <= 0
            return { height: settingsMetrics.Px(56), titleTop: (settingsMetrics.Px(56) - titleLine) / 2, captionTop: 0 }
        end if

        if captionLines = 1 and kind = "three"
            top = settingsMetrics.Px(15)
            height = settingsMetrics.Px(88)
            textEnd = top + titleLine + settingsMetrics.Px(6.4) + captionLine + settingsMetrics.Px(8)
            if textEnd > height then height = textEnd
            return { height: height, titleTop: top, captionTop: top + titleLine + settingsMetrics.Px(6.4) }
        end if

        if captionLines = 1
            ' The pixel theme's smaller text keeps the line positions full size text has, so its
            ' two lines sit lower
            if scale < 1 then return { height: settingsMetrics.Px(72), titleTop: settingsMetrics.Px(25), captionTop: settingsMetrics.Px(25) + titleLine + settingsMetrics.Px(10.85) }
            return { height: settingsMetrics.Px(72), titleTop: settingsMetrics.Px(19), captionTop: settingsMetrics.Px(19) + titleLine + settingsMetrics.Px(5.45) }
        end if

        top = settingsMetrics.Px(8)
        return { height: top * 2 + titleLine + captionLines * captionLine, titleTop: top, captionTop: top + titleLine }
    end function

    ' Pickers and switches sit closer to the card's edges than a row that opens a screen
    function CardHeight(bodyHeight as float, tight as boolean) as float
        padding = settingsMetrics.Px(8)
        if tight then padding = settingsMetrics.Px(4)
        return bodyHeight + padding * 2 + 2
    end function

    ' A section heading's line, with 20 above it and 6 below
    const HEADER_LINE_DP = 17.16

    function HeaderBand() as float
        return settingsMetrics.Px(20 + settingsMetrics.HEADER_LINE_DP + 6)
    end function

    ' A value bubble, three lines at most, with its padding and border
    function BubbleHeight(lines as integer) as float
        return (settingsMetrics.Px(8) + 1) * 2 + lines * settingsMetrics.Px(14.67)
    end function
end namespace

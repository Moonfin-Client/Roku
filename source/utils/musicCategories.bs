import "pkg:/source/utils/accentFolding.bs"
import "pkg:/source/utils/misc.bs"

' What the music category screens work out from the server's answers, kept apart from the
' screens so it can be checked off the device
namespace musicCategories
    const PAGE_SIZE = 100
    const RAIL_LETTERS = "#ABCDEFGHIJKLMNOPQRSTUVWXYZ"

    function Palette() as object
        return ["#7A2E22", "#3B2D5C", "#6B2F4A", "#4D3B72", "#B4472F", "#1F3A5F", "#8A5A1E", "#14505C"]
    end function

    ' The heading an artist files under, from its sort name with accents folded
    function LetterOf(item as object) as string
        sortTitle = item.LookupCI("SortName")
        if not isValidAndNotEmpty(sortTitle) then sortTitle = item.LookupCI("Name")
        initial = accentFolding.StartLetter(toString(sortTitle ?? ""))
        if initial = "" then return "#"
        return initial
    end function

    ' The first loaded artist at or past a letter in the order the list runs, or -1 when none of
    ' the loaded ones are. Names in other scripts file under # but sort after Z, so only a plain
    ' letter counts as passing the one asked for.
    function JumpIndex(initials as object, target as string, descending as boolean) as integer
        for i = 0 to initials.count() - 1
            initial = initials[i]
            if target = "#"
                if initial = "#" then return i
            else if initial <> "#"
                if descending and initial <= target then return i
                if not descending and initial >= target then return i
            end if
        end for
        return -1
    end function

    ' A genre's album count, or -1 when the server gave none
    function AlbumCount(genre as object) as integer
        count = genre.LookupCI("AlbumCount")
        if not isValid(count) or count <= 0 then count = genre.LookupCI("ChildCount")
        if not isValid(count) then return -1
        return Int(count)
    end function

    ' Most albums first with ties by name. The sort runs on one string key, since the firmware
    ' sorts mixed number types apart, brs has no stable tie break and it only finds a lowercase key.
    function ByAlbumCount(genres as object) as object
        keyed = []
        for i = 0 to genres.count() - 1
            count = musicCategories.AlbumCount(genres[i])
            if count < 0 then count = 0
            rank = Right("000000000" + (999999999 - count).toStr(), 9)
            order = Right("00000" + i.toStr(), 5)
            keyed.push({ key: rank + LCase(toString(genres[i].LookupCI("Name") ?? "")) + order, genre: genres[i] })
        end for
        keyed.SortBy("key")
        sorted = []
        for each entry in keyed
            sorted.push(entry.genre)
        end for
        return sorted
    end function

    function AnyAlbumCount(genres as object) as boolean
        for each genre in genres
            if musicCategories.AlbumCount(genre) > 0 then return true
        end for
        return false
    end function

    ' "41 min" or "2 hr 40 min", empty when the server gave no length
    function Duration(ticks as dynamic) as string
        if not isValid(ticks) or ticks <= 0 then return ""
        minutes = Int(ticks / 600000000# + 0.5)
        if minutes < 1 then minutes = 1
        hours = minutes \ 60
        minutes = minutes mod 60
        if hours = 0 then return Substitute(tr("{0} min"), minutes.toStr())
        if minutes = 0 then return Substitute(tr("{0} hr"), hours.toStr())
        return Substitute(tr("{0} hr {1} min"), hours.toStr(), minutes.toStr())
    end function

    ' A count in words, "1 album" or "12 albums", or nothing at all for none
    function CountText(count as dynamic, one as string, many as string) as string
        if not isValid(count) or count <= 0 then return ""
        if count = 1 then return one
        return many.Replace("{count}", Int(count).toStr())
    end function

    ' The parts a line is made of that the server gave, joined
    function Joined(parts as object, separator as string) as string
        kept = []
        for each part in parts
            if isValidAndNotEmpty(part) then kept.push(part)
        end for
        return kept.join(separator)
    end function
end namespace

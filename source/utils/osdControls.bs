' The player's controls: the glyph a seek button wears for the skip length, the
' speeds and bitrates its menus offer, and where Previous and Next land in a title with chapters
namespace osdControls

    ' How far a seek button or key skips, from the player's settings or the preview's values
    function SkipSeconds(settings as object, direction as integer) as integer
        key = "playback.skipBackLength"
        if direction > 0 then key = "playback.skipForwardLength"
        seconds = (settings[key] ?? "10").toStr().toInt()
        if seconds <= 0 then seconds = 10
        return seconds
    end function

    ' These lengths have a numbered glyph, the rest get plain arrows
    function SeekGlyph(direction as integer, seconds as integer) as string
        if seconds = 5 or seconds = 10 or seconds = 30
            if direction > 0 then return "forward_" + seconds.toStr() + "_rounded"
            return "replay_" + seconds.toStr() + "_rounded"
        end if
        if direction > 0 then return "fast_forward_rounded"
        return "fast_rewind_rounded"
    end function

    ' Speeds stop at 2x since the Roku plays anything faster at 2x.
    function Speeds() as object
        return [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0]
    end function

    ' 1 reads 1.0x and 1.25 reads 1.25x
    function SpeedLabel(speed as float) as string
        hundredths = Int(speed * 100 + 0.5)
        whole = Int(hundredths / 100)
        part = hundredths - whole * 100
        if part mod 10 = 0 then return `${whole}.${Int(part / 10)}x`
        if part < 10 then return `${whole}.0${part}x`
        return `${whole}.${part}x`
    end function

    ' In bits per second, with Auto as zero for no cap
    function Bitrates() as object
        return [0, 40000000, 20000000, 12000000, 8000000, 4000000, 2000000]
    end function

    function BitrateLabel(bps as integer) as string
        if bps <= 0 then return tr("Auto")
        return `${Int(bps / 1000000)} Mbps`
    end function

    ' The start of the chapter playing, or the one before it within three seconds of a start, so a
    ' second press steps further back. -1 when there is none and the queue decides.
    function PreviousChapterStart(startsMs as object, positionMs as float) as dynamic
        threshold = positionMs - 3000
        best = -1
        for each startMs in startsMs
            if startMs <= threshold and startMs > best then best = startMs
        end for
        return best
    end function

    ' The next chapter's start, or -1 inside the last one
    function NextChapterStart(startsMs as object, positionMs as float) as dynamic
        best = -1
        for each startMs in startsMs
            if startMs > positionMs and (best < 0 or startMs < best) then best = startMs
        end for
        return best
    end function

end namespace

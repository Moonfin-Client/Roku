import "pkg:/source/utils/misc.bs"

' Local recommendation scoring and seed helpers shared by the home rows and the details screens.
namespace HomeRecommendations

    function sequelStopWords() as object
        return {
            "the": true, "and": true, "with": true, "from": true,
            "under": true, "over": true, "about": true, "chapter": true,
            "part": true, "movie": true, "film": true
        }
    end function

    function keyWords(title as dynamic) as object
        result = []
        if not isValid(title) or title = "" then return result

        stops = sequelStopWords()
        cleanRegex = CreateObject("roRegex", "[^0-9a-zA-Z\s]", "")
        cleaned = cleanRegex.ReplaceAll(LCase(title), " ")
        splitRegex = CreateObject("roRegex", "\s+", "")
        words = splitRegex.Split(cleaned)

        for each word in words
            if Len(word) >= 4 and not stops.DoesExist(word)
                result.Push(word)
            end if
        end for
        return result
    end function

    ' True when two titles share their meaningful words, so sequels and franchise
    ' entries score higher without matching something unrelated.
    function isSequelOrSimilarTitle(titleA as dynamic, titleB as dynamic) as boolean
        a = keyWords(titleA)
        b = keyWords(titleB)
        if a.Count() = 0 or b.Count() = 0 then return false

        setA = toStringSet(a)
        setB = toStringSet(b)
        if setContainsAll(setA, b) or setContainsAll(setB, a) then return true

        if setA.Count() = 1 and setB.Count() = 1
            ' A single subject word differing only by a short suffix (<= 2 chars), so pluralized
            ' sequels like "Alien" and "Aliens" match, while unrelated titles sharing a common
            ' prefix (such as matching "Alien" to "The Alienist") are excluded.
            if Len(a[0]) <= Len(b[0])
                shortWord = a[0]
                longWord = b[0]
            else
                shortWord = b[0]
                longWord = a[0]
            end if
            return Left(longWord, Len(shortWord)) = shortWord and (Len(longWord) - Len(shortWord)) <= 2
        end if
        return false
    end function

    function scoreDiminishing(count as integer, first as float, second as float, third = 0.0 as float) as float
        if count <= 0 then return 0.0
        if count = 1 then return first
        if count = 2 then return first + second
        return first + second + third
    end function

    ' Builds the scoring context from the seed item once so candidates can be
    ' compared against it.
    function buildContext(seed as object) as object
        people = readItemArray(seed, "People")
        return {
            genres: readItemArray(seed, "Genres"),
            tags: readItemArray(seed, "Tags"),
            baseStudios: studioNameList(readItemArray(seed, "Studios")),
            baseYear: seed.ProductionYear,
            baseRating: seed.CommunityRating,
            baseName: readItemString(seed, "Name"),
            actorNames: namesList(people, "Actor"),
            directorNames: namesList(people, "Director"),
            writerNames: namesList(people, "Writer"),
            actorIds: idsList(people, "Actor"),
            directorIds: idsList(people, "Director"),
            writerIds: idsList(people, "Writer")
        }
    end function

    function scoreCandidate(candidate as object, ctx as object) as float
        score = 0.0

        ' Genres: 7.0 pts/match, capped at 35.0 (5 matches)
        genreMatches = 0
        cGenres = toStringSet(readItemArray(candidate, "Genres"))
        for each g in ctx.genres
            if cGenres.DoesExist(g) then genreMatches = genreMatches + 1
        end for
        genreScore = genreMatches * 7.0
        if genreScore > 35.0 then genreScore = 35.0
        score = score + genreScore

        ' Tags: 4.0 pts/match, capped at 20.0 (5 matches)
        tagMatches = 0
        cTags = toStringSet(readItemArray(candidate, "Tags"))
        for each t in ctx.tags
            if cTags.DoesExist(t) then tagMatches = tagMatches + 1
        end for
        tagScore = tagMatches * 4.0
        if tagScore > 20.0 then tagScore = 20.0
        score = score + tagScore

        people = readItemArray(candidate, "People")
        cActors = namesSet(people, "Actor")
        cDirectors = namesSet(people, "Director")
        cWriters = namesSet(people, "Writer")

        ' Directors: 15, 10, 5 diminishing returns (capped at 30.0 pts)
        dirMatches = 0
        for each d in ctx.directorNames
            if cDirectors.DoesExist(d) then dirMatches = dirMatches + 1
        end for
        score = score + scoreDiminishing(dirMatches, 15.0, 10.0, 5.0)

        ' Writers: 15, 10, 5 diminishing returns (capped at 30.0 pts)
        writerMatches = 0
        for each w in ctx.writerNames
            if cWriters.DoesExist(w) then writerMatches = writerMatches + 1
        end for
        score = score + scoreDiminishing(writerMatches, 15.0, 10.0, 5.0)

        ' Actors: 10, 6, 4 diminishing returns (capped at 20.0 pts)
        actorMatches = 0
        for each a in ctx.actorNames
            if cActors.DoesExist(a) then actorMatches = actorMatches + 1
        end for
        score = score + scoreDiminishing(actorMatches, 10.0, 6.0, 4.0)

        ' Studios: 12, 8 diminishing returns (capped at 20.0 pts)
        studioMatches = 0
        cStudios = toStringSet(studioNameList(readItemArray(candidate, "Studios")))
        for each s in ctx.baseStudios
            if cStudios.DoesExist(s) then studioMatches = studioMatches + 1
        end for
        score = score + scoreDiminishing(studioMatches, 12.0, 8.0)

        ' Title / Franchise match: 25.0 pts
        if isSequelOrSimilarTitle(ctx.baseName, readItemString(candidate, "Name"))
            score = score + 25.0
        end if

        ' Production Year: smooth 15-year decay up to 10.0 pts
        candYear = candidate.ProductionYear
        if isNumber(candYear) and isNumber(ctx.baseYear)
            delta = Abs(candYear - ctx.baseYear)
            if delta < 15.0
                score = score + (10.0 * (1.0 - (delta / 15.0)))
            end if
        end if

        ' Community Rating proximity: up to 10.0 pts
        comm = candidate.CommunityRating
        if isNumber(comm)
            if isNumber(ctx.baseRating)
                delta = Abs(comm - ctx.baseRating)
                if delta < 10.0
                    score = score + (10.0 * (1.0 - (delta / 10.0)))
                end if
            else
                score = score + comm
            end if
        end if

        return score
    end function

    ' Watched episodes are replaced by their parent series so a seed represents a
    ' show, not a single episode. Movies and series keep their order.
    function resolveSeedEpisodes(rawItems as object, seriesById as object) as object
        finalItems = []
        added = {}
        for each item in rawItems
            itype = readItemString(item, "Type")
            if itype = "Movie"
                finalItems.Push(item)
            else if itype = "Episode"
                sId = readItemString(item, "SeriesId")
                if sId <> "" and seriesById.DoesExist(sId) and not added.DoesExist(sId)
                    added[sId] = true
                    finalItems.Push(seriesById[sId])
                end if
            else if itype = "Series"
                sId = readItemString(item, "Id")
                if sId <> "" and not added.DoesExist(sId)
                    added[sId] = true
                    finalItems.Push(item)
                end if
            end if
        end for
        return finalItems
    end function

    function readItemArray(item as object, key as string) as object
        if not isValid(item) then return []
        v = item[key]
        if isValid(v) and type(v) = "roArray" then return v
        return []
    end function

    function readItemString(item as object, key as string) as string
        if not isValid(item) then return ""
        v = item[key]
        if isValid(v) then return v.toStr()
        return ""
    end function

    function toStringSet(items as object) as object
        result = {}
        for each v in items
            if isValid(v) and v <> "" then result[v.toStr()] = true
        end for
        return result
    end function

    function namesList(people as object, ptype as string) as object
        result = []
        for each p in people
            if isValid(p) and readItemString(p, "Type") = ptype
                nm = readItemString(p, "Name")
                if nm <> "" then result.Push(nm)
            end if
        end for
        return result
    end function

    function namesSet(people as object, ptype as string) as object
        return toStringSet(namesList(people, ptype))
    end function

    function idsList(people as object, ptype as string) as object
        result = []
        for each p in people
            if isValid(p) and readItemString(p, "Type") = ptype
                pid = readItemString(p, "Id")
                if pid <> "" then result.Push(pid)
            end if
        end for
        return result
    end function

    function studioNameList(studios as object) as object
        result = []
        for each s in studios
            if type(s) = "roAssociativeArray"
                nm = readItemString(s, "Name")
                if nm <> "" then result.Push(nm)
            else if isValid(s) and s <> ""
                result.Push(s.toStr())
            end if
        end for
        return result
    end function

    function isNumber(v as dynamic) as boolean
        t = type(v)
        return t = "Integer" or t = "roInt" or t = "roInteger" or t = "Float" or t = "roFloat" or t = "Double" or t = "roDouble" or t = "LongInteger" or t = "roLongInteger"
    end function

    function setContainsAll(bigSet as object, smallList as object) as boolean
        for each w in smallList
            if not bigSet.DoesExist(w) then return false
        end for
        return true
    end function

    function scoredEntryComesAfter(a as object, b as object) as boolean
        if a.score <> b.score then return a.score < b.score
        aDate = readItemString(a.item, "PremiereDate")
        bDate = readItemString(b.item, "PremiereDate")
        return aDate < bDate
    end function

    ' Two lists into one, the first getting first claim and nothing twice. A card with no id of
    ' its own is kept, since there is nothing to match it against.
    function mergeItems(primary as object, secondary as object, limit as integer) as object
        merged = []
        seen = {}
        for each list in [primary, secondary]
            if not isValidAndNotEmpty(list) then continue for

            for each node in list
                if merged.Count() >= limit then exit for

                id = chainLookupReturn(node, "json.Id", "")
                if id <> ""
                    if seen.DoesExist(id) then continue for
                    seen[id] = true
                end if

                merged.Push(node)
            end for
        end for

        return merged
    end function

    ' The scorer only asks for films and shows as candidates, so those are the only titles it can
    ' answer for. An episode, a season or a book keeps the server's own list.
    function canScoreSeedLocally(itemType as string) as boolean
        seedType = LCase(itemType)
        return seedType = "movie" or seedType = "series"
    end function

    ' Sorts candidate entries in place descending by score, breaking ties by newest PremiereDate.
    sub sortScoredCandidates(scored as object)
        total = scored.Count()
        for i = 1 to total - 1
            current = scored[i]
            j = i - 1
            while j >= 0 and scoredEntryComesAfter(scored[j], current)
                scored[j + 1] = scored[j]
                j = j - 1
            end while
            scored[j + 1] = current
        end for
    end sub

end namespace

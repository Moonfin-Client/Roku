import "pkg:/source/utils/misc.bs"

' What the player's episode browser lists and how a row and a pick are worked out
namespace episodeBrowser

    ' A missing or unaired episode has no file behind it, so the browser leaves it out
    function PlayableOnly(episodes as object) as object
        kept = []
        for each episode in episodes
            locationType = chainLookupReturn(episode, "json.LocationType", "")
            if not isStringEqual(locationType, "Virtual") and chainLookupReturn(episode, "json.IsMissing", false) <> true
                kept.push(episode)
            end if
        end for
        return kept
    end function

    ' "Season 2 · Episode 5", leaving out whichever number the server has none for
    function RowLine(episode as object) as string
        parts = []
        season = chainLookupReturn(episode, "json.ParentIndexNumber", invalid)
        if isValid(season)
            if season = 0 then parts.push(tr("Specials")) else parts.push(substitute(tr("Season {0}"), season.toStr()))
        end if
        number = chainLookupReturn(episode, "json.IndexNumber", invalid)
        if isValid(number) then parts.push(`${tr("Episode")} ${number}`)
        return parts.join(" · ")
    end function

    ' One left part way through carries on from there, anything else starts from the top
    function ResumeTicks(episode as object) as dynamic
        ticks = chainLookupReturn(episode, "json.UserData.PlaybackPositionTicks", 0)
        if ticks > 0 and not chainLookupReturn(episode, "json.UserData.Played", false) then return ticks
        return 0
    end function

    ' How far through an episode is, from 0 to 1. The position over the runtime stands in
    ' when the server sends no percentage.
    function WatchedFraction(episode as object) as float
        percent = chainLookupReturn(episode, "json.UserData.PlayedPercentage", 0)
        if not isValid(percent) then percent = 0
        if percent <= 0
            ticks = chainLookupReturn(episode, "json.UserData.PlaybackPositionTicks", 0)
            runtime = chainLookupReturn(episode, "json.RunTimeTicks", 0)
            if ticks > 0 and runtime > 0 then percent = ticks / runtime * 100
        end if
        if percent > 100 then percent = 100
        return percent / 100
    end function

end namespace

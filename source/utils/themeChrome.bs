import "pkg:/source/utils/misc.bs"

namespace themeChrome

    ' Every read of m.global.session copies the whole session across threads, about a millisecond on
    ' a Roku, so a caller that needs several settings reads them once here and passes them on
    function UserSettings() as dynamic
        if not isValid(m.global) then return invalid
        currentSession = m.global.session
        if not isValid(currentSession) or not isValid(currentSession.user) then return invalid
        return currentSession.user.settings
    end function

    function IsActive(themeSettings = invalid as dynamic) as boolean
        if not isValid(themeSettings) then themeSettings = themeChrome.UserSettings()
        if not isValid(themeSettings) then return false
        themeId = themeSettings["ui.theme.customThemeId"]
        return isValidAndNotEmpty(themeId) and themeId <> "moonfin"
    end function

    ' The look of the detail screen's action buttons for a StandardButton outline pill: glass and a
    ' hairline at rest, then the theme's focused button colours inside a ring in the focus colour
    sub StyleDetailChip(chip as object)
        if not isValid(chip) then return
        chip.outline = true
        chip.fillUri = "pkg:/images/details/btnfill.9.png"
        chip.outlineUri = "pkg:/images/details/btnborder.9.png"
        chip.focusOutlineUri = "pkg:/images/details/btnborderfocus4.9.png"
        chip.background = themeChrome.WithAlpha(themeChrome.Token("buttonNormal", "#FFFFFF"), "0F")
        chip.focusBackground = themeChrome.WithAlpha(themeChrome.Token("buttonFocused", "#FFFFFF"), "F2")
        chip.color = themeChrome.Token("onButtonNormal", "#FFFFFFFF")
        chip.focusColor = themeChrome.Token("onButtonFocused", "#000000FF")
        chip.borderColor = "#FFFFFF59"
        chip.focusBorderColor = coreFocusColor()
    end sub

    function Accent(themeSettings = invalid as dynamic) as string
        if not isValid(themeSettings) then themeSettings = themeChrome.UserSettings()
        return formatSceneGraphColor(chainLookupReturn(themeSettings, "colorCursor", ""), "0x00A4DCFF")
    end function

    function OnAccent(themeSettings = invalid as dynamic) as string
        return themeChrome.Token("onAccent", "0x000000FF", themeSettings)
    end function

    ' With no theme on there is nothing to read, so callers keep what they passed
    function Token(name as string, fallback as string, themeSettings = invalid as dynamic) as string
        if not isValid(themeSettings) then themeSettings = themeChrome.UserSettings()
        value = ""
        if themeChrome.IsActive(themeSettings) then value = themeSettings[`ui.theme.${name}`]

        return formatSceneGraphColor(value, fallback)
    end function

    function SurfaceVariant() as string
        return themeChrome.Token("surfaceVariant", "0x252525FF")
    end function

    function OnSurface() as string
        return formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorDialogText", ""), "0xFFFFFFFF")
    end function

    function InputBorder() as string
        return formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorDialogBorderLine", ""), "0x8EC8F055")
    end function

    function OnBackground(themeSettings = invalid as dynamic) as string
        if not isValid(themeSettings) then themeSettings = themeChrome.UserSettings()
        return formatSceneGraphColor(chainLookupReturn(themeSettings, "colorText", ""), "0xFFFFFFFF")
    end function

    function Surface() as string
        return formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorHomeRowItemBackground", ""), "0x101010FF")
    end function

    function Background(themeSettings = invalid as dynamic) as string
        if not isValid(themeSettings) then themeSettings = themeChrome.UserSettings()
        return formatSceneGraphColor(chainLookupReturn(themeSettings, "colorBackground", ""), "0x000000FF")
    end function

    sub ApplyThemeChrome(root as dynamic, restore = false as boolean)
        if not isValid(root) then return

        themeSettings = themeChrome.UserSettings()
        active = themeChrome.IsActive(themeSettings)
        if not active and not restore then return

        ctx = { active: active }
        if active
            ctx.accent = themeChrome.Accent(themeSettings)
            ctx.onAccent = themeChrome.OnAccent(themeSettings)
            ctx.textRgb = themeChrome.RgbParts(themeChrome.OnBackground(themeSettings))
            ctx.backgroundRgb = themeChrome.RgbParts(themeChrome.Background(themeSettings))
        end if
        themeChrome.WalkAndApply(root, ctx, 0)
    end sub

    sub WalkAndApply(node as dynamic, ctx as object, depth as integer)
        if depth > 40 or type(node) <> "roSGNode" then return
        themeChrome.ApplyToNode(node, ctx)
        childCount = node.getChildCount()
        for i = 0 to childCount - 1
            themeChrome.WalkAndApply(node.getChild(i), ctx, depth + 1)
        end for
    end sub

    sub ApplyToNode(node as object, ctx as object)
        accentColor = invalid
        onAccentColor = invalid
        if ctx.active
            accentColor = ctx.accent
            onAccentColor = ctx.onAccent
        end if

        themeChrome.ApplyColorField(node, "focusBitmapBlendColor", "themeBaseFocusBitmapColor", accentColor, ctx.active)
        themeChrome.ApplyColorField(node, "focusFootprintBlendColor", "themeBaseFocusFootprintColor", accentColor, ctx.active)
        themeChrome.ApplyColorField(node, "focusedTextColor", "themeBaseFocusedTextColor", onAccentColor, ctx.active)
        themeChrome.ApplyColorField(node, "focusedIconColor", "themeBaseFocusedIconColor", onAccentColor, ctx.active)

        if node.hasField("color") and node.hasField("text")
            if ctx.active
                themeChrome.CaptureBaseColor(node, "color", "themeBaseTextColor")
                baseColor = node.color
                if node.hasField("themeBaseTextColor") then baseColor = node.getFields()["themeBaseTextColor"]
                remapped = themeChrome.RemapNeutralText(baseColor, ctx.textRgb, ctx.backgroundRgb)
                if isValidAndNotEmpty(remapped) then node.color = remapped
            else
                themeChrome.RestoreColorField(node, "color", "themeBaseTextColor")
            end if
        end if
    end sub

    sub ApplyColorField(node as object, fieldName as string, baseFieldName as string, themedColor as dynamic, active as boolean)
        if not node.hasField(fieldName) then return
        if active
            themeChrome.CaptureBaseColor(node, fieldName, baseFieldName)
            node.setField(fieldName, themedColor)
        else
            themeChrome.RestoreColorField(node, fieldName, baseFieldName)
        end if
    end sub

    sub CaptureBaseColor(node as object, fieldName as string, baseFieldName as string)
        if node.hasField(baseFieldName) then return
        original = node.getFields()[fieldName]
        if not isValid(original) then return
        node.addField(baseFieldName, "color", false)
        if node.hasField(baseFieldName) then node.setField(baseFieldName, original)
    end sub

    sub RestoreColorField(node as object, fieldName as string, baseFieldName as string)
        if not node.hasField(baseFieldName) then return
        node.setField(fieldName, node.getFields()[baseFieldName])
    end sub

    function RgbParts(colorString as string) as object
        hex = themeChrome.BareHex(colorString)
        while hex.len() < 8
            hex = hex + "F"
        end while
        return {
            r: val(hex.mid(0, 2), 16),
            g: val(hex.mid(2, 2), 16),
            b: val(hex.mid(4, 2), 16)
        }
    end function

    ' Colours reach here written both ways, as the six digits a plugin sends and as the eight a
    ' theme setting holds, so the prefix goes and what is left is the digits
    function BareHex(colorString as string) as string
        hex = colorString.trim()
        if hex.left(1) = "#" then hex = hex.mid(1)
        if LCase(hex.left(2)) = "0x" then hex = hex.mid(2)
        return hex
    end function

    ' The same colour at a chosen strength
    function WithAlpha(colorString as string, alphaHex as string) as string
        hex = themeChrome.BareHex(colorString)
        while hex.len() < 6
            hex = hex + "0"
        end while

        return "#" + hex.mid(0, 6) + alphaHex
    end function

    function IntParts(colorInt as dynamic) as dynamic
        colorType = type(colorInt)
        if colorType <> "Integer" and colorType <> "roInt" and colorType <> "LongInteger" and colorType <> "roLongInteger" then return invalid

        c = colorInt * 1.0
        if c < 0 then c = c + 4294967296.0
        r = int(c / 16777216.0)
        c = c - r * 16777216.0
        g = int(c / 65536.0)
        c = c - g * 65536.0
        b = int(c / 256.0)
        a = int(c - b * 256.0)
        return { r: r, g: g, b: b, a: a }
    end function

    function ByteToHex(value as integer) as string
        digits = "0123456789ABCDEF"
        hi = int(value / 16)
        lo = value mod 16
        return digits.mid(hi, 1) + digits.mid(lo, 1)
    end function

    ' What a line of ordinary text needs against the surface behind it
    const MIN_LIGHT_INK_CONTRAST = 4.5

    function Channel(value as float) as float
        v = value / 255.0
        if v <= 0.03928 then return v / 12.92
        return ((v + 0.055) / 1.055) ^ 2.4
    end function

    function Luminance(parts as object) as float
        return 0.2126 * Channel(parts.r) + 0.7152 * Channel(parts.g) + 0.0722 * Channel(parts.b)
    end function

    function ContrastWithWhite(parts as object) as float
        return 1.05 / (Luminance(parts) + 0.05)
    end function

    ' A colour taken down until light text reads against it, keeping its hue.
    '
    ' A theme names anything from near white to a saturated cyan for a focused fill. Dark text on
    ' the bright ones measures well and still reads muddy across a room, so the fill is deepened
    ' and keeps the light text the rows around it already use. Something dark enough comes back
    ' as it is.
    function DeepenForLightInk(colorString as string) as string
        parts = themeChrome.RgbParts(colorString)

        ' Fifteen percent a step reaches black from anywhere inside twenty, so this always ends
        tries = 0
        while tries < 20 and themeChrome.ContrastWithWhite(parts) < MIN_LIGHT_INK_CONTRAST
            parts = { r: parts.r * 0.85, g: parts.g * 0.85, b: parts.b * 0.85 }
            tries++
        end while

        return "#" + themeChrome.ByteToHex(Int(parts.r)) + themeChrome.ByteToHex(Int(parts.g)) + themeChrome.ByteToHex(Int(parts.b)) + "FF"
    end function

    ' Neutral text keeps its original brightness when it takes on the theme color.
    function RemapNeutralText(colorInt as dynamic, textRgb as object, backgroundRgb as object) as dynamic
        parts = themeChrome.IntParts(colorInt)
        if not isValid(parts) then return invalid
        if parts.a = 0 then return invalid

        highest = parts.r
        if parts.g > highest then highest = parts.g
        if parts.b > highest then highest = parts.b
        lowest = parts.r
        if parts.g < lowest then lowest = parts.g
        if parts.b < lowest then lowest = parts.b
        if highest - lowest > 24 then return invalid

        brightness = (parts.r + parts.g + parts.b) / 765.0
        newR = int(textRgb.r * brightness + backgroundRgb.r * (1.0 - brightness))
        newG = int(textRgb.g * brightness + backgroundRgb.g * (1.0 - brightness))
        newB = int(textRgb.b * brightness + backgroundRgb.b * (1.0 - brightness))

        return "0x" + themeChrome.ByteToHex(newR) + themeChrome.ByteToHex(newG) + themeChrome.ByteToHex(newB) + themeChrome.ByteToHex(parts.a)
    end function

end namespace

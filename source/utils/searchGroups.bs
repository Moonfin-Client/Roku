import "pkg:/source/utils/misc.bs"

' The media type groups search results are sorted into, in the order the other
' clients show them. Each result goes into the group that lists its type, and
' anything of a type no group claims is left out.
namespace searchGroups

    const RESULT_CAP = 24

    const ASPECT_POSTER = "poster"
    const ASPECT_WIDE = "wide"
    const ASPECT_SQUARE = "square"

    function Catalogue() as object
        return [
            { key: "books", title: tr("Books"), types: ["book"] },
            { key: "movies", title: tr("Movies"), types: ["movie"] },
            { key: "series", title: tr("Series"), types: ["series"] },
            { key: "seasons", title: tr("Seasons"), types: ["season"] },
            { key: "episodes", title: tr("Episodes"), types: ["episode"] },
            { key: "videos", title: tr("Videos"), types: ["video"] },
            { key: "musicVideos", title: tr("Music Videos"), types: ["musicvideo"] },
            { key: "trailers", title: tr("Trailers"), types: ["trailer"] },
            { key: "programs", title: tr("Programs"), types: ["program"] },
            { key: "channels", title: tr("Channels"), types: ["tvchannel", "livetvchannel"] },
            { key: "playlists", title: tr("Playlists"), types: ["playlist"] },
            { key: "artists", title: tr("Artists"), types: ["musicartist", "albumartist"] },
            { key: "albums", title: tr("Albums"), types: ["musicalbum"] },
            { key: "songs", title: tr("Songs"), types: ["audio"] },
            { key: "photoAlbums", title: tr("Photo Albums"), types: ["photoalbum"] },
            { key: "photos", title: tr("Photos"), types: ["photo"] },
            { key: "collections", title: tr("Collections"), types: ["boxset"] },
            { key: "people", title: tr("People"), types: ["person"] },
            { key: "folders", title: tr("Folders"), types: ["folder", "collectionfolder", "userview"] }
        ]
    end function

    ' Sixteen by nine for the video shaped types, square for music and people,
    ' and a poster for everything else
    function AspectFor(itemType as string) as string
        lowered = LCase(itemType)

        for each entry in ["episode", "program", "recording", "video", "musicvideo"]
            if lowered = entry then return searchGroups.ASPECT_WIDE
        end for

        for each entry in ["musicalbum", "audio", "musicartist", "albumartist", "playlist", "person"]
            if lowered = entry then return searchGroups.ASPECT_SQUARE
        end for

        return searchGroups.ASPECT_POSTER
    end function

    ' How wide a card is, and how tall the artwork on it stands
    function CardSize(aspect as string) as object
        if aspect = searchGroups.ASPECT_WIDE then return { width: 218, image: 123 }
        if aspect = searchGroups.ASPECT_SQUARE then return { width: 218, image: 218 }

        return { width: 157, image: 235 }
    end function

end namespace

import "pkg:/source/utils/misc.bs"

' The facts panel Seerr fills in beside a title. Which facts exist depends on the media type
' and on what the server actually filled in, so anything missing is left out rather than
' shown blank.
namespace seerrFacts

    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    const PER_LINE = 3
    const LINE_HEIGHT = 64
    const LOGO_BASE = "https://image.tmdb.org/t/p/w92"
    const LOGO_SIZE = 64
    const NAME_SIZE = 22
    const PROVIDER_WIDTH = 150
    const PROVIDER_HEIGHT = 136

    ' Seerr dates arrive as YYYY-MM-DD
    function FormatDate(dateString as dynamic) as string
        if not isValidAndNotEmpty(dateString) then return ""

        parts = dateString.split("-")
        if parts.count() <> 3 then return dateString

        month = parts[1].toInt()
        if month < 1 or month > 12 then return dateString

        return `${seerrFacts.MONTHS[month - 1]} ${parts[2].toInt()}, ${parts[0]}`
    end function

    ' Seerr reports budget and revenue in US dollars whatever the viewer's locale
    function FormatCurrency(amount as dynamic) as string
        value = seerrFacts.Positive(amount)
        if value = 0 then return ""

        digits = value.toStr()
        formatted = "$"
        length = len(digits)

        for i = 0 to length - 1
            formatted += digits.mid(i, 1)
            remaining = length - i - 1
            if remaining > 0 and remaining mod 3 = 0 then formatted += ","
        end for

        return formatted
    end function

    ' Seerr reports runtime in minutes
    function FormatRuntime(minutes as dynamic) as string
        total = seerrFacts.Positive(minutes)
        if total = 0 then return ""

        hours = int(total / 60)
        mins = total mod 60
        if hours = 0 then return `${mins}m`
        if mins > 0 then return `${hours}h ${mins}m`
        return `${hours}h`
    end function

    ' Seerr leaves an unknown number as 0 or null rather than omitting it
    function Positive(value as dynamic) as integer
        if not isValid(value) then return 0
        number = int(val(value.toStr()))
        if number <= 0 then return 0
        return number
    end function

    function Build(details as object, mediaType as string) as object
        facts = []
        if not isValid(details) then return facts

        isTv = isStringEqual(mediaType, "tv")

        score = seerrFacts.Positive(details.voteAverage)
        if score > 0 then facts.push({ label: tr("TMDB Score"), value: `${score * 10}%` })

        ' Seerr sends a numeric status code for some titles, which says nothing to a viewer
        if isValid(details.status) and type(details.status) = "roString" and details.status <> ""
            facts.push({ label: tr("Status"), value: details.status })
        end if

        airDate = seerrFacts.FormatDate(isTv ? details.firstAirDate : details.releaseDate)
        if airDate <> ""
            facts.push({ label: isTv ? tr("First Air Date") : tr("Release Date"), value: airDate })
        end if

        budget = seerrFacts.FormatCurrency(details.budget)
        if budget <> "" then facts.push({ label: tr("Budget"), value: budget })

        revenue = seerrFacts.FormatCurrency(details.revenue)
        if revenue <> "" then facts.push({ label: tr("Revenue"), value: revenue })

        runtime = seerrFacts.FormatRuntime(details.runtime)
        if runtime <> "" then facts.push({ label: tr("Runtime"), value: runtime })

        if isTv
            seasons = seerrFacts.Positive(details.numberOfSeasons)
            if seasons > 0 then facts.push({ label: tr("Seasons"), value: seasons.toStr() })

            episodes = seerrFacts.Positive(details.numberOfEpisodes)
            if episodes > 0 then facts.push({ label: tr("Episodes"), value: episodes.toStr() })
        end if

        return facts
    end function

    ' The facts a few to a line, each a faint label over its value. Returns how tall they run.
    function DrawGrid(parent as object, facts as object, width as float) as float
        columnWidth = width / seerrFacts.PER_LINE
        for i = 0 to facts.count() - 1
            x = (i mod seerrFacts.PER_LINE) * columnWidth
            y = int(i / seerrFacts.PER_LINE) * seerrFacts.LINE_HEIGHT

            label = parent.createChild("Label")
            label.text = facts[i].label
            label.font = "font:SmallestBoldSystemFont"
            label.color = "0xFFFFFF66"
            label.width = columnWidth
            label.height = 26
            label.translation = [x, y]

            value = parent.createChild("Label")
            value.text = facts[i].value
            value.font = "font:SmallSystemFont"
            value.color = "0xFFFFFFD9"
            value.width = columnWidth
            value.height = 30
            value.translation = [x, y + 26]
        end for

        return int((facts.count() + seerrFacts.PER_LINE - 1) / seerrFacts.PER_LINE) * seerrFacts.LINE_HEIGHT
    end function

    ' The services a title streams on, each logo named under it since a TV has no hover to name
    ' it. Returns how tall it runs.
    function DrawStreaming(parent as object, providers as object, width as float) as float
        if providers.count() = 0 then return 0

        heading = parent.createChild("Label")
        heading.text = tr("Streaming on")
        heading.font = "font:SmallestBoldSystemFont"
        heading.color = "0xFFFFFF66"
        heading.height = 26

        perLine = int(width / seerrFacts.PROVIDER_WIDTH)
        for i = 0 to providers.count() - 1
            x = (i mod perLine) * seerrFacts.PROVIDER_WIDTH
            y = 34 + int(i / perLine) * seerrFacts.PROVIDER_HEIGHT

            logo = parent.createChild("Poster")
            logo.width = seerrFacts.LOGO_SIZE
            logo.height = seerrFacts.LOGO_SIZE
            logo.loadDisplayMode = "scaleToFit"
            logo.translation = [x + (seerrFacts.PROVIDER_WIDTH - 16 - seerrFacts.LOGO_SIZE) / 2, y]
            if isValidAndNotEmpty(providers[i].logoPath) then logo.uri = seerrFacts.LOGO_BASE + providers[i].logoPath

            name = parent.createChild("Label")
            name.text = providers[i].name
            name.font = "font:SmallestSystemFont"
            name.font.size = seerrFacts.NAME_SIZE
            name.color = "0xFFFFFFB3"
            name.width = seerrFacts.PROVIDER_WIDTH - 16
            name.wrap = true
            name.maxLines = 2
            name.horizAlign = "center"
            name.translation = [x, y + seerrFacts.LOGO_SIZE + 6]
        end for

        return 34 + int((providers.count() + perLine - 1) / perLine) * seerrFacts.PROVIDER_HEIGHT
    end function

end namespace

import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/misc.bs"

' Studio logos always come from TMDB, through the plugin's server side cache. The library and
' TMDB rarely agree on punctuation or spacing, so names are matched without either.
namespace studioLogos

    function NormalizeName(name as dynamic) as string
        if not isValid(name) then return ""

        normalized = ""
        lower = LCase(name.toStr())
        for i = 0 to Len(lower) - 1
            ch = lower.Mid(i, 1)
            if (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") then normalized += ch
        end for
        return normalized
    end function

    ' The companies under both their exact and their normalized names. Two of them can share a
    ' normalized key, Apple TV and Apple TV+ for one, so the first of those wins and the exact
    ' name is what tells them apart.
    function Index(companies as dynamic) as object
        logos = { byName: {}, byNormalizedName: {} }
        if not isValidAndNotEmpty(companies) then return logos

        for each company in companies
            if chainLookupReturn(company, "hasLogo", false) <> true then continue for

            logo = moonfinPlugin.StudioImageURL(company.id)
            name = company.name ?? ""
            exact = LCase(name.Trim())
            if exact <> "" and not logos.byName.DoesExist(exact) then logos.byName[exact] = logo

            normalized = studioLogos.NormalizeName(name)
            if normalized <> "" and not logos.byNormalizedName.DoesExist(normalized) then logos.byNormalizedName[normalized] = logo
        end for
        return logos
    end function

    ' Exact names win, then normalized ones. Anything left has to share a start, because
    ' matching anywhere in the name once handed Netflix the logo of a company called X. The
    ' longest key wins so the closest name does.
    function LogoUrlFor(studioName as string, logos as object) as string
        exact = LCase(studioName.Trim())
        if logos.byName.DoesExist(exact) then return logos.byName[exact]

        normalized = studioLogos.NormalizeName(studioName)
        if normalized = "" then return ""
        if logos.byNormalizedName.DoesExist(normalized) then return logos.byNormalizedName[normalized]

        best = ""
        bestLength = 0
        for each key in logos.byNormalizedName
            shareStart = Left(key, Len(normalized)) = normalized or Left(normalized, Len(key)) = key
            if shareStart and Len(key) > bestLength
                bestLength = Len(key)
                best = logos.byNormalizedName[key]
            end if
        end for
        return best
    end function

end namespace

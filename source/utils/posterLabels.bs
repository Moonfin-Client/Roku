import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/plexUrls.bs"
import "pkg:/source/utils/serverCompatibility.bs"

' The labels a Moonbase admin puts on posters, such as 4K or VFQ. A row or grid asks for them in its
' task as its items load and hangs them on each node, so a card only draws what its node carries.
namespace posterLabels

    ' The plugin ignores anything past 200 ids in one request
    const BATCH_MAX = 200
    const TIMEOUT_MS = 8000

    ' A server without the route, with no rules or not answering isn't asked again for this long. Short
    ' enough that a first rule reaches people without a restart.
    const PAUSE_SECONDS = 300

    const SETTING = "ui.posterLabels"

    ' The server's own default, for a color that doesn't parse
    const FALLBACK_COLOR = &h2563EB

    ' The Material icons Moonbase can send that this app bundles
    const ICONS = "contrast hdr_on high_quality movie theaters aspect_ratio surround_sound speaker graphic_eq album translate subtitles record_voice_over star check_circle"

    ' The flags Moonbase can send as flag-xx. Roku can't draw SVG, so each one loads from Moonbase as
    ' an image.
    const FLAGS = "ad ae af ag ai al am ao aq ar arab as at au aw ax az ba bb bd be bf bg bh bi bj bl bm bn bo bq br bs bt bv bw by bz ca cc cd cefta cf cg ch ci ck cl cm cn co cp cr cu cv cw cx cy cz de dg dj dk dm do dz eac ec ee eg eh er es es-ct es-ga es-pv et eu fi fj fk fm fo fr ga gb gb-eng gb-nir gb-sct gb-wls gd ge gf gg gh gi gl gm gn gp gq gr gs gt gu gw gy hk hm hn hr ht hu ic id ie il im in io iq ir is it je jm jo jp ke kg kh ki km kn kp kr kw ky kz la lb lc li lk lr ls lt lu lv ly ma mc md me mf mg mh mk ml mm mn mo mp mq mr ms mt mu mv mw mx my mz na nc ne nf ng ni nl no np nr nu nz om pa pc pe pf pg ph pk pl pm pn pr ps pt pw py qa re ro rs ru rw sa sb sc sd se sg sh sh-ac sh-hl sh-ta si sj sk sl sm sn so sr ss st sv sx sy sz tc td tf tg th tj tk tl tm tn to tr tt tv tw tz ua ug um un us uy uz va vc ve vg vi vn vu wf ws xk ye yt za zm zw"

    ' Asks Moonbase about the server's own movies and episodes among the nodes and hangs each one's
    ' labels on it as posterLabels. A node with none gets no field at all. Runs in a task, and hands
    ' the nodes back.
    function Attach(nodes as dynamic) as dynamic
        if type(nodes) <> "roArray" or nodes.count() = 0 then return nodes

        home = serverIdentityKey(toString(get_url()))
        holders = {}
        ids = []
        for each node in nodes
            if type(node) = "roSGNode"
                id = posterLabels.ItemIdOf(node.LookupCI("json"), home)
                if id <> ""
                    if not holders.DoesExist(id)
                        holders[id] = []
                        ids.push(id)
                    end if
                    holders[id].push(node)
                end if
            end if
        end for
        ' Asked only now, since it reads the whole session and most rows have nothing to ask about
        if ids.count() = 0 or not posterLabels.Wanted() then return nodes

        found = posterLabels.Fetch(ids)
        for each id in found
            for each node in holders[id] ?? []
                if node.hasField("posterLabels")
                    node.posterLabels = found[id]
                else
                    node.addFields({ posterLabels: found[id] })
                end if
            end for
        end for
        return nodes
    end function

    function Wanted() as boolean
        if not moonfinPlugin.IsEnabled() then return false
        if not get_user_setting_bool(posterLabels.SETTING, true) then return false
        return not posterLabels.Paused()
    end function

    ' Kept on the global node, since every row asks from a task of its own
    sub Pause()
        m.global.posterLabelsPausedAt = UpTime(0)
    end sub

    function Paused() as boolean
        since = m.global.posterLabelsPausedAt ?? 0
        return since > 0 and UpTime(0) - since < posterLabels.PAUSE_SECONDS
    end function

    ' Each item's labels as the card draws them, keyed by item id, for the items that have any
    function Fetch(ids as object) as object
        found = {}
        lookups = invalid
        start = 0
        while start < ids.count()
            last = start + posterLabels.BATCH_MAX - 1
            if last >= ids.count() then last = ids.count() - 1
            batch = []
            for i = start to last
                batch.push(ids[i])
            end for
            start = last + 1

            ' The server shows each label only on the devices the admin picked
            response = requestResponse(APIRequest("/Moonfin/PosterBadges/Items", { ids: batch.join(","), profile: "tv" }), "GET", "", posterLabels.TIMEOUT_MS)

            ' A Moonbase without the route, or one that's down, waits out the pause rather than holding
            ' up every row that loads
            body = response.data
            if response.status <> 200 or type(body) <> "roAssociativeArray" or (body.LookupCI("enabled") ?? false) <> true
                posterLabels.Pause()
                return found
            end if

            perCorner = Int(Val(toString(body.LookupCI("maxPerCorner"))))
            if perCorner < 1 then perCorner = 2

            items = body.LookupCI("items")
            if type(items) = "roAssociativeArray" and items.count() > 0
                if lookups = invalid then lookups = posterLabels.Context(posterLabels.FlagsAt())
                for each id in items
                    labels = posterLabels.Shown(items[id], perCorner, lookups)
                    if labels.count() > 0 then found[id] = labels
                end for
            end if
        end while

        return found
    end function

    ' Flags load as plain images, and on Plex the companion serves them without a token
    function FlagsAt() as string
        if isPlexServer() then return plexUrls.MoonbaseOrigin(toString(get_url() ?? "")) + "/Moonfin/Assets/"
        return toString(buildURL("/Moonfin/Assets/"))
    end function

    ' What drawing a label needs to know, built once for a whole fetch. Flags are read from flagBase,
    ' and an empty one leaves them out.
    function Context(flagBase as string) as object
        return {
            icons: posterLabels.WordSet(posterLabels.ICONS),
            flags: posterLabels.WordSet(posterLabels.FLAGS),
            flagBase: flagBase,
            hex: CreateObject("roRegex", "^#[0-9A-Fa-f]{6}$", "")
        }
    end function

    function WordSet(words as string) as object
        found = {}
        for each word in words.Split(" ")
            found[word] = true
        end for
        return found
    end function

    ' The id to ask about, or empty for a card that isn't one of the server's own movies, episodes or
    ' videos.
    ' A Seerr title, an upcoming release or a Watching Now entry carries an id the server could
    ' mistake for one of its own.
    function ItemIdOf(json as dynamic, home as string) as string
        if type(json) <> "roAssociativeArray" then return ""
        if isValid(json.LookupCI("SeerrTmdbId")) or isValid(json.LookupCI("CalendarDate")) or isValid(json.LookupCI("WatchingNow")) then return ""

        kind = LCase(toString(json.LookupCI("Type")))
        if kind <> "movie" and kind <> "episode" and kind <> "video" and kind <> "musicvideo" then return ""

        ' Another server's item in a pooled row would be asked about on the wrong server
        owner = toString(json.LookupCI("_serverUrl"))
        if owner <> "" and serverIdentityKey(owner) <> home then return ""

        return toString(json.LookupCI("Id"))
    end function

    ' The labels a card draws, in the admin's order with at most perCorner in each corner. A label
    ' with no text and an icon this app doesn't know, from a server newer than the app, would draw as
    ' an empty pill, so it's left out.
    function Shown(raw as dynamic, perCorner as integer, lookups as object) as object
        kept = []
        if type(raw) <> "roArray" then return kept

        taken = {}
        for each badge in raw
            drawn = posterLabels.Entry(badge, lookups)
            if isValid(drawn)
                count = taken[drawn.corner] ?? 0
                if count < perCorner
                    taken[drawn.corner] = count + 1
                    kept.push(drawn)
                end if
            end if
        end for
        return kept
    end function

    ' One label with its colors worked out, or invalid when there's nothing to draw. Nothing in it is
    ' invalid, since invalid doesn't survive the trip into a node's field.
    function Entry(badge as dynamic, lookups as object) as dynamic
        if type(badge) <> "roAssociativeArray" then return invalid
        label = badge.LookupCI("label")
        if not isString(label) then return invalid

        text = label.Trim()

        icon = ""
        flag = ""
        name = LCase(toString(badge.LookupCI("icon")))
        if Left(name, 5) = "flag-"
            code = Mid(name, 6)
            if lookups.flagBase <> "" and lookups.flags.DoesExist(code) then flag = lookups.flagBase + "flag-" + code + ".webp"
        else if lookups.icons.DoesExist(name)
            icon = "pkg:/images/posterLabels/" + name + ".webp"
        end if
        if text = "" and icon = "" and flag = "" then return invalid

        corner = LCase(toString(badge.LookupCI("corner")))
        if corner <> "topright" and corner <> "bottomleft" and corner <> "bottomright" then corner = "topleft"

        shape = LCase(toString(badge.LookupCI("shape")))
        if shape <> "pill" and shape <> "square" then shape = "rounded"

        pill = {
            corner: corner,
            text: text,
            icon: icon,
            flag: flag,
            shape: shape,
            size: posterLabels.SizeFactor(LCase(toString(badge.LookupCI("size"))))
        }

        ' A flag alone is its own shape, with no fill or border
        if text = "" and flag <> ""
            pill.Append({ fill: "", border: "", textColor: "" })
            return pill
        end if

        rgb = posterLabels.ParseHex(badge.LookupCI("color"), lookups.hex)
        if rgb < 0 then rgb = posterLabels.FALLBACK_COLOR

        opacity = 100
        if isValid(badge.LookupCI("opacity")) then opacity = Int(Val(toString(badge.LookupCI("opacity"))))
        if opacity < 10 then opacity = 10
        if opacity > 100 then opacity = 100

        tones = posterLabels.Colors(LCase(toString(badge.LookupCI("style"))), rgb, opacity / 100)
        own = posterLabels.ParseHex(badge.LookupCI("textColor"), lookups.hex)
        if own >= 0 then tones.textColor = posterLabels.Tint(own, 1)

        pill.Append(tones)
        return pill
    end function

    function SizeFactor(size as string) as float
        if size = "small" then return 0.8
        if size = "large" then return 1.25
        if size = "xlarge" then return 1.5
        return 1.0
    end function

    ' Each style's fill, border and text colors. Opacity fades the fill and the border, never the text,
    ' so the text stays readable.
    function Colors(style as string, rgb as integer, alpha as float) as object
        white = "#FFFFFFFF"
        brightness = posterLabels.Luminance(rgb)
        own = posterLabels.Tint(rgb, 1)

        if style = "glass" then return { fill: posterLabels.Tint(rgb, 0.45 * alpha), border: posterLabels.Tint(&hFFFFFF, 0.35 * alpha), textColor: white }

        if style = "outline"
            textColor = own
            if brightness < 0.05 then textColor = white
            return { fill: posterLabels.Tint(0, 0.55 * alpha), border: posterLabels.Tint(rgb, alpha), textColor: textColor }
        end if

        if style = "dark"
            textColor = own
            if brightness < 0.05 then textColor = white
            return { fill: posterLabels.Tint(&h0C0C10, 0.85 * alpha), border: "", textColor: textColor }
        end if

        if style = "light"
            textColor = own
            if brightness > 0.4 then textColor = "#111111FF"
            return { fill: posterLabels.Tint(&hFFFFFF, 0.92 * alpha), border: "", textColor: textColor }
        end if

        ' The admin can pick any color, so the text goes black or white by the fill's brightness
        textColor = white
        if (brightness + 0.05) * (brightness + 0.05) > 0.15 then textColor = "#000000FF"
        return { fill: posterLabels.Tint(rgb, alpha), border: "", textColor: textColor }
    end function

    ' The color as an integer, or -1 when it isn't #RRGGBB
    function ParseHex(value as dynamic, hex as object) as integer
        text = toString(value)
        if not hex.IsMatch(text) then return -1
        return Val(Mid(text, 2), 16)
    end function

    ' Relative luminance, from 0 for black to 1 for white
    function Luminance(rgb as integer) as float
        weights = [0.2126, 0.7152, 0.0722]
        places = [65536, 256, 1]
        total = 0.0
        for i = 0 to 2
            channel = ((rgb \ places[i]) mod 256) / 255.0
            if channel <= 0.03928
                channel = channel / 12.92
            else
                channel = ((channel + 0.055) / 1.055) ^ 2.4
            end if
            total += weights[i] * channel
        end for
        return total
    end function

    ' A #RRGGBBAA color from an integer and an opacity
    function Tint(rgb as integer, alpha as float) as string
        value = Int(alpha * 255 + 0.5)
        if value < 0 then value = 0
        if value > 255 then value = 255

        color = "#"
        for each part in [(rgb \ 65536) mod 256, (rgb \ 256) mod 256, rgb mod 256, value]
            digits = UCase(StrI(part, 16))
            if Len(digits) < 2 then digits = "0" + digits
            color += digits
        end for
        return color
    end function

end namespace

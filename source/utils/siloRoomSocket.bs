' The Silo room socket's reconnect and clock rules (docs/watch-party.md sections 6.4 and 7.1),
' kept pure so test/silo-room-socket.bs can check them. Times are seconds.
namespace siloRoomSocket
    ' Waits between attempts are 0.5, 1, 2, then 5 seconds, each up to a quarter longer at random
    function BackoffSeconds(attempt as integer, jitter as double) as double
        base = 5#
        if attempt <= 1
            base = 0.5#
        else if attempt = 2
            base = 1#
        else if attempt = 3
            base = 2#
        end if
        if jitter < 0 then jitter = 0
        if jitter > 1 then jitter = 1
        return base * (1# + jitter * 0.25#)
    end function

    ' Six failures in a row, and nothing healthy for 150 seconds, is the end of it
    function GivesUp(failures as integer, secondsUnhealthy as double) as boolean
        return failures >= 6 and secondsUnhealthy >= 150#
    end function

    ' A socket open this long was the server's routine rotation, not an outage
    function IsRotation(openSeconds as double) as boolean
        return openSeconds >= 30#
    end function

    ' Answers that mean the party is over for this member, or this member may not join it
    function FinalStatus(status as integer) as boolean
        return status = 409 or status = 401 or status = 403 or status = 404 or status = 410
    end function

    ' The best sample is the one with the fastest round trip, as watchPartyModel.BestOffset picks it
    function BestSample(samples as object) as dynamic
        best = invalid
        for each sample in samples
            if best = invalid or sample.rtt < best.rtt then best = sample
        end for
        return best
    end function

    ' A new sample that disagrees with the best by more than both round trips' half plus 50 ms
    ' means the server's clock stepped, and the old samples no longer describe it
    function ClockStepped(best as object, sample as object) as boolean
        if best = invalid or sample = invalid then return false
        difference = best.offset - sample.offset
        if difference < 0 then difference = -difference
        return difference > (best.rtt + sample.rtt) / 2# + 0.05#
    end function

    ' More than three oversized messages within a minute, counting the latest
    function TooManyOversize(times as object, now as double) as boolean
        recent = 0
        for each at in times
            if now - at < 60# then recent = recent + 1
        end for
        return recent > 3
    end function
end namespace

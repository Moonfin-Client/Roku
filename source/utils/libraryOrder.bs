import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsIcons.bs"

' The order the viewer's libraries appear in on Home, the recently added rows and the nav. It is
' the server's own library order, kept in each account's OrderedViews, so every app signed in to
' the account follows it.
namespace libraryOrder

    ' A run of moves goes out as one write instead of one per move
    const SAVE_DELAY = 0.6

    ' The glyph a library leads with, by what it holds
    function Icon(library as object) as string
        collectionType = LCase(chainLookupReturn(library, "CollectionType", "") ?? "")
        if looksLikeGames(collectionType, chainLookupReturn(library, "Name", "")) then return settingsIcons.LibraryGlyph("games")
        return settingsIcons.LibraryGlyph(collectionType)
    end function

    ' The server decides which libraries hold games and Roku has no way to ask it, so a mixed
    ' library named for them counts, the way the server decides when nobody picked
    function looksLikeGames(collectionType as string, name as dynamic) as boolean
        if not isValidAndNotEmpty(name) then return false
        if collectionType <> "" and collectionType <> "mixed" and collectionType <> "unknown" then return false
        return CreateObject("roRegex", "game|rom|emulat", "i").IsMatch(name)
    end function

    ' Each server keeps the order of its own libraries, so with several servers a library only
    ' moves among the ones from its server. A single server is one group
    function serverOf(library as dynamic) as string
        return chainLookupReturn(library, "serverUrl", "") ?? ""
    end function

    function IsFirstOfServer(libraries as object, index as integer) as boolean
        return index = 0 or serverOf(libraries[index - 1]) <> serverOf(libraries[index])
    end function

    function IsLastOfServer(libraries as object, index as integer) as boolean
        return index = libraries.Count() - 1 or serverOf(libraries[index + 1]) <> serverOf(libraries[index])
    end function

    ' The list with one library moved to newIndex, or invalid when that would leave its server
    function Move(libraries as object, index as integer, newIndex as integer) as dynamic
        if index < 0 or index >= libraries.Count() or newIndex < 0 or newIndex >= libraries.Count() or index = newIndex then return invalid
        if serverOf(libraries[index]) <> serverOf(libraries[newIndex]) then return invalid

        moving = libraries[index]
        rest = []
        for i = 0 to libraries.Count() - 1
            if i <> index then rest.push(libraries[i])
        end for

        moved = []
        for i = 0 to rest.Count() - 1
            if i = newIndex then moved.push(moving)
            moved.push(rest[i])
        end for
        if newIndex = rest.Count() then moved.push(moving)
        return moved
    end function

    ' What each server is told, one group per server url (empty for a single server): the ids of
    ' its own libraries in the order on screen
    function ByServer(libraries as object) as object
        groups = []
        for each library in libraries
            serverUrl = serverOf(library)
            group = invalid
            for each candidate in groups
                if candidate.serverUrl = serverUrl then group = candidate
            end for
            if not isValid(group)
                group = { serverUrl: serverUrl, ids: [] }
                groups.push(group)
            end if
            group.ids.push(library.Id)
        end for
        return groups
    end function

    ' The libraries hidden from My Media on any of the accounts, as a set of ids
    function HiddenIds(configurations as object) as object
        hidden = {}
        for each configuration in configurations
            for each id in chainLookupReturn(configuration, "MyMediaExcludes", []) ?? []
                hidden[id] = true
            end for
        end for
        return hidden
    end function

end namespace

import "pkg:/source/utils/misc.bs"

' The studios and networks Seerr offers as browse tiles. They are a fixed list rather than
' anything the server holds, so both the discovery screen and the home row read them from
' here instead of each carrying their own copy.
namespace seerrBrowseRows

    ' Seerr draws these logos white on the tile, and the duotone filter is how it does it
    const LOGO_BASE = "https://image.tmdb.org/t/p/w780_filter(duotone,ffffff,bababa)"

    function LogoUrl(logoPath as dynamic) as string
        if not isValidAndNotEmpty(logoPath) then return ""

        return seerrBrowseRows.LOGO_BASE + logoPath
    end function

    function Studios() as object
        return [
            { id: 2, name: "Disney", logoPath: "/wdrCwmRnLFJhEoH8GSfymY85KHT.png" },

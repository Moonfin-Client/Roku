    ' The dark and light ends of the duotone TMDB draws a genre's backdrop in, the pairs Seerr
    ' gives each genre so two genres sharing a film still look apart
    function GenreTone(genreId as integer) as object
        black = ["1F2937", "D1D5DB"]
        red = ["991B1B", "FCA5A5"]
        darkred = ["1F2937", "F87171"]
        blue = ["032541", "01b4e4"]
        lightblue = ["1F2937", "60A5FA"]
        darkblue = ["1F2937", "2864d2"]
        orange = ["92400E", "FCD34D"]
        darkorange = ["552c01", "d47c1d"]
        lightgreen = ["065F46", "6EE7B7"]
        purple = ["5B21B6", "C4B5FD"]
        darkpurple = ["480c8b", "a96bef"]
        yellow = ["777e0d", "e4ed55"]
        pink = ["9D174D", "F9A8D4"]
        byId = {
            "28": red, "12": darkpurple, "16": blue, "35": orange, "80": darkblue,
            "99": lightgreen, "18": pink, "10751": yellow, "14": lightblue, "36": orange,
            "27": black, "10402": blue, "9648": purple, "10749": pink, "878": lightblue,
            "10770": red, "53": black, "10752": darkred, "37": orange, "10759": darkpurple,
            "10762": blue, "10763": black, "10764": darkorange, "10765": lightblue,
            "10766": pink, "10767": lightgreen, "10768": darkred
        }
        return byId[genreId.ToStr()] ?? black
    end function

    ' Seerr skips the front of the list, the most popular films, since a popular film sits in
    ' several genres and is what would show up twice
    function GenreBackdropUrl(genreId as integer, backdrops as dynamic) as string
        if type(backdrops) <> "roArray" or backdrops.Count() = 0 then return ""
        path = backdrops.Peek()
        if backdrops.Count() > 4 then path = backdrops[4]
        if not isValidAndNotEmpty(path) then return ""
        tone = seerrBrowseRows.GenreTone(genreId)
        return `https://image.tmdb.org/t/p/w1280_filter(duotone,${tone[0]},${tone[1]})${path}`
    end function

    ' Where a picked tile sends the viewer. SeerrGenreBrowseScreen already understands each
    ' of these, so a home row tile lands on the same screen the discovery screen opens.
    function BrowseScreenFor(browseType as string, id as integer, name as string, mediaType as string) as object
        screen = CreateObject("roSGNode", "SeerrGenreBrowseScreen")
        screen.browseType = browseType
        screen.genreId = id
        screen.genreName = name
        screen.mediaType = mediaType

        return screen
    end function

end namespace

    ' Where a picked tile sends the viewer. SeerrGenreBrowseScreen already understands each
    ' of these, so a home row tile lands on the same screen the discovery screen opens.
    function BrowseScreenFor(browseType as string, id as integer, name as string, mediaType as string) as object
        screen = CreateObject("roSGNode", "SeerrGenreBrowseScreen")
        screen.browseType = browseType
        screen.genreId = id
        screen.genreName = name
        screen.mediaType = mediaType

        return screen
    end function

end namespace

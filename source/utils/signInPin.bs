import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/pinLockout.bs"

' The PIN that holds the app shut once someone has signed in. It belongs to this Roku rather than
' to an account, the same as the switch that turns it on, and neither one syncs.
const SIGN_IN_PIN_ENABLED_KEY = "global.pinCodeProtection"
const SIGN_IN_PIN_HASH_KEY = "global.pinCodeHash"
' The PIN until someone chooses one
const SIGN_IN_DEFAULT_PIN = "0000"

namespace signInPin

    function Enabled() as boolean
        return get_setting(SIGN_IN_PIN_ENABLED_KEY, "false") = "true"
    end function

    function IsConfigured() as boolean
        return get_setting(SIGN_IN_PIN_HASH_KEY, "") <> ""
    end function

    function Matches(guess as string) as boolean
        return pinLockout.Matches(guess, get_setting(SIGN_IN_PIN_HASH_KEY, ""), SIGN_IN_DEFAULT_PIN)
    end function

    ' The PIN is stored as a hash from the first time it is entered, and a correct one clears the
    ' count of wrong guesses
    sub Unlocked(entered as string)
        if not signInPin.IsConfigured() then set_setting(SIGN_IN_PIN_HASH_KEY, pinLockout.HashPin(entered.Trim()))
        pinLockout.ClearLockout(pinLockout.SignInKeys())
    end sub

    ' Choosing a PIN forgets the guesses that came before it
    sub Save(pin as string)
        set_setting(SIGN_IN_PIN_HASH_KEY, pinLockout.HashPin(pin.Trim()))
        pinLockout.ClearLockout(pinLockout.SignInKeys())
    end sub

end namespace

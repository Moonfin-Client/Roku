import "pkg:/source/utils/misc.bs"

' The plugin stores a Material Symbols name per badge, quest and rank tier, and an admin can
' author a badge with any name at all. Every name the plugin ships has artwork under the folder
' below, and a Poster falls back to the trophy the plugin's own web UI uses for anything else,
' so nothing has to carry a list of what was drawn.

const ACHIEVEMENT_ICON_FALLBACK = "pkg:/images/achievements/emoji_events.png"
const ACHIEVEMENT_ICON_ALIASES_KEY = "moonfin.achievementIconAliases"

namespace achievementsIcons

    function PathFor(name as dynamic) as string
        if not isValidAndNotEmpty(name) then return ACHIEVEMENT_ICON_FALLBACK

        key = LCase(name.trim())
        if key = "" then return ACHIEVEMENT_ICON_FALLBACK

        key = achievementsIcons.Aliases()[key] ?? key
        return `pkg:/images/achievements/${key}.png`
    end function

    ' Names that draw the same glyph share one file, so these point at the name it was saved under.
    ' Built once per thread rather than for every icon.
    function Aliases() as object
        context = GetGlobalAA()
        table = context[ACHIEVEMENT_ICON_ALIASES_KEY]
        if table <> invalid then return table

        table = {
            "alert02": "warning",
            "aligncenter": "align_horizontal_center",
            "alignleft": "align_horizontal_left",
            "alignright": "align_horizontal_right",
            "appscontents": "view_carousel",
            "arrowlargedown": "vertical_align_bottom",
            "arrowupdown": "swap_vert",
            "aspectratio": "image_aspect_ratio",
            "audiotrack": "music_note",
            "auto_fix_high": "auto_awesome",
            "background": "blur_on",
            "bedtime": "nights_stay",
            "browser": "view_sidebar",
            "calendarbusy": "event_busy",
            "clock": "schedule",
            "colorpicker": "palette",
            "crop": "zoom_out_map",
            "download": "cloud_download",
            "edit": "border_color",
            "exit": "exit_to_app",
            "expandlabels": "unfold_more",
            "fifteenforward": "fast_forward",
            "files": "description",
            "filter": "filter_list",
            "folderupper": "folder_open",
            "fullscreen": "aspect_ratio",
            "gear": "settings",
            "heart": "favorite",
            "hide": "visibility_off",
            "hourglass_full": "hourglass_top",
            "imagesearch": "image_search",
            "light": "light_mode",
            "liveplay": "live_tv",
            "lockcircle": "shield",
            "mediaplayer": "live_tv",
            "movies": "movie",
            "music": "music_note",
            "newfeature": "star",
            "opacity": "contrast",
            "pausecircle": "pause_circle",
            "photo": "image",
            "picture": "image",
            "play": "play_arrow",
            "playcircle": "play_circle",
            "playspeed": "speed",
            "plug": "extension",
            "profile": "account_circle",
            "quality": "high_quality",
            "rewind": "fast_rewind",
            "scheduler": "schedule",
            "screenpower": "tv",
            "show": "visibility",
            "skip": "skip_next",
            "sound": "volume_up",
            "spanner": "tune",
            "speakergroup": "speaker_group",
            "sprout": "eco",
            "surround": "surround_sound",
            "sync": "refresh",
            "textinput": "format_size",
            "user": "person",
            "wifi4": "wifi",
            "zoomin": "zoom_in"
        }
        context[ACHIEVEMENT_ICON_ALIASES_KEY] = table
        return table
    end function

end namespace

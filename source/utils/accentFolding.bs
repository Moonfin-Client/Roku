' Folds accented Latin letters onto the plain letter behind them, so searching for "canco" or
' "canço" still turns up "Cançó". The server already does this for the searches it answers, so
' anything matched here has to fold too or the same query finds different things depending on
' which box ran it.
namespace accentFolding

    const CACHE_KEY = "moonfin.accentFolds"

    ' Each plain letter with every accented form that folds onto it. Anything left out, like ß,
    ' œ or a letter from another script, stays as it is.
    function groups() as object
        return [
            ["A", "ÀÁÂÃÄÅÆàáâãäåæĀāĂăĄą"],
            ["C", "ÇçĆćČč"],
            ["D", "ÐðĎďĐđ"],
            ["E", "ÈÉÊËèéêëĒēĖėĘęĚě"],
            ["I", "ÌÍÎÏìíîïĪīĮį"],
            ["L", "Łł"],
            ["N", "ÑñŃńŇň"],
            ["O", "ÒÓÔÕÖØòóôõöøŌōŐő"],
            ["S", "ŚśŞşŠš"],
            ["T", "Þþ"],
            ["U", "ÙÚÛÜùúûüŪūŮůŰű"],
            ["Y", "ÝýÿŸ"],
            ["Z", "ŹźŻżŽž"]
        ]
    end function

    ' Built once per thread rather than on every name
    function table() as object
        context = GetGlobalAA()
        cached = context[accentFolding.CACHE_KEY]
        if cached <> invalid then return cached

        letters = {}
        letters.SetModeCaseSensitive()
        for each group in accentFolding.groups()
            for i = 1 to Len(group[1])
                letters[Mid(group[1], i, 1)] = group[0]
            end for
        end for

        cached = { nonAscii: CreateObject("roRegex", "[^\x00-\x7F]", ""), letters: letters }
        context[accentFolding.CACHE_KEY] = cached
        return cached
    end function

    ' A name with nothing outside plain ASCII, which is nearly all of them, comes straight back
    function Fold(value as string) as string
        lookup = accentFolding.table()
        if not lookup.nonAscii.IsMatch(value) then return value

        folded = ""
        for i = 1 to Len(value)
            character = Mid(value, i, 1)
            if Asc(character) > 127
                plain = lookup.letters[character]
                if plain <> invalid then character = plain
            end if
            folded += character
        end for
        return folded
    end function

    function ForSearch(value as string) as string
        return LCase(accentFolding.Fold(value))
    end function

    ' The letter a name files under on the alphabet strip, # when it doesnt start with A to Z,
    ' or nothing for an empty name
    function StartLetter(name as string) as string
        first = UCase(accentFolding.Fold(Left(name.Trim(), 1)))
        if first = "" then return ""
        if first >= "A" and first <= "Z" then return first
        return "#"
    end function

end namespace

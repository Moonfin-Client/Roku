            { pluginColor: "neonPulseMagenta", rokuColor: "0xFF2E92" }
        ]
    end function

    ' A stored name can be camelCase or snake_case depending on what wrote it, so both sides
    ' of a comparison get flattened before matching
    function NormalizeColorName(name as dynamic) as string
        if not isValid(name) then return ""
        return LCase(name.toStr().Trim().Replace("_", ""))
    end function

    function IsSyncEnabled() as boolean
        if not moonfinPlugin.IsEnabled() then return false
        pluginInfo = m.global.session.pluginInfo
        if not isValid(pluginInfo) or not pluginInfo.installed then return false
        if not (pluginInfo.settingsSyncEnabled ?? false) then return false
        return toBoolean(chainLookupReturn(m.global.session, "user.settings.`plugin.settingsSync`", true))
    end function

    ' The profiles the server keeps
    function ProfileNames() as object
        return ["global", "desktop", "mobile", "tv"]
    end function

    ' A pick that isn't one of the server's profiles means this device's own
    function NormalizeProfile(value as dynamic) as string
        if type(value) <> "String" and type(value) <> "roString" then return settingsSync.DEVICE_PROFILE

        wanted = LCase(value.Trim())
        for each known in settingsSync.ProfileNames()
            if wanted = known then return known
        end for

        return settingsSync.DEVICE_PROFILE
    end function

    function ActiveProfile() as string
        return settingsSync.NormalizeProfile(get_user_setting(settingsSync.PROFILE_SETTING))
    end function

    ' Only changes where sync points, so nothing is pushed or pulled. Picking this device's own
    ' profile drops the pick, which leaves the device following it again.
    sub PickProfile(picked as dynamic)
        chosen = settingsSync.NormalizeProfile(picked)
        if chosen = settingsSync.DEVICE_PROFILE
            unset_user_setting(settingsSync.PROFILE_SETTING)
        else
            set_user_setting(settingsSync.PROFILE_SETTING, chosen)
        end if
    end sub

    ' The name a profile goes by on screen, for tr to translate
    function ProfileTitle(profileId as string) as string
        if profileId = "global" then return "Global"
        if profileId = "desktop" then return "Desktop"
        if profileId = "mobile" then return "Mobile"
        return "TV"
    end function

    function ProfilePath(profileId as string) as string
        return `/Moonfin/Settings/Profile/${profileId}`
    end function

    function ResolvedPath(profileId as string) as string
        return `/Moonfin/Settings/Resolved/${profileId}`
    end function

    ' The server can't clear the global profile while device profiles sit on top of it, so
    ' resetting global drops everything the user has stored there
    function ResetPath(profileId as string) as string
        if profileId = "global" then return "/Moonfin/Settings"
        return settingsSync.ProfilePath(profileId)
    end function

    ' Reads the active profile as the server resolves it and applies it here. Returns whether a
    ' profile arrived.
    function PullFromServer() as boolean
        if not settingsSync.IsSyncEnabled() then return false

        profile = settingsSync.FetchResolvedProfile(settingsSync.ActiveProfile())
        if not isValid(profile) then return false

        tmpSettings = m.global.session.user.settings
        mappings = settingsSync.GetMappings()

        for each mapping in mappings
            pluginValue = profile[mapping.pluginKey]
            if not isValid(pluginValue) then continue for

            rokuValue = settingsSync.PluginToRoku(pluginValue, mapping.type)
            if not isValid(rokuValue) then continue for

            tmpSettings[mapping.rokuKey] = toBoolean(rokuValue)
            if not chainLookupReturn(mapping, "skipRegistry", false)
                registry_write(mapping.rokuKey, rokuValue, m.global.session.user.id)
            end if
        end for

        appliedThemeId = tmpSettings["ui.theme.customThemeId"]
        if isValidAndNotEmpty(appliedThemeId)
            settingsSync.ApplyThemeColorsFromId(appliedThemeId, tmpSettings)
        end if

        if isValid(profile.seerrRows)
            ' The list names every row that is on, so a row it leaves out is off
            serverOrder = profile.seerrRows.rowOrder
            if type(serverOrder) = "roArray" or type(serverOrder) = "Array"
                for each entry in settingsSync.GetSeerrRowOrderNames()
                    rokuValue = inArray(serverOrder, entry.name) ? "true" : "false"
                    tmpSettings[entry.rokuKey] = rokuValue
                    registry_write(entry.rokuKey, rokuValue, m.global.session.user.id)
                end for
            end if

            ' The server can omit individual flags, so leave those settings at their current value
            for each rowMapping in settingsSync.GetSeerrRowMappings()
                pluginValue = profile.seerrRows[rowMapping.pluginKey]
                if not isValid(pluginValue) then continue for

                rokuValue = settingsSync.PluginToRoku(pluginValue, "bool")
                if not isValid(rokuValue) then continue for

                tmpSettings[rowMapping.rokuKey] = rokuValue
                registry_write(rowMapping.rokuKey, rokuValue, m.global.session.user.id)
            end for
        end if

        ' The layout arrives as sections, which unlike the flat order can say a row is off
        ' and can carry the rows a plugin contributes
        applied = settingsSync.ApplyHomeSections(tmpSettings, profile.homeSections)

        settingsSync.SyncTogglesFromServerRows(tmpSettings, applied.sections, profile.homeRowOrder)

        ' A picked row answers to the switch for the list it came from, so a layout that
        ' turns such a row on turns its switch on too, the way picking one here does.
        ' Runs after the toggles above so the arriving rows always win.
        for each gateKey in applied.gates
            tmpSettings[gateKey] = "true"
            registry_write(gateKey, "true", m.global.session.user.id)
        end for

        session.user.Update("settings", tmpSettings)

        currentConfig = m.global.session.user.Configuration
        if isValid(currentConfig)
            configChanged = false
            if isValid(profile.subtitleMode)
                subMode = settingsSync.PluginToRoku(profile.subtitleMode, "subtitleModeFormat")
                if isValid(subMode)
                    currentConfig.AddReplace("SubtitleMode", subMode)
                    configChanged = true
                end if
            end if
            if isValid(profile.defaultSubtitleLanguage)
                subLang = profile.defaultSubtitleLanguage
                if isStringEqual(subLang, "anyLanguage") then subLang = ""
                currentConfig.AddReplace("SubtitleLanguagePreference", subLang)
                configChanged = true
            end if
            if isValid(profile.defaultAudioLanguage)
                audLang = settingsSync.PluginToRoku(profile.defaultAudioLanguage, "audioLanguage")
                if isStringEqual(audLang, "anyLanguage") then audLang = ""
                currentConfig.AddReplace("AudioLanguagePreference", audLang)
                configChanged = true
            end if
            if isValid(profile.preferDefaultAudioTrack)
                currentConfig.AddReplace("PlayDefaultAudioTrack", toBoolean(profile.preferDefaultAudioTrack))
                configChanged = true
            end if
            if configChanged
                session.user.Update("Configuration", currentConfig)
                ' Post the full configuration back so fields this client doesn't manage are preserved
                m.settingSyncTask = createObject("roSGNode", "PostTask")
                m.settingSyncTask.apiUrl = "/Users/Configuration"
                m.settingSyncTask.stringData = FormatJson(currentConfig)
                m.settingSyncTask.control = "RUN"
            end if
        end if

        if isValid(m.global) and m.global.hasField("overlaySettingsChanged")
            m.global.overlaySettingsChanged = m.global.overlaySettingsChanged + 1
        end if

        return true
    end function

    sub ApplyThemeColorsFromId(themeId as dynamic, tmpSettings as object)
        if not isValidAndNotEmpty(themeId) then return

        theme = themeRegistry.GetThemeById(themeId)
        if not isValid(theme) or not isValid(theme.colors) then return

        colors = theme.colors
        mappings = themeApply.TokenMappings()
        userId = m.global.session.user.id

        for each token in mappings
            colorValue = colors[token]
            if isValidAndNotEmpty(colorValue)
                for each rokuKey in mappings[token]
                    tmpSettings[rokuKey] = colorValue
                    registry_write(rokuKey, colorValue, userId)
                end for
            end if
        end for

        if isValidAndNotEmpty(colors.scrim)
            tmpSettings["ui.overlayColor"] = colors.scrim
            registry_write("ui.overlayColor", colors.scrim, userId)
        end if

        opacity = themeApply.ScrimOpacity(theme.scrimColor)
        if isValidAndNotEmpty(opacity)
            tmpSettings["ui.overlayOpacity"] = opacity
            registry_write("ui.overlayOpacity", opacity, userId)
        end if

        navCycle = themeApply.NavColorCycleJson(theme.navColorCycle)
        tmpSettings["ui.theme.navColorCycle"] = navCycle
        registry_write("ui.theme.navColorCycle", navCycle, userId)

        fontFamily = theme.fontFamily ?? ""
        tmpSettings["ui.theme.fontFamily"] = fontFamily
        registry_write("ui.theme.fontFamily", fontFamily, userId)

        onAccent = isValidAndNotEmpty(colors.onAccent) ? colors.onAccent : ""
        tmpSettings["ui.theme.onAccent"] = onAccent
        registry_write("ui.theme.onAccent", onAccent, userId)
    end sub

    ' What a render thread hands a PostTask, since it cannot make the request itself
    function ProfilePush(profileData as object) as object
        return {
            url: settingsSync.ProfilePath(settingsSync.ActiveProfile()),
            body: settingsSync.ProfileBody(profileData)
        }
    end function

    ' The keys are quoted so they keep their case on the device
    function ProfileBody(profileData as object) as string
        return FormatJson({ "profile": profileData, "clientId": "roku" })
    end function

    ' Prepare settings sync push data without making HTTP requests (render-thread safe).
    function PreparePush(rokuKey as string, rokuValue as dynamic) as dynamic
        if not settingsSync.IsSyncEnabled() then return invalid

        if Left(rokuKey, 10) = "seerr.row."
            return settingsSync.ProfilePush({ "seerrRows": settingsSync.SeerrRowsPayload(rokuKey, settingsSync.ToBooleanValue(rokuValue)) })
        end if

        mapping = settingsSync.FindMappingByRokuKey(rokuKey)
        if not isValid(mapping) then return invalid

        pluginValue = settingsSync.RokuToPlugin(rokuValue, mapping.type)
        if not isValid(pluginValue) then return invalid

        profileData = {}
        profileData[mapping.pluginKey] = pluginValue

        return settingsSync.ProfilePush(profileData)
    end function

    ' The server expects the whole seerrRows object, so every flag goes along with the one that
    ' changed, if any did
    function SeerrRowsPayload(changedKey = "" as string, changedValue = false as boolean) as object
        userSettings = m.global.session.user.settings
        rows = {}
        rows["rowOrder"] = settingsSync.SeerrRowOrder(changedKey, changedValue, userSettings)

        for each rowMapping in settingsSync.GetSeerrRowMappings()
            if rowMapping.rokuKey = changedKey
                rows[rowMapping.pluginKey] = changedValue
            else
                rows[rowMapping.pluginKey] = settingsSync.GetSeerrRowValue(rowMapping.rokuKey, true, userSettings)
            end if
        end for

        return rows
    end function

    ' Everything this device syncs, in the shape the server keeps it, for writing a whole
    ' profile at once. A setting with nothing stored here is left for the server to keep.
    function FullProfile() as object
        ' Read once, since a task pays for every trip to the session
        userSettings = m.global.session.user.settings
        profileData = {}
        for each mapping in settingsSync.GetMappings()
            if not chainLookupReturn(mapping, "receiveOnly", false)
                current = settingsSync.StoredValue(mapping.rokuKey, userSettings)
                if isValid(current)
                    pluginValue = settingsSync.RokuToPlugin(current, mapping.type)
                    if isValid(pluginValue) then profileData[mapping.pluginKey] = pluginValue
                end if
            end if
        end for

        profileData["seerrRows"] = settingsSync.SeerrRowsPayload()
        ' Both layout keys go together, since a row order arriving without sections makes the
        ' server drop the sections it holds
        profileData["homeSections"] = settingsSync.HomeSectionsPayload()
        profileData["homeRowOrder"] = homeRowLayout.Arranged()

        return profileData
    end function

    ' What this device holds for a setting. The session carries the settings.json default for
    ' anything never written.
    function StoredValue(key as string, userSettings as dynamic) as dynamic
        if isValid(userSettings) and isValid(userSettings[key]) then return userSettings[key]
        return get_user_setting(key)
    end function

    ' The whole home layout as the other clients read it. Every row this app knows goes over
    ' with its own enabled flag, a row behind an off switch going over as off, and rows
    ' belonging to the other clients keep the place the stored lists hold them in. Sections
    ' this app can't draw ride along exactly as they arrived.
    function HomeSectionsPayload() as object
        storedOrder = get_user_setting(homeRowLayout.ORDER_SETTING)
        storedHidden = get_user_setting(homeRowLayout.HIDDEN_SETTING)
        placed = buttonLayout.ToIds(storedOrder)
        off = buttonLayout.HiddenLookup(storedHidden)
        picked = homeRowLayout.DynamicLookup()
        toggles = homeRowLayout.RowToggles()
        serverKey = homeRowLayout.ServerId()

        ' The full catalogue rather than what the picker is offering, so a row behind an off
        ' switch keeps its place in the layout instead of vanishing from it
        known = homeRowLayout.Catalogue()
        for each entry in homeRowLayout.DynamicRows()
            known.push({ id: entry.id, label: entry.title })
        end for

        arranged = []
        hiddenKnown = []
        for each row in buttonLayout.Ordered(known, storedOrder)
            arranged.push(row.id)
            if not homeRowLayout.IsEnabled(row.id, placed, off, picked) then hiddenKnown.push(row.id)
        end for

        merged = buttonLayout.WithUnknownIds(known, arranged, hiddenKnown, storedOrder, storedHidden)

        offAll = {}
        for each id in merged.hidden
            offAll[id] = true
        end for

        sections = []
        order = 0

        for each id in merged.order
            enabled = not isValid(offAll[id])
            if enabled and not homeRowLayout.RowToggleOn(id, toggles) then enabled = false

            ' A picked collection, genre or playlist goes over as the record the other clients
            ' read, typed none the way they write it, since the row id alone can't say which
            ' item the row stands for
            entry = picked[LCase(id)]
            if isValid(entry)
                listEntry = homeRowLayout.SourceFor(entry.source)
                if enabled and isValid(listEntry) and not get_user_setting_bool(listEntry.gate, false) then enabled = false

                sections.push({
                    kind: "pluginDynamic",
                    type: "none",
                    enabled: enabled,
                    order: order,
                    serverId: serverKey,
                    pluginSource: entry.source,
                    pluginSection: isValid(listEntry) ? listEntry.section : entry.source,
                    pluginAdditionalData: entry.itemId,
                    pluginDisplayText: entry.title
                })
            else
                sections.push({ kind: "builtin", type: id, enabled: enabled, order: order })
            end if

            order++
        end for

        for each section in homeRowLayout.Passthrough()
            sections.push(section)
        end for

        return sections
    end function

    ' The keys this device keeps the synced settings under, the layout and the Seerr rows
    ' among them
    function LocalKeys() as object
        keys = []
        for each mapping in settingsSync.GetMappings()
            if not chainLookupReturn(mapping, "receiveOnly", false) then keys.push(mapping.rokuKey)
        end for

        for each entry in settingsSync.GetSeerrRowOrderNames()
            keys.push(entry.rokuKey)
        end for

        keys.Append([homeRowLayout.HIDDEN_SETTING, homeRowLayout.DYNAMIC_SETTING, homeRowLayout.PASSTHROUGH_SETTING])
        return keys
    end function

    ' Puts every synced setting back the way a device that never synced has it, which is the
    ' default settings.json gives it, or nothing stored at all
    sub RestoreLocalDefaults()
        userId = m.global.session.user.id
        if not isValidAndNotEmpty(userId) then return

        defaults = {}
        configTree = GetConfigTree()
        if isValid(configTree) then session.user.settings.CollectDefaults(configTree, defaults)

        tmpSettings = m.global.session.user.settings
        reg = CreateObject("roRegistrySection", userId)
        for each key in settingsSync.LocalKeys()
            reg.Delete(key)
            if defaults.DoesExist(key)
                tmpSettings[key] = defaults[key]
            else
                tmpSettings.Delete(key)
            end if
        end for
        reg.Flush()

        ' A device that never picked a theme draws the Moonfin one, so its colours come back too
        tmpSettings["ui.theme.customThemeId"] = "moonfin"
        registry_write("ui.theme.customThemeId", "moonfin", userId)
        settingsSync.ApplyThemeColorsFromId("moonfin", tmpSettings)

        session.user.Update("settings", tmpSettings)
    end sub

    ' Seerr row flags live in a nested seerrRows object on the server, so they can't use
    ' the flat mapping table that GetMappings covers
    ' What each Seerr row is called in the list the other clients read. The names differ
    ' from the setting names in a couple of places, so they are spelled out rather than
    ' derived.
    function GetSeerrRowOrderNames() as object
        return [
            { rokuKey: "seerr.row.shortcuts", name: "shortcuts" },
            { rokuKey: "seerr.row.recent_requests", name: "recent_requests" },
            { rokuKey: "seerr.row.watchlist", name: "watchlist" },
            { rokuKey: "seerr.row.recently_added", name: "recently_added" },
            { rokuKey: "seerr.row.trending", name: "trending" },
            { rokuKey: "seerr.row.popular_movies", name: "popular_movies" },
            { rokuKey: "seerr.row.movie_genres", name: "movie_genres" },
            { rokuKey: "seerr.row.upcoming_movies", name: "upcoming_movies" },
            { rokuKey: "seerr.row.studios", name: "studios" },
            { rokuKey: "seerr.row.popular_tv", name: "popular_series" },
            { rokuKey: "seerr.row.series_genres", name: "series_genres" },
            { rokuKey: "seerr.row.upcoming_tv", name: "upcoming_series" },
            { rokuKey: "seerr.row.networks", name: "networks" }
        ]
    end function

    ' The rows that are on, in the order the list names them
    function SeerrRowOrder(changedKey = "" as string, changedValue = false as boolean, userSettings = invalid as dynamic) as object
        order = []
        for each entry in settingsSync.GetSeerrRowOrderNames()
            on = entry.rokuKey = changedKey ? changedValue : settingsSync.GetSeerrRowValue(entry.rokuKey, true, userSettings)
            if on then order.push(entry.name)
        end for

        return order
    end function

    function GetSeerrRowMappings() as object
        return [
            ' Seerr serves movie and TV trending from one endpoint, so the single row here
            ' drives both flags the server keeps
            { rokuKey: "seerr.row.trending", pluginKey: "trendingMovies" },
            { rokuKey: "seerr.row.trending", pluginKey: "trendingTv" },
            { rokuKey: "seerr.row.popular_movies", pluginKey: "popularMovies" },
            { rokuKey: "seerr.row.popular_tv", pluginKey: "popularTv" },
            { rokuKey: "seerr.row.upcoming_movies", pluginKey: "upcomingMovies" },
            { rokuKey: "seerr.row.upcoming_tv", pluginKey: "upcomingTv" }
        ]
    end function

    ' Takes the settings already read when there are many rows to look up, since each trip to the
    ' session copies all of them
    function GetSeerrRowValue(key as string, defaultValue = true as boolean, userSettings = invalid as dynamic) as boolean
        if not isValid(userSettings) then userSettings = m.global.session.user.settings
        if isValid(userSettings) and isValid(userSettings[key])
            return settingsSync.ToBooleanValue(userSettings[key], defaultValue)
        end if
        regVal = registry_read(key, m.global.session.user.id)
        if isValid(regVal)
            return settingsSync.ToBooleanValue(regVal, defaultValue)
        end if
        return defaultValue
    end function

    ' Coerces a stored setting into a real boolean. Settings arrive as either "true"/"false"
    ' strings or actual booleans depending on where they were written
    function ToBooleanValue(value as dynamic, defaultValue = false as boolean) as boolean
        if not isValid(value) then return defaultValue

        valueType = type(value)
        if valueType = "Boolean" or valueType = "roBoolean" then return value
        if valueType = "String" or valueType = "roString" then return LCase(value) = "true"

        return defaultValue
    end function

    function FindMappingByRokuKey(rokuKey as string) as object
        mappings = settingsSync.GetMappings()
        for each mapping in mappings
            if mapping.rokuKey = rokuKey then return mapping
        end for
        return invalid
    end function

    ' The other clients name these sorts, and the value here goes into the query as it is
    function FavoritesSortFields() as object
        return [
            { name: "name", field: "SortName" },
            { name: "dateAdded", field: "DateCreated,SortName" },
            { name: "dateEpisodeAdded", field: "DateLastContentAdded,SortName" },
            { name: "premiereDate", field: "PremiereDate,SortName" },
            { name: "rating", field: "OfficialRating,SortName" },
            { name: "runtime", field: "Runtime,SortName" },
            { name: "random", field: "Random" },
            { name: "criticRating", field: "CriticRating,SortName" },
            { name: "communityRating", field: "CommunityRating,SortName" }
        ]
    end function

    ' Core also offers a bottom navbar, which this client has no bar for, so anything it
    ' cannot draw resolves to the top bar
    function NavbarPosition(value as dynamic) as string
        return LCase(value.toStr()) = "left" ? "left" : "top"
    end function

    ' Jellyfin's subtitle modes, which this app offers, and the words the other clients sync
    ' them as
    function SubtitleModes() as object
        return [
            { roku: "Default", plugin: "flagged" },
            { roku: "Smart", plugin: "foreign" },
            { roku: "OnlyForced", plugin: "forced" },
            { roku: "Always", plugin: "always" },
            { roku: "None", plugin: "none" }
        ]
    end function

    function PluginToRoku(pluginValue as dynamic, conversionType as string) as dynamic
        if conversionType = "direct"
            return pluginValue.toStr()
        else if conversionType = "detailStyle"
            return normalizeDetailScreenStyleToken(pluginValue)
        else if conversionType = "navbarPosition"
            return settingsSync.NavbarPosition(pluginValue)
        else if conversionType = "bool"
            if type(pluginValue) = "Boolean" or type(pluginValue) = "roBoolean"
                return pluginValue ? "true" : "false"
            end if
            return LCase(pluginValue.toStr())
        else if conversionType = "clockBehavior"
            ' The clock is a switch here and a three way choice on the server, where anything
            ' but never shows one
            return isStringEqual(pluginValue.toStr(), "never") ? "false" : "true"
        else if conversionType = "boolInvert"
            isTrue = false
            if type(pluginValue) = "Boolean" or type(pluginValue) = "roBoolean"
                isTrue = pluginValue
            else
                isTrue = (LCase(pluginValue.toStr()) = "true")
            end if
            return isTrue ? "false" : "true"
        else if conversionType = "intToStr"
            return pluginValue.toStr()
        else if conversionType = "secondsToMs"
            ' A reading under a second is already in seconds, since the smallest value stored
            ' as milliseconds is 1000
            raw = val(pluginValue.toStr())
            if raw <= 0 then return invalid
            if raw >= 1000 then raw = raw / 1000
            return int(raw).toStr()
        else if conversionType = "jsonArray"
            if type(pluginValue) = "roArray" or type(pluginValue) = "Array"
                return FormatJson(pluginValue)
            end if
            return pluginValue.toStr()
        else if conversionType = "jsonObjectArray"
            if type(pluginValue) = "roArray" or type(pluginValue) = "Array"
                return FormatJson(pluginValue)
            end if
            return "[]"
        else if conversionType = "opacityToPercent"
            percent = 50
            if type(pluginValue) = "Integer" or type(pluginValue) = "roInt" or type(pluginValue) = "roInteger"
                percent = pluginValue
            else if type(pluginValue) = "Float" or type(pluginValue) = "roFloat" or type(pluginValue) = "Double" or type(pluginValue) = "roDouble"
                percent = int(pluginValue)
            end if
            if percent < 0 then percent = 0
            if percent > 100 then percent = 100
            rokuFloat = percent / 100.0
            rounded = int(rokuFloat * 10 + 0.5) / 10.0
            if rounded = 0 then return "0.1"
            if rounded >= 1 then return "1.0"
            return rounded.toStr()

        else if conversionType = "maxVideoResolution"
            valStr = LCase(pluginValue.toStr())
            if valStr = "res480p" then return "480"
            if valStr = "res720p" then return "720"
            if valStr = "res1080p" then return "1080"
            if valStr = "res2160p" then return "2160"
            return "auto"
        else if conversionType = "stillWatchingBehavior"
            ' The plugin sends a preset, the Roku setting is minutes of inactivity
            valStr = LCase(pluginValue.toStr())
            if valStr = "short_" then return "60"
            if valStr = "medium" then return "90"
            if valStr = "long_" then return "150"
            if valStr = "verylong" then return "240"
            return "0"
        else if conversionType = "favoritesSortField"
            valStr = LCase(pluginValue.toStr())
            for each entry in settingsSync.FavoritesSortFields()
                if LCase(entry.name) = valStr then return entry.field
            end for
            return "Random"
        else if conversionType = "favoritesSortOrder"
            return LCase(pluginValue.toStr()) = "descending" ? "Descending" : "Ascending"
        else if conversionType = "mediaSegmentCountdown"
            return LCase(pluginValue.toStr())
        else if conversionType = "shuffleType"
            pluginStr = LCase(pluginValue.toStr())
            if pluginStr = "movies" then return "movies_only"
            if pluginStr = "tv" then return "tv_only"
            return "both"
        else if conversionType = "subtitleModeFormat"
            valStr = LCase(pluginValue.toStr())
            for each mode in settingsSync.SubtitleModes()
                ' Older builds of this app pushed Jellyfin's own names, so those still count
                if valStr = mode.plugin or valStr = LCase(mode.roku) then return mode.roku
            end for
            return invalid
        else if conversionType = "audioLanguage"
            valStr = pluginValue.toStr()
            if valStr = "" or LCase(valStr) = "auto" then return "anyLanguage"
            return valStr
        else if conversionType = "colorName"
            colorStr = settingsSync.NormalizeColorName(pluginValue)
            for each mapping in settingsSync.ColorMapping()
                if settingsSync.NormalizeColorName(mapping.pluginColor) = colorStr
                    return mapping.rokuColor
                end if
            end for
            ' Returning invalid keeps the stored colour instead of overwriting it with a name
            return invalid
        else if conversionType = "seasonalEffect"
            return seasonalEffects.ParseEffect(pluginValue)
        else if conversionType = "seasonalDensity"
            return seasonalEffects.ParseDensity(pluginValue)
        end if
        return invalid
    end function

    function RokuToPlugin(rokuValue as dynamic, conversionType as string) as dynamic
        rokuStr = rokuValue.toStr()

        if conversionType = "direct"
            return rokuStr
        else if conversionType = "detailStyle"
            ' This client's ids are exactly the enum names the Flutter client syncs,
            ' and Smart-TV normalizes names to its own tokens on the way in.
            return normalizeDetailScreenStyleToken(rokuStr)
        else if conversionType = "navbarPosition"
            return settingsSync.NavbarPosition(rokuStr)
        else if conversionType = "bool"
            return (LCase(rokuStr) = "true")
        else if conversionType = "clockBehavior"
            return LCase(rokuStr) = "true" ? "always" : "never"
        else if conversionType = "boolInvert"
            return not (LCase(rokuStr) = "true")
        else if conversionType = "intToStr"
            return val(rokuStr)
        else if conversionType = "secondsToMs"
            seconds = int(val(rokuStr))
            if seconds <= 0 then return invalid
            return seconds * 1000
        else if conversionType = "jsonArray"
            parsed = ParseJson(rokuStr)
            if type(parsed) = "roArray" or type(parsed) = "Array"
                return parsed
            end if
            return []
        else if conversionType = "jsonObjectArray"
            parsed = ParseJson(rokuStr)
            if type(parsed) = "roArray" or type(parsed) = "Array"
                return parsed
            end if
            return []
        else if conversionType = "opacityToPercent"
            rokuFloat = val(rokuStr)
            return int(rokuFloat * 100 + 0.5)

        else if conversionType = "favoritesSortField"
            for each entry in settingsSync.FavoritesSortFields()
                if LCase(entry.field) = LCase(rokuStr) then return entry.name
            end for
            return "random"
        else if conversionType = "favoritesSortOrder"
            return LCase(rokuStr) = "descending" ? "descending" : "ascending"

        else if conversionType = "maxVideoResolution"
            ' Roku offers steps the plugin has no name for, so those report as auto
            if rokuStr = "480" then return "res480p"
            if rokuStr = "720" then return "res720p"
            if rokuStr = "1080" then return "res1080p"
            if rokuStr = "2160" then return "res2160p"
            return "auto"
        else if conversionType = "stillWatchingBehavior"
            minutes = int(val(rokuStr))
            if minutes <= 0 then return "disabled"
            if minutes <= 60 then return "short_"
            if minutes <= 90 then return "medium"
            if minutes <= 150 then return "long_"
            return "veryLong"
        else if conversionType = "mediaSegmentCountdown"
            if LCase(rokuStr) = "progressbar" then return "progressBar"
            return LCase(rokuStr)
        else if conversionType = "shuffleType"
            if rokuStr = "movies_only" then return "movies"
            if rokuStr = "tv_only" then return "tv"
            return "both"
        else if conversionType = "subtitleModeFormat"
            for each mode in settingsSync.SubtitleModes()
                if isStringEqual(rokuStr, mode.roku) then return mode.plugin
            end for
            return invalid
        else if conversionType = "audioLanguage"
            if rokuStr = "" or isStringEqual(rokuStr, "anyLanguage") then return "auto"
            return rokuStr
        else if conversionType = "colorName"
            colorStr = UCase(rokuStr.Trim())
            for each mapping in settingsSync.ColorMapping()
                if UCase(mapping.rokuColor) = colorStr
                    return mapping.pluginColor
                end if
            end for
            ' Returning invalid skips the push, since a nameless colour would clear the server value
            return invalid
        else if conversionType = "seasonalEffect"
            return seasonalEffects.ParseEffect(rokuStr)
        else if conversionType = "seasonalDensity"
            return seasonalEffects.ParseDensity(rokuStr)
        end if
        return invalid
    end function

    function FetchResolvedProfile(profileId as string) as object
        req = APIRequest(settingsSync.ResolvedPath(profileId))
        if not isValid(req) then return invalid

        result = getJson(req)
        if not isValid(result) then return invalid

        return moonfinPlugin.normalizeKeys(result)
    end function

    ' The server merges what arrives into the profile, so only the settings sent are written
    function SaveProfile(profileId as string, profileData as object) as boolean
        req = APIRequest(settingsSync.ProfilePath(profileId))
        if not isValid(req) then return false

        return postVoid(req, settingsSync.ProfileBody(profileData))
    end function

    function DeleteProfile(profileId as string) as boolean
        req = APIRequest(settingsSync.ResetPath(profileId))
        if not isValid(req) then return false

        req.SetRequest("DELETE")
        status = requestResponse(req, "DELETE").status
        return status >= 200 and status < 300
    end function

    ' Which switches a pushed layout is allowed to move, keyed by the row id the server
    ' uses. Narrower than the gating table on purpose. A row the layout has off would
    ' otherwise switch its whole feature off, and the picker hides a row whose feature is
    ' off, leaving no way back. The Seerr rows are left out because seerrRows.rowOrder
    ' already carries them, and two writers would fight over the same settings.
    function GetRowToggleMappings() as object
        driven = [
            "imdb_top_250_movies", "imdb_top_250_tv_shows", "imdb_most_popular_movies",
            "imdb_most_popular_tv_shows", "imdb_lowest_rated_movies", "imdb_top_english_movies",
            "tmdb_popular_movies", "tmdb_top_rated_movies", "tmdb_now_playing_movies",
            "tmdb_upcoming_movies", "tmdb_popular_tv", "tmdb_top_rated_tv",
            "tmdb_airing_today_tv", "tmdb_on_the_air_tv", "tmdb_trending_movie_daily",
            "tmdb_trending_movie_weekly", "tmdb_trending_tv_daily", "tmdb_trending_tv_weekly",
            "tmdb_trending_all_weekly",
            "favorites", "collections", "genres", "playlists", "audio", "rewatch", "seasonal"
        ]

        toggles = homeRowLayout.RowToggles()
        mappings = {}
        for each rowId in driven
            if isValid(toggles[rowId]) then mappings[rowId] = toggles[rowId]
        end for

        return mappings
    end function

    ' CollectRowStates: Reads how the server wants each row set. Resolved rows carry an
    ' explicit enabled flag so they win over the ordered id list, which can only say a row
    ' is present.
    '
    ' @param {object} rows - Resolved rows, each with an id and an enabled flag
    ' @param {object} rowOrder - Ordered row ids, used when no resolved rows arrived
    ' @return {object} row id to enabled state, holding only the rows the server mentioned
    function CollectRowStates(rows as object, rowOrder as object) as object
        states = {}

        if type(rows) = "roArray" or type(rows) = "Array"
            for each row in rows
                rowId = chainLookupReturn(row, "type", chainLookupReturn(row, "id", ""))
                if type(rowId) <> "String" and type(rowId) <> "roString" then continue for
                if rowId = "" then continue for

                rowId = LCase(rowId)

                states[rowId] = settingsSync.ToBooleanValue(chainLookupReturn(row, "enabled", true), true)
            end for
        end if

        if states.Count() > 0 then return states

        if type(rowOrder) = "roArray" or type(rowOrder) = "Array"
            for each rowId in rowOrder
                if type(rowId) <> "String" and type(rowId) <> "roString" then continue for
                if rowId = "" then continue for
                states[LCase(rowId)] = true
            end for
        end if

        return states
    end function

    ' ApplyHomeSections: Turns the layout the server holds into the lists this app arranges
    ' its rows from, so the picker and the home screen need no further translation. A picked
    ' collection, genre or playlist arrives as a pluginDynamic section and becomes the same
    ' record the local picker writes, so the row loads like one picked here. Sections this
    ' app cannot draw are kept aside verbatim for the next save to hand back. Returns the
    ' sections and the list switches the enabled picked rows depend on.
    '
    ' @param {object} tmpSettings - Settings map the caller commits once it finishes
    ' @param {dynamic} sections - homeSections from the resolved profile
    function ApplyHomeSections(tmpSettings as object, sections as dynamic) as object
        applied = { sections: [], gates: [] }
        if type(sections) <> "roArray" and type(sections) <> "Array" then return applied
        if sections.Count() = 0 then return applied

        applied.sections = sections

        order = []
        hidden = []
        dynamicRows = []
        passthrough = []
        gates = {}
        serverKey = homeRowLayout.ServerId()

        for each section in sections
            if LCase(homeRowLayout.AsText(chainLookupReturn(section, "kind", ""))) = "plugindynamic"
                picked = settingsSync.PickedRowFromSection(section, serverKey)
                if not isValid(picked)
                    passthrough.push(section)
                    continue for
                end if

                order.push(picked.id)
                if not picked.enabled then hidden.push(picked.id)
                dynamicRows.push({ id: picked.id, source: picked.source, itemId: picked.itemId, title: picked.title })
                if picked.enabled then gates[picked.gate] = true
                continue for
            end if

            rowType = chainLookupReturn(section, "type", "")
            if type(rowType) <> "String" and type(rowType) <> "roString" then continue for

            rowId = LCase(rowType)
            if not isValidAndNotEmpty(rowId) or rowId = "none" then continue for

            order.push(rowId)
            if not settingsSync.ToBooleanValue(chainLookupReturn(section, "enabled", true), true)
                hidden.push(rowId)
            end if
        end for

        userId = m.global.session.user.id

        writes = [
            { key: homeRowLayout.DYNAMIC_SETTING, value: dynamicRows },
            { key: homeRowLayout.PASSTHROUGH_SETTING, value: passthrough }
        ]

        ' A layout of nothing but sections this app cannot draw leaves the rows alone
        if order.Count() > 0
            writes.push({ key: homeRowLayout.ORDER_SETTING, value: order })
            writes.push({ key: homeRowLayout.HIDDEN_SETTING, value: hidden })
        end if

        for each entry in writes
            serialized = FormatJson(entry.value)
            tmpSettings[entry.key] = serialized
            registry_write(entry.key, serialized, userId)
        end for

        applied.gates = gates.Keys()
        return applied
    end function

    ' The record the local picker would have written for a section this app can draw: one
    ' of the three list sources, for the server this session is on, naming an item. The id
    ' is rebuilt the way the picker builds it so the arriving row and a local pick of the
    ' same item stay one row.
    function PickedRowFromSection(section as object, serverKey as string) as object
        source = LCase(homeRowLayout.AsText(chainLookupReturn(section, "pluginSource", "")))
        listEntry = homeRowLayout.SourceFor(source)
        if not isValid(listEntry) then return invalid

        itemId = homeRowLayout.AsText(chainLookupReturn(section, "pluginAdditionalData", ""))
        if itemId = "" then return invalid

        sectionServer = homeRowLayout.AsText(chainLookupReturn(section, "serverId", ""))
        if not settingsSync.IsSameServer(sectionServer, serverKey) then return invalid

        return {
            id: homeRowLayout.DynamicId(source, serverKey, itemId),
            source: source,
            itemId: itemId,
            title: homeRowLayout.AsText(chainLookupReturn(section, "pluginDisplayText", "")),
            enabled: settingsSync.ToBooleanValue(chainLookupReturn(section, "enabled", true), true),
            gate: listEntry.gate
        }
    end function

    ' Clients spell the same server with and without a trailing slash
    function IsSameServer(a as string, b as string) as boolean
        return LCase(settingsSync.WithoutTrailingSlash(a)) = LCase(settingsSync.WithoutTrailingSlash(b))
    end function

    function WithoutTrailingSlash(url as string) as string
        trimmed = url.Trim()
        while trimmed.endsWith("/")
            trimmed = Left(trimmed, Len(trimmed) - 1)
        end while

        return trimmed
    end function

    ' SyncTogglesFromServerRows: Applies the state the server pushed for each row it names.
    ' Rows the layout leaves out keep whatever the user chose on this device.
    '
    ' @param {object} tmpSettings - Settings map the caller commits once it finishes
    ' @param {object} rows - Resolved rows from the server
    ' @param {object} rowOrder - Ordered row ids from the server
    sub SyncTogglesFromServerRows(tmpSettings as object, rows as object, rowOrder as object)
        if not isValid(tmpSettings) then return

        states = settingsSync.CollectRowStates(rows, rowOrder)
        if states.Count() = 0 then return

        toggles = settingsSync.GetRowToggleMappings()
        userId = m.global.session.user.id

        for each rowId in toggles
            if not states.DoesExist(rowId) then continue for

            value = states[rowId] ? "true" : "false"

            toggleKeys = toggles[rowId]
            if type(toggleKeys) = "String" or type(toggleKeys) = "roString"
                toggleKeys = [toggleKeys]
            end if

            for each toggleKey in toggleKeys
                tmpSettings[toggleKey] = value
                registry_write(toggleKey, value, userId)
            end for
        end for
    end sub

end namespace

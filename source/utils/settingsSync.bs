    ' Which profile on the server this device reads from and writes to. It's kept on this device
    ' only, since each device picks its own.
    const PROFILE_SETTING = "plugin.syncProfile"
    ' The profile a TV follows until the user picks another
    const DEVICE_PROFILE = "tv"

    ' Two settings have a switch here and a property on the server, but mean different
    ' things on each side, so they are left unmapped rather than wired up to corrupt values:
    '   playback.subs.burnin   is subtitle burn-in, subtitleMode picks a track
    '   playback.bitrate.limit is an integer, maxBitrate is a string with "auto"
    ' The still watching preset does sync, carrying the hours side of the preset as the
    ' Roku inactivity minutes.
    function GetMappings() as object
        return [
            { pluginKey: "navbarPosition", rokuKey: "navbar.position", type: "navbarPosition" },

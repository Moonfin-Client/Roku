import "pkg:/source/utils/misc.bs"

' The text for a Live TV recording the Moonfin plugin says missed part of its program. The store
' that holds the plugin's list is components/recordings/IncompleteRecordingStore.
namespace incompleteRecordings

    ' Seconds since the epoch, or 0 when the server sent no date. Jellyfin and Emby send .NET's
    ' minimum date (year 1) for a date they don't have, so that counts as none. It's read off the
    ' text, since local time west of UTC would put it in year 0.
    function DateSeconds(text as dynamic) as integer
        if not isString(text) or text.Len() < 4 then return 0
        if text.Left(4).ToInt() <= 1 then return 0

        parsed = CreateObject("roDateTime")
        parsed.FromISO8601String(text)
        moment = parsed.AsSeconds()
        if moment <= 0 then return 0
        return moment
    end function

    ' Weekday and time, such as Thu 8:00 PM, in the viewer's clock format
    function ShowingTime(moment as integer, twentyFourHour as boolean) as string
        wall = CreateObject("roDateTime")
        wall.FromSeconds(moment)
        wall.ToLocalTime()
        weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
        dayName = tr(weekdays[wall.GetDayOfWeek()])
        hours = wall.GetHours()
        minutes = leftPad(wall.GetMinutes().toStr(), "0", 2)
        if twentyFourHour then return dayName + " " + leftPad(hours.toStr(), "0", 2) + ":" + minutes

        meridian = "AM"
        if hours >= 12 then meridian = "PM"
        hours = hours mod 12
        if hours = 0 then hours = 12
        return dayName + " " + hours.toStr() + ":" + minutes + " " + meridian
    end function

    ' A malformed count reads as zero rather than hiding the line
    function WholeMinutes(count as dynamic) as integer
        if isString(count)
            text = count.Trim()
            if not CreateObject("roRegex", "^-?[0-9]+(\.[0-9]+)?$", "").IsMatch(text) then return 0
            count = Val(text)
        end if

        kind = type(count)
        if kind <> "Integer" and kind <> "roInt" and kind <> "LongInteger" and kind <> "roLongInteger" and kind <> "Float" and kind <> "roFloat" and kind <> "Double" and kind <> "roDouble" then return 0
        return Int(count + 0.5)
    end function

    ' The status line under an incomplete recording's title, such as
    ' Incomplete · 23 of 37 min · Complete showing scheduled Thu 8:00 PM
    function DetailText(entry as object, twentyFourHour as boolean) as string
        recorded = incompleteRecordings.WholeMinutes(entry.LookupCI("recordedMinutes"))
        expected = incompleteRecordings.WholeMinutes(entry.LookupCI("expectedMinutes"))
        parts = [tr("Incomplete"), Substitute(tr("{0} of {1} min"), recorded.toStr(), expected.toStr())]

        state = entry.LookupCI("state")
        if not isString(state) then state = ""
        scheduledAt = incompleteRecordings.DateSeconds(entry.LookupCI("scheduledStart"))
        recordedAt = incompleteRecordings.DateSeconds(entry.LookupCI("recordedAt"))
        if state = "scheduled" and scheduledAt > 0
            parts.push(Substitute(tr("Complete showing scheduled {0}"), incompleteRecordings.ShowingTime(scheduledAt, twentyFourHour)))
        else if state = "recorded" and recordedAt > 0
            parts.push(Substitute(tr("Complete copy recorded {0}"), incompleteRecordings.ShowingTime(recordedAt, twentyFourHour)))
        else if state = "notFound"
            parts.push(tr("No complete showing found"))
        end if

        return parts.Join(" · ")
    end function

end namespace

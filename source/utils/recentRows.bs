' Hide Watched for the Recently Added and Recently Released rows
namespace recentRows
    const HIDE_WATCHED_SETTING = "ui.home.hideWatchedInRecentRows"

    ' Watched the way these rows count it: played, or a series or season with nothing left to watch
    function IsWatched(item as dynamic) as boolean
        if type(item) <> "roAssociativeArray" then return false
        userData = item.LookupCI("UserData")
        if type(userData) <> "roAssociativeArray" then return false
        played = userData.LookupCI("Played")
        if (type(played) = "roBoolean" or type(played) = "Boolean") and played then return true

        kind = item.LookupCI("Type")
        if type(kind) <> "roString" and type(kind) <> "String" then return false
        if LCase(kind) <> "series" and LCase(kind) <> "season" then return false
        unplayed = userData.LookupCI("UnplayedItemCount")
        if not recentRows.IsNumber(unplayed) or unplayed > 0 then return false
        children = item.LookupCI("ChildCount")
        return not recentRows.IsNumber(children) or children > 0
    end function

    function WithoutWatched(items as dynamic) as object
        kept = []
        if type(items) <> "roArray" then return kept
        for each item in items
            if not recentRows.IsWatched(item) then kept.push(item)
        end for
        return kept
    end function

    function IsNumber(value as dynamic) as boolean
        kind = type(value)
        return kind = "roInt" or kind = "roInteger" or kind = "Integer" or kind = "roFloat" or kind = "Float" or kind = "roDouble" or kind = "Double" or kind = "roLongInteger" or kind = "LongInteger"
    end function
end namespace

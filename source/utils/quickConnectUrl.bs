' Where a phone that is already signed in to the web client approves a Quick Connect code. The
' page reads the code from the link, so scanning it approves with one tap instead of typing.

namespace quickConnectUrl

    ' The web client page for a code, or an empty string when there is no server address or the
    ' code isn't made of letters and digits, so a malformed link is never shown as a QR.
    '
    ' Concatenated rather than resolved so a reverse proxy's path prefix survives. An address
    ' copied out of a browser ends in /web or /web/index.html, which is not where the API lives,
    ' so that is dropped before the page is appended.
    function Approval(serverUrl as dynamic, code as dynamic) as string
        if type(serverUrl) <> "roString" and type(serverUrl) <> "String" then return ""
        if type(code) <> "roString" and type(code) <> "String" then return ""

        base = serverUrl.Trim()
        digits = CreateObject("roRegex", "\s", "").ReplaceAll(code, "")
        if base = "" or digits = "" then return ""
        if not CreateObject("roRegex", "^[0-9A-Za-z]+$", "").IsMatch(digits) then return ""

        base = quickConnectUrl.StripTrailingSlash(base)
        lowered = LCase(base)
        if lowered.Len() >= 15 and Right(lowered, 15) = "/web/index.html"
            base = Left(base, base.Len() - 15)
        else if lowered.Len() >= 4 and Right(lowered, 4) = "/web"
            base = Left(base, base.Len() - 4)
        end if
        base = quickConnectUrl.StripTrailingSlash(base)
        if base = "" then return ""

        return base + "/web/#/quickconnect?code=" + digits
    end function

    function StripTrailingSlash(value as string) as string
        return CreateObject("roRegex", "/+$", "").Replace(value, "")
    end function

end namespace

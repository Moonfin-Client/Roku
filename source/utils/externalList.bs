import "pkg:/source/utils/homeRowLayout.bs"
import "pkg:/source/utils/misc.bs"

' The outside lists the plugin fetches for the home rows and the media bar. A list is named by
' the id every client syncs, which is the chart's home row id or a custom row's section id.
namespace externalList

    ' The IMDb and TMDB charts, titled the way their home rows are
    function Charts() as object
        found = []
        for each row in homeRowLayout.Catalogue()
            if row.id.startsWith("imdb_") or row.id.startsWith("tmdb_") then found.push(row)
        end for
        return found
    end function

    ' The custom rows the other clients made. This app can't draw them as rows, so they wait
    ' in the layout the server sent, and that's where their ids and titles come from.
    function CustomRows() as object
        found = []
        seen = {}
        for each section in homeRowLayout.Passthrough()
            if type(section) = "roAssociativeArray" and LCase(homeRowLayout.AsText(section.LookupCI("pluginSource"))) = "custom"
                id = homeRowLayout.AsText(section.LookupCI("pluginSection"))
                if id <> "" and not seen.DoesExist(id)
                    seen[id] = true
                    title = homeRowLayout.AsText(section.LookupCI("pluginDisplayText"))
                    if title = "" then title = id
                    found.push({ id: id, label: title, config: homeRowLayout.AsText(section.LookupCI("pluginAdditionalData")) })
                end if
            end if
        end for
        return found
    end function

    ' The query the CustomRows endpoint takes for a list, or invalid for an id nothing names
    function RequestFor(listId as string, custom as object) as dynamic
        lowerId = LCase(listId)
        if lowerId.startsWith("imdb_") then return { source: "imdb", type: listId, params: "{}" }

        path = externalList.TmdbChartPath(lowerId)
        if path <> "" then return { source: "tmdb_chart", type: path, params: FormatJson({ source: "tmdb_chart", type: path }) }

        for each row in custom
            if row.id = listId
                config = ParseJson(row.config)
                if type(config) <> "roAssociativeArray" then return invalid
                source = homeRowLayout.AsText(config.LookupCI("source"))
                kind = homeRowLayout.AsText(config.LookupCI("type"))
                if source = "" or kind = "" then return invalid
                return { source: source, type: kind, params: FormatJson(config.LookupCI("params") ?? {}) }
            end if
        end for
        return invalid
    end function

    ' The TMDB path behind a chart's row id, or empty for an id that isnt one
    function TmdbChartPath(listId as string) as string
        paths = {
            tmdb_popular_movies: "movie/popular",
            tmdb_top_rated_movies: "movie/top_rated",
            tmdb_now_playing_movies: "movie/now_playing",
            tmdb_upcoming_movies: "movie/upcoming",
            tmdb_popular_tv: "tv/popular",
            tmdb_top_rated_tv: "tv/top_rated",
            tmdb_airing_today_tv: "tv/airing_today",
            tmdb_on_the_air_tv: "tv/on_the_air",
            tmdb_trending_movie_daily: "trending/movie/day",
            tmdb_trending_movie_weekly: "trending/movie/week",
            tmdb_trending_tv_daily: "trending/tv/day",
            tmdb_trending_tv_weekly: "trending/tv/week",
            tmdb_trending_all_weekly: "trending/all/week"
        }
        return paths[LCase(listId)] ?? ""
    end function

    ' TMDB's movie and TV charts dont say what each result is, so the chart's path decides. Trending
    ' says per result, which matters for the list that mixes both
    function ChartItemType(path as string) as string
        route = LCase(path)
        if route.startsWith("trending/") then route = route.Mid(9)
        if route.startsWith("tv/") then return "Series"
        if route.startsWith("movie/") then return "Movie"
        return ""
    end function

    ' A TMDB image path at the given size, and a path that already is a full URL as it is
    function ImageUrl(path as dynamic, size as string) as string
        text = homeRowLayout.AsText(path)
        if text = "" or text.startsWith("http") then return text
        return "https://image.tmdb.org/t/p/" + size + text
    end function

    function asNormalizedText(val as dynamic) as string
        if not isValid(val) then return ""
        valType = type(val)
        if valType = "String" or valType = "roString"
            return val
        end if
        if valType = "Integer" or valType = "roInt" or valType = "roInteger" or valType = "Float" or valType = "roFloat" or valType = "Double" or valType = "LongInteger"
            return val.toStr()
        end if
        return ""
    end function

    ' Reads a property from either a HomeData node or an AssociativeArray
    function ItemProperty(item as dynamic, prop as string) as dynamic
        if not isValid(item) then return invalid

        if type(item) = "roSGNode"
            if isValid(item.json)
                val = item.json.LookupCI(prop)
                if isValid(val) then return val
            end if
            if item.DoesExist(prop) then return item[prop]
            return invalid
        end if

        if type(item) = "roAssociativeArray" or type(item) = "AssociativeArray"
            val = item.LookupCI(prop)
            if isValid(val) then return val
            if isValid(item.json) and (type(item.json) = "roAssociativeArray" or type(item.json) = "AssociativeArray")
                return item.json.LookupCI(prop)
            end if
        end if

        return invalid
    end function

    ' Extracts display name / title
    function ItemName(item as dynamic) as string
        raw = externalList.ItemProperty(item, "Name")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "name")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "Title")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "title")
        return externalList.asNormalizedText(raw)
    end function

    ' Extracts release date normalized to YYYY-MM-DD for chronological string comparison
    function ItemReleaseDate(item as dynamic) as string
        raw = externalList.ItemProperty(item, "PremiereDate")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "premiereDate")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "releaseDate")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "release_date")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "firstAirDate")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "first_air_date")

        dateStr = externalList.asNormalizedText(raw)
        if dateStr <> ""
            if dateStr.Len() >= 10
                return Left(dateStr, 10)
            else if dateStr.Len() = 4
                return dateStr + "-01-01"
            end if
            return dateStr
        end if

        year = externalList.ItemProperty(item, "ProductionYear")
        if not isValid(year) then year = externalList.ItemProperty(item, "productionYear")
        if not isValid(year) then year = externalList.ItemProperty(item, "Year")
        if not isValid(year) then year = externalList.ItemProperty(item, "year")

        if isValid(year)
            yearInt = 0
            if type(year) = "Integer" or type(year) = "roInt" or type(year) = "roInteger" or type(year) = "LongInteger"
                yearInt = year
            else
                yearInt = externalList.asNormalizedText(year).ToInt()
            end if
            if yearInt > 0
                return StrI(yearInt).Trim() + "-01-01"
            end if
        end if

        return ""
    end function

    ' Extracts rating as float
    function ItemRating(item as dynamic) as float
        raw = externalList.ItemProperty(item, "CommunityRating")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "communityRating")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "voteAverage")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "vote_average")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "rating")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "Rating")

        if not isValid(raw) then return 0.0
        if type(raw) = "Float" or type(raw) = "roFloat" or type(raw) = "Double" or type(raw) = "roDouble" or type(raw) = "Integer" or type(raw) = "roInt" or type(raw) = "roInteger"
            return 0.0 + raw
        end if
        return Val(externalList.asNormalizedText(raw))
    end function

    ' Extracts popularity as float
    function ItemPopularity(item as dynamic) as float
        raw = externalList.ItemProperty(item, "Popularity")
        if not isValid(raw) then raw = externalList.ItemProperty(item, "popularity")

        if not isValid(raw) then return 0.0
        if type(raw) = "Float" or type(raw) = "roFloat" or type(raw) = "Double" or type(raw) = "roDouble" or type(raw) = "Integer" or type(raw) = "roInt" or type(raw) = "roInteger"
            return 0.0 + raw
        end if
        return Val(externalList.asNormalizedText(raw))
    end function

    ' Checks if item a should strictly precede item b
    function ComesBefore(a as dynamic, b as dynamic, sortBy as string, sortOrder as string) as boolean
        isAsc = (LCase(sortOrder) <> "descending")

        if sortBy = "name"
            nameA = LCase(externalList.ItemName(a))
            nameB = LCase(externalList.ItemName(b))
            if nameA = nameB then return false
            if nameA = "" then return false
            if nameB = "" then return true
            return isAsc ? (nameA < nameB) : (nameA > nameB)
        else if sortBy = "releasedate"
            dateA = externalList.ItemReleaseDate(a)
            dateB = externalList.ItemReleaseDate(b)
            if dateA = dateB then return false
            if dateA = "" then return false
            if dateB = "" then return true
            return isAsc ? (dateA < dateB) : (dateA > dateB)
        else if sortBy = "rating"
            ratingA = externalList.ItemRating(a)
            ratingB = externalList.ItemRating(b)
            if ratingA = ratingB then return false
            if ratingA <= 0 then return false
            if ratingB <= 0 then return true
            return isAsc ? (ratingA < ratingB) : (ratingA > ratingB)
        else if sortBy = "popularity"
            popA = externalList.ItemPopularity(a)
            popB = externalList.ItemPopularity(b)
            if popA = popB then return false
            if popA <= 0 then return false
            if popB <= 0 then return true
            return isAsc ? (popA < popB) : (popA > popB)
        end if

        return false
    end function

    ' Stable sort for external row items by criterion and order
    function SortItems(items as object, sortBy as string, sortOrder as string) as object
        if not isValid(items) or items.Count() <= 1 then return items

        lowerSortBy = LCase(sortBy)
        if lowerSortBy = "none" or lowerSortBy = "" then return items

        sorted = []
        for each item in items
            sorted.push(item)
        end for

        if lowerSortBy = "shuffle"
            return shuffleArray(sorted)
        end if

        total = sorted.Count()
        for i = 1 to total - 1
            current = sorted[i]
            j = i - 1
            while j >= 0 and externalList.ComesBefore(current, sorted[j], lowerSortBy, sortOrder)
                sorted[j + 1] = sorted[j]
                j = j - 1
            end while
            sorted[j + 1] = current
        end for

        return sorted
    end function

end namespace

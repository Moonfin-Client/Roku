import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalFilter.bs"

' Splits a movie or series library into categories. A genre or a studio puts an item in every
' one it carries, so the counts can add up to more than the library holds, and an item with none
' goes to the catch-all instead.
namespace libraryGroupBy

    function Options() as object
        return [
            { value: "none", label: tr("None") },
            { value: "decade", label: tr("Decade (Year)") },
            { value: "genres", label: tr("Genres") },
            { value: "parentalRatings", label: tr("Parental Rating") },
            { value: "studio", label: tr("Studio") }
        ]
    end function

    function Label(value as dynamic) as string
        for each option in libraryGroupBy.Options()
            if isStringEqual(option.value, value) then return option.label
        end for
        return tr("None")
    end function

    ' A stored value the dialog no longer offers reads as no grouping
    function Normalize(value as dynamic) as string
        for each option in libraryGroupBy.Options()
            if isStringEqual(option.value, value) then return option.value
        end for
        return "none"
    end function

    function KeysFor(json as dynamic, groupBy as string) as object
        if type(json) <> "roAssociativeArray" then return []

        if groupBy = "genres"
            keys = []
            genres = json.LookupCI("Genres")
            if type(genres) = "roArray"
                for each genre in genres
                    if isValidAndNotEmpty(genre) then keys.push(toString(genre))
                end for
            end if
            if keys.count() = 0 then keys.push("Other")
            return keys
        end if

        if groupBy = "parentalRatings"
            rating = toString(json.LookupCI("OfficialRating")).Trim()
            if rating = "" then rating = "Unrated"
            return [rating]
        end if

        if groupBy = "decade"
            year = json.LookupCI("ProductionYear")
            if not isValid(year) then return ["Unknown"]
            return [`${((Int(year) \ 10) * 10).toStr()}s`]
        end if

        if groupBy = "studio"
            keys = []
            studios = json.LookupCI("Studios")
            if type(studios) = "roArray"
                for each studio in studios
                    studioName = ""
                    if type(studio) = "roAssociativeArray" then studioName = toString(studio.LookupCI("Name"))
                    if studioName <> "" then keys.push(studioName)
                end for
            end if
            if keys.count() = 0 then keys.push("Unknown")
            return keys
        end if

        return []
    end function

    function IsCatchAll(key as string) as boolean
        return key = "Other" or key = "Unknown" or key = "Unrated"
    end function

    ' The catch-alls go last, decades run newest first, ratings run mildest first and everything
    ' else is alphabetical. A studio grouping can run to hundreds of categories, so each one gets a
    ' fixed width prefix and one plain sort orders them all.
    function Ordered(keys as object, groupBy as string) as object
        keyed = []
        for each key in keys
            rank = 0
            if groupBy = "decade" then rank = 9999 - Int(Val(key))
            if groupBy = "parentalRatings" then rank = parentalFilter.Severity(key)
            catchAll = libraryGroupBy.IsCatchAll(key) ? "1" : "0"
            keyed.push(catchAll + Right("0000" + rank.toStr(), 4) + key)
        end for

        keyed.Sort()
        sortedKeys = []
        for each entry in keyed
            sortedKeys.push(entry.Mid(5))
        end for
        return sortedKeys
    end function

end namespace

import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/fontRegistry.bs"

' A theme font is drawn well below the size it is asked for (see fontRegistry),
' which leaves small copy hard to read across a room. Blocks of small text ask
' for more so they land back at a comfortable size.
const THEME_TEXT_BUMP = 1.35
' A paragraph is the one place that bump works against itself. A long run of a
' display face reads better a little smaller than the copy around it, so the
' overview asks for less instead.
const THEME_BODY_TRIM = 0.85

namespace fontApply

    ' The fallback font stands in for the theme's face when it's turned on, since a theme face
    ' can't draw Chinese and other scripts either
    function ActiveFamily() as dynamic
        if isValidAndNotEmpty(m.global.fallbackFont) and get_user_setting_bool("useFallbackFont", false) then return FALLBACK_FONT_FAMILY
        return get_user_setting("ui.theme.fontFamily")
    end function

    function DrawsSmall() as boolean
        fontInfo = fontRegistry.FamilyToFont(fontApply.ActiveFamily())
        return isValid(fontInfo) and fontInfo.scale < 1
    end function

    function ThemeTextSize(base as integer) as integer
        if not fontApply.DrawsSmall() then return base

        return Int(base * THEME_TEXT_BUMP + 0.5)
    end function

    function ThemeBodyTextSize(base as integer) as integer
        if not fontApply.DrawsSmall() then return base

        return Int(base * THEME_BODY_TRIM + 0.5)
    end function

    ' The dot between facts, in whatever form the font in play can draw
    function ThemeSeparator() as string
        fontInfo = fontRegistry.FamilyToFont(fontApply.ActiveFamily())
        if not isValid(fontInfo) then return "·"

        return fontInfo.separator ?? "·"
    end function

    sub ApplyThemeFonts(root as dynamic, restore = false as boolean)
        if not isValid(root) then return

        family = fontApply.ActiveFamily()
        active = fontRegistry.HasFamily(family)
        if not active and not restore then return

        fontApply.WalkAndApply(root, family, active, 0)
    end sub

    ' Switches a label's own Font node to the fallback face, for labels the walk misses or that
    ' resize their fonts after it
    sub ApplyFallbackFace(labels as object)
        if fontApply.ActiveFamily() <> FALLBACK_FONT_FAMILY then return
        for each label in labels
            label.font.uri = m.global.fallbackFont
        end for
    end sub

    sub WalkAndApply(node as dynamic, family as dynamic, active as boolean, depth as integer)
        if depth > 40 or type(node) <> "roSGNode" then return

        if node.hasField("font")
            fontApply.ApplyToNode(node, family, active)
        end if

        childCount = node.getChildCount()
        for i = 0 to childCount - 1
            fontApply.WalkAndApply(node.getChild(i), family, active, depth + 1)
        end for
    end sub

    sub ApplyToNode(node as object, family as dynamic, active as boolean)
        if not node.hasField("themeBaseFont")
            current = node.font
            if not isValid(current) or type(current) <> "roSGNode" then return
            node.addField("themeBaseFont", "node", false)
            if not node.hasField("themeBaseFont") then return
            node.themeBaseFont = current
        end if

        baseFont = node.themeBaseFont
        if not isValid(baseFont) then return

        if active
            baseSize = baseFont.size
            if not isValid(baseSize) or baseSize < 1 then baseSize = 24
            themedFont = fontRegistry.GetFont(family, baseSize)
            if isValid(themedFont) then node.font = themedFont
        else
            node.font = baseFont
        end if
    end sub

end namespace

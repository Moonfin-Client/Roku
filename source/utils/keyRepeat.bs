' Key repeat for components that draw their own focus.
'
' Roku OS auto-repeats a held direction key only inside built-in lists and
' grids. A component that moves its own focus in onKeyEvent sees one press and
' one release however long the key is held, so holding Down in the TV guide
' moves a single row. keyRepeat replays the held key into the component's own
' onKeyEvent from a Timer until the key is released.
'
' Everything runs in the component's scope on its render thread: the Timer is a
' child of the component and its fire callback is a component sub.
'
' To use it in a component:
'   init():          keyRepeat.Init("onKeyRepeatFire")
'   onKeyEvent():    keyRepeat.Handle(key, press) as the first line
'   and add:
'     sub onKeyRepeatFire()
'         key = keyRepeat.Take()
'         if key <> "" then onKeyEvent(key, true)
'     end sub
'
' Repeats run only while the component itself holds focus, so a dialog, the
' next screen, or a release that never arrives stops them.

namespace keyRepeat

    ' Seconds from the real press to the first repeat
    const FIRST_DELAY = 0.4
    ' Seconds between repeats
    const INTERVAL = 0.12

    ' Creates the repeat Timer under m.top. fireCallback names a component sub
    ' that passes keyRepeat.Take() to the component's onKeyEvent.
    sub Init(fireCallback as string)
        timer = CreateObject("roSGNode", "Timer")
        timer.repeat = false
        m.top.appendChild(timer)
        timer.observeField("fire", fireCallback)
        m.keyRepeat = { timer: timer, key: "" }
    end sub

    ' First line of onKeyEvent. A direction press starts the countdown and its
    ' release stops it. A press of the key already held is a replay, so it
    ' leaves the timer running.
    sub Handle(key as string, press as boolean)
        state = m.keyRepeat
        if press
            if key = state.key then return
            if key = "up" or key = "down" or key = "left" or key = "right"
                state.key = key
                state.timer.duration = keyRepeat.FIRST_DELAY
                state.timer.control = "start"
            else
                keyRepeat.Stop()
            end if
        else if key = state.key
            keyRepeat.Stop()
        end if
    end sub

    ' The key to replay for this Timer fire, or "" when repeating should stop.
    function Take() as string
        state = m.keyRepeat
        if state.key = "" then return ""
        if not m.top.hasFocus()
            keyRepeat.Stop()
            return ""
        end if
        state.timer.duration = keyRepeat.INTERVAL
        state.timer.control = "start"
        return state.key
    end function

    sub Stop()
        m.keyRepeat.timer.control = "stop"
        m.keyRepeat.key = ""
    end sub
end namespace

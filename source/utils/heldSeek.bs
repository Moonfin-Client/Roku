' Seeking speeds up while Left or Right is held. The remote sends one press and one release however
' long the key is held, so the player steps again on a timer between the two.

' Ten seconds of 180 s steps covers any runtime, so a hold still going past that lost its release
const HELD_SEEK_LIMIT_MS = 10000

namespace heldSeek

    ' The set step for the first three moves of a hold, then 30 s up to the eighth, 60 s up to the
    ' sixteenth and 180 s after that, never less than the set step
    function SecondsFor(baseSeconds as integer, count as integer) as integer
        tier = 180
        if count <= 3
            tier = 0
        else if count <= 8
            tier = 30
        else if count <= 16
            tier = 60
        end if
        if baseSeconds > tier then return baseSeconds
        return tier
    end function

end namespace

import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsSync.bs"

' Core's home cards. Core lays them out in points on a canvas 1150 wide and draws them at 0.8 on a
' TV, so a 1920 wide screen draws each point 0.8 * 1920 / 1150 pixels.
namespace homeCards

    const PIXELS_PER_POINT = 1.3356522
    const BANNER_RATIO = 5.4054054

    ' The account's card size, or the one the settings preview is trying. Home draws Grandparents,
    ' which every grid caps at Extra Large.
    function CardSizeName(stored = invalid as dynamic) as string
        if not isValid(stored) then stored = get_user_setting("ui.posterSize")
        if isStringEqual(stored, "grandparents") then return "grandparents"
        return libraryCard.PosterSize(invalid, stored)
    end function

    ' Core's portrait and landscape heights for a card size, in its points
    function PointHeights(sizeName as string) as object
        table = { small: [120, 88], medium: [150, 110], large: [180, 132], extraLarge: [210, 154], grandparents: [300, 220] }
        found = table[sizeName]
        if not isValid(found) then found = table.medium
        return found
    end function

    ' A card's width and height on screen. Core sizes a card wider than it is tall from the
    ' landscape height and any other from the portrait height, unless it asks for the portrait one.
    function CardBox(sizeName as string, aspect as float, portraitHeight = false as boolean) as object
        points = homeCards.PointHeights(sizeName)
        tall = points[0]
        if aspect > 1 and not portraitHeight then tall = points[1]
        tall = tall * homeCards.PIXELS_PER_POINT
        return [Int(tall * aspect + 0.5), Int(tall + 0.5)]
    end function

    ' Core's image type for a Classic row. Audio rows and music only rows stay square posters,
    ' and Seerr's browse rows stay wide. The settings preview passes the type a picker is trying
    ' for the row, which stands in for the saved one.
    function RowImageType(rowId as string, posterOnly as boolean, tried = invalid as dynamic) as string
        if posterOnly then return "poster"
        if isSeerrFilterRow(rowId) or rowId = "watch_parties" then return "thumb"
        if get_user_setting_bool("ui.home.rowsImageTypeOverride", false) then return settingsSync.ImageTypeName(get_user_setting("ui.home.rowsImageType"), "thumb")
        if isValid(tried) then return settingsSync.ImageTypeName(tried, homeCards.StoredType(rowId))
        return homeCards.StoredType(rowId)
    end function

    ' What a row was set to here, or Core's default, a thumbnail for My Media and a poster for
    ' every other row
    function StoredType(rowId as string) as string
        fallback = "poster"
        if rowId = "smalllibrarytiles" then fallback = "thumb"
        return settingsSync.ImageTypeName(get_user_setting(settingsSync.ROW_IMAGE_TYPE_KEY + rowId), fallback)
    end function

    ' A server image asked for at the size its card draws it. Only the size in the query changes, so
    ' art from anywhere else comes through as it is.
    function SizedImageUrl(url as dynamic, width as integer, height as integer) as dynamic
        if not isString(url) then return url
        ' Cards ask for this on every bind, so the patterns are made once
        if not isValid(m.imageSizeQuery) then m.imageSizeQuery = [CreateObject("roRegex", "([?&]maxWidth=)\d+", "i"), CreateObject("roRegex", "([?&]maxHeight=)\d+", "i")]
        sized = m.imageSizeQuery[0].ReplaceAll(url, "\1" + width.ToStr())
        return m.imageSizeQuery[1].ReplaceAll(sized, "\1" + height.ToStr())
    end function

    function AspectFor(itemType as dynamic, rowId as string, audioRow as boolean, imageType as string) as float
        if rowId = "mdblist_watching_now" or rowId = "watch_parties" or isSeerrFilterRow(rowId) then return 16 / 9
        if audioRow then return 1.0
        if imageType = "banner" then return homeCards.BANNER_RATIO
        kind = LCase(toString(itemType))
        if inArray(["musicalbum", "musicartist", "audio", "playlist", "person"], kind) then return 1.0
        if imageType = "thumb" or kind = "studio" or kind = "network" then return 16 / 9
        return 2 / 3
    end function

end namespace

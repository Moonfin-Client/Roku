import "pkg:/source/utils/misc.bs"

' Which rating sources show and in what order. Turned-on sources lead in the order the viewer
' put them, and the rest follow in the order they're offered.
namespace ratingSourceList

    function Catalogue() as object
        return [
            { id: "personal", label: "My Rating" },
            { id: "stars", label: "Community Rating" },
            { id: "imdb", label: "IMDb" },
            { id: "tmdb", label: "TMDB" },
            { id: "tomatoes", label: "Rotten Tomatoes (Critics)" },
            { id: "tomatoes_audience", label: "Rotten Tomatoes (Audience)" },
            { id: "metacritic", label: "Metacritic" },
            { id: "metacriticuser", label: "Metacritic (User)" },
            { id: "trakt", label: "Trakt" },
            { id: "letterboxd", label: "Letterboxd" },
            { id: "rogerebert", label: "Roger Ebert" },
            { id: "myanimelist", label: "MyAnimeList" }
        ]
    end function

    ' What a viewer who never picked any starts with
    function Defaults() as object
        return ["stars", "imdb", "tmdb", "tomatoes", "metacritic"]
    end function

    ' A stored list in the ids this app filters on. The other clients write a few in camelCase,
    ' and the RT audience score has had two older names.
    function Normalize(stored as dynamic) as object
        parsed = stored
        if isValid(stored) and (type(stored) = "String" or type(stored) = "roString") then parsed = ParseJson(stored)
        result = []
        if type(parsed) <> "roArray" then return result
        for each entry in parsed
            if isValid(entry)
                id = LCase(entry.toStr())
                if id = "popcorn" or id = "rtaudience" then id = "tomatoes_audience"
                if not inArray(result, id) then result.push(id)
            end if
        end for
        return result
    end function

    ' Every source as a row, the turned-on ones first
    function Rows(enabled as object) as object
        offered = {}
        for each source in ratingSourceList.Catalogue()
            offered[source.id] = source
        end for

        list = []
        for each id in enabled
            source = offered[id]
            if isValid(source) then list.push({ id: id, label: source.label, enabled: true })
        end for
        for each source in ratingSourceList.Catalogue()
            if not inArray(enabled, source.id) then list.push({ id: source.id, label: source.label, enabled: false })
        end for
        return list
    end function

    ' Turning a source on puts it at the end of the ones already on
    function Toggle(enabled as object, id as string) as object
        result = []
        for each existing in enabled
            if existing <> id then result.push(existing)
        end for
        if result.Count() = enabled.Count() then result.push(id)
        return result
    end function

    ' The list as the server keeps it, in the spellings the other clients read
    function ToStored(enabled as object) as object
        spellings = { metacriticuser: "metacriticUser", myanimelist: "myAnimeList", rogerebert: "rogerEbert" }
        stored = []
        for each id in enabled
            stored.push(spellings[id] ?? id)
        end for
        return stored
    end function

end namespace

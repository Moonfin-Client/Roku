import "pkg:/source/utils/misc.bs"

' What the settings preview draws for the audio and Collections Row Options: Home the way it looks
' with the remote on the first row the setting changes, or Home as it is with a note saying what
' keeps that row off it. Nothing here touches a node, so the rules can be tested on their own.
namespace rowOptionsPreview

    const AUDIO_DISPLAY = "ui.home.displayAudioRows"
    const COLLECTIONS_DISPLAY = "ui.home.displayCollectionsRows"
    const SHOW_EPISODES = "ui.home.collectionsRowShowEpisodes"

    ' The group of rows a Row Options setting changes, "audio" or "collections", or "" for any
    ' other setting
    function Group(settingName as string) as string
        groups = {
            "ui.home.displayAudioRows": "audio",
            "ui.home.audioRowsSortBy": "audio",
            "ui.home.audioRowsSortOrder": "audio",
            "ui.home.displayCollectionsRows": "collections",
            "ui.home.collectionsRowSortBy": "collections",
            "ui.home.collectionsRowSortOrder": "collections",
            "ui.home.collectionsRowShowEpisodes": "collections"
        }
        return groups[settingName] ?? ""
    end function

    ' The first row in Home's order that the setting changes, or "" when Home has none of them.
    ' The Collections settings sort the Collections row and every collection added as a row of its
    ' own, and Show Episodes only changes those. [picked] holds the ids of the collection rows Home
    ' would show.
    function EditedRow(settingName as string, arranged as object, picked as object) as string
        rowGroup = rowOptionsPreview.Group(settingName)
        for each id in arranged
            if rowGroup = "audio" and id = "audio" then return id
            if rowGroup = "collections"
                if id = "collections" and settingName <> SHOW_EPISODES then return id
                if picked.DoesExist(id) then return id
            end if
        end for
        return ""
    end function

    ' Why the setting can't change Home: "switch" while the group's Display switch is off but Rows
    ' has the row on, so turning the switch on is enough, "display" while the switch is off and Rows
    ' has the row off too, "rows" while every row it changes is off in Rows, and "picked" for Show
    ' Episodes when no collection is added as a row of its own. "" when it can. Settings hides Row
    ' Options in Kids Mode, so that needs no reason of its own.
    function Blocked(settingName as string, values as object, edited as string) as string
        rowGroup = rowOptionsPreview.Group(settingName)
        if rowGroup = "" then return ""
        display = AUDIO_DISPLAY
        if rowGroup = "collections" then display = COLLECTIONS_DISPLAY
        if LCase(toString(values[display])) <> "true"
            if edited <> "" then return "switch"
            return "display"
        end if
        if edited <> "" then return ""
        if settingName = SHOW_EPISODES then return "picked"
        return "rows"
    end function

    ' The amber line in the inspector, saying what to change first
    function Status(settingName as string, reason as string) as string
        if reason = "switch" then return Substitute(tr("Turn on {0}"), rowOptionsPreview.displayName(settingName))
        if reason = "display" then return Substitute(tr("Turn on {0}, then turn the row on in Rows"), rowOptionsPreview.displayName(settingName))
        if reason = "rows" then return tr("Turn the row on in Rows, under Disabled")
        if reason = "picked" then return tr("Add a collection to Home as a row of its own")
        return ""
    end function

    ' The note over the preview while Home stays as it is, naming the steps in the order the Rows
    ' screen needs them. Rows only lists a group's rows once its Display switch is on, and lists the
    ' audio row as Music. A sort keeps its place in Row Options while the switch is off, so the note
    ' names the switch unless it's the one in focus.
    function Notice(settingName as string, reason as string) as string
        audio = rowOptionsPreview.Group(settingName) = "audio"
        onSwitch = settingName = AUDIO_DISPLAY or settingName = COLLECTIONS_DISPLAY
        if reason = "switch"
            if audio and onSwitch then return tr("The Audio row is off. To show it, turn this on.")
            if audio then return Substitute(tr("The Audio row is off. To show it, turn on {0}."), rowOptionsPreview.displayName(settingName))
            if onSwitch then return tr("The Collections rows are off. To show them, turn this on.")
            return Substitute(tr("The Collections rows are off. To show them, turn on {0}."), rowOptionsPreview.displayName(settingName))
        end if
        if reason = "display"
            if audio and onSwitch then return tr("The Audio row is off. To show it, turn this on, then go to Rows and turn on Music under Disabled.")
            if audio then return Substitute(tr("The Audio row is off. To show it, turn on {0}, then go to Rows and turn on Music under Disabled."), rowOptionsPreview.displayName(settingName))
            if onSwitch then return tr("The Collections row is off. To show it, turn this on, then go to Rows and turn on Collections under Disabled.")
            return Substitute(tr("The Collections row is off. To show it, turn on {0}, then go to Rows and turn on Collections under Disabled."), rowOptionsPreview.displayName(settingName))
        end if
        if reason = "rows"
            if audio then return tr("The Audio row is off. To show it, go to Rows and turn on Music under Disabled.")
            return tr("The Collections row is off, and no collection is added as a row of its own. To show one, go to Rows and turn on Collections under Disabled.")
        end if
        if reason = "picked" then return tr("This only changes a collection added to Home as a row of its own, and there isn't one.")
        if reason = "empty"
            if audio then return tr("There's no music to show, so Home leaves the Audio row out.")
            return tr("There's nothing to show in this row, so Home leaves it out.")
        end if
        return ""
    end function

    ' A note under the preview when the row it draws isn't the only one the setting changes. A
    ' collection added as its own row can come before the Collections row, so the note only says
    ' that row is off when Rows has it off.
    function Caption(settingName as string, edited as string, arranged as object) as string
        if rowOptionsPreview.Group(settingName) <> "collections" or edited = "collections" then return ""
        collectionsOn = inArray(arranged, "collections")
        if settingName = SHOW_EPISODES
            if collectionsOn then return tr("This only changes a collection added as a row of its own. The Collections row looks the same.")
            return ""
        end if
        if collectionsOn then return ""
        return tr("The Collections row is off, so this only changes the collections added as rows of their own.")
    end function

    ' Where in [shown], the ids of the rows Home has on screen in its order, the rows after
    ' [edited] start. A row Home is still missing, like one just turned on, would sit after the
    ' last row before it in [arranged]. A row whose id isn't in [arranged], like one of several
    ' Recently Added rows, goes with the row before it. Past the end when it's the last row Home
    ' shows, and -1 when Rows doesn't have it or no row Home shows comes after it.
    function RowsAfter(edited as string, arranged as object, shown as object) as integer
        editedAt = -1
        for i = 0 to arranged.count() - 1
            if arranged[i] = edited then editedAt = i
        end for
        if editedAt < 0 then return -1
        position = -1
        for i = 0 to shown.count() - 1
            if shown[i] = edited then return i + 1
            for j = 0 to arranged.count() - 1
                if arranged[j] = shown[i] then position = j
            end for
            if position > editedAt then return i
        end for
        return -1
    end function

    function displayName(settingName as string) as string
        if rowOptionsPreview.Group(settingName) = "audio" then return tr("Display Audio Rows")
        return tr("Display Collections Rows")
    end function
end namespace

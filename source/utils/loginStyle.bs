import "pkg:/source/utils/misc.bs"

' Shared look for the buttons across the server select, user select and sign in
' screens, which all sit outside the themed part of the app
namespace loginStyle

    const ACCENT = "0x00A4DCFF"
    const LABEL = "0xFFFFFFCC"
    const BORDER = "0xFFFFFF33"

    sub ApplyButton(button as object)
        if not isValid(button) then return

        button.color = loginStyle.LABEL
        button.focusColor = loginStyle.ACCENT
        button.borderColor = loginStyle.BORDER
        button.focusBorderColor = loginStyle.ACCENT
    end sub

    ' The tab holding the visible pane keeps the accent even while focus is elsewhere
    sub SetTabSelected(tabButton as object, selected as boolean)
        if not isValid(tabButton) then return

        if selected
            tabButton.color = loginStyle.ACCENT
            tabButton.borderColor = loginStyle.ACCENT
        else
            tabButton.color = loginStyle.LABEL
            tabButton.borderColor = loginStyle.BORDER
        end if
    end sub

end namespace

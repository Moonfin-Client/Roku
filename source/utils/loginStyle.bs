import "pkg:/source/utils/misc.bs"

' Shared look for the server, account and sign in screens, which all sit outside the themed part
' of the app
namespace loginStyle

    const ACCENT = "0x00A4DCFF"
    const ACCENT_HEX = "#00A4DC"
    ' Text and icons drawn on an accent fill
    const ON_ACCENT = "#04151C"
    const LABEL = "0xFFFFFFCC"
    const BORDER = "0xFFFFFF33"

    sub ApplyButton(button as object)
        if not isValid(button) then return

        button.color = loginStyle.LABEL
        button.focusColor = loginStyle.ACCENT
        button.borderColor = loginStyle.BORDER
        button.focusBorderColor = loginStyle.ACCENT
    end sub

    ' Where a centered column starts so the whole of it sits a fifth of the way down the leftover
    ' height
    function ColumnTop(height as float) as float
        top = (1080 - height) * 0.2
        if top < 0 then top = 0
        return top
    end function

end namespace

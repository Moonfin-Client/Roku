import "pkg:/source/utils/misc.bs"

namespace episodeLabels

    ' Numbers the episode as E1 so a long title keeps its room. An episode with no title of its
    ' own still gets the spelled out label, since a bare number says nothing.
    function CardTitle(title as dynamic, number as dynamic) as string
        if not isValidAndNotEmpty(title)
            if not isValid(number) then return ""
            return tr("Episode") + " " + number.ToStr()
        end if

        if not isValid(number) then return title
        return "E" + number.ToStr() + ": " + title
    end function

end namespace

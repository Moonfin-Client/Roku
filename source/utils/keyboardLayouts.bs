import "pkg:/source/utils/misc.bs"

' Key arrangements for the in-app keyboard, in the same order the other clients
' lay them out. Single characters type themselves, longer names are actions the
' keyboard handles. Paste is left out, since Roku offers no clipboard to read.
namespace keyboardLayouts

    const KEY_GAP_FACTOR = 0.1

    function BottomRow() as object
        return ["123", "@", ".", "SPACE", "CURSORL", "CURSORR", "IME", "DONE"]
    end function

    function Lower(variant as string) as object
        if variant = "azerty"
            return [
                ["a", "z", "e", "r", "t", "y", "u", "i", "o", "p"],
                ["q", "s", "d", "f", "g", "h", "j", "k", "l", "m"],
                ["SHIFT", "w", "x", "c", "v", "b", "n", "'", ",", "BACKSPACE"],
                keyboardLayouts.BottomRow()
            ]
        end if

        if variant = "qwertz"
            return [
                ["q", "w", "e", "r", "t", "z", "u", "i", "o", "p"],
                ["a", "s", "d", "f", "g", "h", "j", "k", "l", "'"],
                ["SHIFT", "y", "x", "c", "v", "b", "n", "m", ",", "BACKSPACE"],
                keyboardLayouts.BottomRow()
            ]
        end if

        return [
            ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
            ["a", "s", "d", "f", "g", "h", "j", "k", "l", "'"],
            ["SHIFT", "z", "x", "c", "v", "b", "n", "m", ",", "BACKSPACE"],
            keyboardLayouts.BottomRow()
        ]
    end function

    ' Shifted keys are the same grid drawn in capitals, bar the quote
    function Upper(variant as string) as object
        shifted = []
        for each sourceRow in keyboardLayouts.Lower(variant)
            builtRow = []
            for each entry in sourceRow
                if entry.len() > 1
                    builtRow.push(entry)
                else if entry = "'"
                    builtRow.push(`"`)
                else
                    builtRow.push(UCase(entry))
                end if
            end for
            shifted.push(builtRow)
        end for

        return shifted
    end function

    function Numeric() as object
        return [
            ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
            ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"],
            ["-", "_", "=", "+", ";", ":", "'", "?", "/", "BACKSPACE"],
            ["ABC", ",", ".", "SPACE", "CURSORL", "CURSORR", "IME", "DONE"]
        ]
    end function

    ' The docked keyboard's rows, twelve cells each: the mode rail, ten characters and an
    ' action. A key named in neighboring cells is one key spread across them. Roku has no
    ' clipboard, so space runs on into the cell a paste key would take
    function Docked(variant as string, numericPage as boolean, shifted as boolean) as object
        bottom = ["IME", "SPACE", "SPACE", "SPACE", "SPACE", "SPACE", "SPACE", "SPACE", "SPACE", "CURSORL", "CURSORR", "DONE"]
        if numericPage
            return [
                ["MODE_LOWER", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BACKSPACE"],
                ["MODE_UPPER", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "BACKSPACE"],
                ["MODE_NUM", "-", "_", "=", "+", ":", "'", "?", "/", ",", ".", "DONE"],
                bottom
            ]
        end if

        letters = keyboardLayouts.Lower(variant)
        if shifted then letters = keyboardLayouts.Upper(variant)
        rails = ["MODE_LOWER", "MODE_UPPER", "MODE_NUM"]
        ends = ["BACKSPACE", "BACKSPACE", "DONE"]
        rows = []
        for i = 0 to 2
            cells = [rails[i]]
            for each entry in letters[i]
                if entry.len() = 1 then cells.push(entry)
            end for
            if i = 2 then cells.append([".", "@"])
            cells.push(ends[i])
            rows.push(cells)
        end for
        rows.push(bottom)

        return rows
    end function

    ' Where a press lands on the docked keyboard. Sideways steps go to the next key that
    ' differs, wrapping round the row, and up or down keep the column and pass over the rest
    ' of a tall key. Running off the top comes back invalid, for the caller to decide
    function DockedStep(rows as object, rowIndex as integer, colIndex as integer, key as string) as object
        here = rows[rowIndex][colIndex]

        if key = "left" or key = "right"
            stepBy = 1
            if key = "left" then stepBy = -1
            width = rows[rowIndex].count()
            target = colIndex
            for i = 1 to width - 1
                target = (target + stepBy + width) mod width
                if rows[rowIndex][target] <> here then return { row: rowIndex, col: target }
            end for
            return { row: rowIndex, col: colIndex }
        end if

        stepBy = 1
        if key = "up" then stepBy = -1
        target = rowIndex + stepBy
        while target >= 0 and target < rows.count()
            if rows[target][colIndex] <> here then exit while
            target += stepBy
        end while

        if target < 0 then return invalid
        if target >= rows.count() then return { row: rowIndex, col: colIndex }
        return { row: target, col: colIndex }
    end function

    ' The keyboard styles in the order the setting and the keyboard's own picker list them
    function Styles() as object
        return [
            { id: "native", title: "Native" },
            { id: "classic", title: "Classic" },
            { id: "glass", title: "Glass" },
            { id: "docked", title: "Docked" }
        ]
    end function

    function VariantForLocale(locale as string) as string
        language = LCase(locale)
        separator = language.instr("-")
        if separator < 0 then separator = language.instr("_")
        if separator > 0 then language = language.left(separator)

        if language = "fr" then return "azerty"
        for each match in ["de", "cs", "sk", "hu", "hr", "sl"]
            if language = match then return "qwertz"
        end for

        return "qwerty"
    end function

    ' The accents behind a key, the key itself leading the list. Only lower case
    ' is listed, since an associative array matches keys without regard to case
    ' and the capitals would collide with them
    function AlternatesFor(entry as string) as object
        quote = chr(34)
        table = {
            "a": ["a", "à", "á", "â", "ä", "ã", "å", "æ"],
            "c": ["c", "ç"],
            "e": ["e", "è", "é", "ê", "ë", "ē"],
            "i": ["i", "ì", "í", "î", "ï", "ī"],
            "n": ["n", "ñ"],
            "o": ["o", "ò", "ó", "ô", "ö", "õ", "ø", "œ"],
            "s": ["s", "ß", "ś", "š"],
            "u": ["u", "ù", "ú", "û", "ü", "ū"],
            "y": ["y", "ý", "ÿ"],
            "z": ["z", "ž", "ź", "ż"],
            ".": [".", "!", "?", ",", ";", ":"],
            ",": [",", ";", ":"],
            "?": ["?", "!", "¿", "¡"],
            "!": ["!", "¡"],
            "-": ["-", "_", "–", "—"],
            "_": ["_", "-"],
            "@": ["@", ".com", ".net", ".org"],
            "(": ["(", "[", "{", "<"],
            ")": [")", "]", "}", ">"],
            "=": ["=", "~", "≠"],
            ":": [":", ";"]
        }

        ' Quote and backslash cant be written as plain keys above
        table[quote] = [quote, "'"]
        table["'"] = ["'", quote]
        table["/"] = ["/", chr(92), "|"]

        options = table[LCase(entry)]
        if not isValid(options) or options.count() < 2 then return invalid

        ' A shifted key wears the same accents in capitals
        if entry <> LCase(entry)
            capitals = []
            for each option in options
                capitals.push(UCase(option))
            end for
            return capitals
        end if

        return options
    end function

    function IsRepeatable(entry as string) as boolean
        return entry = "BACKSPACE" or entry = "CURSORL" or entry = "CURSORR"
    end function

    ' Space stretches and the labelled action keys get a little extra, while
    ' everything else shares one unit
    function KeyUnitSpan(entry as string) as float
        if entry = "SPACE" then return 2.4
        if entry = "123" or entry = "ABC" or entry = "IME" or entry = "DONE" then return 1.22

        return 1.0
    end function

    function MaxRowSpan(grid as object) as float
        widest = 0.0
        for each gridRow in grid
            span = 0.0
            for each entry in gridRow
                span += keyboardLayouts.KeyUnitSpan(entry)
            end for
            span += (gridRow.count() - 1) * keyboardLayouts.KEY_GAP_FACTOR
            if span > widest then widest = span
        end for

        return widest
    end function

end namespace

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' The track pickers, sized the way the other clients size theirs. Rows run the
' full width of the panel, so the panel carries no padding of its own down the
' sides. It grows around however many tracks there are and stops once it fills
' the screen, where the list starts scrolling instead.
namespace trackDialog

    const PANEL_WIDTH = 660
    const PANEL_PAD_Y = 30
    const PANEL_MAX_HEIGHT = 864
    const PANEL_INK = "#181818"
    const PANEL_OPACITY = 0.94
    const TITLE_SIZE = 30
    const TITLE_LINE = 36
    const TITLE_GAP = 18
    const ROW_PAD_X = 36
    const ROW_PAD_Y = 21
    const ROW_NAME_LINE = 30
    const ROW_INFO_LINE = 25
    const ROW_FLAG_LINE = 30
    const DIVIDER_MARGIN = 8

    ' The rule under the title, then the gap below it
    function TitleBlock() as integer
        return trackDialog.TITLE_LINE + trackDialog.TITLE_GAP + 1 + trackDialog.TITLE_GAP
    end function

    ' Every row is the height of a name over a detail, so the list stays on a
    ' single stride even where a row carries only one of them
    function RowHeight() as integer
        return (trackDialog.ROW_PAD_Y * 2) + trackDialog.ROW_NAME_LINE + trackDialog.ROW_INFO_LINE
    end function

    function DividerBand() as integer
        return (trackDialog.DIVIDER_MARGIN * 2) + 1
    end function

    ' A picker's rows carry a name over a detail, and the downloader adds a line
    ' of badges under those
    function FlaggedRowHeight() as integer
        return trackDialog.RowHeight() + trackDialog.ROW_FLAG_LINE
    end function

    function VisibleRows(count as integer, stride as integer) as integer
        room = trackDialog.PANEL_MAX_HEIGHT - (trackDialog.PANEL_PAD_Y * 2) - trackDialog.TitleBlock()
        rows = room / stride
        if rows < 1 then rows = 1
        if count < rows then return count

        return Int(rows)
    end function

    sub Layout(parts as object, count as integer, stride = 0 as integer)
        if stride <= 0 then stride = trackDialog.RowHeight()
        rows = trackDialog.VisibleRows(count, stride)
        listHeight = rows * stride
        panelHeight = (trackDialog.PANEL_PAD_Y * 2) + trackDialog.TitleBlock() + listHeight

        parts.panel.translation = [(1920 - trackDialog.PANEL_WIDTH) / 2, (1080 - panelHeight) / 2]

        for each layer in [parts.panelBg, parts.panelBorder]
            layer.width = trackDialog.PANEL_WIDTH
            layer.height = panelHeight
        end for
        parts.panelBg.blendColor = themeChrome.IsActive() ? themeChrome.Surface() : trackDialog.PANEL_INK
        parts.panelBg.opacity = trackDialog.PANEL_OPACITY

        parts.title.font.size = trackDialog.TITLE_SIZE
        parts.title.width = trackDialog.PANEL_WIDTH - (trackDialog.ROW_PAD_X * 2)
        parts.title.height = trackDialog.TITLE_LINE
        parts.title.translation = [trackDialog.ROW_PAD_X, trackDialog.PANEL_PAD_Y]

        parts.titleRule.width = trackDialog.PANEL_WIDTH - (trackDialog.ROW_PAD_X * 2)
        parts.titleRule.height = 1
        parts.titleRule.translation = [trackDialog.ROW_PAD_X, trackDialog.PANEL_PAD_Y + trackDialog.TITLE_LINE + trackDialog.TITLE_GAP]

        parts.list.itemSize = [trackDialog.PANEL_WIDTH, stride]
        parts.list.numRows = rows
        parts.list.translation = [0, trackDialog.PANEL_PAD_Y + trackDialog.TitleBlock()]
    end sub

    ' The artwork browser needs room for pictures rather than rows, so it takes a
    ' wider panel while keeping the same ink, title block and padding
    sub LayoutGrid(parts as object, columns as integer, rows as integer, cell as object, gap as integer)
        gridWidth = (columns * cell[0]) + ((columns - 1) * gap)
        gridHeight = (rows * cell[1]) + ((rows - 1) * gap)
        panelWidth = gridWidth + (trackDialog.ROW_PAD_X * 2)
        panelHeight = (trackDialog.PANEL_PAD_Y * 2) + trackDialog.TitleBlock() + gridHeight

        parts.panel.translation = [(1920 - panelWidth) / 2, (1080 - panelHeight) / 2]

        for each layer in [parts.panelBg, parts.panelBorder]
            layer.width = panelWidth
            layer.height = panelHeight
        end for
        parts.panelBg.blendColor = themeChrome.IsActive() ? themeChrome.Surface() : trackDialog.PANEL_INK
        parts.panelBg.opacity = trackDialog.PANEL_OPACITY

        parts.title.font.size = trackDialog.TITLE_SIZE
        parts.title.width = gridWidth
        parts.title.height = trackDialog.TITLE_LINE
        parts.title.translation = [trackDialog.ROW_PAD_X, trackDialog.PANEL_PAD_Y]

        parts.titleRule.width = gridWidth
        parts.titleRule.height = 1
        parts.titleRule.translation = [trackDialog.ROW_PAD_X, trackDialog.PANEL_PAD_Y + trackDialog.TITLE_LINE + trackDialog.TITLE_GAP]

        gridTop = trackDialog.PANEL_PAD_Y + trackDialog.TitleBlock()
        parts.grid.itemSize = cell
        parts.grid.itemSpacing = [gap, gap]
        parts.grid.numColumns = columns
        parts.grid.numRows = rows
        parts.grid.translation = [trackDialog.ROW_PAD_X, gridTop]
        ' A grid draws past the rows it shows, so it is cut off at the panel
        parts.grid.clippingRect = [0, 0, gridWidth, gridHeight]

        parts.state.width = gridWidth
        parts.state.translation = [trackDialog.ROW_PAD_X, gridTop + (gridHeight / 2)]
    end sub

end namespace

import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/utils/misc.bs"

' A file carrying pt-BR, pt-BR closed caption and pt-PT offers three rows all
' reading Portuguese, so each row says what the track is and where it comes from.
' That is what tells them apart and shows which ones have already been tried.

' Servers and release groups spell hearing impaired several ways, and the word
' boundaries keep cc from matching inside an ordinary word
const SDH_WORDS = "\b(sdh|cc|hoh|hearing[\s-]*impaired|closed[\s-]*captions?)\b"

namespace trackLabels

    ' A track with no name of its own still needs something to be called, and its
    ' position is the only thing left to call it by
    function Name(position as integer, title as dynamic, typeLabel as string) as string
        if isValidAndNotEmpty(title) then return title.toStr()

        return `${typeLabel} ${position}`
    end function

    ' Audio rows lead with their position, which is how the players below refer
    ' to the track when switching between them
    function NumberedName(position as integer, title as dynamic, typeLabel as string) as string
        return `${position} - ${trackLabels.Name(position, title, typeLabel)}`
    end function

    ' A track whose name fell back to its language already shows it, so the
    ' language only earns a place here when the name says something else
    function AudioDetail(stream as dynamic) as string
        if not isValid(stream) then return ""

        parts = []
        language = trackLabels.Field(stream, "Language")
        displayTitle = trackLabels.Field(stream, "Title")
        if language <> "" and not isStringEqual(language, "Unknown") and displayTitle <> "" and not isStringEqual(displayTitle, language)
            parts.push(language)
        end if

        codec = trackLabels.Field(stream, "Codec")
        if codec <> "" then parts.push(UCase(codec))

        channels = trackLabels.Field(stream, "Channels")
        if channels <> "" then parts.push(`${channels}ch`)

        return parts.join(" · ")
    end function

    ' The format and where the track comes from lead the line, then the parts
    ' that tell two otherwise identical rows apart. Those are dropped when the
    ' name already says them, so a track that announces itself is not announced
    ' twice. The language code always shows, because the name spells the language
    ' out and only the code tells pt-BR and pt-PT apart
    function SubtitleDetail(stream as dynamic, trackTitle as dynamic) as string
        if not isValid(stream) then return ""

        named = LCase(isValidAndNotEmpty(trackTitle) ? trackTitle.toStr() : "")
        codec = trackLabels.Field(stream, "Codec")
        parts = [codec <> "" ? UCase(codec) : tr("Unknown")]

        if trackLabels.IsExternal(stream)
            if Instr(1, named, "external") = 0 then parts.push(tr("External"))
        else if LCase(trackLabels.Field(stream, "DeliveryMethod").Trim()) = "embed"
            if Instr(1, named, "embed") = 0 then parts.push(tr("Embedded"))
        else
            parts.push(tr("Internal"))
        end if

        language = trackLabels.Field(stream, "Language")
        if language <> "" and not isStringEqual(language, "Unknown") then parts.push(UCase(language))

        if trackLabels.Flag(stream, "IsHearingImpaired") and not trackLabels.SaysSdh(named)
            parts.push(tr("SDH"))
        end if

        if trackLabels.Flag(stream, "IsForced") and Instr(1, named, "forced") = 0
            parts.push(tr("Forced"))
        end if

        return parts.join(" · ")
    end function

    ' The player works in mapped streams and the detail screen in raw server
    ' ones, so both spellings have to answer
    function IsExternal(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsExternal") then return true

        return LCase(trackLabels.Field(stream, "DeliveryMethod").Trim()) = "external"
    end function

    function SaysSdh(named as string) as boolean
        regex = createObject("roRegex", SDH_WORDS, "i")

        return regex.isMatch(named)
    end function

    ' The streams arrive from the server, the player and the detail screens, so
    ' a field is read whichever way its owner happens to spell it
    function Field(stream as dynamic, fieldName as string) as string
        value = invalid
        if type(stream) = "roAssociativeArray"
            value = stream.LookupCI(fieldName)
        else if isValid(stream)
            value = stream[fieldName]
        end if

        if not isValid(value) then return ""

        return value.toStr()
    end function

    function Flag(stream as dynamic, fieldName as string) as boolean
        return isStringEqual(trackLabels.Field(stream, fieldName), "true")
    end function

    function Setting(settings as object, key as string, defaultVal = invalid as dynamic) as dynamic
        if not isValid(settings) then return defaultVal

        if type(settings) = "roAssociativeArray"
            val = settings.LookupCI(key)
            if isValid(val) then return val
        end if

        val = chainLookupReturn(settings, "user.settings.`" + key + "`", invalid)
        if isValid(val) then return val

        val = chainLookupReturn(settings, "`" + key + "`", invalid)
        if isValid(val) then return val

        return defaultVal
    end function

    function ScoreSubtitle(stream as dynamic, settings as object) as integer
        if not isValid(stream) or not isValid(settings) then return -99999

        rawLang = LCase(trackLabels.Setting(settings, "playback.subs.language", ""))
        userPrefLang = (rawLang = "anylanguage" or rawLang = "none") ? "" : rawLang

        rawFallback = LCase(trackLabels.Setting(settings, "playback.subs.fallbackLanguage", ""))
        userFallbackLang = (rawFallback = "anylanguage" or rawFallback = "none") ? "" : rawFallback

        preferSdh = toBoolean(trackLabels.Setting(settings, "playback.preferSdhSubtitles", false))
        preferText = toBoolean(trackLabels.Setting(settings, "playback.preferTextSubtitles", false))
        preferExternal = toBoolean(trackLabels.Setting(settings, "playback.preferExternalSubtitles", false))

        codec = LCase(trackLabels.Field(stream, "Codec"))
        title = LCase(trackLabels.Field(stream, "Title"))
        if title = "" then title = LCase(trackLabels.Field(stream, "DisplayTitle"))

        isSdh = trackLabels.Flag(stream, "IsHearingImpaired") or trackLabels.SaysSdh(title)
        isExternalTrack = trackLabels.IsExternal(stream)
        isText = trackLabels.Flag(stream, "IsTextSubtitleStream") or (codec = "srt" or codec = "subrip" or codec = "vtt" or codec = "ass" or codec = "ssa" or codec = "ttml")
        isCommentary = trackLabels.Flag(stream, "IsCommentary") or instr(1, title, "commentary") > 0
        lang = LCase(trackLabels.Field(stream, "Language"))

        score = 0
        ' 1. Language matching
        if userPrefLang <> "" and (lang = userPrefLang or (len(userPrefLang) >= 2 and Left(lang, 2) = Left(userPrefLang, 2)))
            score += 10000
        else if userFallbackLang <> "" and (lang = userFallbackLang or (len(userFallbackLang) >= 2 and Left(lang, 2) = Left(userFallbackLang, 2)))
            score += 8000
        else if userPrefLang = "" and userFallbackLang = ""
            score += 6000
        end if

        ' 2. Demote commentary
        if isCommentary
            score -= 5000
        end if

        ' 3. SDH preference
        if preferSdh
            if isSdh then score += 400
        else
            if not isSdh then score += 400
        end if

        ' 4. Text preference
        if preferText
            if isText then score += 200
        end if

        ' 5. External preference
        if preferExternal
            if isExternalTrack then score += 100
        else
            if not isExternalTrack then score += 100
        end if

        ' 6. Default flag tiebreaker
        if trackLabels.Flag(stream, "IsDefault")
            score += 50
        end if

        return score
    end function

    function ResolveBestSubtitleIndex(streams as dynamic, settings as object) as integer
        if not isValid(streams) or not isValid(settings) then return SubtitleSelection.NONE

        subMode = LCase(trackLabels.Setting(settings, "playback.subs.mode", "default"))
        if subMode = "none" then return SubtitleSelection.NONE
        onlyText = toBoolean(trackLabels.Setting(settings, "playback.subs.onlytext", false))

        bestScore = -99999
        bestIndex = SubtitleSelection.NONE

        for i = 0 to streams.Count() - 1
            stream = streams[i]
            streamType = trackLabels.Field(stream, "Type")
            if isStringEqual(streamType, "Subtitle")
                isForced = trackLabels.Flag(stream, "IsForced")

                if subMode = "onlyforced" and not isForced
                    continue for
                end if

                codec = LCase(trackLabels.Field(stream, "Codec"))
                isText = trackLabels.Flag(stream, "IsTextSubtitleStream") or (codec = "srt" or codec = "subrip" or codec = "vtt" or codec = "ass" or codec = "ssa" or codec = "ttml")
                if onlyText and not isText
                    continue for
                end if

                score = trackLabels.ScoreSubtitle(stream, settings)
                if isForced and subMode <> "onlyforced"
                    score -= 2000
                end if

                if score > bestScore
                    bestScore = score
                    idxVal = trackLabels.Field(stream, "Index")
                    bestIndex = idxVal <> "" ? idxVal.ToInt() : i
                end if
            end if
        end for

        return bestIndex
    end function

end namespace

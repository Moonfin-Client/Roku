import "pkg:/source/utils/misc.bs"

' A file carrying pt-BR, pt-BR closed caption and pt-PT offers three rows all
' reading Portuguese, so each row says what the track is and where it comes from.
' That is what tells them apart and shows which ones have already been tried.

' Servers and release groups spell hearing impaired several ways, and the word
' boundaries keep cc from matching inside an ordinary word
const SDH_WORDS = "\b(sdh|cc|hoh|hearing[\s-]*impaired|closed[\s-]*captions?)\b"

const LANGUAGE_SPELLINGS = ",aa:aar,ab:abk,ae:ave,af:afr,ak:aka,am:amh,an:arg,ar:ara,as:asm,av:ava,ay:aym,az:aze,ba:bak,be:bel,bg:bul,bh:bih,bi:bis,bm:bam,bn:ben,bo:bod,br:bre,bs:bos,ca:cat,ce:che,ch:cha,co:cos,cr:cre,cs:ces,cu:chu,cv:chv,cy:cym,da:dan,de:deu,dv:div,dz:dzo,ee:ewe,el:ell,en:eng,eo:epo,es:spa,et:est,eu:eus,fa:fas,ff:ful,fi:fin,fj:fij,fo:fao,fr:fra,fy:fry,ga:gle,gd:gla,gl:glg,gn:grn,gu:guj,gv:glv,ha:hau,he:heb,hi:hin,ho:hmo,hr:hrv,ht:hat,hu:hun,hy:hye,hz:her,ia:ina,id:ind,ie:ile,ig:ibo,ii:iii,ik:ipk,io:ido,is:isl,it:ita,iu:iku,ja:jpn,jv:jav,ka:kat,kg:kon,ki:kik,kj:kua,kk:kaz,kl:kal,km:khm,kn:kan,ko:kor,kr:kau,ks:kas,ku:kur,kv:kom,kw:cor,ky:kir,la:lat,lb:ltz,lg:lug,li:lim,ln:lin,lo:lao,lt:lit,lu:lub,lv:lav,mg:mlg,mh:mah,mi:mri,mk:mkd,ml:mal,mn:mon,mr:mar,ms:msa,mt:mlt,my:mya,na:nau,nb:nob,nd:nde,ne:nep,ng:ndo,nl:nld,nn:nno,no:nor,nr:nbl,nv:nav,ny:nya,oc:oci,oj:oji,om:orm,or:ori,os:oss,pa:pan,pi:pli,pl:pol,ps:pus,pt:por,qu:que,rm:roh,rn:run,ro:ron,ru:rus,rw:kin,sa:san,sc:srd,sd:snd,se:sme,sg:sag,si:sin,sk:slk,sl:slv,sm:smo,sn:sna,so:som,sq:sqi,sr:srp,ss:ssw,st:sot,su:sun,sv:swe,sw:swa,ta:tam,te:tel,tg:tgk,th:tha,ti:tir,tk:tuk,tl:tgl,tn:tsn,to:ton,tr:tur,ts:tso,tt:tat,tw:twi,ty:tah,ug:uig,uk:ukr,ur:urd,uz:uzb,ve:ven,vi:vie,vo:vol,wa:wln,wo:wol,xh:xho,yi:yid,yo:yor,za:zha,zh:zho,zu:zul,alb:sqi,arm:hye,baq:eus,bur:mya,chi:zho,cze:ces,dut:nld,fre:fra,geo:kat,ger:deu,gre:ell,ice:isl,mac:mkd,mao:mri,may:msa,per:fas,rum:ron,slo:slk,tib:bod,wel:cym,pt-br:pob,"

namespace trackLabels

    ' A track with no name of its own still needs something to be called, and its
    ' position is the only thing left to call it by
    function Name(position as integer, title as dynamic, typeLabel as string) as string
        if isValidAndNotEmpty(title) then return title.toStr()

        return `${typeLabel} ${position}`
    end function

    ' Audio rows lead with their position, which is how the players below refer
    ' to the track when switching between them
    function NumberedName(position as integer, title as dynamic, typeLabel as string) as string
        return `${position} - ${trackLabels.Name(position, title, typeLabel)}`
    end function

    ' A track whose name fell back to its language already shows it, so the
    ' language only earns a place here when the name says something else
    function AudioDetail(stream as dynamic) as string
        if not isValid(stream) then return ""

        parts = []
        language = trackLabels.Field(stream, "Language")
        displayTitle = trackLabels.Field(stream, "Title")
        if language <> "" and not isStringEqual(language, "Unknown") and displayTitle <> "" and not isStringEqual(displayTitle, language)
            parts.push(language)
        end if

        codec = trackLabels.Field(stream, "Codec")
        if codec <> "" then parts.push(UCase(codec))

        channels = trackLabels.Field(stream, "Channels")
        if channels <> "" then parts.push(`${channels}ch`)

        return parts.join(" · ")
    end function

    ' The format and where the track comes from lead the line, then the parts
    ' that tell two otherwise identical rows apart. Those are dropped when the
    ' name already says them, so a track that announces itself is not announced
    ' twice. The language code always shows, because the name spells the language
    ' out and only the code tells pt-BR and pt-PT apart
    function SubtitleDetail(stream as dynamic, trackTitle as dynamic) as string
        if not isValid(stream) then return ""

        named = LCase(isValidAndNotEmpty(trackTitle) ? trackTitle.toStr() : "")
        codec = trackLabels.Field(stream, "Codec")
        parts = [codec <> "" ? UCase(codec) : tr("Unknown")]

        if trackLabels.IsExternal(stream)
            if Instr(1, named, "external") = 0 then parts.push(tr("External"))
        else if LCase(trackLabels.Field(stream, "DeliveryMethod").Trim()) = "embed"
            if Instr(1, named, "embed") = 0 then parts.push(tr("Embedded"))
        else
            parts.push(tr("Internal"))
        end if

        language = trackLabels.Field(stream, "Language")
        if language <> "" and not isStringEqual(language, "Unknown") then parts.push(UCase(language))

        if trackLabels.Flag(stream, "IsHearingImpaired") and not trackLabels.SaysSdh(named)
            parts.push(tr("SDH"))
        end if

        if trackLabels.Flag(stream, "IsForced") and Instr(1, named, "forced") = 0
            parts.push(tr("Forced"))
        end if

        return parts.join(" · ")
    end function

    ' The player works in mapped streams and the detail screen in raw server
    ' ones, so both spellings have to answer
    function IsExternal(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsExternal") then return true

        return LCase(trackLabels.Field(stream, "DeliveryMethod").Trim()) = "external"
    end function

    function SaysSdh(named as string) as boolean
        regex = createObject("roRegex", SDH_WORDS, "i")

        return regex.isMatch(named)
    end function

    ' The streams arrive from the server, the player and the detail screens, so
    ' a field is read whichever way its owner happens to spell it
    function Field(stream as dynamic, fieldName as string) as string
        value = invalid
        if type(stream) = "roAssociativeArray"
            value = stream.LookupCI(fieldName)
        else if isValid(stream)
            value = stream[fieldName]
        end if

        if not isValid(value) then return ""

        return value.toStr()
    end function

    function Flag(stream as dynamic, fieldName as string) as boolean
        return isStringEqual(trackLabels.Field(stream, fieldName), "true")
    end function

    ' Setting names hold dots, so they're looked up whole rather than as a path
    function Setting(settings as object, key as string, defaultVal = invalid as dynamic) as dynamic
        if type(settings) <> "roAssociativeArray" then return defaultVal

        value = settings.LookupCI(key)
        if isValid(value) then return value

        return defaultVal
    end function

    ' How high a track sits in the subtitle menus
    function ScoreSubtitle(stream as dynamic, settings as object) as integer
        if not isValid(stream) or not isValid(settings) then return -99999

        rawLang = LCase(trackLabels.Setting(settings, "playback.subs.language", ""))
        userPrefLang = (rawLang = "anylanguage" or rawLang = "none") ? "" : rawLang

        rawFallback = LCase(trackLabels.Setting(settings, "playback.subs.fallbackLanguage", ""))
        userFallbackLang = (rawFallback = "anylanguage" or rawFallback = "none") ? "" : rawFallback

        preferSdh = toBoolean(trackLabels.Setting(settings, "playback.preferSdhSubtitles", false))
        preferText = toBoolean(trackLabels.Setting(settings, "playback.preferTextSubtitles", false))
        preferExternal = toBoolean(trackLabels.Setting(settings, "playback.preferExternalSubtitles", false))

        lang = trackLabels.LanguageKey(trackLabels.Field(stream, "Language"))

        score = 0
        if userPrefLang <> "" and lang = trackLabels.LanguageKey(userPrefLang)
            score += 10000
        else if userFallbackLang <> "" and lang = trackLabels.LanguageKey(userFallbackLang)
            score += 8000
        else if userPrefLang = "" and userFallbackLang = ""
            score += 6000
        end if

        if trackLabels.IsCommentary(stream)
            score -= 5000
        end if

        if preferSdh = trackLabels.IsSdh(stream)
            score += 400
        end if

        if preferText and trackLabels.IsText(stream)
            score += 200
        end if

        if preferExternal = trackLabels.Flag(stream, "IsExternal")
            score += 100
        end if

        if trackLabels.Flag(stream, "IsDefault")
            score += 50
        end if

        return score
    end function

    ' The server's subtitle mode decides whether a track comes on and in which language. The
    ' prefer settings only swap its pick for another track of the same language and kind, so
    ' nothing comes on that the server left off
    function PreferredSubtitle(streams as dynamic, serverIndex as integer, settings as object) as integer
        if serverIndex < 0 or type(streams) <> "roArray" or not isValid(settings) then return serverIndex

        preferSdh = toBoolean(trackLabels.Setting(settings, "playback.preferSdhSubtitles", false))
        preferText = toBoolean(trackLabels.Setting(settings, "playback.preferTextSubtitles", false))
        preferExternal = toBoolean(trackLabels.Setting(settings, "playback.preferExternalSubtitles", false))
        if not preferSdh and not preferText and not preferExternal then return serverIndex

        chosen = invalid
        for each stream in streams
            if isStringEqual(trackLabels.Field(stream, "Type"), "Subtitle") and trackLabels.Field(stream, "Index") = serverIndex.toStr()
                chosen = stream
                exit for
            end if
        end for
        if not isValid(chosen) then return serverIndex

        ' An untagged track could be any language, so there's nothing safe to swap it for
        spoken = trackLabels.LanguageKey(trackLabels.Field(chosen, "Language"))
        if spoken = "" or spoken = "und" or spoken = "unknown" then return serverIndex

        forced = trackLabels.Flag(chosen, "IsForced")
        commentary = trackLabels.IsCommentary(chosen)
        hearingImpaired = trackLabels.IsSdh(chosen)
        onlyText = toBoolean(trackLabels.Setting(settings, "playback.subs.onlytext", false))

        best = serverIndex
        bestRank = trackLabels.VariantRank(chosen, preferSdh, preferText, preferExternal)
        for each stream in streams
            if isStringEqual(trackLabels.Field(stream, "Type"), "Subtitle") and trackLabels.Field(stream, "Index") <> ""
                sameKind = trackLabels.LanguageKey(trackLabels.Field(stream, "Language")) = spoken and trackLabels.Flag(stream, "IsForced") = forced and trackLabels.IsCommentary(stream) = commentary
                if not preferSdh then sameKind = sameKind and trackLabels.IsSdh(stream) = hearingImpaired
                if sameKind and (not onlyText or trackLabels.IsText(stream))
                    rank = trackLabels.VariantRank(stream, preferSdh, preferText, preferExternal)
                    ' A tie keeps the server's pick
                    if rank > bestRank
                        bestRank = rank
                        best = trackLabels.Field(stream, "Index").ToInt()
                    end if
                end if
            end if
        end for

        return best
    end function

    function VariantRank(stream as dynamic, preferSdh as boolean, preferText as boolean, preferExternal as boolean) as integer
        rank = 0
        if preferSdh and trackLabels.IsSdh(stream) then rank += 4
        if preferText and trackLabels.IsText(stream) then rank += 2
        if preferExternal and trackLabels.Flag(stream, "IsExternal") then rank += 1

        return rank
    end function

    function IsSdh(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsHearingImpaired") then return true

        return trackLabels.SaysSdh(trackLabels.StreamTitle(stream))
    end function

    function IsText(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsTextSubtitleStream") then return true

        codec = LCase(trackLabels.Field(stream, "Codec"))
        return codec = "srt" or codec = "subrip" or codec = "vtt" or codec = "webvtt" or codec = "ass" or codec = "ssa" or codec = "ttml"
    end function

    function IsCommentary(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsCommentary") then return true

        return Instr(1, LCase(trackLabels.StreamTitle(stream)), "commentary") > 0
    end function

    function IsAudioDescription(stream as dynamic) as boolean
        if trackLabels.Flag(stream, "IsAudioDescription") then return true

        return Instr(1, LCase(trackLabels.StreamTitle(stream)), "audio description") > 0
    end function

    ' The player's tracks keep their name on the track rather than the stream
    function StreamTitle(stream as dynamic) as string
        title = trackLabels.Field(stream, "Title")
        if title = "" then title = trackLabels.Field(stream, "DisplayTitle")
        if title = "" and type(stream) = "roAssociativeArray" then title = trackLabels.Field(stream.LookupCI("Track"), "Description")

        return title
    end function

    ' Files tag a language as en, fre or fra, so each is read as the one the settings use
    function LanguageKey(code as string) as string
        spelled = LCase(code.Trim())
        spellings = LANGUAGE_SPELLINGS
        found = Instr(1, spellings, `,${spelled}:`)
        if found = 0 then return spelled

        return Mid(spellings, found + Len(spelled) + 2, 3)
    end function

end namespace

import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' Which screen a music library opens on, from the Music Library Style setting
namespace musicLibraryStyle
    const SETTING = "ui.library.musicStyle"

    ' Classic keeps the artist and album grid. So does a library pooled from another signed in
    ' server, since the styled screens only load from this one.
    function OpensGrid(libraryItem as object) as boolean
        if settingOr(musicLibraryStyle.SETTING, "immersive") = "classic" then return true
        pooledUrl = libraryItem.serverUrl ?? ""
        return pooledUrl <> "" and not isStringEqual(pooledUrl, chainLookupReturn(m.global.session, "server.url", ""))
    end function
end namespace

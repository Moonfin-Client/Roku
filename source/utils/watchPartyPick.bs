import "pkg:/source/utils/misc.bs"

' Core's Watch with group on a title's page: the host's pick for the party, which opens a party first
' when this device is in none. A guest has no say in what plays, so the button is the host's alone.
namespace watchPartyPick
    function Candidate(json as dynamic) as dynamic
        if not watchPartyPick.Offered(json) then return invalid
        return { id: "watchWithGroup", config: { icon: "pkg:/images/icons/userGroup.webp", label: tr("Watch with group"), action: "watchWithGroup", id: "watchWithGroupButton" } }
    end function

    function Offered(json as dynamic) as boolean
        if type(json) <> "roAssociativeArray" then return false
        if not inArray(["Movie", "Episode", "Series", "Season"], toString(json.Type ?? "")) then return false
        party = m.global.watchParty
        if not isValid(party) or chainLookupReturn(party, "serverConfig.enabled", false) <> true then return false
        if party.inRoom and toString(party.room.self_role ?? "") <> "host" then return false
        ' Silo changes what plays only in the lobby
        if party.inRoom and party.isSilo = true and toString(party.room.phase ?? "") <> "lobby" then return false
        return true
    end function

    sub Pick(json as dynamic)
        if type(json) <> "roAssociativeArray" then return
        m.global.watchParty.callFunc("pickForParty", { id: toString(json.Id ?? ""), type: toString(json.Type ?? ""), name: toString(json.Name ?? ""), seriesId: toString(json.SeriesId ?? "") })
    end sub
end namespace

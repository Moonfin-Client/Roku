import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/syncPlayHelpers.bs"

' Core's Watch with group on a title's page. In a SyncPlay group it plays the title for the group, and
' otherwise it's the host's pick for the Watch Party, which opens a party first when there's none.
namespace watchPartyPick
    function Candidate(json as dynamic) as dynamic
        if not watchPartyPick.Offered(json) then return invalid
        return { id: "watchWithGroup", config: { icon: "pkg:/images/icons/userGroup.webp", label: tr("Watch with group"), action: "watchWithGroup", id: "watchWithGroupButton" } }
    end function

    function Offered(json as dynamic) as boolean
        if type(json) <> "roAssociativeArray" then return false
        itemType = LCase(toString(json.Type ?? ""))
        if itemType <> "series" and itemType <> "season" and not syncPlayIsVideoType(itemType) then return false
        ' A title from another server can't go to this server's group or party
        if isValid(getServerInfoFromItem(json)) then return false
        return watchPartyPick.InSyncPlayGroup() or m.global.watchParty.callFunc("canPick") = true
    end function

    function InSyncPlayGroup() as boolean
        return chainLookupReturn(m.global, "syncPlayManager.syncPlayActive", false) = true
    end function

    ' Said once the page's own play has sent the title to the SyncPlay group
    sub SayGroupSyncing()
        groupName = toString(m.global.syncPlayManager.groupName ?? "")
        if groupName = "" then groupName = tr("SyncPlay Group")
        banner = m.top.getScene().findNode("notificationBanner")
        if isValid(banner) then banner.callFunc("enqueue", [{ title: Substitute(tr("Syncing playback to {0}"), groupName) }])
    end sub

    sub Pick(json as dynamic)
        if type(json) <> "roAssociativeArray" then return
        m.global.watchParty.callFunc("pickForParty", { id: toString(json.Id ?? ""), type: toString(json.Type ?? ""), name: toString(json.Name ?? ""), seriesId: toString(json.SeriesId ?? "") })
    end sub
end namespace

import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"

namespace detailsBackdropCycle
    const DEFAULT_INTERVAL_MS = 15000

    function ValidIntervalMs(raw as dynamic) as integer
        ms = detailsBackdropCycle.DEFAULT_INTERVAL_MS
        if isString(raw) and raw <> ""
            ms = Val(raw)
        else if type(raw) = "roInt" or type(raw) = "Integer" or type(raw) = "roFloat" or type(raw) = "Float"
            ms = Int(raw)
        end if
        if ms = 5000 or ms = 10000 or ms = 15000 or ms = 30000 then return ms
        return detailsBackdropCycle.DEFAULT_INTERVAL_MS
    end function

    function ShuffleEnabled() as boolean
        return get_user_setting_bool("ui.itemdetail.backdropShuffle", true)
    end function

    function IntervalSeconds() as float
        return detailsBackdropCycle.ValidIntervalMs(get_user_setting("ui.itemdetail.backdropIntervalMs")) / 1000.0
    end function

    ' All backdrop URLs an item can cycle through on its details screen: its own
    ' BackdropImageTags first, otherwise its parent's (for seasons and episodes).
    function BackdropUrlsForItem(itemData as object, baseParams as object) as object
        urls = []
        if not isValid(itemData) then return urls

        if isValidAndNotEmpty(itemData._externalBackdropUrl)
            urls.push(itemData._externalBackdropUrl)
            return urls
        end if

        serverBaseUrl = invalid
        if isChainValid(itemData, "_serverUrl")
            serverBaseUrl = itemData._serverUrl
            if serverBaseUrl.right(1) = "/"
                serverBaseUrl = serverBaseUrl.left(serverBaseUrl.len() - 1)
            end if
        end if

        targetId = ""
        tags = invalid
        if isValidAndNotEmpty(itemData.BackdropImageTags)
            targetId = toString(itemData.id)
            tags = itemData.BackdropImageTags
        else if isValidAndNotEmpty(itemData.ParentBackdropImageTags) and isValidAndNotEmpty(itemData.ParentBackdropItemId)
            targetId = toString(itemData.ParentBackdropItemId)
            tags = itemData.ParentBackdropImageTags
        end if

        if targetId = "" or not isValid(tags) then return urls

        seen = {}
        for i = 0 to tags.count() - 1
            tag = tags[i]
            if not isValidAndNotEmpty(tag) then continue for

            params = {}
            if isValid(baseParams)
                for each k in baseParams
                    params[k] = baseParams[k]
                end for
            end if
            params["Tag"] = tag

            imageVersion = i = 0 ? ImageType.BACKDROP : `Backdrop/${i.toStr()}`
            if isValid(serverBaseUrl)
                url = buildImageURLForServer(serverBaseUrl, targetId, imageVersion, params)
            else
                url = ImageURL(targetId, imageVersion, params)
            end if

            if isValidAndNotEmpty(url) and not seen.DoesExist(url)
                seen[url] = true
                urls.push(url)
            end if
        end for

        return urls
    end function

    ' Fisher-Yates shuffle without replacement so every backdrop is shown once
    ' before the set repeats. When reshuffling across a cycle boundary, avoid
    ' repeating avoidFirst back-to-back.
    function BuildCycleOrder(source as object, shuffle as boolean, avoidFirst = "" as string) as object
        order = []
        if not isValid(source) then return order
        for each url in source
            order.push(url)
        end for

        count = order.count()
        if not shuffle or count <= 1 then return order

        for i = count - 1 to 1 step -1
            j = Rnd(i + 1) - 1
            tmp = order[i]
            order[i] = order[j]
            order[j] = tmp
        end for

        if avoidFirst <> "" and order[0] = avoidFirst
            swapIdx = Rnd(count - 1)
            tmp = order[0]
            order[0] = order[swapIdx]
            order[swapIdx] = tmp
        end if

        return order
    end function
end namespace

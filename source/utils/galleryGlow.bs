import "pkg:/source/utils/misc.bs"

' The colour the gallery tints itself with, picked from the item's first genre
' that this knows about. The tones match the other clients so the same title
' glows the same colour everywhere.
const GALLERY_GLOW_DEFAULT = "#4A5A78"

namespace galleryGlow

    ' Ordered, since a genre that matches nothing exactly is then checked for
    ' one of these reading inside it
    function Tones() as object
        return [
            { genre: "horror", color: "#8A0F1A" },
            { genre: "thriller", color: "#2E6FB0" },
            { genre: "mystery", color: "#3B4E8C" },
            { genre: "crime", color: "#5A2B2B" },
            { genre: "sci-fi", color: "#E0B23A" },
            { genre: "science fiction", color: "#E0B23A" },
            { genre: "fantasy", color: "#6A3FB0" },
            { genre: "romance", color: "#C85C8E" },
            { genre: "comedy", color: "#E08A2E" },
            { genre: "animation", color: "#2FA8A0" },
            { genre: "family", color: "#3FA85C" },
            { genre: "documentary", color: "#6E7A52" },
            { genre: "drama", color: "#7A5230" },
            { genre: "action", color: "#C0451E" },
            { genre: "adventure", color: "#B07A2E" },
            { genre: "war", color: "#5C5A3E" },
            { genre: "western", color: "#9A5A22" },
            { genre: "music", color: "#B03F8A" },
            { genre: "history", color: "#8A6A3A" },
            { genre: "kids", color: "#3FA0C8" },
            { genre: "reality", color: "#B0903A" }
        ]
    end function

    function ForGenres(genres as dynamic) as string
        if not isValidAndNotEmpty(genres) then return GALLERY_GLOW_DEFAULT

        tones = galleryGlow.Tones()
        for each genre in genres
            if not isValidAndNotEmpty(genre) then continue for

            name = LCase(genre.ToStr().Trim())
            if name = "" then continue for

            for each tone in tones
                if name = tone.genre then return tone.color
            end for

            for each tone in tones
                if name.Instr(tone.genre) >= 0 then return tone.color
            end for
        end for

        return GALLERY_GLOW_DEFAULT
    end function

end namespace

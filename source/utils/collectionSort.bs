import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrMissingCollection.bs"

' The orders a collection's playlist can be shown and played in. The server's own order is the one
' everything falls back to, and a pick lasts only as long as the page is open.
namespace collectionSort

    const SORT_SERVER = "server"
    const SORT_RELEASE_ASCENDING = "releaseAscending"
    const SORT_RELEASE_DESCENDING = "releaseDescending"
    const SORT_ALPHABETICAL = "alphabetical"
    const SORT_CUSTOM = "custom"

    ' The custom order is named for what it keeps rather than for a gesture, since a remote has none
    function Label(option as string) as string
        if option = SORT_RELEASE_ASCENDING then return tr("Release Order (Ascending)")
        if option = SORT_RELEASE_DESCENDING then return tr("Release Order (Descending)")
        if option = SORT_ALPHABETICAL then return tr("Alphabetical")
        if option = SORT_CUSTOM then return tr("Custom Order")
        return tr("Server Order")
    end function

    ' The picker's rows in the order they're offered, with the one in use marked. Custom is only
    ' offered once there's a saved order to follow.
    function Choices(active as string, canReorder as boolean) as object
        options = [SORT_SERVER, SORT_RELEASE_ASCENDING, SORT_RELEASE_DESCENDING, SORT_ALPHABETICAL]
        if canReorder then options.push(SORT_CUSTOM)
        rows = []
        for each option in options
            row = { Name: option, description: collectionSort.Label(option) }
            if option = active then row.selected = true
            rows.push(row)
        end for
        return rows
    end function

    ' A saved order means somebody arranged the collection, so it opens the way they left it
    function Initial(savedOrder as dynamic) as string
        if type(savedOrder) = "roArray" and savedOrder.count() > 0 then return SORT_CUSTOM
        return SORT_SERVER
    end function

    ' Cards in the server's order, put in the order picked. Custom follows the ids it's given, and
    ' anything they leave out goes on the end in release order so it isn't lost.
    function Apply(cards as object, option as string, customOrder as dynamic) as object
        if option = SORT_CUSTOM then return arrangeByStoredOrder(stableSorted(cards, collectionSort.Before, SORT_RELEASE_ASCENDING), customOrder)
        if option = SORT_RELEASE_ASCENDING or option = SORT_RELEASE_DESCENDING or option = SORT_ALPHABETICAL then return stableSorted(cards, collectionSort.Before, option)
        return cards
    end function

    ' Release order puts the undated titles last and settles ties by name, and descending is that
    ' order turned round
    function Before(first as object, second as object, option as string) as boolean
        firstJson = first.json
        secondJson = second.json
        if option = SORT_ALPHABETICAL then return LCase(firstJson.Name ?? "") < LCase(secondJson.Name ?? "")
        if option = SORT_RELEASE_DESCENDING then return seerrMissingCollection.ReleasesAfter(firstJson, secondJson)
        return seerrMissingCollection.ReleasesAfter(secondJson, firstJson)
    end function

end namespace

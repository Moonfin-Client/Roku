import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' Kids Mode strips the app back to what a child needs and locks the way out behind a PIN.
'
' Everything the mode decides lives here, so the rules can be read in one place. The flag belongs
' to this Roku rather than to whoever is signed in, so switching account or signing out leaves the
' mode on. It isnt synced either, since a parent handing over the TV shouldnt put their phone in
' Kids Mode too.

' The only rows the mode leaves standing: the way into the libraries, what arrived in them lately,
' and the account's own Continue Watching and Next Up as one row. An allow list rather than a block
' list, so a row added later stays hidden until someone decides a child should see it. Everything
' else pulls from somewhere this mode cant vouch for, whether that is a request queue or an
' outside catalog no parental rating reaches.
const KIDS_LIBRARY_ROW = "smalllibrarytiles"
const KIDS_LATEST_ROW = "latestmedia"
const KIDS_MERGED_ROW = "resume"

' The only buttons the mode offers, alongside the play and restart every details screen puts in
' front of them. An allow list rather than a block list, so a button added later stays out until
' someone decides a child should have it. Keeping the row short is half the point, since anything
' that does not fit folds into a menu, which hands back everything the mode meant to put away.
const KIDS_BUTTONS = ["shuffle", "favorite"]

const KIDS_ENABLED_KEY = "global.kids.enabled"
const KIDS_PIN_KEY = "global.kids.pinHash"

' The guide, the recordings and everything Seerr, named by the screens that draw them
const BLOCKED_SCENES = ["LiveTVLibraryView", "Schedule", "SeerrDiscoveryScreen", "SeerrRequestsScreen", "SeerrGenreBrowseScreen", "SeerrHubScreen", "SeerrIssueThread", "SeerrSettingsScreen"]

namespace kidsMode

    function Enabled() as boolean
        return get_setting(KIDS_ENABLED_KEY, "false") = "true"
    end function

    function PinHash() as string
        return get_setting(KIDS_PIN_KEY, "")
    end function

    ' Whether the way out needs a PIN at all. Nothing should be able to leave the mode on without
    ' one, but if anything ever did there would be no code to check and no way to recover on a
    ' television, so the door opens rather than locking for good.
    function NeedsPin() as boolean
        return kidsMode.PinHash() <> ""
    end function

    sub TurnOn(hash as string)
        kidsMode.store(KIDS_PIN_KEY, hash)
        kidsMode.store(KIDS_ENABLED_KEY, "true")
    end sub

    ' The PIN belonged to this stretch of the mode, so the next time it goes on someone picks a
    ' code for it rather than a forgotten one still being the way out
    sub TurnOff()
        kidsMode.store(KIDS_ENABLED_KEY, "false")
        kidsMode.store(KIDS_PIN_KEY, "")
    end sub

    ' The navigation redraws off the session, so the change lands there as well as on the device
    sub store(key as string, value as string)
        set_setting(key, value)
        session.user.settings.Save(key, value)
    end sub

    ' Applied on read rather than by rewriting the saved rows, so turning the mode off gives the
    ' viewer their own home screen back untouched. The mode drops the libraries entry from the
    ' navigation, so the library row is the only way into a library and it leads.
    ' Continue Watching and Next Up come back as the one merged row, in the place the first of
    ' them was saved.
    function Sections(saved as object) as object
        kept = [KIDS_LIBRARY_ROW]
        mergedPlaced = false
        for each name in saved
            if name = KIDS_LATEST_ROW
                kept.push(name)
            else if (name = "resume" or name = "nextup") and not mergedPlaced
                kept.push(KIDS_MERGED_ROW)
                mergedPlaced = true
            end if
        end for

        return kept
    end function

    function MergesContinueWatching(chosen as boolean) as boolean
        return Enabled() or chosen
    end function

    ' The guide is off limits, so the tile that leads to it is the one thing the library row
    ' loses
    function KeepLibraries(libraries as object) as object
        if not Enabled() then return libraries

        kept = []
        for each library in libraries
            if not isStringEqual(chainLookupReturn(library, "json.collectiontype", ""), "livetv") then kept.push(library)
        end for

        return kept
    end function

    ' The order here is the order on screen. The saved arrangement belongs to the parent and is
    ' one of the things the mode sets aside, so it is not consulted.
    function KeepButtons(buttons as object) as object
        if not Enabled() then return buttons

        kept = []
        for each id in KIDS_BUTTONS
            for each button in buttons
                if button.id = id then kept.push(button)
            end for
        end for

        return kept
    end function

    ' An outside catalogue is one no parental rating reaches, so recommendations stay inside the
    ' server's own library. Read rather than written, so turning the mode off gives the viewer
    ' their own choice back and nothing forced reaches the settings the plugin syncs.
    function RecommendationSource(chosen as string) as string
        return Enabled() ? "local" : chosen
    end function

    ' The stripped back screen, which the mode always shows. Everything else the mode would set
    ' aside on a details screen, the technical row, the description and the expanded tabs, is
    ' something Minimalist never draws, so the style is the only choice left to force.
    function DetailStyle(chosen as string) as string
        return Enabled() ? "minimalist" : chosen
    end function

    ' A still says which part of a show this is, and a child picking an episode has little else to
    ' go on, so the setting that swaps every one of them for the show's own artwork is set aside.
    function SeriesThumbnails(chosen as boolean) as boolean
        return Enabled() ? false : chosen
    end function

    ' Screens the mode refuses to open. Hiding a way in is presentation, and a home row, a search
    ' result or the back stack reaches these without one, so the move itself has to refuse.
    function Blocked(sceneName as string) as boolean
        if not Enabled() then return false

        return inArray(BLOCKED_SCENES, sceneName)
    end function

end namespace

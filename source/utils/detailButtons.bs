import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' The glass the other clients rest these buttons on, and the hairline that only
' shows once one takes focus
const CLASSIC_FILL_OPACITY = 0.08
const CLASSIC_FOCUS_OPACITY = 0.95

' The button as the other clients draw it, in the same pixels
const CLASSIC_BOX = 84
const CLASSIC_ICON = 39
const CLASSIC_LABEL_WIDTH = 157
const CLASSIC_LABEL_GAP = 12
const CLASSIC_LABEL_SIZE = 19
const CLASSIC_LABEL_INK = "#FFFFFFCC"
const CLASSIC_DETAIL_GAP = 2
const CLASSIC_DETAIL_SIZE = 16
const CLASSIC_DETAIL_INK = "#FFFFFF80"
const CLASSIC_DETAIL_FOCUS_INK = "#FFFFFFE6"
const CLASSIC_FOCUS_INK = "#0A0A0A"
const CLASSIC_FOCUS_SCALE = 1.1

const CLASSIC_WATCHED_INK = "#00A4DC"
const CLASSIC_FAVORITE_INK = "#FF4757"

namespace detailButtons

    ' The caller observes focusedChild and appends the button to the row and its
    ' own tracking array
    function createButton(config as object, buttonIndex as integer) as object
        buttonGroup = CreateObject("roSGNode", "Group")
        buttonGroup.id = config.id
        buttonGroup.focusable = true

        layoutGroup = CreateObject("roSGNode", "LayoutGroup")
        layoutGroup.layoutDirection = "vert"
        layoutGroup.horizAlignment = "center"
        layoutGroup.itemSpacings = [CLASSIC_LABEL_GAP, CLASSIC_DETAIL_GAP]

        iconContainer = CreateObject("roSGNode", "Group")
        iconContainer.id = config.id + "IconContainer"

        ' Only the box grows on focus, so the label under it stays where it is
        iconContainer.scaleRotateCenter = [CLASSIC_BOX / 2, CLASSIC_BOX / 2]

        bgRect = CreateObject("roSGNode", "Poster")
        bgRect.uri = "pkg:/images/details/btnaction22.9.png"
        bgRect.width = CLASSIC_BOX
        bgRect.height = CLASSIC_BOX
        bgRect.id = config.id + "Background"
        iconContainer.appendChild(bgRect)

        borderRect = CreateObject("roSGNode", "Poster")
        borderRect.uri = "pkg:/images/details/btnactionborder22.9.png"
        borderRect.width = CLASSIC_BOX
        borderRect.height = CLASSIC_BOX
        borderRect.blendColor = "#FFFFFF"
        borderRect.id = config.id + "Border"
        iconContainer.appendChild(borderRect)

        icon = CreateObject("roSGNode", "Poster")
        icon.uri = config.icon
        icon.width = CLASSIC_ICON
        icon.height = CLASSIC_ICON
        icon.translation = [(CLASSIC_BOX - CLASSIC_ICON) / 2, (CLASSIC_BOX - CLASSIC_ICON) / 2]
        icon.id = config.id + "Icon"
        iconContainer.appendChild(icon)

        layoutGroup.appendChild(iconContainer)

        label = CreateObject("roSGNode", "Label")
        label.text = config.label
        label.font = "font:SmallestBoldSystemFont"
        label.font.size = CLASSIC_LABEL_SIZE
        label.horizAlign = "center"
        label.vertAlign = "top"
        label.width = CLASSIC_LABEL_WIDTH
        label.wrap = true
        label.maxLines = 2
        label.id = config.id + "Text"
        layoutGroup.appendChild(label)

        ' A second, quieter line for things like where a resume point sits
        if isValidAndNotEmpty(config.detail)
            detailLabel = CreateObject("roSGNode", "Label")
            detailLabel.text = config.detail
            detailLabel.font = "font:SmallestSystemFont"
            detailLabel.font.size = CLASSIC_DETAIL_SIZE
            detailLabel.horizAlign = "center"
            detailLabel.width = CLASSIC_LABEL_WIDTH
            detailLabel.id = config.id + "Detail"
            layoutGroup.appendChild(detailLabel)
        end if

        buttonGroup.appendChild(layoutGroup)

        ' Carried on the button so the focus handlers can read it back
        buttonGroup.addField("activeInk", "string", false)
        buttonGroup.activeInk = config.activeInk ?? ""

        buttonGroup.addField("buttonAction", "string", false)
        buttonGroup.buttonAction = config.action
        buttonGroup.addField("buttonIndex", "integer", false)
        buttonGroup.buttonIndex = buttonIndex

        detailButtons.rest(buttonGroup)

        return buttonGroup
    end function

    ' Creates a modern pill button that expands to reveal its label when focused.
    ' Keeps the same buttonAction/buttonIndex contract as createButton so the
    ' detail screen dispatch works unchanged.
    function createModernButton(config as object, buttonIndex as integer) as object
        buttonGroup = CreateObject("roSGNode", "ModernDetailButton")
        buttonGroup.id = config.id
        buttonGroup.focusable = true
        buttonGroup.iconUri = config.icon
        buttonGroup.labelText = config.label
        buttonGroup.detailText = config.detail ?? ""
        buttonGroup.active = config.active ?? false
        buttonGroup.buttonAction = config.action
        buttonGroup.buttonIndex = buttonIndex
        return buttonGroup
    end function

    ' Highlights one modern button and collapses the rest.
    sub highlightModern(index as integer, buttonGroups as object)
        for i = 0 to buttonGroups.count() - 1
            buttonGroup = buttonGroups[i]
            if buttonGroup = invalid then continue for
            buttonGroup.highlighted = (i = index)
        end for
    end sub

    sub unhighlightAllModern(buttonGroups as object)
        for each buttonGroup in buttonGroups
            if buttonGroup <> invalid then buttonGroup.highlighted = false
        end for
    end sub

    ' Highlights the button at the given index and unhighlights all others.
    sub highlight(index as integer, buttonGroups as object)
        if index < 0 or index >= buttonGroups.count() then return

        for i = 0 to buttonGroups.count() - 1
            buttonGroup = buttonGroups[i]
            if buttonGroup = invalid then continue for

            if i = index
                bgRect = buttonGroup.findNode(buttonGroup.id + "Background")
                borderRect = buttonGroup.findNode(buttonGroup.id + "Border")
                icon = buttonGroup.findNode(buttonGroup.id + "Icon")
                themed = themeChrome.IsActive()
                if bgRect <> invalid
                    bgRect.blendColor = themed ? themeChrome.Accent() : "#FFFFFF"
                    bgRect.opacity = CLASSIC_FOCUS_OPACITY
                end if
                if borderRect <> invalid
                    borderRect.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")
                    borderRect.opacity = 1
                end if
                if icon <> invalid
                    icon.blendColor = detailButtons.iconInk(buttonGroup.activeInk, themed ? themeChrome.OnAccent() : CLASSIC_FOCUS_INK)
                end if
                detailButtons.inkDetail(buttonGroup, CLASSIC_DETAIL_FOCUS_INK)
                detailButtons.scaleBox(buttonGroup, CLASSIC_FOCUS_SCALE)
            else
                detailButtons.rest(buttonGroup)
            end if
        end for
    end sub

    ' Sets all buttons to the unhighlighted (unfocused) visual state.
    sub unhighlightAll(buttonGroups as object)
        for i = 0 to buttonGroups.count() - 1
            buttonGroup = buttonGroups[i]
            if buttonGroup = invalid then continue for

            detailButtons.rest(buttonGroup)
        end for
    end sub

    ' The look a button that has given up focus goes back to
    sub rest(buttonGroup as object)
        bgRect = buttonGroup.findNode(buttonGroup.id + "Background")
        borderRect = buttonGroup.findNode(buttonGroup.id + "Border")
        icon = buttonGroup.findNode(buttonGroup.id + "Icon")
        textNode = buttonGroup.findNode(buttonGroup.id + "Text")

        if isValid(bgRect)
            bgRect.blendColor = "#FFFFFF"
            bgRect.opacity = CLASSIC_FILL_OPACITY
        end if
        if isValid(borderRect) then borderRect.opacity = 0
        if isValid(icon) then icon.blendColor = detailButtons.iconInk(buttonGroup.activeInk, "#FFFFFFFF")
        if isValid(textNode) and textNode.hasField("color") then textNode.color = CLASSIC_LABEL_INK
        detailButtons.inkDetail(buttonGroup, CLASSIC_DETAIL_INK)
        detailButtons.scaleBox(buttonGroup, 1.0)
    end sub

    sub inkDetail(buttonGroup as object, ink as string)
        detailNode = buttonGroup.findNode(buttonGroup.id + "Detail")
        if isValid(detailNode) then detailNode.color = ink
    end sub

    ' Watched and favourite carry their own colour, focused or not, so it wins
    ' over whatever the button would otherwise draw
    function iconInk(activeInk as string, fallback as string) as string
        if activeInk <> "" then return activeInk

        return fallback
    end function

    sub scaleBox(buttonGroup as object, factor as float)
        iconBox = buttonGroup.findNode(buttonGroup.id + "IconContainer")
        if isValid(iconBox) then iconBox.scale = [factor, factor]
    end sub

end namespace

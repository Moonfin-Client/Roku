import "pkg:/source/utils/misc.bs"

' The dialog keeps its choices as plain lists and the server wants a query parameter per
' kind. Genres, ratings and tags are pipe delimited so a value holding a comma still
' arrives whole.

namespace libraryFilters

    function joined(values as dynamic, separator = "," as string) as dynamic
        if not isValidAndNotEmpty(values) then return invalid
        return values.join(separator)
    end function

    function flag(values as dynamic, key as string) as dynamic
        if not isValidAndNotEmpty(values) then return invalid
        for each value in values
            if value = key then return "true"
        end for
        return invalid
    end function

    ' One flag serves both standard and high definition, so asking for both is the same as
    ' asking for neither
    function hdFlag(quality as dynamic) as dynamic
        wantsHd = isValid(libraryFilters.flag(quality, "hd"))
        wantsSd = isValid(libraryFilters.flag(quality, "sd"))
        if wantsHd = wantsSd then return invalid
        return wantsHd ? "true" : "false"
    end function

    ' The comma joined list the server reads as its own Filters parameter
    function statusFlags(state as object) as dynamic
        flags = []
        if state.favorites = true then flags.push("IsFavorite")

        if state.played = "played" then flags.push("IsPlayed")
        if state.played = "unplayed" then flags.push("IsUnplayed")
        if state.played = "resumable" then flags.push("IsResumable")

        if state.rated = "liked" then flags.push("Likes")
        if state.rated = "disliked" then flags.push("Dislikes")

        return libraryFilters.joined(flags)
    end function

    function BuildParams(state as object) as object
        if not isValid(state) then return {}

        candidates = {
            Filters: libraryFilters.statusFlags(state),
            SeriesStatus: state.seriesStatus <> "all" ? state.seriesStatus : invalid,
            HasSubtitles: libraryFilters.flag(state.features, "HasSubtitles"),
            HasTrailer: libraryFilters.flag(state.features, "HasTrailer"),
            HasSpecialFeature: libraryFilters.flag(state.features, "HasSpecialFeature"),
            HasThemeSong: libraryFilters.flag(state.features, "HasThemeSong"),
            HasThemeVideo: libraryFilters.flag(state.features, "HasThemeVideo"),
            IsHD: libraryFilters.hdFlag(state.quality),
            Is4K: libraryFilters.flag(state.quality, "uhd"),
            Is3D: libraryFilters.flag(state.quality, "threeD"),
            VideoTypes: libraryFilters.joined(state.videoSources),
            Genres: libraryFilters.joined(state.genres, "|"),
            OfficialRatings: libraryFilters.joined(state.ratings, "|"),
            Tags: libraryFilters.joined(state.tags, "|"),
            Years: libraryFilters.joined(state.years),
            AudioLanguages: libraryFilters.joined(state.audioLanguages),
            SubtitleLanguages: libraryFilters.joined(state.subtitleLanguages)
        }

        ' A filter nobody picked is left out rather than sent as an empty value
        params = {}
        for each key in candidates
            if isValid(candidates[key]) then params[key] = candidates[key]
        end for

        return params
    end function

    ' Nothing chosen anywhere, which is what decides whether the dialog offers to clear
    function IsEmpty(state as object) as boolean
        return libraryFilters.BuildParams(state).count() = 0
    end function

    function EmptyState() as object
        return {
            favorites: false,
            played: "all",
            rated: "all",
            seriesStatus: "all",
            features: [],
            quality: [],
            videoSources: [],
            genres: [],
            ratings: [],
            tags: [],
            years: [],
            audioLanguages: [],
            subtitleLanguages: []
        }
    end function

end namespace

import "pkg:/source/utils/misc.bs"

namespace playedState

    ' The server counts a season with nothing left unplayed as played, and a season the library
    ' doesnt have has nothing to play, so it comes back played too. A missing title never
    ' carries the check.
    function ShowsWatchedCheck(json as dynamic) as boolean
        return chainLookupReturn(json, "UserData.Played", false) = true and chainLookupReturn(json, "LocationType", "") <> "Virtual"
    end function

end namespace

import "pkg:/source/utils/misc.bs"

' The scene carries one keyboard and every field borrows it, so a screen can
' take text without knowing where the keyboard lives
namespace tvKeyboard

    function Open(scene as object, options as object) as object
        panel = scene.findNode("tvKeyboard")
        if not isValid(panel) then return invalid

        panel.titleText = options.title ?? ""
        panel.hintText = options.hint ?? ""
        panel.text = options.text ?? ""
        panel.secureMode = options.secure ?? false
        panel.chips = options.chips ?? []
        panel.showScrim = options.showScrim ?? true

        ' Screens are added to the scene after the keyboard is, so it is lifted
        ' back to the front rather than opening behind whatever is showing
        scene.removeChild(panel)
        scene.appendChild(panel)

        panel.visible = true

        return panel
    end function

    ' Lets go of a keyboard a screen was borrowing, so the next screen to take
    ' it does not inherit the last one's observers
    sub Release(panel as dynamic, fields as object)
        if not isValid(panel) then return

        for each name in fields
            panel.unobserveField(name)
        end for
        panel.visible = false
    end sub

    ' A server address is nearly all punctuation, so the pieces are offered up
    ' front the way the other clients offer them
    function AddressChips() as object
        return ["https://", "http://", "www.", "jellyfin", ".com", ".org", ".net", ":8096", "/"]
    end function

    function EmailChips() as object
        return ["@gmail.com", "@outlook.com", "@icloud.com", "@yahoo.com", ".com", "."]
    end function

end namespace

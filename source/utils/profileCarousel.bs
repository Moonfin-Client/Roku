' The hero carousel Who's watching and the user switcher share: the selected profile big in the
' middle, two either side getting smaller and fainter
namespace profileCarousel

    ' The sum of the id's characters, the same rule Core and Smart-TV use, so a user without a picture
    ' keeps one color on every client
    function InitialsColor(id as string) as string
        colors = ["#2B6CB0", "#9C4221", "#2F855A", "#6B46C1", "#B83280", "#2C7A7B"]
        total = 0
        for i = 1 to Len(id)
            total += Asc(Mid(id, i, 1))
        end for
        return colors[total mod colors.count()]
    end function

    function Initial(name as string) as string
        return UCase(Left(name.Trim(), 1))
    end function

    ' A user's picture in an avatar Poster, or their initial (a Label over it) on their color when
    ' they have no picture
    sub ShowAvatar(picture as object, initials as dynamic, uri as string, name as string, id as string)
        if uri <> ""
            picture.blendColor = "0xFFFFFFFF"
            picture.uri = uri
        else
            picture.uri = "pkg:/images/icons/circle.webp"
            picture.blendColor = profileCarousel.InitialsColor(id)
        end if
        if initials <> invalid
            initials.text = profileCarousel.Initial(name)
            initials.visible = (uri = "")
        end if
    end sub

    ' Where a face sits for an offset from the middle, which falls between two slots mid slide: its
    ' center's distance from the middle, its size and how opaque it is. The third slot out is past the
    ' edge, so a face slides in from there.
    function Placement(offset as float) as object
        slots = [
            { x: 0, size: 280, opacity: 1.0 },
            { x: 314, size: 167, opacity: 0.55 },
            { x: 524, size: 120, opacity: 0.3 },
            { x: 700, size: 84, opacity: 0.0 }
        ]
        distance = Abs(offset)
        if distance >= 3 then distance = 3
        lower = Int(distance)
        if lower = 3 then lower = 2
        fraction = distance - lower
        near = slots[lower]
        far = slots[lower + 1]
        direction = 1
        if offset < 0 then direction = -1
        return {
            x: direction * (near.x + (far.x - near.x) * fraction),
            size: near.size + (far.size - near.size) * fraction,
            opacity: near.opacity + (far.opacity - near.opacity) * fraction
        }
    end function

end namespace

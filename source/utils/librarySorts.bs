import "pkg:/source/utils/misc.bs"

' What the Sort By group offers, and how a stored field maps back onto it.

namespace librarySorts

    ' The plugin serves this one rather than the Items API, and the load task asks it for every
    ' rated item at once
    const MY_RATING_FIELD = "MyRating"
    ' Plain folders first, then everything else by name. The server counts a series or a box set
    ' as a folder too, so the load task asks for the folders on their own rather than sorting on
    ' IsFolder.
    const FOLDERS_FIRST_FIELD = "FoldersFirst"
    ' Plain directories, which Folders First lists ahead of everything else and a flat library
    ' leaves out
    const DIRECTORY_TYPES = "Folder,CollectionFolder,UserView,PhotoAlbum"

    ' Every sort ends on SortName so items the server ranks equally keep a stable order
    ' between pages, which a bare key leaves to whatever the database returns.
    ' kind says what the library holds: music, songs, series, movieOrSeries, foldery, myList and
    ' myRating, the last for whether the plugin is there to serve My Rating. A library keeps its
    ' direction when the sort changes, and order is where the favorites screen starts each one.
    function Options(kind = invalid as dynamic) as object
        if not isValid(kind) then kind = {}
        music = kind.music = true
        songs = kind.songs = true
        runtimeLabel = tr("Runtime")
        if music or songs then runtimeLabel = tr("Length")

        name = { value: "SortName", field: "SortName", order: "Ascending", label: tr("Name") }
        dateAdded = { value: "DateCreated", field: "DateCreated,SortName", order: "Descending", label: tr("Date Added") }
        premiereDate = { value: "PremiereDate", field: "PremiereDate,SortName", order: "Descending", label: tr("Release Date") }
        rating = { value: "OfficialRating", field: "OfficialRating,SortName", order: "Ascending", label: tr("Parental Rating") }
        datePlayed = { value: "DatePlayed", field: "DatePlayed,SortName", order: "Descending", label: tr("Last Played") }
        playCount = { value: "PlayCount", field: "PlayCount,SortName", order: "Descending", label: tr("Play Count") }
        criticRating = { value: "CriticRating", field: "CriticRating,SortName", order: "Descending", label: tr("Critic Rating") }
        communityRating = { value: "CommunityRating", field: "CommunityRating,SortName", order: "Descending", label: tr("Community Rating") }
        runtime = { value: "Runtime", field: "Runtime,SortName", order: "Ascending", label: runtimeLabel }
        random = { value: "Random", field: "Random", order: "Ascending", label: tr("Random") }
        albumArtist = { value: "AlbumArtist", field: "AlbumArtist,Album,SortName", order: "Ascending", label: tr("Album Artist") }
        album = { value: "Album", field: "Album,SortName", order: "Ascending", label: tr("Album") }

        if kind.foldery = true
            sorts = [name, dateAdded, premiereDate, rating, datePlayed, playCount, criticRating, communityRating, runtime, random]
            sorts.push({ value: "FoldersFirst", field: librarySorts.FOLDERS_FIRST_FIELD, order: "Ascending", label: tr("Folders First") })
        else if songs
            sorts = [name, dateAdded, albumArtist, album]
            sorts.push({ value: "Artist", field: "Artist,Album,SortName", order: "Ascending", label: tr("Artist") })
            sorts.push({ value: "IndexNumber", field: "IndexNumber,SortName", order: "Ascending", label: tr("Track Number") })
            sorts.Append([premiereDate, datePlayed, playCount, runtime, random])
        else
            sorts = []
            if kind.myRating = true then sorts.push({ value: "MyRating", field: librarySorts.MY_RATING_FIELD, order: "Descending", label: tr("My Rating") })
            sorts.push(name)
            sorts.push(dateAdded)
            if kind.series = true then sorts.push({ value: "DateLastContentAdded", field: "DateLastContentAdded,SortName", order: "Descending", label: tr("Date Episode Added") })
            sorts.push(premiereDate)
            ' Group By covers parental rating better than a sort does, so the libraries offering it
            ' drop the duplicate
            if kind.movieOrSeries <> true and not music then sorts.push(rating)
            sorts.push(datePlayed)
            if not music then sorts.Append([playCount, criticRating, communityRating])
            if music
                sorts.Append([albumArtist, album])
                sorts.push({ value: "Genre", field: "Genre,SortName", order: "Ascending", label: tr("Genre") })
            end if
            sorts.Append([runtime, random])
        end if

        ' My List keeps the order things were put into it, which no other library offers
        if kind.myList = true
            sorts.unshift({ value: "OrderAdded", field: "OrderAdded", order: "Ascending", label: tr("Order Added") })
        end if

        return sorts
    end function

    function Chosen(key as string, kind = invalid as dynamic) as object
        return librarySorts.Pick(librarySorts.Options(kind), key)
    end function

    function Pick(sorts as object, key as string) as object
        for each sort in sorts
            if isStringEqual(sort.value, key) then return sort
        end for
        return sorts[0]
    end function

    ' The row a stored field belongs to, or nothing when the library no longer offers it, so the
    ' caller can fall back to the library's own default
    function KeyFor(field as dynamic, kind = invalid as dynamic) as string
        if not isValidAndNotEmpty(field) then return ""
        for each sort in librarySorts.Options(kind)
            if isStringEqual(sort.field, field) then return sort.value
        end for
        return ""
    end function

    ' The rated items' ids, highest first or lowest first, with a tie settled on the id so the
    ' order survives a reload. Each rating is turned into a fixed width key so one plain sort
    ' covers both.
    function MyRatingOrder(entries as dynamic, ascending as boolean) as object
        keyed = []
        if type(entries) <> "roArray" then return keyed

        for each entry in entries
            if type(entry) = "roAssociativeArray"
                itemId = toString(entry.LookupCI("ItemId"))
                rating = entry.LookupCI("Rating")
                if itemId <> "" and isNumber(rating)
                    scaled = Int((rating * 1000) + 0.5) + 1000000
                    if not ascending then scaled = 99000000 - scaled
                    keyed.push(Right("00000000" + scaled.toStr(), 8) + "|" + itemId)
                end if
            end if
        end for

        keyed.Sort()
        ids = []
        for each key in keyed
            ids.push(key.Mid(9))
        end for
        return ids
    end function

    function isNumber(value as dynamic) as boolean
        valueType = LCase(type(value))
        return valueType = "integer" or valueType = "rointeger" or valueType = "roint" or valueType = "longinteger" or valueType = "rolonginteger" or valueType = "float" or valueType = "rofloat" or valueType = "double" or valueType = "rodouble" or valueType = "rointrinsicdouble"
    end function

end namespace

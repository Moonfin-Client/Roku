import "pkg:/source/utils/misc.bs"

' What the Sort By group offers, and how a stored field maps back onto it.

namespace librarySorts

    ' Every sort ends on SortName so items the server ranks equally keep a stable order
    ' between pages, which a bare key leaves to whatever the database returns.
    function Options(isMusic as boolean, isMyList = false as boolean) as object
        if isMusic
            return [
                { value: "SortName", field: "SortName", order: "Ascending", label: tr("Name") },
                { value: "DateCreated", field: "DateCreated,SortName", order: "Descending", label: tr("Date Added") },
                { value: "CommunityRating", field: "CommunityRating,SortName", order: "Descending", label: tr("Community Rating") },
                { value: "DatePlayed", field: "DatePlayed,SortName", order: "Descending", label: tr("Last Played") },
                { value: "AlbumArtist", field: "AlbumArtist,Album,SortName", order: "Ascending", label: tr("Album artist") },
                { value: "Album", field: "Album,SortName", order: "Ascending", label: tr("Album") },
                { value: "Artist", field: "Artist,Album,SortName", order: "Ascending", label: tr("Artist") },
                { value: "IndexNumber", field: "IndexNumber,SortName", order: "Ascending", label: tr("Number") },
                { value: "Random", field: "Random", order: "Ascending", label: tr("Random") }
            ]
        end if

        sorts = [
            { value: "SortName", field: "SortName", order: "Ascending", label: tr("Name") },
            { value: "DateCreated", field: "DateCreated,SortName", order: "Descending", label: tr("Date Added") },
            { value: "DateLastContentAdded", field: "DateLastContentAdded,SortName", order: "Descending", label: tr("Date Episode Added"), seriesOnly: true },
            { value: "PremiereDate", field: "PremiereDate,SortName", order: "Descending", label: tr("Premiere Date") },
            { value: "OfficialRating", field: "OfficialRating,SortName", order: "Ascending", label: tr("Rating") },
            { value: "CommunityRating", field: "CommunityRating,SortName", order: "Descending", label: tr("Community Rating") },
            { value: "CriticRating", field: "CriticRating,SortName", order: "Descending", label: tr("Critic rating") },
            { value: "DatePlayed", field: "DatePlayed,SortName", order: "Descending", label: tr("Last Played") },
            { value: "PlayCount", field: "PlayCount,SortName", order: "Descending", label: tr("Play Count") },
            { value: "Runtime", field: "Runtime,SortName", order: "Ascending", label: tr("Runtime") },
            { value: "Random", field: "Random", order: "Ascending", label: tr("Random") }
        ]

        ' My List keeps the order things were put into it, which no other library offers
        if isMyList
            sorts.unshift({ value: "OrderAdded", field: "OrderAdded", order: "Ascending", label: tr("Order Added") })
        end if

        return sorts
    end function

    function Chosen(key as string, isMusic as boolean, isMyList = false as boolean) as object
        sorts = librarySorts.Options(isMusic, isMyList)
        for each sort in sorts
            if isStringEqual(sort.value, key) then return sort
        end for
        return sorts[0]
    end function

    ' What a library sorted before the dialog named its sorts, so a stored field still
    ' lands on the row it belongs to
    function KeyFor(field as string, isMusic as boolean, isMyList = false as boolean) as string
        for each sort in librarySorts.Options(isMusic, isMyList)
            if isStringEqual(sort.field, field) then return sort.value
        end for
        return "SortName"
    end function

end namespace

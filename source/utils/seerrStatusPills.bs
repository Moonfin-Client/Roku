import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' Seerr tracks a title's availability twice, once for HD and once for 4K, and each can be
' declined on its own. The pills on the details screen say something sensible about every
' pairing of those.
namespace seerrStatusPills

    ' One pill per quality track. HD alone stays unlabeled, but once the 4K track has anything to
    ' say both carry their name. A title already in the library says plain HD availability by
    ' being there, so that pill stays silent, while 4K always speaks when it has state.
    function Build(details as dynamic) as object
        mediaInfo = chainLookupReturn(details, "mediaInfo", invalid)
        if not isValid(mediaInfo) then return []

        hdStatus = mediaInfo.status ?? 0
        status4k = mediaInfo.status4k ?? 0
        hdDeclined = false
        fourKDeclined = false
        for each request in chainLookupReturn(mediaInfo, "requests", [])
            if chainLookupReturn(request, "status", 0) <> SEERR_REQUEST_DECLINED then continue for
            is4k = chainLookupReturn(request, "is4k", invalid)
            if not isValid(is4k) then continue for
            if is4k then fourKDeclined = true else hdDeclined = true
        end for

        tracks = [{ status: hdStatus, declined: hdDeclined, prefix: "" }]
        if seerrStatusPills.HasAnyState(status4k, fourKDeclined)
            tracks = [
                { status: hdStatus, declined: hdDeclined, prefix: "HD" },
                { status: status4k, declined: fourKDeclined, prefix: "4K" }
            ]
        end if

        shown = []
        for each track in tracks
            if track.prefix <> "4K" and (track.status = SEERR_MEDIA_AVAILABLE or not seerrStatusPills.HasAnyState(track.status, track.declined)) then continue for

            pill = seerrStatusPills.TrackPill(track.status, track.declined)
            if track.prefix <> "" then pill.text = `${track.prefix} · ${pill.text}`
            shown.push(pill)
        end for
        return shown
    end function

    function HasAnyState(status as integer, declined as boolean) as boolean
        return declined or status > 1
    end function

    function TrackPill(status as integer, declined as boolean) as object
        if declined then return { text: tr("Declined"), tone: "red" }
        if status = SEERR_MEDIA_AVAILABLE then return { text: tr("Available"), tone: "green" }
        if status = SEERR_MEDIA_PARTIAL then return { text: tr("Partially Available"), tone: "green" }
        if status = SEERR_MEDIA_PROCESSING then return { text: tr("Requested"), tone: "purple" }
        if status = SEERR_MEDIA_PENDING then return { text: tr("Pending"), tone: "yellow" }
        if status = SEERR_MEDIA_BLOCKLISTED then return { text: tr("Blocklisted"), tone: "red" }
        if status = SEERR_MEDIA_DELETED then return { text: tr("Deleted"), tone: "red" }
        return { text: tr("Not Requested"), tone: "gray" }
    end function

    ' Seerr's treatment: the fill at 80 percent, a border of the same hue and light text of it,
    ' readable over cover art where a faint tint isnt
    function Colors(tone as string) as object
        if tone = "green" then return { fill: "#22C55ECC", text: "#D7F5E2", border: "#22C55E" }
        if tone = "yellow" then return { fill: "#EAB308CC", text: "#FBF1D3", border: "#EAB308" }
        if tone = "purple" then return { fill: "#A855F7CC", text: "#F0E3FD", border: "#A855F7" }
        if tone = "red" then return { fill: "#EF4444CC", text: "#FCDDDD", border: "#EF4444" }
        return { fill: "#6B728026", text: "#9CA3AF", border: "#6B7280" }
    end function

end namespace

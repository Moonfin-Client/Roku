import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' Which rows the home screen offers and what order they sit in. The layout follows the
' viewer between devices through the plugin, so the ids here have to match the ones the
' other clients write. Renaming an id drops whatever the viewer had arranged.
namespace homeRowLayout

    const ORDER_SETTING = "ui.home.rowOrder"
    const HIDDEN_SETTING = "ui.home.hiddenRows"
    const DYNAMIC_SETTING = "ui.home.dynamicRows"
    const DYNAMIC_PREFIX = "plugindynamic:"
    const LEGACY_SLOT_COUNT = 8

    ' Only rows this app can actually build belong here. The other clients split some of
    ' these apart, favourites by media type for instance, and Save carries those ids
    ' through untouched. Declaration order decides where a row nobody arranged ends up.
    function Catalogue() as object
        return [
            { id: "resume", label: "Continue Watching" },
            { id: "nextup", label: "Next Up" },
            { id: "latestmedia", label: "Recently Added Media" },
            { id: "collections", label: "Collections" },
            { id: "smalllibrarytiles", label: "My Media" },
            { id: "favorites", label: "Favorites" },
            { id: "mylist", label: "My List" },
            { id: "genres", label: "Genres" },
            { id: "studios", label: "Studios" },
            { id: "recentlyreleased", label: "Recently Released" },
            { id: "imdb_top_250_movies", label: "IMDb Top 250 Movies" },
            { id: "imdb_top_250_tv_shows", label: "IMDb Top 250 TV Shows" },
            { id: "imdb_most_popular_movies", label: "IMDb Most Popular Movies" },
            { id: "imdb_most_popular_tv_shows", label: "IMDb Most Popular TV Shows" },
            { id: "imdb_lowest_rated_movies", label: "IMDb Lowest Rated Movies" },
            { id: "imdb_top_english_movies", label: "IMDb Top Rated English Movies" },
            { id: "sinceyouwatched", label: "Since You Watched" },
            { id: "rewatch", label: "Rewatch" },
            { id: "playlists", label: "Playlists" },
            { id: "audio", label: "Music" },
            { id: "resumeaudio", label: "Continue Listening" },
            { id: "livetv", label: "Live TV" },
            { id: "radarr_calendar", label: "Radarr Upcoming" },
            { id: "sonarr_calendar", label: "Sonarr Upcoming" },
            { id: "seerr_shortcuts", label: "Seerr Browse" },
            { id: "seerr_recent_requests", label: "Recent Requests" },
            { id: "seerr_recently_added", label: "Recently Added" },
            { id: "seerr_trending", label: "Trending Now" },
            { id: "seerr_popular_movies", label: "Popular Movies" },
            { id: "seerr_popular_series", label: "Popular TV Shows" },
            { id: "seerr_upcoming_movies", label: "Upcoming Movies" },
            { id: "seerr_upcoming_series", label: "Upcoming TV Shows" },
            { id: "seerr_movie_genres", label: "Browse Movies by Genre" },
            { id: "seerr_series_genres", label: "Browse TV by Genre" },
            { id: "seerr_studios", label: "Browse by Studio" },
            { id: "seerr_networks", label: "Browse by Network" },
            { id: "seerr_watchlist", label: "Your Watchlist" },
            { id: "tmdb_popular_movies", label: "TMDB Popular Movies" },
            { id: "tmdb_top_rated_movies", label: "TMDB Top Rated Movies" },
            { id: "tmdb_now_playing_movies", label: "TMDB Now Playing Movies" },
            { id: "tmdb_upcoming_movies", label: "TMDB Upcoming Movies" },
            { id: "tmdb_popular_tv", label: "TMDB Popular TV" },
            { id: "tmdb_top_rated_tv", label: "TMDB Top Rated TV" },
            { id: "tmdb_airing_today_tv", label: "TMDB Airing Today TV" },
            { id: "tmdb_on_the_air_tv", label: "TMDB On The Air TV" },
            { id: "tmdb_trending_movie_daily", label: "TMDB Trending Movies (Daily)" },
            { id: "tmdb_trending_movie_weekly", label: "TMDB Trending Movies (Weekly)" },
            { id: "tmdb_trending_tv_daily", label: "TMDB Trending TV (Daily)" },
            { id: "tmdb_trending_tv_weekly", label: "TMDB Trending TV (Weekly)" },
            { id: "tmdb_trending_all_weekly", label: "TMDB Trending All (Weekly)" }
        ]
    end function

    ' The three lists the server can be asked for, each offered as one row per item. The
    ' source name and the section word both go into the row id, so they have to match what
    ' the other clients write or the same collection ends up with two identities.
    function Sources() as object
        return [
            { key: "collections", section: "collection", gate: "ui.home.displayCollectionsRows", setting: "ui.home.pickCollections", task: "collections" },
            { key: "genres", section: "genre", gate: "ui.home.displayGenresRows", setting: "ui.home.pickGenres", task: "genres" },
            { key: "playlists", section: "playlist", gate: "ui.home.displayPlaylistsRows", setting: "ui.home.pickPlaylists", task: "homeplaylists" }
        ]
    end function

    function SourceFor(key as string) as object
        for each entry in homeRowLayout.Sources()
            if isStringEqual(entry.key, key) then return entry
        end for

        return invalid
    end function

    function SourceForSetting(settingName as dynamic) as object
        name = homeRowLayout.AsText(settingName)
        for each entry in homeRowLayout.Sources()
            if isStringEqual(entry.setting, name) then return entry
        end for

        return invalid
    end function

    ' These rows are keyed on the server they came from, so the same collection on two
    ' servers stays two rows
    function ServerId() as string
        return homeRowLayout.AsText(chainLookupReturn(m.global, "session.server.url", ""))
    end function

    function DynamicId(sourceKey as string, serverKey as string, itemId as string) as string
        entry = homeRowLayout.SourceFor(sourceKey)
        word = isValid(entry) ? entry.section : sourceKey

        return `pluginDynamic:${sourceKey}:${serverKey}:${word}:${itemId}`
    end function

    ' What a row id is asking for, or invalid when it is not one of these rows. The server
    ' key sits in the middle and is a url, so it carries colons of its own and only the two
    ' ends of the id can be read.
    function SourceFromId(id as dynamic) as object
        text = homeRowLayout.AsText(id)
        if not LCase(text).startsWith(homeRowLayout.DYNAMIC_PREFIX) then return invalid

        parts = text.Split(":")
        if parts.Count() < 5 then return invalid

        entry = homeRowLayout.SourceFor(parts[1])
        if not isValid(entry) then return invalid

        return { source: entry.key, itemId: parts[parts.Count() - 1] }
    end function

    function AsText(value as dynamic) as string
        if not isValid(value) then return ""

        return value.ToStr().Trim()
    end function

    ' Rows picked out of those lists. The order and the off list hold them alongside the
    ' built in rows, so only what the loader and the picker cannot work out for themselves
    ' is kept here.
    function DynamicRows() as object
        entries = []

        stored = get_user_setting(homeRowLayout.DYNAMIC_SETTING)
        if not isValidAndNotEmpty(stored) then return entries

        parsed = ParseJson(stored)
        if LCase(type(parsed)) <> "roarray" then return entries

        for each record in parsed
            if LCase(type(record)) <> "roassociativearray" then continue for

            id = homeRowLayout.AsText(record.id)
            if id = "" then continue for

            entries.push({
                id: id,
                source: homeRowLayout.AsText(record.source),
                itemId: homeRowLayout.AsText(record.itemId),
                title: homeRowLayout.AsText(record.title)
            })
        end for

        return entries
    end function

    function DynamicLookup() as object
        found = {}
        for each entry in homeRowLayout.DynamicRows()
            found[LCase(entry.id)] = entry
        end for

        return found
    end function

    sub SaveDynamic(entries as object)
        set_user_setting(homeRowLayout.DYNAMIC_SETTING, FormatJson(entries))
    end sub

    ' A few rows sit behind a switch of their own that turns a whole group on or off. The
    ' home screen honours those switches, so the picker leaves those rows out rather than
    ' offering to arrange something that never appears.
    function Offered() as object
        gates = {
            favorites: "ui.home.displayFavoritesRows",
            collections: "ui.home.displayCollectionsRows",
            genres: "ui.home.displayGenresRows",
            studios: "ui.home.displayStudiosRows",
            radarr_calendar: "calendar.radarr.enabled",
            sonarr_calendar: "calendar.sonarr.enabled",
            playlists: "ui.home.displayPlaylistsRows",
            audio: "ui.home.displayAudioRows",
            rewatch: "ui.home.displayRewatchRow"
        }

        ' Only rows already picked from a list reach the main picker, so it stays short no
        ' matter how many collections the server holds
        picked = {}
        for each entry in homeRowLayout.DynamicRows()
            if not isValid(picked[entry.source]) then picked[entry.source] = []
            picked[entry.source].push({ id: entry.id, label: entry.title })
        end for

        rows = []
        for each row in homeRowLayout.Catalogue()
            gate = gates[row.id]
            if isValid(gate) and not get_user_setting_bool(gate, false) then continue for
            rows.push(row)

            ' A picked row starts beside the list it came from, until the viewer moves it
            fromList = picked[row.id]
            if not isValid(fromList) then continue for
            for each entry in fromList
                rows.push(entry)
            end for
        end for

        return rows
    end function

    ' What a viewer who has never arranged anything starts with, matching the other clients.
    ' Everything else in the catalogue is off until they turn it on.
    function DefaultEnabled() as object
        return ["resume", "nextup", "latestmedia"]
    end function

    ' A row in neither list is one this app started offering after the viewer last arranged
    ' their layout, and those start off, since every row but the opening three is declared
    ' off across the clients.
    function IsEnabled(id as string, placed as object, off as object, picked as object) as boolean
        if isValid(off[id]) then return false
        if inArray(placed, id) then return true

        ' Picking a row is what switches it on, so it needs no place in the order until the
        ' viewer moves it. Until then it sits beside the list it came from.
        if isValid(picked[LCase(id)]) then return true

        return inArray(homeRowLayout.DefaultEnabled(), id)
    end function

    ' The rows the viewer left on, in the order they put them. Only the ids come back,
    ' since that is what the home screen builds from.
    function Arranged() as object
        storedOrder = get_user_setting(homeRowLayout.ORDER_SETTING)
        placed = buttonLayout.ToIds(storedOrder)
        off = buttonLayout.HiddenLookup(get_user_setting(homeRowLayout.HIDDEN_SETTING))

        known = homeRowLayout.Catalogue()
        picked = {}
        for each entry in homeRowLayout.DynamicRows()
            known.push({ id: entry.id, label: entry.title })
            picked[LCase(entry.id)] = entry
        end for

        ids = []
        for each row in buttonLayout.Ordered(known, storedOrder)
            if homeRowLayout.IsEnabled(row.id, placed, off, picked) then ids.push(row.id)
        end for

        return ids
    end function

    ' Carries an existing eight slot layout over to the new list the first time it is needed,
    ' so a viewer who already arranged their rows keeps them. Anything they had turned off
    ' stays off, since a slot set to none never reaches the order.
    sub MigrateLegacySlots()
        if isValidAndNotEmpty(get_user_setting(homeRowLayout.ORDER_SETTING)) then return

        order = []
        for i = 0 to LEGACY_SLOT_COUNT - 1
            slot = LCase(get_user_setting("homeScreenSection" + i.toStr()) ?? "")
            if slot <> "" and slot <> "none" then order.push(slot)
        end for

        ' Nothing to carry over means this is a fresh viewer, who gets the usual starting rows
        if order.count() = 0 then order = homeRowLayout.DefaultEnabled()

        hidden = []
        for each row in homeRowLayout.Catalogue()
            if not inArray(order, row.id) then hidden.push(row.id)
        end for

        set_user_setting(homeRowLayout.ORDER_SETTING, FormatJson(order))
        set_user_setting(homeRowLayout.HIDDEN_SETTING, FormatJson(hidden))
    end sub

    ' A save from here has to carry through every id the picker did not offer. That covers
    ' the rows the other clients have and this app does not, and the rows behind a switch
    ' that is currently off, so saving a layout never erases either.
    function Save(order as object, hidden as object) as object
        return buttonLayout.WithUnknownIds(
            homeRowLayout.Offered(),
            order,
            hidden,
            get_user_setting(homeRowLayout.ORDER_SETTING),
            get_user_setting(homeRowLayout.HIDDEN_SETTING)
        )
    end function

end namespace

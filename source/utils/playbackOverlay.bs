import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' Shared by the skip segment capsule and the Up Next card, which render the same
' countdown and pull frames from the same style of ring.
'
' The colours below are what the other clients draw these overlays with. A custom
' theme replaces them token for token, which is how the rest of the app chooses
' between its own colours and a theme's
const OVERLAY_ACCENT = "0x00A4DCFF"
const OVERLAY_ON_ACCENT = "0xFFFFFFFF"
const OVERLAY_SURFACE = "0x1A1A1AFF"
const OVERLAY_ON_SURFACE = "0xFFFFFFFF"
const OVERLAY_SURFACE_VARIANT = "0x252525FF"
const OVERLAY_CHIP_BORDER = "0x8EC8F055"

' Ring frames run 00 to 40, and the full circle doubles as the unfilled track
const RING_FRAMES = 40
const RING_TRACK = "40"

namespace playbackOverlay

    function Palette() as object
        if not themeChrome.IsActive()
            return {
                accent: OVERLAY_ACCENT,
                onAccent: OVERLAY_ON_ACCENT,
                surface: OVERLAY_SURFACE,
                onSurface: OVERLAY_ON_SURFACE,
                surfaceVariant: OVERLAY_SURFACE_VARIANT,
                chipBorder: OVERLAY_CHIP_BORDER
            }
        end if

        return {
            accent: themeChrome.Accent(),
            onAccent: themeChrome.OnAccent(),
            surface: themeChrome.Surface(),
            onSurface: themeChrome.OnSurface(),
            surfaceVariant: themeChrome.SurfaceVariant(),
            chipBorder: themeChrome.InputBorder()
        }
    end function

    ' Returns the colour with a different alpha, keeping the RGB
    function WithAlpha(colorValue as dynamic, alpha as integer) as string
        rgb = playbackOverlay.HexDigits(colorValue)
        value = alpha
        if value < 0 then value = 0
        if value > 255 then value = 255

        return `0x${Left(rgb, 6)}${playbackOverlay.HexByte(value)}`
    end function


    function HexDigits(colorValue as dynamic) as string
        hex = formatSceneGraphColor(colorValue, "0xFFFFFFFF")
        if Left(hex, 2) = "0x" or Left(hex, 2) = "0X" then hex = Mid(hex, 3)
        while Len(hex) < 8
            hex = hex + "F"
        end while

        return hex
    end function

    function HexByte(value as integer) as string
        digits = UCase(StrI(value, 16).Trim())
        if Len(digits) < 2 then digits = `0${digits}`

        return digits
    end function

    ' Core renders a bare ":09" under a minute and "1:09" above it
    function ClockText(seconds as integer) as string
        value = seconds
        if value < 0 then value = 0

        if value < 60 then return `:${playbackOverlay.PadLeftZero(value)}`

        return `${value \ 60}:${playbackOverlay.PadLeftZero(value mod 60)}`
    end function

    function PadLeftZero(value as integer) as string
        if value < 10 then return `0${value}`

        return value.toStr()
    end function

    ' Rounds a 0..1 progress value onto one of the pre-rendered ring frames
    function RingFrame(progress as float) as string
        frame = Int(progress * RING_FRAMES + 0.5)
        if frame < 0 then frame = 0
        if frame > RING_FRAMES then frame = RING_FRAMES

        return playbackOverlay.PadLeftZero(frame)
    end function

    function SegmentLabel(segmentType as string) as string
        if not isValidAndNotEmpty(segmentType) then return tr("Unknown")

        return tr(UCase(Left(segmentType, 1)) + Mid(segmentType, 2))
    end function

end namespace

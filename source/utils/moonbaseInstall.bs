' What the setup wizard's Moonbase dialog says and sends, kept free of the network so it can be tested
namespace moonbaseInstall
    const MANIFEST_URL = "https://raw.githubusercontent.com/Moonfin-Client/Plugin/refs/heads/master/manifest.json"
    const NAME = "Moonbase"
    const GUID = "8c5d0e91-4f2a-4b6d-9e3f-1a7c8d9e0f2b"

    function GuideUrl(serverType as string) as string
        return "https://github.com/Moonfin-Client/Plugin/wiki/Installation#" + LCase(serverType)
    end function

    ' Moonbase for Plex and Silo can't read the library, so they offer less
    function Features(serverType as string) as object
        fullPlugin = serverType = "jellyfin" or serverType = "emby"
        list = [tr("Settings synced across your devices"), tr("Extra ratings and TMDB reviews")]
        if fullPlugin then list.append([tr("Seerr requests"), tr("Custom rows from your favorite lists"), tr("Retro games with synced saves")])
        if serverType <> "silo" then list.push(tr("A calendar of what's coming up"))
        if not fullPlugin then list.push(tr("Your own order for each collection"))
        list.append([tr("Custom themes"), tr("Messages from your server admin")])
        return list
    end function

    ' The server's repositories with Moonbase added and turned on, keeping the rest, or invalid when it already is
    function RepositoriesWith(repos as object) as dynamic
        kept = []
        for each repo in repos
            if repo.Url = moonbaseInstall.MANIFEST_URL
                if repo.Enabled = true then return invalid
            else
                kept.push(repo)
            end if
        end for
        ' Set by name so the keys keep the case the server sends
        moonbase = {}
        moonbase.AddReplace("Name", moonbaseInstall.NAME)
        moonbase.AddReplace("Url", moonbaseInstall.MANIFEST_URL)
        moonbase.AddReplace("Enabled", true)
        kept.push(moonbase)
        return kept
    end function
end namespace

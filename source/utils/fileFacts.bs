import "pkg:/source/utils/misc.bs"

' What the details screens say about the file behind a title.
'
' These deliberately dont reuse the friendlier codec and range names the player shows. They
' report what the file says it is, so a codec stays the letters the server gave and a range keeps
' its type beside it.
namespace fileFacts

    ' Whole megabytes up to 999, gigabytes to two places past that
    function FormatSize(bytes as dynamic) as string
        if not fileFacts.IsNumber(bytes) or bytes <= 0 then return ""

        megabytes = bytes / 1048576.0
        if megabytes > 999 then return fileFacts.Fixed(megabytes / 1024.0, 2) + " GB"
        return Int(megabytes + 0.5).ToStr() + " MB"
    end function

    ' A number written out to a set count of places, zeros kept
    function Fixed(value as dynamic, places as integer) as string
        scale = 1
        for i = 1 to places
            scale *= 10
        end for

        rounded = Int(value * scale + 0.5)
        whole = rounded \ scale
        text = whole.ToStr()
        if places = 0 then return text

        return text + "." + leftPad((rounded - whole * scale).ToStr(), "0", places)
    end function

    function IsNumber(value as dynamic) as boolean
        valueType = LCase(type(value))
        return valueType = "integer" or valueType = "rointeger" or valueType = "roint" or valueType = "longinteger" or valueType = "rolonginteger" or valueType = "float" or valueType = "rofloat" or valueType = "double" or valueType = "rodouble" or valueType = "rointrinsicdouble"
    end function

    ' The name the server holds for the file, falling back to the last part of its path where it
    ' only gave one of those
    function FileName(source as dynamic) as string
        held = chainLookupReturn(source, "Name", "")
        if isValidAndNotEmpty(held) then return held.Trim()

        path = chainLookupReturn(source, "Path", "")
        if not isValidAndNotEmpty(path) then return ""

        parts = path.Trim().Replace("\", "/").Split("/")
        if parts.count() = 0 then return ""
        return parts[parts.count() - 1]
    end function

    ' Both halves or neither, since one on its own reads as a sentence with a hole in it
    function SizeLine(source as dynamic) as string
        size = fileFacts.FormatSize(chainLookupReturn(source, "Size", 0))
        container = UCase(chainLookupReturn(source, "Container", ""))
        if size = "" or container = "" then return ""

        return Substitute(tr("Size: {0}  •  Format: {1}"), size, container)
    end function

    function VideoLines(video as dynamic) as object
        if not isValid(video) then return []

        lines = []
        codec = UCase(chainLookupReturn(video, "Codec", ""))
        if codec = "" then codec = tr("Unknown Codec")
        profile = chainLookupReturn(video, "Profile", "")
        lines.push(isValidAndNotEmpty(profile) ? `${codec} (${profile})` : codec)

        width = chainLookupReturn(video, "Width", 0)
        height = chainLookupReturn(video, "Height", 0)
        if fileFacts.IsNumber(width) and fileFacts.IsNumber(height) and width > 0 and height > 0 then lines.push(`${width} × ${height}`)

        fps = chainLookupReturn(video, "RealFrameRate", 0)
        if not fileFacts.IsNumber(fps) or fps <= 0 then fps = chainLookupReturn(video, "AverageFrameRate", 0)
        if fileFacts.IsNumber(fps) and fps > 0 then lines.push(fileFacts.Fixed(fps, 3) + " fps")

        bitDepth = chainLookupReturn(video, "BitDepth", 0)
        if fileFacts.IsNumber(bitDepth) and bitDepth > 0 then lines.push(`${bitDepth}-bit`)

        range = chainLookupReturn(video, "VideoRange", "")
        if isValidAndNotEmpty(range)
            rangeType = chainLookupReturn(video, "VideoRangeType", "")
            lines.push(isValidAndNotEmpty(rangeType) ? `${range} (${rangeType})` : range)
        end if

        return lines
    end function

    ' One track as the File Information tab lists it, its language in capitals and its flags
    ' in brackets after it
    function TrackLine(stream as object, includeForced as boolean) as string
        title = chainLookupReturn(stream, "DisplayTitle", "")
        if not isValidAndNotEmpty(title) then title = UCase(chainLookupReturn(stream, "Codec", ""))

        language = chainLookupReturn(stream, "Language", "")
        language = isValidAndNotEmpty(language) ? UCase(language) : tr("Unknown")

        line = `${title} (${language})`
        if chainLookupReturn(stream, "IsDefault", false) = true then line += ` [${tr("Default")}]`
        if includeForced and chainLookupReturn(stream, "IsForced", false) = true then line += ` [${tr("Forced")}]`
        return line
    end function

    ' Shown in local time, since the server sends UTC and an evening west of UTC would read as
    ' the next day. A new roDateTime starts at the current time, so a string it cant read has
    ' to be caught before it is parsed.
    function AddedOn(dateCreated as dynamic) as string
        if not isString(dateCreated) or Len(dateCreated) < 19 then return ""
        if Mid(dateCreated, 5, 1) <> "-" or Mid(dateCreated, 11, 1) <> "T" then return ""

        date = CreateObject("roDateTime")
        date.FromISO8601String(Left(dateCreated, 19) + "Z")
        date.ToLocalTime()

        months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
        month = date.GetMonth()
        if month < 1 or month > 12 then return ""
        return `${tr(months[month - 1])} ${date.GetDayOfMonth()}, ${date.GetYear()}`
    end function

end namespace

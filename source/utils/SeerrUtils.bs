' Seerr API Configuration and Utilities

' ============================================
' Permission Constants (from Seerr)
' ============================================
' Permission bits from https://github.com/seerr-team/seerr/blob/develop/server/lib/permissions.ts
' Stands in until the plugin reports a real bitmask, matching the other clients
const SEERR_PERMISSIONS_UNKNOWN = &hFFFFFFF
const SEERR_PERMISSION_ADMIN = 2
const SEERR_PERMISSION_MANAGE_REQUESTS = 16
const SEERR_PERMISSION_REQUEST = 32
const SEERR_PERMISSION_REQUEST_4K = 1024
const SEERR_PERMISSION_REQUEST_4K_MOVIE = 2048
const SEERR_PERMISSION_REQUEST_4K_TV = 4096
const SEERR_PERMISSION_REQUEST_ADVANCED = 8192
const SEERR_PERMISSION_REQUEST_MOVIE = 262144
const SEERR_PERMISSION_MANAGE_ISSUES = 1048576
const SEERR_PERMISSION_VIEW_ISSUES = 2097152
const SEERR_PERMISSION_CREATE_ISSUES = 4194304

' Check if user has a specific Seerr permission
' @param permissions - User's permission bitmask
' @param permission - Permission constant to check
' @returns True if user has the permission (or is admin)
function HasSeerrPermission(permissions as integer, permission as integer) as boolean
    ' Admin has all permissions
    if (permissions and SEERR_PERMISSION_ADMIN) <> 0
        return true
    end if
    return (permissions and permission) <> 0
end function

' Check if user can request 4K content for a specific media type
' @param permissions - User's permission bitmask
' @param mediaType - "movie" or "tv"
' @returns True if user can request 4K for this media type
function CanRequest4K(permissions as integer, mediaType as string) as boolean
    if not Seerr4kEnabled(mediaType) then return false

    ' Admin can request anything
    if (permissions and SEERR_PERMISSION_ADMIN) <> 0
        return true
    end if

    ' Check general 4K permission first
    if (permissions and SEERR_PERMISSION_REQUEST_4K) <> 0
        return true
    end if

    ' Check specific media type permission
    if mediaType = "movie"
        return (permissions and SEERR_PERMISSION_REQUEST_4K_MOVIE) <> 0
    else if mediaType = "tv"
        return (permissions and SEERR_PERMISSION_REQUEST_4K_TV) <> 0
    end if

    return false
end function

' Whether the server has 4K switched on for this media type. Seerr leaves the flag out on
' older builds, so an answer that hasn't arrived or doesn't carry it counts as on.
function Seerr4kEnabled(mediaType as string) as boolean
    publicSettings = invalid
    if m.global <> invalid then publicSettings = m.global.seerrPublicSettings
    if publicSettings = invalid then return true

    if mediaType = "tv"
        flag = publicSettings.series4kEnabled
    else
        flag = publicSettings.movie4kEnabled
    end if

    if flag = invalid then return true
    return flag = true
end function

' Fetched once a session, since it only changes when the server is reconfigured
sub EnsureSeerrPublicSettings()
    if m.global = invalid then return
    if m.global.seerrPublicSettings <> invalid then return
    if m.seerrPublicSettingsTask <> invalid then return

    m.seerrPublicSettingsTask = CreateObject("roSGNode", "SeerrAPITask")
    m.seerrPublicSettingsTask.request = {
        method: "GET",
        endpoint: "/api/v1/settings/public"
    }
    m.seerrPublicSettingsTask.observeField("response", "onSeerrPublicSettingsLoaded")
    m.seerrPublicSettingsTask.control = "RUN"
end sub

sub onSeerrPublicSettingsLoaded(event as object)
    response = event.getData()
    m.seerrPublicSettingsTask = invalid

    if response = invalid or response.success <> true or response.data = invalid then return
    m.global.addFields({ seerrPublicSettings: response.data })
end sub

' The viewer's own Seerr settings, fetched once a session and dropped when the Seerr account changes
sub EnsureSeerrUserSettings()
    if m.global = invalid then return
    if m.global.seerrUserSettings <> invalid then return
    if m.seerrUserSettingsTask <> invalid then return

    m.seerrUserSettingsTask = CreateObject("roSGNode", "SeerrAPITask")
    m.seerrUserSettingsTask.request = {
        method: "GET",
        endpoint: "/api/v1/auth/me"
    }
    m.seerrUserSettingsTask.observeField("response", "onSeerrUserSettingsLoaded")
    m.seerrUserSettingsTask.control = "RUN"
end sub

sub onSeerrUserSettingsLoaded(event as object)
    response = event.getData()
    m.seerrUserSettingsTask = invalid

    if response = invalid or response.success <> true or response.data = invalid then return
    userSettings = response.data.settings
    if type(userSettings) <> "roAssociativeArray" then userSettings = {}
    m.global.addFields({ seerrUserSettings: userSettings })
end sub

' Where a title's streaming services are looked up, in the order Seerr's own page uses: the
' viewer's region, then the server's, then the US
function SeerrStreamingRegion() as string
    if m.global = invalid then return "US"

    for each stored in [m.global.seerrUserSettings, m.global.seerrPublicSettings]
        if isValid(stored) and isValidAndNotEmpty(stored.streamingRegion) then return stored.streamingRegion
    end for
    return "US"
end function

' The services that include a title with a subscription in a region, in the order Seerr sends them
function SeerrStreamingProviders(details as object, region as string) as object
    providers = []
    if not isValid(details) or type(details.watchProviders) <> "roArray" then return providers

    for each entry in details.watchProviders
        if type(entry) = "roAssociativeArray" and isStringEqual(entry.iso_3166_1, region)
            if type(entry.flatrate) <> "roArray" then return providers
            for each provider in entry.flatrate
                if type(provider) = "roAssociativeArray" and isString(provider.name) then providers.push(provider)
            end for
            return providers
        end if
    end for
    return providers
end function

' Check if user has advanced request permission (can select server, profile, root folder)
' @param permissions - User's permission bitmask
' @returns True if user has REQUEST_ADVANCED permission (or is admin/manage requests)
function HasAdvancedRequestPermission(permissions as integer) as boolean

    ' Admin has all permissions
    if (permissions and SEERR_PERMISSION_ADMIN) <> 0
        return true
    end if
    ' MANAGE_REQUESTS also grants advanced request options
    if (permissions and SEERR_PERMISSION_MANAGE_REQUESTS) <> 0
        return true
    end if
    hasAdvanced = (permissions and SEERR_PERMISSION_REQUEST_ADVANCED) <> 0
    return hasAdvanced
end function

' ============================================
' User ID Management
' ============================================

' Get the current logged-in Jellyfin user ID
' Returns empty string if no user is logged in
function GetCurrentJellyfinUserId() as string
    if m.global <> invalid and m.global.session <> invalid and m.global.session.user <> invalid and m.global.session.user.id <> invalid
        return m.global.session.user.id
    end if
    return ""
end function

' The Seerr account behind the signed-in Jellyfin user, which the quota is keyed by
function CurrentSeerrUserId() as integer
    userId = GetCurrentJellyfinUserId()
    if userId = "" then return 0

    return GetSeerrUserConfig(userId).seerrUserId
end function

' Get the last Jellyfin user ID that used Seerr
' Returns empty string if never set
function GetLastSeerrUserId() as string
    sec = CreateObject("roRegistrySection", "seerr_global")
    lastUserId = sec.Read("lastJellyfinUserId")
    if lastUserId = invalid
        return ""
    end if
    return lastUserId
end function

' Store the last Jellyfin user ID that used Seerr
' @param userId - Jellyfin user ID to store
sub SetLastSeerrUserId(userId as string)
    if userId = ""
        return
    end if

    sec = CreateObject("roRegistrySection", "seerr_global")
    sec.Write("lastJellyfinUserId", userId)
    sec.Flush()
end sub

' Get the registry section name for a specific user's Seerr settings
' @param userId - Jellyfin user ID
' @returns Registry section name like "seerr_user_abc123"
function GetSeerrUserRegistry(userId as string) as string
    if userId = ""
        return ""
    end if
    return "seerr_user_" + userId
end function

' ============================================
' Migration & Backward Compatibility
' ============================================

' Carry pre-rename device data from the jellyseerr_* registry namespace (and the
' jellyseerr.* per-user setting keys) over to the seerr_* names. Idempotent: each copy
' no-ops once the target already holds data.
sub MigrateSeerrRegistryNamespace()
    CopyRegistrySectionIfEmpty("jellyseerr_global", "seerr_global")

    userId = GetCurrentJellyfinUserId()
    if userId <> ""
        CopyRegistrySectionIfEmpty("jellyseerr_user_" + userId, "seerr_user_" + userId)
        ' Per-user settings are stored in a registry section named after the user id,
        ' keyed by settingName (e.g. "jellyseerr.enabled" -> "seerr.enabled").
        MigrateUserSettingPrefix(userId, "jellyseerr.", "seerr.")
    end if
end sub

sub CopyRegistrySectionIfEmpty(fromName as string, toName as string)
    toSec = CreateObject("roRegistrySection", toName)
    toKeys = toSec.GetKeyList()
    if toKeys <> invalid and toKeys.Count() > 0 then return

    fromSec = CreateObject("roRegistrySection", fromName)
    fromKeys = fromSec.GetKeyList()
    if fromKeys = invalid then return

    for each k in fromKeys
        if fromSec.Exists(k)
            toSec.Write(k, fromSec.Read(k))
        end if
    end for
    toSec.Flush()
end sub

sub MigrateUserSettingPrefix(sectionName as string, oldPrefix as string, newPrefix as string)
    sec = CreateObject("roRegistrySection", sectionName)
    keys = sec.GetKeyList()
    if keys = invalid then return

    changed = false
    for each k in keys
        if Left(k, Len(oldPrefix)) = oldPrefix
            newKey = newPrefix + Mid(k, Len(oldPrefix) + 1)
            if not sec.Exists(newKey)
                sec.Write(newKey, sec.Read(k))
                changed = true
            end if
        end if
    end for
    if changed then sec.Flush()
end sub

' Migrate old Seerr configuration to new separated registry structure
' This runs once per installation and preserves all existing settings
' Old structure: Single "seerr" registry for all data
' New structure: "seerr_global" + "seerr_user_{userId}" per user
sub MigrateSeerrConfig()
    ' Check if migration already completed
    globalSec = CreateObject("roRegistrySection", "seerr_global")
    migrated = globalSec.Read("migrated")
    if migrated = "true"
        ' Already migrated, skip
        return
    end if

    ' Check if old registry section exists
    oldSec = CreateObject("roRegistrySection", "seerr")
    oldServerUrl = oldSec.Read("serverUrl")

    ' If no old config exists, just mark as migrated and return
    if oldServerUrl = invalid or oldServerUrl = ""
        globalSec.Write("migrated", "true")
        globalSec.Flush()
        return
    end if

    ' Get current user ID (migration only works if user is logged in)
    userId = GetCurrentJellyfinUserId()
    if userId = ""
        ' Migrate blockNsfw (default to true if not set)
        oldBlockNsfw = oldSec.Read("blockNsfw")
        if oldBlockNsfw <> invalid
            oldBlockNsfwType = type(oldBlockNsfw)
            if (oldBlockNsfwType = "String" or oldBlockNsfwType = "roString") and oldBlockNsfw = ""
                globalSec.Write("blockNsfw", "true")
            else
                globalSec.Write("blockNsfw", oldBlockNsfw)
            end if
        else
            globalSec.Write("blockNsfw", "true")
        end if

        globalSec.Write("migrated", "true")
        globalSec.Flush()
        return
    end if

    ' Migrate global blockNsfw preference
    oldBlockNsfw = oldSec.Read("blockNsfw")
    if oldBlockNsfw <> invalid
        oldBlockNsfwType = type(oldBlockNsfw)
        if (oldBlockNsfwType = "String" or oldBlockNsfwType = "roString") and oldBlockNsfw = ""
            globalSec.Write("blockNsfw", "true")
        else
            globalSec.Write("blockNsfw", oldBlockNsfw)
        end if
    else
        globalSec.Write("blockNsfw", "true") ' Default to enabled
    end if

    ' Migrate user-specific settings (authCookie, authMethod, credentials)
    userRegistry = GetSeerrUserRegistry(userId)
    userSec = CreateObject("roRegistrySection", userRegistry)

    ' Migrate authCookie
    oldAuthCookie = oldSec.Read("authCookie")
    if oldAuthCookie <> invalid and oldAuthCookie <> ""
        userSec.Write("authCookie", oldAuthCookie)
    end if

    ' Migrate authMethod
    oldAuthMethod = oldSec.Read("authMethod")
    if oldAuthMethod <> invalid and oldAuthMethod <> ""
        userSec.Write("authMethod", oldAuthMethod)
    else
        ' Default to jellyfin if not set
        userSec.Write("authMethod", "jellyfin")
    end if

    ' Migrate Jellyfin password (if stored)
    oldJellyfinPassword = oldSec.Read("jellyfinPassword")
    if oldJellyfinPassword <> invalid and oldJellyfinPassword <> ""
        userSec.Write("jellyfinPassword", oldJellyfinPassword)
    end if

    ' Migrate local credentials (if stored)
    oldLocalEmail = oldSec.Read("localEmail")
    if oldLocalEmail <> invalid and oldLocalEmail <> ""
        userSec.Write("localEmail", oldLocalEmail)
    end if

    oldLocalPassword = oldSec.Read("localPassword")
    if oldLocalPassword <> invalid and oldLocalPassword <> ""
        userSec.Write("localPassword", oldLocalPassword)
    end if

    userSec.Flush()

    ' Mark migration as complete
    globalSec.Write("migrated", "true")
    globalSec.Flush()

    ' Delete old registry section to clean up
    oldSec.Delete("serverUrl")
    oldSec.Delete("apiKey")
    oldSec.Delete("authCookie")
    oldSec.Delete("authMethod")
    oldSec.Delete("blockNsfw")
    oldSec.Delete("enabled")
    oldSec.Delete("jellyfinPassword")
    oldSec.Delete("localEmail")
    oldSec.Delete("localPassword")
    oldSec.Flush()
end sub

' ============================================
' User Switch Detection & Cleanup
' ============================================

' Handle Jellyfin user switch - clears previous user's session data
' Called after successful user login to detect and handle user changes
' @returns True if user switch was detected and handled, false if same user
function HandleSeerrUserSwitch() as boolean
    currentUserId = GetCurrentJellyfinUserId()
    if currentUserId = ""
        ' No user logged in, nothing to do
        return false
    end if

    ' Ensure this user's pre-rename device data is carried over.
    MigrateSeerrRegistryNamespace()

    lastUserId = GetLastSeerrUserId()

    ' Check if this is a different user
    if lastUserId <> "" and lastUserId <> currentUserId
        ' Just update the last user ID - each user keeps their own session
        SetLastSeerrUserId(currentUserId)

        return true
    else if lastUserId = ""
        ' First time using Seerr, just set the user ID
        SetLastSeerrUserId(currentUserId)
        return false
    end if

    ' Same user, no switch
    return false
end function

' ============================================
' Global & Per-User Config Helpers
' ============================================

' Get global Seerr settings (shared across all users)
' @returns Object with blockNsfw
function GetSeerrGlobalConfig() as object
    sec = CreateObject("roRegistrySection", "seerr_global")

    blockNsfwStr = sec.Read("blockNsfw")
    blockNsfw = true ' Default to enabled
    if blockNsfwStr <> invalid and blockNsfwStr <> ""
        blockNsfw = (blockNsfwStr = "true")
    end if

    return {
        blockNsfw: blockNsfw
    }
end function

' Set global Seerr settings (shared across all users)
' @param blockNsfw - Whether to block NSFW content
sub SetSeerrGlobalConfig(blockNsfw as boolean)
    sec = CreateObject("roRegistrySection", "seerr_global")

    if blockNsfw
        sec.Write("blockNsfw", "true")
    else
        sec.Write("blockNsfw", "false")
    end if

    sec.Flush()
end sub

' Get user-specific Seerr settings
' @param userId - Jellyfin user ID
' @returns Object with authCookie, authMethod, credentials
function GetSeerrUserConfig(userId as string) as object
    if userId = ""
        return {
            authCookie: "",
            authMethod: "jellyfin",
            jellyfinPassword: "",
            localEmail: "",
            localPassword: "",
            seerrUserId: 0,
            displayName: "",
            avatar: "",
            permissions: 0
        }
    end if

    registryName = GetSeerrUserRegistry(userId)
    sec = CreateObject("roRegistrySection", registryName)

    authCookie = sec.Read("authCookie")
    if authCookie = invalid then authCookie = ""

    authMethod = sec.Read("authMethod")
    if authMethod = invalid or authMethod = "" then authMethod = "jellyfin"

    jellyfinPassword = sec.Read("jellyfinPassword")
    if jellyfinPassword = invalid then jellyfinPassword = ""

    localEmail = sec.Read("localEmail")
    if localEmail = invalid then localEmail = ""

    localPassword = sec.Read("localPassword")
    if localPassword = invalid then localPassword = ""

    seerrUserIdStr = sec.Read("seerrUserId")
    seerrUserId = 0
    if seerrUserIdStr <> invalid and seerrUserIdStr <> ""
        seerrUserId = seerrUserIdStr.toInt()
    end if

    displayName = sec.Read("displayName")
    if displayName = invalid then displayName = ""

    avatar = sec.Read("avatar")
    if avatar = invalid then avatar = ""

    permissionsStr = sec.Read("permissions")
    permissions = 0
    if permissionsStr <> invalid and permissionsStr <> ""
        permissions = permissionsStr.toInt()
    end if

    return {
        authCookie: authCookie,
        authMethod: authMethod,
        jellyfinPassword: jellyfinPassword,
        localEmail: localEmail,
        localPassword: localPassword,
        seerrUserId: seerrUserId,
        displayName: displayName,
        avatar: avatar,
        permissions: permissions
    }
end function

' Set user-specific Seerr settings
' @param userId - Jellyfin user ID
' @param authCookie - Session cookie
' @param authMethod - Authentication method ("jellyfin" or "local")
' @param jellyfinPassword - Jellyfin password (optional, for auto-login)
' @param localEmail - Local account email (optional)
' @param localPassword - Local account password (optional)
sub SetSeerrUserConfig(userId as string, authCookie as string, authMethod as string, jellyfinPassword = "" as string, localEmail = "" as string, localPassword = "" as string)
    if userId = ""
        return
    end if

    registryName = GetSeerrUserRegistry(userId)

    sec = CreateObject("roRegistrySection", registryName)

    if authCookie <> ""
        sec.Write("authCookie", authCookie)
    end if

    if authMethod <> ""
        sec.Write("authMethod", authMethod)
    end if

    if jellyfinPassword <> ""
        sec.Write("jellyfinPassword", jellyfinPassword)
    else
        sec.Delete("jellyfinPassword")
    end if

    if localEmail <> ""
        sec.Write("localEmail", localEmail)
    else
        sec.Delete("localEmail")
    end if

    if localPassword <> ""
        sec.Write("localPassword", localPassword)
    else
        sec.Delete("localPassword")
    end if

    sec.Flush()
end sub

' Save Seerr user permissions
' @param userId - Jellyfin user ID
' @param permissions - Permission bitmask from /auth/me response
sub SetSeerrUserPermissions(userId as string, permissions as integer)
    if userId = ""
        return
    end if

    registryName = GetSeerrUserRegistry(userId)
    sec = CreateObject("roRegistrySection", registryName)
    sec.Write("permissions", permissions.toStr())
    sec.Flush()
end sub

sub SetSeerrUserIdentity(userId as string, seerrUserId as integer, displayName as string, permissions as integer, avatar = "" as string)
    if userId = ""
        return
    end if

    registryName = GetSeerrUserRegistry(userId)
    sec = CreateObject("roRegistrySection", registryName)
    sec.Write("seerrUserId", seerrUserId.toStr())

    if displayName <> ""
        sec.Write("displayName", displayName)
    else
        sec.Delete("displayName")
    end if

    if avatar <> ""
        sec.Write("avatar", avatar)
    else
        sec.Delete("avatar")
    end if

    sec.Write("permissions", permissions.toStr())
    sec.Flush()

    if m.global.hasField("seerrUserSettings") then m.global.removeField("seerrUserSettings")
end sub

sub ClearSeerrUserIdentity(userId as string)
    if userId = ""
        return
    end if

    registryName = GetSeerrUserRegistry(userId)
    sec = CreateObject("roRegistrySection", registryName)
    sec.Delete("seerrUserId")
    sec.Delete("displayName")
    sec.Delete("avatar")
    sec.Delete("permissions")
    sec.Flush()

    if m.global.hasField("seerrUserSettings") then m.global.removeField("seerrUserSettings")
end sub

' Seerr grants every account a set of rights, and the plugin only reports them when it
' knows them. A payload with no bitmask means unknown rather than none, so the buttons
' behind a right are offered the way the other clients offer them.
function SeerrPermissionsFrom(payload as object) as integer
    if payload = invalid then return SEERR_PERMISSIONS_UNKNOWN
    if not payload.DoesExist("permissions") then return SEERR_PERMISSIONS_UNKNOWN

    value = payload.permissions
    if value = invalid then return SEERR_PERMISSIONS_UNKNOWN
    return Int(value)
end function

' Get current user's Seerr permissions
' @returns Permission bitmask
function GetCurrentUserSeerrPermissions() as integer
    userId = GetCurrentJellyfinUserId()
    if userId = ""
        return 0
    end if

    config = GetSeerrUserConfig(userId)
    ' Nothing stored means the plugin never reported a bitmask, not that the account
    ' holds no rights, so the rights-gated buttons stay on offer
    if config.permissions = 0 then return SEERR_PERMISSIONS_UNKNOWN
    return config.permissions
end function

' ============================================
' TMDB Image URLs
' ============================================

' TMDB Image Base URLs (cached to avoid repeated concatenation)
function GetTmdbImageBaseUrls() as object
    return {
        posterW500: "https://image.tmdb.org/t/p/w500",
        posterW342: "https://image.tmdb.org/t/p/w342",
        backdropW1280: "https://image.tmdb.org/t/p/w1280",
        backdropW780: "https://image.tmdb.org/t/p/w780"
    }
end function

' Get complete Seerr configuration (combines global and user-specific settings)
' NOTE: Now uses separated registry sections for global vs per-user data
' @returns Object with all Seerr settings
function GetSeerrConfig() as object
    pluginEnabled = false
    pluginSeerrEnabled = false
    seerrSettingEnabled = false
    serverUrl = ""

    if m.global <> invalid and m.global.session <> invalid
        if m.global.session.user <> invalid and m.global.session.user.settings <> invalid
            pluginEnabled = SeerrParseBool(m.global.session.user.settings["plugin.enabled"], false)
            seerrSettingEnabled = SeerrParseBool(m.global.session.user.settings["seerr.enabled"], false)
        end if
        if m.global.session.pluginInfo <> invalid
            pluginSeerrEnabled = SeerrParseBool(m.global.session.pluginInfo.seerrEnabled, false)
        end if
        if m.global.session.server <> invalid
            serverUrl = m.global.session.server.url ?? ""
        end if
    end if

    ' Seerr is reached only through the Moonfin server plugin proxy. The client never
    ' connects to Seerr directly, so there is no Seerr URL or API key to configure.
    ' serverUrl here is the Jellyfin server the proxy lives on.
    return {
        serverUrl: serverUrl,
        authMethod: "plugin",
        blockNsfw: GetSeerrGlobalConfig().blockNsfw,
        enabled: (pluginEnabled and pluginSeerrEnabled and seerrSettingEnabled and serverUrl <> ""),
        usePluginProxy: true
    }
end function

' Whether Moonbase can read the Radarr/Sonarr queue. An older plugin, or one without Seerr set up,
' leaves it out, and everything then shows what Seerr reports.
function SeerrArrQueueAvailable() as boolean
    if not GetSeerrConfig().enabled then return false
    return SeerrParseBool(chainLookupReturn(m.global.session, "pluginInfo.arrQueueAvailable", false), false)
end function

' What to call Seerr on screen. A server running a fork names it in the plugin config,
' and anything else falls back on the name the navigation bar already uses.
function GetSeerrDisplayName() as string
    if m.global = invalid or m.global.session = invalid then return "Seerr"

    pluginInfo = m.global.session.pluginInfo
    if pluginInfo = invalid then return "Seerr"

    name = pluginInfo.seerrDisplayName
    if isValidStringValue(name) then return name

    return "Seerr"
end function

' A season or an episode, which Seerr only knows as part of its series
function IsSeerrSeriesPart(itemData as dynamic) as boolean
    if type(itemData) <> "roAssociativeArray" then return false
    if not isStringEqual(itemData.Type, "Season") and not isStringEqual(itemData.Type, "Episode") then return false
    return isValidAndNotEmpty(itemData.SeriesId)
end function

' Which Seerr title a library item stands for. Only movies and series have a counterpart,
' and an episode or a season resolves through its series page instead.
function GetSeerrTargetFor(itemData as object) as object
    idle = { tmdbId: "", mediaType: "" }
    if itemData = invalid or not isValidStringValue(itemData.Type) then return idle

    if LCase(itemData.Type) = "series"
        mediaType = "tv"
    else if LCase(itemData.Type) = "movie"
        mediaType = "movie"
    else
        return idle
    end if

    providerIds = itemData.ProviderIds
    if providerIds = invalid or type(providerIds) <> "roAssociativeArray" then return idle

    ' Jellyfin keeps provider ids as strings and varies their casing between servers
    tmdbId = providerIds.LookupCI("Tmdb")
    if tmdbId = invalid then return idle

    tmdbId = tmdbId.toStr()
    if tmdbId = "" or tmdbId.toInt() <= 0 then return idle

    return { tmdbId: tmdbId, mediaType: mediaType }
end function

' Disable Seerr and clear all configuration
' Clears both global settings and current user's settings
sub DisableSeerr()
    ' Clear global settings
    globalSec = CreateObject("roRegistrySection", "seerr_global")
    globalSec.Delete("serverUrl")
    globalSec.Delete("blockNsfw")
    globalSec.Flush()

    ' Clear current user's settings
    userId = GetCurrentJellyfinUserId()
    if userId <> ""
        userRegistry = GetSeerrUserRegistry(userId)
        userSec = CreateObject("roRegistrySection", userRegistry)
        userSec.Delete("authCookie")
        userSec.Delete("authMethod")
        userSec.Delete("jellyfinPassword")
        userSec.Delete("localEmail")
        userSec.Delete("localPassword")
        userSec.Delete("seerrUserId")
        userSec.Delete("displayName")
        userSec.Delete("avatar")
        userSec.Delete("permissions")
        userSec.Flush()
    end if
end sub

' Set NSFW filtering preference (global setting shared across all users)
' @param enabled - True to block NSFW content, false to allow
sub SetSeerrBlockNsfw(enabled as boolean)
    SetSeerrGlobalConfig(enabled)
end sub

function BuildQueryString(params as object) as string
    if params = invalid
        return ""
    end if

    query = ""
    for each key in params
        if query <> ""
            query = query + "&"
        end if
        value = params[key]

        if type(value) = "String" or type(value) = "roString"
            query = query + key + "=" + UrlEncode(value)
        else
            query = query + key + "=" + value.ToStr()
        end if
    end for

    return query
end function

function UrlEncode(str as string) as string
    encoded = ""
    for i = 0 to str.Len() - 1
        char = str.Mid(i, 1)
        if char = " "
            encoded = encoded + "%20"
        else if char = "&"
            encoded = encoded + "%26"
        else if char = "="
            encoded = encoded + "%3D"
        else if char = "/"
            encoded = encoded + "%2F"
        else
            encoded = encoded + char
        end if
    end for
    return encoded
end function

' A quoted JSON string, escaping the backslashes of a Windows path and any quote or control
' character a name or password can hold
function SeerrEscapeJsonString(value as string) as string
    result = """"
    hexDigits = "0123456789abcdef"
    for i = 1 to Len(value)
        char = Mid(value, i, 1)
        code = Asc(char)
        if code = 34 or code = 92
            result = result + Chr(92) + char
        else if code = 8
            result = result + Chr(92) + "b"
        else if code = 9
            result = result + Chr(92) + "t"
        else if code = 10
            result = result + Chr(92) + "n"
        else if code = 12
            result = result + Chr(92) + "f"
        else if code = 13
            result = result + Chr(92) + "r"
        else if code < 32
            result = result + Chr(92) + "u00" + Mid(hexDigits, Int(code / 16) + 1, 1) + Mid(hexDigits, (code mod 16) + 1, 1)
        else
            result = result + char
        end if
    end for
    return result + """"
end function

' Seerr wants camelCase keys, and an associative array hands its keys back lowercased once it
' has been through a node field. Building from ordered pairs keeps the case the caller wrote.
function SeerrJsonFromPairs(pairs as object) as string
    json = "{"

    for i = 0 to pairs.Count() - 1
        if i > 0
            json = json + ","
        end if
        json = json + SeerrEscapeJsonString(pairs[i].key) + ":" + SeerrFormatJsonValue(pairs[i].value)
    end for

    return json + "}"
end function

function SeerrFormatJson(obj as object) as string
    if obj = invalid
        return "{}"
    end if

    json = "{"
    isFirst = true

    for each key in obj
        if not isFirst
            json = json + ","
        end if
        isFirst = false

        json = json + SeerrEscapeJsonString(key) + ":"
        value = obj[key]
        json = json + SeerrFormatJsonValue(value)
    end for

    json = json + "}"
    return json
end function

function SeerrFormatJsonValue(value as dynamic) as string
    if value = invalid
        return "null"
    else if type(value) = "String" or type(value) = "roString"
        return SeerrEscapeJsonString(value)
    else if SeerrIsNumber(value)
        return value.ToStr()
    else if type(value) = "Boolean" or type(value) = "roBoolean"
        if value
            return "true"
        else
            return "false"
        end if
    else if type(value) = "roArray"
        json = "["
        for i = 0 to value.Count() - 1
            if i > 0
                json = json + ","
            end if
            json = json + SeerrFormatJsonValue(value[i])
        end for
        return json + "]"
    else if type(value) = "roAssociativeArray"
        return SeerrFormatJson(value)
    end if

    return SeerrEscapeJsonString(value.ToStr())
end function

' Format a float value to a specific number of decimal places (Seerr-specific)
' @param value - Float or dynamic value to format
' @param decimals - Number of decimal places
' @returns Formatted string representation
function SeerrFormatFloat(value as dynamic, decimals as integer) as string
    if value = invalid then return ""
    strVal = value.ToStr()
    dotPos = InStr(1, strVal, ".")
    if dotPos > 0 and decimals >= 0
        return Left(strVal, dotPos + decimals)
    end if
    return strVal
end function

' Create a content node for a Seerr genre item
' Genre items have id, name, and backdrops (array of TMDB backdrop paths)
function CreateGenreContentNode(genre as object, mediaType as string) as object
    if genre = invalid then return invalid
    if genre.id = invalid or genre.name = invalid then return invalid

    node = CreateObject("roSGNode", "ContentNode")

    node.title = genre.name

    ' Store genre ID and media type for navigation
    node.addField("genreId", "integer", false)
    node.genreId = genre.id

    node.addField("mediaType", "string", false)
    node.mediaType = mediaType

    node.addField("isGenre", "boolean", false)
    node.isGenre = true

    ' Use a random backdrop from the list if available
    backdrops = genre.backdrops
    if type(backdrops) = "roArray" and backdrops.count() > 0
        tmdbUrls = GetTmdbImageBaseUrls()

        ' Pick random backdrop for variety
        randomIdx = Rnd(backdrops.count()) - 1
        backdropPath = backdrops[randomIdx]

        if backdropPath <> invalid and backdropPath <> ""
            ' Use backdrop as poster for genre cards (landscape style)
            backdropUrl = tmdbUrls.backdropW780 + backdropPath
            node.hdPosterUrl = backdropUrl
            node.sdPosterUrl = backdropUrl
            node.HDGRIDPOSTERURL = backdropUrl
            node.SDGRIDPOSTERURL = backdropUrl
            node.addField("posterUrl", "string", false)
            node.posterUrl = backdropUrl
            node.url = backdropUrl

            ' Also set as background
            node.hdBackgroundImageUrl = tmdbUrls.backdropW1280 + backdropPath
            node.sdBackgroundImageUrl = tmdbUrls.backdropW780 + backdropPath
        end if
    end if

    return node
end function

function CreateMediaContentNode(item as object) as object
    if item = invalid or type(item) <> "roAssociativeArray" then return invalid

    node = CreateObject("roSGNode", "ContentNode")

    if item.title <> invalid
        node.title = item.title
    else if item.name <> invalid
        node.title = item.name
    else
        node.title = "Unknown"
    end if

    if item.overview <> invalid
        node.description = item.overview
        node.shortDescriptionLine1 = item.overview
    end if

    posterPath = invalid
    if item.posterPath <> invalid and item.posterPath <> ""
        posterPath = item.posterPath
    else if item.poster_path <> invalid and item.poster_path <> ""
        posterPath = item.poster_path
    end if

    if posterPath <> invalid and posterPath <> ""
        tmdbUrls = GetTmdbImageBaseUrls()
        ' Grids get the smaller size, since a w500 texture is larger than a 720p UI and a
        ' screen full of them stalls the render thread while they decode
        gridPosterUrl = tmdbUrls.posterW342 + posterPath
        node.hdPosterUrl = tmdbUrls.posterW500 + posterPath
        node.sdPosterUrl = gridPosterUrl
        node.addField("PosterUrl", "string", false)
        node.PosterUrl = gridPosterUrl
        node.url = gridPosterUrl
    end if

    backdropPath = invalid
    if item.backdropPath <> invalid and item.backdropPath <> ""
        backdropPath = item.backdropPath
    else if item.backdrop_path <> invalid and item.backdrop_path <> ""
        backdropPath = item.backdrop_path
    end if

    if backdropPath <> invalid and backdropPath <> ""
        tmdbUrls = GetTmdbImageBaseUrls()
        backdropUrl = tmdbUrls.backdropW1280 + backdropPath
        node.hdBackgroundImageUrl = backdropUrl
        node.sdBackgroundImageUrl = tmdbUrls.backdropW780 + backdropPath
    end if

    releaseYear = ""
    if item.releaseDate <> invalid and item.releaseDate <> ""
        releaseYear = Left(item.releaseDate, 4)
    else if item.release_date <> invalid and item.release_date <> ""
        releaseYear = Left(item.release_date, 4)
    else if item.firstAirDate <> invalid and item.firstAirDate <> ""
        releaseYear = Left(item.firstAirDate, 4)
    else if item.first_air_date <> invalid and item.first_air_date <> ""
        releaseYear = Left(item.first_air_date, 4)
    end if

    rating = ""
    voteAvg = invalid
    if item.voteAverage <> invalid
        voteAvg = item.voteAverage
    else if item.vote_average <> invalid
        voteAvg = item.vote_average
    end if

    if voteAvg <> invalid
        rating = SeerrFormatFloat(voteAvg, 1)
    end if

    adultFlag = false
    if item.adult <> invalid
        adultFlag = item.adult
    end if

    ' Status: 1=unknown, 2=pending, 3=processing, 4=partial, 5=available, 6=blacklisted
    mediaInfoStatus = 0
    if item.mediaInfo <> invalid and item.mediaInfo.status <> invalid
        mediaInfoStatus = item.mediaInfo.status
    end if

    ' Add custom fields including backdrop URL
    fieldsToAdd = {
        tmdbId: item.id,
        mediaType: item.mediaType,
        releaseDate: item.releaseDate,
        voteAverage: voteAvg,
        releaseYear: releaseYear,
        rating: rating,
        overview: item.overview,
        adult: adultFlag,
        mediaInfoStatus: mediaInfoStatus,
        originalData: item,
        ' Minimal .json structure for Jellyfin grid compatibility
        json: {
            Type: item.mediaType,
            UserData: {
                Played: false,
                UnplayedItemCount: 0
            }
        }
    }

    if backdropPath <> invalid and backdropPath <> ""
        tmdbUrls = GetTmdbImageBaseUrls()
        fieldsToAdd.backdropUrl = tmdbUrls.backdropW1280 + backdropPath
    end if

    node.addFields(fieldsToAdd)

    return node
end function

function GetRequestStatusText(status as integer) as string
    if status = 1
        return "Unknown"
    else if status = 2
        return "Pending"
    else if status = 3
        return "Processing"
    else if status = 4
        return "Partially Available"
    else if status = 5
        return "Available"
    end if
    return "Unknown"
end function

' ============================================
' Request and issue state
' ============================================

' Seerr media status
const SEERR_MEDIA_PENDING = 2
const SEERR_MEDIA_PROCESSING = 3
const SEERR_MEDIA_PARTIAL = 4
const SEERR_MEDIA_AVAILABLE = 5
const SEERR_MEDIA_BLOCKLISTED = 6
const SEERR_MEDIA_DELETED = 7

' Seerr request status
const SEERR_REQUEST_PENDING = 1
const SEERR_REQUEST_APPROVED = 2
const SEERR_REQUEST_DECLINED = 3
const SEERR_REQUEST_FAILED = 4
const SEERR_REQUEST_COMPLETED = 5

' Seerr issue status
const SEERR_ISSUE_OPEN = 1
const SEERR_ISSUE_RESOLVED = 2

function SeerrPosterUrl(media as object, size as string) as string
    if media = invalid then return ""
    if not isValidStringValue(media.posterPath) then return ""

    return "https://image.tmdb.org/t/p/" + size + media.posterPath
end function

function SeerrMediaTitle(media as object) as string
    if media <> invalid
        if isValidStringValue(media.title) then return media.title
        if isValidStringValue(media.name) then return media.name
    end if

    return tr("Unknown")
end function

function SeerrRequesterName(request as object) as string
    for each key in ["displayName", "username", "email"]
        name = chainLookupReturn(request, `requestedBy.${key}`, "")
        if isValidAndNotEmpty(name) then return name
    end for
    return tr("Unknown")
end function

' A picker sheet over a Seerr dialog: the choices with the current one checked and focused, then a
' dimmed Cancel. With no current choice the first one takes focus.
function CreateSeerrPicker(title as string, labels as object, selected as integer) as object
    rows = []
    for i = 0 to labels.count() - 1
        rows.push({ kind: "option", id: i.ToStr(), label: labels[i], selected: i = selected })
    end for
    picker = CreateObject("roSGNode", "SeerrSheet")
    picker.dialogTitle = title
    picker.bodyPadding = [0, 0, 0]
    picker.showCancel = true
    picker.elements = rows
    picker.focusId = selected.ToStr()
    picker.callFunc("render")
    return picker
end function

function CanManageIssues(permissions as integer) as boolean
    return HasSeerrPermission(permissions, SEERR_PERMISSION_MANAGE_ISSUES)
end function

' Filing an issue is its own bit, though a moderator can always file one
function CanCreateIssues(permissions as integer) as boolean
    if HasSeerrPermission(permissions, SEERR_PERMISSION_CREATE_ISSUES) then return true
    return HasSeerrPermission(permissions, SEERR_PERMISSION_MANAGE_ISSUES)
end function

function CanManageRequests(permissions as integer) as boolean
    return HasSeerrPermission(permissions, SEERR_PERMISSION_MANAGE_REQUESTS)
end function

function CanRequestMovies(permissions as integer) as boolean
    return HasSeerrPermission(permissions, SEERR_PERMISSION_REQUEST) or HasSeerrPermission(permissions, SEERR_PERMISSION_REQUEST_MOVIE)
end function

' What a request reads as, the way the other clients work it out. The media status wins over
' the request status except where the request was turned down, and a queue with something in
' it is the difference between processing and merely requested.
function SeerrRequestStatusInfo(request as object) as object
    if request = invalid then return { label: tr("Unknown"), color: "approved" }

    if request.status = SEERR_REQUEST_DECLINED then return { label: tr("Declined"), color: "error" }
    if request.status = SEERR_REQUEST_FAILED then return { label: tr("Failed"), color: "error" }

    media = request.media
    mediaStatus = invalid
    downloading = false
    if media <> invalid
        if request.is4k = true
            mediaStatus = media.status4k
            downloading = SeerrQueueHasWork(media.downloadStatus4k)
        else
            mediaStatus = media.status
            downloading = SeerrQueueHasWork(media.downloadStatus)
        end if
    end if

    if mediaStatus = SEERR_MEDIA_PENDING then return { label: tr("Pending"), color: "pending" }
    if mediaStatus = SEERR_MEDIA_PROCESSING
        if downloading then return { label: tr("Processing"), color: "requested" }
        return { label: tr("Requested"), color: "requested" }
    end if
    if mediaStatus = SEERR_MEDIA_PARTIAL
        if downloading then return { label: tr("Processing"), color: "requested" }
        return { label: tr("Partially Available"), color: "available" }
    end if
    if mediaStatus = SEERR_MEDIA_AVAILABLE then return { label: tr("Available"), color: "available" }
    if mediaStatus = SEERR_MEDIA_BLOCKLISTED then return { label: tr("Blocklisted"), color: "error" }
    if mediaStatus = SEERR_MEDIA_DELETED then return { label: tr("Deleted"), color: "error" }

    if request.status = SEERR_REQUEST_PENDING then return { label: tr("Pending"), color: "pending" }
    if request.status = SEERR_REQUEST_COMPLETED then return { label: tr("Available"), color: "available" }

    return { label: tr("Approved"), color: "approved" }
end function

function SeerrQueueHasWork(queue as object) as boolean
    if queue = invalid then return false
    if type(queue) <> "roArray" then return false
    return queue.Count() > 0
end function

function SeerrIssueStatusInfo(issue as object) as object
    if issue <> invalid and issue.status = SEERR_ISSUE_RESOLVED
        return { label: tr("Resolved"), color: "available" }
    end if

    return { label: tr("Open"), color: "pending" }
end function

function SeerrIssueTypeLabel(issueType as integer) as string
    if issueType = 1 then return tr("Video")
    if issueType = 2 then return tr("Audio")
    if issueType = 3 then return tr("Subtitles")
    return tr("Other")
end function

' How far along a download is, by bytes across the queue, and what it's doing. Nothing to show
' unless the title is being worked on, so a finished or turned down request returns invalid.
' arrQueue is what Moonbase read from Radarr or Sonarr for the title, when it could. It only covers
' the default HD arr, so a 4K request leaves it out.
function SeerrRequestDownloadSummary(request as object, arrQueue = invalid as dynamic) as object
    if request = invalid then return invalid
    if request.status = SEERR_REQUEST_DECLINED or request.status = SEERR_REQUEST_FAILED then return invalid

    media = request.media
    if media = invalid then return invalid

    if request.is4k = true
        mediaStatus = media.status4k
        queue = media.downloadStatus4k
    else
        mediaStatus = media.status
        queue = media.downloadStatus
    end if

    if mediaStatus <> SEERR_MEDIA_PROCESSING and mediaStatus <> SEERR_MEDIA_PARTIAL then return invalid
    ' The arr's own queue has its reasons, and it's there whether or not Seerr scans the arr. A title
    ' Moonbase didn't find in the default arr went to another one, so Seerr's copy stays.
    fromArr = request.is4k <> true and SeerrArrQueueHasTitle(arrQueue)
    if fromArr then queue = arrQueue.items
    if not SeerrQueueHasWork(queue) then return invalid

    ' Sonarr lists a season pack once per episode, each with the whole pack's size and the same
    ' download id, so each download counts once. An entry with no download id is a release Sonarr
    ' or Radarr is holding back rather than downloading.
    total = 0#
    left = 0#
    state = ""
    decider = invalid
    reason = invalid
    slowest = invalid
    timeLeftKnown = true
    seen = {}
    for each entry in queue
        key = SeerrDownloadKey(entry)
        if fromArr then key = SeerrArrEntryKey(entry, key)
        if key <> "" and not seen.DoesExist(key)
            seen[key] = true
            ' A magnet with no peers never learns its size, so it counts for its state but adds no
            ' bytes. No sizeLeft says nothing about how far along it is, so it counts as not started.
            size = 0#
            if SeerrIsNumber(entry.size) and entry.size > 0 then size = entry.size * 1#
            itemLeft = size
            if SeerrIsNumber(entry.sizeLeft) then itemLeft = entry.sizeLeft * 1#
            if itemLeft < 0 then itemLeft = 0#
            if itemLeft > size then itemLeft = size
            total += size
            left += itemLeft

            itemState = SeerrDownloadEntryState(entry, size > 0 and SeerrIsNumber(entry.sizeLeft) and itemLeft <= 0)
            ' The arr's words, unless the download is simply moving along. A paused one gets them too,
            ' since they still say why the bar isn't moving.
            itemReason = invalid
            if fromArr and (itemState <> "downloading" or not SeerrArrHealthy(entry)) then itemReason = SeerrArrReason(entry)
            ' Of two downloads in the same state, the one that says why speaks for the request
            if state = "" or SeerrDownloadStateRank(itemState) > SeerrDownloadStateRank(state) or (itemState = state and reason = invalid and itemReason <> invalid)
                state = itemState
                decider = entry
                reason = itemReason
            end if
            if itemState <> "waitingForImport" and itemState <> "importBlocked"
                ' A paused or queued sibling has no end in sight, so the request has none either
                eta = invalid
                if itemState = "downloading" then eta = SeerrParseTimeLeft(entry.timeLeft)
                if eta = invalid
                    timeLeftKnown = false
                else if slowest = invalid or eta > slowest
                    slowest = eta
                end if
            end if
        end if
    end for

    if state = "" then return invalid

    fraction = 0#
    if total > 0 then fraction = (total - left) / total
    if state = "waitingForImport" or state = "importBlocked"
        ' The client can call a download completed before its byte count settles
        fraction = 1#
    else if fraction > 0.99
        ' A sizeless download adds no bytes, so the sized ones alone can reach 100% while it's going
        fraction = 0.99
    end if
    if state <> "downloading" or not timeLeftKnown then slowest = invalid

    ' The arr's queue id and release name of a stuck download, so an admin can swap it for another
    stuck = SeerrDownloadIsStuck(state)
    stuckItemId = invalid
    stuckRelease = ""
    if stuck and fromArr and SeerrIsNumber(decider.id)
        stuckItemId = decider.id
        if isValidStringValue(decider.title) then stuckRelease = decider.title
    end if

    return { fraction: fraction, done: total - left, total: total, hasSize: total > 0, state: state, timeLeft: slowest, isWaitingForImport: state = "waitingForImport", isStuck: stuck, reason: reason, stuckItemId: stuckItemId, stuckRelease: stuckRelease }
end function

' What tells one of the arr's queue entries apart: its download, else its own queue id, since an
' entry with no download id can be stuck too. Empty for an entry the arr has stopped tracking, or
' a delay or fallback release it's holding back on purpose, which may never be the one grabbed.
function SeerrArrEntryKey(entry as dynamic, downloadKey as string) as string
    if type(entry) <> "roAssociativeArray" then return ""
    if SeerrLower(entry.trackedDownloadState) = "ignored" then return ""
    status = SeerrLower(entry.status)
    if status = "delay" or status = "fallback" then return ""
    if downloadKey <> "" then return downloadKey
    if SeerrIsNumber(entry.id) then return `queue:${SeerrIdText(entry.id)}`
    return ""
end function

' Moonbase answers 404 both for a download already gone from the queue, which is what a swap asked
' for, and for an arr it can't find, which is a failure. Only its words tell them apart.
function SeerrArrGoneFromQueue(response as dynamic) as boolean
    if chainLookupReturn(response, "statusCode", 0) <> 404 then return false
    return Instr(1, SeerrLower(chainLookupReturn(response, "error", "")), "no longer in the") > 0
end function

' Not going to finish by itself: stalled, refused at import, or failed
function SeerrDownloadIsStuck(state as string) as boolean
    return state = "stalled" or state = "importBlocked" or state = "failed"
end function

' Whether Moonbase found the title in the default arr, so its queue speaks for the HD track
function SeerrArrQueueHasTitle(queue as dynamic) as boolean
    if type(queue) <> "roAssociativeArray" then return false
    return SeerrArrFlagIs(queue.inArr, true)
end function

' A JSON true or false. A flag the arr left out or sent as null is neither.
function SeerrArrFlagIs(value as dynamic, wanted as boolean) as boolean
    valueType = type(value)
    if valueType <> "Boolean" and valueType <> "roBoolean" then return false
    return value = wanted
end function

' Only the items for a season request's seasons. A movie, or no seasons, keeps everything, and an
' item with no season number stays since it can't be ruled out.
function SeerrArrQueueForSeasons(queue as dynamic, seasons as dynamic) as dynamic
    if type(queue) <> "roAssociativeArray" then return queue
    if SeerrLower(queue.service) = "radarr" then return queue
    if type(seasons) <> "roArray" or seasons.Count() = 0 then return queue
    if type(queue.items) <> "roArray" then return queue

    wanted = {}
    for each season in seasons
        number = season
        if type(season) = "roAssociativeArray" then number = season.seasonNumber
        if SeerrIsNumber(number) then wanted[Int(number).toStr()] = true
    end for
    if wanted.Count() = 0 then return queue

    items = []
    for each item in queue.items
        number = invalid
        if type(item) = "roAssociativeArray" then number = item.seasonNumber
        if not SeerrIsNumber(number) or wanted.DoesExist(Int(number).toStr()) then items.Push(item)
    end for

    narrowed = {}
    narrowed.Append(queue)
    narrowed.items = items
    return narrowed
end function

' Radarr has the released movie, is watching for it and hasn't got it, yet nothing is downloading.
' Sonarr can't say whether a season has aired, so it never answers yes.
function SeerrArrNotFoundYet(queue as dynamic) as boolean
    if type(queue) <> "roAssociativeArray" then return false
    if SeerrLower(queue.service) <> "radarr" then return false
    if not SeerrArrFlagIs(queue.inArr, true) or not SeerrArrFlagIs(queue.monitored, true) then return false
    if not SeerrArrFlagIs(queue.hasFile, false) or not SeerrArrFlagIs(queue.isAvailable, true) then return false
    return type(queue.items) <> "roArray" or queue.items.Count() = 0
end function

' An approved HD request for a released movie the arr hasn't found a release for yet. Seerr calls
' that processing too, so without the arr's queue it looks the same as a download on its way.
function SeerrRequestNotFoundYet(request as dynamic, arrQueue as dynamic) as boolean
    if type(request) <> "roAssociativeArray" or request.is4k = true then return false
    if not SeerrIsNumber(request.status) or request.status <> SEERR_REQUEST_APPROVED then return false
    mediaStatus = chainLookupReturn(request, "media.status", 0)
    if not SeerrIsNumber(mediaStatus) or mediaStatus <> SEERR_MEDIA_PROCESSING then return false
    return SeerrArrNotFoundYet(arrQueue)
end function

' The arr's own words for what's wrong, or invalid. The error first, since the arr shows it in its own
' Activity view, then the first import message, then the title of a message group with no lines.
function SeerrArrReason(item as dynamic) as dynamic
    if type(item) <> "roAssociativeArray" then return invalid
    if isValidStringValue(item.errorMessage) and item.errorMessage.Trim() <> "" then return item.errorMessage.Trim()

    groups = item.statusMessages
    if type(groups) <> "roArray" then return invalid
    for each group in groups
        if type(group) = "roAssociativeArray" and type(group.messages) = "roArray"
            for each line in group.messages
                if isValidStringValue(line) and line.Trim() <> "" then return line.Trim()
            end for
        end if
    end for
    for each group in groups
        if type(group) = "roAssociativeArray" and isValidStringValue(group.title) and group.title.Trim() <> "" then return group.title.Trim()
    end for
    return invalid
end function

' The arr flags a download it has doubts about with a warning or an error
function SeerrArrHealthy(item as object) as boolean
    status = SeerrLower(item.trackedDownloadStatus)
    return status = "" or status = "ok"
end function

' The arr's name as people know it, for messages
function SeerrArrServiceName(queue as dynamic) as string
    if SeerrLower(chainLookupReturn(queue, "service", "")) = "radarr" then return "Radarr"
    return "Sonarr"
end function

' Where Moonbase reads a title's queue: Radarr by TMDB id for a movie, Sonarr by TVDB id for a
' series. Empty when the series has no TVDB id to ask by.
function SeerrArrQueuePath(mediaType as string, tmdbId as dynamic, tvdbId as dynamic) as string
    if isStringEqual(mediaType, "movie")
        if not SeerrIsNumber(tmdbId) and not isValidStringValue(tmdbId) then return ""
        return `/Moonfin/Seerr/Radarr/Queue?tmdbId=${SeerrIdText(tmdbId)}`
    end if
    if not SeerrIsNumber(tvdbId) and not isValidStringValue(tvdbId) then return ""
    return `/Moonfin/Seerr/Sonarr/Queue?tvdbId=${SeerrIdText(tvdbId)}`
end function

' Where to read a Seerr title's queue from, while its HD track is on its way: processing, or
' partly there with more coming. Empty for anything else.
function SeerrArrQueuePathForDetails(details as dynamic, mediaType as string) as string
    status = chainLookupReturn(details, "mediaInfo.status", 0)
    if not SeerrIsNumber(status) or (status <> SEERR_MEDIA_PROCESSING and status <> SEERR_MEDIA_PARTIAL) then return ""
    if isStringEqual(mediaType, "movie") then return SeerrArrQueuePath("movie", chainLookupReturn(details, "id", invalid), invalid)

    tvdbId = chainLookupReturn(details, "mediaInfo.tvdbId", invalid)
    if not isValid(tvdbId) then tvdbId = chainLookupReturn(details, "externalIds.tvdbId", invalid)
    return SeerrArrQueuePath("tv", invalid, tvdbId)
end function

' What the detail screen's download line shows: the HD track's download, else that it hasn't been
' found yet, else the 4K track's download. invalid when there's nothing on its way.
function SeerrDetailDownload(mediaInfo as dynamic, arrQueue as dynamic) as dynamic
    if type(mediaInfo) <> "roAssociativeArray" then return invalid

    summary = SeerrRequestDownloadSummary({ status: SEERR_REQUEST_APPROVED, is4k: false, media: mediaInfo }, arrQueue)
    if isValid(summary) then return { summary: summary, is4k: false, notFoundYet: false }

    if SeerrMediaNotFoundYet(mediaInfo, arrQueue) then return { summary: invalid, is4k: false, notFoundYet: true }

    summary = SeerrRequestDownloadSummary({ status: SEERR_REQUEST_APPROVED, is4k: true, media: mediaInfo })
    if isValid(summary) then return { summary: summary, is4k: true, notFoundYet: false }
    return invalid
end function

' A title page's Not found yet: processing on the HD track, with an approved HD request
function SeerrMediaNotFoundYet(mediaInfo as dynamic, arrQueue as dynamic) as boolean
    requests = chainLookupReturn(mediaInfo, "requests", invalid)
    if type(requests) <> "roArray" then return false
    for each request in requests
        if type(request) = "roAssociativeArray"
            if SeerrRequestNotFoundYet({ status: request.status, is4k: request.is4k, media: mediaInfo }, arrQueue) then return true
        end if
    end for
    return false
end function

' The HD track's stuck download an admin may swap for another release, or invalid. Moonbase decides
' who may, from the Jellyfin admin flag, and says so in canRemove.
function SeerrReplaceableDownload(mediaInfo as dynamic, arrQueue as dynamic) as dynamic
    if type(arrQueue) <> "roAssociativeArray" or not SeerrArrFlagIs(arrQueue.canRemove, true) then return invalid
    if type(mediaInfo) <> "roAssociativeArray" then return invalid

    summary = SeerrRequestDownloadSummary({ status: SEERR_REQUEST_APPROVED, is4k: false, media: mediaInfo }, arrQueue)
    if not isValid(summary) or not summary.isStuck or not isValid(summary.stuckItemId) then return invalid
    return summary
end function

' The removal that blocks a stuck release and has the arr search again
function SeerrArrRemovePath(queue as dynamic, queueId as dynamic) as string
    return `/Moonfin/Seerr/${SeerrArrServiceName(queue)}/Queue/${SeerrIdText(queueId)}`
end function

' An id as it goes in a path, without the leading space str() gives a number
function SeerrIdText(value as dynamic) as string
    if isValidStringValue(value) then return value.Trim()
    if SeerrIsNumber(value) then return value.toStr()
    return ""
end function

' A string in lower case, or empty for anything that isn't one
function SeerrLower(value as dynamic) as string
    if not isValidStringValue(value) then return ""
    return LCase(value)
end function

' What one queue entry is doing, from the status Radarr or Sonarr report. done is a download with
' every byte in, which waits on the import whatever the client calls it.
function SeerrDownloadEntryState(entry as object, done as boolean) as string
    ' The arr's own verdict, which only its queue carries, outranks the client's status: a client
    ' calls a blocked import completed
    tracked = SeerrLower(entry.trackedDownloadState)
    if tracked = "importblocked" then return "importBlocked"
    if tracked = "importpending" or tracked = "importing"
        ' Radarr and Sonarr hold a release with an executable here, with a warning, until someone
        ' steps in, so it is as stuck as a blocked one
        if not SeerrArrHealthy(entry) then return "importBlocked"
        return "waitingForImport"
    end if
    if tracked = "imported" then return "waitingForImport"
    if tracked = "failedpending" or tracked = "failed" then return "failed"

    status = ""
    if isValidStringValue(entry.status) then status = LCase(entry.status)
    if status = "failed" then return "failed"
    if done or status = "completed" then return "waitingForImport"
    ' A torrent with no seeders shows as a warning, and an unreachable client isn't moving either
    if status = "warning" or status = "downloadclientunavailable" then return "stalled"
    if status = "paused" then return "paused"
    if status = "queued" then return "queued"
    return "downloading"
end function

' Where several downloads make up a request, the one ranked highest speaks for it. One download on
' the move outranks a paused or queued one, and a stuck, blocked or failed one outranks everything.
function SeerrDownloadStateRank(state as string) as integer
    ranks = ["waitingForImport", "paused", "queued", "downloading", "stalled", "importBlocked", "failed"]
    for i = 0 to ranks.Count() - 1
        if ranks[i] = state then return i
    end for
    return 3
end function

' Seconds left from a .NET TimeSpan as Radarr and Sonarr send it: "hh:mm:ss", with a "d." day prefix
' past a day and an optional fraction of a second. invalid when there's no estimate.
function SeerrParseTimeLeft(value as dynamic) as dynamic
    if not isValidStringValue(value) then return invalid
    match = CreateObject("roRegex", "^(?:(\d+)\.)?(\d+):(\d{2}):(\d{2})(?:\.\d+)?$", "").Match(value.Trim())
    if match.Count() < 5 then return invalid
    days = 0
    if isValidStringValue(match[1]) then days = match[1].ToInt()
    ' TimeSpan's maximum means no estimate, and a count that size would overflow the seconds
    if days > 9999 then return invalid
    return days * 86400 + match[2].ToInt() * 3600 + match[3].ToInt() * 60 + match[4].ToInt()
end function

' "12m left", "2h left" or "1h 5m left", rounded up so the last minute doesn't read 0m. A download
' days out reads in hours.
function SeerrTimeLeftText(seconds as integer) as string
    minutes = Int((seconds + 59) / 60)
    if minutes < 60 then return tr("%1m left").Replace("%1", minutes.toStr())
    hours = Int(minutes / 60)
    minutes = minutes mod 60
    if minutes = 0 then return tr("%1h left").Replace("%1", hours.toStr())
    return tr("%1h %2m left").Replace("%1", hours.toStr()).Replace("%2", minutes.toStr())
end function

' The download bar's label. A wide bar says the sizes beside a stuck download's word, and the time
' left after an active one's percentage, which a narrow one hasn't room for.
function SeerrDownloadLabel(summary as object, wide as boolean, separator as string) as string
    parts = SeerrDownloadLabelParts(summary, wide, separator)
    if parts.trail = "" then return parts.lead
    return `${parts.lead} ${separator} ${parts.trail}`
end function

' The label in two halves: what's happening, and how far along. A tile sets the second apart, so the
' first is what gets cut short and the percentage always shows.
function SeerrDownloadLabelParts(summary as object, wide as boolean, separator as string) as object
    if summary.isWaitingForImport
        if wide then return { lead: tr("Downloaded, waiting for import"), trail: "" }
        return { lead: tr("Downloaded"), trail: "" }
    end if
    ' Always fully downloaded, so the words alone, which a percentage would only cut short
    if summary.state = "importBlocked" then return { lead: tr("Import blocked"), trail: "" }

    trail = `${Int(summary.fraction * 100 + 0.5).toStr()}%`
    word = SeerrDownloadStateWord(summary.state)
    if word <> ""
        if wide and summary.hasSize then return { lead: `${word} ${separator} ${SeerrDownloadSizeText(summary)}`, trail: trail }
        return { lead: word, trail: trail }
    end if

    lead = tr("Downloading")
    if summary.hasSize then lead = SeerrDownloadSizeText(summary)
    if wide and summary.timeLeft <> invalid and summary.timeLeft > 0 then trail += ` ${separator} ${SeerrTimeLeftText(summary.timeLeft)}`
    return { lead: lead, trail: trail }
end function

' The word for a download that isn't simply moving, or nothing for one that is
function SeerrDownloadStateWord(state as string) as string
    if state = "stalled" then return tr("Stalled")
    if state = "failed" then return tr("Download failed")
    if state = "paused" then return tr("Paused")
    if state = "queued" then return tr("Queued")
    return ""
end function

' Amber for a stalled download and red for a failed one, so a stuck bar stands out from a slow one,
' and dimmed while it's paused or waiting its turn
function SeerrDownloadBarColor(state as string, normal as string) as string
    if state = "stalled" or state = "importBlocked" then return "#EAB308"
    if state = "failed" then return "#EF4444"
    if state = "paused" or state = "queued" then return "#FFFFFF61"
    return normal
end function

' The done half is read in the total's unit, so a part finished download says 1.6 GB / 4.4 GB
' rather than 330.9 MB / 4.4 GB
function SeerrDownloadSizeText(summary as object) as string
    if summary = invalid then return ""

    unit = SeerrByteUnit(summary.total)
    return SeerrScaleBytes(summary.done, unit) + " / " + SeerrScaleBytes(summary.total, unit)
end function

function SeerrByteUnit(bytes as double) as string
    if bytes >= 1073741824 then return "GB"
    if bytes >= 1048576 then return "MB"
    if bytes >= 1024 then return "KB"
    return "B"
end function

function SeerrScaleBytes(bytes as double, unit as string) as string
    if unit = "GB" then return Str(Int(bytes / 107374182.4) / 10).Trim() + " GB"
    if unit = "MB" then return Str(Int(bytes / 104857.6) / 10).Trim() + " MB"
    if unit = "KB" then return Str(Int(bytes / 102.4) / 10).Trim() + " KB"
    return Str(Int(bytes)).Trim() + " B"
end function

' Dates are cut out of the string, because roDateTime shifts the day for anyone west of UTC
function SeerrFormatDate(value as dynamic) as string
    if not isValidStringValue(value) then return ""
    if Len(value) < 10 then return ""

    year = Mid(value, 1, 4)
    month = Mid(value, 6, 2).toInt()
    day = Mid(value, 9, 2).toInt()
    if month < 1 or month > 12 then return ""

    months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

    return tr(months[month - 1]) + " " + day.toStr() + ", " + year
end function

' ============================================
' Validation
' ============================================

function isValidStringValue(value as dynamic) as boolean
    ' Helper to check if a value is a valid non-empty string (handles type mismatches)
    if value = invalid then return false
    if type(value) <> "String" and type(value) <> "roString" then return false
    return value <> ""
end function

' The download a queue entry belongs to, or nothing for one without a download id
function SeerrDownloadKey(entry as dynamic) as string
    if type(entry) <> "roAssociativeArray" then return ""
    downloadId = entry.downloadId
    if not isValid(downloadId) or (SeerrIsNumber(downloadId) and downloadId = 0) then return ""
    return toString(downloadId)
end function

function SeerrIsNumber(value as dynamic) as boolean
    kind = type(value)
    return kind = "Integer" or kind = "roInt" or kind = "roInteger" or kind = "LongInteger" or kind = "roLongInteger" or kind = "Float" or kind = "roFloat" or kind = "Double" or kind = "roDouble"
end function

function SeerrParseBool(value as dynamic, defaultValue = false as boolean) as boolean
    if value = invalid then return defaultValue

    valueType = type(value)
    if valueType = "Boolean" or valueType = "roBoolean"
        return value
    else if valueType = "Integer" or valueType = "LongInteger" or valueType = "Float" or valueType = "Double" or valueType = "roInt" or valueType = "roInteger" or valueType = "roFloat" or valueType = "roDouble"
        return value <> 0
    else if valueType = "String" or valueType = "roString"
        normalized = LCase(value.Trim())
        if normalized = "true" or normalized = "1" or normalized = "yes" or normalized = "on"
            return true
        else if normalized = "false" or normalized = "0" or normalized = "no" or normalized = "off"
            return false
        end if
    end if

    return defaultValue
end function

function IsValidSeerrConfig(config as object) as boolean
    if config = invalid
        return false
    end if

    ' Valid when the Jellyfin server hosting the Moonfin proxy is known.
    return isValidStringValue(config.serverUrl)
end function

function IsItemAvailable(item as object) as boolean
    ' Status 4=partial, 5=available
    if item = invalid then return false
    if item.mediaInfo <> invalid and item.mediaInfo.status <> invalid
        status = item.mediaInfo.status
        return status = 4 or status = 5
    end if

    if item.mediaInfoStatus <> invalid
        return item.mediaInfoStatus = 4 or item.mediaInfoStatus = 5
    end if

    return false
end function

function IsItemRequested(item as object) as boolean
    ' Status 2=pending, 3=processing - these indicate a request has been made
    if item = invalid then return false
    if item.mediaInfo <> invalid and item.mediaInfo.status <> invalid
        status = item.mediaInfo.status
        return status = 2 or status = 3
    end if

    if item.mediaInfoStatus <> invalid
        return item.mediaInfoStatus = 2 or item.mediaInfoStatus = 3
    end if

    return false
end function

function IsItemBlacklisted(item as object) as boolean
    ' Status 6=blacklisted
    if item = invalid then return false

    if item.mediaInfo <> invalid and item.mediaInfo.status <> invalid
        return item.mediaInfo.status = 6
    end if

    if item.mediaInfoStatus <> invalid
        return item.mediaInfoStatus = 6
    end if

    return false
end function

function IsItemNsfw(item as object) as boolean
    ' Check adult flag and keyword detection
    if item = invalid then return false

    if item.adult <> invalid and item.adult = true
        return true
    end if

    ' NSFW keyword detection
    nsfwKeywords = [
        "sex", "sexual", "porn", "erotic", "nude", "nudity", "xxx",
        "adult film", "prostitute", "stripper", "escort", "seduction",
        "affair", "threesome", "orgy", "kinky", "fetish", "bdsm", "dominatrix"
    ]

    searchText = ""

    if item.title <> invalid and item.title <> ""
        searchText = LCase(item.title)
    else if item.name <> invalid and item.name <> ""
        searchText = LCase(item.name)
    end if

    if item.overview <> invalid and item.overview <> ""
        searchText = searchText + " " + LCase(item.overview)
    end if

    if searchText = "" then return false

    ' Word boundary check for keyword matches
    for each keyword in nsfwKeywords
        if InStr(1, searchText, keyword) > 0
            keywordPos = InStr(1, searchText, keyword)
            keywordLen = Len(keyword)

            validStart = true
            if keywordPos > 1
                charBefore = Mid(searchText, keywordPos - 1, 1)
                if charBefore <> " " and charBefore <> "," and charBefore <> "." and charBefore <> "!" and charBefore <> "?" and charBefore <> ":" and charBefore <> ";"
                    validStart = false
                end if
            end if

            validEnd = true
            if keywordPos + keywordLen <= Len(searchText)
                charAfter = Mid(searchText, keywordPos + keywordLen, 1)
                if charAfter <> " " and charAfter <> "," and charAfter <> "." and charAfter <> "!" and charAfter <> "?" and charAfter <> ":" and charAfter <> ";"
                    validEnd = false
                end if
            end if

            if validStart and validEnd
                return true
            end if
        end if
    end for

    return false
end function


' ============================================
' Cookie Validation
' ============================================

' Clear authentication cookie for current user
' Used when session expires or authentication fails
sub ClearSeerrCookie()
    userId = GetCurrentJellyfinUserId()
    if userId = ""
        return
    end if

    ' Remove cookie from user-specific registry
    userRegistry = GetSeerrUserRegistry(userId)
    sec = CreateObject("roRegistrySection", userRegistry)
    sec.Delete("authCookie")
    sec.Flush()

    ' Clear validation flag so user can re-authenticate
    if m.global <> invalid
        m.global.seerrSessionValidated = false
    end if
end sub

' ============================================
' Search API
' ============================================

function SearchSeerr(query as string, timeoutMs = 1500 as integer) as object
    ' Search Seerr for movies and TV shows
    ' Returns array of search results in standardized format
    ' NOTE: Does NOT filter out items already in library (per user request)

    if query = invalid or query = "" then return []

    config = GetSeerrConfig()
    if not IsValidSeerrConfig(config) then return []

    ' Create API task for search
    searchTask = CreateObject("roSGNode", "SeerrAPITask")
    searchTask.request = {
        method: "GET",
        endpoint: "/api/v1/search",
        queryParams: {
            query: query,
            page: "1",
            language: "en"
        }
    }

    timeout = timeoutMs
    if timeout <= 0 then timeout = 1500
    if timeout > 5000 then timeout = 5000

    ' Reading a node field from here is a rendezvous with the render thread, so wait on an
    ' observer rather than polling and risking an abort while the render thread is busy
    port = CreateObject("roMessagePort")
    searchTask.observeField("response", port)
    searchTask.control = "RUN"

    response = invalid
    msg = wait(timeout, port)
    if type(msg) = "roSGNodeEvent"
        response = msg.getData()
    end if
    searchTask.unobserveField("response")

    if response = invalid
        searchTask.control = "stop"
        return []
    end if

    if not response.success then return []
    if response.data = invalid or type(response.data) <> "roAssociativeArray" then return []
    if type(response.data.results) <> "roArray" then return []

    return SeerrSearchCards(response.data.results)
end function

' Seerr search answers as cards that open the Seerr details screen
function SeerrSearchCards(items as object) as object
    results = []
    for each item in items
        contentNode = CreateMediaContentNode(item)
        if contentNode <> invalid
            contentNode.addFields({
                isSeerrResult: true,
                seerrItem: item
            })
            results.push(contentNode)
        end if
    end for

    return results
end function

' Opens a Seerr title on whichever detail screen the viewer has chosen. The screen asks Seerr
' for the rest itself, so a title already in the library can open as the library item instead.
' @param mediaItem - ContentNode with media information (title, tmdbId, mediaType, etc.)
sub ShowSeerrDetails(mediaItem as object)
    if mediaItem = invalid then return
    if mediaItem.tmdbId = invalid then return

    mediaType = "movie"
    if isValidStringValue(mediaItem.mediaType) then mediaType = mediaItem.mediaType

    detailsScreen = CreateObject("roSGNode", SeerrDetailScreenComponent())
    detailsScreen.seerrTarget = {
        tmdbId: mediaItem.tmdbId.toStr(),
        mediaType: mediaType
    }
    m.global.sceneManager.callFunc("pushScene", detailsScreen)
end sub

' Mirrors detailScreenComponent in ShowScenes, read without the lookup helpers so this stays
' usable from the task scopes this file is pulled into
function SeerrDetailScreenComponent() as string
    if m.global = invalid or m.global.session = invalid then return "ModernItemDetails"

    user = m.global.session.user
    if user = invalid or user.settings = invalid then return "ModernItemDetails"

    style = normalizeDetailScreenStyleToken(user.settings["ui.itemdetail.style"])
    ' Kids Mode always shows the stripped back screen, which drops the request buttons
    if SeerrParseBool(user.settings["global.kids.enabled"], false) then style = "minimalist"
    if style = "classic" then return "ItemDetails"
    if style = "spotlight" then return "SpotlightItemDetails"
    if style = "nouveau" then return "NouveauItemDetails"
    if style = "minimalist" then return "MinimalistItemDetails"
    if style = "stage" then return "StageItemDetails"
    if style = "premiere" then return "PremiereItemDetails"
    if style = "quickLook" then return "QuickLookItemDetails"
    if style = "frost" then return "FrostItemDetails"

    return "ModernItemDetails"
end function

' ============================================
' Error Formatting
' ============================================

' Convert technical error messages to user-friendly messages
' @param errorMessage - Raw error message from API or internal error
' @return User-friendly error message
function FormatSeerrError(errorMessage as string) as string
    if errorMessage = invalid or errorMessage = ""
        return "An unknown error occurred. Please try again."
    end if

    errorLower = LCase(errorMessage)

    ' Connection errors
    if InStr(errorLower, "timeout") > 0
        return "Connection timed out. Please check your network and server status."
    end if

    if InStr(errorLower, "connection") > 0 or InStr(errorLower, "connect") > 0
        return "Unable to connect to Seerr server. Please verify the server URL and network connection."
    end if

    if InStr(errorLower, "network") > 0 or InStr(errorLower, "dns") > 0
        return "Network error. Please check your internet connection."
    end if

    ' Authentication errors
    if InStr(errorLower, "unauthorized") > 0 or InStr(errorLower, "401") > 0
        return "Authentication failed. Please check your credentials and try logging in again."
    end if

    if InStr(errorLower, "forbidden") > 0 or InStr(errorLower, "403") > 0
        return "Access denied. You may not have permission for this action."
    end if

    if InStr(errorLower, "invalid credentials") > 0 or InStr(errorLower, "invalid password") > 0
        return "Invalid username or password. Please try again."
    end if

    if InStr(errorLower, "session") > 0 or InStr(errorLower, "cookie") > 0
        return "Your session has expired. Please log in again."
    end if

    ' Resource errors
    if InStr(errorLower, "not found") > 0 or InStr(errorLower, "404") > 0
        return "The requested item was not found. It may have been removed or is unavailable."
    end if

    ' Server errors
    if InStr(errorLower, "server error") > 0 or InStr(errorLower, "500") > 0 or InStr(errorLower, "502") > 0 or InStr(errorLower, "503") > 0
        return "Seerr server error. The server may be temporarily unavailable. Please try again later."
    end if

    ' Rate limiting
    if InStr(errorLower, "rate limit") > 0 or InStr(errorLower, "too many") > 0 or InStr(errorLower, "429") > 0
        return "Too many requests. Please wait a moment and try again."
    end if

    ' Configuration errors
    if InStr(errorLower, "not configured") > 0
        return "Seerr is not configured. Please set up your server connection in settings."
    end if

    if InStr(errorLower, "invalid url") > 0
        return "Invalid server URL. Please check the URL format (http:// or https://)."
    end if

    ' Parsing errors
    if InStr(errorLower, "parse") > 0 or InStr(errorLower, "json") > 0
        return "Unable to process server response. The server may be experiencing issues."
    end if

    ' Default: return original message if it's short and readable, otherwise generic message
    if Len(errorMessage) < 100 and InStr(errorMessage, "{") = 0 and InStr(errorMessage, "<") = 0
        return errorMessage
    end if

    return "An error occurred: " + errorMessage
end function


' The glyph each editor row leads with, by the id the row's setting stores
namespace settingsIcons

    function DetailButtonGlyph(id as string) as string
        glyphs = {
            seerrRequest: "add",
            seerrRequest4k: "add",
            shuffle: "shuffle_rounded",
            version: "video_file",
            parts: "video_file",
            audio: "audiotrack",
            subtitles: "subtitles",
            trailer: "movie_outlined",
            watched: "check_circle_outline",
            favorite: "favorite_border",
            personalRating: "star_outline",
            goToSeries: "tv",
            playlist: "playlist_add",
            collection: "library_add",
            deleteFiles: "delete_outline",
            artwork: "image",
            seerrWatchlist: "bookmark_border",
            seerrReportIssue: "report_problem_outlined",
            seerrManage: "rule",
            admin: "settings"
        }
        return glyphs[id] ?? "tune"
    end function

    function OsdButtonGlyph(id as string) as string
        glyphs = {
            speed: "speed_rounded",
            chapters: "bookmark_outline_rounded",
            episodes: "video_library_outlined",
            subtitles: "subtitles_outlined",
            audio: "audiotrack_outlined",
            info: "info_outline_rounded"
        }
        return glyphs[id] ?? "tune"
    end function

    function MetadataGlyph(id as string) as string
        glyphs = {
            year: "calendar_today_outlined",
            parentalRating: "verified_user_outlined",
            runtimeAndSeasons: "schedule_outlined",
            status: "timelapse_outlined",
            upcomingEpisodeDate: "event_available_outlined",
            genres: "category_outlined",
            seerrAvailability: "cloud_download_outlined"
        }
        return glyphs[id] ?? "tune"
    end function

    function SectionGlyph(id as string) as string
        glyphs = {
            logo: "branding_watermark_outlined",
            tagline: "format_quote",
            poster: "image_outlined",
            versionBadge: "video_file",
            upNext: "skip_next_outlined",
            cast: "people_outline",
            crew: "movie_creation_outlined",
            studios: "business_outlined",
            chapters: "bookmarks_outlined",
            extras: "video_library_outlined",
            collections: "collections_bookmark_outlined",
            moreLikeThis: "recommend_outlined",
            moreEpisodes: "view_list_outlined",
            mediaInfo: "info_outline",
            seerrGenresTags: "sell_outlined",
            seerrStats: "bar_chart",
            seerrRecommendations: "auto_awesome_outlined",
            seerrSimilar: "grid_view_outlined",
            seerrCollection: "collections_outlined",
            seerrPersonAppearances: "theaters_outlined",
            seerrPersonCrew: "engineering_outlined",
            biography: "article_outlined",
            birthplace: "place_outlined",
            guestAppearances: "person_add_alt_outlined",
            musicVideos: "music_video_outlined"
        }
        return glyphs[id] ?? "dashboard_customize_outlined"
    end function

    ' A library by what it holds
    function LibraryGlyph(collectionType as string) as string
        glyphs = {
            movies: "movie_rounded",
            tvshows: "tv_rounded",
            music: "music_note_rounded",
            books: "menu_book_rounded",
            audiobooks: "menu_book_rounded",
            livetv: "live_tv_rounded",
            homevideos: "photo_library_rounded",
            photos: "photo_library_rounded",
            boxsets: "collections_bookmark_rounded",
            playlists: "playlist_play_rounded",
            games: "sports_esports"
        }
        return glyphs[collectionType] ?? "video_library_rounded"
    end function

end namespace

import "pkg:/source/utils/misc.bs"

' The seasonal row asks the plugin for the holidays of one country. Which country is a synced
' setting, with Automatic reading the one the device reports, and the holidays the viewer
' unticked travel as a synced list of ids.
namespace seasonalRow

    const COUNTRY_SETTING = "seasonal.row.country"
    const HIDDEN_HOLIDAYS_SETTING = "seasonal.row.hiddenHolidays"
    ' The plugin reads this as "no country, and dont fall back to the server's"
    const OTHER_COUNTRY = "ZZ"

    ' In calendar order. The ids match the other clients, since the hidden list travels
    ' between them.
    function Holidays() as object
        return [
            { id: "newYear", title: "New Year's" },
            { id: "valentines", title: "Valentine's Day" },
            { id: "easter", title: "Easter" },
            { id: "pride", title: "Pride" },
            { id: "halloween", title: "Halloween" },
            { id: "thanksgiving", title: "Thanksgiving" },
            { id: "christmas", title: "Christmas Movies" },
            { id: "lunarNewYear", title: "Lunar New Year" },
            { id: "diwali", title: "Diwali" }
        ]
    end function

    ' The country the request carries, or "" to let the plugin fall back to the server's own.
    ' Anything that isnt two letters is left out, since a wrong code would pick the wrong
    ' holidays.
    function CountryParam(setting as dynamic, deviceCountry as dynamic) as string
        choice = ""
        if isValid(setting) then choice = LCase(setting.toStr().Trim())
        if choice = "" then choice = "auto"
        if choice = "other" then return seasonalRow.OTHER_COUNTRY

        if choice = "auto"
            code = seasonalRow.TwoLetters(deviceCountry)
            ' OT is what the device reports for a region Roku has no code for
            return code = "OT" ? "" : code
        end if

        return seasonalRow.TwoLetters(choice)
    end function

    function TwoLetters(code as dynamic) as string
        if not isValid(code) then return ""
        trimmed = code.toStr().Trim()
        if not CreateObject("roRegex", "^[A-Za-z]{2}$", "").IsMatch(trimmed) then return ""
        return UCase(trimmed)
    end function

    ' The stored hidden list is a JSON array of ids. Anything else reads as nothing hidden.
    function HiddenHolidays(stored as dynamic) as object
        if not isValid(stored) then return []
        parsed = stored
        if type(stored) = "String" or type(stored) = "roString" then parsed = ParseJson(stored)
        if type(parsed) <> "roArray" then return []

        ids = []
        for each id in parsed
            if type(id) = "String" or type(id) = "roString" then ids.push(id)
        end for
        return ids
    end function

end namespace

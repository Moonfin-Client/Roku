import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/serverCompatibility.bs"

' The library half of the details action row: rating, playlists, collections, deleting,
' artwork and identify. These run in the host screen's scope, so m is whichever detail
' screen imported them, the same way the Seerr half works.

' The score at which a rating counts as liked, the same line the other clients draw
const LIKED_RATING_THRESHOLD = 6.5

' Only an item from another server moves the request off the signed-in one
function withDetailActionServer(request as object) as object
    serverData = getServerInfoFromItem(m.top.itemContent)
    if not isValid(serverData) then return request
    if serverIdentityKey(serverData.serverUrl) = serverIdentityKey(chainLookupReturn(m.global.session, "server.url", "")) then return request

    request.serverData = serverData
    return request
end function

function detailActionCandidates(itemData as object) as object
    candidates = []
    if not isValid(itemData) then return candidates

    itemType = LCase(chainLookupReturn(itemData, "Type", ""))
    isTitle = itemType = "movie" or itemType = "series" or itemType = "season" or itemType = "episode" or itemType = "boxset"
    personPage = itemType = "person"
    isAdmin = chainLookupReturn(m.global.session, "user.Policy.IsAdministrator", false) = true

    ' Plex keeps no personal ratings
    if isTitle and not isPlexServer(toString(chainLookupReturn(itemData, "_serverUrl", "")))
        candidates.push({ id: "personalRating", config: ratingButtonConfig(itemData) })
    end if

    ' A person cant go in a playlist
    if not personPage
        candidates.push({ id: "playlist", config: { icon: "pkg:/images/icons/add_to_playlist.webp", label: tr("Add to Playlist"), action: "addToPlaylist", id: "playlistButton" } })
    end if

    if isTitle
        candidates.push({ id: "collection", config: { icon: "pkg:/images/icons/add_to_collection.webp", label: tr("Add to Collection"), action: "addToCollection", id: "collectionButton" } })
    end if

    if chainLookupReturn(itemData, "CanDelete", false) = true
        candidates.push({ id: "deleteFiles", config: { icon: "pkg:/images/icons/delete_item.webp", label: tr("Delete"), action: "deleteItem", id: "deleteButton" } })
    end if

    if isAdmin and isTitle
        candidates.push({ id: "artwork", config: { icon: "pkg:/images/icons/artwork.webp", label: tr("Change Artwork"), action: "changeArtwork", id: "artworkButton" } })
    end if
    if isAdmin and (isTitle or personPage)
        candidates.push({ id: "admin", config: { icon: "pkg:/images/icons/admin_controls.webp", label: tr("Admin Controls"), action: "adminControls", id: "adminButton" } })
    end if

    return candidates
end function

' Plex keeps no favorites for people
function offersFavorite(itemData as object) as boolean
    if LCase(chainLookupReturn(itemData, "Type", "")) <> "person" then return true
    return not isPlexServer(toString(chainLookupReturn(itemData, "_serverUrl", "")))
end function

' The task has to outlive this call or it is collected before it answers
function runDetailAction(request as object, callback as string) as object
    task = CreateObject("roSGNode", "JellyfinAPITask")
    task.request = withDetailActionServer(request)
    task.observeField("response", callback)
    m.detailActionTask = task
    task.control = "RUN"
    return task
end function

' ===== Rating =====

function personalRatingStyle() as string
    style = LCase(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.personalRatingStyle`", "thumbs"))
    if style = "stars" or style = "numeric" then return style
    return "thumbs"
end function

function effectivePersonalRatingIntervals(style as string, configured as integer) as integer
    if style = "stars"
        if configured = 6 then return 6
        if configured = 21 or configured = 41 then return 21
        return 11
    else if style = "numeric"
        if configured = 21 then return 21
        if configured = 41 then return 41
        return 11
    end if
    return 11
end function

function personalRatingIntervals(style = "" as string) as integer
    activeStyle = style <> "" ? style : personalRatingStyle()
    raw = chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.personalRatingIntervals`", "11")
    configured = Val(raw.toStr())
    return effectivePersonalRatingIntervals(activeStyle, Int(configured))
end function

function personalRatingServerStep(style as string, intervals as integer) as float
    effective = effectivePersonalRatingIntervals(style, intervals)
    return 10.0 / (effective - 1)
end function

function personalRatingMaxDecimals(style as string, intervals as integer) as integer
    effective = effectivePersonalRatingIntervals(style, intervals)
    if style = "stars"
        if effective = 6 then return 0
        if effective = 11 then return 1
        return 2
    else if style = "numeric"
        if effective = 11 then return 0
        if effective = 21 then return 1
        return 2
    end if
    return 0
end function

function snapPersonalRatingToGrid(rating as float, style as string, intervals as integer) as float
    stepSize = personalRatingServerStep(style, intervals)
    clamped = rating
    if clamped < 0.0 then clamped = 0.0
    if clamped > 10.0 then clamped = 10.0
    snapped = Int((clamped / stepSize) + 0.5) * stepSize
    if snapped < 0.0 then snapped = 0.0
    if snapped > 10.0 then snapped = 10.0
    return Int((snapped * 100.0) + 0.5) / 100.0
end function

function formatPersonalRatingNumber(value as float, maxDecimals as integer) as string
    if maxDecimals <= 0
        return Int(value + 0.5).toStr()
    end if
    factor = maxDecimals = 1 ? 10 : 100
    scaled = Int((value * factor) + 0.5)
    whole = Int(scaled / factor)
    frac = scaled mod factor
    if frac = 0 then return whole.toStr()
    if maxDecimals = 1
        return `${whole.toStr()}.${frac.toStr()}`
    end if
    if (frac mod 10) = 0
        return `${whole.toStr()}.${Int(frac / 10).toStr()}`
    end if
    fracStr = frac < 10 ? `0${frac.toStr()}` : frac.toStr()
    return `${whole.toStr()}.${fracStr}`
end function

function savedRating(itemData as object) as dynamic
    return chainLookupReturn(itemData, "UserData.Rating", invalid)
end function

' A thumb only stores the liked flag, so a bare score has to stand in for one
function savedLikes(itemData as object) as dynamic
    likes = chainLookupReturn(itemData, "UserData.Likes", invalid)
    if isValid(likes) then return likes

    rating = savedRating(itemData)
    if not isValid(rating) then return invalid
    return rating >= LIKED_RATING_THRESHOLD
end function

function ratingButtonConfig(itemData as object) as object
    style = personalRatingStyle()
    intervals = personalRatingIntervals(style)

    icon = "pkg:/images/icons/rating_star.webp"
    if style = "numeric" then icon = "pkg:/images/icons/rating_numbers.webp"

    label = tr("Rate")
    if style = "thumbs"
        likes = savedLikes(itemData)
        icon = likes = false ? "pkg:/images/icons/rating_thumb_down.webp" : "pkg:/images/icons/rating_thumb_up.webp"
        if isValid(likes) then label = likes ? tr("Like") : tr("Dislike")
    else
        rating = savedRating(itemData)
        if isValid(rating)
            label = style = "stars" ? starLabel(rating, intervals) : tr("Rated")
        end if
    end if

    return { icon: icon, label: label, action: "personalRating", id: "personalRatingButton" }
end function

' Full stars with a fraction glyph matching the configured star interval
function starLabel(rating as float, intervals = 11 as integer) as string
    effective = effectivePersonalRatingIntervals("stars", intervals)
    snappedStars = snapPersonalRatingToGrid(rating, "stars", effective) / 2.0
    subdivisions = effective = 6 ? 1 : (effective = 11 ? 2 : 4)
    snappedUnits = Int((snappedStars * subdivisions) + 0.5)
    if snappedUnits <= 0 then return "0 / 5"

    full = Int(snappedUnits / subdivisions)
    remainder = snappedUnits mod subdivisions

    label = ""
    for i = 1 to full
        label += "★"
    end for
    if subdivisions = 2 and remainder = 1
        label += "½"
    else if subdivisions = 4
        if remainder = 1
            label += "¼"
        else if remainder = 2
            label += "½"
        else if remainder = 3
            label += "¾"
        end if
    end if

    if label = "" then return "0 / 5"
    return label
end function

' The scores run from ten down to zero on the active interval grid
function markedRatingIndex(rating as dynamic, style = "numeric" as string, intervals = 11 as integer) as integer
    if not isValid(rating) then return -1
    stepSize = personalRatingServerStep(style, intervals)
    snapped = snapPersonalRatingToGrid(rating * 1.0, style, intervals)
    return Int(((10.0 - snapped) / stepSize) + 0.5)
end function

sub showRatingPrompt()
    itemData = m.top.itemContent.json
    style = personalRatingStyle()
    intervals = personalRatingIntervals(style)

    options = []
    m.ratingChoices = []
    marked = -1

    if style = "thumbs"
        likes = savedLikes(itemData)
        options.push(tr("Like"))
        m.ratingChoices.push({ kind: "likes", value: true })
        options.push(tr("Dislike"))
        m.ratingChoices.push({ kind: "likes", value: false })
        if isValid(likes) then marked = likes ? 0 : 1
    else
        effective = effectivePersonalRatingIntervals(style, intervals)
        stepSize = personalRatingServerStep(style, effective)
        maxDecimals = personalRatingMaxDecimals(style, effective)
        for i = 0 to effective - 1
            score = Int(((10.0 - (i * stepSize)) * 100.0) + 0.5) / 100.0
            if score < 0.0 then score = 0.0
            if style = "stars"
                choiceLabel = score <= 0.0 ? "0 / 5" : starLabel(score, effective)
            else
                choiceLabel = formatPersonalRatingNumber(score, maxDecimals)
            end if
            options.push(choiceLabel)
            m.ratingChoices.push({ kind: "rating", value: score })
        end for
        marked = markedRatingIndex(savedRating(itemData), style, effective)
    end if

    if isValid(savedLikes(itemData)) or isValid(savedRating(itemData))
        options.push(tr("Clear Rating"))
        m.ratingChoices.push({ kind: "clear" })
    end if

    showActionPrompt(tr("Rate"), options, "onRatingChosen", { selected: marked })
end sub

sub onRatingChosen(event as object)
    index = event.getData()
    closeActionPrompt()
    if index < 0 or index >= m.ratingChoices.count() then return

    choice = m.ratingChoices[index]
    itemId = chainLookupReturn(m.top.itemContent, "json.id", "")
    if not isValidAndNotEmpty(itemId) then return

    if choice.kind = "likes"
        request = { method: "POST", path: Substitute("UserItems/{0}/Rating", itemId), params: { Likes: choice.value } }
    else if choice.kind = "rating"
        request = { method: "POST", path: Substitute("UserItems/{0}/UserData", itemId), bodyJson: FormatJson({ Rating: choice.value }) }
    else
        request = { method: "DELETE", path: Substitute("UserItems/{0}/Rating", itemId) }
    end if

    task = CreateObject("roSGNode", "JellyfinAPITask")
    task.addField("choice", "assocarray", false)
    task.choice = choice
    task.request = withDetailActionServer(request)
    task.observeField("response", "onRatingSaved")
    m.detailActionTask = task
    task.control = "RUN"
end sub

' The button changes face straight away, the way watched and favorite already do
sub onRatingSaved(event as object)
    choice = event.getRoSGNode().choice

    itemData = m.top.itemContent.json
    userData = itemData.UserData
    if not isValid(userData) then userData = {}

    if choice.kind = "likes"
        userData.Likes = choice.value
        userData.Delete("Rating")
    else if choice.kind = "rating"
        userData.Rating = choice.value
        userData.Likes = choice.value >= LIKED_RATING_THRESHOLD
    else
        userData.Delete("Rating")
        userData.Delete("Likes")
    end if
    itemData.UserData = userData
    m.top.itemContent.json = itemData

    button = m.top.findNode("personalRatingButton")
    if isValid(button)
        config = ratingButtonConfig(itemData)
        if button.hasField("labelText")
            button.labelText = config.label
            button.iconUri = config.icon
        else
            ' The classic button is a plain group, so its face is changed piece by piece
            label = m.top.findNode("personalRatingButtonText")
            if isValid(label) then label.text = config.label
            icon = m.top.findNode("personalRatingButtonIcon")
            if isValid(icon) then icon.uri = config.icon
        end if
    end if
end sub

' ===== Deleting =====

sub confirmDelete()
    title = chainLookupReturn(m.top.itemContent, "json.name", "")
    showActionPrompt(Substitute(tr(`Delete "^0"?`), title), [tr("Cancel"), tr("Delete")], "onDeleteChosen")
end sub

sub onDeleteChosen(event as object)
    index = event.getData()
    closeActionPrompt()
    if index <> 1 then return

    itemId = chainLookupReturn(m.top.itemContent, "json.id", "")
    startLoadingSpinner()

    runDetailAction({ method: "DELETE", path: Substitute("Items/{0}", itemId) }, "onItemDeleted")
end sub

' The item is gone, so the screen showing it goes too
sub onItemDeleted(_event as object)
    stopLoadingSpinner()
    m.global.sceneManager.callFunc("popScene")
end sub

' ===== The shared prompt =====

' extras carries the optional trimmings: message, details and selected
sub showActionPrompt(title as string, options as object, callback as string, extras = {} as object)
    m.actionPrompt = CreateObject("roSGNode", "ListPromptDialog")
    m.actionPrompt.dialogTitle = title
    m.actionPrompt.message = extras.message ?? ""
    m.actionPrompt.options = options
    m.actionPrompt.optionDetails = extras.details ?? []
    m.actionPrompt.selectedOption = extras.selected ?? - 1
    m.actionPrompt.returnFocus = seerrFocusTarget()
    m.actionPrompt.observeField("optionSelected", callback)

    m.top.getScene().appendChild(m.actionPrompt)
    m.actionPrompt.callFunc("showDialog")
end sub

sub closeActionPrompt()
    if not isValid(m.actionPrompt) then return

    m.actionPrompt.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.actionPrompt)
    m.actionPrompt = invalid
end sub

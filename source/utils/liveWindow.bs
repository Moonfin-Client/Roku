import "pkg:/source/utils/misc.bs"

' A live HLS stream keeps every segment since it started, so the player reports the end of its
' playlist as the duration and the position on the same clock from 0. A live TS stream keeps nothing
' to seek through and reports no duration at all.

' Roku keeps a live stream this far from the end of its playlist, so the live point sits here and a
' Jump to Live seek lands just short of it
const LIVE_HOLDBACK_SECONDS = 30
' A live stream only rewinds once it keeps at least this much behind the live point
const LIVE_MIN_WINDOW_SECONDS = 60
' This close to the live point still reads as live
const LIVE_AT_LIVE_SECONDS = 10

namespace liveWindow

    ' The stretch of a live stream that can be rewound, in seconds on the player's clock, or invalid
    ' while it's under a minute
    function WindowFor(duration as float) as dynamic
        if duration <= 0 then return invalid
        edge = duration - LIVE_HOLDBACK_SECONDS
        if edge < LIVE_MIN_WINDOW_SECONDS then return invalid
        return { start: 0, edge: edge }
    end function

    function Behind(window as object, position as float) as float
        seconds = window.edge - position
        if seconds < 0 then return 0.0
        return seconds
    end function

    ' How far along the window a moment is, from 0 at its start to 1 at the live point
    function Progress(window as object, position as float) as float
        fraction = (position - window.start) / (window.edge - window.start)
        if fraction < 0 then return 0.0
        if fraction > 1 then return 1.0
        return fraction
    end function

end namespace

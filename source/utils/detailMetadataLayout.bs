import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/misc.bs"

const DETAIL_METADATA_ORDER_SETTING = "ui.itemdetail.metadataOrder"
const DETAIL_METADATA_HIDDEN_SETTING = "ui.itemdetail.hiddenMetadata"

namespace detailMetadataLayout

    ' The default catalogue of metadata elements shown on the details screen.
    ' Each item has an id matching Moonfin-Core, Moonbase, and Smart-TV,
    ' and a display label.
    function DetailMetadata() as object
        return [
            { id: "year", label: "Release Year" },
            { id: "parentalRating", label: "Parental Rating" },
            { id: "runtimeAndSeasons", label: "Runtime & Seasons" },
            { id: "status", label: "Series Status", subtitle: "Shows whether the series is continuing, ended, or returning" },
            { id: "upcomingEpisodeDate", label: "Upcoming Episodes", subtitle: "Uses Sonarr and TMDB to show upcoming release dates" },
            { id: "genres", label: "Genres" },
            { id: "seerrAvailability", label: "Seerr Availability", subtitle: "Shows request and media availability status from Seerr" }
        ]
    end function

    function Ordered(all as object, stored as dynamic) as object
        return buttonLayout.Ordered(all, stored)
    end function

    function HiddenLookup(stored as dynamic) as object
        return buttonLayout.HiddenLookup(stored)
    end function

    function Arrange(all as object, order as dynamic, hidden as dynamic) as object
        return buttonLayout.Arrange(all, order, hidden)
    end function

    function WithUnknownIds(catalogue as object, savedOrder as object, savedHidden as object, storedOrder as dynamic, storedHidden as dynamic) as object
        return buttonLayout.WithUnknownIds(catalogue, savedOrder, savedHidden, storedOrder, storedHidden)
    end function

end namespace

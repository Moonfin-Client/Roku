import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"

' The chrome the library sort and settings dialogs share, which is the panel the track
' pickers use. Rows run the full width of the panel and draw their own focus chip.

namespace libraryPanel

    ' A heading is shorter than an option row on the web, but one stride keeps a whole
    ' dialog on a single MarkupList
    const ROW_HEIGHT = 54
    ' A settings row carries a value under its label, so it takes more
    const SETTING_ROW_HEIGHT = 76
    const HEADER_PAD_X = 32
    const CHIP_INSET = 18

    const CONTROL_SIZE = 22
    const CONTROL_GAP = 14
    const RADIO_DOT_SIZE = 12
    const CHECK_MARK_SIZE = 16
    const CHEVRON_SIZE = 18
    const CHEVRON_GAP = 10

    const LABEL_SIZE = 18
    const HEADER_SIZE = 15
    const EYEBROW_SIZE = 14
    const EYEBROW_LINE = 22
    const SETTING_LABEL_SIZE = 19
    const SETTING_VALUE_SIZE = 16
    const SETTING_LABEL_LINE = 24
    const SETTING_GAP = 4
    const MUTED_INK = "#FFFFFF73"
    const LABEL_INK = "#FFFFFFCC"
    const FOCUS_OPACITY = 0.1

    ' The tallest the house panel goes, for a list whose length keeps changing and would
    ' otherwise resize the panel under the viewer
    function FullHeightRows() as integer
        return trackDialog.VisibleRows(999, libraryPanel.ROW_HEIGHT)
    end function

    ' The other clients name the kind of thing the panel is about above its title, so
    ' the title block grows by a line and everything under it comes down with it
    sub AddEyebrow(parts as object, eyebrow as object)
        block = libraryPanel.EYEBROW_LINE

        eyebrow.font.size = libraryPanel.EYEBROW_SIZE
        eyebrow.width = parts.title.width
        eyebrow.height = block
        eyebrow.translation = [trackDialog.ROW_PAD_X, trackDialog.PANEL_PAD_Y]

        for each part in [parts.title, parts.titleRule, parts.list]
            part.translation = [part.translation[0], part.translation[1] + block]
        end for

        for each layer in [parts.panelBg, parts.panelBorder]
            layer.height += block
        end for

        parts.panel.translation = [parts.panel.translation[0], (1080 - parts.panelBg.height) / 2]
    end sub

end namespace

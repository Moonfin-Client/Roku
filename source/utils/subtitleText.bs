' A sidecar SRT, WebVTT or ASS file as the timed lines the caption task draws, for servers that hand
' out the file as it is. Times are in milliseconds.

namespace subtitleText

    function Parse(text as string) as object
        if CreateObject("roRegex", "^\s*\[Script Info\]", "m").IsMatch(text) then return subtitleText.Ass(text)

        timing = CreateObject("roRegex", "((?:\d+:)?)(\d{1,2}):(\d{2})[,.](\d{1,3})\s*-->\s*((?:\d+:)?)(\d{1,2}):(\d{2})[,.](\d{1,3})", "")
        tags = CreateObject("roRegex", "<[^>]+>|\{\\[^}]*\}", "")
        text = text.Replace(Chr(13) + Chr(10), Chr(10)).Replace(Chr(13), Chr(10))
        if text.Left(1) = Chr(65279) then text = text.Mid(1)

        cues = []
        for each block in CreateObject("roRegex", "\n{2,}", "").Split(text)
            lines = block.Split(Chr(10))
            for at = 0 to lines.Count() - 1
                found = timing.Match(lines[at])
                if found.Count() > 0
                    body = []
                    for i = at + 1 to lines.Count() - 1
                        body.push(lines[i])
                    end for
                    subtitleText.Add(cues, subtitleText.Ms(found[1], found[2], found[3], found[4]), subtitleText.Ms(found[5], found[6], found[7], found[8]), tags.ReplaceAll(body.Join(Chr(10)), ""))
                    exit for
                end if
            end for
        end for
        return cues
    end function

    ' ASS keeps its lines as Dialogue entries, with the text last so it can hold commas of its own
    function Ass(text as string) as object
        time = CreateObject("roRegex", "^(\d+):(\d{2}):(\d{2})\.(\d{1,3})$", "")
        overrides = CreateObject("roRegex", "\{[^}]*\}", "")
        breaks = CreateObject("roRegex", "\\[Nn]", "")
        cues = []
        for each line in CreateObject("roRegex", "\r?\n", "").Split(text)
            if line.Left(9) = "Dialogue:"
                fields = line.Mid(9).Split(",")
                if fields.Count() > 9
                    start = time.Match(fields[1].Trim())
                    finish = time.Match(fields[2].Trim())
                    rest = []
                    for i = 9 to fields.Count() - 1
                        rest.push(fields[i])
                    end for
                    if start.Count() > 0 and finish.Count() > 0
                        subtitleText.Add(cues, subtitleText.Ms(start[1], start[2], start[3], start[4]), subtitleText.Ms(finish[1], finish[2], finish[3], finish[4]), breaks.ReplaceAll(overrides.ReplaceAll(rest.Join(","), ""), Chr(10)))
                    end if
                end if
            end if
        end for
        return cues
    end function

    sub Add(cues as object, start as integer, finish as integer, body as string)
        body = body.Trim()
        if body = "" then return
        cues.push({ "start": start, "end": finish, "text": body.Split(Chr(10)), "styles": {}, "id": "caption" + cues.Count().toStr() })
    end sub

    function Ms(hours as string, minutes as string, secs as string, fraction as string) as integer
        if hours.Right(1) = ":" then hours = hours.Left(hours.Len() - 1)
        if hours = "" then hours = "0"
        return (Val(hours, 10) * 3600 + Val(minutes, 10) * 60 + Val(secs, 10)) * 1000 + Val((fraction + "00").Left(3), 10)
    end function

end namespace

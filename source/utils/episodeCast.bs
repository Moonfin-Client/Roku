import "pkg:/source/utils/misc.bs"

namespace episodeCast

    ' Formats an actor's role on an episode as a guest star.
    ' If the role is empty or already "Guest Star", returns "Guest Star".
    ' If the role already contains "Guest Star", returns it unchanged (idempotent).
    ' Otherwise appends "(Guest Star)".
    function formatGuestStarRole(role as dynamic) as string
        if not isValid(role) then return tr("Guest Star")
        roleStr = role.ToStr().Trim()
        if roleStr = "" then return tr("Guest Star")

        guestStarRegex = CreateObject("roRegex", "\b(guest\s*star)\b", "i")
        if guestStarRegex.IsMatch(roleStr)
            return roleStr
        end if

        return Substitute(tr("{0} (Guest Star)"), roleStr)
    end function

    ' Formats an episode director role.
    ' Returns "Episode Director" if empty, "Director", or already tagged.
    ' If a specific role like "Co-Director" is passed, appends "(Episode Director)".
    function formatEpisodeDirectorRole(role = "" as dynamic) as string
        if not isValid(role) then return tr("Episode Director")
        roleStr = role.ToStr().Trim()
        if roleStr = "" or LCase(roleStr) = "director" then return tr("Episode Director")

        regex = CreateObject("roRegex", "\b(episode\s*director)\b", "i")
        if regex.IsMatch(roleStr)
            return roleStr
        end if

        return Substitute(tr("{0} (Episode Director)"), roleStr)
    end function

    ' Formats an episode writer role.
    ' Returns "Episode Writer" if empty, "Writer", or already tagged.
    ' If a specific role like "Story" is passed, appends "(Episode Writer)".
    function formatEpisodeWriterRole(role = "" as dynamic) as string
        if not isValid(role) then return tr("Episode Writer")
        roleStr = role.ToStr().Trim()
        if roleStr = "" or LCase(roleStr) = "writer" then return tr("Episode Writer")

        regex = CreateObject("roRegex", "\b(episode\s*writer)\b", "i")
        if regex.IsMatch(roleStr)
            return roleStr
        end if

        return Substitute(tr("{0} (Episode Writer)"), roleStr)
    end function

    ' Checks if a role string already contains a guest star designation.
    function hasGuestStarTag(role as dynamic) as boolean
        if not isValid(role) then return false
        return CreateObject("roRegex", "\b(guest\s*star)\b", "i").IsMatch(role.ToStr())
    end function

    ' Checks if a role string already contains an episode director designation.
    function hasEpisodeDirectorTag(role as dynamic) as boolean
        if not isValid(role) then return false
        return CreateObject("roRegex", "\b(episode\s*director)\b", "i").IsMatch(role.ToStr())
    end function

    ' Checks if a role string already contains an episode writer designation.
    function hasEpisodeWriterTag(role as dynamic) as boolean
        if not isValid(role) then return false
        return CreateObject("roRegex", "\b(episode\s*writer)\b", "i").IsMatch(role.ToStr())
    end function

    ' Compares two person representations (AssociativeArray or SGNode) by Id first.
    ' Falls back to case-insensitive Name only if Id is absent or empty on either.
    function isSamePerson(a as dynamic, b as dynamic) as boolean
        if not isValid(a) or not isValid(b) then return false

        idA = chainLookupReturn(a, "Id", chainLookupReturn(a, "json.Id", ""))
        if isValid(idA) then idA = idA.ToStr().Trim() else idA = ""

        idB = chainLookupReturn(b, "Id", chainLookupReturn(b, "json.Id", ""))
        if isValid(idB) then idB = idB.ToStr().Trim() else idB = ""

        if idA <> "" and idB <> ""
            return idA = idB
        end if

        nameA = chainLookupReturn(a, "Name", chainLookupReturn(a, "json.Name", chainLookupReturn(a, "labelText", "")))
        if isValid(nameA) then nameA = LCase(nameA.ToStr().Trim()) else nameA = ""

        nameB = chainLookupReturn(b, "Name", chainLookupReturn(b, "json.Name", chainLookupReturn(b, "labelText", "")))
        if isValid(nameB) then nameB = LCase(nameB.ToStr().Trim()) else nameB = ""

        if nameA <> "" and nameB <> ""
            return nameA = nameB
        end if

        return false
    end function

    ' Merges episode cast/crew with regular cast from season/series:
    ' 1. Episode actors tagged with (Guest Star)
    ' 2. Parent regular actors (deduplicated against episode actors)
    ' 3. Episode crew tagged with Episode Director / Episode Writer
    function mergeEpisodePeople(episodePeople as dynamic, parentActors as dynamic) as object
        merged = []
        episodeActors = []
        episodeCrew = []

        if type(episodePeople) = "roArray"
            for each person in episodePeople
                if isValid(person)
                    pType = LCase(chainLookupReturn(person, "Type", chainLookupReturn(person, "json.Type", "")))
                    pRole = chainLookupReturn(person, "Role", chainLookupReturn(person, "json.Role", ""))

                    pCopy = clonePerson(person)

                    if pType = "director"
                        newRole = formatEpisodeDirectorRole(pRole)
                        setPersonRoleAndType(pCopy, newRole, "Director")
                        episodeCrew.push(pCopy)
                    else if pType = "writer"
                        newRole = formatEpisodeWriterRole(pRole)
                        setPersonRoleAndType(pCopy, newRole, "Writer")
                        episodeCrew.push(pCopy)
                    else
                        ' Actor, GuestStar, or other credited cast
                        newRole = formatGuestStarRole(pRole)
                        setPersonRoleAndType(pCopy, newRole, isValidAndNotEmpty(pType) ? pType : "Actor")
                        episodeActors.push(pCopy)
                    end if
                end if
            end for
        end if

        for each actor in episodeActors
            merged.push(actor)
        end for

        if type(parentActors) = "roArray"
            for each parentActor in parentActors
                if isValid(parentActor)
                    alreadyInCast = false
                    for each epActor in episodeActors
                        if isSamePerson(epActor, parentActor)
                            alreadyInCast = true
                            exit for
                        end if
                    end for

                    if not alreadyInCast
                        merged.push(clonePerson(parentActor))
                    end if
                end if
            end for
        end if

        for each crewMember in episodeCrew
            merged.push(crewMember)
        end for

        return merged
    end function

    ' Deep/shallow copy for person dictionary
    function clonePerson(person as dynamic) as dynamic
        if not isValid(person) then return invalid
        if type(person) = "roAssociativeArray"
            copy = {}
            copy.append(person)
            return copy
        end if
        return person
    end function

    sub setPersonRoleAndType(person as dynamic, role as string, personType as string)
        if type(person) = "roAssociativeArray"
            person.Role = role
            if isValidAndNotEmpty(personType) then person.Type = personType
        else if isValid(person)
            if person.doesExist("json") and type(person.json) = "roAssociativeArray"
                person.json.Role = role
                if isValidAndNotEmpty(personType) then person.json.Type = personType
            end if
            if person.doesExist("subTitle")
                if LCase(personType) = "actor" or LCase(personType) = "gueststar"
                    if LCase(role.Trim()) = "guest star"
                        person.subTitle = tr("Guest Star")
                    else
                        person.subTitle = "as " + role
                    end if
                else
                    person.subTitle = role
                end if
            end if
        end if
    end sub

end namespace


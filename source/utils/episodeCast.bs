import "pkg:/source/utils/misc.bs"

namespace episodeCast

    function formatGuestStarRole(role as dynamic) as string
        return tagRole(role, "", "guest\s*star", tr("Guest Star"), tr("{0} (Guest Star)"))
    end function

    function formatEpisodeDirectorRole(role as dynamic) as string
        return tagRole(role, "director", "episode\s*director", tr("Episode Director"), tr("{0} (Episode Director)"))
    end function

    function formatEpisodeWriterRole(role as dynamic) as string
        return tagRole(role, "writer", "episode\s*writer", tr("Episode Writer"), tr("{0} (Episode Writer)"))
    end function

    ' An empty or plain role becomes the label on its own, and a role that already carries the tag
    ' is left as it is
    function tagRole(role as dynamic, plain as string, tag as string, label as string, template as string) as string
        roleStr = toString(role).Trim()
        if roleStr = "" or LCase(roleStr) = plain then return label
        if CreateObject("roRegex", "\b" + tag + "\b", "i").IsMatch(roleStr) then return roleStr
        return Substitute(template, roleStr)
    end function

    function hasGuestStarTag(role as dynamic) as boolean
        return CreateObject("roRegex", "\bguest\s*star\b", "i").IsMatch(toString(role))
    end function

    ' "as" the character for the cast and the role for the crew, otherwise the credit type
    function personSubtitle(personType as dynamic, role as dynamic) as string
        typeStr = toString(personType)
        kind = LCase(typeStr)
        roleStr = toString(role).Trim()
        if roleStr = "" then return typeStr
        if kind = "actor" or kind = "gueststar"
            if LCase(roleStr) = "guest star" or LCase(roleStr) = LCase(tr("Guest Star")) then return tr("Guest Star")
            return "as " + roleStr
        end if
        if kind = "director" or kind = "writer" then return roleStr
        return typeStr
    end function

    ' Two credits are the same person when their ids match, or by name when either has no id
    function isSamePerson(a as object, b as object) as boolean
        idA = toString(a.Id).Trim()
        idB = toString(b.Id).Trim()
        if idA <> "" and idB <> "" then return idA = idB

        nameA = LCase(toString(a.Name).Trim())
        nameB = LCase(toString(b.Name).Trim())
        return nameA <> "" and nameA = nameB
    end function

    ' The episode's own cast comes first, then the regulars it doesn't already credit, then its crew
    ' and anyone else
    function mergeEpisodePeople(episodePeople as object, parentActors as object) as object
        episodeActors = []
        episodeCrew = []
        otherCredits = []

        for each person in episodePeople
            if isValid(person)
                pCopy = {}
                pCopy.Append(person)
                pType = LCase(toString(person.Type))

                if pType = "director"
                    pCopy.Role = formatEpisodeDirectorRole(person.Role)
                    pCopy.Type = "Director"
                    episodeCrew.push(pCopy)
                else if pType = "writer"
                    pCopy.Role = formatEpisodeWriterRole(person.Role)
                    pCopy.Type = "Writer"
                    episodeCrew.push(pCopy)
                else if pType = "gueststar" or (pType = "actor" and hasGuestStarTag(person.Role))
                    pCopy.Role = formatGuestStarRole(person.Role)
                    episodeActors.push(pCopy)
                else if pType = "actor" or pType = ""
                    pCopy.Type = "Actor"
                    episodeActors.push(pCopy)
                else
                    otherCredits.push(pCopy)
                end if
            end if
        end for

        merged = []
        merged.Append(episodeActors)
        for each parentActor in parentActors
            alreadyInCast = false
            for each epActor in episodeActors
                if isSamePerson(epActor, parentActor)
                    alreadyInCast = true
                    exit for
                end if
            end for
            if not alreadyInCast then merged.push(parentActor)
        end for
        merged.Append(episodeCrew)
        merged.Append(otherCredits)
        return merged
    end function

end namespace

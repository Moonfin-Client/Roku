import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' The actions a Seerr title offers, in the shape the detail screens build their buttons from.
' What is on offer depends on what Seerr already has and on what the viewer is allowed to ask
' for, so the state is worked out here rather than in each screen.
namespace seerrButtons

    ' Seerr's media status: 1 unknown, 2 pending, 3 processing, 4 partly available, 5 available
    const STATUS_UNKNOWN = 1
    const STATUS_PENDING = 2
    const STATUS_PROCESSING = 3
    const STATUS_PARTIAL = 4

    const REQUEST_PENDING = 1

    function Candidates(details as object, mediaType as string) as object
        offered = []
        if not isValid(details) then return offered

        mediaInfo = details.mediaInfo
        hdStatus = invalid
        status4k = invalid
        if isValid(mediaInfo)
            hdStatus = mediaInfo.status
            status4k = mediaInfo.status4k
        end if

        offersHd = seerrButtons.Requestable(hdStatus)
        offers4k = seerrButtons.Requestable(status4k) and CanRequest4K(GetCurrentUserSeerrPermissions(), mediaType)

        ' With both tracks on offer one button covers them and asks which first
        if offersHd and offers4k
            offered.push(seerrButtons.Entry("seerrRequest", "pkg:/images/icons/request_hd.png", tr("Request"), "seerrRequest"))
        else
            button = seerrButtons.TrackButton("seerrRequest", "pkg:/images/icons/request_hd.png", tr("HD"), hdStatus, offersHd, "seerrRequest")
            if isValid(button) then offered.push(button)

            button = seerrButtons.TrackButton("seerrRequest4k", "pkg:/images/icons/request_4k.png", tr("4K"), status4k, offers4k, "seerrRequest4k")
            if isValid(button) then offered.push(button)
        end if

        if seerrButtons.PendingRequests(mediaInfo).count() > 0
            offered.push(seerrButtons.Entry("seerrCancel", "pkg:/images/icons/cancel.png", tr("Cancel Request"), "seerrCancel"))
        end if

        return offered
    end function

    ' Whether one button has to cover both tracks and ask which first
    function OffersBothTracks(details as object, mediaType as string) as boolean
        if not isValid(details) then return false

        mediaInfo = details.mediaInfo
        hdStatus = invalid
        status4k = invalid
        if isValid(mediaInfo)
            hdStatus = mediaInfo.status
            status4k = mediaInfo.status4k
        end if

        if not seerrButtons.Requestable(hdStatus) then return false
        if not seerrButtons.Requestable(status4k) then return false

        return CanRequest4K(GetCurrentUserSeerrPermissions(), mediaType)
    end function

    ' A title can be asked for while Seerr knows nothing about it, and again once it is only
    ' partly there
    function Requestable(status as dynamic) as boolean
        if not isValid(status) then return true
        return status = seerrButtons.STATUS_UNKNOWN or status = seerrButtons.STATUS_PARTIAL
    end function

    ' Either an offer to request the track or a note on what is already happening to it
    function TrackButton(id as string, icon as string, track as string, status as dynamic, canRequest as boolean, action as string) as object
        if isValid(status) and status >= seerrButtons.STATUS_PENDING and status <> seerrButtons.STATUS_PARTIAL
            if status = seerrButtons.STATUS_PENDING
                return seerrButtons.Disabled(id, icon, Substitute(tr("{0} Pending"), track))
            end if
            if status = seerrButtons.STATUS_PROCESSING
                return seerrButtons.Disabled(id, icon, Substitute(tr("{0} Processing"), track))
            end if
            return seerrButtons.Disabled(id, icon, Substitute(tr("{0} Available"), track))
        end if

        if not canRequest then return invalid

        label = Substitute(tr("Request {0}"), track)
        if status = seerrButtons.STATUS_PARTIAL then label = Substitute(tr("Request More ({0})"), track)

        return seerrButtons.Entry(id, icon, label, action)
    end function

    function PendingRequests(mediaInfo as object) as object
        pending = []
        if not isValid(mediaInfo) or not isValidAndNotEmpty(mediaInfo.requests) then return pending

        for each request in mediaInfo.requests
            if request.status = seerrButtons.REQUEST_PENDING then pending.push(request)
        end for

        return pending
    end function

    function Entry(id as string, icon as string, label as string, action as string) as object
        return { id: id, config: { icon: icon, label: label, action: action, id: `${id}Button` } }
    end function

    function Disabled(id as string, icon as string, label as string) as object
        return { id: id, config: { icon: icon, label: label, action: "none", id: `${id}Button` } }
    end function

end namespace

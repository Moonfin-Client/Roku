import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' The technical badges beside a title: what it is encoded as, what it is wrapped in and what
' it sounds like. All of them read off the media source, so a title with nothing selected yet
' gets none rather than a row of blanks.
namespace mediaBadges

    const WIDTH_4K = 3800
    const WIDTH_1080 = 1900
    const WIDTH_720 = 1260

    ' The viewer can turn the whole row off
    function Enabled() as boolean
        return get_user_setting_bool("ui.library.showTechnicalDetails", true)
    end function

    function Build(itemData as object, versionIndex = 0 as integer) as object
        badges = []

        source = mediaBadges.SourceAt(itemData, versionIndex)
        if not isValid(source) then return badges

        streams = source.MediaStreams
        if not isValidAndNotEmpty(streams) then streams = itemData.MediaStreams
        video = mediaBadges.StreamOfType(streams, "Video")
        audio = mediaBadges.StreamOfType(streams, "Audio")

        if isValid(video)
            mediaBadges.AddResolution(badges, video)
            mediaBadges.AddRange(badges, video)

            codec = mediaBadges.VideoCodecLabel(video.Codec)
            if codec <> "" then badges.push(codec)
        end if

        if isValidAndNotEmpty(source.Container) then badges.push(UCase(source.Container))

        if isValid(audio)
            mediaBadges.AddChannels(badges, audio)

            codec = mediaBadges.AudioCodecLabel(audio.Codec)
            if codec <> "" then badges.push(codec)
        end if

        return badges
    end function

    function SourceAt(itemData as object, versionIndex as integer) as object
        if not isValid(itemData) or not isValidAndNotEmpty(itemData.MediaSources) then return invalid

        sources = itemData.MediaSources
        if versionIndex >= 0 and versionIndex < sources.count() then return sources[versionIndex]

        return sources[0]
    end function

    function StreamOfType(streams as object, streamType as string) as object
        if not isValidAndNotEmpty(streams) then return invalid

        for each stream in streams
            if isStringEqual(stream.Type, streamType) then return stream
        end for

        return invalid
    end function

    sub AddResolution(badges as object, video as object)
        width = video.Width
        if not isValid(width) then return

        if width >= mediaBadges.WIDTH_4K
            badges.push(tr("4K"))
        else if width >= mediaBadges.WIDTH_1080
            badges.push(tr("1080p"))
        else if width >= mediaBadges.WIDTH_720
            badges.push(tr("720p"))
        end if
    end sub

    ' Dolby Vision is called out on its own, and a disc that carries both says so twice
    sub AddRange(badges as object, video as object)
        rangeType = video.VideoRangeType ?? ""

        if rangeType = "DOVI" or rangeType = "DOVIWithHDR10" or rangeType = "DOVIWithHDR10Plus"
            badges.push(tr("DV"))
        end if

        if rangeType <> "" and rangeType <> "SDR"
            if rangeType.Instr("HDR10Plus") >= 0
                badges.push(tr("HDR10+"))
            else if rangeType.Instr("HDR10") >= 0
                badges.push(tr("HDR10"))
            else if rangeType <> "DOVI"
                badges.push(tr("HDR"))
            end if
            return
        end if

        if isStringEqual(video.VideoRange ?? "", "HDR") then badges.push(tr("HDR"))
    end sub

    ' Atmos and DTS:X name themselves, and anything else is described by its channel count
    sub AddChannels(badges as object, audio as object)
        profile = audio.Profile ?? ""
        title = audio.Title ?? ""

        if profile.Instr("Atmos") >= 0 or title.Instr("Atmos") >= 0
            badges.push(tr("ATMOS"))
            return
        end if

        if profile.Instr("DTS:X") >= 0 or title.Instr("DTS:X") >= 0
            badges.push(tr("DTS:X"))
            return
        end if

        channels = audio.Channels
        if not isValid(channels) then return

        if channels > 6
            badges.push(`${channels - 1}.1`)
        else if channels = 6
            badges.push("5.1")
        else if channels = 2
            badges.push(tr("Stereo"))
        end if
    end sub

    function VideoCodecLabel(codec as dynamic) as string
        if not isValidAndNotEmpty(codec) then return ""

        upper = UCase(codec)
        if upper = "H264" then return "H.264"
        return upper
    end function

    function AudioCodecLabel(codec as dynamic) as string
        if not isValidAndNotEmpty(codec) then return ""

        upper = UCase(codec)
        if upper = "TRUEHD" then return "TrueHD"
        return upper
    end function

end namespace

import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/misc.bs"

' The technical badges beside a title: what it is encoded as, what it is wrapped in and what
' it sounds like. All of them read off the media source, so a title with nothing selected yet
' gets none rather than a row of blanks.
namespace mediaBadges

    const WIDTH_4K = 3800
    const WIDTH_1080 = 1900
    const WIDTH_720 = 1260

    ' The viewer can turn the whole row off, and Kids Mode always does
    function Enabled() as boolean
        if kidsMode.Enabled() then return false
        return get_user_setting_bool("ui.library.showTechnicalDetails", true)
    end function

    function Build(itemData as object, versionIndex = 0 as integer) as object
        badges = []

        source = mediaBadges.SourceAt(itemData, versionIndex)
        if not isValid(source) then return badges

        streams = source.MediaStreams
        if not isValidAndNotEmpty(streams) then streams = itemData.MediaStreams
        video = mediaBadges.StreamOfType(streams, "Video")
        audio = mediaBadges.StreamOfType(streams, "Audio")

        if isValid(video)
            mediaBadges.AddResolution(badges, video)
            mediaBadges.AddRange(badges, video)

            codec = mediaBadges.VideoCodecLabel(video.Codec)
            if codec <> "" then badges.push(codec)
        end if

        if isValidAndNotEmpty(source.Container) then badges.push(UCase(source.Container))

        if isValid(audio)
            mediaBadges.AddChannels(badges, audio)

            codec = mediaBadges.AudioCodecLabel(audio.Codec)
            if codec <> "" then badges.push(codec)
        end if

        return badges
    end function

    function SourceAt(itemData as object, versionIndex as integer) as object
        if not isValid(itemData) or not isValidAndNotEmpty(itemData.MediaSources) then return invalid

        sources = itemData.MediaSources
        if versionIndex >= 0 and versionIndex < sources.count() then return sources[versionIndex]

        return sources[0]
    end function

    function StreamOfType(streams as object, streamType as string) as object
        if not isValidAndNotEmpty(streams) then return invalid

        for each stream in streams
            if isStringEqual(stream.Type, streamType) then return stream
        end for

        return invalid
    end function

    sub AddResolution(badges as object, video as object)
        width = video.Width
        if not isValid(width) then return

        if width >= mediaBadges.WIDTH_4K
            badges.push(tr("4K"))
        else if width >= mediaBadges.WIDTH_1080
            badges.push(tr("1080p"))
        else if width >= mediaBadges.WIDTH_720
            badges.push(tr("720p"))
        end if
    end sub

    ' The shorthand a video is known by, taken from what its stream measures. Both sides are
    ' checked because a scope film is short of the height its width would suggest, and a
    ' pillarboxed one is short of the width.
    function ResolutionLabel(itemData as object) as string
        if not isValid(itemData) then return ""

        streams = itemData.MediaStreams
        source = mediaBadges.SourceAt(itemData, 0)
        if not isValidAndNotEmpty(streams) and isValid(source) then streams = source.MediaStreams

        video = mediaBadges.StreamOfType(streams, "Video")
        if not isValid(video) then return ""

        width = video.Width
        height = video.Height
        if not isValid(width) or not isValid(height) or width <= 0 or height <= 0 then return ""

        suffix = video.IsInterlaced = true ? "i" : "p"

        if width >= 7600 or height >= 4300 then return "8K"
        if width >= 3800 or height >= 2000 then return "4K"
        if width >= 2500 or height >= 1400 then return `1440${suffix}`
        if width >= 1800 or height >= 1000 then return `1080${suffix}`
        if width >= 1200 or height >= 700 then return `720${suffix}`
        if width >= 600 or height >= 400 then return `480${suffix}`
        return tr("SD")
    end function

    ' Dolby Vision with its profile when the server gives one (DV P8), then the layer a set without
    ' Dolby Vision falls back to. An SDR fallback gets no badge of its own, and Dolby Vision the
    ' server calls invalid reads as whatever VideoRange says the picture is.
    sub AddRange(badges as object, video as object)
        rangeType = mediaBadges.RangeTypeOf(video)
        if rangeType = "DOVIInvalid"
            range = isStringEqual(video.LookupCI("VideoRange") ?? "", "HDR") ? "HDR" : "SDR"
        else
            range = mediaBadges.RangeLabel(video)
        end if

        hdrLabel = range
        if range = "Dolby Vision"
            hdrLabel = mediaBadges.BaseLayerLabel(rangeType)
            profile = mediaBadges.DolbyVisionProfile(video)
            if profile > 0
                badges.push(tr("DV P{profile}").Replace("{profile}", profile.ToStr()))
            else
                badges.push(tr("DV"))
            end if
        end if

        if hdrLabel = "HDR" then badges.push(tr("HDR"))
        if hdrLabel = "HDR10" then badges.push(tr("HDR10"))
        if hdrLabel = "HDR10+" then badges.push(tr("HDR10+"))
        if hdrLabel = "HLG" then badges.push(tr("HLG"))
    end sub

    ' A range value squashed to capitals and digits, with + spelled out so HDR 10+ doesn't read as HDR10
    function Squash(value as dynamic) as string
        if not isValidAndNotEmpty(value) or type(value) <> "roString" and type(value) <> "String" then return ""
        return CreateObject("roRegex", "[^A-Z0-9]+", "").ReplaceAll(UCase(value.Replace("+", "PLUS")), "")
    end function

    ' The first range field the server filled in with a range. Emby puts None in ExtendedVideoType for
    ' anything that isn't Dolby Vision or HLG, and Jellyfin sometimes Unknown in VideoRangeType, so
    ' those say nothing and the next field is read.
    function RangeField(video as object, fields as object) as string
        for each field in fields
            value = mediaBadges.Squash(video.LookupCI(field))
            if value <> "" and value <> "NONE" and value <> "UNKNOWN" then return value
        end for
        return ""
    end function

    ' The HDR format a stream carries, from whichever range field the server filled in. Emby types it
    ' in ExtendedVideoType and writes VideoRange as prose, HDR 10 rather than HDR10.
    function RangeLabel(video as object) as string
        range = mediaBadges.RangeField(video, ["VideoRangeType", "ExtendedVideoType", "VideoRange"])

        if range.Instr("DOVI") >= 0 or range.Instr("DOLBYVISION") >= 0 then return "Dolby Vision"
        ' Ahead of HDR10, which its own name would match first
        if range.Instr("HDR10PLUS") >= 0 then return "HDR10+"
        if range.Instr("HDR10") >= 0 then return "HDR10"
        if range.Instr("HLG") >= 0 or range.Instr("HYPERLOGGAMMA") >= 0 then return "HLG"
        if range.Instr("HDR") >= 0 then return "HDR"
        return "SDR"
    end function

    ' Jellyfin's VideoRangeType for the stream. Emby leaves that off and types Dolby Vision in
    ' ExtendedVideoType, or the VideoRange it derives from it, with the profile in
    ' ExtendedVideoSubType, which reads here as the range type Jellyfin gives the same file.
    function RangeTypeOf(video as object) as string
        rangeType = video.LookupCI("VideoRangeType")
        if isValidAndNotEmpty(rangeType) and mediaBadges.Squash(rangeType) <> "UNKNOWN" then return rangeType

        if mediaBadges.RangeField(video, ["ExtendedVideoType", "VideoRange"]) <> "DOLBYVISION" then return ""

        ' The layer under each profile, as Jellyfin names it for the same file
        subType = mediaBadges.Squash(video.LookupCI("ExtendedVideoSubType"))
        layers = {
            DOVIPROFILE61: "DOVIWithHDR10",
            DOVIPROFILE81: "DOVIWithHDR10",
            DOVIPROFILE101: "DOVIWithHDR10",
            DOVIPROFILE84: "DOVIWithHLG",
            DOVIPROFILE104: "DOVIWithHLG",
            DOVIPROFILE102: "DOVIWithSDR"
        }
        if layers.DoesExist(subType) then return layers[subType]
        if Left(subType, 12) = "DOVIPROFILE5" then return "DOVI"
        if Left(subType, 12) = "DOVIPROFILE7" then return "DOVIWithEL"
        return "DolbyVision"
    end function

    ' The Dolby Vision profile, from DvProfile (Jellyfin, Silo, Plex) or Emby's ExtendedVideoSubType,
    ' which writes the profile and its compatibility level together: DoviProfile81 is profile 8 and
    ' DoviProfile101 profile 10. 0 when there's none.
    function DolbyVisionProfile(video as dynamic) as integer
        if type(video) <> "roAssociativeArray" then return 0
        profile = video.LookupCI("DvProfile")
        if isValid(profile) and (type(profile) = "roInt" or type(profile) = "Integer" or type(profile) = "roFloat" or type(profile) = "Float" or type(profile) = "LongInteger") and profile > 0 then return Int(profile)
        match = CreateObject("roRegex", "doviprofile(\d+)", "i").Match(toString(video.LookupCI("ExtendedVideoSubType") ?? ""))
        if match.count() < 2 then return 0
        digits = match[1]
        if Len(digits) >= 3 then return Left(digits, 2).ToInt()
        return Left(digits, 1).ToInt()
    end function

    ' The format under the Dolby Vision, named after DOVIWith in the range type. A profile 7
    ' enhancement layer sits on HDR10 unless HDR10+ is named with it, and bare Dolby Vision has
    ' nothing under it.
    function BaseLayerLabel(rangeType as string) as string
        match = CreateObject("roRegex", "^DOVIWITH(?:EL)?(.*)$", "").Match(mediaBadges.Squash(rangeType))
        if match.count() < 2 then return ""
        layer = match[1]
        if layer = "" then layer = "HDR10"
        return mediaBadges.RangeLabel({ VideoRangeType: layer })
    end function

    ' Atmos and DTS:X name themselves, and anything else is described by its channel count
    sub AddChannels(badges as object, audio as object)
        profile = audio.Profile ?? ""
        title = audio.Title ?? ""

        if profile.Instr("Atmos") >= 0 or title.Instr("Atmos") >= 0
            badges.push(tr("ATMOS"))
            return
        end if

        if profile.Instr("DTS:X") >= 0 or title.Instr("DTS:X") >= 0
            badges.push(tr("DTS:X"))
            return
        end if

        channels = audio.Channels
        if not isValid(channels) then return

        if channels > 6
            badges.push(`${channels - 1}.1`)
        else if channels = 6
            badges.push("5.1")
        else if channels = 2
            badges.push(tr("Stereo"))
        end if
    end sub

    function VideoCodecLabel(codec as dynamic) as string
        if not isValidAndNotEmpty(codec) then return ""

        upper = UCase(codec)
        if upper = "H264" then return "H.264"
        return upper
    end function

    function AudioCodecLabel(codec as dynamic) as string
        if not isValidAndNotEmpty(codec) then return ""

        upper = UCase(codec)
        if upper = "TRUEHD" then return "TrueHD"
        return upper
    end function

end namespace

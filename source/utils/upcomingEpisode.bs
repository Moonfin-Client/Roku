import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

namespace upcomingEpisode

    const LOOKUP_TIMEOUT_MS = 5000
    const SONARR_TTL_SECONDS = 1800

    ' Next: Today (S2:E1), counted in days on the viewer's own calendar
    function FormatUpcomingEpisode(info as object) as string
        if not isValid(info) or not isValidAndNotEmpty(info.airDate) then return ""

        target = upcomingEpisode.localDate(info.airDate)
        if not isValid(target) then return ""

        now = CreateObject("roDateTime")
        now.ToLocalTime()
        diffDays = upcomingEpisode.dayNumber(target.year, target.month, target.day) - upcomingEpisode.dayNumber(now.GetYear(), now.GetMonth(), now.GetDayOfMonth())

        if diffDays = 0
            dateText = tr("Today")
        else if diffDays = 1
            dateText = tr("Tomorrow")
        else if diffDays > 1 and diffDays < 7
            weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
            dateText = tr(weekdays[target.weekday])
        else
            months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
            dateText = `${tr(months[target.month - 1])} ${target.day.toStr()}`
        end if

        code = ""
        if isValid(info.seasonNumber) and isValid(info.episodeNumber)
            code = ` (S${info.seasonNumber.toStr()}:E${info.episodeNumber.toStr()})`
        end if

        return `${tr("Next")}: ${dateText}${code}`
    end function

    function ResolveUpcomingEpisodeText(itemData as object) as string
        if not isValid(itemData) then return ""
        return upcomingEpisode.FormatUpcomingEpisode(upcomingEpisode.lookup(itemData))
    end function

    ' A season or an episode asks about its series. Each series is looked up once per
    ' session, and a miss is kept as well so the same series isnt asked about again.
    function lookup(itemData as object) as dynamic
        seriesId = itemData.Id
        if not isStringEqual(itemData.Type, "Series") and isValidAndNotEmpty(itemData.SeriesId) then seriesId = itemData.SeriesId
        if not isValidAndNotEmpty(seriesId) then return invalid

        known = upcomingEpisode.cache().series
        if known.DoesExist(seriesId) then return known[seriesId].info

        info = upcomingEpisode.find(itemData)

        stored = upcomingEpisode.cache()
        stored.series[seriesId] = { info: info }
        m.global.upcomingEpisodeCache = stored
        return info
    end function

    ' Sonarr first, matched on the TVDB id and then the TMDB id, then TMDB with the synced
    ' key, then TMDB through Moonbase
    function find(itemData as object) as dynamic
        providerIds = upcomingEpisode.seriesProviderIds(itemData)
        tvdbId = upcomingEpisode.providerId(providerIds, "Tvdb")
        tmdbId = upcomingEpisode.providerId(providerIds, "Tmdb")

        calendar = upcomingEpisode.sonarrCalendar()
        if tvdbId <> "" and calendar.byTvdb.DoesExist(tvdbId) then return calendar.byTvdb[tvdbId]
        if tmdbId <> "" and calendar.byTmdb.DoesExist(tmdbId) then return calendar.byTmdb[tmdbId]

        if tmdbId = "" then return invalid

        info = upcomingEpisode.fromTmdb(tmdbId)
        if isValid(info) then return info
        return upcomingEpisode.fromMoonbase(tmdbId, itemData)
    end function

    ' A season carries its own provider ids, which Sonarr and TMDB know nothing about
    function seriesProviderIds(itemData as object) as object
        if isStringEqual(itemData.Type, "Series") or not isValidAndNotEmpty(itemData.SeriesId) then return itemData.ProviderIds

        data = getJsonWithin(upcomingEpisode.serverRequest(itemData, "/Items", { ids: itemData.SeriesId, fields: "ProviderIds" }), upcomingEpisode.LOOKUP_TIMEOUT_MS)
        series = chainLookup(data, "Items.0")
        if isChainValid(series, "ProviderIds") then return series.ProviderIds
        return itemData.ProviderIds
    end function

    function providerId(providerIds as dynamic, name as string) as string
        if not isValid(providerIds) then return ""
        return upcomingEpisode.idText(providerIds.LookupCI(name))
    end function

    function idText(value as dynamic) as string
        if not isValid(value) then return ""
        if type(value) = "String" or type(value) = "roString" then return value.Trim()
        if value = 0 then return ""
        return value.toStr()
    end function

    function serverRequest(itemData as object, path as string, params as object) as dynamic
        serverData = getServerInfoFromItem(itemData)
        if isValid(serverData) then return APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, path, params)
        return APIRequest(path, params)
    end function

    ' Every show Sonarr has coming up in the next 90 days, keeping the earliest episode
    ' of each that hasnt aired before today
    function sonarrCalendar() as object
        nowSeconds = CreateObject("roDateTime").AsSeconds()
        cached = upcomingEpisode.cache().sonarr
        if isValid(cached) and nowSeconds - cached.fetchedAt < upcomingEpisode.SONARR_TTL_SECONDS then return cached

        calendar = { byTvdb: {}, byTmdb: {}, fetchedAt: nowSeconds }
        if not GetSeerrConfig().enabled then return calendar

        episodes = getJsonWithin(APIRequest("/Moonfin/Seerr/Sonarr/Calendar"), upcomingEpisode.LOOKUP_TIMEOUT_MS)
        if type(episodes) <> "roArray" then return calendar

        midnight = upcomingEpisode.localMidnightSeconds()
        for each episode in episodes
            series = episode.series ?? {}
            tvdbId = upcomingEpisode.idText(series.tvdbId)
            tmdbId = upcomingEpisode.idText(series.tmdbId)
            airDate = episode.airDateUtc ?? episode.airDate

            if (tvdbId <> "" or tmdbId <> "") and upcomingEpisode.isDateText(airDate)
                airedAt = upcomingEpisode.airSeconds(airDate)
                if airedAt >= midnight
                    info = {
                        seasonNumber: episode.seasonNumber ?? 1,
                        episodeNumber: episode.episodeNumber ?? 1,
                        airDate: airDate,
                        airSeconds: airedAt
                    }
                    upcomingEpisode.keepEarliest(calendar.byTvdb, tvdbId, info)
                    upcomingEpisode.keepEarliest(calendar.byTmdb, tmdbId, info)
                end if
            end if
        end for

        stored = upcomingEpisode.cache()
        stored.sonarr = calendar
        m.global.upcomingEpisodeCache = stored
        return calendar
    end function

    sub keepEarliest(index as object, key as string, info as object)
        if key = "" then return
        if index.DoesExist(key) and index[key].airSeconds <= info.airSeconds then return
        index[key] = info
    end sub

    function fromTmdb(tmdbId as string) as dynamic
        apiKey = chainLookupReturn(m.global.session, "user.settings.`plugin.tmdb.apiKey`", "")
        if apiKey = "" then return invalid

        url = "https://api.themoviedb.org/3/tv/" + tmdbId
        req = CreateObject("roUrlTransfer")
        req.SetCertificatesFile("common:/certs/ca-bundle.crt")
        req.InitClientCertificates()

        ' v4 tokens go in the Authorization header, v3 keys go in the query string
        if Left(apiKey, 3) = "eyJ"
            req.AddHeader("Authorization", "Bearer " + apiKey)
        else
            url = url + "?api_key=" + apiKey
        end if
        req.SetUrl(url)

        nextEpisode = chainLookup(getJsonWithin(req, upcomingEpisode.LOOKUP_TIMEOUT_MS), "next_episode_to_air")
        if not isChainValid(nextEpisode, "air_date") or nextEpisode.air_date = "" then return invalid

        return {
            seasonNumber: nextEpisode.season_number ?? 1,
            episodeNumber: nextEpisode.episode_number ?? 1,
            airDate: nextEpisode.air_date
        }
    end function

    function fromMoonbase(tmdbId as string, itemData as object) as dynamic
        if not moonfinPlugin.IsEnabled() then return invalid

        data = getJsonWithin(upcomingEpisode.serverRequest(itemData, "/Moonfin/Tmdb/NextEpisode", { tmdbId: tmdbId }), upcomingEpisode.LOOKUP_TIMEOUT_MS)
        if chainLookupReturn(data, "success", false) <> true or not isValidAndNotEmpty(data.airDate) then return invalid

        return {
            seasonNumber: data.seasonNumber ?? 1,
            episodeNumber: data.episodeNumber ?? 1,
            airDate: data.airDate
        }
    end function

    function cache() as object
        if not m.global.hasField("upcomingEpisodeCache") then m.global.addFields({ upcomingEpisodeCache: {} })

        stored = m.global.upcomingEpisodeCache
        if not isValid(stored.series) then stored.series = {}
        return stored
    end function

    ' A bare date is already a day on the viewer's calendar. A timestamp is moved into
    ' the local time zone first, so an evening airing isnt counted as the next day.
    function localDate(airDate as string) as dynamic
        if not upcomingEpisode.isDateText(airDate) then return invalid

        date = CreateObject("roDateTime")
        if Len(airDate) = 10
            date.FromISO8601String(airDate + "T00:00:00Z")
        else
            date.FromISO8601String(airDate)
            date.ToLocalTime()
        end if

        return {
            year: date.GetYear(),
            month: date.GetMonth(),
            day: date.GetDayOfMonth(),
            weekday: date.GetDayOfWeek()
        }
    end function

    ' A new roDateTime starts at the current time, so a string it cant read has to be
    ' caught before it is parsed
    function isDateText(value as dynamic) as boolean
        if not isValid(value) or (type(value) <> "String" and type(value) <> "roString") or Len(value) < 10 then return false

        month = Mid(value, 6, 2).toInt()
        day = Mid(value, 9, 2).toInt()
        return Mid(value, 5, 1) = "-" and month >= 1 and month <= 12 and day >= 1 and day <= 31
    end function

    function dayNumber(year as integer, month as integer, day as integer) as integer
        date = CreateObject("roDateTime")
        date.FromISO8601String(Substitute("{0}-{1}-{2}T00:00:00Z", year.toStr(), Right("0" + month.toStr(), 2), Right("0" + day.toStr(), 2)))
        return Int(date.AsSeconds() / 86400)
    end function

    function airSeconds(airDate as string) as integer
        date = CreateObject("roDateTime")
        if Len(airDate) = 10
            date.FromISO8601String(airDate + "T00:00:00Z")
        else
            date.FromISO8601String(airDate)
        end if
        return date.AsSeconds()
    end function

    ' The moment today began where the viewer is
    function localMidnightSeconds() as integer
        now = CreateObject("roDateTime")
        local = CreateObject("roDateTime")
        local.ToLocalTime()
        return now.AsSeconds() - (local.GetHours() * 3600 + local.GetMinutes() * 60 + local.GetSeconds())
    end function

end namespace

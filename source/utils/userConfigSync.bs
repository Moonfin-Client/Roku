import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"

' The playback language settings also live in the signed in user's Jellyfin configuration, which
' the server picks tracks by and the other clients read
namespace userConfigSync

    ' The configuration field a setting is kept in, empty for a setting that isnt one of them
    function FieldFor(rokuKey as string) as string
        if isStringEqual(rokuKey, "playback.subs.mode") then return "SubtitleMode"
        if isStringEqual(rokuKey, "playback.subs.language") then return "SubtitleLanguagePreference"
        if isStringEqual(rokuKey, "playback.audioPreferredLanguage") then return "AudioLanguagePreference"
        if isStringEqual(rokuKey, "playback.playDefaultAudioTrack") then return "PlayDefaultAudioTrack"
        return ""
    end function

    ' Writes the given settings into the configuration. The task reads the configuration again
    ' first, so fields this client doesnt manage, and ones another app changed since sign in, are
    ' kept. Settings that dont belong there are passed over. Answers the task, which the caller
    ' holds until it finishes, or invalid when there was nothing to send.
    function Push(changes as object) as dynamic
        currentConfig = m.global.session.user.Configuration
        if not isValid(currentConfig) then return invalid

        fields = {}
        for each rokuKey in changes
            field = userConfigSync.FieldFor(rokuKey)
            if field <> ""
                value = changes[rokuKey]
                if field = "PlayDefaultAudioTrack"
                    value = toBoolean(value)
                else if isStringEqual(value, "anyLanguage")
                    ' The client stores "anyLanguage" but the server expects an empty string
                    value = ""
                end if
                fields.AddReplace(field, value)
            end if
        end for
        if fields.IsEmpty() then return invalid

        ' The app reads the new values at once, before the server has answered
        currentConfig.Append(fields)
        session.user.Update("Configuration", currentConfig)

        task = CreateObject("roSGNode", "UserConfigTask")
        task.changes = fields
        task.control = "RUN"
        return task
    end function

end namespace

import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"

' What goes in the row of scores under a focused item, for the screens that show one.

namespace ratingsRow

    ' The community star and the critic score come off the item itself, so they are there
    ' before the plugin has been asked anything. The details page can turn both off, and home
    ' rows ("home") follow their own sources.
    function ServerEntries(itemData as object, scope = "" as string) as object
        entries = { community: invalid, critic: invalid }
        if not isValid(itemData) then return entries
        if scope = "" and not get_user_setting_bool("ui.itemdetail.showRatings", true) then return entries

        if isValid(itemData.CommunityRating) and moonfinPlugin.IsRatingSourceEnabled("stars", scope)
            entries.community = {
                source: "stars",
                name: tr("Community"),
                iconPath: "pkg:/images/sharp_star_white_18dp.webp",
                iconBlendColor: "#FFD700",
                formatted: libraryCard.OneDecimal(itemData.CommunityRating)
            }
        end if

        if isValid(itemData.CriticRating) and itemData.CriticRating > 0
            entries.critic = {
                source: "tomatoes",
                name: tr("Rotten Tomatoes"),
                iconPath: itemData.CriticRating >= 60 ? "pkg:/images/fresh.webp" : "pkg:/images/rotten.webp",
                formatted: `${itemData.CriticRating}%`
            }
        end if

        return entries
    end function

    ' The critic score stands in until the plugin's ratings arrive, then steps aside
    function Merge(fromServer as object, pluginRatings as object) as object
        entries = []
        if not isValid(fromServer) then fromServer = {}
        if not isValid(pluginRatings) then pluginRatings = []

        if isValid(fromServer.community) then entries.push(fromServer.community)
        if isValid(fromServer.critic) and pluginRatings.count() = 0 then entries.push(fromServer.critic)

        for each rating in pluginRatings
            entries.push(rating)
        end for

        return entries
    end function

end namespace

import "pkg:/source/api/plex/PlexItems.bs"

' Changes to what an account has watched and kept on a Plex server

namespace plexWrites

    function Status(reply as object) as object
        return { status: reply.status, data: invalid }
    end function

    function Favorite(ctx as object, itemId as string, isFavorite as boolean) as object
        if plexUrls.IsPrefixedId(itemId) then return { status: 501, data: invalid }
        rating = -1
        if isFavorite then rating = PLEX_FAVORITE_RATING
        reply = plexHttp.Send(ctx, "/:/rate", { "key": plexItems.KeyOf(itemId), "identifier": PLEX_LIBRARY_IDENTIFIER, "rating": rating }, "PUT")
        return plexWrites.Status(reply)
    end function

    function Watched(ctx as object, itemId as string, isWatched as boolean) as object
        path = "/:/unscrobble"
        if isWatched then path = "/:/scrobble"
        return plexWrites.Status(plexHttp.Send(ctx, path, { "key": plexItems.KeyOf(itemId), "identifier": PLEX_LIBRARY_IDENTIFIER }))
    end function

    ' Plex keeps the resume position, and nothing but playing the item again brings it back
    function HideFromResume(ctx as object, itemId as string) as object
        return plexWrites.Status(plexHttp.Send(ctx, "/actions/removeFromContinueWatching", { "ratingKey": plexItems.KeyOf(itemId) }, "PUT"))
    end function

end namespace

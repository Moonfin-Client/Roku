import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/youtubeTrailer.bs"

' A Plex item never carries trailer links, so its trailer is the top YouTube search hit for the title
' instead. A search is kept per title for the session, but a failed one isn't.

const TRAILER_SEARCH_TIMEOUT_MS = 10000

namespace trailerSearch

    ' An item from the signed in server names no server of its own
    function Searches(item as dynamic) as boolean
        return isPlexServer(toString(chainLookupReturn(item, "_serverUrl", "")))
    end function

    ' A movie or show offers a trailer before one is searched for
    function Offers(item as dynamic) as boolean
        itemType = LCase(toString(chainLookupReturn(item, "Type", "")))
        return (itemType = "movie" or itemType = "series") and trailerSearch.Searches(item)
    end function

    ' The item's trailer as a RemoteTrailers list, empty when the search found nothing
    function Find(item as dynamic) as object
        query = youtubeTrailer.SearchQuery(item)
        if query = "" then return []
        kept = m.global.trailerSearches
        if type(kept) <> "roAssociativeArray" then kept = {}
        if kept.DoesExist(query) then return [{ "Url": kept[query] }]

        req = CreateObject("roUrlTransfer")
        req.SetUrl(youtubeTrailer.SEARCH_URL)
        req.SetCertificatesFile("common:/certs/ca-bundle.crt")
        req.InitClientCertificates()
        req.EnableEncodings(true)
        req.AddHeader("Content-Type", "text/plain;charset=UTF-8")
        videoId = youtubeTrailer.FirstSearchVideoId(requestResponse(req, "POST", youtubeTrailer.SearchRequestBody(query), TRAILER_SEARCH_TIMEOUT_MS).data)
        if videoId = "" then return []

        url = "https://www.youtube.com/watch?v=" + videoId
        kept[query] = url
        m.global.trailerSearches = kept
        return [{ "Url": url }]
    end function

end namespace

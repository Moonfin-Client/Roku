import "pkg:/source/utils/diagnostics.bs"
import "pkg:/source/utils/serverCompatibility.bs"
' Functions for making requests to the API
function buildParams(params = {} as object) as string
    ' Take an object of parameters and construct the URL query

    param_array = []
    for each field in params.items()
        item = ""
        if type(field.value) = "String" or type(field.value) = "roString"
            item = field.key + "=" + field.value.trim().EncodeUriComponent()
        else if type(field.value) = "roInteger" or type(field.value) = "roInt" or type(field.value) = "Integer"
            item = field.key + "=" + stri(field.value).trim()
            'item = field.key + "=" + str(field.value).trim()
        else if type(field.value) = "roFloat" or type(field.value) = "Float"
            item = field.key + "=" + stri(int(field.value)).trim()
        else if type(field.value) = "LongInteger" or type(field.value) = "roLongInteger"
            item = field.key + "=" + field.value.toStr().trim()
        else if type(field.value) = "roArray"
            ' TODO handle array params
        else if type(field.value) = "roBoolean" or type(field.value) = "Boolean"
            if field.value
                item = field.key + "=true"
            else
                item = field.key + "=false"
            end if
        else if field.value = invalid
            item = field.key + "=null"
        else if field <> invalid
            item = field.key + "=" + field.value.EncodeUriComponent()
        end if

        if item <> "" then param_array.push(item)
    end for

    return param_array.join("&")
end function

function buildServerURL(serverUrl as string, path as string, params = {} as object) as string
    if serverUrl = "" then return ""

    if serverUrl.left(7) <> "http://" and serverUrl.left(8) <> "https://"
        serverUrl = "http://" + serverUrl
    end if

    parsedUrl = ParsedUrl(serverUrl)
    if parsedUrl = invalid and serverUrl.Right(1) = "/"
        serverUrl = serverUrl.Left(serverUrl.Len() - 1)
        parsedUrl = ParsedUrl(serverUrl)
    end if
    if parsedUrl = invalid and Instr(1, serverUrl, "/?") > 0
        serverUrl = serverUrl.Replace("/?", "?")
        parsedUrl = ParsedUrl(serverUrl)
    end if
    if parsedUrl = invalid then return ""
    full_url = `${parsedUrl.proto}://${parsedUrl.host}${parsedUrl.port = "" ? "" : `:${parsedUrl.port}`}${parsedUrl.path}`

    pathParts = path.split("?")
    realPath = pathParts[0]
    pathQuery = ""
    if pathParts.count() > 1
        pathQuery = pathParts[1]
    end if

    if not realPath.startswith("/")
        realPath = "/" + realPath
    end if
    full_url += realPath

    hasServerQuery = isValidAndNotEmpty(parsedUrl.query)
    hasPathQuery = isValidAndNotEmpty(pathQuery)
    hasParams = isValidAndNotEmpty(params)

    if hasServerQuery or hasPathQuery or hasParams
        full_url += "?"

        if hasServerQuery
            full_url += parsedUrl.query
            if hasPathQuery or hasParams then full_url += "&"
        end if

        if hasPathQuery
            full_url += pathQuery
            if hasParams then full_url += "&"
        end if

        if hasParams
            full_url += buildParams(params)
        end if
    end if

    return full_url
end function

function buildURL(path as string, params = {} as object) as dynamic
    serverURL = get_url()
    if serverURL = invalid then return invalid

    emby = isEmbyServer(serverURL)
    if emby
        path = serverCompatiblePath(path, params, currentSessionUserId(), true)
        params = serverCompatibleParams(params, true)
    end if

    full_url = buildServerURL(serverURL, path, params)
    if full_url = "" then return invalid

    if Instr(1, LCase(path), "/images/") > 0 then full_url = authenticatedResourceURL(full_url, serverURL, params.LookupCI("api_key") ?? "")
    return full_url
end function

function APIRequest(url as string, params = {} as object) as dynamic
    full_url = buildURL(url, params)
    if full_url = invalid then return invalid

    req = CreateObject("roUrlTransfer")
    if not isValid(req) then return invalid

    req.setUrl(full_url)
    req.AddHeader("Accept", "application/json")
    req = authRequest(req)
    ' SSL cert
    if LCase(full_url).left(8) = "https://"
        setCertificateAuthority(req)
    end if

    return req
end function

' APIRequest hands back invalid when there is no server to build a URL against,
' so callers can reach here before a server has been picked
function getJson(req)
    if req = invalid then return invalid

    started = diagnostics.StartTrace("GET", req)
    data = req.GetToString()

    if data = invalid or data = ""
        diagnostics.EndTrace(started, "no body", diagnostics.LEVEL_WARN)
        return invalid
    end if

    json = ParseJson(data)
    if json = invalid
        diagnostics.EndTrace(started, "unparseable", diagnostics.LEVEL_WARN)
        return invalid
    end if

    diagnostics.EndTrace(started, "ok")
    return json
end function

function postVoid(req, data = "" as string) as boolean
    started = diagnostics.StartTrace("POST", req)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.AsyncPostFromString(data)
    resp = wait(30000, req.GetMessagePort())
    if type(resp) <> "roUrlEvent"
        diagnostics.EndTrace(started, "timed out", diagnostics.LEVEL_ERROR)
        return false
    end if

    code = resp.GetResponseCode()
    diagnostics.EndTrace(started, code.ToStr(), code = 200 ? diagnostics.LEVEL_DEBUG : diagnostics.LEVEL_ERROR)

    if code = 200
        return true
    end if

    return false
end function

function headVoid(req) as boolean
    started = diagnostics.StartTrace("HEAD", req)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.AsyncHead()
    resp = wait(30000, req.GetMessagePort())
    if type(resp) <> "roUrlEvent"
        diagnostics.EndTrace(started, "timed out", diagnostics.LEVEL_ERROR)
        return false
    end if

    code = resp.GetResponseCode()
    diagnostics.EndTrace(started, code.ToStr(), code = 200 ? diagnostics.LEVEL_DEBUG : diagnostics.LEVEL_ERROR)

    if code = 200
        return true
    end if

    return false
end function

function getVoid(req) as boolean
    started = diagnostics.StartTrace("GET", req)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.AsyncGetToString()
    resp = wait(30000, req.GetMessagePort())

    if type(resp) <> "roUrlEvent"
        diagnostics.EndTrace(started, "timed out", diagnostics.LEVEL_ERROR)
        return false
    end if

    code = resp.GetResponseCode()
    diagnostics.EndTrace(started, code.ToStr(), code = 200 ? diagnostics.LEVEL_DEBUG : diagnostics.LEVEL_ERROR)

    if code = 200
        return true
    end if

    return false
end function

function postJson(req, data = "" as string)
    started = diagnostics.StartTrace("POST", req)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.AsyncPostFromString(data)
    resp = wait(30000, req.GetMessagePort())
    if type(resp) <> "roUrlEvent"
        diagnostics.EndTrace(started, "timed out", diagnostics.LEVEL_ERROR)
        return invalid
    end if

    code = resp.GetResponseCode()

    if resp.getString() = ""
        diagnostics.EndTrace(started, code.ToStr() + " no body", diagnostics.LEVEL_WARN)
        return invalid
    end if

    diagnostics.EndTrace(started, code.ToStr(), code = 200 ? diagnostics.LEVEL_DEBUG : diagnostics.LEVEL_ERROR)

    json = ParseJson(resp.GetString())

    return json
end function

function deleteVoid(req)
    started = diagnostics.StartTrace("DELETE", req)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.SetRequest("DELETE")
    req.GetToString()

    ' Synchronous, so there is no status to report
    diagnostics.EndTrace(started, "sent")

    return true
end function

function getRuntimeContextValue(key as string) as dynamic
    if not isValidAndNotEmpty(key)
        return invalid
    end if

    runtimeContext = GetGlobalAA()
    if isValid(runtimeContext) and runtimeContext.DoesExist(key)
        return runtimeContext[key]
    end if

    return invalid
end function

function getRegistryValue(section as string, key as string) as dynamic
    if not isValidAndNotEmpty(section) or not isValidAndNotEmpty(key)
        return invalid
    end if

    registry = CreateObject("roRegistrySection", section)
    if registry.exists(key)
        return registry.read(key)
    end if

    return invalid
end function

function getActiveUserIdFromRegistry() as dynamic
    runtimeUserId = getRuntimeContextValue("moonfin.userId")
    if isValidAndNotEmpty(runtimeUserId)
        return runtimeUserId
    end if

    activeUserId = getRegistryValue("Jellyfin", "active_user")
    if isValidAndNotEmpty(activeUserId)
        return activeUserId
    end if

    usersRaw = getRegistryValue("Jellyfin", "available_users")
    if not isValidAndNotEmpty(usersRaw)
        return invalid
    end if

    users = ParseJson(usersRaw)
    if type(users) = "roArray" or type(users) = "Array"
        if users.count() = 1
            firstUser = users[0]
            if isValid(firstUser) and isValidAndNotEmpty(firstUser.id)
                return firstUser.id
            end if
        end if
    end if

    return invalid
end function

function getServerUrlFromRegistry() as dynamic
    serverURL = getRuntimeContextValue("moonfin.serverUrl")
    if isValidAndNotEmpty(serverURL)
        return serverURL
    end if

    serverURL = getRegistryValue("Jellyfin", "server")
    if isValidAndNotEmpty(serverURL)
        return serverURL
    end if

    activeUserId = getActiveUserIdFromRegistry()
    if isValidAndNotEmpty(activeUserId)
        serverURL = getRegistryValue(activeUserId, "serverUrl")
        if isValidAndNotEmpty(serverURL)
            return serverURL
        end if
    end if

    usersRaw = getRegistryValue("Jellyfin", "available_users")
    if isValidAndNotEmpty(usersRaw)
        users = ParseJson(usersRaw)
        if (type(users) = "roArray" or type(users) = "Array") and users.count() = 1
            firstUser = users[0]
            if isValid(firstUser) and isValidAndNotEmpty(firstUser.server)
                return firstUser.server
            end if
        end if
    end if

    return invalid
end function

function getAuthTokenFromRegistry() as dynamic
    authToken = getRuntimeContextValue("moonfin.authToken")
    if isValidAndNotEmpty(authToken)
        return authToken
    end if

    activeUserId = getActiveUserIdFromRegistry()
    if isValidAndNotEmpty(activeUserId)
        authToken = getRegistryValue(activeUserId, "token")
        if isValidAndNotEmpty(authToken)
            return authToken
        end if
    end if

    if isValid(m) and isChainValid(m, "global.session.user.authToken")
        authToken = chainLookupReturn(m, "global.session.user.authToken", invalid)
        if isValidAndNotEmpty(authToken)
            return authToken
        end if
    end if

    return invalid
end function

function get_url()
    serverURL = getServerUrlFromRegistry()
    if not isValidAndNotEmpty(serverURL) then return invalid

    serverURL = serverURL.toStr().trim()

    if serverURL.right(1) = "/"
        serverURL = serverURL.left(serverURL.len() - 1)
    end if

    if serverURL.left(7) <> "http://" and serverURL.left(8) <> "https://"
        serverURL = "http://" + serverURL
    end if

    return serverURL
end function

function getString(req)
    if req = invalid then return ""

    data = req.GetToString()
    return data
end function

function postString(req, data = "" as string)
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")
    req.AsyncPostFromString(data)
    resp = wait(30000, req.GetMessagePort())
    if type(resp) <> "roUrlEvent"
        return invalid
    end if

    return resp.getString()
end function

function buildAuthHeader() as string
    QUOTE = Chr(34)
    headerContext = getAuthHeaderContext()

    auth = serverAuthScheme(get_url() ?? "") + " Client=" + QUOTE + headerContext.appName + " Roku" + QUOTE
    auth = auth + ", Device=" + QUOTE + headerContext.deviceName + " (" + headerContext.deviceModel + ")" + QUOTE
    auth = auth + ", Version=" + QUOTE + headerContext.appVersion + QUOTE
    auth = auth + ", DeviceId=" + QUOTE + headerContext.deviceId + QUOTE
    if isValidAndNotEmpty(headerContext.authToken)
        auth = auth + ", Token=" + QUOTE + headerContext.authToken + QUOTE
    end if

    return auth
end function

function getAuthHeaderContext() as object
    context = {
        appName: getRuntimeContextValue("moonfin.appName"),
        appVersion: getRuntimeContextValue("moonfin.appVersion"),
        deviceName: getRuntimeContextValue("moonfin.deviceName"),
        deviceModel: getRuntimeContextValue("moonfin.deviceModel"),
        deviceId: getRuntimeContextValue("moonfin.deviceId"),
        authToken: invalid
    }

    applyGlobalIdentity(context)
    applyDeviceIdentity(context)

    fillIdentity(context, "appName", "Moonfin")
    fillIdentity(context, "appVersion", "0.0.0")
    fillIdentity(context, "deviceName", "Roku")
    fillIdentity(context, "deviceModel", "Roku")
    fillIdentity(context, "deviceId", "Roku")

    authToken = getAuthTokenFromRegistry()
    if isValidAndNotEmpty(authToken)
        context.authToken = authToken
    end if

    return context
end function

sub fillIdentity(context as object, field as string, value as dynamic)
    if isValidAndNotEmpty(context[field]) then return
    if isValidAndNotEmpty(value) then context[field] = value
end sub

function identityIsComplete(context as object) as boolean
    return isValidAndNotEmpty(context.appName) and isValidAndNotEmpty(context.appVersion) and isValidAndNotEmpty(context.deviceName) and isValidAndNotEmpty(context.deviceModel) and isValidAndNotEmpty(context.deviceId)
end function

' Every thread keeps its own GetGlobalAA, so what the main thread stored there is
' invisible to a task. Without this a task reports itself as a different device
' and gets a session of its own. The global node is shared by every thread
sub applyGlobalIdentity(context as object)
    if identityIsComplete(context) then return
    if not isValid(m) then return

    globalNode = m.global
    if not isValid(globalNode) then return

    app = globalNode.app
    if isValid(app)
        fillIdentity(context, "appName", app.name)
        fillIdentity(context, "appVersion", app.version)
    end if

    device = globalNode.device
    if not isValid(device) then return

    fillIdentity(context, "deviceName", device.name)
    fillIdentity(context, "deviceModel", device.model)
    fillIdentity(context, "deviceId", device.serverDeviceName)
end sub

' Anything still missing means the request went out before the globals were ready,
' so ask the box itself rather than sending a placeholder
sub applyDeviceIdentity(context as object)
    if identityIsComplete(context) then return

    appInfo = CreateObject("roAppInfo")
    if isValid(appInfo)
        fillIdentity(context, "appName", appInfo.GetTitle())
        fillIdentity(context, "appVersion", appInfo.GetVersion())
    end if

    deviceInfo = CreateObject("roDeviceInfo")
    if not isValid(deviceInfo) then return

    fillIdentity(context, "deviceName", deviceInfo.GetModelDisplayName())
    fillIdentity(context, "deviceName", deviceInfo.GetModel())
    fillIdentity(context, "deviceModel", deviceInfo.GetModel())
    fillIdentity(context, "deviceId", deviceInfo.GetChannelClientID())
end sub

' sets the certificate authority by file path on the passed node
sub setCertificateAuthority(request as object) as void
    request.setCertificatesFile("common:/certs/ca-bundle.crt")
end sub

' Takes and returns a roUrlTransfer object after adding a Jellyfin "Authorization" header
function authRequest(req as object) as object
    addServerAuthorization(req, buildAuthHeader())
    return req
end function

function authRequestForServer(req as object, serverData as object) as object
    addServerAuthorization(req, buildAuthHeaderForServer(serverData), serverData.serverUrl)
    return req
end function

function buildAuthHeaderForServer(serverData as object) as string
    QUOTE = Chr(34)
    headerContext = getAuthHeaderContext()

    auth = serverAuthScheme(serverData.serverUrl ?? "") + " Client=" + QUOTE + headerContext.appName + " Roku" + QUOTE
    auth = auth + ", Device=" + QUOTE + headerContext.deviceName + " (" + headerContext.deviceModel + ")" + QUOTE
    auth = auth + ", Version=" + QUOTE + headerContext.appVersion + QUOTE

    if isValidAndNotEmpty(serverData.userId)
        auth = auth + ", UserId=" + QUOTE + serverData.userId + QUOTE
    end if

    auth = auth + ", DeviceId=" + QUOTE + headerContext.deviceId + QUOTE

    if isValidAndNotEmpty(serverData.authToken)
        auth = auth + ", Token=" + QUOTE + serverData.authToken + QUOTE
    end if

    return auth
end function

function buildURLForServer(serverUrl as string, path as string, params = {} as object, userId = "" as string) as string
    if serverUrl = "" then return ""

    emby = isEmbyServer(serverUrl)
    if emby
        path = serverCompatiblePath(path, params, userId, true)
        params = serverCompatibleParams(params, true)
    end if

    full_url = buildServerURL(serverUrl, path, params)
    if full_url = "" then return ""

    if Instr(1, LCase(path), "/images/") > 0 then full_url = authenticatedResourceURL(full_url, serverUrl, params.LookupCI("api_key") ?? "")
    return full_url
end function

function APIRequestForServer(serverUrl as string, userId as string, authToken as string, url as string, params = {} as object) as dynamic
    full_url = buildURLForServer(serverUrl, url, params, userId)
    if full_url = "" then return invalid

    req = CreateObject("roUrlTransfer")
    if not isValid(req) then return invalid

    req.setUrl(full_url)

    serverData = {
        serverUrl: serverUrl,
        userId: userId,
        authToken: authToken
    }
    req.AddHeader("Accept", "application/json")
    addServerAuthorization(req, buildAuthHeaderForServer(serverData), serverData.serverUrl)

    if serverUrl.left(8) = "https://"
        setCertificateAuthority(req)
    end if

    return req
end function

function getServerInfoFromItem(item as object) as object
    if not isValid(item) then return invalid

    jsonData = item
    if isValid(item.json)
        jsonData = item.json
    end if

    if not isValid(jsonData._serverUrl) then return invalid
    if not isValid(jsonData._userId) then return invalid
    if not isValid(jsonData._authToken) then return invalid

    return {
        serverUrl: jsonData._serverUrl,
        userId: jsonData._userId,
        authToken: jsonData._authToken,
        serverId: jsonData._serverId,
        serverName: jsonData._serverName
    }
end function

function isMultiServerItem(item as object) as boolean
    itemServerData = getServerInfoFromItem(item)
    return isValid(itemServerData)
end function

' Bounded optional requests share cancellation/status handling. Regular library
' GETs retain their transport-managed timeout through getJson.
function requestResponse(req as object, method = "GET" as string, body = "" as string, timeoutMs = 30000 as integer, cancelNode = invalid as dynamic) as object
    if req = invalid then return { status: 0, data: invalid }
    if requestCanceled(cancelNode) then return { status: 0, data: invalid }
    port = CreateObject("roMessagePort")
    req.SetMessagePort(port)
    if method = "POST"
        started = req.AsyncPostFromString(body)
    else
        started = req.AsyncGetToString()
    end if
    if not started then return { status: 0, data: invalid }
    timer = CreateObject("roTimespan")
    while timer.TotalMilliseconds() < timeoutMs
        if requestCanceled(cancelNode) then exit while
        event = wait(100, port)
        if type(event) = "roUrlEvent"
            code = event.GetResponseCode()
            data = invalid
            if code >= 200 and code < 300 then data = ParseJson(event.GetString())
            return { status: code, data: data }
        end if
    end while
    req.AsyncCancel()
    return { status: 0, data: invalid }
end function

function requestCanceled(node as dynamic) as boolean
    if node = invalid then return false
    return node.cancelRequested = true
end function

function optionalJson(req as dynamic) as dynamic
    if req = invalid then return invalid
    return requestResponse(req).data
end function

' Older Emby releases can reject the Roku DeviceProfile. Retry only those
' server errors, never bad credentials, missing items, or a network timeout.
function postPlaybackInfo(req as object, body as object, emby as boolean) as dynamic
    if not emby then return postJson(req, FormatJson(body))
    req.AddHeader("Content-Type", "application/json")
    attempts = [body]
    withoutProfile = {}
    withoutProfile.Append(body)
    withoutProfile.Delete("DeviceProfile")
    attempts.Push(withoutProfile)
    attempts.Push({})
    for each payload in attempts
        response = requestResponse(req, "POST", FormatJson(payload))
        if response.status <> 400 and response.status <> 422 and response.status <> 500 then return response.data
    end for
    return invalid
end function

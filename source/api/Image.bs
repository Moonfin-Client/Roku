import "pkg:/source/api/sdk.bs"
import "pkg:/source/enums/ImageType.bs"

function ItemImages(id = "" as string, params = {} as object)
    if not isValidAndNotEmpty(id) then return []

    data = api.items.GetImages(id)
    if type(data) <> "roArray" then return invalid

    results = []
    for each item in data
        tmp = CreateObject("roSGNode", "ImageData")
        tmp.imagetype = item.imagetype
        tmp.size = item.size
        tmp.height = item.height
        tmp.width = item.width
        tmp.url = ImageURL(id, tmp.imagetype, params)
        results.push(tmp)
    end for
    return results
end function


function PosterImage(id as string, params = {} as object)
    if not isValidAndNotEmpty(id) then return invalid

    images = ItemImages(id, params)
    if not isValid(images) then return invalid
    primary_image = invalid

    for each image in images
        if isStringEqual(image.imagetype, ImageType.PRIMARY)
            primary_image = image
        else if isStringEqual(image.imagetype, ImageType.LOGO) and primary_image = invalid
            primary_image = image
        else if isStringEqual(image.imagetype, ImageType.THUMB) and primary_image = invalid
            primary_image = image
        end if
    end for

    return primary_image
end function

function ImageURL(id, version = "Primary", params = {})
    if not isValidAndNotEmpty(id) then return ""

    ' set defaults
    if params.maxHeight = invalid
        param = { "maxHeight": "384" }
        params.append(param)
    end if
    if params.maxWidth = invalid
        param = { "maxWidth": "196" }
        params.append(param)
    end if
    if params.quality = invalid
        param = { "quality": "90" }
        params.append(param)
    end if
    url = Substitute("Items/{0}/Images/{1}", id, version)
    return buildURL(url, params)
end function

' A chapter's image, or "" when the server has none for it. serverBase is the item's own server, or invalid for the active one
function chapterImageURL(itemId as string, index as integer, imageTag as dynamic, serverBase as dynamic, authToken as string) as string
    if not isValidAndNotEmpty(imageTag) then return ""
    path = "Items/" + itemId + "/Images/Chapter/" + index.toStr()
    params = { "maxWidth": 400, "tag": imageTag }
    if isValid(serverBase)
        if serverBase.right(1) = "/" then serverBase = serverBase.left(serverBase.len() - 1)
        if isEmbyServer(serverBase) then params.api_key = authToken
        return buildURLForServer(serverBase, path, params)
    end if
    url = buildURL(path, params)
    if url = invalid then return ""
    return url
end function

function UserImageURL(id, params = {})
    if not isValidAndNotEmpty(id) then return ""

    ' set defaults
    if params.maxHeight = invalid
        params.append({ "maxHeight": "300" })
    end if
    if params.maxWidth = invalid
        params.append({ "maxWidth": "300" })
    end if
    if params.quality = invalid
        params.append({ "quality": "90" })
    end if

    return buildURL(`Users/${id}/Images/Primary`, params)
end function

' Emby item metadata already contains image tags. Avoid the image-management
' endpoint, which may require additional permissions, on the detail load path.
function MetadataPosterImage(id as string, params = {} as object) as dynamic
    if isEmbyServer() then return invalid
    return PosterImage(id, params)
end function

function metadataPosterURL(item as dynamic) as string
    if type(item) <> "roAssociativeArray" then return ""
    id = item.Id ?? ""
    tag = chainLookupReturn(item, "ImageTags.Primary", "")
    if tag = "" and isValidAndNotEmpty(item.SeriesPrimaryImageTag)
        id = item.SeriesId ?? id
        tag = item.SeriesPrimaryImageTag
    end if
    if id = "" or tag = "" then return ""
    params = { tag: tag, maxWidth: 400, maxHeight: 400, quality: 90 }
    if isValidAndNotEmpty(item._serverUrl)
        if isEmbyServer(item._serverUrl) and isValidAndNotEmpty(item._authToken) then params.api_key = item._authToken
        return buildURLForServer(item._serverUrl, "Items/" + id + "/Images/Primary", params)
    end if
    return ImageURL(id, "Primary", params)
end function

import "pkg:/source/api/EmbyConnect.bs"
import "pkg:/source/utils/diagnostics.bs"
' needed for SignOut() and ServerInfo()
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"

function passwordLoginRequest(serverUrl as string, user as string, password as string) as object
    ' Login must not inherit an expired token or another server's session.
    header = buildAuthHeaderForServer({ serverUrl: serverUrl, userId: "", authToken: "" })
    headers = { "Content-Type": "application/json", "Authorization": header }
    if isEmbyServer(serverUrl)
        headers["X-Emby-Authorization"] = header
    end if
    url = buildURLForServer(serverUrl, "Users/AuthenticateByName", { format: "json" })
    return embyConnect.Request(url, "POST", FormatJson({ Username: user.Trim(), Pw: password }), headers)
end function

function validPasswordLogin(response as object) as boolean
    if response.status < 200 or response.status >= 300 then return false
    json = response.data
    if type(json) <> "roAssociativeArray" then return false
    if embyConnect.StringValue(json, ["AccessToken"]) = "" then return false
    return embyConnect.StringValue(json.User, ["Id"]) <> "" and embyConnect.StringValue(json.User, ["Name"]) <> ""
end function

' Jellyfin refuses a sign in with a 403 when the account can't be used right now, for instance
' outside the hours of its access schedule, and gives no reason beyond that. A wrong password is
' a 401, but the account is checked first, so such an account gets this for any password.
function signInRefusedMessage() as string
    return tr("This account can't sign in right now. It may be outside its allowed hours, locked or disabled. Try again later or ask an administrator.")
end function

function passwordLoginError(status as integer) as string
    if status = 401 or status = 403
        if isEmbyServer() then return tr("Emby server rejected the login. Use the local server account, or choose Emby Connect for your Emby account.")
        if status = 403 then return signInRefusedMessage()
        return tr("Username or password is incorrect, or access is denied.")
    end if
    if status = 0 then return tr("The server did not respond. Check the connection and try again.")
    if status = 404 then return tr("Login endpoint not found. Check the server URL and proxy path.")
    return tr("Login failed. Server response:") + " " + status.ToStr()
end function

function get_token(user as string, password as string)
    m.loginError = ""
    if isSiloServer() then return siloSignIn(user, password)
    response = passwordLoginRequest(get_url(), user, password)
    if not validPasswordLogin(response)
        m.loginError = passwordLoginError(response.status)
        return invalid
    end if
    userdata = CreateObject("roSGNode", "UserData")
    userdata.json = response.data
    userdata.callFunc("saveToRegistry")
    return userdata
end function

' Signs a Silo account in as its primary profile. Every profile of the household is saved as a user of
' the server, so the user picker lists them all
function siloSignIn(user as string, password as string) as dynamic
    return siloOpenedLogin(silo.SignIn(get_url(), user.Trim(), password))
end function

' Replaces the temporary password a Silo sign-in stopped on, then signs in as siloSignIn does
function siloChangePassword(newPassword as string) as dynamic
    m.loginError = silo.NewPasswordIssue(newPassword)
    if m.loginError <> "" then return invalid
    return siloOpenedLogin(silo.ChangeRequiredPassword(newPassword))
end function

function siloOpenedLogin(result as object) as dynamic
    if not result.ok
        m.loginError = result.message
        return invalid
    end if
    userdata = CreateObject("roSGNode", "UserData")
    userdata.json = result.data
    userdata.callFunc("saveToRegistry")
    saveSiloHousehold(result.data)
    return userdata
end function

' Each profile gets the login's token under its own id, like a user signed in on its own
sub saveSiloHousehold(answer as object)
    if type(answer.SiloUsers) <> "roArray" then return
    users = parseJson(get_setting("available_users", "[]"))
    if type(users) <> "roArray" then users = []
    serverUrl = m.global.session.server.url
    for each profile in answer.SiloUsers
        known = false
        for each saved in users
            if saved.id = profile.Id then known = true
        end for
        if not known then users.push({ id: profile.Id, username: profile.Name, server: serverUrl })
        if profile.Id <> answer.User.Id and should_save_credentials()
            registry_write("token", answer.AccessToken, profile.Id)
            registry_write("username", profile.Name, profile.Id)
            registry_write("serverId", m.global.session.server.id, profile.Id)
            registry_write("serverUrl", LCase(serverUrl), profile.Id)
        end if
    end for
    set_setting("available_users", formatJson(users))
end sub

function AboutMe(id = "" as string)
    if id = ""
        if m.global.session.user.id <> invalid
            id = m.global.session.user.id
        else
            return invalid
        end if
    end if

    url = Substitute("Users/{0}", id)
    resp = APIRequest(url)
    return getJson(resp)
end function

sub SignOut(deleteSavedEntry = true as boolean)
    diagnostics.Auth("Signed out")
    ' Leaving a Silo profile whose PIN is asked every time locks it again
    silo.ForgetUnrememberedPin(currentSessionUserId())
    m.global.queueManager.callFunc("clear")
    m.global.audioPlayer.control = "stop"

    if deleteSavedEntry
        endSiloLoginIfLast(currentSessionUserId())
        if isChainValid(m.global, "session.server.url") then forgetServerIdentity(m.global.session.server.url, currentSessionUserId())
        unset_user_setting("token")
        unset_user_setting("username")
    end if
    unset_setting("active_user")
    ' The group is left while the token still works
    m.global.syncPlayManager.callFunc("disable")
    session.user.Logout()

    ' Anime markers are keyed by the server's own ids, so they cant follow the user to
    ' another account or server
    if m.global.hasField("animeMarkerStore") then m.global.animeMarkerStore.callFunc("clearMarkers")

    ' The plugin's list of incomplete recordings belongs to that server and account too
    if m.global.hasField("incompleteRecordingStore") then m.global.incompleteRecordingStore.callFunc("clear")

    ' Which collections hold a title depends on who is asking, so the next account looks again
    if m.global.hasField("collectionOwners") then m.global.removeField("collectionOwners")

    ' The next account has its own Seerr region for streaming services
    if m.global.hasField("seerrUserSettings") then m.global.removeField("seerrUserSettings")

    m.global.sceneManager.currentUser = ""
    group = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(group) then group.optionsAvailable = false
end sub

' Points the session at a saved account so the next sign in picks it up without
' asking for a password again
sub SwitchToSavedUser(account as object)
    if not isValid(account) or not isValidAndNotEmpty(account.id) then return

    SignOut(false)

    if isValidAndNotEmpty(account.serverUrl)
        set_setting("server", account.serverUrl)
    end if

    ' Signing in decides whether Auto Sign In remembers them, so this only lasts for the run
    m.global.pendingUserSwitch = account.id
end sub

' Each signed in user gets its own registry section keyed by their id
sub DeleteUserRegistrySection(userId as string)
    endSiloLoginIfLast(userId)
    serverUrl = registry_read("serverUrl", userId)
    forgetServerIdentity(serverUrl, userId)
    registry_delete("token", userId)
    registry_delete("username", userId)
    registry_delete("serverId", userId)
    registry_delete("serverUrl", userId)
end sub

' Sign Out: a Silo profile signs its whole account out, whichever profile is in use, as in
' Moonfin Core. Anyone else signs only themselves out
sub SignOutCurrentUser()
    if isValid(silo.ProfileEntry(currentSessionUserId()))
        SignOutSiloAccount()
    else
        SignOut()
    end if
end sub

'' Signs the signed-in Silo profile's whole account out: every saved profile of it goes, and the
' login ends on Silo with the last one. Ported from Moonfin Core (signOutSiloAccount)
sub SignOutSiloAccount()
    userId = currentSessionUserId()
    for each id in siloHouseholdSiblings()
        ForgetSavedUser(id)
    end for
    ForgetSavedUser(userId)
    SignOut()
end sub

' Silo refused to renew the signed-in profile's login ("server|account"): every saved profile of
' the account goes, as in Moonfin Core, and the next sign in opens for the profile's name. False
' when it was another login, or the account signed in again before the news arrived (the ended
' login's tokens are gone, so a pair means a new one)
function SignOutEndedSiloLogin(login as string) as boolean
    userId = currentSessionUserId()
    entry = silo.ProfileEntry(userId)
    if not isValid(entry) or entry.server + "|" + entry.account <> login then return false
    if isValid(silo.LoadTokens(entry.server, entry.account)) then return false
    name = registry_read("username", userId) ?? ""
    for each id in siloHouseholdSiblings()
        ForgetSavedUser(id)
    end for
    ForgetSavedUser(userId)
    SignOut()
    m.siloSignInAgain = name
    return true
end function

' The name the sign in opens for after Silo ended the login, handed over once
function TakeSiloSignInAgain() as string
    name = m.siloSignInAgain ?? ""
    m.siloSignInAgain = invalid
    return name
end function

' The ids of the other saved profiles of the signed-in Silo profile's account, empty for anyone else
function siloHouseholdSiblings() as object
    ids = []
    userId = currentSessionUserId()
    entry = silo.ProfileEntry(userId)
    if not isValid(entry) then return ids
    for each account in AvailableUsers()
        other = silo.ProfileEntry(account.id)
        if account.id <> userId and isValid(other) and other.server = entry.server and other.account = entry.account then ids.push(account.id)
    end for
    return ids
end function

' Drops one saved account, leaving any others alone
sub ForgetSavedUser(userId as string)
    if not isValidAndNotEmpty(userId) then return

    DeleteUserRegistrySection(userId)

    remaining = []
    for each user in AvailableUsers()
        if not isStringEqual(user.id, userId) then remaining.push(user)
    end for
    set_setting("available_users", FormatJson(remaining))
end sub

sub SignOutAllUsers()
    for each user in AvailableUsers()
        DeleteUserRegistrySection(user.id)
    end for
    set_setting("available_users", "[]")

    SignOut()
end sub

function AvailableUsers()
    users = parseJson(get_setting("available_users", "[]"))
    return users
end function

function ServerInfo()
    serverUrl = get_url() ?? ""
    if registry_read(serverIdentityKey(serverUrl), "ServerTypes") = "silo"
        info = siloServerInfo(serverUrl)
        if isValid(info) then return info
    end if

    url = "System/Info/Public"
    req = APIRequest(url)
    if req = invalid then return { "Error": true, "ErrorMessage": "Unknown" }

    ' A Plex server is asked through the Plex bridge, which answers from /identity
    plex = plexAnswer(req, "GET", "", 15000)
    if plex <> invalid
        if type(plex.data) <> "roAssociativeArray" then return { "Error": true, "ErrorCode": plex.status, "ErrorMessage": "Doesn't appear to be a Plex server" }
        info = plex.data
        info.Error = false
        return info
    end if

    req.setMessagePort(CreateObject("roMessagePort"))
    req.AsyncGetToString()

    ' wait 15 seconds for a server response
    resp = wait(35000, req.GetMessagePort())

    ' handle unknown errors
    if type(resp) <> "roUrlEvent"
        return { "Error": true, "ErrorMessage": "Unknown" }
    end if

    ' check for a location redirect header in the response
    headers = resp.GetResponseHeaders()
    if headers <> invalid and headers.location <> invalid

        ' only follow redirect if it the API Endpoint path is the same (/System/Info/Public)
        ' set the server to new location and try again
        if right(headers.location, 19) = "/System/Info/Public"
            set_setting("server", left(headers.location, len(headers.location) - 19))
            isConnected = session.server.UpdateURL(left(headers.location, len(headers.location) - 19))
            if isConnected
                info = ServerInfo()
                if info.Error
                    info.UpdatedUrl = left(headers.location, len(headers.location) - 19)
                    info.ErrorMessage = info.ErrorMessage + " (Note: Server redirected us to " + info.UpdatedUrl + ")"
                end if
                return info
            end if
        end if
    end if

    ' handle any non 200 responses, returning the error code and message
    if resp.GetResponseCode() <> 200
        return { "Error": true, "ErrorCode": resp.GetResponseCode(), "ErrorMessage": resp.GetFailureReason() }
    end if

    ' return the parsed response string
    responseString = resp.GetString()
    ' A Silo's web page isn't JSON, and parsing it prints an error to the console
    if responseString <> invalid and responseString.Trim().Left(1) = "{"
        result = ParseJson(responseString)
        if type(result) = "roAssociativeArray" and detectServerType(result) <> ""
            result.Error = false
            return result
        end if
    end if

    ' A Silo's web app answers the Jellyfin probe with a page
    info = siloServerInfo(serverUrl)
    if isValid(info) then return info

    ' otherwise return error message
    return { "Error": true, "ErrorMessage": "Does not appear to be a Jellyfin, Emby or Silo Server" }

end function

' Silo's public info as Jellyfin's, or invalid when no Silo answers
function siloServerInfo(serverUrl as string) as dynamic
    info = silo.Probe(serverUrl)
    if info = invalid then return invalid
    if info.SiloUnsupported = true
        if info.ServerIsNewer then return { "Error": true, "ErrorMessage": "This Silo server needs a newer version of Moonfin" }
        return { "Error": true, "ErrorMessage": "This Silo server is too old for this version of Moonfin" }
    end if
    info.Error = false
    return info
end function

function GetPublicUsers()
    url = "Users/Public"
    resp = APIRequest(url)
    return getJson(resp)
end function

sub LoadUserAbilities()
    canRecord = (m.global.session.user.Policy.EnableLiveTvManagement = true)
    canDelete = (m.global.session.user.Policy.EnableContentDeletion = true)

    tmpSettings = m.global.session.user.settings
    tmpSettings["livetv.canrecord"] = canRecord
    tmpSettings["content.candelete"] = canDelete
    session.user.Update("settings", tmpSettings)

    userId = m.global.session.user.id
    if userId <> invalid
        canRecordStr = canRecord ? "true" : "false"
        canDeleteStr = canDelete ? "true" : "false"
        reg = CreateObject("roRegistrySection", userId)
        reg.write("livetv.canrecord", canRecordStr)
        reg.write("content.candelete", canDeleteStr)
        reg.flush()
    end if
end sub

function initQuickConnect()
    if isEmbyServer() then return invalid
    if isSiloServer() then return silo.DeviceStart(get_url())
    resp = APIRequest("QuickConnect/Initiate")
    jsonResponse = postJson(resp)
    if jsonResponse = invalid
        return invalid
    end if

    if jsonResponse.Secret = invalid
        return invalid
    end if

    return jsonResponse
end function

function checkQuickConnect(secret)
    if isSiloServer() then return silo.DevicePoll(get_url(), secret)
    url = Substitute("QuickConnect/Connect?secret={0}", secret)
    resp = APIRequest(url)
    jsonResponse = getJson(resp)
    if jsonResponse = invalid
        return false
    end if

    if jsonResponse.Authenticated <> invalid and jsonResponse.Authenticated = true
        return true
    end if

    return false
end function

' Exchanges an approved Quick Connect secret for a session. refused is true when the server turned
' the account away, which it does with a 403 and nothing in the body.
function AuthenticateViaQuickConnect(secret) as object
    serverUrl = get_url()
    if isSiloServer(serverUrl)
        result = silo.DeviceSignIn(serverUrl, secret)
        if not result.ok then return { ok: false, refused: result.status = 403 }
        userdata = CreateObject("roSGNode", "UserData")
        userdata.json = result.data
        session.user.Update("id", result.data.User.Id)
        session.user.Update("authToken", result.data.AccessToken)
        userdata.callFunc("saveToRegistry")
        saveSiloHousehold(result.data)
        return { ok: true, refused: false }
    end if
    header = buildAuthHeaderForServer({ serverUrl: serverUrl, userId: "", authToken: "" })
    headers = { "Content-Type": "application/json", "Authorization": header }
    if isEmbyServer(serverUrl) then headers["X-Emby-Authorization"] = header
    url = buildURLForServer(serverUrl, "Users/AuthenticateWithQuickConnect", {})
    response = embyConnect.Request(url, "POST", FormatJson({ secret: secret }), headers)
    if not validPasswordLogin(response) then return { ok: false, refused: response.status = 403 }

    jsonResponse = response.data
    userdata = CreateObject("roSGNode", "UserData")
    userdata.json = jsonResponse
    session.user.Update("id", jsonResponse.User.Id)
    session.user.Update("authToken", jsonResponse.AccessToken)
    userdata.callFunc("saveToRegistry")
    return { ok: true, refused: false }
end function

' A Silo login is shared by the account's profiles, so it ends on the server only when the last
' saved profile that uses it signs out
sub endSiloLoginIfLast(userId as string)
    entry = silo.ProfileEntry(userId)
    if not isValid(entry) then return
    silo.ForgetProfile(userId)
    for each account in AvailableUsers()
        if account.id <> userId and isValidAndNotEmpty(registry_read("token", account.id))
            other = silo.ProfileEntry(account.id)
            if isValid(other) and other.server = entry.server and other.account = entry.account then return
        end if
    end for
    silo.EndLogin(entry.server, entry.account)
end sub

' True when the signed-in Silo profile shares its login with another saved profile
function siloHouseholdToPick() as boolean
    userId = currentSessionUserId()
    entry = silo.ProfileEntry(userId)
    if not isValid(entry) then return false
    for each account in AvailableUsers()
        if account.id <> userId and isValidAndNotEmpty(registry_read("token", account.id))
            other = silo.ProfileEntry(account.id)
            if isValid(other) and other.server = entry.server and other.account = entry.account then return true
        end if
    end for
    return false
end function

sub forgetServerIdentity(serverUrl as dynamic, removedUserId as string)
    if not isValidAndNotEmpty(serverUrl) then return
    key = serverIdentityKey(serverUrl)
    for each account in AvailableUsers()
        if account.id <> removedUserId
            savedUrl = registry_read("serverUrl", account.id)
            if isValidAndNotEmpty(savedUrl) and isValidAndNotEmpty(registry_read("token", account.id))
                if serverIdentityKey(savedUrl) = key then return
            end if
        end if
    end for
    registry_delete(key, "ServerTypes")
end sub

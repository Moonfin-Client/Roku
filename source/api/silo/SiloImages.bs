import "pkg:/source/api/silo/SiloSession.bs"
import "pkg:/source/utils/misc.bs"

' Artwork on a Silo server. Silo has no image address that can be built from an item id: each
' picture comes signed, inside the item that shows it. The mapper hands the picture's own address
' over as the item's image tag, and an image URL asked with that tag is the picture. Callers that
' ask without a tag find the picture in this thread's record of what it mapped (Smart-TV's
' utils/siloUrls.js keeps the same record, for every caller).
namespace silo
    const MAX_IMAGES = 4000

    ' Records a picture of itemId and answers its tag, or "" when there's no picture
    function RegisterImage(server as string, itemId as string, imageType as string, url as dynamic, index = 0 as integer) as string
        if not isString(url) then return ""
        url = url.Trim()
        if url = "" or itemId = "" then return ""
        if type(m.siloImages) <> "roAssociativeArray" or m.siloImages.Count() > silo.MAX_IMAGES
            m.siloImages = {}
            m.siloCompleteBackdrops = {}
        end if
        key = silo.ImageKey(server, itemId, imageType, index)
        if m.siloImages[key] <> url
            m.siloImages[key] = url
            ' Published for the other threads with the next flush
            if type(m.siloImagesByItem) <> "roAssociativeArray" then m.siloImagesByItem = {}
            if m.siloImagesByItem.Count() > silo.MAX_IMAGES
                ' Publish the queued fields before the record starts over
                silo.FlushImages()
                m.siloImagesByItem = {}
            end if
            if type(m.siloImagesPending) <> "roAssociativeArray" then m.siloImagesPending = {}
            field = silo.ImageField(server, itemId, imageType)
            pictures = m.siloImagesByItem[field]
            if type(pictures) <> "roAssociativeArray"
                pictures = {}
                m.siloImagesByItem[field] = pictures
            end if
            pictures[key] = url
            m.siloImagesPending[field] = true
        end if
        return url
    end function

    ' Screens build many picture addresses from an item id alone, on the render thread, which
    ' mapped none of them. So what a task maps is also kept on one node of the global node, a field
    ' per item and picture type, written in one go after each answer. A thread replaces a whole field,
    ' so one that recorded only a series' backdrop doesn't drop the logo another thread recorded. The
    ' node is kept per thread, since each read of the global node from a task waits for the render thread
    function ImageStore() as dynamic
        if type(m.siloImageStore) = "roSGNode" then return m.siloImageStore
        if type(m.global) <> "roSGNode" then return invalid
        if not m.global.hasField("siloImageStore") then m.global.addFields({ siloImageStore: CreateObject("roSGNode", "Node") })
        m.siloImageStore = m.global.siloImageStore
        return m.siloImageStore
    end function

    ' Two servers can use the same item ids, so the server is part of the name
    function ImageField(server as string, itemId as string, imageType as string) as string
        return "i_" + CreateObject("roRegex", "[^A-Za-z0-9_]", "").ReplaceAll(silo.ServerKey(server) + "_" + itemId, "_") + "_" + LCase(imageType)
    end function

    sub FlushImages()
        if type(m.siloImagesPending) <> "roAssociativeArray" or m.siloImagesPending.Count() = 0 then return
        store = silo.ImageStore()
        if store = invalid then return
        fields = {}
        for each field in m.siloImagesPending
            ' A field queued before this thread's record started over has nothing left to publish
            pictures = m.siloImagesByItem[field]
            if type(pictures) = "roAssociativeArray"
                existing = store.getField(field)
                if type(existing) = "roAssociativeArray" and existing["__complete"] = true and pictures["__complete"] <> true
                    ' Preserve a complete shared backdrop list when another task only mapped a partial card
                    merged = {}
                    for each ek in existing
                        merged[ek] = existing[ek]
                    end for
                    for each pk in pictures
                        if pk <> "__complete" and existing.DoesExist(pk)
                            merged[pk] = pictures[pk]
                        end if
                    end for
                    fields[field] = merged
                else
                    fields[field] = pictures
                end if
            end if
        end for
        m.siloImagesPending = {}
        if fields.Count() > 0 then store.update(fields, true)
    end sub

    ' The picture recorded for itemId in this thread, or ""
    function ImageFor(server as string, itemId as string, imageType as string, index = 0 as integer) as string
        key = silo.ImageKey(server, itemId, imageType, index)
        if type(m.siloImages) = "roAssociativeArray"
            url = m.siloImages[key]
            if isString(url) then return url
        end if
        return ""
    end function

    function CompleteBackdropsKey(server as string, itemId as string) as string
        return silo.ServerKey(server) + "|" + itemId
    end function

    function HasCompleteBackdrops(server as string, itemId as string) as boolean
        if type(m.siloCompleteBackdrops) = "roAssociativeArray"
            if m.siloCompleteBackdrops[silo.CompleteBackdropsKey(server, itemId)] = true then return true
        end if
        store = silo.ImageStore()
        if store <> invalid
            pictures = store.getField(silo.ImageField(server, itemId, "Backdrop"))
            if type(pictures) = "roAssociativeArray" and pictures["__complete"] = true then return true
        end if
        return false
    end function

    ' Replaces borrowed episode-fallback backdrop slots without marking the series complete.
    sub RegisterBorrowedBackdrops(server as string, itemId as string, urls as object)
        if itemId = "" or type(urls) <> "roArray" or urls.count() = 0 then return
        index = 0
        for each url in urls
            tag = silo.RegisterImage(server, itemId, "Backdrop", url, index)
            if tag <> "" then index++
        end for
        silo.TrimBackdropsFrom(server, itemId, index)
    end sub

    sub TrimBackdropsFrom(server as string, itemId as string, startIndex as integer)
        if type(m.siloImages) <> "roAssociativeArray" then return
        field = silo.ImageField(server, itemId, "Backdrop")
        pictures = invalid
        if type(m.siloImagesByItem) = "roAssociativeArray"
            pictures = m.siloImagesByItem[field]
        end if
        trimIdx = startIndex
        while true
            key = silo.ImageKey(server, itemId, "Backdrop", trimIdx)
            if not m.siloImages.DoesExist(key) then exit while
            m.siloImages.Delete(key)
            if type(pictures) = "roAssociativeArray" and pictures.DoesExist(key)
                pictures.Delete(key)
                if type(m.siloImagesPending) <> "roAssociativeArray" then m.siloImagesPending = {}
                m.siloImagesPending[field] = true
            end if
            trimIdx++
        end while
    end sub

    ' Replaces an item's backdrop list with its authoritative set, removing any
    ' trailing indices previously seeded by episode fallback, and marks it complete
    ' both locally and in the shared cross-thread store.
    function ReplaceBackdrops(server as string, itemId as string, urls as object) as object
        tags = []
        if itemId = "" or type(urls) <> "roArray" then return tags

        index = 0
        for each url in urls
            tag = silo.RegisterImage(server, itemId, "Backdrop", url, index)
            if tag <> ""
                tags.push(tag)
                index++
            end if
        end for

        silo.TrimBackdropsFrom(server, itemId, tags.count())

        if type(m.siloCompleteBackdrops) <> "roAssociativeArray" then m.siloCompleteBackdrops = {}
        cKey = silo.CompleteBackdropsKey(server, itemId)
        field = silo.ImageField(server, itemId, "Backdrop")
        if tags.count() > 0
            m.siloCompleteBackdrops[cKey] = true
            if type(m.siloImagesByItem) = "roAssociativeArray" and type(m.siloImagesByItem[field]) = "roAssociativeArray"
                m.siloImagesByItem[field]["__complete"] = true
                if type(m.siloImagesPending) <> "roAssociativeArray" then m.siloImagesPending = {}
                m.siloImagesPending[field] = true
            end if
        else
            m.siloCompleteBackdrops.Delete(cKey)
        end if

        return tags
    end function

    ' A picture another thread mapped
    function SharedImageFor(server as string, itemId as string, imageType as string, index = 0 as integer) as string
        store = silo.ImageStore()
        if store = invalid then return ""
        pictures = store.getField(silo.ImageField(server, itemId, imageType))
        if type(pictures) <> "roAssociativeArray" then return ""
        url = pictures[silo.ImageKey(server, itemId, imageType, index)]
        if isString(url) then return url
        return ""
    end function

    function ImageKey(server as string, itemId as string, imageType as string, index as integer) as string
        return silo.ServerKey(server) + "|" + itemId + "|" + LCase(imageType) + "|" + index.ToStr()
    end function

    ' A picture address as a full URL on server
    function ResolveUrl(server as string, url as string) as string
        if url = "" then return ""
        lower = LCase(url)
        if lower.Left(7) = "http://" or lower.Left(8) = "https://" then return url
        if url.Left(2) = "//"
            if LCase(server).Left(8) = "https://" then return "https:" + url
            return "http:" + url
        end if
        base = server
        while base.Right(1) = "/"
            base = base.Left(base.Len() - 1)
        end while
        if url.Left(1) = "/" then return base + url
        return base + "/" + url
    end function

    ' A Roku can't draw SVG, so a DiceBear avatar is asked for as a PNG. It's asked for round too, as
    ' a MaskGroup doesn't clip on Rokus without OpenGL
    function DrawableAvatar(url as string) as string
        prefix = "https://api.dicebear.com/"
        if LCase(url).Left(prefix.Len()) <> prefix then return url
        parts = url.Split("?")
        path = parts[0]
        if LCase(path).Right(4) <> "/svg" then return url
        query = ["radius=50"]
        if parts.Count() > 1
            for each pair in parts[1].Split("&")
                if pair <> "" and LCase(pair.Split("=")[0]) <> "radius" then query.Push(pair)
            end for
        end if
        return path.Left(path.Len() - 4) + "/png?" + query.Join("&")
    end function

    ' The Silo picture a Jellyfin image path names, or "" for none. Size options are ignored: Silo sizes
    ' a picture when the item is read, and a signed address can't be resized
    function ImageURL(server as string, path as string, params as dynamic) as string
        segments = []
        for each segment in path.Split("?")[0].Split("/")
            if segment <> "" then segments.Push(segment)
        end for
        if segments.Count() < 4 then return ""
        kind = LCase(segments[0])
        if LCase(segments[2]) <> "images" then return ""
        tag = ""
        if type(params) = "roAssociativeArray" then tag = params.LookupCI("tag") ?? ""
        if isString(tag) and tag <> "" and (tag.Left(1) = "/" or LCase(tag).Left(4) = "http") then return silo.ResolveUrl(server, tag)

        if kind = "users"
            entry = silo.ProfileEntry(segments[1])
            if isValid(entry) and isValidAndNotEmpty(entry.avatar) then return silo.ResolveUrl(server, silo.DrawableAvatar(entry.avatar))
            return ""
        end if
        if kind <> "items" then return ""
        index = 0
        if segments.Count() > 4 then index = segments[4].ToInt()
        found = silo.ImageFor(server, segments[1], segments[3], index)
        if found = "" then found = silo.SharedImageFor(server, segments[1], segments[3], index)
        url = silo.ResolveUrl(server, found)
        ' A picture asked for without its tag, on a thread that didn't map the item, can't be found.
        ' Said once per image type, so the caller that needs a tag shows up in the console
        if url = ""
            if type(m.siloImageMisses) <> "roAssociativeArray" then m.siloImageMisses = {}
            if not m.siloImageMisses.DoesExist(segments[3])
                m.siloImageMisses[segments[3]] = true
                print "[Moonfin network] WARN: Silo image without a tag: " + segments[3] + " of " + segments[1]
            end if
        end if
        return url
    end function
end namespace

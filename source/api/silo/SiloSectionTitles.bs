            "home.section.topGenre": tr("Top %1"),
            "home.section.topPicksToday": tr("Top Picks Today"),
            "home.section.topRated": tr("Top Rated"),
            "home.section.topRatedMovies": tr("Top Rated Movies"),
            "home.section.topRatedTv": tr("Top Rated TV"),
            "home.section.trendingOnServer": tr("Trending on Server"),
            "home.section.trendingThisWeek": tr("Trending This Week")
        }
    end function

    function SectionTitleArgs() as object
        return {
            "home.section.becauseYouEnjoy": "genres",
            "home.section.becauseYouWatchedTitle": "title",
            "home.section.recentlyAddedIn": "library",
            "home.section.recentlyReleasedEpisodesIn": "library",
            "home.section.recentlyReleasedIn": "library",
            "home.section.topGenre": "genre"
        }
    end function

    ' A section's title in the app's language, or Silo's own title for a renamed row, a key this
    ' app doesn't know, or a key without the value its placeholder needs
    function SectionTitle(section as object, strings = invalid as dynamic, argNames = invalid as dynamic) as string
        if not isValidAndNotEmpty(section.titleKey) then return section.title
        if strings = invalid then strings = silo.SectionTitleStrings()
        if argNames = invalid then argNames = silo.SectionTitleArgs()
        text = strings[section.titleKey]
        if not isString(text) then return section.title
        argName = argNames[section.titleKey]
        if not isString(argName) then return text
        value = invalid
        if type(section.titleArgs) = "roAssociativeArray" then value = section.titleArgs[argName]
        if not isString(value) then return section.title
        return text.Replace("%1", value)
    end function
end namespace

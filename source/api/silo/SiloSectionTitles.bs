import "pkg:/source/utils/misc.bs"

' Silo's own home rows in the app's language. Silo sends title_key (and title_args) with a section
' while its title is the server's own, so a row the viewer renamed keeps the name it was given
namespace silo
    ' Every title key Silo sends for a home row, as this app's string. A key with a placeholder
    ' fills %1 with the title_args value SectionTitleArgs names
    function SectionTitleStrings() as object
        return {
            "home.section.becauseYouEnjoy": tr("Because you enjoy %1"),
            "home.section.becauseYouWatched": tr("Because You Watched"),
            "home.section.becauseYouWatchedTitle": tr("Because You Watched %1"),
            "home.section.continueListening": tr("Continue Listening"),
            "home.section.continueReading": tr("Continue Reading"),
            "home.section.continueWatching": tr("Continue Watching"),
            "home.section.forYou": tr("For You"),
            "home.section.hiddenGems": tr("Hidden Gems"),
            "home.section.highlyRatedInLibrary": tr("Highly Rated in Your Library"),
            "home.section.nextInYourSeries": tr("Next in Your Series"),
            "home.section.nextUp": tr("Next Up"),
            "home.section.pickedFromYourHistory": tr("Picked from your history"),
            "home.section.popularOnServer": tr("Popular on This Server"),
            "home.section.profilesLikeYouEnjoyed": tr("Profiles Like You Enjoyed"),
            "home.section.randomPicks": tr("Random Picks"),
            "home.section.recentlyAdded": tr("Recently Added"),
            "home.section.recentlyAddedAudiobooks": tr("Recently Added Audiobooks"),
            "home.section.recentlyAddedEbooks": tr("Recently Added Ebooks"),
            "home.section.recentlyAddedIn": tr("Recently Added in %1"),
            "home.section.recentlyAddedManga": tr("Recently Added Manga"),
            "home.section.recentlyAddedMovies": tr("Recently Added Movies"),
            "home.section.recentlyAddedTv": tr("Recently Added TV"),
            "home.section.recentlyReleased": tr("Recently Released"),
            "home.section.recentlyReleasedAudiobooks": tr("Recently Released Audiobooks"),
            "home.section.recentlyReleasedEbooks": tr("Recently Released Ebooks"),
            "home.section.recentlyReleasedEpisodes": tr("Recently Released Episodes"),
            "home.section.recentlyReleasedEpisodesIn": tr("Recently Released Episodes in %1"),
            "home.section.recentlyReleasedIn": tr("Recently Released in %1"),
            "home.section.recentlyReleasedManga": tr("Recently Released Manga"),
            "home.section.recentlyReleasedMovies": tr("Recently Released Movies"),
            "home.section.recommendedForYou": tr("Recommended for You"),
            "home.section.returningShows": tr("Returning Shows"),
            "home.section.seasonal.christmas.classics": tr("Christmas Classics"),
            "home.section.seasonal.christmas.comedies": tr("Christmas Comedies"),
            "home.section.seasonal.christmas.family": tr("Family Christmas"),
            "home.section.seasonal.christmas.favorites": tr("Christmas Favorites"),
            "home.section.seasonal.christmas.hallmark": tr("Hallmark Christmas"),
            "home.section.seasonal.christmas.romcoms": tr("Christmas Rom-Coms"),
            "home.section.seasonal.easter.faith": tr("Easter Stories"),
            "home.section.seasonal.easter.family": tr("Easter Movies"),
            "home.section.seasonal.familyMovieNight.favorites": tr("Family Favorites"),
            "home.section.seasonal.familyMovieNight.liveAction": tr("Family Movie Night"),
            "home.section.seasonal.familyMovieNight.new": tr("Family Movie Night"),
            "home.section.seasonal.halloween.animated": tr("Animated Halloween"),
            "home.section.seasonal.halloween.family": tr("Family Halloween"),
            "home.section.seasonal.halloween.favorites": tr("Halloween Favorites"),
            "home.section.seasonal.halloween.horror": tr("Halloween Horror"),
            "home.section.seasonal.halloween.tv": tr("Halloween TV"),
            "home.section.seasonal.newYear.favorites": tr("New Year's Movies"),
            "home.section.seasonal.saturdayMorning.cartoons": tr("Saturday Morning Cartoons"),
            "home.section.seasonal.saturdayMorning.modern": tr("Saturday Morning Favorites"),
            "home.section.seasonal.saturdayMorning.nineties": tr("90s Saturday Mornings"),
            "home.section.seasonal.stPatricks.irishFilm": tr("Irish Film"),
            "home.section.seasonal.stPatricks.irishTv": tr("Irish TV"),
            "home.section.seasonal.summer.blockbusters": tr("Summer Blockbusters"),
            "home.section.seasonal.summer.classicSummer": tr("Classic Summer Movies"),
            "home.section.seasonal.summer.nostalgia": tr("Summer Nostalgia"),
            "home.section.seasonal.summerBlockbuster.blockbusters": tr("Summer Blockbusters"),
            "home.section.seasonal.summerBlockbuster.classicSummer": tr("Classic Summer Movies"),
            "home.section.seasonal.summerBlockbuster.nostalgia": tr("Summer Nostalgia"),
            "home.section.seasonal.thanksgiving.favorites": tr("Thanksgiving Movies"),
            "home.section.seasonal.thanksgiving.feelGood": tr("Feel-Good Favorites"),
            "home.section.seasonal.valentines.favorites": tr("Valentine's Favorites"),
            "home.section.seasonal.valentines.loveStories": tr("Classic Love Stories"),
            "home.section.seasonal.valentines.romanticDramas": tr("Romantic Dramas"),

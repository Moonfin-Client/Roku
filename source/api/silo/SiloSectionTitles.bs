import "pkg:/source/utils/misc.bs"

' Silo's own home rows in the app's language. Silo sends title_key (and title_args) with a section
' while its title is the server's own, so a row the viewer renamed keeps the name it was given
namespace silo
    ' The title keys a row can carry on Silo's home layout, as this app's strings, with %1 the row's
    ' library. Seasonal and recommendation headings only get their keys when a row's cards are read,
    ' and Home doesn't take its titles from there
    function SectionTitleStrings() as object
        return {
            "home.section.becauseYouWatched": tr("Because You Watched"),
            "home.section.continueListening": tr("Continue Listening"),
            "home.section.continueReading": tr("Continue Reading"),
            "home.section.hiddenGems": tr("Hidden Gems"),
            "home.section.nextInYourSeries": tr("Next in Your Series"),
            "home.section.profilesLikeYouEnjoyed": tr("Profiles Like You Enjoyed"),
            "home.section.randomPicks": tr("Random Picks"),
            "home.section.recentlyAdded": tr("Recently Added"),
            "home.section.recentlyAddedAudiobooks": tr("Recently Added Audiobooks"),
            "home.section.recentlyAddedEbooks": tr("Recently Added Ebooks"),
            "home.section.recentlyAddedIn": tr("Recently Added in %1"),
            "home.section.recentlyAddedManga": tr("Recently Added Manga"),
            "home.section.recentlyAddedMovies": tr("Recently Added Movies"),
            "home.section.recentlyAddedTv": tr("Recently Added TV"),
            "home.section.recentlyReleased": tr("Recently Released"),
            "home.section.recentlyReleasedAudiobooks": tr("Recently Released Audiobooks"),
            "home.section.recentlyReleasedEbooks": tr("Recently Released Ebooks"),
            "home.section.recentlyReleasedEpisodes": tr("Recently Released Episodes"),
            "home.section.recentlyReleasedEpisodesIn": tr("Recently Released Episodes in %1"),
            "home.section.recentlyReleasedIn": tr("Recently Released in %1"),
            "home.section.recentlyReleasedManga": tr("Recently Released Manga"),
            "home.section.recentlyReleasedMovies": tr("Recently Released Movies"),
            "home.section.recommendedForYou": tr("Recommended for You"),
            "home.section.returningShows": tr("Returning Shows"),
            "home.section.seasonalPicks": tr("Seasonal Picks"),
            "home.section.topPicksToday": tr("Top Picks Today"),
            "home.section.topRated": tr("Top Rated"),
            "home.section.topRatedMovies": tr("Top Rated Movies"),
            "home.section.topRatedTv": tr("Top Rated TV"),
            "home.section.trendingOnServer": tr("Trending on Server"),
            "home.section.trendingThisWeek": tr("Trending This Week")
        }
    end function

    ' A section's title in the app's language, or Silo's own title for a renamed row, a key this
    ' app doesn't know, or a key without the library its placeholder needs
    function SectionTitle(section as object, strings = invalid as dynamic) as string
        if not isString(section.titleKey) or section.titleKey = "" then return section.title
        if strings = invalid then strings = silo.SectionTitleStrings()
        text = strings[section.titleKey]
        if not isString(text) then return section.title
        if text.InStr("%1") < 0 then return text
        library = invalid
        if type(section.titleArgs) = "roAssociativeArray" then library = section.titleArgs.library
        if not isString(library) then return section.title
        return text.Replace("%1", library)
    end function
end namespace

import "pkg:/source/utils/misc.bs"

' The card menu runs on the render thread and hands over what only this thread can do: opening a
' series, and the entries the library item handler runs
sub onItemMenuRequestEvent(msg)
    request = msg.getData()
    if type(request) <> "roAssociativeArray" then return

    if isStringEqual(request.action, "goToSeries")
        if not isValidAndNotEmpty(request.seriesId) then return
        CreateSeriesDetailsGroup(request.seriesId, request.serverData)
        return
    end if

    if isStringEqual(request.action, "libraryItem")
        if not isString(request.label) or not isValidAndNotEmpty(request.itemId) then return
        params = request.params
        if type(params) <> "roAssociativeArray" then params = {}
        processLibraryItemPopup(request.label, request.itemId, params)
    end if
end sub

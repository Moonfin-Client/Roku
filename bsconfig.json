{
  "files": [
    "manifest",
    "source/**/*.*",
    "components/**/*.*",
    "images/**/*.*",
    "!images/readme/**/*",
    "locale/**/*.*",
    "settings/**/*.*",
    "fonts/**/*.*",
    "sounds/**/*.*",
    "!**/*.svg",
    "!components/qrCode/README.md"
  ],
  "plugins": [
    "@rokucommunity/bslint"
  ],
  "diagnosticFilters": [
    "node_modules/**/*",
    "**/roku_modules/**/*",
    "components/qrCode/**/*"
  ],
  "sourceMap": true,
  "autoImportComponentScript": true,
  "stagingDir": "build/staging",
  "retainStagingDir": true
}
{
  "name": "moonfin",
  "type": "module",
  "version": "2.0.0",
  "description": "Moonfin - Roku Client for Jellyfin",
  "dependencies": {
    "@rokucommunity/bslib": "0.1.1"
  },
  "devDependencies": {
    "@rokucommunity/bslint": "0.8.38",
    "brighterscript": "0.70.3",
    "brighterscript-formatter": "1.7.19",
    "brs": "0.45.0",
    "rimraf": "6.1.3",
    "roku-deploy": "3.16.1"
  },
  "scripts": {
    "build": "npx rimraf build/ out/ && npx bsc --project bsconfig.json --out-file ./out/moonfin-roku-v$(node -p \"require('./package.json').version\").zip",
    "lint": "npx bsc --project bsconfig.json --create-package false --copy-to-staging false",
    "format": "npx bsfmt --write",
    "test": "node test/server-compatibility.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Moonfin-Client/Roku.git"
  },
  "keywords": [
    "jellyfin",
    "roku",
    "music",
    "movies"
  ],
  "author": "Moonfin",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/Moonfin-Client/Roku.git"
  },
  "homepage": "https://github.com/Moonfin-Client/Roku"
}

import "pkg:/components/calendar/calendarHost.bs"
import "pkg:/source/utils/misc.bs"

const HERO_HEIGHT = 701
const INFO_WIDTH = 935
const CARD_GAP = 23

sub init()
    m.top.focusable = true
    m.page = m.top.findNode("page")
    m.heroMask = m.top.findNode("heroMask")
    m.heroArt = m.top.findNode("heroArt")
    m.heroScrim = m.top.findNode("heroScrim")
    m.heroInfo = m.top.findNode("heroInfo")
    m.kicker = m.top.findNode("kicker")
    m.heroTitle = m.top.findNode("heroTitle")
    m.heroSubtitle = m.top.findNode("heroSubtitle")
    m.countdown = m.top.findNode("countdown")
    m.startsIn = m.top.findNode("startsIn")
    m.cells = m.top.findNode("cells")
    m.overview = m.top.findNode("overview")
    m.heroButtons = m.top.findNode("heroButtons")
    m.weekSection = m.top.findNode("weekSection")
    m.weekTitle = m.top.findNode("weekTitle")
    m.weekStrip = m.top.findNode("weekStrip")
    m.readySection = m.top.findNode("readySection")
    m.readyTitle = m.top.findNode("readyTitle")
    m.readyStrip = m.top.findNode("readyStrip")
    m.state = m.top.findNode("state")
    m.stateTitle = m.top.findNode("title")
    m.fullButton = m.top.findNode("fullButton")
    m.stateText = m.top.findNode("stateText")
    m.retryButton = m.top.findNode("retryButton")
    m.tick = m.top.findNode("tick")
    m.keys = m.top.createChild("Group")
    m.keys.focusable = true

    calendarInit()
    m.zone = "hero"
    m.index = 0
    m.heroEntry = invalid
    m.counting = false
    m.buttonNodes = []
    m.buttonSpecs = []
    m.week = []
    m.ready = []
    m.weekCards = []
    m.readyCards = []

    m.stateIcon = calendarGlyphLabel(80)
    m.stateIcon.color = "#FFFFFF66"
    m.state.appendChild(m.stateIcon)

    layoutView()
    m.top.observeField("focusedChild", "paintFocus")
    m.tick.observeField("fire", "onTick")
    render()
end sub

sub layoutView()
    m.insets = calendarInsets()
    m.width = 1920 - m.insets.left - m.insets.right
    m.viewHeight = 1080 - m.insets.top - m.insets.bottom
    m.page.translation = [m.insets.left, m.insets.top]
    m.state.translation = [m.insets.left, m.insets.top]

    m.heroMask.maskSize = [m.width, HERO_HEIGHT]
    ' The image takes the right 68 percent of the width at 16:9, centered top to bottom
    artLeft = Int(m.width * 0.32)
    artHeight = Int((m.width - artLeft) * 9 / 16)
    if artHeight > HERO_HEIGHT then artHeight = HERO_HEIGHT
    m.heroArt.translation = [artLeft, Int((HERO_HEIGHT - artHeight) / 2)]
    m.heroArt.width = m.width - artLeft
    m.heroArt.height = artHeight
    m.heroArt.loadWidth = m.heroArt.width
    m.heroArt.loadHeight = artHeight
    m.heroScrim.width = m.width
    m.heroScrim.height = HERO_HEIGHT
    m.heroScrim.blendColor = m.calBackground

    m.kicker.font = fontOfSize(22, true)
    m.kicker.height = 31
    m.kicker.vertAlign = "center"
    m.heroTitle.font = fontOfSize(67, true)
    m.heroSubtitle.font = fontOfSize(30, false)
    m.heroSubtitle.height = 42
    m.heroSubtitle.vertAlign = "center"
    m.startsIn.font = fontOfSize(20, true)
    m.startsIn.height = 28
    m.startsIn.vertAlign = "center"
    m.overview.font = fontOfSize(25, false)
    for each heading in [m.weekTitle, m.readyTitle]
        heading.font = fontOfSize(33, true)
        heading.height = 47
        heading.vertAlign = "center"
    end for
    m.weekTitle.text = tr("Coming up this week")
    m.readyTitle.text = tr("Ready to watch")
    m.startsIn.text = tr("Starts in")

    m.stateTitle.font = fontOfSize(47, true)
    m.stateText.font = fontOfSize(27, false)
    m.stateTitle.text = tr("Calendar")
    m.stateTitle.height = 59
    m.stateTitle.vertAlign = "center"
    for each button in [m.fullButton, m.retryButton]
        button.accent = m.calAccent
        button.onAccent = m.calOnAccent
    end for
    m.fullButton.text = tr("Full calendar")
    m.fullButton.translation = [m.width - m.fullButton.buttonWidth, (59 - m.fullButton.buttonHeight) / 2]
    m.retryButton.text = tr("Retry")
end sub

sub onCalendarChanged()
    render()
end sub

' The hero is the next thing to air that isn't on the server. With nothing coming up, the newest
' ready item takes it, with Play in place of the timer.
sub render()
    nextEntry = calendarEntries.NextUp(m.calEntries, m.calNow)
    m.ready = calendarEntries.ReadyToWatch(m.calEntries, m.calToday)
    m.counting = isValid(nextEntry)
    m.heroEntry = nextEntry
    if not m.counting and m.ready.Count() > 0 then m.heroEntry = m.ready[0]

    showsState = m.calLoading or m.calProblem <> "" or not isValid(m.heroEntry)
    m.state.visible = showsState
    m.page.visible = not showsState
    m.tick.control = "stop"
    if showsState
        showState()
        return
    end if

    heroKey = m.heroEntry.key
    m.week = []
    for each entry in calendarEntries.ThisWeek(m.calEntries, m.calToday, m.calNow)
        if entry.key <> heroKey then m.week.push(entry)
    end for
    kept = []
    for each entry in m.ready
        if entry.key <> heroKey then kept.push(entry)
    end for
    m.ready = kept

    renderHero()
    y = HERO_HEIGHT
    poster = m.calPrefs.imageType = "poster"
    y = layOutSection(m.weekSection, m.weekStrip, m.week, poster, y, "week")
    y = layOutSection(m.readySection, m.readyStrip, m.ready, false, y, "ready")

    if m.zone = "week" and m.week.Count() = 0 then m.zone = "hero"
    if m.zone = "ready" and m.ready.Count() = 0 then m.zone = "hero"
    if m.zone <> "hero" and m.zone <> "week" and m.zone <> "ready" then m.zone = "hero"
    if m.zone = "hero" and m.index >= m.buttonNodes.Count() then m.index = 0
    if m.counting then m.tick.control = "start"
    scrollToZone()
    paintFocus()
end sub

sub renderHero()
    entry = m.heroEntry
    hides = calendarHidesSpoilers(entry)
    art = entry.backdropUrl
    if art = "" and not hides then art = entry.stillUrl
    m.heroArt.uri = art

    if m.counting
        kickerParts = []
        if m.calPrefs.badges and entry.badge <> "" then kickerParts.push(calendarEntries.BadgeLabel(entry.badge))
        kickerParts.push(calendarWhen(entry))
        m.kicker.text = UCase(kickerParts.Join(" · "))
        m.kicker.color = calendarColor(entry)
    else
        m.kicker.text = UCase(tr("Ready to watch"))
        m.kicker.color = calendarEntries.READY_COLOR
    end if

    ' The title is a 74 tall box per line, up to two
    m.heroTitle.text = entry.title
    m.heroTitle.width = INFO_WIDTH
    m.heroTitle.height = 0
    titleHeight = 74
    if m.heroTitle.boundingRect().height > 110 then titleHeight = 148
    m.heroTitle.height = titleHeight
    m.heroTitle.vertAlign = "center"

    subtitle = calendarSubtitle(entry)
    m.heroSubtitle.text = subtitle
    m.heroSubtitle.width = INFO_WIDTH
    m.heroSubtitle.visible = subtitle <> ""

    m.countdown.visible = m.counting
    countdownHeight = 0
    if m.counting then countdownHeight = renderCountdown()

    showOverview = not hides and entry.overview <> ""
    m.overview.visible = showOverview
    overviewHeight = 0
    if showOverview
        ' Lines sit 34 apart, with half the leading above the first line and below the last
        m.overview.text = entry.overview
        m.overview.width = INFO_WIDTH
        m.overview.height = 0
        m.overview.lineSpacing = 8
        overviewHeight = m.overview.boundingRect().height + 8
        m.overview.height = overviewHeight
        m.overview.vertAlign = "center"
    end if

    m.buttonSpecs = calendarEntryButtons(entry, not m.counting)
    for each spec in m.buttonSpecs
        if spec.id = "request" then spec.primary = false
    end for
    m.buttonSpecs.push({ id: "full", text: tr("Full calendar"), glyph: "calendar_month_rounded", primary: false })
    laid = calendarLayButtons(m.heroButtons, m.buttonSpecs, INFO_WIDTH)
    m.buttonNodes = laid.nodes

    blocks = [{ node: m.kicker, height: 31, before: 0 }, { node: m.heroTitle, height: titleHeight, before: 10 }]
    if m.heroSubtitle.visible then blocks.push({ node: m.heroSubtitle, height: 42, before: 10 })
    if m.counting then blocks.push({ node: m.countdown, height: countdownHeight, before: 27 })
    if showOverview then blocks.push({ node: m.overview, height: overviewHeight, before: 23 })
    blocks.push({ node: m.heroButtons, height: laid.height, before: 30 })
    total = 0
    for each block in blocks
        total += block.before + block.height
    end for
    y = (HERO_HEIGHT - total) / 2
    if y < 40 then y = 40
    for each block in blocks
        y += block.before
        block.node.translation = [0, y]
        y += block.height
    end for
    m.heroInfo.translation = [53, 0]
end sub

' Days, hr and min cells, the days one only while there are days left. Returns its height.
function renderCountdown() as integer
    entry = m.heroEntry
    target = entry.seconds
    parts = calendarEntries.CountdownParts(target, m.calNow)
    m.cells.removeChildrenIndex(m.cells.getChildCount(), 0)
    cells = []
    if parts.days > 0 then cells.push([parts.days, tr("days")])
    cells.push([parts.hours, tr("hr")])
    cells.push([parts.minutes, tr("min")])
    x = 0
    valueFont = fontOfSize(43, true)
    unitFont = fontOfSize(20, false)
    for each cell in cells
        fill = m.cells.createChild("Poster")
        value = m.cells.createChild("Label")
        unit = m.cells.createChild("Label")
        value.font = valueFont
        value.text = leftPad(cell[0].ToStr(), "0", 2)
        value.color = "#FFFFFF"
        unit.font = unitFont
        unit.text = cell[1]
        unit.color = "#FFFFFF99"
        width = value.boundingRect().width
        if unit.boundingRect().width > width then width = unit.boundingRect().width
        width += 40
        if width < 107 then width = 107
        fill.uri = "pkg:/images/details/surface17.9.png"
        fill.blendColor = "#FFFFFF"
        fill.opacity = 0.1
        fill.width = width
        ' Padding around a 61 tall number line and a 28 tall unit line
        fill.height = 116
        fill.translation = [x, 0]
        for each label in [value, unit]
            label.width = width
            label.horizAlign = "center"
            label.vertAlign = "center"
            label.translation = [x, 13]
        end for
        value.height = 61
        unit.translation = [x, 74]
        unit.height = 28
        x += width + 13
    end for
    m.cells.translation = [0, 38]
    return 38 + 116
end function

' Minutes are the smallest unit shown, so a tick every 20 seconds keeps the cells within a third
' of a minute. Once the hero airs the next one takes its place.
sub onTick()
    m.calNow = calendarEntries.NowEpoch()
    m.calToday = calendarEntries.TodayNumber()
    nextEntry = calendarEntries.NextUp(m.calEntries, m.calNow)
    if not isValid(nextEntry) or not isValid(m.heroEntry) or nextEntry.key <> m.heroEntry.key
        render()
        return
    end if
    renderCountdown()
end sub

' A titled row of cards under the hero. Returns where the next one goes.
function layOutSection(section as object, strip as object, entries as object, poster as boolean, y as integer, which as string) as integer
    strip.removeChildrenIndex(strip.getChildCount(), 0)
    cards = []
    section.visible = entries.Count() > 0
    if not section.visible
        if which = "week" then m.weekCards = cards else m.readyCards = cards
        return y
    end if

    width = 467
    height = 263
    mask = "pkg:/images/calendar/wideMask.webp"
    if poster
        width = 250
        height = 375
        mask = "pkg:/images/calendar/posterMask.webp"
    end if
    section.translation = [0, y + 40]
    ' A row clips just left of the content so it never slides over the nav, and runs on to the
    ' right edge of the screen
    section.clippingRect = [-27, -20, 1920 - m.insets.left + 27, 64 + height + 120]
    strip.translation = [0, 64]
    x = 0
    for each entry in entries
        hides = calendarHidesSpoilers(entry)
        url = calendarEntries.ThumbUrl(entry, hides)
        if poster then url = entry.posterUrl
        line = calendarWhen(entry)
        if calendarEntries.InLibrary(entry) then line = calendarSubtitle(entry)
        card = strip.createChild("CalendarCard")
        card.focusColor = m.calFocusColor
        card.data = {
            width: width,
            height: height,
            url: url,
            maskUri: mask,
            glyph: calendarFallbackGlyph(entry),
            title: entry.title,
            line: line,
            lineColor: calendarColor(entry) + "E6"
        }
        card.translation = [x, 0]
        x += width + CARD_GAP
        cards.push(card)
    end for
    if which = "week"
        m.weekCards = cards
        m.weekCardWidth = width + CARD_GAP
    else
        m.readyCards = cards
        m.readyCardWidth = width + CARD_GAP
    end if
    ' The card's two text lines take the 86 under the art
    m[which + "Top"] = y + 40
    m[which + "Bottom"] = y + 40 + 64 + height + 86
    return y + 40 + 64 + height + 86
end function

sub showState()
    message = tr("Loading...")
    glyph = ""
    retry = false
    if not m.calLoading
        if m.calProblem <> ""
            message = calendarProblemText(m.calProblem)
            glyph = "event_busy_rounded"
            retry = m.calProblem <> "adminsOnly"
        else
            message = tr("Nothing coming up")
            glyph = "event_available_rounded"
        end if
    end if
    m.stateIcon.text = settingsGlyphs.Char(glyph)
    m.stateIcon.width = m.width
    m.stateIcon.height = 80
    m.stateText.width = m.width - 200
    m.stateText.height = 0
    m.stateText.text = message
    textHeight = m.stateText.boundingRect().height
    m.stateText.height = textHeight
    y = m.viewHeight / 2 - 60
    m.stateIcon.translation = [0, y - 107]
    m.stateText.translation = [100, y]
    m.retryButton.visible = retry
    m.retryButton.translation = [(m.width - m.retryButton.buttonWidth) / 2, y + textHeight + 33]
    m.zone = "full"
    if retry then m.zone = "retry"
    if m.top.isInFocusChain() then focusIn()
end sub

' What holds focus is centered, kept within the ends: the row down the page and the card along its
' row. The hero keeps the page at the top.
sub scrollToZone()
    offset = 0
    if m.zone = "week" or m.zone = "ready"
        center = (m[m.zone + "Top"] + 64 + m[m.zone + "Bottom"]) / 2
        offset = Int(m.insets.top + center - 540)
        ' The page stops 53 above the bottom of the screen
        last = m.weekBottom
        if m.readyCards.Count() > 0 then last = m.readyBottom
        most = last + 53 + m.insets.top - 1080
        if offset > most then offset = most
        if offset < 0 then offset = 0
    end if
    m.page.translation = [m.insets.left, m.insets.top - offset]

    if m.zone = "week" then slideStrip(m.weekStrip, m.weekCardWidth, m.weekCards.Count())
    if m.zone = "ready" then slideStrip(m.readyStrip, m.readyCardWidth, m.readyCards.Count())
end sub

sub slideStrip(strip as object, stride as integer, count as integer)
    cardWidth = stride - CARD_GAP
    shift = m.index * stride + cardWidth / 2 - m.width / 2
    most = count * stride - CARD_GAP - m.width
    if shift > most then shift = most
    if shift < 0 then shift = 0
    strip.translation = [-Int(shift), strip.translation[1]]
end sub

sub paintFocus()
    ' Focus handed to the view itself, by the nav coming back, goes on to where the remote was
    if m.top.hasFocus()
        focusIn()
        return
    end if
    active = m.keys.hasFocus()
    for i = 0 to m.buttonNodes.Count() - 1
        m.buttonNodes[i].focused = active and m.zone = "hero" and m.index = i
    end for
    for i = 0 to m.weekCards.Count() - 1
        m.weekCards[i].focused = active and m.zone = "week" and m.index = i
    end for
    for i = 0 to m.readyCards.Count() - 1
        m.readyCards[i].focused = active and m.zone = "ready" and m.index = i
    end for
    m.fullButton.focused = active and m.zone = "full"
    m.retryButton.focused = active and m.zone = "retry"
end sub

sub focusIn()
    m.keys.setFocus(true)
    paintFocus()
end sub

sub followSettings()
    calendarFollowSettings()
end sub

sub moveTo(zone as string, index as integer)
    m.zone = zone
    m.index = index
    scrollToZone()
    paintFocus()
end sub

function goToNav(edge as string) as boolean
    m.top.getParent().lastFocus = m.keys
    if edge = "up" then return FocusOverhang(m.top)
    return FocusSidebar(m.top)
end function

' The row under or over a zone, skipping an empty one
function zoneBelow(zone as string) as string
    if zone = "hero" and m.week.Count() > 0 then return "week"
    if (zone = "hero" or zone = "week") and m.ready.Count() > 0 then return "ready"
    return ""
end function

function zoneAbove(zone as string) as string
    if zone = "ready" and m.week.Count() > 0 then return "week"
    if zone = "ready" or zone = "week" then return "hero"
    return ""
end function

function zoneCount(zone as string) as integer
    if zone = "hero" then return m.buttonNodes.Count()
    if zone = "week" then return m.weekCards.Count()
    if zone = "ready" then return m.readyCards.Count()
    return 1
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.zone = "full" or m.zone = "retry"
        if key = "OK"
            if m.zone = "full"
                calendarOpenMonth()
            else
                calendarLoad()
                render()
            end if
            return true
        end if
        if key = "up"
            if m.zone = "retry" then moveTo("full", 0) else return goToNav("up")
            return true
        end if
        if key = "down" and m.zone = "full" and m.retryButton.visible
            moveTo("retry", 0)
            return true
        end if
        if key = "left" then return goToNav("left")
        return key = "right" or key = "down"
    end if

    if key = "OK"
        if m.zone = "hero" and m.index < m.buttonSpecs.Count()
            id = m.buttonSpecs[m.index].id
            if id = "full"
                calendarOpenMonth()
            else
                calendarButtonAction(id, m.heroEntry)
            end if
        else if m.zone = "week" and m.index < m.week.Count()
            calendarSelect(m.week[m.index])
        else if m.zone = "ready" and m.index < m.ready.Count()
            calendarSelect(m.ready[m.index])
        end if
        return true
    end if

    if key = "left"
        if m.index = 0 then return goToNav("left")
        moveTo(m.zone, m.index - 1)
        return true
    end if
    if key = "right"
        if m.index < zoneCount(m.zone) - 1 then moveTo(m.zone, m.index + 1)
        return true
    end if
    if key = "down"
        target = zoneBelow(m.zone)
        if target <> "" then moveTo(target, 0)
        return true
    end if
    if key = "up"
        target = zoneAbove(m.zone)
        if target = "" then return goToNav("up")
        moveTo(target, 0)
        return true
    end if
    return false
end function

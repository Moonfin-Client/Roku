<?xml version="1.0" encoding="utf-8"?>
<!-- An agenda row: the time, a colored bar, a 16:9 thumbnail, the title, the line under it and
     tags, with the day's heading over the first row of each day -->
<component name="CalendarRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="width" type="float" onChange="onContentChanged" />
    <field id="height" type="float" />
    <field id="itemHasFocus" type="boolean" onChange="paintFocus" />
  </interface>
  <children>
    <Label id="dayName" vertAlign="center" />
    <Label id="dayDate" vertAlign="center" color="#FFFFFF8C" />
    <Group id="card">
      <Poster id="ring" uri="pkg:/images/seerr/stroke17w3.9.png" visible="false" />
      <Label id="time" color="#FFFFFFB3" vertAlign="center" wrap="true" maxLines="2" />
      <Rectangle id="bar" width="5" />
      <Poster id="fallback" uri="pkg:/images/details/surface17.9.png" blendColor="#1A1A1A" />
      <Label id="fallbackIcon" horizAlign="center" vertAlign="center" color="#FFFFFF4D" />
      <MaskGroup id="thumbMask" maskUri="pkg:/images/calendar/thumbMask.webp">
        <Poster id="thumb" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="title" color="#FFFFFF" />
      <Label id="subtitle" color="#FFFFFFA6" />
      <CalendarTags id="tags" />
    </Group>
  </children>
</component>

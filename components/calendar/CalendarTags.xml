<?xml version="1.0" encoding="utf-8"?>
<!-- Short labels on a tint of their own color -->
<component name="CalendarTags" extends="Group">
  <interface>
    <field id="tags" type="array" onChange="layoutTags" />
    <field id="fontSize" type="integer" value="18" onChange="layoutTags" />
    <field id="maxWidth" type="float" onChange="layoutTags" />
    <field id="tagsWidth" type="float" />
    <field id="tagsHeight" type="float" />
  </interface>
</component>

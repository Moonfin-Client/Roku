<?xml version="1.0" encoding="utf-8"?>
<!-- The full calendar behind both styles: a month grid with the picked day's entries beside it -->
<component name="CalendarMonthScreen" extends="JFScreen">
  <interface>
    <!-- What the screen that opened this one already loaded, so it isn't asked for again -->
    <field id="shared" type="assocarray" />
    <!-- How the settings preview draws the grid, as the styles do -->
    <function name="calendarUsePrefs" />
    <function name="calendarLoad" />
    <function name="calendarShared" />
  </interface>
  <children>
    <Rectangle id="background" width="1920" height="1080" color="#101010" />
    <Label id="monthTitle" color="#FFFFFF" />
    <CalendarButton id="prevButton" compact="true" glyph="chevron_left_rounded" />
    <CalendarButton id="nextButton" compact="true" glyph="chevron_right_rounded" />
    <CalendarButton id="todayButton" compact="true" glyph="today_rounded" />
    <Group id="weekdays" />
    <Group id="grid" />
    <Label id="loading" horizAlign="center" vertAlign="center" color="#FFFFFFCC" />
    <Group id="panel">
      <Label id="dayName" color="#FFFFFF" />
      <Label id="dayDate" color="#FFFFFF8C" />
      <SettingsScroller id="dayList" itemComponentName="CalendarRow" bottomPadding="20" animate="true" followAlignment="0.5" />
      <Label id="emptyDay" horizAlign="center" vertAlign="center" color="#FFFFFF99" />
    </Group>
  </children>
</component>

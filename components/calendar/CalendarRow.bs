import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.dayName = m.top.findNode("dayName")
    m.dayDate = m.top.findNode("dayDate")
    m.card = m.top.findNode("card")
    m.ring = m.top.findNode("ring")
    m.time = m.top.findNode("time")
    m.bar = m.top.findNode("bar")
    m.fallback = m.top.findNode("fallback")
    m.fallbackIcon = m.top.findNode("fallbackIcon")
    m.thumbMask = m.top.findNode("thumbMask")
    m.thumb = m.top.findNode("thumb")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.tags = m.top.findNode("tags")

    m.dayName.font = fontOfSize(27, true)
    m.dayDate.font = fontOfSize(23, false)
    m.time.font = fontOfSize(22, true)
    m.title.font = fontOfSize(25, true)
    m.subtitle.font = fontOfSize(22, false)
    m.fallbackIcon.font = CreateObject("roSGNode", "Font")
    m.fallbackIcon.font.uri = settingsGlyphs.FONT_URI
    m.fallbackIcon.font.size = 40
    m.fallbackIcon.addField("themeBaseFont", "node", false)
    m.ring.blendColor = coreFocusColor()
end sub

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) or not isValid(content.row) then return
    row = content.row
    compact = row.compact = true
    width = m.top.width

    band = content.bandHeight
    m.dayName.visible = row.header <> ""
    m.dayDate.visible = m.dayName.visible and row.headerDate <> ""
    if m.dayName.visible
        m.dayName.text = row.header
        m.dayName.color = "#FFFFFF"
        if row.headerToday = true then m.dayName.color = row.accent
        m.dayName.width = 0
        m.dayName.height = 0
        nameWidth = m.dayName.boundingRect().width
        headerTop = band - 13 - 39
        ' The day header has no inset, unlike the row under it
        m.dayName.translation = [0, headerTop]
        m.dayName.width = nameWidth
        m.dayName.height = 39
        m.dayDate.text = row.headerDate
        m.dayDate.translation = [nameWidth + 13, headerTop]
        m.dayDate.height = 39
    end if

    pad = 10
    thumbWidth = compact ? 147 : 214
    thumbHeight = Int(thumbWidth * 9 / 16)
    timeWidth = compact ? 94 : 120
    cardHeight = content.cardHeight
    m.card.translation = [0, band]
    m.ring.width = width
    m.ring.height = cardHeight

    m.time.text = row.time
    m.time.translation = [pad, 0]
    m.time.width = timeWidth
    m.time.height = cardHeight

    x = pad + timeWidth
    ' The parts are centered in the row, which shows once a compact row's text outgrows the thumbnail
    thumbTop = Int((cardHeight - thumbHeight) / 2)
    m.bar.color = row.color
    m.bar.height = thumbHeight
    m.bar.translation = [x, thumbTop]
    x += 5 + 17

    m.fallback.translation = [x, thumbTop]
    m.fallback.width = thumbWidth
    m.fallback.height = thumbHeight
    m.fallbackIcon.text = settingsGlyphs.Char(row.fallbackGlyph)
    m.fallbackIcon.translation = [x, thumbTop]
    m.fallbackIcon.width = thumbWidth
    m.fallbackIcon.height = thumbHeight
    m.thumbMask.translation = [x, thumbTop]
    m.thumbMask.size = [thumbWidth, thumbHeight]
    m.thumb.width = thumbWidth
    m.thumb.height = thumbHeight
    m.thumb.loadWidth = thumbWidth
    m.thumb.loadHeight = thumbHeight
    m.thumb.uri = row.thumb
    x += thumbWidth + 20

    textWidth = width - x - pad
    hasSubtitle = row.subtitle <> ""
    hasTags = row.tags.Count() > 0
    ' The title's line is 35 tall, the line under it 31, and the tags 32 with 7 above them
    textHeight = 35
    if hasSubtitle then textHeight += 31
    if hasTags then textHeight += 39
    top = (cardHeight - textHeight) / 2
    m.title.text = row.title
    m.title.width = textWidth
    m.title.height = 35
    m.title.vertAlign = "center"
    m.title.translation = [x, top]
    top += 35
    m.subtitle.visible = hasSubtitle
    m.subtitle.text = row.subtitle
    m.subtitle.width = textWidth
    m.subtitle.height = 31
    m.subtitle.vertAlign = "center"
    m.subtitle.translation = [x, top]
    if hasSubtitle then top += 31
    m.tags.visible = hasTags
    m.tags.tags = row.tags
    m.tags.translation = [x, top + 7]
    paintFocus()
end sub

sub paintFocus()
    m.ring.visible = m.top.itemHasFocus
end sub

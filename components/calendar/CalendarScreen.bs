import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

sub init()
    m.top.optionsAvailable = false
    m.top.findNode("background").color = themeChrome.Token("background", "0x101010FF")
    m.view = invalid
    showStyle()
end sub

function styleView() as string
    if settingOr("calendar.style", "agenda") = "countdown" then return "CalendarCountdownView"
    return "CalendarAgendaView"
end function

sub showStyle()
    wanted = styleView()
    if isValid(m.view) and m.view.subtype() = wanted then return
    if isValid(m.view)
        m.view.setFocus(false)
        m.top.removeChild(m.view)
    end if
    m.view = m.top.createChild(wanted)
end sub

' Back from a screen pushed over this one, the style and its filters follow the settings
sub OnScreenShown(isReturning = false as boolean)
    if isReturning then followSettings()
    ' Settings opens over this screen rather than in place of it, so its changes are heard here
    m.global.unobserveFieldScoped("session")
    m.global.observeFieldScoped("session", "followSettings")
    m.view.callFunc("focusIn")
end sub

sub OnScreenHidden()
    m.global.unobserveFieldScoped("session")
end sub

sub followSettings()
    before = m.view
    showStyle()
    if before.isSameNode(m.view)
        m.view.callFunc("followSettings")
    else
        ' The nav comes back to the new view, which hands focus on to its first stop
        m.top.lastFocus = m.view
    end if
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- The Countdown style: a hero for the next thing to air with the time left, over rows of what's
     coming this week and what's ready now -->
<component name="CalendarCountdownView" extends="Group">
  <interface>
    <function name="focusIn" />
    <function name="followSettings" />
    <!-- Called by whoever creates the view, with a calendar another view already loaded or invalid -->
    <function name="calendarLoad" />
    <function name="calendarShared" />
  </interface>
  <children>
    <Group id="page">
      <Group id="hero">
        <MaskGroup id="heroMask" maskUri="pkg:/images/calendar/heroMask.webp">
          <Poster id="heroArt" loadDisplayMode="scaleToZoom" />
          <Poster id="heroScrim" uri="pkg:/images/calendar/scrimSide.webp" />
        </MaskGroup>
        <Group id="heroInfo">
          <Label id="kicker" />
          <Label id="heroTitle" wrap="true" maxLines="2" color="#FFFFFF" />
          <Label id="heroSubtitle" color="#FFFFFFCC" />
          <Group id="countdown">
            <Label id="startsIn" color="#FFFFFF99" />
            <Group id="cells" />
          </Group>
          <Label id="overview" wrap="true" maxLines="3" color="#FFFFFFBF" />
          <Group id="heroButtons" />
        </Group>
      </Group>
      <Group id="weekSection">
        <Label id="weekTitle" color="#FFFFFF" />
        <Group id="weekStrip" />
      </Group>
      <Group id="readySection">
        <Label id="readyTitle" color="#FFFFFF" />
        <Group id="readyStrip" />
      </Group>
    </Group>
    <Group id="state" visible="false">
      <Label id="title" color="#FFFFFF" />
      <CalendarButton id="fullButton" compact="true" glyph="calendar_month_rounded" />
      <Label id="stateText" horizAlign="center" wrap="true" color="#FFFFFFCC" />
      <CalendarButton id="retryButton" glyph="refresh_rounded" />
    </Group>
    <Timer id="tick" duration="20" repeat="true" />
  </children>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A Countdown row card: the poster or 16:9 still, the title, and when it airs or its episode -->
<component name="CalendarCard" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="layoutCard" />
    <field id="focused" type="boolean" onChange="paintFocus" />
    <field id="focusColor" type="string" value="#FFFFFF" />
  </interface>
  <children>
    <Poster id="fallback" uri="pkg:/images/details/surface17.9.png" blendColor="#1A1A1A" />
    <Label id="fallbackIcon" horizAlign="center" vertAlign="center" color="#FFFFFF4D" />
    <MaskGroup id="artMask">
      <Poster id="art" loadDisplayMode="scaleToZoom" />
    </MaskGroup>
    <Poster id="ring" uri="pkg:/images/seerr/stroke17w3.9.png" visible="false" />
    <Label id="title" color="#FFFFFF" />
    <Label id="line" />
  </children>
</component>

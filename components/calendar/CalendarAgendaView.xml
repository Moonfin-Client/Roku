<?xml version="1.0" encoding="utf-8"?>
<!-- The Agenda style: the day by day list on the left and a preview of the focused entry beside it -->
<component name="CalendarAgendaView" extends="Group">
  <interface>
    <function name="focusIn" />
    <function name="followSettings" />
    <!-- Called by whoever creates the view, with a calendar another view already loaded or invalid -->
    <function name="calendarLoad" />
    <function name="calendarShared" />
  </interface>
  <children>
    <Label id="title" />
    <CalendarButton id="fullButton" compact="true" glyph="calendar_month_rounded" />
    <CalendarButton id="upcomingTab" compact="true" />
    <CalendarButton id="recentTab" compact="true" />
    <SettingsScroller id="list" itemComponentName="CalendarRow" bottomPadding="40" animate="true" followAlignment="0.5" />
    <Group id="state" visible="false">
      <Label id="stateText" horizAlign="center" wrap="true" color="#FFFFFFCC" />
      <CalendarButton id="retryButton" glyph="refresh_rounded" />
    </Group>
    <Group id="preview" visible="false">
      <MaskGroup id="previewMask" maskUri="pkg:/images/calendar/paneMask.webp">
        <Poster id="previewSurface" uri="pkg:/images/white.webp" />
        <Poster id="previewArt" loadDisplayMode="scaleToZoom" />
        <Poster id="previewScrim" uri="pkg:/images/calendar/scrimDown.webp" />
      </MaskGroup>
      <Group id="previewInfo">
        <Label id="kicker" />
        <Label id="previewTitle" wrap="true" maxLines="2" color="#FFFFFF" />
        <Label id="previewSubtitle" color="#FFFFFFCC" />
        <CalendarTags id="previewTags" />
        <Label id="overview" wrap="true" maxLines="3" color="#FFFFFFBF" />
        <Group id="previewButtons" />
      </Group>
    </Group>
  </children>
</component>

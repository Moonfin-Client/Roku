import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.ring = m.top.findNode("ring")
    m.ring.blendColor = coreFocusColor()
    m.icon = m.top.findNode("icon")
    m.label = m.top.findNode("label")
    m.icon.font = CreateObject("roSGNode", "Font")
    m.icon.font.uri = settingsGlyphs.FONT_URI
    ' A theme font would draw letters in place of the glyph, and an empty base font keeps it out
    m.icon.addField("themeBaseFont", "node", false)
    m.textSize = 0
    layoutButton()
end sub

sub layoutButton()
    if not isValid(m.label) then return
    compact = m.top.compact
    padX = compact ? 23 : 33
    padY = compact ? 13 : 18
    iconSize = compact ? 30 : 33
    textSize = compact ? 22 : 25
    if m.top.tab
        padX = 27
        textSize = 23
    end if
    m.icon.font.size = iconSize
    ' Each change of text or glyph lays the button out again, so the font is only made for a new size
    if textSize <> m.textSize
        m.textSize = textSize
        m.label.font = fontOfSize(textSize, true)
    end if

    ' The text's line box is about 1.4 times its font size, and a taller glyph sets the height instead
    contentHeight = Int(textSize * 1.4 + 0.5)
    if m.top.tab then contentHeight = 34
    if m.top.glyph <> "" and iconSize > contentHeight then contentHeight = iconSize
    height = padY * 2 + contentHeight
    x = padX
    m.icon.text = settingsGlyphs.Char(m.top.glyph)
    m.icon.visible = m.icon.text <> ""
    if m.icon.visible
        m.icon.width = iconSize
        m.icon.height = height
        m.icon.translation = [x, 0]
        x += iconSize
    end if

    m.label.text = m.top.text
    m.label.visible = m.top.text <> ""
    ' The gap after the glyph stays even when there's no label
    if m.icon.visible then x += 13
    if m.label.visible
        m.label.width = 0
        m.label.height = 0
        textWidth = m.label.boundingRect().width
        m.label.translation = [x, 0]
        m.label.width = textWidth
        m.label.height = height
        x += textWidth
    end if

    width = x + padX
    m.fill.width = width
    m.fill.height = height
    m.ring.width = width
    m.ring.height = height
    m.top.buttonWidth = width
    m.top.buttonHeight = height
    paintButton()
end sub

sub paintButton()
    if not isValid(m.fill) then return
    if m.top.focused
        m.fill.blendColor = "#FFFFFF"
        m.fill.opacity = 1
        ink = "#000000DE"
    else if m.top.primary
        m.fill.blendColor = m.top.accent
        m.fill.opacity = 1
        ink = m.top.onAccent
    else
        m.fill.blendColor = "#FFFFFF"
        m.fill.opacity = m.top.tab ? 0.1 : 0.12
        ink = m.top.tab ? "#FFFFFFD9" : "#FFFFFF"
    end if
    m.ring.visible = m.top.focused and not m.top.tab
    m.icon.color = ink
    m.label.color = ink
    m.top.opacity = m.top.dimmed ? 0.35 : 1.0
end sub

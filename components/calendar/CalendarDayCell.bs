import "pkg:/source/utils/misc.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.todayRing = m.top.findNode("todayRing")
    m.body = m.top.findNode("body")
    m.number = m.top.findNode("number")
    m.newTag = m.top.findNode("newTag")
    m.lines = m.top.findNode("lines")
    m.ring = m.top.findNode("ring")
    m.number.font = fontOfSize(25, true)
    m.titleFont = fontOfSize(20, false)
    m.moreFont = fontOfSize(18, false)
end sub

sub layoutCell()
    data = m.top.data
    width = data.width
    height = data.height
    for each layer in [m.fill, m.todayRing, m.ring]
        layer.width = width
        layer.height = height
    end for
    m.body.clippingRect = [0, 0, width, height]

    if data.selected
        m.fill.blendColor = Left(data.accent, 7)
        m.fill.opacity = 0.2
    else
        m.fill.blendColor = "#FFFFFF"
        m.fill.opacity = 0.05
        if not data.inMonth then m.fill.opacity = 0.02
    end if
    m.todayRing.visible = data.today
    m.todayRing.blendColor = Left(data.accent, 7)
    m.ring.blendColor = data.focusColor

    m.number.text = data.number
    m.number.translation = [13, 10]
    m.number.height = 35
    m.number.vertAlign = "center"
    ' The picked cell is tinted with the accent already, so its number stays plain
    if data.today and not data.selected
        m.number.color = data.accent
    else if data.inMonth
        m.number.color = "#FFFFFFF2"
    else
        m.number.color = "#FFFFFF4D"
    end if

    m.newTag.visible = data.premiere
    if data.premiere
        m.newTag.tags = [{ label: data.newLabel, color: data.accent }]
        m.newTag.translation = [width - 13 - m.newTag.tagsWidth, 12]
    end if

    m.lines.removeChildrenIndex(m.lines.getChildCount(), 0)
    y = 52
    titleInk = "#FFFFFFD9"
    if not data.inMonth then titleInk = "#FFFFFF59"
    for each line in data.lines
        bar = m.lines.createChild("Rectangle")
        bar.color = line.color
        bar.width = 5
        bar.height = 23
        bar.translation = [13, y + 3]
        label = m.lines.createChild("Label")
        label.font = m.titleFont
        label.text = line.title
        label.color = titleInk
        label.width = width - 13 - 13 - 13
        label.height = 28
        label.vertAlign = "center"
        label.translation = [13 + 5 + 8, y]
        y += 33
    end for
    if data.more <> ""
        more = m.lines.createChild("Label")
        more.font = m.moreFont
        more.text = data.more
        more.color = "#FFFFFF8C"
        more.translation = [13, y]
        more.height = 25
        more.vertAlign = "center"
    end if
    paintFocus()
end sub

sub paintFocus()
    m.ring.visible = m.top.focused
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- A day on the month grid: its number, up to two titles with their colored bars and how many
     more, a NEW tag on a premiere day, and today outlined -->
<component name="CalendarDayCell" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="layoutCell" />
    <field id="focused" type="boolean" onChange="paintFocus" />
  </interface>
  <children>
    <Poster id="fill" uri="pkg:/images/details/surface17.9.png" />
    <Poster id="todayRing" uri="pkg:/images/playback/outline17.9.png" visible="false" />
    <Group id="body">
      <Label id="number" />
      <CalendarTags id="newTag" />
      <Group id="lines" />
    </Group>
    <Poster id="ring" uri="pkg:/images/seerr/stroke17w3.9.png" visible="false" />
  </children>
</component>

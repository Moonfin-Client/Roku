import "pkg:/source/utils/misc.bs"

' With a maxWidth the tags wrap onto more lines
sub layoutTags()
    m.top.removeChildrenIndex(m.top.getChildCount(), 0)
    tags = m.top.tags ?? []
    font = fontOfSize(m.top.fontSize, true)
    height = m.top.fontSize + 14
    maxWidth = m.top.maxWidth
    x = 0
    y = 0
    widest = 0
    for each tag in tags
        fill = m.top.createChild("Poster")
        label = m.top.createChild("Label")
        label.font = font
        label.text = tag.label
        label.color = tag.color
        textWidth = label.boundingRect().width
        width = textWidth + 24
        if maxWidth > 0 and x > 0 and x + width > maxWidth
            x = 0
            y += height + 7
        end if
        fill.uri = "pkg:/images/seerr/fill10.9.png"
        fill.blendColor = Left(tag.color, 7)
        fill.opacity = 0.18
        fill.width = width
        fill.height = height
        fill.translation = [x, y]
        label.translation = [x + 12, y]
        label.width = textWidth
        label.height = height
        label.vertAlign = "center"
        if x + width > widest then widest = x + width
        x += width + 10
    end for
    m.top.tagsWidth = widest
    m.top.tagsHeight = tags.Count() > 0 ? y + height : 0
end sub

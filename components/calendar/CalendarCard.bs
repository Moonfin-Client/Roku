import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.fallback = m.top.findNode("fallback")
    m.fallbackIcon = m.top.findNode("fallbackIcon")
    m.artMask = m.top.findNode("artMask")
    m.art = m.top.findNode("art")
    m.ring = m.top.findNode("ring")
    m.title = m.top.findNode("title")
    m.line = m.top.findNode("line")
    m.title.font = fontOfSize(23, true)
    m.line.font = fontOfSize(20, false)
    m.fallbackIcon.font = CreateObject("roSGNode", "Font")
    m.fallbackIcon.font.uri = settingsGlyphs.FONT_URI
    m.fallbackIcon.font.size = 50
    m.fallbackIcon.addField("themeBaseFont", "node", false)
end sub

sub layoutCard()
    data = m.top.data
    width = data.width
    height = data.height
    for each layer in [m.fallback, m.fallbackIcon, m.art]
        layer.width = width
        layer.height = height
    end for
    m.fallbackIcon.text = settingsGlyphs.Char(data.glyph)
    m.artMask.maskUri = data.maskUri
    m.artMask.size = [width, height]
    m.art.loadWidth = width
    m.art.loadHeight = height
    m.art.uri = data.url
    ' The ring goes around the whole card, the art and its two lines
    m.ring.translation = [-5, -5]
    m.ring.width = width + 10
    m.ring.height = height + 94
    m.ring.blendColor = m.top.focusColor
    m.title.text = data.title
    m.title.width = width
    m.title.height = 33
    m.title.vertAlign = "center"
    m.title.translation = [0, height + 10]
    m.line.text = data.line
    m.line.color = data.lineColor
    m.line.width = width
    m.line.height = 28
    m.line.vertAlign = "center"
    m.line.translation = [0, height + 43]
end sub

sub paintFocus()
    m.ring.visible = m.top.focused
end sub

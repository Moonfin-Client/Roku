<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar's pill button: a glyph and a label, filled in the accent when primary, and solid
     white with dark ink while focused -->
<component name="CalendarButton" extends="Group">
  <interface>
    <field id="text" type="string" onChange="layoutButton" />
    <field id="glyph" type="string" onChange="layoutButton" />
    <field id="primary" type="boolean" onChange="paintButton" />
    <field id="compact" type="boolean" onChange="layoutButton" />
    <field id="tab" type="boolean" onChange="layoutButton" />
    <field id="focused" type="boolean" onChange="paintButton" />
    <field id="dimmed" type="boolean" onChange="paintButton" />
    <field id="accent" type="string" value="#00A4DC" onChange="paintButton" />
    <field id="onAccent" type="string" value="#FFFFFF" onChange="paintButton" />
    <!-- Read once laid out, so the host can place the buttons in a row -->
    <field id="buttonWidth" type="float" />
    <field id="buttonHeight" type="float" />
  </interface>
  <children>
    <Poster id="fill" uri="pkg:/images/seerr/fill30.9.png" />
    <Poster id="ring" uri="pkg:/images/seerr/stroke28w3.9.png" visible="false" />
    <Label id="icon" horizAlign="center" vertAlign="center" />
    <Label id="label" vertAlign="center" />
  </children>
</component>

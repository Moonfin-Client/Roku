import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "executeRequest"
end sub

sub executeRequest()
    request = m.top.request
    if request = invalid
        m.top.response = { success: false, data: invalid }
        return
    end if

    method = request.method ?? "GET"
    params = request.params ?? {}
    serverData = request.serverData ?? invalid

    if isValid(serverData) and isValidAndNotEmpty(serverData.serverUrl) and isValidAndNotEmpty(serverData.userId) and isValidAndNotEmpty(serverData.authToken)
        targetParams = {}
        targetParams.Append(params)
        if isValid(targetParams.LookupCI("UserId")) then targetParams.UserId = serverData.userId
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, request.path, targetParams)
    else
        req = APIRequest(request.path, params)
    end if

    if method = "GET"
        data = getJson(req)
        m.top.response = { success: data <> invalid, data: data }
        return
    end if

    m.top.response = send(req, method, request.bodyJson ?? "")
end sub

' Most of these routes answer 204 with nothing in the body, so the shared helpers
' that only take a 200 would read a clean write as a failure
function send(req as object, method as string, body as string) as object
    req.setMessagePort(CreateObject("roMessagePort"))
    req.AddHeader("Content-Type", "application/json")

    if method = "POST"
        req.AsyncPostFromString(body)
    else
        req.SetRequest(method)
        req.AsyncGetToString()
    end if

    resp = wait(30000, req.GetMessagePort())
    if type(resp) <> "roUrlEvent" then return { success: false, data: invalid }

    code = resp.GetResponseCode()
    if code < 200 or code > 299 then return { success: false, data: invalid }

    text = resp.GetString()
    return { success: true, data: text <> "" ? ParseJson(text) : invalid }
end function

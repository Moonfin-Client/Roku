import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

sub init()
    m.letterText = m.top.findNode("letterText")
    m.letterText.color = ColorPalette.WHITE
    m.letterText.font.size = 25

    m.activePill = m.top.findNode("activePill")
    m.activePill.blendColor = themeChrome.Accent()
    m.activeInk = ColorPalette.WHITE
    if themeChrome.IsActive() then m.activeInk = themeChrome.OnAccent()
end sub

sub showContent()
    if isValid(m.content) then m.content.unobserveFieldScoped("active")
    m.content = m.top.itemContent
    m.letterText.text = m.content.title

    ' Only the strip that marks a letter gives its letters the flag
    if not m.content.hasField("active") then return
    m.content.observeFieldScoped("active", "showActive")
    showActive()
end sub

' The letter the grid is narrowed to sits on an accent pill
sub showActive()
    active = m.content.active = true
    m.activePill.visible = active
    m.letterText.color = active ? m.activeInk : ColorPalette.WHITE
end sub

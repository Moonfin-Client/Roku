import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/userDataSync.bs"

sub init()
    m.top.functionName = "setFavoriteStatus"
end sub

' Marks the item a favorite or not, on its own server when it has one, and tells the open lists
' once the server has taken it
sub setFavoriteStatus()
    itemId = m.top.itemId
    favorite = isStringEqual(m.top.favTask, "favorite")
    serverData = m.top.serverData

    if isValid(serverData) and isValidAndNotEmpty(serverData.serverUrl)
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "UserFavoriteItems/" + itemId, { UserId: serverData.userId })
    else
        req = APIRequest(`userfavoriteitems/${itemId}`, { userId: m.global.session.user.id })
    end if
    if userDataSync.Send(req, favorite) then userDataSync.Publish(itemId, userDataSync.FavoritePatch(favorite))
end sub

import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

const CARD_TITLE_SIZE = 19
const CARD_SUBTITLE_SIZE = 17
const CARD_TITLE_LINE = 23
const CARD_TEXT_GAP = 4
const CARD_BADGE = 26
const CARD_BADGE_INSET = 8

sub init()
    m.scaleGroup = m.top.findNode("scaleGroup")
    m.posterBg = m.top.findNode("posterBg")
    m.posterMask = m.top.findNode("posterMask")
    m.poster = m.top.findNode("poster")
    m.posterOutline = m.top.findNode("posterOutline")
    m.placeholderIcon = m.top.findNode("placeholderIcon")
    m.favoriteBadge = m.top.findNode("favoriteBadge")
    m.watchedBadge = m.top.findNode("watchedBadge")
    m.watchIcon = m.top.findNode("watchIcon")
    m.watchCount = m.top.findNode("watchCount")
    m.cardTitle = m.top.findNode("cardTitle")
    m.cardSubtitle = m.top.findNode("cardSubtitle")

    m.cardTitle.font.size = CARD_TITLE_SIZE
    m.cardSubtitle.font.size = CARD_SUBTITLE_SIZE
    m.posterOutline.blendColor = themeChrome.Accent()
    m.placeholderIcon.uri = "pkg:/images/icons/musicFolder.png"
    m.placeholderIcon.blendColor = "#FFFFFF59"
end sub

' A grid item cant be handed anything but its content, so the geometry the whole grid
' agreed on is read back from the one place both sides can reach
sub applyMetrics()
    metrics = m.global.libraryCardMetrics
    if not isValid(metrics) then return

    shape = `${metrics.cellWidth}x${metrics.cellHeight}:${metrics.imageType}:${metrics.textHeight.toStr()}`
    if m.shape = shape then return
    m.shape = shape
    m.metrics = metrics

    padX = metrics.padX
    padY = metrics.padY
    posterWidth = metrics.posterWidth
    posterHeight = metrics.posterHeight

    for each node in [m.posterBg, m.poster, m.posterOutline]
        node.width = posterWidth
        node.height = posterHeight
        node.translation = [padX, padY]
    end for

    m.posterMask.translation = [padX, padY]
    m.poster.translation = [0, 0]
    m.posterMask.maskUri = maskFor(metrics.imageType)
    m.posterMask.maskSize = [posterWidth, posterHeight]

    m.placeholderIcon.width = 60
    m.placeholderIcon.height = 60
    m.placeholderIcon.translation = [padX + ((posterWidth - 60) / 2), padY + ((posterHeight - 60) / 2)]

    m.favoriteBadge.translation = [padX + CARD_BADGE_INSET, padY + CARD_BADGE_INSET]
    m.watchedBadge.translation = [padX + posterWidth - CARD_BADGE - CARD_BADGE_INSET, padY + CARD_BADGE_INSET]

    textY = padY + posterHeight + CARD_TEXT_GAP
    for each label in [m.cardTitle, m.cardSubtitle]
        label.width = posterWidth
        label.translation = [padX, textY]
    end for
    m.cardSubtitle.translation = [padX, textY + CARD_TITLE_LINE]

    ' The band only carries a second line when the grid made room for one
    m.cardSubtitle.visible = metrics.textHeight >= libraryCard.TEXT_HEIGHT_WITH_SUBTITLE
    hasText = metrics.textHeight > 0
    m.cardTitle.visible = hasText

    ' A focused card grows about the middle of its artwork
    m.scaleGroup.scaleRotateCenter = [padX + (posterWidth / 2), padY + (posterHeight / 2)]
end sub

function maskFor(imageType as string) as string
    if imageType = "thumbnail" then return "pkg:/images/libraryThumbMask.png"
    if imageType = "square" then return "pkg:/images/librarySquareMask.png"
    return "pkg:/images/libraryPosterMask.png"
end function

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    applyMetrics()

    json = content.json
    metrics = m.metrics
    if not isValid(metrics) then metrics = { imageType: "poster" }

    m.cardTitle.text = content.title ?? ""
    m.cardSubtitle.text = subtitleFor(json)

    posterUrl = artworkFor(content, metrics.imageType)
    m.poster.uri = posterUrl
    m.placeholderIcon.visible = not isValidAndNotEmpty(posterUrl)

    drawBadges(json)
end sub

function subtitleFor(json as object) as string
    if not isValid(json) then return ""

    isFolder = json.IsFolder = true and not libraryCard.DetailedFolderType(json.Type ?? "")
    return libraryCard.Subtitle(json, isFolder, m.metrics.detailed = true)
end function

function artworkFor(content as object, imageType as string) as string
    if imageType = "thumbnail"
        if isValidAndNotEmpty(content.landscapePosterURL) then return content.landscapePosterURL
        if isValidAndNotEmpty(content.backdropURL) then return content.backdropURL
    end if

    return content.PosterUrl ?? ""
end function

' Favourite sits over the top left corner, watched over the top right
sub drawBadges(json as object)
    if not isValid(json)
        m.favoriteBadge.visible = false
        m.watchedBadge.visible = false
        return
    end if

    m.favoriteBadge.visible = chainLookupReturn(json, "UserData.IsFavorite", false) = true

    played = chainLookupReturn(json, "UserData.Played", false) = true
    unplayed = chainLookupReturn(json, "UserData.UnplayedItemCount", 0)
    hasUnplayed = isValid(unplayed) and unplayed > 0

    m.watchedBadge.visible = played or hasUnplayed
    m.watchIcon.visible = played and not hasUnplayed
    m.watchCount.visible = hasUnplayed
    if hasUnplayed then m.watchCount.text = unplayed.toStr()
end sub

sub onFocusChanged()
    focused = m.top.itemHasFocus
    m.posterOutline.visible = focused
    m.scaleGroup.scale = focused ? [libraryCard.FOCUS_SCALE, libraryCard.FOCUS_SCALE] : [1.0, 1.0]
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Marks a Live TV recording that missed part of its program. A card puts it in its artwork's
     top left corner, and an episode row puts the inline size in its line of text. -->
<component name="IncompleteBadge" extends="Group">
    <children>
        <Poster id="shadow" translation="[0, 1.5]" blendColor="#00000099" />
        <Poster id="fill" blendColor="#E0A33C" />
        <Poster id="border" blendColor="#1E1E24" />
        <Poster id="icon" uri="pkg:/images/icons/content_cut_rounded.webp" blendColor="#1E1E24" />
        <Label id="label" color="#1E1E24" vertAlign="center" />
    </children>
    <interface>
        <!-- The smaller size an episode row uses -->
        <field id="inline" type="boolean" value="false" onChange="layoutBadge" />
        <!-- Read back by whatever places it -->
        <field id="badgeWidth" type="float" value="0" />
        <field id="badgeHeight" type="float" value="0" />
    </interface>
</component>

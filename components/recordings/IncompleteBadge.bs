import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"

const BADGE_BORDER = 1.5

sub init()
    m.shadow = m.top.findNode("shadow")
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.icon = m.top.findNode("icon")
    m.label = m.top.findNode("label")
    m.label.font = "font:SmallestBoldSystemFont"
    m.label.text = tr("Incomplete")
    layoutBadge()
end sub

' The type runs a step larger than the pill around it would suggest, since the system font draws
' small for its size
function badgeMetrics(isInline as boolean) as object
    if isInline
        return {
            height: 21, padLeft: 6, padRight: 8, icon: 12, iconGap: 3, fontSize: 15,
            fillUri: "pkg:/images/livetv/fill10.9.png", borderUri: "pkg:/images/livetv/stroke10w1_5.9.png"
        }
    end if

    return {
        height: 26, padLeft: 7, padRight: 10, icon: 15, iconGap: 4, fontSize: 17,
        fillUri: "pkg:/images/livetv/fill12.9.png", borderUri: "pkg:/images/livetv/stroke12w1_5.9.png"
    }
end function

sub layoutBadge()
    if not isValid(m.label) then return

    metrics = badgeMetrics(m.top.inline)
    ' The size goes on the font a theme font is built from, so the theme pass after it keeps it
    labelFont = m.label.font
    if m.label.hasField("themeBaseFont") and isValid(m.label.themeBaseFont) then labelFont = m.label.themeBaseFont
    labelFont.size = fontApply.ThemeTextSize(metrics.fontSize)
    ' A theme font draws at its own width, so it goes on before the label is measured
    fontApply.ApplyThemeFonts(m.top)
    m.label.width = 0
    m.label.height = 0
    textWidth = m.label.boundingRect().width

    iconLeft = BADGE_BORDER + metrics.padLeft
    labelLeft = iconLeft + metrics.icon + metrics.iconGap
    width = labelLeft + textWidth + metrics.padRight + BADGE_BORDER
    height = metrics.height

    m.icon.width = metrics.icon
    m.icon.height = metrics.icon
    m.icon.translation = [iconLeft, (height - metrics.icon) / 2]

    m.label.height = height
    m.label.translation = [labelLeft, 0]

    m.shadow.uri = metrics.fillUri
    m.fill.uri = metrics.fillUri
    m.border.uri = metrics.borderUri
    for each layer in [m.shadow, m.fill, m.border]
        layer.width = width
        layer.height = height
    end for

    m.top.badgeWidth = width
    m.top.badgeHeight = height
end sub

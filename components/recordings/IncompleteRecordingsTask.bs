import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "runJob"
end sub

sub runJob()
    job = m.top.job
    if job.kind = "dismiss"
        response = requestResponse(APIRequest(`/Moonfin/LiveTv/Recordings/${job.itemId}/Dismiss`), "POST", "")
        m.top.result = { itemId: job.itemId, ok: response.status >= 200 and response.status < 300 }
        return
    end if

    m.top.result = fetchList()
end sub

' Keyed by the item's id without dashes, in lower case, since the plugin and the server can
' write the same id either way
function fetchList() as object
    response = requestResponse(APIRequest("/Moonfin/LiveTv/Recordings/Incomplete"))
    if response.status = 401 or response.status = 403 then return { status: "refused" }
    if response.status < 200 or response.status >= 300 or not isValid(response.data) then return { status: "failed" }

    entries = {}
    if type(response.data) = "roArray"
        for each entry in response.data
            if type(entry) = "roAssociativeArray"
                key = guidKey(entry.LookupCI("itemId"))
                if key <> "" then entries[key] = entry
            end if
        end for
    end if

    return { status: "ok", entries: entries }
end function

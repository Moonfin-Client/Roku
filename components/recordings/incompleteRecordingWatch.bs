import "pkg:/source/utils/misc.bs"

' Shared by every card and screen that marks an incomplete recording. The host supplies
' showIncompleteRecording(entry), which is handed the plugin's entry for its item whenever the
' list changes, or invalid when the item has none.

' Where a card's badge sits over its artwork, and the room it leaves under a heart
const INCOMPLETE_BADGE_EDGE = 8
const INCOMPLETE_BADGE_BELOW_GAP = 6

' The heart a PlayedCheckmark draws
const CHECKMARK_HEART_SIZE = 36

' Follows one item's mark. An empty id hides it.
sub watchIncompleteRecording(itemId as dynamic)
    m.incompleteItemId = itemId ?? ""
    if m.watchingIncomplete <> true
        m.watchingIncomplete = true
        incompleteRecordingStore().observeFieldScoped("changed", "onIncompleteRecordingsChanged")
    end if

    onIncompleteRecordingsChanged()
end sub

sub onIncompleteRecordingsChanged()
    entry = invalid
    if isValidAndNotEmpty(m.incompleteItemId) then entry = incompleteRecordingStore().callFunc("entryFor", m.incompleteItemId)
    showIncompleteRecording(entry)
end sub

' The badge a card draws over its artwork, made the first time there is something to show and
' kept on the card after that
function drawIncompleteBadge(badge as dynamic, parent as object, entry as dynamic, spot as object, isInline = false as boolean) as dynamic
    if not isValid(badge)
        if not isValid(entry) then return invalid

        badge = parent.createChild("IncompleteBadge")
        badge.inline = isInline
    end if

    badge.visible = isValid(entry)
    badge.translation = spot
    return badge
end function

' The artwork's top left corner, or just under the heart when the card's PlayedCheckmark draws one
function incompleteBadgeSpot(indicator as dynamic) as object
    if not isValid(indicator) or chainLookupReturn(indicator.data, "favorite", false) <> true then return [INCOMPLETE_BADGE_EDGE, INCOMPLETE_BADGE_EDGE]

    corner = indicator.favoriteOffset
    if not isValid(corner) or corner.count() <> 2 then corner = [0, 0]
    return [indicator.translation[0] + corner[0], indicator.translation[1] + corner[1] + CHECKMARK_HEART_SIZE + INCOMPLETE_BADGE_BELOW_GAP]
end function

' One store for the whole app, made on first use. That first use is always a card or a screen, so
' it belongs to the render thread its task needs.
function incompleteRecordingStore() as object
    if not m.global.hasField("incompleteRecordingStore")
        m.global.addFields({ incompleteRecordingStore: CreateObject("roSGNode", "IncompleteRecordingStore") })
    end if

    return m.global.incompleteRecordingStore
end function

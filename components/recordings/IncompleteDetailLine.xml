<?xml version="1.0" encoding="utf-8"?>
<!-- The status line under an incomplete recording's title on the details screens, such as
     Incomplete · 23 of 37 min · Complete showing scheduled Thu 8:00 PM -->
<component name="IncompleteDetailLine" extends="Label">
    <interface>
        <!-- The plugin's entry for the item, where an empty one hides the line -->
        <field id="entry" type="assocarray" onChange="onEntryChanged" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the incomplete recordings list from the plugin, or clears one mark, for IncompleteRecordingStore -->
<component name="IncompleteRecordingsTask" extends="Task">
    <interface>
        <!-- { kind: "list" } or { kind: "dismiss", itemId } -->
        <field id="job" type="assocarray" />
        <!-- A list answers { status, entries } and a dismiss { itemId, ok } -->
        <field id="result" type="assocarray" />
    </interface>
</component>

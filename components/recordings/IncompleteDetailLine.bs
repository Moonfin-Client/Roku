import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/incompleteRecordings.bs"
import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    font = CreateObject("roSGNode", "Font")
    font.uri = "font:BoldSystemFontFile"
    font.size = fontApply.ThemeTextSize(24)
    m.top.font = font
    m.top.color = "#E0A33C"
    m.top.visible = false
    fontApply.ApplyThemeFonts(m.top)
end sub

sub onEntryChanged()
    entry = m.top.entry
    m.top.visible = isValid(entry) and entry.count() > 0
    if not m.top.visible then return

    m.top.text = incompleteRecordings.DetailText(entry, liveTvGuide.use24Hour())
end sub

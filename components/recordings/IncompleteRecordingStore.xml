<?xml version="1.0" encoding="utf-8"?>
<!-- The Moonfin plugin's list of Live TV recordings that missed part of their program, for the
     whole app. It sits on the global node, and whatever draws a badge or a line watches changed
     and asks entryFor again. -->
<component name="IncompleteRecordingStore" extends="Node">
    <interface>
        <field id="changed" type="integer" alwaysNotify="true" />
        <!-- { itemId, ok } once a Keep as Complete answers, with the id as entryFor keys it -->
        <field id="keepResult" type="assocarray" alwaysNotify="true" />
        <!-- (itemId) the plugin's entry for the item, or invalid -->
        <function name="entryFor" />
        <!-- Reads the list again once it is a few minutes old -->
        <function name="refresh" />
        <!-- (itemId) clears the mark for everyone on the server -->
        <function name="keepAsComplete" />
        <function name="clear" />
    </interface>
</component>

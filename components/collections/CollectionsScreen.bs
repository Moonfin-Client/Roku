import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.optionsAvailable = false

    m.collectionsGrid = m.top.findNode("collectionsGrid")
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.emptyStateGroup = m.top.findNode("emptyStateGroup")

    m.collectionsGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.collectionsGrid.content = createSGNode("ContentNode")
    m.collectionsGrid.observeFieldScoped("itemSelected", "onItemSelected")

    m.isLoading = false

    m.loadTask = createObject("roSGNode", "LoadCollectionsTask")
    m.loadTask.observeField("results", "onCollectionsLoaded")
end sub

sub OnScreenShown(_isReturning = false as boolean)
    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav)
        activeNav.visible = true
        activeNav.currentPage = "collections"
    end if

    if m.collectionsGrid.content.getChildCount() = 0
        loadCollections()
    else
        m.collectionsGrid.setFocus(true)
    end if
end sub

sub OnScreenHidden()
end sub

sub loadCollections()
    if m.isLoading then return

    m.isLoading = true
    showLoading(true)

    m.loadTask.control = TaskControl.RUN
end sub

sub onCollectionsLoaded(event as object)
    items = event.getData()
    m.isLoading = false
    showLoading(false)

    if not isValid(items) or items.Count() = 0
        showEmptyState()
        return
    end if

    content = createSGNode("ContentNode")
    for each item in items
        content.appendChild(item)
    end for
    m.collectionsGrid.content = content
    m.collectionsGrid.setFocus(true)
end sub

sub onItemSelected(event as object)
    index = event.getData()
    if not isValid(index) then return

    item = m.collectionsGrid.content.getChild(index)
    if not isValid(item) then return

    m.top.selectedItem = item
end sub

sub showLoading(visible as boolean)
    m.loadingGroup.visible = visible
    m.collectionsGrid.visible = not visible
end sub

sub showEmptyState()
    m.emptyStateGroup.visible = true
    m.collectionsGrid.visible = false
    m.emptyStateGroup.setFocus(true)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.UP
        if m.collectionsGrid.hasFocus()
            rowIndex = int(m.collectionsGrid.itemFocused / m.collectionsGrid.numColumns)
            if rowIndex = 0
                m.top.lastFocus = m.collectionsGrid
                return FocusOverhang(m.top)
            end if
        end if
        if m.emptyStateGroup.hasFocus()
            m.top.lastFocus = m.emptyStateGroup
            return FocusOverhang(m.top)
        end if
    end if

    return false
end function

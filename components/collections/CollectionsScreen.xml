<?xml version="1.0" encoding="utf-8"?>
<component name="CollectionsScreen" extends="JFScreen">
    <interface>
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="quickPlayNode" type="node" alwaysNotify="true" />
        <!-- Required by GridItemSmall: traverses up to the screen to read these -->
        <field id="showItemTitles" type="string" value="showalways" />
        <field id="imageDisplayMode" type="string" value="scaleToZoom" />
    </interface>
    <children>
        <Text id="pageTitle"
            translation="[0, 30]"
            width="1920"
            horizAlign="center"
            font="font:LargeBoldSystemFont"
            color="#FFFFFF"
            text="Collections" />

        <MarkupGrid id="collectionsGrid"
            translation="[96, 110]"
            itemComponentName="GridItemSmall"
            vertFocusAnimationStyle="fixed"
            drawFocusFeedback="true"
            focusBitmapUri="pkg:/images/hd_focus.9.png"
            numColumns="7"
            numRows="3"
            itemSize="[230, 390]"
            rowHeights="[390]"
            itemSpacing="[20, 20]" />

        <LayoutGroup id="loadingGroup"
            translation="[960, 540]"
            layoutDirection="vert"
            horizAlignment="center"
            visible="false">
            <Spinner id="loadingSpinner" />
            <Text text="Loading collections..." font="font:MediumSystemFont" color="#FFFFFF" translation="[0, 20]" />
        </LayoutGroup>

        <LayoutGroup id="emptyStateGroup"
            translation="[960, 400]"
            layoutDirection="vert"
            horizAlignment="center"
            visible="false">
            <Text text="No collections found" font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center" />
            <Text text="Add collections in Jellyfin to see them here" font="font:MediumSystemFont" color="#888888" translation="[0, 10]" horizAlign="center" />
        </LayoutGroup>
    </children>
</component>

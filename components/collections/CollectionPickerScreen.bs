import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.optionsAvailable = false

    m.collectionList = m.top.findNode("collectionList")
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.statusGroup = m.top.findNode("statusGroup")
    m.statusText = m.top.findNode("statusText")

    m.collectionList.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.collectionList.focusedColor = "0xFFFFFFFF"
    m.collectionList.observeFieldScoped("itemSelected", "onListItemSelected")

    m.collections = []

    m.loadTask = createObject("roSGNode", "LoadCollectionsTask")
    m.loadTask.observeField("results", "onCollectionsLoaded")

    m.actionTask = createObject("roSGNode", "CollectionActionTask")
    m.actionTask.observeField("success", "onActionComplete")
end sub

sub OnScreenShown(_isReturning = false as boolean)
    showLoading(true)
    m.loadTask.control = TaskControl.RUN
end sub

sub OnScreenHidden()
end sub

sub onCollectionsLoaded(event as object)
    items = event.getData()
    showLoading(false)

    m.collections = []

    content = createSGNode("ContentNode")

    ' "Create New Collection" always first
    newItem = content.createChild("ContentNode")
    newItem.title = "+ Create New Collection"
    m.collections.push({ id: "__new__", name: "+ Create New Collection" })

    if isValid(items)
        for each item in items
            child = content.createChild("ContentNode")
            child.title = item.Title
            m.collections.push({ id: item.id, name: item.Title })
        end for
    end if

    m.collectionList.content = content
    m.collectionList.setFocus(true)
end sub

sub onListItemSelected(event as object)
    index = event.getData()
    if not isValid(index) or index < 0 or index >= m.collections.Count() then return

    selected = m.collections[index]

    if selected.id = "__new__"
        promptCreateNew()
    else
        addToCollection(selected.id, selected.name)
    end if
end sub

sub promptCreateNew()
    dialog = createObject("roSGNode", "Dialog")
    dialog.title = "New Collection"
    dialog.buttons = ["Create", "Cancel"]

    nameField = createObject("roSGNode", "ContentNode")
    nameField.addFields({ value: "" })

    keyboard = createObject("roSGNode", "MiniKeyboard")
    if not isValid(keyboard)
        ' MiniKeyboard not available: fall back to input dialog
        showStatus("MiniKeyboard not available on this device.")
        return
    end if

    ' Use a simple StandardKeyboardDialog for text input
    kbDialog = createObject("roSGNode", "StandardKeyboardDialog")
    if not isValid(kbDialog)
        showStatus("Text input not available on this device.")
        return
    end if

    kbDialog.title = "Enter Collection Name"
    kbDialog.buttons = ["Create", "Cancel"]
    kbDialog.observeField("buttonSelected", "onKeyboardDialogButton")

    m.keyboardDialog = kbDialog
    m.top.getScene().dialog = kbDialog
end sub

sub onKeyboardDialogButton(event as object)
    index = event.getData()
    if not isValid(m.keyboardDialog) then return

    collectionName = m.keyboardDialog.text
    m.top.getScene().dialog = invalid
    m.keyboardDialog = invalid

    if index = 0 and isValidAndNotEmpty(collectionName)
        createNewCollection(collectionName)
    end if
end sub

sub addToCollection(collectionId as string, collectionName as string)
    showStatus("Adding to " + collectionName + "...")

    m.actionTask.action = "addToCollection"
    m.actionTask.collectionId = collectionId
    m.actionTask.itemId = m.top.itemId
    m.actionTask.control = TaskControl.RUN
end sub

sub createNewCollection(name as string)
    showStatus("Creating collection " + chr(34) + name + chr(34) + "...")

    m.actionTask.action = "createCollection"
    m.actionTask.collectionName = name
    m.actionTask.itemId = m.top.itemId
    m.actionTask.control = TaskControl.RUN
end sub

sub onActionComplete(event as object)
    success = event.getData()
    if success
        showStatus("Done!")
        m.top.actionComplete = true

        ' Brief pause before popping — let user see confirmation
        m.closeTimer = createObject("roSGNode", "Timer")
        m.closeTimer.duration = 1.2
        m.closeTimer.repeat = false
        m.closeTimer.observeField("fire", "onCloseTimer")
        m.closeTimer.control = "start"
    else
        showStatus("Failed. Please try again.")
    end if
end sub

sub onCloseTimer(_event as object)
    m.global.sceneManager.callFunc("popScene")
end sub

sub showLoading(visible as boolean)
    m.loadingGroup.visible = visible
    m.collectionList.visible = not visible
end sub

sub showStatus(text as string)
    m.statusText.text = text
    m.statusGroup.visible = true
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

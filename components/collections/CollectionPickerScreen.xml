<?xml version="1.0" encoding="utf-8"?>
<component name="CollectionPickerScreen" extends="JFScreen">
    <interface>
        <field id="itemId" type="string" value="" />
        <field id="actionComplete" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Text id="pageTitle"
            translation="[96, 30]"
            font="font:LargeBoldSystemFont"
            color="#FFFFFF"
            text="Add to Collection" />

        <Text id="pageSubtitle"
            translation="[96, 80]"
            font="font:MediumSystemFont"
            color="#AAAAAA"
            text="Choose an existing collection or create a new one" />

        <LabelList id="collectionList"
            translation="[96, 130]"
            itemSize="[800, 60]"
            itemSpacing="[0, 4]"
            numRows="12"
            drawFocusFeedback="true"
            focusBitmapUri="pkg:/images/hd_focus.9.png"
            focusBitmapBlendColor="#00A4DCFF"
            font="font:MediumSystemFont"
            color="#FFFFFF" />

        <LayoutGroup id="loadingGroup"
            translation="[960, 540]"
            layoutDirection="vert"
            horizAlignment="center"
            visible="false">
            <Spinner id="loadingSpinner" />
            <Text text="Loading..." font="font:MediumSystemFont" color="#FFFFFF" translation="[0, 20]" />
        </LayoutGroup>

        <LayoutGroup id="statusGroup"
            translation="[96, 780]"
            layoutDirection="vert"
            visible="false">
            <Text id="statusText" font="font:MediumSystemFont" color="#FFFFFF" />
        </LayoutGroup>
    </children>
</component>

import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "runAction"
end sub

sub runAction()
    action = m.top.action

    if action = "addToCollection"
        result = api.collections.AddItems(m.top.collectionId, { Ids: m.top.itemId })
        m.top.success = (result <> invalid)

    else if action = "createCollection"
        result = api.collections.Create({
            Name: m.top.collectionName,
            Ids: m.top.itemId,
            IsLocked: false
        })
        if isValid(result) and isChainValid(result, "Id")
            m.top.resultCollectionId = result.Id
            m.top.success = true
        else
            m.top.success = false
            m.top.error = "Failed to create collection"
        end if

    else if action = "removeFromCollection"
        result = api.collections.DeleteItems(m.top.collectionId, { Ids: m.top.itemId })
        m.top.success = (result <> invalid)

    else if action = "deleteCollection"
        req = APIRequest(Substitute("/Items/{0}", m.top.collectionId))
        result = deleteVoid(req)
        m.top.success = (result <> invalid)

    else if action = "renameCollection"
        itemData = api.items.GetByID(m.top.collectionId, { userId: m.global.session.user.id })
        if isValid(itemData)
            itemData.Name = m.top.collectionName
            req = APIRequest(Substitute("/Items/{0}", m.top.collectionId))
            postJson(req, FormatJson(itemData))
            m.top.success = true
        else
            m.top.success = false
            m.top.error = "Failed to fetch collection for rename"
        end if
    end if
end sub

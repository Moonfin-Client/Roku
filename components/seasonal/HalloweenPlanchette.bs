import "pkg:/source/utils/misc.bs"

' Moves only when focus does, so it costs nothing while focus stays put

' From the planchette's center to its tip, and how far the tip reaches onto the artwork
const REACH = 37
const TIP_INSET = 5
const BUTTON_GAP = 10
const SIDEBAR_GAP = 80
const MARGIN = 45
const SCREEN_WIDTH = 1920
const SCREEN_HEIGHT = 1080

' The art points up, and Roku turns positive angles counterclockwise
const POINT_RIGHT = -1.5707963
const POINT_LEFT = 1.5707963
const HALF_TURN = 3.1415927

sub init()
    m.body = m.top.findNode("body")
    m.glide = m.top.findNode("glide")
    m.glidePosition = m.top.findNode("glidePosition")
    m.glideTurn = m.top.findNode("glideTurn")
    m.fade = m.top.findNode("fade")
    m.fadeOpacity = m.top.findNode("fadeOpacity")
    m.shown = false
    m.spot = ""
end sub

sub onTarget()
    target = m.top.target
    rect = target.rect
    if not isValid(rect) or rect.count() < 4
        if m.shown then fadeTo(0)
        m.shown = false
        return
    end if

    if target.landing = "below"
        x = rect[0] + rect[2] / 2
        y = rect[1] + rect[3] + BUTTON_GAP + REACH
        angle = 0
    else if target.landing = "right"
        x = target.edge + SIDEBAR_GAP
        y = rect[1] + rect[3] / 2
        angle = POINT_LEFT
    else
        ' Home parks the focused card at the start of its row, under the row title, so the
        ' free space is the margin to its left
        x = rect[0] + TIP_INSET - REACH
        y = rect[1] + rect[3] / 2
        angle = POINT_RIGHT
    end if
    if x < MARGIN then x = MARGIN
    if x > SCREEN_WIDTH - MARGIN then x = SCREEN_WIDTH - MARGIN
    if y < MARGIN then y = MARGIN
    if y > SCREEN_HEIGHT - MARGIN then y = SCREEN_HEIGHT - MARGIN

    ' Moving along a row asks for the same spot again, since the card stays in place
    spot = x.toStr() + " " + y.toStr() + " " + angle.toStr()
    if m.shown and spot = m.spot then return
    m.spot = spot

    if not m.shown
        ' It fades in where it lands, already pointing the right way
        m.glide.control = "stop"
        m.body.translation = [x, y]
        m.body.rotation = angle
        m.shown = true
        fadeTo(1)
        return
    end if

    from = m.body.rotation
    turn = angle - from
    while turn > HALF_TURN
        turn = turn - 2 * HALF_TURN
    end while
    while turn < -HALF_TURN
        turn = turn + 2 * HALF_TURN
    end while
    m.glide.control = "stop"
    m.glidePosition.keyValue = [m.body.translation, [x, y]]
    m.glideTurn.keyValue = [from, from + turn]
    m.glide.control = "start"
end sub

sub fadeTo(opacity as float)
    m.fade.control = "stop"
    m.fadeOpacity.keyValue = [m.body.opacity, opacity]
    m.fade.control = "start"
end sub

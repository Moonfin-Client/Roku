import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/seasonalEffects.bs"

sub init()
    m.particles = m.top.findNode("particles")
    m.resumeTimer = m.top.findNode("resumeTimer")
    m.resumeTimer.observeField("fire", "onResume")
    m.animations = []
    m.built = ""
    m.running = false
    m.held = false
    m.tier = seasonalEffects.DeviceTier()
    m.top.visible = false
    m.global.observeFieldScoped("overlaySettingsChanged", "onSettingsChanged")
end sub

' A pick in the settings panel or a sync shows straight away while home is on screen
sub onSettingsChanged()
    if m.running then play()
end sub

sub play()
    effect = seasonalEffects.ParseEffect(get_user_setting("seasonal.surprise")) ?? "none"
    density = seasonalEffects.ParseDensity(get_user_setting("seasonal.density")) ?? "normal"
    key = effect + "/" + density
    if key <> m.built
        clear()
        m.built = key
        built = seasonalEffects.Build(effect, density, seasonalEffects.NewRandom(Rnd(2147483646)), m.tier)
        for each list in [built.falling, built.flyers, built.bursts]
            for each spec in list
                addNode(m.particles, spec)
            end for
        end for
        setControl("start")
    else if not m.running
        setControl("resume")
    end if
    m.running = true
    m.top.visible = m.animations.count() > 0
end sub

sub halt()
    if m.running and not m.held then setControl("pause")
    m.resumeTimer.control = "stop"
    m.held = false
    m.running = false
    m.top.visible = false
end sub

' On a low end device every moving particle costs the rows frames while they scroll, so there
' the particles hold still while the remote is in use and carry on once it settles
sub hold()
    if m.tier <> "low" or not m.running then return
    if not m.held then setControl("pause")
    m.held = true
    m.resumeTimer.control = "stop"
    m.resumeTimer.control = "start"
end sub

sub onResume()
    if not m.held then return
    m.held = false
    setControl("resume")
end sub

sub clear()
    setControl("stop")
    m.resumeTimer.control = "stop"
    m.held = false
    m.top.removeChildren(m.animations)
    m.animations = []
    m.particles.removeChildrenIndex(m.particles.getChildCount(), 0)
end sub

sub setControl(control as string)
    for each animation in m.animations
        animation.control = control
    end for
end sub

' A node starts where its tracks do, and its tracks loop on an Animation of their own
sub addNode(parent as object, spec as object)
    node = parent.createChild(spec.subtype)
    node.setFields(spec.fields)
    if spec.tracks.count() > 0
        node.id = "seasonal" + m.animations.count().toStr()
        animation = CreateObject("roSGNode", "Animation")
        animation.duration = spec.duration
        animation.repeat = true
        animation.easeFunction = "linear"
        for each track in spec.tracks
            node[track.field] = track.values[0]
            interpolator = animation.createChild(track.interpolator)
            interpolator.fieldToInterp = node.id + "." + track.field
            interpolator.key = track.keys
            interpolator.keyValue = track.values
        end for
        m.top.appendChild(animation)
        m.animations.push(animation)
    end if
    for each child in spec.children
        addNode(node, child)
    end for
end sub

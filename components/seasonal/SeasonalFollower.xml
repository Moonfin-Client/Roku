<?xml version="1.0" encoding="utf-8"?>
<component name="SeasonalFollower" extends="Group">
  <children>
    <!-- Sits on the follower's anchor. The glide turns it, and a swing rocks what's inside. -->
    <Group id="body" opacity="0">
      <Group id="turn">
        <Group id="sway">
          <Poster id="under" visible="false" />
          <Poster id="art" />
          <Poster id="over" visible="false" />
        </Group>
      </Group>
    </Group>
    <!-- Drawn 120 wide and stretched to what it underlines -->
    <Group id="rainbow" visible="false" opacity="0" scaleRotateCenter="[60, 5]">
      <Rectangle width="20" height="10" color="0xE40303FF" />
      <Rectangle translation="[20, 0]" width="20" height="10" color="0xFF8C00FF" />
      <Rectangle translation="[40, 0]" width="20" height="10" color="0xFFED00FF" />
      <Rectangle translation="[60, 0]" width="20" height="10" color="0x008026FF" />
      <Rectangle translation="[80, 0]" width="20" height="10" color="0x004DFFFF" />
      <Rectangle translation="[100, 0]" width="20" height="10" color="0x750787FF" />
    </Group>
    <Animation id="glide" duration="0.45" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="glidePosition" key="[0.0, 1.0]" fieldToInterp="body.translation" />
      <FloatFieldInterpolator id="glideTurn" key="[0.0, 1.0]" fieldToInterp="turn.rotation" />
    </Animation>
    <Animation id="stretch" duration="0.45" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="stretchPosition" key="[0.0, 1.0]" fieldToInterp="rainbow.translation" />
      <Vector2DFieldInterpolator id="stretchScale" key="[0.0, 1.0]" fieldToInterp="rainbow.scale" />
    </Animation>
    <Animation id="swing" duration="2.4" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="swingTurn" key="[0.0, 0.15, 0.35, 0.55, 0.75, 1.0]" fieldToInterp="sway.rotation" />
    </Animation>
    <Animation id="fade" duration="0.35" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="fadeBody" key="[0.0, 1.0]" fieldToInterp="body.opacity" />
      <FloatFieldInterpolator id="fadeRainbow" key="[0.0, 1.0]" fieldToInterp="rainbow.opacity" />
    </Animation>
    <Animation id="flicker" duration="0.6" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[1.0, 0.7, 0.95, 0.8, 1.0]" fieldToInterp="over.opacity" />
      <Vector2DFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[[1, 1], [0.94, 1.08], [1.04, 0.95], [0.97, 1.05], [1, 1]]" fieldToInterp="over.scale" />
    </Animation>
    <Animation id="breathe" duration="3" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.7, 1.0, 0.7]" fieldToInterp="under.opacity" />
    </Animation>
  </children>
  <interface>
    <!-- Which follower to draw, such as planchette, sleigh or rainbow -->
    <field id="style" type="string" onChange="onStyle" />
    <!-- What to point at. landing is card (from the card's left), below (under a top bar
         button) or right (beside the sidebar, whose right edge is edge), and rect is the
         focused [x, y, width, height]. A target without a rect fades it away. -->
    <field id="target" type="assocarray" onChange="onTarget" />
    <!-- False while Home is covered, which holds its loops still -->
    <field id="running" type="boolean" value="true" onChange="onRunning" />
  </interface>
</component>

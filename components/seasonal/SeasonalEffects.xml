<?xml version="1.0" encoding="utf-8"?>
<component name="SeasonalEffects" extends="Group">
  <children>
    <Group id="particles" />
    <Timer id="resumeTimer" duration="0.7" repeat="false" />
  </children>
  <interface>
    <!-- Builds the effect named in the settings, or keeps the one already built, and runs it -->
    <function name="play" />
    <!-- Holds the particles where they are while the screen is covered -->
    <function name="halt" />
    <!-- Called as the rows move, so a low end device can hold the particles still -->
    <function name="hold" />
  </interface>
</component>

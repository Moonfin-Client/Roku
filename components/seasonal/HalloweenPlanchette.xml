<?xml version="1.0" encoding="utf-8"?>
<component name="HalloweenPlanchette" extends="Group">
  <children>
    <!-- Centered on the planchette, so it turns about its middle -->
    <Group id="body" opacity="0">
      <Poster uri="pkg:/images/seasonal/planchette.png" width="94" height="94" translation="[-47, -47]" />
    </Group>
    <Animation id="glide" duration="0.45" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="glidePosition" key="[0.0, 1.0]" fieldToInterp="body.translation" />
      <FloatFieldInterpolator id="glideTurn" key="[0.0, 1.0]" fieldToInterp="body.rotation" />
    </Animation>
    <Animation id="fade" duration="0.35" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="fadeOpacity" key="[0.0, 1.0]" fieldToInterp="body.opacity" />
    </Animation>
  </children>
  <interface>
    <!-- What to point at. landing is card (from the card's left), below (under a top bar
         button) or right (beside the sidebar, whose right edge is edge), and rect is the
         focused [x, y, width, height]. A target without a rect fades it away. -->
    <field id="target" type="assocarray" onChange="onTarget" />
  </interface>
</component>

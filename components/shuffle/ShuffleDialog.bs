import "pkg:/source/api/Image.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/trackDialog.bs"

const POSTER_COUNT = 5
const POSTER_WIDTH = 220
const POSTER_HEIGHT = 330
const POSTER_GAP = 30
const POSTER_FOCUS_SCALE = 1.12
const ROW_WIDTH = 1528
const TICKS_PER_MINUTE = 600000000

sub init()
    m.posterGroups = []
    m.posterScales = []
    m.posterImages = []
    m.posterFocusRings = []
    m.posterFocusIndex = 0
    for i = 0 to POSTER_COUNT - 1
        m.posterGroups.push(m.top.findNode("posterGroup" + i.ToStr()))
        m.posterScales.push(m.top.findNode("posterScale" + i.ToStr()))
        m.posterImages.push(m.top.findNode("posterImg" + i.ToStr()))
        m.posterFocusRings.push(m.top.findNode("posterFocus" + i.ToStr()))
    end for

    m.posterRow = m.top.findNode("posterRow")
    m.filterSummary = m.top.findNode("filterSummary")
    m.stateGroup = m.top.findNode("stateGroup")
    m.stateLabel = m.top.findNode("stateLabel")
    m.retryBtn = m.top.findNode("retryBtn")
    m.infoPanel = m.top.findNode("infoPanel")
    m.itemTitle = m.top.findNode("itemTitle")
    m.metaLine = m.top.findNode("metaLine")
    m.ratingsRow = m.top.findNode("shuffleRatings")
    m.overviewLabel = m.top.findNode("overviewLabel")

    m.libraryShuffleBtn = m.top.findNode("libraryShuffleBtn")
    m.randomShuffleBtn = m.top.findNode("randomShuffleBtn")
    m.genresShuffleBtn = m.top.findNode("genresShuffleBtn")

    m.libraryShuffleBtn.observeField("buttonSelected", "onLibraryShuffleSelected")
    m.randomShuffleBtn.observeField("buttonSelected", "onRandomShuffleSelected")
    m.genresShuffleBtn.observeField("buttonSelected", "onGenresShuffleSelected")
    m.retryBtn.observeField("buttonSelected", "onRetrySelected")

    applyChrome()
    placePosters(POSTER_COUNT)

    m.top.id = "ShuffleDialog"
    m.shuffleItems = []
    m.currentFilters = {}
    m.restoreFocusButton = m.randomShuffleBtn

    for i = 0 to POSTER_COUNT - 1
        m.posterGroups[i].observeField("focusedChild", "onPosterFocusChanged")
    end for

    m.top.observeField("contentType", "onContentTypeChanged")
end sub

' Every colour the panel draws comes from the theme rather than the markup
sub applyChrome()
    themed = themeChrome.IsActive()
    onSurface = themeChrome.OnSurface()
    accent = themeChrome.Accent()

    panelBg = m.top.findNode("panelBg")
    panelBg.blendColor = themed ? themeChrome.Surface() : trackDialog.PANEL_INK
    panelBg.opacity = trackDialog.PANEL_OPACITY
    m.top.findNode("panelBorder").blendColor = onSurface

    m.top.findNode("badgeBg").blendColor = accent
    m.top.findNode("badgeLabel").color = onSurface
    m.filterSummary.color = onSurface
    m.filterSummary.opacity = 0.7

    m.top.findNode("infoBg").blendColor = themed ? themeChrome.SurfaceVariant() : "#000000"
    m.top.findNode("infoBorder").blendColor = onSurface

    m.itemTitle.color = onSurface
    m.metaLine.color = onSurface
    m.metaLine.opacity = 0.82
    m.overviewLabel.color = onSurface
    m.overviewLabel.opacity = 0.9
    m.stateLabel.color = onSurface

    for each ring in m.posterFocusRings
        ring.blendColor = accent
    end for

    ' Every action rests on the same surface so that focus, and only focus, reads as lit,
    ' and a focused label takes the ink that sits on the cursor rather than on the panel
    btnBackground = themed ? themeChrome.SurfaceVariant() : chainLookupReturn(m.global.session, "user.settings.colorDialogBackground", ColorPalette.ELEMENTBACKGROUND)
    for each btn in [m.libraryShuffleBtn, m.randomShuffleBtn, m.genresShuffleBtn, m.retryBtn]
        btn.color = onSurface
        btn.focusColor = themeChrome.OnAccent()
        btn.background = btnBackground
        btn.focusBackground = accent
    end for
end sub

' Fewer picks than slots still sit in the middle of the panel
sub placePosters(count as integer)
    if count < 1 then count = 1
    rowWidth = (count * POSTER_WIDTH) + ((count - 1) * POSTER_GAP)
    startX = (ROW_WIDTH - rowWidth) / 2

    for i = 0 to POSTER_COUNT - 1
        m.posterGroups[i].translation = [36 + startX + (i * (POSTER_WIDTH + POSTER_GAP)), 0]
    end for
end sub

sub onContentTypeChanged()
    contentType = m.top.contentType
    if not isValidAndNotEmpty(contentType) then contentType = "both"
    m.currentFilters.contentType = contentType
    updateFilterSummary()
    loadShuffleItems()
end sub

sub loadShuffleItems()
    if isValid(m.shuffleTask)
        m.shuffleTask.unobserveField("results")
        m.shuffleTask.control = TaskControl.STOP
    end if

    clearRatings()
    showState(tr("Loading your library..."), false)

    m.shuffleTask = CreateObject("roSGNode", "ShuffleLoadTask")
    m.shuffleTask.userId = m.global.session.user.id
    m.shuffleTask.contentType = m.currentFilters.contentType
    m.shuffleTask.libraryId = m.currentFilters.libraryId
    m.shuffleTask.genreIds = m.currentFilters.genreIds
    m.shuffleTask.observeField("results", "onShuffleItemsLoaded")
    m.shuffleTask.control = TaskControl.RUN
end sub

sub onShuffleItemsLoaded(event as object)
    items = event.getData()
    failed = m.shuffleTask.loadFailed

    if not isValid(items) or items.Count() = 0
        m.shuffleItems = []
        clearPosters()
        if failed
            showState(tr("Unable to connect to server"), true)
        else
            showState(tr("No items found"), false)
        end if
        m.restoreFocusButton.setFocus(true)
        return
    end if

    m.shuffleItems = items
    populatePosters(items)
    hideState()

    m.posterFocusIndex = 0
    updateItemDetails(0)
    m.posterGroups[0].setFocus(true)
end sub

sub populatePosters(items as object)
    count = items.Count()
    placePosters(count)

    for i = 0 to POSTER_COUNT - 1
        if i < count
            m.posterImages[i].uri = ImageURL(items[i].Id, ImageType.PRIMARY, { "maxHeight": POSTER_HEIGHT, "maxWidth": POSTER_WIDTH })
            m.posterGroups[i].visible = true
        else
            m.posterImages[i].uri = ""
            m.posterGroups[i].visible = false
        end if
        applyPosterFocus(i, false)
    end for
end sub

sub clearPosters()
    for i = 0 to POSTER_COUNT - 1
        m.posterImages[i].uri = ""
        m.posterGroups[i].visible = false
    end for
end sub

sub applyPosterFocus(index as integer, focused as boolean)
    m.posterScales[index].scale = focused ? [POSTER_FOCUS_SCALE, POSTER_FOCUS_SCALE] : [1.0, 1.0]
    m.posterImages[index].opacity = focused ? 1.0 : 0.6
    m.posterFocusRings[index].visible = focused
end sub

sub showState(message as string, offerRetry as boolean)
    m.stateLabel.text = message
    m.retryBtn.visible = offerRetry
    m.stateGroup.visible = true
    m.posterRow.visible = false
    m.infoPanel.visible = false
end sub

sub hideState()
    m.stateGroup.visible = false
    m.retryBtn.visible = false
    m.posterRow.visible = true
    m.infoPanel.visible = true
end sub

function formatRuntime(ticks as dynamic) as string
    if not isValid(ticks) or ticks <= 0 then return ""

    totalMinutes = Int(ticks / TICKS_PER_MINUTE)
    if totalMinutes <= 0 then return ""

    hours = Int(totalMinutes / 60)
    minutes = totalMinutes Mod 60
    if hours > 0 then return `${hours.ToStr()}h ${minutes.ToStr()}m`
    return `${minutes.ToStr()}m`
end function

' Rating, year, runtime and a few genres, with anything the item lacks left out
function infoBits(item as object) as object
    bits = []

    officialRating = item.LookupCI("officialrating")
    if isValidAndNotEmpty(officialRating) then bits.push(officialRating)

    year = item.LookupCI("productionyear")
    if isValid(year) and year > 0 then bits.push(year.ToStr())

    runtime = formatRuntime(item.LookupCI("runtimeticks"))
    if runtime <> "" then bits.push(runtime)

    genres = item.LookupCI("genres")
    if isValidAndNotEmpty(genres)
        named = []
        for each genre in genres
            named.push(genre)
            if named.Count() >= 3 then exit for
        end for
        bits.push(named.join(", "))
    end if

    return bits
end function

sub updateItemDetails(index as integer)
    if index < 0 or index >= m.shuffleItems.Count()
        m.itemTitle.text = tr("No items found")
        m.metaLine.text = ""
        m.overviewLabel.text = tr("Discover a random item from your library.")
        clearRatings()
        return
    end if

    item = m.shuffleItems[index]

    title = item.LookupCI("name")
    m.itemTitle.text = isValidAndNotEmpty(title) ? title : tr("No items found")

    m.metaLine.text = infoBits(item).join(" · ")

    overview = item.LookupCI("overview")
    m.overviewLabel.text = isValidAndNotEmpty(overview) ? overview : tr("Discover a random item from your library.")

    fetchRatings(item)
end sub

' ===== Ratings =====

sub fetchRatings(item as object)
    m.ratingsRow.visible = false
    m.ratingsRow.ratingsData = invalid

    if not isValid(item.LookupCI("type")) then return
    if not isValidAndNotEmpty(moonfinPlugin.GetTmdbId(item.LookupCI("providerids"))) then return

    m.pendingRatingsItem = item
    m.ratingsDebounce = moonfinPlugin.StartRatingsDebounce(m.ratingsDebounce, "onRatingsDebounceFired")
end sub

sub onRatingsDebounceFired()
    item = m.pendingRatingsItem
    m.pendingRatingsItem = invalid
    if not isValid(item) then return

    if isValid(m.ratingsTask)
        m.ratingsTask.unobserveFieldScoped("ratings")
        m.ratingsTask = invalid
    end if

    m.ratingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.ratingsTask.itemData = item
    m.ratingsTask.observeFieldScoped("ratings", "onRatingsLoaded")
    m.ratingsTask.control = TaskControl.RUN
end sub

sub onRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) or not isValidAndNotEmpty(result.data) then return

    m.ratingsRow.ratingsData = result
    m.ratingsRow.visible = true
end sub

sub clearRatings()
    m.ratingsRow.visible = false
    m.ratingsRow.ratingsData = invalid
    m.pendingRatingsItem = invalid

    if isValid(m.ratingsDebounce) then m.ratingsDebounce.control = "stop"
    if isValid(m.ratingsTask)
        m.ratingsTask.unobserveFieldScoped("ratings")
        m.ratingsTask = invalid
    end if
end sub

sub onPosterFocusChanged()
    for i = 0 to POSTER_COUNT - 1
        if m.posterGroups[i].isInFocusChain()
            if i <> m.posterFocusIndex and m.posterFocusIndex >= 0 and m.posterFocusIndex < POSTER_COUNT
                applyPosterFocus(m.posterFocusIndex, false)
            end if
            m.posterFocusIndex = i
            applyPosterFocus(i, true)
            updateItemDetails(i)
            return
        end if
    end for

    if m.posterFocusIndex >= 0 and m.posterFocusIndex < POSTER_COUNT
        applyPosterFocus(m.posterFocusIndex, false)
        m.posterFocusIndex = -1
    end if
end sub

' ===== The three shuffles =====

sub onLibraryShuffleSelected()
    m.restoreFocusButton = m.libraryShuffleBtn
    openPicker("libraries", tr("Select Library"), tr("No libraries found"), "onLibraryPicked")
end sub

sub onRandomShuffleSelected()
    m.restoreFocusButton = m.randomShuffleBtn
    applyFilter("", "", "", "")
end sub

sub onGenresShuffleSelected()
    m.restoreFocusButton = m.genresShuffleBtn
    openPicker("genres", tr("Select Genre"), tr("No genres found"), "onGenrePicked")
end sub

sub onRetrySelected()
    loadShuffleItems()
end sub

' A library and a genre are never in force together, so setting one clears the other
sub applyFilter(libraryId as string, libraryName as string, genreIds as string, genreName as string)
    m.currentFilters.libraryId = libraryId
    m.currentFilters.libraryName = libraryName
    m.currentFilters.genreIds = genreIds
    m.currentFilters.genreName = genreName
    updateFilterSummary()
    loadShuffleItems()
end sub

sub updateFilterSummary()
    if isValidAndNotEmpty(m.currentFilters.libraryName)
        m.filterSummary.text = Substitute(tr("Library: ^0"), m.currentFilters.libraryName)
    else if isValidAndNotEmpty(m.currentFilters.genreName)
        m.filterSummary.text = Substitute(tr("Genre: ^0"), m.currentFilters.genreName)
    else
        m.filterSummary.text = tr("All Libraries")
    end if
end sub

' ===== The filter pickers =====

sub openPicker(mode as string, title as string, emptyMessage as string, callback as string)
    m.pickerTitle = title
    m.pickerEmptyMessage = emptyMessage
    m.pickerCallback = callback

    showState(tr("Loading..."), false)

    m.pickerLoadTask = CreateObject("roSGNode", "ShuffleLoadTask")
    m.pickerLoadTask.mode = mode
    m.pickerLoadTask.userId = m.global.session.user.id
    m.pickerLoadTask.contentType = m.currentFilters.contentType
    m.pickerLoadTask.observeField("resultsData", "onPickerListLoaded")
    m.pickerLoadTask.control = TaskControl.RUN
end sub

sub onPickerListLoaded(event as object)
    hideState()

    contentData = event.getData()
    m.pickerEntries = []
    options = []

    if isValid(contentData) and isValid(contentData.data)
        for each entry in contentData.data
            m.pickerEntries.push(entry)
            options.push(entry.description)
        end for
    end if

    options.push(tr("Cancel"))

    m.picker = CreateObject("roSGNode", "ListPromptDialog")
    m.picker.dialogTitle = m.pickerTitle
    m.picker.message = m.pickerEntries.Count() = 0 ? m.pickerEmptyMessage : ""
    m.picker.options = options
    m.picker.returnFocus = m.restoreFocusButton
    m.picker.observeField("optionSelected", m.pickerCallback)

    m.top.getScene().appendChild(m.picker)
    m.picker.callFunc("showDialog")
end sub

function pickedEntry(event as object) as object
    index = event.getData()
    closePicker()

    if index < 0 or index >= m.pickerEntries.Count() then return invalid
    return m.pickerEntries[index]
end function

sub closePicker()
    if not isValid(m.picker) then return

    m.picker.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.picker)
    m.picker = invalid
end sub

sub onLibraryPicked(event as object)
    entry = pickedEntry(event)
    if not isValid(entry) then return

    applyFilter(entry.value, entry.description, "", "")
end sub

sub onGenrePicked(event as object)
    entry = pickedEntry(event)
    if not isValid(entry) then return

    applyFilter("", "", entry.value, entry.description)
end sub

function convertItemForNavigation(itemData as object) as dynamic
    if itemData = invalid then return invalid

    tmp = CreateObject("roSGNode", "ContentNode")
    tmp.id = itemData.LookupCI("id")
    tmp.title = itemData.LookupCI("name")
    tmp.addFields({ type: itemData.LookupCI("type") })
    return tmp
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        clearRatings()
        m.top.shuffleDialogClosed = true
        return true
    end if

    if key = KeyCode.LEFT
        if m.posterFocusIndex >= 0 and m.posterFocusIndex < POSTER_COUNT
            newIndex = m.posterFocusIndex - 1
            if newIndex >= 0 then m.posterGroups[newIndex].setFocus(true)
            return true
        end if

        if m.randomShuffleBtn.isInFocusChain()
            m.libraryShuffleBtn.setFocus(true)
        else if m.genresShuffleBtn.isInFocusChain()
            m.randomShuffleBtn.setFocus(true)
        end if
        return true
    end if

    if key = KeyCode.RIGHT
        if m.posterFocusIndex >= 0 and m.posterFocusIndex < POSTER_COUNT
            newIndex = m.posterFocusIndex + 1
            if newIndex < POSTER_COUNT and newIndex < m.shuffleItems.Count()
                m.posterGroups[newIndex].setFocus(true)
            end if
            return true
        end if

        if m.libraryShuffleBtn.isInFocusChain()
            m.randomShuffleBtn.setFocus(true)
        else if m.randomShuffleBtn.isInFocusChain()
            m.genresShuffleBtn.setFocus(true)
        end if
        return true
    end if

    if key = KeyCode.DOWN and m.posterFocusIndex >= 0 and m.posterFocusIndex < POSTER_COUNT
        applyPosterFocus(m.posterFocusIndex, false)
        m.randomShuffleBtn.setFocus(true)
        return true
    end if

    if key = KeyCode.UP
        if m.retryBtn.isInFocusChain() then return true

        if m.libraryShuffleBtn.isInFocusChain() or m.randomShuffleBtn.isInFocusChain() or m.genresShuffleBtn.isInFocusChain()
            if m.shuffleItems.Count() = 0 then return true

            target = m.posterFocusIndex
            if target < 0 or target >= m.shuffleItems.Count() then target = 0
            m.posterGroups[target].setFocus(true)
            return true
        end if
    end if

    if key = KeyCode.OK
        for i = 0 to POSTER_COUNT - 1
            if m.posterGroups[i].isInFocusChain() and i < m.shuffleItems.Count()
                navNode = convertItemForNavigation(m.shuffleItems[i])
                if isValid(navNode)
                    clearRatings()
                    m.top.selectedItem = navNode
                end if
                return true
            end if
        end for

        return true
    end if

    return false
end function

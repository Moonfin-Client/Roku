<?xml version="1.0" encoding="utf-8"?>
<!-- The random picks the navbar shuffle offers -->
<component name="ShuffleDialog" extends="Group" initialFocus="posterGroup0">
    <children>
        <Rectangle id="shuffleBackdrop" width="1920" height="1080" color="#000000" opacity="0.7" />

        <Group id="panel" translation="[160, 70]">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" width="1600" height="940" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="1600" height="940"
                blendColor="#FFFFFF" opacity="0.16" />

            <!-- Which shuffle is in force, so the filter is never a mystery -->
            <Group id="topStrip" translation="[36, 36]">
                <Poster id="badgeBg" uri="pkg:/images/tracks/panel20.9.png" width="260" height="40" opacity="0.2" />
                <Label id="badgeLabel" text="RANDOM SHUFFLE" font="font:SmallestBoldSystemFont"
                    width="260" height="40" horizAlign="center" vertAlign="center" />
                <Label id="filterSummary" font="font:SmallSystemFont"
                    width="1268" height="40" horizAlign="right" vertAlign="center" translation="[260, 0]" />
            </Group>

            <!-- Placed by hand rather than laid out, so the focused poster can grow over its
                 neighbours without the row shifting under it -->
            <Group id="posterRow" translation="[0, 110]">
                <Group id="posterGroup0">
                    <Group id="posterScale0" scaleRotateCenter="[110, 165]">
                        <Poster id="posterImg0" width="220" height="330" loadDisplayMode="scaleToZoom" />
                        <Poster id="posterFocus0" width="220" height="330" uri="pkg:/images/posterFocus.9.png" visible="false" />
                    </Group>
                </Group>
                <Group id="posterGroup1">
                    <Group id="posterScale1" scaleRotateCenter="[110, 165]">
                        <Poster id="posterImg1" width="220" height="330" loadDisplayMode="scaleToZoom" />
                        <Poster id="posterFocus1" width="220" height="330" uri="pkg:/images/posterFocus.9.png" visible="false" />
                    </Group>
                </Group>
                <Group id="posterGroup2">
                    <Group id="posterScale2" scaleRotateCenter="[110, 165]">
                        <Poster id="posterImg2" width="220" height="330" loadDisplayMode="scaleToZoom" />
                        <Poster id="posterFocus2" width="220" height="330" uri="pkg:/images/posterFocus.9.png" visible="false" />
                    </Group>
                </Group>
                <Group id="posterGroup3">
                    <Group id="posterScale3" scaleRotateCenter="[110, 165]">
                        <Poster id="posterImg3" width="220" height="330" loadDisplayMode="scaleToZoom" />
                        <Poster id="posterFocus3" width="220" height="330" uri="pkg:/images/posterFocus.9.png" visible="false" />
                    </Group>
                </Group>
                <Group id="posterGroup4">
                    <Group id="posterScale4" scaleRotateCenter="[110, 165]">
                        <Poster id="posterImg4" width="220" height="330" loadDisplayMode="scaleToZoom" />
                        <Poster id="posterFocus4" width="220" height="330" uri="pkg:/images/posterFocus.9.png" visible="false" />
                    </Group>
                </Group>
            </Group>

            <!-- Whatever stands in for the row while it loads, fails or comes back empty -->
            <Group id="stateGroup" translation="[36, 230]" visible="false">
                <Label id="stateLabel" font="font:MediumBoldSystemFont"
                    width="1528" horizAlign="center" />
                <StandardButton id="retryBtn" text="Try Again" width="260" height="70" fontSize="22"
                    translation="[634, 60]" visible="false" />
            </Group>

            <Group id="infoPanel" translation="[36, 460]">
                <Poster id="infoBg" uri="pkg:/images/tracks/panel20.9.png" width="1528" height="316"
                    blendColor="#000000" opacity="0.34" />
                <Poster id="infoBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="1528" height="316"
                    blendColor="#FFFFFF" opacity="0.12" />

                <Label id="itemTitle" font="font:LargeBoldSystemFont"
                    width="1480" height="52" translation="[24, 20]" wrap="false" />
                <Label id="metaLine" font="font:SmallSystemFont"
                    width="1480" height="32" translation="[24, 78]" wrap="false" />
                <RatingsRow id="shuffleRatings" translation="[24, 116]" visible="false"
                    iconHeight="22" labelColor="#aaaaaa" ratingSpacing="16" />
                <Label id="overviewLabel" font="font:SmallSystemFont"
                    width="1480" translation="[24, 166]" wrap="true" maxLines="3" lineSpacing="6" />
            </Group>

            <LayoutGroup id="buttonRow" layoutDirection="horiz" horizAlignment="left"
                itemSpacings="[16]" translation="[37, 800]">
                <StandardButton id="libraryShuffleBtn" text="LIBRARY SHUFFLE" width="498" height="80" fontSize="24" />
                <StandardButton id="randomShuffleBtn" text="RANDOM SHUFFLE" width="498" height="80" fontSize="24" />
                <StandardButton id="genresShuffleBtn" text="GENRES SHUFFLE" width="498" height="80" fontSize="24" />
            </LayoutGroup>
        </Group>
    </children>
    <interface>
        <field id="contentType" type="string" />
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="shuffleDialogClosed" type="boolean" alwaysNotify="true" />
    </interface>
</component>

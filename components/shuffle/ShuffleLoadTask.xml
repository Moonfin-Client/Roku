<?xml version="1.0" encoding="utf-8"?>

<component name="ShuffleLoadTask" extends="Task">
    <interface>
        <field id="userId" type="string" />
        <field id="contentType" type="string" />
        <field id="libraryId" type="string" />
        <field id="genreIds" type="string" />
        <field id="mode" type="string" />
        <field id="results" type="array" />
        <!-- Set when the request itself failed, so an empty row can say which it was -->
        <field id="loadFailed" type="boolean" value="false" />
        <field id="resultsData" type="assocarray" />
    </interface>
</component>

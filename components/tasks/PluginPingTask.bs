import "pkg:/source/api/MoonfinPlugin.bs"

sub init()
    m.top.functionName = "pingPlugin"
end sub

sub pingPlugin()
    result = moonfinPlugin.Ping()
    if isValid(result)
        result.addReplace("success", true)
        ' Asked for here, since the render thread that reads the result can't make the request
        if toBoolean(result.seerrEnabled ?? false) = true then result.addReplace("seerrDisplayName", moonfinPlugin.SeerrDisplayName())
        m.top.result = result
    else
        m.top.result = { success: false }
    end if
end sub

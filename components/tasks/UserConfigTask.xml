<?xml version="1.0" encoding="utf-8"?>
<!-- Writes a few fields of the signed in user's configuration, starting from the configuration as
     the server holds it now -->
<component name="UserConfigTask" extends="Task">
    <interface>
        <!-- Configuration field names to the values they take -->
        <field id="changes" type="assocarray" />
        <field id="ok" type="boolean" alwaysNotify="true" />
    </interface>
</component>

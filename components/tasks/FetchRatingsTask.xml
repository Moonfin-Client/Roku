<?xml version="1.0" encoding="utf-8"?>
<component name="FetchRatingsTask" extends="Task">
    <interface>
        <!-- Preferred input: the raw item json; the task derives type/ids/routing -->
        <field id="itemData" type="assocarray" />
        <!-- Pre-derived fallbacks for callers without the raw json (e.g. MediaBar) -->
        <field id="itemId" type="string" />
        <field id="itemType" type="string" />
        <field id="tmdbId" type="string" />
        <field id="ratings" type="assocarray" />
    </interface>
</component>
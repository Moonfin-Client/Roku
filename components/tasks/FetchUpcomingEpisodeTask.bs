import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/upcomingEpisode.bs"

sub init()
    m.top.functionName = "resolveUpcomingText"
end sub

sub resolveUpcomingText()
    itemData = m.top.itemData
    if not isValid(itemData) or itemData.count() = 0
        m.top.text = ""
        return
    end if

    info = upcomingEpisode.lookup(itemData)
    m.top.info = info ?? {}
    m.top.text = upcomingEpisode.FormatUpcomingEpisode(info)
end sub

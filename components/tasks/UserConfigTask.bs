import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"

sub init()
    m.top.functionName = "saveChanges"
end sub

sub saveChanges()
    m.top.ok = writeChanges()
end sub

' The server replaces the whole configuration on every write, so the write starts from the one it
' holds now. A copy from sign in would put back anything another app changed since.
function writeChanges() as boolean
    userId = chainLookupReturn(m.global, "session.user.id", "")
    if not isValidAndNotEmpty(userId) then return false

    user = getJson(APIRequest("/Users/" + userId))
    if not isChainValid(user, "Configuration") then return false

    configuration = user.Configuration
    configuration.Append(m.top.changes)

    req = APIRequest("/Users/Configuration", { userId: userId })
    if not isValid(req) then return false
    req.AddHeader("Content-Type", "application/json")
    status = requestResponse(req, "POST", FormatJson(configuration)).status
    if status < 200 or status >= 300 then return false

    session.user.Update("Configuration", configuration)
    return true
end function

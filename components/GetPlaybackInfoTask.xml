<?xml version="1.0" encoding="utf-8"?>

<component name="GetPlaybackInfoTask" extends="Task">
    <interface>
        <field id="videoID" type="string" />
        <!-- The item the session reports as playing, which differs from videoID for another version -->
        <field id="itemId" type="string" />
        <!-- What the player is playing, read when the panel opens -->
        <field id="mediaSourceId" type="string" />
        <field id="url" type="string" />
        <field id="isTranscoded" type="boolean" />
        <field id="audioIndex" type="integer" value="-1" />
        <field id="subtitleIndex" type="integer" value="-1" />
        <field id="subtitleBurnedIn" type="boolean" />
        <field id="isLive" type="boolean" />
        <field id="channel" type="assocarray" />
        <field id="program" type="string" />
        <field id="data" type="assocarray" />
        <!-- Multi-server support fields -->
        <field id="serverUrl" type="string" value="" />
        <field id="serverUserId" type="string" value="" />
        <field id="serverAuthToken" type="string" value="" />
    </interface>
</component>

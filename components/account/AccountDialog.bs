import "pkg:/source/api/userauth.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const ACTIONS_Y = 945
const ACTION_GAP = 20

sub init()
    m.carousel = m.top.findNode("carousel")
    m.carousel.observeField("activated", "onActivated")
    m.carousel.observeField("selected", "refreshFocus")
    m.buttonFocus = m.top.findNode("buttonFocus")
    m.removeBadge = m.top.findNode("removeBadge")
    m.removeBg = m.top.findNode("removeBg")
    m.signedInAs = m.top.findNode("signedInAs")
    m.signedInAs.font.size = 25

    removeGlyph = m.top.findNode("removeGlyph")
    removeGlyph.font.uri = settingsGlyphs.FONT_URI
    removeGlyph.font.size = 27
    removeGlyph.text = settingsGlyphs.Char("close")

    title = m.top.findNode("title")
    title.font.size = 40
    title.text = tr("Switch User")

    m.actions = []
    m.actionNames = {}
    for each action in [["addUserButton", "Add User", "add_user"], ["changeServerButton", "Select Server", "change_server"], ["signOutButton", "Sign Out", "sign_out"], ["signOutAllButton", "Sign Out All Users", "sign_out_all"]]
        button = m.top.findNode(action[0])
        button.text = tr(action[1])
        m.actions.push(button)
        m.actionNames[action[0]] = action[2]
    end for

    m.accounts = []
    m.zone = "carousel"
    m.actionIndex = 0
end sub

sub showDialog()
    m.accounts = collectAccounts()
    m.zone = "carousel"
    if m.accounts.count() = 0 then m.zone = "actions"
    m.actionIndex = 0
    m.top.visible = true

    profiles = []
    activeIndex = 0
    m.signedInAs.text = ""
    for each account in m.accounts
        if account.isActive
            activeIndex = profiles.count()
            m.signedInAs.text = Substitute(tr("Signed in as {0} on {1}"), account.username, account.serverName)
        end if
        profiles.push(profileFor(account))
    end for
    m.carousel.selected = activeIndex
    m.carousel.items = profiles

    ' Sign Out already takes a Silo profile's whole household, so Sign Out All Users is only offered
    ' for more than that, as in Moonfin Core
    household = siloHouseholdSiblings()
    others = 0
    for each account in m.accounts
        if not account.isActive and not siloContains(household, account.id) then others++
    end for
    m.top.findNode("signOutAllButton").visible = others > 0
    layoutActions()
    refreshFocus()
end sub

function profileFor(account as object) as object
    lines = [{ text: account.serverName + " · " + serverBrand(account.serverUrl) }]
    badge = ""
    if account.isActive
        lines.push({ text: tr("Active"), color: loginStyle.ACCENT_HEX })
        badge = "active"
    end if
    return { id: account.id, name: account.username, imageURL: account.imageURL, badge: badge, lines: lines }
end function

function serverBrand(serverUrl as string) as string
    serverType = toString(registry_read(serverIdentityKey(serverUrl), "ServerTypes") ?? "")
    if serverType = "emby" then return "Emby"
    if serverType = "plex" then return "Plex"
    if serverType = "silo" then return "Silo"
    return "Jellyfin"
end function

function visibleActions() as object
    shown = []
    for each button in m.actions
        if button.visible then shown.push(button)
    end for
    return shown
end function

' The buttons in a centered row along the bottom
sub layoutActions()
    shown = visibleActions()
    total = -ACTION_GAP
    for each button in shown
        total += button.drawnWidth + ACTION_GAP
    end for
    x = (1920 - total) / 2
    for each button in shown
        button.translation = [x, ACTIONS_Y]
        x += button.drawnWidth + ACTION_GAP
    end for
end sub

' Saved accounts come from the registry, and the signed in user is always shown
' even before anything has been saved
function collectAccounts() as object
    accounts = []
    serverNames = savedServerNames()
    activeId = m.global.session.user.id

    for each user in AvailableUsers()
        if not isValidAndNotEmpty(user.id) then continue for

        serverUrl = user.server ?? ""
        accounts.push({
            id: user.id,
            username: user.username ?? "",
            serverUrl: serverUrl,
            serverName: serverNames[LCase(serverUrl)] ?? serverUrl,
            imageURL: accountImageURL(serverUrl, user.id),
            isActive: isStringEqual(user.id, activeId),
            canRemove: true
        })
    end for

    if accounts.count() = 0 and isValidAndNotEmpty(activeId)
        serverUrl = m.global.session.server.url ?? ""
        accounts.push({
            id: activeId,
            username: m.global.session.user.name ?? "",
            serverUrl: serverUrl,
            serverName: serverNames[LCase(serverUrl)] ?? serverUrl,
            imageURL: accountImageURL(serverUrl, activeId),
            isActive: true,
            canRemove: false
        })
    end if

    ' By server, then by name
    for each account in accounts
        account.sortKey = LCase(account.serverName) + Chr(1) + LCase(account.username)
    end for
    accounts.SortBy("sortKey")

    ' The only account left is the one in use, so there is nothing to remove
    if accounts.count() = 1 and accounts[0].isActive then accounts[0].canRemove = false

    return accounts
end function

function savedServerNames() as object
    names = {}
    saved = ParseJson(get_setting("saved_servers", "{}"))
    if not isValid(saved) or not isValid(saved.serverList) then return names

    for each entry in saved.serverList
        if isValidAndNotEmpty(entry.baseUrl) then names[LCase(entry.baseUrl)] = entry.name
    end for

    return names
end function

' Built against the account's own server so a user on another one still resolves
function accountImageURL(serverUrl as string, userId as string) as string
    if not isValidAndNotEmpty(serverUrl) or not isValidAndNotEmpty(userId) then return ""

    params = { quality: 90, maxHeight: 150 }
    token = registry_read("token", userId) ?? ""
    if isEmbyServer(serverUrl) and isValidAndNotEmpty(token) then params.api_key = token
    return buildURLForServer(serverUrl, "Users/" + userId + "/Images/Primary", params)
end function

sub refreshFocus()
    shown = visibleActions()
    for i = 0 to shown.count() - 1
        shown[i].highlighted = m.zone = "actions" and i = m.actionIndex
    end for

    current = m.accounts[m.carousel.selected]
    m.removeBadge.visible = m.zone <> "actions" and isValid(current) and current.canRemove
    if m.zone = "remove"
        m.removeBg.blendColor = "#C62828"
    else
        m.removeBg.blendColor = "#000000B3"
    end if

    if m.zone = "carousel"
        m.carousel.setFocus(true)
    else
        m.buttonFocus.setFocus(true)
    end if
end sub

sub onActivated()
    account = m.accounts[m.carousel.activated]
    if account.isActive
        m.top.accountAction = "close"
    else
        m.top.switchToUser = { id: account.id, serverUrl: account.serverUrl }
    end if
end sub

' The carousel keeps Left, Right and OK, and the dialog swallows every other key so focus can't
' wander out of it
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.top.accountAction = "close"
        return true
    end if

    if m.zone = "carousel"
        if key = KeyCode.UP and m.removeBadge.visible
            m.zone = "remove"
        else if key = KeyCode.DOWN
            m.zone = "actions"
            m.actionIndex = 0
        end if
    else if m.zone = "remove"
        if key = KeyCode.DOWN
            m.zone = "carousel"
        else if key = KeyCode.OK
            account = m.accounts[m.carousel.selected]
            m.top.removeUserRequest = { id: account.id, username: account.username, serverName: account.serverName }
        end if
    else
        shown = visibleActions()
        if key = KeyCode.LEFT and m.actionIndex > 0
            m.actionIndex--
        else if key = KeyCode.RIGHT and m.actionIndex < shown.count() - 1
            m.actionIndex++
        else if key = KeyCode.UP and m.accounts.count() > 0
            m.zone = "carousel"
        else if key = KeyCode.OK
            m.top.accountAction = m.actionNames[shown[m.actionIndex].id]
        end if
    end if

    refreshFocus()
    return true
end function

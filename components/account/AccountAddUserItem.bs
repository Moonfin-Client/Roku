const ADD_ACCENT = "0x00A4DCFF"
const ADD_ACCENT_FILL = "0x00A4DC26"
const ADD_IDLE_FILL = "0xFFFFFF0F"
const ADD_IDLE_GLYPH = "0xFFFFFF80"
const ADD_IDLE_LABEL = "0xFFFFFFD9"

sub init()
    m.scaleGroup = m.top.findNode("scaleGroup")
    m.addCircle = m.top.findNode("addCircle")
    m.plusGlyph = m.top.findNode("plusGlyph")
    m.addLabel = m.top.findNode("addLabel")
    m.addLabel.text = tr("Add User")
end sub

sub onFocusChanged()
    if m.top.itemHasFocus
        m.scaleGroup.scale = [1.08, 1.08]
        m.addCircle.blendColor = ADD_ACCENT_FILL
        m.plusGlyph.color = ADD_ACCENT
        m.addLabel.color = ADD_ACCENT
    else
        m.scaleGroup.scale = [1.0, 1.0]
        m.addCircle.blendColor = ADD_IDLE_FILL
        m.plusGlyph.color = ADD_IDLE_GLYPH
        m.addLabel.color = ADD_IDLE_LABEL
    end if
end sub

import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.addCircle = m.top.findNode("addCircle")
    m.addRing = m.top.findNode("addRing")
    m.plusGlyph = m.top.findNode("plusGlyph")
    m.plusGlyph.font.uri = settingsGlyphs.FONT_URI
    m.plusGlyph.font.size = 80
    m.plusGlyph.text = settingsGlyphs.Char("add")
    addLabel = m.top.findNode("addLabel")
    addLabel.font.size = 33
    addLabel.text = tr("Add User")
end sub

sub onFocusChanged()
    focused = m.top.itemHasFocus
    m.addCircle.blendColor = focused ? "#00A4DC24" : "#FFFFFF0F"
    m.addRing.blendColor = focused ? loginStyle.ACCENT_HEX : "#FFFFFF40"
    m.plusGlyph.color = focused ? loginStyle.ACCENT_HEX : "#FFFFFF8A"
end sub

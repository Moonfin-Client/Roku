<?xml version="1.0" encoding="utf-8"?>
<!-- A saved account on the user switcher -->
<component name="AccountUserItem" extends="Group">
  <children>
    <Rectangle width="234" height="340" color="#00000000" />
    <Poster id="avatarBg" uri="pkg:/images/icons/circle.webp" width="207" height="207" translation="[14, 5]" blendColor="#252525" />
    <Label id="placeholder" width="207" height="207" translation="[14, 5]" horizAlign="center" vertAlign="center" color="#FFFFFF8C" />
    <MaskGroup maskUri="pkg:/images/icons/circle.webp" maskSize="[207, 207]" translation="[14, 5]">
      <Poster id="avatar" width="207" height="207" loadDisplayMode="scaleToZoom" />
    </MaskGroup>
    <Poster id="avatarRing" uri="pkg:/images/login/ring217w5.webp" width="217" height="217" translation="[9, 0]" blendColor="#FFFFFF26" />
    <Label id="userName" horizAlign="center" vertAlign="center" width="234" height="39" translation="[0, 237]" font="font:MediumSystemFont" color="#FFFFFF" />
    <Label id="serverName" horizAlign="center" vertAlign="center" width="234" height="27" translation="[0, 279]" font="font:SmallSystemFont" color="#FFFFFF73" />
    <Label id="activeBadge" horizAlign="center" vertAlign="center" width="234" height="24" translation="[0, 313]" font="font:SmallestBoldSystemFont" color="#00A4DC" visible="false" />
    <!-- Right from the focused card reaches it, since the remote has nothing to hover with -->
    <Group id="removeBadge" translation="[187, 0]" visible="false">
      <Poster id="removeBg" uri="pkg:/images/icons/circle.webp" width="47" height="47" blendColor="#000000B3" />
      <Label id="removeGlyph" width="47" height="47" horizAlign="center" vertAlign="center" color="#FFFFFFE6" />
    </Group>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
    <field id="removeFocused" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="AccountUserItem" extends="Group">
  <children>
    <!-- Scaling about the tile centre keeps the card in place as it grows -->
    <Group id="scaleGroup" scaleRotateCenter="[70, 113]">
      <Poster
        id="avatarRing"
        uri="pkg:/images/icons/circle.png"
        width="130"
        height="130"
        translation="[5, 0]"
        loadDisplayMode="scaleToFit"
        blendColor="0xFFFFFF26" />

      <Poster
        id="avatarBg"
        uri="pkg:/images/icons/circle.png"
        width="124"
        height="124"
        translation="[8, 3]"
        loadDisplayMode="scaleToFit"
        blendColor="0x2A2A2AFF" />

      <MaskGroup maskUri="pkg:/images/icons/circle.png" maskSize="[124, 124]" translation="[8, 3]">
        <Poster id="avatar" width="124" height="124" loadDisplayMode="scaleToZoom" />
      </MaskGroup>

      <Label
        id="userName"
        horizAlign="center"
        vertAlign="center"
        width="140"
        height="30"
        translation="[0, 144]"
        font="font:SmallSystemFont"
        color="0xFFFFFFD9" />

      <Label
        id="serverName"
        horizAlign="center"
        vertAlign="center"
        width="140"
        height="24"
        translation="[0, 178]"
        font="font:TinySystemFont"
        color="0xFFFFFF73" />

      <Label
        id="activeBadge"
        horizAlign="center"
        vertAlign="center"
        width="140"
        height="20"
        translation="[0, 206]"
        font="font:TinyBoldSystemFont"
        color="0x00A4DCFF"
        visible="false" />

      <!-- Only shown on the focused tile -->
      <Group id="removeBadge" translation="[112, 0]" visible="false">
        <Poster id="removeBg" uri="pkg:/images/icons/circle.png" width="28" height="28" blendColor="0x000000B3" />
        <Label id="removeGlyph" text="X" width="28" height="28" horizAlign="center" vertAlign="center"
          font="font:TinyBoldSystemFont" color="0xFFFFFF99" />
      </Group>
    </Group>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
    <field id="removeFocused" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>

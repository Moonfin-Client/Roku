<?xml version="1.0" encoding="utf-8"?>
<!-- The user switcher: every saved account in a carousel, then Add User, Select Server and the sign outs -->
<component name="AccountDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#05070EE6" />
    <!-- Takes the remote off the carousel while a button or the remove badge has it -->
    <Group id="buttonFocus" focusable="true" />
    <Label id="title" translation="[97, 63]" font="font:LargeBoldSystemFont" color="#FFFFFF" />
    <Label id="signedInAs" translation="[700, 73]" width="1123" horizAlign="right" font="font:SmallSystemFont" color="#FFFFFFA6" />
    <ProfileCarousel id="carousel" translation="[0, 290]" />
    <!-- Up from the carousel reaches it, since the remote has nothing to hover with -->
    <Group id="removeBadge" translation="[1023, 333]" visible="false">
      <Poster id="removeBg" uri="pkg:/images/icons/circle.webp" width="48" height="48" />
      <Label id="removeGlyph" width="48" height="48" horizAlign="center" vertAlign="center" color="#FFFFFFE6" />
    </Group>
    <LoginButton id="addUserButton" height="72" radius="36" padding="33" fontSize="25" iconGlyph="person" />
    <LoginButton id="changeServerButton" height="72" radius="36" padding="33" fontSize="25" iconGlyph="home" />
    <LoginButton id="signOutButton" height="72" radius="36" padding="33" fontSize="25" />
    <LoginButton id="signOutAllButton" style="danger" height="72" radius="36" padding="33" fontSize="25" />
  </children>
  <interface>
    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />
    <field id="accountAction" type="string" alwaysNotify="true" />
    <field id="switchToUser" type="assocarray" alwaysNotify="true" />
    <field id="removeUserRequest" type="assocarray" alwaysNotify="true" />
    <function name="showDialog" />
  </interface>
</component>

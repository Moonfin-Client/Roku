<?xml version="1.0" encoding="utf-8"?>
<!-- The user switcher: every saved account, Add User, then Select Server and the sign outs -->
<component name="AccountDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/login/fill33.9.png" width="1336" blendColor="#1A1A1AE6" />
      <Poster id="panelBorder" uri="pkg:/images/login/stroke33w1.9.png" width="1336" blendColor="#8EC8F054" />
      <Label id="title" translation="[40, 33]" height="39" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle translation="[0, 93]" width="1336" height="2" color="#FFFFFF14" />
      <Group id="userRowClip" translation="[40, 122]">
        <LayoutGroup id="userRow" layoutDirection="horiz" />
      </Group>
      <LoginButton id="changeServerButton" style="switcher" height="87" radius="13" fontSize="28" />
      <LoginButton id="signOutButton" style="switcher" height="87" radius="13" fontSize="28" />
      <LoginButton id="signOutAllButton" style="danger" height="87" radius="13" fontSize="28" visible="false" />
    </Group>
  </children>
  <interface>
    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />
    <field id="accountAction" type="string" alwaysNotify="true" />
    <field id="switchToUser" type="assocarray" alwaysNotify="true" />
    <field id="removeUserRequest" type="assocarray" alwaysNotify="true" />
    <function name="showDialog" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="AccountDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="0x0000004D" />

    <Poster id="panel" uri="pkg:/images/details/surface17.9.png" blendColor="0x1A1A1AFF">
      <Label
        id="title"
        font="font:MediumBoldSystemFont"
        color="0xFFFFFFFF"
        height="36"
        translation="[32, 28]" />

      <StandardButton
        id="closeButton"
        text="X"
        width="44"
        height="44"
        fontSize="24"
        outline="true"
        outlineUri="pkg:/images/playback/outline41.9.png" />

      <Group id="userRowClip">
        <LayoutGroup id="userRow" layoutDirection="horiz" />
      </Group>

      <StandardButton
        id="changeServerButton"
        height="62"
        fontSize="26"
        outline="true"
        outlineUri="pkg:/images/details/outline6.9.png" />

      <StandardButton
        id="signOutButton"
        height="62"
        fontSize="26"
        outline="true"
        outlineUri="pkg:/images/details/outline6.9.png" />

      <StandardButton
        id="signOutAllButton"
        height="62"
        fontSize="26"
        outline="true"
        outlineUri="pkg:/images/details/outline6.9.png"
        visible="false" />
    </Poster>
  </children>
  <interface>
    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />
    <field id="accountAction" type="string" alwaysNotify="true" />
    <field id="switchToUser" type="assocarray" alwaysNotify="true" />
    <field id="removeUserRequest" type="assocarray" alwaysNotify="true" />
    <function name="showDialog" />
  </interface>
</component>

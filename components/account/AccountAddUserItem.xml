<?xml version="1.0" encoding="utf-8"?>
<component name="AccountAddUserItem" extends="Group">
  <children>
    <Group id="scaleGroup" scaleRotateCenter="[70, 113]">
      <Poster
        id="addCircle"
        uri="pkg:/images/icons/circle.png"
        width="130"
        height="130"
        translation="[5, 0]"
        loadDisplayMode="scaleToFit"
        blendColor="0xFFFFFF0F" />

      <Label
        id="plusGlyph"
        text="+"
        width="130"
        height="130"
        translation="[5, 0]"
        horizAlign="center"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFF80" />

      <Label
        id="addLabel"
        horizAlign="center"
        vertAlign="center"
        width="140"
        height="30"
        translation="[0, 144]"
        font="font:SmallSystemFont"
        color="0xFFFFFFD9" />
    </Group>
  </children>
  <interface>
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Add User, at the end of the user switcher's cards -->
<component name="AccountAddUserItem" extends="Group">
  <children>
    <Rectangle width="234" height="340" color="#00000000" />
    <Poster id="addCircle" uri="pkg:/images/icons/circle.webp" width="207" height="207" translation="[14, 5]" blendColor="#FFFFFF0F" />
    <Poster id="addRing" uri="pkg:/images/login/ring217w5.webp" width="217" height="217" translation="[9, 0]" blendColor="#FFFFFF40" />
    <Label id="plusGlyph" width="217" height="217" translation="[9, 0]" horizAlign="center" vertAlign="center" color="#FFFFFF8A" />
    <Label id="addLabel" horizAlign="center" vertAlign="center" width="234" height="39" translation="[0, 237]" font="font:MediumSystemFont" color="#FFFFFF" />
  </children>
  <interface>
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
  </interface>
</component>

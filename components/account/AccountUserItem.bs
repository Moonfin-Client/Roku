import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/utils/misc.bs"

const RING_IDLE = "0xFFFFFF26"
const ACCENT = "0x00A4DCFF"
const NAME_IDLE = "0xFFFFFFD9"
const REMOVE_IDLE_BG = "0x000000B3"
const REMOVE_FOCUS_BG = "0xC62828FF"

sub init()
    m.scaleGroup = m.top.findNode("scaleGroup")
    m.avatarRing = m.top.findNode("avatarRing")
    m.avatar = m.top.findNode("avatar")
    m.userName = m.top.findNode("userName")
    m.serverName = m.top.findNode("serverName")
    m.activeBadge = m.top.findNode("activeBadge")
    m.activeBadge.text = UCase(tr("Active"))
    m.removeBadge = m.top.findNode("removeBadge")
    m.removeBg = m.top.findNode("removeBg")

    m.avatar.observeField("loadStatus", "onAvatarLoadStatusChanged")
end sub

' A user with no picture returns a 404, so the placeholder is driven off the failure
sub onAvatarLoadStatusChanged()
    if m.avatar.loadStatus <> PosterLoadStatus.LOADING
        m.avatar.unobserveField("loadStatus")
    end if

    if isStringEqual(m.avatar.loadStatus, PosterLoadStatus.FAILED)
        m.avatar.uri = "pkg:/images/baseline_person_white_48dp.png"
    end if
end sub

sub itemContentChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    m.userName.text = itemData.username
    m.serverName.text = itemData.serverName
    m.activeBadge.visible = itemData.isActive
    m.avatar.uri = itemData.imageURL

    onFocusChanged()
end sub

sub onFocusChanged()
    isActive = false
    canRemove = false
    if isValid(m.top.itemContent)
        isActive = m.top.itemContent.isActive
        canRemove = m.top.itemContent.canRemove
    end if

    if m.top.itemHasFocus
        m.scaleGroup.scale = [1.08, 1.08]
        m.avatarRing.blendColor = ACCENT
        m.removeBadge.visible = canRemove
    else
        m.scaleGroup.scale = [1.0, 1.0]
        m.avatarRing.blendColor = isActive ? ACCENT : RING_IDLE
        m.removeBadge.visible = false
    end if

    m.userName.color = m.top.itemHasFocus ? ACCENT : NAME_IDLE
    m.removeBg.blendColor = m.top.removeFocused ? REMOVE_FOCUS_BG : REMOVE_IDLE_BG
end sub

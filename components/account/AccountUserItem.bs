import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.avatarRing = m.top.findNode("avatarRing")
    m.avatar = m.top.findNode("avatar")
    m.placeholder = m.top.findNode("placeholder")
    m.userName = m.top.findNode("userName")
    m.serverName = m.top.findNode("serverName")
    m.activeBadge = m.top.findNode("activeBadge")
    m.removeBadge = m.top.findNode("removeBadge")
    m.removeBg = m.top.findNode("removeBg")

    m.userName.font.size = 33
    m.serverName.font.size = 23
    m.activeBadge.font.size = 20
    m.activeBadge.text = UCase(tr("Active"))
    for each glyph in [[m.placeholder, "person", 114], [m.top.findNode("removeGlyph"), "close", 27]]
        glyph[0].font.uri = settingsGlyphs.FONT_URI
        glyph[0].font.size = glyph[2]
        glyph[0].text = settingsGlyphs.Char(glyph[1])
    end for

    m.avatar.observeField("loadStatus", "onAvatarLoadStatusChanged")
end sub

' A user with no picture returns a 404, so the person glyph shows instead
sub onAvatarLoadStatusChanged()
    if m.avatar.loadStatus <> PosterLoadStatus.LOADING
        m.avatar.unobserveField("loadStatus")
    end if
    if isStringEqual(m.avatar.loadStatus, PosterLoadStatus.FAILED)
        m.avatar.uri = ""
        m.placeholder.visible = true
    end if
end sub

sub itemContentChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    m.userName.text = itemData.username
    m.serverName.text = itemData.serverName
    m.activeBadge.visible = itemData.isActive
    m.avatar.uri = itemData.imageURL
    m.placeholder.visible = m.avatar.uri = ""
    onFocusChanged()
end sub

sub onFocusChanged()
    canRemove = isValid(m.top.itemContent) and m.top.itemContent.canRemove
    focused = m.top.itemHasFocus
    m.avatarRing.blendColor = focused ? loginStyle.ACCENT_HEX : "#FFFFFF26"
    m.removeBadge.visible = focused and canRemove
    m.removeBg.blendColor = m.top.removeFocused ? "#C62828" : "#000000B3"
end sub

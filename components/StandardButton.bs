import "pkg:/source/utils/misc.bs"

const ICON_LABEL_GAP = 16

sub init()
    m.buttonBackground = m.top.findNode("buttonBackground")
    m.buttonText = m.top.findNode("buttonText")
    m.buttonTextMeasure = m.top.findNode("buttonTextMeasure")
    m.buttonIcon = m.top.findNode("buttonIcon")
    m.focusFeedback = m.top.findNode("focusFeedback")

    m.top.observeField("background", "onBackgroundChanged")
    m.top.observeField("color", "onColorChanged")
    m.top.observeField("text", "onTextChanged")
    m.top.observeField("height", "onHeightChanged")
    m.top.observeField("width", "onWidthChanged")
    m.top.observeField("focus", "onFocusChanged")
    m.top.observeField("focusedChild", "onFocusedChildChanged")
    m.top.observeField("fontSize", "onFontSizeChanged")
    m.top.observeField("outline", "applyButtonStyle")
    m.top.observeField("outlineUri", "applyButtonStyle")
    m.top.observeField("borderColor", "applyButtonStyle")
    m.top.observeField("focusBorderColor", "applyButtonStyle")
    m.top.observeField("iconUri", "onIconUriChanged")
end sub

' An outline button drops the fill and carries its colour on the border and label
sub applyButtonStyle()
    if m.top.outline
        m.buttonBackground.blendColor = "0x00000000"
        m.focusFeedback.uri = m.top.outlineUri
        m.focusFeedback.visible = true
        m.focusFeedback.blendColor = m.top.focus ? m.top.focusBorderColor : m.top.borderColor
        return
    end if

    m.focusFeedback.blendColor = "0xFFFFFFFF"
    if m.top.focus
        m.buttonBackground.blendColor = m.top.focusBackground
        m.focusFeedback.visible = true
    else
        m.buttonBackground.blendColor = m.top.background
        m.focusFeedback.visible = false
    end if
end sub

sub onIconUriChanged()
    m.buttonIcon.uri = m.top.iconUri
    m.buttonIcon.visible = isValidAndNotEmpty(m.top.iconUri)
    layoutIcon()
end sub

' The label stays centred across the whole button, so the icon is hung off its
' left edge rather than sharing a centred row with it
sub layoutIcon()
    if not m.buttonIcon.visible then return
    if m.top.width <= 0 or m.top.height <= 0 then return

    textWidth = m.buttonTextMeasure.boundingRect().width
    iconX = ((m.top.width - textWidth) / 2) - ICON_LABEL_GAP - m.buttonIcon.width
    if iconX < 0 then iconX = 0

    m.buttonIcon.translation = [iconX, (m.top.height - m.buttonIcon.height) / 2]
end sub

sub applyFont(font as string)
    m.buttonText.font = font
    m.buttonTextMeasure.font = font
    if m.top.fontSize > 0
        m.buttonText.font.size = m.top.fontSize
        m.buttonTextMeasure.font.size = m.top.fontSize
    end if
end sub

sub onFontSizeChanged()
    applyFont(m.top.focus ? "font:SmallBoldSystemFont" : "font:SmallSystemFont")
    layoutIcon()
end sub

sub onFocusChanged()
    if m.top.focus
        m.buttonText.color = m.top.focusColor
        m.buttonIcon.blendColor = m.top.focusColor
        applyFont("font:SmallBoldSystemFont")
    else
        m.buttonText.color = m.top.color
        m.buttonIcon.blendColor = m.top.color
        applyFont("font:SmallSystemFont")
    end if

    applyButtonStyle()
    layoutIcon()
end sub

sub onFocusedChildChanged()
    hasFocus = m.top.hasFocus()
    m.top.focus = hasFocus
end sub

sub onBackgroundChanged()
    applyButtonStyle()
end sub

sub onColorChanged()
    if m.top.focus
        m.buttonText.color = m.top.focusColor
        m.buttonIcon.blendColor = m.top.focusColor
    else
        m.buttonText.color = m.top.color
        m.buttonIcon.blendColor = m.top.color
    end if
end sub

sub onTextChanged()
    m.buttonText.text = m.top.text
    m.buttonTextMeasure.text = m.top.text
    layoutIcon()
end sub

sub onHeightChanged()
    m.buttonBackground.height = m.top.height
    m.buttonText.height = m.top.height
    m.focusFeedback.height = m.top.height
    layoutIcon()
end sub

sub onWidthChanged()
    m.buttonBackground.width = m.top.width
    m.buttonText.width = m.top.width
    m.focusFeedback.width = m.top.width
    layoutIcon()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "OK" and m.top.hasFocus()
        m.top.buttonSelected = true
        return true
    end if

    ' Let parent scene handle left/right navigation
    ' Only set escape and return true if there's specific escape handling needed
    ' For now, return false to allow parent navigation
    return false
end function

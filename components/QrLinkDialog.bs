import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    buttonList = m.top.findNode("buttonList")
    buttonList.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    closeButton = CreateObject("roSGNode", "ContentNode")
    closeButton.title = tr("Close")
    m.top.findNode("buttonContent").appendChild(closeButton)

    buttonList.setFocus(true)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "back" or key = "OK"
        m.top.wasClosed = true
        return true
    end if

    return false
end function

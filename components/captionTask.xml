<?xml version="1.0" encoding="utf-8"?>
<component name="captionTask" extends="Task">
       <interface>
              <function name="getCues" />
              <field id="captionStyles" type="assocarray" alwaysNotify="true" />
              <field id="url" type="string" onChange="onUrlChanged" />
              <!-- The parsed cues for the track at url, sent back from the download -->
              <field id="loaded" type="assocarray" onChange="onCuesLoaded" />
              <!-- True from a pick until its cues come back, so the player can show it's fetching them -->
              <field id="fetching" type="boolean" value="false" />
              <field id="currentCaption" type="roArray" />
              <field id="playerState" type="string" />
              <field id="currentPos" type="int" />
              <!-- True while an HDR picture is showing, so the HDR style is used when it is set apart -->
              <field id="isHdr" type="boolean" value="false" onChange="onStyleChanged" />
              <!-- Bumped when the style settings change, so the next cues draw with them -->
              <field id="styleRevision" type="integer" onChange="onStyleChanged" />
              <!-- The second track's own size in pixels and fill color, where 0 and "" follow the first track -->
              <field id="sizeOverride" type="integer" value="0" onChange="onStyleChanged" />
              <field id="colorOverride" type="string" value="" onChange="onStyleChanged" />
              <!-- How far up from the bottom the cues sit, as a share of the height, for stacking a second track -->
              <field id="bottomPercent" type="float" value="10" />
       </interface>
       <children>
              <timer id="captionTimer" repeat="true" duration="0.1" />
       </children>
</component>
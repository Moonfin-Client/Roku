<?xml version="1.0" encoding="utf-8"?>
<!-- The lane's socket for one playing Silo session: Silo's playback control socket. One node is one lane, and one lane is one session -->
<component name="SiloPlaybackControlTask" extends="Task">
    <interface>
        <field id="server" type="string" />
        <field id="account" type="string" />
        <field id="profileId" type="string" />
        <field id="sessionId" type="string" />
        <field id="installationId" type="string" />
        <field id="appVersion" type="string" />
        <!-- false lets the lane go, after a grace for the commands still running -->
        <field id="active" type="boolean" value="false" />
        <!-- A pulse: the same session replanned, so a lane that gave up tries again -->
        <field id="retry" type="boolean" alwaysNotify="true" />
        <!-- { id, name, payload, reason, sessionId } for each command from the lane's session -->
        <field id="command" type="assocarray" alwaysNotify="true" />
        <!-- { id, type: "ack" | "result", error } from the player, answered on the lane's connection -->
        <field id="answer" type="assocarray" alwaysNotify="true" />
        <!-- idle | connecting | open | gaveUp | off | closed (a refused lane closes) -->
        <field id="state" type="string" value="idle" />
    </interface>
</component>

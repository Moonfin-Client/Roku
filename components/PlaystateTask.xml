<?xml version="1.0" encoding="utf-8"?>

<component name="PlaystateTask" extends="Task">
  <interface>
    <field id="status" type="string" />
    <field id="params" type="assocarray" />
    <field id="itemId" type="string" />
    <!-- A live stop for a session that never reported its start, whose stream the server
         wont let go of by itself -->
    <field id="closeLiveStream" type="boolean" value="false" />
  </interface>
</component>
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/libraryPanel.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' The panel is 445 wide with 32 of padding inside a 1 pixel edge, so its rows get 380
const CONTENT_LEFT = 33
const CONTENT_WIDTH = 380
const PAD_TOP = 40
const EYEBROW_SIZE = 14
const EYEBROW_LINE = 17
const EYEBROW_GAP = 4
const TITLE_SIZE = 32
const TITLE_LINE = 38
const TITLE_GAP = 32
const HEADING_SIZE = 15
const HEADING_LINE = 18
const HEADING_GAP = 16
const SECTION_GAP = 28
const ROW_GAP = 4
const SETTING_ROW_HEIGHT = 86

sub init()
    m.top.visible = false

    m.body = m.top.findNode("body")
    m.eyebrow = m.top.findNode("eyebrow")
    m.title = m.top.findNode("title")
    m.slideIn = m.top.findNode("slideIn")

    m.headingFont = m.top.findNode("headingFont").font
    m.headingFont.size = HEADING_SIZE
    m.eyebrow.font.size = EYEBROW_SIZE
    m.title.font.size = TITLE_SIZE
    m.eyebrow.width = CONTENT_WIDTH
    m.title.width = CONTENT_WIDTH

    if themeChrome.IsActive() then m.top.findNode("panelBg").color = themeChrome.Surface()

    m.rows = []
    m.focusIndex = 0
end sub

sub showPanel()
    wasOpen = m.top.visible
    build(m.top.spec ?? {})

    if not wasOpen
        m.focusIndex = 0
        m.top.visible = true
        m.slideIn.control = "start"
    end if

    if m.focusIndex > m.rows.count() - 1 then m.focusIndex = m.rows.count() - 1
    if m.focusIndex < 0 then m.focusIndex = 0
    drawFocus()
    m.top.setFocus(true)
end sub

sub closePanel()
    if not m.top.visible then return

    m.slideIn.control = "stop"
    m.top.visible = false
    m.top.closed = true
end sub

sub build(spec as object)
    m.body.removeChildrenIndex(m.body.getChildCount(), 0)
    m.rows = []

    y = PAD_TOP
    m.eyebrow.visible = isValidAndNotEmpty(spec.eyebrow)
    if m.eyebrow.visible
        m.eyebrow.text = UCase(spec.eyebrow)
        m.eyebrow.translation = [CONTENT_LEFT, y]
        y += EYEBROW_LINE + EYEBROW_GAP
    end if

    m.title.text = spec.title ?? ""
    m.title.translation = [CONTENT_LEFT, y]
    y += TITLE_LINE + TITLE_GAP

    ' The rows are the library dialog's own, widened by the inset their focus chip keeps so the
    ' chip lines up with the headings
    rowLeft = CONTENT_LEFT - libraryPanel.CHIP_INSET
    rowWidth = CONTENT_WIDTH + (libraryPanel.CHIP_INSET * 2)

    for each section in spec.sections ?? []
        if isValidAndNotEmpty(section.label)
            heading = m.body.createChild("Label")
            heading.font = m.headingFont
            heading.color = libraryPanel.MUTED_INK
            heading.text = UCase(section.label)
            heading.width = CONTENT_WIDTH
            heading.translation = [CONTENT_LEFT, y]
            y += HEADING_LINE + HEADING_GAP
        end if

        for each row in section.rows
            rowHeight = isStringEqual(row.kind, "setting") ? SETTING_ROW_HEIGHT : libraryPanel.ROW_HEIGHT

            data = createObject("roSGNode", "LibraryPanelRowData")
            data.kind = row.kind
            data.title = row.title
            data.summary = row.summary ?? ""
            data.selected = row.selected = true
            data.rowHeight = rowHeight
            data.rowWidth = rowWidth

            node = m.body.createChild("LibraryPanelRow")
            node.translation = [rowLeft, y]
            node.focusPercent = 1.0
            node.itemContent = data

            m.rows.push({ node: node, section: section.id, value: row.value })
            y += rowHeight + ROW_GAP
        end for

        y += SECTION_GAP - ROW_GAP
    end for
end sub

sub drawFocus()
    for i = 0 to m.rows.count() - 1
        m.rows[i].node.itemHasFocus = i = m.focusIndex
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.UP) or isStringEqual(key, KeyCode.DOWN)
        target = m.focusIndex + (isStringEqual(key, KeyCode.UP) ? -1 : 1)
        if target >= 0 and target < m.rows.count()
            m.focusIndex = target
            drawFocus()
        end if
        return true
    end if

    if isStringEqual(key, KeyCode.OK)
        if m.rows.count() = 0 then return true
        picked = m.rows[m.focusIndex]
        m.top.chosen = { section: picked.section, value: picked.value }
        return true
    end if

    if isStringEqual(key, KeyCode.BACK)
        closePanel()
        return true
    end if

    ' Nothing outside the panel can be reached until it closes
    return true
end function

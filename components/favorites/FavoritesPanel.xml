<?xml version="1.0" encoding="utf-8"?>
<!-- The sort and settings panels the favorites grid slides in from the right. Each section
     is a heading over a run of rows, and picking a row reports it without closing anything,
     so the screen decides whether the panel stays -->
<component name="FavoritesPanel" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.45" />

    <Group id="panel" translation="[1475, 0]">
      <Rectangle id="panelBg" width="445" height="1080" color="#141428" opacity="0.92" />
      <Rectangle id="panelEdge" width="1" height="1080" color="#FFFFFF" opacity="0.08" />
      <Label id="eyebrow" font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
      <Label id="title" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <!-- Holds the font every section heading shares -->
      <Label id="headingFont" font="font:SmallestBoldSystemFont" visible="false" />
      <Group id="body" />
    </Group>

    <Animation id="slideIn" duration="0.25" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[1920, 0], [1475, 0]]" fieldToInterp="panel.translation" />
    </Animation>
  </children>

  <interface>
    <!-- eyebrow, title, and sections of { id, label, rows: [{ value, kind, title, summary, selected }] } -->
    <field id="spec" type="assocarray" />
    <!-- The row picked, as { section, value } -->
    <field id="chosen" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />

    <!-- Opens on the first row, or redraws in place with the focus kept when already open -->
    <function name="showPanel" />
    <function name="closePanel" />
  </interface>
</component>

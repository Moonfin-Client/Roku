<?xml version="1.0" encoding="utf-8"?>
<!-- A grid of library cards laid out sideways: items run down each column and the columns run
     off to the right. It answers to the same fields a MarkupGrid does, so a screen can swap
     one for the other -->
<component name="HorizontalCardGrid" extends="Group">
  <children>
    <Group id="track" />

    <Animation id="scroll" duration="0.2" repeat="false" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="track.translation" />
    </Animation>
  </children>

  <interface>
    <field id="content" type="node" onChange="onContentChanged" />
    <!-- cellWidth, cellHeight, rows, and columns for how many fit across -->
    <field id="layout" type="assocarray" onChange="onLayoutChanged" alwaysNotify="true" />
    <field id="itemFocused" type="integer" value="-1" />
    <field id="itemSelected" type="integer" value="-1" alwaysNotify="true" />
    <field id="jumpToItem" type="integer" value="-1" onChange="onJumpToItem" alwaysNotify="true" />
    <!-- The first column on screen, so past 0 once the grid has scrolled -->
    <field id="firstColumn" type="integer" value="0" />

    <!-- Draws the cards again, for content that grew or changed under the grid -->
    <function name="redraw" />
  </interface>
</component>

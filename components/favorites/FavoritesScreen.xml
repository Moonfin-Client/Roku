<?xml version="1.0" encoding="utf-8"?>
<!-- Favorites as the other clients draw it: a line of detail about whatever card is
     focused, a tab per kind of favorite, and a grid under them. The flat alphabetical
     grid is the other layout the view style setting switches to. -->
<component name="FavoritesScreen" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="#000018" />

    <!-- The picture behind the page, held at the previous one until the next has loaded -->
    <Poster id="backdropPrev" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0" />
    <Poster id="backdrop" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0" />

    <Animation id="backdropFadeIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdrop.opacity" />
    </Animation>

    <Animation id="backdropPrevFadeOut" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropPrevFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="backdropPrev.opacity" />
    </Animation>

    <!-- The name and the count read as one line, centred as a pair -->
    <Label id="screenTitle" font="font:LargeBoldSystemFont" color="#FFFFFF"
      height="52" vertAlign="center" translation="[0, 28]" />
    <Label id="itemCount" font="font:SmallSystemFont" color="#FFFFFF" opacity="0.5"
      height="52" vertAlign="center" translation="[0, 34]" />

    <IconButton id="homeButton" translation="[48, 90]"
      icon="pkg:/images/icons/library_home.png" height="52" width="52" padding="26"
      background="0x00000000" focusBackground="#555555" />
    <IconButton id="sortButton" translation="[120, 90]"
      icon="pkg:/images/icons/library_sortaz.png" height="52" width="52" padding="26"
      background="0x00000000" focusBackground="#555555" />
    <IconButton id="settingsButton" translation="[192, 90]"
      icon="pkg:/images/icons/library_gear.png" height="52" width="52" padding="26"
      background="0x00000000" focusBackground="#555555" />

    <!-- Only the flat layout is long enough alphabetically to need the strip -->
    <HorizontalAlphaPicker id="alphaPicker" translation="[264, 101]" visible="false" />

    <!-- What the focused card is, held to a fixed height so the grid never moves -->
    <Group id="focusedInfo" translation="[48, 156]">
      <Label id="focusedName" font="font:MediumBoldSystemFont" color="#FFFFFF"
        width="1824" maxLines="1" />
      <LayoutGroup id="infoGroup" layoutDirection="horiz" vertAlignment="center"
        itemSpacings="[13]" translation="[0, 41]">
        <Label id="focusedYear" font="font:SmallSystemFont" color="#FFFFFF" opacity="0.7" />
        <Label id="focusedRuntime" font="font:SmallSystemFont" color="#FFFFFF" opacity="0.7" />
        <Group id="seriesStatusPill" visible="false">
          <Poster id="seriesStatusFill" uri="pkg:/images/details/badgefill6.9.png" />
          <Label id="seriesStatusLabel" font="font:SmallestBoldSystemFont" color="#FFFFFF"
            horizAlign="center" vertAlign="center" />
        </Group>
        <Group id="officialRatingPill" visible="false">
          <Poster id="officialRatingFill" uri="pkg:/images/details/badgefill6.9.png"
            blendColor="#FFFFFF" opacity="0.15" />
          <Label id="focusedOfficialRating" font="font:SmallestBoldSystemFont" color="#FFFFFF"
            horizAlign="center" vertAlign="center" />
        </Group>
        <Group id="resolutionPill" visible="false">
          <Poster id="resolutionFill" uri="pkg:/images/details/badgefill6.9.png"
            blendColor="#FFFFFF" opacity="0.15" />
          <Label id="focusedResolution" font="font:SmallestBoldSystemFont" color="#FFFFFF"
            horizAlign="center" vertAlign="center" />
        </Group>
      </LayoutGroup>
      <RatingsRow id="pluginRatings" visible="false" translation="[0, 77]"
        iconHeight="32" valueSize="24" nameSize="16" ratingSpacing="9" showNames="true" />
    </Group>

    <DetailTabBar id="tabBar" translation="[48, 330]" visible="false" />

    <MarkupGrid
      id="itemGrid"
      itemComponentName="LibraryCard"
      vertFocusAnimationStyle="fixed"
      translation="[48, 423]"
      clippingRect="[0, 0, 1824, 657]"
      drawFocusFeedback="false"
      numColumns="10"
      numRows="2"
      itemSize="[174, 292]"
      rowHeights="[292]"
      itemSpacing="[0, 0]" />

    <Label id="emptyLabel" translation="[0, 540]" font="font:MediumSystemFont" color="#FFFFFF"
      opacity="0.5" width="1920" horizAlign="center" vertAlign="center" height="64"
      visible="false" />

    <!-- What the flat layout is showing, and how far through it the grid has got -->
    <Label id="statusText" font="font:SmallestSystemFont" color="#FFFFFF" opacity="0.35"
      translation="[48, 1046]" width="1400" height="20" vertAlign="center" visible="false" />
    <Label id="statusCount" font="font:SmallestSystemFont" color="#FFFFFF" opacity="0.35"
      translation="[1472, 1046]" width="400" height="20" horizAlign="right" vertAlign="center"
      visible="false" />

    <LibrarySortDialog id="sortDialog" visible="false" />
    <LibrarySettingsDialog id="settingsDialog" visible="false" />
  </children>

  <interface>
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <field id="alphaSelected" type="string" alias="alphaPicker.letterSelected" onChange="onLetterSelected" alwaysNotify="true" />
  </interface>
</component>

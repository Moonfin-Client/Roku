import "pkg:/source/utils/themeChrome.bs"

const FOCUS_GROW = 1.12

sub init()
    m.face = m.top.findNode("face")
    m.disc = m.top.findNode("disc")
    m.ring = m.top.findNode("ring")
    m.accent = themeChrome.Accent()
end sub

sub onFocusChanged()
    focused = m.top.focus
    m.disc.blendColor = focused ? m.accent : "#FFFFFF"
    m.disc.opacity = focused ? 0.3 : 0.08
    m.ring.visible = focused
    m.face.scale = focused ? [FOCUS_GROW, FOCUS_GROW] : [1.0, 1.0]
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="LoadFavoritesTask" extends="Task">
    <interface>
        <!-- What to fetch: mode is "tabs", "page" or "list", plus whichever of tabKey,
            startIndex, sortField, sortOrder, itemTypes and nameStartsWith that mode reads -->
        <field id="request" type="assocarray" />

        <!-- Everything below is written before results, which is the one to observe -->
        <field id="mode" type="string" />
        <field id="tabKey" type="string" />
        <field id="counts" type="assocarray" />
        <field id="total" type="integer" value="0" />
        <field id="startIndex" type="integer" value="0" />
        <!-- The nodes that came back, each carrying the tab it belongs to -->
        <field id="results" type="array" alwaysNotify="true" />
        <field id="error" type="string" alwaysNotify="true" />
    </interface>
</component>

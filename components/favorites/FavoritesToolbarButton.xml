<?xml version="1.0" encoding="utf-8"?>
<!-- A round toolbar button with a faint disc behind its icon, which takes the accent, a white
     ring and a slight grow while it holds the focus -->
<component name="FavoritesToolbarButton" extends="Group">
  <children>
    <Group id="face" scaleRotateCenter="[26, 26]">
      <Poster id="disc" uri="pkg:/images/icons/circle.png" width="52" height="52" blendColor="#FFFFFF"
        opacity="0.08" />
      <Poster id="ring" uri="pkg:/images/icons/focusRing.png" width="52" height="52" visible="false" />
      <Poster id="glyph" width="26" height="26" translation="[13, 13]" />
    </Group>
  </children>

  <interface>
    <field id="icon" type="uri" alias="glyph.uri" />
    <field id="focus" type="boolean" value="false" onChange="onFocusChanged" />
  </interface>
</component>

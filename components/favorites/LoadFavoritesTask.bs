import "pkg:/source/utils/contentNodes.bs"
import "pkg:/source/utils/diagnostics.bs"
import "pkg:/source/utils/favoriteTabs.bs"
import "pkg:/source/utils/mediaDedup.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/posterLabels.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' How long a batch has before whatever has not arrived is given up on
const FAVORITES_TIMEOUT = 15

sub init()
    m.top.functionName = "loadFavorites"
end sub

sub loadFavorites()
    request = m.top.request
    if not isValid(request)
        m.top.error = "No request"
        return
    end if

    sessions = favoriteSessions()
    if sessions.count() = 0
        m.top.error = "No server sessions available"
        return
    end if

    ' The table is read once per item further down, so it is built here and handed on
    tabs = favoriteTabs.Tabs()
    mode = request.mode ?? "tabs"

    ' One server answers each type on its own so the counts come from the server. Several
    ' answer everything at once, since nine queries per server is more than the fan out is
    ' worth, and the buckets are counted here instead.
    pooled = sessions.count() > 1
    m.top.pooled = pooled

    if mode = "page"
        loadPage(sessions, request, tabs)
    else if mode = "list"
        loadList(sessions, request, tabs, pooled)
    else if pooled
        loadPooledTabs(sessions, request, tabs)
    else
        loadTabs(sessions[0], request, tabs)
    end if
end sub

function emptyCounts(tabs as object) as object
    counts = {}
    for each tabDef in tabs
        counts[tabDef.key] = 0
    end for
    return counts
end function

' The nodes go out last, since that is the field the screen waits on
sub answerWith(mode as string, nodes as object, counts as object, total as integer, startIndex as integer, tabKey as string, fetched = {} as object)
    m.top.fetched = fetched
    m.top.mode = mode
    m.top.tabKey = tabKey
    m.top.counts = counts
    m.top.total = total
    m.top.startIndex = startIndex
    posterLabels.Attach(nodes)
    m.top.results = nodes
end sub

function favoriteSessions() as object
    sessions = []

    if isMultiServerEnabled() then sessions = getAllServerSessions()

    if sessions.count() = 0
        current = getCurrentServerSession()
        if isValid(current) then sessions.push(current)
    end if

    return sessions
end function

' =====================================================================
' THE THREE SHAPES OF LOAD
' =====================================================================

' Every tab of one server, asked for together
sub loadTabs(userSession as object, request as object, tabs as object)
    port = CreateObject("roMessagePort")
    pending = {}
    keepAlive = {}

    for each tabDef in tabs
        params = listParams(userSession, tabDef.types, request.sortField, request.sortOrder, 0, favoriteTabs.PAGE_SIZE)
        started = startRequest(userSession, params, port)
        if isValid(started)
            pending[started.id] = tabDef
            keepAlive[started.id] = started.request
        end if
    end for

    nodes = []
    counts = emptyCounts(tabs)
    fetched = {}

    for each answer in awaitAll(port, pending, keepAlive)
        tabDef = answer.tag
        stampServer(answer.items, userSession)
        built = buildNodes(answer.items, tabs, tabDef)
        counts[tabDef.key] = answer.total > 0 ? answer.total : built.count()
        fetched[tabDef.key] = answer.items.count()

        for each node in built
            nodes.push(node)
        end for
    end for

    addWatchlist(nodes, counts, fetched)
    answerWith("tabs", nodes, counts, nodes.count(), 0, "", fetched)
end sub

' Every tab across every server, one request each, bucketed here
sub loadPooledTabs(sessions as object, request as object, tabs as object)
    nodes = buildNodes(pooledItems(sessions, favoriteTabs.AllTypes(), request.sortKey ?? ""), tabs)

    counts = emptyCounts(tabs)
    for each node in nodes
        counts[node.favoritesTab] = counts[node.favoritesTab] + 1
    end for

    fetched = {}
    addWatchlist(nodes, counts, fetched)
    answerWith("tabs", nodes, counts, nodes.count(), 0, "", fetched)
end sub

' The next page of one tab. Several servers hand back everything at once, so there is
' never a page to ask them for.
sub loadPage(sessions as object, request as object, tabs as object)
    if request.tabKey = "watchlist"
        startIndex = request.startIndex ?? 0
        page = watchlistPage(Int(startIndex / WATCHLIST_PAGE_SIZE) + 1)
        counts = emptyCounts(tabs)
        counts.watchlist = page.total
        answerWith("page", page.nodes, counts, page.total, startIndex, "watchlist", { watchlist: loadedThrough(page, startIndex) })
        return
    end if

    pageTab = favoriteTabs.TabWithKey(tabs, request.tabKey ?? "")
    if not isValid(pageTab)
        m.top.error = "Unknown tab"
        return
    end if

    userSession = sessions[0]
    startIndex = request.startIndex ?? 0
    params = listParams(userSession, pageTab.types, request.sortField, request.sortOrder, startIndex, favoriteTabs.PAGE_SIZE)

    answer = fetchOne(userSession, params)
    stampServer(answer.items, userSession)
    counts = emptyCounts(tabs)
    counts[pageTab.key] = answer.total

    fetched = {}
    fetched[pageTab.key] = answer.items.count()
    answerWith("page", buildNodes(answer.items, tabs, pageTab), counts, answer.total, startIndex, pageTab.key, fetched)
end sub

' The flat view, which narrows by type rather than tabbing between them. The letter strip
' narrows what has loaded on the screen, so it never reaches here.
sub loadList(sessions as object, request as object, tabs as object, pooled as boolean)
    itemTypes = request.itemTypes
    if not isValid(itemTypes) then itemTypes = favoriteTabs.ChosenTypeFilter("all").types

    ' Several servers cant be paged as one list, so they are gathered whole
    if pooled
        nodes = buildNodes(pooledItems(sessions, itemTypes, request.sortKey ?? ""), tabs)
        answerWith("list", nodes, emptyCounts(tabs), nodes.count(), 0, "")
        return
    end if

    userSession = sessions[0]
    startIndex = request.startIndex ?? 0
    params = listParams(userSession, itemTypes, request.sortField, request.sortOrder, startIndex, favoriteTabs.LIST_PAGE_SIZE)

    answer = fetchOne(userSession, params)
    stampServer(answer.items, userSession)
    answerWith("list", buildNodes(answer.items, tabs), emptyCounts(tabs), answer.total, startIndex, "", { list: answer.items.count() })
end sub

' Every server's favorites in one list, with a title two servers both hold shown once
function pooledItems(sessions as object, itemTypes as string, sortKey as string) as object
    port = CreateObject("roMessagePort")
    pending = {}
    keepAlive = {}
    bySession = {}

    for each userSession in sessions
        params = listParams(userSession, itemTypes, "SortName", "Ascending", 0, 0)
        started = startRequest(userSession, params, port)
        if isValid(started)
            pending[started.id] = started.id
            keepAlive[started.id] = started.request
            bySession[started.id] = userSession
        end if
    end for

    items = []
    for each answer in awaitAll(port, pending, keepAlive)
        stampServer(answer.items, bySession[answer.tag])
        items.append(answer.items)
    end for

    return favoriteTabs.SortItems(deduplicateMediaItems(items), sortKey)
end function

' =====================================================================
' REQUESTS
' =====================================================================

function listParams(userSession as object, itemTypes as string, sortField as dynamic, sortOrder as dynamic, startIndex as integer, limit as integer) as object
    params = {
        userId: userSession.userId,
        Recursive: true,
        Filters: "IsFavorite",
        IncludeItemTypes: itemTypes,
        SortBy: isValidAndNotEmpty(sortField) ? sortField : "SortName",
        SortOrder: isValidAndNotEmpty(sortOrder) ? sortOrder : "Ascending",
        StartIndex: startIndex,
        EnableTotalRecordCount: true,
        Fields: favoriteTabs.FIELDS
    }

    if limit > 0 then params.Limit = limit

    return params
end function

function startRequest(userSession as object, params as object, port as object) as object
    request = CreateObject("roUrlTransfer")
    request.SetUrl(buildURLForSession(userSession, "/Items", params))
    addServerAuthorization(request, buildAuthHeaderForSession(userSession), userSession.serverUrl)
    request.AddHeader("Content-Type", "application/json")
    request.SetCertificatesFile("common:/certs/ca-bundle.crt")
    request.InitClientCertificates()
    request.SetMessagePort(port)
    request.EnableEncodings(true)

    ' A Silo server's answer comes from the Silo router at once; awaitAll picks it up
    if silo.Owns(request)
        if type(m.siloAnswers) <> "roAssociativeArray" then m.siloAnswers = {}
        m.siloAnswers[request.GetIdentity().ToStr()] = siloResponse(request, "GET")
        return { id: request.GetIdentity().ToStr(), request: request }
    end if

    requestId = request.GetIdentity().ToStr()
    ' A Plex server only answers through its bridge, which answers right away
    if plexUrls.Owns(request.GetUrl())
        if not isValid(m.plexAnswers) then m.plexAnswers = {}
        m.plexAnswers[requestId] = getJson(request)
    else if not request.AsyncGetToString()
        return invalid
    end if

    return { id: requestId, request: request }
end function

' Waits on every request in one batch and hands back what each of them answered
function awaitAll(port as object, pending as object, keepAlive as object) as object
    answers = []
    startedAt = CreateObject("roDateTime").AsSeconds()

    if type(m.siloAnswers) = "roAssociativeArray"
        for each requestId in pending.Keys()
            answered = m.siloAnswers[requestId]
            if isValid(answered)
                m.siloAnswers.Delete(requestId)
                tag = pending[requestId]
                pending.Delete(requestId)
                keepAlive.Delete(requestId)
                if answered.ok and type(answered.data) = "roAssociativeArray"
                    answers.push({ tag: tag, items: answered.data.Items ?? [], total: answered.data.TotalRecordCount ?? 0 })
                end if
            end if
        end for
    end if
    plexAnswers = m.plexAnswers ?? {}
    for each requestId in pending.Keys()
        if plexAnswers.DoesExist(requestId)
            answer = answerOf(pending[requestId], plexAnswers[requestId])
            if isValid(answer) then answers.push(answer)
            plexAnswers.Delete(requestId)
            pending.Delete(requestId)
            keepAlive.Delete(requestId)
        end if
    end for

    while pending.count() > 0
        msg = wait(1000, port)

        if CreateObject("roDateTime").AsSeconds() - startedAt > FAVORITES_TIMEOUT
            diagnostics.Network("Favorites request timed out waiting for the server", diagnostics.LEVEL_WARN)
            exit while
        end if

        if not isValid(msg) then continue while
        if type(msg) <> "roUrlEvent" then continue while

        requestId = msg.GetSourceIdentity().ToStr()
        tag = pending[requestId]
        if not isValid(tag) then continue while

        pending.Delete(requestId)
        keepAlive.Delete(requestId)

        if msg.GetResponseCode() <> 200 then continue while

        answer = answerOf(tag, ParseJson(msg.GetString()))
        if isValid(answer) then answers.push(answer)
    end while

    return answers
end function

function answerOf(tag as dynamic, data as dynamic) as dynamic
    if not isValid(data) then return invalid
    return {
        tag: tag,
        items: isValid(data.Items) ? data.Items : [],
        total: isValid(data.TotalRecordCount) ? data.TotalRecordCount : 0
    }
end function

' One request, waited on by itself
function fetchOne(userSession as object, params as object) as object
    port = CreateObject("roMessagePort")
    started = startRequest(userSession, params, port)
    if not isValid(started) then return { items: [], total: 0 }

    pending = {}
    pending[started.id] = started.id
    keepAlive = {}
    keepAlive[started.id] = started.request

    answers = awaitAll(port, pending, keepAlive)
    if answers.count() = 0 then return { items: [], total: 0 }

    return answers[0]
end function

' =====================================================================
' BUILDING THE CARDS
' =====================================================================

' Every setFields reads straight off the json, so the server an item came from is put there
' before any node is built
sub stampServer(items as object, userSession as object)
    for each item in items
        item.AddReplace("_serverUrl", userSession.serverUrl)
        item.AddReplace("_userId", userSession.userId)
        item.AddReplace("_authToken", userSession.authToken)
        item.AddReplace("_serverName", userSession.serverName)
    end for
end sub

' A tab of its own means every item belongs to it. Without one each item is placed by what
' it is, which is what the flat grid mixing every type needs.
function buildNodes(items as object, tabs as object, fixedTab = invalid as object) as object
    nodes = []
    if not isValidAndNotEmpty(items) then return nodes

    for each item in parentalControls.WithoutBlockedItems(items)
        tabDef = fixedTab
        if not isValid(tabDef) then tabDef = favoriteTabs.TabForType(tabs, item.Type)
        if isValid(tabDef)
            node = buildNode(item, tabDef)
            if isValid(node) then nodes.push(node)
        end if
    end for

    return nodes
end function

' The same node types the library grid builds, so a card selected here opens what the
' same card opens there
function buildNode(item as object, tabDef as object) as object
    if not isValid(item) or not isValidAndNotEmpty(item.Id) then return invalid

    node = contentNodes.ForType(item.Type ?? "")
    if not isValid(node) then return invalid

    node.addField("favoritesTab", "string", false)
    node.favoritesTab = tabDef.key

    if not isValid(item.ImageTags) then item.AddReplace("ImageTags", {})
    if not isValid(item.BackdropImageTags) then item.AddReplace("BackdropImageTags", [])
    if not isValid(item.UserData) then item.AddReplace("UserData", {})

    node.json = item
    node.title = item.Name ?? ""

    ' setFields sizes its poster for the library grid. Both shapes are kept, since the flat
    ' view's image type setting swaps between them without a reload.
    artwork = cardArtwork(item, "portrait")
    if artwork <> "" then node.posterUrl = artwork
    node.landscapePosterURL = cardArtwork(item, "landscape")

    return node
end function

function cardArtwork(item as object, shape as string) as string
    picked = favoriteTabs.CardImage(item, shape)
    if picked.id = "" then return ""

    params = { maxHeight: 400, quality: 80 }
    if isValidAndNotEmpty(picked.tag) then params.Tag = picked.tag

    return buildImageURLForServer(item._serverUrl, picked.id, picked.imageType, params)
end function

' =====================================================================
' THE WATCHLIST
' =====================================================================

' Seerr pages its watchlist 20 titles at a time
const WATCHLIST_PAGE_SIZE = 20

sub addWatchlist(nodes as object, counts as object, fetched as object)
    page = watchlistPage(1)
    for each node in page.nodes
        nodes.push(node)
    end for
    counts.watchlist = page.total
    fetched.watchlist = loadedThrough(page, 0)
end sub

' How many titles the screen has once it adds this page. Seerr's titles alone fall short of a
' total that includes the library's, so with no page after this one it's the rest of the tab,
' or the screen would ask on for a page it already has.
function loadedThrough(page as object, startIndex as integer) as integer
    if page.lastPage and startIndex + page.fetched < page.total then return page.total - startIndex
    return page.fetched
end function

' One page of the Seerr watchlist as request cards, which open the request screen. It needs a
' Seerr sign in, so without one the tab doesn't show.
function watchlistPage(page as integer) as object
    ' On Silo the tab leads with the library's titles on Silo's watchlist, which need no Seerr
    ' sign in, as Moonfin Core shows them there
    nodes = []
    inLibrary = {}
    ' Counted on every page, so each page's total is the same whole tab
    libraryCount = 0
    if isSiloServer()
        for each node in siloWatchlistNodes()
            if page = 1 then nodes.push(node)
            libraryCount++
            tmdbId = toString(chainLookupReturn(node, "json.ProviderIds.Tmdb", ""))
            if tmdbId <> "" then inLibrary[LCase(node.json.Type) + "/" + tmdbId] = true
        end for
    end if
    ' fetched counts only Seerr's titles, since the next page is worked out from it
    result = { nodes: nodes, total: libraryCount, fetched: 0, lastPage: true }
    if not GetSeerrConfig().enabled then return result
    answer = seerrProxyJson("discover/watchlist", { page: page.ToStr() })
    if not isValid(answer) or type(answer.results) <> "roArray" then return result

    titles = []
    shownAbove = 0
    for each item in answer.results
        if type(item) = "roAssociativeArray" and isValid(item.LookupCI("tmdbId") ?? item.LookupCI("id"))
            ' A title the library already shows above isn't offered again as a request, nor counted
            kind = "movie"
            if watchlistMediaType(item) = "tv" then kind = "series"
            if inLibrary.DoesExist(kind + "/" + watchlistTmdbId(item))
                shownAbove++
            else
                titles.push(item)
            end if
        end if
    end for
    withWatchlistDetails(titles)

    for each item in parentalControls.WithoutBlockedItems(titles)
        node = watchlistNode(item)
        if isValid(node) then nodes.push(node)
    end for
    result.total = libraryCount + (answer.totalResults ?? answer.results.count()) - shownAbove
    result.fetched = answer.results.count()
    result.lastPage = answer.results.count() < WATCHLIST_PAGE_SIZE
    if isValid(answer.totalPages) then result.lastPage = page >= answer.totalPages
    return result
end function

' The library's movies and series on Silo's watchlist, as the cards the other tabs draw
function siloWatchlistNodes() as object
    userSession = getCurrentServerSession()
    if not isValid(userSession) then return []
    data = getJson(APIRequest("Items", {
        UserId: userSession.userId,
        IncludeItemTypes: "Movie,Series",
        Recursive: true,
        Filters: "IsInWatchlist",
        Fields: favoriteTabs.FIELDS,
        Limit: 200
    }))
    if not isChainValid(data, "Items") then return []
    stampServer(data.Items, userSession)
    return buildNodes(data.Items, [], favoriteTabs.WatchlistTab())
end function

' The plugin hands Seerr's answer back as it is, or in a { FileContents: base64 } envelope
function seerrProxyJson(path as string, params as object) as dynamic
    data = getJson(APIRequest("/Moonfin/Seerr/Api/" + path, params))
    if type(data) <> "roAssociativeArray" then return invalid
    if isValidAndNotEmpty(data.FileContents)
        bytes = CreateObject("roByteArray")
        bytes.FromBase64String(data.FileContents)
        data = ParseJson(bytes.ToAsciiString())
        if type(data) <> "roAssociativeArray" then return invalid
    end if
    return data
end function

' Seerr's watchlist names each title by its TMDB id and type and no more, so the poster, year and
' rating come from each title's details, asked for together
sub withWatchlistDetails(titles as object)
    port = CreateObject("roMessagePort")
    running = {}
    for each item in titles
        if not isValidAndNotEmpty(item.LookupCI("posterPath"))
            req = APIRequest("/Moonfin/Seerr/Api/" + watchlistMediaType(item) + "/" + watchlistTmdbId(item), {})
            if isValid(req)
                req.SetMessagePort(port)
                ' siloStartGet answers a Silo request itself and starts any other
                if siloStartGet(req) then running[req.GetIdentity().ToStr()] = { req: req, item: item }
            end if
        end if
    end for

    startedAt = CreateObject("roDateTime").AsSeconds()
    while running.count() > 0 and CreateObject("roDateTime").AsSeconds() - startedAt < FAVORITES_TIMEOUT
        msg = siloWait(1000, port)
        if not isUrlEvent(msg) then continue while
        entry = running[msg.GetSourceIdentity().ToStr()]
        if not isValid(entry) then continue while
        running.Delete(msg.GetSourceIdentity().ToStr())
        if msg.GetResponseCode() <> 200 then continue while
        details = ParseJson(msg.GetString())
        if type(details) <> "roAssociativeArray" then continue while
        if isValidAndNotEmpty(details.FileContents)
            bytes = CreateObject("roByteArray")
            bytes.FromBase64String(details.FileContents)
            details = ParseJson(bytes.ToAsciiString())
        end if
        if type(details) <> "roAssociativeArray" then continue while
        for each key in ["title", "name", "posterPath", "backdropPath", "overview", "releaseDate", "firstAirDate", "voteAverage", "mediaInfo"]
            if isValid(details.LookupCI(key)) then entry.item[key] = details.LookupCI(key)
        end for
    end while
end sub

function watchlistMediaType(item as object) as string
    mediaType = LCase(toString(item.LookupCI("mediaType") ?? item.LookupCI("media_type") ?? ""))
    if mediaType = "tv" or mediaType = "show" or mediaType = "series" then return "tv"
    return "movie"
end function

' Seerr sends the id as a number, which toString() doesn't take and str() would give a leading space
function watchlistTmdbId(item as object) as string
    value = item.LookupCI("tmdbId") ?? item.LookupCI("id")
    if not isValid(value) then return ""
    return value.ToStr().Trim()
end function

' A card the library grid can draw, carrying the Seerr title that opens the request screen
function watchlistNode(item as object) as object
    tmdbId = watchlistTmdbId(item)
    if tmdbId = "" then return invalid
    mediaType = watchlistMediaType(item)
    itemType = mediaType = "tv" ? "Series" : "Movie"
    ' Seerr's watchlist sends an empty title, and a show's details use name instead
    title = toString(item.LookupCI("title") ?? "")
    if title = "" then title = toString(item.LookupCI("name") ?? "")

    ' The request screen reads the TMDB id as the item's id, which a watchlist entry keeps apart
    seerrItem = {}
    seerrItem.Append(item)
    seerrItem.id = tmdbId
    seerrItem.mediaType = mediaType

    urls = GetTmdbImageBaseUrls()
    posterUrl = ""
    if isValidAndNotEmpty(item.LookupCI("posterPath")) then posterUrl = urls.posterW342 + item.LookupCI("posterPath")
    backdropUrl = ""
    if isValidAndNotEmpty(item.LookupCI("backdropPath")) then backdropUrl = urls.backdropW780 + item.LookupCI("backdropPath")

    year = Left(toString(item.LookupCI("releaseDate") ?? item.LookupCI("firstAirDate") ?? ""), 4)
    json = {
        Id: tmdbId,
        Name: title,
        Type: itemType,
        SeerrTmdbId: tmdbId,
        SeerrMediaType: mediaType,
        SeerrItem: seerrItem,
        ProviderIds: { Tmdb: tmdbId },
        Overview: toString(item.LookupCI("overview") ?? ""),
        ImageTags: {},
        BackdropImageTags: [],
        UserData: {}
    }
    if year <> "" then json.ProductionYear = year.ToInt()
    if isValid(item.LookupCI("voteAverage")) then json.CommunityRating = item.LookupCI("voteAverage")

    node = contentNodes.ForType(itemType)
    if not isValid(node) then return invalid
    node.addField("favoritesTab", "string", false)
    node.favoritesTab = "watchlist"
    node.json = json
    node.title = title
    if posterUrl <> "" then node.posterUrl = posterUrl
    node.landscapePosterURL = backdropUrl
    return node
end function

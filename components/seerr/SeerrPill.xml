<?xml version="1.0" encoding="utf-8"?>
<!-- Core's Search and Requests buttons on Seerr Discover: an icon and a label on a dark
     rounded pill, with a count chip when there's something to act on -->
<component name="SeerrPill" extends="Group">
  <interface>
    <field id="text" type="string" onChange="layoutPill" />
    <field id="iconUri" type="string" onChange="layoutPill" />
    <field id="count" type="integer" value="0" onChange="layoutPill" />
    <field id="focused" type="boolean" onChange="showFocus" />
    <field id="accent" type="string" value="#00A4DC" onChange="layoutPill" />
    <field id="focusColor" type="string" value="#FFFFFF" onChange="showFocus" />
    <!-- Read once laid out, so the host can line the pills up from the right -->
    <field id="pillWidth" type="integer" />
  </interface>

  <children>
    <Group id="body">
      <Poster id="fill" uri="pkg:/images/seerr/fill30.9.png" blendColor="#1A1A1A" opacity="0.8" />
      <Poster id="border" uri="pkg:/images/seerr/stroke30w2.9.png" blendColor="#FFFFFF3D" />
      <Poster id="icon" blendColor="#FFFFFFB3" />
      <Label id="label" color="#FFFFFF" vertAlign="center" />
      <Group id="chip" visible="false">
        <Poster id="chipFill" uri="pkg:/images/seerr/fill13.9.png" />
        <Label id="chipLabel" color="#FFFFFF" horizAlign="center" vertAlign="center" />
      </Group>
    </Group>
  </children>
</component>

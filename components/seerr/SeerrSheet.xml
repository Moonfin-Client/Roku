<?xml version="1.0" encoding="utf-8"?>
<!-- The dialogs the Seerr request, cancel, manage, issue and collection flows open: rows, chips,
     pickers and buttons on a panel that keeps every key inside until it closes -->
<component name="SeerrSheet" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" />
    <Group id="panel">
      <Poster id="panelFill" />
      <Poster id="panelBorder" />
      <Label id="title" color="#FFFFFF" wrap="true" />
      <Rectangle id="titleRule" height="2" color="#FFFFFF14" />
      <Group id="viewport">
        <Group id="body" />
      </Group>
      <Group id="footer" />
    </Group>
  </children>
  <interface>
    <!-- core is the dialog panel the pickers and forms use, alert the confirm box with its
         actions on the right -->
    <field id="variant" type="string" value="core" />
    <field id="dialogTitle" type="string" />
    <field id="panelWidth" type="integer" value="735" />
    <!-- In place of the theme's surface, for a box drawn in a color of its own -->
    <field id="surfaceColor" type="string" />
    <!-- [top, sides, bottom] around the body, in dp -->
    <field id="bodyPadding" type="array" />
    <!-- What the body holds, top to bottom, as the kinds render lays out -->
    <field id="elements" type="array" />
    <!-- A picker's dimmed Cancel row under its list -->
    <field id="showCancel" type="boolean" value="false" />
    <field id="focusId" type="string" />
    <field id="activated" type="string" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="render" />
  </interface>
</component>

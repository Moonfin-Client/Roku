<?xml version="1.0" encoding="utf-8"?>
<component name="SeerrDetailBlock" extends="Group">
  <children>
    <StandardButton
      id="tagsChip"
      height="56"
      fontSize="24"
      visible="false"
      outline="true"
      outlineUri="pkg:/images/playback/outline41.9.png" />

    <!-- Filled in at runtime, three facts to a line -->
    <Group id="factsGroup" visible="false" />

    <Group id="recommendationsSection" visible="false">
      <Label id="recommendationsHeading" font="font:MediumBoldSystemFont" color="#FFFFFF" height="40" />
      <RowList id="recommendationsRow"
        translation="[0, 48]"
        itemComponentName="SeerrPoster"
        numRows="1"
        itemSize="[1710, 400]"
        itemSpacing="[0, 0]"
        drawFocusFeedback="true" />
    </Group>

    <Group id="similarSection" visible="false">
      <Label id="similarHeading" font="font:MediumBoldSystemFont" color="#FFFFFF" height="40" />
      <RowList id="similarRow"
        translation="[0, 48]"
        itemComponentName="SeerrPoster"
        numRows="1"
        itemSize="[1710, 400]"
        itemSpacing="[0, 0]"
        drawFocusFeedback="true" />
    </Group>

    <Group id="collectionBanner" visible="false" focusable="true">
      <Poster id="collectionBackdrop" width="1710" height="150" loadDisplayMode="scaleToZoom" />
      <Rectangle id="collectionScrim" width="1710" height="150" color="0x000000B3" />
      <Label id="collectionText" translation="[32, 0]" width="1200" height="150" vertAlign="center"
        font="font:MediumSystemFont" color="0xFFFFFFE6" />
      <Label id="collectionCta" translation="[1300, 0]" width="378" height="150" vertAlign="center"
        horizAlign="right" font="font:SmallBoldSystemFont" color="0x00A4DCFF" />
      <Poster id="collectionFocus" uri="pkg:/images/hd_focus.9.png" width="1710" height="150" visible="false" />
    </Group>
  </children>
  <interface>
    <field id="tmdbId" type="string" value="" />
    <field id="mediaType" type="string" value="movie" />
    <!-- Whether Seerr had anything to say, so a host can leave the block out entirely -->
    <field id="hasContent" type="boolean" value="false" />
    <!-- How far down the block the focused section sits, so a host can scroll it into view -->
    <field id="focusedOffset" type="integer" value="0" alwaysNotify="true" />
    <function name="loadTarget" />
    <function name="focusFirst" />
  </interface>
</component>

import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/seerrButtons.bs"
import "pkg:/source/utils/tvKeyboard.bs"

' Asking Seerr for a title, and taking the ask back. The ask itself is one dialog, the same
' one the other clients put up. Shared so both detail screens behave the same.

sub init()
    m.apiTask = CreateObject("roSGNode", "SeerrAPITask")
end sub

' The detail screens hand over what they already fetched rather than asking again
sub begin(action as string)
    details = m.top.details
    if not isValid(details) then return

    if action = "seerrCancelHd" or action = "seerrCancel4k"
        m.pendingRequests = seerrButtons.PendingRequests(details.mediaInfo, action = "seerrCancel4k")
        onCancelRequestPressed()
    else if action = "seerrRequest4k"
        ShowRequestDialog(true, false)
    else if action = "seerrRequest"
        ' One button covers both tracks, so the dialog carries the switch between them
        ShowRequestDialog(false, seerrButtons.OffersBothTracks(details, m.top.mediaType))
    else if action = "seerrWatchlist"
        ToggleWatchlist()
    else if action = "seerrReportIssue"
        StartReportIssue()
    else if action = "seerrManage"
        ShowManageRequests()
    end if
end sub

' ===== Watchlist =====

sub ToggleWatchlist()
    startLoadingSpinner()

    if m.top.details.onUserWatchlist = true
        m.watchlistTask = CreateObject("roSGNode", "SeerrAPITask")
        ' The query rides on the endpoint, since an assocarray crossing a node field
        ' arrives with its keys lowercased and Seerr reads mediaType as written
        m.watchlistTask.request = {
            method: "DELETE",
            endpoint: `/api/v1/watchlist/${m.top.tmdbId}?mediaType=${m.top.mediaType}`
        }
    else
        m.watchlistTask = CreateObject("roSGNode", "SeerrAPITask")
        m.watchlistTask.request = {
            method: "POST",
            endpoint: "/api/v1/watchlist",
            bodyJson: SeerrJsonFromPairs([
                { key: "tmdbId", value: m.top.tmdbId.toInt() },
                { key: "mediaType", value: m.top.mediaType }
            ])
        }
    end if

    m.watchlistTask.observeField("response", "onWatchlistToggled")
    m.watchlistTask.control = TaskControl.RUN
end sub

sub onWatchlistToggled(event as object)
    response = event.getData()
    stopLoadingSpinner()

    if not isValid(response) or not response.success
        ShowMessage(tr("Request Failed"), tr("Could not update the watchlist."))
        return
    end if

    m.top.watchlistState = not (m.top.details.onUserWatchlist = true)
end sub

' ===== Reporting an issue =====

sub StartReportIssue()
    m.issueType = 0
    m.issueSeason = 0
    m.issueEpisode = 0

    ShowDialog(tr("Report Issue"), "", [tr("Video"), tr("Audio"), tr("Subtitles"), tr("Other")], "onIssueTypeChosen")
end sub

sub onIssueTypeChosen(event as object)
    index = event.getData()
    CloseDialog()
    if index < 0 then return

    ' Seerr numbers the kinds one to four in the order they were offered
    m.issueType = index + 1

    if isStringEqual(m.top.mediaType, "tv")
        ShowSeasonPrompt()
        return
    end if

    ShowIssueKeyboard()
end sub

sub ShowSeasonPrompt()
    m.issueSeasonNumbers = []
    options = [tr("All Seasons")]

    seasons = chainLookupReturn(m.top.details, "seasons", invalid)
    if isValid(seasons) and type(seasons) = "roArray"
        for each season in seasons
            number = chainLookupReturn(season, "seasonNumber", invalid)
            if isValid(number) and number > 0
                m.issueSeasonNumbers.push({ number: number, episodes: chainLookupReturn(season, "episodeCount", 0) })
                options.push(Substitute(tr("Season ^0"), number.toStr()))
            end if
        end for
    end if

    if options.count() = 1
        ShowIssueKeyboard()
        return
    end if

    ShowDialog(tr("Report Issue"), "", options, "onIssueSeasonChosen")
end sub

sub onIssueSeasonChosen(event as object)
    index = event.getData()
    CloseDialog()
    if index < 0 then return

    if index = 0
        ShowIssueKeyboard()
        return
    end if

    chosen = m.issueSeasonNumbers[index - 1]
    m.issueSeason = chosen.number

    if chosen.episodes <= 0
        ShowIssueKeyboard()
        return
    end if

    options = [tr("All Episodes")]
    for episode = 1 to chosen.episodes
        options.push(`E${episode.toStr()}`)
    end for

    ShowDialog(Substitute(tr("Season ^0"), chosen.number.toStr()), "", options, "onIssueEpisodeChosen")
end sub

sub onIssueEpisodeChosen(event as object)
    index = event.getData()
    CloseDialog()
    if index < 0 then return

    if index > 0 then m.issueEpisode = index

    ShowIssueKeyboard()
end sub

sub ShowIssueKeyboard()
    m.keyboard = tvKeyboard.Open(m.top.getScene(), {
        title: tr("Describe the issue...")
    })
    m.keyboard.observeField("submitted", "onIssueMessageSubmitted")
    m.keyboard.observeField("cancelled", "onIssueKeyboardClosed")
end sub

sub onIssueMessageSubmitted(event as object)
    message = event.getRoSGNode().text
    onIssueKeyboardClosed(event)

    if not isValidAndNotEmpty(message) then return

    startLoadingSpinner()

    m.issueTask = CreateObject("roSGNode", "SeerrAPITask")
    m.issueTask.request = {
        method: "POST",
        endpoint: "/api/v1/issue",
        bodyJson: SeerrJsonFromPairs([
            { key: "issueType", value: m.issueType },
            { key: "message", value: message },
            { key: "mediaId", value: chainLookupReturn(m.top.details, "mediaInfo.id", 0) },
            { key: "problemSeason", value: m.issueSeason },
            { key: "problemEpisode", value: m.issueEpisode }
        ])
    }
    m.issueTask.observeField("response", "onIssueReported")
    m.issueTask.control = TaskControl.RUN
end sub

sub onIssueKeyboardClosed(_event as object)
    tvKeyboard.Release(m.keyboard, ["submitted", "cancelled"])
    m.keyboard = invalid
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
end sub

sub onIssueReported(event as object)
    response = event.getData()
    stopLoadingSpinner()

    if not isValid(response) or not response.success
        ShowMessage(tr("Request Failed"), tr("Could not report the issue."))
        return
    end if

    ShowMessage(tr("Success"), tr("Issue reported."))
end sub

' ===== Moderating requests =====

sub ShowManageRequests()
    m.manageable = seerrButtons.AllPendingRequests(m.top.details.mediaInfo)
    if m.manageable.count() = 0 then return

    options = []
    for each request in m.manageable
        options.push(ManageRequestLabel(request))
    end for

    ShowDialog(tr("Manage Requests"), "", options, "onManageRequestChosen")
end sub

function ManageRequestLabel(request as object) as string
    who = chainLookupReturn(request, "requestedBy.displayName", "")
    if not isValidAndNotEmpty(who) then who = tr("Unknown")

    label = `${who} · ${request.is4k = true ? "4K" : "HD"}`

    numbers = []
    seasons = chainLookupReturn(request, "seasons", invalid)
    if isValid(seasons) and type(seasons) = "roArray"
        for each season in seasons
            number = chainLookupReturn(season, "seasonNumber", invalid)
            if isValid(number) and number > 0 then numbers.push(number.toStr())
        end for
    end if
    if numbers.count() > 0 then label += ` · ${tr("Seasons")} ${numbers.join(", ")}`

    return label
end function

sub onManageRequestChosen(event as object)
    index = event.getData()
    CloseDialog()
    if index < 0 or index >= m.manageable.count() then return

    m.managed = m.manageable[index]
    ShowDialog(ManageRequestLabel(m.managed), "", [tr("Approve"), tr("Decline"), tr("Cancel")], "onManageActionChosen")
end sub

sub onManageActionChosen(event as object)
    index = event.getData()
    CloseDialog()
    if index < 0 or index > 1 then return

    startLoadingSpinner()

    m.manageTask = CreateObject("roSGNode", "SeerrAPITask")
    m.manageTask.request = {
        method: "POST",
        endpoint: `/api/v1/request/${m.managed.id.toStr()}/${index = 0 ? "approve" : "decline"}`
    }
    m.manageTask.observeField("response", "onManageActionDone")
    m.manageTask.control = TaskControl.RUN
end sub

sub onManageActionDone(event as object)
    response = event.getData()
    stopLoadingSpinner()

    if not isValid(response) or not response.success
        ShowMessage(tr("Request Failed"), tr("Could not update the request."))
        return
    end if

    m.top.requestCompleted = true
end sub

' ===== The request dialog =====

sub ShowRequestDialog(is4k as boolean, qualityToggle as boolean)
    permissions = GetCurrentUserSeerrPermissions()

    m.requestDialog = CreateObject("roSGNode", "SeerrRequestDialog")
    m.requestDialog.details = m.top.details
    m.requestDialog.mediaType = m.top.mediaType
    m.requestDialog.is4k = is4k
    m.requestDialog.qualityToggle = qualityToggle
    m.requestDialog.canRequest4k = CanRequest4K(permissions, m.top.mediaType)
    m.requestDialog.canRequestAdvanced = HasAdvancedRequestPermission(permissions)
    m.requestDialog.seerrUserId = CurrentSeerrUserId()
    m.requestDialog.returnFocus = m.top.returnFocus

    m.requestDialog.observeField("submitted", "onRequestDialogSubmitted")
    m.requestDialog.observeField("wasCancelled", "onRequestDialogCancelled")

    m.top.getScene().appendChild(m.requestDialog)
    m.requestDialog.callFunc("showDialog")
end sub

sub CloseRequestDialog()
    if not isValid(m.requestDialog) then return

    m.requestDialog.unobserveField("submitted")
    m.requestDialog.unobserveField("wasCancelled")
    m.top.getScene().removeChild(m.requestDialog)
    m.requestDialog = invalid
end sub

sub onRequestDialogSubmitted(event as object)
    if event.getData() <> true then return

    result = m.requestDialog.result
    CloseRequestDialog()
    SubmitRequest(result)
end sub

sub onRequestDialogCancelled(event as object)
    if event.getData() <> true then return

    CloseRequestDialog()
end sub

' ===== Submitting =====

sub SubmitRequest(result as object)
    if not isValid(result) then return

    startLoadingSpinner()
    m.lastRequestIs4k = result.is4k

    pairs = [
        { key: "mediaType", value: m.top.mediaType },
        { key: "mediaId", value: m.top.tmdbId.toInt() },
        { key: "is4k", value: result.is4k }
    ]

    if isStringEqual(m.top.mediaType, "tv")
        if isValid(result.seasons) and result.seasons.count() > 0
            pairs.push({ key: "seasons", value: result.seasons })
        else
            pairs.push({ key: "seasons", value: "all" })
        end if
    end if

    if isValid(result.serverId) then pairs.push({ key: "serverId", value: result.serverId })
    if isValid(result.profileId) then pairs.push({ key: "profileId", value: result.profileId })
    if isValidAndNotEmpty(result.rootFolder) then pairs.push({ key: "rootFolder", value: result.rootFolder })

    m.apiTask.request = {
        method: "POST",
        endpoint: "/api/v1/request",
        bodyJson: SeerrJsonFromPairs(pairs)
    }
    m.apiTask.unobserveField("response")
    m.apiTask.observeField("response", "onRequestSubmitted")
    m.apiTask.control = TaskControl.RUN
end sub

sub onRequestSubmitted(event as object)
    response = event.getData()
    stopLoadingSpinner()

    qualityLabel = m.lastRequestIs4k = true ? "4K" : "HD"

    if response.success
        ShowSuccessAndReload(Substitute(tr("^0 request submitted."), qualityLabel))
        return
    end if

    if response.statusCode = 403
        ShowMessage(tr("Permission Denied"), tr("You don't have permission to make this request. Ask your Seerr administrator to adjust your permissions."))
        return
    end if

    if response.statusCode = 409
        ShowMessage(tr("Request Failed"), tr("This title was already requested."))
        return
    end if

    ShowMessage(tr("Request Failed"), RequestErrorMessage(response, qualityLabel))
end sub

' The task unwraps whatever reason Seerr sent, and falls back to a message of its own
' that says nothing, so the status code stands in for it
function RequestErrorMessage(response as object, qualityLabel as string) as string
    if isValidAndNotEmpty(response.error) and response.error <> "Plugin request failed"
        return response.error
    end if

    status = 0
    if isValid(response.statusCode) then status = response.statusCode

    return Substitute(tr("Could not submit the ^0 request (HTTP ^1)."), qualityLabel, status.toStr())
end function

' ===== Taking a request back =====

sub onCancelRequestPressed()
    if not isValid(m.pendingRequests) or m.pendingRequests.count() = 0
        ShowMessage(tr("No Requests"), tr("There are no pending requests to cancel."))
        return
    end if

    ShowDialog(tr("Cancel Request"), CancelDescription(), [tr("Keep Request"), tr("Cancel Request")], "onCancelConfirmResponse")
end sub

' One request names its track, several are counted per track
function CancelDescription() as string
    title = chainLookupReturn(m.top.details, "title", "")
    if not isValidAndNotEmpty(title) then title = chainLookupReturn(m.top.details, "name", "")

    if m.pendingRequests.count() = 1
        quality = m.pendingRequests[0].is4k = true ? "4K" : "HD"
        return Substitute(tr(`Cancel ^0 request for "^1"?`), quality, title)
    end if

    hdCount = 0
    fourKCount = 0
    for each request in m.pendingRequests
        if request.is4k = true
            fourKCount++
        else
            hdCount++
        end if
    end for

    parts = []
    if hdCount > 0 then parts.push(Substitute(tr("^0 HD"), hdCount.toStr()))
    if fourKCount > 0 then parts.push(Substitute(tr("^0 4K"), fourKCount.toStr()))

    return Substitute(tr(`Cancel ^0 requests for "^1"?`), parts.join(` ${tr("and")} `), title)
end function

sub onCancelConfirmResponse(event as object)
    confirmed = event.getData() = 1
    CloseDialog()

    if confirmed then CancelPendingRequests()
end sub

sub CancelPendingRequests()
    if not isValid(m.pendingRequests) or m.pendingRequests.count() = 0 then return

    startLoadingSpinner()

    m.cancelRequestsRemaining = m.pendingRequests.count()
    m.cancelRequestsSuccess = 0
    m.cancelRequestsFailed = 0
    m.cancelTasks = []

    for each request in m.pendingRequests
        CancelSingleRequest(request.id)
    end for
end sub

sub CancelSingleRequest(requestId as integer)
    task = CreateObject("roSGNode", "SeerrAPITask")
    task.request = {
        method: "DELETE",
        endpoint: `/api/v1/request/${requestId.toStr()}`
    }
    task.observeField("response", "onCancelRequestResponse")

    ' Held onto, otherwise the node goes out of scope while the call is still in flight
    m.cancelTasks.push(task)
    task.control = TaskControl.RUN
end sub

sub onCancelRequestResponse(event as object)
    response = event.getData()

    m.cancelRequestsRemaining = m.cancelRequestsRemaining - 1
    if response.success
        m.cancelRequestsSuccess = m.cancelRequestsSuccess + 1
    else
        m.cancelRequestsFailed = m.cancelRequestsFailed + 1
    end if

    if m.cancelRequestsRemaining > 0 then return

    stopLoadingSpinner()
    m.cancelTasks = []

    if m.cancelRequestsFailed = 0
        if m.cancelRequestsSuccess = 1
            ShowSuccessAndReload(tr("Request cancelled."))
        else
            ShowSuccessAndReload(Substitute(tr("^0 requests cancelled."), m.cancelRequestsSuccess.toStr()))
        end if
    else if m.cancelRequestsSuccess = 0
        ShowMessage(tr("Request Failed"), tr("Could not cancel the request. You may not have permission."))
    else
        ' Some of the tracks were taken, so the host still refetches
        ShowSuccessAndReload(Substitute(tr("^0 cancelled, ^1 failed."), m.cancelRequestsSuccess.toStr(), m.cancelRequestsFailed.toStr()))
    end if
end sub

' ===== Panels =====

sub ShowDialog(title as string, message as string, options as object, callback as string)
    m.messageDialog = CreateObject("roSGNode", "ListPromptDialog")
    m.messageDialog.dialogTitle = title
    m.messageDialog.message = message
    m.messageDialog.options = options
    m.messageDialog.returnFocus = m.top.returnFocus
    m.messageDialog.observeField("optionSelected", callback)

    m.top.getScene().appendChild(m.messageDialog)
    m.messageDialog.callFunc("showDialog")
end sub

sub CloseDialog()
    if not isValid(m.messageDialog) then return

    m.messageDialog.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.messageDialog)
    m.messageDialog = invalid
end sub

sub ShowMessage(title as string, message as string)
    ShowDialog(title, message, [tr("OK")], "onMessageDialogClosed")
end sub

sub onMessageDialogClosed(_event as object)
    CloseDialog()
end sub

sub ShowSuccessAndReload(message as string)
    ShowDialog(tr("Success"), message, [tr("OK")], "onSuccessDialogClosed")
end sub

sub onSuccessDialogClosed(_event as object)
    CloseDialog()
    m.top.requestCompleted = true
end sub

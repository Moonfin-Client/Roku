import "pkg:/components/itemMenu/itemMenuToastHost.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrButtons.bs"
import "pkg:/source/utils/seerrRequestRules.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/tvKeyboard.bs"

' Asking Seerr for a title, taking the ask back, answering open requests and reporting an issue,
' each in a Seerr sheet. Shared so every detail screen behaves the same.

sub init()
    m.apiTask = CreateObject("roSGNode", "SeerrAPITask")
    m.sheet = invalid
    m.sheetKind = ""
    m.picker = invalid
end sub

' The detail screens hand over what they already fetched rather than asking again
sub begin(action as string)
    details = m.top.details
    if not isValid(details) then return

    if action = "seerrCancelHd" or action = "seerrCancel4k"
        ShowCancel(action = "seerrCancel4k")
    else if action = "seerrRequest4k"
        ShowRequestDialog(true, false)
    else if action = "seerrRequest"
        ' One button covers both tracks, so the dialog carries the switch between them
        ShowRequestDialog(false, seerrButtons.OffersBothTracks(details, m.top.mediaType))
    else if action = "seerrWatchlist"
        ToggleWatchlist()
    else if action = "seerrReportIssue"
        ShowReportIssue()
    else if action = "seerrManage"
        ShowManageRequests()
    end if
end sub

function IsTv() as boolean
    return isStringEqual(m.top.mediaType, "tv")
end function

' The reason Seerr sent back, or a line of our own when it sent none
function FailureText(response as dynamic, fallback as string) as string
    reason = chainLookupReturn(response, "error", "")
    if isValidAndNotEmpty(reason) and reason <> "Plugin request failed" then return reason
    return fallback
end function

' The library's name for the title, the series' on a season or episode page
function ItemTitle() as string
    if isValidAndNotEmpty(m.top.itemName) then return m.top.itemName
    title = chainLookupReturn(m.top.details, "title", "")
    if not isValidAndNotEmpty(title) then title = chainLookupReturn(m.top.details, "name", "")
    return title
end function

' ===== Watchlist =====

sub ToggleWatchlist()
    startLoadingSpinner()

    if m.top.details.onUserWatchlist = true
        m.watchlistTask = CreateObject("roSGNode", "SeerrAPITask")
        ' The query rides on the endpoint, since an assocarray crossing a node field
        ' arrives with its keys lowercased and Seerr reads mediaType as written
        m.watchlistTask.request = {
            method: "DELETE",
            endpoint: `/api/v1/watchlist/${m.top.tmdbId}?mediaType=${m.top.mediaType}`
        }
    else
        m.watchlistTask = CreateObject("roSGNode", "SeerrAPITask")
        m.watchlistTask.request = {
            method: "POST",
            endpoint: "/api/v1/watchlist",
            bodyJson: SeerrJsonFromPairs([
                { key: "tmdbId", value: m.top.tmdbId.toInt() },
                { key: "mediaType", value: m.top.mediaType }
            ])
        }
    end if

    m.watchlistTask.observeField("response", "onWatchlistToggled")
    m.watchlistTask.control = TaskControl.RUN
end sub

sub onWatchlistToggled(event as object)
    response = event.getData()
    stopLoadingSpinner()

    if not isValid(response) or not response.success
        showItemMenuToast(FailureText(response, tr("Could not update the watchlist.")))
        return
    end if

    m.top.watchlistState = not (m.top.details.onUserWatchlist = true)
end sub

' ===== The sheets =====

function OpenSheet(kind as string, variant as string, title as string, padding as dynamic) as object
    CloseSheet()
    m.sheet = CreateObject("roSGNode", "SeerrSheet")
    m.sheet.variant = variant
    m.sheet.dialogTitle = title
    if isValid(padding) then m.sheet.bodyPadding = padding
    m.sheet.observeField("activated", "onSheetActivated")
    m.sheet.observeField("closed", "CloseSheet")
    m.sheetKind = kind
    m.top.getScene().appendChild(m.sheet)
    return m.sheet
end function

sub ShowSheet(elements as object)
    m.sheet.elements = elements
    m.sheet.callFunc("render")
    if not isValid(m.picker) then m.sheet.setFocus(true)
end sub

sub CloseSheet()
    ClosePicker()
    if not isValid(m.sheet) then return
    m.sheet.unobserveField("activated")
    m.sheet.unobserveField("closed")
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
    m.top.getScene().removeChild(m.sheet)
    m.sheet = invalid
    m.sheetKind = ""
end sub

sub onSheetActivated(event as object)
    id = event.getData()
    if m.sheetKind = "cancel"
        if id = "confirm" then ConfirmCancel() else CloseSheet()
    else if m.sheetKind = "manage"
        ResolveRequest(id)
    else if m.sheetKind = "report"
        onReportAction(id)
    end if
end sub

sub OpenPicker(title as string, labels as object, selected as integer, callback as string)
    m.picker = CreateSeerrPicker(title, labels, selected)
    m.picker.observeField("activated", callback)
    m.picker.observeField("closed", "ClosePicker")
    m.top.getScene().appendChild(m.picker)
    m.picker.setFocus(true)
end sub

sub ClosePicker()
    if not isValid(m.picker) then return
    m.picker.unobserveField("activated")
    m.picker.unobserveField("closed")
    if isValid(m.sheet) then m.sheet.setFocus(true)
    m.top.getScene().removeChild(m.picker)
    m.picker = invalid
end sub

' ===== Reporting an issue =====

' Opened from a season or an episode, the form starts on that one. Otherwise a series with only
' one season starts on it.
sub ShowReportIssue()
    details = m.top.details
    m.reportSeasons = seerrRequestRules.SeasonNumbers(chainLookupReturn(details, "seasons", invalid), chainLookupReturn(details, "numberOfSeasons", 0))
    m.reportType = 1
    m.reportSeason = 0
    m.reportEpisode = 0
    if IsTv()
        if m.top.initialSeason > 0
            m.reportSeason = m.top.initialSeason
            if m.top.initialEpisode > 0 then m.reportEpisode = m.top.initialEpisode
        else if m.reportSeasons.count() = 1
            m.reportSeason = m.reportSeasons[0]
        end if
    end if
    m.reportMessage = ""
    m.reportSending = false

    sheet = OpenSheet("report", "core", tr("Report Issue"), invalid)
    sheet.focusId = "type:1"
    RenderReport()
end sub

sub RenderReport()
    elements = []
    labels = [tr("Video"), tr("Audio"), tr("Subtitles"), tr("Other")]
    for i = 0 to labels.count() - 1
        elements.push({ kind: "radio", id: `type:${i + 1}`, title: labels[i], selected: m.reportType = i + 1 })
    end for
    if IsTv() and m.reportSeasons.count() > 0
        elements.push({ kind: "divider" })
        elements.push({ kind: "selector", id: "season", label: tr("Season"), value: SeasonLabel(m.reportSeason), gap: 4 })
        if m.reportSeason > 0 then elements.push({ kind: "selector", id: "episode", label: tr("Episode"), value: EpisodeLabel(m.reportEpisode), gap: 12 })
    end if
    elements.push({ kind: "label", text: tr("What's wrong?"), size: 13, color: "#FFFFFFB3", gap: 16 })
    elements.push({ kind: "field", id: "message", text: m.reportMessage, placeholder: tr("What's wrong?"), gap: 8 })
    canSend = m.reportMessage.Trim() <> "" and not m.reportSending
    elements.push({ kind: "buttons", gap: 20, items: [
        { id: "cancel", label: tr("Cancel"), enabled: not m.reportSending },
        { id: "submit", label: tr("Submit Report"), primary: true, busy: m.reportSending, enabled: canSend }
    ] })
    ShowSheet(elements)
end sub

function SeasonLabel(season as integer) as string
    if season > 0 then return Substitute(tr("Season ^0"), season.ToStr())
    return tr("All Seasons")
end function

function EpisodeLabel(episode as integer) as string
    if episode > 0 then return Substitute(tr("Episode ^0"), episode.ToStr())
    return tr("All Episodes")
end function

function ReportEpisodeCount() as integer
    seasons = chainLookupReturn(m.top.details, "seasons", invalid)
    if type(seasons) <> "roArray" then return 0
    for each season in seasons
        if chainLookupReturn(season, "seasonNumber", -1) = m.reportSeason then return chainLookupReturn(season, "episodeCount", 0)
    end for
    return 0
end function

sub onReportAction(id as string)
    if Left(id, 5) = "type:"
        m.reportType = Mid(id, 6).ToInt()
        RenderReport()
    else if id = "season"
        labels = []
        selected = 0
        values = [0]
        values.Append(m.reportSeasons)
        for i = 0 to values.count() - 1
            labels.push(SeasonLabel(values[i]))
            if values[i] = m.reportSeason then selected = i
        end for
        m.reportSeasonValues = values
        OpenPicker(tr("Season"), labels, selected, "onReportSeasonPicked")
    else if id = "episode"
        labels = []
        for i = 0 to ReportEpisodeCount()
            labels.push(EpisodeLabel(i))
        end for
        selected = m.reportEpisode
        if selected > labels.count() - 1 then selected = labels.count() - 1
        OpenPicker(tr("Episode"), labels, selected, "onReportEpisodePicked")
    else if id = "message"
        m.keyboard = tvKeyboard.Open(m.top.getScene(), { title: tr("What's wrong?"), text: m.reportMessage })
        m.keyboard.observeField("submitted", "onReportMessage")
        m.keyboard.observeField("cancelled", "onReportKeyboardClosed")
    else if id = "cancel"
        CloseSheet()
    else if id = "submit"
        SendReport()
    end if
end sub

sub onReportSeasonPicked(event as object)
    id = event.getData()
    if id <> "cancel"
        m.reportSeason = m.reportSeasonValues[id.ToInt()]
        m.reportEpisode = 0
    end if
    ClosePicker()
    RenderReport()
end sub

sub onReportEpisodePicked(event as object)
    id = event.getData()
    if id <> "cancel" then m.reportEpisode = id.ToInt()
    ClosePicker()
    RenderReport()
end sub

sub onReportMessage(event as object)
    m.reportMessage = event.getRoSGNode().text
    onReportKeyboardClosed(event)
    RenderReport()
end sub

sub onReportKeyboardClosed(_event as object)
    tvKeyboard.Release(m.keyboard, ["submitted", "cancelled"])
    m.keyboard = invalid
end sub

sub SendReport()
    message = m.reportMessage.Trim()
    if message = "" or m.reportSending then return
    m.reportSending = true
    RenderReport()

    season = 0
    episode = 0
    if IsTv()
        season = m.reportSeason
        if season > 0 then episode = m.reportEpisode
    end if
    m.issueTask = CreateObject("roSGNode", "SeerrAPITask")
    m.issueTask.request = {
        method: "POST",
        endpoint: "/api/v1/issue",
        bodyJson: SeerrJsonFromPairs([
            { key: "issueType", value: m.reportType },
            { key: "message", value: message },
            { key: "mediaId", value: chainLookupReturn(m.top.details, "mediaInfo.id", 0) },
            { key: "problemSeason", value: season },
            { key: "problemEpisode", value: episode }
        ])
    }
    m.issueTask.observeField("response", "onIssueReported")
    m.issueTask.control = TaskControl.RUN
end sub

' A report that didn't go through leaves the form open as it was
sub onIssueReported(event as object)
    response = event.getData()
    if m.sheetKind <> "report" then return
    if isValid(response) and response.success = true
        CloseSheet()
        return
    end if
    m.reportSending = false
    RenderReport()
end sub

' ===== Moderating requests =====

sub ShowManageRequests()
    m.managed = seerrButtons.AllPendingRequests(m.top.details.mediaInfo)
    if m.managed.count() = 0 then return

    m.manageBusy = false
    OpenSheet("manage", "core", tr("Manage Requests"), [0, 0, 0])
    RenderManage()
end sub

' Each request waiting on the title, with its own Approve and Decline. Only one answer goes out at
' a time, so the buttons wait while one is out.
sub RenderManage()
    elements = []
    for each request in m.managed
        id = request.id.ToStr()
        elements.push({ kind: "label", text: RequesterLabel(request), size: 14, gap: 12, after: 8 })
        elements.push({ kind: "buttons", items: [
            { id: `approve:${id}`, label: tr("Approve"), icon: "check_circle_outline", primary: true, color: "#388E3C", enabled: not m.manageBusy },
            { id: `decline:${id}`, label: tr("Decline"), icon: "cancel_outlined", foreground: "#E57373", enabled: not m.manageBusy }
        ] })
    end for
    ShowSheet(elements)
end sub

function RequesterLabel(request as object) as string
    label = Substitute(tr("Requested by ^0"), SeerrRequesterName(request))
    if request.is4k = true then label += " · " + tr("4K")
    return label
end function

sub ResolveRequest(id as string)
    if m.manageBusy then return
    parts = id.Split(":")
    if parts.count() <> 2 then return

    m.manageBusy = true
    m.resolvingId = parts[1]
    RenderManage()
    m.manageTask = CreateObject("roSGNode", "SeerrAPITask")
    m.manageTask.request = { method: "POST", endpoint: `/api/v1/request/${parts[1]}/${parts[0]}` }
    m.manageTask.observeField("response", "onRequestResolved")
    m.manageTask.control = TaskControl.RUN
end sub

' Answering the last request leaves nothing to manage, so the sheet closes
sub onRequestResolved(event as object)
    response = event.getData()
    m.manageBusy = false
    if m.sheetKind <> "manage" then return

    if not isValid(response) or response.success <> true
        showItemMenuToast(FailureText(response, tr("Failed to update request")))
        RenderManage()
        return
    end if

    remaining = []
    for each request in m.managed
        if request.id.ToStr() <> m.resolvingId then remaining.push(request)
    end for
    m.managed = remaining
    m.top.requestCompleted = true
    if m.managed.count() = 0
        CloseSheet()
    else
        RenderManage()
    end if
end sub

' ===== Taking a request back =====

' Every request handed in is on the one track, which the title names
sub ShowCancel(is4k as boolean)
    requests = chainLookupReturn(m.top.details, "mediaInfo.requests", invalid)
    m.cancelTargets = seerrRequestRules.Cancelable(requests, is4k, CanManageRequests(GetCurrentUserSeerrPermissions()), CurrentSeerrUserId())
    count = m.cancelTargets.count()
    if count = 0 then return

    label = is4k ? tr("Cancel 4K Request") : tr("Cancel Request")
    message = Substitute(tr(`Cancel request for "^0"?`), ItemTitle())
    if count > 1 then message = Substitute(tr(`Cancel ^0 requests for "^1"?`), count.ToStr(), ItemTitle())

    sheet = OpenSheet("cancel", "alert", label, invalid)
    sheet.surfaceColor = "#1A1A2E"
    sheet.focusId = "keep"
    ShowSheet([
        { kind: "text", text: message },
        { kind: "textActions", gap: 24, items: [
            { id: "keep", label: tr("Keep") },
            { id: "confirm", label: label, destructive: true }
        ] }
    ])
end sub

' One after another, then the title is read again. A failure stops the rest.
sub ConfirmCancel()
    CloseSheet()
    m.cancelQueue = m.cancelTargets
    CancelNext()
end sub

sub CancelNext()
    if m.cancelQueue.count() = 0
        m.top.requestCompleted = true
        return
    end if
    request = m.cancelQueue.Shift()
    m.cancelTask = CreateObject("roSGNode", "SeerrAPITask")
    m.cancelTask.request = { method: "DELETE", endpoint: `/api/v1/request/${request.id.ToStr()}` }
    m.cancelTask.observeField("response", "onRequestCancelled")
    m.cancelTask.control = TaskControl.RUN
end sub

sub onRequestCancelled(event as object)
    response = event.getData()
    if not isValid(response) or response.success <> true
        showItemMenuToast(FailureText(response, tr("Failed to cancel request")))
        return
    end if
    CancelNext()
end sub

' ===== The request dialog =====

sub ShowRequestDialog(is4k as boolean, qualityToggle as boolean)
    permissions = GetCurrentUserSeerrPermissions()

    m.requestDialog = CreateObject("roSGNode", "SeerrRequestDialog")
    m.requestDialog.details = m.top.details
    m.requestDialog.mediaType = m.top.mediaType
    m.requestDialog.is4k = is4k
    m.requestDialog.qualityToggle = qualityToggle
    m.requestDialog.canRequest4k = CanRequest4K(permissions, m.top.mediaType)
    m.requestDialog.canRequestAdvanced = HasAdvancedRequestPermission(permissions)
    m.requestDialog.seerrUserId = CurrentSeerrUserId()
    m.requestDialog.returnFocus = m.top.returnFocus

    m.requestDialog.observeField("submitted", "onRequestDialogSubmitted")
    m.requestDialog.observeField("wasCancelled", "onRequestDialogCancelled")

    m.top.getScene().appendChild(m.requestDialog)
    m.requestDialog.callFunc("showDialog")
end sub

sub CloseRequestDialog()
    if not isValid(m.requestDialog) then return

    m.requestDialog.unobserveField("submitted")
    m.requestDialog.unobserveField("wasCancelled")
    m.top.getScene().removeChild(m.requestDialog)
    m.requestDialog = invalid
end sub

sub onRequestDialogSubmitted(event as object)
    if event.getData() <> true then return

    result = m.requestDialog.result
    CloseRequestDialog()
    SubmitRequest(result)
end sub

sub onRequestDialogCancelled(event as object)
    if event.getData() <> true then return

    CloseRequestDialog()
end sub

' ===== Submitting =====

sub SubmitRequest(result as object)
    if not isValid(result) then return

    pairs = [
        { key: "mediaType", value: m.top.mediaType },
        { key: "mediaId", value: m.top.tmdbId.toInt() },
        { key: "is4k", value: result.is4k }
    ]

    if isStringEqual(m.top.mediaType, "tv")
        if isValid(result.seasons) and result.seasons.count() > 0
            pairs.push({ key: "seasons", value: result.seasons })
        else
            pairs.push({ key: "seasons", value: "all" })
        end if
    end if

    if isValid(result.serverId) then pairs.push({ key: "serverId", value: result.serverId })
    if isValid(result.profileId) then pairs.push({ key: "profileId", value: result.profileId })
    if isValidAndNotEmpty(result.rootFolder) then pairs.push({ key: "rootFolder", value: result.rootFolder })

    m.apiTask.request = {
        method: "POST",
        endpoint: "/api/v1/request",
        bodyJson: SeerrJsonFromPairs(pairs)
    }
    m.apiTask.unobserveField("response")
    m.apiTask.observeField("response", "onRequestSubmitted")
    m.apiTask.control = TaskControl.RUN
end sub

' A request that goes through reads the title again quietly, and one that doesn't says why
sub onRequestSubmitted(event as object)
    response = event.getData()
    if isValid(response) and response.success = true
        m.top.requestCompleted = true
        return
    end if
    showItemMenuToast(FailureText(response, tr("Request failed")))
end sub

import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrBrowseRows.bs"
import "pkg:/source/utils/seerrSliders.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/themeChrome.bs"

' Core's TV layout on a 1080p screen. A row's title band and the room under its cards are Home's,
' so Row Padding spaces both screens' rows alike.
const HEADER_HEIGHT = 56
const PLAIN_GAP = 20
const MODERN_INFO_HEIGHT = 292
const MODERN_RATINGS_ROOM = 14
const CLASSIC_CAPTION_ROOM = 118
const TILE_GAP = 20
const TILE_ROW_PAD = 17
const CARD_TEXT_HEIGHT = 62
const RING_OUTSET = 8
const PILL_GAP = 17
const PILLS_RIGHT = 40
' Classic keeps its info above the rows, and its posters grow from their bottom edge when focused
' cards grow
const CLASSIC_ROWS_TOP = 450
const GROW_SCALE = 1.12
' Room above a card for its ring, kept inside the card since the list clips each row to its items
const RING_ROOM = 9
const TILE_ROOM = 6
' The list clips what it draws, so it starts this far left of the cards to leave a grown card
' and its ring room
const CLIP_MARGIN = 24
' How many titles the request, watchlist and recently added rows read, as Core does
const LOCAL_ROW_LIMIT = 15
const ENRICH_AT_ONCE = 2
' Seerr's permission to see what was added lately, which its own pages enforce and the API doesn't
const SEERR_PERMISSION_RECENT_VIEW = 67108864
const SEERR_PERMISSION_REQUEST_VIEW = 16384

sub init()
    m.categoryRows = m.top.findNode("categoryRows")
    m.loadingLabel = m.top.findNode("loadingLabel")
    m.errorLabel = m.top.findNode("errorLabel")
    m.itemTitle = m.top.findNode("itemTitle")
    m.itemOverview = m.top.findNode("itemOverview")
    m.metadataText = m.top.findNode("metadataText")
    m.backdrop = m.top.findNode("backdrop")
    m.backdropPrev = m.top.findNode("backdropPrev")

    m.backdrop.observeField("loadStatus", "onBackdropLoadStatusChange")
    m.backdropFadeIn = m.top.findNode("backdropFadeIn")
    m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")
    m.backdropFadeInInterp = m.top.findNode("backdropFadeInInterp")
    m.backdropPrevFadeOutInterp = m.top.findNode("backdropPrevFadeOutInterp")
    m.backdropCrossfading = false
    m.backdropTargetOpacity = 1.0

    m.rowPages = {}
    m.rowHasMore = {}
    m.isLoadingMore = {}
    m.apiTasks = {}
    m.enrichJobs = {}
    m.sliderRequests = {}
    m.nextRowId = 0

    m.configCache = GetSeerrConfig()
    m.blockNsfwCache = true
    if m.configCache <> invalid and m.configCache.blockNsfw <> invalid
        m.blockNsfwCache = m.configCache.blockNsfw
    end if

    m.sizes = discoverSizes()
    m.navLeft = isStringEqual(get_user_setting("navbar.position"), "left")
    m.expansion = get_user_setting_bool("ui.cardFocusExpansion", true)
    m.modernRows = isModernHomeRows()
    m.modernFocusCard = m.top.findNode("modernFocusCard")
    m.cardRing = m.top.findNode("cardRing")
    m.cardBadge = m.top.findNode("cardBadge")
    m.cardBadgeFill = m.top.findNode("cardBadgeFill")
    m.cardBadgeLabel = m.top.findNode("cardBadgeLabel")
    m.cardBadgeLabel.font = fontOfSize(17, true)
    m.modernCardItem = invalid
    layoutScreen()
    if m.modernRows then applyModernLayout()

    m.categoryRows.observeField("rowItemFocused", "onRowItemFocused")
    m.categoryRows.observeField("rowItemSelected", "onRowItemSelected")
    if m.modernRows
        m.categoryRows.observeField("keyPressedNotifier", "onRowsKeyPressed")
        m.categoryRows.observeField("moveTarget", "onRowsMoveTarget")
        m.modernFocusCard.observeField("cardShown", "onCardShownChanged")
    end if

    m.pillFocus = m.top.findNode("pillFocus")
    m.searchPill = m.top.findNode("searchPill")
    m.requestsPill = m.top.findNode("requestsPill")
    m.pills = [m.searchPill, m.requestsPill]
    m.pillIndex = 0
    accent = themeChrome.Accent()
    m.searchPill.accent = accent
    m.requestsPill.accent = accent
    focusColor = coreFocusColor()
    m.searchPill.focusColor = focusColor
    m.requestsPill.focusColor = focusColor
    m.cardRing.blendColor = focusColor
    m.searchPill.text = tr("Search")
    m.requestsPill.text = tr("Requests")
    layoutPills()
    loadBadgeCount()

    ' Reload config when screen gains focus (after auth, user switch, etc.)
    m.top.observeField("focusedChild", "onScreenFocusChanged")

    LoadDiscoveryCategories()
end sub

' ============================================
' Layout
' ============================================

' Core's posters, focused card and tiles for the account's poster size, which Discover caps at
' Extra Large
function discoverSizes() as object
    posterSize = libraryCard.PosterSize(invalid, get_user_setting("ui.posterSize"))
    if posterSize = "small" then return { posterWidth: 107, posterHeight: 160, cardWidth: 285, tileWidth: 240, tileHeight: 120 }
    if posterSize = "large" then return { posterWidth: 160, posterHeight: 240, cardWidth: 427, tileWidth: 360, tileHeight: 180 }
    if posterSize = "extraLarge" then return { posterWidth: 187, posterHeight: 280, cardWidth: 499, tileWidth: 420, tileHeight: 210 }
    return { posterWidth: 134, posterHeight: 200, cardWidth: 356, tileWidth: 300, tileHeight: 150 }
end function

' Core's rows sit under the top bar, or higher and further in beside the left rail. Classic keeps
' the focused item's details above its rows.
sub layoutScreen()
    m.rowsTop = 212
    m.pillsTop = 139
    m.titleX = 134
    m.cardX = 140
    if m.navLeft
        m.rowsTop = 120
        m.pillsTop = 47
        m.titleX = 147
        m.cardX = 154
    end if
    if not m.modernRows then m.rowsTop = CLASSIC_ROWS_TOP

    m.top.findNode("detailsSection").visible = not m.modernRows
    if m.navLeft then m.top.findNode("detailsSection").translation = [m.titleX, 180]

    ' Row titles use a label's own font, as Home's do
    probe = CreateObject("roSGNode", "Label")
    probe.text = "Ag"
    m.labelHeight = Int(probe.boundingRect().height + 0.5)

    ' The list starts at the title, since it clips a label set left of its edge, and the cards
    ' sit a little further in
    m.categoryRows.translation = [m.cardX - CLIP_MARGIN, m.rowsTop]
    m.categoryRows.rowLabelFont = probe.font
    m.categoryRows.rowLabelColor = "#FFFFFF"
    m.categoryRows.itemSize = [1920 - m.cardX + CLIP_MARGIN, m.sizes.posterHeight + MODERN_INFO_HEIGHT + HEADER_HEIGHT]
    m.infoRoom = MODERN_INFO_HEIGHT
    if moonfinPlugin.IsRatingsEnabled() then m.infoRoom += MODERN_RATINGS_ROOM
    m.rowSpacing = homeRowsVerticalSpacing(m.modernRows)
    m.categoryRows.itemSpacing = [0, m.rowSpacing]
    ' Tiles have no captions under them, so they keep at least Classic's padding, as Core does
    classicSpacing = homeRowsVerticalSpacing(false)
    m.tileRoom = TILE_ROW_PAD
    if classicSpacing > m.rowSpacing then m.tileRoom += classicSpacing - m.rowSpacing

    ' The focused card covers its cell, Core's ring 3 px outside it
    m.cardTop = m.rowsTop + HEADER_HEIGHT
    m.modernFocusCard.translation = [m.cardX, m.cardTop]
    m.cardRing.translation = [m.cardX - RING_OUTSET, m.cardTop - RING_OUTSET]
    m.cardRing.width = m.sizes.cardWidth + RING_OUTSET * 2
    m.cardRing.height = m.sizes.posterHeight + RING_OUTSET * 2
end sub

' The focused card is Core's 16:9 card at the poster's height, with the year under its title
sub applyModernLayout()
    m.modernFocusCard.callFunc("applyLayout", {
        width: m.sizes.cardWidth,
        height: m.sizes.posterHeight,
        maskUri: "pkg:/images/seerr/cardMask356.webp",
        shift: m.sizes.cardWidth - m.sizes.posterWidth,
        infoTop: m.sizes.posterHeight + 10,
        titleSize: 22,
        metaSize: 20,
        metaColor: "#FFFFFF99",
        metaTop: 27,
        ratingsTop: 59,
        overviewTop: 59,
        overviewSize: 20,
        overviewColor: "#FFFFFFB3",
        overviewWidth: 1840 - m.cardX,
        overviewLineSpacing: 8
    })
end sub

' Right aligned under the bar, Requests last
sub layoutPills()
    x = 1920 - PILLS_RIGHT
    for i = m.pills.count() - 1 to 0 step -1
        pill = m.pills[i]
        x -= pill.pillWidth
        pill.translation = [x, m.pillsTop]
        x -= PILL_GAP
    end for
end sub

' Each row's height, card size, spacing and title offset, rebuilt whenever a row comes or goes
sub syncRowGeometry()
    sizes = []
    spacings = []
    heights = []
    offsets = []
    focusOffsets = []
    labelX = m.titleX - m.cardX + CLIP_MARGIN
    content = m.categoryRows.content
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        focusOffsets.push(CLIP_MARGIN)
        if row.isTileRow
            sizes.push([m.sizes.tileWidth, m.sizes.tileHeight + TILE_ROOM * 2])
            spacings.push([TILE_GAP, 0])
            heights.push(HEADER_HEIGHT + m.sizes.tileHeight + m.tileRoom)
            offsets.push([labelX, HEADER_HEIGHT - m.labelHeight - TILE_ROOM])
        else if m.modernRows
            sizes.push([m.sizes.posterWidth, m.sizes.posterHeight + CARD_TEXT_HEIGHT])
            spacings.push([posterGap(), 0])
            heights.push(HEADER_HEIGHT + m.sizes.posterHeight + m.infoRoom)
            offsets.push([labelX, HEADER_HEIGHT - m.labelHeight])
        else
            room = classicRoom()
            sizes.push([m.sizes.posterWidth, room + m.sizes.posterHeight + CARD_TEXT_HEIGHT])
            spacings.push([posterGap(), 0])
            heights.push(HEADER_HEIGHT + room + m.sizes.posterHeight + CLASSIC_CAPTION_ROOM)
            offsets.push([labelX, HEADER_HEIGHT - m.labelHeight])
        end if
    end for
    m.categoryRows.rowItemSize = sizes
    m.categoryRows.rowItemSpacing = spacings
    m.categoryRows.rowHeights = heights
    m.categoryRows.rowLabelOffset = offsets
    m.categoryRows.focusXOffset = focusOffsets
end sub

' A grown classic poster and its ring rise this far above its cell, or only the ring without
' focus expansion
function classicRoom() as integer
    if m.expansion then return Int(m.sizes.posterHeight * (GROW_SCALE - 1) + 0.5) + RING_ROOM
    return RING_ROOM
end function

' Core's gap beside a poster, wide enough for a grown one when focused cards grow
function posterGap() as integer
    if not m.expansion then return PLAIN_GAP
    return PLAIN_GAP + Int(m.sizes.posterWidth * (GROW_SCALE - 1) / 2 + 0.5)
end function

' ============================================
' Rows
' ============================================

' Core's rows in Core's order. The Seerr Rows settings, which sync with the other apps, say which
' are on.
function rowDefinitions() as object
    brand = GetSeerrDisplayName()
    return [
        { setting: "seerr.row.shortcuts", title: tr("Seerr Browse").Replace("Seerr", brand), kind: "shortcut" },
        { setting: "seerr.row.recent_requests", title: tr("Recent Requests"), kind: "requests" },
        { setting: "seerr.row.watchlist", title: tr("Your Watchlist"), kind: "watchlist" },
        { setting: "seerr.row.recently_added", title: tr("Recently Added"), kind: "recentlyAdded" },
        { setting: "seerr.row.trending", title: tr("Trending"), kind: "media", endpoint: "/api/v1/discover/trending" },
        { setting: "seerr.row.popular_movies", title: tr("Popular Movies"), kind: "media", endpoint: "/api/v1/discover/movies" },
        { setting: "seerr.row.movie_genres", title: tr("Movie Genres"), kind: "genre", endpoint: "/api/v1/discover/genreslider/movie", mediaType: "movie" },
        { setting: "seerr.row.upcoming_movies", title: tr("Upcoming Movies"), kind: "media", endpoint: "/api/v1/discover/movies/upcoming" },
        { setting: "seerr.row.studios", title: tr("Studios"), kind: "studio" },
        { setting: "seerr.row.popular_tv", title: tr("Popular Series"), kind: "media", endpoint: "/api/v1/discover/tv" },
        { setting: "seerr.row.series_genres", title: tr("Series Genres"), kind: "genre", endpoint: "/api/v1/discover/genreslider/tv", mediaType: "tv" },
        { setting: "seerr.row.upcoming_tv", title: tr("Upcoming Series"), kind: "media", endpoint: "/api/v1/discover/tv/upcoming" },
        { setting: "seerr.row.networks", title: tr("Networks"), kind: "network" }
    ]
end function

function newRowNode(title as string, kind as string, endpoint as string, mediaType as string) as object
    rowNode = CreateObject("roSGNode", "ContentNode")
    rowNode.title = title
    m.nextRowId = m.nextRowId + 1
    rowNode.addFields({
        rowId: `row_${m.nextRowId}`,
        rowKind: kind,
        endpoint: endpoint,
        mediaType: mediaType,
        isTileRow: kind = "shortcut" or kind = "genre" or kind = "studio" or kind = "network"
    })
    return rowNode
end function

sub LoadDiscoveryCategories()
    ShowLoading()
    if not IsValidSeerrConfig(m.configCache)
        ShowError("Seerr not configured")
        return
    end if

    permissions = GetCurrentUserSeerrPermissions()
    contentNode = CreateObject("roSGNode", "ContentNode")
    for each definition in rowDefinitions()
        shown = get_user_setting_bool(definition.setting, true)
        if definition.kind = "recentlyAdded" and not HasSeerrPermission(permissions, SEERR_PERMISSION_RECENT_VIEW) then shown = false
        if shown then contentNode.appendChild(newRowNode(definition.title, definition.kind, definition.endpoint ?? "", definition.mediaType ?? "all"))
    end for
    m.categoryRows.content = contentNode
    syncRowGeometry()

    for each row in contentNode.getChildren(-1, 0)
        LoadRowContent(row)
    end for
    loadSliders()
end sub

function rowById(rowId as string) as dynamic
    if not isValid(m.categoryRows.content) then return invalid
    for each row in m.categoryRows.content.getChildren(-1, 0)
        if row.rowId = rowId then return row
    end for
    return invalid
end function

function rowIndexOf(rowId as string) as integer
    content = m.categoryRows.content
    for i = 0 to content.getChildCount() - 1
        if content.getChild(i).rowId = rowId then return i
    end for
    return -1
end function

' A row that came back with nothing goes, as Core collapses it
sub dropRowIfEmpty(rowId as string)
    index = rowIndexOf(rowId)
    if index < 0 then return
    if m.categoryRows.content.getChild(index).getChildCount() > 0 then return

    focused = m.categoryRows.rowItemFocused
    m.categoryRows.content.removeChildIndex(index)
    syncRowGeometry()
    if m.categoryRows.content.getChildCount() = 0 then return
    if isValid(focused) and focused.count() = 2 and focused[0] >= index and focused[0] > 0
        ' A row below the dropped one keeps its column
        column = 0
        if focused[0] > index then column = focused[1]
        m.categoryRows.jumpToRowItem = [focused[0] - 1, column]
    end if
end sub

sub LoadRowContent(row as object, isLoadingMore = false as boolean)
    rowId = row.rowId
    kind = row.rowKind

    if kind = "shortcut"
        addShortcutTiles(row)
        loadPage(row, "/api/v1/discover/trending", { page: "1" }, false)
        return
    end if
    if kind = "studio" or kind = "network"
        addLogoTiles(row)
        return
    end if

    if not isLoadingMore then m.rowPages[rowId] = 1
    if isLoadingMore
        if m.rowHasMore[rowId] <> true or m.isLoadingMore[rowId] = true then return
        m.rowPages[rowId] = m.rowPages[rowId] + 1
    end if

    if kind = "requests"
        params = { take: LOCAL_ROW_LIMIT.ToStr(), skip: "0" }
        ' Someone who can't see every request sees their own
        permissions = GetCurrentUserSeerrPermissions()
        if not CanManageRequests(permissions) and not HasSeerrPermission(permissions, SEERR_PERMISSION_REQUEST_VIEW)
            ownId = CurrentSeerrUserId()
            if ownId > 0 then params["requestedBy"] = ownId.ToStr()
        end if
        loadPage(row, "/api/v1/request", params, false)
    else if kind = "watchlist"
        loadPage(row, "/api/v1/discover/watchlist", { page: "1" }, false)
    else if kind = "recentlyAdded"
        loadPage(row, "/api/v1/media", { filter: "allavailable", sort: "mediaAdded", take: LOCAL_ROW_LIMIT.ToStr() }, false)
    else if kind = "genre"
        loadPage(row, row.endpoint, {}, false)
    else
        loadPage(row, row.endpoint, { page: m.rowPages[rowId].ToStr() }, isLoadingMore)
    end if
end sub

sub loadPage(row as object, endpoint as string, params as object, isLoadingMore as boolean)
    rowId = row.rowId
    m.isLoadingMore[rowId] = true
    apiTask = CreateObject("roSGNode", "SeerrAPITask")
    apiTask.addFields({ rowId: rowId, isLoadingMore: isLoadingMore })
    apiTask.request = { method: "GET", endpoint: endpoint, queryParams: params }
    apiTask.observeField("response", "onDiscoveryResponse")
    m.apiTasks[rowId] = apiTask
    apiTask.control = "RUN"
end sub

sub onDiscoveryResponse(event as object)
    response = event.getData()
    apiTask = event.getRoSGNode()
    apiTask.unobserveField("response")
    rowId = apiTask.rowId
    m.isLoadingMore[rowId] = false
    m.apiTasks.delete(rowId)
    HideLoading()

    row = rowById(rowId)
    if not isValid(row) then return
    if not isValid(response) or response.success <> true or not isValid(response.data)
        if row.rowKind <> "shortcut" and row.getChildCount() = 0 then dropRowIfEmpty(rowId)
        return
    end if

    kind = row.rowKind
    data = response.data
    if kind = "shortcut"
        dressShortcutTiles(row, data.results)
    else if kind = "genre"
        m.rowHasMore[rowId] = false
        if type(data) = "roArray"
            for each genre in data
                node = genreNode(genre, row.mediaType)
                if isValid(node) then row.appendChild(node)
            end for
        end if
        dropRowIfEmpty(rowId)
    else if kind = "requests" or kind = "watchlist" or kind = "recentlyAdded"
        m.rowHasMore[rowId] = false
        enrichRow(rowId, enrichEntries(kind, data.results))
    else
        results = data.results
        totalPages = data.totalPages ?? 1
        if kind = "slider"
            results = seerrSliders.Results(data)
            totalPages = seerrSliders.TotalPages(data)
        end if
        if type(results) = "roArray"
            m.rowHasMore[rowId] = m.rowPages[rowId] < totalPages
            for each item in discoverableResults(results)
                addMediaCard(row, item)
            end for
        end if
        if not apiTask.isLoadingMore then dropRowIfEmpty(rowId)
    end if
    focusFirstRow()
end sub

' Focus starts on the rows once there's something in them
sub focusFirstRow()
    if m.categoryRows.hasFocus() or m.pillFocus.hasFocus() then return
    if not m.top.isInFocusChain() and not m.top.hasFocus() then return
    content = m.categoryRows.content
    for i = 0 to content.getChildCount() - 1
        if content.getChild(i).getChildCount() > 0
            m.categoryRows.setFocus(true)
            m.categoryRows.jumpToRowItem = [i, 0]
            m.top.lastFocus = m.categoryRows
            return
        end if
    end for
end sub

' Leaves out what the library already has, what Seerr blacklisted and, when they're blocked, NSFW
' titles, as Core does
function discoverableResults(results as object) as object
    blockNsfw = m.blockNsfwCache
    kept = []
    for each item in results
        if not IsItemAvailable(item) and not IsItemBlacklisted(item) and not (blockNsfw and IsItemNsfw(item)) then kept.push(item)
    end for
    return kept
end function

' ============================================
' Cards
' ============================================

sub addMediaCard(row as object, item as object)
    node = CreateMediaContentNode(item)
    if not isValid(node) then return
    focusStyle = "none"
    if not m.modernRows
        focusStyle = m.expansion ? "grow" : "ring"
        node.addFields({ cardInset: [0, classicRoom()] })
    end if
    node.addFields({
        cardKind: "poster",
        posterSize: [m.sizes.posterWidth, m.sizes.posterHeight],
        maskUri: "pkg:/images/seerr/posterMask134.webp",
        focusStyle: focusStyle,
        cardSubtitle: node.releaseYear ?? ""
    })
    if m.modernRows then node.addField("modernShift", "float", false)
    row.appendChild(node)
end sub

function tileFields(kind as string) as object
    return {
        cardKind: kind,
        posterSize: [m.sizes.tileWidth, m.sizes.tileHeight],
        maskUri: "pkg:/images/seerr/tileMask300.webp",
        focusStyle: "tile",
        cardInset: [0, TILE_ROOM]
    }
end function

' Seerr's duotone in the genre's own colors
function genreNode(genre as object, mediaType as string) as object
    node = CreateGenreContentNode(genre, mediaType)
    if not isValid(node) then return invalid
    node.addFields(tileFields("genre"))
    node.sdPosterUrl = seerrBrowseRows.GenreBackdropUrl(genre.id, genre.backdrops)
    return node
end function

sub addLogoTiles(row as object)
    isNetwork = row.rowKind = "network"
    entries = seerrBrowseRows.Studios()
    if isNetwork then entries = seerrBrowseRows.Networks()
    for each entry in entries
        node = CreateObject("roSGNode", "ContentNode")
        node.title = entry.name
        node.hdPosterUrl = seerrBrowseRows.LogoUrl(entry.logoPath)
        fields = tileFields("logo")
        if isNetwork
            fields.networkId = entry.id
            fields.isNetwork = true
            fields.mediaType = "tv"
        else
            fields.studioId = entry.id
            fields.isStudio = true
            fields.mediaType = "movie"
        end if
        node.addFields(fields)
        row.appendChild(node)
    end for
end sub

' Movies, Series, Requests and Issues, the places Core's shortcut row goes
sub addShortcutTiles(row as object)
    shortcuts = [
        { id: "movies", title: tr("Movies"), glyph: "movie" },
        { id: "series", title: tr("Series"), glyph: "tv" },
        { id: "requests", title: tr("Requests"), icon: "pkg:/images/icons/manage_requests.webp" },
        { id: "issues", title: tr("Issues"), icon: "pkg:/images/icons/report_issue.webp" }
    ]
    for each shortcut in shortcuts
        node = CreateObject("roSGNode", "ContentNode")
        node.title = shortcut.title
        fields = tileFields("shortcut")
        fields.shortcutId = shortcut.id
        fields.tileGlyph = shortcut.glyph ?? ""
        fields.tileIconUri = shortcut.icon ?? ""
        node.addFields(fields)
        row.appendChild(node)
    end for
end sub

' One trending read gives the tiles their stills. Movies and Series take one of their own kind,
' the others alternate, and nothing repeats while there's art to go round.
sub dressShortcutTiles(row as object, results as dynamic)
    if type(results) <> "roArray" then return
    movieArt = []
    tvArt = []
    base = GetTmdbImageBaseUrls().backdropW780
    for each item in discoverableResults(results)
        path = item.backdropPath ?? ""
        if path <> ""
            if isStringEqual(item.mediaType, "tv") then tvArt.push(base + path) else movieArt.push(base + path)
        end if
    end for
    shuffleList(movieArt)
    shuffleList(tvArt)
    mixed = []
    i = 0
    while i < movieArt.count() or i < tvArt.count()
        if i < tvArt.count() then mixed.push(tvArt[i])
        if i < movieArt.count() then mixed.push(movieArt[i])
        i = i + 1
    end while

    used = {}
    tiles = row.getChildren(-1, 0)
    for each tile in tiles
        art = ""
        if tile.shortcutId = "movies" then art = takeArt([movieArt, tvArt], used)
        if tile.shortcutId = "series" then art = takeArt([tvArt, movieArt], used)
        if art <> "" then tile.sdPosterUrl = art
    end for
    for each tile in tiles
        if tile.sdPosterUrl = ""
            art = takeArt([mixed], used)
            if art <> "" then tile.sdPosterUrl = art
        end if
    end for
end sub

function takeArt(pools as object, used as object) as string
    for each pool in pools
        for each uri in pool
            if not used.DoesExist(uri)
                used[uri] = true
                return uri
            end if
        end for
    end for
    return ""
end function

sub shuffleList(items as object)
    for i = items.count() - 1 to 1 step -1
        j = Rnd(i + 1) - 1
        swap = items[i]
        items[i] = items[j]
        items[j] = swap
    end for
end sub

' ============================================
' Requests, watchlist and recently added
' ============================================

' These lists hold bare records, so each title's details are read, a couple at a time, and the
' row fills in their order once they're all back
function enrichEntries(kind as string, results as dynamic) as object
    entries = []
    if type(results) <> "roArray" then return entries
    for each record in results
        entry = invalid
        if kind = "requests"
            media = record.media
            if isValid(media) and isValid(media.tmdbId) then entry = { tmdbId: media.tmdbId, mediaType: record.type, status: media.status ?? 0 }
        else if kind = "watchlist"
            tmdbId = record.tmdbId ?? record.id
            if isValid(tmdbId) then entry = { tmdbId: tmdbId, mediaType: record.mediaType, status: chainLookupReturn(record, "mediaInfo.status", 0) }
        else
            if isValid(record.tmdbId) then entry = { tmdbId: record.tmdbId, mediaType: record.mediaType, status: record.status ?? 0 }
        end if
        if isValid(entry) and isValidAndNotEmpty(entry.mediaType) then entries.push(entry)
    end for
    return entries
end function

sub enrichRow(rowId as string, entries as object)
    if entries.count() = 0
        dropRowIfEmpty(rowId)
        return
    end if
    nodes = []
    for i = 1 to entries.count()
        nodes.push(invalid)
    end for
    m.enrichJobs[rowId] = { entries: entries, nodes: nodes, nextIndex: 0, pending: 0, tasks: {} }
    for i = 1 to ENRICH_AT_ONCE
        startEnrich(rowId)
    end for
end sub

sub startEnrich(rowId as string)
    job = m.enrichJobs[rowId]
    if not isValid(job) then return
    if job.nextIndex >= job.entries.count()
        if job.pending = 0 then finishEnrich(rowId)
        return
    end if

    index = job.nextIndex
    job.nextIndex = index + 1
    job.pending = job.pending + 1
    entry = job.entries[index]
    task = CreateObject("roSGNode", "SeerrAPITask")
    task.addFields({ rowId: rowId, entryIndex: index })
    task.request = { method: "GET", endpoint: `/api/v1/${entry.mediaType}/${entry.tmdbId.ToStr()}` }
    task.observeField("response", "onEnrichResponse")
    job.tasks[index.ToStr()] = task
    task.control = "RUN"
end sub

sub onEnrichResponse(event as object)
    task = event.getRoSGNode()
    task.unobserveField("response")
    rowId = task.rowId
    job = m.enrichJobs[rowId]
    if not isValid(job) then return
    job.tasks.delete(task.entryIndex.ToStr())
    job.pending = job.pending - 1

    response = event.getData()
    if isValid(response) and response.success = true and isValid(response.data)
        entry = job.entries[task.entryIndex]
        details = response.data
        ' TMDB's details leave the media type out, and the list has it
        if not isValidAndNotEmpty(details.mediaType) then details.mediaType = entry.mediaType
        if not isValid(details.mediaInfo) then details.mediaInfo = { status: entry.status }
        job.nodes[task.entryIndex] = details
    end if
    startEnrich(rowId)
end sub

sub finishEnrich(rowId as string)
    job = m.enrichJobs[rowId]
    m.enrichJobs.delete(rowId)
    row = rowById(rowId)
    if not isValid(row) then return
    for each details in job.nodes
        if isValid(details) then addMediaCard(row, details)
    end for
    dropRowIfEmpty(rowId)
    focusFirstRow()
end sub

' ============================================
' Admin sliders
' ============================================

' The custom sliders a Seerr admin set up come after this screen's rows, in Seerr's order. A
' failed read just leaves them out.
sub loadSliders()
    m.sliderRun = (m.sliderRun ?? 0) + 1
    task = CreateObject("roSGNode", "SeerrAPITask")
    task.addFields({ sliderRun: m.sliderRun })
    task.request = { method: "GET", endpoint: seerrSliders.LIST_PATH, queryParams: {} }
    task.observeField("response", "onSlidersLoaded")
    m.slidersTask = task
    task.control = "RUN"
end sub

sub onSlidersLoaded(event as object)
    task = event.getRoSGNode()
    task.unobserveField("response")
    m.slidersTask = invalid
    response = event.getData()
    if task.sliderRun <> m.sliderRun or not isValid(response) or response.success <> true then return
    m.sliderQueue = seerrSliders.Supported(seerrSliders.ParseList(response.data))
    loadNextSliders()
end sub

' Two sliders at a time, each added once its first page is in so one that comes back empty
' leaves no row behind
sub loadNextSliders()
    m.sliderBatch = []
    while m.sliderBatch.Count() < 2 and m.sliderQueue.Count() > 0
        slider = m.sliderQueue.Shift()
        request = seerrSliders.Request(slider)
        endpoint = "/api/v1/" + request.path
        params = { "page": "1" }
        params.Append(request.params)

        task = CreateObject("roSGNode", "SeerrAPITask")
        task.addFields({ sliderRun: m.sliderRun, batchIndex: m.sliderBatch.Count() })
        task.request = { method: "GET", endpoint: endpoint, queryParams: params }
        task.observeField("response", "onSliderPageLoaded")
        m.sliderBatch.push({ title: slider.title, endpoint: endpoint, params: params, task: task, response: invalid, done: false })
        task.control = "RUN"
    end while
end sub

sub onSliderPageLoaded(event as object)
    task = event.getRoSGNode()
    task.unobserveField("response")
    if task.sliderRun <> m.sliderRun then return

    entry = m.sliderBatch[task.batchIndex]
    entry.response = event.getData()
    entry.done = true
    entry.task = invalid
    for each waiting in m.sliderBatch
        if not waiting.done then return
    end for

    for each loaded in m.sliderBatch
        if isValid(loaded.response) and loaded.response.success = true then addSliderRow(loaded)
    end for
    loadNextSliders()
end sub

sub addSliderRow(loaded as object)
    body = loaded.response.data
    results = discoverableResults(seerrSliders.Results(body))
    if results.Count() = 0 then return

    ' A slider row pages through the same request, which the endpoint and params carry
    rowNode = newRowNode(loaded.title, "slider", "", "all")
    m.sliderRequests[rowNode.rowId] = { endpoint: loaded.endpoint, params: loaded.params }
    for each item in results
        addMediaCard(rowNode, item)
    end for
    m.rowPages[rowNode.rowId] = 1
    m.rowHasMore[rowNode.rowId] = seerrSliders.TotalPages(body) > 1
    m.categoryRows.content.appendChild(rowNode)
    syncRowGeometry()
end sub

sub loadMoreSlider(row as object)
    rowId = row.rowId
    if m.rowHasMore[rowId] <> true or m.isLoadingMore[rowId] = true then return
    m.rowPages[rowId] = m.rowPages[rowId] + 1
    request = m.sliderRequests[rowId]
    params = {}
    params.Append(request.params)
    params["page"] = m.rowPages[rowId].ToStr()
    loadPage(row, request.endpoint, params, true)
end sub

' ============================================
' Focus and selection
' ============================================

sub onScreenFocusChanged()
    updatePillVisuals()

    ' The card goes with the rows' focus, to the pills, the nav or another screen
    if m.modernRows
        if m.categoryRows.hasFocus()
            refreshModernCard()
        else
            hideModernCard()
        end if
    end if

    if m.top.hasFocus() or m.top.isInFocusChain()
        oldConfig = m.configCache
        m.configCache = GetSeerrConfig()
        if oldConfig <> invalid and m.configCache <> invalid
            if not IsValidSeerrConfig(oldConfig) and IsValidSeerrConfig(m.configCache)
                LoadDiscoveryCategories()
            end if
        end if
    end if
end sub

sub onRowItemFocused(event as object)
    focusedIndex = event.getData()
    if not isValid(focusedIndex) or focusedIndex.count() < 2 then return
    row = m.categoryRows.content.getChild(focusedIndex[0])
    if not isValid(row) then return
    itemIndex = focusedIndex[1]
    if itemIndex < 0 or itemIndex >= row.getChildCount() then return

    focusedItem = row.getChild(itemIndex)
    UpdateDetailsSection(focusedItem)
    if m.modernRows then updateModernCard(focusedIndex[0], itemIndex)

    ' More of a paging row once focus is within 5 of its end
    if row.getChildCount() - itemIndex <= 5
        if row.rowKind = "media"
            LoadRowContent(row, true)
        else if row.rowKind = "slider"
            loadMoreSlider(row)
        end if
    end if
end sub

sub UpdateDetailsSection(item as object)
    if item = invalid then return

    m.itemTitle.text = item.title
    metaParts = []
    if isValidAndNotEmpty(item.releaseYear) then metaParts.push(item.releaseYear)
    if isStringEqual(item.mediaType, "movie") then metaParts.push(tr("Movie"))
    if isStringEqual(item.mediaType, "tv") then metaParts.push(tr("Series"))
    if isValidAndNotEmpty(item.rating) then metaParts.push("★ " + item.rating)
    m.metadataText.text = metaParts.join(" • ")
    m.itemOverview.text = item.overview ?? ""

    if isValidAndNotEmpty(item.backdropUrl)
        if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
        if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

        if isValid(m.backdropPrev) and m.backdrop.uri <> ""
            m.backdropPrev.uri = m.backdrop.uri
            m.backdropPrev.opacity = 1.0
        end if

        m.backdrop.opacity = 0.0
        m.backdrop.uri = item.backdropUrl
        m.backdropCrossfading = true
    end if
end sub

sub onBackdropLoadStatusChange()
    if isValid(m.backdrop) and m.backdrop.loadStatus = "ready" and isValidAndNotEmpty(m.backdrop.uri)
        if m.backdropCrossfading
            targetOpacity = m.backdropTargetOpacity
            m.backdropFadeInInterp.keyValue = [0.0, targetOpacity]
            m.backdropPrevFadeOutInterp.keyValue = [targetOpacity, 0.0]
            m.backdropFadeIn.control = "start"
            m.backdropPrevFadeOut.control = "start"
            m.backdropCrossfading = false
        else
            m.backdropPrev.uri = m.backdrop.uri
        end if
    end if
end sub

sub onRowItemSelected(event as object)
    selectedIndex = event.getData()
    if not isValid(selectedIndex) or selectedIndex.count() < 2 then return
    row = m.categoryRows.content.getChild(selectedIndex[0])
    if not isValid(row) then return
    selectedItem = row.getChild(selectedIndex[1])
    if not isValid(selectedItem) then return

    if selectedItem.hasField("shortcutId")
        openShortcut(selectedItem)
    else if selectedItem.hasField("isGenre") and selectedItem.isGenre = true
        openBrowse("genre", selectedItem.genreId, selectedItem.title, selectedItem.mediaType)
    else if selectedItem.hasField("isNetwork") and selectedItem.isNetwork = true
        openBrowse("network", selectedItem.networkId, selectedItem.title, "tv")
    else if selectedItem.hasField("isStudio") and selectedItem.isStudio = true
        openBrowse("studio", selectedItem.studioId, selectedItem.title, "movie")
    else
        ShowSeerrDetails(selectedItem)
    end if
end sub

sub openBrowse(browseType as string, id as integer, name as string, mediaType as string)
    m.global.sceneManager.callFunc("pushScene", seerrBrowseRows.BrowseScreenFor(browseType, id, name, mediaType))
end sub

sub openShortcut(tile as object)
    if tile.shortcutId = "movies"
        openBrowse("all", 0, tile.title, "movie")
    else if tile.shortcutId = "series"
        openBrowse("all", 0, tile.title, "tv")
    else
        screen = CreateObject("roSGNode", "SeerrRequestsScreen")
        if tile.shortcutId = "issues" then screen.initialTab = "issues"
        m.global.sceneManager.callFunc("pushScene", screen)
    end if
end sub

' Back on the screen, focus goes where it was, or to the first row with something in it
sub OnScreenShown(_isReturning = false as boolean)
    if isValid(m.top.lastFocus) and not m.top.lastFocus.isSameNode(m.top)
        m.top.lastFocus.setFocus(true)
        setLastFocus(m.top.lastFocus)
    else
        m.top.setFocus(true)
        setLastFocus(m.top)
        focusFirstRow()
    end if
    updatePillVisuals()
end sub

sub ShowLoading()
    m.loadingLabel.visible = true
    m.errorLabel.visible = false
end sub

sub HideLoading()
    m.loadingLabel.visible = false
end sub

sub ShowError(message as string)
    m.errorLabel.text = message
    m.errorLabel.visible = true
    m.loadingLabel.visible = false
end sub

' ============================================
' Search and Requests
' ============================================

' Pending requests for someone who can approve them and open issues for someone who can work
' them, the count Core's Requests pill carries
sub loadBadgeCount()
    m.badgeCount = 0
    m.badgeCalls = []
    permissions = GetCurrentUserSeerrPermissions()
    if CanManageRequests(permissions) then m.badgeCalls.push({ endpoint: "/api/v1/request/count", key: "pending" })
    if CanManageIssues(permissions) then m.badgeCalls.push({ endpoint: "/api/v1/issue/count", key: "open" })
    nextBadgeCall()
end sub

sub nextBadgeCall()
    if m.badgeCalls.count() = 0
        m.requestsPill.count = m.badgeCount
        layoutPills()
        return
    end if
    m.badgeTask = CreateObject("roSGNode", "SeerrAPITask")
    m.badgeTask.addFields({ countKey: m.badgeCalls[0].key })
    m.badgeTask.request = { method: "GET", endpoint: m.badgeCalls.Shift().endpoint }
    m.badgeTask.observeField("response", "onBadgeCount")
    m.badgeTask.control = "RUN"
end sub

sub onBadgeCount(event as object)
    task = event.getRoSGNode()
    task.unobserveField("response")
    response = event.getData()
    if isValid(response) and response.success = true
        value = chainLookupReturn(response, "data." + task.countKey, 0)
        if SeerrIsNumber(value) then m.badgeCount = m.badgeCount + value
    end if
    nextBadgeCall()
end sub

sub focusPill(index as integer)
    m.pillIndex = index
    m.pillFocus.setFocus(true)
    m.top.lastFocus = m.pillFocus
    updatePillVisuals()
end sub

' A pill only looks picked while the remote is on the pills, and the one last picked is kept for
' when focus comes back from the nav
sub updatePillVisuals()
    onPills = m.pillFocus.hasFocus()
    for i = 0 to m.pills.count() - 1
        m.pills[i].focused = onPills and i = m.pillIndex
    end for
end sub

sub openPill()
    if m.pillIndex = 0
        m.top.getScene().jumpTo = { selectionType: "search" }
    else
        m.global.sceneManager.callFunc("pushScene", CreateObject("roSGNode", "SeerrRequestsScreen"))
    end if
end sub

' True when no row above the focused one has anything to move to
function onTopRow() as boolean
    focused = m.categoryRows.rowItemFocused
    if not isValidAndNotEmpty(focused) then return true
    for i = 0 to focused[0] - 1
        if m.categoryRows.content.getChild(i).getChildCount() > 0 then return false
    end for
    return true
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.pillFocus.hasFocus()
        if key = KeyCode.LEFT and m.pillIndex > 0
            focusPill(m.pillIndex - 1)
            return true
        end if
        if key = KeyCode.RIGHT
            if m.pillIndex < m.pills.count() - 1 then focusPill(m.pillIndex + 1)
            return true
        end if
        if key = KeyCode.OK
            openPill()
            return true
        end if
        if key = KeyCode.DOWN
            m.categoryRows.setFocus(true)
            m.top.lastFocus = m.categoryRows
            return true
        end if
        if key = KeyCode.UP
            m.top.lastFocus = m.pillFocus
            return FocusNav(m.top)
        end if
        ' Left off the first pill goes on to the rail when there's one
    else if key = KeyCode.UP and m.categoryRows.hasFocus() and onTopRow()
        focusPill(0)
        return true
    end if

    if key = "*"
        settingsScreen = CreateObject("roSGNode", "SeerrSettingsScreen")
        m.top.getScene().appendChild(settingsScreen)
        settingsScreen.setFocus(true)
        return true
    end if

    if key = KeyCode.BACK
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

' ============================================
' Modern rows
' ============================================

' A media cell opts into the slide that makes room for the card. Tiles never get the card.
function isModernCardRow(row as dynamic) as boolean
    if not isValid(row) then return false
    return row.isTileRow <> true
end function

' The card steps aside while the rows scroll up or down under it
sub onRowsKeyPressed()
    hideModernCard()
end sub

' The row only reports its new focus once it has finished scrolling, so the card and cells
' start changing as the key is pressed, the way Home's do
sub onRowsMoveTarget(event as object)
    target = event.getData()
    if not isValid(target) or target.count() < 2 then return
    if not m.modernFocusCard.cardShown then return
    updateModernCard(target[0], target[1])
end sub

sub onCardShownChanged()
    m.cardRing.visible = m.modernFocusCard.cardShown
    if not m.modernFocusCard.cardShown then m.cardBadge.visible = false
end sub

' The card carries its cell's MOVIE or SERIES badge, below a banner when the status runs across it
sub drawCardBadge(item as object)
    badge = seerrMediaBadge(item.mediaType)
    m.cardBadge.visible = isValid(badge)
    if not isValid(badge) then return

    m.cardBadgeLabel.width = 0
    m.cardBadgeLabel.height = 0
    m.cardBadgeLabel.text = badge.text
    bounds = m.cardBadgeLabel.boundingRect()
    badgeHeight = Int(bounds.height) + 6
    m.cardBadgeFill.width = Int(bounds.width) + 20
    m.cardBadgeFill.height = badgeHeight
    m.cardBadgeFill.blendColor = badge.color
    m.cardBadgeLabel.translation = [10, 0]
    m.cardBadgeLabel.height = badgeHeight

    top = 10
    status = seerrCardStatus(item)
    if status >= 2 and status <= 5 and seerrBadgeStyle() = "banner" then top += SEERR_BANNER_HEIGHT
    m.cardBadge.translation = [m.cardX + 10, m.cardTop + top]
end sub

sub refreshModernCard()
    focused = m.categoryRows.rowItemFocused
    if not isValid(focused) or focused.count() < 2 then return
    if focused[0] < 0 or focused[1] < 0 then return
    updateModernCard(focused[0], focused[1])
end sub

sub updateModernCard(rowIndex as integer, itemIndex as integer)
    if not isValid(m.categoryRows.content) then return
    row = m.categoryRows.content.getChild(rowIndex)
    item = invalid
    if isModernCardRow(row) then item = row.getChild(itemIndex)

    if not isValid(item)
        hideModernCard()
        return
    end if

    m.modernFocusCard.callFunc("reflow", { content: m.categoryRows.content, row: rowIndex, col: itemIndex })

    ' A key press brings the card in before the row settles, and the focus change after it
    ' mustn't ask for the same details again
    if m.modernFocusCard.cardShown and isValid(m.modernCardItem) and m.modernCardItem.isSameNode(item) then return
    m.modernCardItem = item

    m.modernFocusCard.callFunc("showCard", { item: item, uris: discoverCardUris(item), logoTile: false })
    drawCardBadge(item)
    m.modernFocusCard.callFunc("setDetails", { meta: item.releaseYear ?? "", overview: item.overview ?? "" })
    fetchModernRatings(item)
end sub

sub hideModernCard()
    m.modernCardItem = invalid
    if isValid(m.modernRatingsDebounce) then m.modernRatingsDebounce.control = "stop"
    m.pendingModernRatings = invalid
    m.modernFocusCard.callFunc("hideCard")
    m.cardBadge.visible = false
end sub

' The plugin's titled backdrop first, then the plain one, then the poster
function discoverCardUris(item as object) as object
    uris = []
    thumbUrl = moonfinPlugin.TmdbThumbURL(item.mediaType, item.tmdbId)
    if thumbUrl <> "" then uris.push(thumbUrl)
    for each uri in [item.backdropUrl, item.hdPosterUrl]
        if isValidAndNotEmpty(uri) then uris.push(uri)
    end for
    return uris
end function

' The plugin's MDBList ratings, asked for once focus settles on a card
sub fetchModernRatings(item as object)
    if not moonfinPlugin.IsRatingsEnabled() then return

    tmdbId = toString(item.tmdbId).Trim()
    itemType = ""
    if isStringEqual(item.mediaType, "movie")
        itemType = "Movie"
    else if isStringEqual(item.mediaType, "tv")
        itemType = "Series"
    end if
    if tmdbId = "" or itemType = "" then return

    m.pendingModernRatings = { "Type": itemType, "Id": "", "ProviderIds": { "Tmdb": tmdbId } }
    m.pendingModernRatingsItem = item
    m.modernRatingsDebounce = moonfinPlugin.StartRatingsDebounce(m.modernRatingsDebounce, "onModernRatingsDebounceFired")
end sub

sub onModernRatingsDebounceFired()
    itemData = m.pendingModernRatings
    if not isValid(itemData) then return
    m.pendingModernRatings = invalid

    if isValid(m.modernRatingsTask) then m.modernRatingsTask.unobserveFieldScoped("ratings")
    m.modernRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.modernRatingsTask.itemData = itemData
    m.modernRatingsTaskItem = m.pendingModernRatingsItem
    m.modernRatingsTask.observeFieldScoped("ratings", "onModernRatingsLoaded")
    m.modernRatingsTask.control = "RUN"
end sub

sub onModernRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) or not isValidAndNotEmpty(result.data) then return

    ' An answer for a card that has lost focus since is dropped
    if not isValid(m.modernCardItem) or not m.modernCardItem.isSameNode(m.modernRatingsTaskItem) then return
    m.modernFocusCard.callFunc("setRatings", result)
end sub

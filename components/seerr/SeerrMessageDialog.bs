import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"

sub init()
    m.rowMenu = m.top.findNode("rowMenu")
    m.rowMenu.observeField("itemSelected", "onRowSelected")

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.top.findNode("title"),
        titleRule: m.top.findNode("titleRule"),
        list: m.rowMenu
    }

end sub

sub showDialog()
    m.parts.title.text = m.top.dialogTitle

    content = CreateObject("roSGNode", "ContentNode")
    m.firstOption = 0

    if isValidAndNotEmpty(m.top.message)
        row = content.CreateChild("SeerrRequestListData")
        row.title = m.top.message
        row.dimmed = true
        row.noIndicator = true
        row.rowHeight = trackDialog.RowHeight()
        m.firstOption = 1
    end if

    labels = m.top.options
    if not isValid(labels) or labels.count() = 0 then labels = [tr("OK")]

    for i = 0 to labels.count() - 1
        row = content.CreateChild("SeerrRequestListData")
        row.title = labels[i]
        row.dividerAbove = (i = 0 and m.firstOption > 0)
        row.rowHeight = trackDialog.RowHeight()
    end for

    trackDialog.Layout(m.parts, content.getChildCount())

    m.rowMenu.content = content
    m.rowMenu.jumpToItem = m.firstOption

    m.top.visible = true
    m.rowMenu.setFocus(true)
end sub

sub onRowSelected()
    index = m.rowMenu.itemSelected - m.firstOption
    if index < 0 then return

    closeDialog(index)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A dismissed dialog can still hold focus, and swallowing keys there would strand the screen
    if not m.top.visible then return false

    if key = KeyCode.BACK
        closeDialog(-1)
        return true
    end if

    if key = KeyCode.UP or key = KeyCode.DOWN or key = KeyCode.OK
        if not m.rowMenu.isInFocusChain() then m.rowMenu.setFocus(true)
        return true
    end if

    return false
end function

' The owner takes this node out of the scene as soon as it is told, so focus moves first
sub closeDialog(index as integer)
    m.top.visible = false
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
    m.top.optionSelected = index
end sub

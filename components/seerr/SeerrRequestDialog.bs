import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrRequestRules.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' The TMDB keyword Seerr reads to tell anime apart
const ANIME_KEYWORD_ID = 210024

sub init()
    m.sheet = m.top.findNode("sheet")
    m.sheet.observeField("activated", "onActivated")
    m.sheet.observeField("closed", "cancelDialog")

    m.quota = invalid
    m.picker = invalid

    m.quotaTask = CreateObject("roSGNode", "SeerrAPITask")
    m.serversTask = CreateObject("roSGNode", "SeerrAPITask")
    m.serverDetailTask = CreateObject("roSGNode", "SeerrAPITask")
end sub

' Each request starts over from the defaults
sub showDialog()
    m.selected4k = m.top.is4k
    m.allSeasons = true
    m.selectedSeasons = []
    m.advancedOpen = false
    m.advancedLoading = false
    m.servers = invalid
    m.selectedParts = []
    m.partsPicked = false
    m.sending = false
    m.progress = invalid
    clearAdvancedSelection()

    loadQuota()
    if m.top.canRequestAdvanced then loadServers()

    m.sheet.focusId = ""
    if isCollection()
        m.selectedParts = seerrRequestRules.FirstSelectable(m.top.parts, false, invalid)
        m.sheet.focusId = "allParts"
    else if showsToggle()
        m.sheet.focusId = "4k"
    else if isTv()
        m.sheet.focusId = "allSeasons"
    end if
    rebuild()
    m.top.visible = true
    m.sheet.setFocus(true)
end sub

function isTv() as boolean
    return isStringEqual(m.top.mediaType, "tv")
end function

function isCollection() as boolean
    return isValidAndNotEmpty(m.top.parts)
end function

function showsToggle() as boolean
    return m.top.qualityToggle and m.top.canRequest4k
end function

' ===== The sheet =====

sub rebuild()
    if isCollection()
        rebuildCollection()
        return
    end if
    tv = isTv()
    details = m.top.details
    mediaInfo = chainLookupReturn(details, "mediaInfo", invalid)
    elements = []

    status = chainLookupReturn(mediaInfo, m.selected4k ? "status4k" : "status", 0)
    if tv and seerrRequestRules.IsContinuing(chainLookupReturn(details, "status", "")) and status = 5
        elements.push({ kind: "banner", text: tr("Series Continuing · Future Seasons Can Be Requested"), after: 12 })
    end if
    if showsToggle() then elements.push({ kind: "toggle", id: "4k", title: tr("4K"), value: m.selected4k })

    numbers = seerrRequestRules.SeasonNumbers(chainLookupReturn(details, "seasons", invalid), chainLookupReturn(details, "numberOfSeasons", 0))
    taken = seerrRequestRules.TakenSeasons(chainLookupReturn(mediaInfo, "seasons", invalid), chainLookupReturn(mediaInfo, "requests", invalid), m.selected4k)
    if tv
        elements.push({ kind: "divider" })
        elements.push({ kind: "toggle", id: "allSeasons", title: tr("All Seasons"), value: m.allSeasons, checkbox: true })
        if not m.allSeasons and numbers.count() > 0
            available = seerrRequestRules.AvailableSeasons(chainLookupReturn(mediaInfo, "seasons", invalid), m.selected4k)
            chips = []
            for each number in numbers
                chips.push({
                    id: `season:${number}`,
                    label: Substitute(tr("S^0"), number.ToStr()),
                    selected: seerrRequestRules.Has(m.selectedSeasons, number),
                    available: seerrRequestRules.Has(available, number),
                    enabled: not seerrRequestRules.Has(taken, number)
                })
            end for
            elements.push({ kind: "chips", items: chips })
        end if
    end if

    if m.top.canRequestAdvanced
        elements.push({ kind: "divider" })
        elements.push({ kind: "expander", id: "advanced", title: tr("Advanced Options"), open: m.advancedOpen })
        if m.advancedOpen then addAdvanced(elements)
    end if

    needed = seerrRequestRules.SeasonsNeeded(tv, m.allSeasons, m.selectedSeasons.count(), numbers.count(), taken.count())
    quota = quotaDetail()
    blocked = seerrRequestRules.QuotaBlocked(quota, needed)
    if blocked
        elements.push({ kind: "quota", text: tr("Request limit reached"), blocked: true, gap: 12 })
    else if not seerrRequestRules.IsUnlimited(quota)
        template = tv ? tr("^0 of ^1 season requests remaining") : tr("^0 of ^1 movie requests remaining")
        elements.push({ kind: "quota", text: Substitute(template, toString(quota.remaining ?? 0), toString(quota.limit ?? 0)), gap: 12 })
    end if
    m.blocked = blocked

    elements.push({ kind: "buttons", gap: 20, items: [
        { id: "cancel", label: tr("Cancel") },
        { id: "submit", label: tr("Submit Request"), primary: true, color: "#6366F1", enabled: not blocked }
    ] })

    kind = tv ? tr("Series") : tr("Movie")
    title = Substitute(tr("Request ^0"), kind)
    if m.top.is4k and not showsToggle() then title = Substitute(tr("Request 4K ^0"), kind)
    m.sheet.dialogTitle = title
    m.sheet.elements = elements
    m.sheet.callFunc("render")
end sub

' Every film the collection holds, ticked as far as the quota stretches, with the ones it can't
' take saying why
sub rebuildCollection()
    parts = m.top.parts
    requestable = 0
    rows = []
    for each part in parts
        canTake = seerrRequestRules.PartRequestable(part, m.selected4k)
        if canTake then requestable++
        status = seerrRequestRules.PartStatus(part, m.selected4k)
        trailing = ""
        trailingColor = invalid
        if not canTake and seerrRequestRules.IsAvailableStatus(status)
            trailing = tr("Available")
            trailingColor = "#81C784"
        else if not canTake and (status = SEERR_MEDIA_PENDING or status = SEERR_MEDIA_PROCESSING)
            trailing = tr("Requested")
            trailingColor = "#90CAF9"
        end if
        rows.push({ kind: "toggle", id: `part:${part.id}`, title: partTitle(part), checkbox: true, value: canTake and seerrRequestRules.Has(m.selectedParts, part.id), trailing: trailing, trailingColor: trailingColor, enabled: canTake and not m.sending })
    end for

    quota = quotaDetail()
    cap = seerrRequestRules.SelectionCap(quota, requestable)
    picked = m.selectedParts.count()
    limited = not seerrRequestRules.IsUnlimited(quota)
    overCap = limited and picked > cap
    m.partCap = cap

    elements = [
        { kind: "toggle", id: "allParts", title: `${tr("Select All")} (${requestable})`, checkbox: true, value: picked >= cap and cap > 0, enabled: not m.sending },
        { kind: "divider", tight: true },
        { kind: "list", items: rows, maxHeight: 280 }
    ]
    if m.top.canRequest4k then elements.push({ kind: "toggle", id: "4k", title: tr("4K"), value: m.selected4k, enabled: not m.sending })
    if m.top.canRequestAdvanced
        elements.push({ kind: "divider" })
        elements.push({ kind: "expander", id: "advanced", title: tr("Advanced Options"), open: m.advancedOpen })
        if m.advancedOpen then addAdvanced(elements)
    end if
    if limited then elements.push({ kind: "quota", text: Substitute(tr("^0 of ^1 movie requests remaining"), toString(quota.remaining ?? 0), toString(quota.limit ?? 0)), blocked: overCap, gap: 12 })
    m.blocked = overCap or picked = 0

    busyLabel = ""
    if isValid(m.progress) then busyLabel = Substitute(tr("Requesting ^0 of ^1..."), m.progress.current.ToStr(), m.progress.total.ToStr())
    elements.push({ kind: "buttons", gap: 20, items: [
        { id: "cancel", label: tr("Cancel"), enabled: not m.sending },
        { id: "submit", label: Substitute(tr("Request ^0 movies"), picked.ToStr()), primary: true, color: "#6366F1", enabled: not m.sending and not m.blocked, busy: m.sending and isValid(m.progress), busyLabel: busyLabel }
    ] })

    m.sheet.dialogTitle = tr("Request Collection")
    m.sheet.elements = elements
    m.sheet.callFunc("render")
end sub

function partTitle(part as object) as string
    name = part.title ?? part.name ?? ""
    date = part.releaseDate ?? part.release_date ?? ""
    if Len(date) >= 4 then return `${name} (${Left(date, 4)})`
    return name
end function

sub togglePart(id as integer)
    m.partsPicked = true
    if seerrRequestRules.Has(m.selectedParts, id)
        m.selectedParts = withoutValue(m.selectedParts, id)
    else if m.selectedParts.count() < m.partCap
        m.selectedParts.push(id)
    end if
    rebuild()
end sub

sub addAdvanced(elements as object)
    if m.advancedLoading
        elements.push({ kind: "spinner", gap: 8 })
        return
    end if
    if not isValid(m.servers) or m.servers.count() = 0
        elements.push({ kind: "note", text: tr("No service servers configured"), gap: 8 })
        return
    end if
    elements.push({ kind: "selector", id: "server", label: tr("Server"), value: serverLabel(), gap: 8 })
    elements.push({ kind: "selector", id: "profile", label: tr("Quality Profile"), value: profileLabel(), gap: 12 })
    elements.push({ kind: "selector", id: "rootFolder", label: tr("Root Folder"), value: rootFolderLabel(), gap: 12 })
end sub

sub onActivated(event as object)
    id = event.getData()
    if m.sending then return
    if id = "cancel"
        cancelDialog()
    else if id = "submit"
        if isCollection() then sendParts() else submit()
    else if id = "allParts"
        m.partsPicked = true
        if m.selectedParts.count() >= m.partCap and m.partCap > 0
            m.selectedParts = []
        else
            m.selectedParts = seerrRequestRules.FirstSelectable(m.top.parts, m.selected4k, quotaDetail())
        end if
        rebuild()
    else if Left(id, 5) = "part:"
        togglePart(Mid(id, 6).ToInt())
    else if id = "4k"
        ' Server picks only fill a blank, so switching track clears the old track's choices or a
        ' 4K request would go out to the HD server
        m.selected4k = not m.selected4k
        if isCollection() then m.selectedParts = seerrRequestRules.FirstSelectable(m.top.parts, m.selected4k, quotaDetail())
        clearAdvancedSelection()
        if m.top.canRequestAdvanced then applyServerDefaults()
        rebuild()
    else if id = "allSeasons"
        m.allSeasons = not m.allSeasons
        if m.allSeasons then m.selectedSeasons = []
        rebuild()
    else if id = "advanced"
        m.advancedOpen = not m.advancedOpen
        rebuild()
    else if Left(id, 7) = "season:"
        toggleSeason(Mid(id, 8).ToInt())
    else
        openPicker(id)
    end if
end sub

sub toggleSeason(number as integer)
    if seerrRequestRules.Has(m.selectedSeasons, number)
        m.selectedSeasons = withoutValue(m.selectedSeasons, number)
    else
        m.selectedSeasons.push(number)
    end if
    rebuild()
end sub

function withoutValue(list as object, value as dynamic) as object
    kept = []
    for each entry in list
        if entry <> value then kept.push(entry)
    end for
    return kept
end function

sub cancelDialog()
    if m.sending then return
    releaseFocus()
    m.top.wasCancelled = true
end sub

' The owner takes this node out of the scene as soon as it is told, so focus moves first
sub releaseFocus()
    m.top.visible = false
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
end sub

sub submit()
    if m.blocked then return

    seasons = invalid
    if isTv() and not m.allSeasons
        if m.selectedSeasons.count() = 0 then return
        seasons = m.selectedSeasons
        seasons.sort()
    end if

    result = {
        is4k: m.selected4k,
        seasons: seasons
    }
    if isValid(m.selectedServer) then result.serverId = m.selectedServer.id
    if isValid(m.selectedProfileId) then result.profileId = m.selectedProfileId
    if isValidAndNotEmpty(m.selectedRootFolder) then result.rootFolder = m.selectedRootFolder

    releaseFocus()
    m.top.result = result
    m.top.submitted = true
end sub

' One film at a time. A duplicate counts as asked for, and a quota refusal stops the run since
' the rest would be refused the same way.
sub sendParts()
    if m.blocked then return
    m.sending = true
    m.sendQueue = m.selectedParts
    m.sendIndex = 0
    m.sendOk = 0
    m.sendFailed = 0
    m.quotaStopped = false
    sendNextPart()
end sub

sub sendNextPart()
    if m.sendIndex >= m.sendQueue.count()
        finishSending()
        return
    end if

    m.progress = { current: m.sendIndex + 1, total: m.sendQueue.count() }
    rebuild()
    ' A fresh task each time, since the last one is still finishing when its answer arrives
    m.sendTask = CreateObject("roSGNode", "SeerrAPITask")
    m.sendTask.request = {
        method: "POST",
        endpoint: "/api/v1/request",
        bodyJson: SeerrJsonFromPairs(requestPairs(m.sendQueue[m.sendIndex]))
    }
    m.sendTask.observeField("response", "onPartSent")
    m.sendTask.control = TaskControl.RUN
end sub

function requestPairs(tmdbId as integer) as object
    pairs = [
        { key: "mediaType", value: "movie" },
        { key: "mediaId", value: tmdbId },
        { key: "is4k", value: m.selected4k }
    ]
    if isValid(m.selectedServer) then pairs.push({ key: "serverId", value: m.selectedServer.id })
    if isValid(m.selectedProfileId) then pairs.push({ key: "profileId", value: m.selectedProfileId })
    if isValidAndNotEmpty(m.selectedRootFolder) then pairs.push({ key: "rootFolder", value: m.selectedRootFolder })
    return pairs
end function

sub onPartSent(event as object)
    response = event.getData()
    status = chainLookupReturn(response, "statusCode", 0)
    if chainLookupReturn(response, "success", false) = true or status = 409
        m.sendOk++
    else if status = 403 and Instr(1, LCase(toString(chainLookupReturn(response, "error", ""))), "quota") > 0
        m.quotaStopped = true
        finishSending()
        return
    else
        m.sendFailed++
    end if
    m.sendIndex++
    sendNextPart()
end sub

sub finishSending()
    m.sending = false
    releaseFocus()
    m.top.result = { requested: m.sendOk, failed: m.sendFailed, quotaStopped: m.quotaStopped }
    m.top.submitted = true
end sub

function quotaDetail() as object
    if not isValid(m.quota) then return invalid
    return isTv() ? m.quota.tv : m.quota.movie
end function

' ===== Advanced options =====

function serverLabel() as string
    if not isValid(m.selectedServer) then return tr("Default")
    return serverName(m.selectedServer)
end function

function serverName(server as object) as string
    name = chainLookupReturn(server, "name", "")
    if server.is4k = true then name += " (4K)"
    return name
end function

function profileLabel() as string
    profiles = chainLookupReturn(m.serverDetails, "profiles", invalid)
    if isValid(profiles) and isValid(m.selectedProfileId)
        for each profile in profiles
            if profile.id = m.selectedProfileId then return profile.name
        end for
    end if
    return tr("Default")
end function

function rootFolderLabel() as string
    if isValidAndNotEmpty(m.selectedRootFolder) then return m.selectedRootFolder
    return tr("Default")
end function

sub clearAdvancedSelection()
    m.selectedServer = invalid
    m.selectedProfileId = invalid
    m.selectedRootFolder = ""
    m.serverDetails = invalid
end sub

' ===== Option pickers =====

' The server, profile and folder pickers
sub openPicker(key as string)
    options = pickerOptions(key)
    if options.count() = 0 then return

    current = pickerCurrent(key)
    labels = []
    selected = -1
    for i = 0 to options.count() - 1
        labels.push(options[i].label)
        if isValid(current) and options[i].matches = current then selected = i
    end for

    m.pickerKey = key
    m.pickerOptions = options
    m.picker = CreateSeerrPicker(pickerTitle(key), labels, selected)
    m.picker.observeField("activated", "onPickerResponse")
    m.picker.observeField("closed", "closePicker")
    m.top.appendChild(m.picker)
    m.picker.setFocus(true)
end sub

function pickerTitle(key as string) as string
    if key = "server" then return tr("Server")
    if key = "profile" then return tr("Quality Profile")
    return tr("Root Folder")
end function

function pickerCurrent(key as string) as dynamic
    if key = "server" then return chainLookupReturn(m.selectedServer, "id", invalid)
    if key = "profile" then return m.selectedProfileId
    return m.selectedRootFolder
end function

function pickerOptions(key as string) as object
    options = []

    if key = "server"
        if not isValid(m.servers) then return options
        for each server in m.servers
            options.push({ label: serverName(server), value: server, matches: server.id })
        end for
        return options
    end if

    if key = "profile"
        profiles = chainLookupReturn(m.serverDetails, "profiles", invalid)
        if not isValid(profiles) then return options
        for each profile in profiles
            options.push({ label: profile.name, value: profile.id, matches: profile.id })
        end for
        return options
    end if

    folders = chainLookupReturn(m.serverDetails, "rootFolders", invalid)
    if not isValid(folders) then return options
    for each folder in folders
        options.push({ label: folder.path, value: folder.path, matches: folder.path })
    end for
    return options
end function

sub onPickerResponse(event as object)
    id = event.getData()
    if id <> "cancel"
        option = m.pickerOptions[id.ToInt()]
        if m.pickerKey = "server"
            clearAdvancedSelection()
            m.selectedServer = option.value
            loadServerDetails()
        else if m.pickerKey = "profile"
            m.selectedProfileId = option.value
        else
            m.selectedRootFolder = option.value
        end if
        rebuild()
    end if
    closePicker()
end sub

sub closePicker()
    if not isValid(m.picker) then return
    m.picker.unobserveField("activated")
    m.picker.unobserveField("closed")
    m.sheet.setFocus(true)
    m.top.removeChild(m.picker)
    m.picker = invalid
end sub

' ===== Loading =====

sub loadQuota()
    if m.top.seerrUserId <= 0 then return

    m.quotaTask.request = {
        method: "GET",
        endpoint: `/api/v1/user/${m.top.seerrUserId.toStr()}/quota`
    }
    m.quotaTask.unobserveField("response")
    m.quotaTask.observeField("response", "onQuotaLoaded")
    m.quotaTask.control = TaskControl.RUN
end sub

sub onQuotaLoaded(event as object)
    response = event.getData()
    if not isValid(response) or not response.success or not isValid(response.data) then return

    m.quota = response.data
    ' The picks were made before the quota was known, so they follow it until the viewer changes one
    if isCollection() and not m.partsPicked then m.selectedParts = seerrRequestRules.FirstSelectable(m.top.parts, m.selected4k, quotaDetail())
    rebuild()
end sub

sub loadServers()
    m.advancedLoading = true

    m.serversTask.request = {
        method: "GET",
        endpoint: `/api/v1/service/${serviceName()}`
    }
    m.serversTask.unobserveField("response")
    m.serversTask.observeField("response", "onServersLoaded")
    m.serversTask.control = TaskControl.RUN
end sub

sub onServersLoaded(event as object)
    response = event.getData()
    m.advancedLoading = false

    if isValid(response) and response.success and isValid(response.data) and type(response.data) = "roArray"
        m.servers = response.data
        applyServerDefaults()
    else
        m.servers = []
    end if

    rebuild()
end sub

' Seerr keeps films and series on separate services
function serviceName() as string
    return isTv() ? "sonarr" : "radarr"
end function

sub applyServerDefaults()
    if not isValid(m.servers) or m.servers.count() = 0 then return

    m.selectedServer = defaultServer()
    loadServerDetails()
end sub

' The server Seerr would have picked itself: the default for this track, else any
' server on this track, else whatever is first
function defaultServer() as object
    for each server in m.servers
        if (server.is4k = true) = m.selected4k and server.isDefault = true then return server
    end for

    for each server in m.servers
        if (server.is4k = true) = m.selected4k then return server
    end for

    return m.servers[0]
end function

sub loadServerDetails()
    if not isValid(m.selectedServer) then return

    m.serverDetailTask.request = {
        method: "GET",
        endpoint: `/api/v1/service/${serviceName()}/${m.selectedServer.id.toStr()}`
    }
    m.serverDetailTask.unobserveField("response")
    m.serverDetailTask.observeField("response", "onServerDetailsLoaded")
    m.serverDetailTask.control = TaskControl.RUN
end sub

sub onServerDetailsLoaded(event as object)
    response = event.getData()
    if not isValid(response) or not response.success or not isValid(response.data) then return

    m.serverDetails = response.data
    applyProfileAndFolderDefaults()
    rebuild()
end sub

' Anime gets its own profile and folder on the Seerr side, so the title decides which
sub applyProfileAndFolderDefaults()
    server = m.selectedServer
    if not isValid(server) then return

    anime = titleIsAnime()

    if not isValid(m.selectedProfileId)
        profileId = invalid
        if anime then profileId = chainLookupReturn(server, "activeAnimeProfileId", invalid)
        if not isValid(profileId) then profileId = chainLookupReturn(server, "activeProfileId", invalid)
        m.selectedProfileId = profileId
    end if

    if isValidAndNotEmpty(m.selectedRootFolder) then return

    directory = ""
    if anime then directory = chainLookupReturn(server, "activeAnimeDirectory", "")
    if not isValidAndNotEmpty(directory) then directory = chainLookupReturn(server, "activeDirectory", "")

    folders = chainLookupReturn(m.serverDetails, "rootFolders", invalid)
    if not isValid(folders) or folders.count() = 0 then return

    for each folder in folders
        if isStringEqual(folder.path, directory)
            m.selectedRootFolder = folder.path
            return
        end if
    end for

    m.selectedRootFolder = folders[0].path
end sub

function titleIsAnime() as boolean
    keywords = chainLookupReturn(m.top.details, "keywords", invalid)
    if not isValid(keywords) or type(keywords) <> "roArray" then return false

    for each keyword in keywords
        if chainLookupReturn(keyword, "id", 0) = ANIME_KEYWORD_ID then return true
    end for

    return false
end function

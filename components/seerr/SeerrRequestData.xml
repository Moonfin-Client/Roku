<?xml version="1.0" encoding="utf-8"?>
<!-- One request, carried whole so the tile can read whatever it needs off it -->
<component name="SeerrRequestData" extends="ContentNode">
  <interface>
    <field id="request" type="assocarray" />
    <!-- The round buttons on its poster, left to right -->
    <field id="actions" type="array" />
    <!-- The screen draws focus through these, since the grid never holds it. stop 0 is the tile,
         and 1 on are its buttons. -->
    <field id="lit" type="boolean" value="false" />
    <field id="stop" type="integer" value="0" />
    <!-- Set on every tile once any requester's line runs too long, so captions stay one height -->
    <field id="splitRequester" type="boolean" value="false" />
  </interface>
</component>

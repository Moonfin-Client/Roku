<?xml version="1.0" encoding="utf-8"?>
<component name="SeerrDiscoveryScreen" extends="JFScreen">

    <children>
        <Rectangle width="1920" height="1080" color="#101010" />

        <Poster id="backdropPrev" loadDisplayMode="scaleToZoom" width="1920" height="1080" opacity="0.0" />
        <Poster id="backdrop" loadDisplayMode="scaleToZoom" width="1920" height="1080" opacity="0.0" />

        <!-- Core's scrim: 80% black at the top, 33% a quarter of the way down, 87% from 60% down -->
        <Poster id="backdropScrim" uri="pkg:/images/seerr/scrim.webp" width="1920" height="1080" />

        <!-- Classic rows: the focused item's details above the rows -->
        <LayoutGroup id="detailsSection" translation="[100, 180]" layoutDirection="vert" itemSpacings="[15]">
            <Text id="itemTitle" font="font:LargeBoldSystemFont" width="1300" wrap="true" maxLines="2" />
            <Text id="metadataText" font="font:SmallSystemFont" color="#FFFFFF" width="1720" />
            <Text id="itemOverview" font="font:MediumSystemFont" width="1720" wrap="true" maxLines="4" lineSpacing="-5" />
        </LayoutGroup>

        <SeerrDiscoveryRows id="categoryRows"
            itemComponentName="SeerrCard"
            showRowLabel="[true]"
            showRowCounter="[false]"
            vertFocusAnimationStyle="fixedFocus"
            rowFocusAnimationStyle="fixedFocus"
            numRows="4"
            drawFocusFeedback="false"
            itemSpacing="[0, 0]" />

        <!-- Modern rows: the focused media card is drawn here on top of the row, the way
             Home draws it, with Core's ring around it -->
        <ModernFocusCard id="modernFocusCard" visible="false" />
        <Group id="cardBadge" visible="false">
            <Poster id="cardBadgeFill" uri="pkg:/images/seerr/fill7.9.png" opacity="0.85" />
            <Label id="cardBadgeLabel" color="#FFFFFF" vertAlign="center" />
        </Group>
        <Poster id="cardRing" uri="pkg:/images/seerr/ring21w5.9.png" visible="false" />

        <!-- Search and Requests in the top right -->
        <SeerrPill id="searchPill" iconUri="pkg:/images/icons/search-light.webp" />
        <SeerrPill id="requestsPill" iconUri="pkg:/images/icons/manage_requests.webp" />
        <!-- Holds the remote while a pill is picked, since the screen itself can't take focus
             back from a child -->
        <Group id="pillFocus" focusable="true" />

        <Label id="loadingLabel"
            text="Loading..."
            font="font:LargeSystemFont"
            translation="[960, 540]"
            horizAlign="center"
            vertAlign="center"
            visible="false" />

        <Label id="errorLabel"
            text=""
            font="font:MediumSystemFont"
            translation="[60, 100]"
            width="1800"
            wrap="true"
            visible="false" />
        <Animation id="backdropFadeIn" duration="0.6" repeat="false" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="backdropFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdrop.opacity" />
        </Animation>

        <Animation id="backdropPrevFadeOut" duration="0.6" repeat="false" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="backdropPrevFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="backdropPrev.opacity" />
        </Animation>
    </children>
    <interface>
        <function name="showLoading" />
        <function name="hideLoading" />
        <function name="showError" />
    </interface>
</component>

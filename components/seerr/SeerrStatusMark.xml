<?xml version="1.0" encoding="utf-8"?>
<!-- A Seerr status on a poster: a strip across the top for the Banner style, or Seerr's dot in the
     top right corner for the Badge style -->
<component name="SeerrStatusMark" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/white.webp" />
    <Label id="label" horizAlign="center" vertAlign="center" maxLines="1">
      <Font role="font" uri="font:BoldSystemFontFile" size="17" />
    </Label>
    <Group id="dot">
      <Poster id="dotShadow" uri="pkg:/images/icons/circle.webp" blendColor="#00000099" />
      <Poster id="dotOuter" uri="pkg:/images/icons/circle.webp" />
      <Poster id="dotInner" uri="pkg:/images/icons/circle.webp" blendColor="#FFFFFF" />
      <Poster id="dotGlyph" />
    </Group>
  </children>
  <interface>
    <field id="status" type="integer" value="-1" onChange="redraw" />
    <!-- banner or badge -->
    <field id="markStyle" type="string" value="banner" onChange="redraw" />
    <field id="bannerWidth" type="float" onChange="redraw" />
  </interface>
</component>

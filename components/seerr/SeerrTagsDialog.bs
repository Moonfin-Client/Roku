import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"

const PANEL_PADDING = 32
const PANEL_WIDTH = 1360
const PANEL_Y = 140
const CHIP_HEIGHT = 44
const CHIP_PADDING = 20
const CHIP_GAP = 14
const ROW_GAP = 12
const HEADING_HEIGHT = 40
const SECTIONS_TOP = 92
const SECTION_GAP = 24
const CHIP_IDLE = "0xD1D5DBFF"
const CHIP_FOCUS = "0xFFFFFFFF"

sub init()
    m.panel = m.top.findNode("panel")
    m.sections = m.top.findNode("sections")
    m.closeButton = m.top.findNode("closeButton")

    m.top.findNode("title").text = tr("Genres and Tags")
    m.closeButton.text = tr("Close")
    loginStyle.ApplyButton(m.closeButton)

    m.measure = CreateObject("roSGNode", "Label")
    m.measure.font = "font:SmallSystemFont"
    m.measure.text = m.closeButton.text
    m.closeButton.width = m.measure.boundingRect().width + (CHIP_PADDING * 2)

    m.chips = []
    m.chipRows = []
    m.focusedChip = 0
    m.onClose = false

end sub

sub showDialog()
    m.sections.removeChildrenIndex(m.sections.getChildCount(), 0)
    m.chips = []
    m.chipRows = []

    details = m.top.details
    m.chipMediaType = isStringEqual(m.top.mediaType, "tv") ? "tv" : "movie"

    yPos = 0
    yPos = buildSection(tr("Genres"), chipEntries(details, "genres"), "genre", yPos)
    yPos = buildSection(tr("Networks"), chipEntries(details, "networks"), "network", yPos)
    yPos = buildSection(tr("Tags"), chipEntries(details, "keywords"), "keyword", yPos)

    m.panel.width = PANEL_WIDTH
    m.panel.height = SECTIONS_TOP + yPos + PANEL_PADDING
    m.panel.translation = [(1920 - PANEL_WIDTH) / 2, PANEL_Y]
    m.closeButton.translation = [PANEL_WIDTH - PANEL_PADDING - m.closeButton.width, 24]

    m.onClose = m.chips.count() = 0
    m.focusedChip = 0
    refreshFocus()

    m.top.visible = true
    m.top.setFocus(true)
end sub

' Seerr names all three the same way, so one reader covers them
function chipEntries(details as object, key as string) as object
    entries = []
    if not isValid(details) then return entries

    list = details[key]
    if not isValid(list) or type(list) <> "roArray" then return entries

    for each entry in list
        if not isValid(entry) or not isValidAndNotEmpty(entry.name) then continue for
        if not isValid(entry.id) then continue for
        entries.push({ id: entry.id, name: entry.name })
    end for

    return entries
end function

function buildSection(heading as string, entries as object, kind as string, yPos as integer) as integer
    if entries.count() = 0 then return yPos

    label = m.sections.createChild("Label")
    label.text = heading
    label.font = "font:SmallBoldSystemFont"
    label.color = "0xFFFFFF99"
    label.height = HEADING_HEIGHT
    label.translation = [0, yPos]
    yPos += HEADING_HEIGHT

    maxWidth = PANEL_WIDTH - (PANEL_PADDING * 2)
    xPos = 0
    rowIndices = []

    for each entry in entries
        m.measure.text = entry.name
        chipWidth = m.measure.boundingRect().width + (CHIP_PADDING * 2)

        if xPos > 0 and xPos + chipWidth > maxWidth
            m.chipRows.push(rowIndices)
            rowIndices = []
            xPos = 0
            yPos += CHIP_HEIGHT + ROW_GAP
        end if

        m.chips.push(buildChip(entry, kind, [xPos, yPos], chipWidth))
        rowIndices.push(m.chips.count() - 1)
        xPos += chipWidth + CHIP_GAP
    end for

    if rowIndices.count() > 0 then m.chipRows.push(rowIndices)

    return yPos + CHIP_HEIGHT + SECTION_GAP
end function

function buildChip(entry as object, kind as string, position as object, chipWidth as integer) as object
    chip = m.sections.createChild("Group")
    chip.translation = position

    fill = chip.createChild("Poster")
    fill.uri = "pkg:/images/details/badgefill6.9.png"
    fill.width = chipWidth
    fill.height = CHIP_HEIGHT
    fill.blendColor = "0xFFFFFF14"

    focusRing = chip.createChild("Poster")
    focusRing.uri = "pkg:/images/hd_focus.9.png"
    focusRing.width = chipWidth
    focusRing.height = CHIP_HEIGHT
    focusRing.blendColor = ColorPalette.WHITE
    focusRing.visible = false

    label = chip.createChild("Label")
    label.text = entry.name
    label.font = "font:SmallSystemFont"
    label.color = CHIP_IDLE
    label.width = chipWidth
    label.height = CHIP_HEIGHT
    label.horizAlign = "center"
    label.vertAlign = "center"

    chip.addField("entryId", "integer", false)
    chip.entryId = entry.id
    chip.addField("entryName", "string", false)
    chip.entryName = entry.name
    chip.addField("entryKind", "string", false)
    chip.entryKind = kind
    chip.addField("focusRing", "node", false)
    chip.focusRing = focusRing
    chip.addField("labelNode", "node", false)
    chip.labelNode = label

    return chip
end function

sub refreshFocus()
    for i = 0 to m.chips.count() - 1
        chip = m.chips[i]
        focused = (not m.onClose) and i = m.focusedChip
        chip.focusRing.visible = focused
        chip.labelNode.color = focused ? CHIP_FOCUS : CHIP_IDLE
    end for

    m.closeButton.focus = m.onClose
end sub

' The row a chip sits in, so up and down move by row rather than by one chip
function rowOfFocused() as integer
    for i = 0 to m.chipRows.count() - 1
        for each index in m.chipRows[i]
            if index = m.focusedChip then return i
        end for
    end for
    return 0
end function

sub moveToRow(rowIndex as integer)
    if rowIndex < 0 or rowIndex >= m.chipRows.count() then return

    currentRow = m.chipRows[rowOfFocused()]
    column = 0
    for i = 0 to currentRow.count() - 1
        if currentRow[i] = m.focusedChip
            column = i
            exit for
        end if
    end for

    target = m.chipRows[rowIndex]
    if column >= target.count() then column = target.count() - 1
    m.focusedChip = target[column]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        closeDialog()
        return true
    end if

    if key = KeyCode.OK
        if m.onClose
            closeDialog()
        else
            openBrowse()
        end if
        return true
    end if

    if key = KeyCode.LEFT
        if not m.onClose and m.focusedChip > 0
            m.focusedChip--
            refreshFocus()
        end if
        return true
    end if

    if key = KeyCode.RIGHT
        if not m.onClose and m.focusedChip < m.chips.count() - 1
            m.focusedChip++
            refreshFocus()
        end if
        return true
    end if

    if key = KeyCode.UP
        if not m.onClose
            row = rowOfFocused()
            if row = 0
                m.onClose = true
            else
                moveToRow(row - 1)
            end if
            refreshFocus()
        end if
        return true
    end if

    if key = KeyCode.DOWN
        if m.onClose
            if m.chips.count() > 0
                m.onClose = false
                m.focusedChip = 0
            end if
        else
            moveToRow(rowOfFocused() + 1)
        end if
        refreshFocus()
        return true
    end if

    return false
end function

sub closeDialog()
    m.top.visible = false
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
end sub

' Genres, networks and keywords each lead into Seerr browse rather than the library,
' and a network only ever browses TV whatever the title is
sub openBrowse()
    if m.focusedChip < 0 or m.focusedChip >= m.chips.count() then return

    chip = m.chips[m.focusedChip]
    screen = CreateObject("roSGNode", "SeerrGenreBrowseScreen")
    screen.browseType = chip.entryKind
    screen.mediaType = isStringEqual(chip.entryKind, "network") ? "tv" : m.chipMediaType
    screen.genreName = chip.entryName
    screen.genreId = chip.entryId

    closeDialog()
    m.global.sceneManager.callFunc("pushScene", screen)
end sub

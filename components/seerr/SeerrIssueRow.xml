<?xml version="1.0" encoding="utf-8"?>
<!-- One issue in the list: what it is about, what kind it is and whether it is still open -->
<component name="SeerrIssueRow" extends="Group">
  <children>
    <Poster id="rowBg" uri="pkg:/images/details/badgefill6.9.png" blendColor="#FFFFFF" opacity="0.05" />
    <Poster id="rowFocus" uri="pkg:/images/hd_focus.9.png" visible="false" />

    <Poster id="poster" loadDisplayMode="scaleToZoom" />

    <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" maxLines="1" />
    <Label id="meta" font="font:SmallSystemFont" color="#FFFFFFB3" maxLines="1" />
    <SeerrStatusChip id="statusChip" />
    <Label id="byline" font="font:SmallestSystemFont" color="#FFFFFF99" maxLines="1" />
  </children>

  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>

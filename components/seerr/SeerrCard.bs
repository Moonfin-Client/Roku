import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

' Core's sizes on a 1080p screen
const TEXT_GAP = 10
const TITLE_SIZE = 22
const TITLE_LINE = 27
const SUBTITLE_SIZE = 20
const BADGE_SIZE = 17
const BADGE_PAD_X = 10
const BADGE_PAD_Y = 3
const BADGE_EDGE = 10
const RING_OUTSET = 8
const TILE_PAD = 13
const TILE_TEXT_SIZE = 23
const TILE_ICON_SIZE = 27
const TILE_ICON_GAP = 10
const LOGO_INSET = 27
const GROW_SCALE = 1.12
const TILE_SCALE = 1.05

sub init()
    m.insetGroup = m.top.findNode("insetGroup")
    m.shiftGroup = m.top.findNode("shiftGroup")
    m.artGroup = m.top.findNode("artGroup")
    m.ring = m.top.findNode("ring")
    m.artMask = m.top.findNode("artMask")
    m.placeholder = m.top.findNode("placeholder")
    m.art = m.top.findNode("art")
    m.shade = m.top.findNode("shade")
    m.veil = m.top.findNode("veil")
    m.logoFill = m.top.findNode("logoFill")
    m.logo = m.top.findNode("logo")
    m.mediaBadge = m.top.findNode("mediaBadge")
    m.mediaBadgeFill = m.top.findNode("mediaBadgeFill")
    m.mediaBadgeLabel = m.top.findNode("mediaBadgeLabel")
    m.tileLabel = m.top.findNode("tileLabel")
    m.tileIcon = m.top.findNode("tileIcon")
    m.tileIconImage = m.top.findNode("tileIconImage")
    m.tileBorder = m.top.findNode("tileBorder")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.modernShiftAnim = m.top.findNode("modernShiftAnim")
    m.modernShiftInterp = m.top.findNode("modernShiftInterp")
    m.modernShiftOpacity = m.top.findNode("modernShiftOpacity")

    m.title.font = fontOfSize(TITLE_SIZE, true)
    m.subtitle.font = fontOfSize(SUBTITLE_SIZE, false)
    m.mediaBadgeLabel.font = fontOfSize(BADGE_SIZE, true)
    m.tileLabel.font = fontOfSize(TILE_TEXT_SIZE, true)
    iconFont = CreateObject("roSGNode", "Font")
    iconFont.uri = settingsGlyphs.FONT_URI
    iconFont.size = TILE_ICON_SIZE
    m.tileIcon.font = iconFont

    m.focusStyle = "none"
    m.modernObservedNode = invalid
    ' Read once, since every look at the settings copies them all
    focusColor = coreFocusColor()
    m.ring.blendColor = focusColor
    m.tileBorder.blendColor = focusColor
end sub

function nodeValue(node as object, fieldName as string, fallback as dynamic) as dynamic
    if node.hasField(fieldName) and isValid(node.getField(fieldName)) then return node.getField(fieldName)
    return fallback
end function

sub itemContentChanged()
    ' A list can hand a card its content before the card's own init has run
    if not isValid(m.title) then init()
    node = m.top.itemContent
    if not isValid(node) then return

    followModernShift(node)

    kind = nodeValue(node, "cardKind", "poster")
    size = nodeValue(node, "posterSize", [134, 200])
    width = size[0]
    height = size[1]
    m.focusStyle = nodeValue(node, "focusStyle", "none")
    m.insetGroup.translation = nodeValue(node, "cardInset", [0, 0])
    isPoster = kind = "poster"

    m.artMask.maskUri = nodeValue(node, "maskUri", "pkg:/images/seerr/posterMask134.webp")
    m.artMask.size = [width, height]
    for each layer in [m.placeholder, m.art, m.shade, m.veil, m.logoFill, m.tileBorder]
        layer.width = width
        layer.height = height
    end for
    m.ring.translation = [-RING_OUTSET, -RING_OUTSET]
    m.ring.width = width + RING_OUTSET * 2
    m.ring.height = height + RING_OUTSET * 2

    ' A grown poster rises from its bottom edge, and a tile swells from its middle
    if m.focusStyle = "grow"
        m.artGroup.scaleRotateCenter = [width / 2, height]
    else
        m.artGroup.scaleRotateCenter = [width / 2, height / 2]
    end if

    m.placeholder.visible = kind <> "logo"
    m.art.visible = kind <> "logo"
    m.art.loadWidth = width
    m.art.loadHeight = height
    m.art.uri = ""
    if kind <> "logo" then m.art.uri = nodeValue(node, "sdPosterUrl", "")
    m.shade.visible = kind = "shortcut"
    m.veil.visible = kind = "genre"
    m.logoFill.visible = kind = "logo"
    m.logo.visible = kind = "logo"
    m.tileLabel.visible = kind = "genre" or kind = "shortcut"
    iconUri = nodeValue(node, "tileIconUri", "")
    m.tileIcon.visible = kind = "shortcut" and iconUri = ""
    m.tileIconImage.visible = kind = "shortcut" and iconUri <> ""
    m.title.visible = isPoster
    m.subtitle.visible = isPoster

    titleText = node.title ?? ""
    if kind = "logo"
        m.logo.translation = [LOGO_INSET, LOGO_INSET]
        m.logo.width = width - LOGO_INSET * 2
        m.logo.height = height - LOGO_INSET * 2
        m.logo.uri = nodeValue(node, "hdPosterUrl", "")
    else if kind = "genre"
        m.tileLabel.text = UCase(titleText)
        m.tileLabel.color = "#FFFFFFE6"
        m.tileLabel.horizAlign = "center"
        m.tileLabel.vertAlign = "center"
        m.tileLabel.translation = [TILE_PAD, 0]
        m.tileLabel.width = width - TILE_PAD * 2
        m.tileLabel.height = height
    else if kind = "shortcut"
        top = height - TILE_PAD - TILE_ICON_SIZE
        m.tileIcon.text = settingsGlyphs.Char(nodeValue(node, "tileGlyph", "movie"))
        m.tileIcon.width = TILE_ICON_SIZE
        m.tileIcon.height = TILE_ICON_SIZE
        m.tileIcon.translation = [TILE_PAD, top]
        m.tileIconImage.uri = iconUri
        m.tileIconImage.width = TILE_ICON_SIZE
        m.tileIconImage.height = TILE_ICON_SIZE
        m.tileIconImage.translation = [TILE_PAD, top]
        textX = TILE_PAD + TILE_ICON_SIZE + TILE_ICON_GAP
        m.tileLabel.text = titleText
        m.tileLabel.color = "#FFFFFF"
        m.tileLabel.horizAlign = "left"
        m.tileLabel.vertAlign = "center"
        m.tileLabel.translation = [textX, top]
        m.tileLabel.width = width - textX - TILE_PAD
        m.tileLabel.height = TILE_ICON_SIZE
    else
        m.title.text = titleText
        m.title.width = width
        m.title.translation = [0, height + TEXT_GAP]
        m.subtitle.text = nodeValue(node, "cardSubtitle", "")
        m.subtitle.width = width
        m.subtitle.translation = [0, height + TEXT_GAP + TITLE_LINE]
    end if

    status = -1
    if isPoster then status = seerrCardStatus(node)
    m.seerrStatusMark = drawSeerrStatus(m.seerrStatusMark, m.artMask, status, width)
    drawMediaBadge(node, isPoster)
    showFocus()
end sub

' MOVIE or SERIES in the top left, dropped below a banner when the status runs across the top
sub drawMediaBadge(node as object, isPoster as boolean)
    badge = invalid
    if isPoster then badge = seerrMediaBadge(node.mediaType)
    m.mediaBadge.visible = isValid(badge)
    if not isValid(badge) then return

    m.mediaBadgeLabel.width = 0
    m.mediaBadgeLabel.height = 0
    m.mediaBadgeLabel.text = badge.text
    bounds = m.mediaBadgeLabel.boundingRect()
    badgeHeight = Int(bounds.height) + BADGE_PAD_Y * 2
    m.mediaBadgeFill.width = Int(bounds.width) + BADGE_PAD_X * 2
    m.mediaBadgeFill.height = badgeHeight
    m.mediaBadgeFill.blendColor = badge.color
    m.mediaBadgeLabel.translation = [BADGE_PAD_X, 0]
    m.mediaBadgeLabel.height = badgeHeight

    top = BADGE_EDGE
    if isValid(m.seerrStatusMark) and m.seerrStatusMark.visible and m.seerrStatusMark.markStyle = "banner" then top += SEERR_BANNER_HEIGHT
    m.mediaBadge.translation = [BADGE_EDGE, top]
end sub

' The browse grid grows its focused poster with a ring, as Core's TV grid does, or only rings it
' with focus expansion off. Tiles swell a little and take a border. Discover's modern posters
' leave focus to the card drawn over them.
sub showFocus()
    if not isValid(m.artGroup) then return
    ' A card resting under the list's focus without holding it means the list lost focus
    amount = m.top.focusPercent
    if amount >= 1 and not m.top.itemHasFocus then amount = 0.0

    growth = 0.0
    if m.focusStyle = "grow" then growth = GROW_SCALE - 1
    if m.focusStyle = "tile" then growth = TILE_SCALE - 1
    scaled = 1 + growth * amount
    m.artGroup.scale = [scaled, scaled]
    m.ring.opacity = (m.focusStyle = "grow" or m.focusStyle = "ring") ? amount : 0
    m.tileBorder.opacity = m.focusStyle = "tile" ? amount : 0
end sub

' Seerr Discover's modern rows set modernShift on a media row's nodes, so the cells after the
' focused one slide right to open room for its landscape card. Other rows leave it off.
sub followModernShift(itemData as object)
    if isValid(m.modernObservedNode)
        m.modernObservedNode.unobserveFieldScoped("modernShift")
        m.modernObservedNode = invalid
    end if
    m.modernShiftAnim.control = "stop"

    shift = 0
    if itemData.hasField("modernShift")
        itemData.observeFieldScoped("modernShift", "onModernShiftChanged")
        m.modernObservedNode = itemData
        shift = itemData.modernShift
    end if

    ' A cell that's bound again takes its place without sliding into it
    if shift = -1
        m.shiftGroup.translation = [0, 0]
        m.shiftGroup.opacity = 0
    else
        m.shiftGroup.translation = [shift, 0]
        m.shiftGroup.opacity = 1
    end if
end sub

' The focused cell (-1) fades out under the card, and the ones after it slide aside
sub onModernShiftChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    shift = itemData.modernShift
    targetOpacity = 1.0
    if shift = -1
        shift = 0
        targetOpacity = 0.0
    end if

    m.modernShiftAnim.control = "stop"
    m.modernShiftInterp.keyValue = [m.shiftGroup.translation, [shift, 0]]
    m.modernShiftOpacity.keyValue = [m.shiftGroup.opacity, targetOpacity]
    m.modernShiftAnim.control = "start"
end sub

import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' Picked on this screen and kept on this device. Until then the grid follows the library size.
const SEERR_POSTER_SIZE_SETTING = "ui.seerr.posterSize"
const GRID_TOP = 395
const GRID_WIDTH = 1740
const TOOLBAR_RIGHT = 1820

sub init()
    m.genreNameLabel = m.top.findNode("genreNameLabel")
    m.mediaGrid = m.top.findNode("mediaGrid")
    m.backdrop = m.top.findNode("backdrop")
    m.loadingLabel = m.top.findNode("loadingLabel")
    m.errorLabel = m.top.findNode("errorLabel")
    m.noResultsLabel = m.top.findNode("noResultsLabel")

    ' Info section elements
    m.itemTitle = m.top.findNode("itemTitle")
    m.metaYear = m.top.findNode("metaYear")
    m.metaType = m.top.findNode("metaType")
    m.metaRating = m.top.findNode("metaRating")
    m.starIcon = m.top.findNode("starIcon")
    m.metaOverview = m.top.findNode("metaOverview")

    m.sortButton = m.top.findNode("sortButton")
    m.filterButton = m.top.findNode("filterButton")
    m.settingsButton = m.top.findNode("settingsButton")
    m.sortButton.text = tr("Sort")
    m.filterButton.text = tr("Filter")
    m.toolbar = [m.sortButton, m.filterButton, m.settingsButton]
    for each button in m.toolbar
        button.background = "#FFFFFF1A"
        button.focusBackground = "#FFFFFF33"
        button.color = "#FFFFFF"
        button.focusColor = "#FFFFFF"
    end for
    m.sortButton.observeField("buttonSelected", "ShowSortDialog")
    m.filterButton.observeField("buttonSelected", "ShowFilterDialog")
    m.settingsButton.observeField("buttonSelected", "ShowSettingsDialog")
    m.browseSheet = invalid
    layoutToolbar()

    ' Observe interface fields
    m.top.observeField("genreId", "onGenreIdChanged")
    m.top.observeField("genreName", "onGenreNameChanged")
    m.top.observeField("mediaType", "onMediaTypeChanged")

    ' Observe grid selection
    m.mediaGrid.observeField("itemSelected", "onItemSelected")
    m.mediaGrid.observeField("itemFocused", "onItemFocused")

    ' Configure grid focus
    m.mediaGrid.focusBitmapUri = "pkg:/images/hd_focus.9.png"
    m.mediaGrid.focusBitmapBlendColor = ColorPalette.WHITE
    m.mediaGrid.focusFootprintBitmapUri = ""
    m.mediaGrid.focusFootprintBlendColor = ColorPalette.TRANSPARENT
    m.mediaGrid.drawFocusFeedback = true

    ' State management
    m.currentPage = 1
    m.isLoading = false
    m.hasMorePages = true

    ' Sort/filter options
    m.currentSortBy = "popularity.desc"
    m.sortOptions = [
        { label: tr("Popularity"), value: "popularity.desc" },
        { label: tr("Rating"), value: "vote_average.desc" },
        { label: tr("Release Date"), value: "release_date.desc" },
        { label: tr("Title"), value: "original_title.asc" }
    ]

    ' Filter options: show items based on request/availability status
    m.currentFilter = "not_requested" ' Default to not requested
    m.filterOptions = [
        { label: tr("All Items"), value: "all" },
        { label: tr("Not Requested"), value: "not_requested" },
        { label: tr("Available Only"), value: "available" }
    ]

    m.mediaGrid.content = CreateObject("roSGNode", "ContentNode")
    applyPosterSize()

    ' API task for requests
    m.apiTask = invalid

    ' Cache frequently accessed data
    m.configCache = GetSeerrConfig()
    m.blockNsfwCache = true
    if m.configCache <> invalid and m.configCache.blockNsfw <> invalid
        m.blockNsfwCache = m.configCache.blockNsfw
    end if
end sub

sub onGenreIdChanged()
    if m.top.genreId > 0 and m.top.mediaType <> ""
        LoadContent()
    end if
end sub

sub onGenreNameChanged()
    if m.top.genreName <> ""
        m.genreNameLabel.text = m.top.genreName
    end if
end sub

sub onMediaTypeChanged()
    if m.top.genreId > 0 and m.top.mediaType <> ""
        LoadContent()
    end if
end sub

sub LoadContent()
    if m.isLoading then return

    m.isLoading = true
    ShowLoading()

    browseType = m.top.browseType
    if browseType = invalid or browseType = "" then browseType = "genre"

    ' Build endpoint and query params based on browse type
    ' Using discover endpoint with filter params (not /genre/{id} or /studio/{id})
    sortBy = m.currentSortBy
    if sortBy = invalid or sortBy = "" then sortBy = "popularity.desc"

    ' Seerr hands the language parameter to TMDB as the original language
    ' filter, so naming one hides every production made in any other language.
    queryParams = {
        "page": m.currentPage.toStr(),
        "sortBy": sortBy
    }

    if browseType = "genre"
        if m.top.mediaType = "movie"
            endpoint = "/api/v1/discover/movies"
            queryParams["genre"] = m.top.genreId.toStr()
        else
            endpoint = "/api/v1/discover/tv"
            queryParams["genre"] = m.top.genreId.toStr()
        end if
    else if browseType = "network"
        endpoint = "/api/v1/discover/tv"
        queryParams["network"] = m.top.genreId.toStr()
    else if browseType = "studio"
        endpoint = "/api/v1/discover/movies"
        queryParams["studio"] = m.top.genreId.toStr()
    else if browseType = "keyword"
        if m.top.mediaType = "movie"
            endpoint = "/api/v1/discover/movies"
            queryParams["keywords"] = m.top.genreId.toStr()
        else
            endpoint = "/api/v1/discover/tv"
            queryParams["keywords"] = m.top.genreId.toStr()
        end if
    else if browseType = "collection"
        ' A collection comes back whole rather than a page at a time
        endpoint = "/api/v1/collection/" + m.top.genreId.toStr()
        queryParams = {}
    else
        ' Default to genre
        if m.top.mediaType = "movie"
            endpoint = "/api/v1/discover/movies"
            queryParams["genre"] = m.top.genreId.toStr()
        else
            endpoint = "/api/v1/discover/tv"
            queryParams["genre"] = m.top.genreId.toStr()
        end if
    end if

    m.apiTask = CreateObject("roSGNode", "SeerrAPITask")
    m.apiTask.addFields({ page: m.currentPage })

    m.apiTask.request = {
        method: "GET",
        endpoint: endpoint,
        queryParams: queryParams
    }

    m.apiTask.observeField("response", "onContentResponse")
    m.apiTask.control = "RUN"
end sub

sub onContentResponse(event as object)
    response = event.getData()
    m.isLoading = false
    HideLoading()

    if response.success and response.data <> invalid
        results = response.data.results
        ' A collection lists its titles under parts rather than results
        if results = invalid then results = response.data.parts

        if results <> invalid and type(results) = "roArray"
            ' Filter results based on current filter setting
            blockNsfw = m.blockNsfwCache
            filteredResults = []

            for i = 0 to results.Count() - 1
                item = results[i]
                includeItem = true

                ' Always filter NSFW if setting is enabled
                if blockNsfw and IsItemNsfw(item)
                    includeItem = false
                end if

                ' Apply filter based on current filter setting
                if includeItem
                    isAvailable = IsItemAvailable(item)
                    isRequested = IsItemRequested(item)

                    if m.currentFilter = "not_requested"
                        ' Show only items that are NOT available and NOT requested
                        if isAvailable or isRequested
                            includeItem = false
                        end if
                    else if m.currentFilter = "available"
                        ' Show only items that ARE available
                        if not isAvailable
                            includeItem = false
                        end if
                    end if
                    ' "all" filter shows everything (minus NSFW if blocked)
                end if

                if includeItem
                    filteredResults.push(item)
                end if
            end for

            ' Check if there are more pages
            totalPages = response.data.totalPages
            if totalPages <> invalid
                m.hasMorePages = m.currentPage < totalPages
            else
                m.hasMorePages = results.Count() >= 20
            end if

            ' Add items to grid
            for i = 0 to filteredResults.Count() - 1
                item = filteredResults[i]
                mediaNode = CreateMediaContentNode(item)
                if mediaNode <> invalid
                    mediaNode.addFields({ posterSize: m.posterSize })
                    m.mediaGrid.content.appendChild(mediaNode)
                end if
            end for

            ' Show no results message if empty
            if m.mediaGrid.content.getChildCount() = 0
                m.noResultsLabel.visible = true
            else
                m.noResultsLabel.visible = false
                m.mediaGrid.setFocus(true)
            end if
        else
            ShowError("No results found")
        end if
    else
        errorMsg = "Failed to load content"
        if response.error <> invalid
            errorMsg = errorMsg + ": " + response.error
        end if
        ShowError(errorMsg)
    end if
end sub

sub onItemFocused(event as object)
    focusedIndex = event.getData()

    if focusedIndex >= 0 and focusedIndex < m.mediaGrid.content.getChildCount()
        focusedItem = m.mediaGrid.content.getChild(focusedIndex)

        ' Update backdrop
        if focusedItem <> invalid and focusedItem.hdBackgroundImageUrl <> invalid and focusedItem.hdBackgroundImageUrl <> ""
            m.backdrop.uri = focusedItem.hdBackgroundImageUrl
        end if

        ' Update info section
        UpdateInfoSection(focusedItem)

        ' Load more when near end
        itemsFromEnd = m.mediaGrid.content.getChildCount() - focusedIndex
        if itemsFromEnd <= 8 and m.hasMorePages and not m.isLoading
            m.currentPage = m.currentPage + 1
            LoadContent()
        end if
    end if
end sub

sub UpdateInfoSection(item as object)
    if item = invalid then return

    ' Update item title
    if item.title <> invalid and item.title <> ""
        m.itemTitle.text = item.title
    else if item.name <> invalid and item.name <> ""
        m.itemTitle.text = item.name
    else
        m.itemTitle.text = ""
    end if

    ' Update year
    if item.releaseYear <> invalid and item.releaseYear <> ""
        m.metaYear.text = item.releaseYear
    else
        m.metaYear.text = ""
    end if

    ' Update type
    if item.mediaType <> invalid and item.mediaType <> ""
        if item.mediaType = "movie"
            m.metaType.text = "Movie"
        else if item.mediaType = "tv"
            m.metaType.text = "TV Series"
        else
            m.metaType.text = item.mediaType
        end if
    else
        m.metaType.text = ""
    end if

    ' Update rating
    if item.rating <> invalid and item.rating <> ""
        m.metaRating.text = item.rating
        m.starIcon.visible = true
    else
        m.metaRating.text = ""
        m.starIcon.visible = false
    end if

    ' Update overview
    if item.overview <> invalid and item.overview <> ""
        m.metaOverview.text = item.overview
    else if item.description <> invalid and item.description <> ""
        m.metaOverview.text = item.description
    else
        m.metaOverview.text = ""
    end if
end sub

sub onItemSelected(event as object)
    selectedIndex = event.getData()

    if selectedIndex >= 0 and selectedIndex < m.mediaGrid.content.getChildCount()
        selectedItem = m.mediaGrid.content.getChild(selectedIndex)
        if selectedItem <> invalid
            ShowSeerrDetails(selectedItem)
        end if
    end if
end sub

sub ShowLoading()
    m.loadingLabel.visible = true
    m.errorLabel.visible = false
    m.noResultsLabel.visible = false
end sub

sub HideLoading()
    m.loadingLabel.visible = false
end sub

sub ShowError(message as string)
    m.errorLabel.text = message
    m.errorLabel.visible = true
    m.loadingLabel.visible = false
end sub

' ===== Toolbar =====

' The toolbar's buttons that are showing, left to right
function toolbarButtons() as object
    buttons = []
    for each button in m.toolbar
        if button.visible then buttons.push(button)
    end for
    return buttons
end function

' The focused title runs up to wherever the toolbar starts
sub layoutToolbar()
    width = 0
    for each button in toolbarButtons()
        if width > 0 then width += 15
        width += button.width
    end for
    m.itemTitle.width = TOOLBAR_RIGHT - width - 30 - 100
end sub

' ===== Poster size =====

function PosterSize() as string
    library = libraryCard.PosterSize(get_user_setting("ui.library.posterSize"), get_user_setting("ui.posterSize"))
    return libraryCard.PosterSize(get_user_setting(SEERR_POSTER_SIZE_SETTING), library)
end function

' As many columns as fit the width, and only rows whose titles stay on screen
sub applyPosterSize()
    height = libraryCard.posterHeightFor(PosterSize(), false)
    width = Int(height * 2 / 3 + 0.5)
    m.posterSize = [width, height]
    m.mediaGrid.itemSize = m.posterSize
    m.mediaGrid.numColumns = Int(GRID_WIDTH / (width + 20))
    rows = 1 + Int((1080 - GRID_TOP - 70 - height) / (height + 65))
    if rows < 1 then rows = 1
    m.mediaGrid.numRows = rows
end sub

sub ShowSettingsDialog()
    size = PosterSize()
    elements = [
        { kind: "heading", text: tr("Seerr Settings") },
        { kind: "subtitle", text: tr("Poster Size") },
        { kind: "divider", color: "#FFFFFF14" }
    ]
    for each option in [{ id: "small", label: tr("Small") }, { id: "medium", label: tr("Medium") }, { id: "large", label: tr("Large") }, { id: "extraLarge", label: tr("Extra Large") }]
        elements.push({ kind: "radioTile", id: option.id, label: option.label, selected: option.id = size })
    end for
    OpenBrowseSheet(elements, "onPosterSizePicked", m.settingsButton)
end sub

' The cards are bound again at the new size, keeping the one in focus
sub onPosterSizePicked(event as object)
    size = event.getData()
    CloseBrowseSheet()
    if size = PosterSize() then return
    set_user_setting(SEERR_POSTER_SIZE_SETTING, size)
    applyPosterSize()

    focused = m.mediaGrid.itemFocused
    nodes = m.mediaGrid.content.getChildren(-1, 0)
    for each node in nodes
        node.posterSize = m.posterSize
    end for
    content = CreateObject("roSGNode", "ContentNode")
    content.appendChildren(nodes)
    m.mediaGrid.content = content
    if focused >= 0 and focused < nodes.count() then m.mediaGrid.jumpToItem = focused
end sub

' ===== Sort and filter =====

sub ShowSortDialog()
    OpenBrowseSheet(OptionElements(tr("Sort By"), m.sortOptions, m.currentSortBy), "onSortPicked", m.sortButton)
end sub

sub ShowFilterDialog()
    OpenBrowseSheet(OptionElements(tr("Filter"), m.filterOptions, m.currentFilter), "onFilterPicked", m.filterButton)
end sub

function OptionElements(title as string, options as object, current as string) as object
    elements = [{ kind: "heading", text: title }, { kind: "divider", color: "#FFFFFF14" }]
    for each option in options
        elements.push({ kind: "radioTile", id: option.value, label: option.label, selected: option.value = current })
    end for
    return elements
end function

sub onSortPicked(event as object)
    value = event.getData()
    CloseBrowseSheet()
    if value = m.currentSortBy then return
    m.currentSortBy = value
    Reload()
end sub

sub onFilterPicked(event as object)
    value = event.getData()
    CloseBrowseSheet()
    if value = m.currentFilter then return
    m.currentFilter = value
    Reload()
end sub

sub Reload()
    m.currentPage = 1
    m.hasMorePages = true
    ' A fresh node, since the grid keeps its old rows otherwise
    m.mediaGrid.content = CreateObject("roSGNode", "ContentNode")
    LoadContent()
end sub

sub OpenBrowseSheet(elements as object, callback as string, returnFocus as object)
    CloseBrowseSheet()
    m.browseSheet = CreateObject("roSGNode", "SeerrSheet")
    m.browseSheet.variant = "browse"
    m.browseSheet.elements = elements
    m.browseSheet.observeField("activated", callback)
    m.browseSheet.observeField("closed", "CloseBrowseSheet")
    m.browseReturn = returnFocus
    m.top.getScene().appendChild(m.browseSheet)
    m.browseSheet.callFunc("render")
    m.browseSheet.setFocus(true)
end sub

sub CloseBrowseSheet()
    if not isValid(m.browseSheet) then return
    m.browseSheet.unobserveField("activated")
    m.browseSheet.unobserveField("closed")
    m.browseReturn.setFocus(true)
    m.top.getScene().removeChild(m.browseSheet)
    m.browseSheet = invalid
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    buttons = toolbarButtons()
    at = -1
    for i = 0 to buttons.count() - 1
        if buttons[i].hasFocus() then at = i
    end for

    if at >= 0
        if key = "left" or key = "right"
            if key = "left" and at > 0 then buttons[at - 1].setFocus(true)
            if key = "right" and at < buttons.count() - 1 then buttons[at + 1].setFocus(true)
            return true
        end if
        if key = "down" and m.mediaGrid.content.getChildCount() > 0
            m.mediaGrid.setFocus(true)
            return true
        end if
        if key = "up"
            m.top.lastFocus = buttons[at]
            return FocusNav(m.top)
        end if
    else if m.mediaGrid.hasFocus()
        ' Right off the last column or up off the top row reaches the toolbar
        columns = m.mediaGrid.numColumns
        focused = m.mediaGrid.itemFocused
        if (key = "right" and focused mod columns = columns - 1) or (key = "up" and focused < columns)
            buttons[0].setFocus(true)
            return true
        end if
    end if

    if key = "back"
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

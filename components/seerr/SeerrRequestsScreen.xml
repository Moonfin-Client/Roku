<?xml version="1.0" encoding="utf-8"?>
<!-- What has been asked for and what has been reported, the two tabs the other clients put
     on one screen -->
<component name="SeerrRequestsScreen" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="#111827" />

    <Label id="titleLabel" font="font:LargeBoldSystemFont" color="#FFFFFF" translation="[96, 56]" />

    <DetailTabBar id="tabBar" translation="[96, 130]" />
    <DetailTabBar id="filterBar" translation="[96, 214]" />

    <MarkupGrid id="requestGrid"
      translation="[96, 280]"
      itemComponentName="SeerrRequestTile"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="floatingFocus"
      numRows="2"
      numColumns="8"
      itemSize="[176, 386]"
      itemSpacing="[20, 24]"
      visible="false" />

    <MarkupList id="issueList"
      translation="[96, 300]"
      itemComponentName="SeerrIssueRow"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="floatingFocus"
      itemSize="[1720, 176]"
      numRows="4"
      visible="false" />

    <Label id="stateLabel"
      font="font:MediumSystemFont"
      color="#D1D5DB"
      width="1720"
      horizAlign="center"
      translation="[96, 520]"
      visible="false" />

    <StandardButton id="retryButton" width="240" height="64" translation="[840, 600]" visible="false" />
  </children>

  <interface>
    <!-- requests or issues, so a caller can land on either -->
    <field id="initialTab" type="string" value="requests" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- One request in the grid: poster, what state it is in, who asked and when -->
<component name="SeerrRequestTile" extends="Group">
  <children>
    <Rectangle id="tileBg" color="#FFFFFF" opacity="0" />

    <Poster id="poster" loadDisplayMode="scaleToZoom" failedBitmapUri="" />
    <Poster id="posterFocus" uri="pkg:/images/hd_focus.9.png" visible="false" />
    <Rectangle id="stripe" />

    <Group id="typeBadge">
      <Poster id="typeFill" uri="pkg:/images/details/badgefill6.9.png" />
      <Label id="typeLabel" font="font:SmallestBoldSystemFont" color="#FFFFFF" vertAlign="center" />
    </Group>

    <Label id="title" font="font:SmallestBoldSystemFont" color="#FFFFFF" maxLines="1" />

    <!-- Fixed height, so a tile showing a progress bar keeps its neighbours in line -->
    <Group id="statusSlot">
      <SeerrStatusChip id="statusChip" />
      <Group id="progress" visible="false">
        <Label id="progressLabel" font="font:SmallestSystemFont" color="#FFFFFFB3" />
        <Rectangle id="progressTrack" color="#505050D9" />
        <Rectangle id="progressFill" color="#FFFFFF" />
      </Group>
    </Group>

    <Label id="requestedBy" font="font:SmallestSystemFont" color="#FFFFFF99" maxLines="1" />
    <Label id="requestedOn" font="font:SmallestSystemFont" color="#FFFFFF66" maxLines="1" />
  </children>

  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>

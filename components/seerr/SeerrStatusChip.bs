import "pkg:/source/utils/misc.bs"

const CHIP_HEIGHT = 34
const CHIP_PAD_X = 10

sub init()
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.labelNode = m.top.findNode("label")
end sub

sub onChipChanged()
    if not isValidAndNotEmpty(m.top.label)
        m.top.visible = false
        return
    end if

    hue = chipHue(m.top.chipColor)
    m.labelNode.text = UCase(m.top.label)
    m.labelNode.color = hue.text
    m.labelNode.height = CHIP_HEIGHT
    m.labelNode.translation = [CHIP_PAD_X, 0]

    width = m.labelNode.boundingRect().width + (CHIP_PAD_X * 2)
    for each layer in [m.fill, m.border]
        layer.width = width
        layer.height = CHIP_HEIGHT
    end for
    m.fill.blendColor = hue.fill
    m.border.blendColor = hue.border

    m.top.visible = true
end sub

function chipHue(name as string) as object
    if name = "pending" then return { text: "#FBF1D3", border: "#EAB308", fill: "#EAB308CC" }
    if name = "requested" then return { text: "#EAEAFE", border: "#8B8DFA", fill: "#8B8DFACC" }
    if name = "available" then return { text: "#D7F5E2", border: "#22C55E", fill: "#22C55ECC" }
    if name = "error" then return { text: "#FCDDDD", border: "#EF4444", fill: "#EF4444CC" }

    return { text: "#D1EFF9", border: "#00A4DC", fill: "#00A4DCCC" }
end function

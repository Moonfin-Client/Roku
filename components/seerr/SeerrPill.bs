import "pkg:/source/utils/misc.bs"

' Core's pill on a 1080p screen
const PILL_HEIGHT = 60
const PILL_PAD_X = 23
const ICON_SIZE = 30
const ICON_GAP = 10
const TEXT_SIZE = 23
const CHIP_TEXT_SIZE = 19
const CHIP_PAD_X = 10
const CHIP_HEIGHT = 27
const FOCUS_SCALE = 1.05

sub init()
    m.body = m.top.findNode("body")
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.icon = m.top.findNode("icon")
    m.label = m.top.findNode("label")
    m.chip = m.top.findNode("chip")
    m.chipFill = m.top.findNode("chipFill")
    m.chipLabel = m.top.findNode("chipLabel")
    m.label.font = fontOfSize(TEXT_SIZE, false)
    m.chipLabel.font = fontOfSize(CHIP_TEXT_SIZE, true)
    layoutPill()
end sub

function textWidth(label as object) as integer
    label.width = 0
    label.height = 0
    return Int(label.boundingRect().width + 0.5)
end function

sub layoutPill()
    if not isValid(m.label) then return
    x = PILL_PAD_X
    m.icon.uri = m.top.iconUri
    m.icon.visible = isValidAndNotEmpty(m.top.iconUri)
    if m.icon.visible
        m.icon.width = ICON_SIZE
        m.icon.height = ICON_SIZE
        m.icon.translation = [x, (PILL_HEIGHT - ICON_SIZE) / 2]
        x += ICON_SIZE + ICON_GAP
    end if

    m.label.text = m.top.text
    labelWidth = textWidth(m.label)
    m.label.translation = [x, 0]
    m.label.width = labelWidth
    m.label.height = PILL_HEIGHT
    x += labelWidth

    m.chip.visible = m.top.count > 0
    if m.chip.visible
        x += ICON_GAP
        m.chipLabel.text = m.top.count.ToStr()
        chipWidth = textWidth(m.chipLabel) + CHIP_PAD_X * 2
        if chipWidth < CHIP_HEIGHT then chipWidth = CHIP_HEIGHT
        m.chipFill.width = chipWidth
        m.chipFill.height = CHIP_HEIGHT
        m.chipFill.blendColor = m.top.accent
        m.chipLabel.width = chipWidth
        m.chipLabel.height = CHIP_HEIGHT
        m.chip.translation = [x, (PILL_HEIGHT - CHIP_HEIGHT) / 2]
        x += chipWidth
    end if

    width = x + PILL_PAD_X
    for each layer in [m.fill, m.border]
        layer.width = width
        layer.height = PILL_HEIGHT
    end for
    m.body.scaleRotateCenter = [width / 2, PILL_HEIGHT / 2]
    m.top.pillWidth = width
end sub

sub showFocus()
    if not isValid(m.body) then return
    focused = m.top.focused
    scaled = focused ? FOCUS_SCALE : 1.0
    m.body.scale = [scaled, scaled]
    m.border.blendColor = focused ? m.top.focusColor : "#FFFFFF3D"
end sub

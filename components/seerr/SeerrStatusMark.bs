import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrStatusPills.bs"
import "pkg:/source/utils/themeChrome.bs"

const BANNER_FONT_SIZE = 17
const BANNER_MIN_FONT_SIZE = 9
const BANNER_PAD = 10

sub init()
    m.fill = m.top.findNode("fill")
    m.label = m.top.findNode("label")
    m.dot = m.top.findNode("dot")
    m.dotShadow = m.top.findNode("dotShadow")
    m.dotOuter = m.top.findNode("dotOuter")
    m.dotInner = m.top.findNode("dotInner")
    m.dotGlyph = m.top.findNode("dotGlyph")
end sub

' A new mark is given its style and width before its status, so it draws once, when the status comes
sub redraw()
    if m.top.status < 0 then return
    isBanner = m.top.markStyle = "banner"
    m.fill.visible = isBanner
    m.label.visible = isBanner
    m.dot.visible = not isBanner
    themeSettings = themeChrome.UserSettings()
    if isBanner
        drawBanner(m.top.status, themeSettings)
    else
        drawDot(m.top.status, themeSettings)
    end if
end sub

sub drawBanner(status as integer, themeSettings as dynamic)
    width = m.top.bannerWidth
    m.fill.width = width
    m.fill.height = SEERR_BANNER_HEIGHT
    m.fill.blendColor = markColor(status, themeSettings)
    ' Light text would wash out on Pending's yellow
    m.label.color = (status = SEERR_MEDIA_PENDING) ? "#000000" : "#FFFFFF"

    ' A long status shrinks to fit the poster rather than running off it
    m.label.font.size = BANNER_FONT_SIZE
    m.label.width = 0
    m.label.height = 0
    m.label.text = UCase(seerrStatusPills.TrackPill(status, false).text)
    room = width - BANNER_PAD * 2
    textWidth = m.label.boundingRect().width
    if room > 0 and textWidth > room
        fitted = Int(BANNER_FONT_SIZE * room / textWidth)
        if fitted < BANNER_MIN_FONT_SIZE then fitted = BANNER_MIN_FONT_SIZE
        m.label.font.size = fitted
    end if
    m.label.translation = [BANNER_PAD, 0]
    m.label.width = room
    m.label.height = SEERR_BANNER_HEIGHT
end sub

' Seerr's dot: a check once it's in, a filled dash part way, and a clock while it's on its way
sub drawDot(status as integer, themeSettings as dynamic)
    dotSize = SEERR_DOT_SIZE
    color = markColor(status, themeSettings)
    m.dot.translation = [m.top.bannerWidth - SEERR_DOT_EDGE - dotSize, SEERR_DOT_EDGE]
    for each layer in [m.dotShadow, m.dotOuter]
        layer.width = dotSize
        layer.height = dotSize
    end for
    m.dotShadow.translation = [0, 2]
    m.dotOuter.blendColor = color
    ' Core fills the dot in the theme's badge ink and draws the check and ring in the status colour
    onBadge = themeChrome.Token("onBadge", "#FFFFFF", themeSettings)

    partial = status = SEERR_MEDIA_PARTIAL
    ring = dotSize * 0.075
    m.dotInner.visible = not partial
    m.dotInner.blendColor = onBadge
    m.dotInner.translation = [ring, ring]
    m.dotInner.width = dotSize - ring * 2
    m.dotInner.height = dotSize - ring * 2

    glyph = "schedule_rounded"
    glyphSize = dotSize * 0.6
    m.dotGlyph.blendColor = color
    if status = SEERR_MEDIA_AVAILABLE then glyph = "check_rounded"
    if partial
        glyph = "remove_rounded"
        glyphSize = dotSize * 0.65
        m.dotGlyph.blendColor = onBadge
    end if
    m.dotGlyph.uri = `pkg:/images/icons/${glyph}.webp`
    m.dotGlyph.width = glyphSize
    m.dotGlyph.height = glyphSize
    m.dotGlyph.translation = [(dotSize - glyphSize) / 2, (dotSize - glyphSize) / 2]
end sub

' The colors Seerr's dot uses, green once a title is in, in part or in full, from the theme as in Core
function markColor(status as integer, themeSettings as dynamic) as string
    if status = SEERR_MEDIA_PROCESSING then return themeChrome.Token("statusRequested", "#9333EA", themeSettings)
    if status = SEERR_MEDIA_PENDING then return themeChrome.Token("statusPending", "#EAB308", themeSettings)
    return themeChrome.Token("statusAvailable", "#22C55E", themeSettings)
end function

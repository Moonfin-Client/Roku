import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const TILE_WIDTH = 176
const TILE_PAD = 8
const POSTER_WIDTH = 160
const POSTER_HEIGHT = 240
const STRIPE_HEIGHT = 6
const CAPTION_TOP = 258
const TITLE_HEIGHT = 30
const STATUS_SLOT_HEIGHT = 38
const BY_HEIGHT = 26
' The requester and date lines sit a step under the title
const CAPTION_FONT = 22
const BADGE_HEIGHT = 24
const BADGE_PAD_X = 8
' The round buttons at the foot of the poster
const ACTION_SIZE = 42
const ACTION_ICON = 25
const ACTION_INSET = 9
const ACTION_BOTTOM = 15

sub init()
    m.tileBg = m.top.findNode("tileBg")
    m.poster = m.top.findNode("poster")
    m.posterFocus = m.top.findNode("posterFocus")
    m.stripe = m.top.findNode("stripe")
    m.typeBadge = m.top.findNode("typeBadge")
    m.typeFill = m.top.findNode("typeFill")
    m.typeLabel = m.top.findNode("typeLabel")
    m.title = m.top.findNode("title")
    m.statusChip = m.top.findNode("statusChip")
    m.progress = m.top.findNode("progress")
    m.progressLabel = m.top.findNode("progressLabel")
    m.progressTrack = m.top.findNode("progressTrack")
    m.progressFill = m.top.findNode("progressFill")
    m.requestedBy = m.top.findNode("requestedBy")
    m.requester = m.top.findNode("requester")
    m.requestedOn = m.top.findNode("requestedOn")
    m.actions = m.top.findNode("actions")
    m.actions.translation = [TILE_PAD, TILE_PAD]
    m.glyphFont = CreateObject("roSGNode", "Font")
    m.glyphFont.uri = settingsGlyphs.FONT_URI
    m.glyphFont.size = ACTION_ICON
    m.buttons = []
    m.shown = invalid
    for each label in [m.requestedBy, m.requester, m.requestedOn]
        label.font.size = CAPTION_FONT
    end for

    layout()
end sub

sub layout(split = false as boolean)
    m.tileBg.width = TILE_WIDTH
    m.tileBg.height = TileHeight() + (split ? BY_HEIGHT : 0)

    m.poster.width = POSTER_WIDTH
    m.poster.height = POSTER_HEIGHT
    m.poster.translation = [TILE_PAD, TILE_PAD]

    for each layer in [m.posterFocus, m.stripe]
        layer.width = POSTER_WIDTH
    end for
    m.posterFocus.height = POSTER_HEIGHT
    m.posterFocus.translation = [TILE_PAD, TILE_PAD]
    m.stripe.height = STRIPE_HEIGHT
    m.stripe.translation = [TILE_PAD, TILE_PAD + POSTER_HEIGHT - STRIPE_HEIGHT]

    m.typeBadge.translation = [TILE_PAD + 10, TILE_PAD + 10]
    m.typeLabel.height = BADGE_HEIGHT
    m.typeLabel.translation = [BADGE_PAD_X, 0]
    m.typeFill.height = BADGE_HEIGHT

    m.title.width = POSTER_WIDTH
    m.title.translation = [TILE_PAD, CAPTION_TOP]

    m.top.findNode("statusSlot").translation = [TILE_PAD, CAPTION_TOP + TITLE_HEIGHT]

    m.progressLabel.width = POSTER_WIDTH
    m.progressTrack.width = POSTER_WIDTH
    m.progressTrack.height = 6
    m.progressTrack.translation = [0, 26]
    m.progressFill.height = 6
    m.progressFill.translation = [0, 26]

    m.requestedBy.width = POSTER_WIDTH
    m.requestedBy.translation = [TILE_PAD, CAPTION_TOP + TITLE_HEIGHT + STATUS_SLOT_HEIGHT]

    m.requester.width = POSTER_WIDTH
    m.requester.translation = [TILE_PAD, CAPTION_TOP + TITLE_HEIGHT + STATUS_SLOT_HEIGHT + BY_HEIGHT]
    m.requester.visible = split

    m.requestedOn.width = POSTER_WIDTH
    m.requestedOn.translation = [TILE_PAD, CAPTION_TOP + TITLE_HEIGHT + STATUS_SLOT_HEIGHT + BY_HEIGHT * (split ? 2 : 1)]
end sub

function TileHeight() as integer
    return CAPTION_TOP + TITLE_HEIGHT + STATUS_SLOT_HEIGHT + BY_HEIGHT + 26 + TILE_PAD
end function

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    request = content.request
    if not isValid(request) then return

    ' The grid binds the same node again when its focus fields change, which only needs a redraw
    if isValid(m.shown) and m.shown.isSameNode(content)
        showFocus()
        return
    end if
    m.shown = content

    media = request.media
    m.poster.uri = SeerrPosterUrl(media, "w342")

    m.title.text = SeerrMediaTitle(media)
    applyTypeBadge(request, media)
    applyStatus(request)

    ' The name goes under its own label only when the screen found one too long for the line
    who = SeerrRequesterName(request)
    layout(content.splitRequester)
    if content.splitRequester
        m.requestedBy.text = tr("Requested by")
        m.requester.text = who
    else
        m.requestedBy.text = Substitute(tr("Requested by ^0"), who)
    end if
    m.requestedOn.text = SeerrFormatDate(request.createdAt)

    buildActions(content.actions ?? [])
    showFocus()
end sub

' Two buttons sit at either side of the poster, a lone one at the left
sub buildActions(actions as object)
    m.actions.removeChildrenIndex(m.actions.getChildCount(), 0)
    m.buttons = []
    for i = 0 to actions.count() - 1
        style = actionStyle(actions[i])
        x = ACTION_INSET
        if i > 0 then x = POSTER_WIDTH - ACTION_INSET - ACTION_SIZE
        button = m.actions.createChild("Group")
        button.translation = [x, POSTER_HEIGHT - ACTION_BOTTOM - ACTION_SIZE]
        button.scaleRotateCenter = [ACTION_SIZE / 2, ACTION_SIZE / 2]
        fill = button.createChild("Poster")
        fill.uri = "pkg:/images/icons/circle.webp"
        fill.width = ACTION_SIZE
        fill.height = ACTION_SIZE
        fill.blendColor = "#000000B3"
        ring = button.createChild("Poster")
        ring.uri = "pkg:/images/seerr/ring56w3.png"
        ring.width = ACTION_SIZE
        ring.height = ACTION_SIZE
        ring.blendColor = style.color
        ring.visible = false
        glyph = button.createChild("Label")
        glyph.font = m.glyphFont
        glyph.text = settingsGlyphs.Char(style.glyph)
        glyph.color = style.color
        glyph.width = ACTION_SIZE
        glyph.height = ACTION_SIZE
        glyph.horizAlign = "center"
        glyph.vertAlign = "center"
        m.buttons.push({ group: button, ring: ring })
    end for
end sub

function actionStyle(action as string) as object
    if action = "approve" then return { glyph: "check_circle_outline", color: "#22C55E" }
    if action = "decline" then return { glyph: "highlight_off", color: "#EF4444" }
    if action = "retry" then return { glyph: "refresh", color: "#EAB308" }
    return { glyph: "close", color: "#FFFFFF" }
end function

sub applyTypeBadge(request as object, media as object)
    isSeries = isStringEqual(chainLookupReturn(media, "mediaType", "movie"), "tv")

    label = isSeries ? tr("Series") : tr("Movie")
    if request.is4k = true then label += " · 4K"

    m.typeLabel.width = 0
    m.typeLabel.text = UCase(label)
    width = m.typeLabel.boundingRect().width + (BADGE_PAD_X * 2)
    m.typeLabel.width = width
    m.typeFill.width = width
    m.typeFill.blendColor = isSeries ? "#8B5CF6D9" : "#3B82F6D9"
end sub

' A download in flight takes the slot the state pill would have used
sub applyStatus(request as object)
    info = SeerrRequestStatusInfo(request)
    m.stripe.color = stripeColor(info.color)

    summary = SeerrRequestDownloadSummary(request)
    if isValid(summary)
        m.statusChip.visible = false
        m.progress.visible = true

        if summary.isImporting
            m.progressLabel.text = tr("Importing")
        else
            percent = Int(summary.fraction * 100)
            m.progressLabel.text = `${SeerrDownloadSizeText(summary)} · ${percent.toStr()}%`
        end if

        m.progressFill.width = Int(POSTER_WIDTH * summary.fraction)
        return
    end if

    m.progress.visible = false
    m.statusChip.chipColor = info.color
    m.statusChip.label = info.label
    m.statusChip.visible = true
end sub

function stripeColor(name as string) as string
    if name = "pending" then return "#EAB308"
    if name = "requested" then return "#8B8DFA"
    if name = "available" then return "#22C55E"
    if name = "error" then return "#EF4444"
    return "#00A4DC"
end function

' The tile shows focus while it holds it, and a button while that one does
sub showFocus()
    content = m.top.itemContent
    if not isValid(content) then return

    focused = content.lit and content.stop = 0
    m.tileBg.opacity = focused ? 0.08 : 0
    m.posterFocus.visible = focused
    for i = 0 to m.buttons.count() - 1
        on = content.lit and content.stop = i + 1
        m.buttons[i].ring.visible = on
        m.buttons[i].group.scale = on ? [1.05, 1.05] : [1, 1]
    end for
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Seerr Discover's rows. They tell the screen where focus is headed as a key is pressed,
     so a modern card moves with the press the way it does on Home. -->
<component name="SeerrDiscoveryRows" extends="RowList">
    <interface>
        <!-- Flips on an up or down press that moves to another row -->
        <field id="keyPressedNotifier" type="boolean" value="false" alwaysNotify="true" />
        <!-- [row, column] a left or right press is moving to, set before the row starts to scroll -->
        <field id="moveTarget" type="array" alwaysNotify="true" />
    </interface>
</component>

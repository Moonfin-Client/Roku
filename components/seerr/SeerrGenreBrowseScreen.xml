<?xml version="1.0" encoding="utf-8"?>
<!-- Core's Seerr browse grid: the name it was opened on, the focused title's details, the toolbar
     with the availability chips, the letter bar, the grid and a count under it -->
<component name="SeerrGenreBrowseScreen" extends="JFScreen">

    <children>
        <Rectangle width="1920" height="1080" color="#101010" />

        <Label id="genreNameLabel" width="1920" height="52" translation="[0, 20]" horizAlign="center" vertAlign="center" color="#FFFFFF" />

        <!-- The focused title with its year, score and Seerr status -->
        <Group id="hud" translation="[100, 82]">
            <Label id="itemTitle" color="#FFFFFF" width="1720" maxLines="1" translation="[0, 9]" />
            <Group id="metaRow" translation="[0, 55]">
                <Label id="metaYear" color="#FFFFFFB3" />
                <Poster id="starIcon" uri="pkg:/images/sharp_star_white_18dp.webp" blendColor="#FF9800" width="23" height="23" />
                <Label id="metaRating" color="#FFFFFFB3" />
                <Group id="statusBadge">
                    <Poster id="statusFill" uri="pkg:/images/seerr/fill7.9.png" />
                    <Label id="statusLabel" color="#FFFFFF" vertAlign="center" />
                </Group>
            </Group>
        </Group>

        <Group id="toolbar" translation="[100, 185]" />
        <StandardButton id="collectionButton" height="50" visible="false" />
        <Group id="alphaBar" translation="[100, 268]" />

        <MarkupGrid id="mediaGrid"
            itemComponentName="SeerrCard"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false"
            numRows="2" />

        <!-- Covers the grid's next row where the count sits -->
        <Rectangle translation="[0, 1040]" width="1920" height="40" color="#101010" />
        <Label id="footerFilter" translation="[100, 1040]" height="40" vertAlign="center" color="#FFFFFF4D" />
        <Label id="footerCount" translation="[100, 1040]" width="1720" height="40" horizAlign="right" vertAlign="center" color="#FFFFFF73" />

        <!-- Holds the remote on the toolbar and the letter bar, which the screen draws itself -->
        <Group id="browseFocus" focusable="true" />

        <Label id="loadingLabel"
            text="Loading..."
            font="font:LargeSystemFont"
            translation="[960, 640]"
            horizAlign="center"
            vertAlign="center"
            visible="false" />

        <Label id="errorLabel"
            text=""
            font="font:MediumSystemFont"
            translation="[100, 420]"
            width="1720"
            wrap="true"
            color="#EF4444"
            visible="false" />

        <Label id="noResultsLabel"
            text="No results found"
            font="font:MediumSystemFont"
            translation="[960, 640]"
            horizAlign="center"
            vertAlign="center"
            color="#9CA3AF"
            visible="false" />
    </children>

    <interface>
        <field id="genreId" type="integer" value="0" />
        <field id="genreName" type="string" value="" />
        <field id="mediaType" type="string" value="movie" />
        <!-- genre, network, studio, keyword, collection, or all for a whole media type -->
        <field id="browseType" type="string" value="genre" />
    </interface>

</component>

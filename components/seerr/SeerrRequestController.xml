<?xml version="1.0" encoding="utf-8"?>
<component name="SeerrRequestController" extends="Group">
  <interface>
    <field id="tmdbId" type="string" value="" />
    <field id="mediaType" type="string" value="movie" />
    <!-- The payload the host already fetched, so the flow does not ask for it again -->
    <field id="details" type="assocarray" />
    <!-- The library's name for the title, which the cancel confirm quotes. A season or episode page
         passes its series' name. -->
    <field id="itemName" type="string" value="" />
    <!-- The season and episode a season or episode page stands for, where Report Issue starts -->
    <field id="initialSeason" type="integer" value="0" />
    <field id="initialEpisode" type="integer" value="0" />
    <!-- Where focus goes once a dialog closes, since the controller draws nothing itself -->
    <field id="returnFocus" type="node" />
    <!-- Seerr now knows something new about the title, so the host refetches -->
    <field id="requestCompleted" type="boolean" value="false" alwaysNotify="true" />
    <!-- A watchlist toggle changes only the one button, so the host relabels it in place
         rather than refetching and losing the row's focus -->
    <field id="watchlistState" type="boolean" value="false" alwaysNotify="true" />
    <function name="begin" />
  </interface>
</component>

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

const ROW_WIDTH = 1720
const ROW_HEIGHT = 168
const ROW_PAD = 24
const POSTER_WIDTH = 80
const POSTER_HEIGHT = 120

sub init()
    m.rowBg = m.top.findNode("rowBg")
    m.rowFocus = m.top.findNode("rowFocus")
    m.poster = m.top.findNode("poster")
    m.title = m.top.findNode("title")
    m.meta = m.top.findNode("meta")
    m.statusChip = m.top.findNode("statusChip")
    m.byline = m.top.findNode("byline")

    for each layer in [m.rowBg, m.rowFocus]
        layer.width = ROW_WIDTH
        layer.height = ROW_HEIGHT
    end for

    m.poster.width = POSTER_WIDTH
    m.poster.height = POSTER_HEIGHT
    m.poster.translation = [ROW_PAD, (ROW_HEIGHT - POSTER_HEIGHT) / 2]
end sub

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    issue = content.issue
    if not isValid(issue) then return

    media = issue.media
    posterUrl = SeerrPosterUrl(media, "w185")
    m.poster.uri = posterUrl
    m.poster.visible = isValidAndNotEmpty(posterUrl)

    ' Without artwork the text takes the space the poster would have had
    textLeft = m.poster.visible ? ROW_PAD + POSTER_WIDTH + ROW_PAD : ROW_PAD

    m.title.text = SeerrMediaTitle(media)
    m.title.width = ROW_WIDTH - textLeft - ROW_PAD
    m.title.translation = [textLeft, 34]

    m.meta.text = metaLine(issue)
    m.meta.translation = [textLeft, 80]

    info = SeerrIssueStatusInfo(issue)
    m.statusChip.chipColor = info.color
    m.statusChip.label = info.label
    m.statusChip.translation = [textLeft + m.meta.boundingRect().width + 24, 76]

    m.byline.text = byLine(issue)
    m.byline.width = ROW_WIDTH - textLeft - ROW_PAD
    m.byline.translation = [textLeft, 122]
end sub

' The kind of problem, then which season or episode it is about, then how many replies it has
function metaLine(issue as object) as string
    line = SeerrIssueTypeLabel(chainLookupReturn(issue, "issueType", 4))

    season = chainLookupReturn(issue, "problemSeason", 0)
    episode = chainLookupReturn(issue, "problemEpisode", 0)
    if isValid(season) and season > 0
        if isValid(episode) and episode > 0
            line += ` · S${season.toStr()} E${episode.toStr()}`
        else
            line += ` · ${tr("Season")} ${season.toStr()}`
        end if
    end if

    ' The first comment is the issue itself, so it is not a reply
    replies = 0
    comments = chainLookupReturn(issue, "comments", invalid)
    if isValid(comments) and type(comments) = "roArray" then replies = comments.count() - 1
    if replies > 0 then line += Substitute(tr(" · ^0 comments"), replies.toStr())

    return line
end function

function byLine(issue as object) as string
    who = chainLookupReturn(issue, "createdBy.displayName", "")
    if isValidAndNotEmpty(who) then return Substitute(tr("Reported by ^0"), who)

    return SeerrFormatDate(issue.createdAt)
end function

sub onFocusChanged()
    focused = m.top.focusPercent > 0.5 and m.top.itemHasFocus

    m.rowBg.opacity = focused ? 0.15 : 0.05
    m.rowFocus.visible = focused
end sub

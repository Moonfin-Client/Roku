<?xml version="1.0" encoding="utf-8"?>
<!-- One issue and everything said about it, in the same panel as the request dialog -->
<component name="SeerrIssueThread" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="rowMenu"
        itemComponentName="TrackListItem"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <field id="issue" type="assocarray" />
    <field id="canManage" type="boolean" value="false" />
    <field id="seerrUserId" type="integer" value="0" />

    <!-- Where focus goes when the thread closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />

    <!-- The issue as it now stands, or { deleted: true } when it has gone -->
    <field id="issueChanged" type="assocarray" alwaysNotify="true" />

    <function name="showThread" />
  </interface>
</component>

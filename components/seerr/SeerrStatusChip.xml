<?xml version="1.0" encoding="utf-8"?>
<!-- The uppercase state pill the request tiles and issue rows share -->
<component name="SeerrStatusChip" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/details/badgefill6.9.png" />
    <Poster id="border" uri="pkg:/images/details/outline6.9.png" />
    <Label id="label" font="font:SmallestBoldSystemFont" vertAlign="center" />
  </children>

  <interface>
    <field id="label" type="string" onChange="onChipChanged" />
    <!-- pending, requested, available, error or approved -->
    <field id="chipColor" type="string" value="approved" onChange="onChipChanged" />
  </interface>
</component>

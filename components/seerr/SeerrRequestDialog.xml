<?xml version="1.0" encoding="utf-8"?>
<!-- The sheet a request goes through: the quality track, the seasons, the server overrides and the
     quota, with Cancel and Submit Request at the bottom -->
<component name="SeerrRequestDialog" extends="Group">
  <children>
    <SeerrSheet id="sheet" />
  </children>

  <interface>
    <field id="details" type="assocarray" />
    <field id="mediaType" type="string" value="movie" />
    <field id="is4k" type="boolean" value="false" />
    <!-- Whether the caller offers both tracks, so the sheet carries the 4K switch -->
    <field id="qualityToggle" type="boolean" value="false" />
    <field id="canRequest4k" type="boolean" value="false" />
    <field id="canRequestAdvanced" type="boolean" value="false" />
    <field id="seerrUserId" type="integer" value="0" />
    <!-- A collection's films, which turns the sheet into the one that requests several at once
         and sends them itself, with the counts left in result -->
    <field id="parts" type="array" />

    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />

    <field id="result" type="assocarray" />
    <field id="submitted" type="boolean" value="false" alwaysNotify="true" />
    <field id="wasCancelled" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
  </interface>
</component>

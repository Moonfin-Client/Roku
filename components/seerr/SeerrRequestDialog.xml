<?xml version="1.0" encoding="utf-8"?>
<!-- The one dialog a request goes through, in the same panel as the track pickers:
     quality, seasons, advanced options and the quota all in one list -->
<component name="SeerrRequestDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <!-- The panel is placed and sized around however many rows there are -->
    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="rowMenu"
        itemComponentName="TrackListItem"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <field id="details" type="assocarray" />
    <field id="mediaType" type="string" value="movie" />
    <field id="is4k" type="boolean" value="false" />
    <!-- Whether the caller offers both tracks, so the panel carries the 4K row -->
    <field id="qualityToggle" type="boolean" value="false" />
    <field id="canRequest4k" type="boolean" value="false" />
    <field id="canRequestAdvanced" type="boolean" value="false" />
    <field id="seerrUserId" type="integer" value="0" />

    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />

    <field id="result" type="assocarray" />
    <field id="submitted" type="boolean" value="false" alwaysNotify="true" />
    <field id="wasCancelled" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
  </interface>
</component>

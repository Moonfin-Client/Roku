import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"

' The row list moves focus itself, so this only reports where it's going and lets it through
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    focused = m.top.rowItemFocused
    if not isValid(focused) or focused.count() < 2 or not isValid(m.top.content) then return false

    currentRow = focused[0]
    rowCount = m.top.content.getChildCount()
    if currentRow < 0 or currentRow >= rowCount then return false

    if key = KeyCode.UP or key = KeyCode.DOWN
        ' A press that can't reach a row with something in it doesn't move, so the card stays up
        if rowWithItemsToward(currentRow, key = KeyCode.DOWN) then m.top.keyPressedNotifier = not m.top.keyPressedNotifier
    else if key = KeyCode.LEFT or key = KeyCode.RIGHT
        targetCol = focused[1] + 1
        if key = KeyCode.LEFT then targetCol = focused[1] - 1
        if targetCol >= 0 and targetCol < m.top.content.getChild(currentRow).getChildCount()
            m.top.moveTarget = [currentRow, targetCol]
        end if
    end if

    return false
end function

' A row still loading, or one that came back empty, is passed over
function rowWithItemsToward(currentRow as integer, downward as boolean) as boolean
    rowCount = m.top.content.getChildCount()
    rowStep = -1
    if downward then rowStep = 1

    rowIndex = currentRow + rowStep
    while rowIndex >= 0 and rowIndex < rowCount
        if m.top.content.getChild(rowIndex).getChildCount() > 0 then return true
        rowIndex += rowStep
    end while
    return false
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- Core's Seerr card for Discover's rows and the browse grid: a poster with its title and a line
     under it, or a shortcut, genre or logo tile. The content node says which, and how it shows
     focus. -->
<component name="SeerrCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="focusPercent" type="float" onChange="showFocus" />
    <field id="itemHasFocus" type="boolean" onChange="showFocus" />
  </interface>

  <children>
    <!-- The browse grid pads its cards so a grown one stays inside the grid, which clips -->
    <Group id="insetGroup">
      <!-- Discover's modern rows slide this aside to make room for the focused card -->
      <Group id="shiftGroup">
        <Group id="artGroup">
          <Poster id="ring" uri="pkg:/images/seerr/ring21w5.9.png" opacity="0" />
          <ScreenMask id="artMask">
            <Poster id="placeholder" uri="pkg:/images/white.webp" blendColor="#252525" />
            <Poster id="art" loadDisplayMode="scaleToZoom" />
            <Poster id="shade" uri="pkg:/images/seerr/tileShade.webp" visible="false" />
            <Poster id="veil" uri="pkg:/images/white.webp" blendColor="#000000" opacity="0.3" visible="false" />
            <!-- A plain fill, since the mask rounds it and a 9-patch breaks up under a scaled mask -->
            <Poster id="logoFill" uri="pkg:/images/white.webp" blendColor="#1A1A1A" visible="false" />
            <Poster id="logo" loadDisplayMode="scaleToFit" visible="false" />
            <Group id="mediaBadge" visible="false">
              <Poster id="mediaBadgeFill" uri="pkg:/images/seerr/fill7.9.png" opacity="0.85" />
              <Label id="mediaBadgeLabel" color="#FFFFFF" vertAlign="center" />
            </Group>
          </ScreenMask>
          <Label id="tileLabel" color="#FFFFFF" maxLines="1" visible="false" />
          <Label id="tileIcon" color="#FFFFFF" horizAlign="center" vertAlign="center" visible="false" />
          <Poster id="tileIconImage" visible="false" />
          <Poster id="tileBorder" uri="pkg:/images/seerr/stroke13w3.9.png" opacity="0" />
        </Group>
        <Label id="title" color="#FFFFFF" maxLines="1" />
        <Label id="subtitle" color="#FFFFFF99" maxLines="1" />
      </Group>
    </Group>

    <!-- Matches modernShiftAnim in HomeItem.xml, so Discover's rows move the way Home's do -->
    <Animation id="modernShiftAnim" duration="0.2" repeat="false" easeFunction="outExpo">
      <Vector2DFieldInterpolator id="modernShiftInterp" key="[0.0, 1.0]" fieldToInterp="shiftGroup.translation" />
      <FloatFieldInterpolator id="modernShiftOpacity" key="[0.0, 1.0]" fieldToInterp="shiftGroup.opacity" />
    </Animation>
  </children>
</component>

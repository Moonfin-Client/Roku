<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a Seerr dialog, carrying what TrackListItem draws plus the action the
     dialog acts on when the row is picked -->
<component name="SeerrRequestListData" extends="ContentNode">
  <interface>
    <field id="selected" type="boolean" value="false" />
    <field id="dimmed" type="boolean" value="false" />
    <field id="dividerAbove" type="boolean" value="false" />
    <field id="action" type="string" value="" />
    <field id="rowHeight" type="integer" value="0" />
    <field id="noIndicator" type="boolean" value="false" />
  </interface>
</component>

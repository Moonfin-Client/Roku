<?xml version="1.0" encoding="utf-8"?>
<component name="SeerrTagsDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="0x0000004D" />

    <Poster id="panel" uri="pkg:/images/details/surface17.9.png" blendColor="0x1A1A1AFF">
      <Label
        id="title"
        font="font:MediumBoldSystemFont"
        color="0xFFFFFFFF"
        height="36"
        translation="[32, 28]" />

      <StandardButton
        id="closeButton"
        height="44"
        fontSize="24"
        outline="true"
        outlineUri="pkg:/images/playback/outline41.9.png" />

      <Group id="sections" translation="[32, 92]" />
    </Poster>
  </children>
  <interface>
    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />
    <field id="details" type="assocarray" />
    <field id="mediaType" type="string" value="movie" />
    <function name="showDialog" />
  </interface>
</component>

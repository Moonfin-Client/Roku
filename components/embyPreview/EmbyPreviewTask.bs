import "pkg:/source/api/EmbyConnect.bs"
import "pkg:/source/utils/embyFeatures.bs"

sub init()
    m.top.functionName = "loadPreview"
end sub

sub loadPreview()
    result = { frames: [], height: 180 }
    try
        result = loadPreviewData()
    catch error
        result = { frames: [], height: 180 }
    end try
    m.top.result = result
end sub

function loadPreviewData() as object
    server = m.top.server
    params = { Width: 320 }
    if m.top.mediaSourceId <> "" then params.MediaSourceId = m.top.mediaSourceId
    url = buildURLForServer(server.serverUrl, "Items/" + m.top.itemId + "/ThumbnailSet", params)
    response = embyConnect.Request(url, "GET", "", { "X-Emby-Authorization": buildAuthHeaderForServer(server) })
    return embyFeatures.PreviewData(response.data, server, m.top.itemId, m.top.mediaSourceId)
end function

import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/detailSectionLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' A person's dates and filmography, shared by the person screen and the Nouveau details screen.

' Dates are read off the string, because roDateTime localizes on parse and shifts the day for
' anyone west of UTC
function formatPersonDate(value as dynamic) as string
    if not isValidAndNotEmpty(value) then return ""

    parts = Left(value, 10).split("-")
    if parts.count() <> 3 then return value

    month = parts[1].toInt()
    if month < 1 or month > 12 then return value

    monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    return `${tr(monthNames[month - 1])} ${parts[2].toInt()}, ${parts[0].toInt()}`
end function

' Whole years to today on the viewer's own calendar, one fewer until this year's birthday has
' come round
function personAge(birthValue as dynamic) as integer
    if not isValidAndNotEmpty(birthValue) then return 0

    birthParts = Left(birthValue, 10).split("-")
    if birthParts.count() <> 3 then return 0

    today = CreateObject("roDateTime")
    today.ToLocalTime()
    endYear = today.GetYear()
    endMonth = today.GetMonth()
    endDay = today.GetDayOfMonth()

    birthMonth = birthParts[1].toInt()
    age = endYear - birthParts[0].toInt()
    if endMonth < birthMonth or (endMonth = birthMonth and endDay < birthParts[2].toInt()) then age -= 1
    if age <= 0 then return 0
    return age
end function

' Born, then either the date they died or how old they are now, then where they were born
function personMetaParts(itemData as object) as object
    parts = []
    premiereDate = chainLookupReturn(itemData, "PremiereDate", "")
    born = formatPersonDate(premiereDate)
    if born <> "" then parts.push(tr("Born") + " " + born)

    died = formatPersonDate(chainLookupReturn(itemData, "EndDate", ""))
    if died <> ""
        parts.push(tr("Died") + " " + died)
    else if born <> ""
        age = personAge(premiereDate)
        if age > 0 then parts.push(tr("Age") + " " + age.toStr())
    end if

    birthPlace = chainLookupReturn(itemData, "ProductionLocations", invalid)
    if type(birthPlace) = "roArray" and birthPlace.count() > 0
        birthPlace = birthPlace[0]
    else
        birthPlace = chainLookupReturn(itemData, "placeOfBirth", invalid)
    end if
    if isValidAndNotEmpty(birthPlace) and detailSectionLayout.Shows("birthplace") then parts.push(birthPlace)

    return parts
end function

' The filmography comes back as one list, and each kind of work gets its own group. An episode
' of a series the person is billed on is already covered by that series, so only the rest count
' as a guest appearance. Guest appearances and music videos each have a switch, and a hidden one
' comes back empty.
function personPageSortOption() as string
    return chainLookupReturn(m.global.session, "user.settings.`ui.person.sortOption`", "alphabetical")
end function

function personPageGroupItems() as boolean
    return chainLookupReturn(m.global.session, "user.settings.`ui.person.groupItems`", false) = true
end function

' Sorts credit nodes or raw item AAs by alphabetical title, release date descending, or release date ascending.
' Items missing a date sink to the bottom in both date sort modes.
function sortPersonItems(items as object, sortOption = invalid as dynamic) as object
    if not isValidAndNotEmpty(items) or items.count() <= 1 then return items

    effectiveSort = isValidAndNotEmpty(sortOption) ? sortOption : personPageSortOption()

    decorated = []
    for each item in items
        itemJson = isValid(item.json) ? item.json : item
        title = LCase(chainLookupReturn(itemJson, "Name", chainLookupReturn(itemJson, "name", chainLookupReturn(itemJson, "title", chainLookupReturn(itemJson, "Title", "")))))

        dateStr = chainLookupReturn(itemJson, "PremiereDate", "")
        if dateStr = "" then dateStr = chainLookupReturn(itemJson, "releaseDate", "")
        if dateStr = "" then dateStr = chainLookupReturn(itemJson, "firstAirDate", "")
        if dateStr = "" and isValid(itemJson.ProductionYear) and itemJson.ProductionYear > 0
            dateStr = itemJson.ProductionYear.toStr() + "-01-01"
        end if
        if dateStr.len() >= 10 then dateStr = Left(dateStr, 10)

        decorated.push({
            item: item,
            title: title,
            date: dateStr
        })
    end for

    if effectiveSort = "releaseDateAsc"
        decorated.SortBy("title")
        decorated.SortBy("date")
        withDate = []
        withoutDate = []
        for each entry in decorated
            if entry.date <> "" then withDate.push(entry.item) else withoutDate.push(entry.item)
        end for
        sorted = []
        sorted.Append(withDate)
        sorted.Append(withoutDate)
        return sorted
    else if effectiveSort = "releaseDateDesc"
        decorated.SortBy("title")
        decorated.SortBy("date", "r")
        withDate = []
        withoutDate = []
        for each entry in decorated
            if entry.date <> "" then withDate.push(entry.item) else withoutDate.push(entry.item)
        end for
        sorted = []
        sorted.Append(withDate)
        sorted.Append(withoutDate)
        return sorted
    else
        decorated.SortBy("title")
        sorted = []
        for each entry in decorated
            sorted.push(entry.item)
        end for
        return sorted
    end if
end function

' The filmography comes back as one list, and each kind of work gets its own group. An episode
' of a series the person is billed on is already covered by that series, so only the rest count
' as a guest appearance. Guest appearances and music videos each have a switch, and a hidden one
' comes back empty.
function splitFilmography(entries as object, sortOption = invalid as dynamic) as object
    filmography = { movies: [], series: [], guest: [], music: [] }
    hidden = detailSectionLayout.HiddenIds()
    seriesIds = {}
    for each entry in entries
        if chainLookupReturn(entry, "json.Type", "") = "Series" then seriesIds[chainLookupReturn(entry, "json.Id", "")] = true
    end for

    for each entry in entries
        entryType = chainLookupReturn(entry, "json.Type", "")
        if entryType = "Movie"
            filmography.movies.push(entry)
        else if entryType = "Series"
            filmography.series.push(entry)
        else if entryType = "MusicVideo"
            if not hidden.DoesExist("musicVideos") then filmography.music.push(entry)
        else if entryType = "Episode" and not hidden.DoesExist("guestAppearances")
            seriesId = chainLookupReturn(entry, "json.SeriesId", "")
            if seriesId = "" or not seriesIds.DoesExist(seriesId) then filmography.guest.push(entry)
        end if
    end for

    effectiveSort = isValidAndNotEmpty(sortOption) ? sortOption : personPageSortOption()
    filmography.movies = sortPersonItems(filmography.movies, effectiveSort)
    filmography.series = sortPersonItems(filmography.series, effectiveSort)
    filmography.guest = sortPersonItems(filmography.guest, effectiveSort)
    filmography.music = sortPersonItems(filmography.music, effectiveSort)

    return filmography
end function

' What Seerr knows they appeared in and worked on, leaving out a list the viewer hid
function shownSeerrCredits(credits as object, group = invalid as dynamic, sortOption = invalid as dynamic) as object
    hidden = detailSectionLayout.HiddenIds()
    shown = { appearances: [], crew: [] }
    effectiveGroup = isValid(group) ? group : personPageGroupItems()
    effectiveSort = isValidAndNotEmpty(sortOption) ? sortOption : personPageSortOption()
    if not hidden.DoesExist("seerrPersonAppearances") then shown.appearances = usableSeerrCredits(credits.cast, false, effectiveGroup, effectiveSort)
    if not hidden.DoesExist("seerrPersonCrew") then shown.crew = usableSeerrCredits(credits.crew, true, effectiveGroup, effectiveSort)
    return shown
end function

' Only credits with a poster, never a crew job that is a thank you rather than work on the title,
' sorted and grouped according to user preferences.
function usableSeerrCredits(credits as object, isCrew as boolean, group = invalid as dynamic, sortOption = invalid as dynamic) as object
    list = []
    if not isValidAndNotEmpty(credits) then return list

    effectiveGroup = isValid(group) ? group : personPageGroupItems()
    effectiveSort = isValidAndNotEmpty(sortOption) ? sortOption : personPageSortOption()

    posterBase = GetTmdbImageBaseUrls().posterW342
    grouped = {}
    groupedOrder = []
    singleEntries = []

    for each credit in credits
        posterPath = credit.LookupCI("posterPath")
        if not isValidAndNotEmpty(posterPath) then continue for

        if isCrew
            job = LCase(credit.LookupCI("job") ?? "")
            if job = "thanks" or job = "special thanks" then continue for
        end if

        mediaType = LCase(credit.LookupCI("mediaType") ?? "")
        if mediaType = "" then mediaType = isValidAndNotEmpty(credit.LookupCI("title")) ? "movie" : "tv"

        rawId = credit.LookupCI("id")
        tmdbId = ""
        if isValid(rawId) then tmdbId = rawId.ToStr()
        if tmdbId = "" then continue for

        title = credit.LookupCI("title")
        if not isValidAndNotEmpty(title) then title = credit.LookupCI("name")
        if not isValidAndNotEmpty(title) then title = ""

        role = isCrew ? (credit.LookupCI("job") ?? credit.LookupCI("department") ?? "") : (credit.LookupCI("character") ?? "")
        role = role.Trim()

        if effectiveGroup
            key = mediaType + ":" + tmdbId
            if not grouped.DoesExist(key)
                grouped[key] = { credit: credit, title: title, posterPath: posterPath, roles: [], mediaType: mediaType, tmdbId: tmdbId }
                groupedOrder.push(key)
            end if
            if role <> ""
                hasRole = false
                for each r in grouped[key].roles
                    if r = role then hasRole = true: exit for
                end for
                if not hasRole then grouped[key].roles.push(role)
            end if
        else
            singleEntries.push({ credit: credit, title: title, posterPath: posterPath, role: role, mediaType: mediaType, tmdbId: tmdbId })
        end if
    end for

    if effectiveGroup
        for each key in groupedOrder
            entry = grouped[key]
            credit = entry.credit
            creditRole = entry.roles.join(", ")

            released = credit.LookupCI("releaseDate")
            if not isValidAndNotEmpty(released) then released = credit.LookupCI("firstAirDate")
            year = invalid
            if isValidAndNotEmpty(released) and released.len() >= 4 then year = released.left(4).toInt()

            credit.mediaType = entry.mediaType
            data = {
                Id: entry.tmdbId,
                name: entry.title,
                Type: entry.mediaType = "tv" ? "Series" : "Movie",
                SeerrTmdbId: entry.tmdbId,
                SeerrMediaType: entry.mediaType,
                SeerrPosterURL: posterBase + entry.posterPath,
                SeerrItem: credit
            }
            if isValid(year) and year > 0 then data.ProductionYear = year
            if isValidAndNotEmpty(creditRole)
                data.subTitle = creditRole
                data._credit = creditRole
            end if
            if isValidAndNotEmpty(released) then data.releaseDate = released

            card = createSGNode("HomeData")
            card.json = data
            list.push(card)
        end for
    else
        for each entry in singleEntries
            credit = entry.credit
            creditRole = entry.role

            released = credit.LookupCI("releaseDate")
            if not isValidAndNotEmpty(released) then released = credit.LookupCI("firstAirDate")
            year = invalid
            if isValidAndNotEmpty(released) and released.len() >= 4 then year = released.left(4).toInt()

            credit.mediaType = entry.mediaType
            data = {
                Id: entry.tmdbId,
                name: entry.title,
                Type: entry.mediaType = "tv" ? "Series" : "Movie",
                SeerrTmdbId: entry.tmdbId,
                SeerrMediaType: entry.mediaType,
                SeerrPosterURL: posterBase + entry.posterPath,
                SeerrItem: credit
            }
            if isValid(year) and year > 0 then data.ProductionYear = year
            if isValidAndNotEmpty(creditRole)
                data.subTitle = creditRole
                data._credit = creditRole
            end if
            if isValidAndNotEmpty(released) then data.releaseDate = released

            card = createSGNode("HomeData")
            card.json = data
            list.push(card)
        end for
    end if

    return sortPersonItems(list, effectiveSort)
end function

' Biographies often open with a phonetic spelling and the name in its own script. The
' player font has no glyphs for those, so they come out as boxes. Latin text and its
' accents are kept and the rest is dropped along with any brackets left empty by it.
function readableText(value as dynamic) as string
    if not isValidAndNotEmpty(value) then return ""

    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(value)
    kept = CreateObject("roByteArray")

    i = 0
    while i < bytes.Count()
        byte = bytes[i]
        if byte < 128
            kept.Push(byte)
            i++
        else if byte = 194 or byte = 195
            ' Latin-1 accents, which the font does draw
            kept.Push(byte)
            if i + 1 < bytes.Count() then kept.Push(bytes[i + 1])
            i += 2
        else if byte = 226 and i + 2 < bytes.Count() and bytes[i + 1] = 128
            ' Typographic punctuation has a plain equivalent, so it is swapped rather
            ' than dropped and left running words together
            third = bytes[i + 2]
            if third = 147 or third = 148
                kept.Push(45)
            else if third = 152 or third = 153
                kept.Push(39)
            else if third = 156 or third = 157
                kept.Push(34)
            else if third = 166
                kept.Push(46)
                kept.Push(46)
                kept.Push(46)
            end if
            i += 3
        else
            ' Everything else is skipped a whole character at a time
            if byte >= 240
                i += 4
            else if byte >= 224
                i += 3
            else
                i += 2
            end if
        end if
    end while

    text = kept.ToAsciiString()
    emptyBrackets = CreateObject("roRegex", "\(\s*[;:,/]*\s*\)|\[\s*[;:,/]*\s*\]", "i")
    text = emptyBrackets.ReplaceAll(text, "")
    gaps = CreateObject("roRegex", "\s+([,;.])", "i")
    text = gaps.ReplaceAll(text, "\1")
    spacing = CreateObject("roRegex", "\s+", "i")

    return spacing.ReplaceAll(text, " ").Trim()
end function

' The titles the library credits a person on, asked of the server the person came from
function startPersonFilmography(personId as string, itemData as dynamic, limit as integer, handler as string) as object
    task = CreateObject("roSGNode", "LoadExtrasTask")
    task.itemId = personId
    task.isPersonMode = true
    task.personLimit = limit
    if isValidAndNotEmpty(chainLookupReturn(itemData, "_serverUrl", ""))
        task.serverUrl = itemData._serverUrl
        task.serverUserId = itemData._userId ?? ""
        task.serverAuthToken = itemData._authToken ?? ""
    end if
    task.observeField("content", handler)
    task.control = TaskControl.RUN
    return task
end function

' What Seerr knows a person worked on, when Seerr is set up, the person has a TMDB id and the
' viewer left at least one of the two lists on
function startSeerrPersonCredits(tmdbId as string, handler as string) as dynamic
    if not isValidAndNotEmpty(tmdbId) or not IsValidSeerrConfig(GetSeerrConfig()) then return invalid
    hidden = detailSectionLayout.HiddenIds()
    if hidden.DoesExist("seerrPersonAppearances") and hidden.DoesExist("seerrPersonCrew") then return invalid

    task = CreateObject("roSGNode", "SeerrAPITask")
    task.request = { method: "GET", endpoint: `/api/v1/person/${tmdbId}/combined_credits` }
    task.observeField("response", handler)
    task.control = TaskControl.RUN
    return task
end function

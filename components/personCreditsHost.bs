import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/detailSectionLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/personCredits.bs"
import "pkg:/source/utils/SeerrUtils.bs"
import "pkg:/source/utils/settingsSync.bs"

' A person's dates, filmography and Display options, shared by every screen that draws a person.
'
' Hook a screen with the Display button provides:
'   sub personDisplayChanged(), to redraw the credits in the order and grouping just picked

' How much of a person's filmography a detail page asks for, newest first
const PERSON_PAGE_LIMIT = 50

' Dates are read off the string, because roDateTime localizes on parse and shifts the day for
' anyone west of UTC
function formatPersonDate(value as dynamic) as string
    if not isServerDate(value) then return ""

    parts = Left(value, 10).split("-")
    if parts.count() <> 3 then return value

    month = parts[1].toInt()
    if month < 1 or month > 12 then return value

    monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    return `${tr(monthNames[month - 1])} ${parts[2].toInt()}, ${parts[0].toInt()}`
end function

' Whole years to today on the viewer's own calendar, one fewer until this year's birthday has
' come round
function personAge(birthValue as dynamic) as integer
    if not isServerDate(birthValue) then return 0

    birthParts = Left(birthValue, 10).split("-")
    if birthParts.count() <> 3 then return 0

    today = CreateObject("roDateTime")
    today.ToLocalTime()
    endYear = today.GetYear()
    endMonth = today.GetMonth()
    endDay = today.GetDayOfMonth()

    birthMonth = birthParts[1].toInt()
    age = endYear - birthParts[0].toInt()
    if endMonth < birthMonth or (endMonth = birthMonth and endDay < birthParts[2].toInt()) then age -= 1
    if age <= 0 then return 0
    return age
end function

' Born, then either the date they died or how old they are now, then where they were born
function personMetaParts(itemData as object) as object
    parts = []
    premiereDate = chainLookupReturn(itemData, "PremiereDate", "")
    born = formatPersonDate(premiereDate)
    if born <> "" then parts.push(tr("Born") + " " + born)

    died = formatPersonDate(chainLookupReturn(itemData, "EndDate", ""))
    if died <> ""
        parts.push(tr("Died") + " " + died)
    else if born <> ""
        age = personAge(premiereDate)
        if age > 0 then parts.push(tr("Age") + " " + age.toStr())
    end if

    birthPlace = chainLookupReturn(itemData, "ProductionLocations", invalid)
    if type(birthPlace) = "roArray" and birthPlace.count() > 0
        birthPlace = birthPlace[0]
    else
        birthPlace = chainLookupReturn(itemData, "placeOfBirth", invalid)
    end if
    if isValidAndNotEmpty(birthPlace) and detailSectionLayout.Shows("birthplace") then parts.push(birthPlace)

    return parts
end function

' The year a person was born and where, for the line under their name
function personBornParts(itemData as object) as object
    parts = []
    if isServerDate(itemData.PremiereDate) then parts.push(Left(itemData.PremiereDate, 4))
    places = chainLookupReturn(itemData, "ProductionLocations", [])
    if isValidAndNotEmpty(places) and isValidAndNotEmpty(places[0]) and detailSectionLayout.Shows("birthplace") then parts.push(places[0])
    return parts
end function

' The filmography comes back as one list, and each kind of work gets its own group in the order
' the Display options ask for. An episode of a series the person is billed on is already covered
' by that series, so only the rest count as a guest appearance. Guest appearances and music videos
' each have a switch, and a hidden one comes back empty.
function splitFilmography(entries as object) as object
    filmography = { movies: [], series: [], guest: [], music: [] }
    hidden = detailSectionLayout.HiddenIds()
    entries = personCredits.SortCards(entries, personCredits.SortOption())
    seriesIds = {}
    for each entry in entries
        if chainLookupReturn(entry, "json.Type", "") = "Series" then seriesIds[chainLookupReturn(entry, "json.Id", "")] = true
    end for

    for each entry in entries
        entryType = chainLookupReturn(entry, "json.Type", "")
        if entryType = "Movie"
            filmography.movies.push(entry)
        else if entryType = "Series"
            filmography.series.push(entry)
        else if entryType = "MusicVideo"
            if not hidden.DoesExist("musicVideos") then filmography.music.push(entry)
        else if entryType = "Episode" and not hidden.DoesExist("guestAppearances")
            seriesId = chainLookupReturn(entry, "json.SeriesId", "")
            if seriesId = "" or not seriesIds.DoesExist(seriesId) then filmography.guest.push(entry)
        end if
    end for

    return filmography
end function

' What Seerr knows they appeared in and worked on, leaving out a list the viewer hid. A person
' page orders and groups them the way its Display options ask, and a person drawn from Seerr alone
' lists every credit by title.
function shownSeerrCredits(credits as object, followsDisplay as boolean) as object
    option = personCredits.SORT_ALPHABETICAL
    group = false
    if followsDisplay
        option = personCredits.SortOption()
        group = personCredits.GroupsRoles()
    end if

    hidden = detailSectionLayout.HiddenIds()
    shown = { appearances: [], crew: [] }
    if not hidden.DoesExist("seerrPersonAppearances") then shown.appearances = usableSeerrCredits(credits.cast, false, option, group)
    if not hidden.DoesExist("seerrPersonCrew") then shown.crew = usableSeerrCredits(credits.crew, true, option, group)
    return shown
end function

' Only credits with a poster, never a crew job that's a thank you rather than work on the title
function usableSeerrCredits(credits as object, isCrew as boolean, option as string, group as boolean) as object
    list = []
    if not isValidAndNotEmpty(credits) then return list

    usable = []
    for each credit in credits
        if not isValidAndNotEmpty(credit.LookupCI("posterPath")) then continue for

        if isCrew
            job = LCase(credit.LookupCI("job") ?? "")
            if job = "thanks" or job = "special thanks" then continue for
        end if
        usable.push(credit)
    end for

    posterBase = GetTmdbImageBaseUrls().posterW342
    for each credit in personCredits.SortCredits(personCredits.Shaped(usable, isCrew, group), option)
        mediaType = LCase(credit.LookupCI("mediaType") ?? "")
        if mediaType = "" then mediaType = isValidAndNotEmpty(credit.LookupCI("title")) ? "movie" : "tv"

        tmdbId = ""
        rawId = credit.LookupCI("id")
        if isValid(rawId) then tmdbId = rawId.ToStr()

        ' The card caption reads the year off the same field the library entries use
        released = credit.LookupCI("releaseDate")
        if not isValidAndNotEmpty(released) then released = credit.LookupCI("firstAirDate")
        year = invalid
        if isValidAndNotEmpty(released) and released.len() >= 4 then year = released.left(4).toInt()

        ' Selecting the card opens the Seerr page, which reads the credit off SeerrItem the same
        ' way the home rows do
        credit.mediaType = mediaType

        data = {
            Id: tmdbId,
            name: personCredits.CreditTitle(credit),
            Type: mediaType = "tv" ? "Series" : "Movie",
            SeerrTmdbId: tmdbId,
            SeerrMediaType: mediaType,
            SeerrPosterURL: posterBase + credit.LookupCI("posterPath"),
            SeerrItem: credit
        }
        if isValid(year) and year > 0 then data.ProductionYear = year
        if credit._role <> "" then data.SeerrCredit = credit._role

        card = createSGNode("HomeData")
        card.json = data
        list.push(card)
    end for

    return list
end function

' Biographies often open with a phonetic spelling and the name in its own script. The
' player font has no glyphs for those, so they come out as boxes. Latin text and its
' accents are kept and the rest is dropped along with any brackets left empty by it.
function readableText(value as dynamic) as string
    if not isValidAndNotEmpty(value) then return ""

    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(value)
    kept = CreateObject("roByteArray")

    i = 0
    while i < bytes.Count()
        byte = bytes[i]
        if byte < 128
            kept.Push(byte)
            i++
        else if byte = 194 or byte = 195
            ' Latin-1 accents, which the font does draw
            kept.Push(byte)
            if i + 1 < bytes.Count() then kept.Push(bytes[i + 1])
            i += 2
        else if byte = 226 and i + 2 < bytes.Count() and bytes[i + 1] = 128
            ' Typographic punctuation has a plain equivalent, so it is swapped rather
            ' than dropped and left running words together
            third = bytes[i + 2]
            if third = 147 or third = 148
                kept.Push(45)
            else if third = 152 or third = 153
                kept.Push(39)
            else if third = 156 or third = 157
                kept.Push(34)
            else if third = 166
                kept.Push(46)
                kept.Push(46)
                kept.Push(46)
            end if
            i += 3
        else
            ' Everything else is skipped a whole character at a time
            if byte >= 240
                i += 4
            else if byte >= 224
                i += 3
            else
                i += 2
            end if
        end if
    end while

    text = kept.ToAsciiString()
    emptyBrackets = CreateObject("roRegex", "\(\s*[;:,/]*\s*\)|\[\s*[;:,/]*\s*\]", "i")
    text = emptyBrackets.ReplaceAll(text, "")
    gaps = CreateObject("roRegex", "\s+([,;.])", "i")
    text = gaps.ReplaceAll(text, "\1")
    spacing = CreateObject("roRegex", "\s+", "i")

    return spacing.ReplaceAll(text, " ").Trim()
end function

' The titles the library credits a person on, asked of the server the person came from
function startPersonFilmography(personId as string, itemData as dynamic, limit as integer, handler as string) as object
    task = CreateObject("roSGNode", "LoadExtrasTask")
    task.itemId = personId
    task.isPersonMode = true
    task.personLimit = limit
    if isValidAndNotEmpty(chainLookupReturn(itemData, "_serverUrl", ""))
        task.serverUrl = itemData._serverUrl
        task.serverUserId = itemData._userId ?? ""
        task.serverAuthToken = itemData._authToken ?? ""
    end if
    task.observeField("content", handler)
    task.control = TaskControl.RUN
    return task
end function

' What Seerr knows a person worked on, when Seerr is set up, the person has a TMDB id and the
' viewer left at least one of the two lists on
function startSeerrPersonCredits(tmdbId as string, handler as string) as dynamic
    if not isValidAndNotEmpty(tmdbId) or not IsValidSeerrConfig(GetSeerrConfig()) then return invalid
    hidden = detailSectionLayout.HiddenIds()
    if hidden.DoesExist("seerrPersonAppearances") and hidden.DoesExist("seerrPersonCrew") then return invalid

    task = CreateObject("roSGNode", "SeerrAPITask")
    task.request = { method: "GET", endpoint: `/api/v1/person/${tmdbId}/combined_credits` }
    task.observeField("response", handler)
    task.control = TaskControl.RUN
    return task
end function

' The Display dialog a person page opens from its Display button. Each pick is kept and sent to
' the server as it's made, the dialog stays up, and the screen redraws through its
' personDisplayChanged hook.
sub openPersonDisplay()
    if not isValid(m.personDisplay)
        m.personDisplay = m.top.createChild("LibrarySortDialog")
        m.personDisplay.visible = false
        m.personDisplay.observeField("chosen", "onPersonDisplayChosen")
        m.personDisplay.observeField("closed", "onPersonDisplayClosed")
    end if

    ' Whatever had the remote gets it back once the dialog closes
    m.personDisplayReturn = m.top
    while isValid(m.personDisplayReturn) and not m.personDisplayReturn.hasFocus()
        m.personDisplayReturn = m.personDisplayReturn.focusedChild
    end while

    m.personDisplay.context = personDisplayContext()
    m.personDisplay.callFunc("showDialog")
    m.top.lastFocus = m.personDisplay
end sub

function personDisplayOpen() as boolean
    return isValid(m.personDisplay) and m.personDisplay.visible
end function

function personDisplayContext() as object
    grouped = []
    if personCredits.GroupsRoles() then grouped.push("group")
    return {
        title: tr("Display Options"),
        sections: [
            {
                key: "sort",
                title: tr("Sort By"),
                kind: "radio",
                options: [
                    { value: personCredits.SORT_ALPHABETICAL, label: tr("Alphabetical") },
                    { value: personCredits.SORT_DATE_ASCENDING, label: tr("Release Date (Ascending)") },
                    { value: personCredits.SORT_DATE_DESCENDING, label: tr("Release Date (Descending)") }
                ],
                selected: personCredits.SortOption()
            },
            { key: "group", title: tr("Group Contributions"), kind: "check", options: [{ value: "group", label: tr("Group multiple roles") }], selected: grouped }
        ]
    }
end function

sub onPersonDisplayChosen(event as object)
    choice = event.getData()
    if not isValid(choice) then return

    if choice.section = "sort"
        if choice.value = personCredits.SortOption() then return
        savePersonDisplay(PERSON_SORT_SETTING, choice.value)
    else if choice.section = "group"
        savePersonDisplay(PERSON_GROUP_SETTING, personCredits.GroupsRoles() ? "false" : "true")
    end if

    m.personDisplay.context = personDisplayContext()
    m.personDisplay.callFunc("refresh")
    personDisplayChanged()
end sub

sub savePersonDisplay(key as string, value as string)
    set_user_setting(key, value)
    pushData = settingsSync.PreparePush(key, value)
    if not isValid(pushData) then return
    task = createObject("roSGNode", "PostTask")
    task.apiUrl = pushData.url
    task.stringData = pushData.body
    task.control = "RUN"
    ' Held until it finishes, or a task nothing references can be collected mid flight
    m.personDisplaySync = task
end sub

sub onPersonDisplayClosed()
    if not isValid(m.personDisplayReturn) then return
    m.personDisplayReturn.setFocus(true)
    m.top.lastFocus = m.personDisplayReturn
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- One media-server API call off the render thread: request in, response out -->
<component name="JellyfinAPITask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="response" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/libraryPanel.bs"
import "pkg:/source/utils/trackDialog.bs"
import "pkg:/source/enums/KeyCode.bs"

sub init()
    m.rowMenu = m.top.findNode("rowMenu")
    m.eyebrow = m.top.findNode("eyebrow")
    m.title = m.top.findNode("title")

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.title,
        titleRule: m.top.findNode("titleRule"),
        list: m.rowMenu
    }
end sub

sub focusDialog()
    m.rowMenu.setFocus(true)
end sub

sub showDialog()
    m.working = m.top.settings
    buildRows()

    m.eyebrow.text = UCase(m.top.context.kind)
    m.title.text = m.top.context.libraryName

    ' The rows never come and go while the dialog is up, so the panel fits itself around
    ' them the way the track pickers do
    trackDialog.Layout(m.parts, m.rows.count(), libraryPanel.SETTING_ROW_HEIGHT)
    libraryPanel.AddEyebrow(m.parts, m.eyebrow)

    m.top.visible = true
    m.rowMenu.setFocus(true)
end sub

function onOff(value as string) as string
    return isStringEqual(value, "off") ? tr("Off") : tr("On")
end function

' Each row names a setting, the values it steps through, and how its current one reads
function buildSettings() as object
    context = m.top.context
    rows = [{
        key: "imageSize",
        title: tr("Image size"),
        values: ["small", "medium", "large", "extraLarge"],
        labels: [tr("Small"), tr("Medium"), tr("Large"), tr("Extra Large")]
    }]

    ' A library whose cards are square either way has nothing to switch between
    if context.showImageType = true
        rows.push({
            key: "imageType",
            title: tr("Image Type"),
            values: ["poster", "thumbnail"],
            labels: [tr("Poster"), tr("Thumbnail")]
        })
    end if

    rows.push({ key: "cardText", title: tr("Titles under posters"), values: ["on", "off"] })
    rows.push({ key: "letterNav", title: tr("Alphabet bar"), values: ["on", "off"] })

    ' A genre or studio browse is already one flat list of what matched
    if context.showFolderView = true
        rows.push({ key: "folderView", title: tr("Folder view"), values: ["off", "on"] })
    end if

    return rows
end function

function valueLabel(setting as object) as string
    current = toString(m.working[setting.key])
    if not isValidAndNotEmpty(setting.labels) then return onOff(current)

    for i = 0 to setting.values.count() - 1
        if isStringEqual(setting.values[i], current) then return setting.labels[i]
    end for

    ' A value the library no longer offers reads as the first one it does
    return setting.labels[0]
end function

sub buildRows()
    m.rows = buildSettings()

    content = createSGNode("ContentNode")
    for each setting in m.rows
        row = content.createChild("LibraryPanelRowData")
        row.kind = "setting"
        row.rowHeight = libraryPanel.SETTING_ROW_HEIGHT
        row.title = setting.title
        row.summary = valueLabel(setting)
    end for

    m.rowMenu.content = content
end sub

sub cycleSetting(setting as object)
    current = toString(m.working[setting.key])
    stepTo = 0

    for i = 0 to setting.values.count() - 1
        if isStringEqual(setting.values[i], current)
            stepTo = (i + 1) mod setting.values.count()
            exit for
        end if
    end for

    m.working[setting.key] = setting.values[stepTo]
    m.top.applied = m.working

    focused = m.rowMenu.itemFocused
    buildRows()
    m.rowMenu.jumpToItem = focused
    m.rowMenu.setFocus(true)
end sub

sub closeDialog()
    m.top.visible = false
    m.top.closed = true
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.BACK)
        closeDialog()
        return true
    end if

    if isStringEqual(key, KeyCode.OK)
        index = m.rowMenu.itemFocused
        if index >= 0 and index < m.rows.count() then cycleSetting(m.rows[index])
        return true
    end if

    return false
end function

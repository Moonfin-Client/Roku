<?xml version="1.0" encoding="utf-8"?>
<component name="LibraryPanelRow" extends="Group">
  <children>
    <Rectangle id="rowBg" color="#FFFFFF" opacity="0" />
    <Poster id="rowBorder" uri="pkg:/images/details/outline6.9.png" visible="false" />
    <!-- Separates one collapsible group from the next, the way the web draws it -->
    <Rectangle id="rule" color="#FFFFFF" opacity="0.1" height="1" visible="false" />

    <Poster id="chevron" visible="false" />
    <Poster id="controlOutline" visible="false" />
    <Poster id="controlFill" visible="false" />
    <Poster id="controlMark" uri="pkg:/images/icons/check_white.png" visible="false" />

    <Label id="rowLabel" font="font:MediumBoldSystemFont" color="#FFFFFFCC" />
    <Label id="rowValue" font="font:SmallSystemFont" color="#FFFFFF8C" visible="false" />
    <Label id="rowSummary" font="font:SmallSystemFont" horizAlign="right" vertAlign="center" visible="false" />
    <Poster id="sortArrow" visible="false" />
  </children>

  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="applyFocusInk" />
    <field id="itemHasFocus" type="boolean" onChange="applyFocusInk" />
  </interface>
</component>

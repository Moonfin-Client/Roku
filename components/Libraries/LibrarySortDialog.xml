<?xml version="1.0" encoding="utf-8"?>
<!-- Sort and filter in one panel, the same one the track pickers use. Every group
     collapses, only one stands open, and a choice takes effect as it is made rather than
     on an apply -->
<component name="LibrarySortDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="rowMenu"
        itemComponentName="LibraryPanelRow"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <!-- view, sortKey, sortOrder and the filters the dialog starts from -->
    <field id="state" type="assocarray" />
    <!-- What the library holds, for the genre, rating, tag, year and language groups -->
    <field id="facets" type="assocarray" />
    <!-- The views this library offers plus what its item type rules out -->
    <field id="context" type="assocarray" />

    <!-- The whole state back again, whenever any of it changes -->
    <field id="applied" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
    <function name="focusDialog" />
  </interface>
</component>

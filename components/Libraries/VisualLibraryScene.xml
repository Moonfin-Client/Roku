<?xml version="1.0" encoding="utf-8"?>
<component name="VisualLibraryScene" extends="JFScreen">
  <children>
    <!-- Dark background -->
    <Rectangle width="1920" height="1080" color="#000018" />

    <!-- Previous backdrop that stays visible until new one loads -->
    <Poster id="backdropPrev" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />

    <!-- Main backdrop with high quality scaling -->
    <Poster id="backdrop" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />

    <!-- Color tint/scrim overlay for readability - 95% black -->
    <Rectangle id="backdropTint" width="1920" height="1080" color="#F2000000" opacity="1.0" />

    <Animation id="backdropFadeIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdrop.opacity" />
    </Animation>

    <Animation id="backdropPrevFadeOut" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropPrevFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="backdropPrev.opacity" />
    </Animation>

    <!-- Header: Library name (centered) + item count -->
    <Label id="libraryName" font="font:LargeSystemFont" color="#ffffff"
      height="48" vertAlign="center" translation="[0, 20]" />
    <Label id="itemCount" font="font:SmallSystemFont" color="#ffffff" opacity="0.4"
      height="48" vertAlign="center" translation="[0, 22]" />

    <!-- What the focused item is, held to a fixed height so the grid never shifts -->
    <Group id="focusedInfo" translation="[87, 84]">
      <Label id="selectedItemName" font="font:MediumBoldSystemFont" width="1746" maxLines="1" color="#ffffff" />
      <LayoutGroup id="infoGroup" layoutDirection="horiz" vertAlignment="center"
        itemSpacings="[12]" translation="[0, 41]">
        <Label id="selectedItemProductionYear" font="font:SmallSystemFont" color="#ffffff" opacity="0.7" />
        <Label id="runtime" font="font:SmallSystemFont" color="#ffffff" opacity="0.7" />
        <Group id="seriesStatusPill" visible="false">
          <Poster id="seriesStatusFill" uri="pkg:/images/details/badgefill6.9.png" />
          <Label id="seriesStatusLabel" font="font:SmallestBoldSystemFont" color="#ffffff"
            horizAlign="center" vertAlign="center" />
        </Group>
        <Group id="officialRatingPill" visible="false">
          <Poster id="officialRatingFill" uri="pkg:/images/details/badgefill6.9.png"
            blendColor="#FFFFFF" opacity="0.15" />
          <Label id="selectedItemOfficialRating" font="font:SmallestBoldSystemFont" color="#ffffff"
            horizAlign="center" vertAlign="center" />
        </Group>
      </LayoutGroup>
      <RatingsRow id="pluginRatings" visible="false" translation="[0, 72]"
        iconHeight="32" valueSize="24" nameSize="16" ratingSpacing="9" showNames="true" />
    </Group>

    <!-- Toolbar: Icon buttons on the left -->
    <IconButton id="homeButton" translation="[87, 248]"
      icon="pkg:/images/icons/home.png" height="44" width="44" padding="4"
      background="0x00000000" focusBackground="#555555" />
    <IconButton id="sortButton" translation="[134, 248]"
      icon="pkg:/images/icons/sort_by_alpha.png" height="44" width="44" padding="4"
      background="0x00000000" focusBackground="#555555" />
    <IconButton id="settingsButton" translation="[181, 248]"
      icon="pkg:/images/icons/settings.png" height="44" width="44" padding="4"
      background="0x00000000" focusBackground="#555555" />

    <!-- Search field, always on screen the way the other clients show it -->
    <SearchBox id="searchBox" translation="[1369, 9]" boxWidth="464" boxHeight="66" focusable="true" />

    <!-- Horizontal alpha picker on the right -->
    <HorizontalAlphaPicker id="alphaPicker" translation="[240, 255]" />

    <!-- Main item grid -->
    <MarkupGrid
      id="itemGrid"
      itemComponentName="LibraryCard"
      vertFocusAnimationStyle="fixed"
      translation="[87, 316]"
      clippingRect="[0, 0, 1746, 740]"
      drawFocusFeedback="false"
      numColumns="10"
      numRows="3"
      itemSize="[174, 292]"
      rowHeights="[292]"
      itemSpacing="[0, 0]" />

    <!-- Genre card grid (hidden by default) -->
    <MarkupGrid
      id="genreGrid"
      itemComponentName="GenreCard"
      vertFocusAnimationStyle="fixed"
      opacity="0"
      translation="[80, 195]"
      clippingRect="[-30, -10, 1880, 850]"
      drawFocusFeedback="true"
      numColumns="4"
      numRows="3"
      itemSize="[418, 235]"
      rowHeights="[235]"
      itemSpacing="[40, 30]" />

    <!-- Empty text message -->
    <Text translation="[0, 540]" id="emptyText" font="font:LargeSystemFont"
      width="1920" horizAlign="center" vertAlign="center" height="64"
      visible="false" color="#aaaaaa" />

    <!-- Sort & Filter dialog (hidden) -->
    <SortFilterDialog id="options" visible="false" />
  </children>
  <interface>
    <function name="getItemFocused" />
    <function name="redrawItems" />
    <field id="mediaType" type="string" />
    <field id="parentItem" type="node" onChange="loadInitialItems" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <field id="imageDisplayMode" type="string" value="" />
    <field id="alphaSelected" type="string" alias="alphaPicker.letterSelected" onChange="alphaSelectedChanged" alwaysNotify="true" />
    <field id="alphaActive" type="boolean" value="false" />
    <field id="showItemTitles" type="string" value="" />
    <field id="genreFilter" type="assocarray" />
    <field id="studioFilter" type="assocarray" />
    <field id="genreItemSelected" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Looks at what each playlist holds to say which row it belongs in -->
<component name="PlaylistCategoryTask" extends="Task">
    <interface>
        <!-- [{ id, summary }], the summary standing in when a look fails -->
        <field id="playlists" type="array" />
        <!-- { playlistId: category } for each three looked at -->
        <field id="resolved" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

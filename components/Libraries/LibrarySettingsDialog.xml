<?xml version="1.0" encoding="utf-8"?>
<!-- How this library draws itself, in the same panel as the sort and filter dialog. Each
     row steps through its values in place and the grid redraws behind -->
<component name="LibrarySettingsDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="eyebrow" font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="rowMenu"
        itemComponentName="LibraryPanelRow"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <!-- imageSize, imageType, cardText, letterNav and folderView as they stand -->
    <field id="settings" type="assocarray" />
    <!-- The library's name, and which rows apply to it -->
    <field id="context" type="assocarray" />

    <!-- The whole set back again, whenever any of it changes -->
    <field id="applied" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
    <function name="focusDialog" />
  </interface>
</component>

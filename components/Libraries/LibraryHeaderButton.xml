<?xml version="1.0" encoding="utf-8"?>
<!-- A control in the Modern and Docked library headers, a glyph with an optional name and the
     value it holds, filled with the accent while it has the focus -->
<component name="LibraryHeaderButton" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/tracks/panel20.9.png" visible="false" />
    <Label id="glyph" horizAlign="center" vertAlign="center" />
    <Label id="title" font="font:SmallBoldSystemFont" vertAlign="center" />
    <Label id="value" font="font:SmallSystemFont" vertAlign="center" />
    <Poster id="arrow" visible="false" />
    <Label id="chevron" horizAlign="center" vertAlign="center" visible="false" />
  </children>

  <interface>
    <field id="icon" type="string" />
    <field id="focus" type="boolean" value="false" onChange="applyFocus" />
    <function name="layout" />
  </interface>
</component>

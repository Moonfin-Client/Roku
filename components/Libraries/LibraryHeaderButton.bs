import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/themeChrome.bs"

const PAD_LEFT = 18
const PAD_RIGHT = 21
const GLYPH_SIZE = 30
const CHEVRON_SIZE = 26
const GAP = 12
const VALUE_GAP = 8
const ARROW_SIZE = 20

sub init()
    m.fill = m.top.findNode("fill")
    m.glyph = m.top.findNode("glyph")
    m.title = m.top.findNode("title")
    m.value = m.top.findNode("value")
    m.arrow = m.top.findNode("arrow")
    m.chevron = m.top.findNode("chevron")

    m.title.font.size = 24
    m.value.font.size = 22

    m.fill.blendColor = themeChrome.Accent()
    m.focusInk = themeChrome.IsActive() ? themeChrome.OnAccent() : "#FFFFFF"
    m.ink = themeChrome.OnBackground()
    m.mutedInk = themeChrome.WithAlpha(m.ink, "99")
    applyFocus()
end sub

' Sizes the control to the height it is given, as wide as its words when no width is given or
' as a row of that width, and hands back the width it took
function layout(args as object) as integer
    height = args.height
    rowWidth = args.width ?? 0
    m.title.text = args.text ?? ""
    m.value.text = args.value ?? ""
    order = args.sortOrder ?? ""

    ' The screen's theme font replaces every label's font when it is pushed, this one included
    m.glyph.font = glyphFont(GLYPH_SIZE)
    m.glyph.text = settingsGlyphs.Char(m.top.icon)
    m.chevron.font = glyphFont(CHEVRON_SIZE)
    m.chevron.text = settingsGlyphs.Char("chevron_right")

    for each label in [m.glyph, m.title, m.value, m.chevron]
        label.height = height
    end for
    m.glyph.width = GLYPH_SIZE
    m.chevron.width = CHEVRON_SIZE
    m.arrow.width = ARROW_SIZE
    m.arrow.height = ARROW_SIZE
    m.arrow.visible = order <> ""
    m.arrow.uri = isStringEqual(order, "Descending") ? "pkg:/images/icons/sort_arrow_down.webp" : "pkg:/images/icons/sort_arrow_up.webp"
    m.chevron.visible = rowWidth > 0

    titleWidth = textWidth(m.title)
    valueWidth = textWidth(m.value)

    if m.title.text = ""
        width = height
        m.glyph.translation = [(height - GLYPH_SIZE) / 2, 0]
    else if rowWidth > 0
        width = rowWidth
        m.glyph.translation = [PAD_LEFT, 0]
        right = rowWidth - PAD_RIGHT - CHEVRON_SIZE
        m.chevron.translation = [right, 0]
        if m.arrow.visible
            right -= VALUE_GAP + ARROW_SIZE
            m.arrow.translation = [right, (height - ARROW_SIZE) / 2]
        end if
        m.value.translation = [right - VALUE_GAP - valueWidth, 0]
        m.title.translation = [PAD_LEFT + GLYPH_SIZE + GAP, 0]
    else
        m.glyph.translation = [PAD_LEFT, 0]
        x = PAD_LEFT + GLYPH_SIZE + GAP
        m.title.translation = [x, 0]
        x += titleWidth
        if valueWidth > 0
            x += VALUE_GAP
            m.value.translation = [x, 0]
            x += valueWidth
        end if
        if m.arrow.visible
            x += VALUE_GAP
            m.arrow.translation = [x, (height - ARROW_SIZE) / 2]
            x += ARROW_SIZE
        end if
        width = x + PAD_RIGHT
    end if

    m.title.width = titleWidth
    m.value.width = valueWidth
    m.fill.width = width
    m.fill.height = height
    return width
end function

function glyphFont(size as integer) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = settingsGlyphs.FONT_URI
    font.size = size
    return font
end function

' A label reports back the width it was given, so that has to go before its words are measured
function textWidth(label as object) as integer
    label.width = 0
    if label.text = "" then return 0
    return label.boundingRect().width
end function

sub applyFocus()
    focused = m.top.focus
    m.fill.visible = focused
    ink = focused ? m.focusInk : m.ink
    m.title.color = ink
    m.value.color = focused ? ink : m.mutedInk
    m.glyph.color = focused ? ink : m.mutedInk
    m.chevron.color = focused ? ink : m.mutedInk
    m.arrow.blendColor = ink
end sub

' The age rating and series status badges, sized around whatever they are given
const PILL_PAD_X = 18
const PILL_HEIGHT = 26

' Grouped rows draw the square cards at this size, this far apart, with this much room
' between rows for the next row's title
const GROUPED_CARD_SIZE = 240
const GROUPED_CARD_GAP = 24
const GROUPED_ROW_GAP = 90
const PLAYLIST_GROUPING_SETTING = "ui.library.playlistsGroupByType"

' Return parent collection type
function getCollectionType() as string
    return m.top.parentItem.collectionType ?? m.top.parentItem.Type
end function


sub setupNodes()
    m.top.imageDisplayMode = "scaleToZoom"
    m.top.showItemTitles = "showonhover"

    ' Grid and lists
    m.sortDialog = m.top.findNode("sortDialog")
    m.settingsDialog = m.top.findNode("settingsDialog")
    m.itemGrid = m.top.findNode("itemGrid")
    m.genreGrid = m.top.findNode("genreGrid")
    m.emptyText = m.top.findNode("emptyText")

    ' Info display
    m.selectedItemName = m.top.findNode("selectedItemName")
    m.selectedItemProductionYear = m.top.findNode("selectedItemProductionYear")
    m.selectedItemOfficialRating = m.top.findNode("selectedItemOfficialRating")
    m.infoGroup = m.top.findNode("infoGroup")
    m.pluginRatings = m.top.findNode("pluginRatings")

    ' Header
    m.searchBox = m.top.findNode("searchBox")
    m.searchBox.placeholder = tr("Search this library...")

    m.libraryName = m.top.findNode("libraryName")
    m.libraryName.font.size = 38
    m.itemCountLabel = m.top.findNode("itemCount")
    m.itemCountLabel.font.size = 17

    m.selectedItemName.font.size = 29
    for each label in [m.top.findNode("selectedItemProductionYear"), m.top.findNode("runtime")]
        label.font.size = 20
    end for
    for each pill in [m.top.findNode("seriesStatusLabel"), m.top.findNode("selectedItemOfficialRating")]
        pill.font.size = 16
    end for

    ' Toolbar icon buttons
    m.homeButton = m.top.findNode("homeButton")
    m.sortButton = m.top.findNode("sortButton")
    m.settingsButton = m.top.findNode("settingsButton")
    m.toolbarButtons = [m.homeButton, m.sortButton, m.settingsButton]

    ' Alpha picker
    m.alphaPicker = m.top.findNode("alphaPicker")
    m.alphaGrid = m.alphaPicker.findNode("alphaGrid")

    ' Status bar

    m.overhang = getActiveNav(m.top.getScene())
end sub

sub init()
    observeUserData()
    ' Tell SceneManager to hide the overhang for this screen
    m.top.overhangVisible = false

    m.itemGridCounter = 0
    m.top.optionsAvailable = false
    setupNodes()
    m.allItems = []
    m.searchNames = []
    m.searchQuery = ""

    m.itemGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.genreGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.sortDialog.observeField("applied", "onSortApplied")
    m.sortDialog.observeField("closed", "onSortClosed")

    m.settingsDialog.observeField("applied", "onSettingsApplied")
    m.settingsDialog.observeField("closed", "onSortClosed")

    m.loadedRows = 0
    m.loadedItems = 0
    ' Paging follows what the server sent, while the grid and the count leave out blocked titles
    m.serverPosition = 0
    m.blockedCount = 0

    ' Toolbar focus state: 0=home, 1=sort, 2=settings, 3=alpha
    m.toolbarFocusIndex = 0

    m.data = createSGNode("ContentNode")
    m.itemGrid.observeField("itemFocused", "onItemFocused")
    m.itemGrid.observeFieldScoped("itemSelected", "onItemSelected")
    m.itemGrid.content = m.data

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.observeFieldScoped("itemSelected", "onGenreItemSelected")
    m.genreGrid.content = m.genreData

    m.groupRows = m.top.findNode("groupRows")
    m.groupRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.groupRows.rowLabelFont = "font:SmallestBoldSystemFont"
    m.groupRows.rowLabelFont.size = 28
    m.groupRows.observeField("rowItemFocused", "onGroupItemFocused")
    m.groupRows.observeField("rowItemSelected", "onGroupItemSelected")
    m.playlistGrouped = false
    ' What each playlist was found to hold, kept across reloads since a sort doesnt change it
    m.playlistCategories = {}
    m.playlistAttempted = {}
    m.playlistQueue = []
    m.categoryTask = createObject("roSGNode", "PlaylistCategoryTask")
    m.categoryTask.observeField("resolved", "onPlaylistCategories")
    m.categoryTask.observeField("state", "onCategoryTaskState")

    ' Item sort
    m.sortField = "SortName"
    m.sortAscending = true

    m.sortKey = "SortName"
    m.sortOrder = "Ascending"
    m.filterState = libraryFilters.EmptyState()

    m.view = "presentation"

    m.loadItemsTask1 = createObject("roSGNode", "LoadItemsTask")

    m.loadItemsTask = createObject("roSGNode", "LoadItemsTask2")
    m.getFiltersTask = createObject("roSGNode", "GetFiltersTask")

    ' Set initial counts
    m.loadItemsTask.totalRecordCount = 0

    m.backdrop = m.top.findNode("backdrop")
    m.backdropPrev = m.top.findNode("backdropPrev")
    m.backdrop.observeField("loadStatus", "onBackdropLoadStatusChange")

    m.backdropFadeIn = m.top.findNode("backdropFadeIn")
    m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")
    m.backdropFadeInInterp = m.top.findNode("backdropFadeInInterp")
    m.backdropPrevFadeOutInterp = m.top.findNode("backdropPrevFadeOutInterp")
    m.backdropCrossfading = false
    m.backdropTargetOpacity = 1.0
end sub

' Handle backdrop load status - when new backdrop finishes loading, crossfade it in
sub onBackdropLoadStatusChange()
    if isValid(m.backdrop) and m.backdrop.loadStatus = "ready" and isValidAndNotEmpty(m.backdrop.uri)
        if m.backdropCrossfading
            targetOpacity = m.backdropTargetOpacity

            currentBackdropOpacity = 0.0
            if isValid(m.backdrop)
                currentBackdropOpacity = m.backdrop.opacity
            end if

            currentPrevOpacity = 1.0
            if isValid(m.backdropPrev)
                currentPrevOpacity = m.backdropPrev.opacity
            end if

            if isValid(m.backdropFadeInInterp)
                m.backdropFadeInInterp.keyValue = [currentBackdropOpacity, targetOpacity]
            end if
            if isValid(m.backdropPrevFadeOutInterp)
                m.backdropPrevFadeOutInterp.keyValue = [currentPrevOpacity, 0.0]
            end if
            if isValid(m.backdropFadeIn)
                m.backdropFadeIn.control = "start"
            end if
            if isValid(m.backdropPrevFadeOut)
                m.backdropPrevFadeOut.control = "start"
            end if
            m.backdropCrossfading = false
        end if
    end if
end sub

sub clearFocusedItemBackdrop()
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdrop)
        m.backdrop.uri = ""
        m.backdrop.opacity = m.backdropTargetOpacity
    end if

    if isValid(m.backdropPrev)
        m.backdropPrev.uri = ""
        m.backdropPrev.opacity = 0
    end if

    m.backdropCrossfading = false
end sub

sub startBackdropCrossfade(uri as string)
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdropPrev) and m.backdrop.uri <> ""
        m.backdropPrev.uri = m.backdrop.uri
        m.backdropPrev.opacity = m.backdropTargetOpacity
    end if

    m.backdrop.opacity = 0.0
    m.backdrop.uri = uri
    m.backdropCrossfading = true
end sub

sub OnScreenHidden()
    if not m.overhang.isVisible
        m.overhang.disableMoveAnimation = true
        m.overhang.isVisible = true
        m.overhang.disableMoveAnimation = false
    end if
end sub

sub OnScreenShown(isReturning = false as boolean)
    ' Hide the overhang/navbar
    m.overhang.isVisible = false

    ' Set library name in header
    if isValid(m.top.genreFilter) and isValidAndNotEmpty(m.top.genreFilter.genreName)
        m.libraryName.text = m.top.genreFilter.genreName
    else if isValid(m.top.studioFilter) and isValidAndNotEmpty(m.top.studioFilter.studioName)
        m.libraryName.text = m.top.studioFilter.studioName
    else if isValid(m.top.parentItem)
        m.libraryName.text = isValid(m.top.parentItem.name) ? m.top.parentItem.name : m.top.parentItem.title
    end if

    ' Only redraw items on initial show, not when returning from detail screens
    if not isReturning
        redrawItems()
    end if

    ' Temporarily unobserve itemSelected to prevent triggering navigation when restoring focus
    m.itemGrid.unobserveFieldScoped("itemSelected")

    group = m.global.sceneManager.callFunc("getActiveScene")

    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        group.lastFocus = m.top.lastFocus

        ' Re-observe itemSelected after focus is restored
        m.itemGrid.observeFieldScoped("itemSelected", "onItemSelected")

        ' Skip metadata loading when returning from detail screens
        if isReturning then return

        focusedItem = getItemFocused()

        if isValid(focusedItem)
            m.loadItemsTask1.itemId = focusedItem.LookupCI("id")
            m.loadItemsTask1.observeField("content", "onItemDataLoaded")
            m.loadItemsTask1.itemsToLoad = "metaData"
            m.loadItemsTask1.control = TaskControl.RUN
        end if

    else
        m.top.setFocus(true)
        group.lastFocus = m.top
        ' Re-observe itemSelected even if no lastFocus
        m.itemGrid.observeFieldScoped("itemSelected", "onItemSelected")
    end if
end sub

sub onItemDataLoaded()
    itemData = m.loadItemsTask1.content
    m.loadItemsTask1.unobserveField("content")
    m.loadItemsTask1.control = TaskControl.STOP
    m.loadItemsTask1.content = []

    if not isValidAndNotEmpty(itemData) then return

    focusedItem = getItemFocused()
    if not isValid(focusedItem) then return

    focusedItem.callFunc("setWatched", chainLookupReturn(itemData[0], "json.UserData.Played", false), chainLookupReturn(itemData[0], "json.UserData.UnplayedItemCount", 0))
end sub

sub redrawItems()
    applyGridMetrics()

    applySearchFilter()

    ' Reset cursor back to its previous location
    m.itemGrid.jumpToItem = m.itemGrid.itemFocused

    genreContent = m.genreData.getChildren(-1, 0)
    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData
    m.genreData.appendChildren(genreContent)

    ' Reset cursor back to its previous location
    m.genreGrid.jumpToItem = m.genreGrid.itemFocused
end sub

' Get the ID to use for this item (libraryId for library folders, id for BoxSets/collections)
function getParentItemId() as string
    if isValid(m.top.parentItem.libraryId) and m.top.parentItem.libraryId <> ""
        return m.top.parentItem.libraryId
    end if
    return m.top.parentItem.id
end function


' Load initial set of data
sub loadInitialItems()
    m.loadItemsTask.control = TaskControl.STOP
    startLoadingSpinner(false)

    itemId = getParentItemId()

    ' The settings map is gone once the user signs out, and a library can still reload on the way there
    userSettings = chainLookupReturn(m.global.session, "user.settings", {})

    m.sortField = userSettings["display." + itemId + ".sortField"]
    m.view = userSettings["display." + itemId + ".landing"]
    m.sortAscending = userSettings["display." + itemId + ".sortAscending"]
    m.filterState = storedFilterState(itemId)

    ' If user has not set a preferred view for this folder, check if they've set a default view
    if not isValid(m.view)
        settingName = `display.${m.top.mediaType}library.defaultview`

        if isStringEqual(m.top.mediaType, ItemType.PHOTOALBUM)
            settingName = `display.${ItemType.PHOTO}library.defaultview`
        end if

        m.view = userSettings[settingName]
    end if

    if not isValidAndNotEmpty(m.sortField) then m.sortField = "SortName"

    if not isValidAndNotEmpty(m.view)
        if isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
            m.view = "Artists"
        else
            m.view = "presentation"
        end if
    end if
    if not isValid(m.sortAscending)
        m.sortAscending = true
    else if not isStringEqual(type(m.sortAscending), "roBoolean")
        m.sortAscending = isStringEqual(m.sortAscending, "true")
    end if

    ' If we're in genre or studio browse mode, force view to presentation (never "Genres")
    if isValid(m.top.genreFilter) or isValid(m.top.studioFilter)
        if m.view <> "presentation" then m.view = "presentation"
    else
        ' If view is not valid, use default view
        if isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
            if not inArray(["Artists", "Albums", "Genres"], m.view) then m.view = "Artists"
        else
            if not inArray(["presentation", "Genres", "Episodes"], m.view) then m.view = "presentation"
        end if

        if isValid(m.top.parentItem.parentFolder)
            if m.view <> "presentation" then m.view = "presentation"
        end if
    end if

    m.sortKey = librarySorts.KeyFor(m.sortField, isMusicLibrary(), isMyListLibrary())
    m.sortOrder = m.sortAscending ? "Ascending" : "Descending"

    m.loadItemsTask.sortField = m.sortField
    m.loadItemsTask.sortAscending = m.sortAscending
    m.loadItemsTask.filterState = m.filterState
    m.folderView = settingOr(`library_folderView_${itemId}`, "off") = "on"
    m.loadItemsTask.startIndex = 0
    m.loadItemsTask.studioIds = string.EMPTY
    m.loadItemsTask.view = string.EMPTY
    ' The task outlives a load, so anything a branch below switches off is put back first
    m.loadItemsTask.recursive = true
    m.loadItemsTask.passToItem = {
        libraryID: getParentItemId()
    }

    if isStringEqual(m.view, "Genres")
        m.loadItemsTask.view = "Genres"
        m.loadItemsTask.genreIds = getParentItemId()
        m.loadItemsTask.itemId = getParentItemId()
        m.loadItemsTask.studioIds = getParentItemId()
        if isStringEqual(m.top.mediaType, ItemType.MUSICVIDEO)
            m.loadItemsTask.recursive = true
        end if
        ' For music genres, use MusicAlbum as the includeItemTypes
        if isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
            m.loadItemsTask.itemType = "MusicAlbum"
        end if
    else if isStringEqual(m.view, "presentation")
        m.loadItemsTask.itemId = getParentItemId()
        m.loadItemsTask.studioIds = string.EMPTY
        m.loadItemsTask.genreIds = string.EMPTY
    else if isStringEqual(m.view, "Episodes")
        m.loadItemsTask.itemId = getParentItemId()
        m.loadItemsTask.studioIds = string.EMPTY
        m.loadItemsTask.genreIds = string.EMPTY
        if isStringEqual(m.loadItemsTask.sortField, "SortName")
            m.loadItemsTask.sortField = `SeriesSortName,SortName`
        end if
    else if inArray(["Artists", "Albums"], m.view)
        m.loadItemsTask.itemId = getParentItemId()
        m.loadItemsTask.studioIds = string.EMPTY
        m.loadItemsTask.genreIds = string.EMPTY
    end if

    ' Genre browse mode: override task params to filter by selected genre
    if isValid(m.top.genreFilter)
        m.loadItemsTask.view = string.EMPTY
        m.loadItemsTask.studioIds = string.EMPTY
        m.loadItemsTask.recursive = true

        if isValidAndNotEmpty(m.top.genreFilter.genreId)
            m.loadItemsTask.genreIds = m.top.genreFilter.genreId
        else if isValidAndNotEmpty(m.top.genreFilter.genreName)
            m.loadItemsTask.genreNames = m.top.genreFilter.genreName
        end if

        if isValidAndNotEmpty(m.top.genreFilter.libraryId)
            m.loadItemsTask.itemId = m.top.genreFilter.libraryId
        end if

        if isValidAndNotEmpty(m.top.genreFilter.itemType)
            m.loadItemsTask.itemType = m.top.genreFilter.itemType
        end if
    else if isValid(m.top.studioFilter)
        ' Studio browse: filter the library grid by the selected studio.
        m.loadItemsTask.view = string.EMPTY
        m.loadItemsTask.genreIds = string.EMPTY
        m.loadItemsTask.recursive = true
        m.loadItemsTask.itemType = `${ItemType.MOVIE},${ItemType.SERIES}`

        if isValidAndNotEmpty(m.top.studioFilter.studioId)
            m.loadItemsTask.studioIds = m.top.studioFilter.studioId
        end if
        if isValidAndNotEmpty(m.top.studioFilter.libraryId)
            m.loadItemsTask.itemId = m.top.studioFilter.libraryId
        end if
    else if inArray([ItemType.BOXSET, ItemType.PHOTO, ItemType.PHOTOALBUM, ItemType.MUSICVIDEO, ItemType.PLAYLIST, ItemType.FOLDER], m.top.mediaType)
        m.loadItemsTask.recursive = false

        if isStringEqual(m.top.mediaType, ItemType.MUSICVIDEO)
            m.loadItemsTask.sortField = `${m.sortField}`
            m.loadItemsTask.itemType = `${ItemType.MUSICVIDEO},${ItemType.FOLDER}`
            m.loadItemsTask.passToItem.addreplace("collectionType", ItemType.MUSICVIDEO)
        end if

    else if isStringEqual(m.view, "Episodes")
        m.loadItemsTask.recursive = true
        m.loadItemsTask.itemType = ItemType.EPISODE
    else if isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
        ' Music library: set itemType based on selected view
        ' Use PascalCase strings to match LoadItemsTask2's case-sensitive checks
        if isStringEqual(m.view, "Albums")
            m.loadItemsTask.itemType = "MusicAlbum"
            m.loadItemsTask.recursive = true
        else
            ' Default: Artists view
            m.loadItemsTask.itemType = "MusicArtist"
        end if
    else
        m.loadItemsTask.itemType = m.top.mediaType
    end if

    ' Collections / BoxSet handling for libraries and genre filtering
    collType = getCollectionType()
    groupCollections = get_user_setting_bool("ui.library.groupItemsIntoCollections", false)

    if isValid(m.top.genreFilter)
        m.loadItemsTask.collapseBoxSetItems = groupCollections
        m.loadItemsTask.excludeItemTypes = groupCollections ? "Playlist,Episode,Season,Folder" : "BoxSet,Playlist,Episode,Season,Folder"
    else if isStringEqual(collType, CollectionType.MOVIES) or isStringEqual(collType, CollectionType.TVSHOWS)
        m.loadItemsTask.collapseBoxSetItems = groupCollections
        m.loadItemsTask.excludeItemTypes = groupCollections ? "" : "BoxSet"
        if groupCollections
            if isStringEqual(collType, CollectionType.MOVIES)
                m.loadItemsTask.itemType = "Movie,BoxSet"
            else
                m.loadItemsTask.itemType = "Series,BoxSet"
            end if
        end if
    end if

    ' We're in a genre sub folder
    isGenreSubFolder = isValid(m.top.parentItem.json) and (isStringEqual(m.top.parentItem.json.type, "Genre") or isStringEqual(m.top.parentItem.json.type, "MusicGenre"))
    if isValid(m.top.parentItem.parentFolder) and isGenreSubFolder and not isStringEqual(getCollectionType(), CollectionType.BOXSET)
        if not inArray([ItemType.PHOTOALBUM, ItemType.MUSICVIDEO], m.top.mediaType)
            m.loadItemsTask.passToItem = {
                libraryID: m.top.parentItem.libraryID
            }

            m.loadItemsTask.itemId = m.top.parentItem.parentFolder
            m.loadItemsTask.genreIds = m.top.parentItem.id
        end if
    end if

    ' We're inside a music video genre sub folder
    if isStringEqual(m.top.mediaType, ItemType.MUSICVIDEO)
        if isStringEqual(chainLookup(m.top.parentItem, "itemType"), `${ItemType.MUSICVIDEO},${ItemType.FOLDER}`)
            m.loadItemsTask.itemId = m.top.parentItem.id
            m.loadItemsTask.genreIds = m.top.parentItem.id
            m.loadItemsTask.itemType = ItemType.MUSICVIDEO
            m.loadItemsTask.recursive = true
        end if
    end if

    ' Folder view lists one level at a time rather than everything underneath it, so the
    ' folders themselves come back alongside the items
    if m.folderView and not isValid(m.top.genreFilter) and not isValid(m.top.studioFilter)
        m.loadItemsTask.recursive = false
        if isValidAndNotEmpty(m.loadItemsTask.itemType)
            m.loadItemsTask.itemType = `${m.loadItemsTask.itemType},${ItemType.FOLDER}`
        end if
    end if

    m.playlistGrouped = playlistGroupingOn()
    m.itemGrid.visible = not m.playlistGrouped
    m.groupRows.visible = m.playlistGrouped

    applyLetterNav()
    m.emptyText.visible = false

    showDetails = get_user_setting_bool("ui.library.showMediaDetails", true)
    m.infoGroup.visible = showDetails
    m.selectedItemName.visible = showDetails

    applyGridMetrics()

    ' Genres view hides metadata
    if isStringEqual(m.view, "Genres")
        m.infoGroup.visible = false
        m.selectedItemName.visible = false
    end if

    applyGridMetrics()

    m.loadItemsTask.observeField("content", "ItemDataLoaded")
    m.loadItemsTask.control = TaskControl.RUN

    m.getFiltersTask.observeField("filters", "FilterDataLoaded")
    m.getFiltersTask.params = {
        userid: m.global.session.user.id,
        parentid: m.top.parentItem.Id,
        includeitemtypes: m.loadItemsTask.itemType
    }
    m.getFiltersTask.control = "RUN"

    updateStatusBar()
end sub

' Every card in the grid agrees on one set of numbers, worked out the way the other
' clients work them out. A subtitle anywhere in the library buys a second line on all of
' them so the rows stay level.
' A subtitle anywhere in the library buys a second line on every card, so the rows stay
' level. Once one turns up the grid is laid out again to make room.
sub noteCardSubtitles(itemData as object)
    if m.hasCardSubtitles = true then return

    detailed = detailedSubHeadings()

    for each item in itemData
        json = item.json
        if isValid(json)
            isFolder = json.IsFolder = true and not libraryCard.DetailedFolderType(json.Type ?? "")
            if libraryCard.Subtitle(json, isFolder, detailed) <> ""
                m.hasCardSubtitles = true
                applyGridMetrics()
                return
            end if
        end if
    end for
end sub

sub applyGridMetrics()
    libraryId = getParentItemId()

    imageSize = settingOr(`library_imageSize_${libraryId}`, "medium")
    imageType = settingOr(`library_imageType_${libraryId}`, defaultImageType())
    showText = settingOr(`library_cardText_${libraryId}`, "on") <> "off"

    metrics = libraryCard.Metrics(imageSize, imageType, showText, m.hasCardSubtitles = true, detailedSubHeadings())
    if m.playlistGrouped = true
        metrics = groupedCardMetrics()
        m.groupRows.itemSize = [libraryCard.GRID_WIDTH, metrics.cellHeight]
        m.groupRows.rowItemSize = [[metrics.cellWidth, metrics.cellHeight]]
        m.groupRows.rowItemSpacing = [[GROUPED_CARD_GAP - (metrics.padX * 2), 0]]
        m.groupRows.itemSpacing = [0, GROUPED_ROW_GAP]
    end if
    m.global.addFields({ libraryCardMetrics: metrics })
    m.global.libraryCardMetrics = metrics

    m.itemGrid.itemSize = [metrics.cellWidth, metrics.cellHeight]
    m.itemGrid.rowHeights = [metrics.cellHeight]
    m.itemGrid.numColumns = metrics.columns
    m.itemGrid.itemSpacing = [0, 0]

    m.loadItemsTask.numberOfColumns = metrics.columns
end sub

' A grouped row draws square cards of one size with only a title under each, whatever the
' grid is set to
function groupedCardMetrics() as object
    metrics = libraryCard.MetricsFor(GROUPED_CARD_SIZE, GROUPED_CARD_SIZE, "square", libraryCard.TEXT_HEIGHT_TITLE_ONLY, detailedSubHeadings(), libraryCard.GRID_WIDTH)
    metrics.cellWidth = GROUPED_CARD_SIZE + (metrics.padX * 2)
    metrics.posterWidth = GROUPED_CARD_SIZE
    return metrics
end function

function isPlaylistLibrary() as boolean
    if isValid(m.top.genreFilter) or isValid(m.top.studioFilter) then return false
    return isStringEqual(getCollectionType(), "playlists")
end function

' A playlist library shows a row per kind of playlist, unless it is listing its folders
function playlistGroupingOn() as boolean
    if not isPlaylistLibrary() or m.folderView = true then return false
    return get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true)
end function

function detailedSubHeadings() as boolean
    return settingOr("ui.library.detailedSubHeadings", "true") <> "false"
end function

function defaultImageType() as string
    if inArray([ItemType.PHOTO, ItemType.PHOTOALBUM, ItemType.MUSICVIDEO], m.top.mediaType) then return "thumbnail"
    if isStringEqual(m.view, "Episodes") then return "thumbnail"
    if isStringEqual(m.view, "Albums") or inArray([ItemType.PLAYLIST, ItemType.MUSICARTIST], m.top.mediaType) then return "square"
    return "poster"
end function

' Which grids this library can put up. Nothing in the other clients offers this, so it
' leads the dialog rather than being dropped.
function availableViews() as object
    if isMusicLibrary()
        views = [
            { key: "Artists", label: tr("Artists") },
            { key: "Albums", label: tr("Albums") }
        ]
        if not isValid(m.top.genreFilter) then views.push({ key: "Genres", label: tr("Genres") })
        return views
    end if

    views = [{ key: "presentation", label: tr("Presentation") }]

    ' A genre browse, a studio browse, a boxset and a folder inside a genre are each one
    ' grid already
    if isValid(m.top.genreFilter) or isValid(m.top.studioFilter) then return views
    if isValid(m.top.parentItem.parentFolder) then return views
    if inArray([ItemType.BOXSET, CollectionType.BOXSETS, ItemType.MYLIST], getCollectionType()) then return views

    views.push({ key: "Genres", label: tr("Genres") })
    if isStringEqual(m.top.mediaType, ItemType.SERIES)
        views.push({ key: "Episodes", label: tr("Episodes") })
    end if

    return views
end function

function isMusicLibrary() as boolean
    return isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
end function

function isMyListLibrary() as boolean
    return isStringEqual(getCollectionType(), ItemType.MYLIST)
end function

' A shape written by an older build could be missing whatever has been added since, so
' the stored values fill in over a full set rather than standing in for one
function storedFilterState(itemId as string) as object
    state = libraryFilters.EmptyState()
    stored = m.global.session.user.settings["display." + itemId + ".filterState"]
    if not isValidAndNotEmpty(stored) then return state

    parsed = ParseJson(stored)
    if not isValid(parsed) then return state

    for each key in parsed
        if state.doesExist(key) then state[key] = parsed[key]
    end for
    return state
end function

sub openSettingsDialog()
    m.settingsDialog.context = {
        libraryName: m.libraryName.text,
        kind: isValid(m.top.genreFilter) ? tr("Genre") : isValid(m.top.studioFilter) ? tr("Studio") : tr("Libraries"),
        showImageType: not isStringEqual(defaultImageType(), "square"),
        showFolderView: not isValid(m.top.genreFilter) and not isValid(m.top.studioFilter),
        showGroupByType: isPlaylistLibrary()
    }

    libraryId = getParentItemId()
    m.settingsDialog.settings = {
        imageSize: settingOr(`library_imageSize_${libraryId}`, "medium"),
        imageType: settingOr(`library_imageType_${libraryId}`, defaultImageType()),
        cardText: settingOr(`library_cardText_${libraryId}`, "on"),
        letterNav: settingOr(`library_letterNav_${libraryId}`, "on"),
        folderView: settingOr(`library_folderView_${libraryId}`, "off"),
        groupByType: get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true) ? "on" : "off"
    }
    m.settingsDialog.callFunc("showDialog")

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.settingsDialog
end sub

' Every row takes effect as it is stepped on, so this runs once per press
sub onSettingsApplied(msg as object)
    applied = msg.getData()
    if not isValid(applied) then return

    libraryId = getParentItemId()
    wasFolderView = settingOr(`library_folderView_${libraryId}`, "off")

    set_user_setting(`library_imageSize_${libraryId}`, applied.imageSize)
    set_user_setting(`library_imageType_${libraryId}`, applied.imageType)
    set_user_setting(`library_cardText_${libraryId}`, applied.cardText)
    set_user_setting(`library_letterNav_${libraryId}`, applied.letterNav)
    set_user_setting(`library_folderView_${libraryId}`, applied.folderView)

    wasGrouped = get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true) ? "on" : "off"
    if isValid(applied.groupByType) then set_user_setting(PLAYLIST_GROUPING_SETTING, applied.groupByType = "on" ? "true" : "false")

    applyLetterNav()

    ' Listing folders rather than everything inside them is a different query, and grouping
    ' needs every playlist loaded
    if not isStringEqual(wasFolderView, applied.folderView) or (isValid(applied.groupByType) and not isStringEqual(wasGrouped, applied.groupByType))
        resetLoadedItems()
        loadInitialItems()
        return
    end if

    redrawItems()
end sub

' The alphabet strip is the only toolbar item that can be turned off, so focus skips over
' it while it is gone
sub applyLetterNav()
    m.alphaPicker.visible = settingOr(`library_letterNav_${getParentItemId()}`, "on") <> "off" and not m.playlistGrouped
end sub

sub openSortDialog()
    m.sortDialog.context = {
        views: availableViews(),
        isSeries: isStringEqual(m.top.mediaType, ItemType.SERIES),
        isMusic: isMusicLibrary(),
        isMyList: isMyListLibrary(),
        showVideoFilters: not isMusicLibrary() and not isStringEqual(m.top.mediaType, ItemType.PLAYLIST),
        namesOnly: isStringEqual(m.view, "Genres")
    }
    m.sortDialog.state = {
        view: m.view,
        sortKey: m.sortKey,
        sortOrder: m.sortOrder,
        filters: m.filterState
    }
    m.sortDialog.callFunc("showDialog")

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.sortDialog
end sub

' Every choice in the dialog takes effect as it is made, so this runs on each one rather
' than once at the end
sub onSortApplied(msg as object)
    applied = msg.getData()
    if not isValid(applied) then return

    itemId = m.top.parentItem.Id

    if not isStringEqual(applied.view, m.view)
        previousView = m.view
        m.view = applied.view
        set_user_setting("display." + itemId + ".landing", m.view)

        ' Episodes draws a different card, so the grid is rebuilt around it
        if inArray([previousView, m.view], "Episodes")
            m.top.removeChild(m.itemGrid)
            m.itemGridCounter++
            createItemGrid(`itemGrid${m.itemGridCounter}`)
        end if

        clearSearchQuery()
        m.top.alphaSelected = string.EMPTY
        m.loadItemsTask.nameStartsWith = " "

        if not isStringEqual(m.view, "Genres")
            set_user_setting(`display.${m.top.mediaType}library.defaultview`, m.view)
        end if
    end if

    option = librarySorts.Chosen(applied.sortKey, isMusicLibrary(), isMyListLibrary())
    m.sortKey = option.value
    m.sortOrder = isValidAndNotEmpty(applied.sortOrder) ? applied.sortOrder : option.order
    m.sortField = option.field
    m.sortAscending = isStringEqual(m.sortOrder, "Ascending")
    m.filterState = applied.filters

    set_user_setting("display." + itemId + ".sortField", m.sortField)
    set_user_setting("display." + itemId + ".sortAscending", m.sortAscending ? "true" : "false")
    set_user_setting("display." + itemId + ".filterState", FormatJson(m.filterState))

    resetLoadedItems()
    loadInitialItems()
end sub

' A dialog left open while the grid reloads would lose focus to it, since setting the
' grid's content takes focus back
sub restoreDialogFocus(group as object)
    for each dialog in [m.sortDialog, m.settingsDialog]
        if dialog.visible
            dialog.callFunc("focusDialog")
            group.lastFocus = dialog
            return
        end if
    end for
end sub

sub onSortClosed()
    m.itemGrid.setFocus(m.itemGrid.opacity = 1)
    m.genreGrid.setFocus(m.genreGrid.opacity = 1)

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.itemGrid.opacity = 1 ? m.itemGrid : m.genreGrid
end sub

' What the library holds, for the genre, rating, tag, year and language groups
sub FilterDataLoaded(msg as object)
    m.getFiltersTask.unobserveField("filters")

    data = msg.GetData()
    if isValid(data) then m.sortDialog.facets = data
end sub

sub ItemDataLoaded(msg)
    itemData = msg.GetData()
    itemCount = itemData.count()
    m.serverPosition += itemCount

    ' Unobserve to prevent multiple callbacks
    m.loadItemsTask.unobserveField("content")
    m.loadItemsTask.content = []

    if not isValid(itemData)
        if m.loadedItems = 0
            m.emptyText.text = tr("Error loading items. Please check your connection and try again.")
            m.emptyText.visible = true
        end if
        m.Loading = false
        stopLoadingSpinner()
        return
    end if

    ' Client-side fallback: filter out BoxSets (API may not honor ExcludeItemTypes)
    if m.loadItemsTask.excludeItemTypes <> ""
        filteredData = []
        for each item in itemData
            if item.type <> "Boxset" and item.type <> "BoxSet"
                filteredData.push(item)
            end if
        end for
        itemData = filteredData
    end if

    shownData = parentalControls.WithoutBlockedItems(itemData)
    m.blockedCount += itemData.count() - shownData.count()
    itemData = shownData
    itemCount = itemData.count()

    if isStringEqual(m.view, "Genres")
        ' Reset genre grid data
        m.genreData.removeChildren(m.genreData.getChildren(-1, 0))

        for each item in itemData
            m.genreData.appendChild(item)
        end for

        m.loadedItems = m.genreData.getChildCount()

        m.itemGrid.opacity = 0
        m.genreGrid.opacity = 1

        m.genreGrid.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = m.genreGrid

        stopLoadingOperation()

        restoreDialogFocus(group)

        if m.loadedItems = 0
            m.emptyText.text = tr("No items found. Try adjusting your selected filters.")
            m.emptyText.visible = true
        end if

        updateStatusBar()
        return
    end if

    m.itemGrid.opacity = "1"
    m.genreGrid.opacity = "0"

    ' A page arriving behind the open keyboard must not pull focus out of it, and a later page
    ' of grouped playlists leaves focus wherever it is
    if not isValid(m.keyboard) and not (m.playlistGrouped and m.loadedItems > 0)
        contentList = m.playlistGrouped ? m.groupRows : m.itemGrid
        contentList.setFocus(true)
        m.genreGrid.setFocus(false)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = contentList
    end if

    if m.data.getChildCount() = 0
        m.itemGrid.jumpToItem = 0
    end if

    for each item in itemData
        m.allItems.push(item)
    end for
    noteCardSubtitles(itemData)

    if m.searchQuery = ""
        m.data.appendChildren(itemData)
    else
        applySearchFilter()
    end if

    ' Update the stored counts
    m.loadedItems = m.loadedItems + itemCount
    m.loadedRows = m.loadedItems / m.itemGrid.numColumns

    if m.playlistGrouped
        refreshPlaylistGroups()
        queueCategoryChecks(itemData)
    end if

    ' If there are no items to display, show message
    if m.loadedItems = 0
        m.infoGroup.visible = false
        m.selectedItemName.visible = false

        SetName(string.EMPTY)
        clearMetaRow()

        m.emptyText.text = tr("No items found. Try adjusting your selected filters.")
        m.emptyText.visible = true
    end if

    m.Loading = false
    stopLoadingSpinner()

    restoreDialogFocus(m.global.sceneManager.callFunc("getActiveScene"))

    updateStatusBar()

    ' Grouping sorts the whole library, so the rest of it loads without waiting to be scrolled to
    if m.playlistGrouped then loadMoreData()
end sub

' Set Selected Name
sub SetName(itemName as string)
    m.selectedItemName.text = itemName
end sub

sub clearMetaRow()
    setFieldText("selectedItemProductionYear", "")
    setFieldText("runtime", "")
    m.top.findNode("seriesStatusPill").visible = false
    m.top.findNode("officialRatingPill").visible = false
end sub

' Handle new item being focused
sub onItemFocused()
    itemInt = m.itemGrid.itemFocused

    if itemInt = -1
        return
    end if

    ' Lazy loading: Load more items when user is near the end
    focusedRow = m.itemGrid.currFocusRow
    if m.loadItemsTask.totalRecordCount > m.serverPosition
        if focusedRow >= m.loadedRows - 3
            loadMoreData()
        end if
    end if

    showFocusedItem()
end sub

' The name, facts and backdrop of whatever card has focus
sub showFocusedItem()
    clearLibraryPluginRatings()

    focusedItem = getItemFocused()

    if not isChainValid(focusedItem, "json")
        return
    end if

    itemData = focusedItem.json

    populateRatings(itemData)

    if moonfinPlugin.IsRatingsEnabled()
        fetchLibraryRatings(itemData)
    end if

    if isValid(itemData.Name)
        SetName(itemData.Name)
    else
        SetName(string.EMPTY)
    end if

    ' Genres rows carry no per-item metadata, so the detail bar stays hidden on that view
    showDetails = get_user_setting_bool("ui.library.showMediaDetails", true) and not isStringEqual(m.view, "Genres")
    m.selectedItemName.visible = showDetails

    drawMetaRow(itemData)

    if not showDetails then m.infoGroup.visible = false

    backdropUri = ""
    if isValid(m.backdrop) and not get_user_setting_bool("ui.library.hideBackdrops", false)
        if isValidAndNotEmpty(itemData.BackdropImageTags)
            backdropUri = getBlurredImageURL(itemData.Id, "Backdrop", itemData.BackdropImageTags[0])
        else if isValidAndNotEmpty(itemData.ImageTags) and isValidAndNotEmpty(itemData.ImageTags.Primary)
            backdropUri = getBlurredImageURL(itemData.Id, "Primary", itemData.ImageTags.Primary)
        end if
    end if

    if isValidAndNotEmpty(backdropUri)
        ' startBackdropCrossfade reads this to place the outgoing image
        m.backdropTargetOpacity = 0.3
        startBackdropCrossfade(backdropUri)
    else
        clearFocusedItemBackdrop()
    end if

    updateStatusBar()
end sub

' The community star and the critic score sit in the ratings row beside whatever the
' plugin returns, rather than in the metadata line
sub populateRatings(itemData as object)
    m.serverRatings = ratingsRow.ServerEntries(itemData)
    renderRatingsRow([])
end sub

sub renderRatingsRow(pluginRatings as object)
    if not isValid(m.pluginRatings) then return

    m.pluginRatings.showBadges = get_user_setting_bool("plugin.mdblist.showRatingBadges", true)

    entries = ratingsRow.Merge(m.serverRatings, pluginRatings)
    m.pluginRatings.ratingsData = { data: entries }
    m.pluginRatings.visible = entries.count() > 0
end sub

' A series has no single runtime, and only a series carries a status worth a pill
sub drawMetaRow(itemData as object)
    isSeries = isStringEqual(itemData.Type ?? "", "Series")

    setFieldText("selectedItemProductionYear", isValid(itemData.ProductionYear) ? itemData.ProductionYear.toStr() : "")

    runtime = ""
    if not isSeries
        runtime = libraryCard.FormatDuration(itemData.RunTimeTicks)
        if runtime = "0m" then runtime = ""
    end if
    setFieldText("runtime", runtime)

    status = itemData.Status ?? ""
    showStatus = isSeries and isValidAndNotEmpty(status)
    if showStatus
        fillPill("seriesStatusFill", "seriesStatusLabel", tr(status))
        m.top.findNode("seriesStatusFill").blendColor = isStringEqual(status, "Continuing") ? "#22C55E" : "#EF4444"
        m.top.findNode("seriesStatusFill").opacity = 1
    end if
    m.top.findNode("seriesStatusPill").visible = showStatus

    rating = itemData.OfficialRating ?? ""
    showRating = isValidAndNotEmpty(rating) and not isStringEqual(itemData.Type ?? "", "Playlist")
    if showRating then fillPill("officialRatingFill", "selectedItemOfficialRating", rating)
    m.top.findNode("officialRatingPill").visible = showRating
end sub

' A pill is only as wide as the words it holds, plus the padding the other clients give it
sub fillPill(fillId as string, labelId as string, text as string)
    label = m.top.findNode(labelId)
    fill = m.top.findNode(fillId)

    label.text = text

    ' A label given a width reports that width back rather than the width of its text, so
    ' the last size it was given has to go before this one can be measured
    label.width = 0
    width = label.boundingRect().width + PILL_PAD_X

    label.width = width
    label.height = PILL_HEIGHT
    fill.width = width
    fill.height = PILL_HEIGHT
end sub

function getBlurredImageURL(itemId as string, imageType as string, imageTag as string) as string
    params = {
        "maxHeight": 1080,
        "maxWidth": 1920,
        "quality": 90,
        "blur": getHomeBackdropBlurAmount(),
        "Tag": imageTag
    }
    return ImageURL(itemId, imageType, params)
end function

sub clearLibraryPluginRatings()
    if isValid(m.pluginRatings)
        m.pluginRatings.ratingsData = invalid
        m.pluginRatings.visible = false
    end if

    if isValid(m.libraryRatingsDebounce)
        m.libraryRatingsDebounce.control = "stop"
    end if
    m.pendingLibraryRatingsItem = invalid

    if isValid(m.libraryRatingsTask)
        m.libraryRatingsTask.unobserveFieldScoped("ratings")
        m.libraryRatingsTask = invalid
    end if
end sub

sub fetchLibraryRatings(itemData as object)
    tmdbId = moonfinPlugin.GetTmdbId(itemData.ProviderIds ?? invalid)
    if tmdbId = "" then return

    itemType = itemData.Type ?? ""
    if itemType = "" then return

    ' Debounce so rapid grid scrolling doesn't fire a request per focus change
    m.pendingLibraryRatingsItem = itemData
    m.libraryRatingsDebounce = moonfinPlugin.StartRatingsDebounce(m.libraryRatingsDebounce, "onLibraryRatingsDebounceFired")
end sub

sub onLibraryRatingsDebounceFired()
    itemData = m.pendingLibraryRatingsItem
    if not isValid(itemData) then return
    m.pendingLibraryRatingsItem = invalid

    if isValid(m.libraryRatingsTask)
        m.libraryRatingsTask.unobserveFieldScoped("ratings")
        m.libraryRatingsTask = invalid
    end if

    m.libraryRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.libraryRatingsTask.itemData = itemData
    m.libraryRatingsTask.observeFieldScoped("ratings", "onLibraryRatingsLoaded")
    m.libraryRatingsTask.control = "RUN"
end sub

sub onLibraryRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) then return

    displayRatings = result.data
    if not isValidAndNotEmpty(displayRatings) then return

    renderRatingsRow(chainLookupReturn(result, "data", []))
end sub

' Load next batch of items for pagination
sub loadMoreData()
    if m.Loading = true then return
    if m.serverPosition >= m.loadItemsTask.totalRecordCount then return

    startLoadingSpinner(false)
    m.Loading = true
    m.loadItemsTask.startIndex = m.serverPosition
    m.loadItemsTask.observeField("content", "ItemDataLoaded")
    m.loadItemsTask.control = TaskControl.RUN
end sub

' Item Selected
sub onItemSelected()
    m.top.selectedItem = m.itemGrid.content.getChild(m.itemGrid.itemSelected)
    m.top.selectedItem = invalid
end sub

' Returns Focused Item
function getItemFocused()
    if m.groupRows.isinFocusChain()
        return groupRowItemAt(m.groupRows.rowItemFocused)
    else if m.itemGrid.isinFocusChain()
        return getItemGridFocusedItem(m.itemGrid)
    else if m.genreGrid.isinFocusChain() and m.genreGrid.itemFocused >= 0
        return m.genreGrid.content.getChild(m.genreGrid.itemFocused)
    end if
    return invalid
end function

sub onGroupItemFocused()
    showFocusedItem()
end sub

sub onGroupItemSelected()
    selected = groupRowItemAt(m.groupRows.rowItemSelected)
    if not isValid(selected) then return
    m.top.selectedItem = selected
    m.top.selectedItem = invalid
end sub

function groupRowItemAt(position as dynamic) as dynamic
    if not isValid(position) or position.count() < 2 or not isValid(m.groupRows.content) then return invalid
    row = m.groupRows.content.getChild(position[0])
    if not isValid(row) then return invalid
    return row.getChild(position[1])
end function

' Each kind of playlist gets its own row, and focus stays on the playlist it was on
sub refreshPlaylistGroups()
    focusedId = ""
    focusedItem = getItemFocused()
    if isValid(focusedItem) then focusedId = chainLookupReturn(focusedItem, "json.Id", "")

    root = createSGNode("ContentNode")
    target = invalid
    rowIndex = 0
    for each group in playlistGrouping.Group(filteredItems(), m.playlistCategories)
        row = root.createChild("ContentNode")
        row.title = group.label
        row.appendChildren(group.items)
        if focusedId <> ""
            for column = 0 to group.items.count() - 1
                if isStringEqual(chainLookupReturn(group.items[column], "json.Id", ""), focusedId) then target = [rowIndex, column]
            end for
        end if
        rowIndex++
    end for

    m.groupRows.content = root
    if isValid(target) then m.groupRows.jumpToRowItem = target

    m.emptyText.visible = root.getChildCount() = 0 and m.loadedItems > 0
    if m.emptyText.visible then m.emptyText.text = tr("No items found")
end sub

' Playlists that could be more than one kind are looked into, each only once
sub queueCategoryChecks(items as object)
    for each item in items
        json = item.json
        if not isValid(json) then continue for
        playlistId = toString(json.LookupCI("Id"))
        if playlistGrouping.NeedsItemCheck(json) and not m.playlistAttempted.DoesExist(playlistId)
            m.playlistAttempted[playlistId] = true
            m.playlistQueue.push({ id: playlistId, summary: playlistGrouping.SummaryCategory(json) })
        end if
    end for
    runCategoryTask()
end sub

sub runCategoryTask()
    if m.playlistQueue.count() = 0 or m.categoryTask.state = "run" then return
    m.categoryTask.playlists = m.playlistQueue
    m.playlistQueue = []
    m.categoryTask.control = TaskControl.RUN
end sub

sub onPlaylistCategories(event as object)
    resolved = event.getData()
    if not isValid(resolved) then return
    m.playlistCategories.Append(resolved)
    if m.playlistGrouped then refreshPlaylistGroups()
end sub

' Playlists that turned up while a look was running go once it finishes
sub onCategoryTaskState()
    if m.categoryTask.state = "stop" then runCategoryTask()
end sub

sub onGenreItemSelected()
    selectedGenre = m.genreGrid.content.getChild(m.genreGrid.itemSelected)
    if not isValid(selectedGenre) or not isValid(selectedGenre.json) then return

    genreData = selectedGenre.json

    m.top.genreItemSelected = {
        genreId: genreData.id,
        genreName: genreData.Name,
        libraryId: genreData.libraryId,
        itemType: genreData.itemType,
        mediaType: m.top.mediaType,
        collectionType: getCollectionType()
    }
end sub

' Everything the grid was showing goes, so a fresh page does not land beside the old one
sub resetLoadedItems()
    m.loadedRows = 0
    m.loadedItems = 0
    m.serverPosition = 0
    m.blockedCount = 0
    m.allItems = []
    m.searchNames = []
    m.data = createSGNode("ContentNode")
    m.itemGrid.content = m.data
end sub

' The query narrows what is already loaded rather than asking the server again, so the
' grid answers on every keystroke
sub applySearchFilter()
    m.data = createSGNode("ContentNode")
    m.data.appendChildren(filteredItems())

    m.itemGrid.content = m.data
    if m.playlistGrouped then refreshPlaylistGroups()
    updateStatusBar()

    ' Handing the grid new content puts focus back on it, which would send the next
    ' keystroke to a poster rather than the keyboard still standing open over it
    if isValid(m.keyboard) then m.keyboard.setFocus(true)
end sub

function filteredItems() as object
    query = accentFolding.ForSearch(m.searchQuery.Trim())
    if query = "" then return m.allItems

    ' Folding costs more than matching, so each name is only folded once
    for i = m.searchNames.count() to m.allItems.count() - 1
        m.searchNames.push(sortableName(m.allItems[i]))
    end for

    matches = []
    for i = 0 to m.allItems.count() - 1
        if m.searchNames[i].instr(query) <> -1 then matches.push(m.allItems[i])
    end for
    return matches
end function

' The server sorts on SortName, so a query is matched against that where it exists
function sortableName(item as object) as string
    name = chainLookupReturn(item, "json.SortName", "")
    if not isValidAndNotEmpty(name) then name = chainLookupReturn(item, "json.Name", "")
    return accentFolding.ForSearch(name)
end function

sub onSearchQueryChanged(event as object)
    m.searchQuery = event.getData()
    m.searchBox.query = m.searchQuery
    applySearchFilter()

    ' A match further into the library than the pages loaded so far only turns up once
    ' more of it has arrived, so a pause in the typing fetches the next page
    if isValid(m.searchPageTimer) then m.searchPageTimer.control = "stop"
    if m.searchQuery.Trim() = "" then return

    if not isValid(m.searchPageTimer)
        m.searchPageTimer = createObject("roSGNode", "Timer")
        m.searchPageTimer.duration = 0.3
        m.searchPageTimer.repeat = false
        m.searchPageTimer.observeField("fire", "onSearchPageTimer")
    end if
    m.searchPageTimer.control = "start"
end sub

sub clearSearchQuery()
    m.searchQuery = ""
    m.searchBox.query = ""
end sub

sub onSearchPageTimer()
    if m.serverPosition < m.loadItemsTask.totalRecordCount then loadMoreData()
end sub

sub openSearchKeyboard()
    m.keyboard = tvKeyboard.Open(m.top.getScene(), {
        hint: tr("Search this library..."),
        text: m.searchQuery,
        showScrim: false
    })
    if not isValid(m.keyboard) then return

    m.keyboard.observeField("text", "onSearchQueryChanged")
    m.keyboard.observeField("submitted", "closeSearchKeyboard")
    m.keyboard.observeField("cancelled", "closeSearchKeyboard")
end sub

sub closeSearchKeyboard(_event as object)
    tvKeyboard.Release(m.keyboard, ["text", "submitted", "cancelled"])
    m.keyboard = invalid
    focusToolbarItem(4)
end sub

sub alphaSelectedChanged()
    ' Allow user to toggle by clicking letter twice
    if isStringEqual(m.loadItemsTask.nameStartsWith, m.top.alphaSelected)
        m.top.alphaSelected = string.EMPTY
    end if

    resetLoadedItems()

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData

    m.loadItemsTask.nameStartsWith = m.top.alphaSelected
    loadInitialItems()
end sub


sub createItemGrid(itemGridID = "itemGrid" as string)
    m.itemGrid = createObject("rosgnode", "MarkupGrid")
    m.itemGrid.id = itemGridID
    m.itemGrid.itemSpacing = "[20, 20]"
    m.itemGrid.vertFocusAnimationStyle = "fixed"
    m.itemGrid.translation = "[87, 316]"
    m.itemGrid.observeField("itemFocused", "onItemFocused")
    m.itemGrid.observeFieldScoped("itemSelected", "onItemSelected")
    m.itemGrid.drawFocusFeedback = false
    m.itemGrid.itemComponentName = "LibraryCard"

    m.top.insertChild(m.itemGrid, 1)
    applyGridMetrics()
end sub

' =====================================================================
' STATUS BAR
' =====================================================================

' The count sits beside the library name, and is re-centred as it changes width
sub updateStatusBar()
    totalCount = m.loadItemsTask.totalRecordCount - m.blockedCount
    m.itemCountLabel.text = totalCount > 0 ? `${totalCount} ${tr("Items")}` : ""
    centreTitleRow()
end sub

' The name and the count read as one line, so the pair is centred rather than each of them
sub centreTitleRow()
    nameWidth = m.libraryName.boundingRect().width
    countWidth = m.itemCountLabel.boundingRect().width
    gap = countWidth > 0 ? 17 : 0

    startX = (1920 - (nameWidth + gap + countWidth)) / 2
    m.libraryName.translation = [startX, 20]
    m.itemCountLabel.translation = [startX + nameWidth + gap, 22]
end sub


' =====================================================================
' TOOLBAR FOCUS MANAGEMENT
' =====================================================================

sub focusToolbarItem(index as integer)
    ' The alphabet strip is the one toolbar item that can be turned off, so focus lands
    ' back on the gear rather than on nothing
    if index = 3 and not m.alphaPicker.visible then index = 2

    for each btn in m.toolbarButtons
        btn.focus = false
    end for

    m.toolbarFocusIndex = index
    m.searchBox.focused = index = 4

    if index >= 0 and index < m.toolbarButtons.count()
        m.toolbarButtons[index].focus = true
        m.toolbarButtons[index].setFocus(true)
        setLastFocus(m.toolbarButtons[index])
    else if index = 3
        m.alphaGrid.setFocus(true)
        setLastFocus(m.alphaGrid)
    else if index = 4
        m.searchBox.setFocus(true)
        setLastFocus(m.searchBox)
    end if
end sub

' The list under the toolbar, which is the grouped rows while playlists are grouped
sub focusContent()
    if m.loadedItems = 0 then return
    if m.playlistGrouped
        m.groupRows.setFocus(true)
        setLastFocus(m.groupRows)
        return
    end if
    m.itemGrid.setFocus(m.itemGrid.opacity = 1)
    m.genreGrid.setFocus(m.genreGrid.opacity = 1)
    setLastFocus(m.itemGrid.opacity = 1 ? m.itemGrid : m.genreGrid)
end sub

sub unfocusAllToolbarItems()
    m.searchBox.focused = false
    for each btn in m.toolbarButtons
        btn.focus = false
    end for
end sub

' =====================================================================
' KEY EVENT HANDLER
' =====================================================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.searchBox.isInFocusChain()
        if isStringEqual(key, KeyCode.OK)
            openSearchKeyboard()
            return true
        end if

        if isStringEqual(key, KeyCode.LEFT)
            focusToolbarItem(3)
            return true
        end if

        if isStringEqual(key, KeyCode.DOWN)
            m.searchBox.focused = false
            focusToolbarItem(0)
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            reclaimResources()
            m.global.sceneManager.callfunc("popScene")
            return true
        end if

        return true
    end if

    ' ---- TOOLBAR ICON NAVIGATION ----
    if m.homeButton.isInFocusChain() or m.sortButton.isInFocusChain() or m.settingsButton.isInFocusChain()
        if isStringEqual(key, KeyCode.RIGHT)
            if m.homeButton.isInFocusChain()
                focusToolbarItem(1)
                return true
            else if m.sortButton.isInFocusChain()
                focusToolbarItem(2)
                return true
            else if m.settingsButton.isInFocusChain()
                unfocusAllToolbarItems()
                focusToolbarItem(3)
                return true
            end if
        end if

        if isStringEqual(key, KeyCode.LEFT)
            if m.settingsButton.isInFocusChain()
                focusToolbarItem(1)
                return true
            else if m.sortButton.isInFocusChain()
                focusToolbarItem(0)
                return true
            end if
            ' At home button, LEFT does nothing
            return true
        end if

        if isStringEqual(key, KeyCode.UP)
            unfocusAllToolbarItems()
            focusToolbarItem(4)
            return true
        end if

        if isStringEqual(key, KeyCode.DOWN)
            unfocusAllToolbarItems()
            focusContent()
            return true
        end if

        if isStringEqual(key, KeyCode.OK)
            if m.homeButton.isInFocusChain()
                reclaimResources()
                m.global.sceneManager.callfunc("popScene")
                return true
            else if m.sortButton.isInFocusChain()
                openSortDialog()
                return true
            else if m.settingsButton.isInFocusChain()
                openSettingsDialog()
                return true
            end if
        end if

        if isStringEqual(key, KeyCode.BACK)
            reclaimResources()
            m.global.sceneManager.callfunc("popScene")
            return true
        end if

        return false
    end if

    ' ---- ALPHA PICKER NAVIGATION ----
    if m.alphaGrid.isInFocusChain()
        if isStringEqual(key, KeyCode.LEFT) and m.alphaGrid.itemFocused = 0
            ' Move from alpha to settings icon
            focusToolbarItem(2)
            return true
        end if

        if isStringEqual(key, KeyCode.UP)
            focusToolbarItem(4)
            return true
        end if

        if isStringEqual(key, KeyCode.DOWN)
            unfocusAllToolbarItems()
            focusContent()
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            reclaimResources()
            m.global.sceneManager.callfunc("popScene")
            return true
        end if

        return false
    end if

    ' ---- GROUPED PLAYLIST ROWS ----
    if m.groupRows.isInFocusChain()
        focused = m.groupRows.rowItemFocused
        atTop = not isValid(focused) or focused.count() < 1 or focused[0] = 0
        if isStringEqual(key, KeyCode.UP) and atTop
            focusToolbarItem(m.toolbarFocusIndex)
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            if not atTop
                m.groupRows.jumpToRowItem = [0, 0]
                return true
            end if
            reclaimResources()
            m.global.sceneManager.callfunc("popScene")
            return true
        end if

        return handleCardKey(key)
    end if

    ' ---- GRID / GENRE GRID NAVIGATION ----
    if m.itemGrid.isinFocusChain() or m.genreGrid.isinFocusChain()
        if isStringEqual(key, KeyCode.UP)
            gridComponent = m.itemGrid.isinFocusChain() ? m.itemGrid : m.genreGrid
            if gridComponent.itemFocused < gridComponent.numColumns
                ' At top row, move to toolbar
                focusToolbarItem(m.toolbarFocusIndex)
                return true
            end if
        end if

        if isStringEqual(key, KeyCode.BACK)
            gridComponent = m.itemGrid.isinFocusChain() ? m.itemGrid : m.genreGrid
            if gridComponent.itemFocused >= gridComponent.numColumns
                gridComponent.jumpToItem = 0
                return true
            end if
            reclaimResources()
            m.global.sceneManager.callfunc("popScene")
            return true
        end if

        return handleCardKey(key)
    end if

    return false
end function

' Play starts the focused card, or opens it when it is a photo, and Options opens its menu
function handleCardKey(key as string) as boolean
    if not isStringEqual(key, KeyCode.PLAY) and not isStringEqual(key, KeyCode.OPTIONS) then return false
    focusedItem = getItemFocused()
    if not isValid(focusedItem) then return false
    if isStringEqual(key, KeyCode.OPTIONS) then return showItemMenu(focusedItem)

    if isStringEqual(ItemType.PHOTO, chainLookupReturn(focusedItem, "type", string.EMPTY))
        m.itemGrid.itemSelected = m.itemGrid.itemFocused
    else
        m.top.quickPlayNode = focusedItem
    end if
    return true
end function

' =====================================================================
' CARD MENU
' =====================================================================

' The menu changed a card here, so its badges follow
sub itemMenuChanged(action as string, card as dynamic, menuJson as object)
    if type(card) <> "roSGNode" then return

    userData = menuJson.UserData
    if type(userData) <> "roAssociativeArray" then return

    if action = "watched" or action = "hideContinueWatching" or action = "hideNextUp"
        ' Unwatched puts the whole count back, which the card works out when given none
        card.callFunc("setWatched", itemMenu.IsTrue(userData.Played), 0)
    else if action = "favorite" and card.hasField("favorite")
        card.favorite = itemMenu.IsTrue(userData.IsFavorite)
    end if
end sub

sub reclaimResources()
    ' Stopping a task blocks the render thread until the task returns, and a request
    ' in flight is long enough for the watchdog to kill the channel. A running one is
    ' let go of instead, since every caller pops the scene straight after.
    if isValid(m.loadItemsTask)
        m.loadItemsTask.unobserveField("content")
        if not isStringEqual(m.loadItemsTask.state, "run")
            m.loadItemsTask.control = TaskControl.STOP
        end if
        m.loadItemsTask.content = []
    end if

    resetLoadedItems()

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData
end sub

' Items the search is hiding are in no list, so they are brought up to date as well
sub userDataApplied(changes as object)
    for each item in m.allItems
        userDataSync.ApplyToNode(item, changes)
    end for
end sub

' The age rating and series status badges, sized around whatever they are given
const PILL_PAD_X = 18
const PILL_HEIGHT = 26

' Grouped playlist cards sit this far apart, with this much room between rows for the next
' row's title
const GROUPED_CARD_GAP = 24
const GROUPED_ROW_GAP = 90
const PLAYLIST_GROUPING_SETTING = "ui.library.playlistsGroupByType"
' Synced poster sizes, which fall back to the general poster size
const LIBRARY_POSTER_SIZE_SETTING = "ui.library.posterSize"
const PLAYLIST_POSTER_SIZE_SETTING = "ui.library.playlistPosterSize"
const POSTER_SIZE_SETTING = "ui.posterSize"
const CARD_TITLES_SETTING = "ui.library.cardTitles"
' Group By's category chips sit above the grid and push it down this far
const CATEGORY_BAR_SPACE = 74
const CLASSIC_BUTTON_SIZE = 44
const CLASSIC_BUTTON_GAP = 3
const CLASSIC_BAR_TOP = 248

' Where each control sits in the toolbar focus order
const FOCUS_HOME = 0
const FOCUS_SORT = 1
const FOCUS_DISPLAY = 2
const FOCUS_LETTERS = 3
const FOCUS_SEARCH = 4
const FOCUS_SHOW = 5
const FOCUS_GROUP = 6
const FOCUS_SHUFFLE = 7

const LIBRARY_STYLE_SETTING = "ui.library.style"
const MARGIN_X = 87
' Modern's bar runs the grid's width under the title, its controls inset by the bar's padding
const MODERN_BAR_TOP = 80
const MODERN_BAR_HEIGHT = 84
const MODERN_BAR_PAD = 9
const MODERN_CONTROL_GAP = 6
const MODERN_GRID_TOP = 380
' Docked's panel holds every control, so the grid starts beside it and runs up to the details
const DOCK_PAD_X = 30
const DOCK_ROW_WIDTH = 390
const DOCK_TITLE_LEFT = 105
const DOCK_GRID_LEFT = 498
const DOCK_GRID_TOP = 200
const DOCK_GRID_WIDTH = 1335
const HEADER_CONTROL_HEIGHT = 66
const DOCK_ROW_HEIGHT = 72

' Return parent collection type
function getCollectionType() as string
    return m.top.parentItem.collectionType ?? m.top.parentItem.Type
end function


sub setupNodes()
    m.top.imageDisplayMode = "scaleToZoom"
    m.top.showItemTitles = "showonhover"

    ' Grid and lists
    m.sortDialog = m.top.findNode("sortDialog")
    m.displayDialog = m.top.findNode("displayDialog")
    m.groupDialog = m.top.findNode("groupDialog")
    m.dialogs = [m.sortDialog, m.displayDialog, m.groupDialog]
    m.itemGrid = m.top.findNode("itemGrid")
    m.horizontalGrid = m.top.findNode("horizontalGrid")
    m.grid = m.itemGrid
    m.categoryBar = m.top.findNode("categoryBar")
    m.genreGrid = m.top.findNode("genreGrid")
    m.emptyText = m.top.findNode("emptyText")

    ' Info display
    m.selectedItemName = m.top.findNode("selectedItemName")
    m.selectedItemProductionYear = m.top.findNode("selectedItemProductionYear")
    m.selectedItemOfficialRating = m.top.findNode("selectedItemOfficialRating")
    m.infoGroup = m.top.findNode("infoGroup")
    m.pluginRatings = m.top.findNode("pluginRatings")

    ' Header
    m.searchBox = m.top.findNode("searchBox")
    m.searchBox.placeholder = tr("Search this library...")

    m.libraryName = m.top.findNode("libraryName")
    m.libraryName.font.size = 38
    m.itemCountLabel = m.top.findNode("itemCount")
    m.itemCountLabel.font.size = 17

    m.selectedItemName.font.size = 29
    for each label in [m.top.findNode("selectedItemProductionYear"), m.top.findNode("runtime")]
        label.font.size = 20
    end for
    for each pill in [m.top.findNode("seriesStatusLabel"), m.top.findNode("selectedItemOfficialRating")]
        pill.font.size = 16
    end for

    ' Classic's icon buttons, indexed by their place in the focus order
    m.classicButtons = [m.top.findNode("homeButton"), m.top.findNode("sortButton"), m.top.findNode("settingsButton"), invalid, invalid, invalid, m.top.findNode("groupButton"), m.top.findNode("shuffleButton")]
    m.toolbarButtons = m.classicButtons

    ' The Modern and Docked controls
    m.focusedInfo = m.top.findNode("focusedInfo")
    m.styledHeader = m.top.findNode("styledHeader")
    m.dockPanel = m.top.findNode("dockPanel")
    m.dockEdge = m.top.findNode("dockEdge")
    m.dockRule = m.top.findNode("dockRule")
    m.modernBar = m.top.findNode("modernBar")
    m.modernBarBorder = m.top.findNode("modernBarBorder")
    m.modernRuleHome = m.top.findNode("modernRuleHome")
    m.modernRuleSort = m.top.findNode("modernRuleSort")
    m.styledHome = m.top.findNode("styledHome")
    m.styledSort = m.top.findNode("styledSort")
    m.styledGroup = m.top.findNode("styledGroup")
    m.styledShow = m.top.findNode("styledShow")
    m.styledShuffle = m.top.findNode("styledShuffle")
    m.styledDisplay = m.top.findNode("styledDisplay")
    m.styledButtons = [m.styledHome, m.styledSort, m.styledDisplay, invalid, invalid, m.styledShow, m.styledGroup, m.styledShuffle]
    m.letterCaption = m.top.findNode("letterCaption")
    m.letterCaption.text = tr("Jump to letter")
    m.letterCaption.font.size = 18
    panelInk = themeChrome.IsActive() ? themeChrome.Surface() : trackDialog.PANEL_INK
    m.dockPanel.color = panelInk
    m.dockPanel.opacity = trackDialog.PANEL_OPACITY
    m.modernBar.blendColor = panelInk
    m.modernBar.opacity = trackDialog.PANEL_OPACITY

    ' Alpha picker
    m.alphaPicker = m.top.findNode("alphaPicker")
    m.alphaGrid = m.alphaPicker.findNode("alphaGrid")

    ' Status bar

    m.overhang = getActiveNav(m.top.getScene())
end sub

sub init()
    observeUserData()
    ' Tell SceneManager to hide the overhang for this screen
    m.top.overhangVisible = false

    m.top.optionsAvailable = false
    setupNodes()
    m.allItems = []
    m.searchNames = []
    m.searchQuery = ""

    m.itemGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.genreGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.sortDialog.observeField("applied", "onSortApplied")
    m.displayDialog.observeField("chosen", "onDisplayChosen")
    m.groupDialog.observeField("chosen", "onGroupChosen")
    for each dialog in m.dialogs
        dialog.observeField("closed", "onSortClosed")
    end for

    m.categoryBar.observeField("selectedIndex", "onCategorySelected")
    m.categoryBar.observeField("activated", "onCategoryActivated")
    m.categoryBar.observeField("escape", "onCategoryEscape")
    m.syncTasks = []

    m.loadedRows = 0
    m.loadedItems = 0
    ' Paging follows what the server sent, while the grid and the count leave out blocked titles
    m.serverPosition = 0
    m.blockedCount = 0

    ' The header control with focus, one of the FOCUS_ places
    m.toolbarFocusIndex = FOCUS_HOME
    ' The bar control Up from Modern's letters goes back to
    m.barFocusIndex = 0

    m.data = createSGNode("ContentNode")
    for each grid in [m.itemGrid, m.horizontalGrid]
        grid.observeField("itemFocused", "onItemFocused")
        grid.observeFieldScoped("itemSelected", "onItemSelected")
    end for
    m.itemGrid.content = m.data

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.observeFieldScoped("itemSelected", "onGenreItemSelected")
    m.genreGrid.content = m.genreData

    m.groupRows = m.top.findNode("groupRows")
    m.groupRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.groupRows.rowLabelFont = "font:SmallestBoldSystemFont"
    m.groupRows.rowLabelFont.size = 28
    m.groupRows.observeField("rowItemFocused", "onGroupItemFocused")
    m.groupRows.observeField("rowItemSelected", "onGroupItemSelected")
    ' playlists or category, and whether the groups show as rows or as chips over the grid
    m.grouping = ""
    m.groupLayout = ""
    m.groupBy = "none"
    m.folderView = false
    m.scrollDirection = "vertical"
    resetCategoryGroups()
    ' Every kind of playlist shows until one is unticked. It's never saved, the way the other
    ' clients leave it.
    m.playlistTypes = playlistGrouping.Categories()
    ' What each playlist was found to hold, kept across reloads since a sort doesnt change it
    m.playlistCategories = {}
    m.playlistAttempted = {}
    m.playlistQueue = []
    m.categoryTask = createObject("roSGNode", "PlaylistCategoryTask")
    m.categoryTask.observeField("resolved", "onPlaylistCategories")
    m.categoryTask.observeField("state", "onCategoryTaskState")

    ' Item sort
    m.sortField = "SortName"
    m.sortAscending = true

    m.sortKey = "SortName"
    m.sortOrder = "Ascending"
    m.filterState = libraryFilters.EmptyState()

    m.view = ""
    ' A genre browse can be narrowed to one library for as long as it is open
    m.libraryFilter = invalid
    m.libraries = []

    m.loadItemsTask1 = createObject("roSGNode", "LoadItemsTask")

    m.loadItemsTask = createObject("roSGNode", "LoadItemsTask2")
    m.getFiltersTask = createObject("roSGNode", "GetFiltersTask")

    ' Set initial counts
    m.loadItemsTask.totalRecordCount = 0

    m.backdrop = m.top.findNode("backdrop")
    m.backdropPrev = m.top.findNode("backdropPrev")
    m.backdrop.observeField("loadStatus", "onBackdropLoadStatusChange")

    m.backdropFadeIn = m.top.findNode("backdropFadeIn")
    m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")
    m.backdropFadeInInterp = m.top.findNode("backdropFadeInInterp")
    m.backdropPrevFadeOutInterp = m.top.findNode("backdropPrevFadeOutInterp")
    m.backdropCrossfading = false
    m.backdropTargetOpacity = 1.0

    applyLibraryStyle()
end sub

' Handle backdrop load status - when new backdrop finishes loading, crossfade it in
sub onBackdropLoadStatusChange()
    if isValid(m.backdrop) and m.backdrop.loadStatus = "ready" and isValidAndNotEmpty(m.backdrop.uri)
        if m.backdropCrossfading
            targetOpacity = m.backdropTargetOpacity

            currentBackdropOpacity = 0.0
            if isValid(m.backdrop)
                currentBackdropOpacity = m.backdrop.opacity
            end if

            currentPrevOpacity = 1.0
            if isValid(m.backdropPrev)
                currentPrevOpacity = m.backdropPrev.opacity
            end if

            if isValid(m.backdropFadeInInterp)
                m.backdropFadeInInterp.keyValue = [currentBackdropOpacity, targetOpacity]
            end if
            if isValid(m.backdropPrevFadeOutInterp)
                m.backdropPrevFadeOutInterp.keyValue = [currentPrevOpacity, 0.0]
            end if
            if isValid(m.backdropFadeIn)
                m.backdropFadeIn.control = "start"
            end if
            if isValid(m.backdropPrevFadeOut)
                m.backdropPrevFadeOut.control = "start"
            end if
            m.backdropCrossfading = false
        end if
    end if
end sub

sub clearFocusedItemBackdrop()
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdrop)
        m.backdrop.uri = ""
        m.backdrop.opacity = m.backdropTargetOpacity
    end if

    if isValid(m.backdropPrev)
        m.backdropPrev.uri = ""
        m.backdropPrev.opacity = 0
    end if

    m.backdropCrossfading = false
end sub

sub startBackdropCrossfade(uri as string)
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdropPrev) and m.backdrop.uri <> ""
        m.backdropPrev.uri = m.backdrop.uri
        m.backdropPrev.opacity = m.backdropTargetOpacity
    end if

    m.backdrop.opacity = 0.0
    m.backdrop.uri = uri
    m.backdropCrossfading = true
end sub

sub OnScreenHidden()
    if not m.overhang.isVisible
        m.overhang.disableMoveAnimation = true
        m.overhang.isVisible = true
        m.overhang.disableMoveAnimation = false
    end if
end sub

sub OnScreenShown(isReturning = false as boolean)
    ' Hide the overhang/navbar
    m.overhang.isVisible = false

    m.libraryName.text = libraryTitle()

    ' Settings can change the style while this screen waits under it, and the theme font the push
    ' brought means the controls are measured again
    previousStyle = m.libraryStyle
    applyLibraryStyle()

    ' Only redraw items on initial show, not when returning from detail screens
    if not isReturning or previousStyle <> m.libraryStyle
        redrawItems()
    end if

    ' Temporarily unobserve itemSelected to prevent triggering navigation when restoring focus
    m.grid.unobserveFieldScoped("itemSelected")

    group = m.global.sceneManager.callFunc("getActiveScene")

    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        group.lastFocus = m.top.lastFocus

        ' Re-observe itemSelected after focus is restored
        m.grid.observeFieldScoped("itemSelected", "onItemSelected")

        ' Skip metadata loading when returning from detail screens
        if isReturning then return

        focusedItem = getItemFocused()

        if isValid(focusedItem)
            m.loadItemsTask1.itemId = focusedItem.LookupCI("id")
            m.loadItemsTask1.observeField("content", "onItemDataLoaded")
            m.loadItemsTask1.itemsToLoad = "metaData"
            m.loadItemsTask1.control = TaskControl.RUN
        end if

    else
        m.top.setFocus(true)
        group.lastFocus = m.top
        ' Re-observe itemSelected even if no lastFocus
        m.grid.observeFieldScoped("itemSelected", "onItemSelected")
    end if
end sub

sub onItemDataLoaded()
    itemData = m.loadItemsTask1.content
    m.loadItemsTask1.unobserveField("content")
    m.loadItemsTask1.control = TaskControl.STOP
    m.loadItemsTask1.content = []

    if not isValidAndNotEmpty(itemData) then return

    focusedItem = getItemFocused()
    if not isValid(focusedItem) then return

    focusedItem.callFunc("setWatched", chainLookupReturn(itemData[0], "json.UserData.Played", false), chainLookupReturn(itemData[0], "json.UserData.UnplayedItemCount", 0))
end sub

' The library's name, or what a music category or a genre or studio browse holds
function libraryTitle() as string
    if isValid(m.top.genreFilter) and isValidAndNotEmpty(m.top.genreFilter.genreName) then return m.top.genreFilter.genreName
    if isValid(m.top.studioFilter) and isValidAndNotEmpty(m.top.studioFilter.studioName) then return m.top.studioFilter.studioName

    entry = m.top.entry
    if isValid(entry)
        if entry.favorites = true then return tr("Favorites")
        if isStringEqual(entry.itemType, "MusicAlbum") then return tr("Albums")
        if isStringEqual(entry.itemType, "AlbumArtists") then return tr("Album Artists")
        if isStringEqual(entry.itemType, "MusicArtist") then return tr("Artists")
        if isStringEqual(entry.itemType, "Audio") then return tr("Songs")
    end if

    if not isValid(m.top.parentItem) then return ""
    return isValid(m.top.parentItem.name) ? m.top.parentItem.name : m.top.parentItem.title
end function

sub redrawItems()
    applyGridMetrics()

    focused = m.grid.itemFocused
    applySearchFilter()

    ' Reset cursor back to its previous location
    if focused > 0 then m.grid.jumpToItem = focused

    genreContent = m.genreData.getChildren(-1, 0)
    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData
    m.genreData.appendChildren(genreContent)

    ' Reset cursor back to its previous location
    m.genreGrid.jumpToItem = m.genreGrid.itemFocused
end sub

' Get the ID to use for this item (libraryId for library folders, id for BoxSets/collections)
function getParentItemId() as string
    if isValid(m.top.parentItem.libraryId) and m.top.parentItem.libraryId <> ""
        return m.top.parentItem.libraryId
    end if
    return m.top.parentItem.id
end function

' A genre or studio browse carries its library's id, so its sort, filters, view and cards save under a key of their own
function settingsKey() as string
    if isValid(m.top.genreFilter)
        if isValidAndNotEmpty(m.top.genreFilter.genreId) then return "genre-" + m.top.genreFilter.genreId
        return "genre-" + (m.top.genreFilter.genreName ?? "")
    end if
    if isValid(m.top.studioFilter)
        if isValidAndNotEmpty(m.top.studioFilter.studioId) then return "studio-" + m.top.studioFilter.studioId
        return "studio-" + (m.top.studioFilter.studioName ?? "")
    end if
    if isValid(m.top.entry) then return getParentItemId() + "-" + m.top.entry.id
    return libraryKey()
end function

' A folder opened from inside a library was listed with that library's id, so it keeps the
' library's settings rather than starting over with its own
function libraryKey() as string
    owner = chainLookupReturn(m.top.parentItem, "json.passedData.libraryID", "")
    if isFolderInsideLibrary() and isValidAndNotEmpty(owner) then return owner
    return getParentItemId()
end function

function isFolderInsideLibrary() as boolean
    if not isValid(m.top.parentItem) or m.top.parentItem.hasField("collectionType") then return false
    return inArray(["Folder", "PhotoAlbum", "CollectionFolder"], chainLookupReturn(m.top.parentItem, "json.Type", ""))
end function

' The library the screen was opened on, rather than a genre, a studio, a music category or a
' folder inside it
function isLibraryRoot() as boolean
    if isValid(m.top.genreFilter) or isValid(m.top.studioFilter) or isValid(m.top.entry) then return false
    return isValid(m.top.parentItem) and m.top.parentItem.hasField("collectionType")
end function

function libraryCollectionType() as string
    if not isLibraryRoot() then return ""
    return LCase(toString(m.top.parentItem.collectionType))
end function

' Any library can list its own folders one level at a time
function canFolderView() as boolean
    if not isLibraryRoot() or isMusicLibrary() or isMyListLibrary() then return false
    return not inArray([CollectionType.NEXTUP, "livetv", "channels"], libraryCollectionType())
end function

' Home videos and untyped libraries start in folder view, everything else starts flat
function folderViewOn() as boolean
    if not canFolderView() then return false
    fallback = isFlatFolderLibrary() ? "on" : "off"
    return settingOr(`library_folderView_${settingsKey()}`, fallback) = "on"
end function

function isFlatFolderLibrary() as boolean
    collection = libraryCollectionType()
    return canFolderView() and (collection = CollectionType.HOMEVIDEOS or collection = "" or collection = "mixed")
end function

function isMovieOrSeries() as boolean
    return isStringEqual(m.top.mediaType, ItemType.MOVIE) or isStringEqual(m.top.mediaType, ItemType.SERIES)
end function

' Only movies and series carry what the groupings read, and folders carry none of it
function canGroup() as boolean
    return isMovieOrSeries() and m.folderView <> true
end function

function isSongsBrowse() as boolean
    return isStringEqual(chainLookupReturn(m.top.entry, "itemType", ""), "Audio")
end function

' What the Sort By group offers depends on what the library holds
function sortKind() as object
    return {
        music: isMusicLibrary() and not isSongsBrowse(),
        songs: isSongsBrowse(),
        series: isStringEqual(m.top.mediaType, ItemType.SERIES),
        movieOrSeries: isMovieOrSeries(),
        foldery: m.folderView = true,
        myList: isMyListLibrary(),
        myRating: moonfinPlugin.IsPluginInstalled() and not isValidAndNotEmpty(chainLookupReturn(m.top.parentItem, "serverUrl", ""))
    }
end function

' Load initial set of data
sub loadInitialItems()
    m.loadItemsTask.control = TaskControl.STOP
    startLoadingSpinner(false)

    itemId = settingsKey()

    ' The settings map is gone once the user signs out, and a library can still reload on the way there
    userSettings = chainLookupReturn(m.global.session, "user.settings", {})

    m.sortField = userSettings["display." + itemId + ".sortField"]
    m.sortAscending = userSettings["display." + itemId + ".sortAscending"]
    m.filterState = storedFilterState(itemId)
    m.view = ""

    ' A music category keeps its own view, and a list of favorites always keeps its filter
    entry = m.top.entry
    if isValid(entry)
        m.view = entry.view
        if entry.favorites = true then m.filterState.favorites = true
    else if isMusicLibrary() and not isValid(m.top.genreFilter) and not isValid(m.top.parentItem.parentFolder)
        ' The classic music grid remembers which of its views was last picked
        m.view = userSettings["display." + itemId + ".landing"]
        if not isValid(m.view) then m.view = userSettings[`display.${ItemType.MUSICARTIST}library.defaultview`]
        if not isValidAndNotEmpty(m.view) or not inArray(["Artists", "Albums", "Genres"], m.view) then m.view = "Artists"
    end if

    if not isValid(m.sortAscending)
        m.sortAscending = true
    else if not isStringEqual(type(m.sortAscending), "roBoolean")
        m.sortAscending = isStringEqual(m.sortAscending, "true")
    end if

    m.folderView = folderViewOn()
    m.groupBy = "none"
    if canGroup() then m.groupBy = libraryGroupBy.Normalize(settingOr(`library_groupBy_${itemId}`, "none"))
    m.scrollDirection = settingOr(`library_scrollDirection_${itemId}`, "vertical")
    if m.libraryFilter = invalid then m.libraryFilter = chainLookupReturn(m.top.genreFilter, "libraryId", "")

    ' Folders come first until something else is picked, and a saved sort the library no longer
    ' offers goes back to that or to the name
    kind = sortKind()
    m.sortKey = librarySorts.KeyFor(m.sortField, kind)
    if m.sortKey = "" then m.sortKey = m.folderView ? "FoldersFirst" : "SortName"
    m.sortField = librarySorts.Chosen(m.sortKey, kind).field
    m.sortOrder = m.sortAscending ? "Ascending" : "Descending"

    m.loadItemsTask.sortField = m.sortField
    m.loadItemsTask.sortAscending = m.sortAscending
    m.loadItemsTask.filterState = m.filterState
    m.loadItemsTask.startIndex = 0
    m.loadItemsTask.studioIds = string.EMPTY
    m.loadItemsTask.genreIds = string.EMPTY
    m.loadItemsTask.view = string.EMPTY
    ' The task outlives a load, so anything a branch below switches off is put back first
    m.loadItemsTask.recursive = true
    m.loadItemsTask.itemType = string.EMPTY
    m.loadItemsTask.excludeItemTypes = string.EMPTY
    m.loadItemsTask.collapseBoxSetItems = true
    m.loadItemsTask.itemId = getParentItemId()
    m.loadItemsTask.passToItem = {
        libraryID: libraryKey()
    }

    ' Only the music library still lists its genres as a grid of their own
    if isStringEqual(m.view, "Genres")
        m.loadItemsTask.view = "Genres"
        m.loadItemsTask.genreIds = getParentItemId()
        m.loadItemsTask.studioIds = getParentItemId()
        m.loadItemsTask.itemType = "MusicAlbum"
    end if

    ' Genre browse mode: override task params to filter by selected genre
    if isValid(m.top.genreFilter)
        m.loadItemsTask.view = string.EMPTY
        m.loadItemsTask.studioIds = string.EMPTY
        m.loadItemsTask.recursive = true

        if isValidAndNotEmpty(m.top.genreFilter.genreId)
            m.loadItemsTask.genreIds = m.top.genreFilter.genreId
        else if isValidAndNotEmpty(m.top.genreFilter.genreName)
            m.loadItemsTask.genreNames = m.top.genreFilter.genreName
        end if

        ' All Libraries leaves the parent off so the genre is looked for everywhere
        m.loadItemsTask.itemId = m.libraryFilter

        if isValidAndNotEmpty(m.top.genreFilter.itemType)
            m.loadItemsTask.itemType = m.top.genreFilter.itemType
        end if
    else if isValid(m.top.studioFilter)
        ' Studio browse: filter the library grid by the selected studio.
        m.loadItemsTask.view = string.EMPTY
        m.loadItemsTask.genreIds = string.EMPTY
        m.loadItemsTask.recursive = true
        m.loadItemsTask.itemType = `${ItemType.MOVIE},${ItemType.SERIES}`

        if isValidAndNotEmpty(m.top.studioFilter.studioId)
            m.loadItemsTask.studioIds = m.top.studioFilter.studioId
        end if
        if isValidAndNotEmpty(m.top.studioFilter.libraryId)
            m.loadItemsTask.itemId = m.top.studioFilter.libraryId
        end if
    else if inArray([ItemType.BOXSET, ItemType.PHOTO, ItemType.PHOTOALBUM, ItemType.MUSICVIDEO, ItemType.PLAYLIST, ItemType.FOLDER], m.top.mediaType)
        m.loadItemsTask.recursive = false

        if isStringEqual(m.top.mediaType, ItemType.MUSICVIDEO)
            m.loadItemsTask.itemType = `${ItemType.MUSICVIDEO},${ItemType.FOLDER}`
            m.loadItemsTask.passToItem.addreplace("collectionType", ItemType.MUSICVIDEO)
        end if
    else if isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
        ' Music library: set itemType based on selected view
        ' Use PascalCase strings to match LoadItemsTask2's case-sensitive checks
        if isStringEqual(m.view, "Albums")
            m.loadItemsTask.itemType = "MusicAlbum"
            m.loadItemsTask.recursive = true
        else if not isStringEqual(m.view, "Genres")
            ' Default: Artists view
            m.loadItemsTask.itemType = "MusicArtist"
        end if
        if isValid(entry) and isValid(entry.itemType)
            m.loadItemsTask.itemType = entry.itemType
            m.loadItemsTask.recursive = true
        end if
    else
        m.loadItemsTask.itemType = m.top.mediaType
    end if

    ' Collections / BoxSet handling for libraries and genre filtering
    collType = getCollectionType()
    groupCollections = get_user_setting_bool("ui.library.groupItemsIntoCollections", false)

    if isValid(m.top.genreFilter)
        m.loadItemsTask.collapseBoxSetItems = groupCollections
        m.loadItemsTask.excludeItemTypes = groupCollections ? "Playlist,Episode,Season,Folder" : "BoxSet,Playlist,Episode,Season,Folder"
    else if isStringEqual(collType, CollectionType.MOVIES) or isStringEqual(collType, CollectionType.TVSHOWS)
        m.loadItemsTask.collapseBoxSetItems = groupCollections
        m.loadItemsTask.excludeItemTypes = groupCollections ? "" : "BoxSet"
        if groupCollections
            if isStringEqual(collType, CollectionType.MOVIES)
                m.loadItemsTask.itemType = "Movie,BoxSet"
            else
                m.loadItemsTask.itemType = "Series,BoxSet"
            end if
        end if
    end if

    ' We're in a genre sub folder
    isGenreSubFolder = isValid(m.top.parentItem.json) and (isStringEqual(m.top.parentItem.json.type, "Genre") or isStringEqual(m.top.parentItem.json.type, "MusicGenre"))
    if isValid(m.top.parentItem.parentFolder) and isGenreSubFolder and not isStringEqual(getCollectionType(), CollectionType.BOXSET)
        if not inArray([ItemType.PHOTOALBUM, ItemType.MUSICVIDEO], m.top.mediaType)
            m.loadItemsTask.passToItem = {
                libraryID: m.top.parentItem.libraryID
            }

            m.loadItemsTask.itemId = m.top.parentItem.parentFolder
            m.loadItemsTask.genreIds = m.top.parentItem.id
        end if
    end if

    ' We're inside a music video genre sub folder
    if isStringEqual(m.top.mediaType, ItemType.MUSICVIDEO)
        if isStringEqual(chainLookup(m.top.parentItem, "itemType"), `${ItemType.MUSICVIDEO},${ItemType.FOLDER}`)
            m.loadItemsTask.itemId = m.top.parentItem.id
            m.loadItemsTask.genreIds = m.top.parentItem.id
            m.loadItemsTask.itemType = ItemType.MUSICVIDEO
            m.loadItemsTask.recursive = true
        end if
    end if

    ' Folder view lists one level of the library at a time, folders and all. A home videos or
    ' mixed library out of it lists everything under it instead, minus the folders.
    if m.folderView
        m.loadItemsTask.recursive = false
        m.loadItemsTask.itemType = string.EMPTY
        m.loadItemsTask.excludeItemTypes = string.EMPTY
        m.loadItemsTask.collapseBoxSetItems = false
    else if isFlatFolderLibrary()
        m.loadItemsTask.recursive = true
        m.loadItemsTask.excludeItemTypes = librarySorts.DIRECTORY_TYPES
        m.loadItemsTask.collapseBoxSetItems = false
    end if

    setGroupingState()
    layoutContent()
    layoutStyledHeader()
    layoutClassicButtons()

    applyLetterNav()
    m.emptyText.visible = false

    ' Genres rows carry no per-item metadata, so the detail bar stays hidden on that view
    showDetails = get_user_setting_bool("ui.library.showMediaDetails", true) and not isStringEqual(m.view, "Genres")
    m.infoGroup.visible = showDetails
    m.selectedItemName.visible = showDetails

    applyGridMetrics()

    m.loadItemsTask.observeField("content", "ItemDataLoaded")
    m.loadItemsTask.control = TaskControl.RUN

    m.getFiltersTask.observeField("filters", "FilterDataLoaded")
    filterParent = m.top.parentItem.Id
    if isValid(m.top.genreFilter) then filterParent = m.libraryFilter
    m.getFiltersTask.params = {
        userid: m.global.session.user.id,
        parentid: filterParent,
        includeitemtypes: m.loadItemsTask.itemType
    }
    m.getFiltersTask.control = "RUN"

    if isValid(m.top.genreFilter) and m.libraries.count() = 0 then loadLibraries()

    updateStatusBar()
end sub

' Which grouping is on and how it shows. Playlists always group into rows, and a library
' grouped by category shows its groups as rows when it scrolls sideways or as chips over the
' grid when it scrolls down.
sub setGroupingState()
    m.grouping = ""
    m.groupLayout = ""
    if playlistGroupingOn()
        m.grouping = "playlists"
        m.groupLayout = "rows"
    else if m.groupBy <> "none" and canGroup()
        m.grouping = "category"
        m.groupLayout = m.scrollDirection = "horizontal" ? "rows" : "tabs"
    end if

    wanted = m.itemGrid
    if m.grouping = "" and m.scrollDirection = "horizontal" then wanted = m.horizontalGrid
    if not wanted.isSameNode(m.grid)
        m.grid.content = createSGNode("ContentNode")
        m.grid.visible = false
        m.grid = wanted
    end if

    m.grid.visible = m.groupLayout <> "rows"
    m.groupRows.visible = m.groupLayout = "rows"
    m.categoryBar.visible = m.groupLayout = "tabs"
    if m.groupLayout <> "tabs" then m.categoryBar.tabs = []
end sub

' Every card in the grid agrees on one set of numbers, worked out the way the other
' clients work them out. A subtitle anywhere in the library buys a second line on all of
' them so the rows stay level.
' A subtitle anywhere in the library buys a second line on every card, so the rows stay
' level. Once one turns up the grid is laid out again to make room.
sub noteCardSubtitles(itemData as object)
    if m.hasCardSubtitles = true then return

    detailed = detailedSubHeadings()

    for each item in itemData
        json = item.json
        if isValid(json)
            isFolder = json.IsFolder = true and not libraryCard.DetailedFolderType(json.Type ?? "")
            if libraryCard.Subtitle(json, isFolder, detailed) <> ""
                m.hasCardSubtitles = true
                applyGridMetrics()
                return
            end if
        end if
    end for
end sub

sub applyGridMetrics()
    showText = get_user_setting_bool(CARD_TITLES_SETTING, true)
    metrics = libraryCard.Metrics(posterSize(), currentImageType(), showText, m.hasCardSubtitles = true, detailedSubHeadings(), m.gridWidth)
    if m.grouping = "playlists" then metrics = groupedCardMetrics()

    if m.groupLayout = "rows"
        ' A playlist row spaces its square cards out, a category row keeps the grid's own cells
        spacing = 0
        if m.grouping = "playlists" then spacing = GROUPED_CARD_GAP - (metrics.padX * 2)
        m.groupRows.itemSize = [m.gridWidth, metrics.cellHeight]
        m.groupRows.rowItemSize = [[metrics.cellWidth, metrics.cellHeight]]
        m.groupRows.rowItemSpacing = [[spacing, 0]]
        m.groupRows.itemSpacing = [0, GROUPED_ROW_GAP]
    end if
    m.global.addFields({ libraryCardMetrics: metrics })
    m.global.libraryCardMetrics = metrics

    m.itemGrid.itemSize = [metrics.cellWidth, metrics.cellHeight]
    m.itemGrid.rowHeights = [metrics.cellHeight]
    m.itemGrid.numColumns = metrics.columns
    m.itemGrid.itemSpacing = [0, 0]

    ' Sideways, the cards keep their size and as many rows fit as would show on screen
    rows = Int(m.gridRoom / metrics.cellHeight)
    if rows < 1 then rows = 1
    m.horizontalGrid.layout = {
        cellWidth: metrics.cellWidth,
        cellHeight: metrics.cellHeight,
        rows: rows,
        columns: metrics.columns
    }

    m.loadItemsTask.numberOfColumns = metrics.columns
end sub

' A playlist row draws square cards at the poster size with only a title under each. A row
' doesnt stretch its cells to fill the width the way the grid does, so each card keeps its size.
function groupedCardMetrics() as object
    metrics = libraryCard.Metrics(posterSize(), "square", get_user_setting_bool(CARD_TITLES_SETTING, true), false, detailedSubHeadings(), m.gridWidth)
    metrics.posterWidth = metrics.posterHeight
    metrics.cellWidth = metrics.posterWidth + (metrics.padX * 2)
    return metrics
end function

' Playlists keep a size of their own, and either follows the account's general poster size
' until one is picked here
function posterSize() as string
    picked = get_user_setting(isPlaylistLibrary() ? PLAYLIST_POSTER_SIZE_SETTING : LIBRARY_POSTER_SIZE_SETTING)
    return libraryCard.PosterSize(picked, get_user_setting(POSTER_SIZE_SETTING))
end function

' A library whose cards are square either way has nothing to pick between
function currentImageType() as string
    fallback = defaultImageType()
    if fallback = "square" then return fallback
    picked = settingOr(`library_imageType_${settingsKey()}`, fallback)
    if not inArray(["poster", "thumbnail", "banner"], picked) then return fallback
    return picked
end function

function isPlaylistLibrary() as boolean
    if isValid(m.top.genreFilter) or isValid(m.top.studioFilter) then return false
    return isStringEqual(getCollectionType(), "playlists")
end function

' A playlist library shows a row per kind of playlist, unless it is listing its folders
function playlistGroupingOn() as boolean
    if not isPlaylistLibrary() or m.folderView = true then return false
    return get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true)
end function

function detailedSubHeadings() as boolean
    return settingOr("ui.library.detailedSubHeadings", "true") <> "false"
end function

function defaultImageType() as string
    if isStringEqual(m.view, "Albums") or inArray([ItemType.PLAYLIST, ItemType.MUSICARTIST], m.top.mediaType) then return "square"
    orientation = settingOr("libraryPosterOrientation", ImageLayout.DEFAULT)
    if isStringEqual(orientation, ImageLayout.LANDSCAPE) then return "thumbnail"
    if isStringEqual(orientation, ImageLayout.PORTRAIT) then return "poster"
    if inArray([ItemType.PHOTO, ItemType.PHOTOALBUM, ItemType.MUSICVIDEO], m.top.mediaType) then return "thumbnail"
    return "poster"
end function

function availableViews() as object
    if isValid(m.top.entry) or not isMusicLibrary() or isValid(m.top.genreFilter) then return []
    return [
        { key: "Artists", label: tr("Artists") },
        { key: "Albums", label: tr("Albums") },
        { key: "Genres", label: tr("Genres") }
    ]
end function

function isMusicLibrary() as boolean
    return isStringEqual(m.top.mediaType, ItemType.MUSICARTIST)
end function

function isMyListLibrary() as boolean
    return isStringEqual(getCollectionType(), ItemType.MYLIST)
end function

' A shape written by an older build could be missing whatever has been added since, so
' the stored values fill in over a full set rather than standing in for one
function storedFilterState(itemId as string) as object
    state = libraryFilters.EmptyState()
    stored = m.global.session.user.settings["display." + itemId + ".filterState"]
    if not isValidAndNotEmpty(stored) then return state

    parsed = ParseJson(stored)
    if not isValid(parsed) then return state

    for each key in parsed
        if state.doesExist(key) then state[key] = parsed[key]
    end for
    return state
end function

' =====================================================================
' DISPLAY AND GROUP BY
' =====================================================================

sub openDisplayDialog()
    m.displayDialog.context = { title: tr("Display"), sections: displaySections() }
    m.displayDialog.callFunc("showDialog")

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.displayDialog
end sub

function radioSection(key as string, title as string, values as object, labels as object, selected as string) as object
    options = []
    for i = 0 to values.count() - 1
        options.push({ value: values[i], label: labels[i] })
    end for
    return { key: key, title: title, kind: "radio", options: options, selected: selected }
end function

' The Display sections, then this library's alphabet bar with its folder view switch under it
function displaySections() as object
    sections = [radioSection("scroll", tr("Scroll Direction"), ["vertical", "horizontal"], [tr("Vertical"), tr("Horizontal")], m.scrollDirection)]

    imageType = currentImageType()
    if imageType <> "square"
        sections.push(radioSection("imageType", tr("Image Type"), ["poster", "thumbnail", "banner"], [tr("Poster"), tr("Thumbnail"), tr("Banner")], imageType))
    end if
    if imageType <> "banner"
        sections.push(radioSection("posterSize", tr("Poster Size"), ["small", "medium", "large", "extraLarge"], [tr("Small"), tr("Medium"), tr("Large"), tr("Extra Large")], posterSize()))
    end if

    if isPlaylistLibrary()
        grouped = get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true)
        sections.push({ key: "grouping", title: tr("Grouping"), kind: "check", options: [{ value: "groupByType", label: tr("Group by Type") }], selected: grouped ? ["groupByType"] : [] })

        types = []
        labels = [tr("Video"), tr("Music Video"), tr("Audio (Music)"), tr("Audiobook"), tr("Book"), tr("Photo"), tr("Mixed")]
        categories = playlistGrouping.Categories()
        for i = 0 to categories.count() - 1
            types.push({ value: categories[i], label: labels[i] })
        end for
        sections.push({ key: "playlistTypes", title: tr("Playlist Types"), kind: "check", options: types, selected: m.playlistTypes })
    end if

    letters = [{ value: "letterNav", label: tr("Alphabet bar") }]
    chosen = []
    if letterNavOn() then chosen.push("letterNav")
    if canFolderView()
        letters.push({ value: "folderView", label: tr("Folder View") })
        if m.folderView then chosen.push("folderView")
    end if
    sections.push({ key: "letters", title: "", kind: "check", options: letters, selected: chosen })
    return sections
end function

' Every pick takes effect as it is made and the dialog stays up, so it is drawn again after each
sub onDisplayChosen(event as object)
    choice = event.getData()
    if not isValid(choice) then return

    libraryId = settingsKey()
    section = choice.section
    value = choice.value

    if section = "scroll"
        set_user_setting(`library_scrollDirection_${libraryId}`, value)
        m.scrollDirection = value
        relayout()
    else if section = "imageType"
        ' Saving the default would pin it, and the global Library Image Orientation would stop applying
        if isStringEqual(value, defaultImageType())
            unset_user_setting(`library_imageType_${libraryId}`)
        else
            set_user_setting(`library_imageType_${libraryId}`, value)
        end if
        redrawItems()
        layoutStyledHeader()
    else if section = "posterSize"
        savePosterSize(value)
        redrawItems()
    else if section = "grouping"
        set_user_setting(PLAYLIST_GROUPING_SETTING, get_user_setting_bool(PLAYLIST_GROUPING_SETTING, true) ? "false" : "true")
        relayout()
    else if section = "playlistTypes"
        togglePlaylistType(value)
        applySearchFilter()
    else if value = "letterNav"
        set_user_setting(`library_letterNav_${libraryId}`, letterNavOn() ? "off" : "on")
        applyLetterNav()
        layoutStyledHeader()
    else if value = "folderView"
        set_user_setting(`library_folderView_${libraryId}`, m.folderView ? "off" : "on")
        ' Listing folders rather than everything inside them is a different query
        resetLoadedItems()
        loadInitialItems()
    end if

    m.displayDialog.context = { title: tr("Display"), sections: displaySections() }
    m.displayDialog.callFunc("refresh")
end sub

' Clearing the last kind would leave the page blank with no way back
sub togglePlaylistType(category as string)
    kept = []
    found = false
    for each shown in m.playlistTypes
        if isStringEqual(shown, category)
            found = true
        else
            kept.push(shown)
        end if
    end for

    if found and kept.count() = 0 then return
    if not found then kept.push(category)
    m.playlistTypes = kept
end sub

' Kept on this device and sent to the server, so the size follows the account to its other screens
sub savePosterSize(size as string)
    key = isPlaylistLibrary() ? PLAYLIST_POSTER_SIZE_SETTING : LIBRARY_POSTER_SIZE_SETTING
    set_user_setting(key, size)
    pushData = settingsSync.PreparePush(key, size)
    if not isValid(pushData) then return
    task = createObject("roSGNode", "PostTask")
    task.apiUrl = pushData.url
    task.stringData = pushData.body
    task.control = "RUN"
    ' Held until it finishes, or a task nothing references can be collected mid flight
    m.syncTasks.push(task)
end sub

sub openGroupDialog()
    m.groupDialog.context = {
        title: tr("Group By"),
        closeOnPick: true,
        sections: [{ key: "groupBy", title: "", kind: "radio", options: libraryGroupBy.Options(), selected: m.groupBy }]
    }
    m.groupDialog.callFunc("showDialog")

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.groupDialog
end sub

' Grouping sorts the whole library, so the rest of it loads once a grouping is picked
sub onGroupChosen(event as object)
    choice = event.getData()
    if not isValid(choice) then return

    m.groupBy = libraryGroupBy.Normalize(choice.value)
    set_user_setting(`library_groupBy_${settingsKey()}`, m.groupBy)
    m.selectedCategory = ""
    relayout()
end sub

' The grid, the rows or the chips are swapped and laid out again around what is already loaded
sub relayout()
    setGroupingState()
    layoutContent()
    layoutStyledHeader()
    layoutClassicButtons()
    applyGridMetrics()
    applyLetterNav()
    applySearchFilter()
    if m.grouping <> "" then loadMoreData()
end sub

function letterNavOn() as boolean
    return settingOr(`library_letterNav_${settingsKey()}`, "on") <> "off"
end function

' The alphabet strip can be turned off and goes while the library is grouped, so focus skips
' over it while it is gone
sub applyLetterNav()
    m.alphaPicker.visible = letterNavOn() and m.grouping = ""
    m.dockRule.visible = m.alphaPicker.visible and m.libraryStyle = "docked"
    m.letterCaption.visible = m.dockRule.visible
end sub

sub openSortDialog(section = "" as string)
    m.sortDialog.context = {
        section: section,
        views: availableViews(),
        isSeries: isStringEqual(m.top.mediaType, ItemType.SERIES),
        isMusic: isMusicLibrary(),
        favoritesOnly: chainLookupReturn(m.top.entry, "favorites", false) = true,
        sortKind: sortKind(),
        showVideoFilters: not isMusicLibrary() and not isStringEqual(m.top.mediaType, ItemType.PLAYLIST),
        namesOnly: isStringEqual(m.view, "Genres"),
        libraries: m.libraries
    }
    m.sortDialog.state = {
        view: m.view,
        sortKey: m.sortKey,
        sortOrder: m.sortOrder,
        filters: m.filterState,
        libraryId: m.libraryFilter
    }
    m.sortDialog.callFunc("showDialog")

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.sortDialog
end sub

' The libraries a genre browse can be narrowed to, the ones that hold movies or shows
sub loadLibraries()
    if not isValid(m.librariesTask)
        m.librariesTask = createObject("roSGNode", "JellyfinAPITask")
        m.librariesTask.observeField("response", "onLibrariesLoaded")
    end if
    m.librariesTask.request = { path: "UserViews", params: { userId: m.global.session.user.id } }
    m.librariesTask.control = TaskControl.RUN
end sub

sub onLibrariesLoaded(event as object)
    response = event.getData()
    if not isValid(response) or response.success <> true then return

    libraries = []
    for each view in responseItems(response.data)
        collection = view.LookupCI("CollectionType")
        if not isValidAndNotEmpty(collection) or isStringEqual(collection, CollectionType.MOVIES) or isStringEqual(collection, CollectionType.TVSHOWS)
            libraries.push({ value: toString(view.LookupCI("Id")), label: toString(view.LookupCI("Name")) })
        end if
    end for
    m.libraries = libraries
end sub

' Every choice in the dialog takes effect as it is made, so this runs on each one rather
' than once at the end
sub onSortApplied(msg as object)
    applied = msg.getData()
    if not isValid(applied) then return

    itemId = settingsKey()

    if not isStringEqual(applied.view, m.view)
        m.view = applied.view
        set_user_setting("display." + itemId + ".landing", m.view)

        clearSearchQuery()
        m.top.alphaSelected = string.EMPTY
        m.loadItemsTask.nameStartsWith = " "

        if not isStringEqual(m.view, "Genres")
            set_user_setting(`display.${m.top.mediaType}library.defaultview`, m.view)
        end if
    end if

    ' A genre browse narrowed to one library keeps it only while the screen is open
    m.libraryFilter = applied.libraryId ?? ""

    option = librarySorts.Chosen(applied.sortKey, sortKind())
    m.sortKey = option.value
    m.sortOrder = isStringEqual(applied.sortOrder, "Descending") ? "Descending" : "Ascending"
    m.sortField = option.field
    m.sortAscending = isStringEqual(m.sortOrder, "Ascending")
    m.filterState = applied.filters

    set_user_setting("display." + itemId + ".sortField", m.sortField)
    set_user_setting("display." + itemId + ".sortAscending", m.sortAscending ? "true" : "false")
    set_user_setting("display." + itemId + ".filterState", FormatJson(m.filterState))

    resetLoadedItems()
    loadInitialItems()
end sub

' A dialog left open while the grid reloads would lose focus to it, since setting the
' grid's content takes focus back
sub restoreDialogFocus(group as object)
    for each dialog in m.dialogs
        if dialog.visible
            dialog.callFunc("focusDialog")
            group.lastFocus = dialog
            return
        end if
    end for
end sub

' The toolbar buttons draw their focus from a flag of their own, so the button that opened the
' dialog would keep looking focused while the list has the remote
sub onSortClosed()
    ' Focus goes back to the control that opened the dialog
    focusToolbarItem(m.toolbarFocusIndex)
end sub

' What the library holds, for the genre, rating, tag, year and language groups
sub FilterDataLoaded(msg as object)
    m.getFiltersTask.unobserveField("filters")

    data = msg.GetData()
    if isValid(data) then m.sortDialog.facets = data
end sub

sub ItemDataLoaded(msg)
    itemData = msg.GetData()
    itemCount = itemData.count()
    m.serverPosition += itemCount

    ' Unobserve to prevent multiple callbacks
    m.loadItemsTask.unobserveField("content")
    m.loadItemsTask.content = []

    if not isValid(itemData)
        if m.loadedItems = 0
            m.emptyText.text = tr("Error loading items. Please check your connection and try again.")
            m.emptyText.visible = true
        end if
        m.Loading = false
        stopLoadingSpinner()
        return
    end if

    ' Client-side fallback: filter out BoxSets (API may not honor ExcludeItemTypes)
    if m.loadItemsTask.excludeItemTypes <> ""
        filteredData = []
        for each item in itemData
            if item.type <> "Boxset" and item.type <> "BoxSet"
                filteredData.push(item)
            end if
        end for
        itemData = filteredData
    end if

    shownData = parentalControls.WithoutBlockedItems(itemData)
    m.blockedCount += itemData.count() - shownData.count()
    itemData = shownData
    itemCount = itemData.count()

    firstPage = m.loadedItems = 0

    if isStringEqual(m.view, "Genres")
        ' Reset genre grid data
        m.genreData.removeChildren(m.genreData.getChildren(-1, 0))

        for each item in itemData
            m.genreData.appendChild(item)
        end for

        m.loadedItems = m.genreData.getChildCount()

        m.grid.opacity = 0
        m.genreGrid.opacity = 1

        stopLoadingOperation()
        focusFirstPage()

        if m.loadedItems = 0
            m.emptyText.text = tr("No items found. Try adjusting your selected filters.")
            m.emptyText.visible = true
        end if

        updateStatusBar()
        return
    end if

    m.grid.opacity = 1
    m.genreGrid.opacity = 0

    if m.data.getChildCount() = 0
        m.grid.jumpToItem = 0
    end if

    for each item in itemData
        m.allItems.push(item)
    end for
    noteCardSubtitles(itemData)

    ' A search or a narrowed set of playlist types redraws from everything loaded, and a
    ' grouping only takes in the page that just arrived
    if narrowing()
        applySearchFilter()
    else
        m.data.appendChildren(itemData)
        if m.grouping = "playlists"
            refreshPlaylistGroups()
        else if m.grouping = "category"
            addToCategoryGroups(itemData)
        else
            redrawSideways()
        end if
    end if

    if isPlaylistLibrary() then queueCategoryChecks(itemData)

    ' Update the stored counts
    m.loadedItems = m.loadedItems + itemCount
    m.loadedRows = m.loadedItems / m.itemGrid.numColumns

    if firstPage then focusFirstPage()

    ' If there are no items to display, show message
    if m.loadedItems = 0
        m.infoGroup.visible = false
        m.selectedItemName.visible = false

        SetName(string.EMPTY)
        clearMetaRow()

        m.emptyText.text = tr("No items found. Try adjusting your selected filters.")
        m.emptyText.visible = true
    end if

    m.Loading = false
    stopLoadingSpinner()

    restoreDialogFocus(m.global.sceneManager.callFunc("getActiveScene"))

    updateStatusBar()

    ' Grouping sorts the whole library, so the rest of it loads without waiting to be scrolled to
    queueNextPage()
end sub

' The screen opens on Home, and a reload after that puts focus back in the grid. A page arriving
' behind the open keyboard, a dialog or the header controls leaves focus where it is.
sub focusFirstPage()
    group = m.global.sceneManager.callFunc("getActiveScene")
    if m.openedOnHome <> true
        m.openedOnHome = true
        focusToolbarItem(FOCUS_HOME)
    else if not isValid(m.keyboard) and not styledHeaderFocused() and not dialogOpen()
        unfocusAllToolbarItems()
        focusContent()
    end if
    restoreDialogFocus(group)
end sub

function dialogOpen() as boolean
    for each dialog in m.dialogs
        if dialog.visible then return true
    end for
    return false
end function

function narrowing() as boolean
    return m.searchQuery.Trim() <> "" or m.playlistTypes.count() < playlistGrouping.Categories().count()
end function

' The sideways grid only draws the cards in view, so it's told when its content grows under it
sub redrawSideways()
    if m.grid.isSameNode(m.horizontalGrid) then m.horizontalGrid.callFunc("redraw")
end sub

' Set Selected Name
sub SetName(itemName as string)
    m.selectedItemName.text = itemName
end sub

sub clearMetaRow()
    setFieldText("selectedItemProductionYear", "")
    setFieldText("runtime", "")
    m.top.findNode("seriesStatusPill").visible = false
    m.top.findNode("officialRatingPill").visible = false
end sub

' Handle new item being focused
sub onItemFocused()
    if m.grid.itemFocused = -1 then return

    ' Lazy loading: Load more items when user is near the end
    if m.loadItemsTask.totalRecordCount > m.serverPosition and nearLoadedEnd() then loadMoreData()

    showFocusedItem()
end sub

' Within three rows, or three columns sideways, of the last card loaded
function nearLoadedEnd() as boolean
    if m.grid.isSameNode(m.horizontalGrid)
        layout = m.horizontalGrid.layout
        if not isValid(layout) then return false
        reach = (m.horizontalGrid.firstColumn + layout.columns + 3) * layout.rows
        return reach >= m.loadedItems
    end if
    return m.itemGrid.currFocusRow >= m.loadedRows - 3
end function

' The name, facts and backdrop of whatever card has focus
sub showFocusedItem()
    clearLibraryPluginRatings()

    focusedItem = getItemFocused()

    if not isChainValid(focusedItem, "json")
        return
    end if

    itemData = focusedItem.json

    ' Genres rows carry no per-item metadata, so the detail bar stays hidden on that view
    showDetails = get_user_setting_bool("ui.library.showMediaDetails", true) and not isStringEqual(m.view, "Genres")

    populateRatings(itemData)

    if showDetails and moonfinPlugin.IsRatingsEnabled()
        fetchLibraryRatings(itemData)
    end if

    if isValid(itemData.Name)
        SetName(itemData.Name)
    else
        SetName(string.EMPTY)
    end if

    m.selectedItemName.visible = showDetails

    drawMetaRow(itemData)

    if not showDetails then m.infoGroup.visible = false

    backdropUri = ""
    if isValid(m.backdrop) and get_user_setting_bool("ui.library.showBackdrops", true)
        if isValidAndNotEmpty(itemData.BackdropImageTags)
            backdropUri = getBlurredImageURL(itemData.Id, "Backdrop", itemData.BackdropImageTags[0])
        else if isValidAndNotEmpty(itemData.ImageTags) and isValidAndNotEmpty(itemData.ImageTags.Primary)
            backdropUri = getBlurredImageURL(itemData.Id, "Primary", itemData.ImageTags.Primary)
        end if
    end if

    if isValidAndNotEmpty(backdropUri)
        ' startBackdropCrossfade reads this to place the outgoing image
        m.backdropTargetOpacity = 0.3
        startBackdropCrossfade(backdropUri)
    else
        clearFocusedItemBackdrop()
    end if

    updateStatusBar()
end sub

' The community star and the critic score sit in the ratings row beside whatever the
' plugin returns, rather than in the metadata line
sub populateRatings(itemData as object)
    m.serverRatings = ratingsRow.ServerEntries(itemData)
    renderRatingsRow([])
end sub

sub renderRatingsRow(pluginRatings as object)
    if not isValid(m.pluginRatings) then return

    m.pluginRatings.showBadges = get_user_setting_bool("plugin.mdblist.showRatingBadges", true)

    entries = ratingsRow.Merge(m.serverRatings, pluginRatings)
    m.pluginRatings.ratingsData = { data: entries }
    m.pluginRatings.visible = entries.count() > 0 and get_user_setting_bool("ui.library.showMediaDetails", true)
end sub

' A series has no single runtime, and only a series carries a status worth a pill
sub drawMetaRow(itemData as object)
    isSeries = isStringEqual(itemData.Type ?? "", "Series")

    setFieldText("selectedItemProductionYear", isValid(itemData.ProductionYear) ? itemData.ProductionYear.toStr() : "")

    runtime = ""
    if not isSeries
        runtime = libraryCard.FormatDuration(itemData.RunTimeTicks)
        if runtime = "0m" then runtime = ""
    end if
    setFieldText("runtime", runtime)

    status = itemData.Status ?? ""
    showStatus = isSeries and isValidAndNotEmpty(status)
    if showStatus
        fillPill("seriesStatusFill", "seriesStatusLabel", tr(status))
        m.top.findNode("seriesStatusFill").blendColor = isStringEqual(status, "Continuing") ? "#22C55E" : "#EF4444"
        m.top.findNode("seriesStatusFill").opacity = 1
    end if
    m.top.findNode("seriesStatusPill").visible = showStatus

    rating = itemData.OfficialRating ?? ""
    showRating = isValidAndNotEmpty(rating) and not isStringEqual(itemData.Type ?? "", "Playlist")
    if showRating then fillPill("officialRatingFill", "selectedItemOfficialRating", rating)
    m.top.findNode("officialRatingPill").visible = showRating
end sub

' A pill is only as wide as the words it holds, plus the padding the other clients give it
sub fillPill(fillId as string, labelId as string, text as string)
    label = m.top.findNode(labelId)
    fill = m.top.findNode(fillId)

    label.text = text

    ' A label given a width reports that width back rather than the width of its text, so
    ' the last size it was given has to go before this one can be measured
    label.width = 0
    width = label.boundingRect().width + PILL_PAD_X

    label.width = width
    label.height = PILL_HEIGHT
    fill.width = width
    fill.height = PILL_HEIGHT
end sub

function getBlurredImageURL(itemId as string, imageType as string, imageTag as string) as string
    params = {
        "maxHeight": 1080,
        "maxWidth": 1920,
        "quality": 90,
        "blur": getHomeBackdropBlurAmount(),
        "Tag": imageTag
    }
    return ImageURL(itemId, imageType, params)
end function

sub clearLibraryPluginRatings()
    if isValid(m.pluginRatings)
        m.pluginRatings.ratingsData = invalid
        m.pluginRatings.visible = false
    end if

    if isValid(m.libraryRatingsDebounce)
        m.libraryRatingsDebounce.control = "stop"
    end if
    m.pendingLibraryRatingsItem = invalid

    if isValid(m.libraryRatingsTask)
        m.libraryRatingsTask.unobserveFieldScoped("ratings")
        m.libraryRatingsTask = invalid
    end if
end sub

sub fetchLibraryRatings(itemData as object)
    tmdbId = moonfinPlugin.GetTmdbId(itemData.ProviderIds ?? invalid)
    if tmdbId = "" then return

    itemType = itemData.Type ?? ""
    if itemType = "" then return

    ' Debounce so rapid grid scrolling doesn't fire a request per focus change
    m.pendingLibraryRatingsItem = itemData
    m.libraryRatingsDebounce = moonfinPlugin.StartRatingsDebounce(m.libraryRatingsDebounce, "onLibraryRatingsDebounceFired")
end sub

sub onLibraryRatingsDebounceFired()
    itemData = m.pendingLibraryRatingsItem
    if not isValid(itemData) then return
    m.pendingLibraryRatingsItem = invalid

    if isValid(m.libraryRatingsTask)
        m.libraryRatingsTask.unobserveFieldScoped("ratings")
        m.libraryRatingsTask = invalid
    end if

    m.libraryRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.libraryRatingsTask.itemData = itemData
    m.libraryRatingsTask.observeFieldScoped("ratings", "onLibraryRatingsLoaded")
    m.libraryRatingsTask.control = "RUN"
end sub

sub onLibraryRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) then return

    displayRatings = result.data
    if not isValidAndNotEmpty(displayRatings) then return

    renderRatingsRow(chainLookupReturn(result, "data", []))
end sub

' Load next batch of items for pagination
sub loadMoreData()
    if m.Loading = true then return
    if m.serverPosition >= m.loadItemsTask.totalRecordCount then return

    startLoadingSpinner(false)
    m.Loading = true
    m.loadItemsTask.startIndex = m.serverPosition
    m.loadItemsTask.observeField("content", "ItemDataLoaded")
    m.loadItemsTask.control = TaskControl.RUN
end sub

' Item Selected
sub onItemSelected()
    m.top.selectedItem = m.grid.content.getChild(m.grid.itemSelected)
    m.top.selectedItem = invalid
end sub

' Returns Focused Item
function getItemFocused()
    if m.groupRows.isinFocusChain()
        return groupRowItemAt(m.groupRows.rowItemFocused)
    else if m.grid.isinFocusChain()
        return getItemGridFocusedItem(m.grid)
    else if m.genreGrid.isinFocusChain() and m.genreGrid.itemFocused >= 0
        return m.genreGrid.content.getChild(m.genreGrid.itemFocused)
    end if
    return invalid
end function

sub onGroupItemFocused()
    showFocusedItem()
end sub

sub onGroupItemSelected()
    selected = groupRowItemAt(m.groupRows.rowItemSelected)
    if not isValid(selected) then return
    m.top.selectedItem = selected
    m.top.selectedItem = invalid
end sub

function groupRowItemAt(position as dynamic) as dynamic
    if not isValid(position) or position.count() < 2 or not isValid(m.groupRows.content) then return invalid
    row = m.groupRows.content.getChild(position[0])
    if not isValid(row) then return invalid
    return row.getChild(position[1])
end function

' Each kind of playlist gets its own row, and focus stays on the playlist it was on
sub refreshPlaylistGroups()
    focusedId = ""
    focusedItem = getItemFocused()
    if isValid(focusedItem) then focusedId = chainLookupReturn(focusedItem, "json.Id", "")

    root = createSGNode("ContentNode")
    target = invalid
    rowIndex = 0
    for each group in playlistGrouping.Group(filteredItems(), m.playlistCategories)
        row = root.createChild("ContentNode")
        row.title = group.label
        row.appendChildren(group.items)
        if focusedId <> ""
            for column = 0 to group.items.count() - 1
                if isStringEqual(chainLookupReturn(group.items[column], "json.Id", ""), focusedId) then target = [rowIndex, column]
            end for
        end if
        rowIndex++
    end for

    m.groupRows.content = root
    if isValid(target) then m.groupRows.jumpToRowItem = target

    m.emptyText.visible = root.getChildCount() = 0 and m.loadedItems > 0
    if m.emptyText.visible then m.emptyText.text = tr("No items found")
end sub

' =====================================================================
' GROUP BY
' =====================================================================

sub resetCategoryGroups()
    ' What each category holds, under the category's name as it was first seen
    m.categoryItems = {}
    m.categoryLabels = []
    m.categoryRows = {}
    m.categoryShown = invalid
    if not isValid(m.selectedCategory) then m.selectedCategory = ""
end sub

sub rebuildCategoryGroups()
    resetCategoryGroups()
    m.groupRows.content = createSGNode("ContentNode")
    addToCategoryGroups(filteredItems())
    if m.categoryLabels.count() = 0
        m.categoryBar.tabs = []
        m.itemGrid.content = createSGNode("ContentNode")
    end if
end sub

' Each page lands in the categories it belongs to, rather than every category being built
' again. An item can sit in more than one row, and a node only has one parent, so every row past
' its first gets a copy.
sub addToCategoryGroups(items as object)
    rows = m.groupLayout = "rows"
    touched = {}
    added = false

    for each item in items
        firstRow = true
        for each key in libraryGroupBy.KeysFor(item.json, m.groupBy)
            if not m.categoryItems.DoesExist(key)
                m.categoryItems[key] = { label: key, items: [] }
                m.categoryLabels.push(key)
                added = true
            end if
            category = m.categoryItems[key]
            category.items.push(item)
            touched[key] = true

            if rows
                row = m.categoryRows[key]
                if not isValid(row)
                    row = createSGNode("ContentNode")
                    m.categoryRows[key] = row
                end if
                if firstRow
                    row.appendChild(item)
                else
                    row.appendChild(item.clone(true))
                end if
            else if isStringEqual(key, m.selectedCategory) and isValid(m.categoryShown)
                m.categoryShown.appendChild(item)
            end if
            firstRow = false
        end for
    end for

    if added then m.categoryLabels = libraryGroupBy.Ordered(m.categoryLabels, m.groupBy)

    if rows
        for each key in touched
            category = m.categoryItems[key]
            m.categoryRows[key].title = `${category.label} (${category.items.count().toStr()})`
        end for
        ' Only a new category changes the order the rows run in. Swapping the rows in puts focus
        ' back on the first one, so it goes back to the row it was on.
        if added
            focused = m.groupRows.rowItemFocused
            focusedRow = invalid
            if isValid(m.groupRows.content) and isValid(focused) and focused.count() = 2 then focusedRow = m.groupRows.content.getChild(focused[0])
            root = createSGNode("ContentNode")
            target = invalid
            for each label in m.categoryLabels
                row = m.categoryRows[label]
                if isValid(focusedRow) and row.isSameNode(focusedRow) then target = [root.getChildCount(), focused[1]]
                root.appendChild(row)
            end for
            m.groupRows.content = root
            if isValid(target) then m.groupRows.jumpToRowItem = target
        end if
        return
    end if

    ' The category in view stays in view across a reload, or the first one shows
    if not isValid(m.categoryShown) or not m.categoryItems.DoesExist(m.selectedCategory)
        if m.categoryItems.DoesExist(m.selectedCategory)
            showCategory(m.selectedCategory)
        else if m.categoryLabels.count() > 0
            showCategory(m.categoryLabels[0])
        end if
    end if
    if touched.count() > 0 then drawCategoryTabs()
end sub

' The chips name each category with how much it holds, and stay on the one being shown
sub drawCategoryTabs()
    tabs = []
    selected = 0
    for i = 0 to m.categoryLabels.count() - 1
        category = m.categoryItems[m.categoryLabels[i]]
        tabs.push({ id: category.label, label: `${category.label} (${category.items.count().toStr()})` })
        if isStringEqual(category.label, m.selectedCategory) then selected = i
    end for
    m.categoryBar.tabs = tabs
    m.categoryBar.focusIndex = selected
    m.categoryBar.selectedIndex = selected
end sub

' The grid holds one category at a time, so the cards move into it rather than being copied
sub showCategory(key as string)
    category = m.categoryItems[key]
    if not isValid(category) then return

    m.selectedCategory = category.label
    m.categoryShown = createSGNode("ContentNode")
    m.categoryShown.appendChildren(category.items)
    m.itemGrid.content = m.categoryShown
    m.itemGrid.jumpToItem = 0
end sub

sub onCategorySelected()
    index = m.categoryBar.selectedIndex
    if index < 0 or index >= m.categoryLabels.count() then return
    label = m.categoryLabels[index]
    if isStringEqual(label, m.selectedCategory) and isValid(m.categoryShown) then return
    showCategory(label)
end sub

' Focus only leaves the chips when one is pressed
sub onCategoryActivated()
    if m.categoryBar.activated < 0 then return
    focusGridItems()
end sub

' Docked keeps its controls left of the chips, and Classic and Modern keep theirs above them
sub onCategoryEscape()
    escape = m.categoryBar.escape
    if escape = "up" or (escape = "left" and m.libraryStyle = "docked")
        focusToolbarItem(m.toolbarFocusIndex)
    else if escape = "down"
        focusGridItems()
    end if
end sub

sub focusGridItems()
    if not isValid(m.itemGrid.content) or m.itemGrid.content.getChildCount() = 0 then return
    unfocusAllToolbarItems()
    m.itemGrid.setFocus(true)
    setLastFocus(m.itemGrid)
end sub

' Playlists that could be more than one kind are looked into, each only once
sub queueCategoryChecks(items as object)
    for each item in items
        json = item.json
        if not isValid(json) then continue for
        playlistId = toString(json.LookupCI("Id"))
        if playlistGrouping.NeedsItemCheck(json) and not m.playlistAttempted.DoesExist(playlistId)
            m.playlistAttempted[playlistId] = true
            m.playlistQueue.push({ id: playlistId, summary: playlistGrouping.SummaryCategory(json) })
        end if
    end for
    runCategoryTask()
end sub

sub runCategoryTask()
    if m.playlistQueue.count() = 0 or m.categoryTask.state = "run" then return
    m.categoryTask.playlists = m.playlistQueue
    m.playlistQueue = []
    m.categoryTask.control = TaskControl.RUN
end sub

sub onPlaylistCategories(event as object)
    resolved = event.getData()
    if not isValid(resolved) then return
    m.playlistCategories.Append(resolved)
    if m.grouping = "playlists"
        refreshPlaylistGroups()
    else if narrowing()
        applySearchFilter()
    end if
end sub

' Playlists that turned up while a look was running go once it finishes
sub onCategoryTaskState()
    if m.categoryTask.state = "stop" then runCategoryTask()
end sub

sub onGenreItemSelected()
    selectedGenre = m.genreGrid.content.getChild(m.genreGrid.itemSelected)
    if not isValid(selectedGenre) or not isValid(selectedGenre.json) then return

    genreData = selectedGenre.json

    m.top.genreItemSelected = {
        genreId: genreData.id,
        genreName: genreData.Name,
        libraryId: genreData.libraryId,
        itemType: genreData.itemType,
        mediaType: m.top.mediaType,
        collectionType: getCollectionType()
    }
end sub

' Everything the grid was showing goes, so a fresh page does not land beside the old one
sub resetLoadedItems()
    m.loadedRows = 0
    m.loadedItems = 0
    m.serverPosition = 0
    m.blockedCount = 0
    m.allItems = []
    m.searchNames = []
    m.data = createSGNode("ContentNode")
    m.grid.content = m.data
    resetCategoryGroups()
    m.groupRows.content = createSGNode("ContentNode")
end sub

' The query narrows what is already loaded rather than asking the server again, so the
' grid answers on every keystroke
sub applySearchFilter()
    m.data = createSGNode("ContentNode")
    m.data.appendChildren(filteredItems())
    showContent()
    updateStatusBar()

    ' Handing the grid new content puts focus back on it, which would send the next
    ' keystroke to a poster rather than the keyboard still standing open over it
    if isValid(m.keyboard) then m.keyboard.setFocus(true)
end sub

' Hands what is loaded to whatever is showing it: the grid, the playlist rows or the categories
sub showContent()
    if m.grouping = "playlists"
        refreshPlaylistGroups()
    else if m.grouping = "category"
        rebuildCategoryGroups()
    else
        m.grid.content = m.data
        redrawSideways()
    end if
end sub

function filteredItems() as object
    items = m.allItems
    query = accentFolding.ForSearch(m.searchQuery.Trim())
    if query <> ""
        ' Folding costs more than matching, so each name is only folded once
        for i = m.searchNames.count() to m.allItems.count() - 1
            m.searchNames.push(sortableName(m.allItems[i]))
        end for

        items = []
        for i = 0 to m.allItems.count() - 1
            if m.searchNames[i].instr(query) <> -1 then items.push(m.allItems[i])
        end for
    end if

    if m.playlistTypes.count() = playlistGrouping.Categories().count() then return items

    ' Only playlists answer to the type checkboxes, anything else in the library stays
    shown = []
    for each item in items
        json = item.json
        if not isValid(json) or not isStringEqual(json.LookupCI("Type"), "Playlist") or inArray(m.playlistTypes, playlistGrouping.CategoryOf(json, m.playlistCategories))
            shown.push(item)
        end if
    end for
    return shown
end function

' The server sorts on SortName, so a query is matched against that where it exists
function sortableName(item as object) as string
    name = chainLookupReturn(item, "json.SortName", "")
    if not isValidAndNotEmpty(name) then name = chainLookupReturn(item, "json.Name", "")
    return accentFolding.ForSearch(name)
end function

sub onSearchQueryChanged(event as object)
    m.searchQuery = event.getData()
    m.searchBox.query = m.searchQuery
    applySearchFilter()
    queueNextPage()
end sub

' Matching only sees the pages already fetched, so a query or a grouping that reaches past them
' pulls the rest in a page at a time. Typing would restart that walk on every letter, so it waits
' for a pause first.
sub queueNextPage()
    if isValid(m.searchPageTimer) then m.searchPageTimer.control = "stop"
    if m.searchQuery.Trim() = "" and m.grouping = "" then return

    if not isValid(m.searchPageTimer)
        m.searchPageTimer = createObject("roSGNode", "Timer")
        m.searchPageTimer.duration = 0.3
        m.searchPageTimer.repeat = false
        m.searchPageTimer.observeField("fire", "onSearchPageTimer")
    end if
    m.searchPageTimer.control = "start"
end sub

sub clearSearchQuery()
    m.searchQuery = ""
    m.searchBox.query = ""
end sub

sub onSearchPageTimer()
    if m.searchQuery.Trim() = "" and m.grouping = "" then return
    ' The task is still winding down from the page it just handed over, and a running task ignores
    ' being run again
    if m.loadItemsTask.state = "run"
        m.searchPageTimer.control = "start"
        return
    end if
    loadMoreData()
end sub

sub openSearchKeyboard()
    m.keyboard = tvKeyboard.Open(m.top.getScene(), {
        hint: tr("Search this library..."),
        text: m.searchQuery,
        showScrim: false,
        purpose: "search"
    })
    if not isValid(m.keyboard) then return

    m.keyboard.observeField("text", "onSearchQueryChanged")
    m.keyboard.observeField("submitted", "closeSearchKeyboard")
    m.keyboard.observeField("cancelled", "closeSearchKeyboard")
end sub

sub closeSearchKeyboard(_event as object)
    tvKeyboard.Release(m.keyboard, ["text", "submitted", "cancelled"])
    m.keyboard = invalid
    focusToolbarItem(4)
end sub

sub alphaSelectedChanged()
    ' Allow user to toggle by clicking letter twice
    if isStringEqual(m.loadItemsTask.nameStartsWith, m.top.alphaSelected)
        m.top.alphaSelected = string.EMPTY
    end if

    resetLoadedItems()

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData

    m.loadItemsTask.nameStartsWith = m.top.alphaSelected
    loadInitialItems()
end sub

' The item is gone from the server, so it leaves every list it was drawn in and the count drops
sub removeItem(itemId as string)
    kept = []
    for each item in m.allItems
        if not isStringEqual(chainLookupReturn(item, "json.Id", ""), itemId) then kept.push(item)
    end for
    removed = m.allItems.count() - kept.count()
    if removed = 0 then return

    focused = m.grid.itemFocused
    m.allItems = kept
    m.searchNames = []
    m.loadedItems -= removed
    m.serverPosition -= removed
    m.loadItemsTask.totalRecordCount -= removed
    applySearchFilter()

    shown = m.grid.content
    if not isValid(shown) or m.groupLayout = "rows" then return
    if focused >= shown.getChildCount() then focused = shown.getChildCount() - 1
    if focused > 0 then m.grid.jumpToItem = focused
end sub

' =====================================================================
' STATUS BAR
' =====================================================================

' The count sits beside the library name, and is re-centred as it changes width
sub updateStatusBar()
    totalCount = m.loadItemsTask.totalRecordCount - m.blockedCount
    countText = ""
    if totalCount = 1
        countText = tr("1 item")
    else if totalCount > 1
        countText = tr("{count} items").Replace("{count}", totalCount.toStr())
    end if
    m.itemCountLabel.text = countText
    centreTitleRow()
end sub

' The name and the count read as one line, so the pair is centred rather than each of them.
' Modern starts the line at the margin and Docked stacks the two beside its Home button.
sub centreTitleRow()
    if m.libraryStyle = "docked"
        m.libraryName.translation = [DOCK_TITLE_LEFT, 30]
        m.itemCountLabel.translation = [DOCK_TITLE_LEFT, 66]
        return
    end if

    nameWidth = m.libraryName.boundingRect().width
    countWidth = m.itemCountLabel.boundingRect().width
    gap = countWidth > 0 ? 17 : 0

    startX = (1920 - (nameWidth + gap + countWidth)) / 2
    if m.libraryStyle = "modern" then startX = MARGIN_X
    m.libraryName.translation = [startX, 20]
    m.itemCountLabel.translation = [startX + nameWidth + gap, 22]
end sub


' =====================================================================
' LIBRARY STYLES
' =====================================================================

' Classic keeps the header every library had, Modern puts the controls in one bar under the title
' and Docked moves them into a panel down the left with the grid beside it
sub applyLibraryStyle()
    style = settingOr(LIBRARY_STYLE_SETTING, "classic")
    if not inArray(["classic", "modern", "docked"], style) then style = "classic"
    m.libraryStyle = style
    classic = style = "classic"
    docked = style = "docked"

    m.styledHeader.visible = not classic
    m.toolbarButtons = classic ? m.classicButtons : m.styledButtons
    m.dockPanel.visible = docked
    m.dockEdge.visible = docked
    m.dockRule.visible = docked and m.alphaPicker.visible
    for each node in [m.modernBar, m.modernBarBorder, m.modernRuleHome, m.modernRuleSort]
        node.visible = style = "modern"
    end for

    m.focusedInfo.translation = [MARGIN_X, 84]
    if style = "modern"
        m.focusedInfo.translation = [MARGIN_X, MODERN_BAR_TOP + MODERN_BAR_HEIGHT + 16]
        m.alphaPicker.translation = [MARGIN_X, MODERN_GRID_TOP - 50]
    else if docked
        m.focusedInfo.translation = [DOCK_GRID_LEFT, 42]
    end if

    ' The letters run in one line, or seven to a row in the panel with every row in view
    m.alphaGrid.numColumns = docked ? 7 : 28
    m.alphaGrid.numRows = docked ? 4 : 1
    m.alphaGrid.itemSpacing = docked ? [18, 24] : [10, 0]
    m.alphaGrid.vertFocusAnimationStyle = docked ? "floatingFocus" : "fixed"

    if classic
        m.searchBox.translation = [1369, 9]
        m.searchBox.boxWidth = 464
    end if

    layoutContent()
    m.selectedItemName.width = m.gridWidth
    m.libraryName.width = docked ? DOCK_ROW_WIDTH - DOCK_TITLE_LEFT + DOCK_PAD_X : 0

    layoutClassicButtons()
    layoutStyledHeader()
    centreTitleRow()
end sub

' Where the grid, the rows and the chips sit for the style, with the chips taking room off the top
sub layoutContent()
    gridLeft = MARGIN_X
    gridTop = 316
    m.gridWidth = libraryCard.GRID_WIDTH
    if m.libraryStyle = "modern"
        gridTop = MODERN_GRID_TOP
    else if m.libraryStyle = "docked"
        gridLeft = DOCK_GRID_LEFT
        gridTop = DOCK_GRID_TOP
        m.gridWidth = DOCK_GRID_WIDTH
    end if

    m.categoryBar.translation = [gridLeft, gridTop]
    m.categoryBar.maxWidth = m.gridWidth
    if m.groupLayout = "tabs" then gridTop += CATEGORY_BAR_SPACE

    room = 1056 - gridTop
    m.gridRoom = room
    for each grid in [m.itemGrid, m.horizontalGrid, m.groupRows, m.genreGrid]
        grid.translation = [gridLeft, gridTop]
    end for
    m.itemGrid.clippingRect = [0, 0, m.gridWidth, room]
    m.horizontalGrid.clippingRect = [0, 0, m.gridWidth, room]
    m.groupRows.clippingRect = [0, -60, m.gridWidth, room + 60]
    m.genreGrid.clippingRect = [-30, -20, m.gridWidth + 60, room + 37]
    m.genreGrid.numColumns = m.libraryStyle = "docked" ? 3 : 4
end sub

' Which header controls this library shows, in the order focus walks them. Home leads, then the
' search in Modern and Docked, Sort, Group By for movies and shows, Show where there is a played
' status, Shuffle for songs and Display for anything but music.
function toolbarOrder() as object
    classic = m.libraryStyle = "classic"
    order = [FOCUS_HOME]
    if not classic then order.push(FOCUS_SEARCH)
    order.push(FOCUS_SORT)
    if canGroup() then order.push(FOCUS_GROUP)
    if not classic and not isMusicLibrary() then order.push(FOCUS_SHOW)
    if isSongsBrowse() then order.push(FOCUS_SHUFFLE)
    if not isMusicLibrary() then order.push(FOCUS_DISPLAY)
    return order
end function

function headerControlShown(index as integer) as boolean
    return hasIndex(toolbarOrder(), index)
end function

function hasIndex(order as object, index as integer) as boolean
    for each entry in order
        if entry = index then return true
    end for
    return false
end function

' Classic's icons sit in one line over the grid with the letters after them
sub layoutClassicButtons()
    classic = m.libraryStyle = "classic"
    x = MARGIN_X
    for each index in [FOCUS_HOME, FOCUS_SORT, FOCUS_GROUP, FOCUS_SHUFFLE, FOCUS_DISPLAY]
        button = m.classicButtons[index]
        button.visible = classic and headerControlShown(index)
        if button.visible
            button.callFunc("layout", { height: CLASSIC_BUTTON_SIZE })
            button.translation = [x, CLASSIC_BAR_TOP]
            x += CLASSIC_BUTTON_SIZE + CLASSIC_BUTTON_GAP
        end if
    end for
    if classic then m.alphaPicker.translation = [x + 12, 255]
end sub

' The controls name what they are set to, so they are laid out again whenever that changes
sub layoutStyledHeader()
    ' The sort label needs the library, which init runs before
    if m.libraryStyle = "classic" or not isValid(m.top.parentItem) then return

    ' What each control says, by its place in the focus order
    labeled = [invalid, invalid, invalid, invalid, invalid, invalid, invalid, invalid]
    labeled[FOCUS_SORT] = { height: HEADER_CONTROL_HEIGHT, text: tr("Sort By"), value: librarySorts.Chosen(m.sortKey, sortKind()).label, sortOrder: m.sortOrder }
    labeled[FOCUS_GROUP] = { height: HEADER_CONTROL_HEIGHT, text: tr("Group By"), value: libraryGroupBy.Label(m.groupBy) }
    labeled[FOCUS_SHOW] = { height: HEADER_CONTROL_HEIGHT, text: tr("Show"), value: playedLabel() }
    m.styledHome.callFunc("layout", { height: HEADER_CONTROL_HEIGHT })

    shown = toolbarOrder()
    for i = 1 to m.styledButtons.count() - 1
        button = m.styledButtons[i]
        if isValid(button) then button.visible = hasIndex(shown, i)
    end for

    if m.libraryStyle = "docked"
        m.styledHome.translation = [DOCK_PAD_X - 6, 42]
        m.searchBox.translation = [DOCK_PAD_X, 132]
        m.searchBox.boxWidth = DOCK_ROW_WIDTH
        m.styledDisplay.icon = "grid_view"
        labeled[FOCUS_SHUFFLE] = { text: tr("Shuffle") }
        labeled[FOCUS_DISPLAY] = { text: tr("Display"), value: imageTypeLabel() }
        rowTop = 222
        for each index in shown
            args = labeled[index]
            if isValid(args)
                args.height = DOCK_ROW_HEIGHT
                args.width = DOCK_ROW_WIDTH
                m.styledButtons[index].callFunc("layout", args)
                m.styledButtons[index].translation = [DOCK_PAD_X, rowTop]
                rowTop += DOCK_ROW_HEIGHT + 6
            end if
        end for

        ' The letters follow the last row, under a rule and a caption saying what they do
        m.dockRule.translation = [DOCK_PAD_X, rowTop + 12]
        m.letterCaption.translation = [DOCK_PAD_X, rowTop + 25]
        m.letterCaption.width = DOCK_ROW_WIDTH
        m.letterCaption.height = 26
        m.alphaPicker.translation = [DOCK_PAD_X, rowTop + 63]
        return
    end if

    ' Home and the search lead the bar, and the labeled controls are packed against its far end
    top = MODERN_BAR_TOP + MODERN_BAR_PAD
    barRight = MARGIN_X + libraryCard.GRID_WIDTH - MODERN_BAR_PAD
    m.modernBar.translation = [MARGIN_X, MODERN_BAR_TOP]
    m.modernBarBorder.translation = [MARGIN_X, MODERN_BAR_TOP]
    for each layer in [m.modernBar, m.modernBarBorder]
        layer.width = libraryCard.GRID_WIDTH
        layer.height = MODERN_BAR_HEIGHT
    end for

    m.styledHome.translation = [MARGIN_X + MODERN_BAR_PAD, top]
    m.styledDisplay.icon = "settings"

    right = barRight + MODERN_CONTROL_GAP
    sortLeft = right
    for i = shown.count() - 1 to 0 step -1
        index = shown[i]
        if index <> FOCUS_HOME and index <> FOCUS_SEARCH
            args = labeled[index]
            if not isValid(args) then args = { height: HEADER_CONTROL_HEIGHT }
            left = right - MODERN_CONTROL_GAP - m.styledButtons[index].callFunc("layout", args)
            m.styledButtons[index].translation = [left, top]
            right = left
            sortLeft = left
        end if
    end for

    ruleTop = MODERN_BAR_TOP + (MODERN_BAR_HEIGHT - 42) / 2
    searchLeft = MARGIN_X + MODERN_BAR_PAD + HEADER_CONTROL_HEIGHT + MODERN_BAR_PAD
    m.modernRuleHome.translation = [searchLeft, ruleTop]
    m.modernRuleSort.translation = [sortLeft - MODERN_BAR_PAD - 1, ruleTop]
    searchLeft += 1 + MODERN_BAR_PAD
    m.searchBox.translation = [searchLeft, top]
    m.searchBox.boxWidth = sortLeft - (MODERN_BAR_PAD * 2) - 1 - searchLeft
end sub

function imageTypeLabel() as string
    if isPlaylistLibrary() then return ""
    imageType = currentImageType()
    if imageType = "thumbnail" then return tr("Thumbnail")
    if imageType = "banner" then return tr("Banner")
    if imageType = "poster" then return tr("Poster")
    return ""
end function

function playedLabel() as string
    for each option in libraryFilters.PlayedOptions()
        if isStringEqual(option.value, m.filterState.played) then return option.label
    end for
    return tr("All")
end function

function styledHeaderFocused() as boolean
    if m.libraryStyle = "classic" then return false
    if m.searchBox.isInFocusChain() then return true
    return toolbarButtonFocused()
end function

function toolbarButtonFocused() as boolean
    for each btn in m.toolbarButtons
        if isValid(btn) and btn.isInFocusChain() then return true
    end for
    return false
end function

' Modern steps along its bar with Left and Right, Docked down its panel with Up and Down and
' Classic along its icons, all in the order toolbarOrder gives. The other axis leaves for the
' letters, the search or the grid.
function onToolbarKey(key as string) as boolean
    if isStringEqual(key, KeyCode.BACK)
        leaveLibrary()
        return true
    end if

    if isStringEqual(key, KeyCode.OK)
        index = m.toolbarFocusIndex
        if index = FOCUS_HOME
            reclaimResources()
            m.global.sceneManager.callFunc("goHome")
        else if index = FOCUS_SEARCH
            openSearchKeyboard()
        else if index = FOCUS_SORT
            openSortDialog()
        else if index = FOCUS_SHOW
            openSortDialog("played")
        else if index = FOCUS_DISPLAY
            openDisplayDialog()
        else if index = FOCUS_GROUP
            openGroupDialog()
        else if index = FOCUS_SHUFFLE
            shuffleSongs()
        end if
        return true
    end if

    classic = m.libraryStyle = "classic"
    docked = m.libraryStyle = "docked"
    order = toolbarOrder()
    position = 0
    for i = 0 to order.count() - 1
        if order[i] = m.toolbarFocusIndex then position = i
    end for

    if isStringEqual(key, docked ? KeyCode.UP : KeyCode.LEFT)
        if position > 0 then focusToolbarItem(order[position - 1])
        return true
    end if

    if isStringEqual(key, docked ? KeyCode.DOWN : KeyCode.RIGHT)
        if position < order.count() - 1
            focusToolbarItem(order[position + 1])
        else if not isStringEqual(m.libraryStyle, "modern") and m.alphaPicker.visible
            focusToolbarItem(FOCUS_LETTERS)
        end if
        return true
    end if

    if isStringEqual(key, docked ? KeyCode.RIGHT : KeyCode.DOWN)
        if m.libraryStyle = "modern" and m.alphaPicker.visible
            focusToolbarItem(FOCUS_LETTERS)
        else if m.loadedItems > 0
            unfocusAllToolbarItems()
            focusContent()
        end if
        return true
    end if

    ' Classic's search sits above its icons
    if classic and isStringEqual(key, KeyCode.UP)
        focusToolbarItem(FOCUS_SEARCH)
        return true
    end if

    return isStringEqual(key, docked ? KeyCode.LEFT : KeyCode.UP)
end function

sub leaveLibrary()
    reclaimResources()
    m.global.sceneManager.callfunc("popScene")
end sub

' Up to 300 of the library's songs in a random order
sub shuffleSongs()
    if not isValid(m.shuffleTask)
        m.shuffleTask = createObject("roSGNode", "JellyfinAPITask")
        m.shuffleTask.observeField("response", "onShuffleLoaded")
    end if
    m.shuffleTask.control = TaskControl.STOP
    m.shuffleTask.request = {
        path: "Items",
        params: {
            userId: m.global.session.user.id,
            parentId: getParentItemId(),
            includeItemTypes: "Audio",
            recursive: true,
            sortBy: "Random",
            limit: 300,
            fields: "PrimaryImageAspectRatio"
        }
    }
    m.shuffleTask.control = TaskControl.RUN
    startLoadingSpinner()
end sub

sub onShuffleLoaded(event as object)
    response = event.getData()
    tracks = []
    if isValid(response) and response.success = true then tracks = responseItems(response.data)
    if tracks.count() = 0
        stopLoadingSpinner()
        return
    end if

    queue = m.global.queueManager
    queue.callFunc("clear")
    queue.callFunc("resetShuffle")
    queue.callFunc("set", tracks)
    queue.callFunc("setPosition", 0)
    queue.callFunc("playQueue")
end sub

' What Up from the top row of letters reaches
function aboveLetters() as integer
    if m.libraryStyle = "modern" then return m.barFocusIndex
    order = toolbarOrder()
    if m.libraryStyle = "docked" then return order[order.count() - 1]
    return FOCUS_SEARCH
end function

' =====================================================================
' TOOLBAR FOCUS MANAGEMENT
' =====================================================================

sub focusToolbarItem(index as integer)
    ' The alphabet strip can be turned off, so focus lands back on the last header control
    ' rather than on nothing
    if index = FOCUS_LETTERS and not m.alphaPicker.visible
        order = toolbarOrder()
        index = order[order.count() - 1]
    end if
    if index <> FOCUS_LETTERS and index <> FOCUS_SEARCH and not headerControlShown(index) then index = FOCUS_HOME

    unfocusAllToolbarItems()

    m.toolbarFocusIndex = index
    if index <> FOCUS_LETTERS then m.barFocusIndex = index
    m.searchBox.focused = index = FOCUS_SEARCH

    button = m.toolbarButtons[index]
    if isValid(button)
        button.focus = true
        button.setFocus(true)
        setLastFocus(button)
    else if index = FOCUS_LETTERS
        m.alphaGrid.setFocus(true)
        setLastFocus(m.alphaGrid)
    else if index = FOCUS_SEARCH
        m.searchBox.setFocus(true)
        setLastFocus(m.searchBox)
    end if
end sub

' The list under the toolbar: the grouped rows, the category chips, the genres or the grid
sub focusContent()
    if m.loadedItems = 0 then return
    target = m.grid
    if isStringEqual(m.view, "Genres")
        target = m.genreGrid
    else if m.groupLayout = "rows"
        target = m.groupRows
    else if m.groupLayout = "tabs"
        target = m.categoryBar
    end if
    target.setFocus(true)
    setLastFocus(target)
end sub

sub unfocusAllToolbarItems()
    m.searchBox.focused = false
    for each btn in m.toolbarButtons
        if isValid(btn) then btn.focus = false
    end for
end sub

' =====================================================================
' KEY EVENT HANDLER
' =====================================================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if styledHeaderFocused() then return onToolbarKey(key)

    ' Classic's search sits on its own above the icons
    if m.searchBox.isInFocusChain()
        if isStringEqual(key, KeyCode.OK)
            openSearchKeyboard()
            return true
        end if

        if isStringEqual(key, KeyCode.LEFT)
            focusToolbarItem(FOCUS_LETTERS)
            return true
        end if

        if isStringEqual(key, KeyCode.DOWN)
            m.searchBox.focused = false
            focusToolbarItem(FOCUS_HOME)
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            leaveLibrary()
            return true
        end if

        return true
    end if

    if toolbarButtonFocused() then return onToolbarKey(key)

    ' ---- ALPHA PICKER NAVIGATION ----
    if m.alphaGrid.isInFocusChain()
        columns = m.alphaGrid.numColumns
        letter = m.alphaGrid.itemFocused
        letterCount = m.alphaGrid.content.getChildCount()
        if isStringEqual(key, KeyCode.LEFT) and letter mod columns = 0
            ' Classic's letters follow its icons, so Left off the first letter reaches the last one
            if m.libraryStyle = "classic"
                order = toolbarOrder()
                focusToolbarItem(order[order.count() - 1])
            end if
            return true
        end if

        ' Docked's letters sit left of the grid, so Right off the end of a row reaches it
        if isStringEqual(key, KeyCode.RIGHT) and m.libraryStyle = "docked" and ((letter + 1) mod columns = 0 or letter = letterCount - 1)
            if m.loadedItems > 0
                unfocusAllToolbarItems()
                focusContent()
            end if
            return true
        end if

        ' Docked stacks the letters in rows, so Up and Down only leave them from the outer rows
        if isStringEqual(key, KeyCode.UP)
            if letter >= columns
                m.alphaGrid.jumpToItem = letter - columns
            else
                focusToolbarItem(aboveLetters())
            end if
            return true
        end if

        if isStringEqual(key, KeyCode.DOWN)
            if letter + columns < letterCount
                m.alphaGrid.jumpToItem = letter + columns
                return true
            end if
            unfocusAllToolbarItems()
            focusContent()
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            leaveLibrary()
            return true
        end if

        return false
    end if

    ' ---- GROUP BY CHIPS ----
    if m.categoryBar.isInFocusChain()
        if isStringEqual(key, KeyCode.BACK)
            leaveLibrary()
            return true
        end if
        return false
    end if

    ' ---- GROUPED ROWS ----
    if m.groupRows.isInFocusChain()
        focused = m.groupRows.rowItemFocused
        atTop = not isValid(focused) or focused.count() < 1 or focused[0] = 0
        if isStringEqual(key, KeyCode.UP) and atTop
            focusToolbarItem(m.toolbarFocusIndex)
            return true
        end if

        if isStringEqual(key, KeyCode.LEFT) and m.libraryStyle = "docked" and isValid(focused) and focused.count() > 1 and focused[1] = 0
            focusToolbarItem(m.toolbarFocusIndex)
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            if not atTop
                m.groupRows.jumpToRowItem = [0, 0]
                return true
            end if
            leaveLibrary()
            return true
        end if

        return handleCardKey(key)
    end if

    ' ---- GRID / GENRE GRID NAVIGATION ----
    if m.grid.isinFocusChain() or m.genreGrid.isinFocusChain()
        gridComponent = m.grid.isinFocusChain() ? m.grid : m.genreGrid
        ' Docked keeps its controls left of the grid
        if isStringEqual(key, KeyCode.LEFT) and m.libraryStyle = "docked" and atFirstColumn(gridComponent)
            focusToolbarItem(m.toolbarFocusIndex)
            return true
        end if

        ' Above the top row are the category chips while grouped, the toolbar otherwise
        if isStringEqual(key, KeyCode.UP) and onTopRow(gridComponent)
            if m.groupLayout = "tabs"
                m.categoryBar.setFocus(true)
                setLastFocus(m.categoryBar)
            else
                focusToolbarItem(m.toolbarFocusIndex)
            end if
            return true
        end if

        if isStringEqual(key, KeyCode.BACK)
            if scrolledAway(gridComponent)
                gridComponent.jumpToItem = 0
                return true
            end if
            leaveLibrary()
            return true
        end if

        return handleCardKey(key)
    end if

    return false
end function

' The sideways grid runs its items down each column, the upright ones across each row
function onTopRow(grid as object) as boolean
    if grid.isSameNode(m.horizontalGrid) then return grid.itemFocused mod grid.layout.rows = 0
    return grid.itemFocused < grid.numColumns
end function

function atFirstColumn(grid as object) as boolean
    if grid.isSameNode(m.horizontalGrid) then return grid.itemFocused < grid.layout.rows
    return grid.itemFocused mod grid.numColumns = 0
end function

function scrolledAway(grid as object) as boolean
    if grid.isSameNode(m.horizontalGrid) then return grid.firstColumn > 0
    return grid.itemFocused >= grid.numColumns
end function

' Play starts the focused card, or opens it when it is a photo, and Options opens its menu
function handleCardKey(key as string) as boolean
    if not isStringEqual(key, KeyCode.PLAY) and not isStringEqual(key, KeyCode.OPTIONS) then return false
    focusedItem = getItemFocused()
    if not isValid(focusedItem) then return false
    if isStringEqual(key, KeyCode.OPTIONS) then return showItemMenu(focusedItem)

    if isStringEqual(ItemType.PHOTO, chainLookupReturn(focusedItem, "type", string.EMPTY))
        m.top.selectedItem = focusedItem
        m.top.selectedItem = invalid
    else
        m.top.quickPlayNode = focusedItem
    end if
    return true
end function

' =====================================================================
' CARD MENU
' =====================================================================

' The menu changed a card here, so its badges follow
sub itemMenuChanged(action as string, card as dynamic, menuJson as object)
    if type(card) <> "roSGNode" then return

    userData = menuJson.UserData
    if type(userData) <> "roAssociativeArray" then return

    if action = "watched" or action = "hideContinueWatching" or action = "hideNextUp"
        ' Unwatched puts the whole count back, which the card works out when given none
        card.callFunc("setWatched", itemMenu.IsTrue(userData.Played), 0)
    else if action = "favorite" and card.hasField("favorite")
        card.favorite = itemMenu.IsTrue(userData.IsFavorite)
    end if
end sub

sub reclaimResources()
    ' Stopping a task blocks the render thread until the task returns, and a request
    ' in flight is long enough for the watchdog to kill the channel. A running one is
    ' let go of instead, since every caller pops the scene straight after.
    if isValid(m.loadItemsTask)
        m.loadItemsTask.unobserveField("content")
        if not isStringEqual(m.loadItemsTask.state, "run")
            m.loadItemsTask.control = TaskControl.STOP
        end if
        m.loadItemsTask.content = []
    end if

    resetLoadedItems()

    m.genreData = createSGNode("ContentNode")
    m.genreGrid.content = m.genreData
end sub

' Items the search is hiding, and categories off screen, are in no list, so they are brought up
' to date as well
sub userDataApplied(changes as object)
    for each item in m.allItems
        userDataSync.ApplyToNode(item, changes)
    end for
    for each key in m.categoryRows
        userDataSync.ApplyToTree(m.categoryRows[key], changes)
    end for
end sub

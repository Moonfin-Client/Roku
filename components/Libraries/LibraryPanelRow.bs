import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/libraryPanel.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/trackDialog.bs"

' One row of a library dialog. Section headings, radio choices, checkboxes, settings and
' plain actions all take the same stride, so a whole dialog stays on one list.

const RULE_TOP = 6
const SORT_ARROW_SIZE = 20
const CLEAR_ICON_SIZE = 18
const FIELD_INSET_Y = 3
const FIELD_ICON_INSET = 20
const FIELD_ICON_SIZE = 28
const FIELD_ICON_GAP = 16
const FIELD_TEXT_SIZE = 25
const NOTE_SIZE = 15
const EXPAND_GLYPH_SIZE = 26
const SUMMARY_MAX_WIDTH = 200
const SUMMARY_GAP = 12
' A group's name sits at about three quarters white until it has the focus
const HEADING_INK = "#FFFFFFB8"

sub init()
    m.rowBg = m.top.findNode("rowBg")
    m.rowBorder = m.top.findNode("rowBorder")
    m.rule = m.top.findNode("rule")
    m.controlOutline = m.top.findNode("controlOutline")
    m.controlFill = m.top.findNode("controlFill")
    m.controlMark = m.top.findNode("controlMark")
    m.rowLabel = m.top.findNode("rowLabel")
    m.rowValue = m.top.findNode("rowValue")
    m.rowSummary = m.top.findNode("rowSummary")
    m.sortArrow = m.top.findNode("sortArrow")
    m.fieldPill = m.top.findNode("fieldPill")
    m.fieldRing = m.top.findNode("fieldRing")
    m.rowIcon = m.top.findNode("rowIcon")
    m.expandGlyph = m.top.findNode("expandGlyph")
    m.glyphFont = CreateObject("roSGNode", "Font")
    m.glyphFont.uri = settingsGlyphs.FONT_URI
    m.glyphFont.size = EXPAND_GLYPH_SIZE

    if themeChrome.IsActive() then m.fieldPill.blendColor = themeChrome.SurfaceVariant()
    m.fieldRing.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")

    m.accent = themeChrome.IsActive() ? themeChrome.Accent() : formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT), ColorPalette.HIGHLIGHT)
    m.onAccent = themeChrome.IsActive() ? themeChrome.OnAccent() : "#FFFFFF"

    applyRowWidth(trackDialog.PANEL_WIDTH)
    m.rowBorder.blendColor = m.accent
    m.rule.translation = [trackDialog.ROW_PAD_X, RULE_TOP]

    m.controlOutline.width = libraryPanel.CONTROL_SIZE
    m.controlOutline.height = libraryPanel.CONTROL_SIZE

    ' The radio dot sits inside the ring, the check sits inside the filled square
    m.controlFill.uri = "pkg:/images/icons/circle.webp"
    m.controlFill.blendColor = m.accent
    m.controlFill.width = libraryPanel.RADIO_DOT_SIZE
    m.controlFill.height = libraryPanel.RADIO_DOT_SIZE

    m.controlMark.blendColor = m.onAccent
    m.controlMark.width = libraryPanel.CHECK_MARK_SIZE
    m.controlMark.height = libraryPanel.CHECK_MARK_SIZE

    m.sortArrow.width = SORT_ARROW_SIZE
    m.sortArrow.height = SORT_ARROW_SIZE
    m.sortArrow.blendColor = m.accent

    m.rowSummary.font.size = libraryPanel.HEADER_SIZE
    m.rowSummary.color = m.accent
    m.rowValue.font.size = libraryPanel.SETTING_VALUE_SIZE
end sub

' The focus chip stops short of the panel edge, the way the web insets its rows
sub applyRowWidth(width as integer)
    m.rowWidth = width

    chipWidth = width - (libraryPanel.CHIP_INSET * 2)
    for each layer in [m.rowBg, m.rowBorder]
        layer.width = chipWidth
    end for
    m.rule.width = width - (trackDialog.ROW_PAD_X * 2)
end sub

' Everything sits in whatever the rule leaves behind, so a row carrying one still takes
' the same stride as the rest
function contentBand() as object
    top = m.rule.visible ? RULE_TOP + 1 : 0
    return { top: top, height: m.top.itemContent.rowHeight - top }
end function

sub centreVertically(node as object, height as integer, band as object)
    node.translation = [node.translation[0], band.top + ((band.height - height) / 2)]
end sub

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    m.kind = content.kind
    if content.rowWidth > 0 and content.rowWidth <> m.rowWidth then applyRowWidth(content.rowWidth)
    m.rule.visible = content.ruleAbove = true
    band = contentBand()

    ' A row giving up part of itself to a rule keeps its chip clear of it
    for each layer in [m.rowBg, m.rowBorder]
        layer.height = band.height
        layer.translation = [libraryPanel.CHIP_INSET, band.top]
    end for

    m.rowLabel.text = content.title ?? ""
    m.fieldPill.visible = false
    m.fieldRing.visible = false
    m.rowIcon.visible = false
    m.expandGlyph.visible = false

    if m.kind = "header"
        layoutHeader(content, band)
    else if m.kind = "heading"
        layoutHeading(band)
    else if m.kind = "setting"
        layoutSetting(content, band)
    else if m.kind = "clear"
        layoutClear(content, band)
    else if m.kind = "search"
        layoutSearch(content, band)
    else
        layoutOption(content, band)
    end if

    applyFocusInk()
end sub

' A group reads as its name, what it holds on the right in the accent, and the glyph that says
' whether it's open
sub layoutHeader(content as object, band as object)
    hideControls()

    ' The screen's theme font replaces every label's font when it is pushed, this one included
    m.expandGlyph.font = m.glyphFont
    m.expandGlyph.text = settingsGlyphs.Char(content.expanded = true ? "expand_less" : "expand_more")
    m.expandGlyph.width = EXPAND_GLYPH_SIZE
    m.expandGlyph.height = band.height
    glyphLeft = m.rowWidth - libraryPanel.HEADER_PAD_X - EXPAND_GLYPH_SIZE
    m.expandGlyph.translation = [glyphLeft, band.top]
    m.expandGlyph.visible = true

    m.rowLabel.font.size = libraryPanel.HEADER_SIZE
    labelLeft = libraryPanel.HEADER_PAD_X

    ' A tag or a library name can run long, so the summary takes a fixed slice and the name
    ' keeps the rest
    m.rowSummary.visible = isValidAndNotEmpty(content.summary)
    summaryWidth = 0
    if m.rowSummary.visible
        m.rowSummary.text = content.summary
        summaryWidth = SUMMARY_MAX_WIDTH
        m.rowSummary.width = summaryWidth
        m.rowSummary.height = band.height
        m.rowSummary.translation = [glyphLeft - SUMMARY_GAP - summaryWidth, band.top]
        summaryWidth += SUMMARY_GAP
    end if

    m.rowLabel.width = glyphLeft - labelLeft - SUMMARY_GAP - summaryWidth
    m.rowLabel.height = band.height
    m.rowLabel.translation = [labelLeft, band.top]
end sub

' A heading only names the rows under it, so it has nothing to open and the cursor steps past it
sub layoutHeading(band as object)
    hideControls()
    m.rowSummary.visible = false
    m.rowLabel.font.size = libraryPanel.HEADER_SIZE
    m.rowLabel.width = m.rowWidth - (libraryPanel.HEADER_PAD_X * 2)
    m.rowLabel.height = band.height
    m.rowLabel.translation = [libraryPanel.HEADER_PAD_X, band.top]
end sub

sub hideControls()
    m.controlOutline.visible = false
    m.controlFill.visible = false
    m.controlMark.visible = false
    m.sortArrow.visible = false
    m.rowValue.visible = false
end sub

sub layoutOption(content as object, band as object)
    selected = content.selected = true

    m.rowSummary.visible = false
    m.rowValue.visible = false

    hasControl = m.kind = "radio" or m.kind = "check"
    m.controlOutline.visible = hasControl
    m.controlFill.visible = hasControl and selected and m.kind = "radio"
    m.controlMark.visible = hasControl and selected and m.kind = "check"

    labelLeft = trackDialog.ROW_PAD_X
    if hasControl
        m.controlOutline.uri = m.kind = "radio" ? "pkg:/images/icons/radio_outline.webp" : "pkg:/images/icons/checkbox_outline.webp"
        m.controlOutline.blendColor = selected ? m.accent : libraryPanel.MUTED_INK
        m.controlOutline.translation = [trackDialog.ROW_PAD_X, 0]
        centreVertically(m.controlOutline, libraryPanel.CONTROL_SIZE, band)

        if m.kind = "radio"
            inset = (libraryPanel.CONTROL_SIZE - libraryPanel.RADIO_DOT_SIZE) / 2
            m.controlFill.translation = [trackDialog.ROW_PAD_X + inset, m.controlOutline.translation[1] + inset]
        else
            inset = (libraryPanel.CONTROL_SIZE - libraryPanel.CHECK_MARK_SIZE) / 2
            m.controlMark.translation = [trackDialog.ROW_PAD_X + inset, m.controlOutline.translation[1] + inset]
        end if

        labelLeft += libraryPanel.CONTROL_SIZE + libraryPanel.CONTROL_GAP
    end if

    ' The active sort says which way it runs, since picking it again turns it around
    m.sortArrow.visible = isValidAndNotEmpty(content.sortOrder)
    arrowWidth = 0
    if m.sortArrow.visible
        m.sortArrow.uri = isStringEqual(content.sortOrder, "Descending") ? "pkg:/images/icons/sort_arrow_down.webp" : "pkg:/images/icons/sort_arrow_up.webp"
        m.sortArrow.translation = [m.rowWidth - trackDialog.ROW_PAD_X - SORT_ARROW_SIZE, 0]
        centreVertically(m.sortArrow, SORT_ARROW_SIZE, band)
        arrowWidth = SORT_ARROW_SIZE + libraryPanel.CONTROL_GAP
    end if

    m.rowLabel.font.size = m.kind = "note" ? NOTE_SIZE : libraryPanel.LABEL_SIZE
    m.rowLabel.width = m.rowWidth - labelLeft - trackDialog.ROW_PAD_X - arrowWidth
    m.rowLabel.height = band.height
    m.rowLabel.translation = [labelLeft, band.top]
end sub

' Clearing one group is an action of its own, marked in the accent with the filter-off icon
sub layoutClear(content as object, band as object)
    layoutOption(content, band)

    m.rowIcon.uri = "pkg:/images/icons/filter_off.webp"
    m.rowIcon.blendColor = m.accent
    placeIcon(CLEAR_ICON_SIZE, trackDialog.ROW_PAD_X, band)

    labelLeft = trackDialog.ROW_PAD_X + CLEAR_ICON_SIZE + libraryPanel.CONTROL_GAP
    m.rowLabel.width = m.rowWidth - labelLeft - trackDialog.ROW_PAD_X
    m.rowLabel.translation = [labelLeft, band.top]
end sub

' A long facet's search reads as the library's own search field, holding what was typed or the
' facet's name until something is
sub layoutSearch(content as object, band as object)
    layoutOption(content, band)

    left = libraryPanel.CHIP_INSET
    for each layer in [m.fieldPill, m.fieldRing]
        layer.width = m.rowWidth - (left * 2)
        layer.height = band.height - (FIELD_INSET_Y * 2)
        layer.translation = [left, band.top + FIELD_INSET_Y]
    end for
    m.fieldPill.visible = true

    m.rowIcon.uri = "pkg:/images/icons/search-light.webp"
    m.rowIcon.blendColor = "#FFFFFF"
    placeIcon(FIELD_ICON_SIZE, left + FIELD_ICON_INSET, band)

    labelLeft = left + FIELD_ICON_INSET + FIELD_ICON_SIZE + FIELD_ICON_GAP
    if isValidAndNotEmpty(content.value) then m.rowLabel.text = content.value
    m.rowLabel.font.size = FIELD_TEXT_SIZE
    m.rowLabel.width = m.rowWidth - labelLeft - left - FIELD_ICON_INSET
    m.rowLabel.translation = [labelLeft, band.top]
end sub

sub placeIcon(size as integer, left as integer, band as object)
    m.rowIcon.width = size
    m.rowIcon.height = size
    m.rowIcon.translation = [left, 0]
    centreVertically(m.rowIcon, size, band)
    m.rowIcon.visible = true
end sub

' A setting reads as what it is over what it currently holds
sub layoutSetting(content as object, band as object)
    m.controlOutline.visible = false
    m.controlFill.visible = false
    m.controlMark.visible = false
    m.rowSummary.visible = false
    m.sortArrow.visible = false

    width = m.rowWidth - (trackDialog.ROW_PAD_X * 2)
    used = libraryPanel.SETTING_LABEL_LINE + libraryPanel.SETTING_GAP + libraryPanel.SETTING_VALUE_SIZE
    top = band.top + ((band.height - used) / 2)

    m.rowLabel.font.size = libraryPanel.SETTING_LABEL_SIZE
    m.rowLabel.width = width
    m.rowLabel.height = libraryPanel.SETTING_LABEL_LINE
    m.rowLabel.translation = [trackDialog.ROW_PAD_X, top]

    m.rowValue.visible = true
    m.rowValue.text = content.summary ?? ""
    m.rowValue.width = width
    m.rowValue.translation = [trackDialog.ROW_PAD_X, top + libraryPanel.SETTING_LABEL_LINE + libraryPanel.SETTING_GAP]
end sub

' The list keeps its cursor after handing focus on, so a row only washes over while the
' list still holds it
sub applyFocusInk()
    focused = m.top.focusPercent > 0.5 and m.top.itemHasFocus
    content = m.top.itemContent

    ' The search field rings itself the way the library's own search does, rather than taking a
    ' chip, and a note never takes one since focus only passes over it
    isField = m.kind = "search"
    chip = focused and not isField and m.kind <> "note" and m.kind <> "heading"
    m.rowBg.opacity = chip ? libraryPanel.FOCUS_OPACITY : 0
    m.rowBorder.visible = chip
    m.fieldRing.visible = focused and isField

    if not isValid(content) then return

    if m.kind = "header"
        m.rowLabel.color = focused ? "#FFFFFF" : HEADING_INK
        m.expandGlyph.color = m.rowLabel.color
    else if m.kind = "heading"
        m.rowLabel.color = HEADING_INK
    else if m.kind = "setting"
        m.rowLabel.color = "#FFFFFF"
    else if isField
        m.rowLabel.color = isValidAndNotEmpty(content.value) ? "#FFFFFF" : "#FFFFFF80"
    else if m.kind = "clear"
        m.rowLabel.color = m.accent
    else if m.kind = "note"
        m.rowLabel.color = libraryPanel.MUTED_INK
    else
        m.rowLabel.color = focused or content.selected = true ? "#FFFFFF" : libraryPanel.LABEL_INK
    end if
end sub

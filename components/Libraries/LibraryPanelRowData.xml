<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the sort and filter dialog. The kind decides what gets drawn, and the
     section and value say what the dialog acts on when the row is picked -->
<component name="LibraryPanelRowData" extends="ContentNode">
  <interface>
    <!-- header, radio, check, setting or action -->
    <field id="kind" type="string" value="action" />
    <field id="section" type="string" value="" />
    <field id="value" type="string" value="" />
    <field id="summary" type="string" value="" />
    <field id="selected" type="boolean" value="false" />
    <field id="expanded" type="boolean" value="false" />
    <field id="ruleAbove" type="boolean" value="false" />
    <!-- The direction arrow the active sort row carries, empty on every other row -->
    <field id="sortOrder" type="string" value="" />
    <!-- Dialogs choose their own stride, and a row draws inside whatever it is given -->
    <field id="rowHeight" type="integer" value="54" />
  </interface>
</component>

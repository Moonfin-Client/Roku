import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playlistGrouping.bs"

sub init()
    m.top.functionName = "resolveCategories"
end sub

sub resolveCategories()
    userId = chainLookupReturn(m.global.session, "user.id", "")
    batch = {}
    for each playlist in m.top.playlists
        data = getJson(APIRequest(`Playlists/${playlist.id}/Items`, { UserId: userId, Limit: playlistGrouping.SAMPLE_SIZE }))
        category = playlist.summary
        if isValid(data) then category = playlistGrouping.CategoryFromItems(data.LookupCI("Items"))
        batch[playlist.id] = category

        if batch.count() = 3
            m.top.resolved = batch
            batch = {}
        end if
    end for
    if batch.count() > 0 then m.top.resolved = batch
end sub

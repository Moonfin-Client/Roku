import "pkg:/source/utils/misc.bs"
import "pkg:/source/enums/KeyCode.bs"

sub init()
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.applyingText = m.top.findNode("applyingText")
    m.emptyText = m.top.findNode("emptyText")
    m.hintText = m.top.findNode("hintText")
    m.titleText = m.top.findNode("titleText")
    m.fetchTask = m.top.findNode("fetchTask")
    m.downloadTask = m.top.findNode("downloadTask")
    m.subtitleText = m.top.findNode("subtitleText")
    m.posterArea = m.top.findNode("posterArea")

    m.fetchTask.observeField("images", "onImagesLoaded")
    m.downloadTask.observeField("result", "onDownloadResult")
    m.top.observeField("visible", "onVisibleChanged")

    m.currentItemIndex = 0
    m.windowStart = 0
    m.imageItems = []
    m.posterNodes = []
    m.focusRect = invalid

    ' Layout: 200x300 posters, 7 visible at once (7*225=1575px in 1640px wide area)
    m.itemWidth = 200
    m.itemHeight = 300
    m.itemStride = 225
    m.visibleWidth = 1640
    m.maxVisible = 7
end sub

sub onVisibleChanged()
    if m.top.visible
        if isValidAndNotEmpty(m.top.itemId)
            showLoadingState()
            m.fetchTask.control = "STOP"
            m.fetchTask.itemId = m.top.itemId
            m.fetchTask.imageType = "Primary"
            m.fetchTask.control = "RUN"
        end if
    else
        resetState()
    end if
end sub

sub onItemTitleChanged()
    if isValidAndNotEmpty(m.top.itemTitle)
        m.titleText.text = "Edit Poster — " + m.top.itemTitle
    end if
end sub

sub onItemIdChanged()
end sub

sub onImagesLoaded()
    result = m.fetchTask.images
    if not isValid(result) then return

    if not result.success or not isValid(result.items) or result.items.count() = 0
        showEmptyState()
        return
    end if

    m.imageItems = result.items
    buildPosterSlots()
    refreshPosterWindow()
    updateFocusAndCounter()
    showListState()
end sub

function getThumbnailUrl(image as object) as string
    if isValidAndNotEmpty(image.ThumbnailUrl)
        return image.ThumbnailUrl
    end if
    if isValidAndNotEmpty(image.Url)
        return image.Url
    end if
    return ""
end function

sub buildPosterSlots()
    while m.posterArea.getChildCount() > 0
        m.posterArea.removeChildIndex(0)
    end while

    m.posterNodes = []
    m.windowStart = 0
    m.currentItemIndex = 0

    slotCount = m.maxVisible
    if m.imageItems.count() < slotCount then slotCount = m.imageItems.count()

    ' Center the poster area horizontally within the dialog (dialog is 1720px wide)
    gap = m.itemStride - m.itemWidth
    totalWidth = slotCount * m.itemStride - gap
    centeredX = int((1720 - totalWidth) / 2)
    m.posterArea.translation = [centeredX, 130]

    ' Focus rect first so it renders behind posters
    m.focusRect = CreateObject("roSGNode", "Rectangle")
    m.focusRect.width = m.itemWidth + 8
    m.focusRect.height = m.itemHeight + 8
    m.focusRect.color = "#FFFFFF"
    m.focusRect.translation = [-4, -4]
    m.posterArea.appendChild(m.focusRect)

    for i = 0 to slotCount - 1
        xPos = i * m.itemStride

        backdrop = CreateObject("roSGNode", "Rectangle")
        backdrop.width = m.itemWidth
        backdrop.height = m.itemHeight
        backdrop.color = "#222222"
        backdrop.translation = [xPos, 0]
        m.posterArea.appendChild(backdrop)

        poster = CreateObject("roSGNode", "Poster")
        poster.width = m.itemWidth
        poster.height = m.itemHeight
        poster.loadWidth = m.itemWidth
        poster.loadHeight = m.itemHeight
        poster.loadDisplayMode = "scaleToZoom"
        poster.translation = [xPos, 0]
        m.posterArea.appendChild(poster)
        m.posterNodes.push(poster)
    end for
end sub

sub refreshPosterWindow()
    for i = 0 to m.posterNodes.count() - 1
        imageIdx = m.windowStart + i
        poster = m.posterNodes[i]
        if imageIdx < m.imageItems.count()
            poster.uri = getThumbnailUrl(m.imageItems[imageIdx])
        else
            poster.uri = ""
        end if
    end for
end sub

sub updateFocusAndCounter()
    slotIndex = m.currentItemIndex - m.windowStart
    m.focusRect.translation = [slotIndex * m.itemStride - 4, -4]
    m.subtitleText.text = (m.currentItemIndex + 1).toStr() + " of " + m.imageItems.count().toStr()
end sub

sub showLoadingState()
    m.posterArea.visible = false
    m.loadingGroup.visible = true
    m.applyingText.visible = false
    m.emptyText.visible = false
    m.hintText.visible = false
end sub

sub showListState()
    m.posterArea.visible = true
    m.loadingGroup.visible = false
    m.applyingText.visible = false
    m.emptyText.visible = false
    m.hintText.visible = true
    m.top.setFocus(true)
end sub

sub showEmptyState()
    m.posterArea.visible = false
    m.loadingGroup.visible = false
    m.applyingText.visible = false
    m.emptyText.visible = true
    m.hintText.visible = false
end sub

sub showApplyingState()
    m.applyingText.text = "Setting poster..."
    m.posterArea.visible = false
    m.loadingGroup.visible = false
    m.applyingText.visible = true
    m.emptyText.visible = false
    m.hintText.visible = false
    m.top.setFocus(true)
end sub

sub resetState()
    m.imageItems = []
    m.currentItemIndex = 0
    m.windowStart = 0
    m.posterNodes = []
    m.focusRect = invalid
    while m.posterArea.getChildCount() > 0
        m.posterArea.removeChildIndex(0)
    end while
    showLoadingState()
end sub

sub onDownloadResult()
    result = m.downloadTask.result
    if not isValid(result) then return

    if result.success
        m.top.posterChanged = true
        m.top.visible = false
    else
        m.applyingText.text = "Failed to set poster. Press Back to close."
    end if
end sub

sub applyPoster(imageUrl as string)
    showApplyingState()
    m.downloadTask.control = "STOP"
    m.downloadTask.itemId = m.top.itemId
    m.downloadTask.imageType = "Primary"
    m.downloadTask.imageUrl = imageUrl
    m.downloadTask.control = "RUN"
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.top.visible = false
        return true
    end if

    if m.posterArea.visible and m.imageItems.count() > 0
        if key = KeyCode.LEFT
            if m.currentItemIndex > 0
                m.currentItemIndex--
                if m.currentItemIndex < m.windowStart
                    m.windowStart = m.currentItemIndex
                    refreshPosterWindow()
                end if
                updateFocusAndCounter()
            end if
            return true
        end if

        if key = KeyCode.RIGHT
            if m.currentItemIndex < m.imageItems.count() - 1
                m.currentItemIndex++
                if m.currentItemIndex >= m.windowStart + m.posterNodes.count()
                    m.windowStart = m.currentItemIndex - m.posterNodes.count() + 1
                    refreshPosterWindow()
                end if
                updateFocusAndCounter()
            end if
            return true
        end if

        if key = KeyCode.OK
            image = m.imageItems[m.currentItemIndex]
            url = image.Url
            if isValidAndNotEmpty(url)
                applyPoster(url)
            end if
            return true
        end if
    end if

    return false
end function

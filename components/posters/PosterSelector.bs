import "pkg:/source/utils/misc.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/ColorPalette.bs"

sub init()
    m.posterList = m.top.findNode("posterList")
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.applyingText = m.top.findNode("applyingText")
    m.emptyText = m.top.findNode("emptyText")
    m.hintText = m.top.findNode("hintText")
    m.titleText = m.top.findNode("titleText")
    m.fetchTask = m.top.findNode("fetchTask")
    m.downloadTask = m.top.findNode("downloadTask")

    m.posterList.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.posterList.observeField("rowItemFocused", "onRowItemFocused")
    m.posterList.observeField("itemSelected", "onPosterItemSelected")

    m.fetchTask.observeField("images", "onImagesLoaded")
    m.downloadTask.observeField("result", "onDownloadResult")

    m.top.observeField("visible", "onVisibleChanged")

    m.currentItemIndex = 0
    m.imageItems = []
end sub

sub onVisibleChanged()
    if not m.top.visible
        resetState()
    end if
end sub

sub onItemTitleChanged()
    if isValidAndNotEmpty(m.top.itemTitle)
        m.titleText.text = "Edit Poster — " + m.top.itemTitle
    end if
end sub

sub onItemIdChanged()
    if not isValidAndNotEmpty(m.top.itemId) then return

    showLoadingState()
    m.fetchTask.itemId = m.top.itemId
    m.fetchTask.imageType = "Primary"
    m.fetchTask.control = "RUN"
end sub

sub onImagesLoaded()
    result = m.fetchTask.images
    if not isValid(result) then return

    if not result.success or not isValid(result.items) or result.items.count() = 0
        showEmptyState()
        return
    end if

    m.imageItems = result.items
    populatePosterList(result.items)
    showListState()
end sub

sub populatePosterList(images as object)
    rootContent = CreateObject("roSGNode", "ContentNode")
    rowContent = rootContent.CreateChild("ContentNode")

    for each image in images
        item = rowContent.CreateChild("PosterItemData")

        thumbnailUrl = ""
        if isValidAndNotEmpty(image.ThumbnailUrl)
            thumbnailUrl = image.ThumbnailUrl
        else if isValidAndNotEmpty(image.Url)
            thumbnailUrl = image.Url
        end if
        item.thumbnailUrl = thumbnailUrl

        providerName = ""
        if isValidAndNotEmpty(image.ProviderName)
            providerName = image.ProviderName
        end if
        item.providerName = providerName

        imageUrl = ""
        if isValidAndNotEmpty(image.Url)
            imageUrl = image.Url
        end if
        item.imageUrl = imageUrl
    end for

    m.posterList.content = rootContent
    m.posterList.jumpToItem = 0
    m.currentItemIndex = 0
end sub

sub onRowItemFocused()
    focusedInfo = m.posterList.rowItemFocused
    if isValid(focusedInfo) and focusedInfo.count() >= 2
        m.currentItemIndex = focusedInfo[1]
    end if
end sub

sub onPosterItemSelected()
    selectedIndex = m.posterList.itemSelected
    row = m.posterList.content.getChild(0)
    if row = invalid then return

    item = row.getChild(selectedIndex)
    if item = invalid then return
    if not isValidAndNotEmpty(item.imageUrl) then return

    applyPoster(item.imageUrl)
end sub

sub applyPoster(imageUrl as string)
    showApplyingState()

    m.downloadTask.itemId = m.top.itemId
    m.downloadTask.imageType = "Primary"
    m.downloadTask.imageUrl = imageUrl
    m.downloadTask.control = "RUN"
end sub

sub onDownloadResult()
    result = m.downloadTask.result
    if not isValid(result) then return

    if result.success
        m.top.posterChanged = true
    end if

    m.top.visible = false
end sub

sub showLoadingState()
    m.posterList.visible = false
    m.loadingGroup.visible = true
    m.applyingText.visible = false
    m.emptyText.visible = false
    m.hintText.visible = false
end sub

sub showListState()
    m.posterList.visible = true
    m.loadingGroup.visible = false
    m.applyingText.visible = false
    m.emptyText.visible = false
    m.hintText.visible = true
    m.posterList.setFocus(true)
end sub

sub showEmptyState()
    m.posterList.visible = false
    m.loadingGroup.visible = false
    m.applyingText.visible = false
    m.emptyText.visible = true
    m.hintText.visible = false
end sub

sub showApplyingState()
    m.posterList.visible = false
    m.loadingGroup.visible = false
    m.applyingText.visible = true
    m.emptyText.visible = false
    m.hintText.visible = false
end sub

sub resetState()
    m.imageItems = []
    m.currentItemIndex = 0
    m.posterList.content = invalid
    showLoadingState()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.top.visible = false
        return true
    end if

    if key = KeyCode.LEFT or key = KeyCode.RIGHT or key = KeyCode.UP or key = KeyCode.DOWN
        if m.posterList.visible and not m.posterList.isInFocusChain()
            m.posterList.setFocus(true)
        end if
    end if

    return false
end function

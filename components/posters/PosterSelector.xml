<?xml version="1.0" encoding="utf-8"?>
<component name="PosterSelector" extends="Group">
    <children>
        <!-- Full-screen dimming overlay -->
        <Rectangle width="1920" height="1080" color="#000000" opacity="0.75" />

        <!-- Dialog box: 1720x560, vertically centered on 1080px screen -->
        <Group translation="[100, 260]">
            <Poster width="1720" height="560" uri="pkg:/images/dialog.9.png" />

            <!-- Title: media item name -->
            <Text id="titleText"
                font="font:LargeBoldSystemFont"
                color="#FFFFFF"
                horizAlign="center"
                width="1620"
                translation="[50, 40]"
                maxLines="1" />

            <!-- Subtitle prompt -->
            <Text id="subtitleText"
                text="Select a poster"
                font="font:SmallestSystemFont"
                color="#AAAAAA"
                horizAlign="center"
                width="1620"
                translation="[50, 96]" />

            <!-- Poster grid (shown after images load) -->
            <RowList id="posterList"
                translation="[30, 130]"
                visible="false"
                numRows="1"
                rowItemSize="[[120, 210]]"
                rowItemSpacing="[[20, 0]]"
                itemComponentName="PosterSelectorItem"
                focusBitmapUri="pkg:/images/hd_focus.9.png"
                focusBitmapBlendColor="#FFFFFFFF"
                drawFocusFeedback="true"
                showRowLabel="false"
                rowLabelColor="#00000000" />

            <!-- Loading state -->
            <Group id="loadingGroup" translation="[860, 280]" visible="true">
                <BusySpinner id="loadingSpinner" />
                <Text id="loadingText"
                    text="Loading posters..."
                    font="font:SmallestSystemFont"
                    color="#AAAAAA"
                    horizAlign="center"
                    width="300"
                    translation="[-150, 50]" />
            </Group>

            <!-- Applying state (shown while DownloadPosterTask runs) -->
            <Text id="applyingText"
                text="Setting poster..."
                font="font:SmallSystemFont"
                color="#FFFFFF"
                horizAlign="center"
                width="1620"
                translation="[50, 280]"
                visible="false" />

            <!-- Empty state -->
            <Text id="emptyText"
                text="No alternate posters found for this item."
                font="font:SmallSystemFont"
                color="#AAAAAA"
                horizAlign="center"
                width="1620"
                translation="[50, 280]"
                visible="false" />

            <!-- Hint bar at the bottom -->
            <Text id="hintText"
                text="OK: Set as Poster    Back: Cancel"
                font="font:SmallestSystemFont"
                color="#666666"
                horizAlign="center"
                width="1620"
                translation="[50, 510]"
                visible="false" />
        </Group>

        <FetchRemoteImagesTask id="fetchTask" />
        <DownloadPosterTask id="downloadTask" />
    </children>
    <interface>
        <field id="itemId" type="string" onChange="onItemIdChanged" />
        <field id="itemTitle" type="string" onChange="onItemTitleChanged" />
        <field id="posterChanged" type="bool" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/posters/PosterSelector.bs" />
</component>

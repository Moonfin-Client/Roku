<?xml version="1.0" encoding="utf-8"?>
<component name="PosterSelectorItem" extends="Group">
    <children>
        <Rectangle id="backdrop" width="120" height="180" color="#333333" />
        <Poster id="posterImage"
            width="120"
            height="180"
            loadDisplayMode="scaleToZoom" />
        <Text id="providerText"
            width="120"
            height="26"
            translation="[0, 183]"
            font="font:SmallestSystemFont"
            color="#AAAAAA"
            horizAlign="center"
            maxLines="1" />
    </children>
    <interface>
        <field id="itemContent" type="node" onChange="itemContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="focusChanged" alwaysNotify="true" />
        <field id="drawFocusFeedback" type="boolean" value="true" />
    </interface>
</component>

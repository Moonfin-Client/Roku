<?xml version="1.0" encoding="utf-8"?>
<component name="PosterSelectorItem" extends="Group">
    <children>
        <Poster id="posterThumb"
            width="120" height="180"
            loadDisplayMode="scaleToFit" />
        <Text id="providerLabel"
            font="font:SmallestSystemFont"
            color="#AAAAAA"
            width="120"
            horizAlign="center"
            translation="[0, 186]"
            maxLines="1"
            truncateOnDelimiter=" " />
    </children>
    <interface>
        <field id="itemContent" type="node" onChange="onItemContentChanged" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/posters/PosterSelectorItem.bs" />
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The party controls over the video: who's in and how they're doing, and for the host Make host,
     Remove, Everyone can control playback, Room PIN and End for everyone -->
<component name="WatchPartyPanel" extends="Group">
    <interface>
        <!-- Raised when the panel closes, so the player takes the remote back -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- Lets go of the session when the player takes the panel away -->
        <function name="release" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="#000000" opacity="0.5" />
        <Rectangle translation="[1215, 0]" width="705" height="1080" color="#1A1A1A" />
        <Group translation="[1260, 54]" clippingRect="[-12, -12, 640, 1000]">
            <Group id="list" />
        </Group>
    </children>
</component>

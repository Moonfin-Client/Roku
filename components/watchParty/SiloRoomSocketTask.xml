<?xml version="1.0" encoding="utf-8"?>
<!-- The room's WebSocket on a Silo server, in place of WatchPartyEventsTask and WatchPartySendTask: the same fields, plus connection -->
<component name="SiloRoomSocketTask" extends="Task">
    <interface>
        <field id="roomId" type="string" />
        <field id="token" type="string" />
        <field id="active" type="boolean" value="false" />
        <!-- Messages to send, each one a JSON text frame, in order -->
        <field id="outbox" type="array" alwaysNotify="true" />
        <!-- { messages } for each server message other than a pong, in order -->
        <field id="batch" type="assocarray" alwaysNotify="true" />
        <!-- { status, code, final }, where a final one means the party is over for this member -->
        <field id="failure" type="assocarray" alwaysNotify="true" />
        <field id="recovered" type="boolean" alwaysNotify="true" />
        <!-- What the server answered with an error for something sent -->
        <field id="replies" type="array" alwaysNotify="true" />
        <!-- { offset } in seconds the server's clock is ahead of this one -->
        <field id="clock" type="assocarray" alwaysNotify="true" />
        <!-- Counts each socket that opens, so the player can attach its session again -->
        <field id="connection" type="integer" alwaysNotify="true" value="0" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The room's long poll, which asks again as soon as each answer lands until active goes off -->
<component name="WatchPartyEventsTask" extends="Task">
    <interface>
        <field id="roomId" type="string" />
        <field id="token" type="string" />
        <field id="active" type="boolean" value="false" />
        <!-- { messages } for each answer that brought any -->
        <field id="batch" type="assocarray" alwaysNotify="true" />
        <!-- { status, code, final }, where a final one means the room is gone for this member -->
        <field id="failure" type="assocarray" alwaysNotify="true" />
        <field id="recovered" type="boolean" alwaysNotify="true" />
    </interface>
</component>

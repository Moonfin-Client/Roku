<?xml version="1.0" encoding="utf-8"?>
<!-- The watch party this device is in, kept whatever screen is up, and the room list Home polls for
     its row and the party alerts -->
<component name="WatchPartySession" extends="Node">
    <interface>
        <!-- The room from the last snapshot, with commands folded in, or empty when in none -->
        <field id="room" type="assocarray" alwaysNotify="true" />
        <field id="inRoom" type="boolean" value="false" alwaysNotify="true" />
        <field id="suggestions" type="array" alwaysNotify="true" />
        <field id="chatMessage" type="assocarray" alwaysNotify="true" />
        <field id="reaction" type="assocarray" alwaysNotify="true" />
        <!-- { text, name } for a toast naming who did something -->
        <field id="toast" type="assocarray" alwaysNotify="true" />
        <field id="command" type="assocarray" alwaysNotify="true" />
        <!-- The answer to a call, { request, status, data } -->
        <field id="answer" type="assocarray" alwaysNotify="true" />
        <field id="rooms" type="array" alwaysNotify="true" />
        <!-- "ok", "missing" without Moonbase, "disabled" when the admin turned them off, or "failed" -->
        <field id="roomsState" type="string" value="" alwaysNotify="true" />
        <!-- The admin's switches, { enabled, alerts }, read once per server and account -->
        <field id="serverConfig" type="assocarray" />
        <!-- Silo runs its own Watch Party over a room socket, in place of Moonbase's -->
        <field id="isSilo" type="boolean" value="false" />
        <!-- Silo's optional room features: { memberState, lobbyReady, stagedSelection,
             selectionModeSwitch, stopPlayback, voteHostOverride } -->
        <field id="features" type="assocarray" />
        <!-- Counts the room socket's openings and its snapshots, so the player can tell an attach the
             server answered on this socket from one it answered before -->
        <field id="connection" type="integer" value="0" alwaysNotify="true" />
        <field id="snapshots" type="integer" value="0" />
        <!-- The host's subtitles for everyone on Silo, kept by Moonbase: { index, language } for a
             track, { off: true }, or empty to leave them to each member -->
        <field id="groupSubtitle" type="assocarray" alwaysNotify="true" />
        <!-- Whether Moonbase is there to keep that choice -->
        <field id="groupSubtitlesSupported" type="boolean" value="false" alwaysNotify="true" />
        <!-- The subtitle streams of the file the room plays, for the host to pick from -->
        <field id="subtitleTracks" type="array" alwaysNotify="true" />
        <!-- { contentId, seconds } where the host asked a Silo start to pick up -->
        <field id="pendingResume" type="assocarray" />
        <function name="send" />
        <function name="act" />
        <function name="leave" />
        <function name="watch" />
        <function name="serverNow" />
        <function name="selfId" />
        <function name="watchRooms" />
        <function name="open" />
        <!-- A title's page picks { id, type, name, seriesId } for the party, opening one when there's none -->
        <function name="pickForParty" />
        <!-- Host on Silo: subtitles for everyone, as groupSubtitle describes them -->
        <function name="setGroupSubtitle" />
        <function name="canPick" />
    </interface>
</component>

import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/watchParty.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/watchPartyModel.bs"

sub init()
    m.top.functionName = "runRequest"
end sub

' The answer carries the request back, so whoever asked can tell what it was for
sub runRequest()
    request = m.top.request
    if request.kind = "search"
        found = getJson(APIRequest("/Items", { "searchTerm": request.query, "IncludeItemTypes": "Movie,Episode", "Recursive": true, "Limit": 20, "UserId": currentSessionUserId() }))
        items = []
        if type(found) = "roAssociativeArray" and type(found.Items) = "roArray" then items = found.Items
        m.top.result = { request: request, status: 200, data: { items: items } }
        return
    end if

    answer = watchPartyApi.Request(request.method ?? "GET", request.path, request.body, request.token ?? "", 20000)
    ' A lost press is tried again, but not the room list, which polls again soon anyway.
    attempt = 0
    while request.kind <> "rooms" and watchPartyModel.WorthRetrying(answer.status) and attempt < WATCH_PARTY_RETRIES
        attempt++
        sleep(attempt * 1000)
        answer = watchPartyApi.Request(request.method ?? "GET", request.path, request.body, request.token ?? "", 20000)
    end while
    m.top.result = { request: request, status: answer.status, data: answer.data }
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Sends what the room is told, in order, and pings for the clock while it waits -->
<component name="WatchPartySendTask" extends="Task">
    <interface>
        <field id="roomId" type="string" />
        <field id="token" type="string" />
        <field id="active" type="boolean" value="false" />
        <!-- Messages to send, each write queued behind the ones before it -->
        <field id="outbox" type="array" alwaysNotify="true" />
        <!-- What the server answered other than pongs, such as an error for something sent -->
        <field id="replies" type="array" alwaysNotify="true" />
        <!-- { offset } in seconds the server's clock is ahead of this one -->
        <field id="clock" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

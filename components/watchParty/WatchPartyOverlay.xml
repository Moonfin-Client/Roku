<?xml version="1.0" encoding="utf-8"?>
<!-- What a watch party draws over the video: toasts naming who did what, who's in with their status,
     the last three chat messages, floating reactions, the start countdown or the wait for players,
     and the quick bar the chat button opens -->
<component name="WatchPartyOverlay" extends="Group">
    <interface>
        <!-- { mode: "waiting", names, seconds } or { mode: "countdown", seconds }, counting down the
             seconds from when it's set, or an empty one for nothing in the middle -->
        <field id="center" type="assocarray" onChange="onCenter" />
        <field id="quickBarOpen" type="boolean" value="false" onChange="onQuickBar" />
        <!-- Raised when the quick bar closes, so the player takes the remote back -->
        <field id="quickBarClosed" type="boolean" alwaysNotify="true" />
        <!-- Who's in shows with the player's controls only, so it doesn't sit over the movie -->
        <field id="peopleVisible" type="boolean" onChange="onPeopleVisible" />
        <!-- Lets go of the session when the player does -->
        <function name="release" />
    </interface>
    <children>
        <Group id="centerLayer" visible="false">
            <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.6" />
            <Group id="countdown" visible="false">
                <Poster id="countdownRing" uri="pkg:/images/playback/ring84s3.webp" width="156" height="156" translation="[882, 410]" blendColor="#00A4DC" />
                <Label id="countdownNumber" translation="[882, 410]" width="156" height="156" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="#FFFFFF" />
                <Label id="countdownText" translation="[0, 590]" width="1920" horizAlign="center" font="font:SmallSystemFont" color="#E6E6E6" />
            </Group>
            <Group id="waiting" visible="false">
                <Group id="waitingFaces" translation="[0, 380]" />
                <Label id="waitingTitle" translation="[0, 470]" width="1920" horizAlign="center" font="font:SmallBoldSystemFont" color="#FFFFFF" />
                <Label id="waitingNote" translation="[0, 520]" width="1920" horizAlign="center" font="font:SmallSystemFont" color="#A8A8A8" />
                <Rectangle id="waitingTrack" translation="[672, 572]" width="576" height="6" color="#2A2A2A" />
                <Rectangle id="waitingFill" translation="[672, 572]" width="0" height="6" color="#F5B942" />
            </Group>
        </Group>

        <Group id="toast" visible="false" opacity="0" />
        <Animation id="toastFade" duration="4" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator key="[0.0, 0.06, 0.85, 1.0]" keyValue="[0.0, 1.0, 1.0, 0.0]" fieldToInterp="toast.opacity" />
        </Animation>

        <Group id="people" visible="false" />
        <Group id="chat" />
        <Group id="reactions" />

        <Group id="quickBar" visible="false" />

        <Timer id="tick" duration="0.25" repeat="true" />
    </children>
</component>

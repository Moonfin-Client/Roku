<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Parties: the rooms on this server with Start and Join with a code, and the lobby of the
     party this device is in -->
<component name="WatchPartiesScreen" extends="JFScreen">
    <interface>
        <!-- { roomId, hasPin } joins a room picked somewhere else, like the Home row, and { start } starts one -->
        <field id="request" type="assocarray" onChange="onRequest" />
        <!-- Raised once BACK has taken the screen away, so whatever opened it can take the remote back -->
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="#101010" />

        <Label id="title" translation="[84, 60]" font="font:LargeBoldSystemFont" color="#FFFFFF" />
        <Label id="subtitle" translation="[84, 60]" font="font:SmallSystemFont" color="#A8A8A8" />

        <Group id="roomsView">
            <Group id="actions" translation="[84, 170]" />
            <Label id="help" translation="[90, 432]" width="528" wrap="true" maxLines="4" height="160" font="font:SmallSystemFont" color="#A8A8A8" />
            <Label id="problem" translation="[90, 600]" width="528" wrap="true" maxLines="3" height="120" font="font:SmallBoldSystemFont" color="#FF8A8A" />
            <Group id="gridClip" translation="[690, 170]" clippingRect="[0, -20, 1160, 880]">
                <Group id="grid" />
            </Group>
        </Group>

        <Group id="lobbyView" visible="false">
            <Group id="inviteCard" translation="[84, 160]">
                <Poster id="inviteFill" uri="pkg:/images/livetv/fill17.9.png" width="450" height="560" blendColor="#1A1A1A" />
                <Label id="inviteTitle" translation="[0, 36]" width="450" horizAlign="center" font="font:SmallBoldSystemFont" color="#FFFFFF" />
                <Label id="inviteText" translation="[36, 96]" width="378" height="230" wrap="true" maxLines="6" horizAlign="center" font="font:SmallSystemFont" color="#A8A8A8" />
                <Label id="inviteCode" translation="[0, 380]" width="450" horizAlign="center" font="font:LargeBoldSystemFont" color="#FFFFFF" />
                <Label id="inviteNote" translation="[36, 440]" width="378" height="110" wrap="true" maxLines="4" horizAlign="center" font="font:SmallestSystemFont" color="#A8A8A8" />
            </Group>
            <Group id="lobbyClip" translation="[588, 160]" clippingRect="[-12, -12, 840, 880]">
                <Group id="lobbyList" />
            </Group>
            <Group id="memberColumn" translation="[1458, 160]">
                <Label id="membersTitle" font="font:SmallBoldSystemFont" color="#FFFFFF" />
                <Group id="memberList" translation="[0, 60]" />
                <Label id="membersNote" translation="[0, 720]" width="390" height="140" wrap="true" maxLines="4" font="font:SmallestSystemFont" color="#A8A8A8" />
            </Group>
        </Group>
    </children>
</component>

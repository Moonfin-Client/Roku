<?xml version="1.0" encoding="utf-8"?>
<component name="LoadingAnimation" extends="Group">
  <children>
    <Rectangle id="dim" width="1920" height="1080" color="#00000073" visible="false" />
    <Group id="box">
      <Group id="art" />
      <Group id="loadingLabel" />
    </Group>
    <Timer id="bounceTimer" duration="0.033" repeat="true" />
  </children>
  <interface>
    <field id="label" type="string" />
    <field id="dimmed" type="boolean" value="false" />
    <!-- Builds the animation from the current settings and starts it, or stops it -->
    <field id="active" type="boolean" value="false" onChange="onActiveChanged" />
  </interface>
</component>

' Roku scales each side of the layout on its own, which only differ on a screen that isn't 16:9
sub init()
    m.scaleX = 1.0
    m.scaleY = 1.0
    screen = CreateObject("roDeviceInfo").GetUIResolution()
    if screen.width <> invalid and screen.width < 1920 then m.scaleX = screen.width / 1920
    if screen.height <> invalid and screen.height < 1080 then m.scaleY = screen.height / 1080
end sub

sub onSizeChanged()
    size = m.top.size
    m.top.maskSize = [size[0] * m.scaleX, size[1] * m.scaleY]
end sub

sub onOffsetChanged()
    offset = m.top.offset
    m.top.maskOffset = [offset[0] * m.scaleX, offset[1] * m.scaleY]
end sub

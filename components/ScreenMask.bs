import "pkg:/source/utils/misc.bs"

sub init()
    m.screenScale = 1.0
    screenWidth = CreateObject("roDeviceInfo").GetUIResolution().width
    if isValid(screenWidth) and screenWidth < 1920 then m.screenScale = screenWidth / 1920
end sub

sub onSizeChanged()
    size = m.top.size
    m.top.maskSize = [size[0] * m.screenScale, size[1] * m.screenScale]
end sub

sub onOffsetChanged()
    offset = m.top.offset
    m.top.maskOffset = [offset[0] * m.screenScale, offset[1] * m.screenScale]
end sub

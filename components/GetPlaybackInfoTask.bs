import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/enums/PlaybackMethod.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackFacts.bs"
import "pkg:/source/utils/trackLabels.bs"

sub init()
    m.top.functionName = "getPlaybackInfoTask"
end sub

' The request names what the player has, since a playback error empties the queue while the player
' retries and Emby's source ids differ from its item ids
function ItemPostPlaybackInfo(id as string)
    body = {
        "DeviceProfile": getDeviceProfile()
    }
    mediaSourceId = m.top.mediaSourceId
    if mediaSourceId = "" then mediaSourceId = id

    ' Check if we have multi-server info
    serverUrl = m.top.serverUrl
    serverUserId = m.top.serverUserId
    serverAuthToken = m.top.serverAuthToken

    useMultiServer = isValidAndNotEmpty(serverUrl) and isValidAndNotEmpty(serverUserId) and isValidAndNotEmpty(serverAuthToken)

    if useMultiServer
        ' Use the specified server instead of global session
        params = {
            "UserId": serverUserId,
            "IsPlayback": true,
            "AutoOpenLiveStream": true,
            "MaxStreamingBitrate": "140000000",
            "MaxStaticBitrate": "140000000",
            "SubtitleStreamIndex": m.top.subtitleIndex,
            "MediaSourceId": mediaSourceId,
            "AudioStreamIndex": m.top.audioIndex
        }

        req = APIRequestForServer(serverUrl, serverUserId, serverAuthToken, Substitute("Items/{0}/PlaybackInfo", id), params)
        if not isValid(req) then return invalid

        req.SetRequest("POST")
        return postPlaybackInfo(req, body, isEmbyServer(serverUrl))
    else
        ' Use the global session (original behavior)
        params = {
            "UserId": m.global.session.user.id,
            "IsPlayback": true,
            "AutoOpenLiveStream": true,
            "MaxStreamingBitrate": "140000000",
            "MaxStaticBitrate": "140000000",
            "SubtitleStreamIndex": m.top.subtitleIndex,
            "MediaSourceId": mediaSourceId,
            "AudioStreamIndex": m.top.audioIndex
        }

        req = APIRequest(Substitute("Items/{0}/PlaybackInfo", id), params)
        req.SetRequest("POST")
        return postPlaybackInfo(req, body, isEmbyServer())
    end if
end function

' The rows of the Playback Information panel, built from what the player says it's playing, the
' file the server describes and the session's TranscodingInfo
sub getPlaybackInfoTask()
    playing = findPlaybackSession()
    mediaSource = invalid
    if m.top.isLive
        ' Asking for a channel's playback info opens another stream, so the session's tracks stand in
        streams = chainLookup(playing, "NowPlayingItem.MediaStreams")
        if isValidAndNotEmpty(streams) then mediaSource = { MediaStreams: streams }
    else
        playbackInfo = ItemPostPlaybackInfo(m.top.videoID)
        if isValidAndNotEmpty(chainLookup(playbackInfo, "MediaSources")) then mediaSource = playbackInfo.MediaSources[0]
    end if

    settings = m.global.session.user.settings
    limit = 0
    ' Read as text, since a synced setting can arrive as a string as easily as a boolean or number
    if LCase(trackLabels.Field(settings, "playback.bitrate.maxlimited")) = "true" then limit = Int(val(trackLabels.Field(settings, "playback.bitrate.limit"))) * 1000000
    ' Only the setting counts, since the app also forces a transcode on its own for rotated video
    ' and Live TV retries
    forced = not isStringEqual(settings["playback.media.forceTranscode"] ?? PlaybackMethod.PLAYNORMALLY, PlaybackMethod.PLAYNORMALLY)

    deviceInfo = CreateObject("roDeviceInfo")
    os = deviceInfo.GetOSVersion()

    m.top.data = {
        sections: playbackFacts.Build({
            source: mediaSource,
            transcoding: chainLookup(playing, "TranscodingInfo"),
            url: m.top.url,
            isTranscoded: m.top.isTranscoded,
            forced: forced,
            audioIndex: m.top.audioIndex,
            subtitleIndex: m.top.subtitleIndex,
            subtitleBurnedIn: m.top.subtitleBurnedIn,
            live: m.top.isLive,
            channel: m.top.channel,
            program: m.top.program,
            qualityLimit: limit,
            languages: playbackFacts.LanguageNames(serverCultures()),
            player: tr("Roku native player"),
            device: `${deviceInfo.GetModelDisplayName()}, Roku OS ${os.major}.${os.minor}.${os.revision}`
        })
    }
end sub

function serverCultures() as dynamic
    if not isValidAndNotEmpty(m.top.serverUrl) or not isValidAndNotEmpty(m.top.serverUserId) or not isValidAndNotEmpty(m.top.serverAuthToken)
        return api.localization.GetCultures()
    end if
    return getJson(APIRequestForServer(m.top.serverUrl, m.top.serverUserId, m.top.serverAuthToken, "Localization/Cultures", {}))
end function

' Asking the server for our session by device id comes back empty, because task
' threads send a different device id than the main thread does. What we are
' watching is what actually identifies us
function findPlaybackSession() as dynamic
    serverUrl = m.top.serverUrl
    serverUserId = m.top.serverUserId
    serverAuthToken = m.top.serverAuthToken
    useMultiServer = isValidAndNotEmpty(serverUrl) and isValidAndNotEmpty(serverUserId) and isValidAndNotEmpty(serverAuthToken)

    if useMultiServer
        req = APIRequestForServer(serverUrl, serverUserId, serverAuthToken, "Sessions", {})
        sessions = getJson(req)
    else
        sessions = api.sessions.Get({})
    end if
    if not isValidAndNotEmpty(sessions) then return invalid

    client = getAuthHeaderContext().appName + " Roku"
    itemId = m.top.itemId
    if itemId = "" then itemId = m.top.videoID
    match = invalid

    for each candidate in sessions
        if not isStringEqual(chainLookupReturn(candidate, "NowPlayingItem.Id", ""), itemId) then continue for
        if not isStringEqual(candidate.Client, client) then continue for

        ' Other clients can sit on the same item, so hold this one but keep
        ' looking for the session carrying the transcode details
        match = candidate
        if isValidAndNotEmpty(candidate.TranscodingInfo) then return candidate
    end for

    return match
end function

<?xml version="1.0" encoding="utf-8"?>
<component name="LoadExtrasTask" extends="Task">
    <interface>
        <field id="itemId" type="string" />
        <field id="itemType" type="string" value="" />
        <field id="isTVShow" type="boolean" value="false" />
        <field id="isEpisode" type="boolean" value="false" />
        <field id="showID" type="string" value="" />
        <field id="seasonID" type="string" value="" />
        <field id="isPersonMode" type="boolean" value="false" />
        <!-- How much of a person's filmography is asked for -->
        <field id="personLimit" type="integer" value="100" />
        <!-- The classic and modern screens list the collection a film is in, Spotlight loads its own -->
        <field id="includeCollections" type="boolean" value="false" />
        <field id="providerIds" type="assocarray" />
        <field id="content" type="node" />
        <!-- Multi-server support fields -->
        <field id="serverUrl" type="string" value="" />
        <field id="serverUserId" type="string" value="" />
        <field id="serverAuthToken" type="string" value="" />
    </interface>
</component>
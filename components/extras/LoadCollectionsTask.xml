<?xml version="1.0" encoding="utf-8"?>
<component name="LoadCollectionsTask" extends="Task">
    <interface>
        <!-- "parents" finds the collections a title is in, "members" loads a collection -->
        <field id="mode" type="string" value="parents" />
        <field id="itemJson" type="assocarray" />
        <!-- A members load that only wants the titles skips Seerr -->
        <field id="titlesOnly" type="boolean" value="false" />
        <!-- A members load that also brings the people in each title, for the cast and crew -->
        <field id="withPeople" type="boolean" value="false" />
        <!-- A members load reads one page from startIndex, and a limit of 0 reads the rest -->
        <field id="startIndex" type="integer" value="0" />
        <field id="limit" type="integer" value="50" />
        <!-- Array of { name, boxSet, items, missing } -->
        <field id="collections" type="array" />
        <field id="items" type="array" />
        <!-- A members load's titles by id in the order saved through Moonbase, empty when none is -->
        <field id="order" type="array" />
        <field id="missing" type="array" />
        <!-- Where the page after this one starts, and whether the collection has one -->
        <field id="nextIndex" type="integer" value="0" />
        <field id="hasMore" type="boolean" value="false" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
</component>

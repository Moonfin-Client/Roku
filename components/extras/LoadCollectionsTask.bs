import "pkg:/components/extras/collectionLookup.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/seerrMissingCollection.bs"

sub init()
    m.top.functionName = "load"
end sub

sub load()
    itemJson = m.top.itemJson
    m.serverData = getServerInfoFromItem(itemJson)
    if isValid(itemJson) and isValidAndNotEmpty(itemJson.Id)
        if m.top.mode = "members"
            loadMembers(itemJson)
        else
            loadParents(itemJson)
        end if
    end if

    m.top.done = true
end sub

' Every collection the title is in with its titles, skipping any that hold nothing else
sub loadParents(itemJson as object)
    showMissing = showsMissing()
    found = []

    for each collection in findParents(itemJson)
        ' A blocked title is left out of the list but still counts as owned, so it isnt offered as
        ' missing
        held = collectionTitles(collection.Id, "PremiereDate", "PrimaryImageAspectRatio,ProductionYear,ProviderIds,People")
        members = parentalControls.WithoutBlockedItems(held)
        if members.count() <= 1 then continue for

        missing = []
        if showMissing then missing = seerrMissingCollection.Find(collection, held)

        name = collection.Name
        if not isValidAndNotEmpty(name) then name = tr("Collection")

        found.push({
            name: name,
            boxSet: collectionNode(collection),
            items: cardNodes(members),
            missing: cardNodes(missing)
        })
    end for

    m.top.collections = found
end sub

' A page of a collection's own titles in the server's order, each card carrying the people in it when
' they're asked for. The first page also brings the order saved through Moonbase and the titles the
' library is missing.
sub loadMembers(boxSet as object)
    fields = "PrimaryImageAspectRatio,ProductionYear,PremiereDate,ProviderIds"
    if m.top.withPeople then fields += ",People"
    page = collectionPage(boxSet.Id, m.top.startIndex, m.top.limit, fields)

    cards = []
    for each member in parentalControls.WithoutBlockedItems(page.items)
        people = member.People
        member.Delete("People")
        card = memberCard(member)
        if isValid(people) then card.addFields({ people: lightPeople(people) })
        cards.push(card)
    end for
    m.top.items = cards
    m.top.nextIndex = page.nextIndex
    m.top.hasMore = page.hasMore
    if m.top.startIndex > 0 then return

    m.top.order = storedCollectionOrder(boxSet.Id)
    ' A blocked title still counts as owned, so it isn't offered as missing
    if not m.top.titlesOnly
        missing = []
        for each json in missingFromCollection(boxSet, page)
            missing.push(memberCard(json))
        end for
        m.top.missing = missing
    end if
end sub

' The people as the cast rows read them, without the image hashes that make up most of each entry
function lightPeople(people as object) as object
    for each person in people
        if type(person) = "roAssociativeArray" then person.Delete("ImageBlurHashes")
    end for
    return people
end function

function collectionNode(collection as object) as object
    node = cardNode(collection)
    if not isValidAndNotEmpty(node.posterURL) then node.posterURL = ImageURL(collection.Id, "Primary", { "maxHeight": 360, "quality": 90 })
    return node
end function

function fetch(path as string, params as object) as dynamic
    if isValid(m.serverData)
        params.userId = m.serverData.userId
        return getJson(APIRequestForServer(m.serverData.serverUrl, m.serverData.userId, m.serverData.authToken, path, params))
    end if

    params.userId = m.global.session.user.id
    return getJson(APIRequest(path, params))
end function

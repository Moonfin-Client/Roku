<?xml version="1.0" encoding="utf-8"?>
<!-- The top-Level RowList for the Extras rows -->
<component name="ExtrasRowList" extends="RowList">
  <interface>
    <field id="type" type="string" />
    <field id="hasItems" type="boolean" />
    <field id="parentId" type="string" onChange="onParentIdChanged" />
    <field id="showID" type="string" onChange="onShowIDChanged" />
    <field id="episodeID" type="string" />
    <field id="seasonID" type="string" />
    <field id="focusedItem" type="node" alwaysNotify="true" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <!-- Whether a film's page lists the collection it is in. Spotlight loads its own. -->
    <field id="loadsCollections" type="boolean" value="false" />
    <function name="loadParts" />
    <function name="updateContent" />
  </interface>
</component>
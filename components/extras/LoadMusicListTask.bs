import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalControls.bs"

' Asked for the way the other clients ask, so the order and the caps match theirs
const MAX_ARTIST_ALBUMS = 100
const MAX_PLAYLIST_ITEMS = 300

sub init()
    m.top.functionName = "load"
end sub

sub load()
    itemJson = m.top.itemJson
    items = []

    if isValid(itemJson) and isValidAndNotEmpty(itemJson.Id)
        itemType = LCase(itemJson.Type ?? "")
        if itemType = "musicalbum"
            items = fetchItems("/Items", {
                ParentId: itemJson.Id,
                IncludeItemTypes: "Audio",
                SortBy: "ParentIndexNumber,IndexNumber",
                SortOrder: "Ascending"
            })
        else if itemType = "musicartist"
            items = fetchItems("/Items", {
                AlbumArtistIds: itemJson.Id,
                IncludeItemTypes: "MusicAlbum",
                Recursive: "true",
                SortBy: "ProductionYear,SortName",
                SortOrder: "Descending",
                Limit: MAX_ARTIST_ALBUMS,
                Fields: "PrimaryImageAspectRatio,ProductionYear,OfficialRating"
            })
        else if itemType = "playlist"
            items = fetchItems(`/Playlists/${itemJson.Id}/Items`, {
                Limit: MAX_PLAYLIST_ITEMS,
                Fields: "PrimaryImageAspectRatio,ProductionYear,AlbumArtist"
            })
        end if
    end if

    m.top.items = parentalControls.WithoutBlockedItems(items)
    m.top.done = true
end sub

' A list from another server carries that server with each entry, so its artwork and its
' pages come from there too
function fetchItems(path as string, params as object) as object
    serverData = getServerInfoFromItem(m.top.itemJson)
    if isValid(serverData)
        params.userId = serverData.userId
        data = getJson(APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, path, params))
    else
        params.userId = m.global.session.user.id
        data = getJson(APIRequest(path, params))
    end if

    items = chainLookupReturn(data, "Items", [])
    if isValid(serverData)
        for each item in items
            item._serverUrl = serverData.serverUrl
            item._userId = serverData.userId
            item._authToken = serverData.authToken
        end for
    end if
    return items
end function

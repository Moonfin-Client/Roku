import "pkg:/source/utils/misc.bs"

' Shared by every card that draws poster labels. A card hands its node's posterLabels to a
' PosterLabels over its artwork, along with where each corner's stack starts, worked out from the
' marks the card already draws there so the labels never cover them.

' How far labels sit in from the artwork's edges, and the room they leave beside one of the card's marks
const POSTER_LABEL_EDGE = 8
const POSTER_LABEL_GAP = 6

' Labels draw at 0.85 on a poster card and at 0.8 on an episode
const POSTER_LABEL_CARD_SCALE = 0.85
const POSTER_LABEL_EPISODE_SCALE = 0.8

' The labels over one card's artwork, made the first time the card has some and kept on the card
' after that. An empty list clears what a recycled card showed for its last item.
function drawPosterLabels(labels as dynamic, parent as object, entries as dynamic, frame as object, scale as float) as dynamic
    if not isValid(labels)
        if not isValidAndNotEmpty(entries) then return invalid
        labels = parent.createChild("PosterLabels")
    end if

    labels.labelScale = scale
    labels.frame = frame
    labels.labels = entries ?? []
    return labels
end function

' The artwork's size, where each top corner's stack starts, and how far above the bottom edge each
' bottom corner's stack starts
function posterLabelFrame(width as float, height as float, topLeft as float, topRight as float, bottomLeft as float, bottomRight as float) as object
    return { width: width, height: height, topLeft: topLeft, topRight: topRight, bottomLeft: bottomLeft, bottomRight: bottomRight }
end function

' Under a PlayedCheckmark's tick or count, or at the edge when it shows neither. Its disc only shows
' with one of them. A card whose artwork doesn't start where the checkmark's parent does passes the
' artwork's top.
function posterLabelsBelowCheckmark(indicator as dynamic, top = 0 as float) as float
    if not isValid(indicator) then return POSTER_LABEL_EDGE

    disc = indicator.findNode("background")
    if not isValid(disc) or not disc.visible then return POSTER_LABEL_EDGE

    return indicator.translation[1] - top + indicator.height + POSTER_LABEL_GAP
end function

' Under a mark in a top corner, or where the stack would start anyway when the mark isn't showing
function posterLabelsBelow(mark as dynamic, markHeight as float, start as float) as float
    if not isValid(mark) or not mark.visible then return start
    return mark.translation[1] + markHeight + POSTER_LABEL_GAP
end function

' Over a mark along the bottom edge, measured up from that edge, or where the stack would start
' anyway when the mark isn't showing
function posterLabelsAbove(mark as dynamic, cardHeight as float, start as float) as float
    if not isValid(mark) or not mark.visible then return start
    return cardHeight - mark.translation[1] + POSTER_LABEL_GAP
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- The labels a Moonbase admin put on one card's artwork, stacked away from each corner. Only the
     labels rebuild it, so the scale goes on before them, and a new frame only moves what's there. -->
<component name="PosterLabels" extends="Group">
    <interface>
        <!-- As posterLabels.Shown builds them, at most the admin's count in each corner -->
        <field id="labels" type="array" alwaysNotify="true" onChange="onLabelsChanged" />
        <!-- As posterLabelFrame builds it -->
        <field id="frame" type="assocarray" onChange="placeLabels" />
        <field id="labelScale" type="float" />
    </interface>
</component>

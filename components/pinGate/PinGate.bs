import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/themeApply.bs"

const PIN_CARD_WIDTH = 640
const PIN_CARD_PAD = 32
const PIN_SUBTITLE_GAP = 10
const PIN_KEYPAD_GAP = 20
const PIN_ERROR_GAP = 12
const PIN_BUTTON_GAP = 22
const PIN_BUTTON_WIDTH = 220
const PIN_BUTTON_HEIGHT = 64
const PIN_BUTTON_SPACING = 16
const PIN_REMEMBER_GAP = 18

sub init()
    m.top.optionsAvailable = false
    ' The gate owns the whole screen, so the nav bar is hidden
    m.top.overhangVisible = false
    m.card = m.top.findNode("card")
    m.cardFill = m.top.findNode("cardFill")
    m.cardBorder = m.top.findNode("cardBorder")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.keypad = m.top.findNode("keypad")
    m.error = m.top.findNode("error")
    m.unlock = m.top.findNode("unlock")
    m.forgot = m.top.findNode("forgot")
    m.remember = m.top.findNode("remember")

    m.title.font.size = 48
    m.title.text = tr("Enter PIN")
    m.subtitle.font.size = 28
    m.subtitle.width = PIN_CARD_WIDTH - PIN_CARD_PAD * 2
    m.subtitle.text = tr("This profile is protected by a 4-digit PIN.")
    m.error.font.size = 24
    m.error.width = PIN_CARD_WIDTH - PIN_CARD_PAD * 2

    m.keypad.textEditBox.secureMode = true
    m.keypad.textEditBox.maxTextLength = 4
    m.keypad.textEditBox.hintText = tr("4 digits")
    m.keypad.observeField("submit", "onPinSubmit")
    m.keypad.observeField("escape", "onKeypadEscape")
    m.keypad.observeField("text", "onPinTyped")

    m.unlock.text = tr("Unlock")
    m.unlock.width = PIN_BUTTON_WIDTH
    m.unlock.height = PIN_BUTTON_HEIGHT
    m.unlock.observeField("buttonSelected", "onPinSubmit")

    m.forgot.text = tr("Forgot PIN?")
    m.forgot.width = PIN_BUTTON_WIDTH
    m.forgot.height = PIN_BUTTON_HEIGHT
    m.forgot.observeField("buttonSelected", "onForgotPin")

    m.remember.text = tr("Remember PIN on this device")
    m.remember.width = PIN_CARD_WIDTH - PIN_CARD_PAD * 2
    m.remember.height = PIN_BUTTON_HEIGHT
    m.remember.observeField("buttonSelected", "onRememberSelected")
    onRememberChanged()

    themeApply.ApplyToItem(m.top)
    layoutCard()
end sub

' The keypad only knows its size once it is drawn, so the card is laid out again now
sub OnScreenShown(_isReturning = false as boolean)
    if m.top.siloProfileName <> ""
        m.title.text = m.top.siloProfileName
        m.subtitle.text = tr("Enter this profile's PIN.")
        m.keypad.textEditBox.maxTextLength = 8
        m.keypad.textEditBox.hintText = ""
        m.forgot.visible = false
        m.remember.visible = true
    end if
    layoutCard()
    m.keypad.setFocus(true)
end sub

' The error line only takes room while it has something to say, so the card is laid out again
' each time it changes
sub layoutCard()
    width = PIN_CARD_WIDTH - PIN_CARD_PAD * 2
    y = PIN_CARD_PAD

    m.title.translation = [PIN_CARD_PAD, y]
    y += m.title.boundingRect().height + PIN_SUBTITLE_GAP

    m.subtitle.translation = [PIN_CARD_PAD, y]
    y += m.subtitle.boundingRect().height + PIN_KEYPAD_GAP

    keypadSize = m.keypad.boundingRect()
    m.keypad.translation = [PIN_CARD_PAD + (width - keypadSize.width) / 2, y]
    y += keypadSize.height

    m.error.visible = m.error.text <> ""
    if m.error.visible
        y += PIN_ERROR_GAP
        m.error.translation = [PIN_CARD_PAD, y]
        y += m.error.boundingRect().height
    end if

    if m.remember.visible
        y += PIN_REMEMBER_GAP
        m.remember.translation = [PIN_CARD_PAD, y]
        y += PIN_BUTTON_HEIGHT
    end if

    y += PIN_BUTTON_GAP
    buttonsLeft = (PIN_CARD_WIDTH - PIN_BUTTON_WIDTH * 2 - PIN_BUTTON_SPACING) / 2
    m.unlock.translation = [buttonsLeft, y]
    m.forgot.translation = [buttonsLeft + PIN_BUTTON_WIDTH + PIN_BUTTON_SPACING, y]
    y += PIN_BUTTON_HEIGHT + PIN_CARD_PAD

    for each layer in [m.cardFill, m.cardBorder]
        layer.width = PIN_CARD_WIDTH
        layer.height = y
    end for
    m.card.translation = [(1920 - PIN_CARD_WIDTH) / 2, (1080 - y) / 2]
end sub

sub showPinError(message as string)
    m.error.text = message
    m.keypad.text = ""
    layoutCard()
    m.keypad.setFocus(true)
end sub

' A new digit clears the error. Emptying the field after a wrong guess doesnt, or the error would
' vanish as it appears.
sub onPinTyped()
    if m.error.text = "" or m.keypad.text = "" then return
    m.error.text = ""
    layoutCard()
end sub

sub onErrorChanged()
    showPinError(m.top.errorText)
end sub

sub onPinSubmit()
    if m.top.verifying then return
    entered = m.keypad.text
    m.keypad.text = ""
    m.top.submitted = entered
end sub

sub onRememberChanged()
    if m.remember = invalid then return
    if m.top.rememberPin
        m.remember.iconUri = "pkg:/images/tracks/checked.webp"
    else
        m.remember.iconUri = "pkg:/images/tracks/unchecked.webp"
    end if
end sub

sub onRememberSelected()
    if m.top.verifying then return
    m.top.rememberPin = not m.top.rememberPin
end sub

sub onForgotPin()
    if m.top.verifying then return
    m.top.forgotPin = true
end sub

sub onKeypadEscape()
    if m.keypad.escape <> "down" then return
    if m.remember.visible
        m.remember.setFocus(true)
    else
        m.unlock.setFocus(true)
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.UP and (m.unlock.hasFocus() or m.forgot.hasFocus())
        if m.remember.visible
            m.remember.setFocus(true)
        else
            m.keypad.setFocus(true)
        end if
        return true
    end if
    if key = KeyCode.UP and m.remember.hasFocus()
        m.keypad.setFocus(true)
        return true
    end if
    if key = KeyCode.DOWN and m.remember.hasFocus()
        m.unlock.setFocus(true)
        return true
    end if
    if key = KeyCode.RIGHT and m.unlock.hasFocus() and m.forgot.visible
        m.forgot.setFocus(true)
        return true
    end if
    if key = KeyCode.LEFT and m.forgot.hasFocus()
        m.unlock.setFocus(true)
        return true
    end if

    if key = KeyCode.BACK and m.top.siloProfileName <> ""
        m.top.cancelled = true
        return true
    end if

    ' The gate is the only way in, so no key gets past it to the screen behind
    return true
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- Stands between signing in and the app when the account has a PIN. Nothing behind it can take
     focus until the right PIN is in. -->
<component name="PinGate" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="#020814" />
    <Group id="card">
      <Poster id="cardFill" uri="pkg:/images/details/surface12.9.png" blendColor="#070E1E" opacity="0.9" />
      <Poster id="cardBorder" uri="pkg:/images/details/cardborder12.9.png" blendColor="#FFFFFF29" />
      <Label id="title" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <Label id="subtitle" font="font:SmallSystemFont" color="#FFFFFFC2" wrap="true" />
      <IntegerKeyboard id="keypad" domain="numeric" />
      <Label id="error" font="font:SmallestSystemFont" color="#FF9F9F" wrap="true" />
      <StandardButton
        id="unlock"
        background="0x2B6AE5E6"
        focusBackground="0x4783FFF2"
        color="0xFFFFFFFF"
        focusColor="0xFFFFFFFF" />
      <StandardButton
        id="forgot"
        background="0xFFFFFF14"
        focusBackground="0x4783FFF2"
        color="0xFFFFFFFF"
        focusColor="0xFFFFFFFF" />
    </Group>
  </children>
  <interface>
    <!-- The PIN typed in, which the sign in flow checks with the server and answers through errorText -->
    <field id="submitted" type="string" alwaysNotify="true" />
    <field id="forgotPin" type="boolean" alwaysNotify="true" />
    <field id="verifying" type="boolean" value="false" />
    <field id="errorText" type="string" alwaysNotify="true" onChange="onErrorChanged" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Swapping an item's artwork for one the providers offer, in the track picker chrome -->
<component name="ArtworkPickerDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="rowMenu"
        itemComponentName="TrackListItem"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>

    <!-- The pictures take a wider panel of their own once a kind is picked -->
    <Group id="imagePanel" visible="false">
      <Poster id="imagePanelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="imagePanelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="imageTitle" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="imageTitleRule" color="#FFFFFF" opacity="0.08" />
      <Label id="imageState" font="font:MediumSystemFont" color="#D1D5DB" horizAlign="center" visible="false" />
      <MarkupGrid
        id="imageGrid"
        itemComponentName="RemoteImageCard"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <field id="itemId" type="string" value="" />
    <field id="itemType" type="string" value="" />
    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />
    <!-- True when an image was applied, so the screen refetches -->
    <field id="finished" type="boolean" alwaysNotify="true" />
    <function name="showDialog" />
  </interface>
</component>

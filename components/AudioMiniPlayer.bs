import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/VideoControl.bs"
import "pkg:/source/utils/misc.bs"

const PILL_PAD = 32
const TITLE_LEFT = 120
const TITLE_MAX_WIDTH = 560
const TITLE_GAP = 40
const BUTTON_SIZE = 64
const BUTTON_ICON = 40
const BUTTON_GAP = 8

sub init()
    m.pill = m.top.findNode("pill")
    m.pillFill = m.top.findNode("pillFill")
    m.pillBorder = m.top.findNode("pillBorder")
    m.albumCover = m.top.findNode("albumCover")
    m.titleFocus = m.top.findNode("titleFocus")
    m.song = m.top.findNode("song")
    m.songMeasure = m.top.findNode("songMeasure")
    m.buttons = m.top.findNode("buttons")

    m.actions = ["previous", "play", "next", "stop"]
    icons = {
        "previous": "pkg:/images/icons/previous.png",
        "next": "pkg:/images/playback/skip_next.png",
        "stop": "pkg:/images/icons/stop.png"
    }
    for each action in m.actions
        button = m.buttons.createChild("Group")

        disc = button.createChild("Poster")
        disc.uri = "pkg:/images/icons/circle.png"
        disc.width = BUTTON_SIZE
        disc.height = BUTTON_SIZE

        icon = button.createChild("Poster")
        icon.width = BUTTON_ICON
        icon.height = BUTTON_ICON
        icon.translation = [(BUTTON_SIZE - BUTTON_ICON) / 2, (BUTTON_SIZE - BUTTON_ICON) / 2]
        if icons.DoesExist(action) then icon.uri = icons[action]
    end for

    m.focusIndex = 0
    m.top.observeField("focusedChild", "paint")
    layoutPill()
    paint()
end sub

sub setup()
    m.global.audioPlayer.observeFieldScoped("audioData", "onAudioDataChanged")
    m.global.audioPlayer.observeFieldScoped("state", "onPlayerStateChanged")

    ' The sidebar draws its own card from the fields this keeps up to date
    sidebar = m.top.getScene().findNode("sidebar")
    if isValid(sidebar) then sidebar.musicPlayer = m.top
end sub

function isVisible() as boolean
    return m.top.active
end function

sub setVisible(newVisibleState as boolean)
    m.top.active = newVisibleState
    m.pill.visible = newVisibleState
end sub

' Down from the bar, and the replay key, land here on the title
sub focusTitle()
    m.focusIndex = 0
    m.top.setFocus(true)
    paint()
end sub

sub onPlayerStateChanged()
    state = m.global.audioPlayer.state
    m.top.isPlaying = (state = MediaPlaybackState.PLAYING or state = MediaPlaybackState.BUFFERING)
    paint()
end sub

sub runAction(action as string)
    if action = "previous"
        m.global.audioPlayer.callFunc("playPrevious")
    else if action = "next"
        m.global.audioPlayer.callFunc("playNext")
    else if action = "play"
        togglePlayback()
    else if action = "stop"
        m.global.queueManager.callFunc("clear")
        m.global.audioPlayer.control = "stop"
    else if action = "open"
        m.top.getScene().jumpTo = { selectionType: "nowplaying" }
    end if
end sub

sub togglePlayback()
    state = m.global.audioPlayer.state
    if state = MediaPlaybackState.PLAYING
        m.global.audioPlayer.control = VideoControl.PAUSE
    else if state = MediaPlaybackState.PAUSED
        m.global.audioPlayer.control = VideoControl.RESUME
    else if state = MediaPlaybackState.FINISHED
        m.global.audioPlayer.control = VideoControl.PLAY
    end if
end sub

sub onAudioDataChanged()
    stopLoadingSpinner()

    ' A queue that mixes music with video has no mini player
    if m.global.queueManager.callFunc("getQueueUniqueTypes").count() <> 1
        setVisible(false)
        return
    end if

    if not isValidAndNotEmpty(m.global.audioPlayer.audioData)
        setVisible(false)
        return
    end if

    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if isValid(currentItem.name) and isValid(currentItem.Artists)
        artId = currentItem.id
        if isValidAndNotEmpty(currentItem.AlbumId) then artId = currentItem.AlbumId
        showTrack(currentItem, ImageURL(artId, ImageType.PRIMARY, { "maxHeight": 128, "maxWidth": 128 }))
        return
    end if

    m.LoadMetaDataTask = CreateObject("roSGNode", "LoadItemsTask")
    m.LoadMetaDataTask.itemsToLoad = "metaData"
    m.LoadMetaDataTask.itemId = currentItem.id
    m.LoadMetaDataTask.observeField("content", "onMetaDataLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN
end sub

sub onMetaDataLoaded()
    data = m.LoadMetaDataTask.content[0]
    m.LoadMetaDataTask.unobserveField("content")
    if isValidAndNotEmpty(data) and isValid(data.json) then showTrack(data.json, data.posterURL)
end sub

sub showTrack(json as object, posterURL as dynamic)
    title = ""
    if isString(json.name) then title = json.name.trim()

    artist = ""
    if isValidAndNotEmpty(json.Artists) and isString(json.Artists[0]) then artist = json.Artists[0].replace(chr(8208), "-")

    m.top.songTitle = title
    m.top.artistName = artist
    if isString(posterURL) then m.top.artUri = posterURL
    m.albumCover.uri = m.top.artUri

    if artist = ""
        m.song.text = title
    else
        m.song.text = `${title} - ${artist}`
    end if
    layoutPill()
end sub

' The pill is only as wide as its title, centered under the bar
sub layoutPill()
    m.songMeasure.text = m.song.text
    titleWidth = m.songMeasure.boundingRect().width
    if titleWidth > TITLE_MAX_WIDTH then titleWidth = TITLE_MAX_WIDTH

    left = TITLE_LEFT + titleWidth + TITLE_GAP
    for i = 0 to m.buttons.getChildCount() - 1
        m.buttons.getChild(i).translation = [left + i * (BUTTON_SIZE + BUTTON_GAP), 0]
    end for

    pillWidth = left + m.actions.count() * (BUTTON_SIZE + BUTTON_GAP) - BUTTON_GAP + PILL_PAD
    m.pillFill.width = pillWidth
    m.pillBorder.width = pillWidth
    m.titleFocus.width = titleWidth + 24
    m.pill.translation = [960 - pillWidth / 2, m.pill.translation[1]]
end sub

' A focused button turns into a white disc with a dark icon
sub paint()
    focused = m.top.hasFocus()
    m.titleFocus.visible = focused and m.focusIndex = 0

    for i = 0 to m.actions.count() - 1
        button = m.buttons.getChild(i)
        buttonFocused = focused and m.focusIndex = i + 1
        button.getChild(0).visible = buttonFocused

        icon = button.getChild(1)
        icon.blendColor = buttonFocused ? "0x101010FF" : ColorPalette.WHITE
        if m.actions[i] = "play"
            icon.uri = m.top.isPlaying ? "pkg:/images/icons/pause.png" : "pkg:/images/icons/play.png"
        end if
    end for
end sub

' Left and Right stop at both ends, and every key but those and OK goes on to the bar
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.LEFT
        if m.focusIndex > 0 then m.focusIndex -= 1
        paint()
        return true
    end if

    if key = KeyCode.RIGHT
        if m.focusIndex < m.actions.count() then m.focusIndex += 1
        paint()
        return true
    end if

    if key = KeyCode.OK
        if m.focusIndex = 0
            runAction("open")
        else
            runAction(m.actions[m.focusIndex - 1])
        end if
        return true
    end if

    return false
end function

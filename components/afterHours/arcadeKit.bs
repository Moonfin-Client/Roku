' Drawing shared by the After Hours games. Every game works on a 480 x 270 grid of units and draws
' at four device pixels to the unit. Sprites are drawn at that size, pooled by name, and moved from
' the frame timer.

const AH_UNIT = 4
const AH_W = 480
const AH_H = 270
const AH_NIGHT = "#0C0A1F"
const AH_BLUE = "#00A4DC"
const AH_PURPLE = "#AA5CC3"
const AH_GOLD = "#FFC94A"
const AH_CORAL = "#FF6B85"
const AH_MINT = "#5EF2C0"
const AH_INK = "#ECE8FF"
const AH_MUTED = "#A8A2CF"
const AH_LINE = "#2C2756"
const AH_PANEL = "#151231"
const AH_PANEL_2 = "#1C1840"
const AH_ART = "pkg:/images/afterHours/"
const AH_DISPLAY_FONT = "pkg:/fonts/Jersey10.ttf"
const AH_TWO_PI = 6.2831853

' Each sprite's frame width and height in pixels, its frame count (frames lie side by side), and
' where its own origin sits inside a frame
function ahArtTable() as object
    return {
        cable: [124, 94, 1, 55, 49],
        cableFlip: [124, 94, 1, 55, 45],
        sign: [138, 106, 1, 69, 53],
        arc: [72, 72, 1, 36, 36],
        lagBat: [106, 64, 4, 53, 41],
        gremlin: [70, 74, 3, 43, 39],
        gremlinFlip: [70, 74, 3, 43, 35],
        directPlay: [90, 90, 1, 45, 45],
        skipIntro: [106, 62, 1, 53, 31],
        popcorn: [51, 60, 1, 24, 31],
        slide: [215, 108, 4, 140, 103],
        slideFlip: [215, 108, 4, 140, 5],
        ring: [226, 226, 1, 113, 113],
        moon: [210, 210, 1, 105, 105],
        velvetRope: [130, 92, 1, 65, 47],
        popcornCart: [122, 196, 1, 61, 105],
        rollingReel: [94, 94, 1, 47, 47],
        usher: [122, 162, 1, 97, 85],
        ticket: [84, 52, 1, 42, 26],
        magnet: [74, 74, 1, 37, 37],
        frontRowPass: [66, 100, 1, 33, 51],
        bulbs: [136, 16, 2, 8, 8],
        shadow: [98, 26, 1, 49, 13],
        staticBlock: [58, 58, 3, 29, 29],
        brick: [114, 114, 1, 57, 57],
        signal: [50, 48, 1, 25, 25],
        bug: [56, 58, 2, 28, 37],
        tangle: [78, 78, 4, 39, 39],
        ghost: [76, 76, 1, 38, 38],
        snip: [58, 68, 1, 29, 35],
        plug: [80, 46, 1, 41, 23],
        shelfCat: [86, 94, 1, 43, 53],
        perfect: [98, 98, 1, 49, 49],
        hdr: [114, 66, 1, 57, 33],
        bufferNet: [112, 95, 1, 56, 60],
        deadPixel: [66, 66, 1, 33, 33],
        ball: [42, 42, 1, 21, 21],
        cast_banner: [138, 182, 1, 69, 129],
        cast_bluCase: [74, 98, 1, 37, 49],
        cast_steelbook: [74, 98, 1, 37, 49],
        cast_boxSet: [90, 102, 1, 45, 45],
        cast_macroblock: [98, 98, 1, 49, 49],
        cast_keyframe: [98, 74, 1, 49, 37]
    }
end function

function ahRandom(low as float, high as float) as float
    return low + Rnd(0) * (high - low)
end function

' A whole number from low to high, both included
function ahRandomInt(low as integer, high as integer) as integer
    return low + Int(Rnd(0) * (high - low + 1))
end function

function ahClamp(value as float, low as float, high as float) as float
    if value < low then return low
    if value > high then return high
    return value
end function

function ahMin(a as float, b as float) as float
    if a < b then return a
    return b
end function

function ahMax(a as float, b as float) as float
    if a > b then return a
    return b
end function

' Overlap of two { x, y, w, h } boxes in units
function ahHit(a as object, b as object) as boolean
    return a.x < b.x + b.w and a.x + a.w > b.x and a.y < b.y + b.h and a.y + a.h > b.y
end function

' A plain rectangle placed in units
function ahRect(parent as object, x as float, y as float, w as float, h as float, color as string, opacity = 1.0 as float) as object
    rect = parent.createChild("Rectangle")
    rect.translation = [x * AH_UNIT, y * AH_UNIT]
    rect.width = w * AH_UNIT
    rect.height = h * AH_UNIT
    rect.color = color
    if opacity < 1 then rect.opacity = opacity
    return rect
end function

' A still image placed and stretched in units
function ahImage(parent as object, name as string, x as float, y as float, w as float, h as float) as object
    poster = parent.createChild("Poster")
    poster.loadSync = true
    poster.uri = AH_ART + name + ".webp"
    poster.translation = [x * AH_UNIT, y * AH_UNIT]
    poster.width = w * AH_UNIT
    poster.height = h * AH_UNIT
    return poster
end function

' A white rounded 9-patch tinted to a color, placed in device pixels
function ahRounded(parent as object, uri as string, x as float, y as float, w as float, h as float, color as string, opacity = 1.0 as float) as object
    poster = parent.createChild("Poster")
    poster.uri = uri
    poster.translation = [x, y]
    poster.width = w
    poster.height = h
    poster.blendColor = color
    if opacity < 1 then poster.opacity = opacity
    return poster
end function

' A sprite by name. Animated ones are a sheet sliding inside a clip one frame wide.
function ahSprite(parent as object, name as string) as object
    art = m.ahArt[name]
    sprite = { name: name, fw: art[0], fh: art[1], frames: art[2], ox: art[3], oy: art[4], frame: 0, scale: 1.0 }
    if sprite.frames > 1
        sprite.node = parent.createChild("Group")
        sprite.node.clippingRect = [0, 0, art[0], art[1]]
        sprite.poster = sprite.node.createChild("Poster")
    else
        sprite.node = parent.createChild("Poster")
        sprite.poster = sprite.node
    end if
    sprite.poster.loadSync = true
    sprite.poster.uri = AH_ART + name + ".webp"
    sprite.poster.width = art[0] * art[2]
    sprite.poster.height = art[1]
    sprite.poster.scaleRotateCenter = [art[3], art[4]]
    return sprite
end function

' Puts a sprite's origin at a point in units
sub ahMove(sprite as object, x as float, y as float)
    sprite.node.translation = [x * AH_UNIT - sprite.ox * sprite.scale, y * AH_UNIT - sprite.oy * sprite.scale]
end sub

sub ahFrame(sprite as object, frame as integer)
    if sprite.frame = frame then return
    sprite.frame = frame
    sprite.poster.translation = [-frame * sprite.fw * sprite.scale, 0]
end sub

sub ahScale(sprite as object, scale as float)
    if sprite.scale = scale then return
    sprite.scale = scale
    sprite.poster.width = sprite.fw * sprite.frames * scale
    sprite.poster.height = sprite.fh * scale
    sprite.poster.scaleRotateCenter = [sprite.ox * scale, sprite.oy * scale]
    if sprite.frames > 1
        sprite.node.clippingRect = [0, 0, sprite.fw * scale, sprite.fh * scale]
        sprite.poster.translation = [-sprite.frame * sprite.fw * scale, 0]
    end if
end sub

function ahTake(name as string, parent as object) as object
    pool = m.ahPools[name]
    if pool = invalid
        pool = []
        m.ahPools[name] = pool
    end if
    if pool.count() > 0
        sprite = pool.pop()
        sprite.node.visible = true
        return sprite
    end if
    return ahSprite(parent, name)
end function

sub ahGive(sprite as object)
    sprite.node.visible = false
    m.ahPools[sprite.name].push(sprite)
end sub

' Text in the arcade's pixel face, or the system's bold one when the text has letters the face
' doesn't carry
function ahDisplayFont(text as string, size as integer) as object
    uri = AH_DISPLAY_FONT
    for i = 1 to text.Len()
        code = Asc(text.Mid(i - 1, 1))
        if code < 32 or (code > 126 and code < 192) or code > 255
            uri = "font:BoldSystemFontFile"
            exit for
        end if
    end for
    return ahFont(uri, size)
end function

function ahFont(uri as string, size as integer) as object
    key = uri + size.ToStr()
    font = m.ahFonts[key]
    if font = invalid
        font = CreateObject("roSGNode", "Font")
        font.uri = uri
        font.size = size
        m.ahFonts[key] = font
    end if
    return font
end function

function ahLabel(parent as object, x as float, y as float, font as object, color as string, text = "" as string) as object
    label = parent.createChild("Label")
    label.translation = [x, y]
    label.font = font
    label.color = color
    label.text = text
    return label
end function

' The in-game score box, with the powerups running in the top right corner
function ahHud(parent as object) as object
    hud = { score: -1, icons: {}, group: parent.createChild("Group") }
    ahRounded(hud.group, "pkg:/images/playback/surface26.9.png", 32, 28, 368, 84, "#080616", 0.6)
    hud.label = ahLabel(hud.group, 60, 28, ahFont("font:BoldSystemFontFile", 50), AH_INK)
    hud.label.height = 84
    hud.label.vertAlign = "center"
    return hud
end function

' powerups is each of the game's powerups as [sprite, running], and the running ones line up from
' the right in that order
sub ahHudDraw(hud as object, score as integer, powerups as object, t as float)
    if hud.score <> score
        hud.score = score
        hud.label.text = leftPad(score.ToStr(), "0", 7)
    end if
    slot = 0
    for each powerup in powerups
        name = powerup[0]
        icon = hud.icons[name]
        if powerup[1]
            if icon = invalid
                icon = ahSprite(hud.group, name)
                ahScale(icon, 0.85)
                hud.icons[name] = icon
            end if
            icon.node.visible = true
            ahMove(icon, AH_W - 20 - slot * 28, 18)
            if name = "perfect" then icon.poster.rotation = -t * 0.8
            slot += 1
        else if icon <> invalid
            icon.node.visible = false
        end if
    end for
end sub

' Which frame of the 24 frame stride the runner is on. The cadence follows time and speed, so
' the legs keep up with the ground.
function ahStride(g as object, dt as float) as integer
    g.phase = g.phase + dt * 24 * (1.2 + g.speed / 650)
    while g.phase >= 24
        g.phase -= 24
    end while
    return Int(g.phase)
end function

' The runner from the loading screen. Its 170 pixel frames are drawn 54 units square, the slide pose
' is its own sprite, and the ceiling uses an upside-down copy of each, since a negative scale
' doesn't mirror on Roku.
function ahRunner(parent as object) as object
    runner = { group: parent.createChild("Group"), scale: -1.0, flip: false, frame: -1 }
    runner.clip = runner.group.createChild("Group")
    runner.sheet = runner.clip.createChild("Poster")
    runner.sheet.loadSync = true
    runner.sheet.uri = "pkg:/images/loading/runner_170.webp"
    runner.slide = ahSprite(runner.group, "slide")
    runner.slideFlip = ahSprite(runner.group, "slideFlip")
    runner.slide.node.visible = false
    runner.slideFlip.node.visible = false
    return runner
end function

' Draws the runner with its feet at x, y in units. On the ceiling the frame hangs down from the feet.
sub ahRunnerDraw(runner as object, x as float, feetY as float, frame as integer, sliding as boolean, flip as boolean, scale as float)
    cell = 54 * AH_UNIT * scale
    if runner.scale <> scale
        runner.scale = scale
        runner.clip.clippingRect = [0, 0, cell, cell]
        runner.sheet.width = cell * 6
        runner.sheet.height = cell * 4
        runner.frame = -1
    end if
    if runner.flip <> flip
        runner.flip = flip
        if flip
            runner.sheet.uri = AH_ART + "runnerFlip.webp"
        else
            runner.sheet.uri = "pkg:/images/loading/runner_170.webp"
        end if
        runner.frame = -1
    end if

    runner.clip.visible = not sliding
    runner.slide.node.visible = sliding and not flip
    runner.slideFlip.node.visible = sliding and flip
    if sliding
        pose = runner.slide
        if flip then pose = runner.slideFlip
        ahFrame(pose, Int(m.ahClock * 26.67) mod 4)
        ahMove(pose, x, feetY)
        return
    end if

    if runner.frame <> frame
        runner.frame = frame
        row = Int(frame / 6)
        if flip then row = 3 - row
        runner.sheet.translation = [- (frame mod 6) * cell, -row * cell]
    end if
    top = feetY - 47 * scale
    if flip then top = feetY - 7 * scale
    runner.clip.translation = [(x - 27 * scale) * AH_UNIT, top * AH_UNIT]
end sub

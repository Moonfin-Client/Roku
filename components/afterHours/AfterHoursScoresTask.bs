import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/afterHours.bs"

' The After Hours boards on the Moonfin plugin. Anything short of a clean answer reads as no answer,
' so the arcade falls back to the boards kept on the device.

const SCORES_TIMEOUT_MS = 8000

sub init()
    m.top.functionName = "talkToServer"
end sub

sub talkToServer()
    request = m.top.request
    if request.action = "post"
        m.top.answer = postRun(request.gameId, request.score)
    else
        m.top.answer = readBoards()
    end if
end sub

function readBoard(gameId as string) as dynamic
    answer = requestResponse(APIRequest("/Moonfin/MiniGames/" + gameId + "/Scores"), "GET", "", SCORES_TIMEOUT_MS)
    if answer.status <> 200 or type(answer.data) <> "roArray" then return invalid
    return afterHours.ParseBoard(answer.data)
end function

function readBoards() as object
    boards = {}
    for each game in afterHours.Games()
        board = readBoard(game.id)
        if board = invalid then return { ok: false }
        boards[game.id] = board
    end for
    return { ok: true, boards: boards }
end function

' Sends the run, then reads the board back. The server knows who sent it from the token.
function postRun(gameId as string, score as integer) as object
    failed = { ok: false }
    req = APIRequest("/Moonfin/MiniGames/" + gameId + "/Scores")
    if req = invalid then return failed
    req.AddHeader("Content-Type", "application/json")
    answer = requestResponse(req, "POST", FormatJson({ "score": score }), SCORES_TIMEOUT_MS)
    if answer.status <> 200 or type(answer.data) <> "roAssociativeArray" then return failed
    rank = answer.data.LookupCI("rank")
    if not afterHours.IsNumber(rank) then rank = 0
    board = readBoard(gameId)
    if board = invalid then return failed
    return { ok: true, rank: Int(rank), board: board }
end function

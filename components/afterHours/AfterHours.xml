<?xml version="1.0" encoding="utf-8"?>
<!-- Moonfin After Hours, the arcade behind seven presses of Version in Settings > About. Settings
     lays it over itself. -->
<component name="AfterHours" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="#0D0B22" />
    <!-- The game draws here, the focused game's attract demo while the arcade menu is up -->
    <Group id="stage" />
    <Group id="menu">
      <Poster width="1920" height="1080" uri="pkg:/images/afterHours/shade.webp" />
      <Group id="brand" translation="[96, 56]" />
      <Group id="info" translation="[96, 244]" />
      <Group id="board" translation="[1300, 80]" />
      <Group id="row" translation="[96, 796]" />
    </Group>
    <Group id="hint" visible="false" />
    <Group id="over" visible="false">
      <Poster width="1920" height="1080" uri="pkg:/images/afterHours/dim.webp" />
    </Group>
    <Group id="pause" visible="false">
      <Poster width="1920" height="1080" uri="pkg:/images/afterHours/dim.webp" />
    </Group>
    <!-- How to play, built each time it opens -->
    <Group id="howTo" visible="false" />
    <Group id="boards" visible="false">
      <Rectangle width="1920" height="1080" color="#0D0B22" />
    </Group>
    <Audio id="music" />
    <Timer id="frameTimer" duration="0.033" repeat="true" />
    <Timer id="demoTimer" duration="0.25" repeat="false" />
  </children>
  <interface>
    <!-- Set when Back leaves the arcade, so settings can take it down -->
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

' Case Stack, the one-button stacker. The cases are titles from the media bar, colored by genre,
' in m.caseShelf.

const CS_CASE = 14
const CS_BASE = 244
const CS_FULL = 150

function csYOf(index as integer) as float
    return CS_BASE - (index + 1) * CS_CASE
end function

sub csBuild(stage as object)
    g = { slabs: [], spareFalls: [], falls: [], bands: [] }
    m.g = g
    ahImage(stage, "caseBg", 0, 0, AH_W, AH_H)
    for i = 0 to 4
        g.bands.push(ahRect(stage, 0, 0, AH_W, 5, AH_PURPLE, 0.1))
    end for
    g.camera = stage.createChild("Group")
    ahRect(g.camera, 70, CS_BASE, AH_W - 140, 7, "#3A2F6B")
    ahRect(g.camera, 84, CS_BASE + 7, 9, 60, "#2A2152")
    ahRect(g.camera, AH_W - 93, CS_BASE + 7, 9, 60, "#2A2152")
    stackLayer = g.camera.createChild("Group")
    for i = 0 to 15
        g.slabs.push(csSlab(stackLayer))
    end for
    g.moving = csSlab(g.camera)
    g.fallLayer = g.camera.createChild("Group")
    g.cat = ahSprite(stage, "shelfCat")
    ahScale(g.cat, 0.9)
    g.flash = ahLabel(stage, 0, 0, ahDisplayFont("PERFECT", 104), AH_GOLD)
    g.flash.width = 1920
    g.flash.horizAlign = "center"
    g.hud = ahHud(stage)
end sub

' A case's nodes. The clip keeps a trimmed piece to its own part of the title.
function csSlab(parent as object) as object
    slab = { group: parent.createChild("Group") }
    slab.fill = ahRounded(slab.group, "pkg:/images/details/surface8.9.png", 0, 4, 16, (CS_CASE - 2) * AH_UNIT, "#FFFFFF")
    slab.edge = slab.group.createChild("Rectangle")
    slab.edge.translation = [0, 4]
    slab.edge.height = (CS_CASE - 2) * AH_UNIT
    slab.edge.color = "#00000040"
    slab.label = ahLabel(slab.group, 0, 2, ahFont("font:BoldSystemFontFile", 28), "#FFFFFF")
    slab.label.height = CS_CASE * AH_UNIT
    slab.label.vertAlign = "center"
    slab.group.visible = false
    return slab
end function

' off is how far this piece's left edge sits from its case's own, so a trimmed piece keeps its part of the title
sub csShowSlab(slab as object, x as float, y as float, w as float, piece as object, off as float)
    slab.group.visible = w > 0
    if w <= 0 then return
    color = piece.col
    if piece.steel then color = "#B8BDD6"
    slab.group.translation = [x * AH_UNIT, y * AH_UNIT]
    slab.group.clippingRect = [0, 0, w * AH_UNIT, CS_CASE * AH_UNIT]
    slab.fill.width = ahMax(w * AH_UNIT, 16)
    slab.fill.blendColor = color
    slab.edge.visible = off = 0
    slab.edge.width = ahMin(4, w) * AH_UNIT
    slab.label.translation = [(7 - off) * AH_UNIT, 2]
    slab.label.text = piece.title
    slab.label.color = "#FFFFFF"
    if piece.steel or afterHours.IsLightColor(color) then slab.label.color = AH_NIGHT
end sub

sub csReset()
    g = m.g
    for each fall in g.falls
        fall.slab.group.visible = false
        g.spareFalls.push(fall.slab)
    end for
    shelf = m.caseShelf
    seed = ahRandomInt(0, shelf.count() - 1)
    g.over = false
    g.score = 0
    g.bonus = 0
    g.combo = 0
    g.cam = 0.0
    g.flashLeft = 0.0
    g.paw = 0.0
    g.pawX = 0
    g.falls = []
    g.seed = seed + 1
    g.lastDt = 1 / 30
    g.stack = [{ x: (AH_W - CS_FULL) / 2, tx: (AH_W - CS_FULL) / 2, w: CS_FULL, title: shelf[seed].title, col: shelf[seed].color, steel: false }]
    csSpawn()
    csLayout()
end sub

sub csSpawn()
    g = m.g
    n = g.stack.count()
    top = g.stack[n - 1]
    steel = n mod 10 = 9
    cat = n > 8 and not steel and Rnd(0) < 0.12
    fromLeft = Rnd(0) < 0.5
    shelf = m.caseShelf
    entry = shelf[(g.seed + n) mod shelf.count()]
    speed = ahMin(330, 110 + n * 6)
    if steel then speed = speed * 1.6
    if cat then speed = speed * 1.5
    x = AH_W - 12 - top.w
    dir = -1
    if fromLeft
        x = 12
        dir = 1
    end if
    g.cur = { x: x, w: top.w, dir: dir, v: speed, steel: steel, title: entry.title, col: entry.color }
    g.paw = 0
    if cat
        g.paw = 0.5
        ahSound("whoosh")
    end if
    g.pawX = AH_W - 16
    if fromLeft then g.pawX = 16
    g.aim = 0
    if Rnd(0) >= 0.3 then g.aim = ahRandom(-1, 1) * (4 + n * 0.15)
end sub

sub csDrop()
    g = m.g
    c = g.cur
    if c = invalid then return
    top = g.stack[g.stack.count() - 1]
    y = csYOf(g.stack.count())
    dx = c.x - top.x
    ahSound("thud")
    if Abs(dx) < 3
        g.combo += 1
        grow = 6
        g.flashText = tr("PERFECT")
        sound = "pickup"
        if g.combo mod 3 = 0
            grow = 30
            g.flashText = tr("BOX SET")
            sound = "powerup"
        end if
        w = ahMin(CS_FULL, top.w + grow)
        x = top.x - (w - top.w) / 2
        g.stack.push({ title: c.title, col: c.col, steel: c.steel, x: x, tx: x, w: w })
        g.bonus += g.combo * 5
        g.flashLeft = 0.6
        ahSound(sound)
    else
        g.combo = 0
        left = ahMax(c.x, top.x)
        right = ahMin(c.x + c.w, top.x + top.w)
        spin = -2.5
        if dx > 0 then spin = 2.5
        if right <= left
            csFall({ title: c.title, col: c.col, steel: c.steel, tx: c.x, x: c.x, w: c.w, y: y, vy: 0.0, rot: 0.0, vr: spin * 0.8 })
            g.cur = invalid
            g.over = true
            csLayout()
            return
        end if
        g.stack.push({ title: c.title, col: c.col, steel: c.steel, tx: c.x, x: left, w: right - left })
        cutX = c.x
        if dx > 0 then cutX = right
        csFall({ title: c.title, col: c.col, steel: c.steel, tx: c.x, x: cutX, w: c.w - (right - left), y: y, vy: 0.0, rot: 0.0, vr: spin })
        ahSound("break")
    end if
    g.score = g.stack.count() - 1 + g.bonus
    csSpawn()
    csLayout()
end sub

sub csFall(fall as object)
    g = m.g
    if g.spareFalls.count() > 0
        fall.slab = g.spareFalls.pop()
    else
        fall.slab = csSlab(g.fallLayer)
    end if
    csShowSlab(fall.slab, 0, 0, fall.w, fall, fall.x - fall.tx)
    fall.slab.group.scaleRotateCenter = [fall.w * AH_UNIT / 2, CS_CASE * AH_UNIT / 2]
    g.falls.push(fall)
end sub

' The top sixteen cases of the stack, laid out again after each drop
sub csLayout()
    g = m.g
    n = g.stack.count()
    first = n - 16
    if first < 0 then first = 0
    for i = 0 to 15
        index = first + i
        if index < n
            piece = g.stack[index]
            csShowSlab(g.slabs[i], piece.x, csYOf(index), piece.w, piece, piece.x - piece.tx)
        else
            g.slabs[i].group.visible = false
        end if
    end for
    if g.cur <> invalid
        csShowSlab(g.moving, g.cur.x, csYOf(n), g.cur.w, g.cur, 0)
    else
        g.moving.group.visible = false
    end if
end sub

sub csUpdate(dt as float)
    g = m.g
    g.lastDt = dt
    g.paw -= dt
    g.flashLeft -= dt
    c = g.cur
    if c <> invalid
        c.x += c.dir * c.v * dt
        if c.x < 12
            c.x = 12
            c.dir = 1
        end if
        if c.x + c.w > AH_W - 12
            c.x = AH_W - 12 - c.w
            c.dir = -1
        end if
    end if
    kept = []
    for each fall in g.falls
        fall.vy += 900 * dt
        fall.y += fall.vy * dt
        fall.rot += fall.vr * dt
        if fall.y + g.cam < AH_H + 40
            kept.push(fall)
        else
            fall.slab.group.visible = false
            g.spareFalls.push(fall.slab)
        end if
    end for
    g.falls = kept
    goal = ahMax(0, (g.stack.count() - 9) * CS_CASE)
    g.cam += (goal - g.cam) * ahMin(1, dt * 5)
end sub

' Drops when the case is about to cross the spot it's aiming for
sub csAi()
    g = m.g
    c = g.cur
    if c = invalid then return
    target = ahClamp(g.stack[g.stack.count() - 1].x + g.aim, 12, AH_W - 12 - c.w)
    ahead = c.x + c.dir * c.v * g.lastDt
    if (c.x - target) * (ahead - target) <= 0 then csDrop()
end sub

sub csPress(key as string)
    if key = "OK" then csDrop()
end sub

sub csDraw()
    g = m.g
    t = m.ahClock
    for i = 0 to 4
        y = i * 64 + g.cam * 0.4
        y = y - Int(y / 320) * 320 - 20
        g.bands[i].translation = [0, y * AH_UNIT]
    end for
    g.camera.translation = [0, g.cam * AH_UNIT]
    if g.cur <> invalid then g.moving.group.translation = [g.cur.x * AH_UNIT, csYOf(g.stack.count()) * AH_UNIT]
    for each fall in g.falls
        fall.slab.group.translation = [fall.x * AH_UNIT, fall.y * AH_UNIT]
        fall.slab.group.rotation = -fall.rot
    end for

    y = csYOf(g.stack.count()) + g.cam
    g.cat.node.visible = g.paw > 0
    if g.paw > 0
        g.cat.node.opacity = ahMin(1, g.paw * 4)
        ahMove(g.cat, g.pawX, y + CS_CASE / 2)
    end if
    g.flash.visible = g.flashLeft > 0
    if g.flashLeft > 0
        g.flash.opacity = ahMin(1, g.flashLeft * 3)
        if g.flash.text <> g.flashText
            g.flash.font = ahDisplayFont(g.flashText, 104)
            g.flash.text = g.flashText
        end if
        g.flash.translation = [0, (y - 10) * AH_UNIT - 84]
    end if

    ahHudDraw(g.hud, g.score, [["perfect", g.combo > 0]], t)
end sub

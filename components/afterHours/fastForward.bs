' Fast Forward, the three-lane runner. Each lane draws in its own layer, back to front, so the
' nearer lanes cover the farther ones.

function ffDepth(y as float) as float
    return 0.78 + (y - 158) / (240 - 158) * 0.22
end function

function ffNearest(y as float) as integer
    lanes = m.g.lanes
    best = 0
    for i = 1 to 2
        if Abs(lanes[i] - y) < Abs(lanes[best] - y) then best = i
    end for
    return best
end function

sub ffBuild(stage as object)
    ' foot is how far above its lane each thing's origin sits, at full size
    g = { lanes: [158.0, 198.0, 240.0], foot: { velvetRope: 11, popcornCart: 22, rollingReel: 11, usher: 19, ticket: 30, magnet: 34, frontRowPass: 34 }, marquees: [], things: [] }
    m.g = g
    ahRect(stage, 0, 0, AH_W, 134, "#140F2E")
    colors = ["blue", "purple", "coral"]
    for i = 0 to 5
        marquee = { node: stage.createChild("Group"), i: i }
        ahImage(marquee.node, "marquee_" + colors[i mod 3], 0, 22, 62, 86)
        marquee.bulbs = ahSprite(marquee.node, "bulbs")
        ahMove(marquee.bulbs, 6, 16)
        g.marquees.push(marquee)
    end for
    ahRect(stage, 0, 134, AH_W, AH_H - 134, "#211A45")
    ahRect(stage, 0, 134, AH_W, 4, "#2A2152")
    g.dashes = stage.createChild("Group")
    for each y in [178, 219]
        for x = 0 to AH_W + 28 step 28
            ahRect(g.dashes, x, y, 14, 2, AH_GOLD, 0.45)
        end for
    end for

    ' Each lane has its things, then a slot the runner moves into while it's in that lane
    g.layers = []
    g.tops = []
    for i = 0 to 2
        g.layers.push(stage.createChild("Group"))
        g.tops.push(stage.createChild("Group"))
    end for
    g.player = g.tops[1].createChild("Group")
    g.playerLane = 1
    g.shadow = ahSprite(g.player, "shadow")
    g.runner = ahRunner(g.player)
    g.ring = ahSprite(g.player, "ring")
    g.ring.node.opacity = 0.75
    g.hud = ahHud(stage)
    m.ffPool = {}
end sub

sub ffReset()
    g = m.g
    for each o in g.things
        ffDropThing(o)
    end for
    g.over = false
    g.t = 0.0
    g.dist = 0.0
    g.bonus = 0
    g.score = 0
    g.speed = 230.0
    g.spawnIn = 1.0
    g.things = []
    g.inv = 0.0
    g.phase = 0.0
    g.fr = 0
    g.p = { x: 90, lane: 1, ly: g.lanes[1], jy: 0.0, jv: 0.0, pass: false, mag: 0.0 }
end sub

sub ffSpawn()
    g = m.g
    x = AH_W + 30
    lane = ahRandomInt(0, 2)
    r = Rnd(0)
    if g.t > 5 and Rnd(0) < 0.1
        kind = "frontRowPass"
        if Rnd(0) < 0.5 then kind = "magnet"
        ffAddThing({ k: kind, x: x, lane: lane, w: 20, pick: true })
        return
    end if
    kind = ""
    if r < 0.3
        kind = "popcornCart"
    else if r < 0.5
        kind = "velvetRope"
    else if r < 0.64 and g.t > 6
        kind = "rollingReel"
    else if r < 0.76 and g.t > 10
        kind = "usher"
    end if
    if kind = ""
        for i = 0 to 3
            ffAddThing({ k: "ticket", x: x + i * 22, lane: lane, w: 14, pick: true })
        end for
        return
    end if
    ' Never wall off all three lanes at once
    if kind = "popcornCart" or kind = "usher"
        walled = {}
        for each o in g.things
            if o.tall and o.lane <> lane and Abs(o.x - x) < 110 then walled[o.lane.ToStr()] = true
        end for
        if walled.count() >= 2 then kind = "velvetRope"
    end if
    widths = { popcornCart: 30, velvetRope: 30, rollingReel: 22, usher: 16 }
    ffAddThing({ k: kind, x: x, lane: lane, w: widths[kind], tall: kind = "popcornCart" or kind = "usher", sw: ahRandom(0.5, 1.3) })
end sub

sub ffAddThing(o as object)
    g = m.g
    if o.pick = invalid then o.pick = false
    if o.tall = invalid then o.tall = false
    o.dead = false
    o.fy = g.lanes[o.lane]
    o.layer = ffNearest(o.fy)
    pool = m.ffPool[o.k]
    if pool = invalid
        pool = []
        m.ffPool[o.k] = pool
    end if
    if pool.count() > 0
        held = pool.pop()
        g.layers[o.layer].appendChild(held.node)
        held.node.visible = true
    else
        held = { node: g.layers[o.layer].createChild("Group") }
        held.shadow = ahSprite(held.node, "shadow")
        held.sprite = ahSprite(held.node, o.k)
    end if
    o.held = held
    o.node = held.node
    o.shadow = held.shadow
    o.sprite = held.sprite
    o.depth = -1.0
    g.things.push(o)
end sub

sub ffDropThing(o as object)
    o.node.visible = false
    m.ffPool[o.k].push(o.held)
end sub

sub ffUpdate(dt as float)
    g = m.g
    p = g.p
    g.t += dt
    g.speed = ahMin(500, 230 + g.t * 6)
    v = g.speed
    g.dist += v * dt
    g.score = Int(g.dist / 8) + g.bonus
    g.fr = ahStride(g, dt)
    p.ly += ahClamp(g.lanes[p.lane] - p.ly, -420 * dt, 420 * dt)
    if p.jy > 0 or p.jv > 0
        p.jv -= 1400 * dt
        p.jy += p.jv * dt
        if p.jy <= 0
            p.jy = 0
            p.jv = 0
        end if
    end if
    p.mag -= dt
    g.inv -= dt
    g.spawnIn -= dt
    if g.spawnIn <= 0
        ffSpawn()
        g.spawnIn = ahMax(0.35, ahRandom(0.55, 1) * 260 / v)
    end if

    current = ffNearest(p.ly)
    for each o in g.things
        o.x -= v * dt
        if o.k = "rollingReel" then o.x -= 120 * dt
        if o.k = "usher"
            o.x -= 30 * dt
            o.sw -= dt
            if o.sw <= 0
                if o.lane = 1
                    o.lane = 2
                    if Rnd(0) < 0.5 then o.lane = 0
                else
                    o.lane = 1
                end if
                o.sw = 99
            end if
        end if
        o.fy += ahClamp(g.lanes[o.lane] - o.fy, -160 * dt, 160 * dt)
        if o.k = "ticket" and p.mag > 0 and o.x - p.x < 150
            o.lane = current
            o.fy = p.ly
            o.x -= 180 * dt
        end if
        if not o.dead and ffNearest(o.fy) = current and o.x <= p.x + 9 and o.x + o.w >= p.x - 9
            if o.pick
                o.dead = true
                if o.k = "ticket"
                    g.bonus += 25
                    ahSound("pickup")
                else if o.k = "magnet"
                    p.mag = 8
                    ahSound("powerup")
                else
                    p.pass = true
                    ahSound("powerup")
                end if
            else if (o.tall or p.jy <= 16) and g.inv <= 0
                if p.pass
                    p.pass = false
                    g.inv = 1.2
                    o.dead = true
                    ahSound("break")
                else
                    g.over = true
                end if
            end if
        end if
    end for

    kept = []
    for each o in g.things
        if not o.dead and o.x > -60
            kept.push(o)
        else
            ffDropThing(o)
        end if
    end for
    g.things = kept
end sub

sub ffPress(key as string)
    p = m.g.p
    if key = "up" and p.lane > 0
        p.lane -= 1
        ahSound("swish")
    else if key = "down" and p.lane < 2
        p.lane += 1
        ahSound("swish")
    else if key = "OK" and p.jy = 0 and p.jv = 0
        p.jv = 420
        ahSound("jump")
    end if
end sub

' Whether a lane is clear of tall things for a while ahead
function ffFree(lane as integer, reach as float) as boolean
    if lane < 0 or lane > 2 then return false
    p = m.g.p
    for each o in m.g.things
        if o.tall and not o.dead and ffNearest(o.fy) = lane and o.x - p.x > -40 and o.x - p.x < reach then return false
    end for
    return true
end function

sub ffAi()
    g = m.g
    p = g.p
    v = g.speed
    ahead = invalid
    for each o in g.things
        if not o.pick and not o.dead and ffNearest(o.fy) = p.lane
            d = o.x - p.x - 9
            if d >= -o.w and d <= v * 0.6
                if ahead = invalid
                    ahead = o
                else if o.x < ahead.x
                    ahead = o
                end if
            end if
        end if
    end for
    if ahead = invalid then return

    d = ahead.x - p.x - 9
    closing = v
    if ahead.k = "rollingReel" then closing = v + 120
    if ahead.k = "usher" then closing = v + 30
    if not ahead.tall
        if d < closing * 0.16 and p.jy = 0 then ffPress("OK")
        return
    end if
    if d < closing * 0.45
        if ffFree(p.lane - 1, closing * 0.6)
            ffPress("up")
        else if ffFree(p.lane + 1, closing * 0.6)
            ffPress("down")
        end if
    end if
end sub

sub ffDraw()
    g = m.g
    p = g.p
    t = m.ahClock
    blink = Int(t * 5)
    for each marquee in g.marquees
        x = marquee.i * 110 - g.dist * 0.4
        x = x - Int(x / 660) * 660 - 90
        marquee.node.translation = [x * AH_UNIT, 0]
        ahFrame(marquee.bulbs, (marquee.i + blink) mod 2)
    end for
    shift = g.dist - Int(g.dist / 28) * 28
    g.dashes.translation = [-shift * AH_UNIT, 0]

    for each o in g.things
        lane = ffNearest(o.fy)
        if lane <> o.layer
            o.layer = lane
            g.layers[lane].appendChild(o.node)
        end if
        s = ffDepth(o.fy)
        if Abs(s - o.depth) > 0.004
            o.depth = s
            ahScale(o.shadow, s)
            ahScale(o.sprite, s)
        end if
        cx = o.x + o.w / 2
        ahMove(o.shadow, cx, o.fy + 1)
        ahMove(o.sprite, cx, o.fy - g.foot[o.k] * o.depth)
        if o.k = "rollingReel" then o.sprite.poster.rotation = t * 10
    end for

    lane = ffNearest(p.ly)
    if lane <> g.playerLane
        g.playerLane = lane
        g.tops[lane].appendChild(g.player)
    end if
    s = ffDepth(p.ly)
    ahScale(g.shadow, s)
    ahMove(g.shadow, p.x, p.ly + 1)
    shown = not (g.inv > 0 and Int(t * 16) mod 2 = 1)
    g.runner.group.visible = shown
    g.ring.node.visible = shown and p.pass
    if shown
        frame = g.fr
        if p.jy > 0 then frame = 7
        ahRunnerDraw(g.runner, p.x, p.ly - p.jy, frame, false, false, s)
        if p.pass
            ahScale(g.ring, s * 26 / 27)
            ahMove(g.ring, p.x, p.ly - p.jy - 20 * s)
        end if
    end if

    ahHudDraw(g.hud, g.score, [["frontRowPass", p.pass], ["magnet", p.mag > 0]], t)
end sub

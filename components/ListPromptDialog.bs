import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"

sub init()
    m.rowMenu = m.top.findNode("rowMenu")
    m.rowMenu.observeField("itemSelected", "onRowSelected")

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.top.findNode("title"),
        titleRule: m.top.findNode("titleRule"),
        list: m.rowMenu
    }
    m.details = m.top.findNode("details")

end sub

sub showDialog()
    m.parts.title.text = m.top.dialogTitle

    content = CreateObject("roSGNode", "ContentNode")
    m.firstOption = 0

    if isValidAndNotEmpty(m.top.message)
        row = content.CreateChild("SeerrRequestListData")
        row.title = m.top.message
        row.dimmed = true
        row.noIndicator = true
        row.paragraph = true
        row.rowHeight = trackDialog.RowHeight()
        m.firstOption = 1
    end if

    labels = m.top.options
    if not isValid(labels) or labels.count() = 0 then labels = [tr("OK")]

    details = m.top.optionDetails
    if not isValid(details) then details = []

    for i = 0 to labels.count() - 1
        row = content.CreateChild("SeerrRequestListData")
        row.title = labels[i]
        if i < details.count() and details[i] <> "" then row.description = details[i]
        row.dividerAbove = (i = 0 and m.firstOption > 0) or i = m.top.dividerBefore
        row.selected = (i = m.top.selectedOption)
        row.rowHeight = trackDialog.RowHeight()
    end for

    trackDialog.Layout(m.parts, content.getChildCount())
    layoutDetails()

    m.rowMenu.content = content
    opening = m.firstOption
    if m.top.openOnSelected and m.top.selectedOption >= 0
        opening += m.top.selectedOption
    else if m.top.focusOption >= 0
        opening += m.top.focusOption
    end if
    m.rowMenu.jumpToItem = opening

    m.top.visible = true
    m.rowMenu.setFocus(true)
end sub

' The detail lines sit under the title rule, and the list and the panel make room for them
sub layoutDetails()
    m.details.removeChildrenIndex(m.details.getChildCount(), 0)
    lines = m.top.details
    if not isValid(lines) or lines.count() = 0 then return

    width = trackDialog.PANEL_WIDTH - (trackDialog.ROW_PAD_X * 2)
    y = 0
    for each line in lines
        label = CreateObject("roSGNode", "Label")
        label.font = "font:SmallestSystemFont"
        label.font.size = 21
        label.wrap = true
        label.lineSpacing = 6
        label.width = width
        label.color = "#FFFFFFB3"
        if line.note = true then label.color = "#FFFFFF8C"
        label.text = line.text
        label.translation = [0, y]
        m.details.appendChild(label)
        y += label.boundingRect().height + 6
    end for
    room = y + 12

    top = m.parts.list.translation[1]
    m.details.translation = [trackDialog.ROW_PAD_X, top]
    m.parts.list.translation = [0, top + room]
    for each layer in [m.parts.panelBg, m.parts.panelBorder]
        layer.height += room
    end for
    m.parts.panel.translation = [m.parts.panel.translation[0], (1080 - m.parts.panelBg.height) / 2]
end sub

sub onRowSelected()
    index = m.rowMenu.itemSelected - m.firstOption
    if index < 0 then return

    closeDialog(index)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A dismissed dialog can still hold focus, and swallowing keys there would strand the screen
    if not m.top.visible then return false

    if key = KeyCode.BACK
        closeDialog(-1)
        return true
    end if

    if key = KeyCode.UP or key = KeyCode.DOWN or key = KeyCode.OK
        if not m.rowMenu.isInFocusChain() then m.rowMenu.setFocus(true)
        return true
    end if

    return false
end function

' The owner takes this node out of the scene as soon as it is told, so focus moves first
sub closeDialog(index as integer)
    m.top.visible = false
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
    m.top.optionSelected = index
end sub

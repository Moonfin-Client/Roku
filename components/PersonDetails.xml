<?xml version="1.0" encoding="utf-8"?>
<component name="PersonDetails" extends="JFScreen">
  <interface>
    <field id="itemContent" type="node" onChange="loadPerson" />
    <field id="seerrPersonId" type="string" value="" onChange="loadSeerrPerson" />
    <field id="image" type="node" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
  </interface>
  <children>
    <!-- Full page backdrop from the filmography, dimmed -->
    <Poster id="backdropPrev" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.0" />
    <Poster id="backdrop" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.0" />
    <Rectangle id="backdropTint" width="1920" height="1080" color="#F2000000" opacity="1.0" />

    <!-- Person info block -->
    <Group id="infoSection" translation="[96, 140]">
      <!-- The disc sits behind the headshot, so it backs the initial when there is no
           picture rather than covering the picture when there is one -->
      <Poster id="personImageRing"
        uri="pkg:/images/icons/circle.png"
        width="250"
        height="250"
        blendColor="#00A4DC" />
      <MaskGroup id="personImageClip" maskUri="pkg:/images/icons/circle.png" maskSize="[250, 250]">
        <Poster id="personImage"
          width="250"
          height="250"
          loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <!-- Initial placeholder when there is no headshot -->
      <Label id="noImage"
        width="250"
        height="250"
        horizAlign="center"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="#666666"
        visible="false" />

      <Group id="personDetails" translation="[282, 0]">
        <Label id="name"
          font="font:LargeBoldSystemFont"
          color="#FFFFFF" />
        <Label id="metaRow"
          translation="[0, 72]"
          font="font:SmallSystemFont"
          color="#AAAAAA" />
        <RatingsRow id="ratings" translation="[0, 108]" visible="false" />

        <!-- Biography, clamped until it is selected -->
        <Group id="overviewGroup" focusable="true">
          <Label id="overview"
            translation="[0, 150]"
            width="1500"
            font="font:SmallSystemFont"
            color="#CCCCCC"
            wrap="true"
            maxLines="4"
            visible="false" />
          <Label id="overviewToggle"
            translation="[0, 380]"
            font="font:SmallestBoldSystemFont"
            color="#00A4DC"
            visible="false" />
        </Group>
      </Group>
    </Group>

    <!-- Favorite button, a labeled pill like the other clients -->
    <Group id="buttonRow" translation="[378, 570]">
      <Group id="favoriteButtonGroup" focusable="true">
        <Poster id="favoriteButtonBg"
          uri="pkg:/images/hd_focus_filled.9.png"
          loadDisplayMode="scaleToFit"
          width="220"
          height="75"
          blendColor="#444444"
          opacity="0.6" />
        <Poster id="favoriteIcon"
          uri="pkg:/images/icons/heart.png"
          width="40"
          height="40"
          translation="[24, 17]" />
        <Label id="favoriteButtonLabel"
          translation="[76, 22]"
          font="font:SmallSystemFont"
          color="#FFFFFF"
          text="Favorite" />
      </Group>
    </Group>

    <!-- Filmography tabs, the pill bar the detail screens use -->
    <DetailTabBar id="tabBar"
      translation="[96, 648]"
      visible="false" />

    <!-- The one row for the active tab -->
    <ExtrasRowList id="filmographyRow"
      translation="[96, 720]"
      rowFocusAnimationStyle="floatingFocus"
      itemSpacing="[60, 60]"
      numRows="1"
      showRowLabel="false"
      showRowCounter="false"
      visible="true"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/hd_focus.9.png"
      itemComponentName="ExtrasItem" />

    <!-- Backdrop crossfade animations -->
    <Animation id="backdropFadeIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropFadeInInterp"
        key="[0.0, 1.0]"
        keyValue="[0.0, 0.4]"
        fieldToInterp="backdrop.opacity" />
    </Animation>

    <Animation id="backdropPrevFadeOut" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropPrevFadeOutInterp"
        key="[0.0, 1.0]"
        keyValue="[0.4, 0.0]"
        fieldToInterp="backdropPrev.opacity" />
    </Animation>
  </children>
</component>

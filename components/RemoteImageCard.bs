import "pkg:/source/utils/misc.bs"

sub init()
    m.image = m.top.findNode("image")
    m.provider = m.top.findNode("provider")
    m.frame = m.top.findNode("frame")
end sub

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    m.image.uri = content.url
    m.provider.text = content.provider
end sub

' The grid draws no focus ring of its own, so the card lights its own frame
sub onFocusChanged()
    focused = m.top.itemHasFocus or m.top.focusPercent > 0.5
    m.frame.opacity = focused ? 0.9 : 0
    m.provider.color = focused ? "#FFFFFF" : "#FFFFFFB3"
end sub

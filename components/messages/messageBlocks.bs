import "pkg:/source/utils/messageMarkdown.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/themeChrome.bs"

' How the server messages draw markdown text, shared with the review dialog. These run in the
' host's scope and read the colors readPalette leaves on m.

const BLOCK_GAP = 8
const BODY_SIZE = 19

sub readPalette()
    m.ink = themeChrome.OnSurface()
    m.muted = playbackOverlay.WithAlpha(m.ink, 179)
    m.faint = playbackOverlay.WithAlpha(m.ink, 128)
    m.buttonInk = playbackOverlay.WithAlpha(m.ink, 26)
    m.accent = themeChrome.Accent()
    m.onAccent = themeChrome.OnAccent()
    m.surface = themeChrome.Surface()
end sub

function drawBlocks(parent as object, blocks as object, textWidth as float) as float
    used = 0

    for each block in blocks
        if used > 0 then used += BLOCK_GAP

        if block.type = "list"
            for each item in block.items
                line = parent.createChild("Label")
                line.font = "font:SmallSystemFont"
                line.font.size = BODY_SIZE
                line.color = m.muted
                line.width = textWidth - 28
                line.wrap = true
                line.text = "• " + messageMarkdown.FlattenInlines(item)
                line.translation = [28, used]
                used += line.boundingRect().height
            end for
            continue for
        end if

        line = parent.createChild("Label")
        line.wrap = true
        line.width = textWidth
        line.translation = [0, used]

        if block.type = "heading"
            line.font = "font:MediumBoldSystemFont"
            size = 20
            if block.level <= 1 then size = 24
            if block.level = 2 then size = 22
            line.font.size = size
            line.color = m.ink
            line.text = messageMarkdown.FlattenInlines(block.children)
        else if block.type = "code"
            line.font = "font:SmallSystemFont"
            line.font.size = 17
            line.color = m.muted
            line.text = block.text
        else if block.type = "quote"
            line.font = "font:SmallSystemFont"
            line.font.size = BODY_SIZE
            line.color = m.muted
            line.width = textWidth - 14
            line.translation = [14, used]
            line.text = messageMarkdown.FlattenInlines(block.children)

            rule = parent.createChild("Rectangle")
            rule.width = 3
            rule.color = m.faint
            rule.translation = [0, used]
            rule.height = line.boundingRect().height
        else
            line.font = "font:SmallSystemFont"
            line.font.size = BODY_SIZE
            line.color = m.muted
            line.text = messageMarkdown.FlattenInlines(block.children)
        end if

        used += line.boundingRect().height
    end for

    return used
end function

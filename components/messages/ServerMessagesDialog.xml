<?xml version="1.0" encoding="utf-8"?>
<!-- The window listing the messages the server admin sent. A card opens in
     place to show the whole message, and opening one counts as reading it. -->
<component name="ServerMessagesDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />

      <Label id="title" />
      <Poster id="closeRing" uri="pkg:/images/icons/circle.webp" />
      <Label id="closeMark" />

      <Label id="empty" visible="false" />

      <!-- The cards sit in a column that scrolls behind this window -->
      <Group id="viewport">
        <Group id="column" />
      </Group>

      <Poster id="footerBg" uri="pkg:/images/details/surface12.9.png" visible="false" />
      <Label id="footerLabel" visible="false" />
    </Group>

    <!-- The address on its own, in place of the list -->
    <Group id="linkPanel" visible="false">
      <Poster id="linkBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="linkBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="linkTitle" />
      <Label id="linkHint" />
      <Label id="linkUrl" />
      <Poster id="linkCloseBg" uri="pkg:/images/details/surface12.9.png" />
      <Label id="linkCloseLabel" />
    </Group>
  </children>

  <interface>
    <!-- Where focus goes when the window closes, otherwise it is stranded -->
    <field id="returnFocus" type="node" />
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
  </interface>
</component>

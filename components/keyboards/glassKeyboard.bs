' The Glass look for the in-app keyboard. The keys and the moves are Classic's, drawn on a
' see-through panel with larger keys, and the focused key lifts in white. Roku has no blur,
' so the panel is a translucent tint.

const GK_PANEL_WIDTH = 1700
const GK_BOTTOM_MARGIN = 36
const GK_PAD_TOP = 32
const GK_PAD_X = 36
const GK_PAD_BOTTOM = 36
const GK_HEADER_HEIGHT = 72
const GK_HEADER_GAP = 24
const GK_CHIP_HEIGHT = 64
const GK_CHIP_SIZE = 27
const GK_KEY_HEIGHT = 88
const GK_ROW_GAP = 16
const GK_CHAR_SIZE = 38
const GK_WORD_SIZE = 27
const GK_FOCUS_SCALE = 1.12
const GK_FOCUS_FILL = "#F5F7FAFF"
const GK_FOCUS_INK = "#0B0D12FF"

sub buildGlassGrid()
    m.grid.removeChildrenIndex(m.grid.getChildCount(), 0)
    m.keyNodes = []

    for each gridRow in m.rows
        builtRow = []
        for each entry in gridRow
            keyGroup = m.grid.createChild("Group")
            bg = keyGroup.createChild("Poster")
            bg.uri = "pkg:/images/settings/tile23.9.png"

            icon = invalid
            label = invalid
            iconUri = iconFor(entry)
            if iconUri <> "" and entry <> "DONE"
                icon = keyGroup.createChild("Poster")
                icon.uri = iconUri
                icon.width = glassIconSize(entry)
                icon.height = icon.width
            else
                label = keyGroup.createChild("Label")
                label.text = glassKeyLabel(entry)
                if entry.len() = 1
                    label.font = "font:SmallestSystemFont"
                    label.font.size = GK_CHAR_SIZE
                else
                    label.font = entry = "SPACE" ? "font:SmallestSystemFont" : "font:SmallestBoldSystemFont"
                    label.font.size = GK_WORD_SIZE
                end if
                label.horizAlign = "center"
                label.vertAlign = "center"
                label.height = GK_KEY_HEIGHT
            end if

            builtRow.push({ node: keyGroup, bg: bg, icon: icon, label: label, value: entry })
        end for
        m.keyNodes.push(builtRow)
    end for
end sub

function glassIconSize(entry as string) as integer
    if entry = "SHIFT" or entry = "IME" then return 40
    if entry = "BACKSPACE" then return 42

    return 36
end function

function glassKeyLabel(entry as string) as string
    if entry = "SPACE" then return tr("space")
    if entry = "DONE" then return finishLabel()

    return entry
end function

sub layoutGlass()
    contentWidth = GK_PANEL_WIDTH - (GK_PAD_X * 2)
    yPos = layoutFieldRows(GK_PAD_X, GK_PAD_TOP, contentWidth)

    ' The chips start the header and the accents hint ends it
    m.chipBar.translation = [GK_PAD_X, yPos + (GK_HEADER_HEIGHT - GK_CHIP_HEIGHT) / 2]
    layoutChips(GK_CHIP_HEIGHT)
    m.hints.translation = [GK_PAD_X + contentWidth - m.hintsWidth, yPos + (GK_HEADER_HEIGHT - KB_CAP_HEIGHT) / 2]
    yPos += GK_HEADER_HEIGHT + GK_HEADER_GAP

    m.grid.translation = [GK_PAD_X, yPos]
    m.halo.translation = m.grid.translation
    yPos += layoutKeyRows(contentWidth, GK_KEY_HEIGHT, GK_ROW_GAP) + GK_PAD_BOTTOM
    for each builtRow in m.keyNodes
        for each entry in builtRow
            entry.node.scaleRotateCenter = [entry.width / 2, GK_KEY_HEIGHT / 2]
        end for
    end for

    m.panelBg.width = GK_PANEL_WIDTH
    m.panelBg.height = yPos
    m.panelBorder.width = GK_PANEL_WIDTH
    m.panelBorder.height = yPos
    m.panel.translation = [(1920 - GK_PANEL_WIDTH) / 2, 1080 - GK_BOTTOM_MARGIN - yPos]
    m.top.panelTop = m.panel.translation[1]
end sub

sub paintGlass()
    accent = themeChrome.Accent()

    m.panelBg.blendColor = "#181A20EB"
    m.panelBorder.blendColor = "#FFFFFF17"
    m.title.color = "#FFFFFFEB"
    m.fieldBg.blendColor = "#FFFFFF13"
    m.field.textColor = "#FFFFFFEB"
    m.field.hintTextColor = "#FFFFFF73"

    for i = 0 to m.chipNodes.count() - 1
        chip = m.chipNodes[i]
        chosen = (m.chipIndex = i)
        chip.bg.blendColor = chosen ? GK_FOCUS_FILL : "#FFFFFF0F"
        chip.label.color = chosen ? GK_FOCUS_INK : "#FFFFFFDB"
    end for

    focused = invalid
    for r = 0 to m.keyNodes.count() - 1
        for c = 0 to m.keyNodes[r].count() - 1
            entry = m.keyNodes[r][c]
            chosen = (m.chipIndex < 0 and r = m.rowIndex and c = m.colIndex)

            fill = "#FFFFFF13"
            ink = "#FFFFFFEB"
            if entry.value = "DONE"
                fill = themeChrome.WithAlpha(accent, "33")
                ink = accentInk(accent)
            else if entry.value = "SPACE"
                fill = "#FFFFFF09"
                ink = "#FFFFFF73"
            else if entry.value.len() > 1
                fill = "#FFFFFF09"
                ink = "#FFFFFF9E"
            end if
            if chosen
                fill = GK_FOCUS_FILL
                ink = GK_FOCUS_INK
                focused = entry
            end if

            entry.bg.blendColor = fill
            if isValid(entry.label) then entry.label.color = ink
            if isValid(entry.icon) then entry.icon.blendColor = ink
            entry.node.scale = chosen ? [GK_FOCUS_SCALE, GK_FOCUS_SCALE] : [1.0, 1.0]
        end for
    end for

    paintModernAlternates(GK_FOCUS_FILL, GK_FOCUS_INK)
    m.altBg.blendColor = "#181A20F5"

    m.halo.visible = isValid(focused)
    if not isValid(focused) then return

    ' The shadow and glow follow the key out to the size it grows to
    width = focused.width * GK_FOCUS_SCALE
    height = GK_KEY_HEIGHT * GK_FOCUS_SCALE
    rect = {
        x: focused.node.translation[0] - (width - focused.width) / 2,
        y: focused.node.translation[1] - (height - GK_KEY_HEIGHT) / 2,
        width: width,
        height: height
    }
    glowAround(m.haloShadow, rect, 20, "#000000FF", 0.55)
    glowAround(m.haloGlow, rect, 0, "#FFFFFFFF", 0.16)
end sub

' The Docked look for the in-app keyboard: a full width dock on the foot of the screen that
' echoes what is typed in large type, over a mode rail, the character grid and two tall
' actions. A key can spread over several cells of keyboardLayouts.Docked, and the layout
' and the moves both read the spans from there.

const DK_CONTENT_WIDTH = 1648
const DK_PAD_Y = 44
const DK_ECHO_HEIGHT = 80
const DK_ECHO_SIZE = 60
const DK_CARET_WIDTH = 4
const DK_CARET_GAP = 4
const DK_ECHO_HINT_GAP = 48
const DK_SUGGEST_GAP = 20
const DK_SUGGEST_HEIGHT = 56
const DK_SUGGEST_SIZE = 30
const DK_SUGGEST_SPACING = 56
const DK_PILL_HEIGHT = 52
const DK_PILL_PAD_X = 20
const DK_KEYS_GAP = 32
const DK_RAIL_WIDTH = 144
const DK_COLUMN_GAP = 48
const DK_CELL_WIDTH = 104
const DK_CELL_GAP = 8
const DK_ACTION_WIDTH = 296
const DK_ACTION_COLUMN = 11
const DK_ROW_HEIGHT = 96
const DK_ROW_GAP = 12
const DK_RAIL_SIZE = 28
const DK_GLYPH_SIZE = 42
const DK_WORD_SIZE = 26
const DK_DOT_SIZE = 6
const DK_DOT_INSET = 12
const DK_CURSOR_ICON = 40
const DK_RAIL_ICON = 44
const DK_ACTION_ICON = 48
const DK_ACTION_GAP = 16
const DK_RING = 10

' The suggestions are plain words, bold where they match what is typed
sub buildDockedChips()
    m.chipBar.removeChildrenIndex(m.chipBar.getChildCount(), 0)
    m.chipNodes = []
    if not isValidAndNotEmpty(m.top.chips) then return

    for each entry in m.top.chips
        chip = m.chipBar.createChild("Group")
        pill = dockedPoster(chip, "pkg:/images/settings/pill26.9.png")
        match = chip.createChild("Label")
        match.font = "font:SmallestBoldSystemFont"
        rest = chip.createChild("Label")
        rest.font = "font:SmallestSystemFont"
        for each label in [match, rest]
            label.font.size = DK_SUGGEST_SIZE
            label.vertAlign = "center"
            label.height = DK_SUGGEST_HEIGHT
        end for
        m.chipNodes.push({ node: chip, pill: pill, match: match, rest: rest, value: entry })
    end for
end sub

' One node per key, shared by every cell the key covers, so the cell grid stays what
' the moves walk and the keys stay what is drawn
sub buildDockedKeys()
    m.grid.removeChildrenIndex(m.grid.getChildCount(), 0)
    m.keyNodes = []
    m.keyEntries = []

    for r = 0 to m.rows.count() - 1
        cells = []
        for c = 0 to m.rows[r].count() - 1
            value = m.rows[r][c]
            entry = invalid
            if c > 0
                if m.rows[r][c - 1] = value then entry = cells[c - 1]
            end if
            if not isValid(entry) and r > 0
                if m.rows[r - 1][c] = value then entry = m.keyNodes[r - 1][c]
            end if
            if not isValid(entry)
                entry = createDockedKey(value, c)
                entry.index = m.keyEntries.count()
                entry.firstRow = r
                entry.firstCol = c
                m.keyEntries.push(entry)
            end if
            entry.lastRow = r
            entry.lastCol = c
            cells.push(entry)
        end for
        m.keyNodes.push(cells)
    end for
end sub

function createDockedKey(value as string, col as integer) as object
    keyGroup = m.grid.createChild("Group")
    entry = { node: keyGroup, value: value, kind: "char", label: invalid, icon: invalid, border: invalid, dot: invalid, bold: false }
    if col = 0
        entry.kind = "rail"
    else if value = "BACKSPACE" or value = "DONE"
        entry.kind = "action"
    else if value = "SPACE"
        entry.kind = "space"
    else if value = "CURSORL" or value = "CURSORR"
        entry.kind = "cursor"
    end if

    if entry.kind = "space" then entry.border = dockedPoster(keyGroup, "pkg:/images/settings/tile23s.9.png")
    if entry.kind = "rail" or entry.kind = "space"
        entry.bg = dockedPoster(keyGroup, "pkg:/images/settings/tile23.9.png")
    else
        entry.bg = dockedPoster(keyGroup, "pkg:/images/settings/card27.9.png")
    end if
    if value = "DONE" then entry.border = dockedPoster(keyGroup, "pkg:/images/settings/card27s.9.png")

    iconUri = ""
    iconSize = DK_ACTION_ICON
    if value = "IME"
        iconUri = iconFor(value)
        iconSize = DK_RAIL_ICON
    else if entry.kind = "cursor"
        iconUri = iconFor(value)
        iconSize = DK_CURSOR_ICON
    else if value = "BACKSPACE"
        iconUri = iconFor(value)
    else if value = "DONE"
        iconUri = "pkg:/images/livetv/check.webp"
        if m.top.purpose = "search" then iconUri = "pkg:/images/itemMenu/search.webp"
    end if
    if iconUri <> ""
        entry.icon = dockedPoster(keyGroup, iconUri)
        entry.icon.width = iconSize
        entry.icon.height = iconSize
    end if

    words = ""
    size = DK_WORD_SIZE
    if entry.kind = "char"
        words = value
        size = DK_GLYPH_SIZE
    else if entry.kind = "rail" and value <> "IME"
        words = dockedRailLabel(value)
        size = DK_RAIL_SIZE
    else if entry.kind = "space"
        words = tr("space")
    else if value = "BACKSPACE"
        words = tr("Delete")
    else if value = "DONE"
        words = finishLabel()
    end if
    if words <> ""
        entry.label = keyGroup.createChild("Label")
        entry.label.font = value = "DONE" ? "font:SmallestBoldSystemFont" : "font:SmallestSystemFont"
        entry.label.font.size = size
        entry.label.text = words
        entry.label.horizAlign = "center"
        entry.label.vertAlign = "center"
        ' Measured before it is given a box, which it would answer with instead
        entry.labelHeight = entry.label.boundingRect().height
    end if

    if entry.kind = "char" and isValid(keyboardLayouts.AlternatesFor(value))
        entry.dot = dockedPoster(keyGroup, "pkg:/images/icons/circle.webp")
        entry.dot.width = DK_DOT_SIZE
        entry.dot.height = DK_DOT_SIZE
    end if

    return entry
end function

function dockedPoster(parent as object, uri as string) as object
    poster = parent.createChild("Poster")
    poster.uri = uri
    return poster
end function

function dockedRailLabel(value as string) as string
    if value = "MODE_LOWER" then return "abc"
    if value = "MODE_UPPER" then return "ABC"

    return "123"
end function

function dockedColumnLeft(col as integer) as float
    if col = 0 then return 0
    if col = DK_ACTION_COLUMN then return DK_CONTENT_WIDTH - DK_ACTION_WIDTH

    return DK_RAIL_WIDTH + DK_COLUMN_GAP + (col - 1) * (DK_CELL_WIDTH + DK_CELL_GAP)
end function

function dockedColumnRight(col as integer) as float
    if col = 0 then return DK_RAIL_WIDTH
    if col = DK_ACTION_COLUMN then return DK_CONTENT_WIDTH

    return dockedColumnLeft(col) + DK_CELL_WIDTH
end function

sub layoutDocked()
    left = (1920 - DK_CONTENT_WIDTH) / 2
    yPos = DK_PAD_Y

    m.hints.translation = [left + DK_CONTENT_WIDTH - m.hintsWidth, yPos + (DK_ECHO_HEIGHT - KB_CAP_HEIGHT) / 2]
    m.echoWidth = DK_CONTENT_WIDTH - m.hintsWidth - DK_ECHO_HINT_GAP
    m.echo.translation = [left, yPos]
    m.echo.clippingRect = [0, 0, m.echoWidth, DK_ECHO_HEIGHT]
    m.fieldWidth = m.echoWidth
    applyFieldChrome()
    m.fieldGroup.translation = [left, yPos]
    m.fieldGroup.clippingRect = [0, 0, m.echoWidth, DK_ECHO_HEIGHT]
    m.caret.width = DK_CARET_WIDTH
    m.caret.height = DK_ECHO_SIZE
    m.echoText.text = "|"
    m.barWidth = m.echoText.boundingRect().width
    yPos += DK_ECHO_HEIGHT

    if m.chipNodes.count() > 0
        m.chipBar.translation = [left, yPos + DK_SUGGEST_GAP]
        yPos += DK_SUGGEST_GAP + DK_SUGGEST_HEIGHT
    end if

    yPos += DK_KEYS_GAP
    m.grid.translation = [left, yPos]
    m.halo.translation = m.grid.translation
    for each entry in m.keyEntries
        x = dockedColumnLeft(entry.firstCol)
        y = entry.firstRow * (DK_ROW_HEIGHT + DK_ROW_GAP)
        entry.width = dockedColumnRight(entry.lastCol) - x
        entry.height = entry.lastRow * (DK_ROW_HEIGHT + DK_ROW_GAP) + DK_ROW_HEIGHT - y
        entry.node.translation = [x, y]
        for each surface in [entry.bg, entry.border]
            if isValid(surface)
                surface.width = entry.width
                surface.height = entry.height
            end if
        end for
        layoutDockedContent(entry)
    end for
    yPos += m.rows.count() * (DK_ROW_HEIGHT + DK_ROW_GAP) - DK_ROW_GAP + DK_PAD_Y

    m.dockBg.width = 1920
    m.dockBg.height = yPos
    m.dockLine.width = 1920
    m.dockLine.height = 2
    m.panel.translation = [0, 1080 - yPos]
    m.top.panelTop = m.panel.translation[1]

    m.echoReady = true
    refreshEcho()
    layoutDockedChips()
end sub

sub layoutDockedContent(entry as object)
    width = entry.width
    height = entry.height

    if entry.kind = "action"
        top = (height - (DK_ACTION_ICON + DK_ACTION_GAP + entry.labelHeight)) / 2
        entry.icon.translation = [(width - DK_ACTION_ICON) / 2, top]
        entry.label.width = width
        entry.label.height = entry.labelHeight
        entry.label.translation = [0, top + DK_ACTION_ICON + DK_ACTION_GAP]
        return
    end if

    if isValid(entry.icon) then entry.icon.translation = [(width - entry.icon.width) / 2, (height - entry.icon.height) / 2]
    if isValid(entry.label)
        entry.label.width = width
        entry.label.height = height
    end if
    if isValid(entry.dot) then entry.dot.translation = [(width - DK_DOT_SIZE) / 2, height - DK_DOT_INSET - DK_DOT_SIZE]
end sub

' What is typed, the caret and whatever trails it: the rest of the text when the caret is
' inside it, the first suggestion that carries on from it, or the field's name while empty
sub refreshEcho()
    typed = m.field.text
    at = m.field.cursorPosition
    if at > Len(typed) then at = Len(typed)
    shown = typed
    if m.top.secureMode then shown = String(Len(typed), "•")

    before = Left(shown, at)
    caretX = 0
    if before <> "" then caretX = echoWidthOf(before) + DK_CARET_GAP
    m.echoText.text = before

    trailing = ""
    m.ghost.color = "#FFFFFF47"
    if at < Len(typed)
        trailing = Mid(shown, at + 1)
        m.ghost.color = "#FFFFFFFF"
    else if typed = ""
        trailing = m.top.titleText
        if trailing = "" then trailing = m.top.hintText
    else if not m.top.secureMode
        trailing = completionFor(typed)
    end if
    m.ghost.text = trailing

    ' Text longer than the row slides left to keep the caret in sight
    offset = 0
    room = m.echoWidth - DK_CARET_WIDTH - DK_CARET_GAP
    if caretX > room then offset = room - caretX
    m.echoText.translation = [offset, 0]
    m.caret.translation = [caretX + offset, (DK_ECHO_HEIGHT - DK_ECHO_SIZE) / 2]
    m.ghost.translation = [caretX + offset + DK_CARET_WIDTH + DK_CARET_GAP, 0]
end sub

' A label leaves trailing spaces out when it measures, so a bar is added and taken off
function echoWidthOf(value as string) as float
    m.echoText.text = value + "|"
    return m.echoText.boundingRect().width - m.barWidth
end function

function completionFor(typed as string) as string
    if not isValidAndNotEmpty(m.top.chips) then return ""

    for each chip in m.top.chips
        if Len(chip) > Len(typed) and LCase(Left(chip, Len(typed))) = LCase(typed) then return Mid(chip, Len(typed) + 1)
    end for

    return ""
end function

sub layoutDockedChips()
    typed = m.field.text
    if m.top.secureMode then typed = ""

    xPos = 0
    for each chip in m.chipNodes
        matched = typed <> "" and LCase(Left(chip.value, Len(typed))) = LCase(typed)
        chip.match.text = ""
        chip.rest.text = chip.value
        if matched
            chip.match.text = Left(chip.value, Len(typed))
            chip.rest.text = Mid(chip.value, Len(typed) + 1)
        end if

        matchWidth = 0
        if chip.match.text <> "" then matchWidth = chip.match.boundingRect().width
        restWidth = 0
        if chip.rest.text <> "" then restWidth = chip.rest.boundingRect().width
        chip.rest.translation = [matchWidth, 0]
        chip.pill.width = matchWidth + restWidth + (DK_PILL_PAD_X * 2)
        chip.pill.height = DK_PILL_HEIGHT
        chip.pill.translation = [-DK_PILL_PAD_X, (DK_SUGGEST_HEIGHT - DK_PILL_HEIGHT) / 2]
        chip.node.translation = [xPos, 0]
        xPos += matchWidth + restWidth + DK_SUGGEST_SPACING
    end for
end sub

function dockedModeActive(value as string) as boolean
    if value = "MODE_NUM" then return m.numericPage
    if m.numericPage then return false
    if value = "MODE_UPPER" then return m.shifted
    if value = "MODE_LOWER" then return not m.shifted

    return false
end function

sub paintDocked()
    accent = themeChrome.Accent()
    ink = onAccentInk(accent)

    m.dockBg.color = "#0B0C10F7"
    m.dockLine.color = "#FFFFFF12"
    m.echoText.color = "#FFFFFFFF"
    m.caret.color = accent

    for i = 0 to m.chipNodes.count() - 1
        chip = m.chipNodes[i]
        chosen = (m.chipIndex = i)
        chip.pill.visible = chosen
        chip.pill.blendColor = accent
        chip.match.color = chosen ? ink : "#FFFFFFF2"
        chip.rest.color = chosen ? ink : "#FFFFFF80"
    end for

    focused = invalid
    focusedIndex = -1
    if m.chipIndex < 0 then focused = currentKey()
    if isValid(focused) then focusedIndex = focused.index
    for each entry in m.keyEntries
        paintDockedKey(entry, entry.index = focusedIndex, accent, ink)
    end for

    paintModernAlternates(accent, ink)
    m.altBg.blendColor = "#1C1E24FA"

    m.halo.visible = isValid(focused)
    if not isValid(focused) then return

    rect = { x: focused.node.translation[0], y: focused.node.translation[1], width: focused.width, height: focused.height }
    glowAround(m.haloGlow, rect, 24, accent, 0.28)
    m.haloRing.blendColor = themeChrome.WithAlpha(accent, "2E")
    m.haloRing.translation = [rect.x - DK_RING, rect.y - DK_RING]
    m.haloRing.width = rect.width + (DK_RING * 2)
    m.haloRing.height = rect.height + (DK_RING * 2)
end sub

sub paintDockedKey(entry as object, chosen as boolean, accent as string, ink as string)
    fill = accent
    color = ink
    showFill = chosen

    if entry.kind = "rail"
        active = dockedModeActive(entry.value)
        if not chosen
            fill = "#FFFFFF12"
            showFill = active
            color = "#FFFFFF73"
            if active then color = "#FFFFFFFF"
        end if
        bold = active or chosen
        if isValid(entry.label) and entry.bold <> bold
            entry.bold = bold
            entry.label.font = bold ? "font:SmallestBoldSystemFont" : "font:SmallestSystemFont"
            entry.label.font.size = DK_RAIL_SIZE
        end if
    else if entry.value = "BACKSPACE"
        showFill = true
        if not chosen
            fill = "#FFFFFF0D"
            color = "#FFFFFFC7"
        end if
    else if entry.value = "DONE"
        showFill = true
        if not chosen
            fill = themeChrome.WithAlpha(accent, "24")
            color = accentInk(accent)
        end if
        entry.border.blendColor = themeChrome.WithAlpha(accent, "61")
    else if not chosen
        color = "#FFFFFFD1"
        if entry.kind = "space" then color = "#FFFFFF73"
        if entry.kind = "cursor" then color = "#FFFFFFB3"
    end if

    entry.bg.visible = showFill
    entry.bg.blendColor = fill
    if entry.kind = "space" then entry.border.blendColor = "#FFFFFF1A"
    if isValid(entry.label) then entry.label.color = color
    if isValid(entry.icon) then entry.icon.blendColor = color
    if isValid(entry.dot) then entry.dot.blendColor = chosen ? ink : "#FFFFFF3D"
end sub

function moveDockedSelection(key as string) as boolean
    if key <> KeyCode.LEFT and key <> KeyCode.RIGHT and key <> KeyCode.UP and key <> KeyCode.DOWN then return false

    landing = keyboardLayouts.DockedStep(m.rows, m.rowIndex, m.colIndex, key)
    if isValid(landing)
        m.rowIndex = landing.row
        m.colIndex = landing.col
    else if m.chipNodes.count() > 0
        m.chipIndex = 0
    else
        ' Whether there is anywhere above to go is the screen's call, as on Classic
        m.top.escape = "up"
        return true
    end if

    paint()
    return true
end function

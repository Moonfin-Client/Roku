<?xml version="1.0" encoding="utf-8"?>
<component name="TVKeyboard" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.7" />

        <!-- Sat against the foot of the screen, the way the other clients open it -->
        <Group id="panel">
            <Poster id="panelBg" uri="pkg:/images/details/surface17.9.png" />
            <Poster id="panelBorder" uri="pkg:/images/details/cardborder.9.png" opacity="0.4" />

            <Label id="title" font="font:MediumBoldSystemFont" />
            <Group id="fieldGroup">
                <Poster id="fieldBg" uri="pkg:/images/details/surface12.9.png" />
                <!-- Voice is switched on only while this keyboard is showing, so a hidden
                     one never competes to be the target the remote dictates into -->
                <VoiceTextEditBox id="field" voiceEnabled="false" active="true" />
            </Group>

            <!-- Both built at runtime, since what they hold changes with the layout -->
            <Group id="chipBar" />
            <Group id="grid" />
        </Group>

        <!-- Opens over the focused key when it has accents behind it -->
        <Group id="altPopup" visible="false">
            <Poster id="altBg" uri="pkg:/images/details/surface12.9.png" />
            <Group id="altOptions" />
        </Group>

        <Timer id="repeatTimer" repeat="true" duration="0.12" />
        <Timer id="focusTimer" repeat="false" duration="0.15" />
        <Timer id="restoreTimer" repeat="false" duration="0.3" />
    </children>

    <interface>
        <field id="titleText" type="string" />
        <field id="hintText" type="string" />
        <field id="secureMode" type="boolean" value="false" />
        <field id="showScrim" type="boolean" value="true" />
        <field id="chips" type="array" />
        <field id="text" type="string" alwaysNotify="true" />
        <field id="submitted" type="boolean" alwaysNotify="true" />
        <field id="cancelled" type="boolean" alwaysNotify="true" />
        <!-- Which way the viewer tried to leave, for a screen that has something
             of its own above the keyboard -->
        <field id="escape" type="string" alwaysNotify="true" />
        <!-- Where the panel starts, so a screen can lift its field clear of it -->
        <field id="panelTop" type="float" />
        <field id="returnFocus" type="node" />
    </interface>
</component>

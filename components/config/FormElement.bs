import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' The row is clipped to its own size, so the pill has to sit inside it
const FORM_PILL_WIDTH = 1048
const FORM_PILL_HEIGHT = 75
const FORM_PILL_IDLE = "0x2a2e40FF"

sub init()
    m.pill = m.top.findNode("pill")
    m.pill.width = FORM_PILL_WIDTH
    m.pill.height = FORM_PILL_HEIGHT
    m.pill.blendColor = FORM_PILL_IDLE

    m.value = m.top.findNode("value")
    m.value.backgroundUri = "pkg:/images/transparent.png"
    m.value.width = 1000

    m.value.textColor = ColorPalette.DARKGREY
    m.value.hintTextColor = ColorPalette.LIGHTGREY

    m.value.hintText = tr("Username")
    m.value.maxTextLength = 120

    m.value.observeField("text", "onTextChanged")
end sub

sub onTextChanged()
    ' Change text color to white if there's text, otherwise grey for placeholder
    if m.value.text <> "" and m.value.text <> invalid
        m.value.textColor = ColorPalette.WHITE
    else
        m.value.textColor = ColorPalette.DARKGREY
    end if
end sub

sub itemContentChanged()
    data = m.top.itemContent

    if isStringEqual(data.type, "password")
        m.value.hintText = tr("Password")
        m.value.secureMode = true
    end if

    m.value.text = data.value

    ' Update color based on whether text is present
    if data.value <> "" and data.value <> invalid
        m.value.textColor = ColorPalette.WHITE
    else
        m.value.textColor = ColorPalette.DARKGREY
    end if
end sub

sub onFocusChanged()
    m.pill.blendColor = m.top.itemHasFocus ? themeChrome.Token("inputBorderFocused", "0x00A4DCFF") : FORM_PILL_IDLE
end sub

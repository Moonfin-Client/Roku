<?xml version="1.0" encoding="utf-8"?>
<!-- The server list: saved servers, the ones found on the network and Add Server -->
<component name="SetServerScreen" extends="JFScreen">
  <children>
    <Poster id="background" uri="pkg:/images/bg_login_gradient.webp" width="1920" height="1080" />
    <!-- Holds the remote for the list, since the screen can't take it back from a dialog it owns -->
    <Group id="listFocus" focusable="true" />
    <Group id="page">
      <Poster id="logo" uri="pkg:/images/logo.webp" width="592" height="134" translation="[664, 0]" />
      <Label id="statusLine" width="1169" translation="[376, 0]" horizAlign="center" wrap="true" font="font:SmallSystemFont" color="#EF4444" />
      <Group id="card" translation="[376, 0]">
        <Poster id="cardFill" uri="pkg:/images/login/fill33.9.png" width="1169" blendColor="#111528CC" />
        <Poster id="cardBorder" uri="pkg:/images/login/stroke33w1.9.png" width="1169" blendColor="#FFFFFF33" />
        <Group id="rows" />
        <AddServerTile id="addServerTile" translation="[54, 0]" />
      </Group>
      <Label id="versionLabel" width="1169" height="33" translation="[376, 0]" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF66" />
    </Group>
    <AddServerDialog id="addServerDialog" visible="false" />
    <LoginAlertDialog id="removeDialog" visible="false" />
  </children>
  <interface>
    <!-- url, and whether it came from Add Server, which shows the server it found before going on -->
    <field id="connectRequest" type="assocarray" alwaysNotify="true" />
    <field id="embyConnectRequested" type="boolean" alwaysNotify="true" />
    <!-- The Plex sign in, with the address and machine id of a Plex server found on the network, or
         neither for a plex.tv account -->
    <field id="plexSignInRequested" type="assocarray" alwaysNotify="true" />
    <field id="continueSelected" type="boolean" alwaysNotify="true" />
    <field id="forgetServer" type="string" alwaysNotify="true" />
    <!-- Answers from the sign in flow -->
    <field id="errorMessage" type="string" alwaysNotify="true" onChange="onErrorMessageChanged" />
    <field id="foundServer" type="assocarray" onChange="onFoundServerChanged" />
    <!-- Brings the screen back after Emby Connect or the Plex sign in closes without signing in -->
    <field id="restoreFocus" type="boolean" alwaysNotify="true" onChange="onRestoreFocus" />
  </interface>
</component>

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/serverCompatibility.bs"

const SERVER_CARD_WIDTH = 1169
const SERVER_CARD_PAD = 54
const SERVER_CONTENT_WIDTH = 1060
const SERVER_TILE_HEIGHT = 112
const SERVER_TILE_GAP = 7
const SERVER_SECTION_HEIGHT = 33
const SERVER_SECTION_GAP = 33
const SERVER_ADD_HEIGHT = 106
const SERVER_LOGO_HEIGHT = 134
' How long OK is held on a saved server before it offers to remove it
const SERVER_HOLD_SECONDS = 0.5

sub init()
    m.top.optionsAvailable = false
    m.top.overhangVisible = false
    m.page = m.top.findNode("page")
    m.logo = m.top.findNode("logo")
    m.statusLine = m.top.findNode("statusLine")
    m.card = m.top.findNode("card")
    m.cardFill = m.top.findNode("cardFill")
    m.cardBorder = m.top.findNode("cardBorder")
    m.rows = m.top.findNode("rows")
    m.addServerTile = m.top.findNode("addServerTile")
    m.versionLabel = m.top.findNode("versionLabel")
    m.dialog = m.top.findNode("addServerDialog")
    m.removeDialog = m.top.findNode("removeDialog")
    m.listFocus = m.top.findNode("listFocus")

    m.statusLine.font.size = 22
    m.versionLabel.font.size = 20
    m.versionLabel.text = "Moonfin version " + LCase(m.global.app.version)

    m.dialog.observeField("connectAddress", "onDialogConnect")
    m.dialog.observeField("embyConnectChosen", "onDialogEmbyConnect")
    m.dialog.observeField("continueChosen", "onDialogContinue")
    m.dialog.observeField("closed", "closeDialog")
    m.removeDialog.observeField("answer", "onRemoveAnswered")

    m.holdTimer = CreateObject("roSGNode", "Timer")
    m.holdTimer.duration = SERVER_HOLD_SECONDS
    m.holdTimer.observeField("fire", "onHoldFired")

    m.holding = false
    m.saved = savedServers()
    m.discovered = []
    m.discovering = true
    m.focusIndex = -1
    buildRows()
    focusItem(m.items.count() - 1)

    m.discovery = CreateObject("roSGNode", "ServerDiscoveryTask")
    m.discovery.observeField("content", "onDiscoveryDone")
    m.discovery.control = TaskControl.RUN
end sub

function savedServers() as object
    saved = []
    text = get_setting("saved_servers")
    if not isValidAndNotEmpty(text) then return saved
    data = ParseJson(text)
    if not isValid(data) or type(data.serverList) <> "roArray" then return saved
    for each server in data.serverList
        if isValidAndNotEmpty(server.baseUrl) then saved.push(server)
    end for
    return saved
end function

' Every server found that isn't already saved, which the list shows once
sub onDiscoveryDone(event as object)
    found = event.getData()
    m.discovered = []
    if type(found) = "roArray"
        for each server in found
            if isValidAndNotEmpty(server.baseUrl) and not isSaved(server.baseUrl) then m.discovered.push(server)
        end for
    end if
    m.discovering = false

    focusedUrl = ""
    if m.focusIndex >= 0 and m.focusIndex < m.items.count() and m.items[m.focusIndex].isSubtype("LoginServerTile") then focusedUrl = m.items[m.focusIndex].baseUrl
    buildRows()
    index = m.items.count() - 1
    for i = 0 to m.items.count() - 2
        if m.items[i].baseUrl = focusedUrl then index = i
    end for
    focusItem(index)
end sub

function isSaved(url as string) as boolean
    for each server in m.saved
        if LCase(server.baseUrl) = LCase(url) then return true
    end for
    return false
end function

' The card's rows, from the top: saved servers, discovered servers, then Add Server
sub buildRows()
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    m.items = []
    y = SERVER_CARD_PAD

    if m.saved.count() > 0
        y = addSection(tr("Saved Servers"), y)
        for each server in m.saved
            y = addTile(server.name ?? server.baseUrl, server.baseUrl, true, y)
        end for
        y += SERVER_SECTION_GAP - SERVER_TILE_GAP
    end if

    y = addSection(tr("Discovered Servers"), y)
    if m.discovering
        spinner = m.rows.createChild("Spinner")
        spinner.poster.width = 40
        spinner.poster.height = 40
        spinner.translation = [SERVER_CARD_PAD + (SERVER_CONTENT_WIDTH - 40) / 2, y + 27]
        y += 94
    else if m.discovered.count() = 0
        none = m.rows.createChild("Label")
        none.font.size = 23
        none.color = "#FFFFFF66"
        none.text = tr("None found")
        none.height = 73
        none.vertAlign = "center"
        none.translation = [SERVER_CARD_PAD, y]
        y += 73
    else
        for each server in m.discovered
            y = addTile(server.name ?? server.baseUrl, server.baseUrl, false, y)
        end for
        y -= SERVER_TILE_GAP
    end if

    y += 27
    m.addServerTile.translation = [SERVER_CARD_PAD, y]
    m.items.push(m.addServerTile)
    cardHeight = y + SERVER_ADD_HEIGHT + SERVER_CARD_PAD
    m.cardFill.height = cardHeight
    m.cardBorder.height = cardHeight
    m.cardHeight = cardHeight
    layoutPage()
end sub

function addSection(title as string, y as float) as float
    label = m.rows.createChild("Label")
    label.font = "font:SmallBoldSystemFont"
    label.font.size = 23
    label.color = "#FFFFFF"
    label.text = title
    label.height = SERVER_SECTION_HEIGHT
    label.vertAlign = "center"
    label.translation = [SERVER_CARD_PAD, y]
    return y + SERVER_SECTION_HEIGHT + 13
end function

function addTile(name as string, url as string, saved as boolean, y as float) as float
    tile = m.rows.createChild("LoginServerTile")
    tile.title = name
    tile.detailText = url
    tile.serverType = "jellyfin"
    if registry_read(serverIdentityKey(url), "ServerTypes") = "emby" then tile.serverType = "emby"
    tile.baseUrl = url
    tile.isSaved = saved
    tile.translation = [SERVER_CARD_PAD, y]
    m.items.push(tile)
    return y + SERVER_TILE_HEIGHT + SERVER_TILE_GAP
end function

' The logo, an error line, the card and the version, together a fifth of the way down whatever
' room is left
sub layoutPage()
    statusHeight = 0
    if m.statusLine.text <> "" then statusHeight = m.statusLine.boundingRect().height + 27
    m.statusLine.visible = statusHeight > 0

    height = 27 + SERVER_LOGO_HEIGHT + 46 + statusHeight + m.cardHeight + 60 + 27
    top = loginStyle.ColumnTop(height)
    m.logo.translation = [664, top + 27]
    y = top + 27 + SERVER_LOGO_HEIGHT + 46
    m.statusLine.translation = [376, y]
    y += statusHeight
    m.card.translation = [376, y]
    m.versionLabel.translation = [376, y + m.cardHeight + 27]
    m.pageHeight = height
    keepFocusInView()
end sub

sub focusItem(index as integer)
    if index < 0 or index >= m.items.count() then return
    m.focusIndex = index
    for i = 0 to m.items.count() - 1
        m.items[i].highlighted = i = index
    end for
    m.listFocus.setFocus(true)
    keepFocusInView()
end sub

' A list taller than the screen moves so the focused row stays on it
sub keepFocusInView()
    if not isValid(m.pageHeight) or m.pageHeight <= 1080 or m.focusIndex < 0
        m.page.translation = [0, 0]
        return
    end if
    item = m.items[m.focusIndex]
    top = m.card.translation[1] + item.translation[1]
    bottom = top + SERVER_TILE_HEIGHT
    shift = -m.page.translation[1]
    if bottom - shift > 1040 then shift = bottom - 1040
    if top - shift < 40 then shift = top - 40
    if shift < 0 then shift = 0
    m.page.translation = [0, -shift]
end sub

sub onErrorMessageChanged()
    message = m.top.errorMessage
    if m.dialog.visible
        m.dialog.connecting = false
        m.dialog.noticeText = message
        return
    end if
    m.statusLine.text = message
    layoutPage()
end sub

sub onFoundServerChanged()
    if m.dialog.visible then m.dialog.foundServer = m.top.foundServer
end sub

sub openDialog()
    m.statusLine.text = ""
    layoutPage()
    m.dialog.visible = true
    m.dialog.callFunc("open")
end sub

sub closeDialog()
    m.dialog.visible = false
    focusItem(m.items.count() - 1)
end sub

sub onDialogConnect()
    m.top.connectRequest = { url: m.dialog.connectAddress, fromDialog: true }
end sub

sub onDialogEmbyConnect()
    m.dialog.visible = false
    m.top.embyConnectRequested = true
end sub

sub onDialogContinue()
    m.top.continueSelected = true
end sub

sub onRestoreFocus()
    focusItem(m.items.count() - 1)
end sub

sub openTile(tile as object)
    m.statusLine.text = ""
    layoutPage()
    m.top.connectRequest = { url: tile.baseUrl, fromDialog: false }
end sub

sub onHoldFired()
    if not m.holding then return
    m.holdFired = true
    tile = m.items[m.focusIndex]
    m.removeDialog.title = tr("Remove Server")
    m.removeDialog.message = substitute(tr("Remove ""{0}"" from your servers?"), tile.title)
    m.removeDialog.confirmLabel = tr("Remove")
    m.removeDialog.callFunc("show")
end sub

sub onRemoveAnswered()
    m.removeDialog.visible = false
    if m.removeDialog.answer
        url = m.items[m.focusIndex].baseUrl
        m.top.forgetServer = url
        kept = []
        for each server in m.saved
            if LCase(server.baseUrl) <> LCase(url) then kept.push(server)
        end for
        m.saved = kept
        buildRows()
    end if
    focusItem(m.items.count() - 1)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    focused = invalid
    if m.focusIndex >= 0 and m.focusIndex < m.items.count() then focused = m.items[m.focusIndex]

    ' A press on a saved server only opens it once OK comes back up before the hold runs out
    if key = KeyCode.OK and not press
        if m.holding and not m.holdFired
            m.holdTimer.control = "stop"
            openTile(focused)
        end if
        m.holding = false
        return true
    end if
    if not press then return false

    if key = KeyCode.UP
        focusItem(m.focusIndex - 1)
        return true
    else if key = KeyCode.DOWN
        focusItem(m.focusIndex + 1)
        return true
    else if key = KeyCode.LEFT or key = KeyCode.RIGHT
        return true
    else if key = KeyCode.OK
        if not isValid(focused) then return true
        if focused.isSubtype("AddServerTile")
            openDialog()
        else if focused.isSaved
            m.holding = true
            m.holdFired = false
            m.holdTimer.control = "start"
        else
            openTile(focused)
        end if
        return true
    end if

    return false
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in to a server with Quick Connect or a password. Emby Connect uses the same screen. -->
<component name="SigninScene" extends="JFScreen">
  <children>
    <Poster id="background" uri="pkg:/images/bg_login_gradient.webp" width="1920" height="1080" />
    <Group id="signInGroup">
      <Poster id="logo" uri="pkg:/images/logo.webp" width="474" height="107" translation="[723, 0]" />
      <Group id="card">
        <Poster id="cardFill" uri="pkg:/images/login/fill33.9.png" blendColor="#111528CC" />
        <Poster id="cardBorder" uri="pkg:/images/login/stroke33w1.9.png" blendColor="#FFFFFF33" />
        <Group id="column" translation="[54, 0]">
          <Label id="signInTitle" height="33" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFF" />
          <Label id="connectingTo" height="33" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
          <LoginButton id="quickConnect" style="selected" height="72" radius="36" padding="32" />
          <LoginButton id="passwordTab" height="72" radius="36" padding="32" />

          <Group id="quickConnectGroup">
            <Label id="qcInstruction" height="33" horizAlign="center" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFFB3" />
            <Group id="codeDigits" />
            <Spinner id="codeSpinner" />
            <Spinner id="qcSpinner" />
            <Label id="quickConnectStatus" height="33" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
          </Group>

          <LoginTextField id="usernameField" />
          <LoginTextField id="passwordField" secure="true" />
          <Label id="errorLine" horizAlign="center" wrap="true" font="font:SmallSystemFont" color="#EF4444" />
          <LoginButton id="back" height="79" radius="39" padding="38" />
          <LoginButton id="submit" height="79" radius="39" padding="38" />
        </Group>

        <!-- Beside the code, where a phone signed in to the server can approve it -->
        <Group id="qrGroup" visible="false">
          <Poster uri="pkg:/images/login/fill20.9.png" width="367" height="367" blendColor="#FFFFFF" />
          <QRCode id="quickConnectQr" width="300" height="300" translation="[34, 34]" border="0" pixel="7" />
          <Label id="quickConnectQrCaption" translation="[0, 380]" width="367" wrap="true" horizAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
        </Group>
      </Group>
    </Group>

    <Timer id="quickConnectTimer" duration="3" repeat="true" />
  </children>
  <interface>
    <field id="user" type="string" onchange="onUserChange" value="" />
    <field id="alert" type="string" onchange="onAlertChange" value="" />
    <!-- What was typed, read by the sign in flow when Sign In is chosen -->
    <field id="username" type="string" />
    <field id="password" type="string" onChange="onPasswordSet" />
    <field id="submitSelected" type="boolean" alwaysNotify="true" />
    <field id="quickConnectJson" type="assocarray" />
    <field id="quickConnectAuthenticated" type="boolean" alwaysNotify="true" />
  </interface>
</component>

import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/diagnostics.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"

sub init()
    m.top.functionName = "loadGenreItems"
end sub

sub loadGenreItems()
    ' Get all server sessions if multi-server is enabled
    allSessions = []

    if m.top.enableMultiServer and isMultiServerEnabled()
        allSessions = getAllServerSessions()
    end if

    ' If no sessions found or multi-server disabled, fall back to current server only
    if allSessions.Count() = 0
        currentSession = getCurrentServerSession()
        if isValid(currentSession)
            allSessions.push(currentSession)
        end if
    end if

    if allSessions.Count() = 0
        m.top.error = "No server sessions available"
        return
    end if

    groupCollections = m.top.groupCollections ?? false
    port = CreateObject("roMessagePort")
    activeGenreRequests = {}
    requestObjects = {}
    genreMap = {}

    ' Stage 1: Load genre lists from each server via /Genres
    for each userSession in allSessions
        genresList = fetchServerGenres(userSession)
        if isValid(genresList) and genresList.Count() > 0
            for each genre in genresList
                genreName = genre.Name
                genreId = genre.Id
                if not isValidAndNotEmpty(genreName) then continue for

                genreLower = LCase(genreName)
                movieCount = genre.MovieCount ?? 0
                seriesCount = genre.SeriesCount ?? 0
                childCount = genre.ChildCount ?? 0

                initialCount = movieCount + seriesCount
                if initialCount = 0 then initialCount = childCount
                if initialCount <= 0 then continue for

                customBackdropUrl = getCustomGenreArtworkUrl(genre, userSession)

                ' Pre-initialize in genreMap with server baseline count
                if not genreMap.DoesExist(genreLower)
                    genreMap[genreLower] = {
                        displayName: genreName,
                        id: genreId,
                        itemCount: initialCount,
                        candidateBackdrops: isValidAndNotEmpty(customBackdropUrl) ? [customBackdropUrl] : []
                    }
                else
                    genreMap[genreLower].itemCount += initialCount
                    ' A genre from more than one server has no single id, so the browse
                    ' matches on the name instead
                    genreMap[genreLower].id = ""
                    if isValidAndNotEmpty(customBackdropUrl)
                        genreMap[genreLower].candidateBackdrops.push(customBackdropUrl)
                    end if
                end if

                ' Stage 2: Queue random representative items query to get grouped counts and backdrop art
                req = startGenreItemsRequest(userSession, genre, port, groupCollections)
                if isValid(req)
                    activeGenreRequests[req.id] = {
                        userSession: userSession,
                        genreLower: genreLower,
                        genreName: genreName,
                        genreId: genreId,
                        initialCount: initialCount
                    }
                    requestObjects[req.id] = req.request
                end if
            end for
        end if
    end for

    ' Wait for Stage 2 responses (15 second timeout)
    startTime = CreateObject("roDateTime").AsSeconds()

    while activeGenreRequests.Count() > 0
        msg = wait(1000, port)

        currentTime = CreateObject("roDateTime").AsSeconds()
        if currentTime - startTime > 15
            diagnostics.Network("Genre items requests timed out waiting for the server", diagnostics.LEVEL_WARN)
            exit while
        end if

        if msg = invalid then continue while

        if type(msg) = "roUrlEvent"
            requestId = msg.GetSourceIdentity().ToStr()
            reqInfo = activeGenreRequests[requestId]

            if isValid(reqInfo)
                activeGenreRequests.Delete(requestId)
                requestObjects.Delete(requestId)

                responseCode = msg.GetResponseCode()
                if responseCode = 200
                    responseBody = msg.GetString()
                    data = ParseJson(responseBody)

                    if isValid(data)
                        processGenreItemsResponse(data, reqInfo, genreMap)
                    end if
                end if
            end if
        end if
    end while

    emptyKeys = []
    for each key in genreMap.Keys()
        if genreMap[key].itemCount <= 0 then emptyKeys.push(key)
    end for
    for each key in emptyKeys
        genreMap.Delete(key)
    end for

    m.top.genreResults = genreMap
end sub

' Fetch all genres with counts from a server via /Genres
function fetchServerGenres(userSession as object) as object
    params = {
        userId: userSession.userId,
        includeItemTypes: "Movie,Series",
        recursive: true,
        sortBy: "SortName",
        sortOrder: "Ascending",
        fields: "ItemCounts,PrimaryImageTag,ImageTags,BackdropImageTags,PrimaryImageAspectRatio",
        enableTotalRecordCount: true
    }

    url = buildURLForSession(userSession, "/Genres", params)
    authHeader = buildAuthHeaderForSession(userSession)

    request = CreateObject("roUrlTransfer")
    request.SetUrl(url)
    request.AddHeader("Authorization", authHeader)
    request.AddHeader("Content-Type", "application/json")
    request.SetCertificatesFile("common:/certs/ca-bundle.crt")
    request.InitClientCertificates()
    request.EnableEncodings(true)

    responseBody = request.GetToString()
    if isValidAndNotEmpty(responseBody)
        data = ParseJson(responseBody)
        if isValid(data) and isChainValid(data, "Items")
            return data.Items
        end if
    end if

    return []
end function

' Extract custom genre backdrop or thumb URL if present on the server
function getCustomGenreArtworkUrl(genre as object, userSession as object) as string
    if not isValid(genre) or not isValid(genre.Id) then return ""

    params = {
        maxWidth: 1280,
        quality: 80
    }

    if isValid(genre.BackdropImageTags) and genre.BackdropImageTags.Count() > 0
        params.Tag = genre.BackdropImageTags[0]
        return buildImageURLForServer(userSession.serverUrl, genre.Id, "Backdrop", params)
    end if

    if isValid(genre.ImageTags) and isValid(genre.ImageTags.Thumb)
        params.Tag = genre.ImageTags.Thumb
        return buildImageURLForServer(userSession.serverUrl, genre.Id, "Thumb", params)
    end if

    return ""
end function

' Start an async request to load representative items and accurate grouped count for a genre
function startGenreItemsRequest(userSession as object, genre as object, port as object, groupCollections as boolean) as object
    params = {
        userid: userSession.userId,
        GenreIds: genre.Id,
        IncludeItemTypes: groupCollections ? "Movie,Series,BoxSet" : "Movie,Series",
        ExcludeItemTypes: groupCollections ? "Playlist,Episode,Season,Folder" : "BoxSet,Playlist,Episode,Season,Folder",
        CollapseBoxSetItems: groupCollections,
        Limit: 4,
        Recursive: true,
        SortBy: "Random",
        SortOrder: "Ascending",
        Fields: "BackdropImageTags,ParentBackdropItemId,ParentBackdropImageTags,ImageTags",
        EnableImageTypes: "Backdrop",
        ImageTypeLimit: 1,
        EnableTotalRecordCount: true
    }

    url = buildURLForSession(userSession, "/Users/" + userSession.userId + "/Items", params)
    authHeader = buildAuthHeaderForSession(userSession)

    request = CreateObject("roUrlTransfer")
    request.SetUrl(url)
    request.AddHeader("Authorization", authHeader)
    request.AddHeader("Content-Type", "application/json")
    request.SetCertificatesFile("common:/certs/ca-bundle.crt")
    request.InitClientCertificates()
    request.SetMessagePort(port)
    request.EnableEncodings(true)

    if request.AsyncGetToString()
        return {
            id: request.GetIdentity().ToStr(),
            request: request
        }
    end if

    return invalid
end function

' Process response from genre items request
sub processGenreItemsResponse(data as object, reqInfo as object, genreMap as object)
    if not isValid(data) then return

    genreLower = reqInfo.genreLower
    if not genreMap.DoesExist(genreLower) then return

    ' Swap this server's baseline for its exact count and leave the other servers alone
    if isValid(data.TotalRecordCount)
        genreMap[genreLower].itemCount += data.TotalRecordCount - reqInfo.initialCount
    end if

    if not isValid(data.Items) then return

    ' Gather backdrop images from representative items
    for each item in data.Items
        backdropUrl = buildBackdropUrlForServer(item, reqInfo.userSession)
        if isValidAndNotEmpty(backdropUrl)
            isDup = false
            for each existing in genreMap[genreLower].candidateBackdrops
                if existing = backdropUrl
                    isDup = true
                    exit for
                end if
            end for
            if not isDup
                genreMap[genreLower].candidateBackdrops.push(backdropUrl)
            end if
        end if
    end for
end sub

function buildBackdropUrlForServer(item as object, userSession as object) as string
    if not isValid(item) or not isValid(item.Id) then return ""

    params = {
        maxWidth: 1280,
        quality: 80
    }

    ' Try item's own backdrop first
    if isValid(item.BackdropImageTags) and item.BackdropImageTags.Count() > 0
        params.Tag = item.BackdropImageTags[0]
        return buildImageURLForServer(userSession.serverUrl, item.Id, "Backdrop", params)
    end if

    ' Fall back to parent backdrop
    if isValid(item.ParentBackdropItemId) and isValid(item.ParentBackdropImageTags) and item.ParentBackdropImageTags.Count() > 0
        params.Tag = item.ParentBackdropImageTags[0]
        return buildImageURLForServer(userSession.serverUrl, item.ParentBackdropItemId, "Backdrop", params)
    end if

    ' Fall back to thumb if available
    if isValid(item.ImageTags) and isValid(item.ImageTags.Thumb)
        params.Tag = item.ImageTags.Thumb
        return buildImageURLForServer(userSession.serverUrl, item.Id, "Thumb", params)
    end if

    return ""
end function

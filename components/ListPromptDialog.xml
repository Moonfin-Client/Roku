<?xml version="1.0" encoding="utf-8"?>
<!-- A titled list of choices in the same panel as the track pickers: notices,
     confirmations and option pickers throughout the app -->
<component name="ListPromptDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <!-- The panel is placed and sized around however many rows there are -->
    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <Group id="details" />
      <MarkupList
        id="rowMenu"
        itemComponentName="TrackListItem"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <field id="dialogTitle" type="string" value="" />
    <!-- Shown as its own row above the answers, left out when there is nothing to say -->
    <field id="message" type="string" value="" />
    <field id="options" type="array" />
    <!-- Optional second line per option, matched by position and left blank where there is none -->
    <field id="optionDetails" type="array" />
    <!-- Marks whichever option is already in force, left at -1 when none is -->
    <field id="selectedOption" type="integer" value="-1" />
    <!-- Opens with the cursor on that option rather than the first, for a list too long to start at the top -->
    <field id="openOnSelected" type="boolean" value="false" />
    <!-- Opens with the cursor on this option without marking it, left at -1 for the first -->
    <field id="focusOption" type="integer" value="-1" />
    <!-- Lines between the title and the options: [{ text, note }], a note drawn fainter -->
    <field id="details" type="array" />
    <!-- Draws a divider above this option, left at -1 for none -->
    <field id="dividerBefore" type="integer" value="-1" />

    <!-- Where focus goes when the dialog closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />

    <field id="optionSelected" type="integer" value="-1" alwaysNotify="true" />

    <function name="showDialog" />
  </interface>
</component>

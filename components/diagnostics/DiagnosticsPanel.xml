<?xml version="1.0" encoding="utf-8"?>
<!-- The log readout, in the same panel the track pickers use. The list is named checklist
     because showPickerPanel hands focus to a node of that name. Sending the report is not
     done here, since the settings screen owns the render thread this runs on and an upload
     belongs on a task. -->
<component name="DiagnosticsPanel" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
      <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
      <MarkupList
        id="checklist"
        itemComponentName="LibraryPanelRow"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="floatingFocus" />
    </Group>
  </children>

  <interface>
    <!-- What the settings screen writes back after an upload, shown at the top of the list -->
    <field id="status" type="string" value="" alwaysNotify="true" />

    <field id="sendRequested" type="boolean" value="false" alwaysNotify="true" />
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />

    <function name="showDialog" />
  </interface>
</component>

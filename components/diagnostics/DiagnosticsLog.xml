<?xml version="1.0" encoding="utf-8"?>
<!-- The log store. State lives inside the node rather than on a global field because a
     global field hands back a copy on read, so two threads appending would each grow their
     own copy and the loser would vanish. callFunc runs in the thread that owns the node, so
     every append here is serialised against one real array. -->
<component name="DiagnosticsLog" extends="Group">
  <interface>
    <!-- Read by callers before they build an entry, so a thread thats not logging pays
         one field read and never reaches callFunc at all -->
    <field id="on" type="boolean" value="false" />

    <function name="append" />
    <function name="getEntries" />
    <function name="clear" />
    <function name="setEnabled" />
    <function name="takeCrashTail" />
  </interface>
</component>

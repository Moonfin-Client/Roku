import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

const BANNER_INSET = 36
const BANNER_MAX_CONTENT = 560
const BANNER_PAD_X = 24
const BANNER_PAD_Y = 18
const BANNER_EDGE = 4
const BANNER_ICON = 40
const BANNER_ICON_GAP = 18
const BANNER_BODY_GAP = 6
' It drops this far into place as it fades in
const BANNER_SLIDE = 12

sub init()
    m.fill = m.top.findNode("fill")
    m.edge = m.top.findNode("edge")
    m.edgeFill = m.top.findNode("edgeFill")
    m.outline = m.top.findNode("outline")
    m.outlineStroke = m.top.findNode("outlineStroke")
    m.icon = m.top.findNode("icon")
    m.title = m.top.findNode("title")
    m.body = m.top.findNode("body")
    m.enter = m.top.findNode("enter")
    m.enterSlide = m.top.findNode("enterSlide")
    m.dismissTimer = m.top.findNode("dismissTimer")
    m.dismissTimer.observeField("fire", "showNext")

    m.title.font.size = 26
    m.body.font.size = 22

    m.queue = []
    m.top.visible = false
end sub

sub enqueue(notices as object)
    m.queue.append(notices)
    if not m.top.visible then showNext()
end sub

sub showNext()
    if m.queue.count() = 0
        m.top.visible = false
        return
    end if

    show(m.queue.shift())
end sub

sub show(notice as object)
    ' The banner outlives a sign in, so it takes on whichever theme is in force each time
    fontApply.ApplyThemeFonts(m.top, true)
    themeChrome.ApplyThemeChrome(m.top, true)

    hasIcon = isValidAndNotEmpty(notice.icon)
    hasBody = isValidAndNotEmpty(notice.body)
    textLeft = BANNER_EDGE + BANNER_PAD_X
    maxText = BANNER_MAX_CONTENT
    if hasIcon
        textLeft += BANNER_ICON + BANNER_ICON_GAP
        maxText -= BANNER_ICON + BANNER_ICON_GAP
    end if

    ' The panel is only as wide as its longest line, up to the most it can take
    m.title.width = 0
    m.title.text = notice.title
    titleSize = m.title.boundingRect()
    textWidth = titleSize.width

    m.body.visible = hasBody
    if hasBody
        m.body.wrap = false
        m.body.width = 0
        m.body.text = notice.body
        bodyWidth = m.body.boundingRect().width
        if bodyWidth > textWidth then textWidth = bodyWidth
    end if
    if textWidth > maxText then textWidth = maxText

    m.title.width = textWidth
    textHeight = titleSize.height
    if hasBody
        m.body.wrap = true
        m.body.width = textWidth
        textHeight += BANNER_BODY_GAP + m.body.boundingRect().height
    end if

    innerHeight = textHeight
    if hasIcon and BANNER_ICON > innerHeight then innerHeight = BANNER_ICON
    width = textLeft + textWidth + BANNER_PAD_X + 1
    height = innerHeight + (BANNER_PAD_Y + 1) * 2

    surface = "#252525FF"
    if themeChrome.IsActive() then surface = formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorDialogBackground", ""), surface)
    accent = themeChrome.Accent()

    for each layer in [m.fill, m.edgeFill, m.outlineStroke]
        layer.width = width
        layer.height = height
    end for
    m.fill.blendColor = surface
    m.edgeFill.blendColor = accent
    m.edge.clippingRect = [0, 0, BANNER_EDGE, height]
    m.outline.clippingRect = [BANNER_EDGE, 0, width - BANNER_EDGE, height]

    m.icon.visible = hasIcon
    if hasIcon
        m.icon.uri = notice.icon
        m.icon.blendColor = accent
        m.icon.translation = [BANNER_EDGE + BANNER_PAD_X, (height - BANNER_ICON) / 2]
    end if

    top = (height - textHeight) / 2
    m.title.translation = [textLeft, top]
    m.body.translation = [textLeft, top + titleSize.height + BANNER_BODY_GAP]

    left = 1920 - BANNER_INSET - width
    m.enterSlide.keyValue = [[left, BANNER_INSET - BANNER_SLIDE], [left, BANNER_INSET]]

    ' Lifted over whatever has opened since it was last shown, a dialog included
    parent = m.top.getParent()
    if isValid(parent)
        parent.removeChild(m.top)
        parent.appendChild(m.top)
    end if

    m.top.visible = true
    m.enter.control = "start"
    m.dismissTimer.control = "start"
end sub

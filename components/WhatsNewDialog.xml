<?xml version="1.0" encoding="utf-8"?>
<component name="WhatsNewDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000004D" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/whatsnew/fill24.9.png" width="1400" blendColor="#0A0A0A" />
      <Poster id="panelBorder" uri="pkg:/images/whatsnew/stroke24w3.9.png" width="1400" blendColor="#FFFFFF26" />
      <Label id="title" horizAlign="center" color="#00A4DC" />
      <Label id="version" horizAlign="center" color="#FFFFFF" />
      <Group id="viewport">
        <Group id="notes">
          <Poster id="notesFill" uri="pkg:/images/whatsnew/fill16.9.png" blendColor="#FFFFFF0F" />
          <Group id="blocks" />
        </Group>
      </Group>
      <Rectangle id="scrollTrack" width="6" color="#FFFFFF26" visible="false" />
      <Rectangle id="scrollThumb" width="6" color="#FFFFFF99" visible="false" />
      <Group id="okButton">
        <Poster id="okFill" uri="pkg:/images/playback/surface26.9.png" blendColor="#E6E6E6" />
        <Label id="okLabel" horizAlign="center" vertAlign="center" color="#4C5059" />
      </Group>
    </Group>
  </children>
  <interface>
    <field id="whatsNewClosed" type="boolean" alwaysNotify="true" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A MaskGroup sized in layout pixels. A plain one's maskSize and maskOffset are in screen pixels,
  which Roku doesn't scale with the 1920-wide layout, so on a 720p screen its mask stands larger
  than what it covers. -->
<component name="ScreenMask" extends="MaskGroup">
  <interface>
    <field id="size" type="vector2d" onChange="onSizeChanged" />
    <field id="offset" type="vector2d" onChange="onOffsetChanged" />
  </interface>
</component>

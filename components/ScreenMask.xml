<?xml version="1.0" encoding="utf-8"?>
<!-- A MaskGroup sized in layout pixels. Use it for every mask: a plain MaskGroup's size is in screen
  pixels, which Roku doesn't scale with the 1920-wide layout, so on a 720p screen it stands larger
  than what it covers. A scaled parent group does scale the mask, so a card that grows on focus
  needs nothing more. -->
<component name="ScreenMask" extends="MaskGroup">
  <interface>
    <!-- Set these instead of maskSize and maskOffset -->
    <field id="size" type="vector2d" onChange="onSizeChanged" />
    <field id="offset" type="vector2d" onChange="onOffsetChanged" />
  </interface>
</component>

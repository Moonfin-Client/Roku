import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"
import "pkg:/source/utils/settingsSync.bs"

' Applies the active profile here without sending anything back
sub loadProfile()
    m.top.result = { ok: settingsSync.PullFromServer() }
end sub

' Writes every setting this device syncs to the profile
sub saveProfile()
    ok = false
    if settingsSync.IsSyncEnabled()
        ok = settingsSync.SaveProfile(settingsSync.ActiveProfile(), settingsSync.FullProfile())
    end if

    m.top.result = { ok: ok }
end sub

' Clears the profile on the server, puts this device back to its defaults, then applies whatever
' the profile resolves to now, which is the admin defaults and any profile still under it
sub resetProfile()
    ok = false
    if settingsSync.IsSyncEnabled()
        ok = settingsSync.DeleteProfile(settingsSync.ActiveProfile())
    end if

    if ok
        settingsSync.RestoreLocalDefaults()
        settingsSync.PullFromServer()
    end if

    m.top.result = { ok: ok }
end sub

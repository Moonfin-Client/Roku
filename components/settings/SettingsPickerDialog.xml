<?xml version="1.0" encoding="utf-8"?>
<!-- A choice from a list, drawn over the settings panel. One pick saves and closes, or a list of
     checks saves once Save is chosen. -->
<component name="SettingsPickerDialog" extends="Group">
  <interface>
    <field id="title" type="string" />
    <field id="options" type="array" />
    <field id="selectedIndex" type="integer" value="0" />
    <field id="multi" type="boolean" value="false" />
    <field id="checked" type="array" />
    <field id="style" type="node" />
    <field id="chosen" type="integer" value="-1" alwaysNotify="true" />
    <field id="saved" type="boolean" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
  <children>
    <Rectangle id="barrier" translation="[1219, 0]" width="701" height="1080" color="0x0000008A" />
    <Group id="dialog">
      <Poster id="dialogFill" />
      <Label id="dialogTitle" vertAlign="center" wrap="true" maxLines="2" />
      <Group id="listGroup">
        <SettingsScroller id="optionList" bottomPadding="0" />
      </Group>
    </Group>
    <Animation id="fadeIn" duration="0.15" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="barrier.opacity" />
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="dialog.opacity" />
    </Animation>
  </children>
</component>

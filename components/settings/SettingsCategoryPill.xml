<?xml version="1.0" encoding="utf-8"?>
<!-- The settings categories as one pill of segments across the top. Left and right move between
     them, and the screen hears each move through selectedIndex. -->
<component name="SettingsCategoryPill" extends="Group">
  <interface>
    <field id="labels" type="array" onChange="layout" />
    <field id="selectedIndex" type="integer" value="0" alwaysNotify="true" onChange="paint" />
    <!-- Where the pill centers itself: x, y, width and height -->
    <field id="area" type="array" onChange="layout" />
    <field id="focusRing" type="boolean" value="false" onChange="paint" />
    <field id="accent" type="string" value="0x00A4DCFF" onChange="paint" />
  </interface>
  <children>
    <Poster id="track" uri="pkg:/images/livetv/fill28.9.png" blendColor="0xFFFFFFFF" opacity="0.08" />
    <Group id="segments" />
  </children>
</component>

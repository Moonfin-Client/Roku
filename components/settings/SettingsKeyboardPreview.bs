import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"

const TYPED_QUERY = "Spri"
const KEY_GAP = 12

' Search with its keyboard open, drawn the way the chosen keyboard style sits on screen
sub init()
    redraw()
end sub

' Native stands in for the Roku's own keyboard
function keyboardLook(styleName as string) as object
    looks = {
        native: { left: 0, right: 0, bottom: 0, padX: 160, padY: 40, fill: "0xE8EAEDFF", radius: 0, keyWidth: 112, keyHeight: 84, keyFill: "0xFFFFFFFF", keyInk: "0x202124FF", focusFill: "0x1A73E8FF", focusInk: "0xFFFFFFFF" },
        classic: { left: 96, top: 184, padX: 20, padY: 20, fill: "0x141414D9", radius: 24, keyWidth: 76, keyHeight: 76, keyFill: "0x2A2A2AFF", keyInk: "0xFFFFFFFF", focusFill: "0xFFFFFFFF", focusInk: "0x000000FF", grid: true },
        glass: { left: 240, right: 240, bottom: 48, padX: 28, padY: 28, fill: "0xFFFFFF1F", radius: 40, keyWidth: 104, keyHeight: 92, keyFill: "0xFFFFFF29", keyInk: "0xFFFFFFFF", focusFill: "0xFFFFFFFF", focusInk: "0x000000FF" },
        docked: { left: 0, right: 0, bottom: 0, padX: 120, padY: 28, fill: "0x121212F7", radius: 0, keyWidth: 124, keyHeight: 88, keyFill: "0x2A2A2AFF", keyInk: "0xFFFFFFFF", focusFill: "0xFFFFFFFF", focusInk: "0x000000FF", typed: true }
    }
    return looks[styleName] ?? looks.docked
end function

sub redraw()
    m.top.removeChildrenIndex(m.top.getChildCount(), 0)

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    look = keyboardLook(LCase(m.top.keyboardStyle))
    grid = look.grid = true
    typed = look.typed = true
    keyRows = ["qwertyuiop", "asdfghjkl", "zxcvbnm"]
    if grid then keyRows = ["abcdef", "ghijkl", "mnopqr", "stuvwx", "yz1234", "567890"]

    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)

    if not typed
        fieldX = 540
        fieldWidth = 840
        if grid
            fieldX = 96
            fieldWidth = 560
        end if
        setupPreviewDraw.Round(m.top, fieldX, 56, fieldWidth, 88, 44, playbackOverlay.WithAlpha(pal.onSurface, 26))
        setupPreviewDraw.Icon(m.top, "pkg:/images/icons/search-light.webp", fieldX + 32, 78, 44, playbackOverlay.WithAlpha(pal.onSurface, 179))
        query = setupPreviewDraw.TextLabel(m.top, TYPED_QUERY, fieldX + 92, 56, 34, pal.onSurface, false)
        query.height = 88
        query.vertAlign = "center"
        setupPreviewDraw.Rect(m.top, fieldX + 92 + query.boundingRect().width + 4, 80, 4, 40, pal.accent)
    end if

    resultsX = 96
    resultsY = 184
    if grid then resultsX = 720
    if typed then resultsY = 56
    for i = 0 to 3
        cardX = resultsX + i * 212
        setupPreviewDraw.RoundArt(m.top, cardX, resultsY, 184, 276, setupPreviewDraw.ItemField(items, i, "posterUrl"), pal.surfaceVariant, 8, pal.background)
        name = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "title"), cardX, resultsY + 288, 24, pal.onSurface, true)
        name.width = 184
    end for

    drawKeyboard(look, keyRows, typed)
end sub

sub drawKeyboard(look as object, keyRows as object, typed as boolean)
    widest = 0
    for each keyRow in keyRows
        if Len(keyRow) > widest then widest = Len(keyRow)
    end for
    rowsHeight = keyRows.Count() * (look.keyHeight + KEY_GAP) - KEY_GAP
    typedHeight = 0
    if typed then typedHeight = 72

    if isValid(look.top)
        boxWidth = widest * (look.keyWidth + KEY_GAP) - KEY_GAP + look.padX * 2
        boxX = look.left
        boxY = look.top
    else
        boxWidth = 1920 - look.left - look.right
        boxX = look.left
        boxY = 1080 - look.bottom - (rowsHeight + typedHeight + look.padY * 2)
    end if
    boxHeight = rowsHeight + typedHeight + look.padY * 2

    if look.radius > 0
        setupPreviewDraw.Round(m.top, boxX, boxY, boxWidth, boxHeight, look.radius, look.fill)
    else
        setupPreviewDraw.Rect(m.top, boxX, boxY, boxWidth, boxHeight, look.fill)
    end if

    rowY = boxY + look.padY
    if typed
        entry = setupPreviewDraw.TextLabel(m.top, TYPED_QUERY + "|", boxX + look.padX, rowY, 46, "0xFFFFFFFF", false)
        entry.height = 56
        entry.vertAlign = "center"
        rowY = rowY + typedHeight
    end if

    for each keyRow in keyRows
        rowWidth = Len(keyRow) * (look.keyWidth + KEY_GAP) - KEY_GAP
        keyX = boxX + (boxWidth - rowWidth) / 2
        for i = 1 to Len(keyRow)
            letter = Mid(keyRow, i, 1)
            fill = look.keyFill
            ink = look.keyInk
            ' The next letter of the search has focus
            if letter = "n"
                fill = look.focusFill
                ink = look.focusInk
            end if
            setupPreviewDraw.Round(m.top, keyX, rowY, look.keyWidth, look.keyHeight, 12, fill)
            label = setupPreviewDraw.TextLabel(m.top, UCase(letter), keyX, rowY, 34, ink, false)
            label.width = look.keyWidth
            label.height = look.keyHeight
            label.horizAlign = "center"
            label.vertAlign = "center"
            keyX = keyX + look.keyWidth + KEY_GAP
        end for
        rowY = rowY + look.keyHeight + KEY_GAP
    end for
end sub

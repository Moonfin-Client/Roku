import "pkg:/components/settings/settingsNodes.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/settingsMetrics.bs"

' Neon Pulse lights its title with a soft cyan halo. Roku text can't blur, so a few faint copies
' set around the title stand in for it.
const NEON_GLOW = "0x00E5FF4D"

sub init()
    m.background = m.top.findNode("background")
    m.scrolledTint = m.top.findNode("scrolledTint")
    m.titleLabel = m.top.findNode("titleLabel")
    m.actionDisc = m.top.findNode("actionDisc")
    m.actionGlyph = m.top.findNode("actionGlyph")
    m.glowCopies = []
end sub

sub onStyleChanged()
    style = m.top.style
    if not isValid(style) then return
    m.palette = style.palette
    m.titleLabel.font = m.palette.fonts.appTitle
    m.actionGlyph.font = m.palette.fonts.iconCheck
    layout()
end sub

sub layout()
    if not isValid(m.palette) then return
    height = settingsMetrics.TITLE_BAR_HEIGHT
    width = settingsMetrics.PANEL_WIDTH

    titleX = settingsMetrics.Px(72)
    if m.top.isRoot then titleX = settingsMetrics.Px(16)
    titleWidth = width - titleX - settingsMetrics.Px(16)

    hasAction = m.top.action <> ""
    actionSize = settingsMetrics.Px(48)
    if hasAction
        actionX = width - settingsMetrics.Px(4) - actionSize
        actionY = (height - actionSize) / 2
        placeNode(m.actionDisc, actionX, actionY, actionSize, actionSize)
        placeNode(m.actionGlyph, actionX, actionY, actionSize, actionSize)
        m.actionGlyph.text = settingsGlyphs.Char(m.top.action)
        titleWidth = actionX - titleX
    end if
    m.actionGlyph.visible = hasAction

    placeNode(m.titleLabel, titleX, 0, titleWidth, height)
    m.titleLabel.text = m.top.title
    layoutGlow(titleX, titleWidth, height)
    paint()
end sub

sub layoutGlow(titleX as float, titleWidth as float, height as float)
    glow = m.palette.neon and not m.palette.clean and not m.palette.lowTier
    if glow and m.glowCopies.Count() = 0
        for each offset in [[-2, 0], [2, 0], [0, -2], [0, 2]]
            copy = CreateObject("roSGNode", "Label")
            copy.vertAlign = "center"
            copy.color = NEON_GLOW
            ' Under the title, above the bar's own fill
            m.top.insertChild(copy, 2)
            m.glowCopies.push({ label: copy, offset: offset })
        end for
    end if
    for each copy in m.glowCopies
        copy.label.visible = glow
        if glow
            copy.label.font = m.palette.fonts.appTitle
            placeNode(copy.label, titleX + copy.offset[0], copy.offset[1], titleWidth, height)
            copy.label.text = m.top.title
        end if
    end for
end sub

sub paint()
    if not isValid(m.palette) then return
    m.background.color = m.palette.background
    m.scrolledTint.color = m.palette.scrolledTint
    m.scrolledTint.visible = m.top.isRoot and m.top.scrolled

    ' Neon Pulse's title takes the accent outside the clean screens
    m.titleLabel.color = m.palette.title
    if m.palette.neon and not m.palette.clean then m.titleLabel.color = m.palette.header

    m.actionGlyph.color = m.palette.text
    m.actionDisc.visible = m.top.action <> "" and m.top.actionFocused
end sub

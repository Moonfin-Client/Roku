<?xml version="1.0" encoding="utf-8"?>
<!-- The picker panel, built the way the track selectors are so the two match. Its actions
     live at the foot of the list rather than in a button area of their own. -->
<component name="MediaBarChecklistDialog" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

        <Group id="panel">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
            <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
            <Label id="hint" font="font:SmallSystemFont" color="#FFFFFFB3" />
            <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
            <RowChecklist
                id="checklist"
                itemComponentName="TrackListItem"
                drawFocusFeedback="false"
                vertFocusAnimationStyle="floatingFocus" />
        </Group>
    </children>

    <interface>
        <field id="title" type="string" alias="title.text" />
        <field id="allowReorder" type="boolean" value="false" />
        <field id="buttons" type="array" />
        <field id="buttonSelected" type="integer" value="-1" alwaysNotify="true" />
    </interface>
</component>

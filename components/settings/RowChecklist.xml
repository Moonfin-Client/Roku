<?xml version="1.0" encoding="utf-8"?>
<!-- The picker list. It is a MarkupList so the rows can be drawn by TrackListItem, and it
     carries the checked state alongside the content the way the stock CheckList does. -->
<component name="RowChecklist" extends="MarkupList">
    <interface>
        <field id="checkedState" type="array" />
    </interface>
</component>

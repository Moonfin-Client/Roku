import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/detailMetadataLayout.bs"
import "pkg:/source/utils/homeRowGroups.bs"
import "pkg:/source/utils/homeRowLayout.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/ratingSourceList.bs"
import "pkg:/source/utils/seerrSliders.bs"
import "pkg:/source/utils/settingsIcons.bs"

' The home rows, the action and player buttons, the metadata row and the rating sources are each
' a screen of the settings list. The screen works on a copy, left and right move the focused row
' and OK switches it, and the arrangement is written once when the screen closes, and only when
' it changed.

sub openEditor(kind as string, settingItem as object)
    title = settingItem.title
    if kind = "ratingSources"
        title = "Ratings"
        ' Home rows and the media bar each keep a list of their own
        m.ratingSourcesSetting = settingItem.settingName
    end if
    if kind = "rows"
        loadRowsEditor()
        return
    end if
    m.keepAsCompleteOffered = false
    if kind = "detailButtons" and moonfinPlugin.CanKeepAsComplete()
        checkKeepAsCompleteLiveTv(title)
        return
    end if
    showEditor(kind, title, {}, [])
end sub

' Keep as Complete only belongs in the row on a server with Live TV, so the editor waits behind the
' spinner while the libraries are read
sub checkKeepAsCompleteLiveTv(title as string)
    startLoadingSpinner()
    m.keepAsCompleteEditorTitle = title
    m.keepAsCompleteLiveTvTask = createObject("roSGNode", "LoadItemsTask")
    m.keepAsCompleteLiveTvTask.observeField("content", "onKeepAsCompleteLiveTvChecked")
    m.keepAsCompleteLiveTvTask.control = "RUN"
end sub

sub onKeepAsCompleteLiveTvChecked(event as object)
    event.getRoSGNode().unobserveField("content")
    m.keepAsCompleteLiveTvTask = invalid
    for each library in event.getData() ?? []
        if isStringEqual(chainLookupReturn(library, "json.collectiontype", ""), "livetv") then m.keepAsCompleteOffered = true
    end for

    stopLoadingSpinner()
    showEditor("detailButtons", m.keepAsCompleteEditorTitle, {}, [])
    m.settingsMenu.setFocus(true)
end sub

sub showEditor(kind as string, title as string, leftOut as object, fetched as object)
    ' General is the one disabled group that starts open, since it's short
    m.editor = { kind: kind, rows: editorRowsFor(kind, invalid), resetKey: "", openGroups: { general: true }, leftOut: leftOut, fetched: fetched, found: [] }
    addFoundRows()
    m.editor.openedKey = editorKey(m.editor.rows)
    LoadMenu({ title: title, editor: kind, clean: true, titleAction: "restore", children: [] })
end sub

' What an editor offers, in its stored order, or in the order it goes back to after a reset
function editorRowsFor(kind as string, resetTo as dynamic) as object
    rows = []
    if kind = "rows"
        homeRowLayout.MigrateLegacySlots()
        homeRowLayout.MigrateSinceYouWatched()
        stored = get_user_setting(homeRowLayout.ORDER_SETTING)
        off = buttonLayout.HiddenLookup(get_user_setting(homeRowLayout.HIDDEN_SETTING))
        if isValid(resetTo)
            stored = FormatJson(resetTo)
            off = {}
        end if
        placed = buttonLayout.ToIds(stored)
        picked = homeRowLayout.DynamicLookup()
        for each row in buttonLayout.Ordered(homeRowLayout.Offered(), stored)
            ' A reset keeps no picks, so they come back as items to turn on
            if not isValid(resetTo) or not (isValid(homeRowLayout.SourceFromId(row.id)) or homeRowLayout.IsSliderRow(row.id))
                rows.push({ id: row.id, label: tr(row.label), subtitle: pickedRowSource(row.id), enabled: homeRowLayout.IsEnabled(row.id, placed, off, picked) })
            end if
        end for
        return rows
    end if

    if kind = "ratingSources"
        enabled = ratingSourceList.Normalize(get_user_setting(m.ratingSourcesSetting))
        if enabled.Count() = 0 or isValid(resetTo) then enabled = ratingSourceList.Defaults()
        return editorRowsFrom(enabled)
    end if

    target = editorTarget(kind)
    storedOrder = get_user_setting(target.orderKey)
    off = buttonLayout.HiddenLookup(get_user_setting(target.hiddenKey))
    if isValid(resetTo)
        storedOrder = "[]"
        off = {}
    end if
    for each entry in buttonLayout.Ordered(target.catalogue, storedOrder)
        rows.push({ id: entry.id, label: tr(entry.label), subtitle: tr(entry.subtitle ?? ""), enabled: not isValid(off[entry.id]) })
    end for
    return rows
end function

' A collection from another signed in server names that server
function pickedRowSource(rowId as string) as string
    if homeRowLayout.IsSliderRow(rowId) then return tr("Seerr Discovery Rows")
    fromId = homeRowLayout.SourceFromId(rowId)
    if not isValid(fromId) then return ""
    if fromId.source = "genres" then return tr("Genres row")
    if fromId.source = "playlists" then return tr("Playlists row")
    serverName = m.serverNames[serverNameKey(fromId.server)]
    if isValid(serverName) then return substitute(tr("Collections row from {0}"), serverName)
    return tr("Collections row")
end function

function serverNameKey(serverUrl as string) as string
    return LCase(settingsSync.WithoutTrailingSlash(serverUrl))
end function

function editorTarget(kind as string) as object
    if kind = "osdButtons" then return { catalogue: buttonLayout.OsdButtons(), orderKey: OSD_ORDER_SETTING, hiddenKey: OSD_HIDDEN_SETTING }
    if kind = "metadata" then return { catalogue: detailMetadataLayout.DetailMetadata(), orderKey: DETAIL_METADATA_ORDER_SETTING, hiddenKey: DETAIL_METADATA_HIDDEN_SETTING }
    return { catalogue: detailButtonsCatalogue(), orderKey: DETAIL_ORDER_SETTING, hiddenKey: DETAIL_HIDDEN_SETTING }
end function

' Keep as Complete is only offered when the server has Live TV, its plugin tracks incomplete
' recordings and the account can manage them. A save still keeps its place, since ids outside the
' catalogue are carried through.
function detailButtonsCatalogue() as object
    catalogue = buttonLayout.DetailButtons()
    if m.keepAsCompleteOffered = true then return catalogue

    offered = []
    for each entry in catalogue
        if entry.id <> "keepAsComplete" then offered.push(entry)
    end for
    return offered
end function

function editorKey(rows as object) as string
    parts = []
    for each row in rows
        parts.push(`${row.id}:${row.enabled}`)
    end for
    return parts.Join(",")
end function

function editorEnabledIds(rows as object) as object
    ids = []
    for each row in rows
        if row.enabled then ids.push(row.id)
    end for
    return ids
end function

' The rows of the open editor, with the lines that explain it over the first one
function editorSpecs() as object
    kind = m.editor.kind
    specs = []
    hints = {
        detailButtons: "Play is always first. Everything else is up to you.",
        osdButtons: "Playback controls are always shown. Everything below is up to you.",
        metadata: "Turn metadata items on or off, and arrange the order they appear on the details screen."
    }
    if isValid(hints[kind]) then specs.push({ band: "note", text: tr(hints[kind]), caption: tr("Press left or right to move the highlighted button.") })
    if kind = "ratingSources" then specs.push({ band: "plain", glyph: "reorder", text: tr("Rating Sources"), caption: tr("Enable and reorder the rating sources shown throughout the app") })

    m.editor.view = editorView()
    shownEnabled = 0
    for each entry in m.editor.view
        if isValid(entry.row) and m.editor.rows[entry.row].enabled then shownEnabled = shownEnabled + 1
    end for
    m.editor.shownEnabled = shownEnabled
    for i = 0 to m.editor.view.Count() - 1
        entry = m.editor.view[i]
        if kind = "rows"
            if i = 0 then specs.push({ band: "header", text: tr("Enabled") })
            if i = shownEnabled then specs.push({ band: "header", text: tr("Disabled") })
        end if
        specs.push(editorRowSpec(i))
    end for
    return specs
end function

' What the list shows, each entry a row of the editor by its index or a group header. Only the
' home rows are grouped, so every other editor lists its rows as they are.
function editorView() as object
    rows = m.editor.rows
    if m.editor.kind = "rows" then return homeRowGroups.View(rows, m.editor.openGroups, m.editor.leftOut)
    entries = []
    for i = 0 to rows.Count() - 1
        entries.push({ row: i })
    end for
    return entries
end function

function editorGroupLabel(kind as string) as string
    labels = { general: "General", collections: "Collections", favorites: "Favorites", genres: "Genres and Studios", playlists: "Playlists", seerr: "Seerr", external: "External Lists" }
    return tr(labels[kind])
end function

function editorRowSpec(item as integer) as object
    kind = m.editor.kind
    entry = m.editor.view[item]
    if isValid(entry.group)
        glyph = "chevron_right"
        if m.editor.openGroups[entry.group] = true then glyph = "keyboard_arrow_down"
        return { id: editorEntryId(entry), kind: "picker", title: editorGroupLabel(entry.group), glyph: glyph, chip: entry.total.ToStr() }
    end if
    index = entry.row
    rows = m.editor.rows
    row = rows[index]
    spec = { id: row.id, title: row.label, subtitle: row.subtitle ?? "", canMovePrev: index > 0, canMoveNext: index < rows.Count() - 1 }
    checkbox = "check_box_outline_blank"
    if row.enabled then checkbox = "check_box"

    if kind = "rows"
        ' The enabled rows lead the list, and only they have an order to change
        spec.kind = "reorder"
        spec.glyph = checkbox
        spec.canMovePrev = row.enabled and item > 0
        spec.canMoveNext = row.enabled and item < m.editor.shownEnabled - 1
    else if kind = "ratingSources"
        ' Only the turned-on sources have an order to change
        spec.kind = "plain"
        spec.glyph = checkbox
        spec.boolValue = row.enabled
        spec.canMovePrev = row.enabled and index > 0
        spec.canMoveNext = row.enabled and index < editorEnabledIds(rows).Count() - 1
    else
        spec.kind = "button"
        spec.glyphStrong = true
        spec.boolValue = row.enabled
        if kind = "osdButtons"
            spec.glyph = settingsIcons.OsdButtonGlyph(row.id)
        else if kind = "metadata"
            spec.glyph = settingsIcons.MetadataGlyph(row.id)
        else
            spec.glyph = settingsIcons.DetailButtonGlyph(row.id)
        end if
    end if
    return spec
end function

' Left and right move the focused row a place, and focus goes with it
function editorMove(delta as integer) as boolean
    if not isValid(m.editor) then return false
    item = m.settingsMenu.itemFocused
    view = m.editor.view
    if item < 0 or item >= view.Count() or not isValid(view[item].row) then return true
    index = view[item].row
    rows = m.editor.rows

    last = view.Count() - 1
    if m.editor.kind = "ratingSources" or m.editor.kind = "rows"
        if not rows[index].enabled then return true
        last = m.editor.shownEnabled - 1
    end if
    target = item + delta
    if target < 0 or target > last then return true

    other = view[target].row
    moving = rows[index]
    rows[index] = rows[other]
    rows[other] = moving
    m.editor.rows = rows
    refreshEditorRows([item, target])
    m.settingsMenu.jumpToItem = target
    return true
end function

' OK switches the focused row on or off. A rating source switched on joins the end of the ones
' already on, so the list is laid out again around it.
sub editorToggle()
    item = m.settingsMenu.itemFocused
    view = m.editor.view
    if item < 0 or item >= view.Count() then return
    rows = m.editor.rows

    if isValid(view[item].group)
        kind = view[item].group
        m.editor.openGroups[kind] = not (m.editor.openGroups[kind] = true)
        showSection(m.userLocation.peek())
        m.settingsMenu.jumpToItem = item
        return
    end if

    if m.editor.kind = "rows"
        toggleHomeRow(item)
        return
    end if
    index = view[item].row

    if m.editor.kind = "ratingSources"
        id = rows[index].id
        m.editor.rows = editorRowsFrom(ratingSourceList.Toggle(editorEnabledIds(rows), id))
        showSection(m.userLocation.peek())
        for i = 0 to m.editor.rows.Count() - 1
            if m.editor.rows[i].id = id then m.settingsMenu.jumpToItem = i
        end for
        return
    end if

    rows[index].enabled = not rows[index].enabled
    m.editor.rows = rows
    refreshEditorRows([item])
end sub

' A row switched on joins the end of the enabled rows, and one switched off goes back among the
' disabled ones. Focus moves to the row that takes its place in the part of the list it left.
sub toggleHomeRow(item as integer)
    view = m.editor.view
    rows = m.editor.rows
    index = view[item].row
    row = rows[index]
    kind = homeRowGroups.Group(row.id)

    leaving = []
    for each entry in view
        if isValid(entry.row)
            other = rows[entry.row]
            if other.enabled = row.enabled and (row.enabled or homeRowGroups.Group(other.id) = kind) then leaving.push(other.id)
        end if
    end for
    focusId = row.id
    if not row.enabled then focusId = "group:" + kind
    for i = 0 to leaving.Count() - 1
        if leaving[i] = row.id
            if i + 1 < leaving.Count()
                focusId = leaving[i + 1]
            else if i > 0
                focusId = leaving[i - 1]
            end if
        end if
    end for

    if row.enabled
        row.enabled = false
    else
        row.enabled = true
        rest = []
        at = 0
        for i = 0 to rows.Count() - 1
            if i <> index
                rest.push(rows[i])
                if rows[i].enabled then at = rest.Count()
            end if
        end for
        rows = []
        for i = 0 to rest.Count() - 1
            if i = at then rows.push(row)
            rows.push(rest[i])
        end for
        if at = rest.Count() then rows.push(row)
    end if
    m.editor.rows = rows

    showSection(m.userLocation.peek())
    focusEditorEntry(focusId)
end sub

function editorEntryId(entry as object) as string
    if isValid(entry.group) then return "group:" + entry.group
    return m.editor.rows[entry.row].id
end function

sub focusEditorEntry(entryId as string)
    for i = 0 to m.editor.view.Count() - 1
        if editorEntryId(m.editor.view[i]) = entryId then m.settingsMenu.jumpToItem = i
    end for
end sub

' The editor waits behind the spinner until it has what it offers. That's every collection, genre
' and playlist whose rows are switched on, other signed in servers' collections while multi-server
' libraries is on, and whether there's Live TV.
sub loadRowsEditor()
    startLoadingSpinner()
    m.rowsLoad = { waiting: 0, leftOut: {}, fetched: [], tasks: [] }
    others = []
    if isMultiServerEnabled() then others = getLoggedInServerUsersExcludingCurrent()
    m.serverNames = {}
    for each userSession in others
        m.serverNames[serverNameKey(userSession.serverUrl)] = userSession.serverName
    end for

    checkLiveTv()
    fetchSliders()
    for each listEntry in homeRowLayout.Sources()
        if homeRowLayout.RowToggleOn(listEntry.key)
            fetchList(listEntry.key, invalid)
            if listEntry.key = "collections"
                for each userSession in others
                    fetchList(listEntry.key, userSession)
                end for
            end if
        end if
    end for
end sub

' Kept until they finish so the tasks aren't collected mid flight
sub runRowsLoadTask(task as object)
    m.rowsLoad.tasks.push(task)
    m.rowsLoad.waiting = m.rowsLoad.waiting + 1
    task.control = "RUN"
end sub

sub rowsLoadDone()
    m.rowsLoad.waiting = m.rowsLoad.waiting - 1
    if m.rowsLoad.waiting > 0 then return
    loaded = m.rowsLoad
    m.rowsLoad = invalid
    stopLoadingSpinner()
    refreshPicks(loaded.fetched)
    showEditor("rows", "Rows", loaded.leftOut, loaded.fetched)
    m.settingsMenu.setFocus(true)
end sub

' Live TV and On Now only fill on a server with Live TV, so both rows are left out when none of the
' viewer's libraries is Live TV. An empty answer could be a failed request, so it leaves them in.
sub checkLiveTv()
    task = createObject("roSGNode", "LoadItemsTask")
    task.observeField("content", "onLiveTvChecked")
    runRowsLoadTask(task)
end sub

sub onLiveTvChecked(event as object)
    libraries = event.getData()
    event.getRoSGNode().unobserveField("content")
    if isValidAndNotEmpty(libraries)
        hasLiveTv = false
        for each library in libraries
            if isStringEqual(chainLookupReturn(library, "json.collectiontype", ""), "livetv") then hasLiveTv = true
        end for
        if not hasLiveTv
            m.rowsLoad.leftOut.livetv = true
            m.rowsLoad.leftOut.onnow = true
        end if
    end if
    rowsLoadDone()
end sub

' Slider rows follow Seerr: renamed to their current titles, dropped once Seerr no longer has them
' and left out while Seerr has them switched off. Without Seerr they're left out, and a failed read
' leaves them as they are.
sub fetchSliders()
    if not GetSeerrConfig().enabled
        for each entry in homeRowLayout.DynamicRows()
            if homeRowLayout.IsSliderRow(entry.id) then m.rowsLoad.leftOut[entry.id] = true
        end for
        return
    end if
    task = CreateObject("roSGNode", "SeerrAPITask")
    task.request = { method: "GET", endpoint: seerrSliders.LIST_PATH, queryParams: {} }
    task.observeField("response", "onSlidersFetched")
    runRowsLoadTask(task)
end sub

sub onSlidersFetched(event as object)
    event.getRoSGNode().unobserveField("response")
    response = event.getData()
    if isValid(response) and response.success = true and type(response.data) = "roArray"
        sliders = seerrSliders.ParseList(response.data)
        reconciled = seerrSliders.Reconciled(homeRowLayout.DynamicRows(), sliders)
        if reconciled.changed
            homeRowLayout.SaveDynamic(reconciled.picks)
            if reconciled.gone.Count() > 0 then homeRowLayout.ForgetPicks(reconciled.gone)
        end if
        for each pick in reconciled.picks
            if homeRowLayout.IsSliderRow(pick.id)
                fromId = seerrSliders.FromRowId(pick.id)
                live = seerrSliders.Find(sliders, fromId.sliderId, fromId.sliderType)
                if not isValid(live) or not live.enabled then m.rowsLoad.leftOut[pick.id] = true
            end if
        end for
    end if
    rowsLoadDone()
end sub

sub fetchList(key as string, userSession as dynamic)
    task = createObject("roSGNode", "LoadItemsTask")
    task.itemsToLoad = "pickable"
    task.itemId = key
    if isValid(userSession)
        task.serverUrl = userSession.serverUrl
        task.serverUserId = userSession.userId
        task.serverAuthToken = userSession.authToken
    end if
    task.observeField("content", "onListFetched")
    runRowsLoadTask(task)
end sub

sub onListFetched(event as object)
    task = event.getRoSGNode()
    items = event.getData()
    task.unobserveField("content")
    serverKey = task.serverUrl
    if serverKey = "" then serverKey = homeRowLayout.ServerId()
    if isValid(items)
        for each item in items
            itemId = homeRowLayout.AsText(item.id)
            if itemId <> "" then m.rowsLoad.fetched.push({ id: homeRowLayout.DynamicId(task.itemId, serverKey, itemId), source: task.itemId, itemId: itemId, title: homeRowLayout.AsText(item.title) })
        end for
    end if
    rowsLoadDone()
end sub

' Picks the server no longer has are dropped and renamed ones take the new name, kept on the
' device until the next save sends them
sub refreshPicks(fetched as object)
    refreshed = homeRowGroups.Refreshed(homeRowLayout.DynamicRows(), fetched)
    if not refreshed.changed then return
    homeRowLayout.SaveDynamic(refreshed.picks)
    if refreshed.gone.Count() > 0 then homeRowLayout.ForgetPicks(refreshed.gone)
end sub

sub addFoundRows()
    m.editor.found = homeRowGroups.Unlisted(m.editor.rows, m.editor.fetched)
    for each record in m.editor.found
        m.editor.rows.push({ id: record.id, label: record.title, subtitle: pickedRowSource(record.id), enabled: false })
    end for
end sub

function editorRowsFrom(enabled as object) as object
    rows = []
    for each source in ratingSourceList.Rows(enabled)
        source.label = tr(source.label)
        rows.push(source)
    end for
    return rows
end function

' Every row goes back to where it starts, and nothing is written until the screen closes
sub editorReset()
    kind = m.editor.kind
    resetTo = []
    if kind = "rows" then resetTo = homeRowLayout.DefaultEnabled()
    m.editor.rows = editorRowsFor(kind, resetTo)
    addFoundRows()
    m.editor.resetKey = editorKey(m.editor.rows)
    showSection(m.userLocation.peek())
end sub

' Rows that changed lay themselves out again, and the rows under them move if one grew
sub refreshEditorRows(indexes as object)
    heights = m.settingsMenu.rowHeights
    grew = false
    for each index in indexes
        rowNode = m.settingsMenu.content.getChild(index)
        height = layoutRow(rowNode, editorRowSpec(index), m.rowBands[index], m.sectionStyle, settingsMetrics.PANEL_WIDTH)
        if Abs(heights[index] - height) > 0.5
            heights[index] = height
            grew = true
        end if
    end for
    if grew
        m.settingsMenu.rowHeights = heights
        return
    end if
    for each index in indexes
        m.settingsMenu.callFunc("refreshItem", index)
    end for
end sub

sub commitOpenEditor()
    editor = m.editor
    m.editor = invalid
    if not isValid(editor) then return
    key = editorKey(editor.rows)
    if key = editor.openedKey then return
    resetForm = key = editor.resetKey

    if editor.kind = "rows"
        if editor.resetKey <> ""
            ids = []
            for each entry in homeRowLayout.DynamicRows()
                ids.push(entry.id)
            end for
            homeRowLayout.ForgetPicks(ids)
        end if
        ' A reset writes the starting rows and an empty off list, so every row past those falls
        ' back to being off on its own on every client
        if resetForm
            saveHomeRowLayout(homeRowLayout.DefaultEnabled(), [])
        else
            toSave = homeRowGroups.ToSave(editor.rows, editor.found)
            if toSave.picked.Count() > 0
                picked = homeRowLayout.DynamicRows()
                picked.Append(toSave.picked)
                homeRowLayout.SaveDynamic(picked)
            end if
            merged = homeRowLayout.Save(toSave.order, toSave.hidden)
            saveHomeRowLayout(merged.order, merged.hidden)
        end if
        return
    end if

    if editor.kind = "ratingSources"
        stored = FormatJson(ratingSourceList.ToStored(editorEnabledIds(editor.rows)))
        set_user_setting(m.ratingSourcesSetting, stored)
        syncSettingToServer(m.ratingSourcesSetting, stored)
        return
    end if

    target = editorTarget(editor.kind)
    ' A reset clears both lists, which puts every button back in the order the app declares them
    if resetForm
        saveButtonLayout(target, [], [])
        return
    end if
    order = []
    hidden = []
    for each row in editor.rows
        order.push(row.id)
        if not row.enabled then hidden.push(row.id)
    end for
    merged = buttonLayout.WithUnknownIds(target.catalogue, order, hidden, get_user_setting(target.orderKey), get_user_setting(target.hiddenKey))
    saveButtonLayout(target, merged.order, merged.hidden)
end sub

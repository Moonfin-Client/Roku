<?xml version="1.0" encoding="utf-8"?>
<!-- A vertical list of settings rows that can each be a different height -->
<component name="SettingsScroller" extends="Group">
  <interface>
    <field id="content" type="node" onChange="onContentChanged" />
    <field id="rowHeights" type="array" onChange="onHeightsChanged" />
    <field id="itemWidth" type="float" value="701" onChange="onViewSizeChanged" />
    <field id="viewHeight" type="float" value="987" onChange="onViewSizeChanged" />
    <field id="bottomPadding" type="float" value="13" />
    <field id="animate" type="boolean" value="true" />
    <field id="itemFocused" type="integer" value="-1" alwaysNotify="true" />
    <field id="itemSelected" type="integer" value="-1" alwaysNotify="true" />
    <field id="jumpToItem" type="integer" value="-1" alwaysNotify="true" onChange="onJumpToItem" />
    <field id="scrollOffset" type="float" value="0" />
    <function name="refreshItem" />
  </interface>
  <children>
    <Group id="clip">
      <Group id="track" />
    </Group>
    <Animation id="scrollAnim" duration="0.12" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="track.translation" />
    </Animation>
  </children>
</component>

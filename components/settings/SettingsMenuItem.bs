import "pkg:/components/settings/settingsNodes.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/settingsMetrics.bs"

' Every kind of settings row draws in this one item, since the list recycles items between rows
' of different kinds. The row arrives already laid out, so the item only places what it's told.
sub init()
    for each id in ["bandLead", "bandHint", "bandHint2", "bandHeader", "bandPlainGlyph", "bandPlainTitle", "bandPlainCaption", "aboutLogo", "aboutVersion", "aboutDivider", "shadow", "glow", "cardFill", "cardStroke", "tileFill", "tileStroke", "checkFill", "glyph", "swatchRing", "swatchFill", "logo", "title", "caption", "trailingGlyph", "arrowPrev", "arrowNext", "switch", "track", "outline", "thumb", "bubble", "bubbleFill", "bubbleStroke", "bubbleText", "slider", "sliderTrack", "sliderProgress", "ticks", "sliderThumb"]
        m[id] = m.top.findNode(id)
    end for
    m.palette = invalid
    m.style = invalid
end sub

sub onContentChanged()
    row = m.top.itemContent
    if not isValid(row) then return

    style = row.style
    if isValid(style) and (not isValid(m.style) or not style.isSameNode(m.style))
        m.style = style
        m.palette = style.palette
        applyStyle()
    end if
    if not isValid(m.palette) then return

    layout(row)
    paint()
end sub

' The faces and card shapes a style names, set once rather than on every row
sub applyStyle()
    fonts = m.palette.fonts
    m.bandLead.font = fonts.lead
    m.bandHint.font = fonts.hint
    m.bandHint2.font = fonts.hint
    m.bandHeader.font = fonts.header
    m.bandPlainGlyph.font = fonts.iconCheck
    m.bandPlainTitle.font = fonts.title
    m.bandPlainCaption.font = fonts.caption
    m.bubbleText.font = fonts.bubble

    spacing = m.palette.spacing
    m.bandLead.lineSpacing = spacing.lead
    m.bandHint.lineSpacing = spacing.hint
    m.bandHint2.lineSpacing = spacing.hint
    m.bandPlainCaption.lineSpacing = spacing.plainCaption
    m.bubbleText.lineSpacing = spacing.bubble

    images = m.palette.images
    m.cardStroke.uri = images.cardStroke
    m.shadow.uri = images.card
    m.glow.uri = images.glow
    m.tileFill.uri = images.tile
    m.tileStroke.uri = images.tileStroke
    m.bubbleFill.uri = images.bubble
    m.bubbleStroke.uri = images.bubbleStroke
end sub

sub layout(row as object)
    kind = row.kind
    fonts = m.palette.fonts
    lineTitle = settingsMetrics.LineHeight(14, m.palette.scale)
    plain = kind = "plain"
    option = kind = "option"
    ' Core's picker and checklist rows draw nothing until focused
    quiet = option or kind = "tick"
    m.title.font = fonts.title
    m.title.lineSpacing = m.palette.spacing.title
    if option
        lineTitle = settingsMetrics.LineHeight(15, m.palette.scale)
        m.title.font = fonts.option
        m.title.lineSpacing = m.palette.spacing.option
    end if

    layoutBand(row.bandLayout)

    marginX = settingsMetrics.Px(12)
    if plain then marginX = 0
    cardX = marginX
    cardY = row.bandHeight + settingsMetrics.Px(4)
    if quiet then cardY = row.bandHeight + settingsMetrics.Px(1)
    if plain then cardY = row.bandHeight
    cardWidth = m.top.width - marginX * 2
    cardHeight = row.cardHeight
    padX = settingsMetrics.Px(16) + 1
    if plain then padX = settingsMetrics.Px(16)
    if option then padX = settingsMetrics.Px(14)
    if kind = "tick" then padX = settingsMetrics.Px(8)
    rightEdge = cardX + cardWidth - padX

    placeNode(m.cardFill, cardX, cardY, cardWidth, cardHeight)
    placeNode(m.cardStroke, cardX, cardY, cardWidth, cardHeight)
    placeNode(m.glow, cardX - 44, cardY - 44, cardWidth + 88, cardHeight + 88)
    placeNode(m.shadow, cardX + settingsMetrics.Px(4), cardY + settingsMetrics.Px(4), cardWidth, cardHeight)
    m.cardStroke.visible = not (plain or quiet)
    ' A plain tile tints edge to edge with no corners
    m.cardFill.uri = m.palette.images.card
    if plain then m.cardFill.uri = m.palette.images.plain
    if quiet then m.cardFill.uri = m.palette.images.bubble

    ' The leading glyph sits in a tile, or bare where a checkbox or a plain list puts it
    tiled = not (plain or quiet or kind = "check")
    textX = cardX + padX
    m.tileFill.visible = tiled
    m.tileStroke.visible = tiled
    m.logo.visible = false
    m.swatchRing.visible = false
    m.swatchFill.visible = false
    m.glyph.text = row.glyph
    if tiled
        tile = settingsMetrics.Px(44)
        tileY = cardY + (cardHeight - tile) / 2
        placeNode(m.tileFill, textX, tileY, tile, tile)
        placeNode(m.tileStroke, textX, tileY, tile, tile)
        placeNode(m.glyph, textX, tileY, tile, tile)
        m.glyph.horizAlign = "center"
        m.glyph.font = fonts.iconTile
        if isValidAndNotEmpty(row.logo)
            logo = settingsMetrics.Px(26)
            placeNode(m.logo, textX + (tile - logo) / 2, tileY + (tile - logo) / 2, logo, logo)
            m.logo.uri = `pkg:/images/icons/settings/${row.logo}.webp`
            m.logo.visible = true
            m.glyph.text = ""
        end if
        textX = textX + tile + settingsMetrics.Px(14)
    else if not quiet
        slot = settingsMetrics.Px(44)
        gap = settingsMetrics.Px(14)
        if plain
            slot = settingsMetrics.Px(40)
            gap = settingsMetrics.Px(16)
        end if
        placeNode(m.glyph, textX, cardY, slot, cardHeight)
        m.glyph.horizAlign = "left"
        m.glyph.font = fonts.iconCheck
        textX = textX + slot + gap
    else if kind = "tick"
        ' Core's 18 unit checkbox sits in a 40 unit box, and its check shows through onto checkFill
        glyphBox = settingsMetrics.Px(40)
        placeNode(m.glyph, textX, cardY, glyphBox, cardHeight)
        m.glyph.horizAlign = "center"
        m.glyph.font = fonts.iconCheck
        backing = settingsMetrics.Px(16)
        placeNode(m.checkFill, textX + (glyphBox - backing) / 2, cardY + (cardHeight - backing) / 2, backing, backing)
        m.checkFill.uri = m.palette.images.plain
        textX = textX + glyphBox + settingsMetrics.Px(14)
    else if row.glyph <> ""
        ' The glyph is wider than its 18 unit ring, so its box is centered on the ring
        ring = settingsMetrics.Px(18)
        glyphBox = settingsMetrics.Px(24)
        placeNode(m.glyph, textX + (ring - glyphBox) / 2, cardY, glyphBox, cardHeight)
        m.glyph.horizAlign = "center"
        m.glyph.font = fonts.iconRadio
        textX = textX + ring + settingsMetrics.Px(14)
        if isValid(row.swatch.fill)
            dot = settingsMetrics.Px(24)
            dotY = cardY + (cardHeight - dot) / 2
            placeNode(m.swatchRing, textX, dotY, dot, dot)
            placeNode(m.swatchFill, textX + settingsMetrics.Px(1), dotY + settingsMetrics.Px(1), dot - settingsMetrics.Px(2), dot - settingsMetrics.Px(2))
            tint(m.swatchRing, row.swatch.ring)
            tint(m.swatchFill, row.swatch.fill)
            textX = textX + dot + settingsMetrics.Px(14)
        end if
    end if

    titleLines = row.titleLines
    if titleLines < 1 then titleLines = 1
    m.title.maxLines = titleLines
    placeNode(m.title, textX, cardY + row.titleTop, row.textWidth, lineTitle * titleLines)
    m.title.text = row.title

    m.caption.visible = row.captionLines > 0
    if row.captionLines > 0
        captionFont = fonts.caption
        captionDp = 12
        m.caption.lineSpacing = m.palette.spacing.caption
        if row.subtitleTone = "descSmall"
            captionFont = fonts.descSmall
            captionDp = 11
            m.caption.lineSpacing = m.palette.spacing.descSmall
        end if
        captionLine = settingsMetrics.LineHeight(captionDp, m.palette.scale)
        m.caption.font = captionFont
        m.caption.maxLines = row.captionLines
        placeNode(m.caption, textX, cardY + row.captionTop, row.textWidth, captionLine * row.captionLines)
        m.caption.text = row.subtitle
    end if

    layoutTrailing(row, kind, cardY, cardHeight, rightEdge)
    m.slider.visible = kind = "slider"
    if kind = "slider" then layoutSlider(row, textX, cardY, rightEdge)
end sub

sub layoutTrailing(row as object, kind as string, cardY as float, cardHeight as float, rightEdge as float)
    fonts = m.palette.fonts
    m.trailingGlyph.visible = false
    m.arrowPrev.visible = false
    m.arrowNext.visible = false
    m.switch.visible = false
    m.bubble.visible = false

    if kind = "nav"
        m.trailingGlyph.font = fonts.iconTrailing
        m.trailingGlyph.text = settingsGlyphs.Char("chevron_right")
        placeNode(m.trailingGlyph, rightEdge - 60, cardY, 60, cardHeight)
        m.trailingGlyph.visible = true
        return
    end if

    switchRight = rightEdge
    if kind = "button"
        ' Up and down only show which ways the button can move, the remote does the moving
        arrowBox = settingsMetrics.Px(48)
        if row.locked
            switchRight = rightEdge - settingsMetrics.Px(42)
            m.trailingGlyph.font = fonts.iconCaret
            m.trailingGlyph.text = settingsGlyphs.Char("lock_outline")
            placeNode(m.trailingGlyph, rightEdge - settingsMetrics.Px(42), cardY, settingsMetrics.Px(30), cardHeight)
            m.trailingGlyph.visible = true
        else
            switchRight = rightEdge - settingsMetrics.Px(60)
        end if
        placeArrows("keyboard_arrow_up", "keyboard_arrow_down", fonts.iconCheck, switchRight - arrowBox * 2, cardY, arrowBox, cardHeight)
        if row.locked then return
        layoutSwitch(row, rightEdge, cardY, cardHeight)
        return
    end if

    if kind = "reorder" or kind = "plain"
        caret = settingsMetrics.Px(18)
        if row.canMovePrev or row.canMoveNext then placeArrows("arrow_left", "arrow_right", fonts.iconCaret, rightEdge - caret * 2, cardY, caret, cardHeight)
        return
    end if

    if kind = "switch"
        layoutSwitch(row, rightEdge, cardY, cardHeight)
        return
    end if

    if kind = "picker" and row.chip <> ""
        bubbleY = cardY + (cardHeight - row.chipHeight) / 2
        bubbleX = rightEdge - row.chipWidth
        placeNode(m.bubbleFill, bubbleX, bubbleY, row.chipWidth, row.chipHeight)
        placeNode(m.bubbleStroke, bubbleX, bubbleY, row.chipWidth, row.chipHeight)
        insetX = settingsMetrics.Px(10) + 1
        insetY = settingsMetrics.Px(8) + 1
        placeNode(m.bubbleText, bubbleX + insetX, bubbleY + insetY, row.chipWidth - insetX * 2, row.chipHeight - insetY * 2)
        m.bubbleText.text = row.chip
        m.bubble.visible = true
    end if
end sub

sub placeArrows(prevGlyph as string, nextGlyph as string, font as object, x as float, cardY as float, width as float, cardHeight as float)
    m.arrowPrev.font = font
    m.arrowNext.font = font
    m.arrowPrev.text = settingsGlyphs.Char(prevGlyph)
    m.arrowNext.text = settingsGlyphs.Char(nextGlyph)
    placeNode(m.arrowPrev, x, cardY, width, cardHeight)
    placeNode(m.arrowNext, x + width, cardY, width, cardHeight)
    m.arrowPrev.visible = true
    m.arrowNext.visible = true
end sub

' The Material switch, a filled track with a large thumb when on and an outlined one with a small
' thumb when off
sub layoutSwitch(row as object, rightEdge as float, cardY as float, cardHeight as float)
    trackWidth = settingsMetrics.Px(52)
    trackHeight = settingsMetrics.Px(32)
    trackX = rightEdge - settingsMetrics.Px(4) - trackWidth
    trackY = cardY + (cardHeight - trackHeight) / 2
    placeNode(m.track, trackX, trackY, trackWidth, trackHeight)
    placeNode(m.outline, trackX, trackY, trackWidth, trackHeight)

    thumb = settingsMetrics.Px(16)
    centre = settingsMetrics.Px(16)
    if row.boolValue
        thumb = settingsMetrics.Px(24)
        centre = settingsMetrics.Px(36)
    end if
    placeNode(m.thumb, trackX + centre - thumb / 2, trackY + trackHeight / 2 - thumb / 2, thumb, thumb)
    m.switch.visible = true
end sub

' The track runs the text column's width, the value reads under the title, and short ranges show
' a dot for each step
sub layoutSlider(row as object, textX as float, cardY as float, rightEdge as float)
    trackLeft = textX + settingsMetrics.Px(24)
    width = rightEdge - settingsMetrics.Px(24) - trackLeft
    captionLine = settingsMetrics.LineHeight(12, m.palette.scale)
    centreY = cardY + row.captionTop + captionLine + settingsMetrics.Px(24)

    fraction = 0.0
    if row.sliderCount > 1 then fraction = row.sliderIndex / (row.sliderCount - 1)
    placeNode(m.sliderTrack, trackLeft, centreY - 3.5, width, 7)
    progress = width * fraction
    if progress < 10 then progress = 10
    placeNode(m.sliderProgress, trackLeft, centreY - 5, progress, 10)
    thumb = settingsMetrics.Px(20)
    placeNode(m.sliderThumb, trackLeft + width * fraction - thumb / 2, centreY - thumb / 2, thumb, thumb)

    steps = row.sliderCount
    if steps < 2 or steps > 30 then steps = 0
    while m.ticks.getChildCount() < steps
        dot = m.ticks.createChild("Rectangle")
        dot.width = 3
        dot.height = 3
    end while
    for i = 0 to m.ticks.getChildCount() - 1
        dot = m.ticks.getChild(i)
        dot.visible = i < steps
        if i < steps then dot.translation = [trackLeft + width * i / (steps - 1) - 1.5, centreY - 1.5]
    end for
end sub

sub layoutBand(band as dynamic)
    parts = ["lead", "hint", "hint2", "header"]
    labels = [m.bandLead, m.bandHint, m.bandHint2, m.bandHeader]
    for i = 0 to parts.Count() - 1
        part = invalid
        if isValid(band) then part = band[parts[i]]
        label = labels[i]
        label.visible = isValid(part)
        if isValid(part)
            placeNode(label, part.x, part.y, part.width, part.height)
            if parts[i] <> "header" then label.maxLines = part.lines
            label.text = part.text
            label.color = m.palette.text
            if parts[i] = "header" then label.color = m.palette.header
            if part.tone = "error" then label.color = m.palette.error
        end if
    end for

    aboutPart = invalid
    if isValid(band) then aboutPart = band.about
    for each node in [m.aboutLogo, m.aboutVersion, m.aboutDivider]
        node.visible = isValid(aboutPart)
    end for
    if isValid(aboutPart)
        placeNode(m.aboutLogo, aboutPart.logoX, aboutPart.logoY, aboutPart.logoWidth, aboutPart.logoHeight)
        placeNode(m.aboutVersion, 0, aboutPart.versionY, aboutPart.width, aboutPart.versionHeight)
        m.aboutVersion.font = m.palette.fonts.lead
        m.aboutVersion.color = m.palette.text
        m.aboutVersion.text = aboutPart.text
        placeNode(m.aboutDivider, 0, aboutPart.dividerY, aboutPart.width, settingsMetrics.Px(1))
        m.aboutDivider.color = m.palette.text
    end if

    plainPart = invalid
    if isValid(band) then plainPart = band.plain
    m.bandPlainGlyph.visible = isValid(plainPart)
    m.bandPlainTitle.visible = isValid(plainPart)
    m.bandPlainCaption.visible = isValid(plainPart)
    if not isValid(plainPart) then return

    m.bandPlainGlyph.color = m.palette.text
    m.bandPlainTitle.color = m.palette.plainTitle
    m.bandPlainCaption.color = m.palette.plainCaption
    placeNode(m.bandPlainGlyph, plainPart.x, plainPart.y, settingsMetrics.Px(40), plainPart.captionY + plainPart.captionHeight - plainPart.y)
    m.bandPlainGlyph.text = settingsGlyphs.Char(plainPart.glyph)
    placeNode(m.bandPlainTitle, plainPart.textX, plainPart.y, plainPart.width, plainPart.titleHeight)
    m.bandPlainTitle.text = plainPart.title
    placeNode(m.bandPlainCaption, plainPart.textX, plainPart.captionY, plainPart.width, plainPart.captionHeight)
    m.bandPlainCaption.maxLines = plainPart.captionLines
    m.bandPlainCaption.text = plainPart.caption
end sub

sub paint()
    row = m.top.itemContent
    if not isValid(row) or not isValid(m.palette) then return
    p = m.palette
    focused = m.top.itemHasFocus
    kind = row.kind
    plain = kind = "plain"
    tick = kind = "tick"
    quiet = kind = "option" or tick

    m.glow.visible = false
    m.shadow.visible = false
    m.checkFill.visible = false
    if plain or quiet
        m.cardFill.visible = focused
        if focused and plain then tint(m.cardFill, p.plainFocus)
        if focused and quiet then tint(m.cardFill, p.cardFocus)
    else
        if focused
            tint(m.cardFill, p.cardFocus)
            tint(m.cardStroke, p.strokeFocus)
        else
            tint(m.cardFill, p.card)
            tint(m.cardStroke, p.stroke)
        end if
        if focused and isValid(p.glow) then tint(m.glow, p.glow)
        if focused and isValid(p.shadow) then tint(m.shadow, p.shadow)
    end if

    strong = p.text
    soft = p.textSoft
    if focused
        strong = p.inkStrong
        soft = p.inkSoft
    end if

    m.title.color = strong
    if plain then m.title.color = p.plainTitle
    m.title.opacity = 1
    if tick and row.locked then m.title.opacity = 0.4

    ' What a switch or a picker says under its title is as strong as the title, and anything
    ' else under a title is softer
    captionColor = soft
    if kind = "switch" or kind = "picker" then captionColor = strong
    if row.subtitleTone = "error" then captionColor = p.error
    if plain then captionColor = p.plainCaption
    m.caption.color = captionColor

    if m.tileFill.visible
        if focused
            tint(m.tileFill, p.tileFocus)
            tint(m.tileStroke, p.tileStrokeFocus)
            m.glyph.color = soft
        else
            tint(m.tileFill, p.tile)
            tint(m.tileStroke, p.tileStroke)
            m.glyph.color = p.glyph
            if row.glyphStrong then m.glyph.color = p.text
        end if
        m.logo.blendColor = m.glyph.color
    else if plain
        m.glyph.color = p.text
        if row.boolValue then m.glyph.color = p.checkOn
    else if quiet
        m.glyph.color = p.radioOff
        if row.selected or tick then m.glyph.color = p.checkOn
        if focused then m.glyph.color = p.inkRadio
        if focused and tick then m.glyph.color = p.inkBox
        if focused and row.selected then m.glyph.color = p.inkStrong
        if tick and row.selected
            m.checkFill.visible = true
            if focused then tint(m.checkFill, { color: "0xFFFFFFFF", opacity: 1 }) else tint(m.checkFill, p.thumbOn)
        end if
    else
        m.glyph.color = soft
        if row.boolValue and not focused then m.glyph.color = p.checkOn
    end if

    m.trailingGlyph.color = soft
    if kind = "button" and row.locked
        m.trailingGlyph.color = p.lock
        if focused then m.trailingGlyph.color = p.lockFocus
    end if

    arrowOn = soft
    if plain then arrowOn = p.text
    m.arrowPrev.color = arrowOn
    m.arrowNext.color = arrowOn
    if not row.canMovePrev then m.arrowPrev.color = p.hintOff
    if not row.canMoveNext then m.arrowNext.color = p.hintOff
    if kind = "reorder" or plain
        m.arrowPrev.visible = row.canMovePrev
        m.arrowNext.visible = row.canMoveNext
    end if

    ' The switch keeps its colours whether or not the row has the focus
    if m.switch.visible
        if row.boolValue
            tint(m.track, p.trackOn)
            m.outline.visible = false
            tint(m.thumb, p.thumbOn)
        else
            tint(m.track, p.trackOff)
            tint(m.outline, p.outline)
            tint(m.thumb, p.thumbOff)
        end if
    end if

    if m.bubble.visible
        if focused
            tint(m.bubbleFill, p.bubbleFocus)
            tint(m.bubbleStroke, p.bubbleStrokeFocus)
            m.bubbleText.color = p.inkStrong
        else
            tint(m.bubbleFill, p.bubble)
            tint(m.bubbleStroke, p.bubbleStroke)
            m.bubbleText.color = p.bubbleText
        end if
    end if

    if m.slider.visible
        tint(m.sliderTrack, p.sliderTrack)
        tint(m.sliderProgress, p.sliderProgress)
        tint(m.sliderThumb, p.sliderThumb)
        for i = 0 to m.ticks.getChildCount() - 1
            m.ticks.getChild(i).color = p.tick
        end for
    end if
end sub

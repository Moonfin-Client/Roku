import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/SettingType.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' A heading rests on the bottom of its row so it reads as belonging to what
' follows rather than floating between the two
const SECTION_HEADING_TOP = 74
const SECTION_HEADING_INK = "#FFFFFF99"
' A heading has no card to sit beside, so it can run the width of the panel
const SECTION_HEADING_WIDTH = 720
const ROW_TITLE_WIDTH = 480
' A row with nothing to explain sets its title level with the icon rather than above an empty line
const ROW_TITLE_TOP = 30
const ROW_TITLE_CENTERED_TOP = 46
const ROW_DESCRIPTION_TOP = 65
' A note sits low in its row, close to the heading or rows it explains
const NOTE_TEXT_TOP = 46
const NOTE_CAPTION_TOP = 80
const NOTE_INK = "#C8CCD4FF"
const NOTE_ERROR_INK = "#FF9F9F"

sub init()
    m.buttonBackground = m.top.findNode("buttonBackground")
    m.focusOutline = m.top.findNode("focusOutline")
    m.settingTitle = m.top.findNode("settingTitle")
    m.settingCurrentValue = m.top.findNode("settingCurrentValue")
    m.settingDescription = m.top.findNode("settingDescription")
    m.boolToggle = m.top.findNode("boolToggle")
    m.icon = m.top.findNode("icon")
    m.iconBackground = m.top.findNode("iconBackground")
    m.isTextOnly = false

    m.marqueeScrollSpeed = 220
    m.settingTitle.scrollSpeed = m.marqueeScrollSpeed
    m.settingCurrentValue.scrollSpeed = m.marqueeScrollSpeed
    m.settingDescription.scrollSpeed = m.marqueeScrollSpeed

    focusChanged()
end sub

sub itemContentChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    ' A section is a heading over the rows beneath it rather than a row of its
    ' own, so it drops the card and everything that sits on it. A note explains
    ' the rows around it the same way.
    rowType = chainLookupReturn(itemData, "settingType", "")
    m.isTextOnly = rowType = SettingType.SECTION or rowType = SettingType.NOTE
    if rowType = SettingType.SECTION
        showAsSection(chainLookupReturn(itemData, "title", ""))
        return
    end if
    if rowType = SettingType.NOTE
        showAsNote(chainLookupReturn(itemData, "title", ""), chainLookupReturn(itemData, "Description", ""), chainLookupReturn(itemData, "noteTone", ""))
        return
    end if

    m.buttonBackground.visible = true
    m.iconBackground.visible = true
    m.icon.visible = true
    m.settingDescription.visible = true
    m.settingTitle.font = "font:SmallestBoldSystemFont"
    m.settingTitle.maxWidth = ROW_TITLE_WIDTH
    m.settingDescription.translation = [118, ROW_DESCRIPTION_TOP]
    m.settingDescription.maxWidth = ROW_TITLE_WIDTH

    m.settingTitle.text = chainLookupReturn(itemData, "title", "")

    descriptionText = chainLookupReturn(itemData, "Description", "")
    if not isValidAndNotEmpty(descriptionText)
        descriptionText = chainLookupReturn(itemData, "description", "")
    end if
    m.settingDescription.text = descriptionText
    m.settingTitle.translation = [118, descriptionText = "" ? ROW_TITLE_CENTERED_TOP : ROW_TITLE_TOP]

    currentValueText = chainLookupReturn(itemData, "currentValue", "")
    if not isValidAndNotEmpty(currentValueText)
        currentValueText = ""
    end if
    m.settingCurrentValue.text = currentValueText

    itemIcon = chainLookupReturn(itemData, "itemIcon", "")
    if isValidAndNotEmpty(itemIcon)
        m.icon.uri = "pkg:/images/icons/settings/" + itemIcon
    else
        m.icon.uri = "pkg:/images/icons/settings.png"
    end if

    if LCase(rowType) = "bool"
        m.boolToggle.visible = true
        m.settingCurrentValue.visible = false
        boolVal = chainLookupReturn(itemData, "boolValue", "false")
        if LCase(boolVal) = "true"
            m.boolToggle.uri = "pkg:/images/icons/settings/toggle_on.png"
        else
            m.boolToggle.uri = "pkg:/images/icons/settings/toggle_off.png"
        end if
    else
        m.boolToggle.visible = false
        m.settingCurrentValue.visible = true
    end if

    ' Rows are recycled as the list scrolls, so repaint the focus state the row
    ' is being reused into
    focusChanged()
end sub

' A heading is drawn back so the settings under it stay the focus of the row
sub showAsSection(label as string)
    hideCard()
    m.settingDescription.visible = false

    m.settingTitle.text = UCase(label)
    m.settingTitle.font = "font:SmallBoldSystemFont"
    m.settingTitle.color = SECTION_HEADING_INK
    m.settingTitle.translation = [8, SECTION_HEADING_TOP]
    m.settingTitle.maxWidth = SECTION_HEADING_WIDTH
end sub

' A line of explanation with an optional caption under it, drawn without a card like a heading
sub showAsNote(text as string, caption as string, tone as string)
    hideCard()

    m.settingTitle.text = text
    m.settingTitle.font = "font:TinySystemFont"
    m.settingTitle.color = tone = "error" ? NOTE_ERROR_INK : NOTE_INK
    m.settingTitle.translation = [8, NOTE_TEXT_TOP]
    m.settingTitle.maxWidth = SECTION_HEADING_WIDTH

    m.settingDescription.visible = caption <> ""
    m.settingDescription.text = caption
    m.settingDescription.color = NOTE_INK
    m.settingDescription.translation = [8, NOTE_CAPTION_TOP]
    m.settingDescription.maxWidth = SECTION_HEADING_WIDTH
end sub

sub hideCard()
    m.buttonBackground.visible = false
    m.focusOutline.visible = false
    m.iconBackground.visible = false
    m.icon.visible = false
    m.settingCurrentValue.text = ""
    m.boolToggle.visible = false
end sub

sub focusChanged()
    focusColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    ' showAsSection and showAsNote already drew the text, and it never takes the focus ink
    if m.isTextOnly then return

    if m.top.itemHasFocus
        startMarquee(m.settingTitle)
        startMarquee(m.settingCurrentValue)
        startMarquee(m.settingDescription)
        ' The fill is taken down far enough to carry the same light text the rows around it
        ' use, since dark text on a bright fill measures well and still reads muddy across a room
        m.buttonBackground.blendColor = themeChrome.DeepenForLightInk(focusColor)
        m.focusOutline.visible = m.top.drawFocusFeedback
        m.settingTitle.color = "#FFFFFFF5"
        m.settingCurrentValue.color = "#FFFFFFC7"
        m.settingDescription.color = "#FFFFFFC7"
    else
        stopMarquee(m.settingTitle)
        stopMarquee(m.settingCurrentValue)
        stopMarquee(m.settingDescription)
        m.buttonBackground.blendColor = "#181818FF"
        m.focusOutline.visible = false
        m.settingTitle.color = ColorPalette.WHITE
        m.settingCurrentValue.color = focusColor
        m.settingDescription.color = "#C8CCD4FF"
    end if
end sub

sub startMarquee(label as object)
    if not isValid(label) then return
    if not isValidAndNotEmpty(label.text)
        label.repeatCount = 0
        return
    end if

    ' Reset first so marquee restarts when focus changes between rows.
    label.repeatCount = 0
    label.repeatCount = -1
end sub

sub stopMarquee(label as object)
    if not isValid(label) then return
    label.repeatCount = 0
end sub

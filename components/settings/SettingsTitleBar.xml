<?xml version="1.0" encoding="utf-8"?>
<!-- The bar over a settings screen: its name, and one action on the end when the screen has one -->
<component name="SettingsTitleBar" extends="Group">
  <interface>
    <field id="title" type="string" onChange="layout" />
    <field id="isRoot" type="boolean" onChange="layout" />
    <field id="action" type="string" onChange="layout" />
    <field id="scrolled" type="boolean" onChange="paint" />
    <field id="actionFocused" type="boolean" onChange="paint" />
    <field id="style" type="node" onChange="onStyleChanged" />
  </interface>
  <children>
    <Rectangle id="background" width="701" height="93" />
    <Rectangle id="scrolledTint" width="701" height="93" visible="false" />
    <Label id="titleLabel" vertAlign="center" />
    <Poster id="actionDisc" uri="pkg:/images/settings/dot96.png" opacity="0.1" visible="false" />
    <Label id="actionGlyph" horizAlign="center" vertAlign="center" />
  </children>
</component>

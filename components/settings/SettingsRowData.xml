<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row, laid out before it reaches the list so a recycled item only places what it's told -->
<component name="SettingsRowData" extends="ContentNode">
  <interface>
    <field id="kind" type="string" />
    <field id="subtitle" type="string" />
    <field id="subtitleTone" type="string" />
    <field id="glyph" type="string" />
    <field id="glyphStrong" type="boolean" />
    <field id="logo" type="string" />
    <field id="chip" type="string" />
    <field id="chipWidth" type="float" />
    <field id="chipHeight" type="float" />
    <field id="boolValue" type="boolean" />
    <field id="locked" type="boolean" />
    <field id="canMovePrev" type="boolean" />
    <field id="canMoveNext" type="boolean" />
    <field id="sliderIndex" type="integer" />
    <field id="sliderCount" type="integer" />
    <field id="selected" type="boolean" />

    <!-- What sits above the card: a section heading, hint lines, or the plain tile heading a list.
         Each part carries its text and where it goes. -->
    <field id="bandLayout" type="assocarray" />
    <field id="bandHeight" type="float" />

    <field id="cardHeight" type="float" />
    <field id="titleTop" type="float" />
    <field id="captionTop" type="float" />
    <field id="captionLines" type="integer" />
    <field id="titleLines" type="integer" value="1" />
    <field id="textWidth" type="float" />

    <field id="style" type="node" />
  </interface>
</component>

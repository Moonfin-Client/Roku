<?xml version="1.0" encoding="utf-8"?>
<!-- Moves the whole settings profile between this device and the server. The caller picks which
     way by setting functionName to loadProfile, saveProfile or resetProfile. -->
<component name="SettingsSyncTask" extends="Task">
    <interface>
        <!-- ok says whether the server took the request -->
        <field id="result" type="assocarray" />
    </interface>
</component>

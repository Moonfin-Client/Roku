<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsMenuItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" alwaysNotify="true" onChange="onContentChanged" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="itemHasFocus" type="boolean" onChange="paint" />
  </interface>
  <children>
    <Label id="bandLead" wrap="true" vertAlign="center" />
    <Label id="bandHint" wrap="true" vertAlign="center" />
    <Label id="bandHint2" wrap="true" vertAlign="center" />
    <Label id="bandHeader" vertAlign="center" />
    <Label id="bandPlainGlyph" vertAlign="center" />
    <Label id="bandPlainTitle" vertAlign="center" />
    <Label id="bandPlainCaption" wrap="true" vertAlign="center" />
    <Poster id="aboutLogo" uri="pkg:/images/logo.png" />
    <Label id="aboutVersion" horizAlign="center" vertAlign="center" />
    <Rectangle id="aboutDivider" />

    <Poster id="shadow" />
    <Poster id="glow" />
    <Poster id="cardFill" />
    <Poster id="cardStroke" />
    <Poster id="tileFill" />
    <Poster id="tileStroke" />
    <Label id="glyph" horizAlign="center" vertAlign="center" />
    <Poster id="logo" />

    <Label id="title" vertAlign="center" wrap="true" />
    <Label id="caption" wrap="true" vertAlign="center" />

    <Label id="trailingGlyph" horizAlign="right" vertAlign="center" />
    <Label id="arrowPrev" horizAlign="center" vertAlign="center" />
    <Label id="arrowNext" horizAlign="center" vertAlign="center" />

    <Group id="switch">
      <Poster id="track" uri="pkg:/images/settings/pill26.9.png" />
      <Poster id="outline" uri="pkg:/images/settings/pill26s3.9.png" />
      <Poster id="thumb" uri="pkg:/images/settings/dot96.png" />
    </Group>

    <Group id="bubble">
      <Poster id="bubbleFill" />
      <Poster id="bubbleStroke" />
      <Label id="bubbleText" horizAlign="center" vertAlign="center" wrap="true" maxLines="3" />
    </Group>

    <Group id="slider">
      <Poster id="sliderTrack" uri="pkg:/images/settings/round3.9.png" />
      <Poster id="sliderProgress" uri="pkg:/images/settings/round3.9.png" />
      <Group id="ticks" />
      <Poster id="sliderThumb" uri="pkg:/images/settings/dot96.png" />
    </Group>
  </children>
</component>

import "pkg:/components/settings/settingsNodes.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/settingsMetrics.bs"
import "pkg:/source/utils/settingsSync.bs"

const SYNC_CONNECTED_INK = "0x22C55EFF"
const SYNC_RESET_INK = "0xCF6679FF"
const SYNC_RESET_FOCUS_INK = "0x87424FFF"
const SYNC_CHIP_INK = "0x8EC8F0FF"

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.titleBar = m.top.findNode("titleBar")
    m.content = m.top.findNode("content")
    m.syncSection = m.top.findNode("syncSection")
    m.heading = m.top.findNode("profileHeading")
    m.caption = m.top.findNode("profileCaption")
    m.actionsFill = m.top.findNode("actionsFill")
    m.loading = m.top.findNode("loading")

    m.tiles = []
    m.busy = false
    m.isOpen = false
    m.built = false
    m.actionFocused = false
end sub

sub showDialog()
    m.isOpen = true
    m.row = 0
    m.column = 0
    m.actionFocused = false
    m.loading.active = m.busy
    if not m.built then build()
    refresh()
    m.top.setFocus(true)
end sub

' ===== Building =====

function dp(units as float) as float
    return settingsMetrics.Px(units)
end function

function syncFont(bold as boolean, units as float) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = "font:SystemFontFile"
    if bold then font.uri = "font:BoldSystemFontFile"
    font.size = Int(dp(units) * m.palette.scale + 0.5)
    return font
end function

function glyphLabel(parent as object, units as float) as object
    label = parent.createChild("Label")
    font = CreateObject("roSGNode", "Font")
    font.uri = settingsGlyphs.FONT_URI
    font.size = Int(dp(units) + 0.5)
    label.font = font
    label.horizAlign = "center"
    label.vertAlign = "center"
    return label
end function

' Something the focus can land on: a card that glows and fills with the focus, a glyph, and a
' name over a line of detail with room for a dot in front of it
function addTile(parent as object, id as string, glyph as string, glyphSize as float) as object
    group = parent.createChild("Group")
    glow = group.createChild("Poster")
    fill = group.createChild("Poster")
    stroke = group.createChild("Poster")
    icon = glyphLabel(group, glyphSize)
    name = group.createChild("Label")
    detail = group.createChild("Label")
    dot = group.createChild("Poster")

    glow.uri = m.palette.images.glow
    fill.uri = m.palette.images.card
    stroke.uri = m.palette.images.cardStroke
    icon.text = settingsGlyphs.Char(glyph)
    name.vertAlign = "center"
    detail.vertAlign = "center"
    detail.wrap = true
    dot.uri = "pkg:/images/settings/dot96.png"
    dot.blendColor = SYNC_CONNECTED_INK
    dot.width = dp(8)
    dot.height = dp(8)
    dot.visible = false

    tile = { id: id, group: group, glow: glow, fill: fill, stroke: stroke, icon: icon, title: name, subtitle: detail, dot: dot, glyphSize: dp(glyphSize) }
    m.tiles.push(tile)
    return tile
end function

sub sizeTile(tile as object, width as float, height as float)
    tile.width = width
    tile.height = height
    placeNode(tile.fill, 0, 0, width, height)
    placeNode(tile.stroke, 0, 0, width, height)
    placeNode(tile.glow, -44, -44, width + 88, height + 88)
end sub

sub build()
    m.palette = m.top.style.palette
    m.built = true
    m.content.translation = [dp(12), settingsMetrics.TITLE_BAR_HEIGHT + dp(8)]
    m.width = settingsMetrics.PANEL_WIDTH - dp(12) * 2

    m.titleBar.style = m.top.style
    m.titleBar.isRoot = false
    m.titleBar.action = "refresh"
    m.titleBar.title = tr("Settings Sync")

    m.heading.font = syncFont(true, 12)
    m.heading.text = tr("Profile")
    m.caption.font = syncFont(false, 12)
    m.caption.text = tr("This device syncs with the profile you pick until you pick another.")
    m.actionsFill.uri = m.palette.images.card

    buildStatusCard()
    buildProfiles()
    buildActions()
end sub

sub buildStatusCard()
    card = addTile(m.content, "status", "extension", 22)
    card.action = "toggle"
    pad = dp(14) + 1
    tile = dp(44)

    card.tileFill = card.group.createChild("Poster")
    card.tileStroke = card.group.createChild("Poster")
    card.tileFill.uri = m.palette.images.tile
    card.tileStroke.uri = m.palette.images.tileStroke
    ' The tile sits under the glyph
    card.group.insertChild(card.tileFill, 3)
    card.group.insertChild(card.tileStroke, 4)
    rowHeight = dp(64)
    placeNode(card.tileFill, pad, pad + (rowHeight - tile) / 2, tile, tile)
    placeNode(card.tileStroke, pad, pad + (rowHeight - tile) / 2, tile, tile)
    placeNode(card.icon, pad, pad + (rowHeight - tile) / 2, tile, tile)

    textLeft = pad + tile + dp(12)
    switchWidth = dp(60)
    textWidth = m.width - textLeft - pad - dp(12) - switchWidth
    textTop = pad + (rowHeight - dp(24) - dp(2) - dp(16)) / 2
    card.title.font = syncFont(true, 16)
    placeNode(card.title, textLeft, textTop, textWidth, dp(24))
    card.title.text = "Moonbase"
    card.subtitle.font = syncFont(false, 12)
    card.subtitle.maxLines = 1
    placeNode(card.subtitle, textLeft, textTop + dp(26), textWidth, dp(16))
    card.dot.translation = [textLeft, textTop + dp(26) + dp(4)]
    card.textLeft = textLeft
    card.textWidth = textWidth

    ' The switch only shows the state, the card takes the press
    switchLeft = m.width - pad - switchWidth
    card.track = card.group.createChild("Poster")
    card.outline = card.group.createChild("Poster")
    card.thumb = card.group.createChild("Poster")
    card.track.uri = "pkg:/images/settings/pill26.9.png"
    card.outline.uri = "pkg:/images/settings/pill26s3.9.png"
    card.thumb.uri = "pkg:/images/settings/dot96.png"
    card.trackX = switchLeft + dp(4)
    card.trackY = pad + dp(8)
    placeNode(card.track, card.trackX, card.trackY, dp(52), dp(32))
    placeNode(card.outline, card.trackX, card.trackY, dp(52), dp(32))
    card.switchLabel = card.group.createChild("Label")
    card.switchLabel.font = syncFont(true, 11)
    card.switchLabel.horizAlign = "center"
    card.switchLabel.vertAlign = "center"
    placeNode(card.switchLabel, switchLeft - dp(10), pad + dp(48), switchWidth + dp(20), dp(16))

    card.chips = card.group.createChild("Group")
    card.chipList = []
    for i = 1 to 3
        chipGroup = card.chips.createChild("Group")
        chip = { group: chipGroup, fill: chipGroup.createChild("Poster"), stroke: chipGroup.createChild("Poster"), label: chipGroup.createChild("Label") }
        chip.fill.uri = "pkg:/images/settings/pill26.9.png"
        chip.stroke.uri = "pkg:/images/settings/card27s.9.png"
        chip.label.font = syncFont(false, 11)
        chip.label.vertAlign = "center"
        chip.label.horizAlign = "center"
        card.chipList.push(chip)
    end for

    card.note = card.group.createChild("Label")
    card.note.font = syncFont(false, 12)
    card.note.wrap = true
    card.note.width = m.width - pad * 2
    m.status = card
end sub

' Each profile with its glyph and what it does. The one this device follows by default says so
' instead.
function profileChoices() as object
    return [
        { name: "global", glyph: "public", detail: "Applies everywhere" },
        { name: "desktop", glyph: "desktop_windows", detail: "Overrides Global" },
        { name: "mobile", glyph: "phone_iphone", detail: "Overrides Global" },
        { name: "tv", glyph: "tv", detail: "Overrides Global" }
    ]
end function

sub buildProfiles()
    m.grid = m.syncSection.createChild("Group")
    m.profiles = []

    gap = dp(10)
    cardWidth = (m.width - gap) / 2
    pad = dp(12) + 1
    cardHeight = pad * 2 + dp(20) + dp(16)
    m.profileHeight = cardHeight
    index = 0
    for each choice in profileChoices()
        tile = addTile(m.grid, choice.name, choice.glyph, 24)
        tile.action = "profile"
        tile.profile = choice.name
        sizeTile(tile, cardWidth, cardHeight)
        tile.group.translation = [(index mod 2) * (cardWidth + gap), Int(index / 2) * (cardHeight + gap)]
        tile.icon.horizAlign = "left"
        placeNode(tile.icon, pad, 0, dp(24), cardHeight)
        textLeft = pad + dp(24) + dp(10)
        tile.title.font = syncFont(true, 14)
        placeNode(tile.title, textLeft, pad, cardWidth - textLeft - pad, dp(20))
        tile.title.text = tr(settingsSync.ProfileTitle(choice.name))
        tile.subtitle.font = syncFont(false, 12)
        tile.subtitle.maxLines = 1
        placeNode(tile.subtitle, textLeft, pad + dp(20), cardWidth - textLeft - pad, dp(16))

        tile.isDevice = choice.name = settingsSync.DEVICE_PROFILE
        tile.subtitle.text = tr(choice.detail)
        if tile.isDevice
            tile.subtitle.text = tr("This device")
            tile.dot.translation = [textLeft, pad + dp(20) + dp(4)]
            tile.dot.visible = true
            tile.subtitle.translation = [textLeft + dp(14), pad + dp(20)]
        end if
        m.profiles.push(tile)
        index++
    end for
end sub

sub buildActions()
    m.actions = m.syncSection.createChild("Group")
    inset = dp(12)
    gap = dp(10)
    pad = dp(12) + 1
    buttonWidth = (m.width - inset * 2 - gap) / 2
    buttons = [
        { id: "load", glyph: "cloud_download", name: tr("Load"), detail: tr("Server to this device") },
        { id: "save", glyph: "cloud_upload", name: tr("Save"), detail: tr("This device to server") }
    ]
    m.buttonHeight = pad * 2 + dp(20) + dp(16) * 2
    for i = 0 to buttons.Count() - 1
        spec = buttons[i]
        tile = addTile(m.actions, spec.id, spec.glyph, 24)
        tile.action = spec.id
        sizeTile(tile, buttonWidth, m.buttonHeight)
        tile.group.translation = [inset + i * (buttonWidth + gap), inset]
        tile.icon.horizAlign = "left"
        placeNode(tile.icon, pad, 0, dp(24), m.buttonHeight)
        textLeft = pad + dp(24) + dp(10)
        tile.title.font = syncFont(true, 14)
        placeNode(tile.title, textLeft, pad, buttonWidth - textLeft - pad, dp(20))
        tile.title.text = spec.name
        tile.subtitle.font = syncFont(false, 12)
        tile.subtitle.maxLines = 2
        tile.subtitle.vertAlign = "top"
        placeNode(tile.subtitle, textLeft, pad + dp(20), buttonWidth - textLeft - pad, dp(32))
        tile.subtitle.text = spec.detail
        if i = 0 then m.load = tile else m.save = tile
    end for

    ' A line of red text that only takes a fill with the focus
    m.reset = addTile(m.actions, "reset", "restart_alt", 20)
    m.reset.action = "reset"
    m.reset.icon.horizAlign = "left"
    m.reset.title.font = syncFont(true, 14)
    m.reset.subtitle.visible = false
    m.reset.stroke.visible = false
end sub

' ===== Drawing =====

' Lays the panel out for where the plugin and the switch stand now and repaints the focus
sub refresh()
    if not m.built then return
    m.panelFill.blendColor = m.palette.panel.color
    m.panelFill.opacity = m.palette.panel.opacity

    layoutStatus()

    showSync = settingsSync.IsSyncEnabled()
    m.syncSection.visible = showSync
    m.rows = [[m.status]]
    if showSync
        layoutSync()
        m.rows.push([m.profiles[0], m.profiles[1]])
        m.rows.push([m.profiles[2], m.profiles[3]])
        m.rows.push([m.load, m.save])
        m.rows.push([m.reset])
    end if

    if m.row >= m.rows.Count() then m.row = m.rows.Count() - 1
    paintAll()
end sub

sub layoutStatus()
    card = m.status
    pluginInfo = chainLookupReturn(m.global, "session.pluginInfo", {})
    available = moonfinPlugin.IsEnabled()
    pad = dp(14) + 1

    if available
        card.subtitle.text = Substitute(tr("Connected, version {0}"), chainLookupReturn(pluginInfo, "version", "").toStr())
    else
        card.subtitle.text = tr("Plugin Not Detected")
    end if
    card.dot.visible = available
    card.dot.blendColor = SYNC_CONNECTED_INK
    shift = 0
    if available then shift = dp(14)
    card.subtitle.translation = [card.textLeft + shift, card.subtitle.translation[1]]
    card.subtitle.width = card.textWidth - shift

    syncOn = syncSwitchOn()
    card.syncOn = syncOn
    card.switchLabel.text = tr("Sync off")
    thumb = dp(16)
    centre = dp(16)
    if syncOn
        card.switchLabel.text = tr("Sync on")
        thumb = dp(24)
        centre = dp(36)
    end if
    placeNode(card.thumb, card.trackX + centre - thumb / 2, card.trackY + dp(16) - thumb / 2, thumb, thumb)

    ' What the plugin offers on this server, each in a chip of its own
    names = []
    if available
        if chainLookupReturn(pluginInfo, "mdblistAvailable", false) = true then names.push("MDBList")
        if chainLookupReturn(pluginInfo, "tmdbAvailable", false) = true then names.push("TMDB")
        if chainLookupReturn(pluginInfo, "seerrEnabled", false) = true then names.push("Seerr")
    end if

    chipHeight = dp(3) * 2 + dp(16) + 2
    chipLeft = 0.0
    for i = 0 to card.chipList.Count() - 1
        chip = card.chipList[i]
        chip.group.visible = i < names.Count()
        if chip.group.visible
            chip.label.width = 0
            chip.label.height = 0
            chip.label.text = names[i]
            ' Rounded up, since a label a fraction too narrow cuts its text short
            textWidth = Int(chip.label.boundingRect().width) + 2
            chipWidth = textWidth + dp(10) * 2 + 2
            placeNode(chip.label, 0, 0, chipWidth, chipHeight)
            placeNode(chip.fill, 0, 0, chipWidth, chipHeight)
            placeNode(chip.stroke, 0, 0, chipWidth, chipHeight)
            chip.group.translation = [chipLeft, 0]
            chipLeft += chipWidth + dp(6)
        end if
    end for

    noteText = ""
    if not available
        noteText = tr("Install Moonbase on your server and turn on Enable Plugin.")
    else if chainLookupReturn(pluginInfo, "settingsSyncEnabled", false) <> true
        noteText = tr("Settings sync is turned off on the server.")
    end if
    card.note.text = noteText
    card.note.visible = noteText <> ""

    bottom = pad + dp(64)
    card.chips.visible = names.Count() > 0
    if card.chips.visible
        card.chips.translation = [pad, bottom + dp(12)]
        bottom += dp(12) + chipHeight
    end if
    if card.note.visible
        card.note.translation = [pad, bottom + dp(12)]
        bottom += dp(12) + card.note.boundingRect().height
    end if

    m.statusHeight = bottom + pad
    sizeTile(card, m.width, m.statusHeight)
end sub

sub layoutSync()
    top = m.statusHeight
    placeNode(m.heading, dp(16), top + dp(20), m.width - dp(32), dp(settingsMetrics.HEADER_LINE_DP))
    top += settingsMetrics.HeaderBand()
    m.caption.translation = [dp(16), top]
    m.caption.width = m.width - dp(32)
    m.caption.height = 0
    top += m.caption.boundingRect().height + dp(12)

    m.grid.translation = [0, top]
    top += m.profileHeight * 2 + dp(10)

    ' Load, save and reset sit together on a card of their own
    top += dp(12)
    m.actions.translation = [0, top]
    resetY = dp(12) + m.buttonHeight + dp(8)
    resetHeight = (dp(8) + 1) * 2 + dp(20)
    placeNode(m.actionsFill, 0, top, m.width, resetY + resetHeight + dp(12))

    ' The label names the profile it resets, so it's measured again each time
    label = m.reset.title
    label.width = 0
    label.height = 0
    label.text = Substitute(tr("Reset {0} Profile"), tr(settingsSync.ProfileTitle(settingsSync.ActiveProfile())))
    textWidth = Int(label.boundingRect().width) + 2
    padX = dp(10) + 1
    placeNode(m.reset.icon, padX, 0, dp(20), resetHeight)
    placeNode(label, padX + dp(20) + dp(8), 0, textWidth, resetHeight)
    sizeTile(m.reset, padX * 2 + dp(28) + textWidth, resetHeight)
    m.reset.group.translation = [dp(12), resetY]
end sub

function focusedTile() as object
    row = m.rows[m.row]
    column = m.column
    if column >= row.Count() then column = row.Count() - 1
    return row[column]
end function

sub paintAll()
    p = m.palette
    m.actionsFill.blendColor = p.card.color
    m.actionsFill.opacity = 1.0
    m.heading.color = p.header
    m.caption.color = p.textSoft
    m.titleBar.actionFocused = m.actionFocused

    focusedId = ""
    if not m.actionFocused then focusedId = focusedTile().id
    active = settingsSync.ActiveProfile()
    for each tile in m.tiles
        paintTile(tile, tile.id = focusedId, tile.id = active)
    end for
end sub

' A card fills with the theme's focused colour the way a settings row does, and the profile in use
' keeps an accent outline
sub paintTile(tile as object, focused as boolean, selected as boolean)
    p = m.palette
    tint(tile.glow, invalid)
    if focused and isValid(p.glow) then tint(tile.glow, p.glow)

    strong = p.text
    soft = p.textSoft
    if focused
        strong = p.inkStrong
        soft = p.inkSoft
    end if

    if tile.id = "reset"
        tile.fill.visible = focused
        if focused then tint(tile.fill, p.cardFocus)
        tile.icon.color = SYNC_RESET_INK
        tile.title.color = SYNC_RESET_INK
        if focused
            tile.icon.color = SYNC_RESET_FOCUS_INK
            tile.title.color = SYNC_RESET_FOCUS_INK
        end if
        return
    end if

    if focused
        tint(tile.fill, p.cardFocus)
        tile.stroke.uri = p.images.cardStroke
        tint(tile.stroke, p.strokeFocus)
    else if tile.action = "profile" and selected
        tint(tile.fill, p.tile)
        tile.stroke.uri = "pkg:/images/settings/card27s2.9.png"
        tint(tile.stroke, { color: p.trackOn.color, opacity: 1.0 })
    else if tile.action = "load" or tile.action = "save"
        tint(tile.fill, p.trackOff)
        tile.stroke.visible = false
    else
        tint(tile.fill, p.card)
        tile.stroke.uri = p.images.cardStroke
        tint(tile.stroke, p.stroke)
    end if

    tile.title.color = strong
    tile.subtitle.color = soft
    tile.icon.color = soft
    if (tile.action = "load" or tile.action = "save" or (tile.action = "profile" and selected)) and not focused then tile.icon.color = p.header

    if tile.id = "status"
        if focused
            tint(tile.tileFill, p.tileFocus)
            tint(tile.tileStroke, p.tileStrokeFocus)
        else
            tint(tile.tileFill, p.tile)
            tint(tile.tileStroke, p.tileStroke)
            tile.icon.color = p.glyph
        end if
        tile.switchLabel.color = soft
        if tile.syncOn
            tint(tile.track, p.trackOn)
            tile.outline.visible = false
            tint(tile.thumb, p.thumbOn)
        else
            tint(tile.track, p.trackOff)
            tint(tile.outline, p.outline)
            tint(tile.thumb, p.thumbOff)
        end if
        for each chip in tile.chipList
            chip.fill.blendColor = SYNC_CHIP_INK
            chip.fill.opacity = 0.12
            chip.stroke.blendColor = SYNC_CHIP_INK
            chip.stroke.opacity = 0.33
            chip.label.color = strong
            if focused
                chip.fill.blendColor = "0x000000FF"
                chip.fill.opacity = 0.06
                chip.stroke.blendColor = "0x000000FF"
                chip.stroke.opacity = 0.2
            end if
        end for
        tile.note.color = soft
    end if
end sub

' ===== Keys =====

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.BACK)
        close()
        return true
    end if

    ' The title bar's refresh sits above the first card
    if m.actionFocused
        if isStringEqual(key, KeyCode.OK) then m.top.refreshRequested = true
        if isStringEqual(key, KeyCode.DOWN)
            m.actionFocused = false
            paintAll()
        end if
        return true
    end if

    if isStringEqual(key, KeyCode.UP) and m.row = 0
        m.actionFocused = true
        paintAll()
        return true
    end if
    if isStringEqual(key, KeyCode.UP) then return moveRow(-1)
    if isStringEqual(key, KeyCode.DOWN) then return moveRow(1)
    if isStringEqual(key, KeyCode.LEFT) then return moveColumn(0)
    if isStringEqual(key, KeyCode.RIGHT) then return moveColumn(1)

    if isStringEqual(key, KeyCode.OK)
        activate(focusedTile())
        return true
    end if

    return false
end function

' The column is kept across single rows, so coming back to a pair lands on the side it left from
function moveRow(direction as integer) as boolean
    target = m.row + direction
    if target >= 0 and target < m.rows.Count()
        m.row = target
        paintAll()
    end if

    return true
end function

function moveColumn(column as integer) as boolean
    if m.rows[m.row].Count() > 1 and m.column <> column
        m.column = column
        paintAll()
    end if

    return true
end function

' Nothing new starts while a load, save or reset is still running
sub activate(tile as object)
    if m.busy then return

    if tile.action = "toggle"
        toggleSync()
    else if tile.action = "profile"
        chooseProfile(tile.profile)
    else if tile.action = "load"
        runTask("loadProfile", "load")
    else if tile.action = "save"
        runTask("saveProfile", "save")
    else if tile.action = "reset"
        confirmReset()
    end if
end sub

sub toggleSync()
    newValue = "true"
    if syncSwitchOn() then newValue = "false"
    set_user_setting("plugin.settingsSync", newValue)
    refresh()
end sub

' The user's own switch, apart from whether the server allows sync at all
function syncSwitchOn() as boolean
    return settingsSync.ToBooleanValue(chainLookupReturn(m.global.session, "user.settings.`plugin.settingsSync`", true), true)
end function

sub chooseProfile(profileId as string)
    settingsSync.PickProfile(profileId)
    refresh()
end sub

' ===== Load, save and reset =====

sub confirmReset()
    profileId = settingsSync.ActiveProfile()
    message = tr("The server forgets what this profile holds, and every synced setting on this device goes back to its default.")
    if profileId = "global"
        message = tr("The server forgets every profile it holds for you, and every synced setting on this device goes back to its default.")
    end if

    m.resetPrompt = CreateObject("roSGNode", "ListPromptDialog")
    m.resetPrompt.dialogTitle = Substitute(tr("Reset the {0} profile?"), tr(settingsSync.ProfileTitle(profileId)))
    m.resetPrompt.message = message
    m.resetPrompt.options = [tr("Cancel"), tr("Reset")]
    m.resetPrompt.returnFocus = m.top
    m.resetPrompt.observeField("optionSelected", "onResetChosen")

    m.top.getScene().appendChild(m.resetPrompt)
    m.resetPrompt.callFunc("showDialog")
end sub

' The prompt hands the focus back to this panel before it says what was chosen
sub onResetChosen(event as object)
    chosen = event.getData()
    m.resetPrompt.unobserveField("optionSelected")
    scene = m.top.getScene()
    if isValid(scene) then scene.removeChild(m.resetPrompt)
    m.resetPrompt = invalid

    if chosen = 1 then runTask("resetProfile", "reset")
end sub

sub runTask(functionName as string, action as string)
    m.busy = true
    m.loading.active = true
    m.taskAction = action
    m.taskProfile = settingsSync.ActiveProfile()

    if isValid(m.task) then m.task.unobserveField("result")
    m.task = CreateObject("roSGNode", "SettingsSyncTask")
    m.task.observeField("result", "onTaskDone")
    m.task.functionName = functionName
    m.task.control = "RUN"
end sub

' The finished task stays referenced, since a pull can leave a request of its own running
sub onTaskDone(event as object)
    ok = chainLookupReturn(event.getData(), "ok", false) = true
    m.busy = false
    m.loading.active = false

    profileTitle = tr(settingsSync.ProfileTitle(m.taskProfile))
    message = ""
    if m.taskAction = "load"
        message = tr("Couldn't load settings from the server")
        if ok then message = Substitute(tr("Loaded the {0} profile"), profileTitle)
    else if m.taskAction = "save"
        message = tr("Couldn't save settings to the server")
        if ok then message = Substitute(tr("Saved to the {0} profile"), profileTitle)
    else
        message = Substitute(tr("Couldn't reset the {0} profile"), profileTitle)
        if ok then message = Substitute(tr("Reset the {0} profile"), profileTitle)
    end if
    m.top.message = message

    if ok and m.taskAction <> "save" then m.top.applied = m.top.applied + 1
    if m.isOpen then refresh()
end sub

' A load, save or reset still running carries on, since the screen behind keeps this panel
sub close()
    m.isOpen = false
    m.top.closed = true
end sub

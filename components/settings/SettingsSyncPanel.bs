import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/session.bs"
import "pkg:/source/utils/settingsSync.bs"
import "pkg:/source/utils/themeChrome.bs"

' Sized to the settings panel this one covers
const SYNC_CONTENT_WIDTH = 752
const SYNC_TITLE_SIZE = 40
const SYNC_CONTENT_TOP = 120

const SYNC_TILE_FILL = "pkg:/images/whatsnew/fill24.9.png"
const SYNC_TILE_OUTLINE = "pkg:/images/whatsnew/stroke24w3.9.png"
const SYNC_BADGE_FILL = "pkg:/images/livetv/fill28.9.png"
const SYNC_CHIP_FILL = "pkg:/images/details/btnaction22.9.png"
const SYNC_CHIP_BORDER = "pkg:/images/details/btnactionborder22.9.png"
const SYNC_DOT = "pkg:/images/icons/circle.png"

const SYNC_CARD_PAD = 24
const SYNC_BADGE_SIZE = 88
const SYNC_SWITCH_SIZE = 96
const SYNC_SWITCH_LABEL_WIDTH = 120
const SYNC_CHIP_HEIGHT = 44
const SYNC_CHIP_PAD_X = 20
const SYNC_CHIP_GAP = 12
const SYNC_LINE_GAP = 16

const SYNC_HEADING_GAP = 32
const SYNC_HEADING_LINE = 30
const SYNC_CAPTION_GAP = 8
const SYNC_GRID_GAP = 20
const SYNC_PROFILE_HEIGHT = 120
const SYNC_ACTIONS_GAP = 24
const SYNC_ACTIONS_PAD = 20
const SYNC_BUTTON_HEIGHT = 112
const SYNC_RESET_GAP = 12
const SYNC_RESET_HEIGHT = 64

const SYNC_ICON_SIZE = 48
const SYNC_ICON_LEFT = 24
const SYNC_TEXT_LEFT = 88
const SYNC_NAME_SIZE = 28
const SYNC_NAME_LINE = 38
const SYNC_DETAIL_SIZE = 22
const SYNC_DETAIL_LINE = 30
const SYNC_DOT_SIZE = 12
const SYNC_DOT_GAP = 10

const SYNC_CONNECTED_INK = "#22C55E"
const SYNC_THIS_DEVICE_INK = "#86EFAC"
const SYNC_RESET_INK = "#CF6679"
const SYNC_DETAIL_INK = "#FFFFFFA6"

sub init()
    m.panel = m.top.findNode("panel")
    m.background = m.top.findNode("background")
    m.title = m.top.findNode("title")
    m.content = m.top.findNode("content")
    m.syncSection = m.top.findNode("syncSection")
    m.heading = m.top.findNode("profileHeading")
    m.caption = m.top.findNode("profileCaption")
    m.actionsFill = m.top.findNode("actionsFill")
    m.loading = m.top.findNode("loading")

    m.title.font.size = SYNC_TITLE_SIZE
    m.title.text = tr("Settings Sync")
    m.heading.font.size = SYNC_DETAIL_SIZE
    m.heading.height = SYNC_HEADING_LINE
    m.heading.text = UCase(tr("Profile"))
    m.caption.font.size = SYNC_DETAIL_SIZE
    m.caption.width = SYNC_CONTENT_WIDTH - 16
    m.caption.text = tr("This device syncs with the profile you pick until you pick another.")

    m.tiles = []
    buildStatusCard()
    buildProfiles()
    buildActions()

    m.busy = false
    m.isOpen = false
end sub

sub showDialog()
    m.isOpen = true
    m.row = 0
    m.column = 0
    m.loading.active = m.busy
    refresh()
    m.top.setFocus(true)
end sub

' ===== Building =====

' Something the focus can land on: a fill, an outline that only shows with the focus, an icon,
' and a name over a line of detail with room for a dot in front of it
function addTile(parent as object, id as string, iconUri as string) as object
    group = parent.createChild("Group")
    fill = group.createChild("Poster")
    outline = group.createChild("Poster")
    icon = group.createChild("Poster")
    name = group.createChild("Label")
    detail = group.createChild("Label")
    dot = group.createChild("Poster")

    fill.uri = SYNC_TILE_FILL
    outline.uri = SYNC_TILE_OUTLINE
    icon.uri = iconUri
    icon.width = SYNC_ICON_SIZE
    icon.height = SYNC_ICON_SIZE
    name.font = "font:SmallBoldSystemFont"
    name.font.size = SYNC_NAME_SIZE
    name.vertAlign = "center"
    detail.font = "font:SmallSystemFont"
    detail.font.size = SYNC_DETAIL_SIZE
    detail.vertAlign = "center"
    dot.uri = SYNC_DOT
    dot.width = SYNC_DOT_SIZE
    dot.height = SYNC_DOT_SIZE
    dot.blendColor = SYNC_CONNECTED_INK
    dot.visible = false

    tile = { id: id, group: group, fill: fill, outline: outline, icon: icon, title: name, subtitle: detail, dot: dot, rest: {} }
    m.tiles.push(tile)
    return tile
end function

sub sizeTile(tile as object, width as integer, height as integer)
    for each layer in [tile.fill, tile.outline]
        layer.width = width
        layer.height = height
    end for
end sub

' The name sits over the detail, the pair centred on the icon beside them
sub placeText(tile as object, left as integer, top as integer, width as integer)
    tile.title.translation = [left, top]
    tile.title.width = width
    tile.title.height = SYNC_NAME_LINE
    tile.subtitle.translation = [left, top + SYNC_NAME_LINE]
    tile.subtitle.width = width
    tile.subtitle.height = SYNC_DETAIL_LINE
    tile.dot.translation = [left, top + SYNC_NAME_LINE + ((SYNC_DETAIL_LINE - SYNC_DOT_SIZE) / 2)]
end sub

' Shows or hides the dot in front of the detail, moving the detail to make room
sub showDot(tile as object, shown as boolean)
    left = tile.dot.translation[0]
    width = tile.title.width
    if shown
        left += SYNC_DOT_SIZE + SYNC_DOT_GAP
        width -= SYNC_DOT_SIZE + SYNC_DOT_GAP
    end if

    tile.dot.visible = shown
    tile.subtitle.translation = [left, tile.subtitle.translation[1]]
    tile.subtitle.width = width
end sub

sub buildStatusCard()
    card = addTile(m.content, "status", "pkg:/images/achievements/extension.png")
    card.action = "toggle"

    ' The tile behind the plug sits under its icon
    badge = CreateObject("roSGNode", "Poster")
    badge.uri = SYNC_BADGE_FILL
    badge.width = SYNC_BADGE_SIZE
    badge.height = SYNC_BADGE_SIZE
    badge.translation = [SYNC_CARD_PAD, SYNC_CARD_PAD]
    card.group.insertChild(badge, 2)
    card.badge = badge

    iconInset = Int((SYNC_BADGE_SIZE - SYNC_ICON_SIZE) / 2)
    card.icon.translation = [SYNC_CARD_PAD + iconInset, SYNC_CARD_PAD + iconInset]

    switchLeft = SYNC_CONTENT_WIDTH - SYNC_CARD_PAD - SYNC_SWITCH_LABEL_WIDTH
    textLeft = SYNC_CARD_PAD + SYNC_BADGE_SIZE + SYNC_CARD_PAD
    textTop = SYNC_CARD_PAD + Int((SYNC_BADGE_SIZE - SYNC_NAME_LINE - SYNC_DETAIL_LINE) / 2)
    placeText(card, textLeft, textTop, switchLeft - textLeft - SYNC_LINE_GAP)
    card.title.font.size = 30
    card.title.text = "Moonbase"

    ' The switch's pill and its label sit as one block, level with the badge
    card.switch = card.group.createChild("Poster")
    card.switch.width = SYNC_SWITCH_SIZE
    card.switch.height = SYNC_SWITCH_SIZE
    card.switch.translation = [switchLeft + ((SYNC_SWITCH_LABEL_WIDTH - SYNC_SWITCH_SIZE) / 2), SYNC_CARD_PAD - 20]

    card.switchLabel = card.group.createChild("Label")
    card.switchLabel.font = "font:SmallBoldSystemFont"
    card.switchLabel.font.size = 20
    card.switchLabel.horizAlign = "center"
    card.switchLabel.width = SYNC_SWITCH_LABEL_WIDTH
    card.switchLabel.height = 26
    card.switchLabel.translation = [switchLeft, SYNC_CARD_PAD + 57]
    card.switchLabel.color = "#FFFFFFB3"

    card.chips = card.group.createChild("Group")
    card.chipList = []
    for i = 1 to 3
        chipGroup = card.chips.createChild("Group")
        chip = {
            group: chipGroup,
            fill: chipGroup.createChild("Poster"),
            border: chipGroup.createChild("Poster"),
            label: chipGroup.createChild("Label")
        }
        chip.fill.uri = SYNC_CHIP_FILL
        chip.fill.opacity = 0.12
        chip.border.uri = SYNC_CHIP_BORDER
        chip.border.opacity = 0.33
        chip.label.font = "font:SmallSystemFont"
        chip.label.font.size = 20
        chip.label.color = "#FFFFFF"
        card.chipList.push(chip)
    end for

    card.note = card.group.createChild("Label")
    card.note.font = "font:SmallSystemFont"
    card.note.font.size = SYNC_DETAIL_SIZE
    card.note.color = "#FFFFFFB3"
    card.note.wrap = true
    card.note.width = SYNC_CONTENT_WIDTH - (SYNC_CARD_PAD * 2)

    m.status = card
end sub

' Each profile with its icon and what it does. The one this device follows by default says so
' instead.
function profileChoices() as object
    return [
        { name: "global", icon: "pkg:/images/achievements/public.png", detail: "Applies everywhere" },
        { name: "desktop", icon: "pkg:/images/icons/desktop_windows.png", detail: "Overrides Global" },
        { name: "mobile", icon: "pkg:/images/achievements/phone_iphone.png", detail: "Overrides Global" },
        { name: "tv", icon: "pkg:/images/achievements/tv.png", detail: "Overrides Global" }
    ]
end function

sub buildProfiles()
    m.grid = m.syncSection.createChild("Group")
    m.profiles = []

    cardWidth = Int((SYNC_CONTENT_WIDTH - SYNC_GRID_GAP) / 2)
    textTop = Int((SYNC_PROFILE_HEIGHT - SYNC_NAME_LINE - SYNC_DETAIL_LINE) / 2)
    index = 0
    for each choice in profileChoices()
        tile = addTile(m.grid, choice.name, choice.icon)
        tile.action = "profile"
        tile.profile = choice.name
        sizeTile(tile, cardWidth, SYNC_PROFILE_HEIGHT)
        tile.group.translation = [(index mod 2) * (cardWidth + SYNC_GRID_GAP), Int(index / 2) * (SYNC_PROFILE_HEIGHT + SYNC_GRID_GAP)]
        tile.icon.translation = [SYNC_ICON_LEFT, (SYNC_PROFILE_HEIGHT - SYNC_ICON_SIZE) / 2]
        placeText(tile, SYNC_TEXT_LEFT, textTop, cardWidth - SYNC_TEXT_LEFT - SYNC_LINE_GAP)
        tile.title.text = tr(settingsSync.ProfileTitle(choice.name))

        tile.isDevice = choice.name = settingsSync.DEVICE_PROFILE
        if tile.isDevice
            tile.subtitle.text = tr("This device")
            showDot(tile, true)
        else
            tile.subtitle.text = tr(choice.detail)
        end if

        m.profiles.push(tile)
        index++
    end for
end sub

sub buildActions()
    m.actions = m.syncSection.createChild("Group")

    buttonWidth = Int((SYNC_CONTENT_WIDTH - (SYNC_ACTIONS_PAD * 2) - SYNC_GRID_GAP) / 2)
    textTop = Int((SYNC_BUTTON_HEIGHT - SYNC_NAME_LINE - SYNC_DETAIL_LINE) / 2)
    buttons = [
        { id: "load", icon: "pkg:/images/icons/cloud_download.png", name: tr("Load"), detail: tr("Server to this device") },
        { id: "save", icon: "pkg:/images/icons/cloud_upload.png", name: tr("Save"), detail: tr("This device to server") }
    ]
    for i = 0 to buttons.count() - 1
        spec = buttons[i]
        tile = addTile(m.actions, spec.id, spec.icon)
        tile.action = spec.id
        sizeTile(tile, buttonWidth, SYNC_BUTTON_HEIGHT)
        tile.group.translation = [SYNC_ACTIONS_PAD + (i * (buttonWidth + SYNC_GRID_GAP)), SYNC_ACTIONS_PAD]
        tile.icon.translation = [SYNC_ICON_LEFT, (SYNC_BUTTON_HEIGHT - SYNC_ICON_SIZE) / 2]
        placeText(tile, SYNC_TEXT_LEFT, textTop, buttonWidth - SYNC_TEXT_LEFT - SYNC_LINE_GAP)
        tile.title.text = spec.name
        tile.subtitle.text = spec.detail
        if i = 0 then m.load = tile else m.save = tile
    end for

    ' A line of red text that only takes a fill with the focus
    m.reset = addTile(m.actions, "reset", "pkg:/images/achievements/replay.png")
    m.reset.action = "reset"
    m.reset.group.translation = [SYNC_ACTIONS_PAD, SYNC_ACTIONS_PAD + SYNC_BUTTON_HEIGHT + SYNC_RESET_GAP]
    m.reset.icon.width = 36
    m.reset.icon.height = 36
    m.reset.icon.translation = [16, (SYNC_RESET_HEIGHT - 36) / 2]
    m.reset.title.font.size = 26
    m.reset.subtitle.visible = false
end sub

' ===== Drawing =====

' Lays the panel out for where the plugin and the switch stand now and repaints the focus
sub refresh()
    ' A theme font replaces each label's font, so nothing is measured until it has. The panel is
    ' kept between openings, and a load can bring a different font with it.
    fontApply.ApplyThemeFonts(m.panel, true)

    accent = themeChrome.Accent()
    m.focusFill = themeChrome.DeepenForLightInk(accent)
    cardInk = themeChrome.Token("surfaceVariant", "#1A1A1AFF")
    m.background.color = "#101010"
    if themeChrome.IsActive() then m.background.color = themeChrome.Surface()

    layoutStatus(accent, cardInk)

    showSync = settingsSync.IsSyncEnabled()
    m.syncSection.visible = showSync
    m.rows = [[m.status]]
    if showSync
        layoutSync(accent, cardInk)
        m.rows.push([m.profiles[0], m.profiles[1]])
        m.rows.push([m.profiles[2], m.profiles[3]])
        m.rows.push([m.load, m.save])
        m.rows.push([m.reset])
    end if

    if m.row >= m.rows.count() then m.row = m.rows.count() - 1
    paintAll()
end sub

sub layoutStatus(accent as string, cardInk as string)
    card = m.status
    pluginInfo = chainLookupReturn(m.global, "session.pluginInfo", {})
    available = moonfinPlugin.IsEnabled()
    syncOn = syncSwitchOn()

    if available
        card.subtitle.text = Substitute(tr("Connected, version {0}"), chainLookupReturn(pluginInfo, "version", "").toStr())
    else
        card.subtitle.text = tr("Plugin Not Detected")
    end if
    showDot(card, available)

    card.switch.uri = "pkg:/images/icons/settings/toggle_off.png"
    card.switchLabel.text = tr("Sync off")
    if syncOn
        card.switch.uri = "pkg:/images/icons/settings/toggle_on.png"
        card.switchLabel.text = tr("Sync on")
    end if

    ' What the plugin offers on this server, each in a chip of its own
    names = []
    if available
        if chainLookupReturn(pluginInfo, "mdblistAvailable", false) = true then names.push("MDBList")
        if chainLookupReturn(pluginInfo, "tmdbAvailable", false) = true then names.push("TMDB")
        if chainLookupReturn(pluginInfo, "seerrEnabled", false) = true then names.push("Seerr")
    end if

    chipInk = themeChrome.WithAlpha(themeChrome.InputBorder(), "FF")
    chipLeft = 0
    for i = 0 to card.chipList.count() - 1
        chip = card.chipList[i]
        chip.group.visible = i < names.count()
        if chip.group.visible
            chip.label.width = 0
            chip.label.height = 0
            chip.label.text = names[i]
            ' Rounded up, since a label a fraction too narrow cuts its text short
            textWidth = Int(chip.label.boundingRect().width) + 2
            chipWidth = textWidth + (SYNC_CHIP_PAD_X * 2)
            chip.label.width = textWidth
            chip.label.height = SYNC_CHIP_HEIGHT
            chip.label.vertAlign = "center"
            chip.label.translation = [SYNC_CHIP_PAD_X, 0]
            for each layer in [chip.fill, chip.border]
                layer.width = chipWidth
                layer.height = SYNC_CHIP_HEIGHT
                layer.blendColor = chipInk
            end for
            chip.group.translation = [chipLeft, 0]
            chipLeft += chipWidth + SYNC_CHIP_GAP
        end if
    end for

    noteText = ""
    if not available
        noteText = tr("Install Moonbase on your server and turn on Enable Plugin.")
    else if chainLookupReturn(pluginInfo, "settingsSyncEnabled", false) <> true
        noteText = tr("Settings sync is turned off on the server.")
    end if
    card.note.text = noteText
    card.note.visible = noteText <> ""

    bottom = SYNC_CARD_PAD + SYNC_BADGE_SIZE
    card.chips.visible = names.count() > 0
    if card.chips.visible
        card.chips.translation = [SYNC_CARD_PAD, bottom + SYNC_LINE_GAP]
        bottom += SYNC_LINE_GAP + SYNC_CHIP_HEIGHT
    end if
    if card.note.visible
        card.note.translation = [SYNC_CARD_PAD, bottom + SYNC_LINE_GAP]
        bottom += SYNC_LINE_GAP + Int(card.note.boundingRect().height)
    end if

    m.statusHeight = bottom + SYNC_CARD_PAD
    sizeTile(card, SYNC_CONTENT_WIDTH, m.statusHeight)
    card.group.translation = [0, SYNC_CONTENT_TOP]

    card.badge.blendColor = accent
    card.badge.opacity = 0.18
    card.rest = { fill: cardInk, fillOpacity: 1.0, outline: "", outlineOpacity: 0.0, icon: accent, title: "#FFFFFF", subtitle: "#FFFFFFB3" }
end sub

sub layoutSync(accent as string, cardInk as string)
    top = SYNC_CONTENT_TOP + m.statusHeight + SYNC_HEADING_GAP
    m.heading.color = accent
    m.heading.translation = [8, top]
    top += SYNC_HEADING_LINE + SYNC_CAPTION_GAP
    m.caption.translation = [8, top]
    top += Int(m.caption.boundingRect().height) + SYNC_GRID_GAP

    m.grid.translation = [0, top]
    top += (SYNC_PROFILE_HEIGHT * 2) + SYNC_GRID_GAP + SYNC_ACTIONS_GAP

    active = settingsSync.ActiveProfile()
    for each tile in m.profiles
        detailInk = SYNC_DETAIL_INK
        if tile.isDevice then detailInk = SYNC_THIS_DEVICE_INK
        if tile.profile = active
            tile.rest = { fill: accent, fillOpacity: 0.14, outline: accent, outlineOpacity: 1.0, icon: accent, title: "#FFFFFF", subtitle: detailInk }
        else
            tile.rest = { fill: cardInk, fillOpacity: 1.0, outline: "#FFFFFF", outlineOpacity: 0.08, icon: "#FFFFFFBF", title: "#FFFFFF", subtitle: detailInk }
        end if
    end for

    m.actions.translation = [0, top]
    actionsHeight = SYNC_ACTIONS_PAD + SYNC_BUTTON_HEIGHT + SYNC_RESET_GAP + SYNC_RESET_HEIGHT + SYNC_LINE_GAP
    m.actionsFill.translation = [0, top]
    m.actionsFill.width = SYNC_CONTENT_WIDTH
    m.actionsFill.height = actionsHeight
    m.actionsFill.blendColor = cardInk

    buttonInk = themeChrome.Token("buttonNormal", "#2A2A2AFF")
    for each button in [m.load, m.save]
        button.rest = { fill: buttonInk, fillOpacity: 1.0, outline: "", outlineOpacity: 0.0, icon: accent, title: "#FFFFFF", subtitle: SYNC_DETAIL_INK }
    end for

    ' The label names the profile it resets, so it is measured again each time
    label = m.reset.title
    label.width = 0
    label.height = 0
    label.text = Substitute(tr("Reset {0} Profile"), tr(settingsSync.ProfileTitle(active)))
    textWidth = Int(label.boundingRect().width) + 2
    label.translation = [64, 0]
    label.width = textWidth
    label.height = SYNC_RESET_HEIGHT
    sizeTile(m.reset, 64 + textWidth + SYNC_CARD_PAD, SYNC_RESET_HEIGHT)
    m.reset.rest = { fill: "", fillOpacity: 0.0, outline: "", outlineOpacity: 0.0, icon: SYNC_RESET_INK, title: SYNC_RESET_INK, subtitle: SYNC_RESET_INK }
end sub

function focusedTile() as object
    row = m.rows[m.row]
    column = m.column
    if column >= row.count() then column = row.count() - 1
    return row[column]
end function

sub paintAll()
    focusedId = focusedTile().id
    for each tile in m.tiles
        paintTile(tile, tile.id = focusedId)
    end for
end sub

' The focus looks the way it does on the settings rows, a fill in the accent deepened until
' light text reads on it, with an outline around it
sub paintTile(tile as object, focused as boolean)
    style = tile.rest
    if focused
        style = { fill: m.focusFill, fillOpacity: 1.0, outline: "#FFFFFF", outlineOpacity: 1.0, icon: "#FFFFFF", title: "#FFFFFFF5", subtitle: "#FFFFFFC7" }
    end if
    if style.count() = 0 then return

    tile.fill.visible = style.fill <> ""
    if tile.fill.visible
        tile.fill.blendColor = style.fill
        tile.fill.opacity = style.fillOpacity
    end if

    tile.outline.visible = style.outline <> ""
    if tile.outline.visible
        tile.outline.blendColor = style.outline
        tile.outline.opacity = style.outlineOpacity
    end if

    tile.icon.blendColor = style.icon
    tile.title.color = style.title
    tile.subtitle.color = style.subtitle
end sub

' ===== Keys =====

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.BACK)
        close()
        return true
    end if

    if isStringEqual(key, KeyCode.UP) then return moveRow(-1)
    if isStringEqual(key, KeyCode.DOWN) then return moveRow(1)
    if isStringEqual(key, KeyCode.LEFT) then return moveColumn(0)
    if isStringEqual(key, KeyCode.RIGHT) then return moveColumn(1)

    if isStringEqual(key, KeyCode.OK)
        activate(focusedTile())
        return true
    end if

    return false
end function

' The column is kept across single rows, so coming back to a pair lands on the side it left from
function moveRow(direction as integer) as boolean
    target = m.row + direction
    if target >= 0 and target < m.rows.count()
        m.row = target
        paintAll()
    end if

    return true
end function

function moveColumn(column as integer) as boolean
    if m.rows[m.row].count() > 1 and m.column <> column
        m.column = column
        paintAll()
    end if

    return true
end function

' Nothing new starts while a load, save or reset is still running
sub activate(tile as object)
    if m.busy then return

    if tile.action = "toggle"
        toggleSync()
    else if tile.action = "profile"
        chooseProfile(tile.profile)
    else if tile.action = "load"
        runTask("loadProfile", "load")
    else if tile.action = "save"
        runTask("saveProfile", "save")
    else if tile.action = "reset"
        confirmReset()
    end if
end sub

sub toggleSync()
    newValue = "true"
    if syncSwitchOn() then newValue = "false"
    set_user_setting("plugin.settingsSync", newValue)
    refresh()
end sub

' The user's own switch, apart from whether the server allows sync at all
function syncSwitchOn() as boolean
    return settingsSync.ToBooleanValue(chainLookupReturn(m.global.session, "user.settings.`plugin.settingsSync`", true), true)
end function

sub chooseProfile(profileId as string)
    settingsSync.PickProfile(profileId)
    refresh()
end sub

' ===== Load, save and reset =====

sub confirmReset()
    profileId = settingsSync.ActiveProfile()
    message = tr("The server forgets what this profile holds, and every synced setting on this device goes back to its default.")
    if profileId = "global"
        message = tr("The server forgets every profile it holds for you, and every synced setting on this device goes back to its default.")
    end if

    m.resetPrompt = CreateObject("roSGNode", "ListPromptDialog")
    m.resetPrompt.dialogTitle = Substitute(tr("Reset the {0} profile?"), tr(settingsSync.ProfileTitle(profileId)))
    m.resetPrompt.message = message
    m.resetPrompt.options = [tr("Cancel"), tr("Reset")]
    m.resetPrompt.returnFocus = m.top
    m.resetPrompt.observeField("optionSelected", "onResetChosen")

    m.top.getScene().appendChild(m.resetPrompt)
    m.resetPrompt.callFunc("showDialog")
end sub

' The prompt hands the focus back to this panel before it says what was chosen
sub onResetChosen(event as object)
    chosen = event.getData()
    m.resetPrompt.unobserveField("optionSelected")
    scene = m.top.getScene()
    if isValid(scene) then scene.removeChild(m.resetPrompt)
    m.resetPrompt = invalid

    if chosen = 1 then runTask("resetProfile", "reset")
end sub

sub runTask(functionName as string, action as string)
    m.busy = true
    m.loading.active = true
    m.taskAction = action
    m.taskProfile = settingsSync.ActiveProfile()

    if isValid(m.task) then m.task.unobserveField("result")
    m.task = CreateObject("roSGNode", "SettingsSyncTask")
    m.task.observeField("result", "onTaskDone")
    m.task.functionName = functionName
    m.task.control = "RUN"
end sub

' The finished task stays referenced, since a pull can leave a request of its own running
sub onTaskDone(event as object)
    ok = chainLookupReturn(event.getData(), "ok", false) = true
    m.busy = false
    m.loading.active = false

    profileTitle = tr(settingsSync.ProfileTitle(m.taskProfile))
    message = ""
    if m.taskAction = "load"
        message = tr("Couldn't load settings from the server")
        if ok then message = Substitute(tr("Loaded the {0} profile"), profileTitle)
    else if m.taskAction = "save"
        message = tr("Couldn't save settings to the server")
        if ok then message = Substitute(tr("Saved to the {0} profile"), profileTitle)
    else
        message = Substitute(tr("Couldn't reset the {0} profile"), profileTitle)
        if ok then message = Substitute(tr("Reset the {0} profile"), profileTitle)
    end if
    m.top.message = message

    if ok and m.taskAction <> "save" then m.top.applied = m.top.applied + 1
    if m.isOpen then refresh()
end sub

' A load, save or reset still running carries on, since the screen behind keeps this panel
sub close()
    m.isOpen = false
    m.top.closed = true
end sub

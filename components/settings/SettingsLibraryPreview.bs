import "pkg:/components/settings/settingsMusicPreview.bs"
import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/libraryPreview.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/ratingsRow.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/trackDialog.bs"

' The real screen's measurements on its 1920x1080 canvas
const MARGIN_X = 87
const CLASSIC_BUTTON_SIZE = 44
const CLASSIC_BUTTON_GAP = 3
const CLASSIC_BAR_TOP = 248
const MODERN_BAR_TOP = 80
const MODERN_BAR_HEIGHT = 84
const MODERN_BAR_PAD = 9
const MODERN_CONTROL_GAP = 6
const DOCK_PAD_X = 30
const DOCK_ROW_WIDTH = 390
const DOCK_TITLE_LEFT = 105
const DOCK_ROW_HEIGHT = 72
const HEADER_CONTROL_HEIGHT = 66
const PILL_PAD_X = 18
const PILL_HEIGHT = 26
const CARD_TITLE_SIZE = 19
const CARD_SUBTITLE_SIZE = 17
const CARD_TITLE_LINE = 23
const CARD_TEXT_GAP = 4
const LETTERS = "#ABCDEFGHIJKLMNOPQRSTUVWXYZ"

sub redraw()
    m.top.removeChildrenIndex(m.top.getChildCount(), 0)
    look = m.top.look
    ' The page is left unset while it loads, which reads back as invalid
    page = m.top.page ?? {}
    ' Quick Access and Immersive have pages of their own, and Classic music is this grid
    m.music = look.music = true
    if m.music and look.musicStyle <> "classic"
        drawStyledMusic(look, page)
        return
    end if
    loaded = isValid(page.items)
    items = []
    if loaded then items = page.items
    if not loaded then page = { imagePick: "", letters: true, sortLabel: tr("Name"), sortOrder: "Ascending", playedLabel: tr("All"), groupLabel: tr("None"), total: 0 }

    styleName = look.style
    if not inArray(["classic", "modern", "docked"], styleName) then styleName = "classic"
    area = libraryPreview.Frame(styleName)
    settings = chainLookupReturn(m.global.session, "user.settings", {})
    json = invalid
    if items.count() > 0 then json = items[0].json

    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "#000018")
    if look.showBackdrops = true and isValid(json) then drawBackdrop(json)
    ' The real screen's tint, copied as it is written there
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "#F2000000")

    panelInk = trackDialog.PANEL_INK
    if themeChrome.IsActive() then panelInk = themeChrome.Surface()
    if styleName = "docked" then drawDockPanel(panelInk)
    if styleName = "modern" then drawModernBar(panelInk)

    drawTitle(styleName, look.name ?? "", page.total)
    if look.showDetails = true and isValid(json) then drawFocusedInfo(styleName, area, json, settings)

    if styleName = "classic"
        drawClassicControls(page)
    else if styleName = "modern"
        drawModernControls(page)
    else
        drawDockedControls(page)
    end if

    if loaded and items.count() = 0
        empty = setupPreviewDraw.TextLabel(m.top, tr("No items found. Try adjusting your selected filters."), 0, 540, 38, "#aaaaaa", false)
        empty.width = 1920
        empty.height = 64
        empty.horizAlign = "center"
        empty.vertAlign = "center"
    end if
    drawGrid(area, items, look, page, settings)
end sub

' The focused title's backdrop, blurred the way the real screen asks for it and drawn in this copy
' alone, so the app's own backdrop is left as it is
sub drawBackdrop(json as object)
    uri = ""
    params = { "maxHeight": 1080, "maxWidth": 1920, "quality": 90, "blur": getHomeBackdropBlurAmount() }
    if isValidAndNotEmpty(json.BackdropImageTags)
        params["Tag"] = json.BackdropImageTags[0]
        uri = ImageURL(json.Id, "Backdrop", params)
    else if isChainValid(json, "ImageTags.Primary")
        params["Tag"] = json.ImageTags.Primary
        uri = ImageURL(json.Id, "Primary", params)
    end if
    if uri = "" then return
    backdrop = m.top.createChild("Poster")
    backdrop.width = 1920
    backdrop.height = 1080
    backdrop.loadDisplayMode = "scaleToFill"
    backdrop.opacity = 0.3
    backdrop.uri = uri
end sub

sub drawDockPanel(panelInk as string)
    panel = setupPreviewDraw.Rect(m.top, 0, 0, 450, 1080, panelInk)
    panel.opacity = trackDialog.PANEL_OPACITY
    edge = setupPreviewDraw.Rect(m.top, 449, 0, 1, 1080, "#FFFFFF")
    edge.opacity = 0.06
end sub

sub drawModernBar(panelInk as string)
    bar = setupPreviewDraw.Round(m.top, MARGIN_X, MODERN_BAR_TOP, libraryCard.GRID_WIDTH, MODERN_BAR_HEIGHT, 20, panelInk)
    bar.opacity = trackDialog.PANEL_OPACITY
    border = setupPreviewDraw.Ring(m.top, MARGIN_X, MODERN_BAR_TOP, libraryCard.GRID_WIDTH, MODERN_BAR_HEIGHT, 20, "#FFFFFF")
    border.opacity = 0.06
end sub

' The name and count read as one centered line, start at the margin in Modern, and stack beside
' Home in Docked
sub drawTitle(styleName as string, name as string, total as integer)
    title = setupPreviewDraw.TextLabel(m.top, name, 0, 20, 38, "#FFFFFF", false)
    countText = ""
    if total = 1 then countText = tr("1 item")
    if total > 1 then countText = tr("{count} items").Replace("{count}", total.ToStr())
    count = setupPreviewDraw.TextLabel(m.top, countText, 0, 22, 17, "#FFFFFF", false)
    count.opacity = 0.4
    for each label in [title, count]
        label.height = 48
        label.vertAlign = "center"
    end for

    if styleName = "docked"
        title.width = DOCK_ROW_WIDTH - DOCK_TITLE_LEFT + DOCK_PAD_X
        title.translation = [DOCK_TITLE_LEFT, 30]
        count.translation = [DOCK_TITLE_LEFT, 66]
        return
    end if
    nameWidth = title.boundingRect().width
    countWidth = count.boundingRect().width
    gap = 0
    if countWidth > 0 then gap = 17
    startX = (1920 - (nameWidth + gap + countWidth)) / 2
    if styleName = "modern" then startX = MARGIN_X
    title.translation = [startX, 20]
    count.translation = [startX + nameWidth + gap, 22]
end sub

' The focused title's name, facts and scores above the grid. The scores are the server's own,
' since the copy asks the plugin for nothing.
sub drawFocusedInfo(styleName as string, area as object, json as object, settings as object)
    info = m.top.createChild("Group")
    info.translation = [MARGIN_X, 84]
    if styleName = "modern" then info.translation = [MARGIN_X, MODERN_BAR_TOP + MODERN_BAR_HEIGHT + 16]
    if styleName = "docked" then info.translation = [area.left, 42]

    name = setupPreviewDraw.TextLabel(info, json.Name ?? "", 0, 0, 29, "#FFFFFF", true)
    name.width = area.width
    name.maxLines = 1

    facts = info.createChild("LayoutGroup")
    facts.layoutDirection = "horiz"
    facts.vertAlignment = "center"
    facts.itemSpacings = [12]
    facts.translation = [0, 41]
    isSeries = isStringEqual(json.Type ?? "", "Series")
    year = ""
    if isValid(json.ProductionYear) then year = json.ProductionYear.ToStr()
    runtime = ""
    if not isSeries then runtime = libraryCard.FormatDuration(json.RunTimeTicks)
    if runtime = "0m" then runtime = ""
    for each fact in [year, runtime]
        label = setupPreviewDraw.TextLabel(facts, fact, 0, 0, 20, "#FFFFFF", false)
        label.opacity = 0.7
    end for
    status = json.Status ?? ""
    if isSeries and status <> ""
        fill = "#EF4444"
        if isStringEqual(status, "Continuing") then fill = "#22C55E"
        drawPill(facts, tr(status), fill, 1)
    end if
    rating = json.OfficialRating ?? ""
    if rating <> "" then drawPill(facts, rating, "#FFFFFF", 0.15)

    scores = { data: ratingsRow.Merge(ratingsRow.ServerEntries(json), []), showNames: true, showBadges: toString(settings["plugin.mdblist.showRatingBadges"]) <> "false" }
    setupPreviewDraw.RatingsLine(info, scores, 0, 72, { iconHeight: 32, valueSize: 24, nameSize: 16, ratingSpacing: 9 })
end sub

' An age rating or series status, only as wide as its words
sub drawPill(parent as object, text as string, fill as string, opacity as float)
    pill = parent.createChild("Group")
    shape = pill.createChild("Poster")
    shape.uri = "pkg:/images/details/badgefill6.9.png"
    shape.blendColor = fill
    shape.opacity = opacity
    label = setupPreviewDraw.TextLabel(pill, text, 0, 0, 16, "#FFFFFF", true)
    width = label.boundingRect().width + PILL_PAD_X
    for each node in [shape, label]
        node.width = width
        node.height = PILL_HEIGHT
    end for
    label.horizAlign = "center"
    label.vertAlign = "center"
end sub

function headerButton(icon as string, x as float, y as float, args as object) as object
    button = m.top.createChild("LibraryHeaderButton")
    button.icon = icon
    button.callFunc("layout", args)
    button.translation = [x, y]
    return button
end function

function searchBox(x as float, y as float, width as float) as object
    field = m.top.createChild("SearchBox")
    field.placeholder = tr("Search this library...")
    field.boxHeight = HEADER_CONTROL_HEIGHT
    field.boxWidth = width
    field.translation = [x, y]
    return field
end function

' Classic's icons in a line over the grid with the letters after them, and the search up top
sub drawClassicControls(page as object)
    x = MARGIN_X
    icons = ["home", "sort", "category_outlined", "settings"]
    if m.music then icons = ["home", "sort"]
    for each icon in icons
        headerButton(icon, x, CLASSIC_BAR_TOP, { height: CLASSIC_BUTTON_SIZE })
        x += CLASSIC_BUTTON_SIZE + CLASSIC_BUTTON_GAP
    end for
    searchBox(1369, 9, 464)
    if page.letters then drawLetters(x + 12, 255, 28, 10, 0)
end sub

' Home and the search lead the bar, and the labeled controls pack against its far end
sub drawModernControls(page as object)
    top = MODERN_BAR_TOP + MODERN_BAR_PAD
    headerButton("home", MARGIN_X + MODERN_BAR_PAD, top, { height: HEADER_CONTROL_HEIGHT })

    right = MARGIN_X + libraryCard.GRID_WIDTH - MODERN_BAR_PAD + MODERN_CONTROL_GAP
    controls = [
        { icon: "settings", args: { height: HEADER_CONTROL_HEIGHT } },
        { icon: "filter_list", args: { height: HEADER_CONTROL_HEIGHT, text: tr("Show"), value: page.playedLabel } },
        { icon: "category_outlined", args: { height: HEADER_CONTROL_HEIGHT, text: tr("Group By"), value: page.groupLabel } },
        { icon: "sort", args: { height: HEADER_CONTROL_HEIGHT, text: tr("Sort By"), value: page.sortLabel, sortOrder: page.sortOrder } }
    ]
    ' A music library's bar only sorts
    if m.music then controls = [controls.Peek()]
    for each control in controls
        button = m.top.createChild("LibraryHeaderButton")
        button.icon = control.icon
        left = right - MODERN_CONTROL_GAP - button.callFunc("layout", control.args)
        button.translation = [left, top]
        right = left
    end for

    ruleTop = MODERN_BAR_TOP + (MODERN_BAR_HEIGHT - 42) / 2
    searchLeft = MARGIN_X + MODERN_BAR_PAD + HEADER_CONTROL_HEIGHT + MODERN_BAR_PAD
    for each ruleX in [searchLeft, right - MODERN_BAR_PAD - 1]
        rule = setupPreviewDraw.Rect(m.top, ruleX, ruleTop, 1, 42, "#FFFFFF")
        rule.opacity = 0.1
    end for
    searchLeft += 1 + MODERN_BAR_PAD
    searchBox(searchLeft, top, right - (MODERN_BAR_PAD * 2) - 1 - searchLeft)
    if page.letters then drawLetters(MARGIN_X, 330, 28, 10, 0)
end sub

' Every control is a row in the panel, with the letters seven to a row under a caption
sub drawDockedControls(page as object)
    headerButton("home", DOCK_PAD_X - 6, 42, { height: HEADER_CONTROL_HEIGHT })
    searchBox(DOCK_PAD_X, 132, DOCK_ROW_WIDTH)
    rows = [
        { icon: "sort", text: tr("Sort By"), value: page.sortLabel, sortOrder: page.sortOrder },
        { icon: "category_outlined", text: tr("Group By"), value: page.groupLabel },
        { icon: "filter_list", text: tr("Show"), value: page.playedLabel },
        { icon: "grid_view", text: tr("Display"), value: displayLabel(page) }
    ]
    if m.music then rows = [rows[0]]
    rowTop = 222
    for each row in rows
        headerButton(row.icon, DOCK_PAD_X, rowTop, { height: DOCK_ROW_HEIGHT, width: DOCK_ROW_WIDTH, text: row.text, value: row.value, sortOrder: row.sortOrder ?? "" })
        rowTop += DOCK_ROW_HEIGHT + 6
    end for
    if not page.letters then return

    rule = setupPreviewDraw.Rect(m.top, DOCK_PAD_X, rowTop + 12, DOCK_ROW_WIDTH, 1, "#FFFFFF")
    rule.opacity = 0.08
    caption = setupPreviewDraw.TextLabel(m.top, tr("Jump to letter"), DOCK_PAD_X, rowTop + 25, 18, "#FFFFFF99", true)
    caption.width = DOCK_ROW_WIDTH
    caption.height = 26
    drawLetters(DOCK_PAD_X, rowTop + 63, 7, 18, 24)
end sub

function displayLabel(page as object) as string
    shape = libraryPreview.CardShape(m.top.look.orientation, page.imagePick)
    if shape = "thumbnail" then return tr("Thumbnail")
    if shape = "banner" then return tr("Banner")
    return tr("Poster")
end function

' The alphabet strip's letters in its 40 by 30 cells
sub drawLetters(x as float, y as float, columns as integer, gapX as integer, gapY as integer)
    for i = 0 to Len(LETTERS) - 1
        letter = setupPreviewDraw.TextLabel(m.top, Mid(LETTERS, i + 1, 1), x + (i mod columns) * (40 + gapX), y + Int(i / columns) * (30 + gapY) + 7, 25, "#FFFFFF", false)
        letter.width = 35
        letter.height = 25
        letter.horizAlign = "center"
        letter.vertAlign = "center"
    end for
end sub

' Only the cards that fit on screen, the first one grown and ringed the way a focused card is
sub drawGrid(area as object, items as object, look as object, page as object, settings as object)
    if items.count() = 0 then return
    detailed = toString(settings["ui.library.detailedSubHeadings"]) <> "false"
    shape = libraryPreview.CardShape(look.orientation, page.imagePick)
    if m.music then shape = "square"
    subtitles = false
    for each item in items
        if subtitleFor(item.json, detailed) <> "" then subtitles = true
    end for
    metrics = libraryCard.Metrics(libraryCard.PosterSize(settings["ui.library.posterSize"], settings["ui.posterSize"]), shape, look.cardTitles = true, subtitles, detailed, area.width)

    grid = m.top.createChild("Group")
    grid.translation = [area.left, area.top]
    grid.clippingRect = [0, 0, area.width, area.room]
    shown = metrics.columns * libraryPreview.RowsShown(area.room, metrics.cellHeight)
    if shown > items.count() then shown = items.count()
    for i = 0 to shown - 1
        drawCard(grid, items[i], metrics, (i mod metrics.columns) * metrics.cellWidth, Int(i / metrics.columns) * metrics.cellHeight, i = 0, detailed)
    end for
end sub

sub drawCard(grid as object, content as object, metrics as object, x as float, y as float, focused as boolean, detailed as boolean)
    card = grid.createChild("Group")
    card.translation = [x, y]
    padX = metrics.padX
    padY = metrics.padY
    width = metrics.posterWidth
    height = metrics.posterHeight
    if focused
        card.scaleRotateCenter = [padX + width / 2, padY + height / 2]
        card.scale = [libraryCard.FOCUS_SCALE, libraryCard.FOCUS_SCALE]
    end if

    backing = setupPreviewDraw.Rect(card, padX, padY, width, height, "#FFFFFF")
    backing.opacity = 0.08
    mask = card.createChild("MaskGroup")
    mask.translation = [padX, padY]
    mask.maskSize = [width, height]
    mask.maskUri = maskFor(metrics.imageType)
    uri = artworkFor(content, metrics.imageType)
    art = mask.createChild("Poster")
    art.width = width
    art.height = height
    art.loadDisplayMode = "scaleToZoom"
    art.uri = uri
    if uri = "" then setupPreviewDraw.Icon(card, "pkg:/images/icons/musicFolder.webp", padX + (width - 60) / 2, padY + (height - 60) / 2, 60, "#FFFFFF59")
    if focused then setupPreviewDraw.Ring(card, padX, padY, width, height, 6, themeChrome.Accent())

    if metrics.textHeight <= 0 then return
    textScale = metrics.textScale
    textY = padY + height + CARD_TEXT_GAP
    title = setupPreviewDraw.TextLabel(card, content.title ?? "", padX, textY, CInt(CARD_TITLE_SIZE * textScale), "#FFFFFF", true)
    title.width = width
    title.maxLines = 1
    if metrics.textHeight < CInt(libraryCard.TEXT_HEIGHT_WITH_SUBTITLE * textScale) then return
    subtitle = setupPreviewDraw.TextLabel(card, subtitleFor(content.json, detailed), padX, textY + CInt(CARD_TITLE_LINE * textScale), CInt(CARD_SUBTITLE_SIZE * textScale), "#FFFFFF", false)
    subtitle.width = width
    subtitle.maxLines = 1
    subtitle.opacity = 0.6
end sub

function subtitleFor(json as dynamic, detailed as boolean) as string
    if not isValid(json) then return ""
    isFolder = json.IsFolder = true and not libraryCard.DetailedFolderType(json.Type ?? "")
    return libraryCard.Subtitle(json, isFolder, detailed)
end function

function maskFor(shape as string) as string
    if shape = "square" then return "pkg:/images/librarySquareMask.webp"
    if shape = "thumbnail" then return "pkg:/images/libraryThumbMask.webp"
    if shape = "banner" then return "pkg:/images/libraryBannerMask.webp"
    return "pkg:/images/libraryPosterMask.webp"
end function

' The card's art the way the real card picks it: a strip of banner, backdrop or thumb for the wide
' shapes, and the poster otherwise
function artworkFor(content as object, shape as string) as string
    if shape = "banner"
        bannerTag = chainLookupReturn(content.json, "ImageTags.Banner", "")
        if isValidAndNotEmpty(bannerTag) then return ImageURL(content.json.Id, "Banner", { "maxHeight": 185, "maxWidth": 1000, "Tag": bannerTag })
        if isValidAndNotEmpty(content.backdropURL) then return content.backdropURL
        if isValidAndNotEmpty(content.landscapePosterURL) then return content.landscapePosterURL
    end if
    if shape = "thumbnail"
        if isValidAndNotEmpty(content.landscapePosterURL) then return content.landscapePosterURL
        if isValidAndNotEmpty(content.backdropURL) then return content.backdropURL
    end if
    return content.PosterUrl ?? ""
end function

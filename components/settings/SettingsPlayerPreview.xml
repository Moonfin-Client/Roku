<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsPlayerPreview" extends="Group">
  <interface>
    <!-- middle, intro or end of the title, loading before it starts, seek mid-scrub, or playing with the controls hidden -->
    <field id="moment" type="string" value="middle" />
    <field id="values" type="assocarray" />
    <!-- An HDR picture, which takes the HDR subtitle style when Separate HDR Style is on -->
    <field id="hdr" type="boolean" value="false" />
    <field id="items" type="array" onChange="redraw" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A drawn copy of the video library screen for the settings preview, holding the first card of
     the user's first Movies or Shows library in focus -->
<component name="SettingsLibraryPreview" extends="Group">
  <interface>
    <!-- The library's first page and what it saved, left empty while that page loads. Set before look. -->
    <field id="page" type="assocarray" />
    <!-- The library's name, the style and the switches the copy draws with -->
    <field id="look" type="assocarray" onChange="redraw" />
    <field id="items" type="array" />
  </interface>
</component>

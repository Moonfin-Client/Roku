import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsMetrics.bs"

const FOLLOW_ALIGNMENT = 0.9

' Items sit in a small pool and move to whichever rows are on screen, so a long screen costs no
' more nodes than a short one. The focused card scrolls to sit most of the way down the list.
sub init()
    m.clip = m.top.findNode("clip")
    m.track = m.top.findNode("track")
    m.scrollAnim = m.top.findNode("scrollAnim")
    m.scrollInterp = m.top.findNode("scrollInterp")
    m.scrollAnim.observeField("state", "onScrollAnimState")

    m.tops = []
    m.heights = []
    m.total = 0.0
    m.offset = 0.0
    m.bound = {}
    m.free = []
    m.focusIndex = -1

    m.top.observeField("focusedChild", "onFocusChanged")
    onViewSizeChanged()
end sub

sub onViewSizeChanged()
    m.clip.clippingRect = [0, 0, m.top.itemWidth, m.top.viewHeight]
end sub

function rowCount() as integer
    if not isValid(m.top.content) then return 0
    return m.top.content.getChildCount()
end function

sub layoutHeights()
    heights = m.top.rowHeights
    m.tops = []
    m.heights = []
    m.total = 0.0
    for i = 0 to rowCount() - 1
        height = 107.0
        if isValid(heights) and i < heights.Count() and isValid(heights[i]) then height = heights[i]
        m.tops.push(m.total)
        m.heights.push(height)
        m.total = m.total + height
    end for
end sub

sub onContentChanged()
    m.scrollAnim.control = "stop"
    for each key in m.bound
        releaseItem(m.bound[key])
    end for
    m.bound = {}
    m.focusIndex = -1
    m.offset = 0.0
    m.track.translation = [0, 0]
    layoutHeights()

    if rowCount() > 0 then setFocusIndex(0, false)
end sub

' A row that grew or shrank moves everything under it, and the focused card is lined up again
sub onHeightsChanged()
    if m.top.rowHeights.Count() <> rowCount() then return
    layoutHeights()
    for each key in m.bound
        placeItem(m.bound[key], key.ToInt())
    end for
    if m.focusIndex >= 0 then scrollTo(followOffset(m.focusIndex), false)
end sub

sub onJumpToItem()
    index = m.top.jumpToItem
    if index < 0 or index >= rowCount() then return
    setFocusIndex(index, false)
end sub

sub setFocusIndex(index as integer, animate as boolean)
    previous = m.focusIndex
    m.focusIndex = index
    scrollTo(followOffset(index), animate)
    paintFocus(previous)
    paintFocus(index)
    m.top.itemFocused = index
end sub

' Where the list sits for a card to be most of the way down it, without running past either end
function followOffset(index as integer) as float
    if index < 0 or index >= m.tops.Count() then return 0.0

    cardTop = m.tops[index]
    cardHeight = m.heights[index]
    node = m.top.content.getChild(index)
    if isValid(node) and node.hasField("cardHeight") and node.cardHeight > 0
        cardTop = cardTop + node.bandHeight + settingsMetrics.Px(4)
        cardHeight = node.cardHeight
    end if

    view = m.top.viewHeight
    wanted = cardTop - FOLLOW_ALIGNMENT * (view - cardHeight)
    furthest = m.total + m.top.bottomPadding - view
    if furthest < 0 then furthest = 0
    if wanted > furthest then wanted = furthest
    if wanted < 0 then wanted = 0
    return wanted
end function

sub scrollTo(target as float, animate as boolean)
    from = -m.track.translation[1]
    if not animate or Abs(target - from) < 1
        m.scrollAnim.control = "stop"
        m.track.translation = [0, -target]
        bindWindow(target, target)
    else
        ' Both ends stay bound while the list moves, and the pool shrinks again once it stops
        bindWindow(from, target)
        m.scrollInterp.keyValue = [[0, -from], [0, -target]]
        m.scrollAnim.control = "start"
    end if
    m.offset = target
    m.top.scrollOffset = target
end sub

sub onScrollAnimState()
    if m.scrollAnim.state = "stopped" then bindWindow(m.offset, m.offset)
end sub

sub bindWindow(fromOffset as float, toOffset as float)
    low = fromOffset
    high = toOffset
    if toOffset < fromOffset
        low = toOffset
        high = fromOffset
    end if
    high = high + m.top.viewHeight

    first = -1
    last = -1
    for i = 0 to m.tops.Count() - 1
        if m.tops[i] + m.heights[i] > low and m.tops[i] < high
            if first < 0 then first = i
            last = i
        end if
    end for

    leaving = []
    for each key in m.bound
        index = key.ToInt()
        if index < first or index > last then leaving.push(key)
    end for
    for each key in leaving
        releaseItem(m.bound[key])
        m.bound.Delete(key)
    end for

    if first < 0 then return
    for i = first to last
        key = i.ToStr()
        if not m.bound.DoesExist(key)
            item = m.free.Pop()
            if not isValid(item) then item = m.track.createChild("SettingsMenuItem")
            m.bound[key] = item
            placeItem(item, i)
        end if
    end for
end sub

sub placeItem(item as object, index as integer)
    item.translation = [0, m.tops[index]]
    item.width = m.top.itemWidth
    item.height = m.heights[index]
    item.itemContent = m.top.content.getChild(index)
    item.itemHasFocus = (index = m.focusIndex and m.top.hasFocus())
    item.visible = true
end sub

sub releaseItem(item as object)
    item.visible = false
    item.itemHasFocus = false
    m.free.push(item)
end sub

sub paintFocus(index as integer)
    item = m.bound[index.ToStr()]
    if isValid(item) then item.itemHasFocus = (index = m.focusIndex and m.top.hasFocus())
end sub

sub onFocusChanged()
    paintFocus(m.focusIndex)
end sub

' A row whose content changed in place draws itself again
sub refreshItem(index as integer)
    item = m.bound[index.ToStr()]
    if isValid(item) then placeItem(item, index)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "down"
        if m.focusIndex < rowCount() - 1 then setFocusIndex(m.focusIndex + 1, m.top.animate)
        return true
    end if

    ' The first row hands up to whatever sits above the list
    if key = "up"
        if m.focusIndex <= 0 then return false
        setFocusIndex(m.focusIndex - 1, m.top.animate)
        return true
    end if

    if key = "OK"
        if m.focusIndex >= 0 then m.top.itemSelected = m.focusIndex
        return true
    end if

    return false
end function

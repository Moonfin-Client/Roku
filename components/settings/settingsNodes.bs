import "pkg:/source/utils/misc.bs"

sub placeNode(node as object, x as float, y as float, width as float, height as float)
    node.translation = [x, y]
    node.width = width
    node.height = height
end sub

' The settings images are white shapes, so a colour and an opacity tint them, and no colour hides one
sub tint(poster as object, colour as dynamic)
    poster.visible = isValid(colour)
    if not isValid(colour) then return
    poster.blendColor = colour.color
    poster.opacity = colour.opacity
end sub

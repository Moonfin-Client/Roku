<?xml version="1.0" encoding="utf-8"?>
<!-- The live preview beside the settings list: scene chips, a mock of the screen the focused
     setting changes, and that setting spelled out under it with every choice its picker offers -->
<component name="SettingsLivePreview" extends="Group">
  <interface>
    <field id="items" type="array" onChange="onItemsChanged" />
    <!-- scene, focusKey, values, entry, chips, chipsFocused, accent, avatar, pageColor, cardColor, cardOpacity and saves, set together -->
    <field id="state" type="assocarray" onChange="redraw" />
  </interface>
  <children>
    <Group id="header" />
    <Poster id="shadow" uri="pkg:/images/setup/stage24shadow.9.png" blendColor="0x00000080" />
    <Group id="holder" />
    <Poster id="cover" uri="pkg:/images/setup/stage24cover.9.png" />
    <Poster id="stroke" uri="pkg:/images/setup/stage24s2.9.png" />
    <Group id="inspector" />
  </children>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The live preview beside the settings list: scene chips, a mock of the screen the focused
     setting changes, and that setting spelled out under it with every choice its picker offers -->
<component name="SettingsLivePreview" extends="Group">
  <interface>
    <field id="items" type="array" onChange="onItemsChanged" />
    <!-- scene, focusKey, values, entry, chips, chipsFocused, accent, avatar, pageColor, cardColor, cardOpacity, saves and focusedSetting, set together -->
    <field id="state" type="assocarray" onChange="redraw" />
  </interface>
  <children>
    <Group id="header" />
    <Group id="shadow" />
    <Group id="holder" />
    <!-- The stage's corners in the page color and its edge line -->
    <Group id="frame" />
    <Group id="inspector" />
  </children>
</component>

import "pkg:/components/settings/settingsRows.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsMetrics.bs"

sub init()
    m.barrier = m.top.findNode("barrier")
    m.dialog = m.top.findNode("dialog")
    m.dialogFill = m.top.findNode("dialogFill")
    m.dialogTitle = m.top.findNode("dialogTitle")
    m.listGroup = m.top.findNode("listGroup")
    m.optionList = m.top.findNode("optionList")
    m.fadeIn = m.top.findNode("fadeIn")
    m.optionList.observeField("itemSelected", "onOptionSelected")
end sub

' 280 wide, or a step wider when an option needs it, centred on the settings panel
sub open()
    style = m.top.style
    palette = style.palette
    options = m.top.options
    multi = m.top.multi
    checked = m.top.checked ?? []

    width = settingsMetrics.Px(280)
    widest = 0.0
    for each option in options
        optionWidth = measureTextWidth(option.title, palette.fonts.title)
        if optionWidth > widest then widest = optionWidth
    end for
    if widest + (settingsMetrics.Px(16) + 1) * 2 + settingsMetrics.Px(14 + 24) > width then width = settingsMetrics.Px(336)

    specs = []
    for i = 0 to options.Count() - 1
        selected = i = m.top.selectedIndex
        if multi then selected = i < checked.Count() and checked[i] = true
        specs.push({ kind: "option", title: options[i].title, selected: selected })
    end for
    if multi
        specs.push({ kind: "option", title: tr("Save") })
        specs.push({ kind: "option", title: tr("Cancel") })
    end if
    built = BuildRows(specs, style, width)

    listHeight = 0.0
    for each height in built.heights
        listHeight = listHeight + height
    end for

    inset = settingsMetrics.Px(24)
    titleWidth = width - inset * 2
    titleLines = measureTextLines(m.top.title, palette.fonts.dialogTitle, titleWidth, 2)
    titleHeight = titleLines * settingsMetrics.Px(17.8)
    listTop = inset + titleHeight + settingsMetrics.Px(12)
    tallest = 1080 - settingsMetrics.Px(48) - listTop - settingsMetrics.Px(16)
    if listHeight > tallest then listHeight = tallest
    dialogHeight = listTop + listHeight + settingsMetrics.Px(16)

    m.dialog.translation = [settingsMetrics.PANEL_X + (settingsMetrics.PANEL_WIDTH - width) / 2, (1080 - dialogHeight) / 2]
    m.dialogFill.uri = palette.images.card
    m.dialogFill.width = width
    m.dialogFill.height = dialogHeight
    m.dialogFill.blendColor = palette.dialog.color
    m.dialogFill.opacity = palette.dialog.opacity

    m.dialogTitle.font = palette.fonts.dialogTitle
    m.dialogTitle.color = palette.title
    m.dialogTitle.translation = [inset, inset]
    m.dialogTitle.width = titleWidth
    m.dialogTitle.height = titleHeight
    m.dialogTitle.text = m.top.title

    m.listGroup.translation = [0, listTop]
    m.optionList.itemWidth = width
    m.optionList.viewHeight = listHeight
    m.optionList.animate = not palette.lowTier
    m.optionList.rowHeights = built.heights
    m.optionList.content = built.content
    if m.top.selectedIndex > 0 and m.top.selectedIndex < options.Count() then m.optionList.jumpToItem = m.top.selectedIndex
    m.optionList.setFocus(true)

    if not palette.lowTier then m.fadeIn.control = "start"
end sub

sub onOptionSelected()
    index = m.optionList.itemSelected
    count = m.top.options.Count()
    if not m.top.multi
        m.top.chosen = index
        return
    end if

    if index = count
        m.top.saved = true
        return
    end if
    if index > count
        m.top.closed = true
        return
    end if

    ' A tick flips in place, and nothing is kept until Save
    checked = m.top.checked ?? []
    while checked.Count() < count
        checked.push(false)
    end while
    checked[index] = not (checked[index] = true)
    m.top.checked = checked
    m.optionList.content.getChild(index).selected = checked[index]
    m.optionList.callFunc("refreshItem", index)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back"
        m.top.closed = true
        return true
    end if
    ' Nothing else gets past the dialog, since the panel behind reads right as a press and up from
    ' its first row as a move to the title bar
    return key = "left" or key = "right" or key = "up" or key = "down" or key = "options"
end function

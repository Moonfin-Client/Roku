import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/osdControls.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/subtitleStyle.bs"
import "pkg:/source/utils/themeChrome.bs"

' The sample is an episode with chapters and subtitles, 10:04 long
const SAMPLE_DURATION = 604
' Where the player's controls put the title, the seek bar and the time labels
const OSD_LOGO_HEIGHT = 108
const OSD_LOGO_MAX_WIDTH = 652
const OSD_HEADER_X = 24
const OSD_HEADER_Y = 12
const OSD_TITLE_UNDER_LOGO_Y = 112
const OSD_BAR_X = 24
const OSD_BAR_Y = 931
const OSD_BAR_WIDTH = 1872
const OSD_THUMB_SIZE = 21
const OSD_TIME_ROW_HEIGHT = 33
const OSD_TIME_ROW_GAP = 6
const SUBTITLE_CONTROLS_GAP = 12

' The player mid-episode: its controls with the title, the time, the seek bar and every button the
' viewer kept, over the subtitles
sub init()
    redraw()
end sub

sub redraw()
    loading = m.top.findNode("loadingPreview")
    if isValid(loading) then loading.active = false
    m.top.removeChildrenIndex(m.top.getChildCount(), 0)
    m.logo = invalid

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    values = m.top.values ?? {}
    moment = m.top.moment
    intro = values["playback.mediasegments.intro"] ?? "asktoskip"
    nextUp = values["playback.nextupbehavior"] ?? "extended"

    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000FF")
    ' Before the stream starts the picture is still black, under the player's own loading layer
    if moment = "loading"
        loading = m.top.createChild("LoadingAnimation")
        loading.id = "loadingPreview"
        loading.values = values
        loading.dimmed = true
        loading.label = tr("Loading Stream...")
        loading.active = true
        return
    end if
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, setupPreviewDraw.ItemField(items, 0, "backdropUrl"), pal.surfaceVariant)

    position = 252
    if moment = "intro"
        position = 42
        if intro = "skip" then position = 90
    else if moment = "end"
        position = 598
    end if

    controls = moment <> "playing"
    ' The player dims the picture while its controls are up, under the subtitles
    if controls then setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000004D")
    drawSubtitle(values, m.top.hdr, controls)
    if controls
        setupPreviewDraw.Shape(m.top, "pkg:/images/playback/fadedown.webp", 0, 0, 1920, 206, "0xFFFFFFFF")
        setupPreviewDraw.Shape(m.top, "pkg:/images/playback/fadeup.webp", 0, 868, 1920, 212, "0xFFFFFFFF")
        drawHeader(items)
        drawSeekBar(values, position)
        drawButtons(values, moment)
    end if

    if moment = "seek" and values["playback.trickplay.enabled"] <> "false" then drawSeekPreview(items)
    if moment = "end" then drawNextUp(nextUp, items, pal)
    if moment = "intro" and intro = "asktoskip" then drawSkipIntro()
end sub

' Drawn the way the player draws it: by the app with the style settings while Custom Subtitles is
' on, and by the Roku itself otherwise, in its own caption style
sub drawSubtitle(values as object, hdr as boolean, controls as boolean)
    if values["playback.subs.mode"] = "None" then return
    text = subtitleLine(values["playback.subs.language"] ?? "")
    if values["playback.subs.custom"] <> "true"
        drawRokuCaption(text, subtitleBottom(values, 1080 * 0.9, controls))
        return
    end if

    suffix = ""
    if hdr and values["playback.subs.style.hdrSeparate"] = "true" then suffix = "Hdr"
    look = subtitleStyle.FromSettings(values, suffix)
    cue = subtitleStyle.Cue([text], look, "")
    m.top.appendChild(cue)
    bounds = cue.boundingRect()
    placed = subtitleStyle.Placement(bounds, look.bottomPercent)
    cue.translation = [placed[0], subtitleBottom(values, placed[1] + bounds.height, controls) - bounds.height]
end sub

' The sample subtitle stays clear of the controls while they're up, over the bar's thumb or over the
' time row above the bar when that row has something in it. It never moves down.
function subtitleBottom(values as object, bottom as float, controls as boolean) as dynamic
    if not controls then return bottom
    barY = seekBarY(values)
    controlsTop = barY + 3 - OSD_THUMB_SIZE / 2
    if timeRowShows(values, "Above") then controlsTop = barY - OSD_TIME_ROW_HEIGHT - OSD_TIME_ROW_GAP
    if bottom > controlsTop - SUBTITLE_CONTROLS_GAP then return controlsTop - SUBTITLE_CONTROLS_GAP
    return bottom
end function

' The Roku's own captions in its default style, white on a black box near the bottom. They follow
' the Roku's caption settings, which the app can't draw, so this is the look they start with.
sub drawRokuCaption(text as string, bottom as float)
    label = setupPreviewDraw.TextLabel(m.top, text, 0, 0, 40, "0xFFFFFFFF", false)
    bounds = label.boundingRect()
    boxWidth = bounds.width + 24
    boxHeight = bounds.height + 8
    x = (1920 - boxWidth) / 2
    y = bottom - boxHeight
    setupPreviewDraw.Rect(m.top, x, y, boxWidth, boxHeight, "0x000000FF")
    m.top.removeChild(label)
    m.top.appendChild(label)
    label.translation = [x + 12, y + 4]
end sub

sub drawHeader(items as object)
    m.titleGroup = m.top.createChild("LayoutGroup")
    m.titleGroup.layoutDirection = "vert"
    m.titleGroup.itemSpacings = [4]
    m.seriesName = m.titleGroup.createChild("Label")
    m.seriesName.color = "#FFFFFFB3"
    m.seriesName.width = 1310
    playbackOverlay.SetFont(m.seriesName, 21, false)
    m.seriesName.text = setupPreviewDraw.ItemField(items, 0, "title")
    title = m.titleGroup.createChild("Label")
    title.color = "#FFFFFF"
    title.width = 1310
    playbackOverlay.SetFont(title, 27, true)
    title.text = `S1:E4 - ${tr("Episode")} 4`

    uri = setupPreviewDraw.ItemField(items, 0, "logoUrl")
    if uri <> ""
        m.logo = m.top.createChild("Poster")
        m.logo.translation = [OSD_HEADER_X, OSD_HEADER_Y]
        m.logo.height = OSD_LOGO_HEIGHT
        m.logo.loadDisplayMode = "scaleToFit"
        m.logo.visible = false
        m.logo.observeField("loadStatus", "onLogoStatus")
        m.logo.uri = uri
    end if
    layoutHeader()

    ' The controls show no clock, but its times feed the clock slots and Ends at
    m.clock = m.top.createChild("Clock")
    m.clock.visible = false
end sub

' The logo keeps the box's height and takes only the width it needs, so it sits flush left
sub onLogoStatus(event as object)
    logo = event.getRoSGNode()
    if not isValid(m.logo) or not logo.isSameNode(m.logo) then return
    status = LCase(logo.loadStatus)
    if status = "ready" and logo.bitmapHeight > 0
        width = logo.bitmapWidth * OSD_LOGO_HEIGHT / logo.bitmapHeight
        if width > OSD_LOGO_MAX_WIDTH
            width = OSD_LOGO_MAX_WIDTH
            logo.height = width * logo.bitmapHeight / logo.bitmapWidth
        end if
        logo.width = width
        logo.visible = true
    else if status <> "failed"
        return
    end if
    layoutHeader()
end sub

sub layoutHeader()
    hasLogo = isValid(m.logo) and m.logo.visible
    m.seriesName.visible = not hasLogo
    top = OSD_HEADER_Y
    if hasLogo then top = OSD_TITLE_UNDER_LOGO_Y
    m.titleGroup.translation = [OSD_HEADER_X, top]
end sub

' The bar drops into the space of the time row below it when that row has nothing to show
function seekBarY(values as object) as integer
    if timeRowShows(values, "Below") then return OSD_BAR_Y
    return OSD_BAR_Y + OSD_TIME_ROW_HEIGHT + OSD_TIME_ROW_GAP
end function

function timeRowShows(values as object, row as string) as boolean
    for each column in ["Left", "Center", "Right"]
        slotMode = values["playback.time" + row + column] ?? "none"
        if slotMode <> "none" and slotMode <> "" then return true
    end for
    return false
end function

sub drawSeekBar(values as object, position as integer)
    progress = position / SAMPLE_DURATION
    barY = seekBarY(values)
    m.barY = barY
    accent = themeChrome.Token("rangeProgress", "#00a4dc")
    setupPreviewDraw.Rect(m.top, OSD_BAR_X, barY, OSD_BAR_WIDTH, 6, "#404040FF")
    setupPreviewDraw.Rect(m.top, OSD_BAR_X, barY, OSD_BAR_WIDTH * progress, 6, accent)

    if values["playback.showChapterMarkers"] = "true"
        for each startSeconds in [151, 302, 453]
            setupPreviewDraw.Rect(m.top, OSD_BAR_X + OSD_BAR_WIDTH * startSeconds / SAMPLE_DURATION - 1.5, barY + 3 - 7.25, 3, 14.5, "#FFFFFFE6")
        end for
    end if
    ' The controls open with the bar focused, which lights its thumb white
    setupPreviewDraw.Shape(m.top, "pkg:/images/playback/dot84.webp", OSD_BAR_X + OSD_BAR_WIDTH * progress - OSD_THUMB_SIZE / 2, barY + 3 - OSD_THUMB_SIZE / 2, OSD_THUMB_SIZE, OSD_THUMB_SIZE, "0xFFFFFFFF")

    now = localSeconds()
    columns = [48, 656, 1264]
    aligns = ["left", "center", "right"]
    slots = ["AboveLeft", "AboveCenter", "AboveRight", "BelowLeft", "BelowCenter", "BelowRight"]
    for i = 0 to slots.count() - 1
        text = osdTimeText(values["playback.time" + slots[i]] ?? "none", position, SAMPLE_DURATION, now)
        if text <> ""
            above = i < 3
            label = m.top.createChild("Label")
            playbackOverlay.SetFont(label, 18, above)
            label.color = "#FFFFFFB3"
            label.width = 608
            label.height = OSD_TIME_ROW_HEIGHT
            label.vertAlign = "center"
            label.horizAlign = aligns[i mod 3]
            label.translation = [columns[i mod 3], above ? barY - OSD_TIME_ROW_HEIGHT - OSD_TIME_ROW_GAP : barY + 14]
            label.text = text
        end if
    end for
end sub

' What one of the player's time labels reads, the way its controls word it. The clock times come
' from the player's own clock, so they follow the 24-hour setting.
function osdTimeText(slotMode as string, position as integer, duration as integer, now as integer) as string
    if slotMode = "elapsed" then return secondsToHuman(position, false)
    if slotMode = "endsAt" then return tr("Ends at") + " " + clockAt(now + duration - position)
    if slotMode = "time" then return clockAt(now)
    if slotMode = "timeRemaining" then return "-" + secondsToHuman(duration - position, false)
    if slotMode = "totalDuration" or slotMode = "totalTime" then return secondsToHuman(duration, false)
    return ""
end function

function clockAt(seconds as integer) as string
    return m.clock.callFunc("getFormattedTime", seconds, true)
end function

function localSeconds() as integer
    now = CreateObject("roDateTime")
    now.ToLocalTime()
    return now.AsSeconds()
end function

' The row the player draws: the transport buttons with the glyphs the skip lengths pick, then
' every button the viewer kept, with speed reading as text
sub drawButtons(values as object, moment as string)
    ' A scrub with a frame to look at pauses the video while Pause While Scrubbing is on
    playGlyph = "pause_rounded"
    if moment = "seek" and values["playback.trickplay.enabled"] <> "false" and values["playback.trickplay.pauseWhileScrubbing"] <> "false" then playGlyph = "play_arrow_rounded"
    glyphs = ["skip_previous_rounded", osdControls.SeekGlyph(-1, osdControls.SkipSeconds(values, -1)), playGlyph, osdControls.SeekGlyph(1, osdControls.SkipSeconds(values, 1)), "skip_next_rounded"]

    transport = m.top.createChild("LayoutGroup")
    transport.layoutDirection = "horiz"
    transport.itemSpacings = [buttonLayout.OSD_SPACING]
    transport.translation = [buttonLayout.OSD_ROW_X, buttonLayout.OSD_ROW_Y]
    for each glyphName in glyphs
        transport.appendChild(buttonLayout.OsdButton("", glyphName, ""))
    end for

    secondary = m.top.createChild("LayoutGroup")
    secondary.layoutDirection = "horiz"
    secondary.itemSpacings = [buttonLayout.OSD_SPACING]
    secondary.translation = [buttonLayout.OsdSecondaryX(glyphs.Count()), buttonLayout.OSD_ROW_Y]
    for each candidate in arrangedOsdButtons(values)
        button = buttonLayout.OsdButton(candidate.nodeId, candidate.glyph, candidate.label)
        if candidate.id = "speed" then button.text = osdControls.SpeedLabel(1.0)
        secondary.appendChild(button)
    end for
end sub

' The sample has chapters, a season, subtitles and a cast, so every button the viewer kept shows
function arrangedOsdButtons(values as object) as object
    return buttonLayout.Arrange(buttonLayout.OsdCandidates(true, true, true, true, true), values[OSD_ORDER_SETTING], values[OSD_HIDDEN_SETTING])
end function

sub drawSkipIntro()
    prompt = setupPreviewDraw.TextLabel(m.top, tr("Skip Intro"), 0, 0, 30, "0x000000FF", true)
    width = prompt.boundingRect().width + 80
    x = 1920 - 72 - width
    setupPreviewDraw.Round(m.top, x, 780, width, 80, 40, "0xFFFFFFFF")
    m.top.removeChild(prompt)
    m.top.appendChild(prompt)
    prompt.translation = [x, 780]
    prompt.width = width
    prompt.height = 80
    prompt.horizAlign = "center"
    prompt.vertAlign = "center"
end sub

' The frame a scrub is aiming at, in the tile the player draws over the thumb
sub drawSeekPreview(items as object)
    tileHeight = 335
    tileWidth = 595
    x = OSD_BAR_X + OSD_BAR_WIDTH * 252 / SAMPLE_DURATION - tileWidth / 2
    y = m.barY - 2 - tileHeight
    setupPreviewDraw.Round(m.top, x, y, tileWidth, tileHeight, 8, "0x000000FF")
    setupPreviewDraw.Art(m.top, x, y, tileWidth, tileHeight, setupPreviewDraw.ItemField(items, 0, "backdropUrl"), "0x222222FF")
    setupPreviewDraw.Ring(m.top, x, y, tileWidth, tileHeight, 8, themeChrome.Token("rangeProgress", "#00a4dc"))
end sub

sub drawNextUp(nextUp as string, items as object, pal as object)
    nextTitle = setupPreviewDraw.ItemField(items, 1, "title")
    if nextUp = "extended"
        x = 1920 - 64 - 540
        setupPreviewDraw.Round(m.top, x, 56, 540, 420, 24, "0x000000D9")
        setupPreviewDraw.RoundArt(m.top, x, 56, 540, 280, setupPreviewDraw.ItemField(items, 1, "backdropUrl"), pal.surfaceVariant, 18, "0x000000FF")
        setupPreviewDraw.TextLabel(m.top, UCase(tr("Up Next")), x + 24, 360, 22, pal.accent, true)
        name = setupPreviewDraw.TextLabel(m.top, nextTitle, x + 24, 396, 32, "0xFFFFFFFF", true)
        name.width = 492
    else if nextUp = "minimal"
        label = setupPreviewDraw.TextLabel(m.top, `${tr("Up Next")}: ${nextTitle}`, 0, 0, 28, "0xFFFFFFFF", true)
        width = label.boundingRect().width + 64
        x = 1920 - 64 - width
        setupPreviewDraw.Round(m.top, x, 56, width, 72, 36, "0x000000CC")
        m.top.removeChild(label)
        m.top.appendChild(label)
        label.translation = [x, 56]
        label.width = width
        label.height = 72
        label.horizAlign = "center"
        label.vertAlign = "center"
    end if
end sub

function subtitleLine(language as string) as string
    lines = {
        spa: "Espera, ¿oíste eso?",
        fre: "Attends, tu as entendu ça ?",
        fra: "Attends, tu as entendu ça ?",
        ger: "Warte, hast du das gehört?",
        deu: "Warte, hast du das gehört?"
    }
    return lines[language] ?? "Wait, did you hear that?"
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the library order list, carrying what TrackListItem draws -->
<component name="LibraryOrderData" extends="ContentNode">
  <interface>
    <field id="dimmed" type="boolean" value="false" />
    <field id="action" type="string" value="" />
    <field id="rowHeight" type="integer" value="0" />
    <field id="noIndicator" type="boolean" value="false" />
    <field id="paragraph" type="boolean" value="false" />
    <!-- Takes the place of the tick, for a row that names something rather than choosing it -->
    <field id="icon" type="string" value="" />
    <field id="reorderable" type="boolean" value="false" />
    <field id="canMoveLeft" type="boolean" value="false" />
    <field id="canMoveRight" type="boolean" value="false" />
    <!-- Every row shows the ways it can go, not just the focused one -->
    <field id="moveHints" type="boolean" value="false" />
  </interface>
</component>

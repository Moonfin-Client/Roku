<?xml version="1.0" encoding="utf-8"?>
<!-- Settings sync in one place: the plugin's state and the sync switch, the profile this device
     follows, and loading, saving or resetting that profile. It covers the settings panel it
     opens from, and its cards are built in code. -->
<component name="SettingsSyncPanel" extends="Group">
    <children>
        <Group id="panel" translation="[1120, 0]">
            <Rectangle id="background" width="800" height="1080" color="#101010" />
            <Label id="title" translation="[36, 0]" width="728" height="112" vertAlign="center" font="font:MediumSystemFont" color="#FFFFFF" />
            <Group id="content" translation="[24, 0]">
                <Group id="syncSection">
                    <Label id="profileHeading" font="font:SmallBoldSystemFont" />
                    <Label id="profileCaption" font="font:SmallSystemFont" color="#FFFFFFA6" wrap="true" />
                    <Poster id="actionsFill" uri="pkg:/images/whatsnew/fill24.9.png" />
                </Group>
            </Group>
        </Group>

        <LoadingAnimation id="loading" />
    </children>

    <interface>
        <field id="closed" type="boolean" value="false" alwaysNotify="true" />
        <!-- Goes up each time settings from the server land on this device, so the screen behind
             can redraw what they change -->
        <field id="applied" type="integer" value="0" />
        <!-- What a load, save or reset came to, for the screen behind to show, since this panel
             can be closed by the time it finishes -->
        <field id="message" type="string" alwaysNotify="true" />

        <function name="showDialog" />
    </interface>
</component>

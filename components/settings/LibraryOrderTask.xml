<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the libraries in the order each server keeps them, or writes a new order back. The
     caller picks which by setting functionName to loadOrder or saveOrder. -->
<component name="LibraryOrderTask" extends="Task">
    <interface>
        <!-- The order to save, as the list the load handed back, and whether it came from every
             signed in server -->
        <field id="libraries" type="array" />
        <field id="unified" type="boolean" value="false" />
        <field id="result" type="assocarray" />
    </interface>
</component>

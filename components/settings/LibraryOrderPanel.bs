import "pkg:/components/itemMenu/itemMenuToastHost.bs"
import "pkg:/components/settings/settingsRows.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/libraryOrder.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.list = m.top.findNode("checklist")
    m.list.observeField("itemSelected", "onItemSelected")
    m.panelFill = m.top.findNode("panelFill")
    m.titleBar = m.top.findNode("titleBar")
    m.loading = m.top.findNode("loading")

    m.saveTimer = m.top.findNode("saveTimer")
    m.saveTimer.duration = libraryOrder.SAVE_DELAY
    m.saveTimer.observeField("fire", "onSaveTimer")

    m.libraries = []
    m.unified = false
    m.hidden = {}
    ' The order the servers last took, which a failed write goes back to
    m.savedOrder = []
    m.savePending = false
    m.saveQueued = false
    m.isClosed = false
    m.retryShown = false
end sub

sub showDialog()
    palette = m.top.style.palette
    m.panelFill.blendColor = palette.panel.color
    m.panelFill.opacity = palette.panel.opacity
    m.list.animate = not palette.lowTier
    m.titleBar.style = m.top.style
    m.titleBar.isRoot = false
    m.titleBar.title = tr("Library Order")
    load()
end sub

sub load()
    m.libraries = []
    showRows([], 0)
    m.list.setFocus(true)
    m.loading.active = true

    m.loadTask = CreateObject("roSGNode", "LibraryOrderTask")
    m.loadTask.functionName = "loadOrder"
    m.loadTask.observeField("result", "onLoaded")
    m.loadTask.control = "RUN"
end sub

sub onLoaded(event as object)
    result = event.getData()
    m.loadTask = invalid
    m.loading.active = false

    if result.ok <> true
        showMessage(tr("Failed to load libraries"), tr("Retry"))
        return
    end if

    m.unified = result.unified = true
    m.hidden = result.hidden
    m.libraries = result.libraries
    m.savedOrder = result.libraries
    if m.libraries.Count() = 0
        showMessage(tr("No libraries found"), "")
        return
    end if

    showLibraries(0)
end sub

' The lines explaining the screen head the list, and each library is a plain tile with its glyph
sub showLibraries(focusIndex as integer)
    specs = [{ band: "note", text: tr("Your libraries appear in this order on My Media, the recently added rows and the navigation bar. The order is saved to your server account, so other apps you sign in to use it too."), caption: tr("Press left or right to move the highlighted library.") }]
    for i = 0 to m.libraries.Count() - 1
        library = m.libraries[i]
        title = library.Name
        if m.unified and isValidAndNotEmpty(library.serverName) then title += " (" + library.serverName + ")"
        subtitle = ""
        ' Emby's own apps hide a library by its Guid rather than its Id
        if m.hidden.DoesExist(library.Id) or (isValidAndNotEmpty(library.Guid) and m.hidden.DoesExist(library.Guid)) then subtitle = tr("Hidden")
        specs.push({
            kind: "plain",
            title: title,
            subtitle: subtitle,
            glyph: libraryOrder.Icon(library),
            canMovePrev: not libraryOrder.IsFirstOfServer(m.libraries, i),
            canMoveNext: not libraryOrder.IsLastOfServer(m.libraries, i)
        })
    end for
    m.retryShown = false
    showRows(specs, focusIndex)
end sub

sub showMessage(message as string, action as string)
    specs = [{ band: "note", text: message }]
    m.retryShown = action <> ""
    if m.retryShown then specs.push({ kind: "nav", title: action, glyph: "refresh" })
    showRows(specs, 0)
end sub

sub showRows(specs as object, focusIndex as integer)
    built = BuildRows(specs, m.top.style)
    m.list.rowHeights = built.heights
    m.list.content = built.content
    if focusIndex > 0 then m.list.jumpToItem = focusIndex
    m.list.setFocus(true)
end sub

sub onItemSelected()
    if m.retryShown then load()
end sub

' Left and right move the focused library, since up and down already move the focus
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.BACK)
        close()
        return true
    end if

    if isStringEqual(key, KeyCode.LEFT) then return moveFocused(-1)
    if isStringEqual(key, KeyCode.RIGHT) then return moveFocused(1)
    ' The settings panel behind reads up from its first row as a move to its title bar
    return isStringEqual(key, KeyCode.UP)
end function

function moveFocused(direction as integer) as boolean
    if m.libraries.Count() = 0 then return true
    index = m.list.itemFocused
    moved = libraryOrder.Move(m.libraries, index, index + direction)
    if not isValid(moved) then return true

    m.libraries = moved
    showLibraries(index + direction)

    m.savePending = true
    m.top.saving = true
    m.saveTimer.control = "stop"
    m.saveTimer.control = "start"
    return true
end function

sub onSaveTimer()
    m.savePending = false
    saveOrder()
end sub

' Queued so writes land in the order they were made and a slow one cant undo a later move
sub saveOrder()
    if isValid(m.saveTask)
        m.saveQueued = true
        return
    end if

    m.saveQueued = false
    m.sending = m.libraries
    m.saveTask = CreateObject("roSGNode", "LibraryOrderTask")
    m.saveTask.unified = m.unified
    m.saveTask.libraries = m.sending
    m.saveTask.functionName = "saveOrder"
    m.saveTask.observeField("result", "onSaved")
    m.saveTask.control = "RUN"
end sub

sub onSaved(event as object)
    m.saveTask = invalid

    if event.getData().ok = true
        m.savedOrder = m.sending
        ' Home and the nav draw the libraries again straight away, rather than on the next launch
        m.global.librariesChanged = m.global.librariesChanged + 1
    else if not m.saveQueued and not m.isClosed
        ' Only the latest save puts the list back, since a later one still carries what was moved
        m.saveTimer.control = "stop"
        m.savePending = false
        focusedId = chainLookupReturn(m.libraries[m.list.itemFocused], "Id", "")
        m.libraries = m.savedOrder
        showLibraries(indexOfLibrary(focusedId))
        showItemMenuToast(tr("Couldn't save the library order"))
    end if

    if m.saveQueued
        saveOrder()
        return
    end if
    if not m.savePending then m.top.saving = false
end sub

' The focus stays on the library it was on wherever that library lands
function indexOfLibrary(id as string) as integer
    for i = 0 to m.libraries.Count() - 1
        if m.libraries[i].Id = id then return i
    end for
    return 0
end function

' Backing out right after a move still keeps the move
sub close()
    m.isClosed = true
    if m.savePending
        m.saveTimer.control = "stop"
        m.savePending = false
        saveOrder()
    end if
    if isValid(m.loadTask) then m.loadTask.unobserveField("result")
    m.top.closed = true
end sub

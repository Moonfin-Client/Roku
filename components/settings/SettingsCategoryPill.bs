import "pkg:/source/utils/misc.bs"

const PILL_PAD = 6
const SEGMENT_HEIGHT = 52
const SEGMENT_PAD_X = 28
const SEGMENT_GAP = 4
const LABEL_SIZE = 26

sub init()
    m.track = m.top.findNode("track")
    m.segments = m.top.findNode("segments")
    m.fills = []
    m.texts = []
end sub

sub layout()
    labels = m.top.labels ?? []
    area = m.top.area
    if not isValid(area) or area.Count() < 4 then return

    m.segments.removeChildrenIndex(m.segments.getChildCount(), 0)
    m.fills = []
    m.texts = []

    x = PILL_PAD
    for each text in labels
        fill = m.segments.createChild("Poster")
        fill.uri = "pkg:/images/livetv/fill22.9.png"
        label = m.segments.createChild("Label")
        label.font = "font:SmallBoldSystemFont"
        label.font.size = LABEL_SIZE
        label.text = text
        width = label.boundingRect().width + SEGMENT_PAD_X * 2
        fill.translation = [x, PILL_PAD]
        fill.width = width
        fill.height = SEGMENT_HEIGHT
        label.translation = [x, PILL_PAD]
        label.width = width
        label.height = SEGMENT_HEIGHT
        label.horizAlign = "center"
        label.vertAlign = "center"
        m.fills.push(fill)
        m.texts.push(label)
        x += width + SEGMENT_GAP
    end for

    pillWidth = x - SEGMENT_GAP + PILL_PAD
    pillHeight = SEGMENT_HEIGHT + PILL_PAD * 2
    m.track.width = pillWidth
    m.track.height = pillHeight
    m.top.translation = [area[0] + (area[2] - pillWidth) / 2, area[1] + (area[3] - pillHeight) / 2]
    paint()
end sub

sub paint()
    for i = 0 to m.fills.Count() - 1
        chosen = i = m.top.selectedIndex
        m.fills[i].visible = chosen
        m.texts[i].color = "0xFFFFFFC7"
        if chosen
            m.fills[i].blendColor = m.top.accent
            m.texts[i].color = "0xFFFFFFFF"
            if m.top.focusRing
                m.fills[i].blendColor = "0xFFFFFFFF"
                m.texts[i].color = "0x000000FF"
            end if
        end if
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key <> "left" and key <> "right" then return false
    target = m.top.selectedIndex - 1
    if key = "right" then target = m.top.selectedIndex + 1
    if target >= 0 and target < m.fills.Count() then m.top.selectedIndex = target
    return true
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- The library order, in the same panel the pickers use. The list is named checklist because
     showPickerPanel hands focus to a node of that name. -->
<component name="LibraryOrderPanel" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

        <Group id="panel">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
            <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
            <Label id="description" font="font:SmallSystemFont" color="#FFFFFFB3" wrap="true" />
            <Label id="hint" font="font:SmallSystemFont" color="#FFFFFFB3" />
            <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
            <MarkupList
                id="checklist"
                itemComponentName="TrackListItem"
                drawFocusFeedback="false"
                vertFocusAnimationStyle="floatingFocus" />
        </Group>

        <LoadingAnimation id="loading" />
        <Timer id="saveTimer" repeat="false" />
    </children>

    <interface>
        <field id="closed" type="boolean" value="false" alwaysNotify="true" />
        <!-- Up while a save is waiting or on its way, so the screen holding the panel keeps it
             until the server has the order -->
        <field id="saving" type="boolean" value="false" />

        <function name="showDialog" />
    </interface>
</component>

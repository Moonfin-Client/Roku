<?xml version="1.0" encoding="utf-8"?>
<!-- The library order, drawn as a screen over the settings panel. The list is named checklist
     because showPickerPanel hands focus to a node of that name. -->
<component name="LibraryOrderPanel" extends="Group">
    <children>
        <Group id="panel" translation="[1219, 0]">
            <Poster id="panelFill" uri="pkg:/images/settings/card27.9.png" width="729" height="1080" />
            <Group translation="[0, 93]">
                <SettingsScroller id="checklist" />
            </Group>
            <SettingsTitleBar id="titleBar" />
        </Group>

        <LoadingAnimation id="loading" />
        <Timer id="saveTimer" repeat="false" />
    </children>

    <interface>
        <field id="style" type="node" />
        <field id="closed" type="boolean" value="false" alwaysNotify="true" />
        <!-- Up while a save is waiting or on its way, so the screen holding the panel keeps it
             until the server has the order -->
        <field id="saving" type="boolean" value="false" />

        <function name="showDialog" />
    </interface>
</component>

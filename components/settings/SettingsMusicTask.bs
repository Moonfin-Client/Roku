import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/serverCompatibility.bs"

' Asked for the way the real music screen asks for them, but only the rows its first screen
' shows: the newest albums, the songs played last, the music playlists, the genres and the
' featured album with its songs. The shelves further down aren't asked for.
const ROW_SIZE = 15
const GENRE_LIMIT = 8
const ITEM_FIELDS = "PrimaryImageAspectRatio,ChildCount,RecursiveItemCount"

sub init()
    m.top.functionName = "loadRows"
end sub

sub loadRows()
    libraryId = m.top.libraryId
    userId = m.global.session.user.id
    playlistSort = { sortBy: "SortName", sortOrder: "Ascending" }
    if chainLookupReturn(m.global.session, "user.settings.music_sortKey", "") = "DateCreated" then playlistSort = { sortBy: "DateCreated", sortOrder: "Descending" }

    latest = fetchItems("Items/Latest", { userId: userId, parentId: libraryId, limit: ROW_SIZE, fields: ITEM_FIELDS, imageTypeLimit: 1 })
    lastPlayed = fetchItems("Items", { userId: userId, parentId: libraryId, recursive: true, includeItemTypes: "Audio", filters: "IsPlayed", sortBy: "DatePlayed", sortOrder: "Descending", limit: ROW_SIZE, fields: ITEM_FIELDS, imageTypeLimit: 1, enableImageTypes: "Primary" })
    playlists = []
    for each playlist in fetchItems("Items", { userId: userId, recursive: true, includeItemTypes: "Playlist", sortBy: playlistSort.sortBy, sortOrder: playlistSort.sortOrder, limit: ROW_SIZE, fields: ITEM_FIELDS, imageTypeLimit: 1, enableImageTypes: "Primary" })
        if isStringEqual(playlist.LookupCI("MediaType"), "Audio") then playlists.push(playlist)
    end for
    genres = fetchItems("Genres", { userId: userId, parentId: libraryId, recursive: true, sortBy: "SortName", sortOrder: "Ascending", limit: GENRE_LIMIT })

    ' The hero is the song played last, or the first item of the other rows when nothing has played yet
    featured = invalid
    for each row in [lastPlayed, latest, playlists]
        if row.count() > 0
            featured = row[0]
            exit for
        end if
    end for

    album = invalid
    tracks = []
    if isValid(featured)
        albumId = featured.LookupCI("AlbumId")
        if isStringEqual(featured.LookupCI("Type"), "MusicAlbum") then albumId = featured.LookupCI("Id")
        if isValidAndNotEmpty(albumId)
            found = fetchItems("Items", { userId: userId, ids: albumId, fields: ITEM_FIELDS })
            if found.count() > 0 then album = found[0]
            tracks = fetchItems("Items", { userId: userId, parentId: albumId, includeItemTypes: "Audio", sortBy: "ParentIndexNumber,IndexNumber,SortName", fields: ITEM_FIELDS })
        end if
    end if

    m.top.result = { latest: latest, lastPlayed: lastPlayed, playlists: playlists, genres: genres, featured: featured, album: album, tracks: tracks }
end sub

function fetchItems(path as string, params as object) as object
    return responseItems(getJson(APIRequest(path, params)))
end function

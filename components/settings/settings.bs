const TOAST_LINE_HEIGHT = 45
const TOAST_CHARACTER_WIDTH = 16

sub init()
    m.top.optionsAvailable = false

    m.showSecretMenu = false
    m.keypresses = []
    m.magicKeyPressSequence = [KeyCode.UP, KeyCode.LEFT, KeyCode.REPLAY, KeyCode.REWIND, KeyCode.UP, KeyCode.LEFT, KeyCode.REPLAY, KeyCode.REWIND]

    m.userLocation = []
    m.kidsPinMode = ""

    m.settingsMenu = m.top.findNode("settingsMenu")
    m.titleBar = m.top.findNode("titleBar")
    m.scrim = m.top.findNode("scrim")
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.openAnim = m.top.findNode("openAnim")
    m.closeAnim = m.top.findNode("closeAnim")
    m.pushAnim = m.top.findNode("pushAnim")
    m.popAnim = m.top.findNode("popAnim")
    m.closing = false
    m.opened = false
    m.titleActionFocused = false
    m.picker = invalid
    m.sliderPending = invalid

    m.integerSetting = m.top.findNode("integerSetting")
    m.colorgrid = m.top.findNode("colorgrid")

    m.integerSetting.observeField("submit", "onKeyGridSubmit")
    m.integerSetting.observeField("escape", "onKeyGridEscape")

    applySettingsStyle()
    ' The panel slides in from the right edge when it opens
    if m.animate
        m.panel.translation = [1920, 0]
        m.panel.opacity = 0
        m.scrim.opacity = 0
    end if

    m.settingsMenu.setFocus(true)
    m.settingsMenu.observeField("itemFocused", "settingFocused")
    m.settingsMenu.observeField("itemSelected", "settingSelected")
    m.settingsMenu.observeField("scrollOffset", "onListScrolled")

    m.colorgrid.observeField("itemSelected", "onColorSelected")
    m.sliderSaveTimer = m.top.findNode("sliderSaveTimer")
    m.sliderSaveTimer.observeField("fire", "flushSliderSave")
    m.closeAnim.observeField("state", "onCloseAnimState")

    m.postTask = createObject("roSGNode", "PostTask")

    m.keypressTimer = m.top.findNode("keypressTimer")
    m.keypressTimer.observeField("fire", "onKeypressTimerFire")

    m.currentStringSetting = invalid
    m.stringInputDialog = invalid
    m.mediaBarSelectorSetting = invalid
    m.mediaBarSelectorDialogOptions = []
    m.mediaBarSelectorStoresUnchecked = false
    m.mediaBarPickerTask = invalid
    m.pendingMediaBarSettingItem = invalid

    m.seerrKeyboardMode = ""
    m.seerrTempUsername = ""
    m.seerrAccountSection = invalid
    m.seerrAuthTask = invalid
    m.seerrLogoutTask = invalid

    m.themeListTask = invalid
    m.themeResolveTask = invalid
    m.pendingThemeSettingItem = invalid
    m.themeOptions = []

    m.configTree = reorderSettingsForFlutter(GetConfigTree())
    LoadMenu({ children: m.configTree })
end sub

sub onKeypressTimerFire()
    m.keypresses.clear()
end sub

sub hideEditingControls()
    m.integerSetting.visible = false
    m.integerSetting.textEditBox.secureMode = false
    m.integerSetting.textEditBox.hintText = ""
    m.colorgrid.visible = false
end sub

' The panel's colours and faces, built again whenever the theme changes under it
sub applySettingsStyle()
    m.style = BuildSettingsStyle(false)
    m.cleanStyle = BuildSettingsStyle(true)
    palette = m.style.palette
    m.panelFill.blendColor = palette.panel.color
    m.panelFill.opacity = palette.panel.opacity
    m.animate = not palette.lowTier
    m.settingsMenu.animate = m.animate
end sub

' Every single choice in settings is made in this dialog over the panel, which opens on what's
' chosen now
sub openPicker(title as string, options as object, selectedIndex as integer, handler as string)
    dialog = newPickerDialog(title, options)
    dialog.selectedIndex = selectedIndex
    dialog.observeField("chosen", handler)
    showPickerDialog(dialog)
end sub

' A list of ticks, kept only when Save is chosen
sub openMultiPicker(title as string, options as object, checked as object, handler as string)
    dialog = newPickerDialog(title, options)
    dialog.multi = true
    dialog.checked = checked
    dialog.observeField("saved", handler)
    showPickerDialog(dialog)
end sub

function newPickerDialog(title as string, options as object) as object
    closePicker()
    dialog = CreateObject("roSGNode", "SettingsPickerDialog")
    dialog.style = m.sectionStyle
    dialog.title = title
    dialog.options = options
    return dialog
end function

sub showPickerDialog(dialog as object)
    dialog.observeField("closed", "closePicker")
    m.top.appendChild(dialog)
    dialog.callFunc("open")
    m.picker = dialog
end sub

sub closePicker()
    if not isValid(m.picker) then return
    m.picker.unobserveField("chosen")
    m.picker.unobserveField("saved")
    m.picker.unobserveField("closed")
    m.settingsMenu.setFocus(true)
    m.top.removeChild(m.picker)
    m.picker = invalid
end sub

function getFocusedSetting() as dynamic
    focusIndex = m.settingsMenu.itemFocused
    if focusIndex < 0 then return invalid

    if isValid(m.visibleItemsMap) and focusIndex < m.visibleItemsMap.Count()
        return m.visibleItemsMap[focusIndex]
    end if

    if m.userLocation.Count() > 0 and isValid(m.userLocation.peek().children) and focusIndex < m.userLocation.peek().children.Count()
        return m.userLocation.peek().children[focusIndex]
    end if

    return invalid
end function

function dynamicToDisplayString(value as dynamic) as string
    if not isValid(value) then return ""

    valueType = type(value)
    if isStringEqual(valueType, "Boolean") or isStringEqual(valueType, "roBoolean")
        if value then return "true"
        return "false"
    end if

    return value.ToStr()
end function

function isMediaBarMultiSelectSetting(settingName as dynamic) as boolean
    if not isValid(settingName) then return false
    if isStringEqual(settingName, "ui.home.mediaBarLibraryIds") then return true
    if isStringEqual(settingName, "ui.home.mediaBarCollectionIds") then return true
    if isStringEqual(settingName, "ui.home.mediaBarExcludedGenres") then return true
    return false
end function

function parseStringArraySetting(value as dynamic) as object
    if not isValid(value) then return []

    valueType = type(value)
    if valueType = "roArray" or valueType = "Array"
        result = []
        for each item in value
            if isValid(item)
                result.push(item.toStr())
            end if
        end for
        return result
    end if

    parsed = ParseJson(value.toStr())
    if type(parsed) = "roArray" or type(parsed) = "Array"
        result = []
        for each item in parsed
            if isValid(item)
                result.push(item.toStr())
            end if
        end for
        return result
    end if

    return []
end function


function getMediaBarSelectorSummary(settingName as string, currentValue as dynamic) as string
    selectedIds = parseStringArraySetting(currentValue)
    selectedCount = selectedIds.Count()

    if isStringEqual(settingName, "ui.home.mediaBarLibraryIds")
        if selectedCount = 0 then return tr("All Libraries")
        return `${selectedCount.toStr()} ${tr("selected")}`
    end if

    if isStringEqual(settingName, "ui.home.mediaBarCollectionIds")
        if selectedCount = 0 then return tr("All Collections/Playlists")
        return `${selectedCount.toStr()} ${tr("selected")}`
    end if

    if selectedCount = 0 then return tr("None")
    return `${selectedCount.toStr()} ${tr("excluded")}`
end function

function seasonalHolidaysSummary(currentValue as dynamic) as string
    hiddenCount = seasonalRow.HiddenHolidays(currentValue).Count()
    if hiddenCount = 0 then return tr("All holidays")
    return `${(seasonalRow.Holidays().Count() - hiddenCount).toStr()} ${tr("selected")}`
end function

sub showSeasonalHolidaysDialog(settingItem as object)
    options = []
    for each holiday in seasonalRow.Holidays()
        options.push({ id: holiday.id, title: tr(holiday.title) })
    end for
    showMediaBarSelectorDialog(settingItem, options, true)
end sub

' The switch also places the row in the layout, since the pulled layout drives the switch on
' the next sync and one without the row would turn it back off. A row turned on for the
' first time sits after Continue Watching and Next Up.
sub placeSeasonalRow(enabled as boolean)
    homeRowLayout.MigrateLegacySlots()
    order = buttonLayout.ToIds(get_user_setting(homeRowLayout.ORDER_SETTING))
    hidden = buttonLayout.ToIds(get_user_setting(homeRowLayout.HIDDEN_SETTING))
    if enabled and inArray(order, "seasonal") and not inArray(hidden, "seasonal") then return

    kept = []
    insertAt = 0
    for each id in order
        if id = "seasonal" then continue for
        kept.push(id)
        if id = "resume" or id = "nextup" then insertAt = kept.Count()
    end for

    remaining = []
    for each id in hidden
        if id <> "seasonal" then remaining.push(id)
    end for

    if enabled
        placed = []
        for i = 0 to kept.Count() - 1
            if i = insertAt then placed.push("seasonal")
            placed.push(kept[i])
        end for
        if insertAt >= kept.Count() then placed.push("seasonal")
        kept = placed
    else
        remaining.push("seasonal")
    end if

    saveHomeRowLayout(kept, remaining)
end sub

sub loadMediaBarPickerOptions(settingItem as object)
    if not isValid(settingItem) then return

    if isValid(m.mediaBarPickerTask)
        m.mediaBarPickerTask.unobserveFieldScoped("options")
        m.mediaBarPickerTask.unobserveFieldScoped("errorMessage")
    end if

    contentType = get_user_setting("ui.home.mediaBarContentType")
    if not isValidAndNotEmpty(contentType)
        contentType = "both"
    end if

    m.pendingMediaBarSettingItem = settingItem
    m.mediaBarPickerTask = createObject("roSGNode", "MediaBarPickerOptionsTask")
    m.mediaBarPickerTask.userId = m.global.session.user.id
    m.mediaBarPickerTask.settingName = settingItem.settingName
    m.mediaBarPickerTask.contentType = contentType
    m.mediaBarPickerTask.observeFieldScoped("options", "onMediaBarPickerOptionsLoaded")
    m.mediaBarPickerTask.observeFieldScoped("errorMessage", "onMediaBarPickerOptionsError")
    m.mediaBarPickerTask.control = "RUN"
end sub

sub onMediaBarPickerOptionsLoaded(event as object)
    options = event.getData()

    if not isValid(m.pendingMediaBarSettingItem)
        clearMediaBarPickerTask()
        return
    end if

    showMediaBarSelectorDialog(m.pendingMediaBarSettingItem, options)
    clearMediaBarPickerTask()
end sub

sub onMediaBarPickerOptionsError(event as object)
    err = dynamicToDisplayString(event.getData())
    if isValidAndNotEmpty(err)
        ShowToast(err, "error")
        m.settingsMenu.setFocus(true)
    end if
    clearMediaBarPickerTask()
end sub

sub clearMediaBarPickerTask(clearPending = true as boolean)
    if isValid(m.mediaBarPickerTask)
        m.mediaBarPickerTask.unobserveFieldScoped("options")
        m.mediaBarPickerTask.unobserveFieldScoped("errorMessage")
    end if

    m.mediaBarPickerTask = invalid
    if clearPending
        m.pendingMediaBarSettingItem = invalid
    end if
end sub

sub loadThemePickerOptions(settingItem as object)
    if not isValid(settingItem) then return

    clearThemeTasks()
    m.pendingThemeSettingItem = settingItem
    m.themeListTask = createObject("roSGNode", "ThemeListTask")
    m.themeListTask.observeFieldScoped("themes", "onThemeListLoaded")
    m.themeListTask.observeFieldScoped("errorMessage", "onThemeListError")
    m.themeListTask.control = "RUN"
end sub

sub onThemeListLoaded(event as object)
    themes = event.getData()
    settingItem = m.pendingThemeSettingItem
    clearThemeTasks(false)

    if not isValid(settingItem)
        m.pendingThemeSettingItem = invalid
        m.settingsMenu.setFocus(true)
        return
    end if

    if not isValidAndNotEmpty(themes)
        m.pendingThemeSettingItem = invalid
        ShowToast(tr("No themes available."), "error")
        m.settingsMenu.setFocus(true)
        return
    end if

    showThemePicker(settingItem, themes)
end sub

sub onThemeListError(event as object)
    err = dynamicToDisplayString(event.getData())
    clearThemeTasks()
    if isValidAndNotEmpty(err)
        ShowToast(err, "error")
    end if
    m.settingsMenu.setFocus(true)
end sub

sub showThemePicker(settingItem as object, themes as object)
    if not isValid(settingItem) then return

    m.themeOptions = themes

    currentId = get_user_setting("ui.theme.customThemeId")
    if not isValidAndNotEmpty(currentId) then currentId = "moonfin"

    options = []
    selectedIndex = 0
    for each theme in themes
        if isStringEqual(theme.id, currentId) then selectedIndex = options.Count()
        options.push({ id: theme.id, title: getThemeOptionTitle(theme) })
    end for

    m.pickerSetting = settingItem
    openPicker(tr(settingItem.title), options, selectedIndex, "onThemeChosen")
end sub

sub onThemeChosen()
    index = m.picker.chosen
    closePicker()
    applySelectedTheme(m.pickerSetting, index)
end sub

function getThemeOptionTitle(theme as object) as string
    title = chainLookupReturn(theme, "displayName", chainLookupReturn(theme, "id", ""))
    source = LCase(chainLookupReturn(theme, "source", ""))
    if source = "server"
        return `${title} (${tr("Server")})`
    else if source = "store"
        return `${title} (${tr("Community")})`
    end if
    return title
end function

sub applySelectedTheme(settingItem as object, idx as integer)
    if idx < 0 or idx >= m.themeOptions.count() then return

    chosen = m.themeOptions[idx]
    if not isValid(chosen) or not isValidAndNotEmpty(chosen.id) then return

    if themeRegistry.IsBuiltIn(chosen.id)
        theme = themeRegistry.ReadBundledTheme(chosen.id)
        finishThemeApply(theme, settingItem)
        return
    end if

    clearThemeTasks(false)
    m.pendingThemeSettingItem = settingItem
    m.themeResolveTask = createObject("roSGNode", "ThemeResolveTask")
    m.themeResolveTask.themeId = chosen.id
    m.themeResolveTask.observeFieldScoped("theme", "onThemeResolved")
    m.themeResolveTask.observeFieldScoped("errorMessage", "onThemeResolveError")
    m.themeResolveTask.control = "RUN"
end sub

sub onThemeResolved(event as object)
    theme = event.getData()
    settingItem = m.pendingThemeSettingItem
    clearThemeTasks(false)
    finishThemeApply(theme, settingItem)
end sub

sub onThemeResolveError(event as object)
    err = dynamicToDisplayString(event.getData())
    clearThemeTasks()
    if isValidAndNotEmpty(err)
        ShowToast(err, "error")
    end if
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

sub finishThemeApply(theme as dynamic, settingItem as dynamic)
    if not isValid(theme)
        m.pendingThemeSettingItem = invalid
        ShowToast(tr("Could not apply theme."), "error")
        hideEditingControls()
        m.settingsMenu.setFocus(true)
        return
    end if

    themeApply.ApplyTheme(theme, m.top.getScene())
    syncSettingToServer("ui.theme.customThemeId", theme.id)

    ShowToast(`${theme.displayName}`, "success")

    m.pendingThemeSettingItem = invalid
    hideEditingControls()
    applySettingsStyle()
    if isValid(settingItem) then RefreshCurrentMenu()
    m.settingsMenu.setFocus(true)
end sub

function getThemeDisplayName(id as dynamic) as string
    if not isValidAndNotEmpty(id) then return "Moonfin"
    if isStringEqual(id, "moonfin") then return "Moonfin"
    if isStringEqual(id, "neon_pulse") then return "Neon Pulse"
    if isStringEqual(id, "8bit_hero") then return "8-bit Hero"
    return id
end function

sub clearThemeTasks(clearPending = true as boolean)
    if isValid(m.themeListTask)
        m.themeListTask.unobserveFieldScoped("themes")
        m.themeListTask.unobserveFieldScoped("errorMessage")
        m.themeListTask = invalid
    end if
    if isValid(m.themeResolveTask)
        m.themeResolveTask.unobserveFieldScoped("theme")
        m.themeResolveTask.unobserveFieldScoped("errorMessage")
        m.themeResolveTask = invalid
    end if
    if clearPending then m.pendingThemeSettingItem = invalid
end sub

' A checklist over a stored list of ids. The media bar lists store what is ticked, the
' holiday list what is unticked, since there every holiday starts on.
sub showMediaBarSelectorDialog(settingItem as object, options as object, storesUnchecked = false as boolean)
    if not isValidAndNotEmpty(options)
        ShowToast("No options available for this setting right now.", "error")
        m.settingsMenu.setFocus(true)
        return
    end if

    storedValue = get_user_setting(settingItem.settingName)
    if not isValid(storedValue)
        storedValue = chainLookupReturn(m.global.session, `user.settings.${settingItem.settingName}`, "[]")
    end if
    selectedIds = parseStringArraySetting(storedValue)

    checked = []
    for each option in options
        checked.push(isGuidInArray(option.id, selectedIds) <> storesUnchecked)
    end for

    m.mediaBarSelectorSetting = settingItem
    m.mediaBarSelectorDialogOptions = options
    m.mediaBarSelectorStoresUnchecked = storesUnchecked
    openMultiPicker(tr(settingItem.title), options, checked, "onMediaBarSelectorSaved")
end sub

sub onMediaBarSelectorSaved()
    checked = m.picker.checked ?? []
    closePicker()

    selectedIds = []
    for i = 0 to m.mediaBarSelectorDialogOptions.Count() - 1
        isChecked = i < checked.Count() and checked[i] = true
        if isChecked <> m.mediaBarSelectorStoresUnchecked then selectedIds.push(m.mediaBarSelectorDialogOptions[i].id)
    end for

    settingItem = m.mediaBarSelectorSetting
    serialized = FormatJson(selectedIds)
    set_user_setting(settingItem.settingName, serialized)
    syncSettingToServer(settingItem.settingName, serialized)
    refreshCurrentItemValue(settingItem)
    m.mediaBarSelectorDialogOptions = []
end sub


function getSettingCurrentValueLabel(settingItem as dynamic) as string
    if not isValid(settingItem) then return ""
    if not isValid(settingItem.type) then return ""
    if not isValid(settingItem.settingName) then return ""


    if isStringEqual(settingItem.settingName, "seerr.accountSettings")
        return GetSeerrAccountStatusLabel()
    end if

    if isStringEqual(settingItem.settingName, "seerr.blockNsfw")
        config = GetSeerrConfig()
        if config.blockNsfw = true
            return tr("Enabled")
        end if
        return tr("Disabled")
    end if

    if isStringEqual(settingItem.settingName, "ui.theme.picker")
        return getThemeDisplayName(get_user_setting("ui.theme.customThemeId"))
    end if

    if isStringEqual(settingItem.settingName, "plugin.syncProfiles")
        if not settingsSync.IsSyncEnabled() then return ""
        return tr(settingsSync.ProfileTitle(settingsSync.ActiveProfile()))
    end if

    currentValue = get_user_setting(settingItem.settingName)
    if not isValid(currentValue) and isValid(m.global.session.user.settings[settingItem.settingName])
        currentValue = m.global.session.user.settings[settingItem.settingName]
    end if

    if isMediaBarMultiSelectSetting(settingItem.settingName)
        return getMediaBarSelectorSummary(settingItem.settingName, currentValue)
    end if

    if isStringEqual(settingItem.settingName, seasonalRow.HIDDEN_HOLIDAYS_SETTING)
        return seasonalHolidaysSummary(currentValue)
    end if

    if isStringEqual(settingItem.type, SettingType.BOOL)
        valueString = LCase(dynamicToDisplayString(currentValue))
        if isStringEqual(valueString, "true")
            return tr("Enabled")
        end if
        return tr("Disabled")
    end if

    if isStringEqual(settingItem.type, SettingType.RADIO)
        selectedValue = dynamicToDisplayString(currentValue)
        for each option in settingItem.options
            optionId = dynamicToDisplayString(option.id)
            if isStringEqual(optionId, selectedValue)
                return tr(chainLookupReturn(option, "title", optionId))
            end if
        end for
        return selectedValue
    end if

    if isStringEqual(settingItem.type, SettingType.integer)
        return dynamicToDisplayString(currentValue)
    end if

    if isStringEqual(settingItem.type, SettingType.COLORGRID)
        return UCase(dynamicToDisplayString(currentValue))
    end if

    if isStringEqual(settingItem.type, SettingType.string)
        settingKeyLower = LCase(chainLookupReturn(settingItem, "settingName", ""))
        if InStr(settingKeyLower, "apikey") > 0 or InStr(settingKeyLower, "password") > 0
            return "********"
        end if
        return dynamicToDisplayString(currentValue)
    end if

    return ""
end function

sub refreshCurrentItemValue(settingItem = invalid as dynamic)
    if not isValid(settingItem) then settingItem = getFocusedSetting()
    if not isValid(settingItem) then return
    index = rowIndexOf(settingItem)
    if index >= 0 then refreshRow(index)
end sub

' Where an entry sits in the list on screen. Ratings and detail sections share a setting name, so
' they're told apart by what they hold.
function rowIndexOf(settingItem as object) as integer
    wanted = settingRowKey(settingItem)
    focused = m.settingsMenu.itemFocused
    if focused >= 0 and focused < m.visibleItemsMap.Count() and settingRowKey(m.visibleItemsMap[focused]) = wanted then return focused
    for i = 0 to m.visibleItemsMap.Count() - 1
        if settingRowKey(m.visibleItemsMap[i]) = wanted then return i
    end for
    return -1
end function

function settingRowKey(settingItem as dynamic) as string
    if not isValid(settingItem) then return ""
    return `${settingItem.settingName ?? ""}|${settingItem.rating ?? ""}|${settingItem.sectionId ?? ""}|${settingItem.title ?? ""}`
end function

' A row lays itself out again with what it holds now, and the rows under it move if it grew
sub refreshRow(index as integer)
    settingItem = m.visibleItemsMap[index]
    rowNode = m.settingsMenu.content.getChild(index)
    if not isValid(settingItem) or not isValid(rowNode) then return

    height = layoutRow(rowNode, settingsRowSpec(settingItem), m.rowBands[index], m.sectionStyle, settingsMetrics.PANEL_WIDTH)
    heights = m.settingsMenu.rowHeights
    if Abs(heights[index] - height) > 0.5
        heights[index] = height
        m.settingsMenu.rowHeights = heights
    else
        m.settingsMenu.callFunc("refreshItem", index)
    end if
end sub

' What an entry shows as a row: its kind, the line under its title and what sits on the end
function settingsRowSpec(settingItem as object) as object
    rowType = settingItem.type ?? ""
    if rowType = SettingType.SECTION then return { band: "header", text: tr(settingItem.title ?? "") }
    if rowType = SettingType.NOTE then return { band: "note", text: tr(settingItem.title ?? ""), caption: tr(settingItem.description ?? ""), tone: settingItem.tone ?? "", lead: settingItem.lead = true }
    if rowType = "about" then return { band: "about", text: Substitute(tr("Version {0}"), settingItem.title) }

    settingName = settingItem.settingName ?? ""
    description = tr(settingItem.description ?? "")
    spec = { id: settingName, title: tr(settingItem.title ?? ""), glyph: settingItem.glyph ?? "tune", logo: settingItem.logo ?? "" }

    if rowType = SettingType.BOOL
        enabled = boolSettingDisplay(settingItem) = "true"
        spec.boolValue = enabled
        if settingName = "parental.rating"
            spec.kind = "check"
            spec.glyph = "check_box_outline_blank"
            if enabled then spec.glyph = "check_box"
            return spec
        end if
        spec.kind = "switch"
        spec.subtitle = description
        spec.glyphStrong = true
        return spec
    end if

    value = getSettingCurrentValueLabel(settingItem)
    if settingName = "pin.setCode" then value = tr(signInPinDescription())
    if rowType = SettingType.RADIO and settingItem.slider = true
        spec.kind = "slider"
        spec.sliderCount = settingItem.options.Count()
        spec.sliderIndex = currentOptionIndex(settingItem)
        spec.subtitle = value
        return spec
    end if

    opensList = isMediaBarMultiSelectSetting(settingName) or isStringEqual(settingName, seasonalRow.HIDDEN_HOLIDAYS_SETTING)
    if rowType = SettingType.RADIO or rowType = SettingType.integer or rowType = SettingType.COLORGRID or (rowType = SettingType.string and not opensList)
        spec.kind = "picker"
        spec.subtitle = description
        spec.chip = settingChipLabel(settingItem, value)
        return spec
    end if

    if settingName = "seerr.accountStatus" or (settingName = "" and not isValid(settingItem.children))
        spec.kind = "info"
        spec.subtitle = description
        return spec
    end if

    spec.kind = "nav"
    spec.subtitle = description
    if value <> "" then spec.subtitle = value
    return spec
end function

' A picker's bubble shows the short form of a long option when the option has one
function settingChipLabel(settingItem as object, value as string) as string
    if settingItem.type <> SettingType.RADIO or not isValid(settingItem.options) then return value
    option = settingItem.options[currentOptionIndex(settingItem)]
    if isValid(option) and isValidAndNotEmpty(option.chip) then return tr(option.chip)
    return value
end function

function currentOptionIndex(settingItem as object) as integer
    stored = dynamicToDisplayString(getUserSettingValue(settingItem.settingName, settingItem.default))
    for i = 0 to settingItem.options.Count() - 1
        if isStringEqual(dynamicToDisplayString(settingItem.options[i].id), stored) then return i
    end for
    return 0
end function

' "true" or "false" for a switch row. A rating's switch shows whether it is on the blocked list
' rather than a stored setting.
function boolSettingDisplay(settingItem as object) as string
    if isStringEqual(settingItem.settingName, "parental.rating")
        return inArray(parentalControls.BlockedRatings(), settingItem.rating) ? "true" : "false"
    end if
    if isStringEqual(settingItem.settingName, "ui.itemdetail.section")
        return detailSectionLayout.HiddenIds().DoesExist(settingItem.sectionId) ? "false" : "true"
    end if

    rawVal = get_user_setting(settingItem.settingName)
    if not isValid(rawVal) and isValid(m.global.session.user.settings[settingItem.settingName])
        rawVal = m.global.session.user.settings[settingItem.settingName]
    end if
    if not isValid(rawVal)
        rawVal = settingItem.default
    end if
    return LCase(dynamicToDisplayString(rawVal))
end function

' The picker draws its own panel, so it is parented to the settings screen and its list
' takes focus rather than being handed to the scene as a stock dialog
sub showPickerPanel(dialog as object)
    m.top.appendChild(dialog)
    dialog.findNode("checklist").setFocus(true)
end sub

sub closePickerPanel(dialog as object)
    m.top.removeChild(dialog)
end sub

sub saveHomeRowLayout(order as object, hidden as object)
    set_user_setting(homeRowLayout.ORDER_SETTING, FormatJson(order))
    set_user_setting(homeRowLayout.HIDDEN_SETTING, FormatJson(hidden))
    syncHomeRowsToServer()
end sub

' The individual collections, genres or playlists that can each be a row of their own. The
' list comes from the server, so the dialog only opens once it arrives.
sub showPickedRowsDialog(settingItem as object)
    listEntry = homeRowLayout.SourceForSetting(chainLookupReturn(settingItem, "settingName", ""))
    if not isValid(listEntry) then return

    ' The list takes a moment to arrive, so a second press while one is already loading is
    ' ignored rather than leaving two tasks racing to fill the same dialog
    if isValid(m.pickedTask) and m.pickedTask.state = "run" then return

    m.pickedList = listEntry
    m.pickedTitle = tr(chainLookupReturn(settingItem, "title", ""))
    m.pickedTask = createObject("roSGNode", "LoadItemsTask")
    m.pickedTask.itemsToLoad = listEntry.task
    m.pickedTask.observeField("content", "onPickedRowsLoaded")
    m.pickedTask.control = "RUN"
end sub

' The shared message helper waits on a message port, which would freeze the render thread
' the settings screen runs on, so the scene shows this one instead
sub showNothingToPickDialog()
    dialog = createObject("roSGNode", "StandardMessageDialog")
    dialog.title = m.pickedTitle
    dialog.message = [tr("Nothing to pick from here yet.")]
    dialog.buttons = [tr("OK")]
    dialog.observeField("buttonSelected", "onNothingToPickDismissed")
    m.top.getScene().dialog = dialog
end sub

sub onNothingToPickDismissed(event as object)
    event.getRoSGNode().unobserveField("buttonSelected")
    m.top.getScene().dialog = invalid
    m.settingsMenu.setFocus(true)
end sub

sub onPickedRowsLoaded(event as object)
    task = event.getRoSGNode()
    found = event.getData()
    task.unobserveField("content")
    m.pickedTask = invalid

    if not isValidAndNotEmpty(found)
        showNothingToPickDialog()
        return
    end if

    placed = buttonLayout.ToIds(get_user_setting(homeRowLayout.ORDER_SETTING))
    off = buttonLayout.HiddenLookup(get_user_setting(homeRowLayout.HIDDEN_SETTING))
    picked = homeRowLayout.DynamicLookup()
    serverKey = homeRowLayout.ServerId()

    options = []
    checked = []
    for each item in found
        itemId = homeRowLayout.AsText(item.id)
        if itemId = "" then continue for

        rowId = homeRowLayout.DynamicId(m.pickedList.key, serverKey, itemId)
        options.push({ id: rowId, title: item.title })
        checked.push(homeRowLayout.IsEnabled(rowId, placed, off, picked))
    end for

    m.pickedOptions = options
    openMultiPicker(m.pickedTitle, options, checked, "onPickedRowsSaved")
end sub

sub onPickedRowsSaved()
    checked = m.picker.checked ?? []
    closePicker()

    ' Only this list is rewritten, so a collection picked here leaves the genres alone
    kept = []
    for each entry in homeRowLayout.DynamicRows()
        if not isStringEqual(entry.source, m.pickedList.key) then kept.push(entry)
    end for

    off = buttonLayout.HiddenLookup(get_user_setting(homeRowLayout.HIDDEN_SETTING))
    anyPicked = false
    for i = 0 to m.pickedOptions.Count() - 1
        if i >= checked.Count() or checked[i] <> true then continue for
        option = m.pickedOptions[i]

        fromId = homeRowLayout.SourceFromId(option.id)
        if not isValid(fromId) then continue for

        kept.push({
            id: option.id,
            source: m.pickedList.key,
            itemId: fromId.itemId,
            title: option.title
        })
        anyPicked = true
        ' Picking a row again clears the switch off it left behind
        off.Delete(option.id)
    end for

    homeRowLayout.SaveDynamic(kept)
    saveHomeRowLayout(buttonLayout.ToIds(get_user_setting(homeRowLayout.ORDER_SETTING)), off.Keys())

    ' These rows also answer to the switch for the list they came from, which sits in a
    ' submenu of its own, so picking one turns it on rather than leaving nothing to show
    if anyPicked then setUserBoolSetting(m.pickedList.gate, true, true)
    m.pickedOptions = []
end sub

sub saveButtonLayout(target as object, order as object, hidden as object)
    for each entry in [{ key: target.orderKey, value: order }, { key: target.hiddenKey, value: hidden }]
        serialized = FormatJson(entry.value)
        set_user_setting(entry.key, serialized)
        syncSettingToServer(entry.key, serialized)
    end for
end sub

' Sync a setting to the server via PostTask (render-thread safe).
sub syncSettingToServer(rokuKey as string, rokuValue as dynamic)
    pushData = settingsSync.PreparePush(rokuKey, rokuValue)
    if not isValid(pushData) then return

    ' Held until they finish, since two settings can be pushed back to back and a
    ' task with nothing referencing it can be collected mid flight
    if not isValid(m.settingsSyncTasks) then m.settingsSyncTasks = []
    running = []
    for each pending in m.settingsSyncTasks
        if isStringEqual(pending.state, "run") then running.push(pending)
    end for

    diagnostics.Log(diagnostics.CAT_SYNC, diagnostics.LEVEL_DEBUG, `Pushing ${rokuKey} to the server`)

    task = createObject("roSGNode", "PostTask")
    task.apiUrl = pushData.url
    task.stringData = pushData.body
    task.control = "RUN"

    running.push(task)
    m.settingsSyncTasks = running
end sub

function getUserSettingValue(settingName as string, defaultValue = invalid as dynamic) as dynamic
    value = get_user_setting(settingName)
    if isValid(value)
        return value
    end if

    settings = chainLookupReturn(m.global, "session.user.settings", invalid)
    if isValid(settings) and isValid(settings[settingName])
        return settings[settingName]
    end if

    return defaultValue
end function

' The layout rides the settings profile like every other setting. Both keys go together,
' since a row order arriving without sections makes the server drop the sections it holds,
' taking the other clients' disabled and plugin rows with them.
sub syncHomeRowsToServer()
    if not settingsSync.IsSyncEnabled()
        return
    end if

    pushData = settingsSync.ProfilePush({
        homeSections: settingsSync.HomeSectionsPayload(),
        homeRowOrder: homeRowLayout.Arranged()
    })

    m.homeRowsSyncTask = createObject("roSGNode", "PostTask")
    m.homeRowsSyncTask.apiUrl = pushData.url
    m.homeRowsSyncTask.stringData = pushData.body
    m.homeRowsSyncTask.control = "RUN"
end sub

' Left and right step a slider row, the value it shows changes at once and the save waits for the
' presses to stop, so holding a key sends the server one change rather than one for every step
function stepSlider(direction as integer) as boolean
    settingItem = getFocusedSetting()
    if not isValid(settingItem) or settingItem.slider <> true then return false

    index = currentOptionIndex(settingItem)
    if isValid(m.sliderPending) and settingRowKey(m.sliderPending.item) = settingRowKey(settingItem) then index = m.sliderPending.index
    target = index + direction
    if target < 0 or target >= settingItem.options.Count() then return true

    m.sliderPending = { item: settingItem, index: target }
    rowNode = m.settingsMenu.content.getChild(m.settingsMenu.itemFocused)
    rowNode.sliderIndex = target
    rowNode.subtitle = tr(settingItem.options[target].title)
    m.settingsMenu.callFunc("refreshItem", m.settingsMenu.itemFocused)
    m.sliderSaveTimer.control = "stop"
    m.sliderSaveTimer.control = "start"
    return true
end function

sub flushSliderSave()
    m.sliderSaveTimer.control = "stop"
    pending = m.sliderPending
    m.sliderPending = invalid
    if not isValid(pending) then return
    applyRadioChoice(pending.item, pending.item.options[pending.index].id)
end sub

sub onColorSelected()
    selectedColor = m.colorgrid.content.getChild(m.colorgrid.itemSelected).colorCode
    m.colorgrid.selectedColor = selectedColor

    selectedSetting = getFocusedSetting()
    if not isValid(selectedSetting) then return

    set_user_setting(selectedSetting.settingName, selectedColor ?? ColorPalette.VIEWBACKGROUND)

    scene = m.top.getScene()

    if isStringEqual(selectedSetting.settingName, "colorBackground") and isValid(scene)
        scene.backgroundColor = selectedColor ?? ColorPalette.VIEWBACKGROUND
    end if

    if isStringEqual(selectedSetting.settingName, "colorCursor") and isValid(scene)
        activeNav = getActiveNav(scene)
        if isValid(activeNav)
            overlayCurrentUserSelection = activeNav.findNode("overlayCurrentUserSelection")
            if isValid(overlayCurrentUserSelection)
                overlayCurrentUserSelection.blendColor = selectedColor ?? ColorPalette.HIGHLIGHT
            end if
        end if

        'm.settingsMenu.focusBitmapBlendColor = selectedColor ?? ColorPalette.HIGHLIGHT
    end if

    if isStringEqual(selectedSetting.settingName, "colorHomeUsername") and isValid(scene)
        activeNav = getActiveNav(scene)
        if isValid(activeNav)
            overlayCurrentUser = activeNav.findNode("overlayCurrentUser")
            if isValid(overlayCurrentUser)
                overlayCurrentUser.color = selectedColor ?? ColorPalette.WHITE
            end if
        end if
    end if

    refreshCurrentItemValue(selectedSetting)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

' The one keypad the screen has, borrowed for the four digits that hold Kids Mode or the app shut
sub openKidsPin(mode as string)
    m.kidsPinMode = mode
    signingIn = mode = "signIn"
    m.integerSetting.textEditBox.secureMode = signingIn
    if signingIn then m.integerSetting.textEditBox.hintText = tr("4 digits")
    m.integerSetting.text = ""
    m.integerSetting.visible = true
    m.integerSetting.setFocus(true)
end sub

sub submitKidsPin()
    entered = m.integerSetting.text

    if m.kidsPinMode = "signIn"
        submitSignInPin(entered)
        return
    end if

    if m.kidsPinMode = "set"
        if not pinLockout.IsPinShaped(entered)
            ShowToast(tr("PIN must be exactly 4 digits."))
            return
        end if

        kidsMode.TurnOn(pinLockout.HashPin(entered))
        pinLockout.ClearLockout(pinLockout.KidsKeys())
        leaveKidsPin()
        return
    end if

    ' Asked before the guess is looked at, so waiting is the only way through and reopening the
    ' keypad hands back no fresh guesses
    waiting = pinLockout.Remaining(pinLockout.KidsKeys())
    if waiting > 0
        ShowToast(pinLockout.TooManyAttempts(waiting))
        m.integerSetting.text = ""
        return
    end if

    if kidsMode.NeedsPin() and not pinLockout.Matches(entered, kidsMode.PinHash())
        wait = pinLockout.RegisterFailure(pinLockout.KidsKeys())
        ShowToast(wait > 0 ? pinLockout.TooManyAttempts(wait) : tr("Incorrect PIN"))
        m.integerSetting.text = ""
        return
    end if

    kidsMode.TurnOff()
    pinLockout.ClearLockout(pinLockout.KidsKeys())
    leaveKidsPin()
end sub

' Read on every open, so a rating the server picked up since shows without a restart
sub openBlockedRatings(section as object)
    m.blockedRatingsSection = section
    if isValid(m.serverRatingsTask) then m.serverRatingsTask.unobserveField("result")

    startLoadingSpinner()
    m.serverRatingsTask = createObject("roSGNode", "ServerRatingsTask")
    m.serverRatingsTask.observeField("result", "onServerRatingsLoaded")
    m.serverRatingsTask.control = "RUN"
end sub

sub onServerRatingsLoaded(event as object)
    event.getRoSGNode().unobserveField("result")
    m.serverRatingsTask = invalid
    stopLoadingSpinner()

    result = event.getData()
    ' What was blocked before stays listed even when the library no longer has it, so it can
    ' still be let go
    offered = []
    offered.append(chainLookupReturn(result, "ratings", []))
    offered.append(parentalControls.BlockedRatings())
    ratings = parentalFilter.SortBySeverity(parentalFilter.NormalizeList(offered))

    section = m.blockedRatingsSection
    section.pathTitle = "Parental Controls"
    section.children = blockedRatingRows(ratings, chainLookupReturn(result, "failed", false) = true)
    LoadMenu(section)
    m.settingsMenu.setFocus(true)
end sub

' Ratings that cant be ranked sit apart, since they only ever block themselves
function blockedRatingRows(ratings as object, loadFailed as boolean) as object
    rows = [{ title: "Block content with the following ratings:", description: "Blocking a rating also blocks everything stronger than it.", type: SettingType.NOTE, lead: true }]
    if ratings.count() = 0
        message = loadFailed ? "Could not load server ratings. Showing saved ratings only." : "No content ratings were found on this server yet."
        rows.push({ title: message, type: SettingType.NOTE })
        return rows
    end if

    if loadFailed then rows.push({ title: "Could not refresh ratings from server. Showing saved ratings.", type: SettingType.NOTE, tone: "error" })

    ranked = []
    unranked = []
    for each rating in ratings
        row = { title: rating, settingName: "parental.rating", rating: rating, type: SettingType.BOOL }
        if parentalFilter.RatingIsRanked(rating)
            ranked.push(row)
        else
            unranked.push(row)
        end if
    end for

    if ranked.count() > 0
        rows.push({ title: "Ratings", type: SettingType.SECTION })
        rows.append(ranked)
    end if
    if unranked.count() > 0
        rows.push({ title: "Only blocks itself", type: SettingType.SECTION })
        rows.append(unranked)
    end if
    return rows
end function

' Written straight through, the way a switch is, and read from the store so two quick presses
' cant drop each other's change
sub toggleBlockedRating(ratingRow as object)
    current = parentalControls.BlockedRatings()
    if inArray(current, ratingRow.rating)
        kept = []
        for each rating in current
            if rating <> ratingRow.rating then kept.push(rating)
        end for
        parentalControls.SetBlockedRatings(kept)
    else
        current.push(ratingRow.rating)
        parentalControls.SetBlockedRatings(current)
    end if

    m.blockedRatingsChanged = true
    refreshCurrentItemValue(ratingRow)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

' Switches for the parts of the Details screen, limited to what the chosen style draws. The hidden
' list is shared, so a section switched off under one style stays off after switching to another
function detailSectionRows() as object
    style = normalizeDetailScreenStyleToken(getUserSettingValue("ui.itemdetail.style", "modern"))
    offered = detailSectionLayout.Offered(style, GetSeerrConfig().enabled)

    rows = [{ title: "Only the sections the current Details screen style can show are listed. Hiding one hides it in every style that has it.", type: SettingType.NOTE }]
    for each group in detailSectionLayout.Groups()
        groupRows = []
        for each section in offered
            if section.group = group.id then groupRows.push({ title: section.label, description: section.subtitle ?? "", settingName: "ui.itemdetail.section", sectionId: section.id, type: SettingType.BOOL, glyph: settingsIcons.SectionGlyph(section.id) })
        end for
        if groupRows.Count() > 0
            rows.push({ title: group.id = "seerr" ? GetSeerrDisplayName() : group.label, type: SettingType.SECTION })
            rows.append(groupRows)
        end if
    end for
    return rows
end function

' Each press writes straight away, since there is no order to arrange first
sub toggleDetailSection(sectionRow as object)
    hidden = FormatJson(detailSectionLayout.Toggle(get_user_setting(DETAIL_SECTIONS_HIDDEN_SETTING), sectionRow.sectionId))
    set_user_setting(DETAIL_SECTIONS_HIDDEN_SETTING, hidden)
    syncSettingToServer(DETAIL_SECTIONS_HIDDEN_SETTING, hidden)
    refreshCurrentItemValue(sectionRow)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

' Choosing a PIN forgets the guesses that came before it, and the row says one is set from here on
sub submitSignInPin(entered as string)
    if not pinLockout.IsPinShaped(entered)
        ShowToast(tr("PIN must be exactly 4 digits."))
        return
    end if

    signInPin.Save(entered)
    m.kidsPinMode = ""
    hideEditingControls()

    pinRow = getFocusedSetting()
    if isValid(pinRow) then refreshCurrentItemValue(pinRow)
    m.settingsMenu.setFocus(true)
end sub

function signInPinDescription() as string
    if signInPin.IsConfigured() then return "Configured 4-digit PIN"
    return "Default PIN: 0000"
end function

' The settings screen is standing on entries the mode has just taken away, and the home screen
' behind it is holding rows it either lost or got back
sub leaveKidsPin()
    m.kidsPinMode = ""
    hideEditingControls()
    dismissPanel()

    while m.global.sceneManager.callFunc("getSceneCount") > 1
        m.global.sceneManager.callFunc("popScene")
    end while

    home = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(home) and home.isSubtype("Home") then home.callFunc("reload")
end sub

sub onKeyGridSubmit()
    if m.kidsPinMode <> ""
        submitKidsPin()
        return
    end if

    selectedSetting = getFocusedSetting()
    if not isValid(selectedSetting) then return

    if isValid(selectedSetting.max) and m.integerSetting.text.ToInt() > selectedSetting.max.ToInt()
        m.integerSetting.text = selectedSetting.max
        return
    end if
    set_user_setting(selectedSetting.settingName, m.integerSetting.text)
    syncSettingToServer(selectedSetting.settingName, m.integerSetting.text)
    refreshCurrentItemValue(selectedSetting)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

sub onKeyGridEscape()
    if m.integerSetting.escape = "left" or m.integerSetting.escape = "back"
        m.kidsPinMode = ""
        hideEditingControls()
        m.settingsMenu.setFocus(true)
    end if
end sub

sub showStringInputDialog(settingItem as object)
    m.currentStringSetting = settingItem

    currentValue = get_user_setting(settingItem.settingName)
    if not isValid(currentValue) then currentValue = ""

    isSecure = (InStr(LCase(settingItem.settingName), "password") > 0 or InStr(LCase(settingItem.settingName), "apikey") > 0)

    m.stringInputDialog = tvKeyboard.Open(m.top.getScene(), {
        title: tr(settingItem.title),
        text: currentValue,
        secure: isSecure
    })
    m.stringInputDialog.observeField("submitted", "onStringInputSubmitted")
    m.stringInputDialog.observeField("cancelled", "onStringInputClosed")
end sub

sub onStringInputSubmitted(event as object)
    panel = event.getRoSGNode()
    if isValid(m.currentStringSetting)
        set_user_setting(m.currentStringSetting.settingName, panel.text)
    end if
    onStringInputClosed(event)
end sub

sub onStringInputClosed(_event as object)
    updatedSetting = m.currentStringSetting
    if isValid(m.stringInputDialog)
        m.stringInputDialog.unobserveField("submitted")
        m.stringInputDialog.unobserveField("cancelled")
        m.stringInputDialog = invalid
    end if

    m.settingsMenu.setFocus(true)
    m.currentStringSetting = invalid
    refreshCurrentItemValue(updatedSetting)
end sub

sub testPluginConnection()
    if isValid(m.pluginPingTask)
        m.pluginPingTask.unobserveField("result")
    end if

    m.pluginPingTask = createObject("roSGNode", "PluginPingTask")
    m.pluginPingTask.observeField("result", "onPluginPingComplete")
    m.pluginPingTask.control = "RUN"
end sub

sub onPluginPingComplete()
    if not isValid(m.pluginPingTask) then return

    result = m.pluginPingTask.result
    m.pluginPingTask.unobserveField("result")
    m.pluginPingTask = invalid

    if isValid(result) and (result.success ?? false)
        pluginInfo = {
            installed: true,
            version: result.version ?? "unknown",
            settingsSyncEnabled: result.settingsSyncEnabled ?? false,
            mdblistAvailable: result.mdblistAvailable ?? false,
            tmdbAvailable: result.tmdbAvailable ?? false,
            seerrEnabled: result.seerrEnabled ?? false,
            defaultSettings: result.defaultSettings ?? invalid
        }
        tmpSession = m.global.session
        tmpSession.AddReplace("pluginInfo", pluginInfo)
        m.global.setFields({ session: tmpSession })
    else
        ShowToast("Could not connect to Moonfin Plugin. Ensure the plugin is installed on your Jellyfin server.", "error")
        set_user_setting("plugin.enabled", "false")
        session.user.settings.Save("plugin.enabled", "false")
    end if

    if m.userLocation.Count() > 0
        RefreshCurrentMenu()
    end if
    if isValid(m.settingsSyncPanel) and isValid(m.settingsSyncPanel.getParent()) then m.settingsSyncPanel.callFunc("refresh")
end sub

' Helper function to check if a value is a valid non-empty string
function isValidString(value as dynamic) as boolean
    if value = invalid then return false
    if type(value) <> "String" and type(value) <> "roString" then return false
    return value <> ""
end function

sub ShowToast(message as string, _toastType = "" as string)
    if m.activeToast <> invalid
        DismissToast()
    end if

    toastMessage = ""
    if message <> invalid
        if type(message) = "String" or type(message) = "roString"
            toastMessage = message.Trim()
        else
            toastMessage = message.ToStr()
        end if
    end if
    if toastMessage = ""
        toastMessage = "Done."
    end if

    ' Create a simple toast notification using JFMessageDialog
    toast = createObject("roSGNode", "JFMessageDialog")
    ' The dialog works its height out from the size it is told, and a message without one is
    ' drawn with no room to appear in. A font registry is main thread only, so the line is
    ' measured from what it holds.
    toast.fontHeight = TOAST_LINE_HEIGHT
    toast.fontWidth = toastMessage.len() * TOAST_CHARACTER_WIDTH
    toast.message = toastMessage
    toast.options = ["OK"]
    m.top.getScene().appendChild(toast)

    optionList = toast.findNode("optionList")
    if optionList <> invalid
        optionList.observeField("itemSelected", "onToastOptionSelected")
    end if

    m.activeToast = toast
    toast.observeField("backPressed", "onToastClosed")
    toast.setFocus(true)
end sub

sub onToastOptionSelected(_obj as object)
    DismissToast()
end sub

' Handle toast dialog closed
sub onToastClosed(_obj as object)
    DismissToast()
end sub

sub DismissToast()
    if m.activeToast = invalid
        return
    end if

    optionList = m.activeToast.findNode("optionList")
    if optionList <> invalid
        optionList.unobserveField("itemSelected")
    end if
    m.activeToast.unobserveField("backPressed")

    scene = m.top.getScene()
    if scene <> invalid
        scene.removeChild(m.activeToast)
    end if

    m.activeToast = invalid

    ' A PIN the viewer is still in the middle of gets its keypad back rather than the list
    if m.kidsPinMode <> ""
        m.integerSetting.visible = true
        m.integerSetting.setFocus(true)
        return
    end if

    m.settingsMenu.setFocus(true)
end sub

sub PopulateSeerrAccountChildren(section as object)
    m.seerrAccountSection = section
    userId = chainLookupReturn(m.global, "session.user.id", "")
    userConfig = GetSeerrUserConfig(userId)
    isLoggedIn = isValid(userConfig) and isValidAndNotEmpty(userConfig.displayName)

    if isLoggedIn
        displayName = userConfig.displayName
        section.children = [
            {
                title: "Signed in as " + displayName,
                description: "You are currently authenticated with Seerr.",
                settingName: "seerr.accountStatus",
                type: "action"
            },
            {
                title: "Sign Out",
                description: "Sign out from your Seerr account.",
                settingName: "seerr.signOut",
                type: "action"
            }
        ]
    else
        config = GetSeerrConfig()
        pluginAvailable = (config.usePluginProxy ?? false) and (config.serverUrl ?? "") <> ""
        if pluginAvailable
            section.children = [
                {
                    title: "Sign in with Jellyfin",
                    description: "Use your Jellyfin credentials to sign in to Seerr.",
                    settingName: "seerr.signIn.jellyfin",
                    type: "action"
                },
                {
                    title: "Sign in with Local Account",
                    description: "Use a local Seerr account (email and password).",
                    settingName: "seerr.signIn.local",
                    type: "action"
                }
            ]
        else
            section.children = [
                {
                    title: "Not signed in",
                    description: "Seerr plugin authentication is unavailable. Ask your server admin to enable the Seerr plugin.",
                    settingName: "seerr.accountStatus",
                    type: "action"
                }
            ]
        end if
    end if
end sub

sub StartSeerrJellyfinSignIn()
    m.seerrKeyboardMode = "jellyfin_username"
    defaultUsername = ""
    if m.global <> invalid and m.global.session <> invalid and m.global.session.user <> invalid and m.global.session.user.name <> invalid
        defaultUsername = m.global.session.user.name
    end if
    ShowSeerrKeyboard("Jellyfin Username", defaultUsername, false)
end sub

sub StartSeerrLocalSignIn()
    m.seerrKeyboardMode = "local_username"
    ShowSeerrKeyboard("Email", "", false)
end sub

sub ShowSeerrKeyboard(title as string, initialValue as string, isPassword as boolean)
    chips = []
    if not isPassword and m.seerrKeyboardMode = "local_username" then chips = tvKeyboard.EmailChips()

    m.seerrKeyboard = tvKeyboard.Open(m.top.getScene(), {
        title: tr(title),
        text: initialValue,
        secure: isPassword,
        chips: chips
    })
    m.seerrKeyboard.observeField("submitted", "onSeerrKeyboardSubmitted")
    m.seerrKeyboard.observeField("cancelled", "onSeerrKeyboardCancelled")
end sub

sub releaseSeerrKeyboard()
    tvKeyboard.Release(m.seerrKeyboard, ["submitted", "cancelled"])
    m.seerrKeyboard = invalid
end sub

sub onSeerrKeyboardCancelled(_event as object)
    releaseSeerrKeyboard()
    m.seerrKeyboardMode = ""
    m.seerrTempUsername = ""
    m.settingsMenu.setFocus(true)
end sub

sub onSeerrKeyboardSubmitted(event as object)
    enteredText = event.getRoSGNode().text
    releaseSeerrKeyboard()

    if m.seerrKeyboardMode = "jellyfin_username"
        m.seerrTempUsername = enteredText
        m.seerrKeyboardMode = "jellyfin_password"
        ShowSeerrKeyboard("Jellyfin Password", "", true)
        return
    else if m.seerrKeyboardMode = "jellyfin_password"
        username = m.seerrTempUsername
        m.seerrTempUsername = ""
        m.seerrKeyboardMode = ""
        PerformSeerrPluginLogin("jellyfin", username, enteredText)
    else if m.seerrKeyboardMode = "local_username"
        m.seerrTempUsername = enteredText
        m.seerrKeyboardMode = "local_password"
        ShowSeerrKeyboard("Password", "", true)
        return
    else if m.seerrKeyboardMode = "local_password"
        username = m.seerrTempUsername
        m.seerrTempUsername = ""
        m.seerrKeyboardMode = ""
        PerformSeerrPluginLogin("local", username, enteredText)
    end if

    m.settingsMenu.setFocus(true)
end sub

sub PerformSeerrPluginLogin(authType as string, username as string, password as string)
    config = GetSeerrConfig()
    if not (config.usePluginProxy ?? false) or (config.serverUrl ?? "") = ""
        ShowToast("Seerr plugin authentication is unavailable.", "error")
        return
    end if

    authBody = SeerrFormatJson({
        username: username,
        password: password,
        authType: authType
    })

    if isValid(m.seerrAuthTask)
        m.seerrAuthTask.unobserveField("response")
    end if
    m.seerrAuthTask = CreateObject("roSGNode", "SeerrAuthTask")
    m.seerrAuthTask.serverUrl = config.serverUrl
    m.seerrAuthTask.authBody = authBody
    m.seerrAuthTask.observeField("response", "onSeerrLoginResponse")
    m.seerrAuthTask.control = "RUN"
end sub

sub onSeerrLoginResponse()
    if not isValid(m.seerrAuthTask) then return
    response = m.seerrAuthTask.response
    m.seerrAuthTask.unobserveField("response")
    m.seerrAuthTask = invalid
    HandleSeerrLoginResult(response)
end sub

sub HandleSeerrLoginResult(response as object)
    if not isValid(response) or not (response.success ?? false)
        errMsg = "Login failed"
        if isValid(response) and isValid(response.error) and response.error <> ""
            errMsg = response.error
        end if
        ShowToast(errMsg, "error")
        return
    end if

    userId = chainLookupReturn(m.global, "session.user.id", "")
    displayName = ""
    if isValid(response.displayName) then displayName = response.displayName
    seerrUserId = 0
    if isValid(response.seerrUserId) then seerrUserId = int(response.seerrUserId)
    permissions = SeerrPermissionsFrom(response)
    avatar = ""
    if isValid(response.avatar) then avatar = response.avatar

    SetSeerrUserIdentity(userId, seerrUserId, displayName, permissions, avatar)

    RefreshSeerrAccountMenu()
end sub

sub PerformSeerrSignOut()
    config = GetSeerrConfig()
    if not (config.usePluginProxy ?? false) or (config.serverUrl ?? "") = ""
        ' Just clear locally
        userId = chainLookupReturn(m.global, "session.user.id", "")
        ClearSeerrUserIdentity(userId)
        RefreshSeerrAccountMenu()
        return
    end if

    if isValid(m.seerrLogoutTask)
        m.seerrLogoutTask.unobserveField("response")
    end if
    m.seerrLogoutTask = CreateObject("roSGNode", "SeerrAPITask")
    m.seerrLogoutTask.request = {
        method: "DELETE",
        endpoint: "/Moonfin/Seerr/Logout",
        usePluginRoot: true
    }
    m.seerrLogoutTask.observeField("response", "onSeerrLogoutResponse")
    m.seerrLogoutTask.control = "RUN"
end sub

sub onSeerrLogoutResponse()
    if not isValid(m.seerrLogoutTask) then return
    m.seerrLogoutTask.unobserveField("response")
    m.seerrLogoutTask = invalid

    userId = chainLookupReturn(m.global, "session.user.id", "")
    ClearSeerrUserIdentity(userId)
    RefreshSeerrAccountMenu()
end sub

sub RefreshSeerrAccountMenu()
    if not isValid(m.seerrAccountSection) then return
    PopulateSeerrAccountChildren(m.seerrAccountSection)
    m.userLocation.pop()
    LoadMenu(m.seerrAccountSection)
end sub

function GetSeerrAccountStatusLabel() as string
    userId = chainLookupReturn(m.global, "session.user.id", "")
    userConfig = GetSeerrUserConfig(userId)

    if isValid(userConfig) and isValidAndNotEmpty(userConfig.displayName)
        return "Signed in as " + userConfig.displayName
    end if

    if isValid(userConfig) and isValidAndNotEmpty(userConfig.authCookie)
        authMethod = chainLookupReturn(userConfig, "authMethod", "")
        if isStringEqual(authMethod, "jellyfin")
            return "Signed in (Jellyfin)"
        end if
        if isStringEqual(authMethod, "local")
            return "Signed in (Seerr account)"
        end if
        return "Signed in"
    end if

    return "Not signed in"
end function

' The screen on show draws its rows again, keeping the focus where it was
sub RefreshCurrentMenu()
    focused = m.settingsMenu.itemFocused
    showSection(m.userLocation.peek())
    if focused > 0 then m.settingsMenu.jumpToItem = focused
end sub

sub dismissPanel(animated = false as boolean)
    if m.closing then return
    flushSliderSave()
    commitOpenEditor()
    closePicker()
    scene = m.top.getScene()

    OnScreenHidden()

    ' The rows behind the panel read themselves again once, rather than on every rating toggled or
    ' every setting a load or reset brought in. Any other screen leaves it to the home screen to
    ' do on the way back.
    if m.blockedRatingsChanged = true or m.syncSettingsApplied = true
        m.blockedRatingsChanged = false
        m.syncSettingsApplied = false
        behind = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(behind) and behind.isSubtype("Home")
            m.global.homeNeedsRefresh = false
            behind.callFunc("refresh")
        end if
    end if

    m.global.sceneManager.settingsOpen = false
    if isValid(scene)
        if animated and m.animate
            ' Pressing settings again while this fades opens a fresh panel rather than this one
            m.closing = true
            m.top.id = ""
            m.closeAnim.control = "start"
        else
            scene.removeChild(m.top)
        end if

        audioMiniPlayer = scene.findNode("audioMiniPlayer")
        shouldRestoreMiniPlayer = (m.top.restoreMiniPlayerOnClose = true)
        if isValid(audioMiniPlayer) and shouldRestoreMiniPlayer and m.global.audioPlayer.state <> "stopped"
            audioMiniPlayer.callFunc("setVisible", true)
        end if

        activeNav = getActiveNav(scene)
        if isValid(activeNav) and activeNav.visible
            activeNav.setFocus(true)
            return
        end if
    end if

    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene)
        if isValid(activeScene.lastFocus)
            activeScene.lastFocus.setFocus(true)
        else
            activeScene.setFocus(true)
        end if
    end if
end sub

sub onCloseAnimState()
    if m.closeAnim.state <> "stopped" then return
    scene = m.top.getScene()
    if isValid(scene) then scene.removeChild(m.top)
end sub

function findSettingsSectionByTitle(sections as object, title as string) as dynamic
    if not isValid(sections) then return invalid

    for each item in sections
        if isStringEqual(chainLookupReturn(item, "title", ""), title)
            return item
        end if
    end for

    return invalid
end function

function findSettingsChildByTitle(section as object, title as string) as dynamic
    if not isValid(section) then return invalid
    if not isValid(section.children) then return invalid

    for each item in section.children
        if isStringEqual(chainLookupReturn(item, "title", ""), title)
            return item
        end if
    end for

    return invalid
end function

sub pushSettingIfValid(items as object, item as dynamic)
    if isValid(item)
        items.push(item)
    end if
end sub

function titleExistsInList(titles as object, title as string) as boolean
    if not isValid(titles) then return false

    for each itemTitle in titles
        if isStringEqual(itemTitle, title)
            return true
        end if
    end for

    return false
end function

' Removes the setting with this name from wherever it sits in the tree and returns it.
function takeSettingByName(items as object, settingName as string) as dynamic
    if not isValid(items) then return invalid

    for i = 0 to items.count() - 1
        item = items[i]
        if isStringEqual(item.settingName, settingName)
            items.Delete(i)
            return item
        end if

        found = takeSettingByName(item.children, settingName)
        if isValid(found) then return found
    end for

    return invalid
end function

function takeSettings(items as object, settingNames as object) as object
    taken = []
    for each settingName in settingNames
        pushSettingIfValid(taken, takeSettingByName(items, settingName))
    end for
    return taken
end function

function takeChildByTitle(section as dynamic, title as string) as dynamic
    if not isValid(section) or not isValid(section.children) then return invalid

    for i = 0 to section.children.count() - 1
        if isStringEqual(section.children[i].title, title)
            child = section.children[i]
            section.children.Delete(i)
            return child
        end if
    end for

    return invalid
end function

function settingsSection(title as string) as object
    return { title: title, type: SettingType.SECTION }
end function

' Collects every setting still left in a section once the layout has taken what it uses, so a
' setting nobody placed lands under Additional Settings instead of disappearing.
sub pushRemainingSettings(items as object, section as dynamic)
    if not isValid(section) or not isValid(section.children) then return

    for each child in section.children
        if isStringEqual(child.type, SettingType.SECTION) then continue for
        if isValid(child.children)
            pushRemainingSettings(items, child)
        else if isValidAndNotEmpty(child.settingName)
            items.push(child)
        end if
    end for
end sub

function normalizeBoolSettingValue(value as dynamic) as boolean
    if not isValid(value)
        return false
    end if

    if type(value) = "Boolean" or type(value) = "roBoolean"
        return value
    end if

    if type(value) = "String" or type(value) = "roString"
        return LCase(value) = "true"
    end if

    return false
end function

sub setUserBoolSetting(settingName as string, enabled as boolean, syncToServer = false as boolean)
    value = enabled ? "true" : "false"
    session.user.settings.Save(settingName, value)
    set_user_setting(settingName, value)

    if syncToServer
        syncSettingToServer(settingName, value)
    end if
end sub


sub setSettingVisibilityByName(items as object, settingName as string, isVisible as boolean)
    if not isValid(items)
        return
    end if

    for each item in items
        if isValid(item.settingName) and isStringEqual(item.settingName, settingName)
            item.visible = isVisible
        end if

        if isValid(item.children)
            setSettingVisibilityByName(item.children, settingName, isVisible)
        end if
    end for
end sub


function reorderSettingsForFlutter(configTree as object) as object
    if not isValid(configTree) then return configTree

    moonfinSettings = findSettingsSectionByTitle(configTree, "Moonfin Settings")
    pluginRootSection = findSettingsSectionByTitle(configTree, "Moonfin Plugin")
    playback = findSettingsSectionByTitle(configTree, "Playback")
    accountSecurity = findSettingsSectionByTitle(configTree, "Account & Security")
    userInterface = findSettingsSectionByTitle(configTree, "User Interface")

    ' Single settings move first, while every screen is still attached to the tree.
    signIn = takeSettings(configTree, ["global.rememberme", "global.saveCredentials"])
    pinCode = takeSettings(configTree, ["global.pinCodeProtection", "pin.setCode"])
    family = takeSettings(configTree, ["kids.turnOn", "parental.blockedRatings", "ui.home.recommendationsParentalCap"])
    syncSettings = takeSettings(configTree, ["plugin.enabled", "plugin.syncProfiles"])
    ' The sync switch lives on the sync panel, and taking it keeps it out of Additional Settings
    takeSettingByName(configTree, "plugin.settingsSync")
    clock = takeSettings(configTree, ["ui.showClock", "playback.use24hourclock"])
    behavior = takeSettings(configTree, ["load.allowwhatsnew"])
    themePicker = takeSettings(configTree, ["ui.theme.picker"])
    display = takeSettings(configTree, ["useFallbackFont", "ui.backdrop.homeBlurAmount", "ui.watchedIndicator", "ui.tvshows.disableUnwatchedEpisodeCount"])
    shuffleContent = takeSettingByName(configTree, "shuffle_content_type")

    homeRows = takeSettings(configTree, ["ui.home.rowLayout", "ui.home.pickCollections", "ui.home.pickGenres", "ui.home.pickPlaylists"])
    homeLooks = takeSettings(configTree, ["ui.home.rowsStyle", "ui.home.modernCardsOnMyMediaRow", "ui.home.classicRowsPadding", "ui.home.modernRowsPadding", "ui.home.preferThumbnails", "ui.home.hideMediaDescription"])
    continueWatching = takeSettings(configTree, ["ui.details.maxdaysnextup", "ui.home.mergeContinueWatchingNextUp"])
    recentlyAdded = takeSettings(configTree, ["ui.home.recentlyReleasedSeriesType", "ui.home.mergeRecentRowsByType"])
    rowTypes = [
        { title: "AUDIO", settings: takeSettings(configTree, ["ui.home.displayAudioRows"]) },
        { title: "COLLECTIONS", settings: takeSettings(configTree, ["ui.home.displayCollectionsRows", "ui.home.collectionsRowSortBy", "ui.home.collectionsRowShowEpisodes"]) },
        { title: "FAVORITES", settings: takeSettings(configTree, ["ui.home.displayFavoritesRows"]) },
        { title: "GENRES", settings: takeSettings(configTree, ["ui.home.displayGenresRows", "ui.home.genresRowSortBy", "ui.home.genresRowItemFilter"]) },
        { title: "PLAYLISTS", settings: takeSettings(configTree, ["ui.home.displayPlaylistsRows", "ui.home.playlistsRowShowEpisodes"]) },
        { title: "REWATCH", settings: takeSettings(configTree, ["ui.home.displayRewatchRow", "ui.home.rewatchSortBy", "ui.home.rewatchIncludeMovies", "ui.home.rewatchIncludeShows", "ui.home.rewatchIncludeCollections"]) },
        { title: "SINCE YOU WATCHED", settings: takeSettings(configTree, ["ui.home.sinceYouWatchedSource", "ui.home.sinceYouWatchedSourceType", "ui.home.sinceYouWatchedSourceItem", "ui.home.sinceYouWatchedNumRows", "ui.home.sinceYouWatchedIncludeWatched"]) },
        { title: "STUDIOS", settings: takeSettings(configTree, ["ui.home.displayStudiosRows"]) }
    ]

    detailsDisplay = takeSettings(configTree, ["ui.itemdetail.style", "ui.backdrop.detailBlurAmount", "ui.itemdetail.buttonLayout", "ui.itemdetail.buttonsMaxVisible"])
    detailsContent = takeSettings(configTree, ["ui.itemdetail.metadataLayout", "ui.itemdetail.sections", "ui.itemdetail.expandedTabs", "ui.library.showTechnicalDetails", "ui.itemdetail.hideMediaDescription", "ui.itemdetail.useSeriesThumbnails"])
    recommendations = takeSettings(configTree, ["ui.home.recommendationSource"])
    ratingSettings = takeSettings(configTree, ["plugin.mdblist.enabled", "plugin.mdblist.ratingSources", "plugin.tmdb.episodeRatings", "plugin.mdblist.showRatingNames", "plugin.mdblist.showRatingBadges", "ui.itemdetail.showRatings"])
    themeMusic = takeSettings(configTree, ["playback.thememusic.enabled", "playback.thememusic.loop"])

    playerSettings = takeSettings(configTree, ["playback.resumeRewind", "playback.unpauseRewind", "playback.skipBackLength", "playback.skipForwardLength", "playback.seekStep", "playback.showChapterMarkers", "ui.osd.buttonLayout"])
    trickPlay = takeSettings(configTree, ["playback.trickplay.enabled", "playback.trickplay.forcecustom", "playback.trickplay.pauseWhileScrubbing"])
    progressBarTime = takeSettings(configTree, ["playback.timeAboveLeft", "playback.timeAboveCenter", "playback.timeAboveRight", "playback.timeBelowLeft", "playback.timeBelowCenter", "playback.timeBelowRight"])
    musicTime = takeSettings(configTree, ["playback.musicTimeDisplay"])
    streaming = takeSettings(configTree, ["playback.media.forceTranscode"])
    videoStartDelay = takeSettings(configTree, ["playback.videoStartDelay"])
    cinemaMode = takeSettings(configTree, ["playback.cinemamode"])
    audioStream = takeSettings(configTree, ["playback.audioPreferredLanguage", "playback.audioFallbackLanguage", "playback.playDefaultAudioTrack", "playback.preferAudioDescription"])
    audioAdvanced = takeSettings(configTree, ["playback.media.maxAudioChannels", "playback.preferredAudioCodec"])
    subtitleMode = takeSettings(configTree, ["playback.subs.mode"])
    subtitleStream = takeSettings(configTree, ["playback.subs.language", "playback.subs.fallbackLanguage", "playback.preferSdhSubtitles"])
    customSubtitles = takeSettings(configTree, ["playback.subs.custom"])
    subtitleRendering = takeSettings(configTree, ["playback.subs.assdirectplay", "playback.subs.burnin", "playback.subs.onlytext"])

    ' Then the screens that keep their own page.
    navigationBar = takeChildByTitle(moonfinSettings, "Navigation")
    homeScreen = takeChildByTitle(moonfinSettings, "Home Screen")
    featuredMediaBar = takeChildByTitle(moonfinSettings, "Media Bar")
    seasonalEffectsPage = takeChildByTitle(moonfinSettings, "Seasonal Effects")
    loadingAnimation = takeChildByTitle(moonfinSettings, "Loading Animation")
    supportMoonfin = takeChildByTitle(moonfinSettings, "Support Moonfin")
    diagLogging = takeChildByTitle(moonfinSettings, "Diagnostics & Logging")
    runSetup = takeChildByTitle(moonfinSettings, "Run Setup Again")

    generalStyle = findSettingsChildByTitle(userInterface, "General Style")
    colors = takeChildByTitle(generalStyle, "Colors")
    libraries = takeChildByTitle(userInterface, "Libraries")
    detailsScreen = takeChildByTitle(userInterface, "Details Screen")

    seerr = takeChildByTitle(pluginRootSection, "Seerr")
    achievementBadges = takeChildByTitle(pluginRootSection, "Achievement Badges")
    friends = takeChildByTitle(pluginRootSection, "Friends")
    externalLists = findSettingsChildByTitle(pluginRootSection, "External Lists")
    imdbLists = takeChildByTitle(externalLists, "IMDb Lists")
    tmdbLists = takeChildByTitle(externalLists, "TMDB Lists")
    seasonalRowList = takeChildByTitle(externalLists, "Seasonal Row")
    calendars = takeChildByTitle(externalLists, "Upcoming Calendars")
    seerrRows = takeChildByTitle(externalLists, "Seerr Lists")

    videoPreferences = takeChildByTitle(playback, "Video Playback Preferences")
    bitrateLimit = takeChildByTitle(videoPreferences, "Bitrate Limit")
    maxResolution = takeChildByTitle(videoPreferences, "Max Resolution")
    compatibility = takeChildByTitle(videoPreferences, "Compatibility")
    codecSupport = takeChildByTitle(videoPreferences, "Video Codec Support")
    profileLevelSupport = takeChildByTitle(videoPreferences, "Video Profile Level Support")
    audio = takeChildByTitle(playback, "Audio Preferences")
    subtitles = takeChildByTitle(playback, "Subtitle Preferences")
    hdrSubtitles = takeChildByTitle(subtitles, "HDR Subtitles")
    automation = takeChildByTitle(playback, "Automation & Queue")

    reordered = []

    ' The PIN is turned on, then changed, on a screen of its own
    for each item in pinCode
        if item.settingName = "pin.setCode" then item.requires = "setting:global.pinCodeProtection"
    end for
    pinScreen = {
        title: "PIN Code",
        description: "Require a PIN to access your account",
        glyph: "pin",
        clean: true,
        children: [settingsSection("General"), pinCode[0], { title: "Manage", type: SettingType.SECTION, requires: "setting:global.pinCodeProtection" }]
    }
    pushSettingIfValid(pinScreen.children, pinCode[1])

    accountChildren = [settingsSection("Sign-in")]
    accountChildren.Append(signIn)
    accountChildren.push(pinScreen)
    accountChildren.push(settingsSection("Family"))
    accountChildren.Append(family)
    if syncSettings.count() > 0
        accountChildren.push(settingsSection(""))
        accountChildren.push({
            title: "Settings Sync",
            description: "Moonbase plugin sync and customization profiles",
            glyph: "sync",
            clean: true,
            titleAction: "refresh",
            children: syncSettings
        })
    end if
    reordered.push({
        title: "Account",
        requires: "notKidsMode",
        description: "Sign-in, PIN code, Kids Mode, parental controls, and settings sync",
        glyph: "lock",
        children: accountChildren
    })

    generalChildren = [settingsSection("Clock")]
    generalChildren.Append(clock)
    generalChildren.push(settingsSection("Behavior"))
    generalChildren.Append(behavior)
    reordered.push({
        title: "General",
        requires: "notKidsMode",
        description: "Clock and app behavior.",
        glyph: "tune",
        children: generalChildren
    })

    if isValid(navigationBar)
        navigationBar.title = "Navigation Bar"
        if isValid(shuffleContent) and isValid(navigationBar.children)
            shuffleContent.requires = "setting:navbar.show_shuffle"
            buttons = []
            for each item in navigationBar.children
                buttons.push(item)
                if isStringEqual(item.settingName, "navbar.show_shuffle") then buttons.push(shuffleContent)
            end for
            navigationBar.children = buttons
        end if
    end if

    if isValid(homeScreen)
        homeScreen.description = "Rows, media bar, looks, and external sources"
        homeScreen.clean = true
        rowOptions = takeChildByTitle(homeScreen, "Home Row Toggles")
        homeChildren = [settingsSection("Contents")]
        homeChildren.Append(homeRows)
        if isValid(rowOptions)
            rowOptions.title = "Row Options"
            rowOptions.description = "Sorting and content for each row"
            rowOptions.clean = true
            rowOptionsChildren = [settingsSection("CONTINUE WATCHING AND NEXT UP")]
            rowOptionsChildren.Append(continueWatching)
            rowOptionsChildren.push(settingsSection("RECENTLY ADDED"))
            rowOptionsChildren.Append(recentlyAdded)
            for each rowType in rowTypes
                if rowType.settings.count() = 0 then continue for
                rowOptionsChildren.push(settingsSection(rowType.title))
                ' A row's own options only show once the row is on
                gate = rowType.settings[0].settingName
                for each item in rowType.settings
                    if item.settingName <> gate and Left(gate, 15) = "ui.home.display" and not isValid(item.requires) then item.requires = "setting:" + gate
                    rowOptionsChildren.push(item)
                end for
            end for
            pushRemainingSettings(rowOptionsChildren, rowOptions)
            rowOptions.children = rowOptionsChildren
            homeChildren.push(rowOptions)
        end if
        if isValid(featuredMediaBar) then featuredMediaBar.clean = true
        pushSettingIfValid(homeChildren, featuredMediaBar)
        homeChildren.push(settingsSection("Looks"))
        homeChildren.Append(homeLooks)
        homeChildren.push(settingsSection("External Sources"))
        pushSettingIfValid(homeChildren, imdbLists)
        pushSettingIfValid(homeChildren, tmdbLists)
        pushSettingIfValid(homeChildren, seasonalRowList)
        pushSettingIfValid(homeChildren, calendars)
        if isValid(seerrRows)
            seerrRows.title = "Seerr Rows"
            homeChildren.push(seerrRows)
        end if
        ' The hidden section slots stay with the screen that owns them.
        pushRemainingSettings(homeChildren, homeScreen)
        homeScreen.children = homeChildren
    end if

    if isValid(libraries) and isValid(libraries.children)
        libraries.description = "Library order, multi-server libraries, and library pages."
        for each item in libraries.children
            if isStringEqual(item.title, "Home Screen Rows") then item.title = "General"
        end for
    end if

    if isValid(detailsScreen)
        detailsScreen.title = "Details Page"
        detailsScreen.description = "Layout, buttons, sections, ratings, and theme music"
        detailsChildren = [settingsSection("Display")]
        detailsChildren.Append(detailsDisplay)
        detailsChildren.push(settingsSection("Media Details and Spoilers"))
        detailsChildren.Append(detailsContent)
        detailsChildren.push(settingsSection("Recommendations"))
        detailsChildren.Append(recommendations)
        detailsChildren.push(settingsSection("Ratings"))
        detailsChildren.Append(ratingSettings)
        detailsChildren.push(settingsSection("Theme Music"))
        detailsChildren.Append(themeMusic)
        pushRemainingSettings(detailsChildren, detailsScreen)
        detailsScreen.children = detailsChildren
    end if

    appearanceChildren = [settingsSection("Navigation")]
    pushSettingIfValid(appearanceChildren, navigationBar)
    appearanceChildren.push(settingsSection("Layout"))
    pushSettingIfValid(appearanceChildren, homeScreen)
    pushSettingIfValid(appearanceChildren, libraries)
    pushSettingIfValid(appearanceChildren, detailsScreen)
    appearanceChildren.push(settingsSection("Theme"))
    appearanceChildren.Append(themePicker)
    pushSettingIfValid(appearanceChildren, colors)
    appearanceChildren.push(settingsSection("Display"))
    appearanceChildren.Append(display)
    appearanceChildren.push(settingsSection("Extras"))
    pushSettingIfValid(appearanceChildren, seasonalEffectsPage)
    pushSettingIfValid(appearanceChildren, loadingAnimation)
    reordered.push({
        title: "Appearance",
        requires: "notKidsMode",
        description: "Navigation, home screen, libraries, details page, and themes",
        glyph: "palette",
        children: appearanceChildren
    })

    if isValid(playback)
        progressBarTimeChildren = [settingsSection("Video Player")]
        progressBarTimeChildren.Append(progressBarTime)
        progressBarTimeChildren.push(settingsSection("Music Player"))
        progressBarTimeChildren.Append(musicTime)
        playerChildren = [
            settingsSection("Media Player Behavior"),
            {
                title: "Progress Bar Time",
                description: "Choose which time labels appear around the playback progress bar.",
                glyph: "timer_outlined",
                children: progressBarTimeChildren
            }
        ]
        playerChildren.Append(playerSettings)
        playerChildren.push(settingsSection("Trick Play"))
        playerChildren.Append(trickPlay)

        qualityChildren = [settingsSection("Streaming")]
        pushSettingIfValid(qualityChildren, bitrateLimit)
        pushSettingIfValid(qualityChildren, maxResolution)
        qualityChildren.Append(streaming)
        qualityChildren.push(settingsSection("Decoding & Rendering"))
        pushSettingIfValid(qualityChildren, compatibility)
        pushSettingIfValid(qualityChildren, codecSupport)
        pushSettingIfValid(qualityChildren, profileLevelSupport)
        qualityChildren.Append(videoStartDelay)

        if isValid(audio)
            audio.title = "Audio"
            audioChildren = [settingsSection("Audio Stream")]
            audioChildren.Append(audioStream)
            audioChildren.push(settingsSection("Advanced"))
            audioChildren.Append(audioAdvanced)
            pushRemainingSettings(audioChildren, audio)
            audio.children = audioChildren
        end if

        if isValid(subtitles)
            subtitles.title = "Subtitles"
            subtitles.clean = true
            ' The style rows and the HDR ones under them get a screen of their own
            customization = []
            for each item in subtitles.children
                if Left(item.settingName ?? "", 21) = "playback.subs.style." then customization.push(item)
            end for
            for each item in customization
                takeSettingByName(subtitles.children, item.settingName)
                item.requires = invalid
            end for
            if isValid(hdrSubtitles)
                customization.push(settingsSection("HDR"))
                customization.Append(hdrSubtitles.children)
            end if
            subtitlesOn = "setting:playback.subs.mode!=None"
            subtitleChildren = [settingsSection("General")]
            subtitleChildren.Append(subtitleMode)
            subtitleChildren.push({ title: "Subtitle Stream", type: SettingType.SECTION, requires: subtitlesOn })
            subtitleChildren.Append(subtitleStream)
            subtitleChildren.push({ title: "Subtitle Customization", type: SettingType.SECTION, requires: subtitlesOn })
            subtitleChildren.Append(customSubtitles)
            subtitleChildren.push({
                title: "Subtitle Customization",
                description: "Customize subtitle appearance",
                glyph: "style",
                clean: true,
                requires: "setting:playback.subs.custom",
                children: customization
            })
            subtitleChildren.push({ title: "Subtitle Rendering", type: SettingType.SECTION, requires: subtitlesOn })
            subtitleChildren.Append(subtitleRendering)
            for each item in subtitleStream
                item.requires = subtitlesOn
            end for
            subtitles.children = subtitleChildren
        end if

        if isValid(automation)
            automation.title = "Skipping & Autoplay"
            segments = takeChildByTitle(automation, "Media Segment Actions")
            automationChildren = [settingsSection("Playback Enhancements")]
            automationChildren.Append(cinemaMode)
            if isValid(segments) then automationChildren.Append(takeSettings(segments.children, ["playback.mediasegments.intro", "playback.mediasegments.recap", "playback.mediasegments.preview", "playback.mediasegments.commercial", "playback.mediasegments.outro", "playback.mediasegments.countdown"]))
            automationChildren.push(settingsSection("Automatic Queuing"))
            automationChildren.Append(takeSettings(automation.children, ["playback.autoplaynextepisode", "episodeQueueLimit", "playback.nextupbehavior", "playback.nextuptimeout", "playback.nextupbuttonseconds", "playback.replaceskipoutrowithnextup", "playback.showNextUpAfterFinish", "stillwatchingPopupInactivityTime"]))
            pushRemainingSettings(automationChildren, automation)
            automation.children = automationChildren
        end if

        playbackChildren = [
            settingsSection("Video"),
            {
                title: "Player",
                description: "Controls, seeking, player buttons, and trick play",
                glyph: "play_circle",
                children: playerChildren
            },
            {
                title: "Quality & Decoding",
                description: "Bitrate, resolution, transcoding, and codec support.",
                glyph: "high_quality_outlined",
                children: qualityChildren
            },
            settingsSection("Audio & Subtitles")
        ]
        pushSettingIfValid(playbackChildren, audio)
        pushSettingIfValid(playbackChildren, subtitles)
        playbackChildren.push(settingsSection("Skipping & Queue"))
        pushSettingIfValid(playbackChildren, automation)
        pushRemainingSettings(playbackChildren, playback)

        playback.children = playbackChildren
        playback.clean = true
        playback.description = "Player, quality, audio, subtitles, and skipping."
        reordered.push(playback)
    end if

    integrationsChildren = []
    if isValid(seerr) then seerr.clean = true
    pushSettingIfValid(integrationsChildren, seerr)
    pushSettingIfValid(integrationsChildren, achievementBadges)
    pushSettingIfValid(integrationsChildren, friends)
    if integrationsChildren.count() > 0
        reordered.push({
            title: "Integrations",
            requires: "notKidsMode",
            description: "Seerr, Achievement Badges, and friends.",
            glyph: "hub",
            clean: true,
            children: integrationsChildren
        })
    end if

    if isValid(diagLogging)
        diagLogging.clean = true
        logging = takeSettings(diagLogging.children, ["diagnostics.enabled", "diagnostics.crashReports"])
        reports = takeSettings(diagLogging.children, ["diagnostics.viewLogs"])
        diagChildren = [settingsSection("Logging")]
        diagChildren.Append(logging)
        diagChildren.push(settingsSection("Reports"))
        diagChildren.Append(reports)
        pushRemainingSettings(diagChildren, diagLogging)
        diagLogging.children = diagChildren
    end if

    aboutChildren = [
        { title: m.global.app.version, type: "about" },
        settingsSection("APP INFO"),
        {
            title: "Version",
            description: m.global.app.version,
            glyph: "info_outline",
            type: ""
        },
        {
            title: "What's New",
            description: "See what changed in this release.",
            settingName: "moonfin.showWhatsNew",
            glyph: "new_releases",
            type: ""
        }
    ]
    pushSettingIfValid(aboutChildren, diagLogging)
    pushSettingIfValid(aboutChildren, runSetup)
    pushSettingIfValid(aboutChildren, supportMoonfin)
    reordered.push({
        title: "About",
        requires: "notKidsMode",
        description: "Support Moonfin and project information.",
        glyph: "info_outline",
        children: aboutChildren
    })

    additionalChildren = []
    for each section in [moonfinSettings, pluginRootSection, userInterface, accountSecurity, videoPreferences]
        pushRemainingSettings(additionalChildren, section)
    end for

    if additionalChildren.count() > 0
        reordered.push({
            title: "Additional Settings",
            description: "Settings that are not yet grouped in the new layout.",
            requires: "notKidsMode",
            glyph: "tune",
            children: additionalChildren
        })
    end if

    knownRootTitles = ["Moonfin Settings", "Moonfin Plugin", "Playback", "Account & Security", "User Interface"]
    for each rootSection in configTree
        rootTitle = chainLookupReturn(rootSection, "title", "")
        if not isValidAndNotEmpty(rootTitle) then continue for
        if titleExistsInList(knownRootTitles, rootTitle) then continue for
        reordered.push(rootSection)
    end for

    return reordered
end function

sub LoadMenu(configSection, appendPath = true as boolean)
    flushSliderSave()
    goingBack = configSection.children = invalid
    if goingBack
        commitOpenEditor()
        m.userLocation.pop()
        configSection = m.userLocation.peek()
    else
        settingsArray = []

        for each item in configSection.children
            adjustDetailsBackdropBlurItem(item)
            settingsArray.push(item)
        end for

        configSection.children = settingsArray

        if appendPath
            if m.userLocation.Count() > 0 then m.userLocation.peek().selectedIndex = m.settingsMenu.itemFocused
            m.userLocation.push(configSection)
        end if
    end if

    showSection(configSection)

    ' A screen opened from another slides in from the right, and the one gone back to comes in
    ' from the left
    if not m.animate then return
    if goingBack
        m.popAnim.control = "start"
    else if appendPath and m.userLocation.Count() > 1
        m.pushAnim.control = "start"
    end if
end sub

' The rows of one screen, and the bar over them
sub showSection(configSection as object)
    specs = []
    if isValid(configSection.editor)
        specs = editorSpecs()
    else
        for each item in configSection.children
            if isValid(item.visible) and not item.visible and not m.showSecretMenu then continue for
            ' An entry that only exists where a server plugin answered
            if isValid(item.requires) and not settingRequirementMet(item.requires) then continue for
            spec = settingsRowSpec(item)
            spec.item = item
            specs.push(spec)
        end for
    end if

    m.sectionStyle = m.style
    if configSection.clean = true then m.sectionStyle = m.cleanStyle

    built = BuildRows(specs, m.sectionStyle)
    m.visibleItemsMap = []
    for each rowSpec in built.specs
        settingItem = invalid
        if isValid(rowSpec) then settingItem = rowSpec.item
        m.visibleItemsMap.push(settingItem)
    end for
    m.rowBands = built.bands

    m.settingsMenu.rowHeights = built.heights
    m.settingsMenu.content = built.content
    if isValid(configSection.selectedIndex) and configSection.selectedIndex > 0 then m.settingsMenu.jumpToItem = configSection.selectedIndex

    isRoot = m.userLocation.Count() <= 1
    title = tr("Settings")
    if not isRoot and isValid(configSection.title)
        ' A menu can name itself apart from the row that opens it
        title = tr(configSection.pathTitle ?? configSection.title)
    end if
    m.titleBar.style = m.sectionStyle
    m.titleBar.isRoot = isRoot
    m.titleBar.action = configSection.titleAction ?? ""
    m.titleBar.title = title
    m.titleBar.scrolled = false
    focusTitleAction(false)
end sub

sub settingFocused()
    hideEditingControls()
end sub

' The first screen's title takes a tint while its list is scrolled under it
sub onListScrolled()
    m.titleBar.scrolled = m.settingsMenu.scrollOffset > 0
end sub

' Up from the first row reaches the title bar's action, when the screen has one
sub focusTitleAction(focused as boolean)
    m.titleActionFocused = focused
    m.titleBar.actionFocused = focused
    if focused
        m.titleBar.setFocus(true)
    else if m.titleBar.isInFocusChain()
        m.settingsMenu.setFocus(true)
    end if
end sub

sub settingSelected()
    if isValid(m.editor)
        editorToggle()
        return
    end if

    selectedItem = getFocusedSetting()

    if not isValid(selectedItem) then return

    hideEditingControls()

    if isValid(selectedItem.settingName) and selectedItem.settingName = "moonfin.showDonation"
        showDonationDialog()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "moonfin.showWhatsNew"
        dismissPanel()
        m.global.sceneManager.callFunc("whatsNewDialog")
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "moonfin.runSetupWizard"
        dismissPanel()
        wizard = createObject("roSGNode", "SetupWizard")
        ' A deliberate re-run asks every question again, answered or not
        wizard.rerun = true
        m.global.sceneManager.callFunc("pushScene", wizard)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "kids.turnOn"
        openKidsPin("set")
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "kids.exit"
        openKidsPin("exit")
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "pin.setCode"
        openKidsPin("signIn")
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "parental.blockedRatings"
        openBlockedRatings(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "parental.rating"
        toggleBlockedRating(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.itemdetail.sections"
        selectedItem.children = detailSectionRows()
        LoadMenu(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.itemdetail.section"
        toggleDetailSection(selectedItem)
        return
    end if

    if isStringEqual(selectedItem.type, SettingType.NOTE) then return

    if isValid(selectedItem.settingName) and selectedItem.settingName = "achievements.open"
        showAchievementsPanel()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "friends.open"
        showFriendsPanel()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "seerr.accountSettings"
        PopulateSeerrAccountChildren(selectedItem)
        LoadMenu(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "seerr.signIn.jellyfin"
        StartSeerrJellyfinSignIn()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "seerr.signIn.local"
        StartSeerrLocalSignIn()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "seerr.signOut"
        PerformSeerrSignOut()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "seerr.accountStatus"
        return ' read-only status row
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.theme.picker"
        loadThemePickerOptions(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.itemdetail.buttonLayout"
        openEditor("detailButtons", selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.itemdetail.metadataLayout"
        openEditor("metadata", selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = RATING_SOURCES_SETTING
        openEditor("ratingSources", selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "diagnostics.viewLogs"
        showDiagnosticsPanel()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "libraries.order"
        showLibraryOrderPanel()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "plugin.syncProfiles"
        showSettingsSyncPanel()
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.osd.buttonLayout"
        openEditor("osdButtons", selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and selectedItem.settingName = "ui.home.rowLayout"
        openEditor("rows", selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and isValid(homeRowLayout.SourceForSetting(selectedItem.settingName))
        showPickedRowsDialog(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and isMediaBarMultiSelectSetting(selectedItem.settingName)
        loadMediaBarPickerOptions(selectedItem)
        return
    end if

    if isValid(selectedItem.settingName) and isStringEqual(selectedItem.settingName, seasonalRow.HIDDEN_HOLIDAYS_SETTING)
        showSeasonalHolidaysDialog(selectedItem)
        return
    end if

    if selectedItem.type <> invalid
        if isStringEqual(selectedItem.type, SettingType.BOOL)
            boolSettingChanged(selectedItem)
            return
        end if

        if isStringEqual(selectedItem.type, SettingType.COLORGRID)
            m.colorgrid.setting = selectedItem
            m.colorgrid.visible = true
            m.colorgrid.setFocus(true)
            return
        end if

        if isStringEqual(selectedItem.type, SettingType.integer)
            integerValue = dynamicToDisplayString(get_user_setting(selectedItem.settingName))
            if not isValidAndNotEmpty(integerValue)
                integerValue = dynamicToDisplayString(m.global.session.user.settings[selectedItem.settingName])
            end if
            if isValidAndNotEmpty(integerValue)
                m.integerSetting.text = integerValue
            end if

            m.integerSetting.visible = true
            m.integerSetting.setFocus(true)
            return
        end if

        if isStringEqual(selectedItem.type, SettingType.RADIO)
            if isStringEqual(selectedItem.settingName, "playback.media.forceTranscode")
                originalSelectedValue = m.global.session.user.settings[selectedItem.settingName]

                if isStringEqual(type(originalSelectedValue), "roBoolean") or isStringEqual(type(originalSelectedValue), "Boolean")
                    convertedValue = originalSelectedValue ? PlaybackMethod.FORCETRANSCODEALLOWREMUX : selectedItem.default
                    set_user_setting(selectedItem.settingName, convertedValue)
                end if
            end if

            selectedValue = m.global.session.user.settings[selectedItem.settingName]
            radioOptions = selectedItem.options

            if Left(chainLookupReturn(selectedItem, "settingName", ""), 17) = "homeScreenSection"
                ' Rows that ship in the picker are dropped when their toggle is off, so
                ' the picker and the home screen agree on what can appear
                filteredOptions = []
                optInRowEnabled = {
                    favorites: normalizeBoolSettingValue(getUserSettingValue("ui.home.displayFavoritesRows", false)),
                    rewatch: normalizeBoolSettingValue(getUserSettingValue("ui.home.displayRewatchRow", false))
                }
                for each option in selectedItem.options
                    enabled = optInRowEnabled[option.id]
                    if not isValid(enabled) or enabled
                        filteredOptions.push(option)
                    end if
                end for

                ' Each entry pairs the setting that enables a row with the option shown in the picker
                optInRowOptions = [
                    { settingName: "ui.home.displayCollectionsRows", title: "Collections", id: "collections" },
                    { settingName: "ui.home.displayGenresRows", title: "Genres", id: "genres" },
                    { settingName: "ui.home.displayPlaylistsRows", title: "Playlists", id: "playlists" },
                    { settingName: "ui.home.displayAudioRows", title: "Audio", id: "audio" },
                    { settingName: "imdb.top250movies", title: "IMDb Top 250 Movies", id: "imdb_top_250_movies" },
                    { settingName: "imdb.top250tvshows", title: "IMDb Top 250 TV Shows", id: "imdb_top_250_tv_shows" },
                    { settingName: "imdb.mostpopularmovies", title: "IMDb Most Popular Movies", id: "imdb_most_popular_movies" },
                    { settingName: "imdb.mostpopulartvshows", title: "IMDb Most Popular TV Shows", id: "imdb_most_popular_tv_shows" },
                    { settingName: "imdb.lowestratedmovies", title: "IMDb Lowest Rated Movies", id: "imdb_lowest_rated_movies" },
                    { settingName: "imdb.topenglishmovies", title: "IMDb Top Rated English Movies", id: "imdb_top_english_movies" },
                    { settingName: "tmdb.popularmovies", title: "TMDb Popular Movies", id: "tmdb_popular_movies" },
                    { settingName: "tmdb.topratedmovies", title: "TMDb Top Rated Movies", id: "tmdb_top_rated_movies" },
                    { settingName: "tmdb.nowplayingmovies", title: "TMDb Now Playing Movies", id: "tmdb_now_playing_movies" },
                    { settingName: "tmdb.upcomingmovies", title: "TMDb Upcoming Movies", id: "tmdb_upcoming_movies" },
                    { settingName: "tmdb.populartv", title: "TMDb Popular TV Shows", id: "tmdb_popular_tv" },
                    { settingName: "tmdb.topratedtv", title: "TMDb Top Rated TV Shows", id: "tmdb_top_rated_tv" },
                    { settingName: "tmdb.airingtodaytv", title: "TMDb Airing Today TV Shows", id: "tmdb_airing_today_tv" },
                    { settingName: "tmdb.ontheairtv", title: "TMDb On The Air TV Shows", id: "tmdb_on_the_air_tv" },
                    { settingName: "tmdb.trendingmoviedaily", title: "TMDb Trending Movies Daily", id: "tmdb_trending_movie_daily" },
                    { settingName: "tmdb.trendingmovieweekly", title: "TMDb Trending Movies Weekly", id: "tmdb_trending_movie_weekly" },
                    { settingName: "tmdb.trendingtvdaily", title: "TMDb Trending TV Daily", id: "tmdb_trending_tv_daily" },
                    { settingName: "tmdb.trendingtvweekly", title: "TMDb Trending TV Weekly", id: "tmdb_trending_tv_weekly" },
                    { settingName: "tmdb.trendingallweekly", title: "TMDb Trending All Weekly", id: "tmdb_trending_all_weekly" },
                    { settingName: "seerr.row.popular_movies", title: "Seerr Popular Movies", id: "seerr_popular_movies" },
                    { settingName: "seerr.row.popular_tv", title: "Seerr Popular TV Shows", id: "seerr_popular_series" },
                    { settingName: "seerr.row.upcoming_movies", title: "Seerr Upcoming Movies", id: "seerr_upcoming_movies" },
                    { settingName: "seerr.row.upcoming_tv", title: "Seerr Upcoming TV Shows", id: "seerr_upcoming_series" }
                ]

                for each optInRow in optInRowOptions
                    if normalizeBoolSettingValue(getUserSettingValue(optInRow.settingName, false))
                        filteredOptions.push({ title: optInRow.title, id: optInRow.id })
                    end if
                end for

                if normalizeBoolSettingValue(getUserSettingValue("seerr.row.trending", false))
                    filteredOptions.push({ title: "Seerr Trending", id: "seerr_trending" })
                end if

                radioOptions = filteredOptions
            end if

            ' A slider row is moved with left and right, which OK leaves alone
            if selectedItem.slider = true then return

            options = []
            selectedIndex = 0
            for each item in radioOptions
                if selectedValue = item.id then selectedIndex = options.Count()
                options.push({ id: item.id, title: tr(item.title) })
            end for

            m.pickerSetting = selectedItem
            m.pickerOptions = options
            openPicker(tr(selectedItem.title), options, selectedIndex, "onRadioChosen")
            return
        end if

        if isStringEqual(selectedItem.type, SettingType.STRING)
            showStringInputDialog(selectedItem)
            return
        end if
    else if selectedItem.children <> invalid and selectedItem.children.Count() > 0
        LoadMenu(selectedItem)
        m.settingsMenu.setFocus(true)
    else
        return
    end if
end sub

sub refreshMenu()
    showSection(m.userLocation.peek())
end sub

sub boolSettingChanged(selectedSetting as object)
    rawValue = get_user_setting(selectedSetting.settingName)
    if not isValid(rawValue) and isValid(m.global.session.user.settings[selectedSetting.settingName])
        rawValue = m.global.session.user.settings[selectedSetting.settingName]
    end if
    if not isValid(rawValue)
        rawValue = selectedSetting.default
    end if

    currentValue = LCase(dynamicToDisplayString(rawValue))
    isCurrentlyEnabled = (currentValue = "true")
    newValue = isCurrentlyEnabled ? "false" : "true"

    session.user.settings.Save(selectedSetting.settingName, newValue)
    if Left(selectedSetting.settingName, 7) = "global."
        ' global user setting
        ' save to main registry block
        set_setting(selectedSetting.settingName, newValue)
        ' setting specific triggers
        if selectedSetting.settingName = "global.rememberme"
            if newValue = "true"
                set_setting("active_user", m.global.session.user.id)
            else
                unset_setting("active_user")
            end if
        end if
    else
        set_user_setting(selectedSetting.settingName, newValue)
        if selectedSetting.settingName = "seerr.blockNsfw"
            SetSeerrBlockNsfw(newValue = "true")
        end if
        if selectedSetting.settingName = "plugin.enabled"
            testPluginConnection()
        end if
        ' The store keeps its own copy of both switches, so it is told as they change
        if Left(selectedSetting.settingName, 12) = "diagnostics." then diagnostics.Apply()
        ' The top bar and the sidebar redraw their clocks from this
        if selectedSetting.settingName = "ui.showClock" and isValid(m.global)
            m.global.overlaySettingsChanged = m.global.overlaySettingsChanged + 1
        end if
        if selectedSetting.settingName = "seasonal.row.enabled" then placeSeasonalRow(newValue = "true")
    end if

    if isStringEqual(selectedSetting.settingName, "playback.playDefaultAudioTrack")
        m.settingSyncTask = userConfigSync.Push({ "playback.playDefaultAudioTrack": newValue })
    end if
    syncSettingToServer(selectedSetting.settingName, newValue)

    refreshCurrentItemValue(selectedSetting)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
    refreshDependentRows(selectedSetting.settingName)

    if selectedSetting.settingName = SIGN_IN_PIN_ENABLED_KEY and newValue = "true" then lockBehindPin()
end sub

' Turning the PIN on locks the app straight away, the same as signing in with it on would
sub lockBehindPin()
    dismissPanel()
    gate = CreateObject("roSGNode", "PinGate")
    gate.dismissOnUnlock = true
    m.global.sceneManager.callFunc("pushScene", gate)
end sub

sub onRadioChosen()
    index = m.picker.chosen
    closePicker()
    if index < 0 or index >= m.pickerOptions.Count() then return
    applyRadioChoice(m.pickerSetting, m.pickerOptions[index].id)
end sub

sub applyRadioChoice(selectedSetting as object, selectedValue as dynamic)
    set_user_setting(selectedSetting.settingName, selectedValue)

    if inArray(["ui.overlayOpacity", "ui.overlayColor", "navbar.opacity", "navbar.color", "seasonal.surprise", "seasonal.density"], selectedSetting.settingName)
        if isValid(m.global)
            m.global.overlaySettingsChanged = m.global.overlaySettingsChanged + 1
        end if
    end if

    if isStringEqual(selectedSetting.settingName, "ui.home.mediaBarMode")
        if isValid(m.global) and m.global.hasField("mediaBarModeChanged")
            m.global.mediaBarModeChanged = m.global.mediaBarModeChanged + 1
        end if
    end if

    if isStringEqual(selectedSetting.settingName, "navbar.position")
        applyNavbarPosition(selectedValue)
    end if

    if isStringEqual(selectedSetting.settingName, "playback.media.forceTranscode")
        if isStringEqual(selectedValue, PlaybackMethod.PLAYNORMALLY)
            m.global.queueManager.callFunc("setForceTranscode", PlaybackMethod.PLAYNORMALLY)
        end if
    end if

    if userConfigSync.FieldFor(selectedSetting.settingName) <> ""
        changes = {}
        changes[selectedSetting.settingName] = selectedValue
        m.settingSyncTask = userConfigSync.Push(changes)
    end if

    syncSettingToServer(selectedSetting.settingName, selectedValue)

    if Left(chainLookupReturn(selectedSetting, "settingName", ""), 17) = "homeScreenSection"
        syncHomeRowsToServer()
    end if

    refreshCurrentItemValue(selectedSetting)
    hideEditingControls()
    m.settingsMenu.setFocus(true)
    refreshDependentRows(selectedSetting.settingName)
end sub

' Swaps the top bar and the sidebar over straight away, rather than on the next launch
sub applyNavbarPosition(position as string)
    scene = m.top.getScene()
    if not isValid(scene) then return

    overhang = scene.findNode("overhang")
    sidebar = scene.findNode("sidebar")
    if isStringEqual(position, "left")
        if isValid(overhang)
            overhang.visible = false
            overhang.isVisible = false
        end if
        if isValid(sidebar)
            sidebar.visible = true
            sidebar.callFunc("loadLibraries")
        end if
    else
        if isValid(sidebar)
            sidebar.visible = false
        end if
        if isValid(overhang)
            overhang.visible = true
            overhang.isVisible = true
            overhang.callFunc("loadLibraries")
        end if
    end if
    m.global.sceneManager.callFunc("refreshNavReference")
    if m.global.hasField("navPositionChanged")
        m.global.navPositionChanged = m.global.navPositionChanged + 1
    end if
end sub

' JFScreen hook called when screen is shown
sub OnScreenShown(_isReturning = false as boolean)
    if isValid(m.settingsMenu) then m.settingsMenu.setFocus(true)
    if m.opened then return
    m.opened = true
    if m.animate then m.openAnim.control = "start"
end sub

' JFScreen hook that gets ran as needed.
' Assumes settings were changed and they affect the device profile.
' Posts a new device profile to the server using the task thread
sub OnScreenHidden()
    m.postTask.arrayData = getDeviceCapabilities()
    m.postTask.apiUrl = "/Sessions/Capabilities/Full"
    m.postTask.control = "RUN"
    m.postTask.observeField("responseCode", "postFinished")
end sub

' Triggered by m.postTask after completing a post.
' Empty the task data when finished.
sub postFinished()
    m.postTask.unobserveField("responseCode")
    m.postTask.callFunc("empty")
end sub

' Returns true if any of the data entry forms are in focus
function isFormInFocus() as boolean
    return m.integerSetting.hasFocus() or m.colorgrid.hasFocus()
end function

sub checkMagicKeyPressSequence(key as string)
    m.keypressTimer.control = "stop"
    m.keypressTimer.control = "start"

    m.keypresses.push(key)

    if m.keypresses.count() < m.magicKeyPressSequence.count() then return

    for i = 0 to m.keypresses.count()
        if m.keypresses[i] <> m.magicKeyPressSequence[i] then return
    end for

    m.showSecretMenu = true
    LoadMenu({ children: m.configTree })
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ' A panel on its way out takes no more keys
    if m.closing then return true

    checkMagicKeyPressSequence(key)
    listFocused = m.settingsMenu.hasFocus()

    if m.titleActionFocused
        if key = "OK"
            runTitleAction()
            return true
        end if
        if key = "down"
            focusTitleAction(false)
            return true
        end if
        if key = "up" or key = "left" or key = "right" then return true
    end if

    if key = "up" and listFocused and m.titleBar.action <> ""
        focusTitleAction(true)
        return true
    end if

    if (key = "left" or key = "right") and listFocused
        direction = 1
        if key = "left" then direction = -1
        if editorMove(direction) then return true
        if stepSlider(direction) then return true
    end if

    if key = "back" or key = "left"
        if (listFocused or m.titleActionFocused) and m.userLocation.Count() > 1
            LoadMenu({})
            m.settingsMenu.setFocus(true)
            return true
        end if

        if isFormInFocus()
            hideEditingControls()
            m.settingsMenu.setFocus(true)
            return true
        end if

        if listFocused or m.titleActionFocused
            dismissPanel(true)
            return true
        end if
    end if

    if key = "options"
        dismissPanel(true)
        return true
    end if

    ' Right opens a row the way OK does
    if key = "right" and listFocused
        settingSelected()
        return true
    end if

    return false
end function

' What the title bar's action does on the screen it sits over
sub runTitleAction()
    action = m.titleBar.action
    if action = "refresh" then testPluginConnection()
    if action = "restore" and isValid(m.editor) then editorReset()
end sub

' Handle authentication modal closed
sub onAuthModalClosed(_obj as object)
    ' Close the dialog
    m.top.getScene().dialog.close = true
    m.settingsMenu.setFocus(true)
end sub

' Show donation dialog
sub showDonationDialog()
    ' Create the donation dialog
    dialog = createObject("roSGNode", "DonationDialog")
    dialog.observeField("wasClosed", "onDonationDialogClosed")

    ' Add dialog to the scene
    m.top.getScene().appendChild(dialog)
    m.donationDialog = dialog
end sub

' Handle donation dialog closed
sub onDonationDialogClosed(_obj as object)
    ' Remove the dialog from the scene
    if isValid(m.donationDialog)
        m.top.getScene().removeChild(m.donationDialog)
        m.donationDialog = invalid
    end if

    ' Return focus to settings menu
    m.settingsMenu.setFocus(true)
end sub

' Classic reads ui.backdrop.detailBlurAmount as a blur radius and modern reads it as backdrop
' scrim strength, so the menu entry is retitled to suit whichever screen the user picked.
sub adjustDetailsBackdropBlurItem(item as dynamic)
    if not isValid(item) or not isStringEqual(chainLookupReturn(item, "settingName", ""), "ui.backdrop.detailBlurAmount")
        return
    end if

    ' Remember what settings.json shipped so the classic wording can be restored
    if not isValid(m.detailBlurItemDefaults)
        m.detailBlurItemDefaults = {
            title: item.title,
            description: item.description,
            options: item.options
        }
    end if

    if not isStringEqual(dynamicToDisplayString(getUserSettingValue("ui.itemdetail.style", "modern")), "modern")
        item.title = m.detailBlurItemDefaults.title
        item.description = m.detailBlurItemDefaults.description
        item.options = m.detailBlurItemDefaults.options
        return
    end if

    item.title = "Background Opacity"
    item.description = invalid
    item.options = [
        { title: "Minimum (0)", id: "0" },
        { title: "Light (5)", id: "5" },
        { title: "Medium (10)", id: "10" },
        { title: "Strong (15)", id: "15" },
        { title: "Heavy (20)", id: "20" },
        { title: "Maximum (25)", id: "25" }
    ]
end sub

' The log readout. Drawn as a panel parented to this screen rather than a pushed scene,
' since the settings screen is itself an overlay and a scene would land underneath it.
sub showDiagnosticsPanel()
    dialog = createObject("roSGNode", "DiagnosticsPanel")
    dialog.observeField("sendRequested", "onDiagnosticsSendRequested")
    dialog.observeField("closed", "onDiagnosticsPanelClosed")

    m.diagnosticsPanel = dialog
    showPickerPanel(dialog)
    dialog.callFunc("showDialog")
end sub

sub onDiagnosticsPanelClosed(event as object)
    dialog = event.getRoSGNode()
    if not dialog.closed then return

    closePickerPanel(dialog)
    m.diagnosticsPanel = invalid
    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

sub showLibraryOrderPanel()
    dialog = createObject("roSGNode", "LibraryOrderPanel")
    dialog.style = m.cleanStyle
    dialog.observeField("closed", "onLibraryOrderPanelClosed")
    showPickerPanel(dialog)
    dialog.callFunc("showDialog")
end sub

' A panel closed right after a move is still saving, and is held until the server has the order,
' since a task nothing references can be collected mid flight
sub onLibraryOrderPanelClosed(event as object)
    dialog = event.getRoSGNode()
    closePickerPanel(dialog)

    held = []
    for each panel in m.closedLibraryOrderPanels ?? []
        if panel.saving then held.push(panel)
    end for
    if dialog.saving then held.push(dialog)
    m.closedLibraryOrderPanels = held

    hideEditingControls()
    m.settingsMenu.setFocus(true)
end sub

' The panel is made once and kept, so a load, save or reset still running when it closes carries
' on, and opening it again shows that one still going rather than starting a second
sub showSettingsSyncPanel()
    ' A theme picked since it was made gets a panel drawn in it. The old one is held, since a load,
    ' save or reset it started can still be running.
    if isValid(m.settingsSyncPanel) and not m.settingsSyncPanel.style.isSameNode(m.cleanStyle)
        m.retiredSyncPanel = m.settingsSyncPanel
        m.settingsSyncPanel = invalid
    end if
    if not isValid(m.settingsSyncPanel)
        m.settingsSyncPanel = createObject("roSGNode", "SettingsSyncPanel")
        m.settingsSyncPanel.style = m.cleanStyle
        m.settingsSyncPanel.observeField("closed", "onSettingsSyncPanelClosed")
        m.settingsSyncPanel.observeField("applied", "onSettingsSyncApplied")
        m.settingsSyncPanel.observeField("message", "onSettingsSyncMessage")
        m.settingsSyncPanel.observeField("refreshRequested", "testPluginConnection")
    end if

    m.syncedLook = syncedLook()
    m.top.appendChild(m.settingsSyncPanel)
    m.settingsSyncPanel.callFunc("showDialog")
end sub

sub onSettingsSyncPanelClosed()
    m.settingsMenu.setFocus(true)
    closePickerPanel(m.settingsSyncPanel)
    hideEditingControls()
    ' The entry shows the profile in use, which the panel can have changed
    refreshCurrentItemValue()
end sub

' The few settings that change what is already on screen, kept so a load or reset can tell what
' it moved
function syncedLook() as object
    return {
        navPosition: dynamicToDisplayString(getUserSettingValue("navbar.position", "top")),
        mediaBarMode: dynamicToDisplayString(getUserSettingValue("ui.home.mediaBarMode", "")),
        themeId: dynamicToDisplayString(getUserSettingValue("ui.theme.customThemeId", ""))
    }
end function

' Settings that arrived from the server are brought onto the screen the way changing them here
' would, and the rows behind the panel read themselves again once it closes
sub onSettingsSyncApplied()
    before = m.syncedLook
    after = syncedLook()
    m.syncedLook = after

    if not isStringEqual(after.navPosition, before.navPosition) then applyNavbarPosition(after.navPosition)
    if not isStringEqual(after.mediaBarMode, before.mediaBarMode) and m.global.hasField("mediaBarModeChanged")
        m.global.mediaBarModeChanged = m.global.mediaBarModeChanged + 1
    end if
    if not isStringEqual(after.themeId, before.themeId)
        themeApply.Refresh(m.top.getScene())
        applySettingsStyle()
        RefreshCurrentMenu()
    end if
    diagnostics.Apply()

    m.syncSettingsApplied = true
end sub

sub onSettingsSyncMessage(event as object)
    showItemMenuToast(event.getData())
end sub

' Uploading is a request, so it runs on a task rather than the render thread this screen
' is drawn on
sub onDiagnosticsSendRequested(event as object)
    dialog = event.getRoSGNode()
    if not dialog.sendRequested then return

    if isEmbyServer() and not chainLookupReturn(m.global, "session.pluginInfo.clientLogSupported", false)
        dialog.status = tr("Diagnostic uploads require a Moonfin plugin version with client log support.")
        return
    end if
    dialog.status = tr("Sending report...")

    task = createObject("roSGNode", "PostTask")
    task.apiUrl = diagnostics.UploadURL()
    task.contentType = "text/plain"
    task.stringData = diagnostics.BuildReport()
    task.observeField("responseCode", "onDiagnosticsReportSent")
    task.control = "RUN"

    m.diagnosticsUploadTask = task
end sub

sub onDiagnosticsReportSent(event as object)
    code = event.getData()
    m.diagnosticsUploadTask = invalid

    if not isValid(m.diagnosticsPanel) then return

    if code = 204 or code = 200
        m.diagnosticsPanel.status = tr("Report sent to the server")
    else if code = 403
        ' Jellyfin answers 403 when client logging is switched off server side, which is
        ' worth saying rather than reporting a plain failure
        m.diagnosticsPanel.status = tr("The server isnt accepting client logs. Turn them on in the server dashboard.")
    else
        m.diagnosticsPanel.status = tr("Couldnt send the report.") + " (" + code.ToStr() + ")"
    end if
end sub

' The achievements panel sits over this one rather than replacing it, so leaving it lands back
' on the entry it was opened from the way every other settings screen does
sub showAchievementsPanel()
    scene = m.top.getScene()
    if not isValid(scene) then return

    panel = CreateObject("roSGNode", "AchievementsScreen")
    panel.id = "achievementsOverlayPanel"
    panel.observeField("closed", "onAchievementsPanelClosed")
    panel.observeField("selectedItem", "onAchievementsItemSelected")
    panel.observeField("openFriends", "showFriendsPanel")
    scene.appendChild(panel)
    panel.callFunc("OnScreenShown", false)
    panel.setFocus(true)
end sub

sub onAchievementsPanelClosed()
    removeAchievementsPanel()
    m.settingsMenu.setFocus(true)
end sub

sub removeAchievementsPanel()
    scene = m.top.getScene()
    if not isValid(scene) then return

    panel = scene.findNode("achievementsOverlayPanel")
    if isValid(panel) then scene.removeChild(panel)
end sub

' This panel sits over the settings one, which sits over the app, so picking something to watch
' takes both of them out of the way before the item opens under them
sub onAchievementsItemSelected(event as object)
    item = event.getData()
    if not isValid(item) then return

    removeAchievementsPanel()
    dismissPanel()

    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.hasField("selectedItem") then activeScene.selectedItem = item
end sub

' The friends panel sits over whatever opened it, this panel or the achievements one, and leaving
' it lands back there
sub showFriendsPanel()
    scene = m.top.getScene()
    if not isValid(scene) then return

    panel = CreateObject("roSGNode", "FriendsScreen")
    panel.id = "friendsOverlayPanel"
    panel.observeField("closed", "onFriendsPanelClosed")
    panel.observeField("openItem", "onFriendsItemSelected")
    scene.appendChild(panel)
    panel.callFunc("OnScreenShown", false)
    panel.setFocus(true)
end sub

sub onFriendsPanelClosed()
    removeFriendsPanel()

    achievementsPanel = m.top.getScene().findNode("achievementsOverlayPanel")
    if isValid(achievementsPanel)
        achievementsPanel.callFunc("OnScreenShown", true)
    else
        m.settingsMenu.setFocus(true)
    end if
end sub

sub removeFriendsPanel()
    scene = m.top.getScene()
    if not isValid(scene) then return

    panel = scene.findNode("friendsOverlayPanel")
    if isValid(panel) then scene.removeChild(panel)
end sub

' What a friend is watching opens the way a playlist row does, once every panel is out of the way
sub onFriendsItemSelected(event as object)
    item = event.getData()
    if not isValid(item) then return

    removeFriendsPanel()
    removeAchievementsPanel()
    dismissPanel()
    m.global.sceneManager.itemMenuRequest = { action: "openItem", item: item }
end sub

' What a settings entry can ask the server for before it is worth showing
function settingRequirementMet(requirement as string) as boolean
    if requirement = "achievements" then return achievements.IsAvailable()
    if requirement = "social" then return achievements.SocialAvailable()
    if requirement = "kidsMode" then return kidsMode.Enabled()
    if requirement = "notKidsMode" then return not kidsMode.Enabled()
    if Left(requirement, 8) = "setting:"
        for each condition in requirement.Split("&&")
            if not settingConditionMet(Mid(condition, 9)) then return false
        end for
    end if
    return true
end function

' A row that only makes sense for another setting's value: "key" while that switch is on, or
' "key=value" and "key!=value" against a choice
function settingConditionMet(condition as string) as boolean
    expected = invalid
    negate = false
    key = condition
    at = Instr(1, condition, "!=")
    if at > 0
        key = Left(condition, at - 1)
        expected = Mid(condition, at + 2)
        negate = true
    else
        at = Instr(1, condition, "=")
        if at > 0
            key = Left(condition, at - 1)
            expected = Mid(condition, at + 1)
        end if
    end if

    value = LCase(dynamicToDisplayString(m.global.session.user.settings[key]))
    if not isValid(expected) then return value = "true"
    matches = value = LCase(expected)
    if negate then return not matches
    return matches
end function

' Rows that depend on the setting just changed come and go with it, and focus stays on the setting
sub refreshDependentRows(settingName as string)
    section = m.userLocation.peek()
    if not isValid(section) or not isValid(section.children) then return
    needle = "setting:" + settingName
    dependent = false
    for each item in section.children
        if Instr(1, chainLookupReturn(item, "requires", ""), needle) > 0
            dependent = true
            exit for
        end if
    end for
    if not dependent then return

    refreshMenu()
    for i = 0 to m.visibleItemsMap.count() - 1
        if isStringEqual(chainLookupReturn(m.visibleItemsMap[i], "settingName", ""), settingName)
            m.settingsMenu.jumpToItem = i
            exit for
        end if
    end for
end sub

import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/achievementsModel.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/detailMetadataLayout.bs"
import "pkg:/source/utils/homeCards.bs"
import "pkg:/source/utils/homeRowLayout.bs"
import "pkg:/source/utils/homeRowsPreview.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/libraryOrder.bs"
import "pkg:/source/utils/libraryPreview.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/playedState.bs"
import "pkg:/source/utils/ratingsRow.bs"
import "pkg:/source/utils/rowOptionsPreview.bs"
import "pkg:/source/utils/themeChrome.bs"

' The stage is the setup wizard's, so the previews' rounded art comes out at the radius it was
' cut for
const STAGE_WIDTH = 1040
const STAGE_HEIGHT = 585
const STAGE_TOP = 56
const SHADOW_MARGIN = 96
const STAGE_RADIUS = 24
const INSPECTOR_TOP = 657
const INSPECTOR_HEIGHT = 271
const INSPECTOR_PAD = 28
const CHIP_HEIGHT = 44
const CHIP_GAP = 10
const LABEL_LEFT = 24
const OPTION_GAP = 10
const OPTION_MARKER = 28
' The status line of a setting that needs something else turned on first
const BLOCKED_INK = "0xFFC107FF"
const NOTICE_WIDTH = 760
' The rows under the edited one that the stage has room for at the smallest card size
const ROWS_BELOW = 4

sub init()
    m.header = m.top.findNode("header")
    m.holder = m.top.findNode("holder")
    m.inspector = m.top.findNode("inspector")
    m.sceneKey = ""
    m.headerKey = ""
    m.inspectorKey = ""
    m.calendar = invalid
    m.calendarShared = invalid
    m.libraryPages = {}
    m.libraryTask = invalid
    m.effect = invalid
    m.rowSamples = {}
    m.shownSamples = {}
    m.rowTask = invalid
    m.homeSnapshot = invalid
    m.rowLayout = invalid
    m.rowOptionsStatus = ""
    m.homeRowCache = {}

    m.inspector.translation = [0, INSPECTOR_TOP]
    m.holder.translation = [0, STAGE_TOP]
    m.holder.clippingRect = [0, 0, STAGE_WIDTH, STAGE_HEIGHT]
    drawStageFrame()
end sub

' The stage's shadow, its corners in the page color and its edge line only show along its edges,
' so each one is clipped to bands there. Spread over the whole stage they cost the stick frames
' whenever something on the stage moves, like a seasonal effect.
sub drawStageFrame()
    shadowTop = STAGE_TOP + 24 - SHADOW_MARGIN
    shadowWidth = STAGE_WIDTH + 2 * SHADOW_MARGIN
    shadowHeight = STAGE_HEIGHT + 2 * SHADOW_MARGIN
    stageBottom = STAGE_TOP + STAGE_HEIGHT
    outside = [
        [-SHADOW_MARGIN, shadowTop, shadowWidth, STAGE_TOP - shadowTop],
        [-SHADOW_MARGIN, stageBottom, shadowWidth, shadowTop + shadowHeight - stageBottom],
        [-SHADOW_MARGIN, STAGE_TOP, SHADOW_MARGIN, STAGE_HEIGHT],
        [STAGE_WIDTH, STAGE_TOP, SHADOW_MARGIN, STAGE_HEIGHT]
    ]
    shadow = m.top.findNode("shadow")
    for each band in outside
        clip = shadow.createChild("Group")
        clip.clippingRect = band
        setupPreviewDraw.Shape(clip, "pkg:/images/setup/stage24shadow.9.png", -SHADOW_MARGIN, shadowTop, shadowWidth, shadowHeight, "0x00000080")
    end for

    inside = [
        [0, STAGE_TOP, STAGE_WIDTH, STAGE_RADIUS],
        [0, stageBottom - STAGE_RADIUS, STAGE_WIDTH, STAGE_RADIUS],
        [0, STAGE_TOP + STAGE_RADIUS, STAGE_RADIUS, STAGE_HEIGHT - 2 * STAGE_RADIUS],
        [STAGE_WIDTH - STAGE_RADIUS, STAGE_TOP + STAGE_RADIUS, STAGE_RADIUS, STAGE_HEIGHT - 2 * STAGE_RADIUS]
    ]
    frame = m.top.findNode("frame")
    m.covers = []
    m.strokes = []
    for each band in inside
        clip = frame.createChild("Group")
        clip.clippingRect = band
        m.covers.push(setupPreviewDraw.Shape(clip, "pkg:/images/setup/stage24cover.9.png", 0, STAGE_TOP, STAGE_WIDTH, STAGE_HEIGHT, "0xFFFFFFFF"))
        m.strokes.push(setupPreviewDraw.Shape(clip, "pkg:/images/setup/stage24s2.9.png", 0, STAGE_TOP, STAGE_WIDTH, STAGE_HEIGHT, "0xFFFFFFFF"))
    end for
end sub

sub onItemsChanged()
    m.sceneKey = ""
    redraw()
end sub

sub redraw()
    state = m.top.state
    if not isValid(state) or not isValid(state.values) then return
    pal = setupPreviewDraw.Palette()
    ' Rectangles ignore masks on Roku, so the stage's corners are painted in the page color
    strokeInk = playbackOverlay.WithAlpha(pal.onSurface, 51)
    for i = 0 to m.covers.count() - 1
        m.covers[i].blendColor = state.pageColor
        m.strokes[i].blendColor = strokeInk
    end for
    drawHeader(state, pal)
    drawScene(state)
    drawInspector(state, pal)
    ' Something just moved on the remote, so the effect holds still until it goes quiet, which keeps
    ' the list and the picker at full rate
    if isValid(m.effect) then m.effect.callFunc("hold")
end sub

' The remote reaches the chips from the list, and the chosen one is painted the way the category
' pill paints its own, white while the row has focus.
sub drawHeader(state as object, pal as object)
    accent = state.accent ?? pal.accent
    key = FormatJson([state.scene, state.chipsFocused = true, accent, pal.accent, pal.onSurface, state.chips])
    if key = m.headerKey then return
    m.headerKey = key

    m.header.removeChildrenIndex(m.header.getChildCount(), 0)
    chips = m.header.createChild("Group")
    chips.clippingRect = [0, 0, STAGE_WIDTH, CHIP_HEIGHT]
    pieces = []
    widths = []
    for each chip in state.chips ?? []
        selected = chip.id = state.scene
        fill = "0xFFFFFF38"
        ink = playbackOverlay.WithAlpha(pal.onSurface, 179)
        uri = "pkg:/images/setup/ring20.9.png"
        if selected
            fill = accent
            ink = "0xFFFFFFFF"
            uri = "pkg:/images/livetv/fill20.9.png"
            if state.chipsFocused = true
                fill = "0xFFFFFFFF"
                ink = "0x000000FF"
            end if
        end if
        shape = setupPreviewDraw.Shape(chips, uri, 0, 0, 0, CHIP_HEIGHT, fill)
        label = setupPreviewDraw.TextLabel(chips, chip.label, 0, 0, 22, ink, true)
        pieces.push([shape, label])
        widths.push(label.boundingRect().width + 40)
    end for

    layout = headerLayout(widths, CHIP_GAP, STAGE_WIDTH, LABEL_LEFT)
    x = layout.start
    for i = 0 to pieces.Count() - 1
        pieces[i][0].translation = [x, 0]
        pieces[i][0].width = widths[i]
        label = pieces[i][1]
        label.translation = [x, 0]
        label.width = widths[i]
        label.height = CHIP_HEIGHT
        label.horizAlign = "center"
        label.vertAlign = "center"
        x = x + widths[i] + CHIP_GAP
    end for

    if layout.labelWidth <= 0 then return
    setupPreviewDraw.Shape(m.header, "pkg:/images/icons/circle.webp", 0, 16, 12, 12, pal.accent)
    title = setupPreviewDraw.TextLabel(m.header, UCase(tr("Live preview")), LABEL_LEFT, 7, 22, playbackOverlay.WithAlpha(pal.onSurface, 153), true)
    title.width = layout.labelWidth
end sub

' Where the chips start and how wide the label may run. The chips keep their own widths, the label
' gives way to them, and they never start left of the stage, so the first one always shows whole.
function headerLayout(chipWidths as object, gap as float, stageWidth as float, labelLeft as float) as object
    total = 0
    for each width in chipWidths
        total = total + width + gap
    end for
    start = stageWidth - total + gap
    if start < 0 then start = 0
    room = start - labelLeft - gap * 2
    ' A sliver of the label would only show its ellipsis
    if room < 60 then room = 0
    return { start: start, labelWidth: room }
end function

' The scene is built again only when what it draws changed, since a preview is a few dozen nodes
sub drawScene(state as object)
    config = sceneConfig(state)
    key = config.component + FormatJson(config.fields) + config.variant
    if key = m.sceneKey then return
    m.sceneKey = key

    loading = m.holder.findNode("loadingPreview")
    if isValid(loading) then loading.active = false
    ' What the calendar loaded goes on to the next one, so trying the other style doesn't wait on the server
    if isValid(m.calendar)
        shared = m.calendar.callFunc("calendarShared")
        if isValid(shared) then m.calendarShared = shared
        m.calendar = invalid
    end if
    ' Its animations stop before it goes, so nothing of it runs on behind the next scene
    if isValid(m.effect)
        m.effect.callFunc("halt")
        m.effect = invalid
    end if
    m.holder.removeChildrenIndex(m.holder.getChildCount(), 0)
    preview = m.holder.createChild(config.component)
    if isValid(config.page) then preview.page = config.page
    preview.setFields(config.fields)
    ' Every preview draws on a full screen canvas and shrinks to the stage
    preview.scale = [STAGE_WIDTH / 1920, STAGE_HEIGHT / 1080]
    if isValid(config.screen)
        m.calendar = CreateObject("roSGNode", config.screen)
        m.calendar.callFunc("calendarLoad", m.calendarShared)
        preview.screen = m.calendar
    end if
    if isValid(config.homeRows) then preview.screen = homeRowsScreen(config.homeRows)
    preview.items = config.items
    if isValidAndNotEmpty(config.notice) then drawNotice(config.notice)
    if isValidAndNotEmpty(config.caption) then drawCaption(config.caption)
    if isValid(config.effect)
        m.effect = m.holder.createChild("SeasonalEffects")
        m.effect.scale = preview.scale
        m.effect.callFunc("preview", config.effect)
    end if
end sub

function sceneConfig(state as object) as object
    values = state.values
    focusKey = state.focusKey ?? ""
    items = m.top.items ?? []
    m.rowOptionsStatus = ""

    if state.scene = "details"
        hide = values["ui.itemdetail.hideMediaDescription"] = "true"
        shown = items
        if hide then shown = withoutOverview(items)
        style = values["ui.itemdetail.style"] ?? "frost"
        episode = focusKey = "plugin.tmdb.episodeRatings"
        fields = { variant: style, ratings: ratingsFields("", sampleItem(not episode), episode), pageLayout: detailLayout(values, style) }
        return { component: "SetupDetailPreview", fields: fields, items: shown, variant: hide.ToStr() }
    end if
    if state.scene = "player"
        moment = "middle"
        if focusKey = "playback.mediasegments.intro" then moment = "intro"
        if focusKey = "playback.nextupbehavior" then moment = "end"
        if Left(focusKey, 20) = "ui.loadingAnimation." then moment = "loading"
        if Left(focusKey, 19) = "playback.trickplay." then moment = "seek"
        ' A subtitle's look is judged as it plays, so the controls step out of the way
        styleKey = Left(focusKey, 20) = "playback.subs.style."
        if styleKey or focusKey = "playback.subs.custom" then moment = "playing"
        hdr = styleKey and (Right(focusKey, 3) = "Hdr" or focusKey = "playback.subs.style.hdrSeparate")
        return { component: "SettingsPlayerPreview", fields: { moment: moment, values: values, hdr: hdr }, items: items, variant: "" }
    end if
    if state.scene = "search"
        return { component: "SettingsKeyboardPreview", fields: { keyboardStyle: values["ui.keyboard.style"] ?? "docked" }, items: items, variant: "" }
    end if
    if state.scene = "calendar"
        view = "CalendarAgendaView"
        if values["calendar.style"] = "countdown" then view = "CalendarCountdownView"
        ' The calendar reads its other settings itself, so it's built again once one is saved
        saves = state.saves ?? 0
        return { component: "SetupNavbarPreview", fields: navbarFields(values, state.avatar ?? ""), items: items, screen: view, variant: view + saves.ToStr() }
    end if
    if state.scene = "library" then return libraryConfig(state)
    ' Hiding descriptions takes the overview off everything on Home, the way the real one does
    hideHome = values["ui.home.hideMediaDescription"] = "true"
    if hideHome then items = withoutOverview(items)
    variant = hideHome.ToStr()
    if rowOptionsPreview.Group(focusKey) <> "" then return rowOptionsConfig(state, items, variant)
    if focusKey = "ui.home.mediaBarMode" or focusKey = "ui.overlayColor" or focusKey = "ui.overlayOpacity" or Left(focusKey, 20) = "ui.mediaBar.ratings." or focusKey = "ui.home.mediaBarNewReleaseBanner" or focusKey = "ui.home.mediaBarNewReleaseDays" or focusKey = "ui.home.mediaBarRowPeek"
        opacity = -1.0
        if values["ui.overlayOpacity"] <> "" then opacity = Val(values["ui.overlayOpacity"])
        mode = values["ui.home.mediaBarMode"] ?? "moonfin"
        fields = { mode: mode, overlayColor: values["ui.overlayColor"] ?? "", overlayOpacity: opacity, ratings: ratingsFields("mediaBar", sampleItem(false), false) }
        ' Peek Home Rows leaves the banner and no bar alone, as on Home
        fields.rowPeek = values["ui.home.mediaBarRowPeek"] = "true" and not inArray(["banner", "off"], mode)
        peek = invalid
        if fields.rowPeek then peek = homePeekFields(values)
        if isValid(peek) then fields.peek = peek
        banner = values["ui.home.mediaBarNewReleaseBanner"] <> "false"
        if banner then items = withNewReleaseSample(items)
        return { component: "SetupMediaBarPreview", fields: fields, items: items, variant: variant + banner.ToStr() }
    end if
    ownRows = drawsHomeRows(focusKey)
    if focusKey = "ui.home.rowsStyle" or focusKey = "ui.home.hideMediaDescription" or focusKey = "ui.home.backdropStyle" or Left(focusKey, 16) = "ui.home.ratings." or focusKey = "colorCursor" or ownRows
        modern = values["ui.home.rowsStyle"] <> "v1"
        episode = focusKey = "ui.home.ratings.episodeRatings"
        ' The modern card shows only the plugin's scores
        onItem = sampleItem(not episode)
        if modern then onItem = {}
        fields = { modern: modern, ratings: ratingsFields("home", onItem, episode), backdrop: getHomeBackdropStyle(values), cursor: values["colorCursor"] ?? "", focusCard: focusKey = "colorCursor" or ownRows }
        ' Opened from anywhere but Home there are no rows to draw, so the sample rows stand in
        home = invalid
        if ownRows then home = homeRowsFields(values, focusKey, modern)
        if isValid(home) then fields.home = home
        return { component: "SetupHomeRowsPreview", fields: fields, items: items, variant: variant }
    end if
    config = { component: "SetupNavbarPreview", fields: navbarFields(values, state.avatar ?? ""), items: items, variant: variant }
    ' The seasonal effect runs over Home only while its own setting has focus, and None builds nothing
    if inArray(["seasonal.surprise", "seasonal.density"], state.focusedSetting) and values["seasonal.surprise"] <> "none"
        config.effect = { effect: values["seasonal.surprise"], density: values["seasonal.density"] }
        config.variant = variant + config.effect.effect + config.effect.density
    end if
    return config
end function

' The audio and Collections Row Options draw Home with the remote on the first row they change,
' loaded in the sort being tried, and Home's own rows under it. When none of those rows can be on
' Home, Home stays as it is and a note says what keeps them off. The note and caption go into the
' variant, so moving between settings that draw the same rows still puts up the right one.
function rowOptionsConfig(state as object, items as object, variant as string) as object
    values = state.values
    focusKey = state.focusKey
    layout = rowLayout(state.focusedSetting ?? "")
    arranged = layout.arranged
    edited = rowOptionsPreview.EditedRow(focusKey, arranged, layout.picked)
    reason = rowOptionsPreview.Blocked(focusKey, values, edited)
    m.rowOptionsStatus = rowOptionsPreview.Status(focusKey, reason)
    config = { component: "SetupNavbarPreview", fields: navbarFields(values, state.avatar ?? ""), items: items, variant: variant + reason }
    if reason <> ""
        config.notice = rowOptionsPreview.Notice(focusKey, reason)
        config.variant = config.variant + config.notice
        return config
    end if

    sample = rowSample(edited, values)
    if not isValid(sample) then return config
    ' A sort doesn't change what's in a row, so nothing back for a row Home shows means the request
    ' failed, and Home's own copy stands in. Show Episodes can empty a row, so it keeps its answer.
    if sample.items.count() = 0 and focusKey <> "ui.home.collectionsRowShowEpisodes"
        for each row in homeSnapshot().rows
            if row.id = edited then sample = { key: "home", items: snapshotItems(row) }
        end for
    end if
    if sample.items.count() = 0
        config.notice = rowOptionsPreview.Notice(focusKey, "empty")
        config.variant = config.variant + config.notice
        return config
    end if

    modern = values["ui.home.rowsStyle"] <> "v1"
    hide = values["ui.home.hideMediaDescription"] = "true"
    rows = [editedRowLook(edited, sample.items, modern, hide, layout.picked)]
    snapshot = homeSnapshot()
    first = rowOptionsPreview.RowsAfter(edited, arranged, snapshot.ids)
    if first >= 0
        last = first + ROWS_BELOW - 1
        if last > snapshot.rows.count() - 1 then last = snapshot.rows.count() - 1
        for i = first to last
            rows.push(snapshotRowLook(snapshot.rows[i], hide))
        end for
    end if
    config.homeRows = { modern: modern, backdrop: getHomeBackdropStyle(values), rows: rows }
    config.caption = rowOptionsPreview.Caption(focusKey, edited, arranged)
    config.variant = config.variant + sample.key + modern.ToStr() + config.homeRows.backdrop + config.caption
    return config
end function

' Home's row order and its collection rows, read again whenever focus moves to another row of the
' list, since a picker trying one value after another redraws on every press and Rows can't change
' while one row keeps focus. Going to Rows and back moves focus, so that reads them again.
function rowLayout(focusedSetting as string) as object
    if isValid(m.rowLayout) and m.rowLayout.focusedSetting = focusedSetting then return m.rowLayout
    m.rowLayout = { focusedSetting: focusedSetting, arranged: homeRowLayout.Arranged(), picked: pickedCollections() }
    return m.rowLayout
end function

' The rows the preview draws, on the page Home draws them on
function homeRowsScreen(look as object) as object
    screen = CreateObject("roSGNode", "SetupHomeRowsPreview")
    screen.setFields({ modern: look.modern, backdrop: look.backdrop, rows: look.rows })
    screen.items = []
    return screen
end function

' The collections added to Home as rows of their own that Home shows, by id. One picked on another
' server is left out, since the preview reads from this one.
function pickedCollections() as object
    picked = {}
    for each entry in homeRowLayout.DynamicRows()
        if entry.source = "collections" and homeRowLayout.PickShown(entry.id) and homeRowLayout.IsOwnServer(entry.id) then picked[entry.id] = entry.title
    end for
    return picked
end function

' The edited row in the sort being tried, read through Home's own loader with the Row Options
' values in place of the saved ones. Each sort is asked for once while settings is open, and one at
' a time, so scrubbing through a picker only loads where it stops. Until a new sort arrives the row
' keeps the last one drawn, or Home's own, or else Home stays as it is.
function rowSample(rowId as string, values as object) as dynamic
    tried = {}
    for each key in ["ui.home.audioRowsSortBy", "ui.home.audioRowsSortOrder", "ui.home.collectionsRowSortBy", "ui.home.collectionsRowSortOrder", "ui.home.collectionsRowShowEpisodes"]
        tried[key] = values[key]
    end for
    key = rowId + FormatJson(tried)
    sample = m.rowSamples[key]
    if isValid(sample)
        m.shownSamples[rowId] = sample
        return sample
    end if

    if not isValid(m.rowTask)
        settings = {}
        settings.Append(chainLookupReturn(m.global.session, "user.settings", {}))
        settings.Append(tried)
        m.rowTask = CreateObject("roSGNode", "LoadItemsTask")
        m.rowTask.setFields({ itemsToLoad: rowId, settings: settings })
        m.rowTaskKey = key
        m.rowTask.observeField("content", "onRowSampleLoaded")
        m.rowTask.control = "RUN"
    end if

    shown = m.shownSamples[rowId]
    if isValid(shown) then return shown
    for each row in homeSnapshot().rows
        if row.id = rowId then return { key: "home", items: snapshotItems(row) }
    end for
    return invalid
end function

' The sort that arrived, kept for the rest of the time settings is open
sub onRowSampleLoaded()
    task = m.rowTask
    task.unobserveField("content")
    m.rowTask = invalid
    m.rowSamples[m.rowTaskKey] = { key: m.rowTaskKey, items: previewCards(task.content ?? []) }
    redraw()
end sub

' Home's rows as Settings found them. Home stays loaded behind Settings and only builds its rows
' again once Settings closes, so they're read once. Settings opened over another screen has none.
' A row's cards are only read once the preview draws it.
function homeSnapshot() as object
    if isValid(m.homeSnapshot) then return m.homeSnapshot
    m.homeSnapshot = { ids: [], rows: [] }
    screen = m.global.sceneManager.callFunc("getActiveScene")
    if not isValid(screen) or screen.subtype() <> "Home" then return m.homeSnapshot
    list = screen.findNode("homeRows")
    if not isValid(list) or not isValid(list.content) then return m.homeSnapshot
    for each row in list.content.getChildren(-1, 0)
        if row.getChildCount() = 0 then continue for
        m.homeSnapshot.ids.push(row.id)
        m.homeSnapshot.rows.push({ id: row.id, title: row.title, cell: row.cursorSize, imageType: row.imageType, modernCards: row.modernCards, node: row, items: invalid })
    end for
    return m.homeSnapshot
end function

' The edited row's cards, shaped the way Home shapes that row. A row Home already has keeps the
' shape it has there, and one it doesn't yet is shaped by the same rules.
function editedRowLook(rowId as string, items as object, modern as boolean, hide as boolean, picked as object) as object
    sizeName = homeCards.CardSizeName()
    look = invalid
    for each row in homeSnapshot().rows
        if row.id = rowId then look = snapshotRowLook(row, hide)
    end for
    if not isValid(look)
        audio = rowId = "audio"
        look = { title: rowTitle(rowId, picked), modernCards: modern and not audio and useModernCardsForRow(rowId) }
        if look.modernCards
            look.imageType = "poster"
            look.cell = homeCards.CardBox(sizeName, 2 / 3)
        else
            look.imageType = homeCards.RowImageType(rowId, audio)
            look.cell = homeCards.CardBox(sizeName, homeCards.AspectFor(items[0].type, rowId, audio, look.imageType))
        end if
    end if
    look.items = items
    if hide then look.items = withoutOverview(items)
    look.wideWidth = homeCards.CardBox(sizeName, 16 / 9, true)[0]
    return look
end function

' A row Home has, drawn the way Home draws it
function snapshotRowLook(row as object, hide as boolean) as object
    look = { title: row.title, cell: row.cell, imageType: row.imageType, modernCards: row.modernCards, items: snapshotItems(row) }
    if hide then look.items = withoutOverview(look.items)
    return look
end function

function snapshotItems(row as object) as object
    if not isValid(row.items) then row.items = previewCards(row.node.getChildren(12, 0))
    return row.items
end function

' The title Home gives a row it doesn't have yet
function rowTitle(rowId as string, picked as object) as string
    if rowId = "audio" then return tr("Audio")
    if rowId = "collections" then return tr("Collections")
    return picked[rowId] ?? ""
end function

' Home's cards in the shape the preview draws: the art for each image type, the backdrop behind
' the focused one and the facts its details show
function previewCards(nodes as object) as object
    cards = []
    for each node in nodes
        json = node.json ?? {}
        card = { title: node.title, type: toString(node.type), posterUrl: node.posterURL, wideUrl: node.thumbnailURL, backdropUrl: "", year: "", officialRating: toString(json.OfficialRating), runtime: "", overview: toString(json.Overview), genres: [] }
        if not isValidAndNotEmpty(card.title) then card.title = toString(node.name)
        if isValid(json.ProductionYear) then card.year = json.ProductionYear.toStr()
        ' A clip under a minute would read as 0m
        if isValid(json.RunTimeTicks) and json.RunTimeTicks >= 600000000 then card.runtime = getFormattedRuntime(json.RunTimeTicks)
        tags = json.BackdropImageTags
        if type(tags) = "roArray" and tags.count() > 0 then card.backdropUrl = ImageURL(node.id, "Backdrop", { maxWidth: 1280, maxHeight: 720, quality: 90 })
        ' A wide card takes the thumbnail the way Home's does, then the wide art, the backdrop and the poster
        for each art in [node.widePosterURL, card.backdropUrl, card.posterUrl]
            if not isValidAndNotEmpty(card.wideUrl) then card.wideUrl = art
        end for
        cards.push(card)
    end for
    return cards
end function

' What keeps the rows off Home, over the middle of the stage
sub drawNotice(text as string)
    panel = m.holder.createChild("Group")
    label = setupPreviewDraw.Paragraph(panel, text, 32, 28, NOTICE_WIDTH - 64, 26, 5, "0xFFFFFFFF")
    height = label.boundingRect().height + 56
    setupPreviewDraw.Round(panel, 0, 0, NOTICE_WIDTH, height, 20, "0x000000D9")
    ' Back on top of the panel
    panel.removeChild(label)
    panel.appendChild(label)
    panel.translation = [(STAGE_WIDTH - NOTICE_WIDTH) / 2, (STAGE_HEIGHT - height) / 2]
end sub

' A note along the foot of the stage
sub drawCaption(text as string)
    band = m.holder.createChild("Group")
    setupPreviewDraw.Rect(band, 0, 0, STAGE_WIDTH, 64, "0x000000B3")
    label = setupPreviewDraw.TextLabel(band, text, 24, 0, 22, "0xFFFFFFFF", false)
    label.width = STAGE_WIDTH - 48
    label.height = 64
    label.vertAlign = "center"
    band.translation = [0, STAGE_HEIGHT - 64]
end sub
' The settings Home draws on its own rows, which the sample rows can't show
function drawsHomeRows(focusKey as string) as boolean
    if Left(focusKey, Len(settingsSync.ROW_IMAGE_TYPE_KEY)) = settingsSync.ROW_IMAGE_TYPE_KEY then return true
    return inArray([
        "ui.home.rowLayout", "ui.home.rowImageTypes", "ui.home.displayRewatchRow", "ui.home.displayFavoritesRows",
        "ui.home.displayCollectionsRows", "ui.home.displayGenresRows", "ui.home.displayStudiosRows",
        "ui.home.displayPlaylistsRows", "ui.home.displayAudioRows", "seasonal.row.enabled",
        "ui.home.mergeContinueWatchingNextUp", "ui.home.mergeRecentRowsByType", "ui.home.genresRowSortBy",
        "ui.home.collectionsRowSortBy", "ui.home.rewatchSortBy", "ui.tvshows.disableUnwatchedEpisodeCount",
        "ui.watchedIndicator", "ui.posterLabels", "ui.home.preferThumbnails", "ui.home.classicRowsPadding",
        "ui.home.modernRowsPadding"
    ], focusKey)
end function

' Home's rows from the one the focused setting changes down to the foot of the screen, with what
' the values hold put on them, tried or saved, and the Classic info area for the focused card.
' Invalid when there's no Home behind Settings.
function homeRowsFields(values as object, focusKey as string, modern as boolean) as dynamic
    rows = arrangedHomeRows(values)
    if not isValid(rows) then return invalid
    if rows.Count() = 0 then return { rows: [], ink: homeCardInk() }
    genresSort = values["ui.home.genresRowSortBy"] ?? "name"
    if focusKey = "ui.home.genresRowSortBy" and genresSort <> (get_user_setting("ui.home.genresRowSortBy") ?? "name")
        rows = homeRowsPreview.WithGenresSort(rows, genresSort)
    end if

    paddingKey = "ui.home.classicRowsPadding"
    if modern then paddingKey = "ui.home.modernRowsPadding"
    spacing = homeRowsVerticalSpacing(modern, values[paddingKey])
    marks = homeCardMarks(values)
    sizeName = homeCards.CardSizeName()
    infoRoom = homeRowsPreview.MODERN_INFO_ROOM
    if moonfinPlugin.IsRatingsEnabled("home") then infoRoom += homeRowsPreview.MODERN_RATINGS_ROOM

    ' Home's rows sit under the info area in Classic, and near the top in Modern
    y = 450
    if modern then y = 170
    focusAt = homeRowsPreview.FocusIndex(rows, focusKey)
    shown = []
    for i = focusAt to rows.Count() - 1
        if y >= 1080 then exit for
        look = homeRowsPreview.Look(rows[i], modern, values[settingsSync.ROW_IMAGE_TYPE_KEY + rows[i].id], sizeName, infoRoom)
        laid = homeRowsPreview.Laid(rows[i], look, i = focusAt, marks, y)
        shown.push(laid)
        y += laid.height + spacing
    end for

    focused = rows[focusAt].items[0]
    text = homeRowsPreview.CardText(focused, false)
    info = { title: text[0], year: focused.year, officialRating: focused.officialRating, genres: focused.genres, overview: focused.overview }
    return { rows: shown, ink: homeCardInk(), info: info, backdropUrl: focused.backdrop }
end function

' Home's first row where Peek Home Rows puts it under the bar, or invalid when there's no Home
' behind Settings
function homePeekFields(values as object) as dynamic
    rows = arrangedHomeRows(values)
    if not isValid(rows) or rows.Count() = 0 then return invalid
    look = homeRowsPreview.Look(rows[0], values["ui.home.rowsStyle"] <> "v1", invalid, homeCards.CardSizeName(), homeRowsPreview.MODERN_INFO_ROOM)
    ' The bar keeps focus, so no card in the row is focused
    return { rows: [homeRowsPreview.Laid(rows[0], look, false, homeCardMarks(values), 890)], ink: homeCardInk() }
end function

' Home's rows in the order the Rows screen and the Display switches give now, merged the way
' Continue Watching is now. Invalid when there's no Home behind Settings.
function arrangedHomeRows(values as object) as dynamic
    rows = homeRowsBehind()
    if not isValid(rows) then return invalid
    toggles = homeRowLayout.RowToggles()
    shownIds = []
    for each id in homeRowLayout.Arranged(values[homeRowLayout.ORDER_SETTING], values[homeRowLayout.HIDDEN_SETTING])
        if homeRowOn(id, toggles) then shownIds.push(id)
    end for
    titles = { merged: tr("Continue Watching & Next Up"), resume: tr("Continue Watching"), nextUp: tr("Next Up") }
    return homeRowsPreview.Arrange(rows, shownIds, values["ui.home.mergeContinueWatchingNextUp"] = "true", titles)
end function

' The switch a row answers to, the way HomeRows asks before it builds the row. A picked collection,
' genre or playlist goes with the switch of the list it came from.
function homeRowOn(id as string, toggles as object) as boolean
    picked = homeRowLayout.SourceFromId(id)
    if isValid(picked)
        entry = homeRowLayout.SourceFor(picked.source)
        return not isValid(entry) or entry.gate = "" or get_user_setting_bool(entry.gate, false)
    end if
    return homeRowLayout.RowToggleOn(id, toggles)
end function

' The rows Home has behind Settings, read into plain facts, or invalid when Settings was opened
' somewhere else. A row is read again only when its cards change, since reading a card's json
' copies it.
function homeRowsBehind() as dynamic
    behind = m.global.sceneManager.callFunc("getActiveScene")
    if not isValid(behind) or not behind.isSubtype("Home") then return invalid
    list = behind.findNode("homeRows")
    if not isValid(list) or not isValid(list.content) then return invalid
    rows = []
    kept = {}
    for each node in list.content.getChildren(-1, 0)
        count = node.getChildCount()
        ' A row still loading is only its title
        if count > 0
            key = `${node.id}|${node.title}|${count}`
            row = m.homeRowCache[key]
            if not isValid(row)
                row = { id: node.id, title: node.title, items: [] }
                ' The Genres row is read whole, so a sort being tried can reorder all of it
                limit = homeRowsPreview.MAX_CARDS
                if node.id = "genres" then limit = count
                for each child in node.getChildren(limit, 0)
                    row.items.push(homeCardFacts(child))
                end for
            end if
            kept[key] = row
            rows.push(row)
        end if
    end for
    m.homeRowCache = kept
    return rows
end function

' What the preview needs of one of Home's cards, read the way HomeItem reads it
function homeCardFacts(node as object) as object
    json = node.json
    if not isValid(json) then json = {}
    userData = json.UserData
    if type(userData) <> "roAssociativeArray" then userData = {}
    yearText = toString(json.ProductionYear).Trim()
    if yearText = "0" then yearText = ""
    subline = toString(json.Subtitle)
    if subline = "" then subline = yearText
    genres = []
    if type(json.Genres) = "roArray"
        for each genre in json.Genres
            if genres.Count() < 3 then genres.push(toString(genre))
        end for
    end if
    return {
        id: node.id,
        type: node.type ?? "",
        name: node.name ?? "",
        poster: node.posterURL,
        thumb: node.thumbnailURL,
        wide: node.widePosterURL,
        banner: node.bannerURL,
        backdrop: node.backdropURL,
        outside: isValid(json.SeerrTmdbId) or isValid(json.CalendarDate),
        percent: node.PlayedPercentage ?? 0,
        played: playedState.ShowsWatchedCheck(json),
        unplayed: userData.UnplayedItemCount ?? 0,
        favorite: (userData.IsFavorite ?? false) = true,
        series: toString(json.SeriesName),
        season: json.ParentIndexNumber,
        episode: json.IndexNumber,
        subline: subline,
        year: yearText,
        officialRating: toString(json.OfficialRating),
        genres: genres,
        overview: toString(json.Overview),
        labels: node.LookupCI("posterLabels")
    }
end function

' The marks over the cards as the values show them: the watched mark's mode, whether the unwatched
' count is hidden, Prefer Thumbnails and the poster labels, which only show where Home asked for them
function homeCardMarks(values as object) as object
    return {
        indicatorMode: values["ui.watchedIndicator"] ?? "always",
        hideUnplayedCount: values["ui.tvshows.disableUnwatchedEpisodeCount"] = "true",
        preferThumbs: values["ui.home.preferThumbnails"] = "true",
        labels: values["ui.posterLabels"] = "true"
    }
end function

' HomeItem's colors for the art's ground, the names and the progress bar
function homeCardInk() as object
    colors = chainLookupReturn(m.global.session, "user.settings", {})
    return {
        card: colors.colorHomeRowItemBackground ?? ColorPalette.ELEMENTBACKGROUND,
        title: colors.colorHomeRowItemTitle ?? ColorPalette.WHITE,
        progress: colors.colorHomeRowItemProgress ?? ColorPalette.TRIADBLUE,
        track: colors.colorHomeRowItemProgressBackground ?? ColorPalette.BLACK90
    }
end function

' The library screen's copy, drawn in whatever style and switches the values hold, tried or
' saved. The music library shows while its style has focus, or when there is no video library.
' It's built again when its page arrives, and on a save of a setting it reads but doesn't show,
' like Card Size.
function libraryConfig(state as object) as object
    values = state.values
    libraries = libraryOrder.Loaded()
    library = libraryOrder.FirstVideo(libraries)
    music = libraryOrder.FirstMusic(libraries)
    showMusic = isValid(music) and (state.focusKey = "ui.library.musicStyle" or not isValid(library))
    if showMusic then library = music
    musicStyle = values["ui.library.musicStyle"]
    styledMusic = showMusic and musicStyle <> "classic"
    grouped = not showMusic and values["ui.library.groupItemsIntoCollections"] = "true"
    page = invalid
    name = ""
    if isValid(library)
        if styledMusic
            page = musicPage(library)
        else
            page = libraryPage(library, grouped)
        end if
        name = (library.name ?? "") + (library.serverSuffix ?? "")
    end if
    look = {
        name: name,
        style: values["ui.library.style"],
        showDetails: values["ui.library.showMediaDetails"] <> "false",
        cardTitles: values["ui.library.cardTitles"] <> "false",
        showBackdrops: values["ui.library.showBackdrops"] <> "false",
        orientation: values["libraryPosterOrientation"],
        music: showMusic
    }
    if showMusic then look.musicStyle = musicStyle
    ' Quick Access and Immersive keep the navigation bar on screen, drawn the way Home's is
    if styledMusic then look.navbar = navbarFields(values, state.avatar ?? "")
    saves = state.saves ?? 0
    return { component: "SettingsLibraryPreview", fields: { look: look }, items: [], page: page, variant: isValid(page).ToStr() + saves.ToStr() }
end function

' The library's first page, asked for once per grouping while settings is open, so trying another
' style or switch draws straight away. Invalid until it arrives.
function libraryPage(library as object, grouped as boolean) as dynamic
    key = library.id + grouped.ToStr()
    page = m.libraryPages[key]
    if isValid(page) or isValid(m.libraryTask) then return page

    request = libraryPreview.Request(library, chainLookupReturn(m.global.session, "user.settings", {}), grouped)
    m.libraryTask = CreateObject("roSGNode", "LoadItemsTask2")
    m.libraryTask.setFields(request.task)
    ' A library from another signed in server is read from that server, the way its screen reads it
    if isValidAndNotEmpty(library.serverUrl)
        m.libraryTask.setFields({ serverUrl: library.serverUrl, serverUserId: library.userId ?? "", serverAuthToken: library.authToken ?? "", serverId: library.serverId ?? "", serverName: library.serverName ?? "" })
    end if
    request.Delete("task")
    request.key = key
    m.libraryRequest = request
    m.libraryTask.observeField("content", "onLibraryPageLoaded")
    m.libraryTask.control = "RUN"
    return invalid
end function

' What the Quick Access and Immersive copies draw, asked for once while settings is open and
' shared by both, so trying one after the other draws straight away. Invalid until it arrives.
function musicPage(library as object) as dynamic
    key = library.id + "styled"
    page = m.libraryPages[key]
    if isValid(page) or isValid(m.libraryTask) then return page
    m.libraryTask = CreateObject("roSGNode", "SettingsMusicTask")
    m.libraryTask.libraryId = library.id
    m.libraryRequest = { key: key }
    m.libraryTask.observeField("result", "onMusicPageLoaded")
    m.libraryTask.control = "RUN"
    return invalid
end function

sub onMusicPageLoaded()
    task = m.libraryTask
    task.unobserveField("result")
    m.libraryTask = invalid
    m.libraryPages[m.libraryRequest.key] = { music: task.result }
    redraw()
end sub

' Kept the way the real screen keeps a page: blocked titles out, and collections out when the
' library isn't grouping them, since a server can still send them
sub onLibraryPageLoaded()
    task = m.libraryTask
    task.unobserveField("content")
    m.libraryTask = invalid
    loaded = task.content ?? []
    if task.excludeItemTypes <> ""
        kept = []
        for each item in loaded
            if not isStringEqual(item.type ?? "", "BoxSet") then kept.push(item)
        end for
        loaded = kept
    end if
    shown = parentalControls.WithoutBlockedItems(loaded)
    page = m.libraryRequest
    page.items = shown
    page.total = task.totalRecordCount - (loaded.count() - shown.count())
    if page.total < shown.count() then page.total = shown.count()
    m.libraryPages[page.key] = page
    redraw()
end sub

function navbarFields(values as object, avatar as string) as object
    buttons = navbarButtons(values, navbarContext())
    position = values["navbar.position"] ?? "top"
    opacity = Val(values["navbar.opacity"] ?? "0.7")
    color = formatOverlayColor(values["navbar.color"], "0x475569FF")
    ' The sidebar never goes below 60 percent, and a theme paints the top bar in its own surface
    if position = "left" and opacity < 0.6 then opacity = 0.6
    if position <> "left" and themeChrome.IsActive() then color = themeChrome.Surface()
    return {
        position: position,
        buttons: buttons,
        avatar: avatar,
        expanded: values["navbar.alwaysExpanded"] = "true",
        showClock: values["ui.showClock"] <> "false",
        clock24: values["playback.use24hourclock"] = "true",
        barColor: Left(color, 8) + themeChrome.ByteToHex(Int(opacity * 255 + 0.5))
    }
end function

' The bar's buttons in the order the real one builds them, each kept by its switch and the checks
' the real bar makes. The sidebar puts Genres ahead of Favorites.
function navbarButtons(values as object, nav as object) as object
    buttons = [
        { uri: "pkg:/images/icons/home.webp", label: tr("Home") },
        { uri: "pkg:/images/icons/search-light.webp", label: tr("Search") }
    ]
    if values["navbar.show_shuffle"] <> "false" then buttons.push({ uri: "pkg:/images/icons/shuffle.webp", label: tr("Shuffle") })
    favorites = invalid
    genres = invalid
    if values["navbar.show_favorites"] <> "false" then favorites = { uri: "pkg:/images/icons/heart.webp", label: tr("Favorites") }
    if values["navbar.show_genres"] <> "false" then genres = { uri: "pkg:/images/icons/masks.webp", label: tr("Genres") }
    pair = [favorites, genres]
    if values["navbar.position"] = "left" then pair = [genres, favorites]
    for each button in pair
        if isValid(button) then buttons.push(button)
    end for

    kids = nav.kids = true
    libraries = nav.libraries ?? []
    showLiveTv = not kids and values["navbar.show_livetv"] <> "false" and libraryOrder.HasLiveTv(libraries)
    if showLiveTv then buttons.push({ uri: "pkg:/images/icons/livetv.webp", label: tr("Live TV") })
    if not kids and nav.seerr = true and values["navbar.show_seerr"] = "true" then buttons.push({ uri: "pkg:/images/icons/settings/seerr.webp", label: tr("Seerr") })
    if not kids and nav.calendar = true and values["navbar.show_calendar"] <> "false" then buttons.push({ uri: "pkg:/images/icons/calendar.webp", label: tr("Calendar") })

    if not kids and values["navbar.show_libraries"] <> "false"
        if values["navbar.show_libraries_individually"] = "true"
            for each library in libraries
                if not (showLiveTv and isStringEqual(library.collectionType, "livetv")) then buttons.push({ glyph: libraryOrder.Icon(library), label: (library.name ?? "") + (library.serverSuffix ?? "") })
            end for
        else
            buttons.push({ uri: "pkg:/images/icons/library.webp", label: tr("Libraries") })
        end if
    end if

    ' The real bar also waits for a server message, but here that would make the switch look broken
    if values["navbar.show_messages"] = "true" then buttons.push({ uri: "pkg:/images/icons/messages.webp", label: tr("Messages") })
    if not kids and values["navbar.show_friends"] = "true" and nav.social = true then buttons.push({ uri: "pkg:/images/icons/friends.webp", label: tr("Friends") })
    buttons.push({ uri: "pkg:/images/icons/settings.webp", label: tr("Settings") })
    return buttons
end function

' What the real bars check before they add a button
function navbarContext() as object
    userSession = m.global.session
    return {
        kids: kidsMode.Enabled(),
        libraries: libraryOrder.Loaded(),
        seerr: LCase(toString(userSession.user.settings["seerr.enabled"])) = "true",
        social: achievementsModel.SocialAvailable(userSession.achievementsInfo),
        calendar: moonfinPlugin.IsCalendarAvailable()
    }
end function

' The bar only labels a series when something aired lately, so while the banner is on the first
' series stands in with a sample, moved to the front where every style draws it
function withNewReleaseSample(items as object) as object
    for i = 0 to items.count() - 1
        if isStringEqual(items[i].type ?? "", "Series")
            sample = {}
            sample.Append(items[i])
            sample.newRelease = { kind: "newSeason", season: 2 }
            shown = [sample]
            for j = 0 to items.count() - 1
                if j <> i then shown.push(items[j])
            end for
            return shown
        end if
    end for
    return items
end function

' The sample title's own scores. An episode has no critic score.
function sampleItem(withCritic as boolean) as object
    sample = { CommunityRating: 7.8 }
    if withCritic then sample.CriticRating = 91
    return sample
end function

' What the plugin sends for the sample title, every source it knows in the order it sends them
function samplePluginRatings() as object
    return [
        { source: "imdb", value: 7.9 },
        { source: "tmdb", score: 78 },
        { source: "trakt", score: 81 },
        { source: "tomatoes", score: 91 },
        { source: "tomatoes_audience", score: 87 },
        { source: "metacritic", score: 74 },
        { source: "metacriticuser", score: 71 },
        { source: "letterboxd", value: 3.9 },
        { source: "rogerebert", value: 3.5 },
        { source: "myanimelist", value: 8.1 }
    ]
end function

' The scores one surface draws for the sample title, through the rules the real screens follow.
' Home rows ("home") and the media bar ("mediaBar") keep their own settings, the details page
' reads the plugin's. They're all switches and editors, so the saved values are what they draw.
function ratingsFields(scope as string, onItem as object, episode as boolean) as object
    fromPlugin = []
    if episode
        if moonfinPlugin.IsEpisodeRatingsEnabled(scope) and moonfinPlugin.IsRatingSourceEnabled("tmdb", scope) then fromPlugin = moonfinPlugin.BuildDisplayRatings([{ source: "tmdb_episode", value: 7.6 }], scope)
    else if moonfinPlugin.IsRatingsEnabled(scope)
        fromPlugin = moonfinPlugin.BuildDisplayRatings(samplePluginRatings(), scope)
    end if
    return {
        data: ratingsRow.Merge(ratingsRow.ServerEntries(onItem, scope), fromPlugin),
        showNames: moonfinPlugin.RatingsBool(scope, "showRatingNames", false),
        showBadges: moonfinPlugin.RatingsBool(scope, "showRatingBadges", true)
    }
end function

function detailLayout(values as object, style as string) as object
    metadata = []
    for each entry in detailMetadataLayout.Arrange(detailMetadataLayout.DetailMetadata(), values[DETAIL_METADATA_ORDER_SETTING], values[DETAIL_METADATA_HIDDEN_SETTING])
        metadata.push(entry.id)
    end for
    blur = Int(Val(values["ui.backdrop.detailBlurAmount"] ?? "10"))
    if blur < 0 or blur > 25 then blur = 10
    return {
        buttons: detailButtons(values, style),
        metadata: metadata,
        showBackdrop: values["ui.itemdetail.showBackdrop"] <> "false",
        blurAmount: blur,
        technical: values["ui.library.showTechnicalDetails"] <> "false"
    }
end function

' A movie's buttons after Play, in the saved order without the hidden ones, folded behind More the
' way the style and Action Buttons on Screen fold the real row
function detailButtons(values as object, style as string) as object
    offered = [
        { id: "shuffle", icon: "detail_shuffle", label: tr("Shuffle") },
        { id: "trailer", icon: "detail_trailer", label: tr("Trailer") },
        { id: "watched", icon: "detail_watched", label: tr("Unwatched") },
        { id: "favorite", icon: "detail_favorite", label: tr("Favorite") },
        { id: "playlist", icon: "add_to_playlist", label: tr("Add to Playlist") }
    ]
    arranged = buttonLayout.Arrange(offered, values[DETAIL_ORDER_SETTING], values[DETAIL_HIDDEN_SETTING])
    limit = (values[DETAIL_MAX_VISIBLE_SETTING] ?? "0").Trim().ToInt()
    if limit < -1 or limit > 10 then limit = 0

    kept = arranged.Count()
    if style = "nouveau"
        split = buttonLayout.NouveauSplit(arranged.Count(), limit)
        if split.needsOverflow then kept = split.visibleCount
    else
        styleCap = { maxVisible: 0, overflowAsMenu: false, countCapped: false }
        if style = "spotlight" or style = "minimalist" or style = "stage" then styleCap = { maxVisible: 5, overflowAsMenu: true, countCapped: true }
        if style = "premiere" or style = "quickLook" or style = "frost" then styleCap = { maxVisible: 6, overflowAsMenu: true, countCapped: true }
        ' Quick Look's row and Frost's toolbar can't scroll, so they stop at six whatever the limit says
        if (style = "quickLook" or style = "frost") and (limit = -1 or limit > 5) then limit = 0
        ' Play takes a place in the row and counts toward the cap
        split = buttonLayout.CountSplit(arranged.Count() + 1, buttonLayout.ApplyButtonLimit(limit, styleCap))
        if split.needsOverflow then kept = split.visibleCount - 1
    end if
    if kept >= arranged.Count() then return arranged

    shown = []
    for i = 0 to kept - 1
        shown.push(arranged[i])
    end for
    shown.push({ id: "more", icon: "dotDotDot", label: tr("More Actions") })
    return shown
end function

function withoutOverview(items as object) as object
    shown = []
    for each item in items
        copy = {}
        copy.Append(item)
        copy.overview = ""
        shown.push(copy)
    end for
    return shown
end function

sub drawInspector(state as object, pal as object)
    key = FormatJson([state.entry, m.rowOptionsStatus, state.cardColor, state.cardOpacity, pal.accent, pal.onSurface])
    if key = m.inspectorKey then return
    m.inspectorKey = key

    m.inspector.removeChildrenIndex(m.inspector.getChildCount(), 0)
    entry = state.entry
    if not isValid(entry) then return

    card = setupPreviewDraw.Shape(m.inspector, "pkg:/images/settings/card27.9.png", 0, 0, STAGE_WIDTH, INSPECTOR_HEIGHT, state.cardColor)
    card.opacity = state.cardOpacity
    textWidth = STAGE_WIDTH - INSPECTOR_PAD * 2
    muted = playbackOverlay.WithAlpha(pal.onSurface, 153)

    y = 24
    status = entry.status
    if status <> ""
        dotInk = muted
        statusInk = muted
        if entry.shows
            dotInk = pal.accent
            statusInk = pal.onSurface
        end if
        ' A Row Options setting that can't change Home as the rows are set up says what to turn on instead
        if m.rowOptionsStatus <> ""
            status = m.rowOptionsStatus
            dotInk = BLOCKED_INK
            statusInk = BLOCKED_INK
        end if
        setupPreviewDraw.Shape(m.inspector, "pkg:/images/icons/circle.webp", INSPECTOR_PAD, y + 9, 12, 12, dotInk)
        setupPreviewDraw.TextLabel(m.inspector, status, INSPECTOR_PAD + 22, y, 22, statusInk, true)
        y = y + 38
    end if

    title = setupPreviewDraw.TextLabel(m.inspector, entry.title, INSPECTOR_PAD, y, 32, pal.onSurface, true)
    title.width = textWidth
    y = y + 48
    ' A setting's own tile already reads out its description, so it shows where it lives instead
    if isValidAndNotEmpty(entry.path)
        path = setupPreviewDraw.TextLabel(m.inspector, entry.path, INSPECTOR_PAD, y, 22, muted, false)
        path.width = textWidth
    else if entry.description <> ""
        description = setupPreviewDraw.Paragraph(m.inspector, entry.description, INSPECTOR_PAD, y, textWidth, 22, 2, muted)
        ' Left to size itself, the label leaves no room for the second line's spacing
        description.height = 72
    end if

    options = entry.options ?? []
    if options.Count() = 0 or options.Count() > 8 then return
    row = m.inspector.createChild("Group")
    row.translation = [INSPECTOR_PAD, INSPECTOR_HEIGHT - INSPECTOR_PAD - CHIP_HEIGHT]
    row.clippingRect = [0, 0, textWidth, CHIP_HEIGHT]
    chips = []
    widths = []
    for i = 0 to options.Count() - 1
        chip = row.createChild("Group")
        widths.push(drawOption(chip, options[i], i = entry.live, entry.trying and i = entry.saved and i <> entry.live, pal))
        chips.push(chip)
    end for

    shown = optionRange(widths, OPTION_GAP, textWidth, OPTION_MARKER, entry.live)
    markerY = (CHIP_HEIGHT - OPTION_MARKER) / 2
    x = 0
    if shown.firstShown > 0
        setupPreviewDraw.Icon(row, "pkg:/images/icons/dotDotDot.webp", x, markerY, OPTION_MARKER, muted)
        x = OPTION_MARKER + OPTION_GAP
    end if
    for i = 0 to chips.Count() - 1
        chips[i].visible = i >= shown.firstShown and i <= shown.lastShown
        if chips[i].visible
            chips[i].translation = [x, 0]
            x = x + widths[i] + OPTION_GAP
        end if
    end for
    if shown.lastShown < chips.Count() - 1 then setupPreviewDraw.Icon(row, "pkg:/images/icons/dotDotDot.webp", x, markerY, OPTION_MARKER, muted)
end sub

' Which chips the row shows whole when they don't all fit. It runs from the first one, or slides on
' just far enough to hold the one in the preview, and leaves room for dots on each side it cuts.
function optionRange(widths as object, spacing as float, room as float, markerWidth as float, keep as integer) as object
    firstShown = 0
    lastShown = -1
    while lastShown + 1 < widths.Count() and optionsFit(widths, spacing, room, markerWidth, firstShown, lastShown + 1)
        lastShown++
    end while
    if keep > lastShown and keep < widths.Count()
        firstShown = keep
        lastShown = keep
        while firstShown > 0 and optionsFit(widths, spacing, room, markerWidth, firstShown - 1, lastShown)
            firstShown--
        end while
    end if
    return { firstShown: firstShown, lastShown: lastShown }
end function

function optionsFit(widths as object, spacing as float, room as float, markerWidth as float, firstShown as integer, lastShown as integer) as boolean
    total = 0
    for i = firstShown to lastShown
        total = total + widths[i]
        if i > firstShown then total = total + spacing
    end for
    if firstShown > 0 then total = total + markerWidth + spacing
    if lastShown < widths.Count() - 1 then total = total + markerWidth + spacing
    return total <= room
end function

' The one drawn in the preview is filled, and the saved one is outlined in the accent while another
' is tried. Returns the chip's width.
function drawOption(parent as object, text as string, live as boolean, saved as boolean, pal as object) as float
    ink = pal.onSurface
    if live then ink = "0x000000FF"
    label = setupPreviewDraw.TextLabel(parent, text, 0, 0, 22, ink, true)
    textWidth = label.boundingRect().width
    width = textWidth + 36
    tag = invalid
    if saved
        tag = setupPreviewDraw.TextLabel(parent, UCase(tr("Saved")), 0, 0, 16, playbackOverlay.WithAlpha(pal.onSurface, 179), true)
        width = width + tag.boundingRect().width + 10
    end if

    if live
        setupPreviewDraw.Shape(parent, "pkg:/images/livetv/fill20.9.png", 0, 0, width, CHIP_HEIGHT, "0xFFFFFFFF")
    else
        setupPreviewDraw.Shape(parent, "pkg:/images/livetv/fill20.9.png", 0, 0, width, CHIP_HEIGHT, "0xFFFFFF0F")
        ring = "0xFFFFFF24"
        if saved then ring = pal.accent
        setupPreviewDraw.Shape(parent, "pkg:/images/setup/ring20.9.png", 0, 0, width, CHIP_HEIGHT, ring)
    end if
    ' The text goes back on top of the chip
    parent.removeChild(label)
    parent.appendChild(label)
    label.translation = [18, 0]
    label.height = CHIP_HEIGHT
    label.vertAlign = "center"
    if isValid(tag)
        parent.removeChild(tag)
        parent.appendChild(tag)
        tag.translation = [18 + textWidth + 10, 0]
        tag.height = CHIP_HEIGHT
        tag.vertAlign = "center"
    end if
    return width
end function

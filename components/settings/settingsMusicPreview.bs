import "pkg:/components/music/musicScreenHost.bs"

' The Quick Access and Immersive music libraries for the settings preview, laid out the way the
' real screen lays out its first screen and drawn with its own tiles and tabs. Anything that would
' start below the screen isn't built, and nothing here takes the focus.

' The real screen's measurements on its 1920x1080 canvas
const MUSIC_HEADER_TOP = 116
const MUSIC_SIDEBAR_WIDTH = 78
const MUSIC_SECTION_PAD = 28
const MUSIC_SECTION_HEADER = 44
const MUSIC_SECTION_HEADER_GAP = 8
const MUSIC_CARD_SIZE = 168
const MUSIC_CARD_GAP = 20
const MUSIC_SHELF_HEIGHT = 232
const MUSIC_SHELF_GAP = 6
const MUSIC_GRID_GAP = 20
const MUSIC_GRID_CARD_TEXT = 40
const MUSIC_SONG_ROW = 56
const MUSIC_TRACK_ROW = 32
const MUSIC_GENRE_HEIGHT = 96
const MUSIC_GENRE_GAP = 16
const MUSIC_HEADER_BUTTON = 44
const MUSIC_HERO_ART = 300
const MUSIC_HERO_GAP = 40
const MUSIC_HERO_BUTTON = 52
const MUSIC_BUTTON_GAP = 10
const MUSIC_TRACKS_WIDTH = 420
const MUSIC_RAIL_WIDTH = 248
const MUSIC_RAIL_ICON_ROW = 44
const MUSIC_RAIL_PLAYLIST_ROW = 48
const MUSIC_QUICK_INSET = 32
const MUSIC_QUICK_HEIGHT = 64
const MUSIC_QUICK_GAP = 10
const MUSIC_FILTER_HEIGHT = 40
const MUSIC_SCREEN_BOTTOM = 1080

' The page goes under the navigation bar the Home preview draws, since the real screen keeps the
' bar on screen. Until the rows arrive it's the empty page.
sub drawStyledMusic(look as object, page as object)
    m.accent = themeChrome.Accent()
    m.ink = themeChrome.OnBackground()
    m.separator = " " + fontApply.ThemeSeparator() + " "
    content = CreateObject("roSGNode", "Group")
    setupPreviewDraw.Rect(content, 0, 0, 1920, 1080, "#000018")
    rows = page.music
    if isValid(rows)
        inset = 0
        if look.navbar.position = "left" then inset = MUSIC_SIDEBAR_WIDTH
        if look.musicStyle = "quickAccess"
            drawQuickAccess(content, rows, inset, look.name)
        else
            drawImmersive(content, rows, inset, look)
        end if
    end if
    bar = m.top.createChild("SetupNavbarPreview")
    bar.setFields(look.navbar)
    bar.collapsedRail = true
    bar.screen = content
end sub

' The album being listened to over its blurred cover, the categories as tabs, then the newest
' albums, the songs played last and the genres
sub drawImmersive(parent as object, rows as object, inset as integer, look as object)
    left = 48 + inset
    right = 1920 - 48
    featured = rows.featured

    backdrop = invalid
    if isValid(featured) and look.showBackdrops = true then backdrop = musicBackdrop(parent, featured)

    name = addLabel(parent, look.name, left, MUSIC_HEADER_TOP, 24, true)
    name.height = MUSIC_HEADER_BUTTON
    name.vertAlign = "center"
    tabsX = left + name.boundingRect().width + 28
    searchX = right - (MUSIC_HEADER_BUTTON * 2) - 8
    addTile(parent, musicHeaderButton("tune"), right - MUSIC_HEADER_BUTTON, MUSIC_HEADER_TOP)
    addTile(parent, musicHeaderButton("search_rounded"), searchX, MUSIC_HEADER_TOP)

    tabs = [{ id: "overview", label: tr("Overview") }]
    for each category in musicCategoryList()
        tabs.push({ id: category.id, label: category.label })
    end for
    tabBar = parent.createChild("DetailTabBar")
    tabBar.expanded = false
    tabBar.segmentHeight = 34
    tabBar.segmentPadX = 15
    tabBar.barPad = 5
    tabBar.textSize = 13
    tabBar.maxWidth = searchX - 16 - tabsX
    tabBar.translation = [tabsX, MUSIC_HEADER_TOP]
    tabBar.selectedIndex = 0
    tabBar.tabs = tabs

    y = MUSIC_HEADER_TOP + MUSIC_HEADER_BUTTON
    if isValid(featured) then y = musicHero(parent, rows, y + 32, left, right) + 40
    if isValid(backdrop)
        backdrop.image.height = y
        backdrop.fade.height = y
    end if

    y = musicCardGrid(parent, rows.latest, Substitute(tr("Latest {0}"), look.name), y, left, right)
    y = musicSongList(parent, rows.lastPlayed, tr("Last Played"), 5, y, left, 1920 - left)
    musicGenres(parent, rows.genres, y, left, right)
end sub

function musicHeaderButton(glyph as string) as object
    return { kind: "button", height: MUSIC_HEADER_BUTTON, glyph: glyph, fill: "#000000", fillOpacity: 0.35, ink: "#FFFFFF" }
end function

function musicBackdrop(parent as object, featured as object) as dynamic
    url = artOf(featured, 480, { blur: 20 })
    if url = "" then return invalid
    image = parent.createChild("Poster")
    image.loadDisplayMode = "scaleToFill"
    image.width = 1920
    image.loadWidth = 480
    image.loadHeight = 480
    image.opacity = 0.65
    image.uri = url
    fade = parent.createChild("Poster")
    fade.uri = "pkg:/images/seerr_gradient.webp"
    fade.loadDisplayMode = "scaleToFill"
    fade.blendColor = "#00009D"
    fade.width = 1920
    return { image: image, fade: fade }
end function

' The cover, its title over Play, Shuffle and Favorite, and its songs beside it. Hands back the
' bottom of the cover.
function musicHero(parent as object, rows as object, y as integer, left as integer, right as integer) as integer
    featured = rows.featured
    album = rows.album
    tracks = rows.tracks ?? []
    source = featured
    if isValid(album) then source = album
    bottom = y + MUSIC_HERO_ART
    addTile(parent, { kind: "card", width: MUSIC_HERO_ART, image: artOf(featured, MUSIC_HERO_ART), glyph: "album" }, left, y)

    textX = left + MUSIC_HERO_ART + MUSIC_HERO_GAP
    textRight = right
    if tracks.count() > 0 then textRight = right - MUSIC_TRACKS_WIDTH - 40
    textWidth = textRight - textX
    buttonsY = bottom - MUSIC_HERO_BUTTON
    play = addButton(parent, musicHeroButton("play_arrow_rounded", tr("Play"), true))
    shuffle = addButton(parent, musicHeroButton("shuffle_rounded", tr("Shuffle"), false))
    play.node.translation = [textX, buttonsY]
    shuffle.node.translation = [textX + play.width + MUSIC_BUTTON_GAP, buttonsY]
    if isValid(album)
        favorite = musicHeroButton("favorite_border", "", false)
        if chainLookupReturn(album, "UserData.IsFavorite", false) = true
            favorite.glyph = "favorite"
            favorite.iconInk = m.accent
        end if
        addTile(parent, favorite, textX + play.width + shuffle.width + (MUSIC_BUTTON_GAP * 2), buttonsY)
    end if

    meta = addLabel(parent, musicHeroMeta(source, tracks.count()), textX, 0, 16, false)
    meta.color = themeChrome.WithAlpha(m.ink, "CC")
    meta.width = textWidth
    meta.maxLines = 1
    metaY = buttonsY - 24 - meta.boundingRect().height
    meta.translation = [textX, metaY]

    heading = featured.Name ?? ""
    if isValid(album)
        heading = album.Name ?? ""
    else if isStringEqual(featured.Type, "Audio")
        heading = featured.Album ?? featured.Name ?? ""
    end if
    title = addLabel(parent, heading, textX, 0, 52, true)
    title.width = textWidth
    title.wrap = true
    title.maxLines = 2
    titleY = metaY - 8 - title.boundingRect().height
    title.translation = [textX, titleY]

    eyebrowText = tr("Recently Added")
    if rows.lastPlayed.count() > 0 then eyebrowText = tr("Jump Back In")
    eyebrow = addLabel(parent, UCase(eyebrowText), textX, 0, 13, true)
    eyebrow.color = m.accent
    eyebrow.translation = [textX, titleY - 8 - eyebrow.boundingRect().height]

    if tracks.count() > 0 then musicAlbumTracks(parent, featured, tracks, right - MUSIC_TRACKS_WIDTH, bottom)
    return bottom
end function

function musicHeroButton(glyph as string, label as string, primary as boolean) as object
    spec = { kind: "button", height: MUSIC_HERO_BUTTON, glyph: glyph, title: label, glyphSize: 22, textSize: 16, padX: 24, fill: "#FFFFFF", fillOpacity: 0.14, ink: m.ink, pressFill: true }
    if primary
        spec.fill = m.accent
        spec.fillOpacity = 1.0
        spec.ink = themeChrome.OnAccent()
    end if
    return spec
end function

function musicHeroMeta(source as object, trackCount as integer) as string
    parts = []
    artist = subtitleOf(source)
    if artist <> "" then parts.push(artist)
    if isValid(source.ProductionYear) then parts.push(source.ProductionYear.toStr())
    if trackCount = 1
        parts.push(tr("1 track"))
    else if trackCount > 1
        parts.push(tr("{count} tracks").replace("{count}", trackCount.toStr()))
    end if
    return parts.join(m.separator)
end function

' The album's first songs in a panel on the bottom of the cover, the one played last picked out
sub musicAlbumTracks(parent as object, featured as object, tracks as object, x as integer, bottom as integer)
    shown = tracks.count()
    if shown > 6 then shown = 6
    panelHeight = 12 + 26 + (shown * MUSIC_TRACK_ROW) + 12
    y = bottom - panelHeight
    panel = parent.createChild("Poster")
    panel.uri = "pkg:/images/details/surface17.9.png"
    panel.blendColor = "#000000"
    panel.opacity = 0.42
    panel.width = MUSIC_TRACKS_WIDTH
    panel.height = panelHeight
    panel.translation = [x, y]
    heading = addLabel(parent, UCase(tr("From This Album")), x + 20, y + 16, 12, true)
    heading.color = themeChrome.WithAlpha(m.ink, "B3")
    rowY = y + 12 + 26
    for i = 0 to shown - 1
        track = tracks[i]
        number = track.IndexNumber ?? i + 1
        tile = addTile(parent, { kind: "row", width: MUSIC_TRACKS_WIDTH - 24, height: MUSIC_TRACK_ROW, title: track.Name ?? "", leading: number.toStr(), trailing: runtimeOf(track) }, x + 12, rowY + (i * MUSIC_TRACK_ROW))
        tile.highlighted = isStringEqual(track.Id, featured.Id)
    end for
end sub

' A section's heading 28 below the one above, with See All at the far end when it has one. Hands
' back where its cells start.
function musicHeading(parent as object, title as string, y as integer, left as integer, right as integer, seeAll as boolean) as integer
    y += MUSIC_SECTION_PAD
    label = addLabel(parent, title, left, y, 22, true)
    label.height = MUSIC_SECTION_HEADER
    label.vertAlign = "center"
    label.width = right - left
    label.maxLines = 1
    if seeAll
        button = addButton(parent, { kind: "button", height: 33, title: tr("See All"), textSize: 13, padX: 12, bold: false, ink: themeChrome.WithAlpha(m.ink, "B3") })
        button.node.translation = [right - button.width, y + ((MUSIC_SECTION_HEADER - 33) / 2)]
        label.width = right - button.width - 16 - left
    end if
    return y + MUSIC_SECTION_HEADER + MUSIC_SECTION_HEADER_GAP
end function

' Two rows of the newest albums, as many across as fit at 200 or so each
function musicCardGrid(parent as object, items as object, title as string, y as integer, left as integer, right as integer) as integer
    if items.count() = 0 or y + MUSIC_SECTION_PAD >= MUSIC_SCREEN_BOTTOM then return y
    columns = Int((right - left + MUSIC_GRID_GAP) / 200)
    if columns < 3 then columns = 3
    if columns > 8 then columns = 8
    cardWidth = Int(((right - left) - ((columns - 1) * MUSIC_GRID_GAP)) / columns)
    rowHeight = cardWidth + MUSIC_GRID_CARD_TEXT + MUSIC_GRID_GAP
    y = musicHeading(parent, title, y, left, right, false)
    shown = items.count()
    if shown > columns * 2 then shown = columns * 2
    for i = 0 to shown - 1
        top = y + ((i \ columns) * rowHeight)
        if top < MUSIC_SCREEN_BOTTOM
            item = items[i]
            addTile(parent, { kind: "card", width: cardWidth, title: item.Name ?? "", subtitle: subtitleOf(item), image: artOf(item, cardWidth), glyph: "album" }, left + ((i mod columns) * (cardWidth + MUSIC_GRID_GAP)), top)
        end if
    end for
    return y + (((shown - 1) \ columns) * rowHeight) + cardWidth + MUSIC_GRID_CARD_TEXT
end function

' Songs as rows: cover, title over artist and album, and length
function musicSongList(parent as object, items as object, title as string, maxRows as integer, y as integer, left as integer, right as integer) as integer
    if items.count() = 0 or y + MUSIC_SECTION_PAD >= MUSIC_SCREEN_BOTTOM then return y
    y = musicHeading(parent, title, y, left, right, false)
    shown = items.count()
    if shown > maxRows then shown = maxRows
    for i = 0 to shown - 1
        if y + (i * MUSIC_SONG_ROW) < MUSIC_SCREEN_BOTTOM
            item = items[i]
            addTile(parent, { kind: "row", width: right - left, height: MUSIC_SONG_ROW, title: item.Name ?? "", subtitle: songSubtitle(item), trailing: runtimeOf(item), image: artOf(item, 44), glyph: "music_note" }, left, y + (i * MUSIC_SONG_ROW))
        end if
    end for
    return y + (shown * MUSIC_SONG_ROW)
end function

' One row of genre tiles in colors of their own, with See All for the rest
sub musicGenres(parent as object, genres as object, y as integer, left as integer, right as integer)
    if genres.count() = 0 or y + MUSIC_SECTION_PAD >= MUSIC_SCREEN_BOTTOM then return
    columns = Int((right - left + MUSIC_GENRE_GAP) / 166)
    if columns < 2 then columns = 2
    if columns > 8 then columns = 8
    tileWidth = Int(((right - left) - ((columns - 1) * MUSIC_GENRE_GAP)) / columns)
    colors = ["#7A2E22", "#3B2D5C", "#6B2F4A", "#4D3B72", "#B4472F", "#1F3A5F", "#8A5A1E", "#14505C"]
    y = musicHeading(parent, tr("Browse By Genre"), y, left, right, true)
    shown = genres.count()
    if shown > columns then shown = columns
    for i = 0 to shown - 1
        addTile(parent, { kind: "genre", width: tileWidth, height: MUSIC_GENRE_HEIGHT, title: genres[i].Name ?? "", color: colors[i mod colors.count()] }, left + (i * (tileWidth + MUSIC_GENRE_GAP)), y)
    end for
end sub

' Jump Back In over the grid of quick tiles, the newest albums and the songs played last, beside
' the rail of categories and playlists
sub drawQuickAccess(parent as object, rows as object, inset as integer, libraryName as string)
    left = inset + MUSIC_RAIL_WIDTH + MUSIC_QUICK_INSET
    right = 1920 - MUSIC_QUICK_INSET
    quick = musicQuickItems(rows)

    headerText = libraryName
    if quick.count() > 0 then headerText = tr("Jump Back In")
    sortButton = addButton(parent, { kind: "button", height: MUSIC_FILTER_HEIGHT, glyph: "tune", title: tr("Sort & Filter"), glyphSize: 18, textSize: 14, padX: 16, fill: "#FFFFFF", fillOpacity: 0.08 })
    sortButton.node.translation = [right - sortButton.width, MUSIC_HEADER_TOP]
    title = addLabel(parent, headerText, left, MUSIC_HEADER_TOP, 26, true)
    title.width = right - sortButton.width - 16 - left
    title.height = MUSIC_FILTER_HEIGHT
    title.vertAlign = "center"
    title.maxLines = 1

    y = MUSIC_HEADER_TOP + MUSIC_FILTER_HEIGHT
    if quick.count() > 0
        y += 16
        columns = Int((right - left) / 240)
        if columns < 2 then columns = 2
        if columns > 4 then columns = 4
        tileWidth = Int(((right - left) - ((columns - 1) * MUSIC_QUICK_GAP)) / columns)
        for i = 0 to quick.count() - 1
            entry = quick[i]
            addTile(parent, { kind: "quick", width: tileWidth, height: MUSIC_QUICK_HEIGHT, title: entry.title, image: entry.image, glyph: "album" }, left + ((i mod columns) * (tileWidth + MUSIC_QUICK_GAP)), y + ((i \ columns) * (MUSIC_QUICK_HEIGHT + MUSIC_QUICK_GAP)))
        end for
        y += ((((quick.count() - 1) \ columns) + 1) * (MUSIC_QUICK_HEIGHT + MUSIC_QUICK_GAP)) - MUSIC_QUICK_GAP
    end if

    y = musicShelf(parent, rows.latest, Substitute(tr("Latest {0}"), libraryName), y, left, inset + MUSIC_RAIL_WIDTH)
    musicSongList(parent, rows.lastPlayed, tr("Last Played"), 6, y, left, right)

    railBg = setupPreviewDraw.Rect(parent, inset, 0, MUSIC_RAIL_WIDTH, 1080, "#FFFFFF")
    railBg.opacity = 0.03
    musicRail(parent, rows.playlists, inset + 12, libraryName)
end sub

' The albums of the songs played last, each once, then the playlists, eight at most
function musicQuickItems(rows as object) as object
    seen = {}
    entries = []
    for each track in rows.lastPlayed
        albumId = track.AlbumId ?? ""
        key = albumId
        if key = "" then key = track.Id
        if not seen.doesExist(key)
            seen[key] = true
            entryTitle = track.Name ?? ""
            if albumId <> "" then entryTitle = track.Album ?? track.Name ?? ""
            entries.push({ title: entryTitle, image: artOf(track, MUSIC_QUICK_HEIGHT) })
        end if
    end for
    for each playlist in rows.playlists
        entries.push({ title: playlist.Name ?? "", image: artOf(playlist, MUSIC_QUICK_HEIGHT) })
    end for
    while entries.count() > 8
        entries.pop()
    end while
    return entries
end function

' A row of the newest albums from the left edge of the page, as many as reach the screen's edge
function musicShelf(parent as object, items as object, title as string, y as integer, left as integer, clipLeft as integer) as integer
    if items.count() = 0 or y + MUSIC_SECTION_PAD >= MUSIC_SCREEN_BOTTOM then return y
    y = musicHeading(parent, title, y, left, 1920 - 12, false) - MUSIC_SECTION_HEADER_GAP + MUSIC_SHELF_GAP
    clip = parent.createChild("Group")
    clip.translation = [left, y]
    clip.clippingRect = [clipLeft - left, -30, 1920 - clipLeft, MUSIC_SHELF_HEIGHT + 60]
    for i = 0 to items.count() - 1
        x = i * (MUSIC_CARD_SIZE + MUSIC_CARD_GAP)
        if left + x < 1920
            item = items[i]
            addTile(clip, { kind: "card", width: MUSIC_CARD_SIZE, title: item.Name ?? "", subtitle: subtitleOf(item), image: artOf(item, MUSIC_CARD_SIZE), round: false, glyph: "album" }, x, 5)
        end if
    end for
    return y + MUSIC_SHELF_HEIGHT
end function

' The library's name, Search, Overview and the categories, then the music playlists under a
' heading of their own, as many as reach the bottom of the screen
sub musicRail(parent as object, playlists as object, x as integer, libraryName as string)
    itemWidth = MUSIC_RAIL_WIDTH - 24
    name = addLabel(parent, libraryName, x + 12, MUSIC_HEADER_TOP, 24, true)
    name.width = itemWidth - 24
    name.maxLines = 1
    y = MUSIC_HEADER_TOP + name.boundingRect().height + 12
    entries = [
        { title: tr("Search Music"), glyph: "search_rounded" },
        { title: tr("Overview"), glyph: "space_dashboard_outlined", selected: true }
    ]
    for each category in musicCategoryList()
        entries.push({ title: category.label, glyph: category.glyph })
    end for
    for each entry in entries
        addTile(parent, { kind: "rail", width: itemWidth, height: MUSIC_RAIL_ICON_ROW, title: entry.title, glyph: entry.glyph, selected: entry.selected }, x, y)
        y += MUSIC_RAIL_ICON_ROW
    end for

    if playlists.count() = 0 then return
    heading = addLabel(parent, UCase(tr("Playlists")), x + 12, y + 18, 12, true)
    heading.color = themeChrome.WithAlpha(m.ink, "9E")
    y += 18 + heading.boundingRect().height + 8
    for each playlist in playlists
        if y >= MUSIC_SCREEN_BOTTOM then return
        addTile(parent, { kind: "rail", art: true, width: itemWidth, height: MUSIC_RAIL_PLAYLIST_ROW, title: playlist.Name ?? "", image: artOf(playlist, 32), glyph: "queue_music" }, x, y)
        y += MUSIC_RAIL_PLAYLIST_ROW
    end for
end sub

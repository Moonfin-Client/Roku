import "pkg:/components/settings/settingsRows.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/fontRegistry.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seasonalEffects.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/settingsMetrics.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/themeRegistry.bs"

' What settings rows paint with, built once per open and shared by reference, so a row never
' copies the session to find a colour. A clean screen keeps the system face for its title,
' headings and value chips, and any other screen takes the theme's face for those.
function BuildSettingsStyle(clean as boolean) as object
    themeId = get_user_setting("ui.theme.customThemeId")
    if not isValidAndNotEmpty(themeId) then themeId = "moonfin"
    tokens = settingsThemeTokens(themeId)

    accent = settingsArgb(themeChrome.Accent(), "#FF00A4DC")
    onSurface = settingsArgb(tokens.onSurface, "#FFFFFFFF")
    surface = settingsArgb(tokens.surface, "#FF1A1A1A")
    buttonFocused = settingsArgb(tokens.buttonFocused, "#FFFFFFFF")
    ink = settingsInkOn(buttonFocused)

    pixel = themeId = "8bit_hero"
    neon = themeId = "neon_pulse"
    scale = 1.0
    if pixel then scale = 0.6
    lowTier = seasonalEffects.DeviceTier() = "low"

    palette = {
        clean: clean,
        neon: neon,
        lowTier: lowTier,
        scale: scale,

        background: settingsColor(settingsArgb(tokens.background, "#FF101010"), -1),
        title: settingsColor(onSurface, -1),
        header: settingsColor(accent, -1),
        text: settingsColor(onSurface, -1),
        textSoft: settingsColor(onSurface, 0.7),
        glyph: settingsColor(onSurface, 0.78),
        hintOff: settingsColor(onSurface, 0.38),
        lock: settingsColor(onSurface, 0.6),
        tick: settingsColor(onSurface, 0.38),
        inkStrong: settingsColor(ink, 0.87),
        inkSoft: settingsColor(ink, 0.54),
        lockFocus: settingsColor(ink, 0.32),
        bubbleText: settingsColor(accent, -1),
        plainTitle: "0xE6E0E9FF",
        plainCaption: "0xCAC4D0FF",
        checkOn: settingsColor(accent, -1),
        scrolledTint: settingsColor(accent, 0.08),
        error: "0xFF9F9FFF",

        card: settingsTint(surface, 0.82),
        cardFocus: settingsTint(buttonFocused, -1),
        stroke: settingsTint(onSurface, 0.16),
        strokeFocus: settingsTint(accent, 0.72),
        glow: settingsTint(accent, 0.22),
        tile: settingsTint(accent, 0.14),
        tileFocus: settingsTint(accent, 0.22),
        tileStroke: settingsTint(accent, 0.42),
        tileStrokeFocus: settingsTint(accent, 0.64),
        bubble: settingsTint(accent, 0.1),
        bubbleFocus: settingsTint(ink, 0.12),
        bubbleStroke: settingsTint(accent, 0.35),
        bubbleStrokeFocus: settingsTint(ink, 0.35),
        trackOn: settingsTint(accent, -1),
        trackOff: settingsTint(settingsArgb(tokens.surfaceVariant, "#FF252525"), -1),
        outline: settingsTint(onSurface, -1),
        thumbOn: settingsTint(settingsArgb(tokens.onAccent, "#FFFFFFFF"), -1),
        thumbOff: settingsTint(onSurface, -1),
        plainFocus: settingsTint(accent, 0.18),
        sliderTrack: settingsTint(settingsArgb(tokens.rangeTrack, "#FF404040"), -1),
        sliderProgress: settingsTint(settingsArgb(tokens.rangeProgress, "#FF00A4DC"), -1),
        sliderThumb: settingsTint(settingsArgb(tokens.rangeThumb, "#FF00A4DC"), -1),
        dialog: settingsTint(surface, -1),
        panel: settingsTint(settingsArgb(tokens.background, "#FF101010"), -1),
        shadow: invalid
    }

    ' A theme that draws its cards with a border of its own keeps it, a little softer
    if neon
        pink = settingsArgb("#FF2E92", "")
        palette.stroke = settingsTint(pink, 0.4 * 0.55)
        palette.glow = settingsTint(pink, 0.6)
    else if pixel
        palette.stroke = settingsTint(settingsArgb("#566C86", ""), 0.55)
        palette.glow = invalid
        palette.shadow = settingsTint(settingsArgb("#FFCD75", ""), 0.6)
    end if
    if lowTier then palette.glow = invalid

    palette.images = settingsImages(pixel)
    palette.fonts = settingsFonts(clean, scale)
    ' Wrapped lines sit closer together than a Roku label sets its own
    fonts = palette.fonts
    palette.spacing = {
        title: lineSpacingFor(fonts.title, settingsMetrics.LineHeight(14, scale)),
        caption: lineSpacingFor(fonts.caption, settingsMetrics.LineHeight(12, scale)),
        descSmall: lineSpacingFor(fonts.descSmall, settingsMetrics.LineHeight(11, scale)),
        hint: lineSpacingFor(fonts.hint, settingsMetrics.Px(16)),
        lead: lineSpacingFor(fonts.lead, settingsMetrics.Px(20)),
        bubble: lineSpacingFor(fonts.bubble, settingsMetrics.Px(14.67)),
        plainCaption: lineSpacingFor(fonts.caption, settingsMetrics.Px(16))
    }

    style = CreateObject("roSGNode", "SettingsStyle")
    style.palette = palette
    return style
end function

' The colours a theme names, read from its own file where it ships with the app, since the copy
' kept in settings has lost each colour's transparency
function settingsThemeTokens(themeId as string) as object
    if themeRegistry.IsBuiltIn(themeId)
        raw = ReadAsciiFile(`pkg:/settings/themes/${themeId}.json`)
        parsed = invalid
        if isValidAndNotEmpty(raw) then parsed = ParseJson(raw)
        if isValid(parsed) and isValid(parsed.colors) then return parsed.colors
    end if

    stored = {}
    for each token in ["surfaceVariant", "buttonFocused", "onAccent", "rangeProgress", "rangeThumb"]
        stored[token] = themeChrome.Token(token, "")
    end for
    stored.background = chainLookupReturn(m.global.session, "user.settings.colorBackground", "")
    stored.surface = chainLookupReturn(m.global.session, "user.settings.colorDialogBackground", "")
    stored.onSurface = chainLookupReturn(m.global.session, "user.settings.colorDialogText", "")
    stored.rangeTrack = chainLookupReturn(m.global.session, "user.settings.colorHomeRowItemProgressBackground", "")
    return stored
end function

' A colour written #AARRGGBB the way themes write it, or #RRGGBB and 0xRRGGBBAA the way the
' settings keep them, as its parts
function settingsArgb(value as dynamic, fallback as string) as object
    hex = ""
    if isValidAndNotEmpty(value) and (type(value) = "String" or type(value) = "roString") then hex = value.Trim()
    if hex.left(2) = "0x" or hex.left(2) = "0X"
        ' Roku order, alpha last
        hex = hex.mid(2)
        if hex.len() = 8 then hex = hex.mid(6, 2) + hex.mid(0, 6)
    else if hex.left(1) = "#"
        hex = hex.mid(1)
    end if
    if hex.len() = 6 then hex = "FF" + hex
    if hex.len() <> 8
        if fallback = "" then return { a: 255, r: 255, g: 255, b: 255 }
        return settingsArgb(fallback, "")
    end if
    return { a: Val(hex.mid(0, 2), 16), r: Val(hex.mid(2, 2), 16), g: Val(hex.mid(4, 2), 16), b: Val(hex.mid(6, 2), 16) }
end function

' A Label colour. A strength of -1 keeps the colour's own.
function settingsColor(parts as object, strength as float) as string
    alpha = parts.a
    if strength >= 0 then alpha = Int(255 * strength + 0.5)
    return "0x" + themeChrome.ByteToHex(parts.r) + themeChrome.ByteToHex(parts.g) + themeChrome.ByteToHex(parts.b) + themeChrome.ByteToHex(alpha)
end function

' A Poster tint, the colour and an opacity, since the images are white shapes
function settingsTint(parts as object, strength as float) as object
    alpha = parts.a / 255.0
    if strength >= 0 then alpha = strength
    return { color: "0x" + themeChrome.ByteToHex(parts.r) + themeChrome.ByteToHex(parts.g) + themeChrome.ByteToHex(parts.b) + "FF", opacity: alpha }
end function

' Black or white, whichever reads better against a fill
function settingsInkOn(parts as object) as object
    luminance = themeChrome.Luminance(parts)
    if (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) then return { a: 255, r: 0, g: 0, b: 0 }
    return { a: 255, r: 255, g: 255, b: 255 }
end function

' The card shapes, square under the pixel theme
function settingsImages(square as boolean) as object
    if square
        return {
            card: "pkg:/images/settings/square.9.png",
            cardStroke: "pkg:/images/settings/square3s.9.png",
            tile: "pkg:/images/settings/square.9.png",
            tileStroke: "pkg:/images/settings/square3s.9.png",
            bubble: "pkg:/images/settings/square.9.png",
            bubbleStroke: "pkg:/images/settings/square3s.9.png",
            glow: "pkg:/images/settings/glow.9.png",
            plain: "pkg:/images/settings/square.9.png"
        }
    end if
    return {
        card: "pkg:/images/settings/card27.9.png",
        cardStroke: "pkg:/images/settings/card27s.9.png",
        tile: "pkg:/images/settings/tile23.9.png",
        tileStroke: "pkg:/images/settings/tile23s.9.png",
        bubble: "pkg:/images/settings/bubble20.9.png",
        bubbleStroke: "pkg:/images/settings/bubble20s.9.png",
        glow: "pkg:/images/settings/glow.9.png",
        plain: "pkg:/images/settings/square.9.png"
    }
end function

' Row text is always the system face. The title, headings and value chips take the theme's
' face on a screen that isn't clean.
function settingsFonts(clean as boolean, scale as float) as object
    sizes = settingsMetrics.FontSizes(scale)
    fonts = {
        title: settingsFont("font:BoldSystemFontFile", sizes.title),
        caption: settingsFont("font:SystemFontFile", sizes.caption),
        descSmall: settingsFont("font:SystemFontFile", sizes.descSmall),
        bubble: settingsFont("font:BoldSystemFontFile", sizes.bubble),
        header: settingsFont("font:BoldSystemFontFile", sizes.header),
        appTitle: settingsFont("font:SystemFontFile", sizes.appTitle),
        hint: settingsFont("font:SystemFontFile", sizes.hint),
        lead: settingsFont("font:SystemFontFile", sizes.lead),
        dialogTitle: settingsFont("font:BoldSystemFontFile", sizes.dialogTitle),
        iconTile: settingsFont(settingsGlyphs.FONT_URI, Int(settingsMetrics.Px(22) + 0.5)),
        iconTrailing: settingsFont(settingsGlyphs.FONT_URI, Int(settingsMetrics.Px(20) + 0.5)),
        iconCheck: settingsFont(settingsGlyphs.FONT_URI, Int(settingsMetrics.Px(24) + 0.5)),
        iconCaret: settingsFont(settingsGlyphs.FONT_URI, Int(settingsMetrics.Px(18) + 0.5))
    }

    family = get_user_setting("ui.theme.fontFamily")
    if not clean and fontRegistry.HasFamily(family)
        ' The registry shrinks a face to sit where the system one would, so it's handed the size
        ' the system face would have had
        fonts.appTitle = fontRegistry.GetFont(family, sizes.appTitle)
        fonts.header = fontRegistry.GetFont(family, sizes.header)
        fonts.bubble = fontRegistry.GetFont(family, sizes.bubble)
    end if
    return fonts
end function

function settingsFont(uri as string, size as integer) as object
    key = uri + ":" + size.ToStr()
    if not isValid(m.settingsFontCache) then m.settingsFontCache = {}
    font = m.settingsFontCache[key]
    if isValid(font) then return font

    font = CreateObject("roSGNode", "Font")
    font.uri = uri
    font.size = size
    m.settingsFontCache[key] = font
    return font
end function

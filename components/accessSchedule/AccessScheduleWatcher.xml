<?xml version="1.0" encoding="utf-8"?>
<!-- Watches the signed in user's access schedule and says when it closes. Jellyfin turns a user away
     outside their schedule, so nearly every request fails with it. The schedule is read from the
     server, so it is looked at again just before an opening or closing and every minute besides,
     which picks up a change made on the server. The device clock is what it is compared with. -->
<component name="AccessScheduleWatcher" extends="Node">
    <interface>
        <!-- The user to watch, or an empty string to stop -->
        <field id="userId" type="string" onChange="onUserChange" />
        <field id="blocked" type="boolean" value="false" />
        <!-- When the user is next let in, as { seconds, dayOffset, secondOfDay, day }, while blocked -->
        <field id="next" type="assocarray" />
        <!-- Told only when the answer changes -->
        <field id="accessStatus" type="boolean" alwaysNotify="true" />
        <function name="recheck" />
    </interface>
    <children>
        <Timer id="timer" repeat="false" />
    </children>
</component>

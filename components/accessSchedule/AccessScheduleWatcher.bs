import "pkg:/source/utils/accessSchedule.bs"
import "pkg:/source/utils/misc.bs"

' How long to wait between looks when no opening or closing is nearer, for a user with a schedule
' and for one without, and before asking again after a look that failed
const POLL_SECONDS = 60
const IDLE_SECONDS = 900
const RETRY_SECONDS = 15
' The least time between looks prompted by the server turning a request away, which can come in
' bursts
const REFUSAL_SECONDS = 5

sub init()
    m.timer = m.top.findNode("timer")
    m.timer.observeField("fire", "onTimer")
    m.entries = []
    m.exempt = false
    m.windowUnsupported = false
    ' When the allowed window the plugin last reported closes, in m.clock milliseconds
    m.windowCloses = invalid
    m.task = invalid
    m.lookAgain = false
    m.lastRefusalLook = 0
    m.clock = CreateObject("roTimespan")
    m.top.blocked = false

    if m.global.hasField("accessRefused") then m.global.observeField("accessRefused", "onRefused")
end sub

sub onUserChange()
    m.timer.control = "stop"
    ' A look still under way for the previous user must not answer for the next
    cancelTask()
    m.entries = []
    m.exempt = false
    m.windowUnsupported = false
    m.windowCloses = invalid
    m.lookAgain = false
    m.lastRefusalLook = 0
    setBlocked(false, invalid)
    if m.top.userId <> "" then look()
end sub

sub recheck()
    if m.top.userId <> "" then look()
end sub

sub onRefused()
    ' While blocked every request is refused, the server check included
    if m.top.userId = "" or m.top.blocked then return
    now = m.clock.TotalMilliseconds()
    if m.lastRefusalLook <> 0 and now - m.lastRefusalLook < REFUSAL_SECONDS * 1000 then return
    m.lastRefusalLook = now
    look()
end sub

sub onTimer()
    look()
end sub

sub cancelTask()
    if m.task <> invalid
        m.task.unobserveField("result")
        m.task.control = "stop"
        m.task = invalid
    end if
end sub

' Reads the schedule again. One look at a time: a request that arrives while one is under way
' asks for another when it ends.
sub look()
    m.timer.control = "stop"
    if m.task <> invalid
        m.lookAgain = true
        return
    end if
    ' The plugin's durations count from about now, when it's asked
    m.lookStarted = m.clock.TotalMilliseconds()
    m.task = CreateObject("roSGNode", "AccessScheduleTask")
    m.task.userId = m.top.userId
    m.task.askWindow = not m.windowUnsupported
    m.task.observeField("result", "onResult")
    m.task.control = "run"
end sub

sub onResult(event as object)
    result = event.getData()
    m.task.unobserveField("result")
    m.task = invalid

    ' A plugin that can't answer the window won't start to for this user
    flag = result.windowUnsupported
    if (type(flag) = "roBoolean" or type(flag) = "Boolean") and flag then m.windowUnsupported = true

    if result.ok and result.window <> invalid
        applyWindow(result.window, m.clock.TotalMilliseconds() - m.lookStarted)
    else if result.ok
        m.entries = result.entries
        m.exempt = result.exempt
        apply(result.refused)
    else
        keepLastAnswer()
    end if

    if m.lookAgain
        m.lookAgain = false
        look()
    end if
end sub

sub apply(refused as dynamic)
    ' An answer from Users/Me that lets the user in says nothing of when the window closes, so the
    ' close the plugin reported still holds for looks with no answer
    if (type(refused) = "roBoolean" or type(refused) = "Boolean") and refused then m.windowCloses = invalid
    now = CreateObject("roDateTime")
    now.ToLocalTime()
    day = now.GetDayOfWeek()
    secondOfDay = now.GetHours() * 3600 + now.GetMinutes() * 60 + now.GetSeconds()

    status = accessSchedule.Status(m.entries, refused, day, secondOfDay)
    if m.exempt or not status.blocked
        setBlocked(false, invalid)
    else
        setBlocked(true, status.next)
    end if

    ' An administrator has no schedule to enforce, so only a refused request looks again
    if m.exempt then return
    delay = POLL_SECONDS
    if m.entries.Count() = 0 then delay = IDLE_SECONDS
    boundary = accessSchedule.SecondsToBoundary(m.entries, day, secondOfDay)
    if boundary <> invalid and boundary < delay then delay = boundary
    ' A close the plugin reported is a moment the answer can change too
    if m.windowCloses <> invalid
        closes = (m.windowCloses - m.clock.TotalMilliseconds() + 999) \ 1000
        if closes < delay then delay = closes
    end if
    startTimer(delay)
end sub

' The plugin's answer alone decides and times the next look
' The plugin worked its answer out somewhere in the elapsedMs the look took. The next look counts
' from the start of it, so it can only come early, and the opening from halfway through, which is out
' by at most half the time the answer took
sub applyWindow(window as object, elapsedMs as integer)
    m.windowCloses = invalid
    if window.allowed
        setBlocked(false, invalid)
        remaining = accessSchedule.SecondsLeft(window.untilClose, elapsedMs)
        ' Counted from now, so a look with no answer can't end it early
        if window.untilClose <> invalid then m.windowCloses = m.clock.TotalMilliseconds() + window.untilClose * 1000
    else
        remaining = accessSchedule.SecondsLeft(window.untilOpen, elapsedMs)
        setBlocked(true, openingIn(window.untilOpen, elapsedMs))
    end if

    ' Allowed with nothing to close is a user with no schedule, or one open all week
    delay = POLL_SECONDS
    if window.allowed and window.untilClose = invalid then delay = IDLE_SECONDS
    if remaining <> invalid and remaining < delay then delay = remaining
    startTimer(delay)
end sub

' The opening the plugin says is seconds away, named on this device's clock to the nearest
' minute: a schedule opens on a minute, and a clock a moment behind the server's would otherwise
' name the minute before
function openingIn(seconds as dynamic, elapsedMs as integer) as dynamic
    if seconds = invalid then return invalid
    now = CreateObject("roDateTime")
    opening = CreateObject("roDateTime")
    opening.FromSeconds(accessSchedule.NearestMinute(now.AsSeconds() + seconds - elapsedMs \ 2000))
    now.ToLocalTime()
    opening.ToLocalTime()
    return accessSchedule.OpeningAt(now.AsSeconds(), opening.AsSeconds(), seconds)
end function

' A look with no answer from the server keeps the last decision and tries again, but an allowed
' decision ends at the close the plugin reported for it, with no opening to name. The Roku's clock
' doesn't get to judge an older schedule meanwhile.
sub keepLastAnswer()
    delay = RETRY_SECONDS
    if m.windowCloses <> invalid
        leftMs = m.windowCloses - m.clock.TotalMilliseconds()
        if leftMs <= 0
            m.windowCloses = invalid
            if not m.top.blocked then setBlocked(true, invalid)
        else
            left = (leftMs + 999) \ 1000
            if left < delay then delay = left
        end if
    end if
    startTimer(delay)
end sub

sub startTimer(seconds as integer)
    if seconds < 1 then seconds = 1
    m.timer.duration = seconds
    m.timer.control = "start"
end sub

' Told only when the answer changes, so the app stops playback once for each time the user is
' turned away. The next opening is kept current while blocked, since a changed schedule moves it.
sub setBlocked(blocked as boolean, upcoming as dynamic)
    if blocked = m.top.blocked
        if blocked then m.top.next = upcoming
        return
    end if
    m.top.next = upcoming
    m.top.blocked = blocked
    m.top.accessStatus = blocked
end sub

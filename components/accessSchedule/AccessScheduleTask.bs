import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/accessSchedule.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "readSchedule"
end sub

sub readSchedule()
    m.top.result = loadSchedule(m.top.userId)
end sub

function loadSchedule(userId as string) as object
    failed = { ok: false, exempt: false, entries: [] }
    if not isValidAndNotEmpty(userId) then return failed

    response = requestResponse(APIRequest("Users/" + userId), "GET")
    if response.status <> 200 or type(response.data) <> "roAssociativeArray" then return failed

    policy = response.data.Policy
    if type(policy) <> "roAssociativeArray" then return failed

    return {
        ok: true,
        exempt: policy.IsAdministrator = true,
        entries: accessSchedule.Read(policy)
    }
end function

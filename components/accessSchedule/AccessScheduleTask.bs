import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/accessSchedule.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "readSchedule"
end sub

sub readSchedule()
    m.top.result = loadSchedule(m.top.userId, m.top.askWindow)
end sub

function loadSchedule(userId as string, askWindow as boolean) as object
    failed = { ok: false, exempt: false, entries: [], windowUnsupported: false }
    if not isValidAndNotEmpty(userId) then return failed

    windowUnsupported = false
    if askWindow
        response = requestResponse(APIRequest("Moonfin/AccessWindow"), "GET")
        window = invalid
        if response.status = 200 then window = accessSchedule.ReadWindow(response.data)
        if window <> invalid then return { ok: true, window: window, windowUnsupported: false }
        ' No plugin or one from before the endpoint (404), or one that can't read the schedule on
        ' this server (501): judge it here from now on. Any other failure judges just this look here,
        ' so a failing endpoint can't leave the user let in on a server that turns them away.
        windowUnsupported = response.status = 404 or response.status = 501
    end if
    ' Said whether this look's policy read works or not, so the watcher stops asking either way
    failed.windowUnsupported = windowUnsupported

    response = requestResponse(APIRequest("Users/" + userId), "GET")
    if response.status <> 200 or type(response.data) <> "roAssociativeArray" then return failed

    policy = response.data.Policy
    if type(policy) <> "roAssociativeArray" then return failed

    exempt = policy.IsAdministrator = true
    entries = accessSchedule.Read(policy)
    refused = invalid
    if not exempt and entries.Count() > 0 then refused = accessSchedule.RefusedBy(requestResponse(APIRequest("Users/Me"), "GET").status)
    return { ok: true, exempt: exempt, entries: entries, refused: refused, windowUnsupported: windowUnsupported }
end function

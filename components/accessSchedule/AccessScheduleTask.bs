import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/accessSchedule.bs"
import "pkg:/source/utils/misc.bs"

' How long the optional server clock read may hold up a look
const CLOCK_TIMEOUT_MS = 5000

sub init()
    m.top.functionName = "readSchedule"
end sub

sub readSchedule()
    m.top.result = loadSchedule(m.top.userId)
end sub

function loadSchedule(userId as string) as object
    failed = { ok: false, exempt: false, entries: [] }
    if not isValidAndNotEmpty(userId) then return failed

    response = requestResponse(APIRequest("Users/" + userId), "GET")
    if response.status <> 200 or type(response.data) <> "roAssociativeArray" then return failed

    policy = response.data.Policy
    if type(policy) <> "roAssociativeArray" then return failed

    exempt = policy.IsAdministrator = true
    entries = accessSchedule.Read(policy)
    refused = invalid
    clock = invalid
    clockMissing = false
    if not exempt and entries.Count() > 0
        refused = accessSchedule.RefusedBy(requestResponse(APIRequest("Users/Me"), "GET").status)
        if m.top.askClock
            ' Waited for only briefly: the answer is held until it's in, and a refusal from Users/Me
            ' must stop playback promptly. One that doesn't come keeps the last clock.
            timeResponse = requestResponse(APIRequest("Moonfin/Time"), "GET", "", CLOCK_TIMEOUT_MS)
            if timeResponse.status = 200 then clock = accessSchedule.ServerClock(timeResponse.data, CreateObject("roDateTime").AsSeconds())
            ' A server without the plugin, or with one from before it told the time, says so once
            clockMissing = timeResponse.status = 404
        end if
    end if
    return { ok: true, exempt: exempt, entries: entries, refused: refused, clock: clock, clockMissing: clockMissing }
end function

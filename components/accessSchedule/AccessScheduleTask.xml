<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the access schedule in a user's policy. GET /Users/{id} keeps answering outside the
     schedule, where /Users/Me does not. -->
<component name="AccessScheduleTask" extends="Task">
    <interface>
        <field id="userId" type="string" />
        <!-- { ok, exempt, entries }: ok is false when the policy couldn't be read -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the access schedule in a user's policy. GET /Users/{id} keeps answering outside the
     schedule, and /Users/Me says whether the server is turning the user away. -->
<component name="AccessScheduleTask" extends="Task">
    <interface>
        <field id="userId" type="string" />
        <!-- { ok, exempt, entries, refused }: ok is false when the policy couldn't be read, and refused
             is invalid when the server wasn't asked or gave no answer -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

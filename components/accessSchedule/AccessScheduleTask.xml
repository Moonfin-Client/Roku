<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the access schedule in a user's policy. GET /Users/{id} keeps answering outside the
     schedule, and /Users/Me says whether the server is turning the user away. -->
<component name="AccessScheduleTask" extends="Task">
    <interface>
        <field id="userId" type="string" />
        <!-- Whether to ask the plugin for the server's clock -->
        <field id="askClock" type="boolean" value="true" />
        <!-- { ok, exempt, entries, refused, clock, clockMissing }: ok is false when the policy couldn't be
             read, refused is invalid when the server wasn't asked or gave no answer, clock is the
             server's { skew, offset } from this device's and is invalid when it couldn't be read, and clockMissing is
             true when the server has no Moonfin/Time -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Asks the Moonfin plugin for the user's access window, judged on the server's clock. Without
     one that answers, reads the access schedule in the user's policy: GET /Users/{id} keeps
     answering outside the schedule, and /Users/Me says whether the server is turning them away. -->
<component name="AccessScheduleTask" extends="Task">
    <interface>
        <field id="userId" type="string" />
        <!-- Whether to ask the plugin for the access window first -->
        <field id="askWindow" type="boolean" value="true" />
        <!-- { ok, window, windowUnsupported } from the plugin, or { ok, exempt, entries, refused, windowUnsupported }:
             ok is false when neither could be read, refused is invalid when the server wasn't asked
             or gave no answer, and windowUnsupported says the plugin can't answer the window -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the app when the signed in user's access schedule has closed. Nothing behind it can take
     focus, and the only way out is to pick another user or wait for the hours to open. -->
<component name="TimesUp" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="#020814" />
    <Group id="card">
      <Poster id="cardFill" uri="pkg:/images/details/surface12.9.png" blendColor="#070E1E" opacity="0.9" />
      <Poster id="cardBorder" uri="pkg:/images/details/cardborder12.9.png" blendColor="#FFFFFF29" />
      <Label id="title" font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center" />
      <Label id="message" font="font:SmallSystemFont" color="#FFFFFFC2" wrap="true" horizAlign="center" />
      <Label id="next" font="font:SmallSystemFont" color="#FFFFFFC2" wrap="true" horizAlign="center" />
      <StandardButton
        id="switchUser"
        background="0x2B6AE5E6"
        focusBackground="0x4783FFF2"
        color="0xFFFFFFFF"
        focusColor="0xFFFFFFFF" />
    </Group>
  </children>
  <interface>
    <!-- { seconds, dayOffset, secondOfDay, day } from the watcher, or invalid when no entry opens soon -->
    <field id="next" type="assocarray" onChange="onNextChange" />
    <field id="switchUser" type="boolean" alwaysNotify="true" />
  </interface>
</component>

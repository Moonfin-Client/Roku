import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const CARD_WIDTH = 640
const CARD_PAD = 32
const GAP = 14
const BUTTON_WIDTH = 260
const BUTTON_HEIGHT = 64

sub init()
    m.top.optionsAvailable = false
    ' The screen owns the whole display, so the nav bar is hidden
    m.top.overhangVisible = false
    m.card = m.top.findNode("card")
    m.cardFill = m.top.findNode("cardFill")
    m.cardBorder = m.top.findNode("cardBorder")
    m.title = m.top.findNode("title")
    m.message = m.top.findNode("message")
    m.nextLabel = m.top.findNode("next")
    m.switchUser = m.top.findNode("switchUser")

    ' The theme replaces the labels' fonts, so the sizes are set after it
    themeApply.ApplyToItem(m.top)
    width = CARD_WIDTH - CARD_PAD * 2
    m.title.font.size = 48
    m.title.width = width
    m.title.text = tr("Time's up")
    m.message.font.size = 28
    m.message.width = width
    m.message.text = tr("This account isn't available right now.")
    m.nextLabel.font.size = 28
    m.nextLabel.width = width

    m.switchUser.text = tr("Switch User")
    m.switchUser.width = BUTTON_WIDTH
    m.switchUser.height = BUTTON_HEIGHT
    m.switchUser.observeField("buttonSelected", "onSwitchUser")

    layoutCard()
end sub

sub OnScreenShown(_isReturning = false as boolean)
    layoutCard()
    m.switchUser.setFocus(true)
end sub

sub onNextChange()
    m.nextLabel.text = describeNext(m.top.next)
    layoutCard()
end sub

' When the user can come back, in words. Empty when no entry opens soon.
function describeNext(opening as dynamic) as string
    if type(opening) <> "roAssociativeArray" then return ""
    time = timeOfDayText(opening.secondOfDay)
    if opening.dayOffset = 0 then return Substitute(tr("You can use it again today at {0}."), time)
    if opening.dayOffset = 1 then return Substitute(tr("You can use it again tomorrow at {0}."), time)
    days = [tr("Sunday"), tr("Monday"), tr("Tuesday"), tr("Wednesday"), tr("Thursday"), tr("Friday"), tr("Saturday")]
    ' A week out is the same weekday as today, which would read as today, so the date is named too
    if opening.dayOffset >= 7
        months = [tr("Jan"), tr("Feb"), tr("Mar"), tr("Apr"), tr("May"), tr("Jun"), tr("Jul"), tr("Aug"), tr("Sep"), tr("Oct"), tr("Nov"), tr("Dec")]
        date = CreateObject("roDateTime")
        date.FromSeconds(date.AsSeconds() + opening.seconds)
        date.ToLocalTime()
        return Substitute(tr("You can use it again on {0}, {1} {2} at {3}."), days[opening.day], months[date.GetMonth() - 1], date.GetDayOfMonth().ToStr(), time)
    end if
    return Substitute(tr("You can use it again on {0} at {1}."), days[opening.day], time)
end function

' The opening's time of day, shown the way the app's clock is. It's never converted to local time,
' so the hours and minutes stay the opening's own.
function timeOfDayText(secondOfDay as integer) as string
    clock = CreateObject("roDateTime")
    clock.FromSeconds(secondOfDay)
    return formatTime(clock).Trim()
end function

' The line about the next opening only takes room while it has something to say
sub layoutCard()
    y = CARD_PAD

    m.title.translation = [CARD_PAD, y]
    y += m.title.boundingRect().height + GAP

    m.message.translation = [CARD_PAD, y]
    y += m.message.boundingRect().height

    m.nextLabel.visible = m.nextLabel.text <> ""
    if m.nextLabel.visible
        y += GAP
        m.nextLabel.translation = [CARD_PAD, y]
        y += m.nextLabel.boundingRect().height
    end if

    y += CARD_PAD
    m.switchUser.translation = [(CARD_WIDTH - BUTTON_WIDTH) / 2, y]
    y += BUTTON_HEIGHT + CARD_PAD

    for each layer in [m.cardFill, m.cardBorder]
        layer.width = CARD_WIDTH
        layer.height = y
    end for
    m.card.translation = [(1920 - CARD_WIDTH) / 2, (1080 - y) / 2]
end sub

sub onSwitchUser()
    m.top.switchUser = true
end sub

' Nothing gets past the screen to the one behind it, and Back does not leave it
function onKeyEvent(key as string, press as boolean) as boolean
    return true
end function

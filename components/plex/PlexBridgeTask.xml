<?xml version="1.0" encoding="utf-8"?>

<component name="PlexBridgeTask" extends="Task">
    <interface>
        <!-- The app's Jellyfin request: { url, method, body, timeoutMs } -->
        <field id="request" type="assocarray" />
        <!-- Its answer in Jellyfin's shape: { status, data } -->
        <field id="answer" type="assocarray" />
    </interface>
</component>

import "pkg:/source/api/plexTv.bs"
import "pkg:/source/utils/plexServers.bs"

' The plex.tv and Plex server requests the sign in makes, one per run

sub init()
    m.top.functionName = "signInStep"
end sub

sub signInStep()
    request = m.top.request ?? {}
    mode = m.top.mode
    if mode = "createPin"
        m.top.result = plexTv.CreatePin()
    else if mode = "checkPin"
        m.top.result = plexTv.CheckPin(plexUrls.Str(request.pinId ?? ""))
    else if mode = "signIn"
        m.top.result = plexTv.SignIn(plexUrls.Str(request.login ?? ""), plexUrls.Str(request.password ?? ""), plexUrls.Str(request.code ?? ""))
    else if mode = "servers"
        m.top.result = plexTv.Servers(plexUrls.Str(request.token ?? ""))
    else if mode = "connect"
        m.top.result = connect(request)
    else if mode = "bestAddress"
        m.top.result = bestAddress(request)
    end if
end sub

' The first address the server answers at, and the account the token belongs to
function connect(request as object) as object
    server = request.server
    uri = plexTv.FirstAnswering(server.connections, server.id)
    if uri = "" then return { ok: false }
    account = plexTv.Account(plexUrls.Str(request.token ?? ""))
    if not account.ok then return { ok: false, status: account.status }
    return { ok: true, uri: uri, account: account }
end function

' The best address a saved Plex server answers at right now. Whoever asked may have stopped waiting,
' so a better one is saved for next time as well.
function bestAddress(request as object) as object
    best = plexTv.FirstAnswering(request.candidates, plexUrls.Str(request.machineId ?? ""))
    if best <> "" and serverIdentityKey(best) <> serverIdentityKey(plexUrls.Str(request.url ?? "")) then plexServers.MoveTo(plexUrls.Str(request.machineId ?? ""), best)
    return { uri: best }
end function

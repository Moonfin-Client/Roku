<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in with Plex: a code to approve at plex.tv/link or a password, then the account's servers -->
<component name="PlexSignInScene" extends="JFScreen">
  <children>
    <Poster id="background" uri="pkg:/images/bg_login_gradient.webp" width="1920" height="1080" />
    <Group id="signInGroup">
      <Poster id="logo" uri="pkg:/images/logo.webp" width="474" height="107" />
      <Group id="statusBox" visible="false">
        <Poster id="statusFill" uri="pkg:/images/login/fill20.9.png" height="60" blendColor="#FFFFFF14" />
        <Label id="statusText" height="60" horizAlign="center" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFFD9" />
      </Group>
      <Group id="card">
        <Poster id="cardFill" uri="pkg:/images/login/fill33.9.png" blendColor="#111528CC" />
        <Poster id="cardBorder" uri="pkg:/images/login/stroke33w1.9.png" blendColor="#FFFFFF33" />
        <Group id="column" translation="[54, 0]">
          <Label id="title" height="48" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFF" />
          <Label id="instruction" horizAlign="center" wrap="true" font="font:SmallSystemFont" color="#FFFFFFB3" />
          <Group id="codeDigits" />
          <Spinner id="codeSpinner" />
          <Spinner id="waitSpinner" />
          <Label id="waiting" height="33" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
          <LoginTextField id="usernameField" />
          <LoginTextField id="passwordField" secure="true" />
          <LoginTextField id="codeField" />
          <Group id="serverList" />
          <Label id="errorLine" horizAlign="center" wrap="true" font="font:SmallSystemFont" color="#EF4444" />
          <LoginButton id="back" height="79" radius="39" padding="38" />
          <LoginButton id="action" style="primary" height="79" radius="39" padding="38" />
        </Group>

        <!-- Beside the code, where a phone signed in to Plex can approve it -->
        <Group id="qrGroup" visible="false">
          <Poster uri="pkg:/images/login/fill20.9.png" width="367" height="367" blendColor="#FFFFFF" />
          <QRCode id="qr" width="300" height="300" translation="[34, 34]" border="0" pixel="7" />
          <Label id="qrCaption" translation="[0, 380]" width="367" wrap="true" horizAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
        </Group>
      </Group>
    </Group>

    <Timer id="pollTimer" duration="1" repeat="false" />
  </children>
  <interface>
    <!-- A Plex server typed into Add Server or found on the network, which goes first among its addresses -->
    <field id="typedUri" type="string" />
    <field id="typedMachineId" type="string" />
    <!-- Plex servers found on the network, as { id, address } -->
    <field id="discovered" type="array" />
    <!-- The account and the server it reached: { token, account, server, uri, connections } -->
    <field id="result" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

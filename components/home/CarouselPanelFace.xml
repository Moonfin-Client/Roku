<?xml version="1.0" encoding="utf-8"?>
<!-- One look of a Carousel row's panel, 1703 x 500: the item's backdrop on the right under the
     scrims, and its details down the left. CarouselPanel crossfades two of these. -->
<component name="CarouselPanelFace" extends="Group">
  <children>
    <Poster id="shadow" uri="pkg:/images/setup/stage24shadow.9.png" translation="[-96, -72]" width="1895" height="692" blendColor="0x00000073" />
    <Poster id="fill" uri="pkg:/images/livetv/fill28.9.png" width="1703" height="500" />
    <!-- The backdrop takes the right 70%. The banner mask, stretched this far, rounds its right
         corners to the panel's 28. The art is drawn 16:9 across that width and cropped to the
         panel 62% of the way down it. -->
    <Group id="art" translation="[511, 0]" clippingRect="[0, 0, 1192, 500]">
      <MaskGroup id="artMask" maskUri="pkg:/images/posterBannerMask.webp" maskSize="[2701, 500]" maskOffset="[-1509, 0]">
        <Poster id="backdrop" translation="[0, -106]" width="1192" height="670" loadWidth="1192" loadHeight="670" loadDisplayMode="scaleToZoom" />
        <!-- Solid to 40% of the panel, then two of the same fade over each other, which come out at
             0.9 by 46%, 0.5 by 60% and clear by 85%. The solid part runs a little under the fades,
             so scaled down in the previews no gap opens where they meet. -->
        <Rectangle width="182" height="500" color="0x101218FF" />
        <Poster uri="pkg:/images/sidebar-edge-gradient.webp" translation="[170, 0]" width="767" height="500" blendColor="0x101218FF" loadDisplayMode="scaleToFill" />
        <Poster uri="pkg:/images/sidebar-edge-gradient.webp" translation="[170, 0]" width="767" height="500" blendColor="0x101218FF" loadDisplayMode="scaleToFill" />
        <!-- The fade is drawn in #111827, which this blend turns into the panel's own color -->
        <Poster uri="pkg:/images/seerr_gradient.webp" translation="[0, 325]" width="1192" height="175" blendColor="0xF0BF9DFF" opacity="0.7" loadDisplayMode="scaleToFill" />
      </MaskGroup>
    </Group>
    <Poster id="border" uri="pkg:/images/livetv/stroke28w1.9.png" width="1703" height="500" />

    <Group id="details" translation="[72, 0]">
      <Label id="title" width="920" wrap="true" maxLines="2" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="66" />
      </Label>
      <Label id="episode" width="920" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="26" />
      </Label>
      <LayoutGroup id="info" layoutDirection="horiz" vertAlignment="center" itemSpacings="[12]" />
      <RatingsRow id="ratings" visible="false" singleLine="true" iconHeight="24" valueSize="21" nameSize="16"
        labelFont="font:SmallestSystemFont" labelColor="#FFFFFF" ratingSpacing="22" maxWidth="920" />
      <LayoutGroup id="pills" layoutDirection="horiz" vertAlignment="center" itemSpacings="[8]" />
      <Label id="overview" width="820" wrap="true" maxLines="3" color="0xFFFFFFCC">
        <Font role="font" uri="font:SystemFontFile" size="20" />
      </Label>
    </Group>
    <!-- Never shown, they lend the info line and the pills their fonts -->
    <Label id="infoFont" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="21" />
    </Label>
    <Label id="pillFont" visible="false">
      <Font role="font" uri="font:BoldSystemFontFile" size="16" />
    </Label>
  </children>
  <interface>
    <!-- The settings previews draw the panel scaled down, where the mask and the clip don't follow
         the scale, so there the backdrop is plainly cropped to the panel and the preview rounds it -->
    <field id="flat" type="boolean" value="false" onChange="onFlatChanged" />
    <!-- { title, episode, info: [{ text, pill }], ratings, pills, overview, backdrop } -->
    <function name="draw" />
  </interface>
</component>

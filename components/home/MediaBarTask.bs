import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/externalList.bs"
import "pkg:/source/utils/mediaBarNewRelease.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/recentRows.bs"
import "pkg:/source/utils/userViews.bs"

const MEDIA_BAR_FIELDS = "Overview,People,Genres,CommunityRating,CriticRating,OfficialRating,ProductionYear,RunTimeTicks,ChildCount,ProviderIds,RemoteTrailers,DateCreated,DateLastMediaAdded,PremiereDate"

sub init()
    m.top.functionName = "getMediaBarData"
end sub

sub getMediaBarData()
    sourceType = LCase(m.top.sourceType ?? "random")
    sortOrder = normalizeSortOrder(m.top.sortOrder)
    allowedCollectionTypes = getAllowedCollectionTypes()
    includeTypes = getAllowedIncludeTypes()

    selectedLibraryIds = parseStringArraySetting(m.top.selectedLibraryIds)
    selectedCollectionIds = parseStringArraySetting(m.top.selectedCollectionIds)
    excludedGenreIds = parseStringArraySetting(m.top.excludedGenreIds)
    excludedGenreNames = getExcludedGenreNames(excludedGenreIds)

    ' Outside lists picked on their own fill the bar alone. When they come back empty the bar
    ' falls back to what it shows with nothing picked.
    externalItems = getExternalItems(parseStringArraySetting(m.top.externalListIds), includeTypes)

    ' Every source reads the picked libraries and collections together. The views only list
    ' libraries the account can open, so a saved pick it lost access to drops out here, and with
    ' every pick gone the bar draws from all the libraries.
    libraryIds = getLibraryIds(allowedCollectionTypes)
    parentIds = filterIdsBySelection(libraryIds, selectedLibraryIds)
    parentIds.append(selectedCollectionIds)
    if parentIds.count() = 0 and externalItems.count() = 0 then parentIds = libraryIds

    query = {
        userId: m.top.userId,
        includeItemTypes: includeTypes,
        excludeItemTypes: "BoxSet,CollectionFolder",
        recursive: true,
        sortBy: "Random",
        hasBackdrop: true,
        imageTypes: "Backdrop",
        limit: m.top.featuredCount * 2,
        fields: MEDIA_BAR_FIELDS,
        personTypes: "Actor,GuestStar"
    }
    ' The dated sources read the newest titles instead, and one with nothing in its window falls
    ' back to the random draw. Library titles come first, so one an outside list repeats keeps its
    ' server item.
    isDated = (sourceType = "recentlyadded" or sourceType = "recentlyreleased" or sourceType = "newreleases")
    pool = []
    if isDated
        pool = readDatedSources(parentIds, sourceType, includeTypes, excludedGenreNames)
    end if
    usedDatedPool = isDated and pool.count() > 0
    if pool.count() = 0 then pool = readSources(shuffleArray(parentIds), query, excludedGenreNames)
    ' A chart can hold hundreds of titles, so beside a library it gets as many places as the bar
    ' has slides
    externalItems = shuffleArray(filterAndDedupeItems(externalItems))
    if pool.count() > 0 and externalItems.count() > m.top.featuredCount then externalItems = externalItems.slice(0, m.top.featuredCount)

    if usedDatedPool
        pool = mergeDatedWithExternal(filterAndDedupeItems(pool), externalItems, m.top.featuredCount)
    else
        pool.append(externalItems)
        pool = shuffleArray(filterAndDedupeItems(pool))
    end if

    picked = pickSlides(pool, m.top.featuredCount, excludedGenreNames)
    m.top.mediaBarData = { items: sortSlides(picked, sortOrder) }
end sub

' Keeps dated library picks in their relative order while interleaving external picks,
' appending remaining library items at the end so pickSlides can backfill if an external
' title turns out to have no backdrop or an excluded genre.
function mergeDatedWithExternal(libraryPool as object, externalPool as object, wanted as integer) as object
    if externalPool.count() = 0 then return libraryPool
    if libraryPool.count() = 0 then return externalPool

    dedupedAll = filterAndDedupeItems(appendCopy(libraryPool, externalPool))
    libOnly = []
    extOnly = []
    for each item in dedupedAll
        if isValid(item.External)
            extOnly.push(item)
        else
            libOnly.push(item)
        end if
    end for
    if extOnly.count() = 0 then return libOnly

    targetExt = extOnly.count()
    half = Int(wanted / 2)
    if half < 1 then half = 1
    if targetExt > half then targetExt = half

    libKeep = wanted - targetExt
    if libKeep < 0 then libKeep = 0
    if libKeep > libOnly.count() then libKeep = libOnly.count()
    extKeep = wanted - libKeep
    if extKeep > extOnly.count() then extKeep = extOnly.count()

    merged = []
    maxLen = libKeep > extKeep ? libKeep : extKeep
    for i = 0 to maxLen - 1
        if i < libKeep then merged.push(libOnly[i])
        if i < extKeep then merged.push(extOnly[i])
    end for
    for i = libKeep to libOnly.count() - 1
        merged.push(libOnly[i])
    end for
    for i = extKeep to extOnly.count() - 1
        merged.push(extOnly[i])
    end for
    return merged
end function

function appendCopy(first as object, second as object) as object
    combined = []
    for each item in first
        combined.push(item)
    end for
    for each item in second
        combined.push(item)
    end for
    return combined
end function

' Reads the sources six at a time. Random sources shuffle and stop once twice as many usable
' titles are in hand; dated sources read every source and interleave one title per source in turn
' so faster later sources cannot steal shared titles from earlier sources.
function readSources(parentIds as object, query as object, excludedGenreNames as object, path = "/Items/" as string, dated = false as boolean, returnBatches = false as boolean) as object
    port = CreateObject("roMessagePort")
    running = {}
    runningIndex = {}
    batches = []
    for i = 0 to parentIds.count() - 1
        batches.push([])
    end for
    nextSource = 0
    items = []
    seen = {}
    while true
        while running.count() < 6 and nextSource < parentIds.count() and (dated or items.count() < m.top.featuredCount * 2)
            srcIdx = nextSource
            query.parentId = parentIds[srcIdx]
            nextSource++
            req = APIRequest(path, query)
            if req <> invalid
                ' A Plex server is answered by its bridge, one source at a time
                if plexUrls.Owns(req.GetUrl())
                    if dated
                        keepFetched(getJson(req), batches[srcIdx], {}, excludedGenreNames)
                    else
                        keepFetched(getJson(req), items, seen, excludedGenreNames)
                    end if
                else
                    req.setMessagePort(port)
                    if siloStartGet(req)
                        idKey = req.GetIdentity().ToStr()
                        running[idKey] = req
                        runningIndex[idKey] = srcIdx
                    end if
                end if
            end if
        end while
        if running.count() = 0 then exit while

        ' A Silo request is answered at once, as a stand-in URL event
        msg = siloWait(30000, port)
        if not isUrlEvent(msg) then exit while
        idKey = msg.GetSourceIdentity().ToStr()
        srcIdx = runningIndex[idKey]
        running.Delete(idKey)
        runningIndex.Delete(idKey)

        if msg.GetResponseCode() = 200
            if dated and isValid(srcIdx)
                keepFetched(ParseJson(msg.GetString()), batches[srcIdx], {}, excludedGenreNames)
            else
                keepFetched(ParseJson(msg.GetString()), items, seen, excludedGenreNames)
            end if
        end if
    end while

    if not dated then return items
    if returnBatches then return batches

    return interleaveBatches(batches)
end function

' Interleaves per-source batches deterministically in source order, deduplicating across sources by turn.
function interleaveBatches(batches as object) as object
    interleaved = []
    seen = {}
    cursors = []
    for i = 0 to batches.count() - 1
        cursors.push(0)
    end for
    progressed = true
    while progressed
        progressed = false
        for sIdx = 0 to batches.count() - 1
            batch = batches[sIdx]
            while cursors[sIdx] < batch.count() and seen.DoesExist(batch[cursors[sIdx]].Id)
                cursors[sIdx] = cursors[sIdx] + 1
            end while
            if cursors[sIdx] < batch.count()
                item = batch[cursors[sIdx]]
                cursors[sIdx] = cursors[sIdx] + 1
                seen[item.Id] = true
                interleaved.push(item)
                progressed = true
            end if
        end for
    end while
    return interleaved
end function

' The newest titles of a dated source. New Seasons & Episodes asks for the episodes, since a
' series' own date is its first season's, and carries the latest episode air/added dates onto
' each hydrated series while preserving rank order.
function readDatedSources(parentIds as object, sourceType as string, includeTypes as string, excludedGenreNames as object) as object
    query = { userId: m.top.userId, includeItemTypes: includeTypes, limit: 40, fields: MEDIA_BAR_FIELDS, personTypes: "Actor,GuestStar" }
    if sourceType = "recentlyadded"
        ' Filter each source batch before interleaving so unusable items cannot consume a library's turns.
        filtered = []
        for each batch in readSources(parentIds, query, excludedGenreNames, "/Items/Latest", true, true)
            filtered.push(withoutWatchedIfHidden(withBackdrops(batch)))
        end for
        return interleaveBatches(filtered)
    end if

    query.recursive = true
    query.sortBy = "PremiereDate"
    query.sortOrder = "Descending"
    query.excludeItemTypes = "BoxSet,CollectionFolder"
    query.hasBackdrop = true
    if sourceType = "recentlyreleased"
        query.maxPremiereDate = CreateObject("roDateTime").ToISOString()
        if m.top.hideWatched then query.filters = "IsUnplayed"
        filtered = []
        for each batch in readSources(parentIds, query, excludedGenreNames, "/Items/", true, true)
            filtered.push(withoutWatchedIfHidden(batch))
        end for
        return interleaveBatches(filtered)
    end if

    ' Movies only, so nothing here, and the bar falls back to random titles
    if includeTypes = "Movie" then return []
    days = m.top.newReleaseDays
    now = CreateObject("roDateTime").AsSeconds()
    since = CreateObject("roDateTime")
    since.FromSeconds(now - days * 86400)
    episodeQuery = { userId: m.top.userId, includeItemTypes: "Episode", recursive: true, sortBy: "PremiereDate", sortOrder: "Descending", minPremiereDate: since.ToISOString(), limit: 300, fields: "DateCreated" }
    episodeBatches = readSources(parentIds, episodeQuery, [], "/Items/", true, true)
    latestAired = {}
    latestAdded = {}
    seriesBatches = []
    for each batch in episodeBatches
        libSeries = []
        libSeen = {}
        for each episode in mediaBarNewRelease.RecentlyAired(batch, now, days)
            seriesId = toString(episode.LookupCI("SeriesId"))
            if seriesId <> ""
                if not libSeen.DoesExist(seriesId)
                    libSeen[seriesId] = true
                    libSeries.push(seriesId)
                end if
                epPremiere = toString(episode.LookupCI("PremiereDate"))
                epPremiereKey = isoDateTimeKey(epPremiere)
                if epPremiereKey <> "" and (not latestAired.DoesExist(seriesId) or epPremiereKey > latestAired[seriesId].key)
                    latestAired[seriesId] = { key: epPremiereKey, iso: epPremiere }
                end if
                epAdded = toString(episode.LookupCI("DateCreated"))
                epAddedKey = isoDateTimeKey(epAdded)
                if epAddedKey <> "" and (not latestAdded.DoesExist(seriesId) or epAddedKey > latestAdded[seriesId].key)
                    latestAdded[seriesId] = { key: epAddedKey, iso: epAdded }
                end if
            end if
        end for
        seriesBatches.push(libSeries)
    end for

    ' Interleave by series across libraries so a multi-episode season drop in one library
    ' does not spend extra turns on the same show.
    seriesIds = []
    seenSeries = {}
    cursors = []
    for i = 0 to seriesBatches.count() - 1
        cursors.push(0)
    end for
    progressed = true
    while progressed and seriesIds.count() < 40
        progressed = false
        for sIdx = 0 to seriesBatches.count() - 1
            if seriesIds.count() >= 40 then exit for
            libSeries = seriesBatches[sIdx]
            while cursors[sIdx] < libSeries.count() and seenSeries.DoesExist(libSeries[cursors[sIdx]])
                cursors[sIdx] = cursors[sIdx] + 1
            end while
            if cursors[sIdx] < libSeries.count()
                sid = libSeries[cursors[sIdx]]
                cursors[sIdx] = cursors[sIdx] + 1
                seenSeries[sid] = true
                seriesIds.push(sid)
                progressed = true
            end if
        end for
    end while
    if seriesIds.count() = 0 then return []

    items = []
    keepFetched(getJson(APIRequest("/Items/", { userId: m.top.userId, ids: seriesIds.Join(","), fields: MEDIA_BAR_FIELDS, personTypes: "Actor,GuestStar" })), items, {}, excludedGenreNames)
    byId = {}
    for each item in withBackdrops(items)
        itemId = toString(item.LookupCI("Id"))
        if latestAired.DoesExist(itemId) then item._effectivePremiereDate = latestAired[itemId].iso
        if latestAdded.DoesExist(itemId) then item._effectiveDateCreated = latestAdded[itemId].iso
        byId[itemId] = item
    end for
    ordered = []
    for each sid in seriesIds
        if byId.DoesExist(sid) then ordered.push(byId[sid])
    end for
    return ordered
end function

function normalizeSortOrder(value as dynamic) as string
    raw = LCase(toString(value).Trim())
    if raw = "random" then return "random"
    if raw = "dateaddeddesc" then return "dateAddedDesc"
    if raw = "dateaddedasc" then return "dateAddedAsc"
    if raw = "releasedatedesc" then return "releaseDateDesc"
    if raw = "releasedateasc" then return "releaseDateAsc"
    return "default"
end function

' Lexicographical UTC timestamp key ("YYYY-MM-DDTHH:MM:SS") so pre-1970 and modern dates compare
' accurately without repeated roDateTime allocations.
function isoDateTimeKey(value as dynamic) as string
    if not isServerDate(value) then return ""
    if Len(value) >= 19 then return Left(value, 19)
    if Len(value) >= 10 then return Left(value, 10) + "T00:00:00"
    return Left(value, 4) + "-01-01T00:00:00"
end function

' Calendar day key ("YYYY-MM-DD") matching releaseDay() so pre-1970 classic films keep their
' exact month and day instead of clamping to Unix epoch 0.
function isoDateKey(value as dynamic) as string
    if not isServerDate(value) then return ""
    if Len(value) >= 10 then return Left(value, 10)
    return Left(value, 4) + "-01-01"
end function

function dateAddedKeyOf(item as object) as string
    eff = isoDateTimeKey(item.LookupCI("_effectiveDateCreated"))
    lastMedia = isoDateTimeKey(item.LookupCI("DateLastMediaAdded"))
    if eff <> "" and (lastMedia = "" or eff >= lastMedia) then return eff
    if lastMedia <> "" then return lastMedia
    return isoDateTimeKey(item.LookupCI("DateCreated"))
end function

function releaseDateKeyOf(item as object) as string
    eff = isoDateKey(item.LookupCI("_effectivePremiereDate"))
    if eff <> "" then return eff
    premiere = isoDateKey(item.LookupCI("PremiereDate"))
    if premiere <> "" then return premiere
    yearVal = item.LookupCI("ProductionYear")
    if isValid(yearVal)
        yearNum = Int(Val(yearVal.toStr()))
        if yearNum > 0 then return Right("000" + yearNum.toStr(), 4) + "-01-01"
    end if
    return ""
end function

function compareDateKeys(a as string, b as string, descending as boolean) as integer
    if a = "" and b = "" then return 0
    if a = "" then return 1
    if b = "" then return -1
    if a = b then return 0
    if descending then return (b > a) ? 1 : -1
    return (a > b) ? 1 : -1
end function

' Re-orders the already-selected slides according to mediaBarSortOrder.
' "default" leaves the selected source's order untouched.
function sortSlides(slides as object, sortOrder as string) as object
    if slides.count() < 2 or sortOrder = "default" then return slides
    if sortOrder = "random" then return shuffleArray(slides)

    descending = (sortOrder = "dateAddedDesc" or sortOrder = "releaseDateDesc")
    byDateAdded = (sortOrder = "dateAddedDesc" or sortOrder = "dateAddedAsc")

    ' Precompute sort keys once per slide before sorting
    entries = []
    for each s in slides
        addedKey = dateAddedKeyOf(s)
        releaseKey = releaseDateKeyOf(s)
        entries.push({
            item: s,
            primary: byDateAdded ? addedKey : releaseKey,
            secondary: byDateAdded ? releaseKey : addedKey,
            name: LCase(toString(s.LookupCI("Name")))
        })
    end for

    ' Insertion sort (stable, fast for <= 50 slides)
    for i = 1 to entries.count() - 1
        current = entries[i]
        j = i - 1
        while j >= 0 and shouldSwapEntries(entries[j], current, descending)
            entries[j + 1] = entries[j]
            j = j - 1
        end while
        entries[j + 1] = current
    end for

    ordered = []
    for each entry in entries
        ordered.push(entry.item)
    end for
    return ordered
end function

function shouldSwapEntries(leftEntry as object, rightEntry as object, descending as boolean) as boolean
    cmp = compareDateKeys(leftEntry.primary, rightEntry.primary, descending)
    if cmp <> 0 then return cmp > 0

    cmp2 = compareDateKeys(leftEntry.secondary, rightEntry.secondary, descending)
    if cmp2 <> 0 then return cmp2 > 0

    return leftEntry.name > rightEntry.name
end function

' The Recently Added and Recently Released pools follow Hide Watched like their rows
function withoutWatchedIfHidden(items as object) as object
    if not m.top.hideWatched then return items
    return recentRows.WithoutWatched(items)
end function

' The Latest list and a lookup by id can't be asked for backdrops only
function withBackdrops(items as object) as object
    kept = []
    for each item in items
        tags = item.LookupCI("BackdropImageTags")
        if type(tags) = "roArray" and tags.count() > 0 then kept.push(item)
    end for
    return kept
end function

sub keepFetched(json as dynamic, items as object, seen as object, excludedGenreNames as object)
    ' The Latest list comes back as a bare array
    fetched = type(json) = "roArray" ? json : (isChainValid(json, "items") ? json.items : [])
    if excludedGenreNames.count() > 0 then fetched = filterItemsByExcludedGenres(fetched, excludedGenreNames)
    for each item in parentalControls.WithoutBlockedItems(fetched)
        if not seen.DoesExist(item.Id)
            seen[item.Id] = true
            items.push(item)
        end if
    end for
end sub

' The first titles of the shuffled pool, with only the outside ones that make it looked up on
' TMDB. One that turns out to be an excluded genre or to have no backdrop gives its place to
' the next title in the pool.
function pickSlides(pool as object, wanted as integer, excludedGenreNames as object) as object
    picked = []
    cursor = 0
    while picked.count() < wanted and cursor < pool.count()
        batch = []
        while batch.count() < wanted - picked.count() and cursor < pool.count()
            batch.push(pool[cursor])
            cursor++
        end while

        addExternalDetails(batch)
        for each item in batch
            if keepSlide(item, excludedGenreNames) then picked.push(item)
        end for
    end while
    return picked
end function

' Library titles were already filtered when they were fetched
function keepSlide(item as object, excludedGenreNames as object) as boolean
    if not isValid(item.External) then return true
    if not isValidAndNotEmpty(item.BackdropUrl) then return false
    return filterItemsByExcludedGenres([item], excludedGenreNames).count() > 0
end function

function filterAndDedupeItems(items as object) as object
    result = []
    seen = {}
    for each item in items
        keys = dedupeKeys(item)
        fresh = true
        for each key in keys
            if seen.DoesExist(key) then fresh = false
        end for

        if fresh
            for each key in keys
                seen[key] = true
            end for
            result.push(item)
        end if
    end for
    return result
end function

' A title is known by its TMDB id together with its type and by its IMDb id, so the same title
' from a library and from an outside list counts once. Without either, its id or its name and
' year stand in.
function dedupeKeys(item as object) as object
    itemType = LCase(item.LookupCI("Type") ?? "")

    keys = []
    providerIds = item.LookupCI("ProviderIds")
    if isValid(providerIds)
        tmdbId = moonfinPlugin.GetTmdbId(providerIds)
        if isValidAndNotEmpty(tmdbId) then keys.push(`${itemType}|tmdb|${LCase(tmdbId)}`)
        imdbId = providerIds.LookupCI("Imdb")
        if isValidAndNotEmpty(imdbId) then keys.push(`imdb|${LCase(imdbId)}`)
    end if
    if keys.count() > 0 then return keys

    if isValidAndNotEmpty(item.id) then return [`${itemType}|id|${item.id}`]

    nameKey = LCase(item.LookupCI("Name") ?? "")
    yearKey = isValid(item.LookupCI("ProductionYear")) ? item.LookupCI("ProductionYear").toStr() : ""
    return [`${itemType}|name|${nameKey}|${yearKey}`]
end function

' The titles of the picked outside lists that can go on the bar, fetched together. Nothing
' without the plugin, which is what fetches them.
function getExternalItems(listIds as object, includeTypes as string) as object
    pool = []
    if listIds.count() = 0 or not moonfinPlugin.IsEnabled() then return pool

    ' A title with no backdrop of its own can still get one from TMDB
    detailsSupported = moonfinPlugin.AreTmdbDetailsSupported()
    customRows = externalList.CustomRows()

    port = CreateObject("roMessagePort")
    pending = {}
    for each listId in listIds
        query = externalList.RequestFor(listId, customRows)
        req = invalid
        if isValid(query) then req = APIRequest("/Moonfin/CustomRows/Items", externalList.Localized(query))
        if isValid(req)
            req.setMessagePort(port)
            ' siloStartGet answers a Silo request itself, through Moonbase, and starts any other
            if siloStartGet(req) then pending[req.GetIdentity().toStr()] = { req: req, query: query }
        end if
    end for

    while pending.count() > 0
        ' A Silo request is answered at once, as a stand-in URL event
        msg = siloWait(30000, port)
        if not isUrlEvent(msg) then exit while

        key = msg.GetSourceIdentity().toStr()
        entry = pending[key]
        if isValid(entry)
            pending.Delete(key)
            data = invalid
            if msg.GetResponseCode() = 200 then data = ParseJson(msg.GetString())
            if chainLookupReturn(data, "success", false) = true
                rowType = ""
                if entry.query.source = "tmdb_chart" then rowType = externalList.ChartItemType(entry.query.type)
                for each raw in chainLookupReturn(data, "items", [])
                    item = externalSlideItem(raw, rowType)
                    if isValid(item) and Instr(1, includeTypes, item.Type) > 0 and (detailsSupported or item.BackdropUrl <> "") then pool.push(item)
                end for
            end if
        end if
    end while

    ' A missing rating on an outside title means nobody looked it up, so it stays out once a
    ' rating is blocked, as on the home rows
    return parentalControls.WithoutUnratedOrBlockedItems(pool)
end function

' One list title shaped like a library item, so the bar reads both the same way. It carries
' its own art and the Seerr record it opens, since there is no server item behind it.
function externalSlideItem(raw as dynamic, rowType as string) as dynamic
    if type(raw) <> "roAssociativeArray" then return invalid

    ids = raw.LookupCI("providerIds")
    if type(ids) <> "roAssociativeArray" then ids = {}
    tmdbId = toString(ids.LookupCI("Tmdb")).Trim()
    if tmdbId = "" then tmdbId = toString(raw.LookupCI("tmdbId")).Trim()
    imdbId = toString(ids.LookupCI("Imdb")).Trim()
    if tmdbId = "" and imdbId = "" then return invalid

    providerIds = {}
    if tmdbId <> "" then providerIds.Tmdb = tmdbId
    if imdbId <> "" then providerIds.Imdb = imdbId

    itemType = rowType
    if itemType = "" then itemType = toString(raw.LookupCI("type"))
    itemType = (LCase(itemType) = "series") ? "Series" : "Movie"
    mediaType = (itemType = "Series") ? "tv" : "movie"

    title = toString(raw.LookupCI("name"))
    if title = "" then title = toString(raw.LookupCI("title"))
    year = raw.LookupCI("productionYear")
    posterPath = toString(raw.LookupCI("posterUrl"))
    backdropPath = toString(raw.LookupCI("backdropUrl"))

    return {
        External: true,
        Id: tmdbId <> "" ? tmdbId : imdbId,
        Name: title,
        Type: itemType,
        ProductionYear: year,
        OfficialRating: raw.LookupCI("officialRating"),
        CommunityRating: raw.LookupCI("rating"),
        ProviderIds: providerIds,
        PosterUrl: externalList.ImageUrl(posterPath, "w500"),
        BackdropUrl: externalList.ImageUrl(backdropPath, "w1280"),
        LogoUrl: "",
        RemoteTrailers: [],
        SeerrItem: { id: tmdbId, title: title, type: mediaType, mediaType: mediaType, posterPath: posterPath, backdropPath: backdropPath, productionYear: year }
    }
end function

' Fills in what TMDB holds for the outside titles in the batch, asked for together. A title it
' has nothing on keeps what its list gave.
sub addExternalDetails(items as object)
    if not moonfinPlugin.AreTmdbDetailsSupported() then return

    port = CreateObject("roMessagePort")
    pending = {}
    for each item in items
        if isValid(item.External)
            query = { "type": item.SeerrItem.mediaType }
            if isValidAndNotEmpty(item.ProviderIds.Tmdb)
                query["tmdbId"] = item.ProviderIds.Tmdb
            else
                query["imdbId"] = item.ProviderIds.Imdb
            end if
            req = APIRequest("/Moonfin/Tmdb/Details", query)
            if isValid(req)
                req.setMessagePort(port)
                if siloStartGet(req) then pending[req.GetIdentity().toStr()] = { req: req, item: item }
            end if
        end if
    end for

    while pending.count() > 0
        msg = siloWait(15000, port)
        if not isUrlEvent(msg) then exit while

        key = msg.GetSourceIdentity().toStr()
        entry = pending[key]
        if isValid(entry)
            pending.Delete(key)
            ' A 404 means TMDB has nothing on the title
            if msg.GetResponseCode() = 200 then applyExternalDetails(entry.item, ParseJson(msg.GetString()))
        end if
    end while
end sub

sub applyExternalDetails(item as object, details as dynamic)
    if type(details) <> "roAssociativeArray" then return

    overview = toString(details.LookupCI("overview"))
    if overview <> "" then item.Overview = overview
    rating = details.LookupCI("rating")
    if isValid(rating) then item.CommunityRating = rating
    genres = details.LookupCI("genres")
    if type(genres) = "roArray" then item.Genres = genres

    ' The bar reads a LongInteger, and a short runtime parses as an Integer
    ticks = details.LookupCI("runTimeTicks")
    if type(ticks) = "LongInteger" or type(ticks) = "Integer" or type(ticks) = "roInt" or type(ticks) = "roInteger"
        item.RunTimeTicks = 0& + ticks
    end if

    backdropUrl = externalList.ImageUrl(details.LookupCI("backdropPath"), "w1280")
    if backdropUrl <> "" then item.BackdropUrl = backdropUrl
    item.LogoUrl = externalList.ImageUrl(details.LookupCI("logoPath"), "w500")
    trailerUrl = toString(details.LookupCI("trailerUrl"))
    if trailerUrl <> "" then item.RemoteTrailers = [{ Url: trailerUrl }]
end sub

function getAllowedCollectionTypes() as object
    contentType = m.top.contentType
    if contentType = "movies"
        return ["movies"]
    else if contentType = "tvshows"
        return ["tvshows"]
    end if
    return ["movies", "tvshows"]
end function

function getAllowedIncludeTypes() as string
    contentType = m.top.contentType
    if contentType = "movies" then return "Movie"
    if contentType = "tvshows" then return "Series"
    return "Movie,Series"
end function

function parseStringArraySetting(value as dynamic) as object
    if not isValid(value) then return []

    valueType = type(value)
    if valueType = "roArray" or valueType = "Array"
        result = []
        for each item in value
            if isValidAndNotEmpty(item)
                result.push(item.toStr())
            end if
        end for
        return result
    end if

    parsed = ParseJson(value.toStr())
    if type(parsed) = "roArray" or type(parsed) = "Array"
        result = []
        for each item in parsed
            if isValidAndNotEmpty(item)
                result.push(item.toStr())
            end if
        end for
        return result
    end if

    return []
end function

function filterIdsBySelection(candidateIds as object, selectedIds as object) as object
    selectedSet = {}
    for each id in selectedIds
        selectedSet[guidKey(id)] = true
    end for

    filtered = []
    for each id in candidateIds
        if selectedSet.DoesExist(guidKey(id))
            filtered.push(id)
        end if
    end for

    return filtered
end function

function getExcludedGenreNames(excludedGenreIds as object) as object
    names = {}
    if not isValidAndNotEmpty(excludedGenreIds) then return names

    selected = {}
    for each id in excludedGenreIds
        selected[guidKey(id)] = true
        ' Other clients sync the genre's name rather than its id
        names[LCase(id)] = true
    end for

    genres = api.genres.Get({
        userId: m.top.userId,
        sortBy: "SortName",
        sortOrder: "Ascending"
    })

    if not isChainValid(genres, "items") then return names

    for each genre in genres.items
        genreId = guidKey(genre.id)
        genreName = (genre.name ?? "").toStr()

        if selected.DoesExist(genreId) and isValidAndNotEmpty(genreName)
            names[LCase(genreName)] = true
        end if
    end for

    return names
end function

function filterItemsByExcludedGenres(items as object, excludedGenreNames as object) as object
    filtered = []

    for each item in items
        itemGenres = item.LookupCI("Genres") ?? []
        shouldExclude = false

        for each genre in itemGenres
            if excludedGenreNames.DoesExist(LCase(genre.toStr()))
                shouldExclude = true
                exit for
            end if
        end for

        if not shouldExclude
            filtered.push(item)
        end if
    end for

    return filtered
end function

' Folders and recordings carry no collection type, same as a mixed library, but a query
' against one of those reaches every library, so they go out by name
function libraryAllowed(lib as object, allowedTypes as object) as boolean
    name = LCase(lib.LookupCI("Name") ?? "")
    if name = "folders" or name = "recordings" then return false

    collectionType = lib.LookupCI("CollectionType")
    if isMixedLibraryType(collectionType) then return true

    return inArray(allowedTypes, LCase(collectionType))
end function

function getLibraryIds(allowedTypes as object) as object
    ids = []
    views = userViews.Get(m.top.userId)
    if not isChainValid(views, "items") then return ids

    for each lib in views.items
        if libraryAllowed(lib, allowedTypes)
            ids.push(lib.id)
        end if
    end for

    return ids
end function

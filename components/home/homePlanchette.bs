import "pkg:/source/utils/misc.bs"

' Points Halloween's planchette at whatever has focus on Home. These run in Home's scope,
' so m is the screen.

sub planchetteInit()
    m.planchetteLabelHeight = invalid
    m.homeRows.observeFieldScoped("rowItemFocused", "pointPlanchette")
    m.homeRows.observeFieldScoped("focusedChild", "pointPlanchette")
    if isValid(m.mediaBar) then m.mediaBar.observeFieldScoped("focusedChild", "pointPlanchette")
    if isValid(m.modernFocusCard) then m.modernFocusCard.observeFieldScoped("cardShown", "pointPlanchette")
end sub

sub pointPlanchette()
    m.seasonalEffects.callFunc("pointAt", planchetteTarget())
end sub

function planchetteTarget() as object
    if m.homeRows.isInFocusChain() then return { landing: "card", rect: focusedCardRect() }

    nav = m.activeNav
    if not isValid(nav) or not nav.isInFocusChain() then return {}
    if nav.subtype() = "Sidebar"
        bounds = nav.boundingRect()
        return { landing: "right", rect: nav.focusRect, edge: bounds.x + bounds.width }
    end if
    return { landing: "below", rect: nav.focusRect }
end function

' The rows keep the focused card in one place, at the top of the list under its row title
function focusedCardRect() as object
    if m.modernHomeRows and isValid(m.modernFocusCard) and m.modernFocusCard.cardShown
        image = m.modernFocusCard.findNode("mfImageMask").sceneBoundingRect()
        return [image.x, image.y, image.width, image.height]
    end if

    sizes = m.homeRows.rowItemSize
    size = sizes
    if type(sizes[0]) = "roArray"
        ' The rows can take focus a moment before they say which card has it
        focused = m.homeRows.rowItemFocused
        row = 0
        if isValid(focused) and focused.count() > 0 and isValid(focused[0]) then row = focused[0]
        if row < 0 or row >= sizes.count() then row = 0
        size = sizes[row]
    end if
    if m.planchetteLabelHeight = invalid
        label = CreateObject("roSGNode", "Label")
        label.font = m.homeRows.rowLabelFont
        label.text = "Ag"
        m.planchetteLabelHeight = label.boundingRect().height
    end if
    origin = m.homeRows.translation
    return [origin[0], origin[1] + m.planchetteLabelHeight + m.homeRows.rowLabelOffset[0][1], size[0], size[1]]
end function

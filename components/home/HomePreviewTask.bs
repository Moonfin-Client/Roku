import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/trailerSearch.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/homePreview.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/serverCompatibility.bs"

' Each lookup gives up after this long, since a preview thats late has lost its moment
const PREVIEW_REQUEST_TIMEOUT_MS = 5000

sub init()
    m.top.functionName = "execute"
end sub

sub execute()
    request = m.top.request
    if not isValid(request) then return
    answer = { requestId: request.requestId ?? 0 }

    if m.top.action = "stop"
        stopEncoding(request)
    else if m.top.action = "trailer"
        resolveTrailer(request, answer)
    else if m.top.action = "plexStream"
        answer.url = toString(chainLookupReturn(serverJson(request.server, "Videos/" + request.itemId + "/PreviewStream", request.params), "Url", ""))
        answer.format = "hls"
        answer.start = request.start
    else
        target = resolveTarget(request)
        if isValid(target) then answer.target = target
    end if
    m.top.answer = answer
end sub

' The item the card plays, with what the stream needs. A series plays its next episode, and a
' series with none, or whose next is a special, has nothing to show.
function resolveTarget(request as object) as dynamic
    server = request.server
    item = request.item
    if not isValid(server) or not isValid(item) then return invalid
    targetId = toString(chainLookupReturn(item, "Id", ""))
    if targetId = "" or toString(server.url) = "" then return invalid

    if LCase(toString(chainLookupReturn(item, "Type", ""))) = "series"
        nextUp = serverJson(server, "Shows/NextUp", { "SeriesId": targetId, "UserId": server.userId, "Limit": 1, "EnableTotalRecordCount": false })
        episode = homePreview.TargetFromNextUp(chainLookupReturn(nextUp, "Items", invalid))
        if not isValid(episode) then return invalid
        targetId = toString(chainLookupReturn(episode, "Id", ""))
        if targetId = "" then return invalid
    end if

    path = serverItemMetadataPath(targetId, server.userId, isEmbyServer(server.url))
    target = serverJson(server, path, { "UserId": server.userId, "Fields": "MediaSources,MediaStreams" })
    if not validItemMetadata(target) then return invalid
    return target
end function

' The trailer of the item asked about. A file on the server comes back as the target, with what
' its stream needs, and a YouTube trailer comes back as its id. The item is only fetched for its
' links when it has no file and came without them.
sub resolveTrailer(request as object, answer as object)
    if isValid(request.details)
        resolveOutsideTrailer(request.details, answer)
        return
    end if

    server = request.server
    ownerId = toString(chainLookupReturn(request, "item.Id", ""))
    if not isValid(server) or ownerId = "" or toString(server.url) = "" then return

    emby = isEmbyServer(server.url)
    path = serverItemMetadataPath(ownerId, server.userId, emby)
    params = { "UserId": server.userId }
    found = homePreview.TrailerSource(serverJson(server, path + "/LocalTrailers", params), chainLookupReturn(request, "item.RemoteTrailers", invalid))
    if not isValid(found)
        detail = serverJson(server, path, params)
        found = homePreview.TrailerSource(invalid, chainLookupReturn(detail, "RemoteTrailers", invalid))
        if not isValid(found) and isPlexServer(server.url) then found = homePreview.TrailerSource(invalid, trailerSearch.Find(detail))
    end if
    if not isValid(found) then return

    if isValidAndNotEmpty(found.videoId)
        answer.videoId = found.videoId
        return
    end if
    target = serverJson(server, serverItemMetadataPath(found.localId, server.userId, emby), { "UserId": server.userId, "Fields": "MediaSources,MediaStreams" })
    if validItemMetadata(target) then answer.target = target
end sub

' A title with no server item only has the trailer the plugin's TMDB details name
sub resolveOutsideTrailer(query as object, answer as object)
    if not moonfinPlugin.AreTmdbDetailsSupported() then return
    found = homePreview.DetailsTrailerSource(requestResponse(APIRequest("/Moonfin/Tmdb/Details", query), "GET", "", PREVIEW_REQUEST_TIMEOUT_MS).data)
    if isValid(found) then answer.videoId = found.videoId
end sub

' Lets the server drop the preview's transcode. Jellyfin and Emby take the same route.
sub stopEncoding(request as object)
    server = request.server
    playSessionId = toString(request.playSessionId ?? "")
    if not isValid(server) or playSessionId = "" then return

    params = homePreview.EncodingStopParams(toString(getAuthHeaderContext().deviceId), playSessionId)
    req = itemServerRequest(server, "Videos/ActiveEncodings", params)
    if isValid(req) then deleteVoid(req)
end sub

function serverJson(server as object, path as string, params as object) as dynamic
    req = itemServerRequest(server, path, params)
    if not isValid(req) then return invalid
    return requestResponse(req, "GET", "", PREVIEW_REQUEST_TIMEOUT_MS).data
end function

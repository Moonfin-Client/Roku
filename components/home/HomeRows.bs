'
sub createMyListRow()
    sectionName = tr("My List")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    ' Load the My List Data (lazy task creation)
    task = getOrCreateTask("mylist")
    task.cacheRow = cacheRowFor("mylist", sectionName)
    runRowTask(task, "content", "updateMyListItems")

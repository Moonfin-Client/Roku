import "pkg:/source/api/Image.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/homeCache.bs"
import "pkg:/source/utils/homeCards.bs"
import "pkg:/source/utils/homeRowLayout.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/recentRows.bs"
import "pkg:/source/utils/seasonalRow.bs"
import "pkg:/source/utils/settingsSync.bs"
import "pkg:/source/utils/watchPartyCard.bs"
import "pkg:/source/utils/watchPartyModel.bs"

const LOADING_WAIT_TIME = 2

' A build whose rows never all answer still ends, so a refresh waiting behind it runs. A slow
' server took 15 seconds for the last row in testing. The timeout only frees queued refreshes,
' it doesn't stop rows from landing.
const BUILD_TIMEOUT_SECONDS = 30

' Picked rows past the first eight sections wait until focus comes within two rows above them or
' five below, and then load three at a time
const EAGER_SECTION_COUNT = 8
const NEAR_ROWS_ABOVE = 2
const NEAR_ROWS_BELOW = 5
const LATE_ROW_LOADS = 3

' The Recently Added rows a build counts for each server before that server's libraries are known.
' The count is corrected to the real number once they are.
const MULTI_SERVER_LATEST_ROWS = 5

' Row tasks run at most this many at a time. Low-end Rokus have four cores, and each row task parses
' its own answer, so more running at once would only slow each other down
const ROW_POOL_SIZE = 4

' Rows that land after the first of a build wait this long, then go in together, so the RowList
' lays out once per batch rather than once per row while the viewer is pressing keys
const ROW_FLUSH_SECONDS = 0.15

' A row's height beyond its cards. The title above them takes 56. Under them a row keeps room for three
' lines of caption and 16 clear of the next row's title, so no padding setting lets them touch. That's
' 16, the 30 tall name and two 28 tall lines in Classic, and 5 and three 34 tall lines in Modern. A
' Modern row of widening cards keeps Core's room for the focused card's title, details, ratings and
' three lines of overview instead, 175 points and 8 more when it shows ratings. Those points are 1920 /
' 1150 pixels, without the TV's 0.8, since Home's focused card keeps its own bigger fonts.
const ROW_TITLE_BAND = 56
const CLASSIC_CAPTION_ROOM = 118
' Space between cards in a row
const HOME_CARD_GAP = 20
const MODERN_CAPTION_ROOM = 123
const MODERN_INFO_ROOM = 292
const MODERN_RATINGS_ROOM = 14
' A Carousel row keeps 24 between its cards and its 500 tall panel, and 70 clear under the panel
' before the next row's title, which Row Padding can only add to
const CAROUSEL_ROOM = 594

' Helper function to check if Featured Media is enabled via toggle (not home sections)
function isFeaturedMediaEnabled() as boolean
    ' Check the media bar enabled toggle in Moonfin settings
    mediaBarEnabled = (get_user_setting("ui.home.mediaBarMode") <> "off")

    ' Default to true if not set
    if not isValid(mediaBarEnabled)
        return true
    end if

    ' Convert to boolean if it's a string
    if type(mediaBarEnabled) = "String" or type(mediaBarEnabled) = "roString"
        return (LCase(mediaBarEnabled) = "true")
    end if

    return mediaBarEnabled
end function

sub init()
    ' The row list reads settings many times per build, and there is one of it, so it keeps a session copy (see sessionNow)
    m.keepsSessionCopy = true
    m.scene = m.top.getScene()

    m.overhang = getActiveNav(m.scene)
    if isValid(m.overhang)
        m.overhang.isVisible = true
    end if

    m.top.content = CreateObject("roSGNode", "ContentNode")

    ' Initialize libraryData to prevent access before loading
    m.libraryData = []
    m.filteredLatest = []
    m.libraryRowOrder = {}
    m.multiServerEstimates = {}
    m.emptySections = {}

    ' Library sections wait for the library list. Until it lands, they are kept in librarySections.
    m.librariesPending = false
    m.librarySections = []

    ' Rows that land after the first of a build are held here until the flush timer adds them
    m.pendingRows = []
    m.flushedThisBuild = false
    m.flushScheduled = false
    m.flushTimer = createObject("roSGNode", "Timer")
    m.flushTimer.duration = ROW_FLUSH_SECONDS
    m.flushTimer.repeat = false
    m.flushTimer.observeField("fire", "flushPendingRows")

    m.loadingTimer = createObject("roSGNode", "Timer")
    m.loadingTimer.duration = LOADING_WAIT_TIME
    m.loadingTimer.observeField("fire", "loadingTimerComplete")

    updateSize()

    m.top.setfocus(true)

    m.top.observeField("rowItemSelected", "itemSelected")
    ' Recently Added rows grow as the viewer nears their end: the request each row was made
    ' from, the rows waiting on a bigger page, and the rows the server has no more for
    m.latestRequests = {}
    m.latestLoadingMore = {}
    m.latestExhausted = {}
    m.top.observeField("rowItemFocused", "loadRowsNearFocus")
    m.top.observeField("translation", "fitRowCount")
    m.heldBackRows = {}
    m.lateRows = {}
    m.lateRowQueue = []

    ' Row tasks start through a pool of ROW_POOL_SIZE. The rest wait in rowQueue, and Continue Watching
    ' and Next Up jump to its front
    m.rowQueue = []
    m.pooledTasks = []
    m.rowsInFlight = 0

    ' The launch cache is read on a task of its own, so the libraries don't wait behind it
    m.cacheReadTask = createObject("roSGNode", "LoadItemsTask")
    m.cacheReadTask.itemsToLoad = "homeCacheRead"
    m.cacheReadTask.observeField("cachedRecords", "onCachedRecords")

    m.LoadLibrariesTask = createObject("roSGNode", "LoadItemsTask")

    ' Initialize task storage - tasks will be created on-demand
    m.contentTasks = {}
    m.multiServerTasks = {}
    m.pendingProbeCount = 0
    m.initialHomeRowsStarted = false

    ' Only one build fills the rows at a time. A refresh asked for while one runs is queued, and
    ' the strongest queued refresh runs when that build ends
    m.buildInFlight = false
    m.queuedBuild = ""
    m.buildCount = 0
    m.cacheScopeBuild = -1
    m.cacheDir = ""
    m.cacheKey = ""
    m.buildTimeout = createObject("roSGNode", "Timer")
    m.buildTimeout.duration = BUILD_TIMEOUT_SECONDS
    m.buildTimeout.observeField("fire", "onBuildTimeout")

    ' Poster labels for the cards of the rows that flush in together, asked for in one request. Cards
    ' waiting on an id are kept in labelNodes until its answer lands.
    m.labelNodes = {}
    m.labelIdsWaiting = []
    m.labelIdsAsked = []
    m.labelsTask = createObject("roSGNode", "LoadItemsTask")
    m.labelsTask.itemsToLoad = "posterLabels"
    m.labelsTask.observeField("state", "onLabelsTaskState")
end sub

sub beginBuild()
    dropEarlierRowWork()
    m.libraryRowOrder = {}
    m.multiServerEstimates = {}
    m.buildInFlight = true
    m.buildCount++
    m.flushedThisBuild = false
    m.buildTimeout.control = "stop"
    m.buildTimeout.control = "start"
end sub

' dropEarlierRowWork: A new build replaces what earlier ones still had queued or running, such as rows left
' over when a build timed out. Their queued tasks are dropped and late answers ignored, so a row the new
' build doesn't have never comes back. A row it does have watches its task again, which then runs again.
' The held back rows still loading lose their callbacks too, so their slots are freed here, and rows
' waiting for the flush are dropped with the build they came from.
sub dropEarlierRowWork()
    m.lateRows = {}
    m.lateRowQueue = []
    m.pendingRows = []
    m.flushTimer.control = "stop"
    m.flushScheduled = false
    for each task in m.rowQueue
        dropRowCallbacks(task)
    end for
    m.rowQueue = []
    kept = []
    for each task in m.pooledTasks
        if task.rowRunning
            dropRowCallbacks(task)
            kept.push(task)
        end if
    end for
    m.pooledTasks = kept
end sub

' Row tasks answer on content, and multi-server ones on isComplete. A rerun an earlier build asked for
' is dropped too, since it would watch that build's callback again when it starts.
sub dropRowCallbacks(task as object)
    task.unobserveField("content")
    if task.hasField("isComplete") then task.unobserveField("isComplete")
    if task.hasField("rowRerun") then task.rowRerun = false
end sub

' A library reload outranks a layout reload, which outranks a plain update
function buildRank(kind as string) as integer
    if kind = "libraries" then return 3
    if kind = "reload" then return 2
    if kind = "update" then return 1
    return 0
end function

sub queueBuild(kind as string)
    if buildRank(kind) > buildRank(m.queuedBuild) then m.queuedBuild = kind
end sub

' markPainted: Fires the AppLaunchComplete beacon once, when rows are on screen. Roku measures launch time with it.
'
sub markPainted()
    if m.global.app_loaded then return
    m.top.signalBeacon("AppLaunchComplete") ' Roku Performance monitoring
    m.global.app_loaded = true
end sub

sub finishBuild(reason as string)
    if not m.buildInFlight then return

    m.buildInFlight = false
    m.buildTimeout.control = "stop"

    ' Fallback for a layout whose rows are all empty, so no flush ever paints one. Rows still waiting
    ' for a flush are not on screen yet, so they leave the beacon to that flush.
    if m.pendingRows.count() = 0 then markPainted()

    ' A full build removes the painted rows it didn't replace, such as a library that was removed
    if reason = "all rows"
        removed = 0
        for each row in m.top.content.getChildren(-1, 0)
            if row.hasField("fromCache") and row.fromCache = true
                if m.cacheDir <> "" then homeCache.Remove(m.cacheDir, row.id, row.title)
                m.top.content.removeChild(row)
                removed++
            end if
        end for
        if removed > 0 then setRowItemSize()
    end if

    queued = m.queuedBuild
    m.queuedBuild = ""
    if queued = "libraries" then reloadLibraries()
    if queued = "reload" then reloadHomeRows()
    if queued = "update" then updateHomeRows()
end sub

sub onBuildTimeout()
    finishBuild("timeout")
end sub

' refreshCacheScope: Sets where this build's rows are cached, and the layout and settings they were built
' for. Multi-server rows mix servers, so they stay out of the cache while more than one server is signed in.
sub refreshCacheScope()
    ' Once per build: loadLibraries sets it before painting, then startHomeRowsLoading asks again
    if m.cacheScopeBuild = m.buildCount then return
    m.cacheScopeBuild = m.buildCount
    m.cacheDir = ""
    m.cacheKey = ""
    ' The key names the layout, so it's read fresh in case the viewer has just changed it
    m.cachedRowOrder = invalid
    if isMultiServerEnabled() and getAllServerSessions().count() > 0 then return
    ' A refresh during sign-out or a user switch has no user to cache for
    userId = chainLookupReturn(m.global.session, "user.id", "")
    if not isValidAndNotEmpty(userId) or not isString(userId) then return

    m.cacheDir = homeCache.Dir(toString(get_url()), userId)
    ' Folder names are shortened, so two accounts could share one. The key names the account in full,
    ' so neither reads the other's rows.
    ' The same expression addHomeSection reads, so the key matches the rows it builds
    mergeContinueWatching = kidsMode.MergesContinueWatching(isStringEqual(get_user_setting("ui.home.mergeContinueWatchingNextUp"), "true"))
    ' Row titles are translated, so the locale is part of the key
    m.cacheKey = FormatJson([
        homeCache.Owner(toString(get_url()), userId),
        m.global.app.version,
        localRowOrder(),
        mergeContinueWatching,
        get_user_setting_bool("ui.home.mergeRecentRowsByType", false),
        get_user_setting_bool(recentRows.HIDE_WATCHED_SETTING, false),
        kidsMode.Enabled(),
        isModernHomeRows(),
        isCarouselHomeRows(),
        homeCards.CardSizeName(),
        CreateObject("roDeviceInfo").GetCurrentLocale()
    ])
end sub

' cacheRowFor: The cache record a single-server row's task saves its items under. Empty when this build isn't cached.
'
' @param {string} rowId - The row's setting key, as its update handler passes it to addOrUpdateHomeRow
' @param {string} title - The row's title, as its update handler passes it to addOrUpdateHomeRow
' @param {integer} order - The row's place among rows of the same key, so they come back in order
' @return {object} the cache record, or {} when this build isn't cached
function cacheRowFor(rowId as string, title as string, order = 0 as integer) as object
    if m.cacheDir = "" then return {}
    return { dir: m.cacheDir, key: m.cacheKey, id: rowId, title: title, order: order }
end function

sub loadLibraries()
    if m.buildInFlight
        queueBuild("libraries")
        return
    end if

    beginBuild()
    refreshCacheScope()
    m.librariesPending = true
    ' A launch, or a reload that emptied the rows, paints the rows saved last time while the libraries load
    hasRows = false
    for each row in m.top.content.getChildren(-1, 0)
        if row.getChildCount() > 0 then hasRows = true
    end for
    ' The cache read starts first, so its rows are built while the libraries load
    if m.cacheDir <> "" and not hasRows
        m.cacheReadTask.cacheRead = { dir: m.cacheDir, key: m.cacheKey }
        m.cacheReadTask.control = "RUN"
    end if
    m.LoadLibrariesTask.observeField("content", "onLibrariesLoaded")
    m.LoadLibrariesTask.control = "RUN"

    ' The rows that don't read the libraries start now, and the library rows follow when the list lands
    startHomeRowsLoading()
end sub

' The rows are emptied first, since the latest rows follow the library order and filling them
' in place would leave them where they were
sub reloadLibraries()
    if m.buildInFlight
        queueBuild("libraries")
        return
    end if

    m.top.content = CreateObject("roSGNode", "ContentNode")
    loadLibraries()
end sub

' runRowTask: Starts a Home row's task through the pool, or queues it behind the tasks already running
'
' @param {object} task - The LoadItemsTask or MultiServerTask that fills a row
' @param {string} field - The field the task answers on, content or isComplete
' @param {string} handler - The callback for the answer, watched from the moment the run starts
' @param {boolean} first - True for Continue Watching, Next Up and the merged row, which go to the front
sub runRowTask(task as object, field as string, handler as string, first = false as boolean)
    if not isValid(task) then return

    ' A pooled row only tags its cards, and Home asks for their labels once per flush in queueLabels
    if task.hasField("deferPosterLabels") then task.deferPosterLabels = true

    ' Each task is watched once, since a second observeField would call the handler twice
    if not task.hasField("rowPooled")
        task.addFields({ rowPooled: true, rowRunning: false, rowRerun: false, rowField: "", rowHandler: "" })
        task.observeField("state", "onRowTaskState")
    end if
    task.rowField = field
    task.rowHandler = handler

    ' The OS would drop a second RUN on a running task. Its answer may already be in, so it runs again
    ' once it stops (onRowTaskState). The running answer is ignored, and the callback is watched again
    ' when the new run starts. A task that has stopped still holds its slot until onRowTaskState
    ' frees it, so starting it now would count it twice.
    if task.state = "run" or task.rowRunning
        task.unobserveField(field)
        task.rowRerun = true
        return
    end if

    for i = 0 to m.rowQueue.count() - 1
        if m.rowQueue[i].isSameNode(task)
            if first
                m.rowQueue.delete(i)
                m.rowQueue.unshift(task)
            end if
            return
        end if
    end for

    if m.rowsInFlight < ROW_POOL_SIZE
        startRowTask(task)
    else
        if first
            m.rowQueue.unshift(task)
        else
            m.rowQueue.push(task)
        end if
    end if
end sub

' startRowTask: Sets a row task running
'
' @param {object} task - The row task to start
sub startRowTask(task as object)
    m.rowsInFlight++
    task.rowRunning = true
    task.rowRerun = false
    m.pooledTasks.push(task)
    ' Watched only here, so an answer from a run started for an earlier build never reaches it
    task.unobserveField(task.rowField)
    ' A rerun's earlier run may have left isComplete true, and the new run's true would then send no change
    if task.rowField = "isComplete" then task.isComplete = false
    task.observeField(task.rowField, task.rowHandler)
    task.control = "RUN"
end sub

' onRowTaskState: Frees a pool slot when a row task stops, then starts the queued tasks that fit
'
' @param {dynamic} msg - The task's state change
sub onRowTaskState(msg as object)
    state = msg.getData()
    if state <> "stop" and state <> "done" then return

    task = msg.getRoSGNode()
    ' A late stop from a run that has already started again
    if task.state = "run" then return
    ' A stop or done only frees a slot for a task this pool started and has not already counted, so an
    ' OS that reports both states for one run cannot free two slots
    if not task.rowRunning then return
    task.rowRunning = false
    if m.rowsInFlight > 0 then m.rowsInFlight = m.rowsInFlight - 1
    if task.rowRerun
        task.rowRerun = false
        runRowTask(task, task.rowField, task.rowHandler)
    end if

    while m.rowsInFlight < ROW_POOL_SIZE and m.rowQueue.count() > 0
        nextTask = m.rowQueue.shift()
        ' A queued task that is already running is left to its own finish
        if nextTask.state <> "run" then startRowTask(nextTask)
    end while
end sub

' getOrCreateTask: Lazily creates and returns a LoadItemsTask for the given type
'
' @param {string} taskType - Type of task to create (e.g., "continue", "nextUp", "favorites")
' @return {object} The task node
function getOrCreateTask(taskType as string) as object
    ' Check if task already exists
    if m.contentTasks.DoesExist(taskType)
        return m.contentTasks[taskType]
    end if

    ' Create new task on-demand
    task = createObject("roSGNode", "LoadItemsTask")
    task.itemsToLoad = taskType
    m.contentTasks[taskType] = task

    return task
end function

' getTaskContentAndCleanup: Retrieves content from a task and cleans up its observers
'
' @param {string} taskType - Type of task to retrieve content from
' @return {object} The content from the task
function getTaskContentAndCleanup(taskType as string) as object
    if not m.contentTasks.doesExist(taskType)
        return invalid
    end if

    task = m.contentTasks[taskType]
    itemData = task.content
    task.unobserveField("content")
    task.content = []

    return itemData
end function

sub updateSize()
    ' Translation is set in Home.xml, don't override it here
    poster = homeCards.CardBox(homeCards.CardSizeName(), 2 / 3)

    'Set width of Rows to cut off at edge of Safe Zone
    ' Rows that keep a margin left of a growing card start that much further left, so they reach as far
    width = 1703
    if growsClassicHomeCards() then width += homeCards.GROW_MARGIN
    m.top.itemSize = [width, ROW_TITLE_BAND + CLASSIC_CAPTION_ROOM + poster[1]]

    m.top.itemSpacing = [0, homeRowsVerticalSpacing(isModernHomeRows())]

    ' spacing between items in a row. Modern keeps cards tight, the focused card
    ' makes its own room by sliding the following cells aside (reflow).
    m.top.rowItemSpacing = [HOME_CARD_GAP, 0]

    m.top.rowItemSize = poster

    m.top.visible = true
end sub

function getDefaultSection(index as integer) as string
    if index = 0 then return "resume"
    if index = 1 then return "recentlyreleased"
    if index = 2 then return "nextup"
    if index = 3 then return "latestmedia"
    return "none"
end function

function isArrayValue(value as dynamic) as boolean
    valueType = type(value)
    return valueType = "Array" or valueType = "roArray"
end function

function toNormalizedString(value as dynamic) as string
    if not isValid(value)
        return ""
    end if

    valueType = type(value)
    if valueType = "String" or valueType = "roString"
        return value.Trim()
    end if

    return value.ToStr().Trim()
end function

function homeSectionCount() as integer
    return localRowOrder().Count()
end function

' Arranged reads and parses the stored layout, and a row build asks for it once per row
' across several passes, so the answer is kept until the rows are built again
function localRowOrder() as object
    if not isArrayValue(m.cachedRowOrder)
        order = homeRowLayout.Arranged()
        if kidsMode.Enabled() then order = kidsMode.Sections(normalizedSections(order))
        m.cachedRowOrder = order
    end if
    return m.cachedRowOrder
end function

' The stored layout keeps whatever name the client that wrote it used, and Kids Mode decides by
' this app's own
function normalizedSections(order as object) as object
    named = []
    for each entry in order
        known = normalizeSectionId(entry)
        named.push(isValidAndNotEmpty(known) ? known : LCase(toNormalizedString(entry)))
    end for

    return named
end function

' The other clients name a few of these rows differently, so an id arriving from one of
' them is put into this app's own vocabulary. An id it has no other name for, every
' dynamic row among them, is passed through as it stands.
function getResolvedSectionName(index as integer) as string
    localOrder = localRowOrder()
    if index < 0 or index >= localOrder.Count() then return "none"

    userSection = localOrder[index]
    if not isValid(userSection) then return getDefaultSection(index)

    known = normalizeSectionId(userSection)
    if isValidAndNotEmpty(known) then return known

    return LCase(userSection)
end function


sub startHomeRowsLoading()
    refreshCacheScope()
    ' Read once per load, since every row that lands lays the list out again
    m.cardSizeName = homeCards.CardSizeName()
    m.modernRows = isModernHomeRows()
    ' Row Padding can change between loads
    m.top.itemSpacing = [0, homeRowsVerticalSpacing(m.modernRows)]
    m.carouselRows = isCarouselHomeRows()
    m.infoRoom = MODERN_INFO_ROOM
    if moonfinPlugin.IsRatingsEnabled("home") then m.infoRoom += MODERN_RATINGS_ROOM
    m.pendingProbeCount = 0
    m.initialHomeRowsStarted = false
    m.initialHomeRowsStarted = true
    processUserSections()
end sub


function holdsBack(index as integer, sectionName as string) as boolean
    return index >= EAGER_SECTION_COUNT and isValid(homeRowLayout.SourceFromId(sectionName)) and internalRowEnabled(sectionName)
end function

' A held back row keeps its place with a titled placeholder, or with what it showed before
sub holdBack(rowId as string)
    m.heldBackRows[rowId] = true
    title = customDynamicRowTitle(rowId)
    if not isValidAndNotEmpty(title) then title = rowId
    if sectionExists(title, rowId) or knownEmpty(title) then return

    row = m.top.content.CreateChild("HomeRow")
    row.id = rowId
    row.title = title
end sub

' My Media keeps its place with a titled placeholder while the libraries load, so the row lands in place
' Returns true when a placeholder was added
function addLibraryPlaceholder() as boolean
    title = tr("My Media")
    if sectionExists(title, "smalllibrarytiles") or knownEmpty(title) then return false

    row = m.top.content.CreateChild("HomeRow")
    row.id = "smalllibrarytiles"
    row.title = title
    return true
end function

sub loadRowsNearFocus()
    if m.heldBackRows.count() = 0 then return
    focused = m.top.rowItemFocused
    if not isValid(focused) or focused.count() = 0 then return

    for index = focused[0] - NEAR_ROWS_ABOVE to focused[0] + NEAR_ROWS_BELOW
        row = m.top.content.getChild(index)
        if isValid(row) and m.heldBackRows.DoesExist(row.id)
            m.heldBackRows.Delete(row.id)
            m.lateRowQueue.push(row.id)
        end if
    end for
    startLateRows()
end sub

sub startLateRows()
    while m.lateRows.count() < LATE_ROW_LOADS and m.lateRowQueue.count() > 0
        rowId = m.lateRowQueue.Shift()
        m.lateRows[rowId] = true
        createCustomDynamicRow({ id: rowId })
    end while
end sub

function getExpectedRowContribution(sectionName as string) as integer
    if not isValidAndNotEmpty(sectionName) or sectionName = "none"
        return 0
    end if


    if sectionName = "latestmedia" or sectionName = "recentlyreleased"
        if isMultiServerEnabled()
            sessions = getAllServerSessions()
            if sessions.Count() > 0
                ' Multi-server latest media builds a row per library on each server, while
                ' recently released aggregates every server into a single row
                if sectionName = "recentlyreleased"
                    return 1
                end if
                return sessions.Count() * MULTI_SERVER_LATEST_ROWS
            end if
        end if

        excludeList = []
        sessionUser = m.global.session.user
        if isValid(sessionUser.configuration) and isValid(sessionUser.configuration.LatestItemsExcludes)
            excludeList = sessionUser.configuration.LatestItemsExcludes
        end if

        if not isValid(m.libraryData)
            return 0
        end if

        m.filteredLatest = []
        for each library in filterNodeArray(m.libraryData, "id", excludeList)
            if not (isValid(library.json) and library.json.IsGameLibrary = true) then m.filteredLatest.push(library)
        end for

        ' When merging, libraries sharing a collection type collapse into a single row. Recently
        ' Released keeps one row per library either way (createRecentlyReleasedRow).
        mergeByType = (sectionName = "latestmedia") and get_user_setting_bool("ui.home.mergeRecentRowsByType", false)
        seenTypes = {}
        rowCount = 0
        for each latestLibrary in m.filteredLatest
            if latestLibrary.collectionType <> "boxsets" and latestLibrary.collectionType <> "livetv" and latestLibrary.json.CollectionType <> "Program"
                if not mergeByType
                    rowCount++
                else
                    colType = LCase(toNormalizedString(latestLibrary.json.CollectionType ?? latestLibrary.collectionType ?? "other"))
                    if not seenTypes.DoesExist(colType)
                        seenTypes[colType] = true
                        rowCount++
                    end if
                end if
            end if
        end for

        return rowCount
    end if

    return 1
end function

function normalizeSectionToken(value as dynamic) as string
    token = LCase(toNormalizedString(value))
    token = token.Replace(" ", "")
    token = token.Replace("_", "")
    token = token.Replace("-", "")
    return token
end function

function normalizeSectionId(id as dynamic) as string
    token = normalizeSectionToken(id)
    if isValidAndNotEmpty(token)
        if token = "continuewatching" or token = "resume" then return "resume"
        if token = "continuelistening" or token = "resumeaudio" then return "resumeaudio"
        if token = "nextup" then return "nextup"
        if token = "latestmedia" or token = "latestmovies" or token = "latestshows" or token = "recentlyadded" or token = "recentlyaddedmedia" then return "latestmedia"
        if token = "recentlyreleased" or token = "recentlyreleasedmovies" or token = "recentlyreleasedepisodes" then return "recentlyreleased"
        if token = "livetv" then return "livetv"
        if token = "onnow" then return "onnow"
        if token = "favorites" then return "favorites"
        if token = "mylist" then return "mylist"
        if token = "collections" then return "collections"
        if token = "genres" then return "genres"
        if token = "playlists" then return "playlists"
        if token = "audio" then return "audio"
        if token = "smalllibrarytiles" or token = "librarytilessmall" or token = "librarybuttons" or token = "mymedia" then return "smalllibrarytiles"
        if token = "featuredmedia" or token = "mediabar" then return "featuredmedia"
        if token = "sinceyouwatched" then return "sinceyouwatched1"
        if homeRowLayout.SeedRowIndex(token) > 0 then return token
        if token = "rewatch" then return "rewatch"
        if token = "none" then return "none"
    end if

    return ""
end function


' needsLibraries: The sections that read the library list, so they wait for it while it loads
'
' @param {string} sectionName - Resolved section name
' @return {boolean} true when the section needs m.libraryData
function needsLibraries(sectionName as string) as boolean
    return sectionName = "smalllibrarytiles" or sectionName = "latestmedia" or sectionName = "recentlyreleased"
end function

' processUserSections: Loop through user's chosen home section settings and generate the content for each row
'
sub processUserSections()
    m.expectedRowCount = 0
    m.processedRowCount = 0
    m.mergedRowLoading = false
    m.librarySections = []

    ' Migration: Remove featuredmedia from local settings if present (run once)
    for i = 0 to 7
        userSection = get_user_setting("homeScreenSection" + i.toStr())
        if isValid(userSection) and LCase(userSection) = "featuredmedia"
            set_user_setting("homeScreenSection" + i.toStr(), "none")
        end if
    end for

    homeRowLayout.MigrateLegacySlots()
    homeRowLayout.MigrateSinceYouWatched()
    m.cachedRowOrder = invalid

    m.heldBackRows = {}
    m.lateRowQueue = []
    placeholderAdded = false
    ' Library sections are counted once the libraries land, since their contribution reads them
    for i = 0 to homeSectionCount() - 1
        sectionName = getResolvedSectionName(i)
        if m.librariesPending and needsLibraries(sectionName) then continue for
        if not holdsBack(i, sectionName) then m.expectedRowCount = m.expectedRowCount + getExpectedRowContribution(sectionName)
    end for

    ' Add home sections in order based on user settings
    m.loadedSectionCount = 0
    for i = 0 to homeSectionCount() - 1
        sectionName = getResolvedSectionName(i)


        sectionLoaded = false
        if holdsBack(i, sectionName)
            holdBack(sectionName)
        else if m.librariesPending and needsLibraries(sectionName)
            m.librarySections.push(sectionName)
            if sectionName = "smalllibrarytiles"
                if addLibraryPlaceholder() then placeholderAdded = true
            end if
        else if sectionName <> "none"
            sectionLoaded = addHomeSection(sectionName)
        end if

        ' Count how many sections with data are loaded
        if sectionLoaded then m.loadedSectionCount++
    end for

    ' Library sections that are still out will count toward the first load, so focus waits for them
    if m.loadedSectionCount = 0 and m.librarySections.Count() = 0
        m.overhang.setfocus(true)
    end if

    if m.heldBackRows.count() > 0 or placeholderAdded
        sortHomeRows()
        setRowItemSize()
    end if

    ' Start the timer for creating the content rows before we set the cursor size
    m.loadingTimer.control = "start"

    ' A layout with no loadable sections has no row to answer, so the build is done here. Library
    ' rows still out keep the build open until they land, and so do rows waiting to be added.
    ' setRowItemSize finishes the build when it can lay the rows out, and a queued build may start
    ' from there, so this only finishes one that is still this build
    if m.expectedRowCount = m.processedRowCount and not m.librariesPending and m.pendingRows.count() = 0
        build = m.buildCount
        setRowItemSize()
        if m.buildCount = build then finishBuild("all rows")
    end if
end sub

' onLibrariesLoaded: Handler when LoadLibrariesTask returns data
'
sub onLibrariesLoaded()
    ' save data for other functions
    m.libraryData = m.LoadLibrariesTask.content
    m.LoadLibrariesTask.unobserveField("content")
    m.LoadLibrariesTask.content = []

    m.librariesPending = false
    waiting = m.librarySections
    m.librarySections = []

    ' Every contribution first, since the latest rows read m.filteredLatest that they fill
    extraRows = 0
    for each sectionName in waiting
        extraRows += getExpectedRowContribution(sectionName)
    end for
    m.expectedRowCount = m.expectedRowCount + extraRows

    for each sectionName in waiting
        if addHomeSection(sectionName) then m.loadedSectionCount++
    end for

    if m.loadedSectionCount = 0 and isValid(m.overhang) then m.overhang.setfocus(true)

    sortHomeRows()
    setRowItemSize()
end sub

' onCachedRecords: Builds the rows saved at the last launch on the render thread, then paints them.
' Reading a HomeData's json from a task would wait on the render thread for every item.
sub onCachedRecords()
    records = m.cacheReadTask.cachedRecords
    if not isArrayValue(records) or records.count() = 0 then return
    m.cacheReadTask.cachedRecords = []
    ' Only a build removes the cached rows its fresh ones didn't replace, so a read that lands after
    ' the build is dropped rather than left on screen
    if not m.buildInFlight then return

    imageContext = activeImageContext()
    rows = []
    for each record in records
        ' A read started for an earlier build's layout lands in this one, so only rows saved for this
        ' build's key are painted
        if not isStringEqual(record.key, m.cacheKey) then continue for
        row = CreateObject("roSGNode", "HomeRow")
        row.id = record.id
        row.title = record.title
        ' Home can tell a cached row from a fresh one, so it can swap the fresh one in without a jump
        row.fromCache = true
        if isString(record.sig) then row.cacheSig = record.sig
        for each item in record.items
            child = CreateObject("roSGNode", "HomeData")
            child.imageContext = imageContext
            child.json = item
            ' Home's own handlers set this only on Continue Watching and Continue Listening, so only those cards get it
            if isStringEqual(record.id, "resume") or isStringEqual(record.id, "resumeaudio")
                played = chainLookupReturn(item, "UserData.PlayedPercentage", invalid)
                if isValid(played) then child.PlayedPercentage = played
            end if
            row.appendChild(child)
        end for
        rows.push(row)
    end for

    paintCachedRows(rows)
end sub

' paintCachedRows: Paints the rows saved at the last launch, so Home has content before the network answers.
' A fresh row that already landed, or one waiting for the flush, wins over its saved copy.
'
' @param {object} rows - The HomeRow nodes built from the saved records
sub paintCachedRows(rows as object)
    painted = 0
    ' Rows that share an id, such as the latest row of each library, all map to one section index. The
    ' records come sorted by their saved order, so each goes after the one painted before it.
    lastById = {}
    for each row in rows
        searchSectionTitle = LCase(row.title).Replace(" ", "")
        index = getSectionIndex(row.title, row.id)
        existing = invalid
        if index < m.top.content.getChildCount() then existing = m.top.content.getChild(index)

        pendingMatch = false
        for each entry in m.pendingRows
            if sectionMatches({ title: entry.sectionName, id: entry.key }, searchSectionTitle, row.id) then pendingMatch = true
        end for

        ' A row that already came back empty this build stays off, rather than showing its old copy
        if pendingMatch or knownEmpty(row.title) or (isValid(existing) and existing.getChildCount() > 0)
            continue for
        end if

        if isValid(existing)
            m.top.content.replaceChild(row, index)
        else
            insertAt = getOriginalSectionIndex(row.id)
            previous = lastById[row.id]
            if isValid(previous)
                children = m.top.content.getChildren(-1, 0)
                for i = 0 to children.count() - 1
                    if children[i].isSameNode(previous)
                        insertAt = i + 1
                        exit for
                    end if
                end for
            end if
            m.top.content.insertChild(row, insertAt)
        end if
        lastById[row.id] = row
        painted++
    end for

    sortHomeRows()
    setRowItemSize()
    if painted > 0 then markPainted()
end sub

' getOriginalSectionIndex: Gets the index of a section from user settings and adds count of currently known latest media sections
'
' @param {string} sectionName - Name of section we're looking up
'
' @return {integer} indicating index of section taking latest media sections into account
function getOriginalSectionIndex(sectionName as string) as integer
    searchSectionName = LCase(sectionName).Replace(" ", "")

    sectionIndex = 0
    indexLatestMediaSection = 0

    for i = 0 to homeSectionCount() - 1
        settingSectionName = getResolvedSectionName(i)

        if settingSectionName = "latestmedia"
            indexLatestMediaSection = i
        end if

        if settingSectionName = searchSectionName
            sectionIndex = i
        end if
    end for

    ' If the latest media section is before the section we're searching for, then we need to account for how many latest media rows there are
    addLatestMediaSectionCount = (indexLatestMediaSection < sectionIndex)

    if addLatestMediaSectionCount
        for i = sectionIndex to m.top.content.getChildCount() - 1
            sectionToTest = m.top.content.getChild(i)
            if LCase(Left(sectionToTest.title, 6)) = "latest"
                sectionIndex++
            end if
        end for
    end if

    return sectionIndex
end function

' addOrUpdateHomeRow: Sets the row ID and queues the row for the home view. The first row of a build goes in
' at once; rows that land after it are collected and added together by flushPendingRows.
'
' @param {object} row - The HomeRow node we're adding or updating
' @param {string} sectionName - The localized title of the row
' @param {string} originalSectionKey - The setting key associated with the section
sub addOrUpdateHomeRow(row as object, sectionName as string, originalSectionKey as string)
    row.id = originalSectionKey

    ' A newer row for the same slot replaces the older one still waiting
    entry = { row: row, sectionName: sectionName, key: originalSectionKey }
    searchSectionTitle = LCase(sectionName).Replace(" ", "")
    replaced = false
    for i = 0 to m.pendingRows.count() - 1
        if sectionMatches({ title: m.pendingRows[i].sectionName, id: m.pendingRows[i].key }, searchSectionTitle, originalSectionKey)
            m.pendingRows[i] = entry
            replaced = true
            exit for
        end if
    end for
    if not replaced then m.pendingRows.push(entry)

    if not m.flushedThisBuild
        flushPendingRows()
    else if not m.flushScheduled
        m.flushScheduled = true
        m.flushTimer.control = "start"
    end if
end sub

' flushPendingRows: Adds the waiting rows to the home view in one pass, then sorts and sizes the rows once
'
sub flushPendingRows()
    m.flushTimer.control = "stop"
    m.flushScheduled = false
    if m.pendingRows.count() = 0 then return

    flushedRows = []
    for each entry in m.pendingRows
        exists = sectionExists(entry.sectionName, entry.key)
        if exists
            index = getSectionIndex(entry.sectionName, entry.key)
        else
            index = getOriginalSectionIndex(entry.key)
        end if

        kept = false
        if exists
            existing = m.top.content.getChild(index)
            kept = keepCachedCards(existing, entry.row)
            if kept then entry.row = existing
        end if
        if kept
        else if exists
            m.top.content.replaceChild(entry.row, index)
        else
            m.top.content.insertChild(entry.row, index)
        end if
        flushedRows.push(entry.row)
    end for
    m.pendingRows = []

    ' Set before the layout, since it can finish the build and start a queued one that resets these
    m.flushedThisBuild = true

    sortHomeRows()
    setRowItemSize()

    queueLabels(flushedRows)

    painted = false
    for each row in flushedRows
        if row.getChildCount() > 0 then painted = true
    end for
    if painted then markPainted()
end sub

'' keepCachedCards: Keeps a row drawn from the launch cache when the fresh row matches it, so its cards
' aren't drawn a second time. The fresh cards only add what the cache doesn't hold.
'
' @param {object} cached - The row on screen
' @param {object} fresh - The row that just landed
' @return {boolean} true when the cached row stays
function keepCachedCards(cached as dynamic, fresh as object) as boolean
    if not isValid(cached) or not cached.hasField("fromCache") or cached.fromCache <> true then return false
    count = fresh.getChildCount()
    if count = 0 or count <> cached.getChildCount() then return false
    ' Compared with what was painted rather than the saved file, which a run that timed out may have
    ' rewritten since
    if cached.cacheSig = "" or fresh.getChild(0).cacheSig <> cached.cacheSig then return false

    for i = 0 to count - 1
        cachedCard = cached.getChild(i)
        freshCard = fresh.getChild(i)
        if cachedCard.labelId <> freshCard.labelId then cachedCard.labelId = freshCard.labelId
        if cachedCard.PlayedPercentage <> freshCard.PlayedPercentage then cachedCard.PlayedPercentage = freshCard.PlayedPercentage
    end for
    cached.fromCache = false
    return true
end function

' queueLabels: Collects the labelIds of the cards in the rows a flush added, and asks Home for their labels
'
' @param {object} rows - The rows the flush put in
sub queueLabels(rows as object)
    for each row in rows
        ' A cached row is replaced by a fresh one soon, so its cards are not worth asking for
        if row.hasField("fromCache") and row.fromCache = true then continue for
        for each child in row.getChildren(-1, 0)
            if not child.hasField("labelId") then continue for
            id = child.labelId
            if id = "" then continue for
            if m.labelNodes.DoesExist(id)
                ' Already asked for, or waiting for the next request. Its answer covers this card too
                waiting = m.labelNodes[id]
                waiting.push(child)
            else
                m.labelNodes[id] = [child]
                m.labelIdsWaiting.push(id)
            end if
        end for
    end for
    startLabels()
end sub

' startLabels: Asks Home for the labels of the ids waiting, unless a request is still out. Its answer
' starts the next one. A request is out until its answer clears labelIdsAsked, even once the task has
' stopped, so a new one never replaces the ids still waiting for that answer.
sub startLabels()
    if m.labelIdsWaiting.count() = 0 or m.labelIdsAsked.count() > 0 then return

    m.labelIdsAsked = m.labelIdsWaiting
    m.labelIdsWaiting = []
    m.labelsTask.itemIds = m.labelIdsAsked
    m.labelsTask.control = "RUN"
end sub

' onLabelsTaskState: Puts the labels a request brought back on the cards waiting for them
'
' @param {dynamic} msg - The labels task's state change
sub onLabelsTaskState(msg as object)
    state = msg.getData()
    if state <> "stop" and state <> "done" then return
    ' A stop from an earlier request can arrive while a newer one runs. That one answers for itself.
    if m.labelsTask.state = "run" or m.labelIdsAsked.count() = 0 then return

    found = m.labelsTask.labels
    applied = 0
    for each id in m.labelIdsAsked
        if not m.labelNodes.DoesExist(id) then continue for
        waiting = m.labelNodes[id]
        m.labelNodes.Delete(id)
        if isValid(found)
            if found.DoesExist(id)
                for each node in waiting
                    node.posterLabels = found[id]
                    applied++
                end for
            end if
        end if
    end for
    m.labelIdsAsked = []

    startLabels()
end sub

' sortHomeRows: Sorts all home rows based on their settings-configured order
'
sub sortHomeRows()
    if not isValid(m.top.content) then return

    children = m.top.content.getChildren(-1, 0)
    numChildren = children.count()
    if numChildren <= 1 then return

    ' Resolve the section names and localized titles once so scoring stays cheap
    matchers = buildSectionMatchers()

    ' Score every row once rather than recomputing during each comparison. Each library's row shares
    ' its section's place, so the library order this build read breaks the tie. A cached row from
    ' before the libraries came back keeps its saved place until then.
    indexes = []
    for each child in children
        index = getOriginalSettingIndexForNode(child, matchers) * 1000
        libraryOrder = m.libraryRowOrder[child.title]
        if isValid(libraryOrder) then index += libraryOrder
        indexes.push(index)
    end for

    ' Stable insertion sort based on settings index
    for i = 1 to numChildren - 1
        keyNode = children[i]
        keyIndex = indexes[i]
        j = i - 1
        while j >= 0
            if indexes[j] > keyIndex
                children[j + 1] = children[j]
                indexes[j + 1] = indexes[j]
                j = j - 1
            else
                exit while
            end if
        end while
        children[j + 1] = keyNode
        indexes[j + 1] = keyIndex
    end for

    ' Rebuilding the row list drops focus, so only do it when the order actually changed
    existingChildren = m.top.content.getChildren(-1, 0)
    orderChanged = false
    for i = 0 to numChildren - 1
        if not existingChildren[i].isSameNode(children[i])
            orderChanged = true
            exit for
        end if
    end for
    if not orderChanged then return

    m.top.content.removeChildren(children)
    m.top.content.appendChildren(children)
end sub

' buildSectionMatchers: Collects everything needed to match a row against the configured sections
'
' @return {object} the configured section names plus the localized titles and prefixes rows use
function buildSectionMatchers() as object
    sectionNames = []
    for i = 0 to homeSectionCount() - 1
        sectionNames.push(getResolvedSectionName(i))
    end for

    matchers = {
        sectionNames: sectionNames,
        ' Rows built from a library name carry a localized prefix rather than an exact title
        titlePrefixes: {
            latestmedia: LCase(tr("Recently Added in")).Replace(" ", ""),
            recentlyreleased: LCase(tr("Recently Released in")).Replace(" ", "")
        },
        ' Some rows carry no id, so they can only be matched on their localized title
        localizedTitles: {
            collections: LCase(tr("Collections")).Replace(" ", ""),
            genres: LCase(tr("Genres")).Replace(" ", ""),
            playlists: LCase(tr("Playlists")).Replace(" ", ""),
            audio: LCase(tr("Audio")).Replace(" ", ""),
            favorites: LCase(tr("Favorites")).Replace(" ", ""),
            mylist: LCase(tr("My List")).Replace(" ", ""),
            nextup: LCase(tr("Next Up")).Replace(" ", ""),
            resume: LCase(tr("Continue Watching")).Replace(" ", ""),
            resumeaudio: LCase(tr("Continue Listening")).Replace(" ", ""),
            smalllibrarytiles: LCase(tr("My Media")).Replace(" ", "")
        }
    }
    matchers.localizedTitles[onNowSection()] = LCase(tr("On Now")).Replace(" ", "")
    return matchers
end function

' onNowSection: The section that draws the On Now row. A standalone On Now section takes it over from Live TV.
'
' @return {string} "onnow" when that section is on the home screen, otherwise "livetv"
function onNowSection() as string
    for i = 0 to homeSectionCount() - 1
        if getResolvedSectionName(i) = "onnow" then return "onnow"
    end for
    return "livetv"
end function

' getOriginalSettingIndexForNode: Helper function to get the user configuration index of a row
'
' @param {object} node - The HomeRow node we're checking
' @param {object} matchers - The section matchers from buildSectionMatchers
' @return {integer} index of the row setting (0 to 7) or 99 if not found
function getOriginalSettingIndexForNode(node as object, matchers as object) as integer
    if node = invalid then return 99

    nodeId = LCase(node.id).Replace(" ", "")
    ' Watch Parties shows only while there are rooms, and always first, like the other clients
    if nodeId = "watch_parties" then return -1
    nodeTitle = LCase(node.title).Replace(" ", "")
    titlePrefixes = matchers.titlePrefixes
    localizedTitles = matchers.localizedTitles

    for i = 0 to matchers.sectionNames.Count() - 1
        settingSectionName = matchers.sectionNames[i]

        if settingSectionName = nodeId
            return i
        end if

        prefix = titlePrefixes[settingSectionName]
        if isValid(prefix)
            if Left(nodeTitle, prefix.Len()) = prefix
                return i
            end if
            continue for
        end if

        localizedTitle = localizedTitles[settingSectionName]
        if isValid(localizedTitle) and nodeTitle = localizedTitle
            return i
        end if
    end for

    return 99
end function

' removeHomeSection: Removes a home section from the home rows
'
' @param {string} sectionToRemove - Title property of section we're removing
sub removeHomeSection(sectionTitleToRemove as string)
    if not isValid(sectionTitleToRemove) then return

    sectionTitle = LCase(sectionTitleToRemove).Replace(" ", "")
    m.emptySections[sectionTitle] = true
    ' A row that loaded and then came back empty in the same build is not added after all
    for i = m.pendingRows.count() - 1 to 0 step -1
        if LCase(m.pendingRows[i].sectionName).Replace(" ", "") = sectionTitle then m.pendingRows.delete(i)
    end for
    ' A row that was never on screen leaves the layout as it is, but may still be the build's last answer
    if not sectionExists(sectionTitle)
        finishIfAllRowsIn()
        return
    end if

    sectionIndexToRemove = getSectionIndex(sectionTitle)

    m.top.content.removeChildIndex(sectionIndexToRemove)
    setRowItemSize()
end sub

' setRowItemSize: Sizes every row's cards the way Core does for the account's card size and each
' row's image type. A row is as tall as its tallest card.
'
sub setRowItemSize()
    if not isValid(m.top.content) then return

    if not isValid(m.cardSizeName) then return
    modern = m.modernRows
    sizeName = m.cardSizeName
    captionRoom = CLASSIC_CAPTION_ROOM
    if modern then captionRoom = MODERN_CAPTION_ROOM
    sizes = []
    heights = []
    variable = []
    ' Classic rows that grow the focused card keep room above and beside it, as Seerr Discover does
    grows = growsClassicHomeCards()
    spacings = []
    focusOffsets = []
    anyVariable = false
    for each row in m.top.content.getChildren(-1, 0)
        if row.getChildCount() > 0 then m.emptySections.Delete(LCase(row.title).Replace(" ", ""))
        layOutRow(row, modern, sizeName)
        room = captionRoom
        if row.modernCards then room = m.infoRoom
        if row.carousel then room = CAROUSEL_ROOM
        sizes.push(row.cursorSize)
        if grows
            room += homeCards.GrowRoom(row.cursorSize[1])
            spacings.push([HOME_CARD_GAP + homeCards.GrowGap(row.cursorSize[0]), 0])
            focusOffsets.push(homeCards.GROW_MARGIN)
        end if
        heights.push(ROW_TITLE_BAND + room + row.cursorSize[1])
        variable.push(row.variableWidth)
        if row.variableWidth then anyVariable = true
    end for

    ' Each write lays the whole list out again, so only what changed goes in
    if FormatJson(sizes) <> FormatJson(m.top.rowItemSize) then m.top.rowItemSize = sizes
    if FormatJson(heights) <> FormatJson(m.top.rowHeights) then m.top.rowHeights = heights
    if grows
        if FormatJson(spacings) <> FormatJson(m.top.rowItemSpacing) then m.top.rowItemSpacing = spacings
        if FormatJson(focusOffsets) <> FormatJson(m.top.focusXOffset) then m.top.focusXOffset = focusOffsets
        if m.top.rowLabelOffset[0][0] <> homeCards.GROW_MARGIN then m.top.rowLabelOffset = [[homeCards.GROW_MARGIN, m.top.rowLabelOffset[0][1]]]
    end if
    if anyVariable then m.variableWidthUsed = true
    if m.variableWidthUsed = true and FormatJson(variable) <> FormatJson(m.top.variableWidthItems) then m.top.variableWidthItems = variable
    fitRowCount()
    finishIfAllRowsIn()
end sub

' If we have processed the expected number of content rows, stop the loading timer and run the complete function.
' Library rows still out keep the build open until they land, and so do rows waiting to be added.
sub finishIfAllRowsIn()
    if m.expectedRowCount = m.processedRowCount and not m.librariesPending and m.pendingRows.count() = 0
        m.loadingTimer.control = "stop"
        loadingTimerComplete()
        finishBuild("all rows")
    end if
end sub

' The list clips to its first numRows rows, so short rows keep one more to reach the bottom of the
' screen, where Core shows the next row's title. Home moves the rows when the media bar steps aside.
sub fitRowCount()
    reach = 1080 - m.top.translation[1]
    spacing = m.top.itemSpacing[1]
    shown = 0
    for each rowHeight in m.top.rowHeights
        if reach <= 0 then exit for
        shown++
        reach -= rowHeight + spacing
    end for
    if shown < 2 then shown = 2
    if m.top.numRows <> shown then m.top.numRows = shown
end sub

' Gives a row's cards their size and the art to show. Modern cards are posters at the portrait height,
' and My Media's static cards are 16:9 at that height.
sub layOutRow(row as object, modern as boolean, sizeName as string)
    laidOutFor = `${sizeName}|${modern}|${m.carouselRows}|${row.getChildCount()}`
    if row.laidOutFor = laidOutFor then return

    items = row.getChildren(-1, 0)
    rowId = row.id
    audioRow = rowId = "audio" or rowId = "resumeaudio"
    musicRow = audioRow or isMusicOnlyRow(rowId, items)
    ' Core keeps music rows square in Modern, and their focused card doesn't widen
    row.modernCards = modern and not musicRow and useModernCardsForRow(rowId)
    ' My Media keeps plain Modern cards
    row.carousel = row.modernCards and m.carouselRows = true and rowId <> "smalllibrarytiles"
    fixedBox = invalid
    if row.modernCards
        imageType = "poster"
        fixedBox = homeCards.CardBox(sizeName, 2 / 3)
    else if modern and rowId = "smalllibrarytiles"
        imageType = "thumb"
        fixedBox = homeCards.CardBox(sizeName, 16 / 9, true)
    else
        imageType = homeCards.RowImageType(rowId, musicRow)
    end if

    ' A row of same sized cards keeps their size, and only a row of mixed ones sizes each card, since
    ' writing to hundreds of cards is slow. A card's shape only depends on its type.
    cell = fixedBox
    variableWidth = false
    boxes = []
    if not isValid(cell)
        typeBoxes = {}
        for each item in items
            cardBox = typeBoxes[item.type]
            if not isValid(cardBox)
                cardBox = homeCards.CardBox(sizeName, homeCards.AspectFor(item.type, rowId, audioRow, imageType))
                typeBoxes[item.type] = cardBox
            end if
            boxes.push(cardBox)
            if not isValid(cell)
                cell = [cardBox[0], cardBox[1]]
            else
                if cardBox[0] <> cell[0] or cardBox[1] <> cell[1] then variableWidth = true
                if cardBox[1] > cell[1] then cell[1] = cardBox[1]
            end if
        end for
    end if
    if variableWidth
        for i = 0 to items.count() - 1
            items[i].setFields({ imageWidth: boxes[i][0], imageHeight: boxes[i][1], FHDItemWidth: boxes[i][0] })
        end for
    end if
    if not isValid(cell) then cell = homeCards.CardBox(sizeName, homeCards.AspectFor("", rowId, audioRow, imageType))

    row.imageType = imageType
    row.cursorSize = cell
    row.variableWidth = variableWidth
    row.laidOutFor = laidOutFor
end sub

' Core draws a Recently Added row of nothing but music as square posters
function isMusicOnlyRow(rowId as string, items as object) as boolean
    if rowId <> "latestmedia" or items.count() = 0 then return false
    for each item in items
        if not inArray(["audio", "musicalbum", "musicartist"], item.type) then return false
    end for
    return true
end function

' loadingTimerComplete: Event handler for when loading wait time has expired
'
sub loadingTimerComplete()
    ' Signal that content has been loaded
    m.top.contentLoaded = true
end sub


' addHomeSection: Adds a new home section to the home rows.
'
' @param {string} sectionType - Type of section to add
' @return {boolean} indicating if the section was handled
function addHomeSection(sectionType as string) as boolean
    ' Favorites, collections, genres, playlists and audio are opt in, so skip them
    ' unless their toggle is on. This keeps the row and the section picker in agreement.
    if not internalRowEnabled(sectionType)
        m.processedRowCount++
        return false
    end if

    mergeContinueWatching = kidsMode.MergesContinueWatching(isStringEqual(get_user_setting("ui.home.mergeContinueWatchingNextUp"), "true"))

    if sectionType = "livetv" or sectionType = "onnow"
        if sectionType <> onNowSection()
            m.processedRowCount++
            return false
        end if
        createLiveTVRow()
        return true
    end if

    ' Poster size library items
    if sectionType = "smalllibrarytiles"
        createLibraryRow()
        return true
    end if

    ' Continue Watching items - handle merge logic
    if sectionType = "resume"
        if mergeContinueWatching
            loadMergedContinueWatchingRow()
        else
            ' Create separate Continue Watching row
            createContinueWatchingRow()
        end if
        return true
    end if

    ' Continue Watching items
    if sectionType = "resumeaudio"
        createContinueListeningRow()
        return true
    end if

    ' Next Up items - skip if merged with Continue Watching
    if sectionType = "nextup"
        if mergeContinueWatching
            loadMergedContinueWatchingRow()
        else
            ' Create separate Next Up row
            createNextUpRow()
        end if
        return true
    end if

    ' Latest items in each library
    if sectionType = "latestmedia"
        createLatestInRows()
        return true
    end if

    ' Recently Released items
    if sectionType = "recentlyreleased"
        if isMultiServerEnabled()
            sessions = getAllServerSessions()
            if sessions.count() > 0
                createMultiServerRecentlyReleasedRow(sessions)
                return true
            end if
        end if
        createRecentlyReleasedRow()
        return true
    end if

    ' Favorite Items
    if sectionType = "favorites"
        if isMultiServerEnabled()
            sessions = getAllServerSessions()
            if sessions.count() > 0
                createMultiServerFavoritesRow(sessions)
                return true
            end if
        end if
        createFavoritesRow()
        return true
    end if

    ' My List Items
    if sectionType = "mylist"
        createMyListRow()
        return true
    end if

    ' The merged row is built by the radarr side, so sonarr has nothing left to add
    if sectionType = "sonarr_calendar" and calendarsMerged()
        m.processedRowCount++
        return false
    end if

    internalTaskKey = internalRowTaskKey(sectionType)
    if internalTaskKey <> ""
        createInternalRow(internalTaskKey)
        return true
    end if

    ' Since You Watched recommendation rows
    seedIndex = homeRowLayout.SeedRowIndex(sectionType)
    if seedIndex > 0
        createSinceYouWatchedRow(seedIndex)
        return true
    end if

    ' Rewatch items the user has finished
    if sectionType = "rewatch"
        createRewatchRow()
        return true
    end if

    ' Section names arrive lowercased from settings, so match the prefix case-insensitively
    lowerSectionType = LCase(sectionType)
    if lowerSectionType = "seasonal" or lowerSectionType = "mdblist_watching_now" or isValid(homeRowLayout.ExternalChart(lowerSectionType)) or lowerSectionType.startsWith("imdb_") or lowerSectionType.startsWith("tmdb_") or lowerSectionType.startsWith("seerr_") or lowerSectionType.startsWith("plugindynamic:")
        return createCustomDynamicRow({ id: sectionType })
    end if

    ' Featured Media Carousel - now handled by separate toggle in Moonfin settings
    ' Skip creating a row for it, as it's controlled by ui.home.mediaBarEnabled
    if sectionType = "featuredmedia"
        m.processedRowCount++
        return false
    end if

    ' This section type isn't supported.
    ' Count it as processed since we aren't going to do anything else with it
    m.processedRowCount++
    return false
end function


' createLibraryRow: Creates a row displaying the user's libraries
'
sub createLibraryRow()
    m.processedRowCount++
    ' Ensure we have data. No libraries means no row, so the placeholder goes too.
    if not isValidAndNotEmpty(m.libraryData)
        removeHomeSection(tr("My Media"))
        return
    end if

    sectionName = tr("My Media")

    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName

    excludeList = []
    if isValid(m.global.session.user.configuration) and isValid(m.global.session.user.configuration.MyMediaExcludes)
        excludeList = m.global.session.user.configuration.MyMediaExcludes
    end if
    filteredMedia = kidsMode.KeepLibraries(filterNodeArray(m.libraryData, "id", excludeList))
    for each item in filteredMedia
        row.appendChild(item)
    end for

    addOrUpdateHomeRow(row, sectionName, "smalllibrarytiles")
end sub

' createLatestInRows: Creates a row displaying latest items in each of the user's libraries
'
sub createLatestInRows()
    multiServerEnabled = isMultiServerEnabled()

    if multiServerEnabled
        sessions = getAllServerSessions()

        if sessions.count() > 0
            createMultiServerLatestRows(sessions)
            return
        end if
    end if

    ' Ensure we have data
    if not isValidAndNotEmpty(m.libraryData)
        return
    end if


    ' create a Recently Added row for each library (or merged by type)
    if get_user_setting_bool("ui.home.mergeRecentRowsByType", false)
        groupedLibs = {}
        groupKeys = []
        for each lib in m.filteredLatest
            if not isStringEqual(lib.collectionType, "boxsets") and not isStringEqual(lib.collectionType, "livetv") and not isStringEqual(lib.json.CollectionType, "Program")
                colType = LCase(toNormalizedString(lib.json.CollectionType ?? lib.collectionType ?? "other"))
                if not groupedLibs.DoesExist(colType)
                    groupedLibs[colType] = []
                    groupKeys.push(colType)
                end if
                groupedLibs[colType].push(lib)
            end if
        end for

        for i = 0 to groupKeys.count() - 1
            colType = groupKeys[i]
            libsInGroup = groupedLibs[colType]
            libIds = []
            for each lib in libsInGroup
                libIds.push(lib.id)
            end for

            firstLib = libsInGroup[0]
            sectionName = ""
            if colType = "movies"
                sectionName = `${tr("Recently Added")} ${tr("Movies")}`
            else if colType = "tvshows"
                sectionName = `${tr("Recently Added")} ${tr("TV Shows")}`
            else if colType = "music"
                sectionName = `${tr("Recently Added")} ${tr("Music")}`
            else if libsInGroup.Count() = 1
                sectionName = `${tr("Recently Added in")} ${firstLib.name}`
            else
                sectionName = `${tr("Recently Added")} ${colType}`
            end if

            if not sectionExists(sectionName) and not knownEmpty(sectionName)
                row = m.top.content.CreateChild("HomeRow")
                row.title = sectionName
            end if

            try
                loadLatest = createObject("roSGNode", "LoadItemsTask")
                loadLatest.itemsToLoad = "latest"
                loadLatest.itemIds = libIds
                loadLatest.itemId = firstLib.id

                metadata = { "title": firstLib.name, "contentType": colType, "sectionName": sectionName }
                loadLatest.metadata = metadata
                m.latestRequests[sectionName] = { itemIds: libIds, itemId: firstLib.id, metadata: metadata }

                m.libraryRowOrder[sectionName] = i
                loadLatest.cacheRow = cacheRowFor("latestmedia", sectionName, i)
                runRowTask(loadLatest, "content", "updateLatestItems")
            catch e
                removeHomeSection(sectionName)
                m.global.sceneManager.callFunc("standardDialog", `Error creating Recently Added rows`, { data: ["<p>" + `Error Message: ${e.message}` + "</p>"] })
            end try
        end for
        return
    end if

    for i = 0 to m.filteredLatest.count() - 1
        lib = m.filteredLatest[i]
        if not isStringEqual(lib.collectionType, "boxsets") and not isStringEqual(lib.collectionType, "livetv") and not isStringEqual(lib.json.CollectionType, "Program")
            sectionName = `${tr("Recently Added in")} ${lib.name}`

            if not sectionExists(sectionName) and not knownEmpty(sectionName)
                row = m.top.content.CreateChild("HomeRow")
                row.title = sectionName
            end if

            try
                loadLatest = createObject("roSGNode", "LoadItemsTask")
                loadLatest.itemsToLoad = "latest"
                loadLatest.itemId = lib.id

                metadata = { "title": lib.name }
                metadata.Append({ "contentType": lib.json.CollectionType, "sectionName": sectionName })
                loadLatest.metadata = metadata
                m.latestRequests[sectionName] = { itemIds: [], itemId: lib.id, metadata: metadata }

                m.libraryRowOrder[sectionName] = i
                loadLatest.cacheRow = cacheRowFor("latestmedia", sectionName, i)
                runRowTask(loadLatest, "content", "updateLatestItems")
            catch e
                removeHomeSection(sectionName)
                m.global.sceneManager.callFunc("standardDialog", `Error creating Recently Added rows`, { data: ["<p>" + `Error Message: ${e.message}` + "</p>"] })
            end try
        end if
    end for
end sub

' createRecentlyReleasedRow: Creates a row displaying recently released items sorted by premiere date
'
sub createRecentlyReleasedRow()
    ' create a Recently Added in row for each library
    for i = 0 to m.filteredLatest.count() - 1
        lib = m.filteredLatest[i]
        if not isStringEqual(lib.collectionType, "boxsets") and not isStringEqual(lib.collectionType, "livetv") and not isStringEqual(lib.json.CollectionType, "Program")
            sectionName = `${tr("Recently Released in")} ${lib.name}`

            if not sectionExists(sectionName) and not knownEmpty(sectionName)
                row = m.top.content.CreateChild("HomeRow")
                row.title = sectionName
            end if

            try
                loadLatest = createObject("roSGNode", "LoadItemsTask")
                loadLatest.itemsToLoad = "recentlyReleased"
                loadLatest.itemId = lib.id

                metadata = { "title": lib.name }
                metadata.Append({ "contentType": lib.json.CollectionType })
                loadLatest.metadata = metadata

                m.libraryRowOrder[sectionName] = i
                loadLatest.cacheRow = cacheRowFor("recentlyreleased", sectionName, i)
                runRowTask(loadLatest, "content", "updateRecentlyReleasedItems")
            catch e
                removeHomeSection(sectionName)
                m.global.sceneManager.callFunc("standardDialog", `Error creating Recently Released rows`, { data: ["<p>" + `Error Message: ${e.message}` + "</p>"] })
            end try
        end if
    end for
end sub

' createSinceYouWatchedRow: The index picks which recently watched item seeds the row
sub createSinceYouWatchedRow(rowIndex as integer)
    removeHomeRowById(homeRowLayout.SEED_ROW_PREFIX + rowIndex.ToStr())

    task = createObject("roSGNode", "LoadItemsTask")
    task.itemsToLoad = "sinceYouWatched"
    task.metadata = { rowIndex: rowIndex }
    runRowTask(task, "content", "updateSinceYouWatchedItems")
end sub

function homeRowIndexById(rowId as string) as integer
    if not isValid(m.top.content) then return -1
    for i = 0 to m.top.content.getChildCount() - 1
        if isStringEqual(m.top.content.getChild(i).id, rowId) then return i
    end for
    return -1
end function

' removeHomeRowById: A seed row is titled after whatever seeded it, so a rebuild onto a
' different seed has to find the old one by id or it would be left behind
sub removeHomeRowById(rowId as string)
    ' A row still waiting for the flush under this id would otherwise be added after the removal
    for i = m.pendingRows.count() - 1 to 0 step -1
        pending = m.pendingRows[i]
        if isStringEqual(pending.key, rowId) or isStringEqual(pending.row.id, rowId) then m.pendingRows.delete(i)
    end for

    if not isValid(m.top.content) then return

    for i = m.top.content.getChildCount() - 1 to 0 step -1
        section = m.top.content.getChild(i)
        if isValid(section) and isStringEqual(section.id, rowId)
            m.top.content.removeChildIndex(i)
            setRowItemSize()
            return
        end if
    end for
end sub

' updateSinceYouWatchedItems: Builds a single Since You Watched row from its task
'
' @param {dynamic} msg - LoadItemsTask
sub updateSinceYouWatchedItems(msg)
    m.processedRowCount++

    node = msg.getRoSGNode()
    itemData = node.content
    node.unobserveField("content")
    node.content = []

    if not isValidAndNotEmpty(itemData)
        setRowItemSize()
        return
    end if

    seedName = ""
    if isValid(node.metadata) and isValid(node.metadata.seedName) then seedName = node.metadata.seedName
    if not isValidAndNotEmpty(seedName)
        setRowItemSize()
        return
    end if

    sectionName = tr("Since you watched %1").Replace("%1", seedName)

    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName

    for each item in itemData
        row.appendChild(item)
    end for

    rowIndex = isValid(node.metadata.rowIndex) ? node.metadata.rowIndex : 1
    addOrUpdateHomeRow(row, sectionName, homeRowLayout.SEED_ROW_PREFIX + rowIndex.ToStr())
end sub

' createRewatchRow: Creates a row of movies, shows, and collections the user has finished
'
sub createRewatchRow()
    sectionName = tr("Rewatch")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    task = getOrCreateTask("rewatch")
    runRowTask(task, "content", "updateRewatchItems")
end sub

' updateRewatchItems: Processes LoadItemsTask content for the Rewatch row
'
sub updateRewatchItems()
    m.processedRowCount++
    itemData = getTaskContentAndCleanup("rewatch")

    sectionName = tr("Rewatch")

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName

    for each item in itemData
        row.appendChild(item)
    end for

    addOrUpdateHomeRow(row, sectionName, "rewatch")
end sub

' A section that came back empty last time keeps its placeholder off, so it doesnt flash on every
' load. It's still asked for each time and shows up once it has something.
function knownEmpty(sectionName as string) as boolean
    return m.emptySections.DoesExist(LCase(sectionName).Replace(" ", ""))
end function

' sectionExists: Checks if passed section exists in home row content
'
' @param {string} sectionTitle - Title of section we're checking for
' @param {string} rowId - The row's setting key, when the caller knows it
'
' @return {boolean} indicating if the section currently exists in the home row content
function sectionExists(sectionTitle as string, rowId = "" as string) as boolean
    if not isAllValid([sectionTitle, m.top.content]) then return false

    searchSectionTitle = LCase(sectionTitle).Replace(" ", "")

    homeSections = m.top.content.getChildren(-1, 0)

    for each section in homeSections
        if sectionMatches(section, searchSectionTitle, rowId)
            return true
        end if
    end for

    return false
end function

' getSectionIndex: Returns index of requested section in home row content
'
' @param {string} sectionTitle - Title of section we're checking for
' @param {string} rowId - The row's setting key, when the caller knows it
'
' @return {integer} indicating index of request section
function getSectionIndex(sectionTitle as string, rowId = "" as string) as integer
    if not isAllValid([sectionTitle, m.top.content]) then return -1

    searchSectionTitle = LCase(sectionTitle).Replace(" ", "")

    homeSections = m.top.content.getChildren(-1, 0)

    sectionIndex = homeSections.count()
    i = 0

    for each section in homeSections
        if sectionMatches(section, searchSectionTitle, rowId)
            sectionIndex = i
            exit for
        end if
        i++
    end for

    return sectionIndex
end function

' Two rows can share a title, such as the seasonal row and a picked collection of the same
' name, so a row named by its key only matches its own. Several rows share a key too, the
' recently added ones among them, and a placeholder has none, so the title still has to agree.
function sectionMatches(section as object, searchSectionTitle as string, rowId as string) as boolean
    if LCase(section.title).Replace(" ", "") <> searchSectionTitle then return false
    if rowId = "" or not isValidAndNotEmpty(section.id) then return true
    return isStringEqual(section.id, rowId)
end function

' createLiveTVRow: Creates a row displaying the live tv now on section
'
sub createLiveTVRow()
    sectionName = tr("On Now")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    ' Load the On Now Data (lazy task creation)
    task = getOrCreateTask("onNow")
    runRowTask(task, "content", "updateOnNowItems")
end sub

' createContinueWatchingRow: Creates a row displaying items the user can continue watching
'
sub createContinueWatchingRow()
    sectionName = tr("Continue Watching")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    if isMultiServerEnabled() and hasMultipleLoggedInServers()
        createMultiServerContinueWatchingRow()
        return
    end if

    ' Load the Continue Watching Data (lazy task creation)
    task = getOrCreateTask("continue")
    task.cacheRow = cacheRowFor("resume", sectionName)
    runRowTask(task, "content", "updateContinueWatchingItems", true)
end sub

' createMultiServerContinueWatchingRow: Creates a row with continue watching from all servers
'
sub createMultiServerContinueWatchingRow()
    sessions = getAllServerSessions()
    if sessions.count() = 0
        task = getOrCreateTask("continue")
        task.cacheRow = cacheRowFor("resume", tr("Continue Watching"))
        runRowTask(task, "content", "updateContinueWatchingItems", true)
        return
    end if

    taskKey = "multiServerContinue"
    if not m.multiServerTasks.DoesExist(taskKey)
        task = CreateObject("roSGNode", "MultiServerTask")
        m.multiServerTasks[taskKey] = task
    else
        task = m.multiServerTasks[taskKey]
        task.callFunc("reset")
    end if

    task.sessions = sessions
    task.endpoint = "/UserItems/Resume"
    task.params = {
        UserId: "{userId}",
        Recursive: "true",
        SortBy: "DatePlayed",
        SortOrder: "Descending",
        Filters: "IsResumable",
        MediaTypes: "Video",
        EnableTotalRecordCount: "false",
        Limit: "25",
        EnableImageTypes: "Primary,Backdrop,Thumb",
        ImageTypeLimit: "1"
    }
    runRowTask(task, "isComplete", "onMultiServerContinueWatchingComplete", true)
end sub

' onMultiServerContinueWatchingComplete: Handler for multi-server continue watching results
'
sub onMultiServerContinueWatchingComplete()
    m.processedRowCount++
    taskKey = "multiServerContinue"
    if not m.multiServerTasks.DoesExist(taskKey) then return

    task = m.multiServerTasks[taskKey]
    task.unobserveField("isComplete")

    sectionName = tr("Continue Watching")
    results = task.results

    if not isValidAndNotEmpty(results)
        removeHomeSection(sectionName)
        return
    end if

    ' Sort by DatePlayed across all servers
    sortedResults = sortMultiServerResultsByDate(results, "UserData.LastPlayedDate")

    ' Create HomeData nodes from aggregated results
    row = CreateObject("roSGNode", "HomeRow")
    row.id = "resume"
    row.title = sectionName

    showServerName = hasMultipleLoggedInServers()

    for each item in sortedResults
        tmp = createHomeDataFromMultiServerItem(item, showServerName)
        if isValid(tmp)
            if isChainValid(item, "UserData.PlayedPercentage")
                tmp.PlayedPercentage = item.UserData.PlayedPercentage
            end if
            row.appendChild(tmp)
        end if
    end for

    ' Insert or replace row
    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
    else
        m.top.content.insertChild(row, getOriginalSectionIndex("resume"))
    end if
    setRowItemSize()
end sub

function mergedRowTitle() as string
    return tr("Continue Watching & Next Up")
end function

' Both sections feed the merged row, so whichever comes first loads it. It reloads on every pass,
' or a refresh would keep showing the old row.
sub loadMergedContinueWatchingRow()
    if m.mergedRowLoading = true
        ' The second section shares the merged row, so it has nothing of its own to wait for
        m.processedRowCount++
        return
    end if
    m.mergedRowLoading = true
    createMergedContinueWatchingRow()
end sub

' createMergedContinueWatchingRow: Creates a row displaying merged Continue Watching and Next Up items
'
sub createMergedContinueWatchingRow()
    sectionName = mergedRowTitle()

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        ' The merged title isnt one the sort can match, so the placeholder is found by its id
        row.id = "resume"
        row.title = sectionName
    end if

    ' Load the Merged Continue Watching Data (lazy task creation)
    task = getOrCreateTask("mergedContinueWatching")
    task.cacheRow = cacheRowFor("resume", sectionName)
    runRowTask(task, "content", "updateMergedContinueWatchingItems", true)
end sub

' createContinueListeningRow: Creates a row displaying items the user can continue listening
'
sub createContinueListeningRow()
    sectionName = tr("Continue Listening")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    ' Load the Continue Listening Data (lazy task creation)
    task = getOrCreateTask("continueListening")
    task.cacheRow = cacheRowFor("resumeaudio", sectionName)
    runRowTask(task, "content", "updateContinueListeningItems")
end sub

' createNextUpRow: Creates a row displaying next episodes up to watch
'
sub createNextUpRow()
    sectionName = tr("Next Up")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    if isMultiServerEnabled() and hasMultipleLoggedInServers()
        createMultiServerNextUpRow()
        return
    end if

    task = getOrCreateTask("nextUp")
    task.cacheRow = cacheRowFor("nextup", sectionName)
    runRowTask(task, "content", "updateNextUpItems", true)
end sub

' createMultiServerNextUpRow: Creates a row with next up episodes from all servers
'
sub createMultiServerNextUpRow()
    sessions = getAllServerSessions()
    if sessions.count() = 0
        task = getOrCreateTask("nextUp")
        task.cacheRow = cacheRowFor("nextup", tr("Next Up"))
        runRowTask(task, "content", "updateNextUpItems", true)
        return
    end if

    taskKey = "multiServerNextUp"
    if not m.multiServerTasks.DoesExist(taskKey)
        task = CreateObject("roSGNode", "MultiServerTask")
        m.multiServerTasks[taskKey] = task
    else
        task = m.multiServerTasks[taskKey]
        task.callFunc("reset")
    end if

    ' Configure task for Next Up endpoint
    task.sessions = sessions
    task.endpoint = "/Shows/NextUp"
    task.params = {
        Recursive: "true",
        SortBy: "DatePlayed",
        SortOrder: "Descending",
        ImageTypeLimit: "1",
        UserId: "{userId}",
        DisableFirstEpisode: "false",
        Limit: "25",
        EnableTotalRecordCount: "false",
        EnableImageTypes: "Primary,Backdrop,Thumb"
    }
    runRowTask(task, "isComplete", "onMultiServerNextUpComplete", true)
end sub

' onMultiServerNextUpComplete: Handler for multi-server next up results
'
sub onMultiServerNextUpComplete()
    m.processedRowCount++
    taskKey = "multiServerNextUp"
    if not m.multiServerTasks.DoesExist(taskKey) then return

    task = m.multiServerTasks[taskKey]
    task.unobserveField("isComplete")

    sectionName = tr("Next Up")
    results = task.results

    if not isValidAndNotEmpty(results)
        removeHomeSection(sectionName)
        return
    end if

    ' Sort by DatePlayed across all servers
    sortedResults = sortMultiServerResultsByDate(results, "UserData.LastPlayedDate")

    ' Create HomeData nodes from aggregated results
    row = CreateObject("roSGNode", "HomeRow")
    row.id = "nextup"
    row.title = sectionName

    ' Check if we should show server names
    showServerName = hasMultipleLoggedInServers()

    for each item in sortedResults
        tmp = createHomeDataFromMultiServerItem(item, showServerName)
        if isValid(tmp)
            row.appendChild(tmp)
        end if
    end for

    ' Insert or replace row
    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
    else
        m.top.content.insertChild(row, getOriginalSectionIndex("favorites"))
    end if
    setRowItemSize()
end sub

' createMultiServerLatestRows: Creates "Recently Added in {Library} ({Server})" rows for each library on each server
'
' @param {array} sessions - Array of ServerUserSession objects
sub createMultiServerLatestRows(sessions as object)

    ' Use MultiServerTask to fetch libraries from all servers
    ' This must be done in a Task node, not directly in component code
    for each userSession in sessions
        ' Create a task to fetch libraries for this server
        taskKey = "multiServerLibraries_" + userSession.serverId
        if not m.multiServerTasks.DoesExist(taskKey)
            task = CreateObject("roSGNode", "MultiServerTask")
            m.multiServerTasks[taskKey] = task
        else
            task = m.multiServerTasks[taskKey]
            task.callFunc("reset")
        end if

        ' Configure task to fetch user views (libraries)
        task.sessions = [userSession]
        task.endpoint = "/UserViews"
        task.params = { UserId: "{userId}" }

        ' Store metadata for callback
        task.addFields({
            metadata: {
                userSession: userSession
            }
        })

        task.observeField("isComplete", "onMultiServerLibrariesLoaded")
        m.multiServerEstimates[userSession.serverId] = true
        task.control = "RUN"
    end for

end sub

' Swaps the server's estimate for the rows it really started, once per build, since a late answer
' from an earlier build can land in this one
sub settleMultiServerEstimate(serverId as string, started as integer)
    if not m.multiServerEstimates.DoesExist(serverId) then return
    m.multiServerEstimates.Delete(serverId)
    m.expectedRowCount += started - MULTI_SERVER_LATEST_ROWS
    finishIfAllRowsIn()
end sub

' onMultiServerLibrariesLoaded: Handler for library list loaded from a server
'
sub onMultiServerLibrariesLoaded(msg as object)
    node = msg.getRoSGNode()
    if not isValid(node)
        return
    end if

    if not isChainValid(node, "metadata.userSession")
        return
    end if

    userSession = node.metadata.userSession

    node.unobserveField("isComplete")

    results = node.results

    if not isValidAndNotEmpty(results)
        settleMultiServerEstimate(userSession.serverId, 0)
        return
    end if

    ' Determine server name suffix
    serverSuffix = ""
    if hasMultipleLoggedInServers() and isValidAndNotEmpty(userSession.serverName)
        serverSuffix = " (" + userSession.serverName + ")"
    end if


    ' Create a row for each library
    started = 0
    for each item in results
        collectionType = ""
        if isValid(item.CollectionType) then collectionType = LCase(item.CollectionType)

        ' Skip boxsets, livetv, and programs
        if collectionType = "boxsets" or collectionType = "livetv" or collectionType = "program"
            continue for
        end if

        libraryName = item.Name
        if not isValidAndNotEmpty(libraryName) then libraryName = "Library"

        sectionName = tr("Recently Added in") + " " + libraryName + serverSuffix

        ' Create placeholder row
        if not sectionExists(sectionName) and not knownEmpty(sectionName)
            latestRow = m.top.content.CreateChild("HomeRow")
            latestRow.title = sectionName
        end if

        ' Create task to load latest items for this library
        taskKey = "multiServerLatest_" + userSession.serverId + "_" + item.Id
        if not m.multiServerTasks.DoesExist(taskKey)
            task = CreateObject("roSGNode", "MultiServerTask")
            m.multiServerTasks[taskKey] = task
        else
            task = m.multiServerTasks[taskKey]
            task.callFunc("reset")
        end if


        ' Configure task for Latest Items endpoint with parentId filter
        task.sessions = [userSession]
        task.endpoint = "/Items/Latest"
        params = {
            UserId: "{userId}",
            Limit: "25",
            ParentId: item.Id,
            EnableImageTypes: "Primary,Backdrop,Thumb",
            ImageTypeLimit: "1",
            EnableTotalRecordCount: "false"
        }
        ' Hide Watched drops some of what comes back, so it asks for four times as many
        if get_user_setting_bool(recentRows.HIDE_WATCHED_SETTING, false) then params.Limit = "100"
        task.params = params

        ' Store metadata for the callback
        task.addFields({
            metadata: {
                sectionName: sectionName,
                collectionType: collectionType,
                serverName: userSession.serverName
            }
        })

        runRowTask(task, "isComplete", "onMultiServerLatestPerLibraryComplete")
        started++
    end for

    settleMultiServerEstimate(userSession.serverId, started)
end sub

' onMultiServerLatestPerLibraryComplete: Handler for per-library per-server latest items
'
sub onMultiServerLatestPerLibraryComplete(msg as object)
    node = msg.getRoSGNode()
    if not isValid(node)
        return
    end if

    ' Get metadata
    if not isChainValid(node, "metadata")
        return
    end if
    metadata = node.metadata

    m.processedRowCount++
    node.unobserveField("isComplete")

    sectionName = metadata.sectionName
    results = node.results
    if get_user_setting_bool(recentRows.HIDE_WATCHED_SETTING, false) then results = recentRows.WithoutWatched(results)


    if not isValidAndNotEmpty(results)
        removeHomeSection(sectionName)
        return
    end if

    ' Sort by DateCreated
    sortedResults = sortMultiServerResultsByDate(results, "DateCreated")

    ' Create the row
    row = CreateObject("roSGNode", "HomeRow")
    row.id = "latestmedia"
    row.title = sectionName

    ' Don't show server name on individual items since it's in the row title
    for each item in sortedResults
        tmp = createHomeDataFromMultiServerItem(item, false)
        if isValid(tmp)
            row.appendChild(tmp)
        end if
    end for


    ' Insert or replace row
    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
    else
        m.top.content.insertChild(row, getOriginalSectionIndex("latestmedia"))
    end if
    setRowItemSize()
end sub


' createMultiServerRecentlyReleasedRow: Creates an aggregated Recently Released row from all servers
'
' @param {array} sessions - Array of ServerUserSession objects
sub createMultiServerRecentlyReleasedRow(sessions as object)
    taskKey = "multiServerRecentlyReleased"
    if not m.multiServerTasks.DoesExist(taskKey)
        task = CreateObject("roSGNode", "MultiServerTask")
        m.multiServerTasks[taskKey] = task
    else
        task = m.multiServerTasks[taskKey]
        task.callFunc("reset")
    end if

    ' Configure task for Recently Released endpoint
    task.sessions = sessions
    task.endpoint = "/Items"
    params = {
        UserId: "{userId}",
        Recursive: "true",
        SortBy: "PremiereDate,ProductionYear,SortName",
        SortOrder: "Descending",
        IncludeItemTypes: "Movie,Series",
        Limit: "50",
        Fields: "PrimaryImageAspectRatio,Genres,Overview,ChildCount,RecursiveItemCount",
        EnableImageTypes: "Primary,Backdrop,Thumb",
        ImageTypeLimit: "1",
        EnableTotalRecordCount: "false"
    }
    if get_user_setting_bool(recentRows.HIDE_WATCHED_SETTING, false) then params.Filters = "IsUnplayed"
    task.params = params
    runRowTask(task, "isComplete", "onMultiServerRecentlyReleasedComplete")
end sub

' onMultiServerRecentlyReleasedComplete: Handler for multi-server recently released results
'
sub onMultiServerRecentlyReleasedComplete()

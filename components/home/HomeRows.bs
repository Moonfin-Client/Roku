    sectionName = tr("Favorites")

    if not sectionExists(sectionName) and not knownEmpty(sectionName)
        row = m.top.content.CreateChild("HomeRow")
        row.title = sectionName
    end if

    ' Load the Favorites Data (lazy task creation)
    task = getOrCreateTask("favorites")
    task.cacheRow = cacheRowFor("favorites", sectionName)
    runRowTask(task, "content", "updateFavoritesItems")

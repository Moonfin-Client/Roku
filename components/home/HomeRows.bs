    node.unobserveField("content")
    node.content = []

    sectionName = tr("Recently Released in") + " " + node.metadata.title

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    ' remake row using new data
    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName

    for each item in itemData
        row.appendChild(item)
    end for

    addOrUpdateHomeRow(row, sectionName, "recentlyreleased")
end sub


' updateOnNowItems: Processes LoadOnNowTask content. Removes, Creates, or Updates Recently Added in on now row as needed
'
sub updateOnNowItems()
    m.processedRowCount++
    itemData = getTaskContentAndCleanup("onNow")

    sectionName = tr("On Now")

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    ' remake row using the new data
    row = CreateObject("roSGNode", "HomeRow")
    row.id = onNowSection()
    row.title = tr("On Now")

    for each item in itemData
        item.usePoster = false

        if (not isValid(item.thumbnailURL) or item.thumbnailURL = "") and isValid(item.json) and isValid(item.json.imageURL)
            item.thumbnailURL = item.json.imageURL
            item.usePoster = true
        end if
        row.appendChild(item)
    end for

    ' Row already exists, replace it with new content
    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
        setRowItemSize()
        return
    end if

    ' Row does not exist, insert it into the home view
    m.top.content.insertChild(row, getOriginalSectionIndex(onNowSection()))
    setRowItemSize()
end sub

sub itemSelected()
    m.selectedRowItem = m.top.rowItemSelected
    item = getRowListItemAt(m.top, m.top.rowItemSelected)
    if isValid(item) and (item.type = "WatchPartyRoom" or item.type = "WatchPartyStart")
        request = { start: item.type = "WatchPartyStart" }
        if item.type = "WatchPartyRoom" then request = { roomId: item.id, hasPin: item.json.HasPin = true }
        m.global.watchParty.callFunc("open", request)
        return
    end if
    if isValid(item) and playsOnSelect(m.top.rowItemSelected[0])
        ' A card an earlier pick left in selectedItem opens again when it changes, so it's let go first
        m.top.selectedItem = invalid
        m.top.quickPlayNode = item
        return
    end if
    ' Force field change notification even for same item by clearing first
    m.top.selectedItem = invalid
    m.top.selectedItem = item
    ' The card's labels can land later, and a node left in the field would open it again
    m.top.selectedItem = invalid
end sub

' Continue Watching and Next Up cards play when picked, if the viewer set them to
function playsOnSelect(rowIndex as integer) as boolean
    if not isValid(m.top.content) or rowIndex < 0 or rowIndex >= m.top.content.getChildCount() then return false
    rowId = m.top.content.getChild(rowIndex).id
    if rowId <> "resume" and rowId <> "nextup" then return false
    return isStringEqual(get_user_setting("ui.home.continueWatchingDefaultAction"), "play")
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if press
        ' The focus position is empty until the rows have content and something is
        ' focused, so an empty one reads as off the grid
        focused = m.top.rowItemFocused
        if not isValid(focused) or focused.count() < 2 then focused = [-1, -1]

        if key = KeyCode.PLAY
            itemToPlay = getRowListItemAt(m.top, focused)
            ' Online recommendation cards arent local items, so they cant quick play
            if isValid(itemToPlay) and isValid(itemToPlay.json) and isValid(itemToPlay.json.SeerrItem)
                return true
            end if
            if isValid(itemToPlay)
                m.top.quickPlayNode = itemToPlay
            end if
            return true
        end if

        if key = KeyCode.UP
            if focused[0] = 0
                return false
            end if
        end if

        ' The focus card steps aside while the rows scroll up or down under it, but stays up
        ' along a row so it crossfades from one item to the next. A press at the bottom cant
        ' move, so the card stays up for that too.
        rowCount = 0
        if isValid(m.top.content) then rowCount = m.top.content.getChildCount()
        currentRow = focused[0]
        if currentRow >= 0 and currentRow < rowCount
            if key = KeyCode.UP or key = KeyCode.DOWN
                atBottom = (key = KeyCode.DOWN) and (currentRow = rowCount - 1)
                if not atBottom then m.top.keyPressedNotifier = not m.top.keyPressedNotifier
            else if key = KeyCode.LEFT or key = KeyCode.RIGHT
                targetCol = focused[1] + 1
                if key = KeyCode.LEFT then targetCol = focused[1] - 1
                if targetCol >= 0 and targetCol < m.top.content.getChild(currentRow).getChildCount()
                    m.top.moveTarget = [currentRow, targetCol]
                end if
            end if
        end if
    end if

    group = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(group)
        group.lastFocus = m.top
    end if
    return false
end function

function filterNodeArray(nodeArray as object, nodeKey as string, excludeArray as object) as object
    if excludeArray.IsEmpty() then return nodeArray

    newNodeArray = []
    for each node in nodeArray
        excludeThisNode = false
        for each exclude in excludeArray
            if node[nodeKey] = exclude
                excludeThisNode = true
            end if
        end for
        if excludeThisNode = false
            newNodeArray.Push(node)
        end if
    end for
    return newNodeArray
end function

' ============================================
' Multi-Server Helper Functions
' ============================================

' createHomeDataFromMultiServerItem: Creates a HomeData node from a multi-server API result
'
' @param {object} item - Raw API result with _serverId, _serverName, _serverUrl metadata
' @param {boolean} showServerName - Whether to append "(ServerName)" to the item name
' @return {object} HomeData node or invalid
function createHomeDataFromMultiServerItem(item as object, showServerName = false as boolean) as object
    if not isValid(item) then return invalid

    tmp = createSGNode("HomeData")

    ' Store the item ID
    itemId = ""
    if isValid(item.Id)
        itemId = item.Id
    else if isValid(item.id)
        itemId = item.id
    end if
    tmp.Id = itemId

    ' Store item name with optional server suffix
    itemName = ""
    if isValid(item.Name)
        itemName = item.Name
    else if isValid(item.name)
        itemName = item.name
    end if

    if showServerName and isValid(item._serverName)
        itemName = itemName + " (" + item._serverName + ")"
    end if
    tmp.name = itemName

    ' Store type
    if isValid(item.Type)
        tmp.type = item.Type
    else if isValid(item.type)
        tmp.type = item.type
    end if

    ' Build the JSON object with server metadata included
    jsonData = {
        Id: itemId,
        name: itemName,
        Type: item.Type,
        _serverId: item._serverId,
        _serverName: item._serverName,
        _serverUrl: item._serverUrl,
        _userId: item._userId,
        _authToken: item._authToken,
        SeriesName: item.SeriesName,
        SeriesId: item.SeriesId,
        SeasonId: item.SeasonId,
        ProductionYear: item.ProductionYear,
        Status: item.Status,
        EndDate: item.EndDate,
        ParentIndexNumber: item.ParentIndexNumber,
        IndexNumber: item.IndexNumber,
        IndexNumberEnd: item.IndexNumberEnd,
        OfficialRating: item.OfficialRating,
        CollectionType: item.CollectionType,
        ImageTags: item.ImageTags,
        UserData: item.UserData,
        ParentThumbItemId: item.ParentThumbItemId,
        ParentThumbImageTag: item.ParentThumbImageTag,
        ParentBackdropImageTags: item.ParentBackdropImageTags,
        ParentBackdropItemId: item.ParentBackdropItemId,
        SeriesPrimaryImageTag: item.SeriesPrimaryImageTag,
        BackdropImageTags: item.BackdropImageTags
    }
    tmp.json = jsonData

    ' Build image URLs using the item's server URL
    if isValidAndNotEmpty(item._serverUrl) and isValidAndNotEmpty(itemId)
        baseUrl = item._serverUrl
        if baseUrl.right(1) = "/"
            baseUrl = baseUrl.left(baseUrl.len() - 1)
        end if

        ' Only Emby artwork needs a token, so check the server type once per card
        emby = isEmbyServer(baseUrl)
        imageToken = ""
        if emby and isValidAndNotEmpty(item._authToken) then imageToken = item._authToken

        ' Build poster URL
        if isValid(item.ImageTags) and isValid(item.ImageTags.Primary)
            tmp.posterURL = multiServerImageURL(baseUrl, itemId, "Primary", { tag: item.ImageTags.Primary, maxWidth: 400 }, emby, imageToken)
        end if

        ' Build thumbnail URL (for episodes, use parent thumb if available)
        if isValid(item.ParentThumbItemId) and isValid(item.ParentThumbImageTag)
            tmp.thumbnailURL = multiServerImageURL(baseUrl, item.ParentThumbItemId, "Thumb", { tag: item.ParentThumbImageTag, maxWidth: 600 }, emby, imageToken)
        else if isValid(item.ImageTags) and isValid(item.ImageTags.Thumb)
            tmp.thumbnailURL = multiServerImageURL(baseUrl, itemId, "Thumb", { tag: item.ImageTags.Thumb, maxWidth: 600 }, emby, imageToken)
        else if isValid(item.ImageTags) and isValid(item.ImageTags.Primary)
            tmp.thumbnailURL = multiServerImageURL(baseUrl, itemId, "Primary", { tag: item.ImageTags.Primary, maxWidth: 600 }, emby, imageToken)
        end if

        ' Wide poster URL and backdrop URL (for full-screen backdrop)
        if isValid(item.BackdropImageTags) and item.BackdropImageTags.count() > 0
            tmp.widePosterURL = multiServerImageURL(baseUrl, itemId, "Backdrop", { tag: item.BackdropImageTags[0], maxWidth: 600 }, emby, imageToken)
            tmp.backdropURL = multiServerImageURL(baseUrl, itemId, "Backdrop", { tag: item.BackdropImageTags[0], maxWidth: 1920, maxHeight: 1080, quality: 90, blur: getHomeBackdropBlurAmount() }, emby, imageToken)
        else if isValid(item.ParentBackdropItemId) and isValid(item.ParentBackdropImageTags) and item.ParentBackdropImageTags.count() > 0
            tmp.widePosterURL = multiServerImageURL(baseUrl, item.ParentBackdropItemId, "Backdrop", { tag: item.ParentBackdropImageTags[0], maxWidth: 600 }, emby, imageToken)
            tmp.backdropURL = multiServerImageURL(baseUrl, item.ParentBackdropItemId, "Backdrop", { tag: item.ParentBackdropImageTags[0], maxWidth: 1920, maxHeight: 1080, quality: 90, blur: getHomeBackdropBlurAmount() }, emby, imageToken)
        end if
    end if

    return tmp
end function

function multiServerImageURL(baseUrl as string, itemId as string, imageType as string, params as object, emby as boolean, token as string) as string
    path = "Items/" + itemId + "/Images/" + imageType
    if isPlexServer(baseUrl) then return buildURLForServer(baseUrl, path, params, "", token)
    if not emby then return buildServerURL(baseUrl, path, params)
    if token <> "" then params.api_key = token
    return buildURLForServer(baseUrl, path, params)
end function

' sortMultiServerResultsByDate: Sorts multi-server results by a date field (descending)
'
' @param {array} results - Array of items from multiple servers
' @param {string} dateField - Dot-notation path to date field (e.g., "UserData.LastPlayedDate")
' @return {array} Sorted array
function sortMultiServerResultsByDate(results as object, dateField as string) as object
    if not isValidAndNotEmpty(results) then return []

    ' Convert to array with sortable date values
    sortableItems = []
    for each item in results
        dateValue = getNestedValue(item, dateField)
        sortableItems.push({
            item: item,
            sortDate: dateValue
        })
    end for

    ' Simple bubble sort (sufficient for small arrays)
    n = sortableItems.count()
    for i = 0 to n - 2
        for j = 0 to n - i - 2
            ' Compare dates (ISO strings compare correctly alphabetically for descending)
            date1 = sortableItems[j].sortDate
            date2 = sortableItems[j + 1].sortDate

            ' Handle invalid dates
            if not isValid(date1) then date1 = ""
            if not isValid(date2) then date2 = ""

            ' Swap if date1 < date2 (we want descending order)
            if date1 < date2
                temp = sortableItems[j]
                sortableItems[j] = sortableItems[j + 1]
                sortableItems[j + 1] = temp
            end if
        end for
    end for

    ' Extract sorted items
    sortedResults = []
    for each sortable in sortableItems
        sortedResults.push(sortable.item)
    end for

    return sortedResults
end function

' getNestedValue: Gets a value from a nested object using dot notation
'
' @param {object} obj - Object to search
' @param {string} path - Dot-notation path (e.g., "UserData.LastPlayedDate")
' @return {dynamic} Value at path or invalid
function getNestedValue(obj as object, path as string) as dynamic
    if not isValid(obj) or path = "" then return invalid

    parts = path.split(".")
    current = obj

    for each part in parts
        if not isValid(current) then return invalid
        if type(current) <> "roAssociativeArray" then return invalid
        if not current.DoesExist(part) then return invalid
        current = current[part]
    end for

    return current
end function

' customDynamicRowTitle: Resolves the display title for an external list row id
'
' @param {string} rowId - The row id, for example "imdb_top_250_movies" or "tmdb_popular_tv"
' @return {string} localized row title, or an empty string when the id isn't recognized
function customDynamicRowTitle(rowId as string) as string
    titles = {
        imdb_top_250_movies: tr("IMDb Top 250 Movies"),
        imdb_top_250_tv_shows: tr("IMDb Top 250 TV Shows"),
        imdb_most_popular_movies: tr("IMDb Most Popular Movies"),
        imdb_most_popular_tv_shows: tr("IMDb Most Popular TV Shows"),
        imdb_lowest_rated_movies: tr("IMDb Lowest Rated Movies"),
        imdb_top_english_movies: tr("IMDb Top Rated English Movies"),
        tmdb_popular_movies: tr("TMDb Popular Movies"),
        tmdb_top_rated_movies: tr("TMDb Top Rated Movies"),
        tmdb_now_playing_movies: tr("TMDb Now Playing Movies"),
        tmdb_upcoming_movies: tr("TMDb Upcoming Movies"),
        tmdb_popular_tv: tr("TMDb Popular TV Shows"),
        tmdb_top_rated_tv: tr("TMDb Top Rated TV Shows"),
        tmdb_airing_today_tv: tr("TMDb Airing Today TV Shows"),
        tmdb_on_the_air_tv: tr("TMDb On The Air TV Shows"),
        tmdb_trending_movie_daily: tr("TMDb Trending Movies Daily"),
        tmdb_trending_movie_weekly: tr("TMDb Trending Movies Weekly"),
        tmdb_trending_tv_daily: tr("TMDb Trending TV Daily"),
        tmdb_trending_tv_weekly: tr("TMDb Trending TV Weekly"),
        tmdb_trending_all_weekly: tr("TMDb Trending All Weekly"),
        seerr_trending: tr("Seerr Trending"),
        seerr_popular_movies: tr("Seerr Popular Movies"),
        seerr_popular_series: tr("Seerr Popular TV Shows"),
        seerr_upcoming_movies: tr("Seerr Upcoming Movies"),
        seerr_upcoming_series: tr("Seerr Upcoming TV Shows"),
        seerr_shortcuts: tr("Seerr Browse"),
        seerr_watchlist: tr("Your Watchlist"),
        seerr_movie_genres: tr("Browse Movies by Genre"),
        seerr_series_genres: tr("Browse TV by Genre"),
        seerr_studios: tr("Browse by Studio"),
        seerr_networks: tr("Browse by Network"),
        mdblist_watching_now: tr("Watching on MDBList")
    }

    known = titles[rowId]
    if isValidAndNotEmpty(known) then return known

    chart = homeRowLayout.ExternalChart(rowId)
    if isValid(chart) then return tr(chart.label)

    ' A picked collection, genre or playlist is named after the item it came from, so its
    ' title is whatever the server called it when the viewer picked it
    picked = homeRowLayout.DynamicLookup()[LCase(rowId)]
    if isValid(picked) then return picked.title

    return ""
end function

' seasonalRowTitle: The seasonal row is named after the holiday the plugin picked
'
' @param {dynamic} holiday - Holiday id the row task reported
' @return {string} localized title, or an empty string for a holiday this app doesnt know
function seasonalRowTitle(holiday as dynamic) as string
    for each entry in seasonalRow.Holidays()
        if isStringEqual(entry.id, holiday) then return tr(entry.title)
    end for
    return ""
end function

' removeRetitledHomeRow: Drops a row that carries the given id under any other title
'
' @param {string} rowId - The row's setting key
' @param {string} title - The title the row is about to carry
sub removeRetitledHomeRow(rowId as string, title as string)
    if not isValid(m.top.content) then return

    keepTitle = LCase(title).Replace(" ", "")

    ' Same rule as the content check below: a waiting row under this id with another title goes
    for i = m.pendingRows.count() - 1 to 0 step -1
        pending = m.pendingRows[i]
        if isStringEqual(pending.key, rowId) and LCase(pending.sectionName).Replace(" ", "") <> keepTitle then m.pendingRows.delete(i)
    end for

    removed = false
    children = m.top.content.getChildren(-1, 0)
    for i = children.count() - 1 to 0 step -1
        child = children[i]
        if isStringEqual(child.id, rowId) and LCase(child.title).Replace(" ", "") <> keepTitle
            m.top.content.removeChildIndex(i)
            removed = true
        end if
    end for
    if removed then setRowItemSize()
end sub

' createCustomDynamicRow: Starts the load for an external list row
' The row is built once the task reports back, so nothing is added to the home view here
'
' @param {object} row - Row descriptor carrying an id and optional additionalData
' @return {boolean} true once the load has been started
function createCustomDynamicRow(row as object) as boolean
    rowId = chainLookupReturn(row, "id", "")
    if rowId = "mdblist_watching_now"
        startWatchingNowRefreshTimer()
    end if

    task = getOrCreateTask(rowId)
    userSession = pickedRowSession(rowId)
    if isValid(userSession)
        task.serverUrl = userSession.serverUrl
        task.serverUserId = userSession.userId
        task.serverAuthToken = userSession.authToken
    end if

    additionalDataVal = chainLookupReturn(row, "additionalData", invalid)
    if type(additionalDataVal) = "String" or type(additionalDataVal) = "roString"
        additionalDataVal = ParseJson(additionalDataVal)
    end if
    if isValid(additionalDataVal) and type(additionalDataVal) = "roAssociativeArray"
        task.additionalData = additionalDataVal
    end if

    runRowTask(task, "content", "updateCustomDynamicRowItems")
    return true
end function

sub updateCustomDynamicRowItems(event as object)
    task = event.getRoSGNode()
    build = m.buildCount
    rowId = task.itemsToLoad
    itemData = getTaskContentAndCleanup(rowId)

    ' A held back row lands after Home counted itself loaded
    if m.lateRows.DoesExist(rowId)
        m.lateRows.Delete(rowId)
        startLateRows()
    else
        m.processedRowCount++
    end if

    if rowId = "seasonal"
        mappedName = task.rowTitle
        if mappedName = "" then mappedName = seasonalRowTitle(task.rowKey)
        ' The row is named after its holiday, so a row left from the day before would otherwise
        ' sit beside the new one
        removeRetitledHomeRow(rowId, mappedName)
    else if task.rowTitle <> ""
        ' A Seerr slider takes the title Seerr gives it now
        mappedName = task.rowTitle
        removeRetitledHomeRow(rowId, mappedName)
    else
        mappedName = customDynamicRowTitle(rowId)
    end if
    ' Taking a retitled row out can finish the build and start a queued one, which loads this row itself
    if m.buildCount <> build then return
    sectionName = isValidAndNotEmpty(mappedName) ? mappedName : rowId

    ' Found by its key, since a picked row can carry the same title as another one
    if not isValidAndNotEmpty(itemData)
        ' An empty row may be the last one the build was waiting on
        if rowId = "mdblist_watching_now"
            startWatchingNowRefreshTimer()
            ' As in Core, a refresh that fails or comes back empty leaves the cards already up
            if homeRowIndexById(rowId) >= 0
                finishIfAllRowsIn()
                return
            end if
        end if
        m.emptySections[LCase(sectionName).Replace(" ", "")] = true
        removeHomeRowById(rowId)
        finishIfAllRowsIn()
        return
    end if

    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName
    if rowId = "mdblist_watching_now"
        row.subtitle = task.rowSubtitle
        startWatchingNowRefreshTimer()
    end if

    for each item in itemData
        row.appendChild(item)
    end for

    addOrUpdateHomeRow(row, sectionName, rowId)
end sub

' startWatchingNowRefreshTimer: Reloads the Watching on MDBList row every five minutes
sub startWatchingNowRefreshTimer()
    if isValid(m.watchingNowTimer) then return

    m.watchingNowTimer = createObject("roSGNode", "Timer")
    m.watchingNowTimer.duration = 300
    m.watchingNowTimer.repeat = true
    m.watchingNowTimer.observeField("fire", "onWatchingNowRefreshFired")
    m.watchingNowTimer.control = "start"
end sub

sub stopWatchingNowRefreshTimer()
    if isValid(m.watchingNowTimer)
        m.watchingNowTimer.control = "stop"
        m.watchingNowTimer = invalid
    end if
end sub

sub onWatchingNowRefreshFired()
    if kidsMode.Enabled() or not homeRowLayout.RowToggleOn("mdblist_watching_now") or not inArray(homeRowLayout.Arranged(), "mdblist_watching_now")
        stopWatchingNowRefreshTimer()
        return
    end if

    ' As in Core, nobody sees Home under the video player, so those ticks are skipped and the
    ' next one catches up
    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.isSubType("VideoPlayerView") then return

    createCustomDynamicRow({ id: "mdblist_watching_now" })
end sub

' internalRowConfig: Describes the opt in home rows that share one row builder, keyed by the
' task that loads them. Favorites is deliberately absent because it builds its own row to
' cover the multi server case.
'
' @param {string} taskKey - Task key, as set on LoadItemsTask.itemsToLoad
' @return {object} the row's section key and localized title, or invalid
' Merging puts both calendars in one row, so the row that carries them both says so and
' the other one steps aside
function calendarsMerged() as boolean
    if not get_user_setting_bool("calendar.merge", false) then return false
    arranged = homeRowLayout.Arranged()
    ' Both calendars come from the same place, so one answers for the other
    return inArray(arranged, "radarr_calendar") and inArray(arranged, "sonarr_calendar") and homeRowLayout.RowToggleOn("radarr_calendar")
end function

' Which calendar a row comes from, under its title
function arrCalendarSubtitle(sectionKey as string) as string
    if sectionKey <> "radarr_calendar" and sectionKey <> "sonarr_calendar" then return ""
    if calendarsMerged() then return tr("Radarr and Sonarr Calendars")
    if sectionKey = "radarr_calendar" then return tr("Radarr Calendar")

    return tr("Sonarr Calendar")
end function

function arrCalendarTitle(service as string) as string
    if calendarsMerged() then return tr("Upcoming Releases")
    if service = "radarr" then return tr("Upcoming Movies")

    return tr("Upcoming Episodes")
end function

function internalRowConfig(taskKey as string) as object
    configs = {
        collections: { sectionKey: "collections", title: tr("Collections") },
        studios: { sectionKey: "studios", title: tr("Studios") },
        radarr_calendar: { sectionKey: "radarr_calendar", title: arrCalendarTitle("radarr") },
        sonarr_calendar: { sectionKey: "sonarr_calendar", title: arrCalendarTitle("sonarr") },
        genres: { sectionKey: "genres", title: tr("Genres") },
        audio: { sectionKey: "audio", title: tr("Audio") },
        ' The plain "playlists" task feeds the playlist picker, which needs a different node type
        homeplaylists: { sectionKey: "playlists", title: tr("Playlists") }
    }

    return configs[taskKey]
end function

' internalRowTaskKey: Maps a home section key to the task that loads it
'
' @param {string} sectionKey - Home section key, for example "collections"
' @return {string} the task key, or an empty string for sections these rows don't cover
function internalRowTaskKey(sectionKey as string) as string
    keys = {
        collections: "collections",
        genres: "genres",
        studios: "studios",
        radarr_calendar: "radarr_calendar",
        sonarr_calendar: "sonarr_calendar",
        audio: "audio",
        playlists: "homeplaylists"
    }

    return keys[sectionKey] ?? ""
end function

' internalRowEnabled: Reports whether an opt in home row should be built
'
' @param {string} sectionKey - Home section key
' @return {boolean} true for rows that have no toggle, otherwise the state of that toggle
function internalRowEnabled(sectionKey as string) as boolean
    if homeRowLayout.IsSliderRow(sectionKey) then return homeRowLayout.PickShown(sectionKey)

    ' A picked collection, genre or playlist answers to the same switch as the list it was
    ' picked from, so turning that list off takes its rows with it
    picked = homeRowLayout.SourceFromId(sectionKey)
    if isValid(picked)
        if not homeRowLayout.PickShown(sectionKey) then return false
        if not homeRowLayout.IsOwnServer(sectionKey) and not isValid(pickedRowSession(sectionKey)) then return false
        listEntry = homeRowLayout.SourceFor(picked.source)
        if isValid(listEntry) then return listEntry.gate = "" or get_user_setting_bool(listEntry.gate, false)
    end if

    return homeRowLayout.RowToggleOn(sectionKey)
end function

' A collection picked on another server loads with this device's sign in there, and isn't shown
' without one
function pickedRowSession(rowId as string) as dynamic
    if homeRowLayout.IsOwnServer(rowId) then return invalid
    picked = homeRowLayout.SourceFromId(rowId)
    if not isValid(picked) then return invalid
    for each userSession in getLoggedInServerUsersExcludingCurrent()
        if settingsSync.IsSameServer(userSession.serverUrl, picked.server) then return userSession
    end for
    return invalid
end function

sub createInternalRow(taskKey as string)
    task = getOrCreateTask(taskKey)
    runRowTask(task, "content", "updateInternalRowItems")
end sub

sub updateInternalRowItems(event as object)
    m.processedRowCount++

    taskKey = event.getRoSGNode().itemsToLoad
    config = internalRowConfig(taskKey)
    if not isValid(config) then return

    itemData = getTaskContentAndCleanup(taskKey)
    if not isValidAndNotEmpty(itemData)
        removeHomeSection(config.title)
        return
    end if

    row = CreateObject("roSGNode", "HomeRow")
    row.title = config.title
    row.subtitle = arrCalendarSubtitle(config.sectionKey)

    for each item in itemData
        row.appendChild(item)
    end for
    if calendarSeeAllShown(config.sectionKey) then row.appendChild(calendarSeeAllCard())

    addOrUpdateHomeRow(row, config.title, config.sectionKey)
end sub

' The upcoming rows end with a card that opens the month grid at today
function calendarSeeAllShown(sectionKey as string) as boolean
    if sectionKey <> "radarr_calendar" and sectionKey <> "sonarr_calendar" then return false
    return get_user_setting_bool("calendar.rowSeeAll", true) and moonfinPlugin.IsCalendarAvailable()
end function

sub showWatchParties(rooms as object)
    if not isValid(m.top.content) then return
    hadRow = homeRowIndexById("watch_parties") >= 0
    if rooms.Count() = 0
        if hadRow
            removeHomeRowById("watch_parties")
            keepRowFocus(-1)
        end if
        m.watchPartyIds = ""
        return
    end if

    cards = []
    for each summary in rooms
        shown = wpRoomCard(summary)
        cards.push({ "Id": toString(summary.room_id ?? ""), "Type": "WatchPartyRoom", "Name": shown.title, "Overview": watchPartyModel.RoomMeta(summary), "ImageUrl": shown.art, "HasPin": summary.has_pin = true })
    end for
    ' The list is polled every minute, and the row is only built again when a card changed
    drawn = FormatJson(cards)
    if hadRow and drawn = (m.watchPartiesDrawn ?? "") then return
    m.watchPartiesDrawn = drawn

    row = CreateObject("roSGNode", "HomeRow")
    row.title = tr("Watch Parties")
    for each json in cards
        card = CreateObject("roSGNode", "HomeData")
        card.json = json
        card.title = json.Name
        row.appendChild(card)
    end for
    start = CreateObject("roSGNode", "HomeData")
    start.json = { "Id": "watch_party_start", "Type": "WatchPartyStart", "Name": tr("Start a watch party"), "Overview": "" }
    start.title = tr("Start a watch party")
    row.appendChild(start)
    ' Cards draw at the size their row has when they first bind, so the row is sized before it goes in
    row.id = "watch_parties"
    if isValid(m.cardSizeName) then layOutRow(row, m.modernRows, m.cardSizeName)
    addOrUpdateHomeRow(row, row.title, "watch_parties")
    ' keepRowFocus and showWatchPartiesFromStart read the row's index, so it goes in now
    flushPendingRows()
    if not hadRow then keepRowFocus(1)

    ids = []
    for each json in cards
        ids.push(json.Id)
    end for
    drawnIds = ids.Join(",")
    if drawnIds <> (m.watchPartyIds ?? "") then m.watchPartiesFromStart = true
    m.watchPartyIds = drawnIds
    showWatchPartiesFromStart()
end sub

' The list keeps each row's place, so a party that arrives ahead of the card the viewer last had
' would sit off the left edge. When parties come or go, the row opens on its first card again.
sub showWatchPartiesFromStart()
    if m.watchPartiesFromStart <> true then return
    rowIndex = homeRowIndexById("watch_parties")
    focused = m.top.rowItemFocused
    if rowIndex < 0 or type(focused) <> "roArray" or focused.Count() < 2 or focused[0] <> rowIndex then return
    m.watchPartiesFromStart = false
    if focused[1] <> 0 then m.top.jumpToRowItem = [rowIndex, 0]
end sub

' The list keeps focus by index, so when the row comes or goes above the others the viewer is moved
' with the row they were on.
sub keepRowFocus(shift as integer)
    if not m.top.hasFocus() then return
    focused = m.top.rowItemFocused
    if type(focused) <> "roArray" or focused.Count() < 2 then return
    target = [focused[0] + shift, focused[1]]
    if target[0] < 0 then target = [0, 0]
    if target[0] >= m.top.content.getChildCount() then return
    m.top.jumpToRowItem = target
end sub

function calendarSeeAllCard() as object
    card = CreateObject("roSGNode", "HomeData")
    card.json = { "Id": "calendar_see_all", "Type": "CalendarSeeAll", "name": tr("See All"), "Overview": "" }
    card.title = tr("See All")
    return card
end function

' updateHomeRows: Update function exposed to outside components
'
sub updateHomeRows()
    if m.buildInFlight
        queueBuild("update")
        return
    end if

    beginBuild()
    startHomeRowsLoading()
end sub

' A layout change takes rows away as well as adding them, so the list is emptied before it is
' filled again rather than merged with whatever the last one left standing
sub reloadHomeRows()
    if m.buildInFlight
        queueBuild("reload")
        return
    end if

    m.top.content = CreateObject("roSGNode", "ContentNode")
    beginBuild()
    startHomeRowsLoading()
end sub

' updateFavoritesItems: Processes LoadFavoritesTask content. Removes, Creates, or Updates favorites row as needed
'

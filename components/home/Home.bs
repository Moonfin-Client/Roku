import "pkg:/components/home/homeFollowers.bs"
import "pkg:/components/home/modernPreview.bs"
import "pkg:/components/itemMenu/itemMenuHost.bs"
import "pkg:/components/userDataHost.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/api/Items.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/mediaBadges.bs"
import "pkg:/source/utils/musicLibraryStyle.bs"
import "pkg:/source/utils/ratingsRow.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/SeerrUtils.bs"

sub init()
    observeUserData()
    ' Check if this is truly the first run (ever, not just this session)
    ' Use registry to persist this across app restarts
    firstRunKey = "home.hasRunBefore"
    hasRunBefore = get_setting(firstRunKey)
    m.isFirstRun = (hasRunBefore = invalid or hasRunBefore = "false")

    ' m.isMediaBarEnabled will be set after m.homeRows is initialized below

    m.top.optionsAvailable = false
    m.postTask = createObject("roSGNode", "PostTask")

    ' Task to load full item details for display
    m.loadItemDetailsTask = CreateObject("roSGNode", "LoadItemsTask")
    m.loadItemDetailsTask.itemsToLoad = "metaData"
    m.loadItemDetailsTask.observeField("content", "onItemDetailsLoaded")


    m.homeRows = m.top.findNode("homeRows")

    m.modernHomeRows = isModernHomeRows()

    ' The overlay card is the focus indicator in modern rows, so the row list
    ' does not draw its own portrait focus border underneath it.
    ' A row still on landscape tiles wants it back, so the markup's image is kept.
    if m.modernHomeRows and isValid(m.homeRows)
        m.classicFocusBitmapUri = m.homeRows.focusBitmapUri
        m.homeRows.focusBitmapUri = ""
    end if

    ' Initialize media bar enabled state using the shared helper in HomeRows
    m.isMediaBarEnabled = m.homeRows.callFunc("isFeaturedMediaEnabled")

    ' Get references to detail fields
    m.detailsSection = m.top.findNode("detailsSection")
    m.itemTitle = m.top.findNode("itemTitle")
    m.itemLogo = m.top.findNode("itemLogo")
    m.itemLogo.observeField("loadStatus", "onItemLogoLoaded")
    m.infoRow = m.top.findNode("infoRow")
    m.homeRatings = m.top.findNode("homeRatings")
    m.itemOverview = m.top.findNode("itemOverview")
    m.overviewLine = m.top.findNode("overviewLine")
    m.infoFonts = { text: systemFont("font:SystemFontFile", 24), lead: systemFont("font:BoldSystemFontFile", 24), pill: systemFont("font:SystemFontFile", 20) }

    ' Modern rows focused card overlay
    m.modernFocusCard = m.top.findNode("modernFocusCard")

    ' Set up before the media bar below, since laying that out can hide the card and stop a preview
    previewInit()

    m.backdrop = m.top.findNode("backdrop")
    m.backdropPrev = m.top.findNode("backdropPrev")
    m.backdropMask = m.top.findNode("backdropMask")
    m.backdropTint = m.top.findNode("backdropTint")
    m.seasonalEffects = m.top.findNode("seasonalEffects")

    ' Observe backdrop load status to know when new backdrop is ready
    m.backdrop.observeField("loadStatus", "onBackdropLoadStatusChange")

    ' Crossfade animation
    m.backdropFadeIn = m.top.findNode("backdropFadeIn")
    m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")
    m.backdropFadeInInterp = m.top.findNode("backdropFadeInInterp")
    m.backdropPrevFadeOutInterp = m.top.findNode("backdropPrevFadeOutInterp")
    m.backdropCrossfading = false
    m.backdropTargetOpacity = 1.0
    m.backdropPlacement = "fullScreen"

    ' Observe when focused item changes
    m.homeRows.observeField("rowItemFocused", "onItemFocusChanged")

    ' Observe when key is pressed inside homeRows
    m.keyPressedNotifier = false
    m.homeRows.observeField("keyPressedNotifier", "onHomeRowsKeyPressed")
    m.homeRows.observeField("moveTarget", "onHomeRowsMoveTarget")

    ' Observe when home rows content is loaded
    m.homeRows.observeField("contentLoaded", "onHomeRowsContentLoaded")

    ' The sidebar hands focus back to whatever held it last, which can be a row
    ' while the bar is still up, so the bar steps aside when the rows take focus
    m.homeRows.observeField("focusedChild", "onHomeRowsFocusChanged")

    ' Setup media bar
    m.mediaBar = m.top.findNode("mediaBar")
    if isValid(m.mediaBar)
        m.mediaBar.observeField("itemSelected", "onMediaBarItemSelected")
        m.mediaBar.observeField("currentBackdrop", "onMediaBarBackdropChanged")
        m.mediaBar.observeField("focusedChild", "onMediaBarFocusChanged")
        m.mediaBar.observeField("isEmpty", "onMediaBarEmptyChanged")
        m.mediaBar.observeField("fullScreenTrailer", "onTrailerChromeChanged")

        ' Show MediaBar if enabled via toggle
        if m.isMediaBarEnabled
            applyMediaBarLayout(true)
            m.mediaBar.setFocus(true)
            m.homeRows.setFocus(false)
        else
            applyMediaBarLayout(false)
        end if
    end if

    m.global.observeFieldScoped("mediaBarModeChanged", "onMediaBarModeChanged")

    m.global.observeFieldScoped("navPositionChanged", "onNavPositionChanged")
    bindActiveNav()
    followersInit()

    m.global.observeFieldScoped("librariesChanged", "onLibrariesChanged")
end sub

' The sidebar and the top bar are separate nodes, so switching between them hands the
' screen a bar these handlers are not attached to
sub onNavPositionChanged()
    unbindActiveNav()
    bindActiveNav()
end sub

' The libraries themselves changed, like their order, so the nav and the rows read them again
' rather than waiting for the next launch
sub onLibrariesChanged()
    if isValid(m.activeNav) then m.activeNav.callFunc("loadLibraries")
    m.homeRows.callFunc("reloadLibraries")
end sub

sub bindActiveNav()
    activeNav = getActiveNav(m.top.getScene())
    if not isValid(activeNav) then return

    m.activeNav = activeNav
    activeNav.observeFieldScoped("itemSelected", "onNavItemSelected")
    activeNav.observeFieldScoped("showShuffleDialog", "onShowShuffleDialog")
    activeNav.observeFieldScoped("favoritesPressed", "onFavoritesPressed")
    activeNav.observeFieldScoped("genresPressed", "onGenresPressed")
    activeNav.observeFieldScoped("librarySelected", "onLibrarySelected")
    activeNav.observeFieldScoped("focusRect", "pointFollowers")
    activeNav.observeFieldScoped("focusedChild", "pointFollowers")
    activeNav.callFunc("loadLibraries")
end sub

sub unbindActiveNav()
    if not isValid(m.activeNav) then return

    m.activeNav.unobserveFieldScoped("itemSelected")
    m.activeNav.unobserveFieldScoped("showShuffleDialog")
    m.activeNav.unobserveFieldScoped("favoritesPressed")
    m.activeNav.unobserveFieldScoped("genresPressed")
    m.activeNav.unobserveFieldScoped("librarySelected")
    m.activeNav.unobserveFieldScoped("focusRect")
    m.activeNav.unobserveFieldScoped("focusedChild")
    m.activeNav = invalid
end sub

sub onNavItemSelected(event as object)
    selectedItem = event.getData()

    if selectedItem = "home"
        ' Back on Home from another screen
        m.homeRows.callFunc("updateHomeRows")
    else if selectedItem = "homeAgain"
        m.homeRows.callFunc("updateHomeRows")
        if isValid(m.mediaBar) then m.mediaBar.callFunc("drawNewSet")
    else if selectedItem = "search"
        ' Navigate to search
        searchPage = CreateObject("roSGNode", "searchResults")
        searchPage.observeField("quickPlayNode", m.port)
        ' Clear lastFocus so SearchBox gets focused by default
        searchPage.lastFocus = invalid
        m.global.sceneManager.callFunc("pushScene", searchPage)
    end if
end sub

sub onShowShuffleDialog(_event as object)
    showShuffleDialog()
end sub

sub showShuffleDialog()
    dialog = CreateObject("roSGNode", "ShuffleDialog")
    dialog.observeField("selectedItem", "onShuffleItemSelected")
    dialog.observeField("shuffleDialogClosed", "onShuffleDialogClosed")

    contentType = chainLookupReturn(m.global.session, "user.settings.shuffle_content_type", "both")
    dialog.contentType = contentType
    m.shuffleDialogNode = dialog

    scene = m.top.getScene()
    scene.appendChild(dialog)
    dialog.setFocus(true)
end sub

sub onShuffleItemSelected(event as object)
    selectedItem = event.getData()
    if not isValid(selectedItem) then return

    removeShuffleDialog()
    relayShuffleSelection(selectedItem)
end sub

sub onShuffleDialogClosed()
    removeShuffleDialog()
end sub

sub removeShuffleDialog()
    scene = m.top.getScene()

    if isValid(m.shuffleDialogNode)
        scene.removeChild(m.shuffleDialogNode)
        m.shuffleDialogNode = invalid
    end if

    if not FocusOverhang(m.top)
        FocusSidebar(m.top)
    end if
end sub

' Handle favorites button press from overhang
sub onFavoritesPressed(_event as object)
    handleFavorites()
end sub

' Handle genres button press from overhang
sub onGenresPressed(_event as object)
    handleGenres()
end sub

' Handle library selection from overhang
sub onLibrarySelected(event as object)
    libraryNode = event.getData()
    if not isValid(libraryNode) then return

    handleLibraryNavigation(libraryNode)
end sub

' Handle media bar backdrop when style changes
sub onMediaBarModeChanged()
    if not isValid(m.mediaBar) or not isValid(m.homeRows) then return

    mode = m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin"

    if mode = "off" or mode = ""
        applyMediaBarLayout(false)
        m.isMediaBarEnabled = false
        return
    end if

    m.isMediaBarEnabled = true
    if not m.homeRows.hasFocus() and not m.mediaBar.isEmpty
        applyMediaBarLayout(true)
    end if

    if mode = "gallery"
        if isValid(m.backdrop) then m.backdrop.uri = ""
        if isValid(m.backdropPrev) then m.backdropPrev.uri = ""
        m.backdropCrossfading = false
    else if mode = "bookshelf"
        if isValid(m.backdrop) then showBookshelfBackdrop()
        if isValid(m.backdropPrev) then m.backdropPrev.uri = ""
        m.backdropCrossfading = false
    end if
end sub

' A row card may have left the backdrop loading small to soften it
sub showBookshelfBackdrop()
    m.backdrop.loadWidth = 0
    m.backdrop.loadHeight = 0
    m.backdrop.uri = "pkg:/images/bookshelfBg.webp"
end sub

' Handle media bar backdrop changes
sub onMediaBarBackdropChanged(event as object)
    backdropUrl = event.getData()
    if not isValid(backdropUrl)
        return
    end if

    mode = m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin"
    if mode = "gallery" or mode = "banner"
        if isValid(m.backdrop)
            m.backdrop.uri = ""
            m.backdrop.opacity = 0
        end if
        if isValid(m.backdropPrev)
            m.backdropPrev.uri = ""
            m.backdropPrev.opacity = 0
        end if
        m.backdropCrossfading = false
        return
    else if mode = "bookshelf"
        if isValid(m.backdrop)
            showBookshelfBackdrop()
            m.backdrop.opacity = 1
        end if
        if isValid(m.backdropPrev)
            m.backdropPrev.uri = ""
            m.backdropPrev.opacity = 0
        end if
        m.backdropCrossfading = false
        return
    end if

    ' Handle clearing the backdrop when MediaBar loses focus
    if backdropUrl = ""
        if isValid(m.backdrop)
            m.backdrop.uri = ""
        end if
        if isValid(m.backdropPrev)
            m.backdropPrev.uri = ""
        end if
        m.backdropCrossfading = false
        return
    end if

    ' Only update if MediaBar has focus
    if isValid(m.mediaBar) and m.mediaBar.visible
        if isValid(m.backdrop)
            startBackdropCrossfade(backdropUrl)
        end if
    end if
end sub

' Check if Featured Media should be shown when content loads
sub onHomeRowsContentLoaded()
    if not isValid(m.mediaBar) or not isValid(m.homeRows) then return

    ' Check if Media Bar is enabled via toggle (no longer checking homesection0)
    mediaBarCheck = m.homeRows.callFunc("isFeaturedMediaEnabled")
    if isValid(mediaBarCheck) and type(mediaBarCheck) = "roBoolean"
        m.isMediaBarEnabled = mediaBarCheck
    end if

    ' Only show/focus Media Bar if it's enabled and home rows doesn't have focus
    if m.isMediaBarEnabled and not m.homeRows.hasFocus() and not m.mediaBar.isEmpty
        applyMediaBarLayout(true)
    else
        ' Media bar disabled or home rows having focus means focused item details should be loaded
        ' onItemFocusChanged has guardrails already to return if focus is not on a valid
        ' home row item, so we can just call it directly
        onItemFocusChanged()
    end if
end sub

' Handle media bar item selection
sub onMediaBarItemSelected(event as object)
    selectedItem = event.getData()
    if not isValid(selectedItem) then return

    itemType = LCase(selectedItem.type)
    if itemType = "movie"
        ' Navigate to movie details using the same approach as Main.bs
        m.top.selectedItem = selectedItem
    else if itemType = "series" or itemType = "episode"
        ' Navigate to series details
        m.top.selectedItem = selectedItem
    end if
end sub

' Navigate to the selected library
sub handleLibraryNavigation(libraryNode as object)
    if not isValid(libraryNode) then return

    libraryId = libraryNode.libraryId
    libraryName = libraryNode.title
    collectionType = LCase(libraryNode.collectionType)
    hasServerMetadata = isValid(libraryNode.serverUrl) and libraryNode.serverUrl <> ""

    libraryItem = CreateObject("roSGNode", "LibraryData")
    libraryItem.id = libraryId
    libraryItem.libraryId = libraryId
    libraryItem.title = libraryName
    libraryItem.Type = "CollectionFolder"
    libraryItem.collectionType = collectionType

    if hasServerMetadata
        libraryItem.serverUrl = libraryNode.serverUrl
        libraryItem.userId = libraryNode.userId
        libraryItem.authToken = libraryNode.authToken
        libraryItem.serverId = libraryNode.serverId
        libraryItem.serverName = libraryNode.serverName
    end if

    group = invalid

    if collectionType = "movies"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.MOVIE
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "tvshows"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.SERIES
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "homevideos"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.PHOTO
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "music"
        if musicLibraryStyle.OpensGrid(libraryItem)
            group = CreateObject("roSGNode", "VisualLibraryScene")
            group.mediaType = ItemType.MUSICARTIST
        else
            group = CreateObject("roSGNode", "MusicLibraryScreen")
        end if
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "livetv"
        group = CreateObject("roSGNode", "LiveTvGuide")
    else if collectionType = "photos"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.PHOTO
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "boxsets"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.BOXSET
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "playlists"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.PLAYLIST
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "mylist"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = "MyList"
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "musicvideos"
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.MUSICVIDEO
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    else if collectionType = "books"
        group = CreateObject("roSGNode", "AudioBookLibraryView")
        group.parentItem = libraryItem
        group.optionsAvailable = true
        group.observeField("quickPlayNode", m.port)
    else
        group = CreateObject("roSGNode", "VisualLibraryScene")
        group.mediaType = ItemType.FOLDER
        group.parentItem = libraryItem
        group.observeField("quickPlayNode", m.port)
    end if

    if isValid(group)
        group.observeField("selectedItem", "onLibraryItemSelected")
        group.observeField("genreItemSelected", "onLibraryGenreSelected")
        m.global.sceneManager.callFunc("pushScene", group)
    end if
end sub

' Passes a genre picked in a library's Genres view up to Main, which opens it
sub onLibraryGenreSelected(event as object)
    m.top.genreItemSelected = event.getData()
end sub

' Handle item selection from library screens
sub onLibraryItemSelected(event as object)
    selectedItem = event.getData()
    if isValid(selectedItem)
        ' Relay the selection up through Home's selectedItem field which Main.bs observes. The
        ' main loop only clears the screen on top, so the field is cleared here, or a later
        ' favorite or watched change to the card would open it again.
        m.top.selectedItem = selectedItem
        m.top.selectedItem = invalid
    end if
end sub

' Cleared straight away for the same reason as a library pick
sub relayShuffleSelection(selectedItem as object)
    m.top.shuffleSelectedItem = selectedItem
    m.top.shuffleSelectedItem = invalid
end sub

sub onHomeRowsKeyPressed(event as object)
    keyPressedNotifier = event.getData()
    if isValid(keyPressedNotifier) and keyPressedNotifier <> m.keyPressedNotifier
        m.keyPressedNotifier = keyPressedNotifier

        if m.modernHomeRows
            hideModernFocusCard()
        end if
    end if
end sub

' The row only reports its new focus once it has finished scrolling, so the card and cells
' start changing as the key is pressed. Otherwise the incoming cell slides in under the card
' still showing its own poster and title, and the card changes a beat late.
sub onHomeRowsMoveTarget(event as object)
    if not m.modernHomeRows or not isValid(m.homeRows.content) then return
    target = event.getData()
    if not isValid(target) or target.count() < 2 then return

    row = m.homeRows.content.getChild(target[0])
    if not isValid(row) or not useModernCardsForRow(row.id) then return
    applyModernReflow(target[0], target[1])

    item = row.getChild(target[1])
    if not isValid(item) or not m.modernFocusCard.cardShown then return
    previewOnFocus(item)
    showModernFocusCard(item)
end sub

' Navigate to genres screen
sub handleGenres()
    genresScreen = CreateObject("roSGNode", "GenresScreen")
    genresScreen.observeField("selectedItem", "onGenresItemSelected")
    m.global.sceneManager.callFunc("pushScene", genresScreen)
end sub

' Handle item selection from genres screen
sub onGenresItemSelected(event as object)
    selectedItem = event.getData()
    if not isValid(selectedItem)
        return
    end if

    ' Store the selected item type for later use
    m.genresSelectedItemType = LCase(selectedItem.type)

    ' Fetch full metadata from API using async task (includes MediaStreams, etc.)
    m.loadItemDetailsTask.itemId = selectedItem.id
    m.loadItemDetailsTask.observeField("content", "onGenresItemMetadataLoaded")
    m.loadItemDetailsTask.itemsToLoad = "metaData"
    m.loadItemDetailsTask.control = TaskControl.RUN
end sub

' Handle metadata loaded from API
sub onGenresItemMetadataLoaded()
    movieMetaData = m.loadItemDetailsTask.content
    m.loadItemDetailsTask.unobserveField("content")
    m.loadItemDetailsTask.content = []

    if not isValidAndNotEmpty(movieMetaData) then return

    ' Route through shuffleSelectedItem so the main event loop handles
    ' creation via the proper factory functions (CreateMovieDetailsGroup / CreateSeriesDetailsGroup)
    m.top.shuffleSelectedItem = movieMetaData[0]
end sub

' Navigate to favorites screen
sub handleFavorites()
    favoritesScreen = CreateObject("roSGNode", "FavoritesScreen")
    favoritesScreen.observeField("selectedItem", "onFavoritesItemSelected")
    m.global.sceneManager.callFunc("pushScene", favoritesScreen)
end sub

' Handle item selection from favorites screen
sub onFavoritesItemSelected(event as object)
    selectedItem = event.getData()
    if isValid(selectedItem) then relayShuffleSelection(selectedItem)
end sub

' Handle backdrop load status - when new backdrop finishes loading, crossfade it in
sub onBackdropLoadStatusChange()
    if isValid(m.backdrop) and m.backdrop.loadStatus = "ready" and isValidAndNotEmpty(m.backdrop.uri)
        if m.backdropCrossfading
            targetOpacity = m.backdropTargetOpacity

            currentBackdropOpacity = 0.0
            if isValid(m.backdrop)
                currentBackdropOpacity = m.backdrop.opacity
            end if

            currentPrevOpacity = 1.0
            if isValid(m.backdropPrev)
                currentPrevOpacity = m.backdropPrev.opacity
            end if

            if isValid(m.backdropFadeInInterp)
                m.backdropFadeInInterp.keyValue = [currentBackdropOpacity, targetOpacity]
            end if
            if isValid(m.backdropPrevFadeOutInterp)
                m.backdropPrevFadeOutInterp.keyValue = [currentPrevOpacity, 0.0]
            end if
            if isValid(m.backdropFadeIn)
                m.backdropFadeIn.control = "start"
            end if
            if isValid(m.backdropPrevFadeOut)
                m.backdropPrevFadeOut.control = "start"
            end if
            m.backdropCrossfading = false
        end if
    end if
end sub

sub refresh()
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.WHITE)
    m.homeRows.callFunc("updateHomeRows")
end sub

' For a change that decides which rows exist at all, rather than what is in them
sub reload()
    m.homeRows.callFunc("reloadHomeRows")
end sub

sub loadLibraries()
    m.homeRows.callFunc("loadLibraries")
end sub

' Apply layout for media bar visibility (handles banner vs fullscreen vs hidden)
' Where the rows start under the aya frame. The frame runs from 150 to 852 and
' the other clients leave a gap below it, which is the room the first row peeks
' through.
const AYA_ROWS_TOP = 884

' The banner card runs from 130 to 554, and the rows follow it
const BANNER_ROWS_TOP = 574

' With Peek Home Rows on, the rows sit low enough that only the first row's label and the
' top half of its cards show under the bar. The bar lays itself out above this line.
const PEEK_ROWS_TOP = 890

' The corner backdrop covers the top right 70% by 75% of the screen, the size the other clients use
const BACKDROP_CORNER_WIDTH = 1344
const BACKDROP_CORNER_HEIGHT = 810

' The classic info area: a 96 tall title band, the info row 12 below it, the ratings 12 below that
' and the overview 16 below the ratings, or in their place when there are none
const LOGO_MAX_WIDTH = 640
const LOGO_HEIGHT = 96
const INFO_TEXT_COLOR = "#FFFFFFCC"
const PILL_COLOR = "#8EC8F0"
const PILL_HEIGHT = 28
const PILL_PADDING = 10
const OVERVIEW_TOP = 212
const OVERVIEW_TOP_NO_RATINGS = 160
const OVERVIEW_LINE_HEIGHT = 36

' Whichever of the rows and the bar takes focus is where Back returns to, so a pick
' from the bar comes back to the bar. The spinner that takes focus on the way out
' never counts.
sub onHomeRowsFocusChanged()
    ' The card menu, a dialog, the sidebar, the nav and settings all take focus away, and
    ' the preview goes with it. Focus coming back starts the dwell over.
    if not m.homeRows.isInFocusChain()
        stopPreview()
        return
    end if
    m.top.lastFocus = m.homeRows

    if isValid(m.mediaBar) and m.mediaBar.visible then applyMediaBarLayout(false)
    previewOnFocus(getRowListItemAt(m.homeRows, m.homeRows.rowItemFocused))
end sub

sub onMediaBarFocusChanged()
    if m.mediaBar.isInFocusChain() then m.top.lastFocus = m.mediaBar
    onTrailerChromeChanged()
end sub

' The nav and a peeking row clear away with the bar's own chrome while a trailer fills the
' screen. That only holds while the bar has focus, so moving off it brings them back.
sub onTrailerChromeChanged()
    covered = m.mediaBar.fullScreenTrailer and m.mediaBar.isInFocusChain()
    if covered = isValid(m.trailerChrome) then return

    if covered
        m.trailerChrome = { nav: getActiveNav(m.top.getScene()), rows: m.homeRows.visible }
        if isValid(m.trailerChrome.nav) then m.trailerChrome.nav.isVisible = false
        m.homeRows.visible = false
        return
    end if

    if isValid(m.trailerChrome.nav) then m.trailerChrome.nav.isVisible = true
    if m.trailerChrome.rows then m.homeRows.visible = true
    m.trailerChrome = invalid
end sub

' A bar that loaded nothing gives its place to the rows. Focus parked in the sidebar comes back
' through lastFocus, so that moves to the rows too
sub onMediaBarEmptyChanged()
    ' A reload after a source change can find titles for a bar that had none
    if not m.mediaBar.isEmpty
        if m.isMediaBarEnabled and not m.mediaBar.visible and not m.homeRows.hasFocus() then applyMediaBarLayout(true)
        return
    end if
    if not m.mediaBar.visible then return

    focused = m.mediaBar.isInFocusChain()
    applyMediaBarLayout(false)
    m.top.lastFocus = m.homeRows
    if not focused then return

    m.homeRows.setFocus(true)
    onItemFocusChanged()
end sub

sub applyMediaBarLayout(mediaBarVisible as boolean)
    if not isValid(m.mediaBar) or not isValid(m.homeRows) then return

    placeBackdrop(rowsBackdropPlacement(mediaBarVisible))

    if mediaBarVisible
        hideModernFocusCard()
        m.mediaBar.visible = true
        if (m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin") = "banner"
            ' The card draws its own artwork, so the page behind it stays clear
            ' and the rows sit under the card
            m.homeRows.visible = true
            m.homeRows.translation = [111, BANNER_ROWS_TOP]
            if isValid(m.detailsSection) then m.detailsSection.visible = false

            if isValid(m.backdropTint) then m.backdropTint.opacity = 0
            if isValid(m.backdrop) then m.backdrop.opacity = 0
            m.backdropTargetOpacity = 0
        else
            ' Fullscreen media bar style
            if isValid(m.detailsSection) then m.detailsSection.visible = false
            mediaBarMode = m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin"

            ' Aya stops short of the bottom, so the first row shows under it
            ' instead of the screen being given over to the frame
            isAya = isStringEqual(mediaBarMode, "aya")
            peekRows = get_user_setting_bool("ui.home.mediaBarRowPeek", false)
            m.homeRows.visible = isAya or peekRows
            if isAya or peekRows then m.homeRows.translation = [111, peekRows ? PEEK_ROWS_TOP : AYA_ROWS_TOP]
            ' The bookshelf art ends on the peeking row, and its books shrink to stand on its ledge
            if peekRows and mediaBarMode = "bookshelf" then m.backdrop.translation = [0, PEEK_ROWS_TOP - 1080]

            ' Aya draws its own copy of the artwork inside the frame, so the one
            ' behind it is dimmed to an ambient wash rather than left at full
            if mediaBarMode = "aya"
                if isValid(m.backdropTint) then m.backdropTint.opacity = 1.0
                if isValid(m.backdrop) then m.backdrop.opacity = 0.3
                m.backdropTargetOpacity = 0.3
            else
                if isValid(m.backdropTint) then m.backdropTint.opacity = 0
                if isValid(m.backdrop) then m.backdrop.opacity = 1.0
                m.backdropTargetOpacity = 1.0
            end if
        end if
    else
        ' Media bar off, or focus on homeRows
        m.mediaBar.visible = false
        m.homeRows.visible = true
        ' Modern has no top overlay, so the rows sit higher
        m.homeRows.translation = m.modernHomeRows ? [111, 170] : [111, 450]

        if isValid(m.detailsSection) then m.detailsSection.visible = not m.modernHomeRows
        if isValid(m.backdropTint) then m.backdropTint.opacity = 1.0
        if isValid(m.backdrop) then m.backdrop.opacity = 0.3
        m.backdropTargetOpacity = 0.3
    end if
end sub

' The rows can show the backdrop in the top right corner, faded out toward the left and the bottom
' the way the Google TV home screen does, or only its top half, faded out toward the middle. The
' media bar always fills the screen.
function rowsBackdropPlacement(mediaBarVisible as boolean) as string
    if mediaBarVisible then return "fullScreen"
    style = getHomeBackdropStyle(m.global.session.user.settings)
    if style = "corner" or style = "top" then return style
    return "fullScreen"
end function

sub placeBackdrop(placement as string)
    m.backdropPlacement = placement
    if placement = "corner"
        size = [BACKDROP_CORNER_WIDTH, BACKDROP_CORNER_HEIGHT]
        offset = [1920 - BACKDROP_CORNER_WIDTH, 0]
        m.backdropMask.maskUri = "pkg:/images/backdropCornerMask.png"
        m.backdropMask.maskSize = size
        m.backdropMask.maskOffset = offset
        fit = "scaleToZoom"
    else if placement = "top"
        size = [1920, 1080]
        offset = [0, 0]
        m.backdropMask.maskUri = "pkg:/images/backdropTopMask.webp"
        m.backdropMask.maskSize = size
        m.backdropMask.maskOffset = offset
        fit = "scaleToFill"
    else
        size = [1920, 1080]
        offset = [0, 0]
        m.backdropMask.maskUri = ""
        m.backdropMask.maskSize = [0, 0]
        fit = "scaleToFill"
    end if
    for each poster in [m.backdrop, m.backdropPrev]
        poster.width = size[0]
        poster.height = size[1]
        poster.translation = offset
        poster.loadDisplayMode = fit
    end for
end sub

' JFScreen hook called when the screen is displayed by the screen manager
sub OnScreenShown(_isReturning = false as boolean)
    m.homeRows.rowLabelColor = chainLookupReturn(m.global.session, "user.settings.colorHomeRowHeaders", ColorPalette.WHITE)

    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav)
        activeNav.visible = true
        activeNav.currentUserProfileImage = UserImageURL(m.global.session.user.id)
        activeNav.currentUser = m.global.session.user.name
    end if

    ' Temporarily unobserve to prevent triggering events when restoring focus
    m.homeRows.unobserveField("rowItemFocused")
    if isValid(m.mediaBar)
        m.mediaBar.unobserveField("itemSelected")
    end if

    ' Restore focus to the last focused element
    ' SceneManager saves the deepest focused child in m.top.lastFocus
    ' We need to determine if that was within homeRows or mediaBar
    focusRestored = false

    ' Get this scene's stored lastFocus from SceneManager
    scenePreviousFocus = invalid
    if isValid(m.top.lastFocus)
        scenePreviousFocus = m.top.lastFocus
    end if

    ' Priority 1: Restore based on what was focused before
    if isValid(scenePreviousFocus)
        ' Check if the saved focus was homeRows itself or a child of homeRows
        if scenePreviousFocus.isSameNode(m.homeRows) or isChildOf(scenePreviousFocus, m.homeRows)
            m.homeRows.setFocus(true)
            focusRestored = true

            if _isReturning
                onItemFocusChanged()
            end if
            ' Check if the saved focus was mediaBar itself or a child of mediaBar
        else if isValid(m.mediaBar) and m.isMediaBarEnabled and not m.mediaBar.isEmpty and (scenePreviousFocus.isSameNode(m.mediaBar) or isChildOf(scenePreviousFocus, m.mediaBar))
            m.currentFocusedItemId = ""
            m.currentFocusedItemServerUrl = invalid

            m.mediaBar.setFocus(true)
            focusRestored = true

            applyMediaBarLayout(true)
        else
            ' lastFocus exists but isn't in homeRows or mediaBar (e.g., from settings/avatar)
            ' Default to homeRows since we're coming back to Home screen
            if isValid(m.homeRows)
                m.homeRows.setFocus(true)
                m.top.lastFocus = m.homeRows
                focusRestored = true

                applyMediaBarLayout(false)

                ' Trigger backdrop update for current focused item
                if _isReturning
                    onItemFocusChanged()
                end if
            end if
        end if
    end if

    ' Priority 2: If no stored focus, check current focus state
    if not focusRestored
        if isValid(m.homeRows) and m.homeRows.hasFocus()
            ' Home rows already have focus, keep it there
            m.homeRows.setFocus(true)
            focusRestored = true
        else if isValid(m.mediaBar) and m.mediaBar.visible and m.mediaBar.isInFocusChain()
            ' Media bar already has focus, keep it there
            m.mediaBar.setFocus(true)
            focusRestored = true
        end if
    end if

    ' Priority 3: If focus wasn't restored (first time or returning), default based on settings
    if not focusRestored
        ' Check if Media Bar is enabled
        shouldShowMediaBar = false
        if isValid(m.mediaBar) and isValid(m.homeRows)
            mediaBarCheck = m.homeRows.callFunc("isFeaturedMediaEnabled")
            if isValid(mediaBarCheck) and type(mediaBarCheck) = "roBoolean"
                shouldShowMediaBar = mediaBarCheck and not m.mediaBar.isEmpty
            end if
        end if

        if shouldShowMediaBar
            ' Focus media bar if it's enabled
            m.currentFocusedItemId = ""
            m.currentFocusedItemServerUrl = invalid

            applyMediaBarLayout(true)
            m.mediaBar.setFocus(true)
            m.top.lastFocus = m.mediaBar
        else
            ' Default to home rows
            if isValid(m.homeRows)
                m.homeRows.setFocus(true)
                m.top.lastFocus = m.homeRows

                applyMediaBarLayout(false)

                ' Trigger backdrop update
                if _isReturning
                    onItemFocusChanged()
                end if
            else
                m.top.setFocus(true)
                m.top.lastFocus = m.top
            end if
        end if
    end if

    ' Re-observe after focus is restored
    m.homeRows.observeField("rowItemFocused", "onItemFocusChanged")
    if isValid(m.mediaBar)
        m.mediaBar.observeField("itemSelected", "onMediaBarItemSelected")
    end if

    if not m.isFirstRun
        needsPlaybackRefresh = chainLookupReturn(m.global, "homeNeedsRefresh", false)

        if not _isReturning or needsPlaybackRefresh
            refresh()
        end if

        if needsPlaybackRefresh
            m.global.homeNeedsRefresh = false
        end if
    end if

    ' post the device profile the first time this screen is loaded
    if m.isFirstRun
        m.isFirstRun = false
        ' Persist that we've run at least once
        set_setting("home.hasRunBefore", "true")
        m.postTask.arrayData = getDeviceCapabilities()
        m.postTask.apiUrl = "/Sessions/Capabilities/Full"
        m.postTask.control = "RUN"
        m.postTask.observeField("responseCode", "postFinished")
    end if

    if isValid(m.mediaBar) then m.mediaBar.callFunc("setTrailerCovered", false)
    m.seasonalEffects.callFunc("play")
end sub

' JFScreen hook called when the screen is hidden by the screen manager
sub OnScreenHidden()
    ' Don't try to save focus here - SceneManager already did it before calling this
    ' The SceneManager.pushScene() saves currentGroup.lastFocus before removing focus
    ' If we try to check hasFocus() here, it will always be false because
    ' pushScene() calls currentGroup.setFocus(false) before calling OnScreenHidden()

    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav)
        activeNav.callFunc("dehighlightUser")
        activeNav.currentUser = ""
    end if

    ' A preview or trailer has to let go of the media pipeline before the next screen starts its own
    stopPreview()
    if isValid(m.mediaBar) then m.mediaBar.callFunc("setTrailerCovered", true)
    m.seasonalEffects.callFunc("halt")
end sub

' The rows are read again for anything the card menu changed, since it can move a card between
' rows or take one off
sub itemMenuChanged(_action as string, _card as dynamic, _menuJson as object)
    refresh()
end sub

' Triggered by m.postTask after completing a post.
' Empty the task data when finished.
sub postFinished()
    m.postTask.unobserveField("responseCode")
    m.postTask.callFunc("empty")
end sub

' Special handling for key presses on the home screen.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Navigate to overhang with UP key from top row
    if key = KeyCode.UP and m.homeRows.isInFocusChain()
        focusedItem = m.homeRows.rowItemFocused
        currentRowIndex = invalid
        if isValid(focusedItem) and focusedItem.count() > 0
            currentRowIndex = focusedItem[0]
        end if

        ' Check if on first row
        if isValid(currentRowIndex) and currentRowIndex = 0
            ' Check if Media Bar is enabled
            mediaBarEnabled = false
            if isValid(m.homeRows)
                mediaBarCheck = m.homeRows.callFunc("isFeaturedMediaEnabled")
                if isValid(mediaBarCheck) and type(mediaBarCheck) = "roBoolean"
                    mediaBarEnabled = mediaBarCheck
                end if
            end if

            ' If Media Bar is enabled, show it instead of overhang
            if mediaBarEnabled and isValid(m.mediaBar) and not m.mediaBar.isEmpty
                m.currentFocusedItemId = ""
                m.currentFocusedItemServerUrl = invalid

                m.homeRows.setFocus(false)
                applyMediaBarLayout(true)
                m.mediaBar.setFocus(true)
                m.mediaBar.callFunc("refreshCurrentDisplay")

                return true
            end if
        end if

        ' Otherwise go to the nav if on first row
        if isValid(currentRowIndex) and currentRowIndex = 0
            hideModernFocusCard()
            return FocusNav(m.top)
        end if
    end if

    ' Handle navigation between MediaBar and HomeRows
    if isStringEqual(key, KeyCode.DOWN)
        if isValid(m.mediaBar) and m.mediaBar.visible and m.mediaBar.isInFocusChain()
            applyMediaBarLayout(false)

            ' Jump to first row (no placeholder to skip)
            if m.homeRows.content.getChildCount() > 0
                m.homeRows.jumpToRowItem = [0, 0]
            end if

            m.homeRows.setFocus(true)
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.UP)
        if isValid(m.mediaBar) and m.mediaBar.visible and m.mediaBar.isInFocusChain()
            scene = m.top.getScene()
            activeNav = getActiveNav(scene)
            if isValid(activeNav)
                activeNav.setFocus(true)
                return true
            end if
        end if
    end if

    if isStringEqual(key, KeyCode.LEFT)
        scene = m.top.getScene()
        sidebar = scene.findNode("sidebar")
        if isValid(sidebar) and sidebar.visible
            hideModernFocusCard()
            sidebar.setFocus(true)
            return true
        end if
    end if

    ' If the user hit back and is not on the first item of the row,
    ' assume they want to go to the first item of the row.
    ' Otherwise, they are exiting the app.
    if isStringEqual(key, KeyCode.Back)
        if m.homeRows.currFocusColumn > 0
            m.homeRows.jumpToRowItem = [m.homeRows.currFocusRow, 0]
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.OPTIONS)
        if m.homeRows.hasFocus()
            focusedItem = getRowListItemAt(m.homeRows, m.homeRows.rowItemFocused)
            if not isValidAndNotEmpty(focusedItem) then return false

            return showItemMenu(focusedItem, { playImmediately: m.homeRows.callFunc("playsOnSelect", m.homeRows.rowItemFocused[0]) })
        end if
    end if

    ' Seerr - Open with * key
    if isStringEqual(key, "*")
        config = GetSeerrConfig()
        if config.enabled
            seerrHub = CreateObject("roSGNode", "SeerrHubScreen")
            m.global.sceneManager.callFunc("pushScene", seerrHub)
            return true
        end if
    end if

    return false
end function

sub resetFocusedItemDetails()
    m.itemOverview.text = ""
    m.infoRow.removeChildrenIndex(m.infoRow.getChildCount(), 0)
    clearHomeRatings()
end sub

sub clearFocusedItemBackdrop()
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdrop)
        m.backdrop.uri = ""
        m.backdrop.opacity = m.backdropTargetOpacity
    end if

    if isValid(m.backdropPrev)
        m.backdropPrev.uri = ""
        m.backdropPrev.opacity = 0
    end if

    m.backdropCrossfading = false
end sub

sub startBackdropCrossfade(uri as string, matchBlur = false as boolean)
    if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
    if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"

    if isValid(m.backdropPrev) and m.backdrop.uri <> ""
        m.backdropPrev.loadWidth = m.backdrop.loadWidth
        m.backdropPrev.loadHeight = m.backdrop.loadHeight
        m.backdropPrev.uri = m.backdrop.uri
        m.backdropPrev.opacity = m.backdropTargetOpacity
    end if

    loadWidth = 0
    if matchBlur then loadWidth = blurMatchingLoadWidth(uri)
    m.backdrop.loadWidth = loadWidth
    m.backdrop.loadHeight = Int(loadWidth * 9 / 16)
    m.backdrop.opacity = 0.0
    m.backdrop.uri = uri
    m.backdropCrossfading = true
end sub

' The server blurs its own backdrops when asked, but a Seerr or Arr one comes from elsewhere. Loading
' that one small and stretching it over the screen comes close to the server's blur at the same
' setting. Zero leaves it at full size.
function blurMatchingLoadWidth(uri as string) as integer
    blur = getHomeBackdropBlurAmount()
    if blur <= 0 or CreateObject("roRegex", "[?&]blur=", "i").IsMatch(uri) then return 0
    return Int(960 / blur)
end function

sub onItemFocusChanged()
    m.seasonalEffects.callFunc("hold")
    if not isValid(m.homeRows.content) then return

    ' The focus position is gone while the rows are being rebuilt, and the row it
    ' points at can be gone before this runs
    focused = m.homeRows.rowItemFocused
    if not isValid(focused) or focused.count() < 2 then return
    if focused[0] < 0 or focused[1] < 0 then return

    focusedRow = m.homeRows.content.getChild(focused[0])
    if not isValid(focusedRow) then return

    focusedItem = focusedRow.getChild(focused[1])
    if not isValid(focusedItem) then return

    if m.modernHomeRows
        ' focusBitmapUri is set on the whole row list, so it has to follow the focus
        if useModernCardsForRow(focusedRow.id)
            if m.homeRows.focusBitmapUri <> "" then m.homeRows.focusBitmapUri = ""
            applyModernReflow(focused[0], focused[1])
            showModernFocusCard(focusedItem)
            previewOnFocus(focusedItem)
        else
            if m.homeRows.focusBitmapUri <> m.classicFocusBitmapUri then m.homeRows.focusBitmapUri = m.classicFocusBitmapUri
            hideModernFocusCard()
        end if
    end if

    showItemTitle(focusedItem.json, focusedItem.title ?? "")

    resetFocusedItemDetails()

    backdropStyle = getHomeBackdropStyle(m.global.session.user.settings)
    if backdropStyle = "off"
        clearFocusedItemBackdrop()
    else if isValid(m.backdrop) and isValidAndNotEmpty(focusedItem.backdropURL)
        ' A style picked in Settings takes over from the next card
        placement = rowsBackdropPlacement(isValid(m.mediaBar) and m.mediaBar.visible)
        if placement <> m.backdropPlacement then placeBackdrop(placement)
        startBackdropCrossfade(focusedItem.backdropURL, true)
    else
        if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "stop"
        if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "stop"
        m.backdropCrossfading = false
        m.backdropTargetOpacity = 0.3
        if isValid(m.backdropTint)
            m.backdropTint.opacity = 1.0
        end if
    end if

    m.currentFocusedItemId = ""
    m.currentFocusedItemServerUrl = invalid

    if isValidAndNotEmpty(focusedItem.id)
        m.currentFocusedItemId = focusedItem.id
    end if

    if isChainValid(focusedItem, "json._serverUrl") and isValidAndNotEmpty(focusedItem.json._serverUrl)
        m.currentFocusedItemServerUrl = focusedItem.json._serverUrl
    end if

    itemId = focusedItem.id
    if isValidAndNotEmpty(itemId)
        if showCardOwnDetails(focusedItem) then return

        m.loadItemDetailsTask.itemId = itemId

        if isChainValid(focusedItem, "json._serverUrl") and isValidAndNotEmpty(focusedItem.json._serverUrl)
            m.loadItemDetailsTask.serverUrl = focusedItem.json._serverUrl
            m.loadItemDetailsTask.serverUserId = focusedItem.json._userId
            m.loadItemDetailsTask.serverAuthToken = focusedItem.json._authToken
        else
            m.loadItemDetailsTask.serverUrl = ""
            m.loadItemDetailsTask.serverUserId = ""
            m.loadItemDetailsTask.serverAuthToken = ""
        end if

        m.loadItemDetailsTask.control = TaskControl.RUN
    end if
end sub

' Calendar releases and Seerr results are not in the library, so looking them up by id comes
' back empty. Everything they can show is already on the card.
function showCardOwnDetails(focusedItem as object) as boolean
    json = focusedItem.json
    if not isValid(json) then return false
    if not isValid(json.CalendarDate) and not isValid(json.SeerrTmdbId) then return false

    showItemInfo(json, json)
    applyFocusedItemDetails(json, json)
    return true
end function

sub applyFocusedItemDetails(json as object, item as object)
    overview = ""
    hideHomeDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.home.hideMediaDescription`", false), false)
    if not hideHomeDesc
        if isValidAndNotEmpty(item.overview)
            overview = item.overview
        else if isValidAndNotEmpty(json.Overview)
            overview = json.Overview
        end if
    end if

    if isValid(m.itemOverview)
        ' Lines sit 36 apart whatever font the theme draws them in
        m.itemOverview.lineSpacing = OVERVIEW_LINE_HEIGHT - m.overviewLine.boundingRect().height
        m.itemOverview.text = overview
    end if

    if m.modernHomeRows and isValid(m.modernFocusCard)
        m.modernFocusCard.callFunc("setDetails", { meta: buildModernMeta(json, item), overview: overview })
    end if
end sub

sub onItemDetailsLoaded()
    itemData = m.loadItemDetailsTask.content
    if not isValid(itemData) or itemData.count() = 0 then return

    item = itemData[0]
    if not isValid(item) then return

    json = item.json
    if not isValid(json) then return

    loadedItemId = ""
    if isValidAndNotEmpty(item.id)
        loadedItemId = item.id
    else if isValidAndNotEmpty(chainLookupReturn(json, "Id", ""))
        loadedItemId = json.Id
    end if

    if not isValidAndNotEmpty(m.currentFocusedItemId)
        return
    end if

    if not isValidAndNotEmpty(loadedItemId)
        return
    end if

    if LCase(m.currentFocusedItemId) <> LCase(loadedItemId)
        return
    end if

    ' A film or episode's preview reads its sources from here rather than asking again
    m.previewDetails = json

    resetFocusedItemDetails()

    isEpisode = isValid(json.Type) and json.Type = "Episode"

    if isValid(m.backdrop) and getHomeBackdropStyle(m.global.session.user.settings) <> "off"
        backdropUri = ""

        if isEpisode and isValidAndNotEmpty(json.SeriesId)
            if isValidAndNotEmpty(json.ParentBackdropImageTags)
                backdropUri = getBlurredImageURL(json.SeriesId, "Backdrop", json.ParentBackdropImageTags[0])
            end if
        end if

        if backdropUri = ""
            if isValidAndNotEmpty(json.BackdropImageTags)
                backdropUri = getBlurredImageURL(json.Id, "Backdrop", json.BackdropImageTags[0])
            else if isValidAndNotEmpty(json.ImageTags) and isValidAndNotEmpty(json.ImageTags.Primary)
                backdropUri = getBlurredImageURL(json.Id, "Primary", json.ImageTags.Primary)
            end if
        end if

        if isValidAndNotEmpty(backdropUri)
            startBackdropCrossfade(backdropUri)
            m.backdropTargetOpacity = 0.3

            if isValid(m.backdropTint)
                m.backdropTint.opacity = 1.0
            end if
        end if

    end if

    if isValid(json.Type)
        showItemTitle(json, m.itemTitle.text)
        showItemInfo(json, item)
    end if

    applyFocusedItemDetails(json, item)
end sub

' Draws the focused card overlay (landscape image plus info) on top of the row.
' The rest of the info arrives once the details and ratings tasks finish.
sub showModernFocusCard(focusedItem as object)
    if not isValid(m.modernFocusCard) then return

    ' Studios and networks carry a wide logo, which has to sit whole inside the frame on a
    ' dark ground rather than being cropped to fill it. Genre and shortcut tiles use full
    ' backdrop art, so they keep the zoom treatment everything else gets.
    itemDataType = isValid(focusedItem.type) ? LCase(focusedItem.type) : ""
    browseType = LCase(chainLookupReturn(focusedItem, "json.SeerrBrowseType", ""))
    isLogoTile = itemDataType = "seerrbrowse" and (browseType = "studio" or browseType = "network")

    m.modernFocusCard.callFunc("showCard", { item: focusedItem, uris: homeLandscapeUris(focusedItem), logoTile: isLogoTile })
end sub

' The card's wide images best first. It shows the first, and moves down the list when one fails.
function homeLandscapeUris(node as object) as object
    uris = []
    if not isValid(node) then return uris
    for each field in ["thumbnailURL", "widePosterURL", "backdropURL", "posterURL"]
        uri = node.LookupCI(field)
        if isValidAndNotEmpty(uri) then uris.push(uri)
    end for
    return uris
end function

sub hideModernFocusCard()
    stopPreview()
    if isValid(m.modernFocusCard) then m.modernFocusCard.callFunc("hideCard")
end sub

' Slides the items after the focused one aside so the focused landscape card has room
sub applyModernReflow(rowIndex as integer, focusedCol as integer)
    if not isValid(m.modernFocusCard) then return
    m.modernFocusCard.callFunc("reflow", { content: m.homeRows.content, row: rowIndex, col: focusedCol })
end sub

' Builds a "Year • Rating • Runtime" line, adding the community star and series
' status when present, mirroring what the classic top overlay shows.
function buildModernMeta(json as object, item as object) as string
    parts = []

    if isValid(json.ProductionYear) and json.ProductionYear > 0
        parts.push(stri(json.ProductionYear).trim())
    end if

    if isValidAndNotEmpty(json.OfficialRating)
        parts.push(json.OfficialRating)
    end if

    runTimeTicks = invalid
    if type(item.RunTimeTicks) = "LongInteger"
        runTimeTicks = item.RunTimeTicks
    else if type(json.RunTimeTicks) = "LongInteger"
        runTimeTicks = json.RunTimeTicks
    end if

    if isValid(runTimeTicks)
        runTimeMinutes = int(int(runTimeTicks / 10000000&) / 60)
        if runTimeMinutes > 0
            hours = int(runTimeMinutes / 60)
            mins = runTimeMinutes mod 60
            if hours > 0
                if mins > 0
                    parts.push(stri(hours).trim() + "h " + stri(mins).trim() + "m")
                else
                    parts.push(stri(hours).trim() + "h")
                end if
            else
                parts.push(stri(mins).trim() + "m")
            end if
        end if
    end if

    if isValid(json.CommunityRating) and json.CommunityRating > 0
        parts.push("★ " + formatRating(json.CommunityRating))
    end if

    if isValidAndNotEmpty(json.Status) and isStringEqual(json.Type, "Series")
        parts.push(json.Status)
    end if

    meta = ""
    for each part in parts
        if meta <> "" then meta = meta + "  •  "
        meta = meta + part
    end for
    return meta
end function

' The title band shows the logo, an episode's being its series', or the name until one loads
sub showItemTitle(json as dynamic, fallback as string)
    if m.modernHomeRows then return
    if not isValid(json) then json = {}

    title = fallback
    logoUri = ""
    itemType = json.Type ?? ""
    ' A card from another signed in server shows its name, since ImageURL asks the active server
    sameServer = not isValidAndNotEmpty(json._serverUrl)
    if itemType = "Episode"
        if isValidAndNotEmpty(json.SeriesName) then title = json.SeriesName
        if sameServer and isValidAndNotEmpty(json.ParentLogoItemId) and isValidAndNotEmpty(json.ParentLogoImageTag)
            logoUri = ImageURL(json.ParentLogoItemId, "Logo", { maxWidth: 640, maxHeight: 96, Tag: json.ParentLogoImageTag })
        end if
    else if itemType = "Movie" or itemType = "Series"
        logoTag = chainLookupReturn(json, "ImageTags.Logo", "")
        if sameServer and logoTag <> "" then logoUri = ImageURL(json.Id, "Logo", { maxWidth: 640, maxHeight: 96, Tag: logoTag })
    end if

    m.itemTitle.text = title
    if logoUri = m.itemLogo.uri and logoUri <> "" then return

    m.itemLogo.visible = false
    m.itemTitle.visible = true
    m.itemLogo.width = LOGO_MAX_WIDTH
    m.itemLogo.height = LOGO_HEIGHT
    m.itemLogo.translation = [0, 0]
    m.itemLogo.uri = logoUri
end sub

' scaleToFit centers the logo in its box, so the box shrinks to the drawn logo and sits on the
' bottom left of the band
sub onItemLogoLoaded()
    if m.itemLogo.loadStatus <> "ready" or m.itemLogo.bitmapWidth <= 0 or m.itemLogo.bitmapHeight <= 0 then return
    fit = LOGO_HEIGHT / m.itemLogo.bitmapHeight
    if m.itemLogo.bitmapWidth * fit > LOGO_MAX_WIDTH then fit = LOGO_MAX_WIDTH / m.itemLogo.bitmapWidth
    m.itemLogo.width = m.itemLogo.bitmapWidth * fit
    m.itemLogo.height = m.itemLogo.bitmapHeight * fit
    m.itemLogo.translation = [0, LOGO_HEIGHT - m.itemLogo.height]
    m.itemLogo.visible = true
    m.itemTitle.visible = false
end sub

' The info row, the ratings the item already carries, and the plugin's ratings once they arrive
sub showItemInfo(json as object, item as object)
    isEpisode = isStringEqual(json.Type, "Episode")
    if not m.modernHomeRows
        buildInfoRow(json, item)
        m.serverRatings = ratingsRow.ServerEntries(json, "home")
        showHomeRatings([])
    end if

    if isEpisode
        if moonfinPlugin.IsEpisodeRatingsEnabled("home") then fetchHomeRatings(json)
    else if moonfinPlugin.IsRatingsEnabled("home")
        fetchHomeRatings(json)
    end if
end sub

' Episode number and name, year, rating, runtime, resolution and up to three genres, with a dot
' between each
sub buildInfoRow(json as object, item as object)
    parts = []
    if isStringEqual(json.Type, "Episode")
        lead = json.Name ?? ""
        if isValid(json.ParentIndexNumber) and isValid(json.IndexNumber) then lead = `S${json.ParentIndexNumber}:E${json.IndexNumber} - ${lead}`
        if lead <> "" then parts.push(infoLabel(lead, m.infoFonts.lead, "#FFFFFF"))
    end if
    if isValid(json.ProductionYear) and json.ProductionYear > 0 then parts.push(infoLabel(json.ProductionYear.toStr(), m.infoFonts.text, INFO_TEXT_COLOR))
    if isValidAndNotEmpty(json.OfficialRating) then parts.push(infoPill(json.OfficialRating))

    ticks = item.RunTimeTicks ?? json.RunTimeTicks
    minutes = 0
    if isValid(ticks) then minutes = Int(ticks / 600000000&)
    if minutes > 0 and not isStringEqual(json.Type, "Series")
        runtime = `${minutes}m`
        if minutes >= 60 then runtime = `${Int(minutes / 60)}h ${minutes mod 60}m`
        if minutes mod 60 = 0 then runtime = `${Int(minutes / 60)}h`
        parts.push(infoLabel(runtime, m.infoFonts.text, INFO_TEXT_COLOR))
    end if

    resolution = mediaBadges.ResolutionLabel(json)
    if resolution <> "" then parts.push(infoPill(resolution))

    genres = []
    for each genre in json.Genres ?? []
        if genres.Count() < 3 then genres.push(genre)
    end for
    if genres.Count() > 0 then parts.push(infoLabel(genres.Join(", "), m.infoFonts.text, INFO_TEXT_COLOR))

    for i = 0 to parts.Count() - 1
        if i > 0 then m.infoRow.appendChild(infoLabel("•", m.infoFonts.text, "#FFFFFF80"))
        m.infoRow.appendChild(parts[i])
    end for
    themeApply.ApplyToItem(m.infoRow)
end sub

function infoLabel(text as string, font as object, color as string) as object
    label = createObject("roSGNode", "Label")
    label.font = font
    label.color = color
    label.text = text
    return label
end function

function infoPill(text as string) as object
    pill = createObject("roSGNode", "Group")
    fill = pill.createChild("Poster")
    fill.uri = "pkg:/images/makd/dotspill14.9.png"
    fill.blendColor = PILL_COLOR
    fill.opacity = 0.12
    ring = pill.createChild("Poster")
    ring.uri = "pkg:/images/home/pill14s1.9.png"
    ring.blendColor = PILL_COLOR
    ring.opacity = 0.33

    label = pill.createChild("Label")
    label.font = m.infoFonts.pill
    label.color = "#FFFFFFD9"
    label.text = text
    width = label.boundingRect().width + PILL_PADDING * 2
    label.translation = [PILL_PADDING, 0]
    label.height = PILL_HEIGHT
    label.vertAlign = "center"
    for each poster in [fill, ring]
        poster.width = width
        poster.height = PILL_HEIGHT
    end for
    return pill
end function

function systemFont(uri as string, size as integer) as object
    font = createObject("roSGNode", "Font")
    font.uri = uri
    font.size = size
    return font
end function

function formatRating(rating as float) as string
    return Left(rating.toStr(), 3)
end function

sub clearHomeRatings()
    m.serverRatings = invalid
    if isValid(m.homeRatings) then m.homeRatings.ratingsData = invalid

    if isValid(m.homeRatingsDebounce)
        m.homeRatingsDebounce.control = "stop"
    end if
    m.pendingHomeRatingsJson = invalid

    if isValid(m.homeRatingsTask)
        m.homeRatingsTask.unobserveFieldScoped("ratings")
        m.homeRatingsTask = invalid
    end if
end sub

' Labels and badges follow the home rows settings. A row with nothing to show folds away and the
' overview moves up into its place.
sub showHomeRatings(pluginRatings as object)
    moonfinPlugin.StyleRatingsRow(m.homeRatings, "home")
    m.homeRatings.ratingsData = { data: ratingsRow.Merge(m.serverRatings, pluginRatings) }
    m.itemOverview.translation = [0, m.homeRatings.visible ? OVERVIEW_TOP : OVERVIEW_TOP_NO_RATINGS]
end sub

sub fetchHomeRatings(json as object)
    ' An episode is looked up by its series, so its own TMDB id doesn't matter
    itemType = json.Type ?? ""
    if itemType = "" then return
    if moonfinPlugin.GetTmdbId(json.ProviderIds ?? invalid) = "" and itemType <> "Episode" then return

    ' Debounce so rapid row scrolling doesn't fire a request per focus change
    m.pendingHomeRatingsJson = json
    m.homeRatingsDebounce = moonfinPlugin.StartRatingsDebounce(m.homeRatingsDebounce, "onHomeRatingsDebounceFired")
end sub

sub onHomeRatingsDebounceFired()
    json = m.pendingHomeRatingsJson
    if not isValid(json) then return
    m.pendingHomeRatingsJson = invalid

    if isValid(m.homeRatingsTask)
        m.homeRatingsTask.unobserveFieldScoped("ratings")
        m.homeRatingsTask = invalid
    end if

    m.homeRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.homeRatingsTask.itemData = json
    m.homeRatingsTask.scope = "home"
    m.homeRatingsTask.observeFieldScoped("ratings", "onHomeRatingsLoaded")
    m.homeRatingsTask.control = "RUN"
end sub

sub onHomeRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) then return

    displayRatings = result.data
    if not isValidAndNotEmpty(displayRatings) then return

    if m.modernHomeRows
        if isValid(m.modernFocusCard)
            moonfinPlugin.StyleRatingsRow(m.modernFocusCard.findNode("mfRatings"), "home")
            m.modernFocusCard.callFunc("setRatings", result)
        end if
        return
    end if

    showHomeRatings(displayRatings)
end sub

' Helper function to build blurred image URL
' Applies blur to backdrop images for home screen frosted glass effect
function getBlurredImageURL(itemId as string, imageType as string, imageTag as string) as string
    params = {
        "maxHeight": 1080,
        "maxWidth": 1920,
        "quality": 90,
        "blur": getHomeBackdropBlurAmount(),
        "Tag": imageTag
    }
    return ImageURL(itemId, imageType, params)
end function

' Helper function to check if a node is a child/descendant of a parent node
' Walks up the parent chain to see if we find the target parent
function isChildOf(node as object, parent as object) as boolean
    if not isValid(node) or not isValid(parent) then return false

    current = node
    while isValid(current)
        if current.isSameNode(parent) then return true
        current = current.getParent()
    end while

    return false
end function

' Home's rows take the change through their content, and nothing else here shows it
sub userDataApplied(_changes as object)
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="Home" extends="JFScreen">
  <children>
    <!-- Fades the backdrop out toward the left and the bottom in the corner, or toward the middle for Top -->
    <MaskGroup id="backdropMask">
      <!-- Previous backdrop that stays visible until new one loads -->
      <Poster id="backdropPrev" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />

      <!-- Main backdrop with high quality scaling -->
      <Poster id="backdrop" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />
    </MaskGroup>

    <!-- Color tint/scrim overlay for readability - 95% black -->
    <Rectangle id="backdropTint" width="1920" height="1080" color="#F2000000" opacity="1.0" />

    <!-- The focused item's title, info row, ratings and overview, 320 tall above the rows. It starts
         below the top nav and ends just above the row list. -->
    <Group id="detailsSection" translation="[111, 120]">
      <!-- A logo is fitted inside 640 x 96 and sits on the bottom left once it loads -->
      <Poster id="itemLogo" width="640" height="96" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="itemTitle" width="1703" height="96" vertAlign="bottom" color="#FFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="48" />
      </Label>

      <Group translation="[0, 108]" clippingRect="[0, 0, 1703, 36]">
        <LayoutGroup id="infoRow" translation="[0, 18]" layoutDirection="horiz" vertAlignment="center" itemSpacings="[12]" />
      </Group>

      <RatingsRow id="homeRatings" translation="[0, 156]" visible="false" singleLine="true"
        iconHeight="28" valueSize="24" nameSize="18" labelFont="font:SmallestSystemFont"
        labelColor="#FFFFFF" ratingSpacing="10" maxWidth="1703" />

      <Label id="itemOverview" translation="[0, 212]" width="1200" wrap="true" maxLines="3" color="#FFFFFFD9">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
      <!-- Never shown, it measures one line of the overview's font, which a theme can swap -->
      <Label id="overviewLine" text="Ag" visible="false">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
    </Group>

    <!-- Media carousel bar -->
    <MediaBar
      id="mediaBar"
      translation="[0, 223]"
      visible="false" />

    <HomeRows
      id="homeRows"
      translation="[111, 450]"
      showRowLabel="true"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="fixedFocus"
      itemComponentName="HomeItem"
      numRows="2"
      rowLabelOffset="[[0,20]]"
      focusBitmapUri="pkg:/images/posterFocus.9.png" />
    <!-- Modern rows: the focused card is drawn here on top of the row, as a landscape
         thumbnail with its info below -->
    <ModernFocusCard id="modernFocusCard" translation="[111, 225]" visible="false" />

    <!-- The focused card's preview runs on one timer: the dwell before it starts, then how long
         the stream gets to show a frame, then how long it plays -->
    <Timer id="previewTimer" repeat="false" />

    <Animation id="backdropFadeIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdrop.opacity" />
    </Animation>

    <Animation id="backdropPrevFadeOut" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropPrevFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="backdropPrev.opacity" />
    </Animation>

    <!-- Over the whole home screen, and under the nav and dialogs, which the scene draws on top -->
    <SeasonalEffects id="seasonalEffects" />
  </children>
  <interface>
    <field id="playlistData" type="array" />
    <field id="selectedItem" alias="homeRows.selectedItem" alwaysNotify="true" />
    <field id="quickPlayNode" alias="homeRows.quickPlayNode" />
    <field id="shuffleSelectedItem" type="node" alwaysNotify="true" />
    <field id="genreItemSelected" type="assocarray" alwaysNotify="true" />
    <function name="refresh" />
    <function name="reload" />
    <function name="loadLibraries" />
  </interface>
</component>
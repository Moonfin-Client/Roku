import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const ICON_SIZE = 34
const ICON_GAP = 12
const SUMMARY_GAP = 4

sub init()
    m.icon = m.top.findNode("icon")
    m.title = m.top.findNode("title")
    m.summary = m.top.findNode("summary")
    m.subtitle = m.top.findNode("subtitle")
    m.note = m.top.findNode("note")

    iconFont = CreateObject("roSGNode", "Font")
    iconFont.uri = settingsGlyphs.FONT_URI
    iconFont.size = ICON_SIZE
    m.icon.font = iconFont
    m.icon.text = settingsGlyphs.Char("public")
end sub

sub onContentChanged()
    row = m.top.content
    if not isValid(row) then return

    color = chainLookupReturn(m.global.session, "user.settings.colorHomeRowHeaders", ColorPalette.WHITE)
    m.title.color = color
    m.title.text = row.title

    isWatchingNow = row.id = "mdblist_watching_now"
    m.icon.visible = isWatchingNow
    m.title.translation = isWatchingNow ? [ICON_SIZE + ICON_GAP, 0] : [0, 0]
    if isWatchingNow
        m.icon.color = color
        m.icon.height = m.title.boundingRect().height
    end if

    subtitle = row.subtitle
    m.summary.visible = isWatchingNow and isValidAndNotEmpty(subtitle)
    m.note.visible = not isWatchingNow and isValidAndNotEmpty(subtitle)
    if m.summary.visible
        m.subtitle.color = color
        m.subtitle.text = subtitle
        m.summary.translation = [0, m.title.boundingRect().height + SUMMARY_GAP]
    else if m.note.visible
        m.note.color = color
        m.note.text = subtitle
        m.note.translation = [0, m.title.boundingRect().height]
    end if
end sub

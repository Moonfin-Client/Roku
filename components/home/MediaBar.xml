<?xml version="1.0" encoding="utf-8"?>
<component name="MediaBar" extends="Group">
    <children>
        <!-- Logo shadow -->
        <Poster
            id="logoShadow"
            translation="[73, 358]"
            width="400"
            height="120"
            uri=""
            loadDisplayMode="scaleToFit"
            blendColor="0x000000FF"
            opacity="0.6"
            visible="false"
        />

        <!-- Logo image -->
        <Poster
            id="logoImage"
            translation="[70, 355]"
            width="400"
            height="120"
            uri=""
            loadDisplayMode="scaleToFit"
            visible="false"
        />

        <!-- Title text (if no logo available) -->
        <Label
            id="titleText"
            translation="[70, 355]"
            width="820"
            height="80"
            text=""
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="true"
            numLines="2"
            visible="false"
        />

        <!-- Metadata + description + buttons grouped vertically -->
        <LayoutGroup
            id="infoOverlayContent"
            translation="[70, 495]"
            layoutDirection="vert"
            itemSpacings="[8]">

            <!-- Metadata row: Year • Rating • Runtime • ★ Score • Genres -->
            <LayoutGroup
                id="metadataRow"
                layoutDirection="horiz"
                itemSpacings="[12]"
            >
                <Label id="yearLabel" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" text="" />
                <Label id="separatorDot1" font="font:SmallestSystemFont" color="0xFFFFFFFF" text="•" visible="false" />
                <Label id="ratingLabel" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" text="" />
                <Label id="separatorDot2" font="font:SmallestSystemFont" color="0xFFFFFFFF" text="•" visible="false" />
                <Label id="runtimeLabel" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" text="" />
                <Label id="separatorDot3" font="font:SmallestSystemFont" color="0xFFFFFFFF" text="•" visible="false" />
                <Label id="starLabel" font="font:SmallBoldSystemFont" color="0xFFD700FF" text="★" visible="false" />
                <Label id="communityRatingLabel" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" text="" />
                <Label id="separatorDot4" font="font:SmallestSystemFont" color="0xFFFFFFFF" text="•" visible="false" />
                <Label id="genresLabel" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" text="" />
            </LayoutGroup>

            <!-- Overview (2 lines max with ellipsis) -->
            <Label
                id="overviewLabel"
                width="820"
                font="font:SmallestSystemFont"
                color="0xE0E0E0FF"
                wrap="true"
                numLines="2"
                ellipsizeOnBoundary="true"
                text=""
            />

            <!-- Action button row -->
            <LayoutGroup
                id="actionRow"
                layoutDirection="horiz"
                itemSpacings="[14]"
                translation="[0, 4]"
            >
                <!-- Play pill button (pill-focus.9.png is a white 9-patch pill; blendColor controls dark/white) -->
                <Group id="playButton">
                    <Poster
                        id="playBg"
                        uri="pkg:/images/icons/pill-focus.9.png"
                        width="130"
                        height="48"
                        blendColor="0x000000CC"
                    />
                    <Poster
                        id="playIcon"
                        uri="pkg:/images/icons/play.png"
                        width="20"
                        height="20"
                        translation="[14, 14]"
                        blendColor="0xFFFFFFFF"
                        loadDisplayMode="scaleToFit"
                    />
                    <Label
                        id="playLabel"
                        text="Play"
                        font="font:SmallestSystemFont"
                        color="0xFFFFFFFF"
                        translation="[42, 15]"
                    />
                </Group>

                <!-- Info circle button -->
                <Group id="infoButton">
                    <Poster
                        id="infoBg"
                        uri="pkg:/images/icons/circle-bg-white.png"
                        width="48"
                        height="48"
                        blendColor="0x000000CC"
                        loadDisplayMode="scaleToFit"
                    />
                    <Label
                        id="infoLabel"
                        text="i"
                        font="font:MediumBoldSystemFont"
                        color="0xFFFFFFFF"
                        translation="[18, 10]"
                    />
                </Group>

                <!-- Chevron circle button -->
                <Group id="chevronButton">
                    <Poster
                        id="chevronBg"
                        uri="pkg:/images/icons/circle-bg-white.png"
                        width="48"
                        height="48"
                        blendColor="0x000000CC"
                        loadDisplayMode="scaleToFit"
                    />
                    <Poster
                        id="chevronIcon"
                        uri="pkg:/images/icons/chevron-right.png"
                        width="28"
                        height="28"
                        translation="[10, 10]"
                        blendColor="0xFFFFFFFF"
                        loadDisplayMode="scaleToFit"
                    />
                </Group>
            </LayoutGroup>
        </LayoutGroup>

        <!-- Indicator dots — positioned absolutely at component level, centered by code -->
        <LayoutGroup
            id="indicatorDots"
            translation="[960, 730]"
            layoutDirection="horiz"
            itemSpacings="[10]"
        />

        <!-- Pause indicator -->
        <Group
            id="pauseIndicator"
            translation="[920, 80]"
            visible="false"
        >
            <Rectangle width="80" height="40" color="0x000000CC" />
            <Label translation="[12, 8]" text="PAUSED" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
        </Group>

        <Animation id="contentFadeOut" duration="0.2" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator id="contentFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="infoOverlayContent.opacity" />
            <FloatFieldInterpolator id="logoFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="logoImage.opacity" />
            <FloatFieldInterpolator id="logoShadowFadeOutInterp" key="[0.0, 1.0]" keyValue="[0.6, 0.0]" fieldToInterp="logoShadow.opacity" />
            <FloatFieldInterpolator id="titleFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="titleText.opacity" />
        </Animation>

        <Animation id="contentFadeIn" duration="0.3" repeat="false" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="contentFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="infoOverlayContent.opacity" />
            <FloatFieldInterpolator id="logoFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="logoImage.opacity" />
            <FloatFieldInterpolator id="logoShadowFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 0.6]" fieldToInterp="logoShadow.opacity" />
            <FloatFieldInterpolator id="titleFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="titleText.opacity" />
        </Animation>
    </children>

    <interface>
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="quickPlayNode" type="node" alwaysNotify="true" />
        <field id="hasFocus" type="boolean" value="false" alwaysNotify="true" />
        <field id="currentBackdrop" type="string" alwaysNotify="true" />
        <field id="contentType" type="string" value="" />
        <field id="navigateDown" type="boolean" value="false" alwaysNotify="true" />
    </interface>
</component>

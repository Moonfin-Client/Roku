<?xml version="1.0" encoding="utf-8"?>
<component name="MediaBar" extends="Group">
    <children>
        <!-- Note: Backdrop is managed by parent Home component, not locally -->

        <!-- The current title's trailer, under everything the styles draw so the artwork can
            be cleared away from over it. Its place and size follow the style. -->
        <Video id="trailerVideo" visible="false" enableUI="false" enableTrickPlay="false" />


        <Poster
            id="logoShadow"
            uri=""
            loadDisplayMode="scaleToFit"
            blendColor="0x000000"
            opacity="0.6"
            visible="false"
        />

        <Poster
            id="logoImage"
            uri=""
            loadDisplayMode="scaleToFit"
            visible="false"
        />

        <!-- Title text (if no logo available) -->
        <Label
            id="titleText"
            text=""
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="true"
            maxLines="2"
            visible="false"
        />

        <MediaBarNewReleaseLabel id="featuredRelease" />

        <!-- Info overlay content with background box. Its place, width and the
            row of facts inside it are all settled at runtime. -->
        <Poster
            id="infoBackground"
            uri="pkg:/images/mediabar/infobox23.9.png"
            loadDisplayMode="scaleToFit"
        />

        <LayoutGroup
            id="infoOverlayContent"
            layoutDirection="vert">
            <LayoutGroup id="metadataRow" layoutDirection="horiz" vertAlignment="center" />

            <RatingsRow
                id="ratingsRow"
                visible="false"
                labelColor="#FFFFFF"
            />

            <Label
                id="overviewLabel"
                font="font:SmallestSystemFont"
                color="0xFFFFFFE6"
                wrap="true"
                maxLines="3"
                text=""
            />
        </LayoutGroup>

        <!-- Never shown, they just lend their sizes to the row built at runtime -->
        <Label id="featuredMetaFont" font="font:SmallestBoldSystemFont" visible="false" />
        <Label id="featuredBadgeFont" font="font:SmallestBoldSystemFont" visible="false" />

        <!-- Left navigation arrow -->
        <Group
            id="leftArrow"
            translation="[20, 282]"
            visible="false"
        >
            <Poster
                id="leftArrowBg"
                width="70"
                height="70"
                uri="pkg:/images/icons/circle.webp"
                loadDisplayMode="scaleToFit"
            />
            <Poster
                width="48"
                height="48"
                translation="[8, 11]"
                uri="pkg:/images/icons/chevron-left.webp"
                loadDisplayMode="scaleToFit"
            />
        </Group>

        <!-- Right navigation arrow -->
        <Group
            id="rightArrow"
            translation="[1830, 282]"
            visible="false"
        >
            <Poster
                id="rightArrowBg"
                width="70"
                height="70"
                uri="pkg:/images/icons/circle.webp"
                loadDisplayMode="scaleToFit"
            />
            <Poster
                width="48"
                height="48"
                translation="[13, 11]"
                uri="pkg:/images/icons/chevron-right.webp"
                loadDisplayMode="scaleToFit"
            />
        </Group>

        <Poster
            id="dotsBackground"
            uri="pkg:/images/dots.9.png"
            loadDisplayMode="scaleToFit"
        />
        <LayoutGroup
            id="indicatorDots"
            layoutDirection="horiz"
            vertAlignment="center"
        />

        <!-- Banner mode: a rounded card across the top with the rows below it.
            Its place and width are settled at runtime, since a docked sidebar
            takes a bite out of the left of the screen. -->
        <Group id="bannerGroup" visible="false">
            <Poster id="bannerGlow" uri="pkg:/images/settings/glow.9.png" opacity="0.4"
                visible="false" />
            <ScreenMask id="bannerMask" maskUri="pkg:/images/banner/cardmask.webp">
                <Rectangle id="bannerCardBg" color="#101010" />
                <Poster id="bannerBackdrop" loadDisplayMode="scaleToZoom" />
                <Poster id="bannerFill" loadDisplayMode="scaleToZoom" visible="false" />
                <Poster id="bannerArt" loadDisplayMode="scaleToFit" visible="false" />
                <Poster id="bannerGradient" uri="pkg:/images/banner/cardgradient.webp"
                    loadDisplayMode="scaleToFill" />
                <Group id="bannerContent">
                    <Poster id="bannerLogo" height="93" loadDisplayMode="scaleToFit"
                        visible="false" />
                    <Label id="bannerTitle" ellipsisText="..."
                        font="font:LargeBoldSystemFont" color="#FFFFFF" visible="false" />
                    <MediaBarNewReleaseLabel id="bannerRelease" />
                    <Label id="bannerMeta" font="font:SmallBoldSystemFont" color="#FFFFFFBF" />
                    <RatingsRow id="bannerRatings" visible="false"
                        labelFont="font:SmallestBoldSystemFont" labelColor="#FFFFFF"
                        iconHeight="24" ratingSpacing="16" />
                </Group>
                <LayoutGroup id="bannerDots" layoutDirection="horiz" vertAlignment="top" />
            </ScreenMask>
            <Poster id="bannerFocus" uri="pkg:/images/login/stroke27w4.9.png"
                loadDisplayMode="scaleToFit" visible="false" />
        </Group>

        <!-- MakD mode, makd's media bar in its Classic layout: the backdrop under a light shade
            and a corner wash, fading into the page at the foot, with a column of logo, facts,
            overview and buttons on the left. The negative offset lands it at the top of the
            screen, since this component sits well down the page. -->
        <Group id="makdGroup" visible="false" translation="[0, -223]">
            <!-- The overlay color and opacity set both, see applyOverlaySettings -->
            <Rectangle id="makdShade" width="1920" height="1080" color="#000000FF" opacity="0.2" />
            <Poster id="makdWash" uri="pkg:/images/makd/wash130.webp" width="1920" height="1080"
                loadDisplayMode="scaleToFill" blendColor="#1D1D1D" opacity="0.65" />
            <Poster id="makdFade" uri="pkg:/images/makd/fadeBottom.webp" translation="[0, 994]"
                width="1920" height="86" loadDisplayMode="scaleToFill" />
            <Group id="makdContent">
                <Poster id="makdLogo" loadDisplayMode="scaleToFit" opacity="0" />
                <Label id="makdTitle" wrap="true" maxLines="2" vertAlign="bottom"
                    color="#FFFFFF" visible="false">
                    <Font role="font" uri="font:SystemFontFile" size="80" />
                </Label>
                <MediaBarNewReleaseLabel id="makdRelease" />
                <Group id="makdInfo" />
                <Group id="makdGenres" />
                <Label id="makdOverview" wrap="true" maxLines="3" lineSpacing="4" color="#FFFFFF">
                    <Font role="font" uri="font:SystemFontFile" size="20" />
                </Label>
                <Group id="makdButtons" />
            </Group>
            <Group id="makdDots" />
            <Group id="makdArrows" visible="false">
                <Group id="makdArrowLeft">
                    <Poster width="70" height="70" uri="pkg:/images/icons/circle.webp"
                        blendColor="#0A0C12" opacity="0.42" />
                    <Poster width="70" height="70" uri="pkg:/images/icons/circleRing.webp"
                        opacity="0.28" />
                    <Poster width="40" height="40" translation="[15, 15]"
                        uri="pkg:/images/icons/chevron-left.webp" loadDisplayMode="scaleToFit" />
                </Group>
                <Group id="makdArrowRight">
                    <Poster width="70" height="70" uri="pkg:/images/icons/circle.webp"
                        blendColor="#0A0C12" opacity="0.42" />
                    <Poster width="70" height="70" uri="pkg:/images/icons/circleRing.webp"
                        opacity="0.28" />
                    <Poster width="40" height="40" translation="[15, 15]"
                        uri="pkg:/images/icons/chevron-right.webp" loadDisplayMode="scaleToFit" />
                </Group>
            </Group>
            <!-- Never shown, they lend their fonts to the rows built at runtime -->
            <Label id="makdFontMedium" visible="false">
                <Font role="font" uri="pkg:/fonts/ArchivoNarrow-Medium.ttf" size="20" />
            </Label>
            <Label id="makdFontBold" visible="false">
                <Font role="font" uri="pkg:/fonts/ArchivoNarrow-Bold.ttf" size="20" />
            </Label>
            <Label id="makdFontPlay" visible="false">
                <Font role="font" uri="pkg:/fonts/ArchivoNarrow-Bold.ttf" size="18" />
            </Label>
        </Group>

        <!-- Gallery mode. The negative offset lands the row at the top of the
            screen, since this component sits well down the page. -->
        <Group id="galleryGroup" visible="false" translation="[24, -126]">
            <!-- An ambient wash behind the panels, tinted by the open one's genre -->
            <Poster
                id="galleryGlow"
                uri="pkg:/images/gallery/glow.png"
                loadDisplayMode="scaleToFill"
                translation="[-56, -303]"
                width="1600"
                height="1600"
                opacity="0.42"
            />
            <MarkupGrid
                id="galleryGrid"
                itemComponentName="GalleryItem"
                numColumns="5"
                numRows="1"
                itemSize="[1920, 951]"
                rowHeights="[951]"
                itemSpacing="[6, 0]"
                drawFocusFeedback="false"
                columnWidths="[1478, 92, 92, 92, 92]"
            />
        </Group>

        <!-- Bookshelf mode -->
        <Group id="bookshelfGroup" visible="false" translation="[29, 30]">
            <MarkupGrid
                id="bookshelfGrid"
                itemComponentName="BookshelfItem"
                numRows="1"
                itemSize="[60, 800]"
                itemSpacing="[5, 0]"
                drawFocusFeedback="false"
                columnWidths="[660, 60, 60, 60, 60]"
            />
        </Group>

        <!-- Aya mode: a rounded hero frame that floats in the page over a dimmed
            copy of the same artwork. The negative offset lands it at the top of
            the screen, since this component sits well down the page. -->
        <Group id="ayaGroup" visible="false" translation="[80, -73]" scaleRotateCenter="[880, 351]">
            <ScreenMask id="ayaMask" maskUri="pkg:/images/mediabar/aya_frame_mask.webp">
                <Rectangle id="ayaFrameBg" width="1760" height="702" color="#101010" />
                <Poster id="ayaBackdrop" width="1760" height="702" loadDisplayMode="scaleToZoom" />
                <Poster id="ayaBackdropNext" width="1760" height="702"
                    loadDisplayMode="scaleToZoom" opacity="0" />
                <Poster id="ayaLogo" translation="[44, 40]" width="340" height="100"
                    loadDisplayMode="scaleToFit" visible="false" />
                <Label id="ayaTitle" translation="[44, 40]" width="440" wrap="true"
                    maxLines="2" font="font:LargeBoldSystemFont" color="#FFFFFF" visible="false" />
                <MediaBarNewReleaseLabel id="ayaRelease" />
                <LayoutGroup id="ayaIndicators" layoutDirection="horiz"
                    vertAlignment="center" itemSpacings="[5]" />
            </ScreenMask>
            <Poster id="ayaFocusRing" uri="pkg:/images/mediabar/ayafocus.9.png"
                translation="[-4, -4]" width="1768" height="710" loadDisplayMode="scaleToFit"
                blendColor="#FFFFFF" visible="false" />
        </Group>

        <Group id="trailerCaptions" visible="false">
            <Label id="trailerCaptionShadow" translation="[2, 2]" font="font:MediumBoldSystemFont"
                color="0x000000CC" horizAlign="center" vertAlign="bottom" wrap="true" />
            <Label id="trailerCaption" font="font:MediumBoldSystemFont" color="0xFFFFFFFF"
                horizAlign="center" vertAlign="bottom" wrap="true" />
        </Group>
        <Timer id="trailerRevealTimer" duration="3" repeat="false" />

        <!-- Pause indicator (shows when paused) -->
        <Group
            id="pauseIndicator"
            translation="[1772, 808]"
            visible="false"
        >
            <Rectangle
                width="148"
                height="50"
                color="0x000000"
                opacity="0.8"
            />
            <Label
                translation="[12, 10]"
                text="PAUSED"
                font="font:SmallBoldSystemFont"
                color="0xFFFFFFFF"
            />
        </Group>

        <Animation id="ayaSlideIn" duration="0.42" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="ayaSlideInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]"
                fieldToInterp="ayaBackdropNext.opacity" />
        </Animation>

        <!-- MakD: each slide's column fades in, and the logo sharpens in from 70% as it loads -->
        <Animation id="makdContentIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]"
                fieldToInterp="makdContent.opacity" />
        </Animation>
        <Animation id="makdLogoIn" duration="1.2" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.7, 1.0]"
                fieldToInterp="makdLogo.opacity" />
        </Animation>
        <!-- The lit dot grows as the one before it shrinks back. Which dots they are is set as they change. -->
        <Animation id="makdDotMove" duration="0.5" repeat="false" easeFunction="inOutQuad">
            <Vector2DFieldInterpolator id="makdDotGrow" key="[0.0, 1.0]"
                keyValue="[[1.0, 1.0], [1.7, 1.7]]" />
            <Vector2DFieldInterpolator id="makdDotShrink" key="[0.0, 1.0]"
                keyValue="[[1.7, 1.7], [1.0, 1.0]]" />
        </Animation>

        <Animation id="contentFadeOut" duration="0.2" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator id="contentFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="infoOverlayContent.opacity" />
            <FloatFieldInterpolator id="logoFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="logoImage.opacity" />
            <FloatFieldInterpolator id="logoShadowFadeOutInterp" key="[0.0, 1.0]" keyValue="[0.6, 0.0]" fieldToInterp="logoShadow.opacity" />
            <FloatFieldInterpolator id="titleFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="titleText.opacity" />
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="featuredRelease.opacity" />
            <FloatFieldInterpolator id="infoBgFadeOutInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="infoBackground.opacity" />
        </Animation>

        <Animation id="contentFadeIn" duration="0.3" repeat="false" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="contentFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="infoOverlayContent.opacity" />
            <FloatFieldInterpolator id="logoFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="logoImage.opacity" />
            <FloatFieldInterpolator id="logoShadowFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 0.6]" fieldToInterp="logoShadow.opacity" />
            <FloatFieldInterpolator id="titleFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="titleText.opacity" />
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="featuredRelease.opacity" />
            <FloatFieldInterpolator id="infoBgFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="infoBackground.opacity" />
        </Animation>
    </children>

    <interface>
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="hasFocus" type="boolean" value="false" alwaysNotify="true" />
        <field id="currentBackdrop" type="string" alwaysNotify="true" />
        <!-- Stays false until a load actually comes back with nothing -->
        <field id="isEmpty" type="boolean" value="false" />
        <!-- On while a trailer fills the screen behind the bar, so Home clears its own chrome too -->
        <field id="fullScreenTrailer" type="boolean" value="false" />
        <!-- The titles on the bar as { title, genres }, which After Hours stacks in Case Stack -->
        <field id="titles" type="array" />
        <function name="refreshCurrentDisplay" />
        <function name="setTrailerCovered" />
        <function name="drawNewSet" />
    </interface>
</component>
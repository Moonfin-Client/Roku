<?xml version="1.0" encoding="utf-8"?>
<component name="GalleryItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="contentChanged" />
    </interface>
    <children>
        <!-- The idle panel: its place in the run, the title turned on its side,
            and a line above and below tinted by the genre -->
        <Group id="narrowContent">
            <MaskGroup id="narrowMask" maskUri="pkg:/images/gallery/panelnarrow_mask.png">
                <Poster id="narrowPoster" width="92" height="951" loadDisplayMode="scaleToZoom"
                    opacity="0.35" />
                <Poster id="narrowScrim" uri="pkg:/images/gallery/panelscrim.png"
                    loadDisplayMode="scaleToFill" width="92" height="951" />
            </MaskGroup>
            <Label id="itemNumber" translation="[0, 16]" width="92" height="26"
                font="font:SmallestBoldSystemFont" color="#FFFFFFD9" horizAlign="center" />
            <Rectangle id="narrowLineTop" width="2" color="#4A5A78" />
            <Label id="narrowTitle" rotation="-1.5708" horizAlign="center" vertAlign="center"
                font="font:SmallBoldSystemFont" color="#FFFFFF" />
            <Rectangle id="narrowLineBottom" width="2" color="#4A5A78" />
        </Group>

        <!-- The open panel: the title and its facts on the left, who made it on
            the right -->
        <Group id="wideContent" visible="false">
            <MaskGroup id="wideMask" maskUri="pkg:/images/gallery/panelwide_mask.png">
                <Poster id="itemBackdrop" width="1478" height="951" loadDisplayMode="scaleToZoom" />
                <Poster id="wideScrim" uri="pkg:/images/gallery/panelscrim.png"
                    loadDisplayMode="scaleToFill" width="1478" height="951" />
            </MaskGroup>

            <Group id="wideLeft" translation="[48, 40]">
                <Label id="itemTitle" width="812" wrap="true" maxLines="2"
                    font="font:ExtraLargeBoldSystemFont" color="#FFFFFF" />
                <Group id="galleryPills" />
                <!-- Never shown, it just lends its size to the pills built at runtime -->
                <Label id="pillFont" font="font:SmallestBoldSystemFont" visible="false" />
                <RatingsRow id="galleryRatings" visible="false"
                    labelFont="font:SmallestBoldSystemFont" labelColor="#FFFFFF"
                    iconHeight="26" ratingSpacing="16" />
                <Label id="gOverview" width="812" wrap="true" maxLines="4"
                    font="font:SmallSystemFont" color="#FFFFFFE6" />
            </Group>

            <Group id="wideRight" translation="[888, 40]">
                <Poster id="creditsFill" uri="pkg:/images/gallery/credits18.9.png"
                    loadDisplayMode="scaleToFit" width="542" height="200"
                    blendColor="#000000" opacity="0.55" />
                <Poster id="creditsBorder" uri="pkg:/images/gallery/creditsborder18.9.png"
                    loadDisplayMode="scaleToFit" width="542" height="200" blendColor="#FFFFFF1F" />
                <Label id="directorLabel" width="506" height="20"
                    font="font:SmallestBoldSystemFont" color="#00A4DC" />
                <Label id="directorValue" width="506" wrap="true"
                    maxLines="2" font="font:SmallestBoldSystemFont" color="#FFFFFF" />
                <Label id="starringLabel" width="506" height="20"
                    font="font:SmallestBoldSystemFont" color="#00A4DC" />
                <Label id="starringValue" width="506" wrap="true"
                    maxLines="2" font="font:SmallestBoldSystemFont" color="#FFFFFF" />
            </Group>
        </Group>
    </children>
</component>

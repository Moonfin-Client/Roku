<?xml version="1.0" encoding="utf-8"?>
<component name="HomePreviewTask" extends="Task">
    <interface>
        <!-- "resolve" finds what the focused card plays, "stop" tells the server a finished
            preview's transcode can go. A fresh task per call. -->
        <field id="action" type="string" />
        <!-- resolve: { requestId, item: { Id, Type }, server }. A series resolves to its next
            episode, and the target comes back with its sources, streams and user data.
            stop: { server, playSessionId }.
            server is { url, userId, token, remote }, the item's own on a multi-server row. -->
        <field id="request" type="assocarray" />
        <!-- { requestId, target }, with no target when there is nothing to play -->
        <field id="answer" type="assocarray" />
    </interface>
</component>

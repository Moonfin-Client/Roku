<?xml version="1.0" encoding="utf-8"?>
<component name="HomePreviewTask" extends="Task">
    <interface>
        <!-- "resolve" finds what the focused card plays, "trailer" finds its trailer, "stop"
            tells the server a finished preview's transcode can go. A fresh task per call. -->
        <field id="action" type="string" />
        <!-- resolve: { requestId, item: { Id, Type }, server }. A series resolves to its next
            episode, and the target comes back with its sources, streams and user data.
            trailer: { requestId, item: { Id, RemoteTrailers }, server }, where the item is the
            one whose trailer plays, or { requestId, details } for a title with no server item,
            where details is the plugin's TMDB details query.
            stop: { server, playSessionId }.
            server is { url, userId, token, remote }, the item's own on a multi-server row. -->
        <field id="request" type="assocarray" />
        <!-- { requestId, target }, with no target when there is nothing to play. A trailer on
            YouTube comes back as { requestId, videoId } instead. -->
        <field id="answer" type="assocarray" />
    </interface>
</component>

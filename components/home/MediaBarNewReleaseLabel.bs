import "pkg:/source/utils/mediaBarNewRelease.bs"
import "pkg:/source/utils/misc.bs"

const KIND_HEIGHT = 30
const DETAIL_HEIGHT = 48
const BAR_GAP = 17

sub init()
    m.bar = m.top.findNode("bar")
    m.kind = m.top.findNode("kind")
    m.detail = m.top.findNode("detail")
    m.bar.height = KIND_HEIGHT + DETAIL_HEIGHT
    m.top.visible = false
end sub

sub redraw()
    release = m.top.release
    label = ""
    if isValid(release) then label = mediaBarNewRelease.Label(release)
    if label = ""
        m.top.visible = false
        m.top.labelHeight = 0
        return
    end if

    detail = mediaBarNewRelease.Detail(release)
    ' The bar ties two lines together, so a label alone goes without it
    hasDetail = detail <> ""
    textLeft = hasDetail ? 3 + BAR_GAP : 0
    m.kind.text = UCase(label)
    m.kind.translation = [textLeft, 0]
    m.detail.text = detail
    m.detail.translation = [textLeft, KIND_HEIGHT]
    m.detail.visible = hasDetail
    m.bar.visible = hasDetail
    m.top.labelHeight = hasDetail ? KIND_HEIGHT + DETAIL_HEIGHT : KIND_HEIGHT
    m.top.visible = true
end sub

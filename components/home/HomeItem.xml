<?xml version="1.0" encoding="utf-8"?>
<component name="HomeItem" extends="Group">
  <children>
    <Group id="scaleGroup">
      <Rectangle id="backdrop" width="180" height="270" translation="[0,0]" />
      <Poster id="itemIcon" width="80" height="80" translation="[50,95]" loadDisplayMode="scaleToFit" />
      <Text id="posterText" width="180" height="270" translation="[0,0]" horizAlign="center" vertAlign="center" wrap="true" ellipsizeOnBoundary="true" visible="false" />

      <MaskGroup id="posterMask">
        <Poster id="itemPoster" width="180" height="270" translation="[0,0]" loadDisplayMode="scaleToZoom" loadingBitmapUri="pkg:/images/posterVertMask.png" />
      </MaskGroup>

      <PlayedCheckmark id="playedIndicator" translation="[130, 10]" />

      <!-- The width here is a starting point. It is set from the card's own width once an
           item is bound, since a row draws cards at several widths. -->
      <Poster id="progressBackground" uri="pkg:/images/details/badgefill6.9.png" visible="false"
        width="168" height="12" translation="[6,252]">
        <Poster id="progress" uri="pkg:/images/details/badgefill6.9.png" width="0" height="12" />
      </Poster>

      <ScrollingText id="itemText" horizAlign="center" vertAlign="center" font="font:SmallSystemFont" height="64" maxWidth="172" translation="[2,275]" repeatCount="0" />
    </Group>

    <!-- Modern rows: slides this cell aside so the focused landscape card has room. The
         duration and easing match the card's own fade so the two read as one movement -->
    <Animation id="modernShiftAnim" duration="0.2" repeat="false" easeFunction="outExpo">
      <Vector2DFieldInterpolator id="modernShiftInterp" key="[0.0, 1.0]" fieldToInterp="scaleGroup.translation" />
      <FloatFieldInterpolator id="modernShiftPosterOpacity" key="[0.0, 1.0]" fieldToInterp="itemPoster.opacity" />
      <FloatFieldInterpolator id="modernShiftTextOpacity" key="[0.0, 1.0]" fieldToInterp="itemText.opacity" />
    </Animation>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="focusChanged" />
    <field id="drawFocusFeedback" type="boolean" value="true" />
  </interface>
</component>
<?xml version="1.0" encoding="utf-8"?>
<component name="HomeRows" extends="RowList">
  <interface>
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" />
    <field id="contentLoaded" type="boolean" value="false" alwaysNotify="true" />
    <field id="keyPressedNotifier" type="boolean" value="false" alwaysNotify="true" />
    <!-- [row, column] a left or right press is moving to, set before the row starts to scroll -->
    <field id="moveTarget" type="array" alwaysNotify="true" />
    <function name="updateHomeRows" />
    <function name="reloadHomeRows" />
    <function name="loadLibraries" />
    <function name="isFeaturedMediaEnabled" />
  </interface>
</component>

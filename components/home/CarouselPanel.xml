<?xml version="1.0" encoding="utf-8"?>
<!-- The details panel under a Carousel row's cards. It shows one card: the row's focused one, the
     last one focused once focus leaves the row, or the first before the row is ever focused. -->
<component name="CarouselPanel" extends="Group">
  <children>
    <CarouselPanelFace id="faceA" opacity="0" />
    <CarouselPanelFace id="faceB" opacity="0" />
    <Animation id="crossfade" duration="0.3" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="fadeIn" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="faceA.opacity" />
      <FloatFieldInterpolator id="fadeOut" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="faceB.opacity" />
    </Animation>
    <!-- Home loads the focused card's details itself, so the panel waits a moment before asking -->
    <Timer id="detailsWait" repeat="false" duration="0.5" />
  </children>
  <interface>
    <!-- The card to show, one of a home row's content nodes -->
    <field id="item" type="node" onChange="onItemChanged" />
    <!-- The settings preview's { ratings, hideOverview, backdrop }, which stand in for fetching -->
    <field id="preview" type="assocarray" />
    <!-- Drawn scaled down in a settings preview, see CarouselPanelFace -->
    <field id="flat" type="boolean" value="false" onChange="onFlatChanged" />
    <!-- An item's full details, when Home has loaded them first -->
    <function name="setDetails" />
  </interface>
</component>

sub init()
    m.logoImage = m.top.findNode("logoImage")
    m.logoShadow = m.top.findNode("logoShadow")
    m.titleText = m.top.findNode("titleText")
    m.featuredRelease = m.top.findNode("featuredRelease")
    m.overviewLabel = m.top.findNode("overviewLabel")
    m.leftArrow = m.top.findNode("leftArrow")
    m.rightArrow = m.top.findNode("rightArrow")
    m.indicatorDots = m.top.findNode("indicatorDots")
    m.pauseIndicator = m.top.findNode("pauseIndicator")
    m.infoOverlayContent = m.top.findNode("infoOverlayContent")
    m.infoBackground = m.top.findNode("infoBackground")
    m.dotsBackground = m.top.findNode("dotsBackground")

    ' Arrow background elements
    m.leftArrowBg = m.top.findNode("leftArrowBg")
    m.rightArrowBg = m.top.findNode("rightArrowBg")

    m.ratingsRow = m.top.findNode("ratingsRow")

    m.galleryGroup = m.top.findNode("galleryGroup")
    m.galleryGrid = m.top.findNode("galleryGrid")
    m.galleryGlow = m.top.findNode("galleryGlow")

    m.bookshelfGroup = m.top.findNode("bookshelfGroup")
    m.bookshelfGrid = m.top.findNode("bookshelfGrid")

    m.ayaGroup = m.top.findNode("ayaGroup")
    m.ayaBackdrop = m.top.findNode("ayaBackdrop")
    m.ayaBackdropNext = m.top.findNode("ayaBackdropNext")
    m.ayaLogo = m.top.findNode("ayaLogo")
    m.ayaTitle = m.top.findNode("ayaTitle")
    m.ayaRelease = m.top.findNode("ayaRelease")
    m.ayaIndicators = m.top.findNode("ayaIndicators")
    m.ayaFocusRing = m.top.findNode("ayaFocusRing")
    m.ayaMask = m.top.findNode("ayaMask")
    m.ayaFrameBg = m.top.findNode("ayaFrameBg")

    m.makdGroup = m.top.findNode("makdGroup")
    m.makdContent = m.top.findNode("makdContent")
    m.makdLogo = m.top.findNode("makdLogo")
    m.makdLogo.observeFieldScoped("loadStatus", "onMakdLogoStatus")
    m.makdRelease = m.top.findNode("makdRelease")
    m.makdTitle = m.top.findNode("makdTitle")
    m.makdTitle.width = MAKD_COLUMN_WIDTH
    m.makdInfo = m.top.findNode("makdInfo")
    m.makdGenres = m.top.findNode("makdGenres")
    m.makdOverview = m.top.findNode("makdOverview")
    m.makdOverview.width = MAKD_COLUMN_WIDTH
    m.makdButtons = m.top.findNode("makdButtons")
    m.makdDots = m.top.findNode("makdDots")
    m.makdArrows = m.top.findNode("makdArrows")
    m.makdContentIn = m.top.findNode("makdContentIn")
    m.makdLogoIn = m.top.findNode("makdLogoIn")
    m.makdDotMove = m.top.findNode("makdDotMove")
    m.makdDotGrow = m.top.findNode("makdDotGrow")
    m.makdDotShrink = m.top.findNode("makdDotShrink")
    m.makdFade = m.top.findNode("makdFade")
    m.top.findNode("makdArrowRight").translation = [MAKD_ARROWS_RIGHT - MAKD_ARROW, 540 - MAKD_ARROW / 2]
    m.top.findNode("makdArrowLeft").translation = [MAKD_ARROWS_RIGHT - MAKD_ARROW * 2 - MAKD_ARROW_GAP, 540 - MAKD_ARROW / 2]
    ' Which of Info, Play and Favorite carries the focus ring while the bar has focus
    m.makdButton = 0
    m.makdFocused = false
    m.makdShownId = ""
    m.makdPluginRatings = []

    m.metadataRow = m.top.findNode("metadataRow")

    m.bannerGroup = m.top.findNode("bannerGroup")
    m.bannerMask = m.top.findNode("bannerMask")
    m.bannerCardBg = m.top.findNode("bannerCardBg")
    m.bannerBackdrop = m.top.findNode("bannerBackdrop")
    m.bannerFill = m.top.findNode("bannerFill")
    m.bannerArt = m.top.findNode("bannerArt")
    m.bannerArt.observeFieldScoped("loadStatus", "onBannerArtStatus")
    m.bannerGradient = m.top.findNode("bannerGradient")
    m.bannerContent = m.top.findNode("bannerContent")
    m.bannerLogo = m.top.findNode("bannerLogo")
    m.bannerLogo.observeFieldScoped("loadStatus", "onBannerLogoStatus")
    m.bannerTitle = m.top.findNode("bannerTitle")
    m.bannerRelease = m.top.findNode("bannerRelease")
    m.bannerMeta = m.top.findNode("bannerMeta")
    m.bannerRatings = m.top.findNode("bannerRatings")
    m.bannerDots = m.top.findNode("bannerDots")
    m.bannerFocus = m.top.findNode("bannerFocus")
    m.bannerGlow = m.top.findNode("bannerGlow")

    m.bannerTitle.font.size = 46
    m.bannerMeta.font.size = 20
    m.bannerDots.itemSpacings = [BANNER_DOT_GAP]

    m.ayaSlideIn = m.top.findNode("ayaSlideIn")
    m.ayaSlideIn.observeField("state", "onAyaSlideInComplete")

    m.global.observeFieldScoped("mediaBarModeChanged", "onMediaBarModeChanged")
    applyCurrentStyle()

    ' Content fade animations
    m.contentFadeOut = m.top.findNode("contentFadeOut")
    m.contentFadeIn = m.top.findNode("contentFadeIn")
    m.infoBgFadeInInterp = m.top.findNode("infoBgFadeInInterp")
    m.logoShadowFadeInInterp = m.top.findNode("logoShadowFadeInInterp")
    m.pendingDisplayIndex = -1
    if isValid(m.contentFadeOut)
        m.contentFadeOut.observeFieldScoped("state", "onContentFadeOutComplete")
    end if

    ' Initialize state
    m.mediaBarItems = []
    m.currentIndex = 0
    m.isPaused = false
    m.clearBackdrop = false

    ' Gallery mode state
    m.galleryPages = []
    m.galleryPageContentNodes = []
    m.galleryCurrentPage = 0
    m.galleryActiveIndex = 0
    m.galleryTotalPages = 0

    ' Bookshelf mode state
    m.bookshelfContentNode = invalid
    m.bookshelfActiveIndex = 0

    ' Make component focusable
    m.top.focusable = true

    ' Observe visibility changes to refresh display when shown
    m.top.observeFieldScoped("visible", "onVisibilityChanged")

    ' Observe focus changes to ensure backdrop is set on initial focus
    m.top.observeFieldScoped("hasFocus", "onFocusChanged")
    m.top.observeField("focusedChild", "onMediaBarFocusChanged")

    ' Observe overlay settings changes
    if isValid(m.global)
        m.global.observeFieldScoped("overlaySettingsChanged", "onOverlaySettingsChanged")
        ' A newly blocked rating takes its titles off the bar straight away
        if m.global.hasField("parentalBlockedRatings") then m.global.observeFieldScoped("parentalBlockedRatings", "loadMediaBarItems")
        ' So does a change to where the bar draws its titles from
        if m.global.hasField("mediaBarSourcesChanged") then m.global.observeFieldScoped("mediaBarSourcesChanged", "loadMediaBarItems")
    end if

    ' Apply UI overlay settings
    applyOverlaySettings()
    trailerInit()

    ' Load media items
    loadMediaBarItems()

    themeApply.ApplyToItem(m.top)
end sub

' React to media bar mode changes by re-applying style and refreshing display
sub onMediaBarModeChanged(_event as object)
    ' The old style puts back what the trailer cleared before the new one lays itself out
    stopTrailer()
    applyCurrentStyle()
    applyOverlaySettings()
    refreshMediaBarBackdropUrls()

    if m.mediaBarItems.count() > 0
        if m.mediaBarMode = "gallery"
            setupGalleryPages()
            showGalleryPage(0)
            m.top.currentBackdrop = ""
            if m.mediaBarItems.count() > 1
                startAutoAdvanceTimer()
            end if
        else if m.mediaBarMode = "bookshelf"
            setupBookshelfPages()
            showBookshelfPage()
            m.top.currentBackdrop = "pkg:/images/bookshelfBg.webp"
            if m.mediaBarItems.count() > 1
                startAutoAdvanceTimer()
            end if
        else
            if m.indicatorDots.getChildCount() = 0
                createIndicatorDots()
            end if
            showMediaBarItem(m.currentIndex)
            m.top.currentBackdrop = m.mediaBarItems[m.currentIndex].backdropUrl
        end if
    end if
end sub

' Configure visibility, translations, and font sizes for current media bar mode
sub applyCurrentStyle()
    mode = m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin"
    m.mediaBarMode = mode
    m.ayaGroup.visible = false
    m.makdGroup.visible = false
    m.bannerGroup.visible = false
    m.featuredRelease.release = {}
    if mode = "off" or mode = ""
        m.galleryGroup.visible = false
        m.bookshelfGroup.visible = false
        m.infoOverlayContent.visible = false
        m.logoImage.visible = false
        m.logoShadow.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false
        m.pauseIndicator.visible = false
        if isValid(m.autoAdvanceTimer) then m.autoAdvanceTimer.control = "stop"
    end if

    if mode <> "moonfin" and mode <> "makd" and mode <> "gallery" and mode <> "banner" and mode <> "bookshelf" and mode <> "aya" ' Only accept available styles
        mode = "moonfin"
        m.mediaBarMode = mode
    end if

    m.rowPeek = get_user_setting_bool("ui.home.mediaBarRowPeek", false) and mode <> "banner"
    m.barBottom = m.rowPeek ? ROW_PEEK_LINE : 1080
    ' MakD's column and dots end just above where the rows start, the screen's foot with no peek
    m.makdColumnBottom = m.barBottom - (MAKD_ROWS_TOP - MAKD_COLUMN_BOTTOM)

    ' The arrows sit level with the middle of what the bar shows
    arrowTop = m.barBottom / 2 - 35 - MEDIA_BAR_TOP
    m.leftArrow.translation = [20, arrowTop]
    m.rightArrow.translation = [1830, arrowTop]

    if mode = "moonfin"
        m.galleryGroup.visible = false
        m.bookshelfGroup.visible = false
        m.infoOverlayContent.visible = true
        m.infoBackground.visible = true
        m.overviewLabel.visible = true
        m.dotsBackground.visible = true
        m.indicatorDots.visible = true

        layoutFeatured()

        m.pauseIndicator.translation = "[1772, 808]"
    else if mode = "makd"
        if isValid(m.contentFadeOut) then m.contentFadeOut.control = "stop"
        if isValid(m.contentFadeIn) then m.contentFadeIn.control = "stop"
        m.pendingDisplayIndex = -1

        m.logoShadow.visible = false
        m.logoImage.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.infoOverlayContent.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false

        m.galleryGroup.visible = false
        m.bookshelfGroup.visible = false
        m.makdGroup.visible = true
        m.makdFade.blendColor = pageColor()

        ' Up in the top corner, where the original keeps its pause control
        m.pauseIndicator.translation = [1772, 120 - MEDIA_BAR_TOP]
    else if mode = "bookshelf"
        m.infoBottomAnchor = 720

        if isValid(m.contentFadeOut) then m.contentFadeOut.control = "stop"
        if isValid(m.contentFadeIn) then m.contentFadeIn.control = "stop"
        m.pendingDisplayIndex = -1

        m.logoShadow.visible = false
        m.logoImage.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.infoOverlayContent.visible = false
        m.leftArrow.visible = false
        m.leftArrowBg.visible = false
        m.rightArrow.visible = false
        m.rightArrowBg.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false

        m.galleryGroup.visible = false

        m.bookshelfGroup.visible = true

        m.dotsY = 810
        m.dotsBgY = 793
        ' Paused Indicator
        m.pauseIndicator.translation = "[1772, 808]"
    else if mode = "gallery"
        m.infoBottomAnchor = 720

        if isValid(m.contentFadeOut) then m.contentFadeOut.control = "stop"
        if isValid(m.contentFadeIn) then m.contentFadeIn.control = "stop"
        m.pendingDisplayIndex = -1

        m.logoShadow.visible = false
        m.logoImage.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.infoOverlayContent.visible = false
        m.leftArrow.visible = false
        m.leftArrowBg.visible = false
        m.rightArrow.visible = false
        m.rightArrowBg.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false

        m.galleryGroup.visible = true
        m.bookshelfGroup.visible = false

        ' The panels end as far above the peeking row as they do above the foot of the screen
        m.galleryPanelHeight = GALLERY_PANEL_HEIGHT - (1080 - m.barBottom)
        m.galleryGrid.itemSize = [1920, m.galleryPanelHeight]
        m.galleryGrid.rowHeights = [m.galleryPanelHeight]

        m.dotsY = 810
        m.dotsBgY = 793
        ' Paused Indicator
        m.pauseIndicator.translation = "[1722, 808]"
    else if mode = "aya"
        if isValid(m.contentFadeOut) then m.contentFadeOut.control = "stop"
        if isValid(m.contentFadeIn) then m.contentFadeIn.control = "stop"
        m.pendingDisplayIndex = -1

        m.logoShadow.visible = false
        m.logoImage.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.infoOverlayContent.visible = false
        m.leftArrow.visible = false
        m.leftArrowBg.visible = false
        m.rightArrow.visible = false
        m.rightArrowBg.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false

        m.galleryGroup.visible = false
        m.bookshelfGroup.visible = false
        m.ayaGroup.visible = true

        m.ayaTitle.font.size = AYA_TITLE_SIZE
        frameHeight = m.rowPeek ? AYA_PEEK_FRAME_HEIGHT : AYA_FRAME_HEIGHT
        m.ayaMask.size = [AYA_FRAME_WIDTH, frameHeight]
        for each layer in [m.ayaFrameBg, m.ayaBackdrop, m.ayaBackdropNext]
            layer.height = frameHeight
        end for
        m.ayaFocusRing.height = frameHeight + 8
        m.ayaGroup.scaleRotateCenter = [AYA_FRAME_WIDTH / 2, frameHeight / 2]
        onMediaBarFocusChanged()

        m.pauseIndicator.translation = "[1772, 808]"
    else if mode = "banner"
        if isValid(m.contentFadeOut) then m.contentFadeOut.control = "stop"
        if isValid(m.contentFadeIn) then m.contentFadeIn.control = "stop"
        m.pendingDisplayIndex = -1

        m.logoShadow.visible = false
        m.logoImage.visible = false
        m.titleText.visible = false
        m.infoBackground.visible = false
        m.infoOverlayContent.visible = false
        m.dotsBackground.visible = false
        m.indicatorDots.visible = false
        m.overviewLabel.visible = false

        m.galleryGroup.visible = false
        m.bookshelfGroup.visible = false
        m.bannerGroup.visible = true
        ' Sized up front so the focus ring and gradient don't sit small in the corner while the
        ' items load
        layoutBannerCard()
        m.bannerFocus.blendColor = themeChrome.IsActive() ? themeChrome.Accent() : "#00A4DC"
        m.bannerGlow.blendColor = m.bannerFocus.blendColor
        onMediaBarFocusChanged()

        m.pauseIndicator.translation = "[1698, 239]"
    end if
    if m.rowPeek and mode <> "makd" then m.pauseIndicator.translation = [m.pauseIndicator.translation[0], m.pauseIndicator.translation[1] - (1080 - ROW_PEEK_LINE)]

    updateInfoBackgroundSize()
    updateDotsBackgroundSize()
    updateArrowVisibility()
end sub

sub updateArrowVisibility()
    sidebarActive = isValid(dockedSidebar())

    showArrows = false
    if isValid(m.mediaBarItems) and m.mediaBarMode = "moonfin"
        showArrows = m.mediaBarItems.count() > 1
    end if
    if m.mediaBarMode = "makd" then updateMakdFocus()

    m.rightArrow.visible = showArrows
    if isValid(m.rightArrowBg) then m.rightArrowBg.visible = showArrows

    showLeft = showArrows and not sidebarActive
    m.leftArrow.visible = showLeft
    if isValid(m.leftArrowBg) then m.leftArrowBg.visible = showLeft
end sub

' Rebuild backdrop URLs for all items after mode change affects URL params
sub refreshMediaBarBackdropUrls()
    for each item in m.mediaBarItems
        item.backdropUrl = buildBackdropUrl(item)
    end for
end sub

' Handle focus changes - ensure backdrop is set when component gets focus
sub onFocusChanged(event as object)
    hasFocus = event.getData()

    if hasFocus and m.mediaBarItems.count() > 0
        ' Immediately refresh display when focus is gained
        refreshDisplay()
        updateArrowVisibility()
        ' Resume auto-advance timer
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "start"
        end if
    else
        if m.clearBackdrop
            ' Clear backdrop when focus is lost (if allowed)
            m.top.currentBackdrop = "" ' Clear backdrop on focus loss
            m.clearBackdrop = false ' reset flag
        end if
        ' Stop auto-advance timer when losing focus (e.g., navigating to navbar)
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "stop"
        end if
    end if
end sub

' Handle visibility changes - refresh display when component becomes visible
sub onVisibilityChanged(event as object)
    isVisible = event.getData()

    if isVisible and m.mediaBarItems.count() > 0
        refreshDisplay()
    end if
    refreshTrailer()
end sub

' Mode-aware display refresh
sub refreshDisplay()
    if m.mediaBarItems.count() = 0 then return
    if m.mediaBarMode = "gallery"
        showGalleryPage(m.galleryCurrentPage)
    else if m.mediaBarMode = "bookshelf"
        showBookshelfPage()
    else
        displayMediaBarItem(m.currentIndex)
    end if
end sub

' Handle overlay settings changes
sub onOverlaySettingsChanged(_event as object)
    applyOverlaySettings()
end sub

' Apply opacity and color settings to overlay elements
sub applyOverlaySettings()
    if not isValid(m.global) or not isValid(m.global.session) then return

    opacitySetting = m.global.session.user.settings["ui.overlayOpacity"] ?? invalid
    opacity = isValid(opacitySetting) ? opacitySetting.toFloat() : 0.5

    ' Store for use in fade animations
    m.overlayOpacity = opacity

    color = formatOverlayColor(m.global.session.user.settings["ui.overlayColor"] ?? "", "0x475569FF")

    for each element in [m.infoBackground, m.dotsBackground, m.leftArrowBg, m.rightArrowBg]
        if isValid(element)
            element.opacity = opacity
            element.blendColor = color
        end if
    end for

    ' MakD's shade and corner wash, which the default 0.5 puts at the original's 20% and 65%
    tint = makdTint(color)
    shade = m.top.findNode("makdShade")
    shade.color = tint
    shade.opacity = opacity * 0.4
    washOpacity = opacity * 1.3
    if washOpacity > 1 then washOpacity = 1
    wash = m.top.findNode("makdWash")
    wash.blendColor = tint
    wash.opacity = washOpacity
end sub

' Home pressed while Home is showing draws a new set, while the current one stays up and is kept
' if the draw comes back empty. A press while one is on its way is dropped.
sub drawNewSet()
    if isValid(m.newSetTask) or (m.global.session.user.settings["ui.home.mediaBarMode"] ?? "moonfin") = "off" then return
    loadMediaBarItems()
    m.newSetTask = m.mediaBarTask
end sub

' Fetch and prepare media items
sub loadMediaBarItems()
    ' A reload can start while the last one is out, and only the newest may fill the bar
    if isValid(m.mediaBarTask) then m.mediaBarTask.unobserveFieldScoped("mediaBarData")
    m.newSetTask = invalid
    m.mediaBarTask = createObject("roSGNode", "MediaBarTask")
    m.mediaBarTask.userId = m.global.session.user.id
    m.mediaBarTask.contentType = m.global.session.user.settings["ui.home.mediaBarContentType"] ?? "both"
    m.mediaBarTask.sourceType = m.global.session.user.settings["ui.home.mediaBarSourceType"] ?? "random"
    m.mediaBarTask.selectedLibraryIds = m.global.session.user.settings["ui.home.mediaBarLibraryIds"] ?? "[]"
    m.mediaBarTask.featuredCount = m.global.session.user.settings["ui.home.featuredMediaItems"] ?? 15
    m.mediaBarTask.selectedCollectionIds = m.global.session.user.settings["ui.home.mediaBarCollectionIds"] ?? "[]"
    m.mediaBarTask.excludedGenreIds = m.global.session.user.settings["ui.home.mediaBarExcludedGenres"] ?? "[]"
    m.mediaBarTask.externalListIds = m.global.session.user.settings["ui.home.mediaBarExternalLists"] ?? "[]"
    m.mediaBarTask.newReleaseDays = newReleaseDays()
    m.mediaBarTask.hideWatched = get_user_setting_bool(recentRows.HIDE_WATCHED_SETTING, false)
    m.mediaBarTask.observeFieldScoped("mediaBarData", "onMediaBarDataLoaded")
    m.mediaBarTask.control = "RUN"
end sub

' Handle data loaded from task
sub onMediaBarDataLoaded(event as object)
    data = event.getData()
    if not isValid(data)
        return
    end if

    ' Clean up task observer now that we have the data
    if isValid(m.mediaBarTask)
        m.mediaBarTask.unobserveFieldScoped("mediaBarData")
    end if

    allItems = isChainValid(data, "items") ? data.items : []
    newSet = isValid(m.newSetTask)
    m.newSetTask = invalid
    if newSet and allItems.count() = 0 then return

    m.mediaBarItems = []
    titles = []
    for each item in allItems
        processed = processItem(item)
        buildItemUrls(processed)
        m.mediaBarItems.push(processed)
        titles.push({ title: processed.title, genres: processed.genres })
    end for
    m.top.titles = titles
    loadNewReleases()

    m.top.isEmpty = m.mediaBarItems.count() = 0
    ' A reload starts the new titles from the first
    m.currentIndex = 0
    updateArrowVisibility()

    ' Initialize display if we have items
    if m.mediaBarItems.count() > 0
        if m.mediaBarMode = "gallery"
            setupGalleryPages()
            showGalleryPage(0)
            if m.mediaBarItems.count() > 1
                startAutoAdvanceTimer()
            end if
        else if m.mediaBarMode = "bookshelf"
            setupBookshelfPages()
            showBookshelfPage()
            m.top.currentBackdrop = "pkg:/images/bookshelfBg.webp"
            if m.mediaBarItems.count() > 1
                startAutoAdvanceTimer()
            end if
        else
            createIndicatorDots()
            if m.mediaBarItems.count() > 1
                updateArrowVisibility()
                startAutoAdvanceTimer()
            end if
            ' Display first item (single backdrop update)
            displayMediaBarItem(0)
        end if
    end if
end sub

function newReleaseDays() as integer
    return toString(m.global.session.user.settings["ui.home.mediaBarNewReleaseDays"] ?? "30").ToInt()
end function

' Asked for once the bar shows, so a slow server only holds back the labels
sub loadNewReleases()
    if isValid(m.newReleasesTask) then m.newReleasesTask.unobserveFieldScoped("releases")
    m.newReleasesTask = invalid
    if not get_user_setting_bool("ui.home.mediaBarNewReleaseBanner", true) then return

    seriesIds = []
    for each item in m.mediaBarItems
        if isStringEqual(item.itemType ?? "", "Series") and not item.isExternal then seriesIds.push(item.id)
    end for
    if seriesIds.count() = 0 then return

    m.newReleasesTask = createObject("roSGNode", "MediaBarNewReleasesTask")
    m.newReleasesTask.userId = m.global.session.user.id
    m.newReleasesTask.seriesIds = seriesIds
    m.newReleasesTask.days = newReleaseDays()
    m.newReleasesTask.observeFieldScoped("releases", "onNewReleasesLoaded")
    m.newReleasesTask.control = "RUN"
end sub

sub onNewReleasesLoaded(event as object)
    releases = event.getData()
    if isValid(m.newReleasesTask) then m.newReleasesTask.unobserveFieldScoped("releases")
    m.newReleasesTask = invalid
    if not isValid(releases) or releases.count() = 0 then return

    ' The gallery pages hold these same items, so they pick the labels up too
    for each item in m.mediaBarItems
        if releases.DoesExist(item.id) then item.newRelease = releases[item.id]
    end for

    if m.mediaBarMode = "gallery" and isValid(m.galleryPageContentNodes)
        for pageIndex = 0 to m.galleryPageContentNodes.count() - 1
            content = m.galleryPageContentNodes[pageIndex]
            page = m.galleryPages[pageIndex]
            for i = 0 to content.getChildCount() - 1
                if isValid(page[i].newRelease) then content.getChild(i).newRelease = page[i].newRelease
            end for
        end for
        return
    end if

    current = m.mediaBarItems[m.currentIndex]
    if not isValid(current) then return
    release = current.newRelease ?? {}
    if m.mediaBarMode = "moonfin"
        m.featuredRelease.release = release
    else if m.mediaBarMode = "makd"
        m.makdRelease.release = release
        layoutMakd()
    else if m.mediaBarMode = "banner"
        m.bannerRelease.release = release
        layoutBannerContent()
    else if m.mediaBarMode = "aya"
        m.ayaRelease.release = release
        layoutAyaRelease()
    end if
end sub

' Process item data into display format
function processItem(item as object) as object
    processed = {
        id: item.id,
        title: item.name,
        itemType: item.type,
        overview: item.overview,
        year: item.productionYear,
        rating: item.officialRating,
        runtime: invalid,
        runtimeDisplay: "",
        communityRating: item.communityRating,
        communityRatingDisplay: "",
        genres: [],
        backdropTag: "",
        logoUrl: "",
        director: "",
        hasLogo: false,
        tmdbId: "",
        imdbId: "",
        people: invalid,
        remoteTrailers: item.remoteTrailers ?? [],
        isExternal: isValid(item.external),
        criticRating: item.criticRating,
        childCount: item.childCount,
        runTimeTicks: item.runTimeTicks,
        isFavorite: chainLookupReturn(item, "UserData.IsFavorite", false) = true,
        playbackPositionTicks: chainLookupReturn(item, "UserData.PlaybackPositionTicks", 0)
    }

    ' A title from an outside list brings its own TMDB art and opens in Seerr like its home row card
    if processed.isExternal
        processed.externalBackdropUrl = item.backdropUrl
        processed.externalPosterUrl = item.posterUrl
        processed.logoUrl = item.logoUrl
        processed.hasLogo = processed.logoUrl <> ""
        processed.seerrItem = item.seerrItem
    end if

    if isChainValid(item, "backdropImageTags") and item.backdropImageTags.count() > 0
        processed.backdropTag = item.backdropImageTags[0]
    end if

    if isChainValid(item, "imageTags.Logo")
        processed.hasLogo = true
    end if

    processed.bannerTag = chainLookupReturn(item, "imageTags.Banner", "")

    if isChainValid(item, "providerIds")
        processed.tmdbId = moonfinPlugin.GetTmdbId(item.providerIds)
        processed.imdbId = item.providerIds.LookupCI("Imdb") ?? ""
    end if

    if isValid(item.runTimeTicks)
        minutes = int(item.runTimeTicks / 600000000)
        processed.runtime = minutes
        if minutes >= 60
            hours = int(minutes / 60)
            mins = minutes mod 60
            processed.runtimeDisplay = hours.toStr() + "h " + mins.toStr() + "m"
        else
            processed.runtimeDisplay = minutes.toStr() + " min"
        end if
    end if

    if isValid(item.communityRating) and moonfinPlugin.IsRatingSourceEnabled("stars", "mediaBar")
        processed.communityRatingDisplay = moonfinPlugin.formatDecimal(item.communityRating, 1)
    end if

    if isChainValid(item, "genres") and item.genres.count() > 0
        processed.genres = item.genres
    end if

    if isChainValid(item, "People") and item.People.count() > 0
        peopleList = []
        directors = []
        for each person in item.People
            personType = LCase(person.Type)
            if personType = "director"
                directors.push(person.Name)
            else if personType <> "writer" and peopleList.count() < GALLERY_CAST_LIMIT
                peopleList.push(person.Name)
            end if
        end for
        if peopleList.count() > 0
            processed.people = peopleList.join(", ")
        end if
        if directors.count() > 0
            processed.director = directors.join(", ")
        end if
    end if

    return processed
end function

' Build a single backdrop image URL with mode-specific sizing and quality
function buildBackdropUrl(item as object) as string
    if item.isExternal
        if m.mediaBarMode = "bookshelf" then return item.externalPosterUrl
        return item.externalBackdropUrl
    end if
    if not isValid(item.backdropTag) or item.backdropTag = "" then return ""
    if m.mediaBarMode = "bookshelf"
        return ImageURL(item.id, "Primary", { maxHeight: 850, maxWidth: 420, quality: 90 })
    else
        return ImageURL(item.id, "Backdrop", { maxHeight: 1080, maxWidth: 1920, quality: 90, Tag: item.backdropTag })
    end if
end function

' Build backdrop and logo URLs for a single media item
sub buildItemUrls(item as object)
    item.backdropUrl = buildBackdropUrl(item)
    if item.hasLogo and not item.isExternal
        item.logoUrl = ImageURL(item.id, "Logo", { maxHeight: 150, maxWidth: 500, quality: 100 })
    end if
end sub

' Create a ContentNode from an item dict with optional extra fields
function createItemContentNode(item as object, extraFields = {} as object) as object
    child = createObject("roSGNode", "ContentNode")
    fields = {
        title: item.title,
        backdropUrl: item.backdropUrl,
        logoUrl: item.logoUrl,
        overview: item.overview,
        starring: item.people,
        director: item.director,
        genres: item.genres,
        year: item.year,
        rating: item.rating,
        runtimeDisplay: item.runtimeDisplay,
        communityRatingDisplay: item.communityRatingDisplay,
        itemType: item.itemType,
        trailerActive: false,
        newRelease: item.newRelease ?? {}
    }
    for each key in extraFields
        fields[key] = extraFields[key]
    end for
    child.addFields(fields)
    return child
end function

' Split items into pages of 5 for gallery display
sub setupGalleryPages()
    pageSize = 5
    m.galleryPages = []
    m.galleryPageContentNodes = []
    allItems = m.mediaBarItems

    for pageIndex = 0 to (allItems.count() - 1) step pageSize
        finish = pageIndex + pageSize - 1
        if finish >= allItems.count() then finish = allItems.count() - 1
        page = []
        content = createObject("roSGNode", "ContentNode")
        for i = pageIndex to finish
            item = allItems[i]
            page.push(item)
            child = createItemContentNode(item, { isActive: false, itemNumber: i + 1, panelHeight: m.galleryPanelHeight })
            content.appendChild(child)
        end for
        m.galleryPages.push(page)
        m.galleryPageContentNodes.push(content)
    end for

    m.galleryTotalPages = m.galleryPages.count()
    m.galleryCurrentPage = 0
    m.galleryActiveIndex = 0
end sub

' Show a specific gallery page
sub showGalleryPage(pageIndex as integer)
    if pageIndex < 0 or pageIndex >= m.galleryTotalPages then return

    pageContent = m.galleryPageContentNodes[pageIndex]

    for i = 0 to pageContent.getChildCount() - 1
        pageContent.getChild(i).isActive = false
    end for

    active = pageContent.getChild(m.galleryActiveIndex)
    active.isActive = true
    m.galleryGlow.blendColor = galleryGlow.ForGenres(active.genres)

    m.galleryGrid.content = pageContent
    setGalleryColumnWidths(m.galleryActiveIndex)
    refreshTrailer()
end sub

' Set column widths based on active index
sub setGalleryColumnWidths(activeIndex as integer)
    widths = [GALLERY_NARROW_COLUMN, GALLERY_NARROW_COLUMN, GALLERY_NARROW_COLUMN, GALLERY_NARROW_COLUMN, GALLERY_NARROW_COLUMN]
    widths[activeIndex] = GALLERY_WIDE_COLUMN
    m.galleryGrid.columnWidths = widths
end sub

' Navigate between gallery items
sub galleryAdvance(direction as integer)
    if m.galleryTotalPages = 0 then return
    itemsOnPage = m.galleryPages[m.galleryCurrentPage].count()

    if direction > 0
        if m.galleryActiveIndex < itemsOnPage - 1
            m.galleryActiveIndex++
        else
            m.galleryCurrentPage = (m.galleryCurrentPage + 1) mod m.galleryTotalPages
            m.galleryActiveIndex = 0
        end if
    else
        if m.galleryActiveIndex > 0
            m.galleryActiveIndex--
        else
            m.galleryCurrentPage = m.galleryCurrentPage - 1
            if m.galleryCurrentPage < 0 then m.galleryCurrentPage = m.galleryTotalPages - 1
            m.galleryActiveIndex = m.galleryPages[m.galleryCurrentPage].count() - 1
        end if
    end if

    showGalleryPage(m.galleryCurrentPage)
end sub

' Get the currently active item in gallery mode
function getGalleryActiveItem() as object
    if m.galleryTotalPages = 0 then return invalid
    page = m.galleryPages[m.galleryCurrentPage]
    if m.galleryActiveIndex < page.count()
        return page[m.galleryActiveIndex]
    end if
    return invalid
end function

' Build the bookshelf ContentNode with spine colours and initial column widths
sub setupBookshelfPages()
    allItems = m.mediaBarItems
    totalItems = allItems.count()
    if totalItems = 0 then return

    blendColors = [
        "0xBF441BFF", ' orange
        "0xae792dFF", ' gold
        "0xD98934FF", ' yellow
        "0x870F19FF", ' burgundy
        "0x7A5334FF", ' brown
        "0x592B2BFF", ' purpleish brown
        "0x30A49CFF", ' cyan/light blue
        "0x6C7851FF" ' army green
    ]

    content = createObject("roSGNode", "ContentNode")
    for i = 0 to totalItems - 1
        item = allItems[i]

        colorIndex = Rnd(8) - 1

        child = createItemContentNode(item, { isActive: (i = 0), itemNumber: i + 1, blendColor: blendColors[colorIndex] })
        content.appendChild(child)
    end for

    m.bookshelfContentNode = content
    m.bookshelfActiveIndex = m.currentIndex

    m.bookshelfGrid.numColumns = totalItems

    updateBookshelfLayout(m.bookshelfActiveIndex)
end sub

' Render the current bookshelf page, marking the active item and recentering
sub showBookshelfPage()
    m.bookshelfGroup.visible = true

    pageContent = m.bookshelfContentNode
    totalItems = pageContent.getChildCount()

    for i = 0 to totalItems - 1
        pageContent.getChild(i).isActive = (i = m.bookshelfActiveIndex)
    end for

    m.bookshelfGrid.content = pageContent

    updateBookshelfLayout(m.bookshelfActiveIndex)
end sub

' Navigate between gallery items
sub bookshelfAdvance(direction as integer)
    totalItems = m.mediaBarItems.count()
    if totalItems <= 1 then return

    if direction > 0
        m.bookshelfActiveIndex = (m.bookshelfActiveIndex + 1) mod totalItems
    else
        m.bookshelfActiveIndex = m.bookshelfActiveIndex - 1
        if m.bookshelfActiveIndex < 0 then m.bookshelfActiveIndex = totalItems - 1
    end if
    m.currentIndex = m.bookshelfActiveIndex
    showBookshelfPage()
end sub

sub updateBookshelfLayout(activeIndex as integer)
    totalItems = m.mediaBarItems.count()
    if totalItems = 0 then return

    ' Set column widths: wide for active item, narrow for the rest
    widths = []
    for i = 0 to totalItems - 1
        if i = activeIndex
            widths.push(690)
        else
            widths.push(60)
        end if
    end for
    m.bookshelfGrid.columnWidths = widths

    ' Translate the bookshelf group to the active book is horizontally centered
    spineWidth = 60
    bookWidth = 778
    spacing = 5
    screenCenterX = 960

    ' The books stand 800 tall from 30 down the bar on the 26 pixel ledge at the foot of the art.
    ' Home lifts the art to end on a peeking row, so the shelf shrinks to stand on it there.
    shelfScale = m.rowPeek ? (ROW_PEEK_LINE - 26 - MEDIA_BAR_TOP - 30) / 800 : 1.0

    itemX = activeIndex * (spineWidth + spacing)
    centerX = itemX + bookWidth / 2
    offsetX = screenCenterX - centerX * shelfScale

    m.bookshelfGroup.scale = [shelfScale, shelfScale]
    m.bookshelfGroup.translation = [offsetX, 30]
end sub

' One dot per item, left plain here since updateIndicatorDots sizes and colours
' them around the current one
sub createIndicatorDots()
    m.indicatorDots.removeChildrenIndex(m.indicatorDots.getChildCount(), 0)

    for i = 0 to m.mediaBarItems.count() - 1
        dot = m.indicatorDots.createChild("Poster")
        dot.uri = "pkg:/images/icons/circle.webp"
        dot.loadDisplayMode = "scaleToFit"
    end for

    updateIndicatorDots()
    updateDotsBackgroundSize()
end sub

' Update the background size for indicator dots
sub updateDotsBackgroundSize()
    if not isValid(m.indicatorDots) or not isValid(m.dotsBackground) then return

    numDots = m.indicatorDots.getChildCount()
    if numDots = 0 then return

    totalDotsWidth = (numDots - 1) * FEATURED_DOT_SIZE + FEATURED_DOT_ACTIVE_SIZE
    totalSpacingWidth = (numDots - 1) * FEATURED_DOT_GAP
    calculatedWidth = totalDotsWidth + totalSpacingWidth + (FEATURED_DOTS_PAD_X * 2)

    screenCenter = 960

    m.indicatorDots.translation = [screenCenter - (totalDotsWidth + totalSpacingWidth) / 2, m.dotsY]

    if not m.dotsBackground.visible then return

    m.dotsBackground.width = calculatedWidth
    m.dotsBackground.translation = [screenCenter - calculatedWidth / 2, m.dotsBgY]
end sub

' Update indicator dots to show current slide
sub updateIndicatorDots()
    numDots = m.indicatorDots.getChildCount()
    if numDots = 0 then return

    for i = 0 to numDots - 1
        dot = m.indicatorDots.getChild(i)
        isCurrent = i = m.currentIndex
        size = isCurrent ? FEATURED_DOT_ACTIVE_SIZE : FEATURED_DOT_SIZE
        dot.blendColor = isCurrent ? "#FFFFFF" : "#FFFFFF80"
        dot.width = size
        dot.height = size
    end for
end sub

' Display media bar item with crossfade
sub displayMediaBarItem(index as integer)
    if index < 0 or index >= m.mediaBarItems.count() then return

    ' These draw their own copy of the item rather than the overlay the other
    ' styles crossfade
    if m.mediaBarMode = "makd" or m.mediaBarMode = "banner"
        showMediaBarItem(index)
        return
    end if

    if m.mediaBarMode = "aya"
        showMediaBarItem(index)
        return
    end if

    ' If this is not the first display and we have fade animations, do a crossfade
    if m.currentIndex <> index or m.pendingDisplayIndex >= 0
        if isValid(m.contentFadeOut) and isValid(m.infoOverlayContent) and m.infoOverlayContent.opacity > 0
            m.pendingDisplayIndex = index
            m.contentFadeOut.control = "start"
            ' Still update backdrop immediately so it crossfades in parallel
            item = m.mediaBarItems[index]
            if item.backdropUrl <> ""
                m.top.currentBackdrop = item.backdropUrl
            end if
            return
        end if
    end if

    showMediaBarItem(index)
end sub

' The page under Home, which the MakD backdrop fades into at its foot
function pageColor() as string
    return formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorBackground", ""), ColorPalette.VIEWBACKGROUND)
end function

' The sidebar sits over the left of the screen when it is docked, so anything
' drawn there has to allow for it
function dockedSidebar() as dynamic
    scene = m.top.getScene()
    if not isValid(scene) then return invalid

    sidebar = scene.findNode("sidebar")
    if isValid(sidebar) and sidebar.visible then return sidebar

    return invalid
end function

sub renderFeaturedRatings(pluginRatings as object)
    entries = []
    if isValid(m.featuredCommunity) then entries.push(m.featuredCommunity)
    for each rating in pluginRatings
        entries.push(rating)
    end for

    moonfinPlugin.StyleRatingsRow(m.ratingsRow, "mediaBar")
    m.ratingsRow.ratingsData = { data: entries }
end sub

' The hero fills the screen, so everything in it is placed against the screen
' rather than against this component, which sits well down the page. Only the
' sidebar moves any of it, so the run of items goes by without laying out again
sub layoutFeatured()
    docked = isValid(dockedSidebar())
    if isValid(m.featuredDocked) and m.featuredDocked = docked and m.featuredPeek = m.rowPeek then return

    ' The theme swaps these fonts for shared ones of its own once init ends, so they are only
    ' sized on the first layout
    if not isValid(m.featuredDocked)
        m.titleText.font.size = FEATURED_TITLE_SIZE
        m.overviewLabel.font.size = FEATURED_OVERVIEW_SIZE
        m.top.findNode("featuredMetaFont").font.size = FEATURED_META_SIZE
        m.top.findNode("featuredBadgeFont").font.size = FEATURED_BADGE_SIZE
    end if

    m.featuredDocked = docked
    m.featuredPeek = m.rowPeek

    logoLeft = docked ? FEATURED_LOGO_LEFT_DOCKED : FEATURED_LOGO_LEFT
    ' Without a sidebar the navbar runs across the top, so the logo clears it
    logoTop = docked ? FEATURED_LOGO_TOP : FEATURED_LOGO_TOP_TOPBAR

    m.logoImage.width = FEATURED_LOGO_WIDTH
    m.logoImage.height = FEATURED_LOGO_HEIGHT
    m.logoImage.translation = [logoLeft, logoTop - MEDIA_BAR_TOP]

    m.logoShadow.width = FEATURED_LOGO_WIDTH
    m.logoShadow.height = FEATURED_LOGO_HEIGHT
    m.logoShadow.translation = [logoLeft + FEATURED_SHADOW_OFFSET, logoTop + FEATURED_SHADOW_OFFSET - MEDIA_BAR_TOP]

    m.titleText.width = FEATURED_LOGO_WIDTH
    m.titleText.translation = [logoLeft, logoTop - MEDIA_BAR_TOP]
    m.featuredRelease.translation = [logoLeft, logoTop + FEATURED_LOGO_HEIGHT + NEW_RELEASE_GAP - MEDIA_BAR_TOP]

    edge = docked ? FEATURED_EDGE_DOCKED : FEATURED_EDGE
    if m.rowPeek and not docked then edge = FEATURED_EDGE_PEEK
    boxWidth = 1920 - (edge * 2)

    m.infoBackground.width = boxWidth
    m.infoBackground.translation = [edge, m.infoBackground.translation[1]]
    m.infoBottomAnchor = FEATURED_BOX_BOTTOM - (1080 - m.barBottom) - MEDIA_BAR_TOP

    m.infoOverlayContent.itemSpacings = [FEATURED_RATINGS_GAP, FEATURED_OVERVIEW_GAP]
    m.infoOverlayContent.translation = [edge + FEATURED_BOX_PAD_X, m.infoOverlayContent.translation[1]]
    m.metadataRow.itemSpacings = [FEATURED_META_GAP]

    m.ratingsRow.labelFont = "font:SmallBoldSystemFont"
    m.ratingsRow.iconHeight = FEATURED_RATING_ICON
    m.ratingsRow.ratingSpacing = FEATURED_RATING_GAP

    m.overviewLabel.width = boxWidth - (FEATURED_BOX_PAD_X * 2)
    m.overviewLabel.lineSpacing = FEATURED_OVERVIEW_SPACING

    m.indicatorDots.itemSpacings = [FEATURED_DOT_GAP]
    pillHeight = FEATURED_DOT_ACTIVE_SIZE + (FEATURED_DOTS_PAD_Y * 2)
    m.dotsBackground.height = pillHeight
    m.dotsBgY = m.barBottom - FEATURED_DOTS_BOTTOM - pillHeight - MEDIA_BAR_TOP
    m.dotsY = m.dotsBgY + FEATURED_DOTS_PAD_Y
end sub

sub buildFeaturedMeta(item as object)
    m.metadataRow.removeChildrenIndex(m.metadataRow.getChildCount(), 0)

    metaFont = m.top.findNode("featuredMetaFont").font
    badgeFont = m.top.findNode("featuredBadgeFont").font

    parts = []
    if isValid(item.year) and item.year > 0 then parts.push({ text: item.year.toStr() })

    rating = item.rating ?? ""
    if rating <> "" then parts.push({ text: rating, badge: true })

    runtime = item.runtimeDisplay ?? ""
    if not isStringEqual(item.itemType ?? "", "Series") and runtime <> "" and runtime <> "0m"
        parts.push({ text: runtime })
    end if

    if isValidAndNotEmpty(item.genres)
        shown = 0
        for each genre in item.genres
            parts.push({ text: genre })
            shown++
            if shown = FEATURED_GENRES_LIMIT then exit for
        end for
    end if

    for i = 0 to parts.count() - 1
        part = parts[i]
        if isValid(part.badge)
            addFeaturedBadge(part.text, badgeFont)
        else
            label = m.metadataRow.createChild("Label")
            label.font = metaFont
            label.color = FEATURED_META_INK
            label.text = part.text
        end if

        if i = parts.count() - 1 then continue for

        dot = m.metadataRow.createChild("Label")
        dot.font = metaFont
        dot.color = FEATURED_META_DOT_INK
        dot.text = "•"
    end for
end sub

sub addFeaturedBadge(text as string, badgeFont as object)
    holder = m.metadataRow.createChild("Group")

    border = holder.createChild("Poster")
    border.uri = "pkg:/images/mediabar/metabadge4.9.png"
    border.loadDisplayMode = "scaleToFit"
    border.blendColor = "#FFFFFF"
    border.opacity = 0.4

    label = holder.createChild("Label")
    label.font = badgeFont
    label.color = FEATURED_META_INK
    label.text = text
    label.translation = [FEATURED_BADGE_PAD_X, FEATURED_BADGE_PAD_Y]

    rect = label.boundingRect()
    border.width = rect.width + (FEATURED_BADGE_PAD_X * 2)
    border.height = rect.height + (FEATURED_BADGE_PAD_Y * 2)
end sub

sub showBannerItem(item as object)
    layoutBannerCard()

    ' A title's own banner art stands in for the backdrop, logo and title. One that won't load
    ' falls back to them.
    art = ""
    if item.id <> m.failedBannerId then art = bannerArtUrl(item)
    hasArt = art <> ""
    m.bannerArtItemId = item.id
    m.bannerArt.uri = art
    m.bannerArt.visible = hasArt
    m.bannerFill.uri = ""
    if hasArt and not item.isExternal then m.bannerFill.uri = ImageURL(item.id, "Banner", { maxWidth: 640, blur: 24, Tag: item.bannerTag })
    m.bannerFill.visible = m.bannerFill.uri <> ""
    m.bannerBackdrop.uri = hasArt ? "" : item.backdropUrl ?? ""
    m.bannerBackdrop.visible = not hasArt

    hasLogo = not hasArt and isValidAndNotEmpty(item.logoUrl)
    logoUri = hasLogo ? item.logoUrl : ""
    if m.bannerLogo.uri <> logoUri
        m.bannerLogo.width = BANNER_LOGO_WIDTH
        m.bannerLogo.uri = logoUri
    end if
    m.bannerLogo.visible = hasLogo

    m.bannerTitle.text = item.title
    m.bannerTitle.visible = not hasArt and not hasLogo

    m.bannerMeta.text = bannerMetaText(item)
    m.bannerMeta.visible = m.bannerMeta.text <> ""
    m.bannerRelease.release = item.newRelease ?? {}

    m.bannerCommunity = communityRatingEntry(item)
    renderBannerRatings([])
    if moonfinPlugin.IsRatingsEnabled("mediaBar") then fetchMediaBarRatings(item)

    layoutBannerContent()
    updateBannerDots()
end sub

' A title from an outside list has no server banner, so the plugin's titled TMDB thumb stands in
function bannerArtUrl(item as object) as string
    if item.isExternal then return moonfinPlugin.TmdbThumbURL(isStringEqual(item.itemType, "Series") ? "tv" : "movie", item.tmdbId, item.imdbId)
    if not isValidAndNotEmpty(item.bannerTag) then return ""
    return ImageURL(item.id, "Banner", { maxWidth: 1280, Tag: item.bannerTag })
end function

' scaleToFit centers a narrow logo in its box, so the box shrinks to the drawn logo to sit flush left
sub onBannerLogoStatus()
    if m.bannerLogo.loadStatus <> "ready" or m.bannerLogo.bitmapHeight <= 0 then return
    drawnWidth = m.bannerLogo.bitmapWidth * m.bannerLogo.height / m.bannerLogo.bitmapHeight
    if drawnWidth < BANNER_LOGO_WIDTH then m.bannerLogo.width = drawnWidth
end sub

sub onBannerArtStatus()
    if m.bannerArt.loadStatus <> "failed" or m.bannerArt.uri = "" then return
    m.failedBannerId = m.bannerArtItemId
    if not isValid(m.mediaBarItems) or m.currentIndex >= m.mediaBarItems.count() then return
    current = m.mediaBarItems[m.currentIndex]
    if current.id = m.failedBannerId then showBannerItem(current)
end sub

function bannerMetaText(item as object) as string
    parts = []
    if isValid(item.year) and item.year > 0 then parts.push(item.year.toStr())

    runtime = item.runtimeDisplay ?? ""
    if not isStringEqual(item.itemType ?? "", "Series") and runtime <> "" and runtime <> "0m"
        parts.push(runtime)
    end if

    rating = item.rating ?? ""
    if rating <> "" then parts.push(rating)

    return parts.join(`  ${fontApply.ThemeSeparator()}  `)
end function

sub renderBannerRatings(pluginRatings as object)
    entries = []
    if isValid(m.bannerCommunity) then entries.push(m.bannerCommunity)
    for each rating in pluginRatings
        entries.push(rating)
    end for

    moonfinPlugin.StyleRatingsRow(m.bannerRatings, "mediaBar")
    m.bannerRatings.ratingsData = { data: entries }
end sub

' The card runs to the right edge of the screen from wherever the sidebar leaves
' off, so its width is settled before anything is laid out inside it. Only the
' sidebar moves it, so the run of items goes by without resizing the mask
sub layoutBannerCard()
    left = isValid(dockedSidebar()) ? BANNER_CARD_LEFT_DOCKED : BANNER_CARD_LEFT
    if isValid(m.bannerCardLeft) and m.bannerCardLeft = left then return

    m.bannerCardLeft = left
    width = BANNER_CARD_RIGHT - left

    m.bannerGroup.translation = [left, BANNER_CARD_TOP - MEDIA_BAR_TOP]
    m.bannerMask.size = [width, BANNER_CARD_HEIGHT]

    for each layer in [m.bannerCardBg, m.bannerBackdrop, m.bannerFill, m.bannerArt, m.bannerGradient]
        layer.width = width
        layer.height = BANNER_CARD_HEIGHT
    end for

    m.bannerFocus.translation = [-BANNER_RING, -BANNER_RING]
    m.bannerFocus.width = width + BANNER_RING * 2
    m.bannerFocus.height = BANNER_CARD_HEIGHT + BANNER_RING * 2
    glowEdge = BANNER_RING + BANNER_GLOW_MARGIN
    m.bannerGlow.translation = [-glowEdge, -glowEdge]
    m.bannerGlow.width = width + glowEdge * 2
    m.bannerGlow.height = BANNER_CARD_HEIGHT + glowEdge * 2

    textWidth = width - (BANNER_PAD_X * 2)
    m.bannerTitle.width = textWidth
    m.bannerMeta.width = textWidth

    m.bannerCardWidth = width
end sub

' The block sits on the bottom of the card, so it is stacked and then lifted by
' its own height. Each gap belongs to the line under it and only opens when
' something sits above
sub layoutBannerContent()
    yPos = 0

    if m.bannerLogo.visible
        m.bannerLogo.translation = [0, yPos]
        yPos += m.bannerLogo.height
    end if

    if m.bannerTitle.visible
        m.bannerTitle.translation = [0, yPos]
        yPos += m.bannerTitle.boundingRect().height
    end if

    if m.bannerRelease.visible
        if yPos > 0 then yPos += BANNER_LOGO_GAP
        m.bannerRelease.translation = [0, yPos]
        yPos += m.bannerRelease.labelHeight
    end if

    if m.bannerMeta.visible
        if yPos > 0 then yPos += BANNER_META_GAP
        m.bannerMeta.translation = [0, yPos]
        yPos += m.bannerMeta.boundingRect().height
    end if

    if m.bannerRatings.visible
        if yPos > 0 then yPos += BANNER_RATINGS_GAP
        m.bannerRatings.translation = [0, yPos]
        yPos += m.bannerRatings.boundingRect().height
    end if

    m.bannerContent.translation = [BANNER_PAD_X, BANNER_CARD_HEIGHT - BANNER_PAD_BOTTOM - yPos]
end sub

' Only a handful of dots fit, so the run is shown through a window that keeps
' the current one in the middle
sub updateBannerDots()
    count = m.mediaBarItems.count()
    if count <= 1
        m.bannerDots.visible = false
        return
    end if

    shown = count < BANNER_MAX_DOTS ? count : BANNER_MAX_DOTS
    start = m.currentIndex - Int(shown / 2)
    if start > count - shown then start = count - shown
    if start < 0 then start = 0

    if m.bannerDots.getChildCount() <> shown
        m.bannerDots.removeChildrenIndex(m.bannerDots.getChildCount(), 0)
        for i = 0 to shown - 1
            dot = m.bannerDots.createChild("Poster")
            dot.uri = "pkg:/images/banner/dot4.9.png"
            dot.loadDisplayMode = "scaleToFit"
            dot.height = BANNER_DOT_SIZE
        end for
    end if

    rowWidth = 0
    for i = 0 to shown - 1
        dot = m.bannerDots.getChild(i)
        isCurrent = start + i = m.currentIndex
        dot.width = isCurrent ? BANNER_DOT_ACTIVE_WIDTH : BANNER_DOT_SIZE
        dot.blendColor = isCurrent ? "#FFFFFF" : "#FFFFFF66"
        rowWidth += dot.width
    end for
    rowWidth += (shown - 1) * BANNER_DOT_GAP

    m.bannerDots.translation = [m.bannerCardWidth - BANNER_DOTS_RIGHT - rowWidth, BANNER_DOTS_TOP]
    m.bannerDots.visible = true
end sub

sub showMakdItem(item as object)
    isNew = item.id <> m.makdShownId
    m.makdShownId = item.id

    logoUri = ""
    if isValidAndNotEmpty(item.logoUrl)
        logoUri = item.logoUrl
        ' Asked for at the size the column shows it, which the bar's shared logo url is too small for
        if not item.isExternal then logoUri = ImageURL(item.id, "Logo", { maxHeight: MAKD_LOGO_HEIGHT, maxWidth: MAKD_COLUMN_WIDTH, quality: 100 })
    end if
    if m.makdLogo.uri <> logoUri
        m.makdLogoIn.control = "stop"
        m.makdLogo.opacity = 0
        m.makdLogo.uri = logoUri
    end if
    ' The title stands in when there is no logo or it fails to load
    m.makdTitle.text = item.title
    m.makdTitle.visible = logoUri = "" or m.makdLogo.loadStatus = "failed"

    hideDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.home.hideMediaDescription`", false), false)
    m.makdOverview.text = hideDesc ? "" : (item.overview ?? "")
    m.makdOverview.visible = m.makdOverview.text <> ""

    m.makdRelease.release = item.newRelease ?? {}
    m.makdPluginRatings = []
    buildMakdFacts(item)
    buildMakdGenres(item)
    buildMakdButtons(item)
    layoutMakd()
    updateMakdDots()
    updateMakdFocus()
    if moonfinPlugin.IsRatingsEnabled("mediaBar") then fetchMediaBarRatings(item)

    if isNew
        m.makdContent.opacity = 0
        m.makdContentIn.control = "start"
    end if
end sub

' The community star, the critic tomato, any plugin scores, year, the rating on its badge, and
' when it ends or how many seasons it has, with a dot between each one
sub buildMakdFacts(item as object)
    m.makdInfo.removeChildrenIndex(m.makdInfo.getChildCount(), 0)

    facts = []
    community = item.communityRatingDisplay ?? ""
    if community <> "" then facts.push({ icon: "pkg:/images/sharp_star_white_18dp.webp", size: MAKD_STAR, blend: "#F2B01E", iconGap: 4, text: community })
    hasCritic = isValid(item.criticRating)
    if hasCritic
        tomato = "pkg:/images/icons/ratings/rt-rotten.webp"
        if item.criticRating >= 60 then tomato = "pkg:/images/icons/ratings/rt-fresh.webp"
        facts.push({ icon: tomato, size: MAKD_TOMATO, iconGap: 5, text: Int(item.criticRating).toStr() + "%" })
    end if
    for each rating in m.makdPluginRatings
        source = LCase(rating.source ?? "")
        if source <> "stars" and not (source = "tomatoes" and hasCritic)
            iconWidth = MAKD_RATING_ICON
            if source = "imdb" then iconWidth = MAKD_RATING_ICON * 2
            facts.push({ icon: rating.iconPath ?? "", size: MAKD_RATING_ICON, width: iconWidth, blend: rating.iconBlendColor ?? "", iconGap: 4, text: rating.formatted ?? "" })
        end if
    end for
    if isValid(item.year) and item.year > 0 then facts.push({ text: item.year.toStr() })
    officialRating = item.rating ?? ""
    if officialRating <> "" then facts.push({ text: officialRating, badge: true })
    if isStringEqual(item.itemType ?? "", "Series")
        seasons = item.childCount ?? 0
        if seasons = 1 then facts.push({ text: "1 " + tr("Season") })
        if seasons > 1 then facts.push({ text: seasons.toStr() + " " + tr("Seasons") })
    else if isValid(item.runTimeTicks) and item.runTimeTicks > 0
        facts.push({ text: tr("Ends at %1").Replace("%1", getEndTimeFromTicks(item.runTimeTicks).Trim()) })
    end if

    font = m.top.findNode("makdFontMedium").font
    badgeFont = m.top.findNode("makdFontBold").font
    x = 0
    for i = 0 to facts.count() - 1
        if i > 0 then x = makdSeparator(m.makdInfo, x, MAKD_FACTS_HEIGHT, MAKD_FACT_GAP)
        x = makdFact(m.makdInfo, x, facts[i], font, badgeFont)
    end for
end sub

' One fact on the row, its icon first when it has one. Returns where it ends.
function makdFact(parent as object, x as float, fact as object, font as object, badgeFont as object) as float
    iconUri = fact.icon ?? ""
    if iconUri <> ""
        iconSize = fact.size
        iconWidth = fact.width ?? iconSize
        icon = parent.createChild("Poster")
        icon.uri = iconUri
        icon.width = iconWidth
        icon.height = iconSize
        icon.loadDisplayMode = "scaleToFit"
        blend = fact.blend ?? ""
        if blend <> "" then icon.blendColor = blend
        icon.translation = [x, (MAKD_FACTS_HEIGHT - iconSize) / 2]
        x += iconWidth + fact.iconGap
    end if

    badged = fact.badge ?? false
    badge = invalid
    if badged then badge = parent.createChild("Poster")
    label = parent.createChild("Label")
    label.text = fact.text
    label.height = MAKD_FACTS_HEIGHT
    label.vertAlign = "center"
    if badged
        label.font = badgeFont
        label.color = "#000000"
        textWidth = label.boundingRect().width
        badge.uri = "pkg:/images/details/badgefill6.9.png"
        badge.blendColor = "#FFFFFFCC"
        badge.width = textWidth + MAKD_BADGE_PAD * 2
        badge.height = MAKD_LINE_HEIGHT
        badge.translation = [x, (MAKD_FACTS_HEIGHT - MAKD_LINE_HEIGHT) / 2]
        label.translation = [x + MAKD_BADGE_PAD, 0]
        return x + badge.width
    end if
    label.font = font
    label.color = "#FFFFFF"
    label.translation = [x, 0]
    return x + label.boundingRect().width
end function

' The small round mark between facts and between genres, with its gap either side
function makdSeparator(parent as object, x as float, rowHeight as integer, gap as integer) as float
    mark = parent.createChild("Poster")
    mark.uri = "pkg:/images/icons/circle.webp"
    mark.width = MAKD_SEPARATOR
    mark.height = MAKD_SEPARATOR
    mark.blendColor = MAKD_SEPARATOR_INK
    mark.translation = [x + gap, (rowHeight - MAKD_SEPARATOR) / 2]
    return x + gap * 2 + MAKD_SEPARATOR
end function

sub buildMakdGenres(item as object)
    m.makdGenres.removeChildrenIndex(m.makdGenres.getChildCount(), 0)
    if not isValidAndNotEmpty(item.genres) then return

    font = m.top.findNode("makdFontMedium").font
    x = 0
    for i = 0 to item.genres.count() - 1
        if i = MAKD_GENRES_LIMIT then exit for
        if i > 0 then x = makdSeparator(m.makdGenres, x, MAKD_LINE_HEIGHT, MAKD_GENRE_GAP)
        label = m.makdGenres.createChild("Label")
        label.font = font
        label.color = "#FFFFFF"
        label.text = item.genres[i]
        label.height = MAKD_LINE_HEIGHT
        label.vertAlign = "center"
        label.translation = [x, 0]
        x += label.boundingRect().width
    end for
end sub

' Info, Play and Favorite, or Info alone for a title from an outside list
sub buildMakdButtons(item as object)
    m.makdButtons.removeChildrenIndex(m.makdButtons.getChildCount(), 0)
    m.makdButtonNodes = []
    kinds = ["info"]
    if not item.isExternal then kinds = ["info", "play", "favorite"]

    x = 0
    for each kind in kinds
        group = m.makdButtons.createChild("Group")
        group.translation = [x, 0]
        focusRing = group.createChild("Poster")
        focusRing.translation = [-MAKD_FOCUS_OUT, -MAKD_FOCUS_OUT]
        focusRing.visible = false
        width = MAKD_BUTTON
        if kind = "play"
            fill = group.createChild("Poster")
            icon = group.createChild("Poster")
            label = group.createChild("Label")
            label.font = m.top.findNode("makdFontPlay").font
            label.text = tr("Play")
            label.color = "#000000"
            label.height = MAKD_BUTTON
            label.vertAlign = "center"
            label.translation = [MAKD_PLAY_PAD + MAKD_BUTTON_ICON + MAKD_PLAY_ICON_GAP, 0]
            width = MAKD_PLAY_PAD * 2 + MAKD_BUTTON_ICON + MAKD_PLAY_ICON_GAP + label.boundingRect().width
            fill.uri = "pkg:/images/details/surface8.9.png"
            fill.width = width
            fill.height = MAKD_BUTTON
            icon.uri = "pkg:/images/icons/play.webp"
            icon.blendColor = "#000000"
            icon.translation = [MAKD_PLAY_PAD, (MAKD_BUTTON - MAKD_BUTTON_ICON) / 2]
            focusRing.uri = "pkg:/images/seerr/stroke13w3.9.png"
        else
            favorited = kind = "favorite" and item.isFavorite
            fill = group.createChild("Poster")
            fill.uri = "pkg:/images/icons/circle.webp"
            fill.blendColor = "#000000"
            fill.opacity = 0.45
            fill.width = MAKD_BUTTON
            fill.height = MAKD_BUTTON
            ring = group.createChild("Poster")
            ring.uri = "pkg:/images/icons/circleRing.webp"
            ring.width = MAKD_BUTTON
            ring.height = MAKD_BUTTON
            ring.opacity = favorited ? 0.6 : 0.35
            if favorited then ring.blendColor = MAKD_FAVORITE_INK
            icon = group.createChild("Poster")
            icon.uri = "pkg:/images/icons/info_outline.webp"
            if kind = "favorite" then icon.uri = favorited ? "pkg:/images/icons/favorite.webp" : "pkg:/images/icons/favorite_outline.webp"
            if favorited then icon.blendColor = MAKD_FAVORITE_INK
            icon.translation = [(MAKD_BUTTON - MAKD_BUTTON_ICON) / 2, (MAKD_BUTTON - MAKD_BUTTON_ICON) / 2]
            focusRing.uri = "pkg:/images/icons/focusRing.webp"
        end if
        icon.width = MAKD_BUTTON_ICON
        icon.height = MAKD_BUTTON_ICON
        icon.loadDisplayMode = "scaleToFit"
        focusRing.width = width + MAKD_FOCUS_OUT * 2
        focusRing.height = MAKD_BUTTON + MAKD_FOCUS_OUT * 2
        m.makdButtonNodes.push({ kind: kind, focusRing: focusRing })
        x += width + MAKD_BUTTON_GAP
    end for
end sub

function communityRatingEntry(item as object) as dynamic
    community = item.communityRatingDisplay ?? ""
    if community = "" then return invalid

    return {
        source: "stars",
        name: tr("Community"),
        iconPath: "pkg:/images/sharp_star_white_18dp.webp",
        iconBlendColor: "#FFD700",
        formatted: community
    }
end function

' The column stacks up from its foot over the first row: buttons, overview, genres, facts, the
' new release label, then the logo box, which is what gives way if it all runs too tall
sub layoutMakd()
    columnLeft = MAKD_GUTTER
    if isValid(dockedSidebar()) then columnLeft += MAKD_SIDEBAR_RAIL
    m.makdContent.translation = [columnLeft, 0]

    y = m.makdColumnBottom - MAKD_BUTTON
    m.makdButtons.translation = [0, y]
    y -= MAKD_LOGO_GAP + MAKD_GAP

    if m.makdOverview.visible
        ' Sized to its lines, since a wrapped label with no height can draw just one
        m.makdOverview.height = 0
        overviewHeight = m.makdOverview.boundingRect().height
        m.makdOverview.height = overviewHeight
        y -= overviewHeight
        m.makdOverview.translation = [0, y]
        y -= MAKD_GAP
    end if
    if m.makdGenres.getChildCount() > 0
        y -= MAKD_LINE_HEIGHT
        m.makdGenres.translation = [0, y]
        y -= MAKD_GAP
    end if
    if m.makdInfo.getChildCount() > 0
        y -= MAKD_FACTS_HEIGHT
        m.makdInfo.translation = [0, y]
        y -= MAKD_GAP
    end if
    if m.makdRelease.visible
        y -= m.makdRelease.labelHeight
        m.makdRelease.translation = [0, y]
        y -= MAKD_GAP
    end if
    y -= MAKD_LOGO_GAP

    logoBox = MAKD_LOGO_HEIGHT
    columnTop = MAKD_COLUMN_BOTTOM - MAKD_COLUMN_MAX
    if y - logoBox < columnTop then logoBox = y - columnTop
    if logoBox < 0 then logoBox = 0
    m.makdLogoBox = logoBox
    m.makdLogoBottom = y
    m.makdTitle.height = logoBox
    m.makdTitle.translation = [0, y - logoBox]
    layoutMakdLogo()
end sub

' Shown at its own size up to the box, sitting on the box's foot at the left
sub layoutMakdLogo()
    bitmapWidth = m.makdLogo.bitmapWidth
    bitmapHeight = m.makdLogo.bitmapHeight
    if not isValid(m.makdLogoBox) or bitmapWidth <= 0 or bitmapHeight <= 0 then return
    fit = 1.0
    if bitmapWidth > MAKD_COLUMN_WIDTH then fit = MAKD_COLUMN_WIDTH / bitmapWidth
    if bitmapHeight * fit > m.makdLogoBox then fit = m.makdLogoBox / bitmapHeight
    m.makdLogo.width = bitmapWidth * fit
    m.makdLogo.height = bitmapHeight * fit
    m.makdLogo.translation = [0, m.makdLogoBottom - m.makdLogo.height]
end sub

sub onMakdLogoStatus()
    status = m.makdLogo.loadStatus
    if status = "ready" and m.makdLogo.uri <> ""
        m.makdTitle.visible = false
        layoutMakdLogo()
        m.makdLogoIn.control = "start"
    else if status = "failed"
        m.makdLogo.opacity = 0
        m.makdTitle.visible = true
    end if
end sub

' At most five dots, the lit one standing for its share of the run when there are more titles
sub updateMakdDots()
    total = m.mediaBarItems.count()
    if total <= 1
        m.makdDots.visible = false
        return
    end if

    count = total
    if count > MAKD_MAX_DOTS then count = MAKD_MAX_DOTS
    if m.makdDots.getChildCount() <> count
        m.makdDots.removeChildrenIndex(m.makdDots.getChildCount(), 0)
        m.makdActiveDot = -1
        for i = 0 to count - 1
            dot = m.makdDots.createChild("Poster")
            dot.id = "makdDot" + i.toStr()
            dot.uri = "pkg:/images/icons/circle.webp"
            dot.width = MAKD_DOT
            dot.height = MAKD_DOT
            dot.scaleRotateCenter = [MAKD_DOT / 2, MAKD_DOT / 2]
        end for
    end if
    dotsLeft = MAKD_DOTS_RIGHT - count * MAKD_DOT_SLOT
    for i = 0 to count - 1
        m.makdDots.getChild(i).translation = [dotsLeft + i * MAKD_DOT_SLOT + (MAKD_DOT_SLOT - MAKD_DOT) / 2, m.makdColumnBottom - MAKD_DOT]
    end for

    active = m.currentIndex
    if total > count then active = Int(m.currentIndex * count / total)
    if active > count - 1 then active = count - 1
    previous = m.makdActiveDot ?? -1
    m.makdActiveDot = active

    for i = 0 to count - 1
        dot = m.makdDots.getChild(i)
        dot.blendColor = i = active ? "#FFFFFF" : MAKD_DOT_INK
        if previous < 0 or previous = active then dot.scale = i = active ? [MAKD_DOT_ACTIVE_SCALE, MAKD_DOT_ACTIVE_SCALE] : [1.0, 1.0]
    end for
    if previous >= 0 and previous <> active
        m.makdDotMove.control = "finish"
        m.makdDotGrow.fieldToInterp = "makdDot" + active.toStr() + ".scale"
        m.makdDotShrink.fieldToInterp = "makdDot" + previous.toStr() + ".scale"
        m.makdDotMove.control = "start"
    end if
    m.makdDots.visible = true
end sub

' The ring sits on one button and the arrows show only while the bar has focus. Coming onto the
' bar puts the ring on Info.
sub updateMakdFocus()
    if not isValid(m.mediaBarItems) or not isValid(m.makdButtonNodes) then return
    focused = m.mediaBarMode = "makd" and m.top.isInFocusChain()
    if focused and not m.makdFocused then m.makdButton = 0
    m.makdFocused = focused

    count = m.makdButtonNodes.count()
    if m.makdButton > count - 1 then m.makdButton = count - 1
    for i = 0 to count - 1
        m.makdButtonNodes[i].focusRing.visible = focused and i = m.makdButton
    end for
    m.makdArrows.visible = focused and m.mediaBarItems.count() > 1
end sub

' Left and Right step along the buttons. Past either end onKeyEvent turns the slide, as the original
' does, or hands Left to a docked sidebar from any slide. Info's OK opens the title the way every
' style does.
function onMakdKey(key as string) as boolean
    count = 0
    if isValid(m.makdButtonNodes) then count = m.makdButtonNodes.count()
    if count = 0 then return false

    if key = KeyCode.LEFT and m.makdButton > 0
        m.makdButton--
        updateMakdFocus()
        return true
    else if key = KeyCode.RIGHT and m.makdButton < count - 1
        m.makdButton++
        updateMakdFocus()
        return true
    else if key = KeyCode.OK
        kind = m.makdButtonNodes[m.makdButton].kind
        if kind = "play"
            playMakdItem()
            return true
        else if kind = "favorite"
            toggleMakdFavorite()
            return true
        end if
    end if
    return false
end function

sub playMakdItem()
    item = m.mediaBarItems[m.currentIndex]
    if not isValid(item) or item.isExternal then return
    node = CreateObject("roSGNode", "ContentNode")
    node.id = item.id
    node.addFields({ type: item.itemType, json: { "Id": item.id, "Type": item.itemType, "UserData": { "PlaybackPositionTicks": item.playbackPositionTicks } }, selectedAudioStreamIndex: 0 })
    node.addField("startingPoint", "longinteger", false)
    m.global.sceneManager.quickPlayNode = node
end sub

sub toggleMakdFavorite()
    item = m.mediaBarItems[m.currentIndex]
    if not isValid(item) or item.isExternal then return
    item.isFavorite = not item.isFavorite
    m.makdFavoriteTask = CreateObject("roSGNode", "FavoriteItemsTask")
    m.makdFavoriteTask.itemId = item.id
    m.makdFavoriteTask.favTask = item.isFavorite ? "favorite" : "unfavorite"
    m.makdFavoriteTask.control = "RUN"
    buildMakdButtons(item)
    updateMakdFocus()
end sub

' The home screen hands the bar real focus rather than setting hasFocus, so the
' styles that mark themselves follow the focus chain
sub onMediaBarFocusChanged()
    focused = m.top.isInFocusChain()

    if m.mediaBarMode = "aya"
        m.ayaFocusRing.visible = focused
        m.ayaGroup.scale = focused ? [AYA_FOCUS_SCALE, AYA_FOCUS_SCALE] : [1.0, 1.0]
        return
    end if

    if m.mediaBarMode = "banner"
        m.bannerFocus.visible = focused
        m.bannerGlow.visible = focused
    end if

    if m.mediaBarMode = "makd" then updateMakdFocus()
end sub

sub showAyaItem(item as object)
    if item.logoUrl <> ""
        m.ayaLogo.uri = item.logoUrl
        m.ayaLogo.visible = true
        m.ayaTitle.visible = false
    else
        m.ayaTitle.text = item.title
        m.ayaTitle.visible = true
        m.ayaLogo.visible = false
    end if
    m.ayaRelease.release = item.newRelease ?? {}
    layoutAyaRelease()

    updateAyaIndicators()
    showAyaBackdrop(item.backdropUrl)
end sub

sub layoutAyaRelease()
    above = m.ayaLogo.visible ? m.ayaLogo : m.ayaTitle
    height = m.ayaLogo.visible ? m.ayaLogo.height : m.ayaTitle.boundingRect().height
    m.ayaRelease.translation = [above.translation[0], above.translation[1] + height + NEW_RELEASE_GAP]
end sub

' The incoming artwork fades in over the one already showing, then takes its
' place, so a slide never lands half drawn
sub showAyaBackdrop(url as string)
    if url = "" or isStringEqual(url, m.ayaBackdrop.uri) then return

    if not isValidAndNotEmpty(m.ayaBackdrop.uri)
        m.ayaBackdrop.uri = url
        return
    end if

    ' Let whatever is still fading land before starting the next one
    if isStringEqual(m.ayaSlideIn.state, "running") then commitAyaBackdrop()

    m.ayaBackdropNext.uri = url
    m.ayaSlideIn.control = "start"
end sub

sub onAyaSlideInComplete(event as object)
    if isStringEqual(event.getData(), "stopped") then commitAyaBackdrop()
end sub

sub commitAyaBackdrop()
    if not isValidAndNotEmpty(m.ayaBackdropNext.uri) then return

    m.ayaBackdrop.uri = m.ayaBackdropNext.uri
    m.ayaBackdropNext.uri = ""
    m.ayaBackdropNext.opacity = 0
end sub

' The bars are right aligned in the corner, so the row is measured before it is
' placed and the active one is wider
sub updateAyaIndicators()
    count = m.mediaBarItems.count()
    if count <= 1
        m.ayaIndicators.visible = false
        return
    end if

    if m.ayaIndicators.getChildCount() <> count
        m.ayaIndicators.removeChildrenIndex(m.ayaIndicators.getChildCount(), 0)
        for i = 0 to count - 1
            bar = m.ayaIndicators.createChild("Rectangle")
            bar.height = 2
        end for
    end if

    rowWidth = 0
    for i = 0 to count - 1
        bar = m.ayaIndicators.getChild(i)
        if i = m.currentIndex
            bar.width = AYA_INDICATOR_ACTIVE_WIDTH
            bar.color = "#FFFFFFFF"
        else
            bar.width = AYA_INDICATOR_WIDTH
            bar.color = "#FFFFFF4D"
        end if
        rowWidth += bar.width
    end for
    rowWidth += (count - 1) * AYA_INDICATOR_GAP

    m.ayaIndicators.translation = [AYA_FRAME_WIDTH - AYA_INDICATOR_RIGHT - rowWidth, AYA_INDICATOR_TOP]
    m.ayaIndicators.visible = true
end sub

' Called when contentFadeOut completes - swap content and fade back in
sub onContentFadeOutComplete(event as object)
    if event.getData() = "stopped" then return
    if m.pendingDisplayIndex >= 0
        showMediaBarItem(m.pendingDisplayIndex)
        m.pendingDisplayIndex = -1
        if isValid(m.contentFadeIn)
            ' Set dynamic fade-in targets to respect user settings
            if isValid(m.infoBgFadeInInterp)
                m.infoBgFadeInInterp.keyValue = [0.0, m.overlayOpacity ?? 0.5]
            end if
            if isValid(m.logoShadowFadeInInterp)
                m.logoShadowFadeInInterp.keyValue = [0.0, 0.6]
            end if
            m.contentFadeIn.control = "start"
        end if
    end if
end sub

' Actually populate the content (no animation, just sets values)
sub showMediaBarItem(index as integer)
    if index < 0 or index >= m.mediaBarItems.count() then return

    item = m.mediaBarItems[index]
    refreshTrailer()

    ' Update backdrop (single set, parent handles transitions)
    if item.backdropUrl <> ""
        m.top.currentBackdrop = item.backdropUrl
    end if

    if m.mediaBarMode = "aya"
        showAyaItem(item)
        return
    end if

    if m.mediaBarMode = "makd"
        showMakdItem(item)
        return
    end if

    if m.mediaBarMode = "banner"
        showBannerItem(item)
        return
    end if

    layoutFeatured()

    if item.logoUrl <> ""
        m.logoImage.uri = item.logoUrl
        m.logoShadow.uri = item.logoUrl
        m.logoImage.visible = true
        m.logoShadow.visible = true
        m.titleText.visible = false
    else
        m.titleText.text = item.title
        m.titleText.visible = true
        m.logoImage.visible = false
        m.logoShadow.visible = false
    end if

    m.featuredRelease.release = item.newRelease ?? {}
    buildFeaturedMeta(item)

    m.featuredCommunity = communityRatingEntry(item)
    renderFeaturedRatings([])
    if moonfinPlugin.IsRatingsEnabled("mediaBar")
        fetchMediaBarRatings(item)
    else
        if isValid(m.ratingsDebounceTimer) then m.ratingsDebounceTimer.control = "stop"
        m.pendingRatingsItem = invalid
    end if

    hideDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.home.hideMediaDescription`", false), false)
    m.overviewLabel.text = hideDesc ? "" : (item.overview ?? "")

    updateIndicatorDots()
    updateInfoBackgroundSize()
end sub

' Update info background to match content height
sub updateInfoBackgroundSize()
    if not isValid(m.infoOverlayContent) or not isValid(m.infoBackground) then return
    if not m.infoBackground.visible then return

    contentHeight = m.infoOverlayContent.boundingRect().height
    if contentHeight <= 0 then return

    totalHeight = contentHeight + (FEATURED_BOX_PAD_Y * 2)
    newBgY = m.infoBottomAnchor - totalHeight

    m.infoBackground.height = totalHeight
    m.infoBackground.translation = [m.infoBackground.translation[0], newBgY]

    m.infoOverlayContent.translation = [m.infoOverlayContent.translation[0], newBgY + FEATURED_BOX_PAD_Y]
end sub

sub fetchMediaBarRatings(item as object)
    m.ratingsRow.ratingsData = invalid

    tmdbId = item.tmdbId ?? ""
    itemType = item.itemType ?? ""
    if tmdbId = "" or itemType = "" then return

    ' Debounce so auto-advance and rapid arrows don't fire a request per item
    m.pendingRatingsItem = item
    m.pendingRatingsIndex = m.currentIndex
    m.ratingsDebounceTimer = moonfinPlugin.StartRatingsDebounce(m.ratingsDebounceTimer, "onRatingsDebounceFired")
end sub

sub onRatingsDebounceFired()
    item = m.pendingRatingsItem
    if not isValid(item) then return
    m.pendingRatingsItem = invalid

    if isValid(m.mediaBarRatingsTask)
        m.mediaBarRatingsTask.unobserveFieldScoped("ratings")
        m.mediaBarRatingsTask = invalid
    end if

    m.mediaBarRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.mediaBarRatingsTask.itemId = item.id ?? ""
    m.mediaBarRatingsTask.itemType = item.itemType
    m.mediaBarRatingsTask.tmdbId = item.tmdbId
    m.mediaBarRatingsTask.scope = "mediaBar"
    m.mediaBarRatingsTask.observeFieldScoped("ratings", "onMediaBarRatingsLoaded")
    m.mediaBarRatingsTask.control = "RUN"
end sub

sub onMediaBarRatingsLoaded(event as object)
    result = event.getData()
    if not isValid(result) then return

    if m.currentIndex <> m.pendingRatingsIndex then return

    displayRatings = result.data
    if not isValidAndNotEmpty(displayRatings) then return

    if m.mediaBarMode = "makd"
        m.makdPluginRatings = displayRatings
        buildMakdFacts(m.mediaBarItems[m.currentIndex])
        layoutMakd()
        return
    end if

    if m.mediaBarMode = "banner"
        renderBannerRatings(displayRatings)
        layoutBannerContent()
        return
    end if

    renderFeaturedRatings(displayRatings)

    updateInfoBackgroundSize()
end sub

' Start auto-advance timer
sub startAutoAdvanceTimer()
    if isValid(m.autoAdvanceTimer)
        m.autoAdvanceTimer.control = "stop"
        m.autoAdvanceTimer = invalid
    end if

    if not getMediaBarAutoAdvanceEnabled() then return

    m.autoAdvanceTimer = createObject("roSGNode", "Timer")
    m.autoAdvanceTimer.duration = getMediaBarIntervalMs() / 1000.0
    m.autoAdvanceTimer.repeat = true
    m.autoAdvanceTimer.observeFieldScoped("fire", "onAutoAdvance")
    m.autoAdvanceTimer.control = "start"
end sub

function getMediaBarAutoAdvanceEnabled() as boolean
    return get_user_setting_bool("ui.home.mediaBarAutoAdvance", false)
end function

function getMediaBarIntervalMs() as integer
    defaultMs = 7000
    settingValue = m.global.session.user.settings["ui.home.mediaBarIntervalMs"] ?? invalid
    if not isValid(settingValue) then return defaultMs

    intervalMs = settingValue.toInt()
    if intervalMs < 1000 then return 1000
    if intervalMs > 60000 then return 60000
    return intervalMs
end function

' Auto-advance handler
sub onAutoAdvance()
    if not getMediaBarAutoAdvanceEnabled() then return
    ' A playing trailer moves the bar on itself once it ends
    if m.trailerHolding then return

    if not m.isPaused and m.mediaBarItems.count() > 1
        if m.mediaBarMode = "gallery"
            galleryAdvance(1)
        else if m.mediaBarMode = "bookshelf"
            bookshelfAdvance(1)
        else
            nextSlide()
        end if
    end if
end sub

' Navigate to next slide
sub nextSlide()
    if m.mediaBarItems.count() <= 1 then return

    m.currentIndex = (m.currentIndex + 1) mod m.mediaBarItems.count()
    displayMediaBarItem(m.currentIndex)
end sub

' Navigate to previous slide
sub previousSlide()
    if m.mediaBarItems.count() <= 1 then return

    if m.currentIndex = 0
        m.currentIndex = m.mediaBarItems.count() - 1
    else
        m.currentIndex = m.currentIndex - 1
    end if

    displayMediaBarItem(m.currentIndex)
end sub

' Handle key events
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    m.clearBackdrop = true ' Default to clearing backdrop on focus loss

    ' Over a full screen trailer the first Left or Right ends it and brings the bar back. Its title
    ' is kept as the trailer's, so it only plays again once the slide changes.
    if m.mediaBarMode = "makd" and m.trailerActive and (key = KeyCode.LEFT or key = KeyCode.RIGHT)
        markTrailerUnavailable()
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "stop"
            m.autoAdvanceTimer.control = "start"
        end if
        return true
    end if
    if m.mediaBarMode = "makd" and onMakdKey(key) then return true

    if key = KeyCode.UP
        ' Signal parent to navigate to overhang (navbar)
        ' and don't clear the backdrop (if any)
        m.clearBackdrop = false
        return false ' Let parent handle navigation to overhang
    else if key = KeyCode.DOWN
        ' Navigate down to home rows
        return false ' Let parent handle
    else if key = KeyCode.LEFT
        sidebar = dockedSidebar()
        ' The banner steps back through its slides and only hands Left to the sidebar from the first one
        if isValid(sidebar) and (m.mediaBarMode <> "banner" or m.currentIndex = 0)
            m.clearBackdrop = false
            sidebar.setFocus(true)
            return true
        end if
        if m.mediaBarMode = "gallery"
            galleryAdvance(-1)
        else if m.mediaBarMode = "bookshelf"
            bookshelfAdvance(-1)
        else
            previousSlide()
        end if
        ' Reset auto-advance timer
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "stop"
            m.autoAdvanceTimer.control = "start"
        end if
        return true
    else if key = KeyCode.RIGHT
        if m.mediaBarMode = "gallery"
            galleryAdvance(1)
        else if m.mediaBarMode = "bookshelf"
            bookshelfAdvance(1)
        else
            nextSlide()
        end if
        ' Reset auto-advance timer
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "stop"
            m.autoAdvanceTimer.control = "start"
        end if
        return true
    else if key = KeyCode.OK
        ' Navigate to item details
        activeItem = invalid
        if m.mediaBarMode = "gallery"
            activeItem = getGalleryActiveItem()
        else if m.mediaBarMode = "bookshelf"
            if m.bookshelfActiveIndex >= 0 and m.bookshelfActiveIndex < m.mediaBarItems.count()
                activeItem = m.mediaBarItems[m.bookshelfActiveIndex]
            end if
        else if m.currentIndex >= 0 and m.currentIndex < m.mediaBarItems.count()
            activeItem = m.mediaBarItems[m.currentIndex]
        end if

        if isValid(activeItem) and isValid(activeItem.id) and isValid(activeItem.itemType)
            itemNode = createObject("roSGNode", "ContentNode")
            itemNode.id = activeItem.id
            itemNode.title = activeItem.title
            itemNode.addFields({ type: activeItem.itemType })
            if activeItem.isExternal then itemNode.addFields({ json: { SeerrItem: activeItem.seerrItem } })
            m.top.itemSelected = itemNode
        end if
        return true
    else if key = KeyCode.PLAY or key = "pause"
        ' Toggle pause/play
        m.isPaused = not m.isPaused
        m.pauseIndicator.visible = m.isPaused

        ' Stop/start auto-advance timer
        if isValid(m.autoAdvanceTimer)
            if m.isPaused
                m.autoAdvanceTimer.control = "stop"
            else
                m.autoAdvanceTimer.control = "start"
            end if
        end if
        return true
    end if

    return false
end function

' Public function to refresh the current display from parent
sub refreshCurrentDisplay()
    if m.mediaBarItems.count() > 0
        if m.mediaBarMode = "gallery"
            m.top.currentBackdrop = ""
            refreshDisplay()
        else if m.mediaBarMode = "bookshelf"
            m.top.currentBackdrop = ""
            refreshDisplay()
        else
            refreshDisplay()
        end if
    end if
end sub

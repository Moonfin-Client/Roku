import "pkg:/source/api/Image.bs"
import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.logoImage = m.top.findNode("logoImage")
    m.logoShadow = m.top.findNode("logoShadow")
    m.titleText = m.top.findNode("titleText")
    m.yearLabel = m.top.findNode("yearLabel")
    m.ratingLabel = m.top.findNode("ratingLabel")
    m.runtimeLabel = m.top.findNode("runtimeLabel")
    m.starLabel = m.top.findNode("starLabel")
    m.communityRatingLabel = m.top.findNode("communityRatingLabel")
    m.genresLabel = m.top.findNode("genresLabel")
    m.overviewLabel = m.top.findNode("overviewLabel")
    m.indicatorDots = m.top.findNode("indicatorDots")
    m.pauseIndicator = m.top.findNode("pauseIndicator")
    m.infoOverlayContent = m.top.findNode("infoOverlayContent")

    ' Separator dots for metadata
    m.separatorDot1 = m.top.findNode("separatorDot1")
    m.separatorDot2 = m.top.findNode("separatorDot2")
    m.separatorDot3 = m.top.findNode("separatorDot3")
    m.separatorDot4 = m.top.findNode("separatorDot4")

    ' Action button nodes
    m.playBg = m.top.findNode("playBg")
    m.playLabel = m.top.findNode("playLabel")
    m.playIcon = m.top.findNode("playIcon")
    m.infoBg = m.top.findNode("infoBg")
    m.infoLabel = m.top.findNode("infoLabel")
    m.chevronBg = m.top.findNode("chevronBg")
    m.chevronIcon = m.top.findNode("chevronIcon")

    ' Fade animations
    m.contentFadeOut = m.top.findNode("contentFadeOut")
    m.contentFadeIn = m.top.findNode("contentFadeIn")
    m.logoShadowFadeInInterp = m.top.findNode("logoShadowFadeInInterp")
    m.pendingDisplayIndex = -1
    if isValid(m.contentFadeOut)
        m.contentFadeOut.observeFieldScoped("state", "onContentFadeOutComplete")
    end if

    ' State
    m.mediaBarItems = []
    m.currentIndex = 0
    m.isPaused = false
    m.clearBackdrop = false
    m.focusedButton = "play"

    m.top.focusable = true

    m.top.observeFieldScoped("visible", "onVisibilityChanged")
    m.top.observeFieldScoped("hasFocus", "onFocusChanged")
    m.top.observeFieldScoped("contentType", "onContentTypeChanged")

    loadMediaBarItems()
end sub

sub onFocusChanged(event as object)
    hasFocus = event.getData()

    if hasFocus and m.mediaBarItems.count() > 0
        displayMediaBarItem(m.currentIndex)
        updateButtonStyles()
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "start"
        end if
    else
        if m.clearBackdrop
            m.top.currentBackdrop = ""
            m.clearBackdrop = false
        end if
        if isValid(m.autoAdvanceTimer)
            m.autoAdvanceTimer.control = "stop"
        end if
    end if
end sub

sub onVisibilityChanged(event as object)
    isVisible = event.getData()
    if isVisible and m.mediaBarItems.count() > 0
        displayMediaBarItem(m.currentIndex)
        updateButtonStyles()
    end if
end sub

' Reload when content type changes (e.g. LibraryHomePage sets movies vs tvshows)
sub onContentTypeChanged(_event as object)
    m.mediaBarItems = []
    m.currentIndex = 0
    if isValid(m.autoAdvanceTimer)
        m.autoAdvanceTimer.control = "stop"
        m.autoAdvanceTimer = invalid
    end if
    m.indicatorDots.removeChildrenIndex(m.indicatorDots.getChildCount(), 0)
    loadMediaBarItems()
end sub

sub loadMediaBarItems()
    ' Cancel any in-flight task so its result doesn't overwrite the new one
    if isValid(m.mediaBarTask)
        m.mediaBarTask.unobserveFieldScoped("mediaBarData")
        m.mediaBarTask = invalid
    end if

    m.mediaBarTask = createObject("roSGNode", "MediaBarTask")
    m.mediaBarTask.userId = m.global.session.user.id

    ' contentType field overrides settings (used by Movies/Shows pages)
    contentTypeOverride = m.top.contentType
    if isValidAndNotEmpty(contentTypeOverride)
        m.mediaBarTask.contentType = contentTypeOverride
    else
        m.mediaBarTask.contentType = m.global.session.user.settings["ui.home.mediaBarContentType"] ?? "both"
    end if

    m.mediaBarTask.sourceType = m.global.session.user.settings["ui.home.mediaBarSourceType"] ?? "library"
    m.mediaBarTask.selectedLibraryIds = m.global.session.user.settings["ui.home.mediaBarLibraryIds"] ?? "[]"
    m.mediaBarTask.selectedCollectionIds = m.global.session.user.settings["ui.home.mediaBarCollectionIds"] ?? "[]"
    m.mediaBarTask.excludedGenreIds = m.global.session.user.settings["ui.home.mediaBarExcludedGenres"] ?? "[]"
    m.mediaBarTask.observeFieldScoped("mediaBarData", "onMediaBarDataLoaded")
    m.mediaBarTask.control = "RUN"
end sub

sub onMediaBarDataLoaded(event as object)
    data = event.getData()
    if not isValid(data) then return

    if isValid(m.mediaBarTask)
        m.mediaBarTask.unobserveFieldScoped("mediaBarData")
    end if

    allItems = isChainValid(data, "items") ? data.items : []

    itemsWithBackdrops = []
    seenMediaBarItems = {}
    for each item in allItems
        itemType = LCase(item.LookupCI("Type") ?? "")
        if itemType <> "boxset" and itemType <> "collectionfolder" and isChainValid(item, "backdropImageTags") and item.backdropImageTags.count() > 0
            processedItem = processItem(item)

            if isValidAndNotEmpty(processedItem.tmdbId)
                dedupeKey = `${itemType}|tmdb|${LCase(processedItem.tmdbId)}`
            else if isValidAndNotEmpty(processedItem.id)
                dedupeKey = `${itemType}|id|${processedItem.id}`
            else
                nameKey = LCase(item.LookupCI("Name") ?? "")
                yearKey = isValid(item.LookupCI("ProductionYear")) ? item.LookupCI("ProductionYear").toStr() : ""
                dedupeKey = `${itemType}|name|${nameKey}|${yearKey}`
            end if

            if not seenMediaBarItems.DoesExist(dedupeKey)
                seenMediaBarItems[dedupeKey] = true
                itemsWithBackdrops.push(processedItem)
            end if
        end if
    end for

    settingValue = m.global.session.user.settings["ui.home.featuredMediaItems"] ?? invalid
    carouselItemCount = isValid(settingValue) ? settingValue.toInt() : 15

    shuffled = shuffleArray(itemsWithBackdrops)
    if shuffled.count() > carouselItemCount
        m.mediaBarItems = shuffled.slice(0, carouselItemCount)
    else
        m.mediaBarItems = shuffled
    end if

    if m.mediaBarItems.count() > 0
        createIndicatorDots()
        if m.mediaBarItems.count() > 1
            startAutoAdvanceTimer()
        end if
        displayMediaBarItem(0)
        updateButtonStyles()
    end if
end sub

function processItem(item as object) as object
    processed = {
        id: item.id,
        title: item.name,
        itemType: item.type,
        overview: invalid,
        year: invalid,
        rating: invalid,
        runtime: invalid,
        runtimeDisplay: "",
        communityRating: invalid,
        communityRatingDisplay: "",
        genres: [],
        genresDisplay: "",
        backdropUrl: "",
        logoUrl: "",
        tmdbId: ""
    }

    if isChainValid(item, "backdropImageTags") and item.backdropImageTags.count() > 0
        processed.backdropUrl = ImageURL(item.id, "Backdrop", {
            maxHeight: 1080,
            maxWidth: 1920,
            quality: 100,
            Tag: item.backdropImageTags[0]
        })
    end if

    if isChainValid(item, "imageTags.Logo")
        processed.logoUrl = ImageURL(item.id, "Logo", {
            maxHeight: 150,
            maxWidth: 500,
            quality: 100
        })
    end if

    if isValid(item.overview) then processed.overview = item.overview
    if isValid(item.productionYear) then processed.year = item.productionYear
    if isValid(item.officialRating) then processed.rating = item.officialRating

    if isValid(item.runTimeTicks)
        minutes = int(item.runTimeTicks / 600000000)
        processed.runtime = minutes
        if minutes >= 60
            hours = int(minutes / 60)
            mins = minutes mod 60
            processed.runtimeDisplay = hours.toStr() + "h " + mins.toStr() + "m"
        else
            processed.runtimeDisplay = minutes.toStr() + " min"
        end if
    end if

    if isValid(item.communityRating)
        processed.communityRating = item.communityRating
        processed.communityRatingDisplay = formatFloat(item.communityRating, 1)
    end if

    if isChainValid(item, "providerIds")
        processed.tmdbId = moonfinPlugin.GetTmdbId(item.providerIds)
    end if

    if isChainValid(item, "genres") and item.genres.count() > 0
        processed.genres = item.genres
        displayGenres = item.genres
        if displayGenres.count() > 3
            displayGenres = [displayGenres[0], displayGenres[1], displayGenres[2]]
        end if
        processed.genresDisplay = displayGenres.join(" • ")
    end if

    return processed
end function

sub createIndicatorDots()
    m.indicatorDots.removeChildrenIndex(m.indicatorDots.getChildCount(), 0)

    totalItems = m.mediaBarItems.count()
    dotSize = 10
    spacing = 10

    for i = 0 to totalItems - 1
        dot = createObject("roSGNode", "Poster")
        dot.uri = "pkg:/images/icons/circle.png"
        dot.width = dotSize
        dot.height = dotSize
        dot.loadDisplayMode = "scaleToFit"
        dot.blendColor = (i = 0) ? "0xFFFFFFFF" : "0x888888FF"
        dot.opacity = 1.0
        m.indicatorDots.appendChild(dot)
    end for

    ' Center dots horizontally on screen (screen width 1920, center at 960)
    totalWidth = totalItems * dotSize + (totalItems - 1) * spacing
    m.indicatorDots.translation = [960 - totalWidth / 2, 730]
end sub

sub updateIndicatorDots()
    numDots = m.indicatorDots.getChildCount()
    if numDots = 0 then return

    for i = 0 to numDots - 1
        dot = m.indicatorDots.getChild(i)
        dot.blendColor = (i = m.currentIndex) ? "0xFFFFFFFF" : "0x888888FF"
    end for
end sub

' Update visual state of all three action buttons based on m.focusedButton
' Colors use 0xRRGGBBAA format. Black opaque = 0x000000FF. White opaque = 0xFFFFFFFF.
sub updateButtonStyles()
    if not isValid(m.playBg) then return

    ' Play button (Poster pill background — blendColor tints the white 9-patch image)
    if m.focusedButton = "play"
        m.playBg.blendColor = "0xFFFFFFFF"
        m.playLabel.color = "0x000000FF"
        m.playIcon.blendColor = "0x000000FF"
    else
        m.playBg.blendColor = "0x000000CC"
        m.playLabel.color = "0xFFFFFFFF"
        m.playIcon.blendColor = "0xFFFFFFFF"
    end if

    ' Info button (Poster circle — blendColor tints white image)
    if m.focusedButton = "info"
        m.infoBg.blendColor = "0xFFFFFFFF"
        m.infoLabel.color = "0x000000FF"
    else
        m.infoBg.blendColor = "0x000000CC"
        m.infoLabel.color = "0xFFFFFFFF"
    end if

    ' Chevron button
    if m.focusedButton = "chevron"
        m.chevronBg.blendColor = "0xFFFFFFFF"
        m.chevronIcon.blendColor = "0x000000FF"
    else
        m.chevronBg.blendColor = "0x000000CC"
        m.chevronIcon.blendColor = "0xFFFFFFFF"
    end if
end sub

sub displayMediaBarItem(index as integer)
    if index < 0 or index >= m.mediaBarItems.count() then return

    if m.currentIndex <> index or m.pendingDisplayIndex >= 0
        if isValid(m.contentFadeOut) and isValid(m.infoOverlayContent) and m.infoOverlayContent.opacity > 0
            m.pendingDisplayIndex = index
            m.contentFadeOut.control = "start"
            item = m.mediaBarItems[index]
            if item.backdropUrl <> ""
                m.top.currentBackdrop = item.backdropUrl
            end if
            return
        end if
    end if

    showMediaBarItem(index)
end sub

sub onContentFadeOutComplete(event as object)
    if event.getData() = "stopped" then return
    if m.pendingDisplayIndex >= 0
        showMediaBarItem(m.pendingDisplayIndex)
        m.pendingDisplayIndex = -1
        if isValid(m.contentFadeIn)
            if isValid(m.logoShadowFadeInInterp)
                m.logoShadowFadeInInterp.keyValue = [0.0, 0.6]
            end if
            m.contentFadeIn.control = "start"
        end if
    end if
end sub

sub showMediaBarItem(index as integer)
    if index < 0 or index >= m.mediaBarItems.count() then return

    item = m.mediaBarItems[index]

    if item.backdropUrl <> ""
        m.top.currentBackdrop = item.backdropUrl
    end if

    if item.logoUrl <> ""
        m.logoImage.uri = item.logoUrl
        m.logoShadow.uri = item.logoUrl
        m.logoImage.visible = true
        m.logoShadow.visible = true
        m.logoShadow.opacity = 0.6
        m.titleText.visible = false
    else
        m.titleText.text = item.title
        m.titleText.visible = true
        m.logoImage.visible = false
        m.logoShadow.visible = false
    end if

    hasYear = false
    hasRating = false
    hasRuntime = false
    hasStarRating = false

    if item.year <> invalid
        m.yearLabel.text = item.year.toStr()
        hasYear = true
    else
        m.yearLabel.text = ""
    end if

    if item.rating <> invalid
        m.ratingLabel.text = item.rating
        hasRating = true
    else
        m.ratingLabel.text = ""
    end if

    ' Series don't display runtime in the featured row (episode length isn't meaningful here)
    isSeries = (LCase(item.itemType) = "series")
    if item.runtimeDisplay <> "" and not isSeries
        m.runtimeLabel.text = item.runtimeDisplay
        hasRuntime = true
    else
        m.runtimeLabel.text = ""
    end if

    if item.communityRatingDisplay <> ""
        m.starLabel.visible = true
        m.communityRatingLabel.text = item.communityRatingDisplay
        hasStarRating = true
    else
        m.starLabel.visible = false
        m.communityRatingLabel.text = ""
    end if

    m.separatorDot1.visible = (hasYear and hasRating)
    m.separatorDot2.visible = (hasRating and hasRuntime)
    m.separatorDot3.visible = (hasRuntime and hasStarRating)

    hasGenres = (item.genresDisplay <> "")
    m.genresLabel.text = item.genresDisplay
    hasPreviousMeta = (hasYear or hasRating or hasRuntime or hasStarRating)
    m.separatorDot4.visible = (hasPreviousMeta and hasGenres)

    if item.overview <> invalid
        m.overviewLabel.text = item.overview
    else
        m.overviewLabel.text = ""
    end if

    updateIndicatorDots()
end sub

sub startAutoAdvanceTimer()
    if isValid(m.autoAdvanceTimer)
        m.autoAdvanceTimer.control = "stop"
        m.autoAdvanceTimer = invalid
    end if

    m.autoAdvanceTimer = createObject("roSGNode", "Timer")
    m.autoAdvanceTimer.duration = getMediaBarIntervalMs() / 1000.0
    m.autoAdvanceTimer.repeat = true
    m.autoAdvanceTimer.observeFieldScoped("fire", "onAutoAdvance")
    m.autoAdvanceTimer.control = "start"
end sub

function getMediaBarIntervalMs() as integer
    defaultMs = 7000
    settingValue = m.global.session.user.settings["ui.home.mediaBarIntervalMs"] ?? invalid
    if not isValid(settingValue) then return defaultMs
    intervalMs = settingValue.toInt()
    if intervalMs < 1000 then return 1000
    if intervalMs > 60000 then return 60000
    return intervalMs
end function

sub onAutoAdvance()
    if not m.isPaused and m.mediaBarItems.count() > 1
        nextSlide()
    end if
end sub

sub nextSlide()
    if m.mediaBarItems.count() <= 1 then return
    m.currentIndex = (m.currentIndex + 1) mod m.mediaBarItems.count()
    displayMediaBarItem(m.currentIndex)
end sub

sub previousSlide()
    if m.mediaBarItems.count() <= 1 then return
    if m.currentIndex = 0
        m.currentIndex = m.mediaBarItems.count() - 1
    else
        m.currentIndex = m.currentIndex - 1
    end if
    displayMediaBarItem(m.currentIndex)
end sub

sub resetAutoAdvanceTimer()
    if isValid(m.autoAdvanceTimer)
        m.autoAdvanceTimer.control = "stop"
        m.autoAdvanceTimer.control = "start"
    end if
end sub

sub playCurrentItem()
    if m.mediaBarItems.count() = 0 then return
    if m.currentIndex < 0 or m.currentIndex >= m.mediaBarItems.count() then return

    currentItem = m.mediaBarItems[m.currentIndex]
    if not isValid(currentItem) or not isValid(currentItem.id) or not isValid(currentItem.itemType) then return

    ' Series have no direct stream — go to detail page so the user can pick an episode
    if LCase(currentItem.itemType) = "series"
        navigateToDetail()
        return
    end if

    itemNode = createObject("roSGNode", "ContentNode")
    itemNode.id = currentItem.id
    itemNode.title = currentItem.title
    itemNode.addFields({ type: currentItem.itemType })
    m.top.quickPlayNode = itemNode
end sub

sub navigateToDetail()
    if m.mediaBarItems.count() = 0 then return
    if m.currentIndex < 0 or m.currentIndex >= m.mediaBarItems.count() then return

    currentItem = m.mediaBarItems[m.currentIndex]
    if not isValid(currentItem) or not isValid(currentItem.id) or not isValid(currentItem.itemType) then return

    itemNode = createObject("roSGNode", "ContentNode")
    itemNode.id = currentItem.id
    itemNode.title = currentItem.title
    itemNode.addFields({ type: currentItem.itemType })
    m.top.itemSelected = itemNode
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    m.clearBackdrop = true

    if key = KeyCode.UP
        m.clearBackdrop = false
        return false

    else if key = KeyCode.DOWN
        ' Signal parent to switch to browse/row mode
        m.clearBackdrop = false
        m.top.navigateDown = not m.top.navigateDown
        return true

    else if key = KeyCode.LEFT
        if m.focusedButton = "chevron"
            m.focusedButton = "info"
            updateButtonStyles()
            return true
        else if m.focusedButton = "info"
            m.focusedButton = "play"
            updateButtonStyles()
            return true
        else
            scene = m.top.getScene()
            if isValid(scene)
                sidebar = scene.findNode("sidebar")
                if isValid(sidebar) and sidebar.visible
                    m.clearBackdrop = false
                    sidebar.setFocus(true)
                    return true
                end if
            end if
            previousSlide()
            resetAutoAdvanceTimer()
            return true
        end if

    else if key = KeyCode.RIGHT
        if m.focusedButton = "play"
            m.focusedButton = "info"
            updateButtonStyles()
            return true
        else if m.focusedButton = "info"
            m.focusedButton = "chevron"
            updateButtonStyles()
            return true
        else
            ' Chevron — advance carousel, stay on chevron
            nextSlide()
            resetAutoAdvanceTimer()
            return true
        end if

    else if key = KeyCode.OK
        if m.focusedButton = "play"
            playCurrentItem()
        else if m.focusedButton = "info"
            navigateToDetail()
        else if m.focusedButton = "chevron"
            nextSlide()
            resetAutoAdvanceTimer()
        end if
        return true

    else if key = KeyCode.PLAY or key = "pause"
        m.isPaused = not m.isPaused
        m.pauseIndicator.visible = m.isPaused
        if isValid(m.autoAdvanceTimer)
            if m.isPaused
                m.autoAdvanceTimer.control = "stop"
            else
                m.autoAdvanceTimer.control = "start"
            end if
        end if
        return true
    end if

    return false
end function

function formatFloat(value as float, decimals as integer) as string
    multiplier = 10 ^ decimals
    rounded = int(value * multiplier + 0.5)
    intPart = int(rounded / multiplier)
    decPart = rounded mod multiplier

    result = intPart.toStr()
    if decimals > 0
        result = result + "." + decPart.toStr()
    end if

    return result
end function

sub refreshCurrentDisplay()
    if m.mediaBarItems.count() > 0
        displayMediaBarItem(m.currentIndex)
    end if
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="HomeRow" extends="ContentNode">
  <interface>
    <!-- The row's cell, as wide as its first card and as tall as its tallest -->
    <field id="cursorSize" type="array" value="[134, 200]" />
    <!-- Whether its cards differ in size, so each card carries its own -->
    <field id="variableWidth" type="bool" value="false" />
    <!-- poster, thumb or banner, the art its cards show -->
    <field id="imageType" type="string" value="poster" />
    <!-- Whether a Modern row's focused card widens and shows its details under it -->
    <field id="modernCards" type="bool" value="false" />
    <!-- The card size, style and card count the cards were last sized for -->
    <field id="laidOutFor" type="string" value="" />
    <!-- A second line under the title, which only Watching on MDBList draws -->
    <field id="subtitle" type="string" value="" />
  </interface>
</component>
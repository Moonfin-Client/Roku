<?xml version="1.0" encoding="utf-8"?>
<component name="TrailerPreviewTask" extends="Task">
    <interface>
        <!-- { requestId, item, index, captions, language }, or a videoId in place of the item.
            Each run resolves the attempt at index, so a local trailer that plays never waits on
            a YouTube lookup. -->
        <field id="request" type="assocarray" />
        <!-- { requestId, index, count, url, format, startTime, segments, cues } -->
        <field id="answer" type="assocarray" />
    </interface>
</component>

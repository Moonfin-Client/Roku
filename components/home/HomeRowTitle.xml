<?xml version="1.0" encoding="utf-8"?>
<!-- Draws each home row's title in place of the row label. Watching on MDBList adds a globe ahead
     of the title and its live counts on a second line behind a green dot. -->
<component name="HomeRowTitle" extends="Group">
  <children>
    <Label id="icon" visible="false" vertAlign="center" />
    <Label id="title" />
    <Group id="summary" visible="false">
      <Poster id="dotGlow" uri="pkg:/images/icons/circle.webp" width="24" height="24" blendColor="#22C55E" opacity="0.35" />
      <Poster id="dot" uri="pkg:/images/icons/circle.webp" width="14" height="14" translation="[5,5]" blendColor="#22C55E" />
      <Label id="subtitle" translation="[34,0]" height="24" vertAlign="center" opacity="0.95">
        <Font role="font" uri="font:BoldSystemFontFile" size="24" />
      </Label>
    </Group>
  </children>
  <interface>
    <field id="content" type="node" onChange="onContentChanged" />
    <field id="rowCounterVertAlign" type="string" value="top" />
  </interface>
</component>

import "pkg:/source/api/MoonfinPlugin.bs"
import "pkg:/source/utils/galleryGlow.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/themeApply.bs"

' Panel geometry, taken from the other clients, which write their layout in the
' same 1920x1080 pixels this screen uses
const GALLERY_PANEL_HEIGHT = 951
const GALLERY_NARROW_WIDTH = 92
const GALLERY_PAD = 16
const GALLERY_LINE_GAP = 10
const GALLERY_LINE_WIDTH = 2
const GALLERY_INDEX_HEIGHT = 26
const GALLERY_TURNED_TITLE_HEIGHT = 30
const GALLERY_TITLE_SHARE = 0.66

const GALLERY_ACTIVE_PAD_X = 48
const GALLERY_RIGHT_LEFT = 888
const GALLERY_CREDITS_PAD = 18

const GALLERY_BLOCK_GAP = 12
const GALLERY_PILL_GAP = 8
const GALLERY_GENRES_LIMIT = 3
const GALLERY_OVERVIEW_GAP = 14
const GALLERY_PILL_PAD_X = 10
const GALLERY_PILL_PAD_Y = 5
const GALLERY_CREDIT_GAP = 12
const GALLERY_CREDIT_LABEL_GAP = 4

sub init()
    m.narrowContent = m.top.findNode("narrowContent")
    m.narrowPoster = m.top.findNode("narrowPoster")
    m.itemNumber = m.top.findNode("itemNumber")
    m.narrowTitle = m.top.findNode("narrowTitle")
    m.narrowLineTop = m.top.findNode("narrowLineTop")
    m.narrowLineBottom = m.top.findNode("narrowLineBottom")

    m.wideContent = m.top.findNode("wideContent")
    m.itemBackdrop = m.top.findNode("itemBackdrop")
    m.wideLeft = m.top.findNode("wideLeft")
    m.wideRight = m.top.findNode("wideRight")
    m.itemTitle = m.top.findNode("itemTitle")
    m.galleryPills = m.top.findNode("galleryPills")
    m.galleryRatings = m.top.findNode("galleryRatings")
    m.gOverview = m.top.findNode("gOverview")
    m.creditsFill = m.top.findNode("creditsFill")
    m.creditsBorder = m.top.findNode("creditsBorder")
    m.directorLabel = m.top.findNode("directorLabel")
    m.directorValue = m.top.findNode("directorValue")
    m.starringLabel = m.top.findNode("starringLabel")
    m.starringValue = m.top.findNode("starringValue")

    m.pillFont = m.top.findNode("pillFont").font
    m.pillFont.size = 18
    m.itemNumber.font.size = 20
    m.narrowTitle.font.size = 22
    m.itemTitle.font.size = 52
    m.gOverview.font.size = 22
    m.gOverview.lineSpacing = 10
    for each node in [m.directorLabel, m.starringLabel]
        node.font.size = 16
    end for
    for each node in [m.directorValue, m.starringValue]
        node.font.size = 20
    end for

    m.directorLabel.text = UCase(tr("Director"))
    m.starringLabel.text = UCase(tr("Starring"))

    accent = themeChrome.IsActive() ? themeChrome.Accent() : "#00A4DC"
    m.directorLabel.color = accent
    m.starringLabel.color = accent

    layoutNarrowPanel()
    themeApply.ApplyToItem(m.top)
end sub

' The idle column is fixed, so it only has to be placed once
sub layoutNarrowPanel()
    inner = GALLERY_PANEL_HEIGHT - GALLERY_PAD * 2
    titleHeight = Int(inner * GALLERY_TITLE_SHARE)

    ' Each line carries the gap above and below it, so four of them come out of
    ' the room the lines get to share
    lineHeight = (inner - titleHeight - GALLERY_INDEX_HEIGHT - GALLERY_LINE_GAP * 4) / 2
    lineLeft = (GALLERY_NARROW_WIDTH - GALLERY_LINE_WIDTH) / 2

    lineTop = GALLERY_PAD + GALLERY_INDEX_HEIGHT + GALLERY_LINE_GAP
    m.narrowLineTop.translation = [lineLeft, lineTop]
    m.narrowLineTop.height = lineHeight

    ' The title is turned on its side, so its own width runs down the panel and
    ' it is placed by its centre
    titleTop = lineTop + lineHeight + GALLERY_LINE_GAP
    halfTitle = GALLERY_TURNED_TITLE_HEIGHT / 2
    m.narrowTitle.width = titleHeight
    m.narrowTitle.height = GALLERY_TURNED_TITLE_HEIGHT
    m.narrowTitle.scaleRotateCenter = [titleHeight / 2, halfTitle]
    m.narrowTitle.translation = [GALLERY_NARROW_WIDTH / 2 - titleHeight / 2, titleTop + titleHeight / 2 - halfTitle]

    m.narrowLineBottom.translation = [lineLeft, titleTop + titleHeight + GALLERY_LINE_GAP]
    m.narrowLineBottom.height = lineHeight
end sub

sub contentChanged()
    data = m.top.itemContent
    if not isValid(data) then return

    isActive = data.isActive = true
    glow = galleryGlow.ForGenres(data.genres)

    m.itemNumber.text = padGalleryIndex(data.itemNumber)
    m.narrowTitle.text = UCase(data.title ?? "")
    m.narrowLineTop.color = glow
    m.narrowLineBottom.color = glow

    backdropUrl = data.backdropUrl ?? ""
    m.narrowPoster.uri = isActive ? "" : backdropUrl
    m.itemBackdrop.uri = isActive ? backdropUrl : ""

    m.narrowContent.visible = not isActive
    m.wideContent.visible = isActive
    if isActive then showWidePanel(data, glow)
end sub

sub showWidePanel(data as object, glow as string)
    m.itemTitle.text = UCase(data.title ?? "")

    hideDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.home.hideMediaDescription`", false), false)
    overview = data.overview ?? ""
    m.gOverview.text = hideDesc ? "" : overview
    m.gOverview.visible = m.gOverview.text <> ""

    buildGalleryPills(data, glow)
    showGalleryRatings(data)
    layoutWideLeft()
    layoutCredits(data)
end sub

' The facts run as pills, with the genres carrying the glow the panel is tinted
' with and the age rating outlined rather than filled
sub buildGalleryPills(data as object, glow as string)
    m.galleryPills.removeChildrenIndex(m.galleryPills.getChildCount(), 0)

    runtime = data.runtimeDisplay ?? ""
    if not isStringEqual(data.itemType ?? "", "Series") and runtime <> "" and runtime <> "0m"
        addGalleryPill(runtime, "#000000", 0.35, false)
    end if

    rating = data.rating ?? ""
    if rating <> "" then addGalleryPill(rating, "#FFFFFF8C", 1.0, true)

    year = data.year
    if isValid(year) and year > 0 then addGalleryPill(year.toStr(), "#000000", 0.35, false)

    if isValidAndNotEmpty(data.genres)
        shown = 0
        for each genre in data.genres
            addGalleryPill(genre, glow, 0.30, false)
            shown++
            if shown = GALLERY_GENRES_LIMIT then exit for
        end for
    end if

    xPos = 0
    for i = 0 to m.galleryPills.getChildCount() - 1
        pill = m.galleryPills.getChild(i)
        pill.translation = [xPos, 0]
        xPos += pill.findNode("pillBg").width + GALLERY_PILL_GAP
    end for
end sub

sub addGalleryPill(text as string, fill as string, fillOpacity as float, outlined as boolean)
    pill = m.galleryPills.createChild("Group")

    bg = pill.createChild("Poster")
    bg.id = "pillBg"
    bg.uri = outlined ? "pkg:/images/gallery/pilloutline8.9.png" : "pkg:/images/gallery/pill8.9.png"
    bg.loadDisplayMode = "scaleToFit"
    bg.blendColor = fill
    bg.opacity = fillOpacity

    label = pill.createChild("Label")
    label.font = m.pillFont
    label.color = "#FFFFFF"
    label.text = text
    label.translation = [GALLERY_PILL_PAD_X, GALLERY_PILL_PAD_Y]

    bounds = label.boundingRect()
    bg.width = bounds.width + GALLERY_PILL_PAD_X * 2
    bg.height = bounds.height + GALLERY_PILL_PAD_Y * 2
end sub

' The community score comes off the item, so the row fills without waiting on
' anything the plugin would have to fetch
sub showGalleryRatings(data as object)
    community = data.communityRatingDisplay ?? ""
    if community = ""
        m.galleryRatings.ratingsData = { data: [] }
        return
    end if

    m.galleryRatings.ratingsData = { data: [{
        source: "stars",
        name: tr("Community"),
        iconPath: "pkg:/images/sharp_star_white_18dp.png",
        iconBlendColor: "#FFD700",
        formatted: community
    }] }
end sub

' The left column is stacked, then the pair is centred on the panel the way the
' other clients centre theirs
sub layoutWideLeft()
    yPos = m.itemTitle.boundingRect().height + GALLERY_BLOCK_GAP

    m.galleryPills.translation = [0, yPos]
    if m.galleryPills.getChildCount() > 0
        yPos += m.galleryPills.getChild(0).findNode("pillBg").height + GALLERY_BLOCK_GAP
    end if

    m.galleryRatings.translation = [0, yPos]
    if m.galleryRatings.visible then yPos += m.galleryRatings.boundingRect().height

    if m.gOverview.visible
        yPos += GALLERY_OVERVIEW_GAP
        m.gOverview.translation = [0, yPos]
        yPos += m.gOverview.boundingRect().height
    end if

    m.wideLeft.translation = [GALLERY_ACTIVE_PAD_X, (GALLERY_PANEL_HEIGHT - yPos) / 2]
end sub

sub layoutCredits(data as object)
    director = data.director ?? ""
    starring = data.starring ?? ""
    hasDirector = director <> ""
    hasStarring = starring <> ""

    m.directorLabel.visible = hasDirector
    m.directorValue.visible = hasDirector
    m.directorValue.text = director

    m.starringLabel.visible = hasStarring
    m.starringValue.visible = hasStarring
    m.starringValue.text = starring

    if not hasDirector and not hasStarring
        m.wideRight.visible = false
        return
    end if

    m.wideRight.visible = true
    yPos = GALLERY_CREDITS_PAD

    if m.directorValue.visible
        m.directorLabel.translation = [GALLERY_CREDITS_PAD, yPos]
        yPos += m.directorLabel.boundingRect().height + GALLERY_CREDIT_LABEL_GAP
        m.directorValue.translation = [GALLERY_CREDITS_PAD, yPos]
        yPos += m.directorValue.boundingRect().height
    end if

    if m.starringValue.visible
        if m.directorValue.visible then yPos += GALLERY_CREDIT_GAP
        m.starringLabel.translation = [GALLERY_CREDITS_PAD, yPos]
        yPos += m.starringLabel.boundingRect().height + GALLERY_CREDIT_LABEL_GAP
        m.starringValue.translation = [GALLERY_CREDITS_PAD, yPos]
        yPos += m.starringValue.boundingRect().height
    end if

    panelHeight = yPos + GALLERY_CREDITS_PAD
    m.creditsFill.height = panelHeight
    m.creditsBorder.height = panelHeight
    m.wideRight.translation = [GALLERY_RIGHT_LEFT, (GALLERY_PANEL_HEIGHT - panelHeight) / 2]
end sub

function padGalleryIndex(index as dynamic) as string
    if not isValid(index) then return ""
    if index < 10 then return `0${index}`

    return index.toStr()
end function

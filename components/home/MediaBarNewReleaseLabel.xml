<?xml version="1.0" encoding="utf-8"?>
<!-- White rather than the accent, which means focus on the media bar -->
<component name="MediaBarNewReleaseLabel" extends="Group">
    <interface>
        <field id="release" type="assocarray" alwaysNotify="true" onChange="redraw" />
        <!-- How tall it draws, 0 while there's nothing to say, so a stack can make room -->
        <field id="labelHeight" type="float" value="0" />
    </interface>
    <children>
        <Rectangle id="bar" width="3" color="#FFFFFF" visible="false" />
        <Label id="kind" width="650" height="30" vertAlign="center" color="#FFFFFF" ellipsisText="...">
            <Font role="font" uri="font:BoldSystemFontFile" size="23" />
        </Label>
        <Label id="detail" width="650" height="48" vertAlign="center" color="#FFFFFF" ellipsisText="...">
            <Font role="font" uri="font:BoldSystemFontFile" size="40" />
        </Label>
    </children>
</component>

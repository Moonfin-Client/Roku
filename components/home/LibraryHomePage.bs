import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.rowList = m.top.findNode("rowList")
    m.spinner = m.top.findNode("spinner")
    m.pageTitle = m.top.findNode("pageTitle")
    m.itemTitle = m.top.findNode("itemTitle")
    m.metaYear = m.top.findNode("metaYear")
    m.metaDot1 = m.top.findNode("metaDot1")
    m.metaRating = m.top.findNode("metaRating")
    m.metaDot2 = m.top.findNode("metaDot2")
    m.metaRuntime = m.top.findNode("metaRuntime")
    m.metaDot3 = m.top.findNode("metaDot3")
    m.metaCommunityGroup = m.top.findNode("metaCommunityGroup")
    m.metaCommunityRating = m.top.findNode("metaCommunityRating")
    m.metaDot4 = m.top.findNode("metaDot4")
    m.metaStatus = m.top.findNode("metaStatus")
    m.metaRow = m.top.findNode("metaRow")
    m.itemOverview = m.top.findNode("itemOverview")
    m.backdrop = m.top.findNode("backdrop")
    m.backdropPrev = m.top.findNode("backdropPrev")
    m.backdropFadeIn = m.top.findNode("backdropFadeIn")
    m.backdropPrevFadeOut = m.top.findNode("backdropPrevFadeOut")

    m.rowList.itemSize = [1703, 460]
    m.rowList.itemSpacing = [0, 80]
    m.rowList.rowItemSize = [230, 345]
    m.rowList.rowItemSpacing = [20, 0]

    m.content = CreateObject("roSGNode", "ContentNode")
    m.rowList.content = m.content

    m.rowList.observeField("rowItemSelected", "onRowItemSelected")
    m.rowList.observeField("rowItemFocused", "onItemFocusChanged")

    m.pendingGenreRows = 0
    m.pendingInitialLoads = 3
    m.genreTasks = []
    m.genreRows = []
end sub

sub onMediaTypeChanged()
    mediaType = m.top.mediaType
    if not isValidAndNotEmpty(mediaType) then return

    if mediaType = "movies"
        m.pageTitle.text = "Movies"
    else
        m.pageTitle.text = "TV Shows"
    end if

    startLoading()
end sub

sub startLoading()
    mediaType = m.top.mediaType
    m.spinner.visible = true

    m.continueRow = addRow("Keep Watching")
    m.continueTask = CreateObject("roSGNode", "LoadLibraryItemsTask")
    m.continueTask.mediaType = mediaType
    m.continueTask.itemsToLoad = "mergedcontinue"
    m.continueTask.observeField("content", "onContinueLoaded")
    m.continueTask.control = "RUN"

    m.latestRow = addRow("Recently Added")
    m.latestTask = CreateObject("roSGNode", "LoadLibraryItemsTask")
    m.latestTask.mediaType = mediaType
    m.latestTask.itemsToLoad = "latest"
    m.latestTask.observeField("content", "onLatestLoaded")
    m.latestTask.control = "RUN"

    m.genresTask = CreateObject("roSGNode", "LoadLibraryItemsTask")
    m.genresTask.mediaType = mediaType
    m.genresTask.itemsToLoad = "genres"
    m.genresTask.observeField("content", "onGenresLoaded")
    m.genresTask.control = "RUN"

    m.browseAllRow = addBrowseAllRow()
end sub

function addRow(title as string) as object
    row = CreateObject("roSGNode", "HomeRow")
    row.title = title
    row.imageWidth = 230
    row.cursorSize = [230, 345]
    m.content.appendChild(row)
    return row
end function

function addBrowseAllRow() as object
    row = CreateObject("roSGNode", "HomeRow")
    row.title = "Browse All"
    row.imageWidth = 230
    row.cursorSize = [230, 345]

    item = CreateObject("roSGNode", "HomeData")
    item.id = "browseAll"
    item.name = "Browse All"
    item.type = "browseAll"
    item.labelText = "Browse All"
    item.imageWidth = 230
    item.imageHeight = 345
    item.posterURL = "pkg:/images/browse_all_poster.png"
    row.appendChild(item)

    m.content.appendChild(row)
    return row
end function

sub onContinueLoaded(event as object)
    items = event.getData()
    if not isValidAndNotEmpty(items)
        removeRow(m.continueRow)
    else
        populateRow(m.continueRow, items)
    end if
    m.pendingInitialLoads -= 1
    checkDoneLoading()
end sub

sub onLatestLoaded(event as object)
    items = event.getData()
    if not isValidAndNotEmpty(items)
        removeRow(m.latestRow)
    else
        populateRow(m.latestRow, items)
    end if
    m.pendingInitialLoads -= 1
    checkDoneLoading()
end sub

sub onGenresLoaded(event as object)
    genres = event.getData()
    m.pendingInitialLoads -= 1
    if not isValidAndNotEmpty(genres)
        checkDoneLoading()
        return
    end if

    m.pendingGenreRows = genres.count()
    m.genreTasks = []
    m.genreRows = []

    for each genre in genres
        genreRow = addRowBefore(genre.title, m.browseAllRow)
        m.genreRows.push(genreRow)

        task = CreateObject("roSGNode", "LoadLibraryItemsTask")
        task.mediaType = m.top.mediaType
        task.itemsToLoad = "genreitems"
        task.genreId = genre.id
        task.observeField("content", "onGenreItemsLoaded")
        m.genreTasks.push(task)
        task.control = "RUN"
    end for
end sub

sub onGenreItemsLoaded(event as object)
    task = event.getRoSGNode()
    genreRow = invalid
    for i = 0 to m.genreTasks.count() - 1
        if m.genreTasks[i].isSameNode(task)
            genreRow = m.genreRows[i]
            exit for
        end if
    end for

    items = event.getData()
    if isValid(genreRow)
        if not isValidAndNotEmpty(items)
            removeRow(genreRow)
        else
            populateRow(genreRow, items)
        end if
    end if

    m.pendingGenreRows -= 1
    checkDoneLoading()
end sub

sub checkDoneLoading()
    if m.pendingInitialLoads > 0 then return
    if m.pendingGenreRows > 0 then return
    m.spinner.visible = false
    if m.rowList.content.getChildCount() > 0
        m.rowList.setFocus(true)
    end if
end sub

sub populateRow(row as object, items as object)
    for each item in items
        row.appendChild(item)
    end for
    updateRowSizes()
end sub

sub updateRowSizes()
    count = m.content.getChildCount()
    sizeArray = []
    for i = 0 to count - 1
        row = m.content.getChild(i)
        if isValid(row) and isValid(row.cursorSize)
            sizeArray.push(row.cursorSize)
        else
            sizeArray.push([180, 270])
        end if
    end for
    if sizeArray.count() > 0
        m.rowList.rowItemSize = sizeArray
    end if
end sub

sub removeRow(row as object)
    if not isValid(row) then return
    parent = row.getParent()
    if isValid(parent) then parent.removeChild(row)
end sub

function addRowBefore(title as string, referenceRow as object) as object
    row = CreateObject("roSGNode", "HomeRow")
    row.title = title
    row.imageWidth = 230
    row.cursorSize = [230, 345]

    if isValid(referenceRow)
        refIndex = 0
        for i = 0 to m.content.getChildCount() - 1
            if m.content.getChild(i).isSameNode(referenceRow)
                refIndex = i
                exit for
            end if
        end for
        m.content.insertChild(row, refIndex)
    else
        m.content.appendChild(row)
    end if

    return row
end function

sub onItemFocusChanged()
    if not isValid(m.rowList.content) then return

    focused = m.rowList.rowItemFocused
    if not isValidAndNotEmpty(focused) or focused[0] < 0 or focused[1] < 0 then return

    item = m.content.getChild(focused[0]).getChild(focused[1])
    if not isValid(item) then return

    m.itemTitle.text = item.name ?? ""

    json = item.json
    if not isValid(json) then return

    clearMeta()

    if isValid(json.ProductionYear) and json.ProductionYear > 0
        m.metaYear.text = stri(json.ProductionYear).trim()
        m.metaYear.visible = true
    end if

    if isValidAndNotEmpty(json.OfficialRating)
        m.metaRating.text = json.OfficialRating
        m.metaRating.visible = true
    end if

    runTimeTicks = invalid
    if type(item.RunTimeTicks) = "LongInteger"
        runTimeTicks = item.RunTimeTicks
    else if type(json.RunTimeTicks) = "LongInteger"
        runTimeTicks = json.RunTimeTicks
    end if
    if isValid(runTimeTicks)
        mins = int(int(runTimeTicks / 10000000&) / 60)
        if mins > 0
            hrs = int(mins / 60)
            remMins = mins mod 60
            hTmp = stri(hrs)
            hStr = hTmp.trim()
            remTmp = stri(remMins)
            remStr = remTmp.trim()
            runtimeText = ""
            if hrs > 0
                runtimeText = hStr + "h"
                if remMins > 0
                    runtimeText = runtimeText + " " + remStr + "m"
                end if
            else
                runtimeText = remStr + "m"
            end if
            m.metaRuntime.text = runtimeText
            m.metaRuntime.visible = true
        end if
    end if

    if isValid(json.CommunityRating) and json.CommunityRating > 0
        m.metaCommunityRating.text = left(json.CommunityRating.toStr(), 3)
        m.metaCommunityGroup.visible = true
    end if

    if isValidAndNotEmpty(json.Status)
        m.metaStatus.text = json.Status
        m.metaStatus.visible = true
    end if

    updateMetaDots()

    if isValid(m.itemOverview)
        overview = ""
        if isValidAndNotEmpty(json.Overview)
            overview = json.Overview
        end if
        m.itemOverview.text = overview
    end if

    if isValidAndNotEmpty(item.backdropURL)
        if isValidAndNotEmpty(m.backdrop.uri)
            m.backdropPrev.uri = m.backdrop.uri
            m.backdropPrev.opacity = 0.3
        end if
        m.backdrop.opacity = 0.0
        m.backdrop.uri = item.backdropURL
        if isValid(m.backdropFadeIn) then m.backdropFadeIn.control = "start"
        if isValid(m.backdropPrevFadeOut) then m.backdropPrevFadeOut.control = "start"
    else
        m.backdrop.uri = ""
        m.backdropPrev.uri = ""
    end if
end sub

sub clearMeta()
    if isValid(m.itemOverview) then m.itemOverview.text = ""
    m.metaYear.text = ""
    m.metaYear.visible = false
    m.metaRating.text = ""
    m.metaRating.visible = false
    m.metaRuntime.text = ""
    m.metaRuntime.visible = false
    m.metaCommunityGroup.visible = false
    m.metaStatus.text = ""
    m.metaStatus.visible = false
    m.metaDot1.visible = false
    m.metaDot2.visible = false
    m.metaDot3.visible = false
    m.metaDot4.visible = false
end sub

sub updateMetaDots()
    contentNodes = [m.metaYear, m.metaRating, m.metaRuntime, m.metaCommunityGroup, m.metaStatus]
    dots = [m.metaDot1, m.metaDot2, m.metaDot3, m.metaDot4]

    for i = 0 to dots.count() - 1
        leftNode = contentNodes[i]
        rightNode = contentNodes[i + 1]
        dots[i].visible = (leftNode.visible and rightNode.visible)
    end for
end sub

sub onRowItemSelected(event as object)
    selected = event.getData()
    if not isValidAndNotEmpty(selected) or selected.count() < 2 then return

    rowIndex = selected[0]
    itemIndex = selected[1]
    item = m.content.getChild(rowIndex).getChild(itemIndex)

    if not isValid(item) then return

    if isStringEqual(item.type, "browseAll")
        m.top.browseAllPressed = not m.top.browseAllPressed
        return
    end if

    m.top.selectedItem = item
end sub

sub OnScreenShown(_isReturning = false as boolean)
    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav) and isValidAndNotEmpty(m.top.mediaType)
        activeNav.currentPage = m.top.mediaType
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.LEFT)
        nav = getActiveNav(m.top.getScene())
        if isValid(nav)
            nav.setFocus(true)
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.BACK)
        scene = m.top.getScene()
        if isValid(scene)
            sidebar = scene.findNode("sidebar")
            if isValid(sidebar) and sidebar.visible
                sidebar.setFocus(true)
                return true
            end if
        end if
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

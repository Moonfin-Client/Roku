<?xml version="1.0" encoding="utf-8"?>
<component name="LibraryHomePage" extends="JFScreen">
  <children>
    <!-- Backdrops (crossfade pair, full screen) -->
    <Poster id="backdropPrev" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />
    <Poster id="backdrop" loadDisplayMode="scaleToFill" width="1920" height="1080" opacity="0.3" />


    <!-- Dark scrim for readability (hidden in featured mode, shown in browse mode) -->
    <Rectangle id="backdropTint" width="1920" height="1080" color="#F2000000" opacity="0.0" />

    <!-- Left-side vignette gradient for featured mode readability -->
    <Poster id="featuredGradient" uri="pkg:/images/featured_gradient.png" width="960" height="1080" loadDisplayMode="scaleToFill" visible="false" />

    <!-- Details section shown when MediaBar is disabled (mirrors Home.xml layout) -->
    <Group id="detailsSection" translation="[111, 60]" visible="false">
      <Text id="pageTitle"
        font="font:SmallBoldSystemFont"
        color="#AAAAAA"
        visible="false" />

      <ScrollingText id="itemTitle"
        translation="[0, 30]"
        font="font:LargeBoldSystemFont"
        color="#FFFFFF"
        maxWidth="1500"
        repeatCount="-1" />

      <LayoutGroup id="metaRow"
        translation="[0, 110]"
        layoutDirection="horiz"
        horizAlignment="left"
        vertAlignment="center"
        itemSpacings="[15]">
        <Text id="metaYear"    font="font:MediumSystemFont"     color="#CCCCCC" />
        <Text id="metaDot1"   font="font:MediumSystemFont"     text="•" color="#CCCCCC" visible="false" />
        <Text id="metaRating"  font="font:MediumBoldSystemFont" color="#CCCCCC" />
        <Text id="metaDot2"   font="font:MediumSystemFont"     text="•" color="#CCCCCC" visible="false" />
        <Text id="metaRuntime" font="font:MediumSystemFont"     color="#CCCCCC" />
        <Text id="metaDot3"   font="font:MediumSystemFont"     text="•" color="#CCCCCC" visible="false" />
        <LayoutGroup id="metaCommunityGroup" visible="false" layoutDirection="horiz" itemSpacings="[5]">
          <Poster id="metaStar" uri="pkg:/images/sharp_star_white_18dp.png" height="28" width="28" blendColor="#FFD700" />
          <Text id="metaCommunityRating" font="font:MediumSystemFont" color="#CCCCCC" />
        </LayoutGroup>
        <Text id="metaDot4"   font="font:MediumSystemFont"     text="•" color="#CCCCCC" visible="false" />
        <Text id="metaStatus"  font="font:MediumSystemFont"     color="#CCCCCC" />
      </LayoutGroup>

      <Text id="itemOverview"
        translation="[0, 145]"
        font="font:SmallSystemFont"
        color="#CCCCCC"
        width="1600"
        wrap="true"
        maxLines="3"
        lineSpacing="-5" />
    </Group>

    <!-- Featured media carousel (Apple TV style) -->
    <MediaBar
      id="mediaBar"
      translation="[0, 0]"
      visible="false" />

    <!-- Row list starts below the featured section -->
    <RowList
      id="rowList"
      translation="[111, 870]"
      showRowLabel="true"
      rowLabelOffset="[[0, 20]]"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="fixedFocus"
      itemComponentName="HomeItem"
      numRows="2"
      focusBitmapUri="pkg:/images/hd_focus.9.png" />

    <!-- Loading indicator -->
    <BusySpinner id="spinner" translation="[940, 430]" visible="true" />

    <!-- Backdrop crossfade animations -->
    <Animation id="backdropFadeIn" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropFadeInInterp" key="[0.0, 1.0]" keyValue="[0.0, 0.3]" fieldToInterp="backdrop.opacity" />
    </Animation>
    <Animation id="backdropPrevFadeOut" duration="0.5" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="backdropPrevFadeOutInterp" key="[0.0, 1.0]" keyValue="[0.3, 0.0]" fieldToInterp="backdropPrev.opacity" />
    </Animation>
  </children>
  <interface>
    <field id="mediaType" type="string" value="" onChange="onMediaTypeChanged" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <field id="browseAllPressed" type="boolean" alwaysNotify="true" />
  </interface>
</component>

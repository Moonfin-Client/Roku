import "pkg:/components/anime/animeMarkerWatch.bs"
import "pkg:/components/posterLabels/posterLabelsDraw.bs"
import "pkg:/components/recordings/incompleteRecordingWatch.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/enums/SeriesStatus.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/homeCards.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playedState.bs"
import "pkg:/source/utils/themeApply.bs"

' Font size bounds for the name that stands in for missing artwork
const PLACEHOLDER_MAX_SIZE = 30
const PLACEHOLDER_MIN_SIZE = 16

' How far the progress track sits in from each poster edge
const PROGRESS_INSET = 6

' How far below the art a classic card's name and then its second line start, and a modern card's name
const CLASSIC_TEXT_GAP = 16
const CLASSIC_SUBTEXT_GAP = 46
const MODERN_TEXT_GAP = 5

' Room left around a browse tile's logo so it reads as a logo rather than artwork, and the
' solid ground it sits on. ColorPalette only carries part opaque blacks.
const BROWSE_TILE_INSET = 24
const BROWSE_TILE_BACKGROUND = "0x000000FF"
const STUDIO_LOGO_TILE_BACKGROUND = "0xFFFFFF1A"

sub init()
    m.seeAllCard = false
    findNodes()
    m.itemPoster.observeField("loadStatus", "onPosterLoadStatusChanged")
    setColors()

    ' Modern rows slide neighbors aside to make room for the focused landscape
    ' card. The scene sets modernShift on this item's content node.
    m.modernEnabled = isModernHomeRows()
    m.modernObservedNode = invalid
    ' The art a card asked for, before it was sized for the card
    m.artSource = ""

    ' Track focus change timing to detect and prevent oscillations
    m.lastFocusChangeTime = 0
    m.focusChangeCount = 0
    m.isInOscillation = false
    m.lastStableFocusState = false
    m.initTime = UpTime(0)
    m.initCooldownPeriod = 0.8 ' Block animations for 800ms after creation (increased to handle focus restoration)
    themeApply.ApplyToItem(m.top)
end sub

sub setColors()
    if not isAllValid([m.itemProgress, m.itemProgressBackground, m.backdrop]) then findNodes()

    ' Every read of the session copies all of it, and a row binds its cards as it scrolls, so the
    ' colors come from one read
    colors = chainLookupReturn(m.global.session, "user.settings", {})
    if isValid(m.itemProgress) then m.itemProgress.blendColor = colors.colorHomeRowItemProgress ?? ColorPalette.TRIADBLUE
    if isValid(m.itemProgressBackground) then m.itemProgressBackground.blendColor = colors.colorHomeRowItemProgressBackground ?? ColorPalette.BLACK90
    m.cardBackground = colors.colorHomeRowItemBackground ?? ColorPalette.ELEMENTBACKGROUND
    if isValid(m.backdrop) then m.backdrop.color = m.cardBackground
    if isValid(m.itemText) then m.itemText.color = colors.colorHomeRowItemTitle ?? ColorPalette.WHITE
    if isValid(m.posterText) then m.posterText.color = colors.colorHomeRowItemTitle ?? ColorPalette.WHITE
    if isValid(m.itemIcon) then m.itemIcon.blendcolor = colors.colorHomeMyListIcon ?? ColorPalette.WHITE
end sub

sub findNodes()
    initItemText()
    initItemPoster()
    initPosterText()
    initBackdrop()
    initItemIcon()
    m.itemProgress = m.top.findNode("progress")
    m.itemProgressBackground = m.top.findNode("progressBackground")
    m.playedIndicator = m.top.findNode("playedIndicator")
    m.scaleGroup = m.top.findNode("scaleGroup")
    m.posterMask = m.top.findNode("posterMask")
    m.modernShiftAnim = m.top.findNode("modernShiftAnim")
    m.modernShiftInterp = m.top.findNode("modernShiftInterp")
    m.modernShiftPosterOpacity = m.top.findNode("modernShiftPosterOpacity")
    m.modernShiftTextOpacity = m.top.findNode("modernShiftTextOpacity")
    m.itemSubtext = m.top.findNode("itemSubtext")
    m.classicNameFont = m.top.findNode("classicNameFont")
    m.classicLineFont = m.top.findNode("classicLineFont")
end sub

sub initItemText()
    m.itemText = m.top.findNode("itemText")
end sub

sub initItemPoster()
    m.itemPoster = m.top.findNode("itemPoster")
end sub

sub initPosterText()
    m.posterText = m.top.findNode("posterText")
end sub

' The name stands in for artwork the item does not have. A wide card gets a bigger name
' than a portrait one, up to a point, so neither ends up unreadable.
sub setPosterText(itemData as object)
    if not isValid(m.posterText) then initPosterText()
    if not isValid(m.posterText) then return

    m.posterText.width = m.cardWidth
    m.posterText.height = m.itemPoster.height

    textSize = Int(m.cardWidth / 8)
    if textSize > PLACEHOLDER_MAX_SIZE then textSize = PLACEHOLDER_MAX_SIZE
    if textSize < PLACEHOLDER_MIN_SIZE then textSize = PLACEHOLDER_MIN_SIZE
    m.posterText.font.size = textSize

    title = itemData.LookupCI("title")
    m.posterText.text = isValidAndNotEmpty(title) ? UCase(title) : string.EMPTY

    showPosterText(m.itemPoster.loadStatus <> PosterLoadStatus.READY)
end sub

' A tile with an icon of its own says enough already. That is read off the item rather than
' the node, which still holds whatever the last item in this cell put there.
sub showPosterText(visible as boolean)
    if not isValid(m.posterText) then return

    hasIcon = isValidAndNotEmpty(chainLookupReturn(m.top.itemContent, "iconUrl", ""))
    m.posterText.visible = visible and (not hasIcon or m.seeAllCard)
end sub

sub initBackdrop()
    m.backdrop = m.top.findNode("backdrop")
end sub

sub initItemIcon()
    m.itemIcon = m.top.findNode("itemIcon")
end sub

sub itemContentChanged()
    ' A row can hand a card its content before the card's own init has run
    if not isValid(m.initCooldownPeriod) then init()

    itemData = m.top.itemContent

    if not isValid(itemData) then return
    localGlobal = m.global

    ' A card's content hangs off the row it was appended to, which says whether its cards widen
    parentRow = itemData.getParent()
    if m.modernEnabled and isValid(parentRow) and parentRow.modernCards = true
        setupModernShiftObserver(itemData)
    else if isValid(m.modernObservedNode)
        m.modernObservedNode.unobserveFieldScoped("modernShift")
        m.modernObservedNode = invalid
        if isValid(m.scaleGroup) then m.scaleGroup.translation = [0, 0]
    end if

    ' Every read of the json field copies it, so it is read once
    json = itemData.json
    if isValid(m.playedIndicator)
        m.playedIndicator.data = {
            played: playedState.ShowsWatchedCheck(json),
            favorite: chainLookupReturn(json, "UserData.IsFavorite", chainLookupReturn(itemData, "favorite", false)),
            unplayedCount: chainLookupReturn(json, "UserData.UnplayedItemCount", 0),
            itemType: chainLookupReturn(json, "Type", "")
        }
    end if

    itemData.AddReplace("Title", itemData.LookupCI("name"))

    setColors()
    initItemIcon()
    initItemText()

    ' validate to prevent crash
    if not isValid(m.itemPoster) then initItemPoster()
    if not isValid(m.backdrop) then initBackdrop()
    if not isValid(m.itemIcon) then initItemIcon()

    ' A row of same sized cards keeps their size, and a row of mixed ones gives each card its own
    width = itemData.imageWidth
    height = itemData.imageHeight ?? 270
    m.cardImageType = "poster"
    if isValid(parentRow)
        m.cardImageType = parentRow.imageType
        if parentRow.variableWidth <> true
            cell = parentRow.cursorSize
            width = cell[0]
            height = cell[1]
        end if
    end if
    m.cardWidth = width
    m.itemPoster.width = width
    m.itemPoster.height = height
    m.backdrop.height = height
    ' The upcoming rows' See All card puts the calendar glyph above the middle and the words in it
    m.seeAllCard = isStringEqual(itemData.type, "CalendarSeeAll")
    iconSize = 80
    iconTop = (height - iconSize) / 2
    if m.seeAllCard
        iconSize = 60
        iconTop = height * 0.3 - iconSize / 2
    end if
    m.itemIcon.width = iconSize
    m.itemIcon.height = iconSize
    m.itemIcon.opacity = m.seeAllCard ? 0.6 : 1.0
    m.itemIcon.translation = [(width - iconSize) / 2, iconTop]
    m.itemProgressBackground.translation = [PROGRESS_INSET, height - PROGRESS_INSET - m.itemProgressBackground.height]
    m.posterMask.visible = true

    ' Art for a title outside the library comes at TMDB's size rather than the card's, so it's
    ' scaled down as it loads. A wide row of 1280 pixel backdrops would fill texture memory.
    m.outsideCard = isValid(json) and (isValid(json.SeerrTmdbId) or isValid(json.CalendarDate))
    m.itemPoster.loadWidth = m.outsideCard ? width : 0
    m.itemPoster.loadHeight = m.outsideCard ? m.itemPoster.height : 0

    ' A Seerr title can carry its status on the poster. It rides on the poster so it fades with it,
    ' and the marks along the top edge drop below it.
    m.seerrStatusMark = drawSeerrStatus(m.seerrStatusMark, m.itemPoster, seerrCardStatus(itemData), width)
    seerrInset = seerrStatusInset(m.seerrStatusMark)

    ' Reposition played indicator to top-right corner of poster
    if isValid(m.playedIndicator)
        m.playedIndicator.translation = [width - 50, 10 + seerrInset]
        m.playedIndicator.favoriteOffset = [10 - (width - 50), 0]
    end if

    m.itemText.maxWidth = width
    m.itemText.horizAlign = "left"
    if m.modernEnabled
        m.itemText.translation = [2, height + MODERN_TEXT_GAP]
        m.itemText.height = 34
        m.itemText.font.size = 25
        m.itemText.vertAlign = "bottom"
    else
        ' Classic cards carry two lines under the art, the name and then the year or the episode
        m.itemText.font = m.classicNameFont.font
        m.itemText.translation = [0, height + CLASSIC_TEXT_GAP]
        m.itemText.height = 30
        m.itemText.vertAlign = "center"
        m.itemSubtext.font = m.classicLineFont.font
        m.itemSubtext.translation = [0, height + CLASSIC_SUBTEXT_GAP]
    end if
    m.itemSubtext.maxWidth = width
    m.itemSubtext.text = ""
    m.itemSubtext.visible = not m.modernEnabled

    m.backdrop.width = width

    ' A cell keeps whatever the last item left here, so the bar starts hidden and only an
    ' item with progress turns it back on
    if isValid(m.itemProgressBackground) then m.itemProgressBackground.visible = false

    setPosterText(itemData)
    showWatchingNow(chainLookupReturn(json, "WatchingNow", invalid), width)

    m.animeAboveProgress = (itemData.LookupCI("PlayedPercentage") ?? 0) > 0
    watchAnimeMarker(itemData, json, true)
    watchIncompleteRecording(chainLookupReturn(json, "Id", ""))
    showPosterLabels(itemData.LookupCI("posterLabels"))

    if isAllValid([m.itemIcon, itemData.iconUrl])
        m.itemIcon.uri = itemData.iconUrl
    end if

    ' The See All card has no art or label, so a recycled cell drops the last card's poster and name
    if m.seeAllCard
        m.itemPoster.uri = ""
        m.itemText.text = ""
        m.backdrop.visible = true
        m.itemIcon.visible = true
        showPosterText(true)
        return
    end if

    itemDataType = isValid(itemData.type) ? LCase(itemData.type) : ""

    if inArray([ItemType.COLLECTIONFOLDER, ItemType.USERVIEW, ItemType.CHANNEL, ItemType.FOLDER], itemDataType)
        displayCollectionInfo(itemData)
        return
    end if

    ' "Program" is from clicking on an "On Now" item on the Home Screen
    if itemDataType = ItemType.PROGRAM
        displayProgramInfo(itemData)
        return
    end if

    if inArray([ItemType.EPISODE, ItemType.RECORDING], itemDataType)
        displayEpisodeInfo(localGlobal, itemData)
        return
    end if

    if inArray([ItemType.MOVIE, ItemType.MUSICVIDEO], itemDataType)
        displayMovieInfo(itemData)
        return
    end if

    if itemDataType = ItemType.VIDEO
        displayVideoInfo(itemData)
        return
    end if

    if itemDataType = ItemType.BOXSET
        displayBoxsetInfo(itemData)
        return
    end if

    if itemDataType = ItemType.SERIES
        displaySeriesInfo(itemData)
        return
    end if

    if itemDataType = ItemType.MUSICALBUM
        displayMusicAlbumInfo(itemData as object)
        return
    end if

    if itemDataType = ItemType.AUDIOBOOK
        displayAudioBookInfo(itemData as object)
        return
    end if

    if inArray([ItemType.MUSICARTIST, ItemType.AUDIO], itemDataType)
        displayAudioInfo(itemData as object)
        return
    end if

    if itemDataType = ItemType.TVCHANNEL
        displayTVChannelInfo(itemData as object)
        return
    end if

    if itemDataType = ItemType.SEASON
        displaySeasonInfo(itemData as object)
        return
    end if

    if itemDataType = ItemType.PHOTO
        displayPhotoInfo(itemData as object)
        return
    end if

    if itemDataType = ItemType.PHOTOALBUM
        displayPhotoAlbumInfo(itemData as object)
        return
    end if

    if itemDataType = "seerrbrowse" or itemDataType = "seerrshortcut"
        displayBrowseTileInfo(itemData)
        return
    end if

    if itemDataType = ItemType.STUDIO
        displayStudioInfo(itemData)
        return
    end if

end sub

' Core's Watching on MDBList card. Its parts are laid out at twice Core's points and scaled down to
' Core's size on a TV. The rank and the kind of title sit along the top, the logo or the name low in
' the middle and the watchers under it, over a scrim and with no name below the card. It's built the
' first time a card needs it.
sub showWatchingNow(info as dynamic, cardWidth as integer)
    on = isValid(info)
    m.itemText.visible = not on
    if on then m.itemSubtext.visible = false
    if not isValid(m.watchingNow)
        if not on then return
        buildWatchingNow()
    end if
    m.watchingNow.visible = on
    if not on then return

    partsScale = homeCards.PIXELS_PER_POINT / 2
    m.watchingNow.scale = [partsScale, partsScale]
    width = cardWidth / partsScale
    height = m.itemPoster.height / partsScale
    m.wnScrim.width = width
    m.wnScrim.height = height

    m.wnRank.text = info.rank.ToStr()

    m.wnTypeText.text = UCase(info.mediaType)
    badgeWidth = m.wnTypeText.boundingRect().width + 24
    for each part in [m.wnTypeFill, m.wnTypeRing]
        part.width = badgeWidth
    end for
    m.wnType.translation = [width - 24 - badgeWidth, 20]

    m.wnWatchers.text = tr("{count} watching").Replace("{count}", info.watchers.ToStr())
    m.wnWatchersRow.translation = [24, height - 16 - 26]

    ' The logo keeps to the bottom of its box, which needs the logo's size, so it's placed once it loads
    m.wnLogoBox = [28, height - 52 - 88, width - 56, 88]
    m.wnTitle.translation = [m.wnLogoBox[0], m.wnLogoBox[1]]
    m.wnTitle.width = m.wnLogoBox[2]
    m.wnTitle.height = m.wnLogoBox[3]
    m.wnTitle.text = m.top.itemContent.name
    m.wnLogo.visible = false
    m.wnTitle.visible = info.logo = ""
    m.wnLogo.loadWidth = m.wnLogoBox[2]
    m.wnLogo.loadHeight = m.wnLogoBox[3]
    m.wnLogo.uri = info.logo
    ' A cell handed the logo it already shows never hears from loadStatus again
    if info.logo <> "" then onWatchingNowLogoStatus()
end sub

sub buildWatchingNow()
    m.watchingNow = m.posterMask.createChild("Group")

    m.wnScrim = m.watchingNow.createChild("Poster")
    m.wnScrim.uri = "pkg:/images/home/watchingNowScrim.webp"

    m.wnRank = m.watchingNow.createChild("Label")
    m.wnRank.translation = [24, 16]
    m.wnRank.color = "#FFFFFF"
    m.wnRank.font = watchingNowFont(36)

    m.wnType = m.watchingNow.createChild("Group")
    m.wnTypeFill = m.wnType.createChild("Poster")
    m.wnTypeFill.uri = "pkg:/images/details/badgefill6.9.png"
    m.wnTypeFill.blendColor = "#000000A6"
    m.wnTypeFill.height = 30
    m.wnTypeRing = m.wnType.createChild("Poster")
    m.wnTypeRing.uri = "pkg:/images/details/outline6.9.png"
    m.wnTypeRing.blendColor = "#FFFFFF3D"
    m.wnTypeRing.height = 30
    m.wnTypeText = m.wnType.createChild("Label")
    m.wnTypeText.translation = [12, 0]
    m.wnTypeText.height = 30
    m.wnTypeText.vertAlign = "center"
    m.wnTypeText.color = "#FFFFFF"
    m.wnTypeText.font = watchingNowFont(20)

    m.wnLogo = m.watchingNow.createChild("Poster")
    m.wnLogo.loadDisplayMode = "scaleToFit"
    m.wnLogo.observeField("loadStatus", "onWatchingNowLogoStatus")

    m.wnTitle = m.watchingNow.createChild("Label")
    m.wnTitle.wrap = true
    m.wnTitle.maxLines = 2
    m.wnTitle.horizAlign = "center"
    m.wnTitle.vertAlign = "bottom"
    m.wnTitle.color = "#FFFFFF"
    m.wnTitle.font = watchingNowFont(28)

    m.wnWatchersRow = m.watchingNow.createChild("Group")
    glow = m.wnWatchersRow.createChild("Poster")
    glow.uri = "pkg:/images/icons/circle.webp"
    glow.width = 22
    glow.height = 22
    glow.translation = [0, 2]
    glow.blendColor = "#22C55E"
    glow.opacity = 0.35
    dot = m.wnWatchersRow.createChild("Poster")
    dot.uri = "pkg:/images/icons/circle.webp"
    dot.width = 14
    dot.height = 14
    dot.translation = [4, 6]
    dot.blendColor = "#22C55E"
    m.wnWatchers = m.wnWatchersRow.createChild("Label")
    m.wnWatchers.translation = [34, 0]
    m.wnWatchers.height = 26
    m.wnWatchers.vertAlign = "center"
    m.wnWatchers.color = "#FFFFFF"
    m.wnWatchers.font = watchingNowFont(22)
end sub

function watchingNowFont(size as integer) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = "font:BoldSystemFontFile"
    font.size = size
    return font
end function

sub onWatchingNowLogoStatus()
    status = m.wnLogo.loadStatus
    if status = PosterLoadStatus.FAILED
        m.wnLogo.visible = false
        m.wnTitle.visible = true
        return
    end if
    if status <> PosterLoadStatus.READY or m.wnLogo.bitmapWidth = 0 or m.wnLogo.bitmapHeight = 0 then return

    area = m.wnLogoBox
    scale = area[2] / m.wnLogo.bitmapWidth
    if area[3] / m.wnLogo.bitmapHeight < scale then scale = area[3] / m.wnLogo.bitmapHeight
    drawnWidth = m.wnLogo.bitmapWidth * scale
    drawnHeight = m.wnLogo.bitmapHeight * scale
    m.wnLogo.width = drawnWidth
    m.wnLogo.height = drawnHeight
    m.wnLogo.translation = [area[0] + (area[2] - drawnWidth) / 2, area[1] + area[3] - drawnHeight]
    m.wnLogo.visible = true
    m.wnTitle.visible = false
end sub

' A studio or network tile carries a wide logo rather than a poster, so it sits whole and
' smaller inside the card on a dark ground instead of being cropped to fill it
sub displayBrowseTileInfo(itemData as object, background = BROWSE_TILE_BACKGROUND as string)
    m.itemText.text = itemData.name
    ' The name already sits under the card, so the placeholder would only cover the logo
    showPosterText(false)

    ' Sizing and fit go on before the uri, since the load takes the mode it is given at the
    ' time and setting it after leaves the logo cropped to fill the card
    m.itemPoster.loadDisplayMode = "scaleToFit"
    m.itemPoster.width = m.cardWidth - (BROWSE_TILE_INSET * 2)
    m.itemPoster.height = m.backdrop.height - (BROWSE_TILE_INSET * 2)
    m.itemPoster.translation = [BROWSE_TILE_INSET, BROWSE_TILE_INSET]
    m.itemPoster.uri = itemData.posterURL
    m.posterMask.maskUri = ""
    m.posterMask.maskSize = [0, 0]
    m.backdrop.color = background
    m.backdrop.visible = true
end sub

' A card for a title outside the library carries a plain TMDB or Arr backdrop. A library item's
' backdropURL is the blurred page background, so it never stands in for the card's art.
function outsideCardBackdrop() as string
    if m.outsideCard <> true then return string.EMPTY
    return chainLookupReturn(m.top.itemContent, "backdropURL", string.EMPTY)
end function

' A browse tile sizes and grounds its own logo, so the poster handling that crops a poster
' to fill its card has to leave it alone
function isBrowseTile() as boolean
    itemType = LCase(chainLookupReturn(m.top.itemContent, "type", ""))
    if itemType = "studio" then return chainLookupReturn(m.top.itemContent, "json.MoonfinStudioLogo", false) = true

    return itemType = "seerrbrowse" or itemType = "seerrshortcut"
end function

' A studio Moonbase has a TMDB logo for shows it whole on a faint card. Any other studio shows
' its own art, or its name when it has none.
sub displayStudioInfo(itemData as object)
    if isBrowseTile()
        displayBrowseTileInfo(itemData, STUDIO_LOGO_TILE_BACKGROUND)
        return
    end if

    m.itemText.text = itemData.name
    ' A recycled cell may still be set up for a logo tile
    m.itemPoster.loadDisplayMode = "scaleToZoom"
    m.itemPoster.translation = [0, 0]
    if isValid(m.cardBackground) then m.backdrop.color = m.cardBackground
    if isValidAndNotEmpty(itemData.posterURL) or isValidAndNotEmpty(itemData.thumbnailURL) or isValidAndNotEmpty(itemData.widePosterURL)
        showCardArt(itemData)
        return
    end if

    setCardArt("")
    m.posterMask.visible = false
    m.backdrop.visible = true
    showPosterText(true)
end sub

sub displayCollectionInfo(itemData as object)
    m.itemText.text = itemData.name
    if isValidAndNotEmpty(itemData.iconUrl)
        m.itemIcon.uri = itemData.iconUrl
    end if

    ' A library's own art is wide with its name drawn in, which a poster card would crop, so the card
    ' shows the name instead, as Core does for that and for a library with no art
    json = itemData.json
    if m.cardImageType = "poster" and (not isValidAndNotEmpty(chainLookupReturn(json, "ImageTags.Primary", "")) or chainLookupReturn(json, "PrimaryImageAspectRatio", 0) >= 1)
        setCardArt("")
        m.posterMask.visible = false
        m.backdrop.visible = true
        m.itemIcon.visible = true
        showPosterText(true)
        return
    end if

    if isValidAndNotEmpty(itemData.widePosterURL)
        setCardArt(itemData.widePosterURL)
    else
        setCardArt(itemData.posterURL)
    end if
end sub

sub displayPhotoAlbumInfo(itemData as object)
    m.itemText.text = itemData.name
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displayPhotoInfo(itemData as object)
    m.itemText.text = itemData.name
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displaySeasonInfo(itemData as object)
    m.itemText.text = itemData.json.SeriesName
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displayTVChannelInfo(itemData as object)
    m.itemText.text = itemData.name
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displayAudioInfo(itemData as object)
    m.itemText.text = itemData.name
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displayAudioBookInfo(itemData as object)
    if itemData.PlayedPercentage > 0
        drawProgressBar(itemData)
    end if

    m.itemText.text = itemData.name
    setCardArt(ImageURL(itemData.LookupCI("id")))
end sub

sub displayMusicAlbumInfo(itemData as object)
    m.itemText.text = itemData.name
    setCardArt(itemData.posterURL)
end sub

sub displaySeriesInfo(itemData as object)
    m.itemText.text = itemData.name
    m.itemSubtext.text = productionYear(itemData)
    showCardArt(itemData)
end sub

sub displayBoxsetInfo(itemData as object)
    m.itemText.text = itemData.name
    showCardArt(itemData)
end sub

' A poster row leads with the primary image, a thumbnail row with the wide art and a banner row with
' the banner, or a title from outside the library with its plain backdrop, each falling back to the
' others. An episode's wide art is its own image, or its series' art unless Prefer Thumbnails is on.
sub showCardArt(itemData as object)
    wide = [itemData.LookupCI("thumbnailURL"), itemData.LookupCI("widePosterURL")]
    if isStringEqual(itemData.type, ItemType.EPISODE) and not prefersThumbnails() then wide.Reverse()
    poster = itemData.LookupCI("posterURL")
    imageType = m.cardImageType
    art = [poster]
    art.Append(wide)
    if isStringEqual(imageType, "thumb") or isStringEqual(imageType, "banner")
        art = wide
        art.push(poster)
        if isStringEqual(imageType, "banner")
            art.Unshift(outsideCardBackdrop())
            art.Unshift(itemData.LookupCI("bannerURL"))
        end if
    end if

    for each uri in art
        if isValidAndNotEmpty(uri)
            setCardArt(uri)
            return
        end if
    end for
end sub

sub setCardArt(uri as dynamic)
    m.artSource = uri
    m.itemPoster.uri = homeCards.SizedImageUrl(uri, Int(m.itemPoster.width), Int(m.itemPoster.height))
end sub

sub displayVideoInfo(itemData as object)
    m.itemText.text = itemData.name

    if itemData.PlayedPercentage > 0
        drawProgressBar(itemData)
    end if

    ' For videos, prioritize thumbnail first, then fall back to primary
    if isValidAndNotEmpty(itemData.thumbnailURL)
        setCardArt(itemData.thumbnailURL)
    else if isValidAndNotEmpty(itemData.posterURL)
        setCardArt(itemData.posterURL)
    end if
end sub

sub displayMovieInfo(itemData as object)
    m.itemText.text = itemData.name
    m.itemSubtext.text = productionYear(itemData)

    if itemData.PlayedPercentage > 0
        drawProgressBar(itemData)
    end if

    showCardArt(itemData)
end sub

sub displayProgramInfo(itemData as object)
    m.itemText.Text = itemData.json.name
    if itemData.usePoster then setCardArt(itemData.thumbnailURL) else setCardArt(ImageURL(itemData.json.ChannelId))
    m.itemPoster.loadDisplayMode = "scaleToFill"
end sub

sub displayEpisodeInfo(_localGlobal as object, itemData as object)
    if m.modernEnabled
        showModernEpisodeText(itemData)
    else
        showClassicEpisodeText(itemData)
    end if

    if isValid(itemData.LookupCI("PlayedPercentage"))
        if itemData.LookupCI("PlayedPercentage") > 0
            drawProgressBar(itemData)
        end if
    end if

    showCardArt(itemData)
end sub

' The series, then "S2:E5 - Episode Name". A recording with no series leads with its own name.
sub showClassicEpisodeText(itemData as object)
    json = itemData.json
    name = itemData.LookupCI("name") ?? ""
    episode = name
    if isValid(json) and isValid(json.ParentIndexNumber) and isValid(json.IndexNumber)
        episode = `S${json.ParentIndexNumber}:E${json.IndexNumber} - ${name}`
    end if

    seriesName = chainLookupReturn(json, "SeriesName", "")
    if seriesName = ""
        m.itemText.text = name
        if episode <> name then m.itemSubtext.text = episode
        return
    end if
    m.itemText.text = seriesName
    m.itemSubtext.text = episode
end sub

sub showModernEpisodeText(itemData as object)
    ' Format: "Show Name - S1E2 Episode Title"
    titleText = ""

    if isChainValid(itemData, "json.SeriesName")
        titleText = itemData.json.SeriesName
    end if

    episodeInfo = ""
    if isChainValid(itemData, "json.ParentIndexNumber")
        episodeInfo = "S" + StrI(itemData.json.ParentIndexNumber).trim()
    end if

    if isChainValid(itemData, "json.IndexNumber")
        episodeInfo = episodeInfo + "E" + StrI(itemData.json.IndexNumber).trim()
    end if

    if episodeInfo.len() > 0
        titleText = titleText + " - " + episodeInfo
    end if

    if isValidAndNotEmpty(itemData.LookupCI("name"))
        titleText = titleText + " " + itemData.LookupCI("name")
    end if

    m.itemText.text = titleText
end sub

function productionYear(itemData as object) as string
    year = chainLookupReturn(itemData.json, "ProductionYear", 0)
    if year > 0 then return year.toStr()
    return ""
end function

'
' Draws and animates item progress bar
sub drawProgressBar(itemData)
    m.itemProgressBackground.width = m.cardWidth - (PROGRESS_INSET * 2)
    m.itemProgressBackground.visible = true

    ' Drawn at its length rather than grown into it, since a row rebinds its cells as it
    ' scrolls and each one would otherwise replay the fill from nothing
    m.itemProgress.width = m.itemProgressBackground.width * (itemData.PlayedPercentage / 100)
end sub

' An anime episode or movie carries one marker pill over its artwork. It rides on the
' poster so it fades with it when a modern row hands the cell over to the focused card.
sub showAnimeMarker(marker as dynamic)
    m.animeCardPill = drawAnimeCardPill(m.animeCardPill, m.itemPoster, marker, m.itemPoster.width, m.itemPoster.height, m.animeAboveProgress)
    if isValid(m.posterLabels) and m.posterLabels.visible then m.posterLabels.frame = posterLabelSpots()
end sub

sub showIncompleteRecording(entry as dynamic)
    m.incompleteBadge = drawIncompleteBadge(m.incompleteBadge, m.itemPoster, entry, incompleteBadgeSpot(m.playedIndicator))
    if isValid(m.posterLabels) and m.posterLabels.visible then m.posterLabels.frame = posterLabelSpots()
end sub

' The admin's labels ride on the poster with the anime pill, so they fade with it too
sub showPosterLabels(entries as dynamic)
    if not isValid(entries) and not isValid(m.posterLabels) then return
    m.posterLabels = drawPosterLabels(m.posterLabels, m.itemPoster, entries, posterLabelSpots(), POSTER_LABEL_CARD_SCALE)
end sub

' Clear of the heart and the Incomplete badge, the tick or count, and the progress bar and anime pill
function posterLabelSpots() as object
    height = m.itemPoster.height
    topLeft = incompleteBadgeSpot(m.playedIndicator)[1]
    if isValid(m.incompleteBadge) then topLeft = posterLabelsBelow(m.incompleteBadge, m.incompleteBadge.badgeHeight, topLeft)

    bottom = POSTER_LABEL_EDGE
    if m.animeAboveProgress then bottom = ANIME_CARD_PILL_ABOVE_PROGRESS

    return posterLabelFrame(m.itemPoster.width, height, topLeft, posterLabelsBelowCheckmark(m.playedIndicator), posterLabelsAbove(m.animeCardPill, height, bottom), bottom)
end function

'
' Enable title scrolling based on item Focus
sub focusChanged()
    if not isValid(m.initCooldownPeriod) then init()

    currentTime = UpTime(0)

    ' Block ALL animations during initialization cooldown
    timeSinceInit = currentTime - m.initTime
    if timeSinceInit < m.initCooldownPeriod
        m.itemText.repeatCount = m.top.itemHasFocus ? - 1 : 0
        m.itemSubtext.repeatCount = m.itemText.repeatCount
        return
    end if

    timeSinceLastChange = currentTime - m.lastFocusChangeTime

    ' Detect rapid focus oscillation (multiple changes within 200ms)
    if timeSinceLastChange < 0.2
        m.focusChangeCount++
        if m.focusChangeCount >= 2
            m.isInOscillation = true
        end if
    else
        ' Reset counter if enough time has passed
        m.focusChangeCount = 0
        if m.isInOscillation
            ' Exiting oscillation - save the stable state
            m.lastStableFocusState = m.top.itemHasFocus
        end if
        m.isInOscillation = false
    end if

    m.lastFocusChangeTime = currentTime

    ' Always update text scrolling
    m.itemText.repeatCount = m.top.itemHasFocus ? - 1 : 0
    m.itemSubtext.repeatCount = m.itemText.repeatCount

    ' Set scale animation center point
    if isValid(m.scaleGroup)
        m.scaleGroup.scaleRotateCenter = [90, 158]
    end if

    ' Only animate if NOT in oscillation
    if not m.isInOscillation
        ' Save stable state before animating
        m.lastStableFocusState = m.top.itemHasFocus
    end if
    ' During oscillation, do nothing - keep whatever scale we had from last stable state
    ' This prevents the visual bounce
end sub

' The scene sets modernShift on the focused row's item content nodes so the
' cells after the focused one slide right, opening room for the landscape card.
sub setupModernShiftObserver(itemData as object)
    if isValid(m.modernObservedNode)
        m.modernObservedNode.unobserveFieldScoped("modernShift")
    end if
    if not itemData.hasField("modernShift") then itemData.addField("modernShift", "float", false)
    itemData.observeFieldScoped("modernShift", "onModernShiftChanged")
    m.modernObservedNode = itemData

    ' Apply the current shift instantly (no slide) when the cell is (re)bound
    shift = itemData.modernShift
    if not isValid(shift) then shift = 0
    if shift = -1 then shift = 0
    if isValid(m.scaleGroup) then m.scaleGroup.translation = [shift, 0]
end sub

sub onModernShiftChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) or not isValid(m.scaleGroup) then return

    shift = itemData.modernShift
    if not isValid(shift) then shift = 0

    if isValid(m.modernShiftAnim) and isValid(m.modernShiftInterp)
        m.modernShiftAnim.control = "stop"
        m.modernShiftInterp.keyValue = [m.scaleGroup.translation, [shift, 0]]

        targetOpacity = shift = -1 ? 0.0 : 1.0
        m.modernShiftPosterOpacity.keyValue = [m.itemPoster.opacity, targetOpacity]
        m.modernShiftTextOpacity.keyValue = [m.itemText.opacity, targetOpacity]

        m.modernShiftAnim.control = "start"
    else
        m.scaleGroup.translation = [shift, 0]
    end if
end sub

'Hide backdrop and icon when poster loaded
sub onPosterLoadStatusChanged()
    if m.itemPoster.loadStatus = PosterLoadStatus.FAILED
        thisItemType = chainLookupReturn(m.top.itemContent, "json.type", string.EMPTY)

        ' If loading the album poster image failed, try loading the artist image
        if isStringEqual(thisItemType, ItemType.MUSICALBUM)
            params = {
                tag: m.top.itemContent.json.parentbackdropimagetags,
                maxHeight: 261,
                maxWidth: 261
            }
            artistPrimaryImageURL = ImageURL(m.top.itemContent.json.parentbackdropitemid, "Primary", params)

            ' Check if we've already tried to fall back to the artist image
            if isStringEqual(m.artSource, artistPrimaryImageURL) then return

            setCardArt(artistPrimaryImageURL)
            return
        end if

        ' If loading the episode poster image failed, try loading the series image
        if isStringEqual(thisItemType, ItemType.EPISODE)
            params = {
                tag: m.top.itemContent.json.parentbackdropimagetags,
                maxHeight: 261,
                maxWidth: 261
            }
            seriesPrimaryImageURL = ImageURL(m.top.itemContent.json.parentbackdropitemid, "Primary", params)

            ' Check if we've already tried to fall back to the series image
            if isStringEqual(m.artSource, seriesPrimaryImageURL) then return

            setCardArt(seriesPrimaryImageURL)
            return
        end if

        failedUri = m.artSource
        posterUri = m.top.itemContent.posterURL

        ' The wide art failed, so a card from outside the library tries its plain backdrop
        ' next, and anything else goes to its poster
        if isStringEqual(failedUri, m.top.itemContent.widePosterURL) or isStringEqual(failedUri, m.top.itemContent.thumbnailURL) or isStringEqual(failedUri, m.top.itemContent.LookupCI("bannerURL"))
            backdropUri = outsideCardBackdrop()
            if backdropUri <> "" and not isStringEqual(failedUri, backdropUri)
                setCardArt(backdropUri)
                return
            end if
            if not isStringEqual(failedUri, posterUri)
                setCardArt(posterUri)
                return
            end if
        end if

        ' That backdrop failed as well, which leaves the poster
        if isStringEqual(failedUri, outsideCardBackdrop()) and not isStringEqual(failedUri, posterUri)
            setCardArt(posterUri)
            return
        end if

        ' Nothing left to fall back to, so this drops through to the not ready handling
    end if

    if isBrowseTile() then return

    if m.itemPoster.loadStatus = PosterLoadStatus.READY and m.itemPoster.uri <> string.EMPTY
        m.backdrop.visible = false
        m.itemIcon.visible = false
        showPosterText(false)

        ' Each mask is stretched to the card, so the one nearest its shape keeps the corners round
        posterW = m.itemPoster.width
        posterH = m.itemPoster.height
        mask = "pkg:/images/posterWideMask.webp"
        if posterW < posterH then mask = "pkg:/images/posterVertMask.webp"
        if posterW = posterH then mask = "pkg:/images/posterSquareMask.webp"
        if posterW > posterH * 3 then mask = "pkg:/images/posterBannerMask.webp"
        m.posterMask.maskUri = mask
        m.posterMask.maskSize = [posterW, posterH]
    else
        ' Still loading, or out of fallbacks, so the name stands in for the artwork
        m.backdrop.visible = true
        m.itemIcon.visible = true
        showPosterText(true)
    end if
end sub

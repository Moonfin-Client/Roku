import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const PANEL_HEIGHT = 500
const PANEL_FILL = "0x101218FF"
const PILL_HEIGHT = 28
const PILL_PADDING = 9
' The overview's lines sit 30 apart, half again its 20 size
const OVERVIEW_LINE = 30

sub init()
    m.shadow = m.top.findNode("shadow")
    m.fill = m.top.findNode("fill")
    m.art = m.top.findNode("art")
    m.backdrop = m.top.findNode("backdrop")
    m.border = m.top.findNode("border")
    m.details = m.top.findNode("details")
    m.title = m.top.findNode("title")
    m.episode = m.top.findNode("episode")
    m.info = m.top.findNode("info")
    m.ratings = m.top.findNode("ratings")
    m.pills = m.top.findNode("pills")
    m.overview = m.top.findNode("overview")
    themeApply.ApplyToItem(m.top)
    ' Read after the theme has swapped them
    m.infoFont = m.top.findNode("infoFont").font
    m.pillFont = m.top.findNode("pillFont").font
end sub

sub onFlatChanged()
    if not m.top.flat then return
    m.top.findNode("artMask").maskUri = ""
    m.art.clippingRect = [-4000, -4000, 8000, 8000]
    ' Scaled down, the art bleeds a pixel past the scrim's edges, so it's kept inside them. At the
    ' foot it would show under the panel's edge, so it stops a little higher there.
    m.backdrop.translation = [0, 1]
    m.backdrop.height = PANEL_HEIGHT - 4
    m.backdrop.loadHeight = PANEL_HEIGHT
end sub

sub draw(params as object)
    hasArt = isValidAndNotEmpty(params.backdrop)
    m.shadow.visible = hasArt
    m.art.visible = hasArt
    ' With no backdrop the panel is left empty and a little see-through, so it reads as a frame
    if hasArt
        m.fill.blendColor = PANEL_FILL
        m.fill.opacity = 1
        m.border.opacity = 0.08
        if m.backdrop.uri <> params.backdrop then m.backdrop.uri = params.backdrop
    else
        m.fill.blendColor = "0xFFFFFFFF"
        m.fill.opacity = 0.06
        m.border.opacity = 0.12
        m.backdrop.uri = ""
    end if

    y = fitLines(m.title, params.title ?? "", 2, invalid)

    m.episode.text = params.episode ?? ""
    m.episode.visible = m.episode.text <> ""
    if m.episode.visible
        y += 10
        m.episode.translation = [0, y]
        y += m.episode.boundingRect().height
    end if

    m.info.removeChildrenIndex(m.info.getChildCount(), 0)
    parts = params.info ?? []
    for i = 0 to parts.count() - 1
        if i > 0 then m.info.appendChild(textLabel("•", "0xFFFFFF73"))
        if parts[i].pill = true
            m.info.appendChild(pill(parts[i].text))
        else
            m.info.appendChild(textLabel(parts[i].text, "0xFFFFFFD6"))
        end if
    end for
    y = placeLine(m.info, y, 14)

    ratings = params.ratings
    if isValid(ratings)
        m.ratings.showNames = ratings.showNames = true
        m.ratings.showBadges = ratings.showBadges <> false
    end if
    m.ratings.ratingsData = ratings
    if m.ratings.visible
        y += 16
        m.ratings.translation = [0, y]
        y += m.ratings.boundingRect().height
    end if

    m.pills.removeChildrenIndex(m.pills.getChildCount(), 0)
    for each label in params.pills ?? []
        m.pills.appendChild(pill(label))
    end for
    y = placeLine(m.pills, y, 12)

    m.overview.visible = isValidAndNotEmpty(params.overview)
    if m.overview.visible
        y += 20
        m.overview.translation = [0, y]
        y += fitLines(m.overview, params.overview, 3, OVERVIEW_LINE)
    end if

    m.details.translation = [72, Int((PANEL_HEIGHT - y) / 2)]
end sub

' Measured with no height against one line, then given the room its lines take, since a wrapped
' label with no height can draw only its first line. Lines sit lineStep apart, or as the font sets
' them when that's invalid.
function fitLines(label as object, text as string, maxLines as integer, lineStep as dynamic) as float
    label.height = 0
    label.lineSpacing = 0
    label.text = "A"
    lineHeight = label.boundingRect().height
    label.text = text
    lines = Int(label.boundingRect().height / lineHeight + 0.5)
    if lines < 1 then lines = 1
    if lines > maxLines then lines = maxLines
    if not isValid(lineStep) then lineStep = lineHeight
    label.lineSpacing = lineStep - lineHeight
    label.height = lines * lineStep
    return label.height
end function

' Puts a line of the details under the last one, or leaves it out when it holds nothing
function placeLine(line as object, y as float, gap as integer) as float
    line.visible = line.getChildCount() > 0
    if not line.visible then return y
    line.translation = [0, y + gap]
    return y + gap + line.boundingRect().height
end function

function textLabel(text as string, color as string) as object
    label = createObject("roSGNode", "Label")
    label.font = m.infoFont
    label.color = color
    label.text = text
    return label
end function

' A translucent rounded tag with a faint ring, as the media pills and the age rating are drawn
function pill(text as string) as object
    group = createObject("roSGNode", "Group")
    fill = group.createChild("Poster")
    fill.uri = "pkg:/images/details/badgefill6.9.png"
    fill.opacity = 0.08
    ring = group.createChild("Poster")
    ring.uri = "pkg:/images/details/outline6.9.png"
    ring.opacity = 0.35
    label = group.createChild("Label")
    label.font = m.pillFont
    label.color = "0xFFFFFFFF"
    label.text = text
    width = label.boundingRect().width + PILL_PADDING * 2
    label.translation = [PILL_PADDING, 0]
    label.height = PILL_HEIGHT
    label.vertAlign = "center"
    for each poster in [fill, ring]
        poster.width = width
        poster.height = PILL_HEIGHT
    end for
    return group
end function

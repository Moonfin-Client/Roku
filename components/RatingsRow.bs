import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

const RATING_ICON_GAP = 7
const RATING_BADGE_PAD_H = 12
const RATING_BADGE_PAD_V = 6
const RATING_BADGE_FILL = "0x000000"
const RATING_BADGE_OPACITY = 0.45
const RATING_NAME_GAP = 2

sub init()
    m.ratingsLayout = m.top.findNode("ratingsLayout")
end sub

sub onRatingsDataChanged()
    ratingsData = m.top.ratingsData

    m.ratingsLayout.removeChildrenIndex(m.ratingsLayout.getChildCount(), 0)

    if not isValid(ratingsData)
        m.top.visible = false
        return
    end if

    displayRatings = ratingsData.data
    if not isValidAndNotEmpty(displayRatings)
        m.top.visible = false
        return
    end if

    m.ratingsLayout.itemSpacings = [m.top.ratingSpacing]

    for each rating in displayRatings
        m.ratingsLayout.appendChild(buildRating(rating))
    end for

    m.top.visible = true
end sub

' Each rating reads as the icon and the score together, with the source named underneath
function buildRating(rating as object) as object
    stack = createObject("roSGNode", "LayoutGroup")
    stack.layoutDirection = "vert"
    stack.horizAlignment = "left"
    stack.itemSpacings = [RATING_NAME_GAP]

    top = stack.createChild("LayoutGroup")
    top.layoutDirection = "horiz"
    top.vertAlignment = "center"
    top.itemSpacings = [RATING_ICON_GAP]

    addIcon(top, rating)

    formatted = rating.formatted ?? ""
    if formatted <> ""
        value = top.createChild("Label")
        value.text = formatted
        value.font = m.top.valueFont
        value.font.size = m.top.valueSize
        value.color = m.top.labelColor
    end if

    if m.top.showNames
        sourceName = rating.name ?? ""
        if sourceName <> ""
            nameLabel = stack.createChild("Label")
            nameLabel.text = sourceName
            nameLabel.font = m.top.labelFont
            nameLabel.font.size = m.top.nameSize
            nameLabel.color = m.top.labelColor
        end if
    end if

    if not m.top.showBadges then return stack

    return inBadge(stack)
end function

sub addIcon(row as object, rating as object)
    iconPath = rating.iconPath ?? ""
    if iconPath = "" then return

    iconHeight = m.top.iconHeight
    icon = row.createChild("Poster")
    icon.uri = iconPath
    icon.height = iconHeight
    ' The IMDb mark is a wordmark rather than a square, so it gets the room for it
    icon.width = isStringEqual(rating.source ?? "", "imdb") ? iconHeight * 2 : iconHeight
    icon.loadDisplayMode = "scaleToFit"

    blend = rating.iconBlendColor ?? ""
    if blend <> "" then icon.blendColor = blend
end sub

' A scrim behind each rating so a score stays readable over a bright backdrop
function inBadge(stack as object) as object
    bounds = stack.boundingRect()

    badge = createObject("roSGNode", "Group")
    fill = badge.createChild("Poster")
    fill.uri = "pkg:/images/details/badgefill6.9.png"
    fill.blendColor = RATING_BADGE_FILL
    fill.opacity = RATING_BADGE_OPACITY
    fill.width = bounds.width + (RATING_BADGE_PAD_H * 2)
    fill.height = bounds.height + (RATING_BADGE_PAD_V * 2)

    stack.translation = [RATING_BADGE_PAD_H, RATING_BADGE_PAD_V]
    badge.appendChild(stack)

    return badge
end function

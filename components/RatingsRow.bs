import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

const RATING_ICON_GAP = 7
const RATING_BADGE_PAD_H = 12
const RATING_BADGE_PAD_V = 6
const RATING_BADGE_FILL = "0x000000"
const RATING_BADGE_OPACITY = 0.45
const RATING_NAME_GAP = 2
const SINGLE_LINE_GAP = 8
const SINGLE_LINE_HEIGHT = 40
const SINGLE_LINE_NAME_COLOR = "#FFFFFFB3"
' The strip in columns shows seven sources at most, each padded in from its hairlines
const COLUMNS_MAX = 7
const COLUMN_PAD = 6
const COLUMN_NAME_GAP = 4.5

sub init()
    m.ratingsLayout = m.top.findNode("ratingsLayout")
end sub

sub onRatingsDataChanged()
    ratingsData = m.top.ratingsData

    m.ratingsLayout.removeChildrenIndex(m.ratingsLayout.getChildCount(), 0)

    if not isValid(ratingsData)
        m.top.visible = false
        return
    end if

    displayRatings = ratingsData.data
    if not isValidAndNotEmpty(displayRatings)
        m.top.visible = false
        return
    end if

    if m.top.columns
        m.ratingsLayout.appendChild(buildColumns(displayRatings))
        m.top.visible = true
        return
    end if

    m.ratingsLayout.itemSpacings = [m.top.ratingSpacing]

    for each rating in displayRatings
        m.ratingsLayout.appendChild(buildRating(rating))
    end for

    fitToMaxWidth()
    m.top.visible = true
end sub

sub fitToMaxWidth()
    maxWidth = m.top.maxWidth
    if maxWidth <= 0 then return

    fit = 1.0
    width = m.ratingsLayout.boundingRect().width
    if width > maxWidth then fit = maxWidth / width
    m.top.scale = [fit, fit]
end sub

' Each rating reads as the icon and the score together, with the source named underneath
function buildRating(rating as object) as object
    stack = createObject("roSGNode", "LayoutGroup")
    stack.layoutDirection = "vert"
    stack.horizAlignment = "left"
    stack.itemSpacings = [RATING_NAME_GAP]

    top = stack.createChild("LayoutGroup")
    top.layoutDirection = "horiz"
    top.vertAlignment = "center"
    top.itemSpacings = [m.top.singleLine ? SINGLE_LINE_GAP : RATING_ICON_GAP]

    addIcon(top, rating)

    formatted = rating.formatted ?? ""
    if formatted <> ""
        value = top.createChild("Label")
        value.text = formatted
        value.font = m.top.valueFont
        value.font.size = m.top.valueSize
        value.color = m.top.labelColor
    end if

    if m.top.showNames
        sourceName = rating.name ?? ""
        if sourceName <> ""
            if m.top.singleLine
                nameLabel = top.createChild("Label")
                nameLabel.color = SINGLE_LINE_NAME_COLOR
            else
                nameLabel = stack.createChild("Label")
                nameLabel.color = m.top.labelColor
            end if
            nameLabel.text = sourceName
            nameLabel.font = m.top.labelFont
            nameLabel.font.size = m.top.nameSize
        end if
    end if

    if m.top.singleLine then return onChip(stack)
    if not m.top.showBadges then return stack

    return inBadge(stack)
end function

sub addIcon(row as object, rating as object)
    iconPath = rating.iconPath ?? ""
    if iconPath = "" then return

    iconHeight = m.top.iconHeight
    icon = row.createChild("Poster")
    icon.uri = iconPath
    icon.height = iconHeight
    ' The IMDb mark is a wordmark rather than a square, so it gets the room for it
    icon.width = isStringEqual(rating.source ?? "", "imdb") ? iconHeight * 2 : iconHeight
    icon.loadDisplayMode = "scaleToFit"

    blend = rating.iconBlendColor ?? ""
    if blend <> "" then icon.blendColor = blend
end sub

' A scrim behind each rating so a score stays readable over a bright backdrop
function inBadge(stack as object) as object
    bounds = stack.boundingRect()

    badge = createObject("roSGNode", "Group")
    fill = badge.createChild("Poster")
    fill.uri = "pkg:/images/details/badgefill6.9.png"
    fill.blendColor = RATING_BADGE_FILL
    fill.opacity = RATING_BADGE_OPACITY
    fill.width = bounds.width + (RATING_BADGE_PAD_H * 2)
    fill.height = bounds.height + (RATING_BADGE_PAD_V * 2)

    stack.translation = [RATING_BADGE_PAD_H, RATING_BADGE_PAD_V]
    badge.appendChild(stack)

    return badge
end function

' A single line chip keeps its height with badges off too, so the scores sit level on the row
function onChip(stack as object) as object
    bounds = stack.boundingRect()

    chip = createObject("roSGNode", "Group")
    padding = 0
    if m.top.showBadges
        fill = chip.createChild("Poster")
        fill.uri = "pkg:/images/details/surface8.9.png"
        fill.blendColor = RATING_BADGE_FILL
        fill.opacity = RATING_BADGE_OPACITY
        fill.width = bounds.width + (RATING_BADGE_PAD_H * 2)
        fill.height = SINGLE_LINE_HEIGHT
        padding = RATING_BADGE_PAD_H
    end if

    stack.translation = [padding, (SINGLE_LINE_HEIGHT - bounds.height) / 2 - bounds.y]
    chip.appendChild(stack)

    return chip
end function

' One column per source sharing the strip's width, with its name in capitals over its score and a
' hairline between each. The names always show, whatever the setting says, since nothing else tells
' the columns apart.
function buildColumns(ratings as object) as object
    strip = createObject("roSGNode", "Group")
    count = ratings.count()
    if count > COLUMNS_MAX then count = COLUMNS_MAX
    columnWidth = m.top.columnsWidth / count

    for i = 0 to count - 1
        rating = ratings[i]
        x = i * columnWidth
        if i > 0
            line = strip.createChild("Rectangle")
            line.color = "#FFFFFF24"
            line.translation = [x, 0]
            line.width = 1.5
            line.height = m.top.columnsHeight
        end if

        nameLabel = strip.createChild("Label")
        nameLabel.font = m.top.labelFont
        nameLabel.font.size = m.top.nameSize
        nameLabel.color = "#FFFFFF99"
        nameLabel.text = UCase(rating.name ?? "")
        value = strip.createChild("Label")
        value.font = m.top.valueFont
        value.font.size = m.top.valueSize
        value.color = "#FFFFFFEB"
        value.text = rating.formatted ?? ""

        nameHeight = nameLabel.boundingRect().height
        valueHeight = value.boundingRect().height
        top = (m.top.columnsHeight - nameHeight - COLUMN_NAME_GAP - valueHeight) / 2
        for each label in [nameLabel, value]
            label.horizAlign = "center"
            label.width = columnWidth - COLUMN_PAD * 2
        end for
        nameLabel.translation = [x + COLUMN_PAD, top]
        value.translation = [x + COLUMN_PAD, top + nameHeight + COLUMN_NAME_GAP]
    end for
    return strip
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- A text box on the sign in screens, white with an accent edge while it has the remote -->
<component name="LoginTextField" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/login/fill20.9.png" width="893" blendColor="#FFFFFF14" />
    <Poster id="border" uri="pkg:/images/login/stroke20w1.9.png" width="893" blendColor="#FFFFFF1A" />
    <Label id="text" translation="[27, 0]" width="839" vertAlign="center" font="font:MediumSystemFont" />
  </children>
  <interface>
    <field id="placeholder" type="string" onChange="draw" />
    <field id="value" type="string" onChange="draw" />
    <field id="secure" type="boolean" onChange="draw" />
    <field id="highlighted" type="boolean" onChange="draw" />
    <field id="width" type="float" value="893" onChange="draw" />
    <!-- Grows by the border's width while focused -->
    <field id="height" type="float" value="88" />
  </interface>
</component>

import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.profileImage = m.top.findNode("profileImage")
    m.profileImage.observeField("loadStatus", "onPosterLoadStatusChanged")
    m.avatarRing = m.top.findNode("avatarRing")
    m.placeholder = m.top.findNode("placeholder")
    m.profileName = m.top.findNode("profileName")
    m.scaleGroup = m.top.findNode("scaleGroup")

    m.placeholder.font.uri = settingsGlyphs.FONT_URI
    m.placeholder.font.size = 53
    m.placeholder.text = settingsGlyphs.Char("person")
    m.profileName.font.size = 23
end sub

' Without a picture the person glyph shows through
sub onPosterLoadStatusChanged()
    if m.profileImage.loadStatus <> PosterLoadStatus.LOADING
        m.profileImage.unobserveField("loadStatus")
    end if
    if isStringEqual(m.profileImage.loadStatus, PosterLoadStatus.FAILED)
        m.profileImage.uri = ""
        m.placeholder.visible = true
    end if
end sub

' The focused tile grows, rings its picture and pushes the name down to clear the ring
sub onFocusChanged()
    if not isValid(m.top.itemContent) then return

    focused = m.top.itemHasFocus
    m.avatarRing.visible = focused
    if focused
        m.profileName.color = "#00A4DC"
        m.profileName.translation = [13, 152]
        m.scaleGroup.scale = [1.08, 1.08]
    else
        m.profileName.color = "#FFFFFF"
        m.profileName.translation = [13, 147]
        m.scaleGroup.scale = [1.0, 1.0]
    end if
end sub

sub itemContentChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    m.profileName.text = itemData.name
    m.profileImage.uri = itemData.imageURL ?? ""
    m.placeholder.visible = m.profileImage.uri = ""
end sub

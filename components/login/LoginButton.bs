import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const LOGIN_BUTTON_ICON_GAP = 13

sub init()
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.ring = m.top.findNode("ring")
    m.icon = m.top.findNode("icon")
    m.label = m.top.findNode("label")
    m.icon.font.uri = settingsGlyphs.FONT_URI
    m.icon.font.size = 30
    layout()
end sub

sub layout()
    radius = m.top.radius.toStr()
    m.fill.uri = `pkg:/images/login/fill${radius}.9.png`
    m.border.uri = `pkg:/images/login/stroke${radius}w1.9.png`

    if m.top.bold
        m.label.font = "font:SmallBoldSystemFont"
    else
        m.label.font = "font:SmallSystemFont"
    end if
    m.label.font.size = m.top.fontSize
    m.label.text = m.top.text
    m.label.width = 0
    textWidth = m.label.boundingRect().width

    hasIcon = m.top.iconGlyph <> ""
    m.icon.visible = hasIcon
    iconWidth = 0
    if hasIcon
        m.icon.text = settingsGlyphs.Char(m.top.iconGlyph)
        iconWidth = 30 + LOGIN_BUTTON_ICON_GAP
    end if

    width = m.top.width
    if width <= 0 then width = textWidth + iconWidth + m.top.padding * 2
    height = m.top.height
    m.top.drawnWidth = width

    for each layer in [m.fill, m.border, m.ring]
        layer.width = width
        layer.height = height
    end for

    contentLeft = (width - textWidth - iconWidth) / 2
    m.icon.translation = [contentLeft, 0]
    m.icon.height = height
    m.label.translation = [contentLeft + iconWidth, 0]
    m.label.height = height
    restyle()
end sub

sub restyle()
    focused = m.top.highlighted
    style = m.top.style
    fill = "#00000000"
    border = "#00000000"
    ring = ""
    textColor = "#FFFFFF"

    if style = "primary"
        fill = loginStyle.ACCENT_HEX
        textColor = loginStyle.ON_ACCENT
        if focused then ring = "#FFFFFF"
        if not m.top.enabled then fill = "#00A4DC8C"
    else if style = "ghost"
        fill = "#FFFFFF0F"
        textColor = "#FFFFFFE6"
        if focused then ring = loginStyle.ACCENT_HEX
    else if style = "selected"
        fill = loginStyle.ACCENT_HEX
        if focused
            border = "#FFFFFF"
            ring = "#FFFFFF"
        end if
    else if style = "danger"
        border = "#F8717173"
        textColor = "#FCA5A5"
        if focused
            fill = "#F871711F"
            border = "#F87171"
            ring = "#F87171"
        end if
    else if style = "text"
        textColor = loginStyle.ACCENT_HEX
        if focused then fill = "#00A4DC1A"
    else
        border = "#FFFFFF33"
        textColor = "#FFFFFFCC"
        if focused
            border = loginStyle.ACCENT_HEX
            ring = loginStyle.ACCENT_HEX
            textColor = loginStyle.ACCENT_HEX
        end if
    end if

    m.fill.blendColor = fill
    m.border.blendColor = border
    m.ring.visible = ring <> ""
    if ring <> ""
        m.ring.uri = `pkg:/images/login/stroke${m.top.radius.toStr()}w3.9.png`
        m.ring.blendColor = ring
    end if
    m.label.color = textColor
    m.icon.color = textColor
    m.top.opacity = 1.0
    if not m.top.enabled and style <> "primary" then m.top.opacity = 0.5
end sub

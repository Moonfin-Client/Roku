import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/tvKeyboard.bs"

const ADD_SERVER_PANEL_WIDTH = 868
const ADD_SERVER_PAD = 38
const ADD_SERVER_ROUND = 67
const ADD_SERVER_FIELD = 88
const ADD_SERVER_FIELD_FOCUSED = 94

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelBorder = m.top.findNode("panelBorder")
    m.backButton = m.top.findNode("backButton")
    m.closeButton = m.top.findNode("closeButton")
    m.badge = m.top.findNode("badge")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.chooseStep = m.top.findNode("chooseStep")
    m.addressStep = m.top.findNode("addressStep")
    m.foundStep = m.top.findNode("foundStep")
    m.addressChoice = m.top.findNode("addressChoice")
    m.embyChoice = m.top.findNode("embyChoice")
    m.fieldLabel = m.top.findNode("fieldLabel")
    m.field = m.top.findNode("field")
    m.fieldFill = m.top.findNode("fieldFill")
    m.fieldBorder = m.top.findNode("fieldBorder")
    m.fieldGlyph = m.top.findNode("fieldGlyph")
    m.fieldText = m.top.findNode("fieldText")
    m.connectButton = m.top.findNode("connectButton")
    m.connectSpinner = m.top.findNode("connectSpinner")
    m.hint = m.top.findNode("hint")
    m.notice = m.top.findNode("notice")
    m.noticeDetail = m.top.findNode("noticeDetail")
    m.otherButton = m.top.findNode("otherButton")
    m.continueButton = m.top.findNode("continueButton")

    for each glyph in [["backGlyph", "arrow_back", 30], ["closeGlyph", "close", 30], ["badgeGlyph", "check", 30], ["fieldGlyph", "language", 30], ["noticeGlyph", "error", 33]]
        node = m.top.findNode(glyph[0])
        node.font.uri = settingsGlyphs.FONT_URI
        node.font.size = glyph[2]
        node.text = settingsGlyphs.Char(glyph[1])
    end for

    m.title.font.size = 37
    m.subtitle.font.size = 23
    m.fieldLabel.font.size = 20
    m.fieldLabel.text = tr("Server Address")
    m.fieldText.font.size = 27
    m.hint.font.size = 20
    m.top.findNode("noticeTitle").font.size = 23
    m.top.findNode("noticeTitle").text = tr("Unable to connect to server")
    m.noticeDetail.font.size = 22
    m.top.findNode("foundName").font.size = 30
    m.top.findNode("kindChip").font.size = 20
    m.top.findNode("versionChip").font.size = 20
    m.top.findNode("foundAddress").font.size = 22
    m.top.findNode("foundNote").font.size = 23
    m.top.findNode("foundNote").text = tr("Continue to choose who's signing in.")

    m.addressChoice.title = tr("Server Address")
    m.addressChoice.detail = tr("Jellyfin or Emby on your network or online")
    m.embyChoice.title = tr("Emby Connect")
    m.embyChoice.detail = tr("Sign in with your Emby Connect account")
    m.connectButton.text = tr("Connect")
    m.otherButton.text = tr("Use a different address")
    m.continueButton.text = tr("Continue")
    m.connectSpinner.poster.width = 30
    m.connectSpinner.poster.height = 30

    m.address = ""
    m.focusId = ""
    onConnectingChanged()
end sub

' Starts over at the choice, with nothing typed
sub open()
    m.address = ""
    m.top.noticeText = ""
    m.top.connecting = false
    showStep("choose")
    m.top.setFocus(true)
end sub

sub showStep(stepName as string)
    m.stepName = stepName
    m.chooseStep.visible = stepName = "choose"
    m.addressStep.visible = stepName = "address"
    m.foundStep.visible = stepName = "found"
    m.backButton.visible = stepName = "address"
    m.closeButton.visible = stepName <> "found"
    m.badge.visible = stepName = "found"

    if stepName = "choose"
        m.title.text = tr("Add Server")
        m.subtitle.text = tr("Choose how you'd like to connect.")
        m.subtitle.visible = true
        focusOn("addressChoice")
    else if stepName = "address"
        m.title.text = tr("Connect to Server")
        m.subtitle.text = tr("The same address you'd open in a browser, including the port.")
        m.subtitle.visible = true
        focusOn("field")
    else
        m.title.text = tr("Server found")
        m.subtitle.visible = false
        focusOn("continue")
    end if
    layout()
end sub

sub layout()
    headingLeft = ADD_SERVER_PAD
    if m.backButton.visible then headingLeft += ADD_SERVER_ROUND + 20
    headingRight = ADD_SERVER_PANEL_WIDTH - ADD_SERVER_PAD
    if m.closeButton.visible then headingRight -= ADD_SERVER_ROUND + 20

    if m.stepName = "found"
        m.title.translation = [ADD_SERVER_PAD + 47 + 17, 39]
        m.title.width = 0
        layoutFound()
        return
    end if

    m.title.translation = [headingLeft, 45]
    m.title.width = headingRight - headingLeft
    m.subtitle.translation = [headingLeft, 100]
    m.subtitle.width = headingRight - headingLeft
    headerBottom = 100 + m.subtitle.boundingRect().height

    if m.stepName = "choose"
        setPanelHeight(308 + 126 + ADD_SERVER_PAD)
        return
    end if

    y = headerBottom + 30
    m.fieldLabel.translation = [ADD_SERVER_PAD, y]
    y += 33 + 13
    fieldHeight = ADD_SERVER_FIELD
    if m.focusId = "field" then fieldHeight = ADD_SERVER_FIELD_FOCUSED
    m.field.translation = [ADD_SERVER_PAD, y]
    for each layer in [m.fieldFill, m.fieldBorder]
        layer.height = fieldHeight
    end for
    m.fieldGlyph.height = fieldHeight
    m.fieldText.height = fieldHeight
    y += fieldHeight + 20
    m.connectButton.translation = [ADD_SERVER_PAD, y]
    m.connectSpinner.translation = [ADD_SERVER_PAD + 380, y + 25]
    y += 80 + 17
    m.hint.translation = [ADD_SERVER_PAD, y]
    y += 28

    m.notice.visible = m.top.noticeText <> ""
    if m.notice.visible
        y += 23
        m.notice.translation = [ADD_SERVER_PAD, y]
        m.noticeDetail.text = m.top.noticeText
        noticeHeight = 52 + m.noticeDetail.boundingRect().height + 18
        m.top.findNode("noticeFill").height = noticeHeight
        m.top.findNode("noticeBorder").height = noticeHeight
        y += noticeHeight
    end if
    setPanelHeight(y + ADD_SERVER_PAD)
end sub

sub layoutFound()
    continueLeft = ADD_SERVER_PANEL_WIDTH - ADD_SERVER_PAD - m.continueButton.drawnWidth
    m.continueButton.translation = [continueLeft, 396]
    m.otherButton.translation = [continueLeft - 17 - m.otherButton.drawnWidth, 396]
    setPanelHeight(396 + 80 + ADD_SERVER_PAD)
end sub

sub setPanelHeight(height as float)
    m.panelFill.height = height
    m.panelBorder.height = height
    m.panel.translation = [(1920 - ADD_SERVER_PANEL_WIDTH) / 2, (1080 - height) / 2]
end sub

sub onFoundServerChanged()
    found = m.top.foundServer
    if not isValid(found) then return

    emby = found.serverType = "emby"
    tile = m.top.findNode("brandTile")
    mark = m.top.findNode("brandMark")
    if emby
        tile.blendColor = "#52B54B24"
        mark.uri = "pkg:/images/login/emby.webp"
        mark.blendColor = "#7BD175"
    else
        tile.blendColor = "#AA5CC329"
        mark.uri = "pkg:/images/login/jellyfin.webp"
        mark.blendColor = "#C88BE0"
    end if
    m.top.findNode("foundName").text = found.name ?? ""
    m.top.findNode("foundAddress").text = found.url ?? ""

    kind = m.top.findNode("kindChip")
    kind.text = emby ? tr("Emby") : tr("Jellyfin")
    version = m.top.findNode("versionChip")
    version.text = substitute(tr("Version {0}"), found.version ?? "")
    version.visible = isValidAndNotEmpty(found.version)
    m.top.findNode("versionChipFill").visible = version.visible
    x = 0
    for each chip in [[kind, m.top.findNode("kindChipFill")], [version, m.top.findNode("versionChipFill")]]
        chip[0].width = 0
        textWidth = chip[0].boundingRect().width
        chip[1].translation = [x, 0]
        chip[1].width = textWidth + 33
        chip[0].translation = [x + 17, 0]
        x += textWidth + 33 + 10
    end for

    m.top.connecting = false
    showStep("found")
end sub

sub onConnectingChanged()
    connecting = m.top.connecting
    m.connectSpinner.visible = connecting
    m.connectButton.enabled = not connecting
    if connecting
        m.connectButton.text = ""
        m.hint.text = substitute(tr("Checking {0}"), m.address)
    else
        m.connectButton.text = tr("Connect")
        m.hint.text = tr("Works with Jellyfin and Emby.")
    end if
    m.backButton.opacity = connecting ? 0.5 : 1.0
end sub

sub onNoticeChanged()
    if m.stepName <> "address" then return
    if m.top.noticeText <> "" then focusOn("connect")
    layout()
end sub

' What has the remote, drawn the way that piece looks while it does
sub focusOn(id as string)
    m.focusId = id
    m.addressChoice.highlighted = id = "addressChoice"
    m.embyChoice.highlighted = id = "embyChoice"
    m.connectButton.highlighted = id = "connect"
    m.otherButton.highlighted = id = "other"
    m.continueButton.highlighted = id = "continue"
    m.top.findNode("backRing").visible = id = "back"
    m.top.findNode("closeRing").visible = id = "close"
    drawField()
    if m.stepName = "address" then layout()
end sub

sub drawField()
    focused = m.focusId = "field"
    hasText = m.address <> ""
    m.fieldText.text = hasText ? m.address : "https://your-server.example.com"

    if focused
        m.fieldFill.blendColor = "#FFFFFF"
        m.fieldBorder.uri = "pkg:/images/login/stroke27w4.9.png"
        m.fieldBorder.blendColor = loginStyle.ACCENT_HEX
        m.fieldGlyph.color = "#000000"
        m.fieldText.color = hasText ? "#000000" : "#00000080"
    else
        m.fieldFill.blendColor = "#FFFFFF14"
        m.fieldBorder.uri = "pkg:/images/login/stroke27w1.9.png"
        m.fieldBorder.blendColor = "#FFFFFF1F"
        m.fieldGlyph.color = "#FFFFFF"
        m.fieldText.color = hasText ? "#FFFFFF" : "#FFFFFF80"
    end if
end sub

sub openKeyboard()
    m.keyboard = tvKeyboard.Open(m.top.getScene(), {
        title: tr("Enter the server name or ip address"),
        text: m.address,
        chips: tvKeyboard.AddressChips()
    })
    m.keyboard.observeField("submitted", "onKeyboardSubmitted")
    m.keyboard.observeField("cancelled", "onKeyboardClosed")
end sub

' Done on the keyboard connects straight away
sub onKeyboardSubmitted(event as object)
    m.address = event.getRoSGNode().text.Trim()
    onKeyboardClosed(event)
    drawField()
    connect()
end sub

sub onKeyboardClosed(_event as object)
    tvKeyboard.Release(m.keyboard, ["submitted", "cancelled"])
    m.keyboard = invalid
end sub

sub connect()
    if m.address = "" or m.top.connecting then return
    m.top.noticeText = ""
    m.top.connecting = true
    m.top.connectAddress = m.address
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return true

    if key = KeyCode.BACK
        if m.stepName = "found"
            showAddressAgain()
        else if m.stepName = "address"
            if not m.top.connecting then showStep("choose")
        else
            m.top.closed = true
        end if
        return true
    end if

    if m.stepName = "choose" then return chooseKey(key)
    if m.stepName = "address" then return addressKey(key)
    return foundKey(key)
end function

function chooseKey(key as string) as boolean
    if key = KeyCode.UP
        if m.focusId = "embyChoice" then focusOn("addressChoice") else focusOn("close")
    else if key = KeyCode.DOWN
        if m.focusId = "close" then focusOn("addressChoice") else focusOn("embyChoice")
    else if key = KeyCode.OK
        if m.focusId = "close"
            m.top.closed = true
        else if m.focusId = "addressChoice"
            showStep("address")
        else
            m.top.embyConnectChosen = true
        end if
    end if
    return true
end function

function addressKey(key as string) as boolean
    id = m.focusId
    if key = KeyCode.UP
        if id = "field"
            focusOn("back")
        else if id = "connect"
            focusOn("field")
        end if
    else if key = KeyCode.DOWN
        if id = "back" or id = "close"
            focusOn("field")
        else if id = "field"
            focusOn("connect")
        end if
    else if key = KeyCode.LEFT
        if id = "close" then focusOn("back")
    else if key = KeyCode.RIGHT
        if id = "back" then focusOn("close")
    else if key = KeyCode.OK
        if id = "field"
            if not m.top.connecting then openKeyboard()
        else if id = "connect"
            connect()
        else if id = "back"
            if not m.top.connecting then showStep("choose")
        else if id = "close"
            m.top.closed = true
        end if
    end if
    return true
end function

function foundKey(key as string) as boolean
    if key = KeyCode.LEFT
        focusOn("other")
    else if key = KeyCode.RIGHT
        focusOn("continue")
    else if key = KeyCode.OK
        if m.focusId = "continue"
            m.top.continueChosen = true
        else
            showAddressAgain()
        end if
    end if
    return true
end function

' The address stays as typed, without the notice from before
sub showAddressAgain()
    m.top.noticeText = ""
    showStep("address")
end sub

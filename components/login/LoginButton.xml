<?xml version="1.0" encoding="utf-8"?>
<!-- The buttons on the server, account and sign in screens. The style picks the look:
     primary, ghost, outline, selected, switcher, danger or text. -->
<component name="LoginButton" extends="Group">
  <children>
    <Poster id="glow" visible="false" />
    <Poster id="fill" />
    <Poster id="border" />
    <Poster id="ring" visible="false" />
    <Label id="icon" vertAlign="center" />
    <Label id="label" vertAlign="center" />
  </children>
  <interface>
    <field id="text" type="string" onChange="layout" />
    <field id="style" type="string" value="outline" onChange="layout" />
    <!-- 0 sizes the button to its label -->
    <field id="width" type="float" value="0" onChange="layout" />
    <field id="height" type="float" value="66" onChange="layout" />
    <field id="radius" type="integer" value="13" onChange="layout" />
    <field id="padding" type="float" value="30" onChange="layout" />
    <field id="fontSize" type="integer" value="23" onChange="layout" />
    <field id="bold" type="boolean" value="false" onChange="layout" />
    <field id="iconGlyph" type="string" value="" onChange="layout" />
    <field id="highlighted" type="boolean" onChange="restyle" />
    <field id="enabled" type="boolean" value="true" onChange="restyle" />
    <!-- How wide it came out, for whoever lines buttons up -->
    <field id="drawnWidth" type="float" value="0" />
  </interface>
</component>

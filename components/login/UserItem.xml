<?xml version="1.0" encoding="utf-8"?>
<component name="UserItem" extends="Group">
  <children>
    <!-- Holds the tile at its full width, so the row spaces tiles evenly -->
    <Rectangle width="210" height="200" color="#00000000" />
    <!-- Scaling about the tile center keeps the card in place as it grows -->
    <Group id="scaleGroup" scaleRotateCenter="[105, 100]">
      <Poster id="avatarRing" width="130" height="130" translation="[40, 8]" uri="pkg:/images/login/ring130w5.webp" blendColor="#00A4DC" visible="false" />
      <Poster id="avatarBg" width="120" height="120" translation="[45, 13]" uri="pkg:/images/icons/circle.webp" blendColor="#FFFFFF1A" />
      <Label id="placeholder" width="120" height="120" translation="[45, 13]" horizAlign="center" vertAlign="center" color="#FFFFFF99" />
      <MaskGroup maskUri="pkg:/images/icons/circle.webp" maskSize="[120, 120]" translation="[45, 13]">
        <Poster id="profileImage" width="120" height="120" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="profileName" horizAlign="center" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFF" height="33" width="184" translation="[13, 147]" />
    </Group>
  </children>
  <interface>
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
    <field id="itemContent" type="node" onChange="itemContentChanged" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="UserItem" extends="Group">
  <children>
    <!-- Scaling about the tile centre keeps the card in place as it grows -->
    <Group id="scaleGroup" scaleRotateCenter="[110, 100]">
      <LayoutGroup layoutDirection="vert" horizAlignment="center" translation="[110, 0]" itemSpacings="[16]">
        <Group id="avatarContainer">
          <Poster id="avatarRing"
            width="144"
            height="144"
            uri="pkg:/images/icons/circle.png"
            loadDisplayMode="scaleToFit"
            blendColor="0x6B728099" />

          <Poster id="avatarBg"
            width="132"
            height="132"
            translation="[6, 6]"
            uri="pkg:/images/icons/circle.png"
            loadDisplayMode="scaleToFit"
            blendColor="0x1F2937FF" />

          <MaskGroup maskUri="pkg:/images/icons/circle.png" maskSize="[132, 132]" translation="[6, 6]">
            <Poster id="profileImage"
              width="132"
              height="132"
              loadDisplayMode="scaleToZoom" />
          </MaskGroup>
        </Group>

        <Label id="profileName"
          horizAlign="center"
          vertAlign="center"
          font="font:TinyBoldSystemFont"
          color="0xD1D5DBFF"
          height="30"
          width="220" />
      </LayoutGroup>
    </Group>
  </children>
  <interface>
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" alwaysNotify="true" />
    <field id="itemContent" type="node" onChange="itemContentChanged" />
  </interface>
</component>

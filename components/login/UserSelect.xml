<?xml version="1.0" encoding="utf-8"?>
<component name="UserSelect" extends="JFScreen">
  <children>
    <Poster
      id="background"
      uri="pkg:/images/bg_login_gradient.png"
      width="1920"
      height="1080"
      translation="[0, 0]" />

    <Rectangle translation="[710, 70]" width="500" height="113" color="0x00000000">
      <Poster
        id="logo"
        uri="pkg:/images/logo.png"
        width="500"
        height="113" />
    </Rectangle>

    <Poster
      id="userSelectionGroup"
      translation="[360, 215]"
      width="1200"
      height="580"
      uri="pkg:/images/surface.9.png">

      <Label id="serverName"
        horizAlign="center"
        width="1200"
        height="35"
        font="font:TinySystemFont"
        color="0x9CA3AFFF"
        translation="[0, 60]" />

      <Label id="whoWatching"
        text="Who's watching?"
        horizAlign="center"
        width="1200"
        height="35"
        font="font:MediumBoldSystemFont"
        color="0xFFFFFFFF"
        translation="[0, 100]" />

      <Group id="userRowContainer" translation="[40, 190]" clippingRect="[0, 0, 1120, 260]">
        <UserRow id="userRow" translation="[0, 0]" />
      </Group>

      <StandardButton
        id="addUser"
        text="Add User"
        height="84"
        width="548"
        translation="[40, 440]"
        fontSize="30"
        outline="true"
        outlineUri="pkg:/images/playback/outline41.9.png"
        iconUri="pkg:/images/baseline_person_white_48dp.png" />

      <StandardButton
        id="changeServer"
        text="Select Server"
        height="84"
        width="548"
        translation="[612, 440]"
        fontSize="30"
        outline="true"
        outlineUri="pkg:/images/playback/outline41.9.png"
        iconUri="pkg:/images/icons/home.png" />
    </Poster>
  </children>
  <interface>
    <field id="changeServer" type="boolean" alwaysNotify="true" />
    <field id="itemContent" type="array" onChange="itemContentChanged" />
  </interface>
</component>

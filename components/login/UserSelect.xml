<?xml version="1.0" encoding="utf-8"?>
<!-- Who's watching: the server's accounts, then Add User and Select Server -->
<component name="UserSelect" extends="JFScreen">
  <children>
    <Poster id="background" uri="pkg:/images/bg_login_gradient.webp" width="1920" height="1080" />
    <!-- Takes the remote off the tiles while a button has it, since the screen can't take it back from its own children -->
    <Group id="buttonFocus" focusable="true" />
    <Poster id="logo" uri="pkg:/images/logo.webp" width="592" height="134" translation="[664, 0]" />
    <Group id="card" translation="[376, 0]">
      <Poster id="cardFill" uri="pkg:/images/login/fill33.9.png" width="1169" blendColor="#111528CC" />
      <Poster id="cardBorder" uri="pkg:/images/login/stroke33w1.9.png" width="1169" blendColor="#FFFFFF33" />
      <Label id="serverName" translation="[54, 54]" width="1060" height="33" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
      <Label id="whoWatching" translation="[54, 114]" width="1060" height="33" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFF" />
      <Group id="userRowContainer" translation="[54, 187]" clippingRect="[-30, -20, 1120, 257]">
        <UserRow id="userRow" />
      </Group>
      <LoginButton id="addUser" translation="[54, 444]" width="520" height="67" radius="13" padding="38" iconGlyph="person" />
      <LoginButton id="changeServer" translation="[594, 444]" width="520" height="67" radius="13" padding="38" iconGlyph="home" />
    </Group>
  </children>
  <interface>
    <field id="changeServer" type="boolean" alwaysNotify="true" />
    <field id="addUserSelected" type="boolean" alwaysNotify="true" />
    <field id="itemContent" type="array" onChange="itemContentChanged" />
  </interface>
</component>

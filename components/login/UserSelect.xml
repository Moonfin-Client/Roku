<?xml version="1.0" encoding="utf-8"?>
<!-- Who's watching: the server's accounts in a carousel, then Add User and Select Server -->
<component name="UserSelect" extends="JFScreen">
  <children>
    <Poster id="background" uri="pkg:/images/bg_login_gradient.webp" width="1920" height="1080" />
    <!-- Takes the remote off the carousel while a button has it, since the screen can't take it back from its own children -->
    <Group id="buttonFocus" focusable="true" />
    <Poster id="logo" uri="pkg:/images/logo.webp" width="296" height="67" translation="[97, 63]" />
    <Label id="serverIcon" color="#FFFFFFA6" />
    <Label id="serverName" font="font:SmallSystemFont" color="#FFFFFFA6" />
    <Label id="whoWatching" translation="[97, 240]" width="1726" horizAlign="center" font="font:MediumSystemFont" color="#FFFFFFB3" />
    <ProfileCarousel id="carousel" translation="[0, 330]" />
    <LoginButton id="addUser" height="72" radius="36" padding="33" fontSize="25" iconGlyph="person" />
    <LoginButton id="changeServer" height="72" radius="36" padding="33" fontSize="25" iconGlyph="home" />
  </children>
  <interface>
    <field id="changeServer" type="boolean" alwaysNotify="true" />
    <field id="addUserSelected" type="boolean" alwaysNotify="true" />
    <!-- The picked account's name -->
    <field id="userSelected" type="string" alwaysNotify="true" />
    <field id="itemContent" type="array" onChange="itemContentChanged" />
  </interface>
</component>

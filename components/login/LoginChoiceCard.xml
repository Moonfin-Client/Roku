<?xml version="1.0" encoding="utf-8"?>
<!-- One way to add a server on the Add Server dialog's first step -->
<component name="LoginChoiceCard" extends="Group">
  <children>
    <Group id="body" scaleRotateCenter="[395, 63]">
      <Poster id="glow" uri="pkg:/images/login/stroke35w5.9.png" width="800" height="136" translation="[-5, -5]" blendColor="#00A4DC59" visible="false" />
      <Poster id="fill" uri="pkg:/images/login/fill30.9.png" width="790" height="126" blendColor="#FFFFFF09" />
      <Poster id="border" uri="pkg:/images/login/stroke30w1.9.png" width="790" height="126" blendColor="#FFFFFF12" />
      <Poster id="tile" uri="pkg:/images/login/fill23.9.png" width="80" height="80" translation="[22, 23]" />
      <Label id="glyph" width="80" height="80" translation="[22, 23]" horizAlign="center" vertAlign="center" />
      <Poster id="mark" width="40" height="40" translation="[42, 43]" visible="false" />
      <Label id="title" translation="[125, 29]" width="566" height="34" vertAlign="center" font="font:SmallBoldSystemFont" color="#FFFFFFF2" />
      <Label id="detail" translation="[125, 67]" width="566" height="30" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFF99" />
      <Poster id="arrowFill" uri="pkg:/images/icons/circle.webp" width="53" height="53" translation="[715, 36]" blendColor="#FFFFFF0F" />
      <Label id="arrow" width="53" height="53" translation="[715, 36]" horizAlign="center" vertAlign="center" color="#FFFFFF99" />
    </Group>
  </children>
  <interface>
    <field id="title" type="string" alias="title.text" />
    <field id="detail" type="string" alias="detail.text" />
    <!-- A Material glyph, or a brand mark when markUri is set -->
    <field id="glyph" type="string" onChange="onGlyphChanged" />
    <field id="markUri" type="string" onChange="onGlyphChanged" />
    <field id="tint" type="string" value="#00A4DC" onChange="onGlyphChanged" />
    <field id="tileColor" type="string" value="#00A4DC24" onChange="onGlyphChanged" />
    <field id="highlighted" type="boolean" onChange="onHighlightedChanged" />
  </interface>
</component>

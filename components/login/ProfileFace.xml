<?xml version="1.0" encoding="utf-8"?>
<!-- One profile in the hero carousel: the picture, or the initial on the user's color behind it -->
<component name="ProfileFace" extends="Group">
  <children>
    <Group id="body">
      <Poster id="initialBg" uri="pkg:/images/icons/circle.webp" width="280" height="280" />
      <Label id="initial" width="280" height="280" horizAlign="center" vertAlign="center" color="#FFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="120" />
      </Label>
    </Group>
    <ScreenMask id="mask" maskUri="pkg:/images/icons/circle.webp">
      <Poster id="image" loadWidth="280" loadHeight="280" loadDisplayMode="scaleToZoom" />
    </ScreenMask>
    <Group id="badge" visible="false">
      <Poster uri="pkg:/images/icons/circle.webp" width="48" height="48" blendColor="#10131F" />
      <Poster id="badgeFill" uri="pkg:/images/icons/circle.webp" width="42" height="42" translation="[3, 3]" />
      <Label id="badgeGlyph" width="42" height="42" translation="[3, 3]" horizAlign="center" vertAlign="center" />
    </Group>
  </children>
  <interface>
    <!-- { id, name, imageURL, badge: "active" or "pin" } -->
    <field id="itemContent" type="assocarray" onChange="itemContentChanged" />
    <field id="size" type="float" value="280" onChange="resize" />
  </interface>
</component>

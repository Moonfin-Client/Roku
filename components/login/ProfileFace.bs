import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/profileCarousel.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const FACE_SIZE = 280
' Where the badge's top-left sits at full size: on the picture's bottom-right edge, clear of the ring
const FACE_BADGE_AT = 203

sub init()
    m.body = m.top.findNode("body")
    m.initialBg = m.top.findNode("initialBg")
    m.initial = m.top.findNode("initial")
    m.mask = m.top.findNode("mask")
    m.image = m.top.findNode("image")
    m.image.observeField("loadStatus", "onImageStatus")
    m.badge = m.top.findNode("badge")
    m.badgeFill = m.top.findNode("badgeFill")
    m.badgeGlyph = m.top.findNode("badgeGlyph")
    m.badgeGlyph.font.uri = settingsGlyphs.FONT_URI
    m.badgeGlyph.font.size = 26

    ' A MaskGroup's mask is in screen pixels, which a 720p Roku doesn't scale with the layout
    width = CreateObject("roDeviceInfo").GetUIResolution().width
    m.maskScale = 1.0
    if isValid(width) and width < 1920 then m.maskScale = width / 1920
    resize()
end sub

sub itemContentChanged()
    item = m.top.itemContent
    if not isValid(item) then return

    m.initial.text = profileCarousel.Initial(item.name ?? "")
    m.initialBg.blendColor = profileCarousel.InitialsColor(item.id ?? "")
    m.image.uri = item.imageURL ?? ""

    badge = item.badge ?? ""
    m.badge.visible = badge <> ""
    if badge = "active"
        m.badgeFill.blendColor = loginStyle.ACCENT_HEX
        m.badgeGlyph.color = "#04131A"
        m.badgeGlyph.text = settingsGlyphs.Char("check")
    else if badge = "pin"
        m.badgeFill.blendColor = "#1C2238"
        m.badgeGlyph.color = "#FFFFFF"
        m.badgeGlyph.text = settingsGlyphs.Char("lock_outline")
    end if
end sub

' The initial only stands in until a picture loads, so a see-through picture shows what's behind it
sub onImageStatus()
    m.body.visible = m.image.loadStatus <> PosterLoadStatus.READY
end sub

' The picture is sized outright and the rest scaled, since a scaled MaskGroup keeps its mask's size
sub resize()
    size = m.top.size
    scale = size / FACE_SIZE
    m.body.scale = [scale, scale]
    m.badge.scale = [scale, scale]
    m.badge.translation = [FACE_BADGE_AT * scale, FACE_BADGE_AT * scale]
    m.image.width = size
    m.image.height = size
    m.mask.maskSize = [size * m.maskScale, size * m.maskScale]
end sub

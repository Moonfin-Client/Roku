import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.body = m.top.findNode("body")
    m.glow = m.top.findNode("glow")
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.arrowFill = m.top.findNode("arrowFill")
    m.arrow = m.top.findNode("arrow")
    m.glyph = m.top.findNode("glyph")
    m.mark = m.top.findNode("mark")

    m.glyph.font.uri = settingsGlyphs.FONT_URI
    m.glyph.font.size = 40
    m.arrow.font.uri = settingsGlyphs.FONT_URI
    m.arrow.font.size = 27
    m.arrow.text = settingsGlyphs.Char("arrow_forward")
    m.top.findNode("title").font.size = 27
    m.top.findNode("detail").font.size = 22
end sub

sub onGlyphChanged()
    m.top.findNode("tile").blendColor = m.top.tileColor
    m.mark.visible = m.top.markUri <> ""
    m.glyph.visible = not m.mark.visible
    if m.mark.visible
        m.mark.uri = m.top.markUri
        m.mark.blendColor = m.top.tint
    else
        m.glyph.text = settingsGlyphs.Char(m.top.glyph)
        m.glyph.color = m.top.tint
    end if
end sub

sub onHighlightedChanged()
    focused = m.top.highlighted
    m.glow.visible = focused
    if focused
        m.body.scale = [1.02, 1.02]
        m.fill.blendColor = "#00A4DC1F"
        m.border.blendColor = loginStyle.ACCENT_HEX
        m.arrowFill.blendColor = loginStyle.ACCENT_HEX
        m.arrow.color = loginStyle.ON_ACCENT
    else
        m.body.scale = [1, 1]
        m.fill.blendColor = "#FFFFFF09"
        m.border.blendColor = "#FFFFFF12"
        m.arrowFill.blendColor = "#FFFFFF0F"
        m.arrow.color = "#FFFFFF99"
    end if
end sub

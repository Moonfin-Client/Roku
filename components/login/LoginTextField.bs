import "pkg:/source/utils/loginStyle.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.text = m.top.findNode("text")
    m.text.font.size = 27
    draw()
end sub

sub draw()
    focused = m.top.highlighted
    height = 88
    if focused then height = 94
    m.top.height = height
    m.fill.width = m.top.width
    m.border.width = m.top.width
    m.text.width = m.top.width - 54
    m.fill.height = height
    m.border.height = height
    m.text.height = height

    value = m.top.value
    hasText = value <> ""
    if hasText and m.top.secure
        dots = ""
        for i = 1 to Len(value)
            dots += "•"
        end for
        value = dots
    end if
    m.text.text = hasText ? value : m.top.placeholder

    if focused
        m.fill.blendColor = "#FFFFFF"
        m.border.uri = "pkg:/images/login/stroke20w4.9.png"
        m.border.blendColor = loginStyle.ACCENT_HEX
        m.text.color = hasText ? "#000000" : "#00000080"
    else
        m.fill.blendColor = "#FFFFFF14"
        m.border.uri = "pkg:/images/login/stroke20w1.9.png"
        m.border.blendColor = "#FFFFFF1A"
        m.text.color = hasText ? "#FFFFFF" : "#FFFFFF80"
    end if
end sub

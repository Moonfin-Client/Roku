<?xml version="1.0" encoding="utf-8"?>
<!-- Add Server: a choice between an address, a Plex account and Emby Connect, then the address, then
     the server that answered before anyone signs in -->
<component name="AddServerDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#05071099" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/login/fill40.9.png" width="868" blendColor="#1D2130F0" />
      <Poster id="panelBorder" uri="pkg:/images/login/stroke40w1.9.png" width="868" blendColor="#FFFFFF33" />

      <Group id="backButton" translation="[38, 38]">
        <Poster id="backFill" uri="pkg:/images/icons/circle.webp" width="67" height="67" blendColor="#FFFFFF12" />
        <Poster id="backRing" uri="pkg:/images/login/ring67w3.webp" width="67" height="67" blendColor="#00A4DC" visible="false" />
        <Label id="backGlyph" width="67" height="67" horizAlign="center" vertAlign="center" color="#FFFFFFE6" />
      </Group>
      <Group id="closeButton" translation="[763, 38]">
        <Poster id="closeFill" uri="pkg:/images/icons/circle.webp" width="67" height="67" blendColor="#FFFFFF12" />
        <Poster id="closeRing" uri="pkg:/images/login/ring67w3.webp" width="67" height="67" blendColor="#00A4DC" visible="false" />
        <Label id="closeGlyph" width="67" height="67" horizAlign="center" vertAlign="center" color="#FFFFFFE6" />
      </Group>
      <Group id="badge" translation="[38, 39]">
        <Poster uri="pkg:/images/icons/circle.webp" width="47" height="47" blendColor="#34D39929" />
        <Label id="badgeGlyph" width="47" height="47" horizAlign="center" vertAlign="center" color="#5EE0AE" />
      </Group>
      <Label id="title" height="48" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFFF5" />
      <Label id="subtitle" wrap="true" lineSpacing="4" font="font:SmallSystemFont" color="#FFFFFF9E" />

      <Group id="chooseStep">
        <LoginChoiceCard id="addressChoice" translation="[38, 166]" glyph="language" />
        <LoginChoiceCard id="plexChoice" translation="[38, 308]" tint="#F2BC45" tileColor="#E5A00D24" markUri="pkg:/images/login/plex.webp" />
        <LoginChoiceCard id="embyChoice" translation="[38, 450]" tint="#7BD175" tileColor="#52B54B24" markUri="pkg:/images/login/emby.webp" />
      </Group>

      <Group id="addressStep">
        <Label id="fieldLabel" translation="[38, 195]" height="33" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF99" />
        <Group id="field" translation="[38, 241]">
          <Poster id="fieldFill" uri="pkg:/images/login/fill27.9.png" width="790" />
          <Poster id="fieldBorder" uri="pkg:/images/login/stroke27w1.9.png" width="790" />
          <Label id="fieldGlyph" width="30" translation="[28, 0]" vertAlign="center" />
          <Label id="fieldText" width="694" translation="[70, 0]" vertAlign="center" font="font:MediumSystemFont" />
        </Group>
        <LoginButton id="connectButton" style="primary" width="790" height="80" radius="23" fontSize="25" bold="true" />
        <Spinner id="connectSpinner" visible="false" />
        <Label id="hint" width="790" height="28" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFF80" />
        <Group id="notice">
          <Poster id="noticeFill" uri="pkg:/images/login/fill23.9.png" width="790" blendColor="#EF44441A" />
          <Poster id="noticeBorder" uri="pkg:/images/login/stroke23w1.9.png" width="790" blendColor="#EF44444D" />
          <Label id="noticeGlyph" translation="[18, 18]" width="33" height="33" horizAlign="center" vertAlign="center" color="#FFB4B4" />
          <Label id="noticeTitle" translation="[71, 18]" width="697" height="30" vertAlign="center" font="font:SmallBoldSystemFont" color="#FFB4B4" />
          <Label id="noticeDetail" translation="[71, 52]" width="697" wrap="true" font="font:SmallSystemFont" color="#FFB4B4D9" />
        </Group>
      </Group>

      <Group id="foundStep">
        <Group id="serverCard" translation="[38, 117]">
          <Poster uri="pkg:/images/login/fill30.9.png" width="790" height="189" blendColor="#FFFFFF0A" />
          <Poster uri="pkg:/images/login/stroke30w1.9.png" width="790" height="189" blendColor="#FFFFFF17" />
          <Poster id="brandTile" uri="pkg:/images/login/fill27.9.png" width="94" height="94" translation="[26, 48]" />
          <Poster id="brandMark" width="50" height="50" translation="[48, 70]" />
          <Label id="foundName" translation="[143, 26]" width="620" height="38" vertAlign="center" font="font:MediumBoldSystemFont" color="#FFFFFFF5" />
          <Group id="chips" translation="[143, 69]">
            <Poster id="kindChipFill" uri="pkg:/images/login/fill20.9.png" height="46" blendColor="#FFFFFF12" />
            <Label id="kindChip" height="46" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFFD9" />
            <Poster id="versionChipFill" uri="pkg:/images/login/fill20.9.png" height="46" blendColor="#FFFFFF12" />
            <Label id="versionChip" height="46" vertAlign="center" font="font:SmallestSystemFont" color="#FFFFFFD9" />
          </Group>
          <Label id="foundAddress" translation="[143, 131]" width="620" height="33" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFF8C" />
        </Group>
        <Label id="foundNote" translation="[38, 330]" width="790" height="33" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFF9E" />
        <LoginButton id="otherButton" style="ghost" height="80" radius="23" fontSize="25" />
        <LoginButton id="continueButton" style="primary" height="80" radius="23" fontSize="25" bold="true" />
      </Group>
    </Group>
  </children>
  <interface>
    <!-- What the viewer asked for. The screen answers through the fields below them. -->
    <field id="connectAddress" type="string" alwaysNotify="true" />
    <field id="embyConnectChosen" type="boolean" alwaysNotify="true" />
    <field id="plexChosen" type="boolean" alwaysNotify="true" />
    <field id="continueChosen" type="boolean" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />

    <field id="connecting" type="boolean" onChange="onConnectingChanged" />
    <!-- Why the address didn't work, or "" -->
    <field id="noticeText" type="string" alwaysNotify="true" onChange="onNoticeChanged" />
    <!-- name, serverType, version and url of the server that answered -->
    <field id="foundServer" type="assocarray" onChange="onFoundServerChanged" />
    <function name="open" />
  </interface>
</component>

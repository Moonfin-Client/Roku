<?xml version="1.0" encoding="utf-8"?>
<!-- A saved or discovered server on the server list -->
<component name="LoginServerTile" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/login/fill20.9.png" width="1060" height="112" blendColor="#FFFFFF0D" />
    <Poster id="border" uri="pkg:/images/login/stroke20w3.9.png" width="1060" height="112" blendColor="#00A4DC" visible="false" />
    <Poster id="mark" width="40" height="40" translation="[27, 36]" blendColor="#FFFFFFB3" />
    <Label id="name" translation="[87, 22]" width="946" height="34" vertAlign="center" font="font:SmallBoldSystemFont" color="#FFFFFFE6" />
    <Label id="detail" translation="[87, 55]" width="946" height="34" vertAlign="center" font="font:SmallSystemFont" color="#FFFFFF80" />
  </children>
  <interface>
    <field id="title" type="string" alias="name.text" />
    <field id="detailText" type="string" alias="detail.text" />
    <field id="serverType" type="string" onChange="onServerTypeChanged" />
    <field id="highlighted" type="boolean" onChange="onHighlightedChanged" />
    <!-- Where the server lives and whether it was saved, for whoever opens it -->
    <field id="baseUrl" type="string" />
    <field id="isSaved" type="boolean" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A question with Cancel and one other answer, asked before removing something -->
<component name="LoginAlertDialog" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="#0000008A" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/login/fill27.9.png" width="468" blendColor="#1A1A1A" />
      <Label id="title" translation="[40, 40]" width="388" height="53" vertAlign="center" font="font:MediumSystemFont" color="#FFFFFF" />
      <Label id="message" translation="[40, 120]" width="388" wrap="true" font="font:SmallSystemFont" color="#FFFFFF" />
      <LoginButton id="cancelButton" style="text" height="67" radius="33" padding="20" />
      <LoginButton id="confirmButton" style="text" height="67" radius="33" padding="20" />
    </Group>
  </children>
  <interface>
    <field id="title" type="string" alias="title.text" />
    <field id="message" type="string" alias="message.text" />
    <field id="confirmLabel" type="string" />
    <!-- true for the confirm answer, false for Cancel or Back -->
    <field id="answer" type="boolean" alwaysNotify="true" />
    <function name="show" />
  </interface>
</component>

import "pkg:/source/enums/KeyCode.bs"

const LOGIN_ALERT_WIDTH = 468

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.titleLabel = m.top.findNode("title")
    m.messageLabel = m.top.findNode("message")
    m.cancelButton = m.top.findNode("cancelButton")
    m.confirmButton = m.top.findNode("confirmButton")
    m.titleLabel.font.size = 40
    m.messageLabel.font.size = 23
    m.cancelButton.text = tr("Cancel")
end sub

' Lays the dialog out for what it says, with Cancel focused
sub show()
    m.confirmButton.text = m.top.confirmLabel
    messageHeight = m.messageLabel.boundingRect().height
    buttonsTop = 120 + messageHeight + 40
    right = LOGIN_ALERT_WIDTH - 40
    m.confirmButton.translation = [right - m.confirmButton.drawnWidth, buttonsTop]
    m.cancelButton.translation = [right - m.confirmButton.drawnWidth - 13 - m.cancelButton.drawnWidth, buttonsTop]
    height = buttonsTop + 67 + 40
    m.panelFill.height = height
    m.panel.translation = [(1920 - LOGIN_ALERT_WIDTH) / 2, (1080 - height) / 2]
    highlight(false)
    m.top.visible = true
    m.top.setFocus(true)
end sub

sub highlight(confirm as boolean)
    m.confirmFocused = confirm
    m.confirmButton.highlighted = confirm
    m.cancelButton.highlighted = not confirm
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return true
    if key = KeyCode.RIGHT
        highlight(true)
    else if key = KeyCode.LEFT
        highlight(false)
    else if key = KeyCode.OK
        m.top.answer = m.confirmFocused
    else if key = KeyCode.BACK
        m.top.answer = false
    end if
    return true
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- The hero carousel Who's watching and the user switcher share. It takes the remote itself:
     Left and Right move the selection, OK picks it, and Up and Down go to the screen around it. -->
<component name="ProfileCarousel" extends="Group">
  <children>
    <Group id="faces" />
    <Poster id="ring" uri="pkg:/images/login/ring217w5.webp" width="308" height="308" translation="[806, 0]" blendColor="#FFFFFF40" />
    <Label id="name" translation="[97, 341]" width="1726" height="72" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="#FFFFFF" />
    <Group id="lines" />
    <Group id="dots" />
    <Animation id="slide" duration="0.22" easeFunction="outCubic">
      <FloatFieldInterpolator id="slideInterp" key="[0.0, 1.0]" />
    </Animation>
  </children>
  <interface>
    <!-- { id, name, imageURL, badge: "active" or "pin", lines: [{ text, color, lock }] } -->
    <field id="items" type="array" onChange="itemsChanged" />
    <!-- Set before items to start somewhere other than the first -->
    <field id="selected" type="integer" value="0" />
    <field id="activated" type="integer" alwaysNotify="true" />
    <!-- Where the slide has got to, between the old selection and the new one -->
    <field id="position" type="float" onChange="layoutFaces" />
  </interface>
</component>

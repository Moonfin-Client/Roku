import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const USER_SELECT_RIGHT = 1823
const USER_SELECT_TOP_TEXT_Y = 79
const USER_SELECT_BUTTONS_Y = 945
const USER_SELECT_BUTTON_GAP = 20

sub init()
    m.top.optionsAvailable = false

    m.carousel = m.top.findNode("carousel")
    m.carousel.observeField("activated", "onActivated")
    m.addUser = m.top.findNode("addUser")
    m.changeServer = m.top.findNode("changeServer")
    m.buttonFocus = m.top.findNode("buttonFocus")
    m.addUser.text = tr("Add User")
    m.changeServer.text = tr("Select Server")
    buttonsLeft = (1920 - m.addUser.drawnWidth - USER_SELECT_BUTTON_GAP - m.changeServer.drawnWidth) / 2
    m.addUser.translation = [buttonsLeft, USER_SELECT_BUTTONS_Y]
    m.changeServer.translation = [buttonsLeft + m.addUser.drawnWidth + USER_SELECT_BUTTON_GAP, USER_SELECT_BUTTONS_Y]

    whoWatching = m.top.findNode("whoWatching")
    whoWatching.font.size = 33
    whoWatching.text = tr("Who's watching?")

    m.button = ""
    initServerName()
end sub

' The server's name at the top right, after its icon
sub initServerName()
    serverName = m.global.session.server.name
    if not isValidAndNotEmpty(serverName)
        serverUrl = get_setting("server") ?? ""
        if serverUrl = "" then return

        serverName = serverUrl.replace("https://", "").replace("http://", "")
        colonPos = serverName.instr(":")
        slashPos = serverName.instr("/")
        endPos = serverName.len()
        if colonPos >= 0 and colonPos < endPos then endPos = colonPos
        if slashPos >= 0 and slashPos < endPos then endPos = slashPos
        serverName = serverName.left(endPos)
    end if

    label = m.top.findNode("serverName")
    label.font.size = 25
    label.text = serverName
    labelLeft = USER_SELECT_RIGHT - label.boundingRect().width
    label.translation = [labelLeft, USER_SELECT_TOP_TEXT_Y]

    icon = m.top.findNode("serverIcon")
    icon.font.uri = settingsGlyphs.FONT_URI
    icon.font.size = 30
    icon.text = settingsGlyphs.Char("dns")
    icon.translation = [labelLeft - 13 - icon.boundingRect().width, USER_SELECT_TOP_TEXT_Y]
end sub

sub itemContentChanged()
    stopLoadingSpinner()
    profiles = []
    for each user in m.top.itemContent ?? []
        profiles.push(profileFor(user))
    end for
    m.carousel.items = profiles
    if profiles.count() = 0
        focusButton("addUser")
    else
        focusButton("")
    end if
end sub

' A token on the Roku signs in without asking, so only someone without one is told what they'll need
function profileFor(user as object) as object
    lines = []
    badge = ""
    if isValidAndNotEmpty(registry_read("token", user.id))
        lines.push({ text: tr("Signed in on this device") })
    else if user.needsPin
        lines.push({ text: tr("PIN required"), lock: true })
        badge = "pin"
    else if user.hasPassword
        lines.push({ text: tr("Password required") })
    end if
    return { id: user.id, name: user.name, imageURL: user.imageURL, badge: badge, lines: lines }
end function

sub onActivated()
    m.top.userSelected = m.top.itemContent[m.carousel.activated].name
end sub

' Add User or Select Server, or "" to give the remote back to the carousel
sub focusButton(button as string)
    m.button = button
    m.addUser.highlighted = button = "addUser"
    m.changeServer.highlighted = button = "changeServer"
    if button = ""
        m.carousel.setFocus(true)
    else
        m.buttonFocus.setFocus(true)
    end if
end sub

sub OnScreenShown(_isReturning = false as boolean)
    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav)
        activeNav.isVisible = false
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.top.backPressed = true
        return true
    end if

    ' The carousel hands over the keys it doesn't use
    if m.button = ""
        if key = KeyCode.DOWN then focusButton("addUser")
        return true
    end if

    if key = KeyCode.LEFT
        focusButton("addUser")
    else if key = KeyCode.RIGHT
        focusButton("changeServer")
    else if key = KeyCode.UP
        if (m.top.itemContent ?? []).count() > 0 then focusButton("")
    else if key = KeyCode.OK
        if m.button = "addUser"
            m.top.addUserSelected = true
        else
            m.top.changeServer = true
        end if
    end if
    return true
end function

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/loginStyle.bs"
import "pkg:/source/utils/misc.bs"

const USER_TILE_WIDTH = 210
const USER_TILE_SPACING = 27
const USER_ROW_WIDTH = 1060
const USER_CARD_HEIGHT = 565

sub init()
    m.top.optionsAvailable = false

    m.userRow = m.top.findNode("userRow")
    m.userRow.observeField("itemFocused", "onUserFocusChanged")
    m.addUser = m.top.findNode("addUser")
    m.changeServer = m.top.findNode("changeServer")
    m.buttonFocus = m.top.findNode("buttonFocus")
    m.addUser.text = tr("Add User")
    m.changeServer.text = tr("Select Server")
    m.top.findNode("serverName").font.size = 20
    whoWatching = m.top.findNode("whoWatching")
    whoWatching.font.size = 40
    whoWatching.text = tr("Who's watching?")

    top = loginStyle.ColumnTop(27 + 134 + 46 + USER_CARD_HEIGHT + 27)
    m.top.findNode("logo").translation = [664, top + 27]
    card = m.top.findNode("card")
    card.translation = [376, top + 27 + 134 + 46]
    m.top.findNode("cardFill").height = USER_CARD_HEIGHT
    m.top.findNode("cardBorder").height = USER_CARD_HEIGHT

    m.button = ""
    initServerName()
end sub

sub initServerName()
    serverName = m.global.session.server.name
    if not isValidAndNotEmpty(serverName)
        serverUrl = get_setting("server") ?? ""
        if serverUrl = "" then return

        serverName = serverUrl.replace("https://", "").replace("http://", "")
        colonPos = serverName.instr(":")
        slashPos = serverName.instr("/")
        endPos = serverName.len()
        if colonPos >= 0 and colonPos < endPos then endPos = colonPos
        if slashPos >= 0 and slashPos < endPos then endPos = slashPos
        serverName = serverName.left(endPos)
    end if
    m.top.findNode("serverName").text = serverName
end sub

sub itemContentChanged()
    stopLoadingSpinner()
    m.userRow.itemContent = m.top.itemContent
    if m.top.itemContent.count() = 0
        focusButton("addUser")
    else
        focusButton("")
    end if
    redraw()
end sub

' Add User or Select Server, or "" to give the remote back to the tiles
sub focusButton(button as string)
    m.button = button
    m.addUser.highlighted = button = "addUser"
    m.changeServer.highlighted = button = "changeServer"
    if button = ""
        m.userRow.setFocus(true)
        return
    end if
    m.buttonFocus.setFocus(true)
    for each tile in m.userRow.findNode("itemLayout").getChildren(-1, 0)
        tile.itemHasFocus = false
    end for
end sub

' Tiles that fit are centered as a group, and a longer row starts at the left and scrolls
sub redraw()
    userCount = m.top.itemContent.Count()
    if userCount = 0 then return

    rowWidth = (userCount * USER_TILE_WIDTH) + ((userCount - 1) * USER_TILE_SPACING)
    if rowWidth <= USER_ROW_WIDTH
        m.userRow.translation = [(USER_ROW_WIDTH - rowWidth) / 2, 8]
    else
        scrollUserRow()
    end if
end sub

sub onUserFocusChanged()
    scrollUserRow()
end sub

sub scrollUserRow()
    userCount = m.top.itemContent.Count()
    if userCount = 0 then return

    rowWidth = (userCount * USER_TILE_WIDTH) + ((userCount - 1) * USER_TILE_SPACING)
    if rowWidth <= USER_ROW_WIDTH then return

    focusedIndex = m.userRow.itemFocused
    if focusedIndex < 0 then focusedIndex = 0

    focusedItemLeft = focusedIndex * (USER_TILE_WIDTH + USER_TILE_SPACING)
    focusedItemRight = focusedItemLeft + USER_TILE_WIDTH
    currentOffset = -m.userRow.translation[0]
    if focusedItemRight > currentOffset + USER_ROW_WIDTH
        currentOffset = focusedItemRight - USER_ROW_WIDTH
    else if focusedItemLeft < currentOffset
        currentOffset = focusedItemLeft
    end if

    maxOffset = rowWidth - USER_ROW_WIDTH
    if currentOffset < 0 then currentOffset = 0
    if currentOffset > maxOffset then currentOffset = maxOffset
    m.userRow.translation = [-currentOffset, 8]
end sub

sub OnScreenShown(_isReturning = false as boolean)
    scene = m.top.getScene()
    activeNav = getActiveNav(scene)
    if isValid(activeNav)
        activeNav.isVisible = false
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.BACK
        m.top.backPressed = true
        return true
    end if

    hasUsers = m.top.itemContent.count() > 0
    if m.button = ""
        ' The row hands over the keys it has no tile for
        if key = KeyCode.DOWN or key = KeyCode.LEFT
            focusButton("addUser")
        else if key = KeyCode.RIGHT
            focusButton("changeServer")
        end if
        return true
    end if

    if key = KeyCode.LEFT
        focusButton("addUser")
    else if key = KeyCode.RIGHT
        focusButton("changeServer")
    else if key = KeyCode.UP
        if hasUsers then focusButton("")
    else if key = KeyCode.OK
        if m.button = "addUser"
            m.top.addUserSelected = true
        else
            m.top.changeServer = true
        end if
    end if
    return true
end function

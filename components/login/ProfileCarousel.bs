import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/profileCarousel.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const CAROUSEL_CENTER = 960
const CAROUSEL_MIDDLE = 154
const CAROUSEL_LINES_TOP = 419
const CAROUSEL_LINE_STEP = 42
const CAROUSEL_DOT = 12
const CAROUSEL_PILL = 40

sub init()
    m.faces = m.top.findNode("faces")
    m.ring = m.top.findNode("ring")
    m.name = m.top.findNode("name")
    m.name.font.size = 60
    m.lines = m.top.findNode("lines")
    m.dots = m.top.findNode("dots")
    m.slide = m.top.findNode("slide")
    m.slideInterp = m.top.findNode("slideInterp")
    m.top.observeField("focusedChild", "onFocusChanged")
end sub

sub onFocusChanged()
    if m.top.hasFocus()
        m.ring.blendColor = profileCarousel.Accent()
    else
        m.ring.blendColor = "#FFFFFF40"
    end if
end sub

sub itemsChanged()
    m.faces.removeChildrenIndex(m.faces.getChildCount(), 0)
    profiles = m.top.items ?? []
    for each profile in profiles
        m.faces.createChild("ProfileFace").itemContent = profile
    end for
    m.ring.visible = profiles.count() > 0

    index = m.top.selected
    if index > profiles.count() - 1 then index = profiles.count() - 1
    if index < 0 then index = 0
    m.top.selected = index
    m.slide.control = "stop"
    m.top.position = index
    layoutFaces()
    showDetails()
end sub

sub layoutFaces()
    position = m.top.position
    for i = 0 to m.faces.getChildCount() - 1
        face = m.faces.getChild(i)
        spot = profileCarousel.Placement(i - position)
        face.visible = spot.opacity > 0
        if face.visible
            face.size = spot.size
            face.opacity = spot.opacity
            face.translation = [CAROUSEL_CENTER + spot.x - spot.size / 2, CAROUSEL_MIDDLE - spot.size / 2]
        end if
    end for
end sub

sub moveTo(index as integer)
    m.top.selected = index
    m.slideInterp.fieldToInterp = m.top.id + ".position"
    m.slideInterp.keyValue = [m.top.position, index]
    m.slide.control = "start"
    showDetails()
end sub

' The name and lines under the middle face, then a dot per profile
sub showDetails()
    m.lines.removeChildrenIndex(m.lines.getChildCount(), 0)
    m.dots.removeChildrenIndex(m.dots.getChildCount(), 0)
    profiles = m.top.items ?? []
    if profiles.count() = 0
        m.name.text = ""
        return
    end if

    profile = profiles[m.top.selected]
    m.name.text = profile.name ?? ""
    y = CAROUSEL_LINES_TOP
    for each entry in profile.lines ?? []
        addLine(entry, y)
        y += CAROUSEL_LINE_STEP
    end for
    if profiles.count() > 1 then addDots(profiles.count(), y + 37)
end sub

sub addLine(entry as object, y as float)
    label = m.lines.createChild("Label")
    label.font = "font:SmallSystemFont"
    label.font.size = 27
    label.color = entry.color ?? "#FFFFFFA6"
    label.text = entry.text ?? ""
    textWidth = label.boundingRect().width

    glyph = invalid
    glyphWidth = 0
    if entry.lock = true
        glyph = m.lines.createChild("Label")
        glyph.font.uri = settingsGlyphs.FONT_URI
        glyph.font.size = 28
        glyph.color = label.color
        glyph.text = settingsGlyphs.Char("lock_outline")
        glyphWidth = glyph.boundingRect().width + 10
    end if
    startX = CAROUSEL_CENTER - (glyphWidth + textWidth) / 2
    if glyph <> invalid then glyph.translation = [startX, y]
    label.translation = [startX + glyphWidth, y]
end sub

' The selected one is a pill, two dots and a bar between them
sub addDots(count as integer, y as float)
    x = CAROUSEL_CENTER - ((count * 2 - 1) * CAROUSEL_DOT + CAROUSEL_PILL - CAROUSEL_DOT) / 2
    accent = profileCarousel.Accent()
    for i = 0 to count - 1
        if i = m.top.selected
            addDot(x, y, accent)
            bar = m.dots.createChild("Rectangle")
            bar.color = accent
            bar.width = CAROUSEL_PILL - CAROUSEL_DOT
            bar.height = CAROUSEL_DOT
            bar.translation = [x + CAROUSEL_DOT / 2, y]
            addDot(x + CAROUSEL_PILL - CAROUSEL_DOT, y, accent)
            x += CAROUSEL_PILL
        else
            addDot(x, y, "#FFFFFF4D")
            x += CAROUSEL_DOT
        end if
        x += CAROUSEL_DOT
    end for
end sub

sub addDot(x as float, y as float, color as string)
    dot = m.dots.createChild("Poster")
    dot.uri = "pkg:/images/icons/circle.webp"
    dot.width = CAROUSEL_DOT
    dot.height = CAROUSEL_DOT
    dot.blendColor = color
    dot.translation = [x, y]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    count = m.faces.getChildCount()
    if key = KeyCode.LEFT or key = KeyCode.RIGHT
        target = m.top.selected - 1
        if key = KeyCode.RIGHT then target = m.top.selected + 1
        ' Held at the ends too, there's nothing beside the carousel to go to
        if target >= 0 and target < count then moveTo(target)
        return true
    end if

    if key = KeyCode.OK and count > 0
        m.top.activated = m.top.selected
        return true
    end if

    return false
end function

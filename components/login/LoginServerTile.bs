sub init()
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.mark = m.top.findNode("mark")
    m.top.findNode("name").font.size = 23
    m.top.findNode("detail").font.size = 22
    onServerTypeChanged()
end sub

sub onServerTypeChanged()
    if m.top.serverType = "emby"
        m.mark.uri = "pkg:/images/login/emby.webp"
    else if m.top.serverType = "plex"
        m.mark.uri = "pkg:/images/login/plex.webp"
    else
        m.mark.uri = "pkg:/images/login/jellyfin.webp"
    end if
end sub

sub onHighlightedChanged()
    m.border.visible = m.top.highlighted
    if m.top.highlighted
        m.fill.blendColor = "#00A4DC2E"
    else
        m.fill.blendColor = "#FFFFFF0D"
    end if
end sub

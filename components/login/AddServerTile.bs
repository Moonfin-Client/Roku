import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.border = m.top.findNode("border")
    m.ring = m.top.findNode("ring")

    plus = m.top.findNode("plus")
    plus.font.uri = settingsGlyphs.FONT_URI
    plus.font.size = 40
    plus.text = settingsGlyphs.Char("add")

    title = m.top.findNode("title")
    title.font.size = 25
    title.text = tr("Add Server")
    subtitle = m.top.findNode("subtitle")
    subtitle.font.size = 22
    subtitle.text = tr("By address, or with a Plex or Emby Connect account")
end sub

sub onHighlightedChanged()
    m.ring.visible = m.top.highlighted
    if m.top.highlighted
        m.fill.blendColor = "#00A4DC2E"
        m.border.blendColor = "#00A4DCD9"
    else
        m.fill.blendColor = "#00A4DC1A"
        m.border.blendColor = "#00A4DC73"
    end if
end sub

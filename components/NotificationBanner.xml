<?xml version="1.0" encoding="utf-8"?>
<!-- A passive banner in the top right corner for anything the app has to say in passing, like a
     badge the user just unlocked. Notices wait their turn, and it never takes focus. -->
<component name="NotificationBanner" extends="Group">
  <children>
    <Group id="panel" opacity="0">
      <Poster id="fill" uri="pkg:/images/details/surface8.9.png" />
      <!-- The left edge is the rounded panel in the accent colour, cut down to the edge's width -->
      <Group id="edge">
        <Poster id="edgeFill" uri="pkg:/images/details/surface8.9.png" />
      </Group>
      <Group id="outline">
        <Poster id="outlineStroke" uri="pkg:/images/details/outline8.9.png" blendColor="#FFFFFF" opacity="0.18" />
      </Group>
      <Poster id="icon" width="40" height="40" failedBitmapUri="pkg:/images/achievements/emoji_events.png" />
      <Label id="title" font="font:SmallBoldSystemFont" color="#FFFFFF" />
      <Label id="body" font="font:SmallSystemFont" color="#FFFFFFBF" maxLines="2" />
    </Group>

    <Animation id="enter" duration="0.22" repeat="false" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="panel.opacity" />
      <Vector2DFieldInterpolator id="enterSlide" key="[0.0, 1.0]" fieldToInterp="panel.translation" />
    </Animation>
    <Timer id="dismissTimer" duration="7" repeat="false" />
  </children>

  <interface>
    <!-- Takes a list of { title, body, icon }, with the body and icon optional, and shows them in turn -->
    <function name="enqueue" />
  </interface>
</component>

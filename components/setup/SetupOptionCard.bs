import "pkg:/components/setup/setupPreviewDraw.bs"

const OPTION_ROW_WIDTH = 600
const OPTION_ROW_HEIGHT = 60
const OPTION_LABEL_X = 66
const OPTION_INK = "0x101010FF"
const OPTION_DOT_URI = "pkg:/images/settings/dot96.png"

' One answer in the wizard's list: a radio, its name, a Current tag on the chosen one and, for a
' theme, a swatch of its accent on its surface. The focused row fills with the text color.
sub init()
    m.built = false
end sub

sub rebuild()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while
    m.built = false
    m.swatchHole = invalid

    config = m.top.config
    if not isValid(config) then return

    m.palette = setupPreviewDraw.Palette()
    m.fill = setupPreviewDraw.Shape(m.top, "pkg:/images/makd/dotspill14.9.png", 0, 0, OPTION_ROW_WIDTH, OPTION_ROW_HEIGHT, m.palette.onSurface)
    ' The ring is a disc with a hole punched in the row's own color, so the dot sits in a 2 px ring
    m.ring = setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 24, 18, 24, 24, m.palette.onSurface)
    m.ringHole = setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 26, 20, 20, 20, m.palette.background)
    m.dot = setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 30, 24, 12, 12, m.palette.accent)

    m.endX = OPTION_ROW_WIDTH - 24
    if isValid(config.swatchAccent)
        setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 544, 13, 34, 34, playbackOverlay.WithAlpha(m.palette.onSurface, 51))
        m.swatchHole = setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 546, 15, 30, 30, m.palette.background)
        setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 546, 15, 30, 30, config.swatchSurface)
        setupPreviewDraw.Shape(m.top, OPTION_DOT_URI, 552.5, 21.5, 17, 17, config.swatchAccent)
        m.endX = 528
    end if

    m.label = setupPreviewDraw.TextLabel(m.top, config.label ?? "", OPTION_LABEL_X, 0, 28, m.palette.onSurface, false)
    m.label.height = OPTION_ROW_HEIGHT
    m.label.vertAlign = "center"

    m.current = setupPreviewDraw.TextLabel(m.top, tr("Current"), 0, 0, 20, m.palette.onSurface, false)
    m.currentWidth = m.current.boundingRect().width
    m.current.width = m.endX
    m.current.height = OPTION_ROW_HEIGHT
    m.current.horizAlign = "right"
    m.current.vertAlign = "center"

    m.built = true
    updateState()
end sub

sub updateState()
    if not m.built then return
    focused = m.top.focused
    selected = m.top.selected
    onSurface = m.palette.onSurface

    m.fill.visible = focused
    if selected
        m.ring.blendColor = m.palette.accent
    else if focused
        m.ring.blendColor = "0x10101080"
    else
        m.ring.blendColor = playbackOverlay.WithAlpha(onSurface, 102)
    end if
    hole = m.palette.background
    if focused then hole = onSurface
    m.ringHole.blendColor = hole
    if isValid(m.swatchHole) then m.swatchHole.blendColor = hole
    m.dot.visible = selected

    m.label.font = "font:SmallSystemFont"
    if focused then m.label.font = "font:SmallBoldSystemFont"
    m.label.font.size = 28
    m.label.color = focused ? OPTION_INK : playbackOverlay.WithAlpha(onSurface, 209)
    labelEnd = m.endX
    if selected then labelEnd -= m.currentWidth + 18
    m.label.width = labelEnd - OPTION_LABEL_X

    m.current.visible = selected
    m.current.color = focused ? "0x10101099" : playbackOverlay.WithAlpha(onSurface, 140)
end sub

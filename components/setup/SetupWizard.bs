import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/settingsSync.bs"
import "pkg:/source/utils/setupWizardGate.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeRegistry.bs"
import "pkg:/source/utils/userConfigSync.bs"

const AUDIO_LANGUAGE_KEY = "playback.audioPreferredLanguage"
const DEFAULT_TRACK_KEY = "playback.playDefaultAudioTrack"
const SUBTITLE_MODE_KEY = "playback.subs.mode"
const SUBTITLE_LANGUAGE_KEY = "playback.subs.language"

' Laid out on the same 1920x1080 reference the other clients use
const COLUMN_X = 96
const COLUMN_Y = 160
const COLUMN_WIDTH = 600
' The tour's languages panel can open past the footer, so the column scrolls above this line
const COLUMN_CLIP_BOTTOM = 930
const ROW_PITCH = 66
const STAGE_X = 784
const STAGE_Y = 160
const STAGE_WIDTH = 1040
const STAGE_HEIGHT = 585
const SHADOW_MARGIN = 96
const CAPTION_Y = 769
const FOOTER_Y = 951
const FOOTER_HEIGHT = 73
const BUTTON_Y = 962

const ROUND3_URI = "pkg:/images/settings/round3.9.png"
const ROUND14_URI = "pkg:/images/makd/dotspill14.9.png"
const ROUND16_URI = "pkg:/images/whatsnew/fill16.9.png"
const ROUND20_URI = "pkg:/images/livetv/fill20.9.png"
const ROUND22_URI = "pkg:/images/livetv/fill22.9.png"

const PLAYBACK_WIDTH = 600
const PLAYBACK_HEADER_FOLDED = 108
const PLAYBACK_HEADER_OPEN = 76
const PLAYBACK_ROW_GAP = 12
const PLAYBACK_ROW_HEIGHT = 80
const PLAYBACK_HINT_ROW_HEIGHT = 140

' The first thing a new user sees after signing in: a few questions about how the app should
' look, then a look at what else is in here. Each answer is a row in a list, and the stage beside
' it previews whichever row has focus, so every option can be seen before one is chosen.
sub init()
    m.top.optionsAvailable = false
    m.built = false
    m.steps = []
    m.stepIndex = 0
    m.answers = {}
    m.items = []
    m.rows = []
    m.previews = []
    m.options = []
    m.focusZone = "rows"
    m.rowIndex = 0
    m.lastContentZone = "rows"
    m.playbackExpanded = false
    m.playbackIndex = 0
    m.playbackItems = []

    m.itemsTask = createObject("roSGNode", "SetupPreviewItemsTask")
    m.itemsTask.observeFieldScoped("items", "onPreviewItemsLoaded")
    m.itemsTask.control = "RUN"
end sub

sub OnScreenShown(_isReturning = false as boolean)
    if not m.built
        m.built = true
        m.steps = setupWizardGate.RemainingSteps(m.top.rerun)
        if m.steps.count() = 0
            ' Everything was answered on another device or an earlier visit,
            ' so there is nothing to show and nothing to ask again
            closeWizard()
            return
        end if
        ' What the answers were when the wizard opened, so a re-run can tell
        ' which live signals to send at the end
        m.initialNavPosition = effectiveValue("navbar")
        m.initialMediaBarMode = effectiveValue("mediaBar")
        buildStep()
    end if
    m.top.setFocus(true)
end sub

sub onPreviewItemsLoaded()
    m.items = m.itemsTask.items
    for each preview in m.previews
        preview.items = m.items
    end for
end sub

function questionFor(stepName as string) as string
    if isStringEqual(stepName, "navbar") then return tr("Where should navigation go?")
    if isStringEqual(stepName, "mediaBar") then return tr("How should the top of your Home screen look?")
    if isStringEqual(stepName, "homeRows") then return tr("How should your rows look?")
    if isStringEqual(stepName, "detailStyle") then return tr("How should a movie or show look when you open it?")
    return tr("You're set. Here's what else is in here.")
end function

' Where the same choice lives in Settings, as the device's own menu lays it out
function settingsPath(stepName as string) as object
    if isStringEqual(stepName, "navbar") then return { crumbs: [tr("Settings"), tr("Appearance"), tr("Navigation Bar")], name: tr("Navigation Style") }
    if isStringEqual(stepName, "mediaBar") then return { crumbs: [tr("Settings"), tr("Appearance"), tr("Home Screen"), tr("Media Bar")], name: tr("Media Bar Style") }
    if isStringEqual(stepName, "homeRows") then return { crumbs: [tr("Settings"), tr("Appearance"), tr("Home Screen")], name: tr("Row Type") }
    if isStringEqual(stepName, "detailStyle") then return { crumbs: [tr("Settings"), tr("Appearance"), tr("Details Page")], name: tr("Details Screen Style") }
    return { crumbs: [tr("Settings"), tr("Appearance")], name: tr("App Theme") }
end function

function rokuKeyFor(stepName as string) as string
    for each question in setupWizardGate.QuestionSteps()
        if isStringEqual(question.step, stepName) then return question.rokuKey
    end for
    return ""
end function

' The held answer when there is one, the current setting otherwise, which
' always exists because the defaults are merged into the session at load.
' Another client can have stored the detail style in its own spelling, so
' the token is brought back to the one the options carry
function effectiveValue(stepName as string) as string
    key = rokuKeyFor(stepName)
    if key = "" then return ""
    held = m.answers[key]
    if isValidAndNotEmpty(held) then return held
    current = toString(m.global.session.user.settings[key])
    if isStringEqual(stepName, "detailStyle") then return normalizeDetailScreenStyleToken(current)
    return current
end function

function stepOptions(stepName as string) as object
    if isStringEqual(stepName, "navbar")
        return [
            { value: "top", label: tr("Top Bar"), hint: tr("Tabs across the top of the screen."), previewComponent: "SetupNavbarPreview", previewFields: { position: "top" } },
            { value: "left", label: tr("Left Sidebar"), hint: tr("A slim rail of icons down the left side."), previewComponent: "SetupNavbarPreview", previewFields: { position: "left" } }
        ]
    end if
    if isStringEqual(stepName, "mediaBar")
        modes = [
            ["moonfin", tr("Moonfin"), tr("Large artwork with the title, details and overview laid over it.")],
            ["makd", tr("MakD"), tr("Large artwork led by a big title logo.")],
            ["bookshelf", tr("Bookshelf"), tr("Titles shelved as book spines, with the featured one face out.")],
            ["gallery", tr("Gallery"), tr("The featured title opened up, with the next few lined up beside it.")],
            ["banner", tr("Banner"), tr("A shorter banner above your rows, so more of them fit on screen.")],
            ["aya", tr("Aya"), tr("Artwork first in a framed panel, with your rows right underneath.")],
            ["off", tr("Off"), tr("No featured area. Home opens straight onto your rows.")]
        ]
        configs = []
        for each mode in modes
            configs.push({ value: mode[0], label: mode[1], hint: mode[2], previewComponent: "SetupMediaBarPreview", previewFields: { mode: mode[0] } })
        end for
        return configs
    end if
    if isStringEqual(stepName, "homeRows")
        return [
            { value: "v1", label: tr("Classic"), hint: tr("Compact. More rows on screen at once."), previewComponent: "SetupHomeRowsPreview", previewFields: { modern: false } },
            { value: "v2", label: tr("Modern"), hint: tr("Larger cards with titles underneath."), previewComponent: "SetupHomeRowsPreview", previewFields: { modern: true } }
        ]
    end if
    if isStringEqual(stepName, "detailStyle")
        return [
            { value: "classic", label: tr("Classic"), hint: tr("Everything centred in one stack."), previewComponent: "SetupDetailPreview", previewFields: { variant: "classic" } },
            { value: "modern", label: tr("Modern"), hint: tr("Cinematic, with tabs for cast and extras."), previewComponent: "SetupDetailPreview", previewFields: { variant: "modern" } },
            { value: "spotlight", label: tr("Spotlight"), hint: tr("Hero-first, with pop-up cards for cast and extras."), previewComponent: "SetupDetailPreview", previewFields: { variant: "spotlight" } },
            { value: "nouveau", label: tr("Nouveau"), hint: tr("Full-screen, with sections stacked instead of tabs."), previewComponent: "SetupDetailPreview", previewFields: { variant: "nouveau" } },
            { value: "minimalist", label: tr("Minimalist"), hint: tr("Artwork, one play button and the episodes."), previewComponent: "SetupDetailPreview", previewFields: { variant: "minimalist" } }
        ]
    end if

    ' The tour lists the themes, and every one of them points at the rest of Settings
    bullets = [tr("Seerr requests"), tr("Live TV"), tr("Custom themes"), tr("And plenty more")]
    tourHint = `${tr("There is more waiting in Settings")}: ${bullets.join(" · ")}`
    configs = []
    for each themeId in themeRegistry.BuiltInIds()
        theme = themeRegistry.ReadBundledTheme(themeId)
        if isValid(theme) and isValid(theme.colors)
            configs.push({
                value: themeId,
                label: theme.displayName ?? themeId,
                hint: tourHint,
                swatchSurface: formatSceneGraphColor(theme.colors.surface, "0x101010FF"),
                swatchAccent: formatSceneGraphColor(theme.colors.accent, "0xFF6867FF")
            })
        end if
    end for
    return configs
end function

function chosenValue(stepName as string) as string
    if not isStringEqual(stepName, "tour") then return effectiveValue(stepName)
    activeThemeId = toString(m.global.session.user.settings["ui.theme.customThemeId"])
    if not isValidAndNotEmpty(activeThemeId) then return "moonfin"
    return activeThemeId
end function

' The whole screen is drawn again for every step, which also restyles it when the tour applies a theme
sub buildStep()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while
    m.rows = []
    m.previews = []
    m.playbackItems = []
    m.playbackGroup = invalid

    palette = setupPreviewDraw.Palette()
    stepName = m.steps[m.stepIndex]
    m.onTour = isStringEqual(stepName, "tour")
    m.options = stepOptions(stepName)
    m.path = settingsPath(stepName)

    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, palette.background)
    drawHeader(palette)
    drawColumn(stepName, palette)
    drawStage(palette)
    m.caption = m.top.createChild("Group")
    m.caption.translation = [STAGE_X, CAPTION_Y]
    drawFooter(palette)

    m.focusZone = "rows"
    m.lastContentZone = "rows"
    applyFocus()
end sub

sub drawHeader(palette as object)
    x = COLUMN_X
    for i = 0 to m.steps.count() - 1
        ink = playbackOverlay.WithAlpha(palette.onSurface, 46)
        if i < m.stepIndex then ink = palette.onSurface
        if i = m.stepIndex then ink = palette.accent
        setupPreviewDraw.Shape(m.top, ROUND3_URI, x, 86, 72, 6, ink)
        x += 80
    end for

    count = setupPreviewDraw.TextLabel(m.top, substitute(tr("Step {0} of {1}"), (m.stepIndex + 1).toStr(), m.steps.count().toStr()), x + 16, 64, 24, playbackOverlay.WithAlpha(palette.onSurface, 153), false)
    x += 16 + count.boundingRect().width + 24
    count.height = 51
    count.vertAlign = "center"

    chipBorder = setupPreviewDraw.Shape(m.top, ROUND22_URI, x, 67, 0, 44, playbackOverlay.WithAlpha(palette.onSurface, 41))
    chipHole = setupPreviewDraw.Shape(m.top, ROUND20_URI, x + 2, 69, 0, 40, palette.background)
    chipFill = setupPreviewDraw.Shape(m.top, ROUND20_URI, x + 2, 69, 0, 40, playbackOverlay.WithAlpha(palette.onSurface, 20))
    chipText = setupPreviewDraw.TextLabel(m.top, m.path.name, x + 20, 67, 24, palette.onSurface, true)
    chipWidth = chipText.boundingRect().width + 40
    chipBorder.width = chipWidth
    chipHole.width = chipWidth - 4
    chipFill.width = chipWidth - 4
    chipText.height = 44
    chipText.vertAlign = "center"

    m.skipLabel = setupPreviewDraw.TextLabel(m.top, tr("Skip setup"), 0, 64, 28, palette.onSurface, false)
    skipWidth = m.skipLabel.boundingRect().width
    m.skipLabel.translation = [1808 - skipWidth, 64]
    m.skipLabel.height = 49
    m.skipLabel.vertAlign = "center"
    m.skipUnderline = setupPreviewDraw.Rect(m.top, 1792 - skipWidth, 113, skipWidth + 32, 2, palette.onSurface)
end sub

' The question and the answers as one vertical list. The tour adds the playback languages panel
' and where those settings live under the themes.
sub drawColumn(stepName as string, palette as object)
    clip = m.top.createChild("Group")
    clip.clippingRect = [COLUMN_X - 16, COLUMN_Y, COLUMN_WIDTH + 32, COLUMN_CLIP_BOTTOM - COLUMN_Y]
    m.column = clip.createChild("Group")
    m.column.translation = [COLUMN_X, COLUMN_Y]
    m.columnScroll = 0

    question = setupPreviewDraw.TextLabel(m.column, questionFor(stepName), 0, 0, 52, palette.onSurface, true)
    question.width = COLUMN_WIDTH
    question.wrap = true
    rowY = question.boundingRect().height + 36

    chosen = chosenValue(stepName)
    m.rowIndex = 0
    for each option in m.options
        row = m.column.createChild("SetupOptionCard")
        row.translation = [0, rowY]
        row.config = option
        row.selected = isStringEqual(option.value, chosen)
        if row.selected then m.rowIndex = m.rows.count()
        m.rows.push(row)
        rowY += ROW_PITCH
    end for

    if m.onTour
        m.playbackTop = rowY - (ROW_PITCH - 60) + 24
        m.playbackGroup = m.column.createChild("Group")
        m.playbackGroup.translation = [0, m.playbackTop]
        drawPlayback()
    end if
end sub

' A 16:9 window onto the real previews, one per option with only the focused one showing. The
' tour shows home with the media bar it will open on, in whichever theme is on.
sub drawStage(palette as object)
    setupPreviewDraw.Shape(m.top, "pkg:/images/setup/stage24shadow.9.png", STAGE_X - SHADOW_MARGIN, STAGE_Y + 24 - SHADOW_MARGIN, STAGE_WIDTH + 2 * SHADOW_MARGIN, STAGE_HEIGHT + 2 * SHADOW_MARGIN, "0x00000080")

    holder = m.top.createChild("Group")
    holder.translation = [STAGE_X, STAGE_Y]
    holder.clippingRect = [0, 0, STAGE_WIDTH, STAGE_HEIGHT]
    configs = m.options
    if m.onTour then configs = [{ previewComponent: "SetupMediaBarPreview", previewFields: { mode: effectiveValue("mediaBar") } }]
    for each config in configs
        preview = holder.createChild(config.previewComponent)
        preview.setFields(config.previewFields)
        preview.items = m.items
        ' Every preview draws on a full screen canvas and shrinks to the stage
        preview.scale = [STAGE_WIDTH / 1920, STAGE_HEIGHT / 1080]
        preview.visible = false
        m.previews.push(preview)
    end for

    ' Rectangles ignore masks on Roku, so the corners are painted over in the page color instead
    setupPreviewDraw.Shape(m.top, "pkg:/images/setup/stage24cover.9.png", STAGE_X, STAGE_Y, STAGE_WIDTH, STAGE_HEIGHT, palette.background)
    setupPreviewDraw.Shape(m.top, "pkg:/images/setup/stage24s2.9.png", STAGE_X, STAGE_Y, STAGE_WIDTH, STAGE_HEIGHT, playbackOverlay.WithAlpha(palette.onSurface, 51))
end sub

sub drawCaption(palette as object)
    while m.caption.getChildCount() > 0
        m.caption.removeChildIndex(0)
    end while
    if m.rowIndex >= m.options.count() then return
    option = m.options[m.rowIndex]

    title = setupPreviewDraw.TextLabel(m.caption, option.label, 0, 0, 36, palette.onSurface, true)
    descY = title.boundingRect().height + 8
    desc = setupPreviewDraw.TextLabel(m.caption, option.hint ?? "", 0, descY, 26, playbackOverlay.WithAlpha(palette.onSurface, 158), false)
    desc.width = STAGE_WIDTH
    desc.wrap = true
    desc.maxLines = 2
    drawPath(m.caption, m.path.crumbs, m.path.name, descY + desc.boundingRect().height + 16, STAGE_WIDTH, true, palette)
end sub

' Settings crumbs split by chevrons, the setting itself last and in bold. Returns where it ends.
function drawPath(parent as object, crumbs as object, lastCrumb as string, pathY as float, maxWidth as integer, withGear as boolean, palette as object) as float
    x = 0
    lineY = pathY
    if withGear
        glyphLabel(parent, "settings", 0, lineY, 24, playbackOverlay.WithAlpha(palette.onSurface, 140))
        x = 32
    end if
    parts = []
    parts.append(crumbs)
    parts.push(lastCrumb)
    for i = 0 to parts.count() - 1
        isLast = i = parts.count() - 1
        ink = playbackOverlay.WithAlpha(palette.onSurface, 153)
        if isLast then ink = palette.onSurface
        crumb = setupPreviewDraw.TextLabel(parent, parts[i], x, lineY, 22, ink, isLast)
        crumbWidth = crumb.boundingRect().width
        if x > 0 and x + crumbWidth > maxWidth
            x = 0
            lineY += 30
            crumb.translation = [x, lineY]
        end if
        crumb.height = 24
        crumb.vertAlign = "center"
        x += crumbWidth + 8
        if not isLast
            glyphLabel(parent, "chevron_right", x, lineY + 3, 18, playbackOverlay.WithAlpha(palette.onSurface, 102))
            x += 26
        end if
    end for
    return lineY + 24
end function

' One of the Material icons the settings screens draw, from the same icon font
function glyphLabel(parent as object, glyphName as string, x as float, y as float, size as integer, color as string) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = settingsGlyphs.FONT_URI
    font.size = size
    label = parent.createChild("Label")
    label.font = font
    label.text = settingsGlyphs.Char(glyphName)
    label.color = color
    label.width = size
    label.height = size
    label.horizAlign = "center"
    label.vertAlign = "center"
    label.translation = [x, y]
    return label
end function

sub drawFooter(palette as object)
    m.backLabel = setupPreviewDraw.TextLabel(m.top, tr("Back"), COLUMN_X + 16, BUTTON_Y, 28, palette.onSurface, false)
    backWidth = m.backLabel.boundingRect().width
    m.backLabel.height = 49
    m.backLabel.vertAlign = "center"
    m.backLabel.visible = m.stepIndex > 0
    m.backUnderline = setupPreviewDraw.Rect(m.top, COLUMN_X, BUTTON_Y + 49, backWidth + 32, 2, palette.onSurface)

    hint = setupPreviewDraw.TextLabel(m.top, tr("Up and down to preview · OK to choose · Back twice to skip"), COLUMN_X + 240, BUTTON_Y, 22, playbackOverlay.WithAlpha(palette.onSurface, 128), false)
    hint.width = 1920 - 2 * (COLUMN_X + 240)
    hint.height = 49
    hint.horizAlign = "center"
    hint.vertAlign = "center"

    m.nextRing = setupPreviewDraw.Shape(m.top, ROUND20_URI, 0, FOOTER_Y - 4, 0, FOOTER_HEIGHT + 8, palette.onSurface)
    nextFill = setupPreviewDraw.Shape(m.top, ROUND16_URI, 0, FOOTER_Y, 0, FOOTER_HEIGHT, palette.accent)
    nextText = tr("Next")
    if m.stepIndex >= m.steps.count() - 1 then nextText = tr("Done")
    nextLabel = setupPreviewDraw.TextLabel(m.top, nextText, 0, FOOTER_Y, 28, palette.onAccent, true)
    nextWidth = nextLabel.boundingRect().width + 104
    nextX = 1920 - COLUMN_X - nextWidth
    m.nextRing.translation = [nextX - 4, FOOTER_Y - 4]
    m.nextRing.width = nextWidth + 8
    nextFill.translation = [nextX, FOOTER_Y]
    nextFill.width = nextWidth
    nextLabel.translation = [nextX, FOOTER_Y]
    nextLabel.width = nextWidth
    nextLabel.height = FOOTER_HEIGHT
    nextLabel.horizAlign = "center"
    nextLabel.vertAlign = "center"
end sub

' ===== Playback languages =====

' The held answer when there is one, the current setting otherwise. Sign in has already filled
' these in from the server.
function playbackValue(rokuKey as string) as string
    held = m.answers[rokuKey]
    if isValidAndNotEmpty(held) then return held
    return toString(m.global.session.user.settings[rokuKey])
end function

' The same lists the audio and subtitle settings offer, read once
function playbackChoices(settingName as string) as object
    if not isValid(m.playbackChoices)
        tree = GetConfigTree()
        m.playbackChoices = {}
        for each key in [AUDIO_LANGUAGE_KEY, SUBTITLE_MODE_KEY, SUBTITLE_LANGUAGE_KEY]
            m.playbackChoices[key] = settingOptions(tree, key)
        end for
    end if
    return m.playbackChoices[settingName]
end function

function settingOptions(entries as object, settingName as string) as dynamic
    for each entry in entries
        if isStringEqual(entry.settingName, settingName) then return entry.options ?? []
        if isValid(entry.children)
            found = settingOptions(entry.children, settingName)
            if isValid(found) then return found
        end if
    end for
    return invalid
end function

' A language the server brought in that isnt in the list shows as its code
function choiceLabel(choices as object, value as string, fallback as string) as string
    for each choice in choices
        if isStringEqual(choice.id, value) then return tr(choice.title)
    end for
    return fallback
end function

function subtitleModeDescription(mode as string) as string
    if isStringEqual(mode, "Always") then return tr("Automatically loads and displays subtitles every time a video starts.")
    if isStringEqual(mode, "Smart") then return tr("Automatically turns on subtitles if the default audio track is in a foreign language.")
    if isStringEqual(mode, "OnlyForced") then return tr("Only loads subtitles explicitly tagged with the forced metadata flag.")
    if isStringEqual(mode, "None") then return tr("Completely disables automatic subtitle loading.")
    return tr("Plays tracks internally flagged in the media file's metadata as ""default"" or ""forced"".")
end function

' A header that shows the current answers while folded, opening downwards into its rows when
' pressed. It starts folded since the answers are already filled in. Where these settings live
' sits under it either way.
sub drawPlayback()
    group = m.playbackGroup
    while group.getChildCount() > 0
        group.removeChildIndex(0)
    end while
    m.playbackItems = []

    palette = setupPreviewDraw.Palette()
    audioChoices = playbackChoices(AUDIO_LANGUAGE_KEY)
    modeChoices = playbackChoices(SUBTITLE_MODE_KEY)
    subtitleChoices = playbackChoices(SUBTITLE_LANGUAGE_KEY)
    audio = playbackValue(AUDIO_LANGUAGE_KEY)
    mode = playbackValue(SUBTITLE_MODE_KEY)
    subtitle = playbackValue(SUBTITLE_LANGUAGE_KEY)
    audioLabel = choiceLabel(audioChoices, audio, audio)
    modeLabel = choiceLabel(modeChoices, mode, choiceLabel(modeChoices, "Default", mode))
    subtitleLabel = choiceLabel(subtitleChoices, subtitle, subtitle)
    subtitlesOn = not isStringEqual(mode, "None")

    expanded = m.playbackExpanded
    headerHeight = expanded ? PLAYBACK_HEADER_OPEN : PLAYBACK_HEADER_FOLDED
    m.playbackItems.push(drawPlaybackPanel(0, headerHeight, palette))

    playbackIcon("pkg:/images/icons/translate.png", 30, 22, (headerHeight - 30) / 2, palette.onSurface)
    titleTop = expanded ? (headerHeight - 36) / 2 : 20
    title = setupPreviewDraw.TextLabel(group, tr("Playback languages"), 68, titleTop, 28, palette.onSurface, true)
    setupPreviewDraw.TextLabel(group, tr("Optional"), 68 + title.boundingRect().width + 12, titleTop + 6, 22, playbackOverlay.WithAlpha(palette.onSurface, 140), false)

    if not expanded
        summaryParts = [audioLabel]
        if subtitlesOn then summaryParts.push(subtitleLabel)
        summaryParts.push(modeLabel)
        summary = setupPreviewDraw.TextLabel(group, summaryParts.join(" · "), 68, 62, 24, playbackOverlay.WithAlpha(palette.onSurface, 166), false)
        summary.width = PLAYBACK_WIDTH - 68 - 80
    end if

    chevron = playbackIcon("pkg:/images/icons/keyboard_arrow_down.png", 36, PLAYBACK_WIDTH - 58, (headerHeight - 36) / 2, playbackOverlay.WithAlpha(palette.onSurface, 179))
    if expanded
        chevron.scaleRotateCenter = [18, 18]
        chevron.rotation = 3.14159
    end if

    m.playbackRows = []
    if expanded
        m.playbackRows.push({ key: AUDIO_LANGUAGE_KEY, label: tr("Default Audio Language"), choices: audioChoices, value: audioLabel })
        m.playbackRows.push({ key: DEFAULT_TRACK_KEY, label: tr("Prefer Default Audio Track"), hint: tr("Pick the track the file marks as default before matching languages") })
        ' Mode stays above the language so hiding the language doesnt move the focused row
        m.playbackRows.push({ key: SUBTITLE_MODE_KEY, label: tr("Subtitle Mode"), choices: modeChoices, value: modeLabel, described: true })
        if subtitlesOn then m.playbackRows.push({ key: SUBTITLE_LANGUAGE_KEY, label: tr("Default Subtitle Language"), choices: subtitleChoices, value: subtitleLabel })
    end if

    top = headerHeight
    for each row in m.playbackRows
        top += PLAYBACK_ROW_GAP
        height = isValid(row.hint) ? PLAYBACK_HINT_ROW_HEIGHT : PLAYBACK_ROW_HEIGHT
        m.playbackItems.push(drawPlaybackPanel(top, height, palette))

        if isValid(row.choices)
            playbackIcon("pkg:/images/icons/chevron-right.png", 32, PLAYBACK_WIDTH - 56, top + (height - 32) / 2, playbackOverlay.WithAlpha(palette.onSurface, 140))
            value = setupPreviewDraw.TextLabel(group, row.value, 0, top, 28, palette.onSurface, true)
            valueWidth = value.boundingRect().width
            if valueWidth > 220 then valueWidth = 220
            valueX = PLAYBACK_WIDTH - 64 - valueWidth
            value.translation = [valueX, top]
            value.width = valueWidth
            value.height = height
            value.horizAlign = "right"
            value.vertAlign = "center"
            labelEnd = valueX - 16
        else
            drawPlaybackSwitch(toBoolean(playbackValue(row.key)) = true, PLAYBACK_WIDTH - 96, top + (height - 40) / 2, palette)
            labelEnd = PLAYBACK_WIDTH - 112
        end if

        label = setupPreviewDraw.TextLabel(group, row.label, 24, top, 28, playbackOverlay.WithAlpha(palette.onSurface, 179), false)
        label.width = labelEnd - 24
        if isValid(row.hint)
            label.translation = [24, top + 20]
            hint = setupPreviewDraw.TextLabel(group, row.hint, 24, top + 60, 24, playbackOverlay.WithAlpha(palette.onSurface, 128), false)
            hint.width = label.width
            hint.wrap = true
            hint.maxLines = 2
        else
            label.height = height
            label.vertAlign = "center"
        end if

        top += height
    end for

    m.playbackBottom = drawPath(group, [tr("Settings"), tr("Playback")], `${tr("Audio")}, ${tr("Subtitles")}`, top + 12, PLAYBACK_WIDTH, false, palette)
end sub

' The rounded box a header or a row sits in, lit up while focused
function drawPlaybackPanel(top as integer, height as integer, palette as object) as object
    border = setupPreviewDraw.Shape(m.playbackGroup, ROUND16_URI, 0, top, PLAYBACK_WIDTH, height, playbackOverlay.WithAlpha(palette.onSurface, 36))
    setupPreviewDraw.Shape(m.playbackGroup, ROUND14_URI, 2, top + 2, PLAYBACK_WIDTH - 4, height - 4, palette.background)
    fill = setupPreviewDraw.Shape(m.playbackGroup, ROUND14_URI, 2, top + 2, PLAYBACK_WIDTH - 4, height - 4, playbackOverlay.WithAlpha(palette.onSurface, 10))
    return { top: top, height: height, border: border, fill: fill }
end function

' The row takes the press and the focus, the switch only shows the state
sub drawPlaybackSwitch(isOn as boolean, left as integer, top as integer, palette as object)
    trackInk = isOn ? palette.accent : playbackOverlay.WithAlpha(palette.onSurface, 64)
    track = playbackIcon("pkg:/images/details/btnfill.9.png", 40, left, top, trackInk)
    track.width = 72
    knobLeft = isOn ? left + 32 : left + 4
    playbackIcon("pkg:/images/icons/circle.png", 32, knobLeft, top + 4, isOn ? palette.onAccent : palette.onSurface)
end sub

function playbackIcon(uri as string, size as integer, left as integer, top as integer, color as string) as object
    icon = m.playbackGroup.createChild("Poster")
    icon.uri = uri
    icon.width = size
    icon.height = size
    icon.blendColor = color
    icon.translation = [left, top]
    return icon
end function

' The header folds and unfolds, the switch flips, and a list row opens its picker
sub selectPlaybackRow()
    if m.playbackIndex = 0
        m.playbackExpanded = not m.playbackExpanded
        drawPlayback()
        return
    end if

    row = m.playbackRows[m.playbackIndex - 1]
    if not isValid(row.choices)
        m.answers[row.key] = toBoolean(playbackValue(row.key)) = true ? "false" : "true"
        drawPlayback()
        return
    end if

    current = playbackValue(row.key)
    labels = []
    details = []
    selected = -1
    for each choice in row.choices
        if isStringEqual(choice.id, current) then selected = labels.count()
        labels.push(tr(choice.title))
        if row.described = true then details.push(subtitleModeDescription(choice.id))
    end for

    m.pickerRow = row
    m.picker = CreateObject("roSGNode", "ListPromptDialog")
    m.picker.dialogTitle = row.label
    m.picker.options = labels
    m.picker.optionDetails = details
    m.picker.selectedOption = selected
    m.picker.openOnSelected = true
    m.picker.returnFocus = m.top
    m.picker.observeField("optionSelected", "onPlaybackPicked")
    m.top.getScene().appendChild(m.picker)
    m.picker.callFunc("showDialog")
end sub

sub onPlaybackPicked(event as object)
    index = event.getData()
    m.picker.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.picker)
    m.picker = invalid

    row = m.pickerRow
    if index >= 0 and index < row.choices.count()
        value = row.choices[index].id
        if not isStringEqual(value, playbackValue(row.key)) then m.answers[row.key] = value
    end if

    drawPlayback()
    applyFocus()
end sub

' The focused part of the column is brought into view, and it goes back to the top for the rows
sub scrollColumn()
    if not isValid(m.playbackGroup) then return

    viewHeight = COLUMN_CLIP_BOTTOM - COLUMN_Y
    contentBottom = m.playbackTop + m.playbackBottom
    target = m.columnScroll
    if isStringEqual(m.focusZone, "rows")
        target = 0
    else if isStringEqual(m.focusZone, "playback") and m.playbackIndex < m.playbackItems.count()
        item = m.playbackItems[m.playbackIndex]
        itemTop = m.playbackTop + item.top
        itemBottom = itemTop + item.height
        ' The settings path under the last row comes into view with it
        if m.playbackIndex = m.playbackItems.count() - 1 then itemBottom = contentBottom
        if itemBottom - target > viewHeight then target = itemBottom - viewHeight
        if itemTop - target < 0 then target = itemTop
    end if

    maxScroll = contentBottom - viewHeight
    if target > maxScroll then target = maxScroll
    if target < 0 then target = 0
    m.columnScroll = target
    m.column.translation = [COLUMN_X, COLUMN_Y - target]
end sub

sub applyFocus()
    palette = setupPreviewDraw.Palette()

    index = 0
    for each row in m.rows
        row.focused = isStringEqual(m.focusZone, "rows") and index = m.rowIndex
        index++
    end for
    ' The stage and caption keep showing the last row focus was on while it sits elsewhere
    index = 0
    for each preview in m.previews
        preview.visible = index = m.rowIndex or m.previews.count() = 1
        index++
    end for
    drawCaption(palette)

    if m.playbackIndex >= m.playbackItems.count() then m.playbackIndex = m.playbackItems.count() - 1
    if m.playbackIndex < 0 then m.playbackIndex = 0
    index = 0
    for each item in m.playbackItems
        focused = isStringEqual(m.focusZone, "playback") and index = m.playbackIndex
        item.border.blendColor = focused ? palette.onSurface : playbackOverlay.WithAlpha(palette.onSurface, 36)
        item.fill.blendColor = playbackOverlay.WithAlpha(palette.onSurface, focused ? 26 : 10)
        index++
    end for
    scrollColumn()

    faded = playbackOverlay.WithAlpha(palette.onSurface, 158)
    skipFocused = isStringEqual(m.focusZone, "skip")
    m.skipLabel.color = skipFocused ? palette.onSurface : faded
    m.skipUnderline.visible = skipFocused

    backFocused = isStringEqual(m.focusZone, "back")
    m.backLabel.color = backFocused ? palette.onSurface : faded
    m.backUnderline.visible = backFocused and m.backLabel.visible

    m.nextRing.visible = isStringEqual(m.focusZone, "next")
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' BACK never leaves the wizard on the first press. It moves to Skip, so
    ' the way out is always something the user chose to press twice.
    if key = "back"
        if isStringEqual(m.focusZone, "skip")
            doSkip()
        else
            m.focusZone = "skip"
            applyFocus()
        end if
        return true
    end if

    if key = "OK"
        handleSelect()
        return true
    end if

    if key = "left" or key = "right" or key = "up" or key = "down"
        handleArrow(key)
        return true
    end if

    return false
end function

sub handleSelect()
    if isStringEqual(m.focusZone, "rows")
        selectRow(m.rowIndex)
    else if isStringEqual(m.focusZone, "playback")
        selectPlaybackRow()
        applyFocus()
    else if isStringEqual(m.focusZone, "skip")
        doSkip()
    else if isStringEqual(m.focusZone, "back")
        goBack()
    else if isStringEqual(m.focusZone, "next")
        advance()
    end if
end sub

' The list is one straight line: up off the top reaches Skip, down off the bottom or right from
' anywhere reaches Next
sub handleArrow(key as string)
    zone = m.focusZone
    if isStringEqual(zone, "rows")
        if key = "up" and m.rowIndex > 0
            m.rowIndex--
        else if key = "up"
            m.focusZone = "skip"
        else if key = "down" and m.rowIndex < m.rows.count() - 1
            m.rowIndex++
        else if key = "down" and isValid(m.playbackGroup)
            m.focusZone = "playback"
            m.playbackIndex = 0
        else if key = "down" or key = "right"
            m.focusZone = "next"
        end if
    else if isStringEqual(zone, "playback")
        if key = "up" and m.playbackIndex > 0
            m.playbackIndex--
        else if key = "up"
            m.focusZone = "rows"
        else if key = "down" and m.playbackIndex < m.playbackItems.count() - 1
            m.playbackIndex++
        else if key = "down" or key = "right"
            m.focusZone = "next"
        end if
    else if isStringEqual(zone, "skip")
        if key = "down" then m.focusZone = m.lastContentZone
    else if isStringEqual(zone, "next")
        if key = "up"
            m.focusZone = m.lastContentZone
        else if key = "left" and m.backLabel.visible
            m.focusZone = "back"
        else if key = "left"
            m.focusZone = m.lastContentZone
        end if
    else if isStringEqual(zone, "back")
        if key = "right"
            m.focusZone = "next"
        else if key = "up"
            m.focusZone = m.lastContentZone
        end if
    end if

    ' The way back from Skip and the buttons lands where the viewer last was
    if isStringEqual(m.focusZone, "rows") or isStringEqual(m.focusZone, "playback") then m.lastContentZone = m.focusZone
    applyFocus()
end sub

' Choosing marks the row without moving on. A theme is the exception that applies at once.
sub selectRow(index as integer)
    if m.onTour
        applyTheme(index)
        return
    end if
    key = rokuKeyFor(m.steps[m.stepIndex])
    if key = "" then return
    m.answers[key] = m.options[index].value
    i = 0
    for each row in m.rows
        row.selected = i = index
        i++
    end for
end sub

' Written straight away rather than held back with the rest, because the
' point is that the wizard restyles around you
sub applyTheme(index as integer)
    themeId = m.options[index].value
    theme = themeRegistry.ReadBundledTheme(themeId)
    if not isValid(theme) then return

    themeApply.ApplyTheme(theme, m.top.getScene())

    pushData = settingsSync.PreparePush("ui.theme.customThemeId", themeId)
    if isValid(pushData)
        m.themePushTask = createObject("roSGNode", "PostTask")
        m.themePushTask.apiUrl = pushData.url
        m.themePushTask.stringData = pushData.body
        m.themePushTask.control = "RUN"
    end if

    ' The theme just applied is now the chosen row, so focus comes back to it
    buildStep()
end sub

sub advance()
    if m.stepIndex >= m.steps.count() - 1
        finish()
        return
    end if
    m.stepIndex++
    buildStep()
end sub

sub goBack()
    if m.stepIndex = 0 then return
    m.stepIndex--
    buildStep()
end sub

' Skipping leaves without answering anything, and without being asked again.
' Writing the defaults here would mark them as deliberate choices and stop
' any future device from asking, so only the completion mark lands.
sub doSkip()
    setupWizardGate.MarkComplete()
    closeWizard()
end sub

sub finish()
    ' With subtitles off the language stays as it was
    if isStringEqual(playbackValue(SUBTITLE_MODE_KEY), "None") then m.answers.Delete(SUBTITLE_LANGUAGE_KEY)

    for each key in m.answers
        set_user_setting(key, m.answers[key])
    end for

    ' Held rather than pushed as they are chosen, so the answers across the
    ' steps land on the server as one batch
    if m.answers.count() > 0 and settingsSync.IsSyncEnabled()
        profileData = {}
        for each key in m.answers
            mapping = settingsSync.FindMappingByRokuKey(key)
            if isValid(mapping)
                pluginValue = settingsSync.RokuToPlugin(m.answers[key], mapping.type)
                if isValid(pluginValue) then profileData[mapping.pluginKey] = pluginValue
            end if
        end for
        if profileData.count() > 0
            pushData = settingsSync.ProfilePush(profileData)
            m.profilePushTask = createObject("roSGNode", "PostTask")
            m.profilePushTask.apiUrl = pushData.url
            m.profilePushTask.stringData = pushData.body
            m.profilePushTask.control = "RUN"
        end if
    end if
    m.userConfigTask = userConfigSync.Push(m.answers)

    setupWizardGate.MarkComplete()
    if m.top.rerun then applyLiveChanges()
    closeWizard()
end sub

' On a re-run home already exists, so the choices are applied the same way
' the settings screen applies them. On a first run Main reads the fresh
' values right after the wizard returns and none of this is needed.
sub applyLiveChanges()
    mediaBarMode = m.answers["ui.home.mediaBarMode"]
    if isValidAndNotEmpty(mediaBarMode) and not isStringEqual(mediaBarMode, m.initialMediaBarMode)
        if m.global.hasField("mediaBarModeChanged")
            m.global.mediaBarModeChanged = m.global.mediaBarModeChanged + 1
        end if
    end if

    navPosition = m.answers["navbar.position"]
    if isValidAndNotEmpty(navPosition) and not isStringEqual(navPosition, m.initialNavPosition)
        scene = m.top.getScene()
        if isValid(scene)
            overhang = scene.findNode("overhang")
            sidebar = scene.findNode("sidebar")
            if isStringEqual(navPosition, "left")
                if isValid(overhang)
                    overhang.visible = false
                    overhang.isVisible = false
                end if
                if isValid(sidebar)
                    sidebar.visible = true
                    sidebar.callFunc("loadLibraries")
                end if
            else
                if isValid(sidebar)
                    sidebar.visible = false
                end if
                if isValid(overhang)
                    overhang.visible = true
                    overhang.isVisible = true
                    overhang.callFunc("loadLibraries")
                end if
            end if
            m.global.sceneManager.callFunc("refreshNavReference")
            if m.global.hasField("navPositionChanged")
                m.global.navPositionChanged = m.global.navPositionChanged + 1
            end if
        end if
    end if
end sub

sub closeWizard()
    m.top.wizardDone = true
    if m.top.rerun then m.global.sceneManager.callFunc("popScene")
end sub

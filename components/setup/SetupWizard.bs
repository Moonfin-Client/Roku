import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/settingsSync.bs"
import "pkg:/source/utils/setupWizardGate.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeRegistry.bs"
import "pkg:/source/utils/userConfigSync.bs"

const AUDIO_LANGUAGE_KEY = "playback.audioPreferredLanguage"
const DEFAULT_TRACK_KEY = "playback.playDefaultAudioTrack"
const SUBTITLE_MODE_KEY = "playback.subs.mode"
const SUBTITLE_LANGUAGE_KEY = "playback.subs.language"

' The tour is the one step tall enough to scroll, so its body shows through this band
const TOUR_VIEW_TOP = 240
const TOUR_VIEW_BOTTOM = 900

const PLAYBACK_LEFT = 216
const PLAYBACK_TOP = 600
const PLAYBACK_WIDTH = 940
const PLAYBACK_HEADER_FOLDED = 108
const PLAYBACK_HEADER_OPEN = 76
const PLAYBACK_ROW_GAP = 12
const PLAYBACK_ROW_HEIGHT = 80
const PLAYBACK_HINT_ROW_HEIGHT = 112

' The first thing a new user sees after signing in: a few questions about how
' the app should look, each shown as preview cards, then a look at what else
' is in here. It only asks about things it cant work out on its own, and
' only about things a person can answer by looking.
sub init()
    m.top.optionsAvailable = false
    m.built = false
    m.steps = []
    m.stepIndex = 0
    m.answers = {}
    m.items = []
    m.cards = []
    m.swatches = []
    m.focusZone = "cards"
    m.cardIndex = 0
    m.swatchIndex = 0
    m.lastContentZone = "cards"
    m.playbackExpanded = false
    m.playbackIndex = 0
    m.playbackItems = []

    m.itemsTask = createObject("roSGNode", "SetupPreviewItemsTask")
    m.itemsTask.observeFieldScoped("items", "onPreviewItemsLoaded")
    m.itemsTask.control = "RUN"
end sub

sub OnScreenShown(_isReturning = false as boolean)
    if not m.built
        m.built = true
        m.steps = setupWizardGate.RemainingSteps(m.top.rerun)
        if m.steps.count() = 0
            ' Everything was answered on another device or an earlier visit,
            ' so there is nothing to show and nothing to ask again
            closeWizard()
            return
        end if
        ' What the answers were when the wizard opened, so a re-run can tell
        ' which live signals to send at the end
        m.initialNavPosition = effectiveValue("navbar")
        m.initialMediaBarMode = effectiveValue("mediaBar")
        buildShell()
        buildStep()
    end if
    m.top.setFocus(true)
end sub

sub onPreviewItemsLoaded()
    m.items = m.itemsTask.items
    for each card in m.cards
        card.items = m.items
    end for
end sub

' The static frame every step of the wizard sits in: dots, Skip, the
' question, and the Back and Next actions
sub buildShell()
    palette = setupPreviewDraw.Palette()

    m.background = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, palette.background)
    m.dotsGroup = m.top.createChild("Group")

    m.skipLabel = m.top.createChild("Label")
    m.skipLabel.font = "font:SmallSystemFont"
    m.skipLabel.text = tr("Skip setup")
    skipWidth = m.skipLabel.boundingRect().width
    m.skipLabel.translation = [1824 - skipWidth, 88]
    m.skipUnderline = setupPreviewDraw.Rect(m.top, 1824 - skipWidth, 132, skipWidth, 3, palette.onSurface)

    m.questionLabel = m.top.createChild("Label")
    m.questionLabel.font = "font:LargeSystemFont"
    m.questionLabel.width = 1920
    m.questionLabel.horizAlign = "center"
    m.questionLabel.translation = [0, 156]

    m.stepHolder = m.top.createChild("Group")

    m.backLabel = m.top.createChild("Label")
    m.backLabel.font = "font:SmallSystemFont"
    m.backLabel.text = tr("Back")
    backWidth = m.backLabel.boundingRect().width
    m.backLabel.translation = [96, 950]
    m.backUnderline = setupPreviewDraw.Rect(m.top, 96, 994, backWidth, 3, palette.onSurface)

    m.nextRing = setupPreviewDraw.Rect(m.top, 1556, 926, 272, 84, palette.onSurface)
    m.nextRect = setupPreviewDraw.Rect(m.top, 1560, 930, 264, 76, palette.accent)
    m.nextLabel = m.top.createChild("Label")
    m.nextLabel.font = "font:SmallBoldSystemFont"
    m.nextLabel.width = 264
    m.nextLabel.height = 76
    m.nextLabel.horizAlign = "center"
    m.nextLabel.vertAlign = "center"
    m.nextLabel.translation = [1560, 930]
end sub

' The tour restyles the shell live when a theme lands, so the colors are
' reapplied rather than set once
sub refreshShellPalette()
    palette = setupPreviewDraw.Palette()
    m.background.color = palette.background
    m.questionLabel.color = palette.onSurface
    m.nextRect.color = palette.accent
    m.nextLabel.color = palette.onAccent
end sub

function questionFor(stepName as string) as string
    if isStringEqual(stepName, "navbar") then return tr("Where should navigation go?")
    if isStringEqual(stepName, "mediaBar") then return tr("How should the top of your Home screen look?")
    if isStringEqual(stepName, "homeRows") then return tr("How should your rows look?")
    if isStringEqual(stepName, "detailStyle") then return tr("How should a movie or show look when you open it?")
    return tr("You're set. Here's what else is in here.")
end function

function rokuKeyFor(stepName as string) as string
    for each question in setupWizardGate.QuestionSteps()
        if isStringEqual(question.step, stepName) then return question.rokuKey
    end for
    return ""
end function

' The held answer when there is one, the current setting otherwise, which
' always exists because the defaults are merged into the session at load.
' Another client can have stored the detail style in its own spelling, so
' the token is brought back to the one the cards carry
function effectiveValue(stepName as string) as string
    key = rokuKeyFor(stepName)
    if key = "" then return ""
    held = m.answers[key]
    if isValidAndNotEmpty(held) then return held
    current = toString(m.global.session.user.settings[key])
    if isStringEqual(stepName, "detailStyle") then return normalizeDetailScreenStyleToken(current)
    return current
end function

function stepConfigs(stepName as string) as object
    if isStringEqual(stepName, "navbar")
        return [
            { value: "top", label: tr("Top Bar"), previewComponent: "SetupNavbarPreview", previewFields: { position: "top" } },
            { value: "left", label: tr("Left Sidebar"), previewComponent: "SetupNavbarPreview", previewFields: { position: "left" } }
        ]
    end if
    if isStringEqual(stepName, "mediaBar")
        configs = []
        for each mode in [["moonfin", "Moonfin"], ["makd", "MakD"], ["bookshelf", "Bookshelf"], ["gallery", "Gallery"], ["banner", "Banner"], ["aya", "Aya"], ["off", "Off"]]
            configs.push({ value: mode[0], label: tr(mode[1]), previewComponent: "SetupMediaBarPreview", previewFields: { mode: mode[0] } })
        end for
        return configs
    end if
    if isStringEqual(stepName, "homeRows")
        return [
            { value: "v1", label: tr("Classic"), hint: tr("Compact. More rows on screen at once."), previewComponent: "SetupHomeRowsPreview", previewFields: { modern: false } },
            { value: "v2", label: tr("Modern"), hint: tr("Larger cards with titles underneath."), previewComponent: "SetupHomeRowsPreview", previewFields: { modern: true } }
        ]
    end if
    return [
        { value: "classic", label: tr("Classic"), hint: tr("All the details on one page."), previewComponent: "SetupDetailPreview", previewFields: { variant: "classic" } },
        { value: "modern", label: tr("Modern"), hint: tr("Cinematic, with tabs for cast and extras."), previewComponent: "SetupDetailPreview", previewFields: { variant: "modern" } },
        { value: "spotlight", label: tr("Spotlight"), hint: tr("Artwork first, with cards that open what they name."), previewComponent: "SetupDetailPreview", previewFields: { variant: "spotlight" } },
        { value: "nouveau", label: tr("Nouveau"), hint: tr("Every section stacked down one page."), previewComponent: "SetupDetailPreview", previewFields: { variant: "nouveau" } },
        { value: "minimalist", label: tr("Minimalist"), hint: tr("Artwork, one play button and the episodes."), previewComponent: "SetupDetailPreview", previewFields: { variant: "minimalist" } }
    ]
end function

sub buildStep()
    while m.stepHolder.getChildCount() > 0
        m.stepHolder.removeChildIndex(0)
    end while
    m.cards = []
    m.swatches = []
    m.playbackItems = []
    m.tourBody = invalid

    palette = setupPreviewDraw.Palette()
    stepName = m.steps[m.stepIndex]
    m.questionLabel.text = questionFor(stepName)

    while m.dotsGroup.getChildCount() > 0
        m.dotsGroup.removeChildIndex(0)
    end while
    for i = 0 to m.steps.count() - 1
        color = i = m.stepIndex ? palette.onSurface : palette.onSurfaceFaint
        setupPreviewDraw.Rect(m.dotsGroup, 96 + i * 36, 92, 16, 16, color)
    end for

    m.backLabel.visible = m.stepIndex > 0
    isLast = m.stepIndex >= m.steps.count() - 1
    m.nextLabel.text = isLast ? tr("Done") : tr("Next")

    if isStringEqual(stepName, "tour")
        buildTour()
        m.focusZone = "swatches"
        m.lastContentZone = "swatches"
    else
        buildCards(stepName)
        m.focusZone = "cards"
        m.lastContentZone = "cards"
    end if
    refreshShellPalette()
    applyFocus()
end sub

sub buildCards(stepName as string)
    configs = stepConfigs(stepName)
    effective = effectiveValue(stepName)
    m.cardIndex = 0

    if configs.count() > 5
        previewWidth = 384
        previewHeight = 216
        columns = 4
        x0 = 144
        y0 = 290
        strideX = previewWidth + 32
        strideY = 302
    else
        ' One row across, with the previews shrunk when there are enough of them to need it
        roomy = configs.count() < 5
        previewWidth = roomy ? 720 : 336
        previewHeight = roomy ? 405 : 189
        gap = roomy ? 48 : 32
        columns = configs.count()
        x0 = (1920 - configs.count() * previewWidth - (configs.count() - 1) * gap) / 2
        y0 = roomy ? 280 : 340
        strideX = previewWidth + gap
        strideY = 0
    end if

    index = 0
    for each config in configs
        config.previewWidth = previewWidth
        config.previewHeight = previewHeight
        card = m.stepHolder.createChild("SetupOptionCard")
        card.config = config
        card.items = m.items
        card.translation = [x0 + (index mod columns) * strideX, y0 + Int(index / columns) * strideY]
        card.selected = isStringEqual(config.value, effective)
        if card.selected then m.cardIndex = index
        m.cards.push(card)
        index++
    end for
end sub

' Pick a look, the optional playback languages, then what else lives in Settings. Only the theme
' writes anything here, the languages go out with the rest of the answers.
sub buildTour()
    palette = setupPreviewDraw.Palette()

    tourView = m.stepHolder.createChild("Group")
    tourView.clippingRect = [0, TOUR_VIEW_TOP, 1920, TOUR_VIEW_BOTTOM - TOUR_VIEW_TOP]
    m.tourBody = tourView.createChild("Group")
    m.tourScroll = 0

    pickLabel = m.tourBody.createChild("Label")
    pickLabel.font = "font:SmallSystemFont"
    pickLabel.color = palette.onSurfaceDim
    pickLabel.text = tr("Pick a look")
    pickLabel.translation = [216, 260]

    activeThemeId = toString(m.global.session.user.settings["ui.theme.customThemeId"])
    if not isValidAndNotEmpty(activeThemeId) then activeThemeId = "moonfin"
    m.swatchIndex = 0

    index = 0
    for each themeId in themeRegistry.BuiltInIds()
        theme = themeRegistry.ReadBundledTheme(themeId)
        if isValid(theme)
            swatch = m.tourBody.createChild("SetupThemeSwatch")
            swatch.themeName = theme.displayName ?? themeId
            swatch.themeId = themeId
            swatch.translation = [216 + index * 320, 320]
            swatch.selected = isStringEqual(themeId, activeThemeId)
            if swatch.selected then m.swatchIndex = index
            m.swatches.push(swatch)
            index++
        end if
    end for

    m.playbackGroup = m.tourBody.createChild("Group")
    m.playbackGroup.translation = [PLAYBACK_LEFT, PLAYBACK_TOP]
    drawPlayback()

    setupPreviewDraw.Rect(m.tourBody, 1176, 316, 628, 468, palette.onSurfaceFaint)
    setupPreviewDraw.Rect(m.tourBody, 1180, 320, 620, 460, palette.surface)

    header = m.tourBody.createChild("Label")
    header.font = "font:MediumBoldSystemFont"
    header.color = palette.onSurface
    header.width = 540
    header.wrap = true
    header.text = tr("There is more waiting in Settings")
    header.translation = [1220, 360]

    bullets = [tr("Seerr requests"), tr("Live TV"), tr("Custom themes"), tr("And plenty more")]
    index = 0
    for each bullet in bullets
        line = m.tourBody.createChild("Label")
        line.font = "font:SmallSystemFont"
        line.color = palette.onSurfaceDim
        line.text = `• ${bullet}`
        line.translation = [1220, 470 + index * 54]
        index++
    end for
end sub

' ===== Playback languages =====

' The held answer when there is one, the current setting otherwise. Sign in has already filled
' these in from the server.
function playbackValue(rokuKey as string) as string
    held = m.answers[rokuKey]
    if isValidAndNotEmpty(held) then return held
    return toString(m.global.session.user.settings[rokuKey])
end function

' The same lists the audio and subtitle settings offer, read once
function playbackChoices(settingName as string) as object
    if not isValid(m.playbackChoices)
        tree = GetConfigTree()
        m.playbackChoices = {}
        for each key in [AUDIO_LANGUAGE_KEY, SUBTITLE_MODE_KEY, SUBTITLE_LANGUAGE_KEY]
            m.playbackChoices[key] = settingOptions(tree, key)
        end for
    end if
    return m.playbackChoices[settingName]
end function

function settingOptions(entries as object, settingName as string) as dynamic
    for each entry in entries
        if isStringEqual(entry.settingName, settingName) then return entry.options ?? []
        if isValid(entry.children)
            found = settingOptions(entry.children, settingName)
            if isValid(found) then return found
        end if
    end for
    return invalid
end function

' A language the server brought in that isnt in the list shows as its code
function choiceLabel(choices as object, value as string, fallback as string) as string
    for each choice in choices
        if isStringEqual(choice.id, value) then return tr(choice.title)
    end for
    return fallback
end function

function subtitleModeDescription(mode as string) as string
    if isStringEqual(mode, "Always") then return tr("Automatically loads and displays subtitles every time a video starts.")
    if isStringEqual(mode, "Smart") then return tr("Automatically turns on subtitles if the default audio track is in a foreign language.")
    if isStringEqual(mode, "OnlyForced") then return tr("Only loads subtitles explicitly tagged with the forced metadata flag.")
    if isStringEqual(mode, "None") then return tr("Completely disables automatic subtitle loading.")
    return tr("Plays tracks internally flagged in the media file's metadata as ""default"" or ""forced"".")
end function

' A header that shows the current answers while folded, opening downwards into its rows when
' pressed. It starts folded since the answers are already filled in.
sub drawPlayback()
    group = m.playbackGroup
    while group.getChildCount() > 0
        group.removeChildIndex(0)
    end while
    m.playbackItems = []

    palette = setupPreviewDraw.Palette()
    audioChoices = playbackChoices(AUDIO_LANGUAGE_KEY)
    modeChoices = playbackChoices(SUBTITLE_MODE_KEY)
    subtitleChoices = playbackChoices(SUBTITLE_LANGUAGE_KEY)
    audio = playbackValue(AUDIO_LANGUAGE_KEY)
    mode = playbackValue(SUBTITLE_MODE_KEY)
    subtitle = playbackValue(SUBTITLE_LANGUAGE_KEY)
    audioLabel = choiceLabel(audioChoices, audio, audio)
    modeLabel = choiceLabel(modeChoices, mode, choiceLabel(modeChoices, "Default", mode))
    subtitleLabel = choiceLabel(subtitleChoices, subtitle, subtitle)
    subtitlesOn = not isStringEqual(mode, "None")

    expanded = m.playbackExpanded
    headerHeight = expanded ? PLAYBACK_HEADER_OPEN : PLAYBACK_HEADER_FOLDED
    m.playbackItems.push(drawPlaybackPanel(0, headerHeight, palette))

    playbackIcon("pkg:/images/icons/translate.png", 30, 24, (headerHeight - 30) / 2, palette.onSurface)
    titleTop = expanded ? (headerHeight - 36) / 2 : 20
    title = playbackLabel(tr("Playback languages"), 70, titleTop, 28, palette.onSurface, true)
    playbackLabel(tr("Optional"), 70 + title.boundingRect().width + 16, titleTop + 4, 24, playbackOverlay.WithAlpha(palette.onSurface, 140), false)

    if not expanded
        summaryParts = [audioLabel]
        if subtitlesOn then summaryParts.push(subtitleLabel)
        summaryParts.push(modeLabel)
        summary = playbackLabel(summaryParts.join(" · "), 70, 62, 24, playbackOverlay.WithAlpha(palette.onSurface, 166), false)
        summary.width = PLAYBACK_WIDTH - 70 - 88
    end if

    chevron = playbackIcon("pkg:/images/icons/keyboard_arrow_down.png", 40, PLAYBACK_WIDTH - 64, (headerHeight - 40) / 2, playbackOverlay.WithAlpha(palette.onSurface, 179))
    if expanded
        chevron.scaleRotateCenter = [20, 20]
        chevron.rotation = 3.14159
    end if

    m.playbackRows = []
    if not expanded then return

    m.playbackRows.push({ key: AUDIO_LANGUAGE_KEY, label: tr("Default Audio Language"), choices: audioChoices, value: audioLabel })
    m.playbackRows.push({ key: DEFAULT_TRACK_KEY, label: tr("Prefer Default Audio Track"), hint: tr("Pick the track the file marks as default before matching languages") })
    ' Mode stays above the language so hiding the language doesnt move the focused row
    m.playbackRows.push({ key: SUBTITLE_MODE_KEY, label: tr("Subtitle Mode"), choices: modeChoices, value: modeLabel, described: true })
    if subtitlesOn then m.playbackRows.push({ key: SUBTITLE_LANGUAGE_KEY, label: tr("Default Subtitle Language"), choices: subtitleChoices, value: subtitleLabel })

    top = headerHeight
    for each row in m.playbackRows
        top += PLAYBACK_ROW_GAP
        height = isValid(row.hint) ? PLAYBACK_HINT_ROW_HEIGHT : PLAYBACK_ROW_HEIGHT
        m.playbackItems.push(drawPlaybackPanel(top, height, palette))

        trailingWidth = 72
        if isValid(row.choices)
            playbackIcon("pkg:/images/icons/chevron-right.png", 32, PLAYBACK_WIDTH - 64, top + (height - 32) / 2, playbackOverlay.WithAlpha(palette.onSurface, 140))
            value = playbackLabel(row.value, PLAYBACK_WIDTH - 472, top, 28, palette.onSurface, true)
            value.width = 400
            value.height = height
            value.horizAlign = "right"
            value.vertAlign = "center"
            trailingWidth = 440
        else
            drawPlaybackSwitch(toBoolean(playbackValue(row.key)) = true, PLAYBACK_WIDTH - 104, top + (height - 40) / 2, palette)
        end if

        label = playbackLabel(row.label, 32, top, 28, playbackOverlay.WithAlpha(palette.onSurface, 179), false)
        label.width = PLAYBACK_WIDTH - 32 - trailingWidth - 56
        if isValid(row.hint)
            label.translation = [32, top + 20]
            hint = playbackLabel(row.hint, 32, top + 60, 24, playbackOverlay.WithAlpha(palette.onSurface, 128), false)
            hint.width = label.width
        else
            label.height = height
            label.vertAlign = "center"
        end if

        top += height
    end for
end sub

' The box a header or a row sits in, lit up while focused
function drawPlaybackPanel(top as integer, height as integer, palette as object) as object
    border = setupPreviewDraw.Rect(m.playbackGroup, 0, top, PLAYBACK_WIDTH, height, playbackOverlay.WithAlpha(palette.onSurface, 36))
    setupPreviewDraw.Rect(m.playbackGroup, 2, top + 2, PLAYBACK_WIDTH - 4, height - 4, palette.background)
    fill = setupPreviewDraw.Rect(m.playbackGroup, 2, top + 2, PLAYBACK_WIDTH - 4, height - 4, playbackOverlay.WithAlpha(palette.onSurface, 10))
    return { top: top, height: height, border: border, fill: fill }
end function

' The row takes the press and the focus, the switch only shows the state
sub drawPlaybackSwitch(isOn as boolean, left as integer, top as integer, palette as object)
    trackInk = isOn ? palette.accent : playbackOverlay.WithAlpha(palette.onSurface, 64)
    track = playbackIcon("pkg:/images/details/btnfill.9.png", 40, left, top, trackInk)
    track.width = 72
    knobLeft = isOn ? left + 32 : left + 4
    playbackIcon("pkg:/images/icons/circle.png", 32, knobLeft, top + 4, isOn ? palette.onAccent : palette.onSurface)
end sub

function playbackLabel(text as string, left as integer, top as integer, size as integer, color as string, bold as boolean) as object
    label = m.playbackGroup.createChild("Label")
    label.font = bold ? "font:SmallBoldSystemFont" : "font:SmallSystemFont"
    label.font.size = size
    label.color = color
    label.text = text
    label.translation = [left, top]
    return label
end function

function playbackIcon(uri as string, size as integer, left as integer, top as integer, color as string) as object
    icon = m.playbackGroup.createChild("Poster")
    icon.uri = uri
    icon.width = size
    icon.height = size
    icon.blendColor = color
    icon.translation = [left, top]
    return icon
end function

' The header folds and unfolds, the switch flips, and a list row opens its picker
sub selectPlaybackRow()
    if m.playbackIndex = 0
        m.playbackExpanded = not m.playbackExpanded
        drawPlayback()
        return
    end if

    row = m.playbackRows[m.playbackIndex - 1]
    if not isValid(row.choices)
        m.answers[row.key] = toBoolean(playbackValue(row.key)) = true ? "false" : "true"
        drawPlayback()
        return
    end if

    current = playbackValue(row.key)
    labels = []
    details = []
    selected = -1
    for each choice in row.choices
        if isStringEqual(choice.id, current) then selected = labels.count()
        labels.push(tr(choice.title))
        if row.described = true then details.push(subtitleModeDescription(choice.id))
    end for

    m.pickerRow = row
    m.picker = CreateObject("roSGNode", "ListPromptDialog")
    m.picker.dialogTitle = row.label
    m.picker.options = labels
    m.picker.optionDetails = details
    m.picker.selectedOption = selected
    m.picker.openOnSelected = true
    m.picker.returnFocus = m.top
    m.picker.observeField("optionSelected", "onPlaybackPicked")
    m.top.getScene().appendChild(m.picker)
    m.picker.callFunc("showDialog")
end sub

sub onPlaybackPicked(event as object)
    index = event.getData()
    m.picker.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.picker)
    m.picker = invalid

    row = m.pickerRow
    if index >= 0 and index < row.choices.count()
        value = row.choices[index].id
        if not isStringEqual(value, playbackValue(row.key)) then m.answers[row.key] = value
    end if

    drawPlayback()
    applyFocus()
end sub

' The focused part is brought into view, and the band goes back to the top for the themes
sub scrollTourToFocus()
    if not isValid(m.tourBody) then return

    target = m.tourScroll
    if isStringEqual(m.focusZone, "swatches")
        target = 0
    else if isStringEqual(m.focusZone, "playback") and m.playbackIndex < m.playbackItems.count()
        item = m.playbackItems[m.playbackIndex]
        itemTop = PLAYBACK_TOP + item.top
        itemBottom = itemTop + item.height
        if itemBottom - target > TOUR_VIEW_BOTTOM then target = itemBottom - TOUR_VIEW_BOTTOM
        if itemTop - target < TOUR_VIEW_TOP then target = itemTop - TOUR_VIEW_TOP
    end if

    last = m.playbackItems[m.playbackItems.count() - 1]
    maxScroll = PLAYBACK_TOP + last.top + last.height - TOUR_VIEW_BOTTOM
    if target > maxScroll then target = maxScroll
    if target < 0 then target = 0

    m.tourScroll = target
    m.tourBody.translation = [0, -target]
end sub

sub applyFocus()
    palette = setupPreviewDraw.Palette()

    index = 0
    for each card in m.cards
        card.focused = isStringEqual(m.focusZone, "cards") and index = m.cardIndex
        index++
    end for
    index = 0
    for each swatch in m.swatches
        swatch.focused = isStringEqual(m.focusZone, "swatches") and index = m.swatchIndex
        index++
    end for

    if m.playbackIndex >= m.playbackItems.count() then m.playbackIndex = m.playbackItems.count() - 1
    index = 0
    for each item in m.playbackItems
        focused = isStringEqual(m.focusZone, "playback") and index = m.playbackIndex
        item.border.color = focused ? palette.onSurface : playbackOverlay.WithAlpha(palette.onSurface, 36)
        item.fill.color = playbackOverlay.WithAlpha(palette.onSurface, focused ? 26 : 10)
        index++
    end for
    scrollTourToFocus()

    skipFocused = isStringEqual(m.focusZone, "skip")
    m.skipLabel.color = skipFocused ? palette.onSurface : palette.onSurfaceDim
    m.skipUnderline.visible = skipFocused
    m.skipUnderline.color = palette.onSurface

    backFocused = isStringEqual(m.focusZone, "back")
    m.backLabel.color = backFocused ? palette.onSurface : palette.onSurfaceDim
    m.backUnderline.visible = backFocused and m.backLabel.visible

    m.nextRing.visible = isStringEqual(m.focusZone, "next")
end sub

' Which grid the cards sit in, so up and down can hop rows on the media bar
' step and leave the row on every other one
function cardColumns() as integer
    if m.cards.count() > 4 then return 4
    return m.cards.count()
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' BACK never leaves the wizard on the first press. It moves to Skip, so
    ' the way out is always something the user chose to press twice.
    if key = "back"
        if isStringEqual(m.focusZone, "skip")
            doSkip()
        else
            m.focusZone = "skip"
            applyFocus()
        end if
        return true
    end if

    if key = "OK"
        handleSelect()
        return true
    end if

    if key = "left" or key = "right" or key = "up" or key = "down"
        handleArrow(key)
        return true
    end if

    return false
end function

sub handleSelect()
    if isStringEqual(m.focusZone, "cards")
        selectCard(m.cardIndex)
    else if isStringEqual(m.focusZone, "swatches")
        applySwatchTheme(m.swatchIndex)
    else if isStringEqual(m.focusZone, "playback")
        selectPlaybackRow()
        applyFocus()
    else if isStringEqual(m.focusZone, "skip")
        doSkip()
    else if isStringEqual(m.focusZone, "back")
        goBack()
    else if isStringEqual(m.focusZone, "next")
        advance()
    end if
end sub

sub handleArrow(key as string)
    zone = m.focusZone
    if isStringEqual(zone, "cards")
        columns = cardColumns()
        if key = "left" and m.cardIndex > 0
            m.cardIndex--
        else if key = "right" and m.cardIndex < m.cards.count() - 1
            m.cardIndex++
        else if key = "up"
            if m.cardIndex >= columns
                m.cardIndex -= columns
            else
                m.focusZone = "skip"
            end if
        else if key = "down"
            if m.cardIndex + columns < m.cards.count()
                m.cardIndex += columns
            else
                m.focusZone = "next"
            end if
        end if
    else if isStringEqual(zone, "swatches")
        if key = "left" and m.swatchIndex > 0
            m.swatchIndex--
        else if key = "right" and m.swatchIndex < m.swatches.count() - 1
            m.swatchIndex++
        else if key = "up"
            m.focusZone = "skip"
        else if key = "down"
            m.focusZone = "playback"
            m.playbackIndex = 0
        end if
    else if isStringEqual(zone, "playback")
        if key = "up" and m.playbackIndex > 0
            m.playbackIndex--
        else if key = "up"
            m.focusZone = "swatches"
        else if key = "down" and m.playbackIndex < m.playbackItems.count() - 1
            m.playbackIndex++
        else if key = "down"
            m.focusZone = "next"
        end if
    else if isStringEqual(zone, "skip")
        if key = "down" then m.focusZone = m.lastContentZone
    else if isStringEqual(zone, "next")
        if key = "up"
            m.focusZone = m.lastContentZone
        else if key = "left" and m.backLabel.visible
            m.focusZone = "back"
        end if
    else if isStringEqual(zone, "back")
        if key = "right"
            m.focusZone = "next"
        else if key = "up"
            m.focusZone = m.lastContentZone
        end if
    end if

    ' The way back up from the actions lands where the viewer last was
    if isStringEqual(m.focusZone, "swatches") or isStringEqual(m.focusZone, "playback") then m.lastContentZone = m.focusZone
    applyFocus()
end sub

sub selectCard(index as integer)
    key = rokuKeyFor(m.steps[m.stepIndex])
    if key = "" then return
    m.answers[key] = m.cards[index].config.value
    i = 0
    for each card in m.cards
        card.selected = i = index
        i++
    end for
end sub

' Written straight away rather than held back with the rest, because the
' point is that the wizard restyles around you
sub applySwatchTheme(index as integer)
    themeId = m.swatches[index].themeId
    theme = themeRegistry.ReadBundledTheme(themeId)
    if not isValid(theme) then return

    themeApply.ApplyTheme(theme, m.top.getScene())

    pushData = settingsSync.PreparePush("ui.theme.customThemeId", themeId)
    if isValid(pushData)
        m.themePushTask = createObject("roSGNode", "PostTask")
        m.themePushTask.apiUrl = pushData.url
        m.themePushTask.stringData = pushData.body
        m.themePushTask.control = "RUN"
    end if

    savedIndex = m.swatchIndex
    buildStep()
    m.swatchIndex = savedIndex
    applyFocus()
end sub

sub advance()
    if m.stepIndex >= m.steps.count() - 1
        finish()
        return
    end if
    m.stepIndex++
    buildStep()
end sub

sub goBack()
    if m.stepIndex = 0 then return
    m.stepIndex--
    buildStep()
end sub

' Skipping leaves without answering anything, and without being asked again.
' Writing the defaults here would mark them as deliberate choices and stop
' any future device from asking, so only the completion mark lands.
sub doSkip()
    setupWizardGate.MarkComplete()
    closeWizard()
end sub

sub finish()
    ' With subtitles off the language stays as it was
    if isStringEqual(playbackValue(SUBTITLE_MODE_KEY), "None") then m.answers.Delete(SUBTITLE_LANGUAGE_KEY)

    for each key in m.answers
        set_user_setting(key, m.answers[key])
    end for

    ' Held rather than pushed as they are chosen, so the answers across the
    ' steps land on the server as one batch
    if m.answers.count() > 0 and settingsSync.IsSyncEnabled()
        profileData = {}
        for each key in m.answers
            mapping = settingsSync.FindMappingByRokuKey(key)
            if isValid(mapping)
                pluginValue = settingsSync.RokuToPlugin(m.answers[key], mapping.type)
                if isValid(pluginValue) then profileData[mapping.pluginKey] = pluginValue
            end if
        end for
        if profileData.count() > 0
            pushData = settingsSync.ProfilePush(profileData)
            m.profilePushTask = createObject("roSGNode", "PostTask")
            m.profilePushTask.apiUrl = pushData.url
            m.profilePushTask.stringData = pushData.body
            m.profilePushTask.control = "RUN"
        end if
    end if
    m.userConfigTask = userConfigSync.Push(m.answers)

    setupWizardGate.MarkComplete()
    if m.top.rerun then applyLiveChanges()
    closeWizard()
end sub

' On a re-run home already exists, so the choices are applied the same way
' the settings screen applies them. On a first run Main reads the fresh
' values right after the wizard returns and none of this is needed.
sub applyLiveChanges()
    mediaBarMode = m.answers["ui.home.mediaBarMode"]
    if isValidAndNotEmpty(mediaBarMode) and not isStringEqual(mediaBarMode, m.initialMediaBarMode)
        if m.global.hasField("mediaBarModeChanged")
            m.global.mediaBarModeChanged = m.global.mediaBarModeChanged + 1
        end if
    end if

    navPosition = m.answers["navbar.position"]
    if isValidAndNotEmpty(navPosition) and not isStringEqual(navPosition, m.initialNavPosition)
        scene = m.top.getScene()
        if isValid(scene)
            overhang = scene.findNode("overhang")
            sidebar = scene.findNode("sidebar")
            if isStringEqual(navPosition, "left")
                if isValid(overhang)
                    overhang.visible = false
                    overhang.isVisible = false
                end if
                if isValid(sidebar)
                    sidebar.visible = true
                    sidebar.callFunc("loadLibraries")
                end if
            else
                if isValid(sidebar)
                    sidebar.visible = false
                end if
                if isValid(overhang)
                    overhang.visible = true
                    overhang.isVisible = true
                    overhang.callFunc("loadLibraries")
                end if
            end if
            m.global.sceneManager.callFunc("refreshNavReference")
            if m.global.hasField("navPositionChanged")
                m.global.navPositionChanged = m.global.navPositionChanged + 1
            end if
        end if
    end if
end sub

sub closeWizard()
    m.top.wizardDone = true
    if m.top.rerun then m.global.sceneManager.callFunc("popScene")
end sub

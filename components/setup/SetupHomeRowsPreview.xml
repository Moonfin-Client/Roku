<?xml version="1.0" encoding="utf-8"?>
<component name="SetupHomeRowsPreview" extends="Group">
  <interface>
    <field id="modern" type="boolean" value="false" />
    <!-- Set by the settings live preview. The wizard leaves it empty and shows the community score. -->
    <field id="ratings" type="assocarray" />
    <!-- The Home Screen Backdrop style the settings preview draws behind the rows. The wizard leaves it empty and draws none. -->
    <field id="backdrop" type="string" />
    <!-- Set by the settings preview for the Row Options: Home's rows from the edited one down, drawn
         where Home draws them with the remote on the first card. The wizard leaves it empty. Each
         row is a title, its cell size, image type, whether its focused card widens, the width of
         that wide card and its items. -->
    <field id="rows" type="array" />
    <!-- The Cursor color from Settings. The wizard leaves it empty and draws the saved one. -->
    <field id="cursor" type="string" />
    <!-- Holds the first Classic card in focus too, so Cursor has a ring to show on. -->
    <field id="focusCard" type="boolean" value="false" />
    <field id="items" type="array" onChange="redraw" />
  </interface>
</component>

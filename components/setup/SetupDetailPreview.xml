<?xml version="1.0" encoding="utf-8"?>
<component name="SetupDetailPreview" extends="Group">
  <interface>
    <field id="variant" type="string" value="modern" />
    <!-- Set by the settings live preview. The wizard leaves them empty and gets the default page.
         The layout holds buttons, metadata, showBackdrop, blurAmount and technical. -->
    <field id="ratings" type="assocarray" />
    <field id="pageLayout" type="assocarray" />
    <field id="items" type="array" onChange="redraw" />
  </interface>
</component>

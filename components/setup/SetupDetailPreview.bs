import "pkg:/components/setup/setupPreviewDraw.bs"

' Detail screens, one per style the picker offers, filled with a real title's art and facts.

sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    m.items = m.top.items
    ' The settings live preview hands in what the details settings draw, and the wizard leaves it
    ' empty for the default page
    m.pageLayout = m.top.pageLayout
    m.live = isValid(m.pageLayout) and m.pageLayout.Count() > 0
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)

    style = LCase(m.top.variant)
    if style = "classic"
        drawClassic(pal)
    else if style = "spotlight"
        drawSpotlight(pal)
    else if style = "nouveau"
        drawNouveau(pal)
    else if style = "minimalist"
        drawMinimalist(pal)
    else if style = "stage"
        drawStage(pal)
    else if style = "premiere"
        drawPremiere(pal)
    else if style = "quicklook"
        drawQuickLook(pal)
    else if style = "frost"
        drawFrost(pal)
    else
        drawModern(pal)
    end if
end sub

' One page over a dimmed backdrop: logo and facts down the left, the poster in the top right
' corner, the actions centered and the metadata card underneath. Classic is the one style that
' can go without its backdrop, and it asks the server for the picture already blurred.
sub drawClassic(pal as object)
    if not m.live or m.pageLayout.showBackdrop
        uri = setupPreviewDraw.ItemField(m.items, 0, "backdropUrl")
        if m.live and m.pageLayout.blurAmount > 0 and uri <> "" then uri = `${uri}&blur=${m.pageLayout.blurAmount}`
        setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, uri, pal.surfaceVariant)
    end if
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000C8")

    if sectionShown("poster") then setupPreviewDraw.Art(m.top, 1585, 140, 239, 360, setupPreviewDraw.ItemField(m.items, 0, "posterUrl"), pal.surfaceVariant)
    setupPreviewDraw.Logo(m.top, m.items, 0, 96, 130, 507, 116)
    shift = drawFacts(pal, 96, 280)
    drawOverview(pal, 96, 336 + shift, 1300, 2)

    ' Classic writes each button's name under it
    buttons = [["detail_play", tr("Play")]]
    if m.live
        for each button in m.pageLayout.buttons
            buttons.push([button.icon, button.label])
        end for
    else
        buttons.Append([["detail_trailer", tr("Trailer")], ["detail_watched", tr("Unwatched")], ["detail_favorite", tr("Favorite")], ["detail_shuffle", tr("Shuffle")]])
    end if
    drawClassicButtons(444 + shift, buttons)

    setupPreviewDraw.Round(m.top, 96, 590 + shift, 1728, 330, 16, "0xFFFFFF0D")
    found = setupPreviewDraw.Entry(m.items, 0)
    genres = ""
    if isValid(found.genres) then genres = found.genres.join(", ")
    columns = [[tr("Genres"), genres], [tr("Runtime"), found.runtime ?? ""], [tr("Director"), ""]]
    for column = 0 to 2
        x = 160 + column * 560
        setupPreviewDraw.TextLabel(m.top, UCase(columns[column][0]), x, 634 + shift, 24, pal.accent, true)
        if columns[column][1] = ""
            setupPreviewDraw.Round(m.top, x, 684 + shift, 300, 24, 12, pal.onSurfaceFaint)
        else
            value = setupPreviewDraw.TextLabel(m.top, columns[column][1], x, 676 + shift, 30, pal.onSurface, false)
            value.width = 480
        end if
    end for
end sub

' Cinematic: full bleed art, scrims darkening the left and bottom, the text block top left,
' buttons and the tab strip below
sub drawModern(pal as object)
    drawBackdrop(pal)
    gradient = 1.0
    if m.live
        scrim = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000FF")
        scrim.opacity = 0.8 * scrimFactor()
        gradient = 0.3 + 0.7 * scrimFactor()
    end if
    setupPreviewDraw.FadeRight(m.top, 0, 0, 1400, 1080, "0x000000", gradient)
    setupPreviewDraw.FadeUp(m.top, 0, 640, 1920, 440, "0x000000", 0.85 * gradient)

    setupPreviewDraw.Logo(m.top, m.items, 0, 96, 130, 500, 200)
    shift = drawFacts(pal, 96, 372)
    drawOverview(pal, 96, 428 + shift, 1000, 2)

    drawPillButtons(96, 560 + shift, rowButtons(["detail_trailer", "detail_watched", "detail_favorite", "detail_shuffle", "dotDotDot"]))

    ' The first tab opens with the page only while Expanded Tabs is on
    opened = not m.live or m.pageLayout.expandedTabs <> false
    x = 96
    index = 0
    tabs = sectionsShown([["", tr("Overview")], ["cast", tr("Cast")], ["extras", tr("Extras")], ["moreLikeThis", tr("Similar")]])
    for each shownTab in tabs
        ink = pal.onSurfaceDim
        if index = 0 and opened then ink = pal.onSurface
        label = setupPreviewDraw.TextLabel(m.top, shownTab[1], x, 972, 30, ink, true)
        tabWidth = label.boundingRect().width
        if index = 0 and opened then setupPreviewDraw.Rect(m.top, x, 1022, tabWidth, 6, pal.accent)
        x += tabWidth + 56
        index++
    end for
end sub

' Whether the Sections screen leaves a section on, which the wizard always does
function sectionShown(id as string) as boolean
    return not m.live or not isValid(m.pageLayout.hiddenSections) or not m.pageLayout.hiddenSections.DoesExist(id)
end function

' The [section id, name] pairs left on, where an empty id is a part no switch covers
function sectionsShown(parts as object) as object
    kept = []
    for each part in parts
        if part[0] = "" or sectionShown(part[0]) then kept.push(part)
    end for
    return kept
end function

' Artwork first: the hero sits high on the picture and a band of summary cards under it names
' what each one opens
sub drawSpotlight(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 640, 440)

    setupPreviewDraw.Logo(m.top, m.items, 0, 80, 142, 600, 150)
    shift = drawFacts(pal, 80, 312)
    drawOverview(pal, 80, 400 + shift, 1500, 3)

    drawPillButtons(80, 559 + shift, rowButtons(["detail_trailer", "detail_watched", "detail_favorite", "dotDotDot"]))

    index = 0
    shown = sectionsShown([["cast", tr("Cast")], ["extras", tr("Extras")], ["moreLikeThis", tr("More Like This")]])
    for each section in shown
        x = 80 + index * 412
        setupPreviewDraw.Round(m.top, x, 723 + shift, 380, 216, 16, "0xFFFFFF14")
        setupPreviewDraw.TextLabel(m.top, section[1], x + 28, 822 + shift, 30, pal.onSurface, true)
        setupPreviewDraw.Round(m.top, x + 28, 870 + shift, 160, 20, 10, pal.onSurfaceFaint)
        index++
    end for
end sub

' Every section stacked down one page, so the hero is shallow and two rails already sit under it
sub drawNouveau(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 500, 580)

    setupPreviewDraw.Logo(m.top, m.items, 0, 80, 96, 520, 124)
    shift = drawFacts(pal, 80, 236)
    drawOverview(pal, 80, 320 + shift, 1420, 2)

    ' Nouveau keeps Play open and leaves a little more room after it
    drawPillButtons(80, 424 + shift, rowButtons(["detail_watched", "detail_favorite", "dotDotDot"]), 18)

    ' The rails move up into the place of one that's switched off
    railY = 552 + shift
    if sectionShown("extras")
        drawRail(pal, tr("Extras"), railY, 5, 192, 108, "backdropUrl")
        railY += 188
    end if
    if sectionShown("moreLikeThis") then drawRail(pal, tr("More Like This"), railY, 7, 108, 162, "posterUrl")
end sub

' Mostly picture, with the title, one play button and the episodes along the bottom
sub drawMinimalist(pal as object)
    drawBackdrop(pal)
    scrim = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000008C")
    if m.live
        ' The same ramp minimalistRules.ScrimOpacity gives the real screen, copied here since
        ' importing it would pull the whole API client into this preview
        scrim.color = "0x000000FF"
        scrim.opacity = 0.35 + scrimFactor() * 0.5
    end if

    setupPreviewDraw.Logo(m.top, m.items, 0, 56, 639, 440, 104)
    drawPillButtons(56, 771, rowButtons(["detail_shuffle", "detail_favorite"]))

    for i = 0 to 3
        setupPreviewDraw.Art(m.top, 56 + i * 256, 899, 236, 133, setupPreviewDraw.ItemField(m.items, i + 1, "backdropUrl"), "0xFFFFFF29")
    end for
end sub

' The poster on the left with Play spanning it and the circles under that, and the title, facts and
' overview beside it
sub drawStage(pal as object)
    drawBackdrop(pal)
    ' The same floor and ramp the real screen darkens its picture by
    scrim = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000FF")
    scrim.opacity = 0.55 + 0.3 * scrimFactor()

    setupPreviewDraw.Art(m.top, 200, 172, 388, 583, setupPreviewDraw.ItemField(m.items, 0, "posterUrl"), pal.surfaceVariant)
    drawStageButtons(200, 782, rowButtons(["detail_trailer", "detail_watched", "detail_favorite", "dotDotDot"]))

    setupPreviewDraw.Logo(m.top, m.items, 0, 656, 172, 601, 173)
    shift = drawFacts(pal, 656, 372, stageScores(1184))
    drawOverview(pal, 656, 432 + shift, 1184, 4)
end sub

' Play as a pill the poster's width with focus on it, and up to three circles and More under it
sub drawStageButtons(x as float, y as float, icons as object)
    size = 87
    playHeight = 90
    focusInk = themeChrome.Token("onButtonFocused", "#000000FF")
    pill = setupPreviewDraw.Round(m.top, x, y, 388, playHeight, playHeight / 2, themeChrome.Token("buttonFocused", "#FFFFFF"))
    pill.opacity = 0.95
    setupPreviewDraw.Ring(m.top, x, y, 388, playHeight, playHeight / 2, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
    play = setupPreviewDraw.TextLabel(m.top, tr("Play"), 0, y, 23, focusInk, true)
    labelWidth = play.boundingRect().width
    left = x + (388 - 86 - labelWidth) / 2
    play.translation = [left + 86, y]
    play.height = playHeight
    play.vertAlign = "center"
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.webp", left, y + 24, 42, focusInk)

    restFill = themeChrome.Token("buttonNormal", "#FFFFFF")
    restInk = themeChrome.Token("onButtonNormal", "#FFFFFFFF")
    top = y + playHeight + 21
    bx = x
    for i = 0 to icons.count() - 1
        if i > 3 then exit for
        fill = setupPreviewDraw.Round(m.top, bx, top, size, size, size / 2, restFill)
        fill.opacity = 0.06
        border = setupPreviewDraw.Ring(m.top, bx, top, size, size, size / 2, "0xFFFFFFFF")
        border.opacity = 0.35
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icons[i]}.webp`, bx + 23, top + 23, 41, restInk)
        bx += size + 13
    end for
end sub

' The title centered at the foot of a backdrop that fills the screen, with the facts and the overview
' under it, then Play and the circles, and an arrow saying the page runs on. It's laid out from the
' foot up, the way the real screen is.
sub drawPremiere(pal as object)
    drawBackdrop(pal)
    ' The same shading the real screen fades its picture with, darker as the blur slider goes up
    shade = 0.6 + 0.4 * scrimFactor()
    setupPreviewDraw.Scrim(m.top, "pkg:/images/details/premiere/vignette.webp", 0, 0, 1920, 1080, pal.background, shade)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/details/premiere/fade.webp", 0, 0, 1920, 1080, pal.background, 1)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/details/premiere/fade_dim.webp", 0, 0, 1920, 1080, pal.background, shade)

    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/keyboard_arrow_down.webp", 935, 1010, 50, playbackOverlay.WithAlpha(pal.onSurface, 166))
    ' The scores open the sections under the buttons, so they sit over the arrow and lift the rest
    lift = 0
    scoresRow = setupPreviewDraw.RatingsLine(m.top, m.top.ratings, 0, 0, stageScores(1552))
    if isValid(scoresRow)
        bounds = scoresRow.boundingRect()
        lift = bounds.height
        scoresRow.translation = [(1920 - bounds.width) / 2, 990 - lift]
    end if
    drawPremiereButtons(863 - lift, rowButtons(["detail_trailer", "detail_watched", "detail_favorite", "add_to_playlist", "dotDotDot"]))

    overview = setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), 326, 756 - lift, 1269, 23, 2, playbackOverlay.WithAlpha(pal.onSurface, 209))
    overview.horizAlign = "center"
    ' A wrapped label with no height can stop at its first line
    overview.height = 76
    y = 739 - lift

    if m.live and m.pageLayout.technical
        chips = m.top.createChild("Group")
        drawTechChips(0, 0, chips)
        y -= 36
        chips.translation = [(1920 - chips.boundingRect().width) / 2, y]
        y -= 10
    end if

    order = invalid
    if m.live then order = m.pageLayout.metadata
    facts = m.top.createChild("Group")
    setupPreviewDraw.MetaLine(facts, m.items, 0, leadScore(facts, 0, 0, 26, pal.onSurface), 0, 26, playbackOverlay.WithAlpha(pal.onSurface, 230), order)
    y -= 32
    facts.translation = [(1920 - facts.boundingRect().width) / 2, y]

    logo = setupPreviewDraw.Logo(m.top, m.items, 0, 526, y - 20 - 238, 868, 238, 100)
    if logo.isSubtype("Label")
        logo.text = UCase(logo.text)
        logo.horizAlign = "center"
    end if
end sub

' Play as a pill as wide as its label with focus on it, and the circles after it, the whole row
' centered unless it's given where to start
sub drawPremiereButtons(y as float, icons as object, left = -1 as float)
    size = 87
    gap = 14
    playHeight = 90
    focusInk = themeChrome.Token("onButtonFocused", "#000000FF")
    pill = setupPreviewDraw.Round(m.top, 0, y, playHeight, playHeight, playHeight / 2, themeChrome.Token("buttonFocused", "#FFFFFF"))
    pill.opacity = 0.95
    ring = setupPreviewDraw.Ring(m.top, 0, y, playHeight, playHeight, playHeight / 2, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
    playIcon = setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.webp", 0, y + 24, 42, focusInk)
    play = setupPreviewDraw.TextLabel(m.top, tr("Play"), 0, y, 23, focusInk, true)

    ' The pill is only as wide as its word, and the row centers once that's known
    pillWidth = play.boundingRect().width + 143
    x = (1920 - pillWidth - icons.count() * (size + gap)) / 2
    if left >= 0 then x = left
    pill.translation = [x, y]
    pill.width = pillWidth
    ring.translation = [x, y]
    ring.width = pillWidth
    playIcon.translation = [x + 28, y + 24]
    play.translation = [x + 114, y]
    play.height = playHeight
    play.vertAlign = "center"

    restFill = themeChrome.Token("buttonNormal", "#FFFFFF")
    restInk = themeChrome.Token("onButtonNormal", "#FFFFFFFF")
    bx = x + pillWidth + gap
    top = y + (playHeight - size) / 2
    for each icon in icons
        fill = setupPreviewDraw.Round(m.top, bx, top, size, size, size / 2, restFill)
        fill.opacity = 0.06
        border = setupPreviewDraw.Ring(m.top, bx, top, size, size, size / 2, "0xFFFFFFFF")
        border.opacity = 0.35
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icon}.webp`, bx + 23, top + 23, 41, restInk)
        bx += size + gap
    end for
end sub

' The drawer down the right over a dimmed row of titles: the picture fading into it, the title, its
' facts and the buttons, and Open full page at its foot
sub drawQuickLook(pal as object)
    for i = 0 to 4
        setupPreviewDraw.Art(m.top, 80 + i * 350, 172, 320, 480, setupPreviewDraw.ItemField(m.items, i, "posterUrl"), pal.surfaceVariant)
    end for
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000009E")
    setupPreviewDraw.Rect(m.top, 960, 0, 960, 1080, pal.background)

    y = 107
    if not m.live or m.pageLayout.showBackdrop
        setupPreviewDraw.Art(m.top, 960, 0, 960, 346, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), pal.surfaceVariant)
        setupPreviewDraw.Scrim(m.top, "pkg:/images/details/quicklook/fade.webp", 960, 138, 960, 208, pal.background, 1)
        y = 289
    end if
    hint = setupPreviewDraw.TextLabel(m.top, tr("Back to close"), 0, 23, 20, "0xFFFFFFD9", false)
    hintWidth = hint.boundingRect().width + 40
    setupPreviewDraw.Round(m.top, 1897 - hintWidth, 23, hintWidth, 46, 23, "0x00000080")
    hint.translation = [1917 - hintWidth, 23]
    hint.height = 46
    hint.vertAlign = "center"
    ' It was measured before its pill was drawn, so it goes back on top of it
    m.top.removeChild(hint)
    m.top.appendChild(hint)

    title = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(m.items, 0, "title"), 1003, y, 45, pal.onSurface, true)
    title.width = 874
    y += title.boundingRect().height + 10
    order = invalid
    if m.live then order = m.pageLayout.metadata
    setupPreviewDraw.MetaLine(m.top, m.items, 0, leadScore(m.top, 1003, y, 22, pal.onSurface), y, 22, playbackOverlay.WithAlpha(pal.onSurface, 230), order)
    y += 32
    if m.live and m.pageLayout.technical
        y += 10
        drawTechChips(1003, y)
        y += 36
    end if

    ' The drawer leaves the sources' names off whatever the setting says
    look = stageScores(874)
    look.showNames = false
    scoresRow = setupPreviewDraw.RatingsLine(m.top, m.top.ratings, 1003, y + 17, look)
    if isValid(scoresRow) then y += 17 + scoresRow.boundingRect().height

    y += 27
    drawPremiereButtons(y, rowButtons(["detail_trailer", "detail_watched", "detail_favorite", "add_to_playlist", "dotDotDot"]), 1003)
    overview = setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), 1003, y + 147, 874, 23, 3, playbackOverlay.WithAlpha(pal.onSurface, 209))
    ' A wrapped label with no height can stop short of its lines
    overview.height = 105

    setupPreviewDraw.Ring(m.top, 1003, 966, 874, 77, 38, "0xFFFFFF40")
    open = setupPreviewDraw.TextLabel(m.top, tr("Open full page"), 0, 966, 23, pal.onSurface, true)
    openWidth = open.boundingRect().width
    open.translation = [1440 - (openWidth + 40) / 2, 966]
    open.height = 77
    open.vertAlign = "center"
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/chevron-right.webp", 1450 + (openWidth - 40) / 2, 989, 30, pal.onSurface)

    ' The same lift off the page color the real drawer has
    tint = setupPreviewDraw.Rect(m.top, 960, 0, 960, 1080, "0xFFFFFFFF")
    tint.opacity = 0.03
end sub

' The art blurred and dimmed behind a glass window that holds it sharp, with the title at the window's
' foot, the buttons in a capsule over its edge and the tabs in a bar under them
sub drawFrost(pal as object)
    shown = not m.live or m.pageLayout.showBackdrop
    uri = setupPreviewDraw.ItemField(m.items, 0, "backdropUrl")
    if shown and uri <> "" then setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, `${uri}&blur=30`, pal.surfaceVariant)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000008C")
    setupPreviewDraw.Shape(m.top, "pkg:/images/details/frost/vignette.webp", 0, 0, 1920, 1080, "0x000000FF")

    setupPreviewDraw.Round(m.top, 36, 18, 1848, 843, 66, "0x1C1C208C")
    if shown
        window = m.top.createChild("ScreenMask")
        window.translation = [36, 18]
        window.maskUri = "pkg:/images/details/frost/window_mask.webp"
        window.size = [1848, 843]
        setupPreviewDraw.Art(window, 0, 0, 1848, 843, uri, pal.surfaceVariant)
        for each fade in ["fade_up", "fade_right"]
            setupPreviewDraw.Scrim(window, `pkg:/images/details/frost/${fade}.webp`, 0, 0, 1848, 843, "0x0C0C0EFF", 1)
        end for
    end if

    title = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(m.items, 0, "title"), 120, 270, 96, "0xFFFFFFFF", true)
    title.width = 1470
    order = invalid
    if m.live then order = m.pageLayout.metadata
    setupPreviewDraw.MetaLine(m.top, m.items, 0, leadScore(m.top, 120, 393, 27, "0xFFFFFFFF"), 393, 27, "0xEBEBF5C7", order)
    ' The scores in a strip of columns between two hairlines, over the overview
    frostScores = { columns: true, labelFont: "font:SmallestBoldSystemFont", valueFont: "font:SmallestBoldSystemFont", nameSize: 18, valueSize: 42, columnsWidth: 1560, columnsHeight: 150 }
    if isValid(setupPreviewDraw.RatingsLine(m.top, m.top.ratings, 120, 462, frostScores))
        setupPreviewDraw.Rect(m.top, 120, 462, 1560, 1.5, "0xFFFFFF24")
        setupPreviewDraw.Rect(m.top, 120, 610.5, 1560, 1.5, "0xFFFFFF24")
    end if
    overview = setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), 120, 648, 960, 27, 3, playbackOverlay.WithAlpha(pal.onSurface, 230))
    ' A wrapped label with no height can stop short of its lines
    overview.height = 117

    ' Play as a white pill with focus on it, and the rest as bare icons, in a capsule centered over the
    ' window's foot
    icons = rowButtons(["detail_restart", "detail_trailer", "detail_watched", "detail_favorite", "dotDotDot"])
    play = setupPreviewDraw.TextLabel(m.top, tr("Play"), 0, 819, 29, "0x000000FF", true)
    pillWidth = play.boundingRect().width + 128
    if pillWidth < 300 then pillWidth = 300
    barWidth = pillWidth + 18 + icons.count() * 99 - 9 + 24
    left = 960 - barWidth / 2
    setupPreviewDraw.Round(m.top, left, 807, barWidth, 114, 57, "0x303036E6")
    glow = setupPreviewDraw.Round(m.top, left + 6, 813, pillWidth + 12, 102, 51, "0xFFFFFFFF")
    glow.opacity = 0.3
    setupPreviewDraw.Round(m.top, left + 12, 819, pillWidth, 90, 45, "0xFFFFFFFF")
    content = (pillWidth - play.boundingRect().width - 44) / 2
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.webp", left + 12 + content, 849.5, 29, "0x000000FF")
    play.translation = [left + 12 + content + 44, 819]
    play.height = 90
    play.vertAlign = "center"
    ' It was measured before the pill was drawn, so it goes back on top of it
    m.top.removeChild(play)
    m.top.appendChild(play)
    x = left + 12 + pillWidth + 18
    for each icon in icons
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icon}.webp`, x + 26, 845, 38, "0xFFFFFFFF")
        x += 99
    end for

    ' The tabs under the buttons, with Overview open
    tabs = []
    kept = sectionsShown([["", "smart_display_outlined", tr("Overview")], ["cast", "people_outline", tr("Cast & Crew")], ["moreLikeThis", "grid_view", tr("More Like This")], ["", "info_outline", tr("Details")]])
    for each shownTab in kept
        tabs.push([shownTab[1], shownTab[2]])
    end for
    measure = CreateObject("roSGNode", "Label")
    measure.font = "font:SmallBoldSystemFont"
    measure.font.size = 24
    widths = []
    barWidth = 18 - 6
    for each entry in tabs
        measure.text = entry[1]
        widths.push(measure.boundingRect().width + 102)
        barWidth += widths.peek() + 6
    end for
    x = 960 - barWidth / 2
    setupPreviewDraw.Round(m.top, x, 936, barWidth, 90, 45, "0x303036E6")
    setupPreviewDraw.Round(m.top, x + 9, 945, widths[0], 72, 36, "0xFFFFFF29")
    x += 9
    for i = 0 to tabs.count() - 1
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${tabs[i][0]}.webp`, x + 27, 964.5, 33, "0xFFFFFFFF")
        label = setupPreviewDraw.TextLabel(m.top, tabs[i][1], x + 75, 945, 24, "0xFFFFFFFF", true)
        label.height = 72
        label.vertAlign = "center"
        x += widths[i] + 6
    end for
end sub

' ===== Pieces the styles share =====

sub drawBackdrop(pal as object)
    if m.live and not m.pageLayout.showBackdrop then return
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), pal.surfaceVariant)
end sub

' The real screens read Background Blur as how strong their scrims are, out of 25. The wizard
' draws them at the default of 10.
function scrimFactor() as float
    if not m.live then return 0.4
    return m.pageLayout.blurAmount / 25.0
end function

' The wash and the two fades the artwork-first styles lay over the picture. They blend with the
' page color rather than with black, the way the real screens do, so the picture keeps its color
sub drawArtworkScrims(pal as object, fadeY as float, fadeHeight as float)
    scrim = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000FF")
    scrim.opacity = 0.8 * scrimFactor()
    gradient = 0.3 + 0.7 * scrimFactor()
    setupPreviewDraw.FadeRight(m.top, 0, 0, 1400, 1080, pal.background, gradient)
    setupPreviewDraw.FadeUp(m.top, 0, fadeY, 1920, fadeHeight, pal.background, gradient)
end sub

' The facts line, then the file's chips and the scores under it when the settings show them, in
' the order the real headers stack them. The look styles the scores like the real screen's. Returns
' how far the chips and scores push the rest of the page down.
function drawFacts(pal as object, x as float, y as float, look = invalid as dynamic) as float
    order = invalid
    if m.live then order = m.pageLayout.metadata
    setupPreviewDraw.MetaLine(m.top, m.items, 0, leadScore(m.top, x, y, 26, pal.onSurface), y, 26, playbackOverlay.WithAlpha(pal.onSurface, 230), order)
    if not m.live then return 0

    below = y + 52
    if m.pageLayout.technical then below += drawTechChips(x, below) + 14
    scoresRow = setupPreviewDraw.RatingsLine(m.top, m.top.ratings, x, below, look)
    if isValid(scoresRow) then below += scoresRow.boundingRect().height + 14
    return below - y - 52
end function

' The wizard has no scores to hand in, so it leads the facts with the community score instead of
' drawing the row. Returns where the facts start.
function leadScore(parent as object, x as float, y as float, size as integer, ink as string) as float
    if m.live then return x
    after = setupPreviewDraw.Score(parent, m.items, 0, x, y, size, ink)
    if after > x then after += 24
    return after
end function

' The scores at the size Stage draws them, which Premiere and Quick Look keep, in the room each gives
function stageScores(maxWidth as float) as object
    return { valueSize: 27, nameSize: 17, iconHeight: 34, maxWidth: maxWidth }
end function

' Sample chips for what the file is, outlined like the real ones. Returns their height.
function drawTechChips(x as float, y as float, parent = invalid as dynamic) as float
    if parent = invalid then parent = m.top
    at = x
    for each text in ["4K", "HDR10", "HEVC", "MKV", "5.1", "EAC3"]
        label = setupPreviewDraw.TextLabel(parent, text, at + 12, y, 22, "0xFFFFFFCC", false)
        chipWidth = label.boundingRect().width + 24
        label.height = 36
        label.vertAlign = "center"
        setupPreviewDraw.Ring(parent, at, y, chipWidth, 36, 6, "0xFFFFFF4D")
        at += chipWidth + 9
    end for
    return 36
end function

' The buttons after Play, the saved arrangement's once the settings preview hands one in
function rowButtons(fallback as object) as object
    if not m.live then return fallback
    icons = []
    for each button in m.pageLayout.buttons
        icons.push(button.icon)
    end for
    return icons
end function

sub drawOverview(pal as object, x as float, y as float, width as float, lines as integer)
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), x, y, width, 26, lines, playbackOverlay.WithAlpha(pal.onSurface, 204))
end sub

sub drawRail(pal as object, title as string, y as float, count as integer, cardWidth as float, cardHeight as float, field as string)
    setupPreviewDraw.TextLabel(m.top, title, 80, y - 8, 30, pal.onSurface, true)
    for i = 0 to count - 1
        setupPreviewDraw.Art(m.top, 80 + i * (cardWidth + 20), y + 44, cardWidth, cardHeight, setupPreviewDraw.ItemField(m.items, i + 1, field), "0xFFFFFF24")
    end for
end sub

' The real buttons of the four newer styles, at their real size: 75 px circles on faint glass with
' a hairline round them, led by Play as the open pill that focus starts on, its word showing
sub drawPillButtons(x as float, y as float, icons as object, leadGap = 12 as integer)
    size = 75
    focusInk = themeChrome.Token("onButtonFocused", "#000000FF")
    restFill = themeChrome.Token("buttonNormal", "#FFFFFF")
    restInk = themeChrome.Token("onButtonNormal", "#FFFFFFFF")

    pill = setupPreviewDraw.Round(m.top, x, y, size, size, size / 2, themeChrome.Token("buttonFocused", "#FFFFFF"))
    pill.opacity = 0.95
    ring = setupPreviewDraw.Ring(m.top, x, y, size, size, size / 2, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.webp", x + 20, y + 20, 35, focusInk)
    play = setupPreviewDraw.TextLabel(m.top, tr("Play"), x + 92, y, 19, focusInk, true)
    labelWidth = play.boundingRect().width
    play.height = size
    play.vertAlign = "center"
    pill.width = size + labelWidth + 44
    ring.width = pill.width

    bx = x + size + labelWidth + 41 + leadGap
    for each icon in icons
        fill = setupPreviewDraw.Round(m.top, bx, y, size, size, size / 2, restFill)
        fill.opacity = 0.06
        border = setupPreviewDraw.Ring(m.top, bx, y, size, size, size / 2, "0xFFFFFFFF")
        border.opacity = 0.35
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icon}.webp`, bx + 20, y + 20, 35, restInk)
        bx += size + 12
    end for
end sub

' Classic's real buttons: an 84 px rounded square on faint glass with its word underneath, in
' columns centered on the screen. Play holds focus, filled and grown by a tenth about its center.
sub drawClassicButtons(y as float, buttons as object)
    side = 84
    column = 157
    gap = 12
    x = 960 - (buttons.count() * (column + gap) - gap) / 2
    index = 0
    for each button in buttons
        tile = m.top.createChild("Group")
        tile.translation = [x + (column - side) / 2, y]
        fill = setupPreviewDraw.Round(tile, 0, 0, side, side, 22, "0xFFFFFFFF")
        fill.opacity = 0.08
        iconInk = "0xFFFFFFFF"
        if index = 0
            tile.scaleRotateCenter = [side / 2, side / 2]
            tile.scale = [1.1, 1.1]
            fill.opacity = 0.95
            iconInk = "0x0A0A0AFF"
            if themeChrome.IsActive()
                fill.blendColor = themeChrome.Accent()
                iconInk = themeChrome.OnAccent()
            end if
            setupPreviewDraw.Ring(tile, 0, 0, side, side, 22, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
        end if
        setupPreviewDraw.Icon(tile, `pkg:/images/icons/${button[0]}.webp`, (side - 39) / 2, (side - 39) / 2, 39, iconInk)

        label = setupPreviewDraw.TextLabel(m.top, button[1], x, y + side + 12, 19, "0xFFFFFFCC", true)
        label.width = column
        label.horizAlign = "center"
        label.wrap = true
        label.maxLines = 2
        x += column + gap
        index++
    end for
end sub

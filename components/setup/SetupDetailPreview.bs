import "pkg:/components/setup/setupPreviewDraw.bs"

' Detail screens, one per style the picker offers, filled with a real title's art and facts.

' How far the scrims are taken on the two artwork-first styles, which show more of the picture
' than the cinematic one does
const DETAIL_PREVIEW_SCRIM = 0.58

sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    m.items = m.top.items
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)

    style = LCase(m.top.variant)
    if style = "classic"
        drawClassic(pal)
    else if style = "spotlight"
        drawSpotlight(pal)
    else if style = "nouveau"
        drawNouveau(pal)
    else if style = "minimalist"
        drawMinimalist(pal)
    else
        drawModern(pal)
    end if
end sub

' One page over a dimmed backdrop: logo and facts down the left, the poster in the top right
' corner, the actions centered and the metadata card underneath
sub drawClassic(pal as object)
    drawBackdrop(pal)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000C8")

    setupPreviewDraw.Art(m.top, 1585, 140, 239, 360, setupPreviewDraw.ItemField(m.items, 0, "posterUrl"), pal.surfaceVariant)
    setupPreviewDraw.Logo(m.top, m.items, 0, 96, 130, 507, 116)
    drawFacts(pal, 96, 280)
    drawOverview(pal, 96, 336, 1300, 2)

    drawClassicButtons(444, [["detail_play", tr("Play")], ["detail_trailer", tr("Trailer")], ["detail_watched", tr("Unwatched")], ["detail_favorite", tr("Favorite")], ["detail_shuffle", tr("Shuffle")]])

    setupPreviewDraw.Round(m.top, 96, 590, 1728, 330, 16, "0xFFFFFF0D")
    found = setupPreviewDraw.Entry(m.items, 0)
    genres = ""
    if isValid(found.genres) then genres = found.genres.join(", ")
    columns = [[tr("Genres"), genres], [tr("Runtime"), found.runtime ?? ""], [tr("Director"), ""]]
    for column = 0 to 2
        x = 160 + column * 560
        setupPreviewDraw.TextLabel(m.top, UCase(columns[column][0]), x, 634, 24, pal.accent, true)
        if columns[column][1] = ""
            setupPreviewDraw.Round(m.top, x, 684, 300, 24, 12, pal.onSurfaceFaint)
        else
            value = setupPreviewDraw.TextLabel(m.top, columns[column][1], x, 676, 30, pal.onSurface, false)
            value.width = 480
        end if
    end for
end sub

' Cinematic: full bleed art, scrims darkening the left and bottom, the text block top left,
' buttons and the tab strip below
sub drawModern(pal as object)
    drawBackdrop(pal)
    setupPreviewDraw.FadeRight(m.top, 0, 0, 1400, 1080, "0x000000", 1)
    setupPreviewDraw.FadeUp(m.top, 0, 640, 1920, 440, "0x000000", 0.85)

    setupPreviewDraw.Logo(m.top, m.items, 0, 96, 130, 500, 200)
    drawFacts(pal, 96, 372)
    drawOverview(pal, 96, 428, 1000, 2)

    drawPillButtons(96, 560, ["detail_trailer", "detail_watched", "detail_favorite", "detail_shuffle", "dotDotDot"])

    x = 96
    index = 0
    for each tabName in [tr("Overview"), tr("Cast"), tr("Extras"), tr("Similar")]
        ink = pal.onSurfaceDim
        if index = 0 then ink = pal.onSurface
        label = setupPreviewDraw.TextLabel(m.top, tabName, x, 972, 30, ink, true)
        tabWidth = label.boundingRect().width
        if index = 0 then setupPreviewDraw.Rect(m.top, x, 1022, tabWidth, 6, pal.accent)
        x += tabWidth + 56
        index++
    end for
end sub

' Artwork first: the hero sits high on the picture and a band of summary cards under it names
' what each one opens
sub drawSpotlight(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 640, 440)

    setupPreviewDraw.Logo(m.top, m.items, 0, 80, 142, 600, 150)
    drawFacts(pal, 80, 312)
    drawOverview(pal, 80, 400, 1500, 3)

    drawPillButtons(80, 559, ["detail_trailer", "detail_watched", "detail_favorite", "dotDotDot"])

    index = 0
    for each section in [tr("Cast"), tr("Extras"), tr("More Like This")]
        x = 80 + index * 412
        setupPreviewDraw.Round(m.top, x, 723, 380, 216, 16, "0xFFFFFF14")
        setupPreviewDraw.TextLabel(m.top, section, x + 28, 822, 30, pal.onSurface, true)
        setupPreviewDraw.Round(m.top, x + 28, 870, 160, 20, 10, pal.onSurfaceFaint)
        index++
    end for
end sub

' Every section stacked down one page, so the hero is shallow and two rails already sit under it
sub drawNouveau(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 500, 580)

    setupPreviewDraw.Logo(m.top, m.items, 0, 80, 96, 520, 124)
    drawFacts(pal, 80, 236)
    drawOverview(pal, 80, 320, 1420, 2)

    ' Nouveau keeps Play open and leaves a little more room after it
    drawPillButtons(80, 424, ["detail_watched", "detail_favorite", "dotDotDot"], 18)

    drawRail(pal, tr("Extras"), 552, 5, 192, 108, "backdropUrl")
    drawRail(pal, tr("More Like This"), 740, 7, 108, 162, "posterUrl")
end sub

' Mostly picture, with the title, one play button and the episodes along the bottom
sub drawMinimalist(pal as object)
    drawBackdrop(pal)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000008C")

    setupPreviewDraw.Logo(m.top, m.items, 0, 56, 639, 440, 104)
    drawPillButtons(56, 771, ["detail_shuffle", "detail_favorite"])

    for i = 0 to 3
        setupPreviewDraw.Art(m.top, 56 + i * 256, 899, 236, 133, setupPreviewDraw.ItemField(m.items, i + 1, "backdropUrl"), "0xFFFFFF29")
    end for
end sub

' ===== Pieces the styles share =====

sub drawBackdrop(pal as object)
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), pal.surfaceVariant)
end sub

' The wash and the two fades the artwork-first styles lay over the picture. They blend with the
' page color rather than with black, the way the real screens do, so the picture keeps its color
sub drawArtworkScrims(pal as object, fadeY as float, fadeHeight as float)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x00000052")
    setupPreviewDraw.FadeRight(m.top, 0, 0, 1400, 1080, pal.background, DETAIL_PREVIEW_SCRIM)
    setupPreviewDraw.FadeUp(m.top, 0, fadeY, 1920, fadeHeight, pal.background, DETAIL_PREVIEW_SCRIM)
end sub

' The facts line with the community score in front, the way the real headers lead
sub drawFacts(pal as object, x as float, y as float)
    after = setupPreviewDraw.Score(m.top, m.items, 0, x, y, 26, pal.onSurface)
    if after > x then after += 24
    setupPreviewDraw.MetaLine(m.top, m.items, 0, after, y, 26, playbackOverlay.WithAlpha(pal.onSurface, 230))
end sub

sub drawOverview(pal as object, x as float, y as float, width as float, lines as integer)
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), x, y, width, 26, lines, playbackOverlay.WithAlpha(pal.onSurface, 204))
end sub

sub drawRail(pal as object, title as string, y as float, count as integer, cardWidth as float, cardHeight as float, field as string)
    setupPreviewDraw.TextLabel(m.top, title, 80, y - 8, 30, pal.onSurface, true)
    for i = 0 to count - 1
        setupPreviewDraw.Art(m.top, 80 + i * (cardWidth + 20), y + 44, cardWidth, cardHeight, setupPreviewDraw.ItemField(m.items, i + 1, field), "0xFFFFFF24")
    end for
end sub

' The real buttons of the four newer styles, at their real size: 75 px circles on faint glass with
' a hairline round them, led by Play as the open pill that focus starts on, its word showing
sub drawPillButtons(x as float, y as float, icons as object, leadGap = 12 as integer)
    size = 75
    focusInk = themeChrome.Token("onButtonFocused", "#000000FF")
    restFill = themeChrome.Token("buttonNormal", "#FFFFFF")
    restInk = themeChrome.Token("onButtonNormal", "#FFFFFFFF")

    pill = setupPreviewDraw.Round(m.top, x, y, size, size, size / 2, themeChrome.Token("buttonFocused", "#FFFFFF"))
    pill.opacity = 0.95
    ring = setupPreviewDraw.Ring(m.top, x, y, size, size, size / 2, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.webp", x + 20, y + 20, 35, focusInk)
    play = setupPreviewDraw.TextLabel(m.top, tr("Play"), x + 92, y, 19, focusInk, true)
    labelWidth = play.boundingRect().width
    play.height = size
    play.vertAlign = "center"
    pill.width = size + labelWidth + 44
    ring.width = pill.width

    bx = x + size + labelWidth + 41 + leadGap
    for each icon in icons
        fill = setupPreviewDraw.Round(m.top, bx, y, size, size, size / 2, restFill)
        fill.opacity = 0.06
        border = setupPreviewDraw.Ring(m.top, bx, y, size, size, size / 2, "0xFFFFFFFF")
        border.opacity = 0.35
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icon}.webp`, bx + 20, y + 20, 35, restInk)
        bx += size + 12
    end for
end sub

' Classic's real buttons: an 84 px rounded square on faint glass with its word underneath, in
' columns centered on the screen. Play holds focus, filled and grown by a tenth about its center.
sub drawClassicButtons(y as float, buttons as object)
    side = 84
    column = 157
    gap = 12
    x = 960 - (buttons.count() * (column + gap) - gap) / 2
    index = 0
    for each button in buttons
        tile = m.top.createChild("Group")
        tile.translation = [x + (column - side) / 2, y]
        fill = setupPreviewDraw.Round(tile, 0, 0, side, side, 22, "0xFFFFFFFF")
        fill.opacity = 0.08
        iconInk = "0xFFFFFFFF"
        if index = 0
            tile.scaleRotateCenter = [side / 2, side / 2]
            tile.scale = [1.1, 1.1]
            fill.opacity = 0.95
            iconInk = "0x0A0A0AFF"
            if themeChrome.IsActive()
                fill.blendColor = themeChrome.Accent()
                iconInk = themeChrome.OnAccent()
            end if
            setupPreviewDraw.Ring(tile, 0, 0, side, side, 22, themeChrome.Token("inputBorderFocused", "#FFFFFF"))
        end if
        setupPreviewDraw.Icon(tile, `pkg:/images/icons/${button[0]}.webp`, (side - 39) / 2, (side - 39) / 2, 39, iconInk)

        label = setupPreviewDraw.TextLabel(m.top, button[1], x, y + side + 12, 19, "0xFFFFFFCC", true)
        label.width = column
        label.horizAlign = "center"
        label.wrap = true
        label.maxLines = 2
        x += column + gap
        index++
    end for
end sub

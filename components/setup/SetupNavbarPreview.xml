<?xml version="1.0" encoding="utf-8"?>
<component name="SetupNavbarPreview" extends="Group">
  <interface>
    <field id="position" type="string" value="top" />
    <!-- Set by the settings live preview. The wizard leaves them alone and gets the default bar. -->
    <field id="buttons" type="array" />
    <field id="avatar" type="string" />
    <field id="expanded" type="boolean" value="false" />
    <field id="showClock" type="boolean" value="true" />
    <field id="clock24" type="boolean" value="false" />
    <field id="barColor" type="string" />
    <!-- A real screen drawn under the bar in place of the home hero -->
    <field id="screen" type="node" onChange="redraw" />
    <field id="items" type="array" onChange="redraw" />
  </interface>
</component>

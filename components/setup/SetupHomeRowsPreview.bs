import "pkg:/components/setup/setupPreviewDraw.bs"

' Home rows in the two styles with the library's own art. Classic leads with the info area over
' compact rows. Modern's whole point is the focused card, so its preview holds the first card in
' that state with the text block it grows underneath.
sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)
    if m.top.modern
        drawModern(pal, items)
    else
        drawClassic(pal, items)
    end if
end sub

sub drawClassic(pal as object, items as object)
    faded = playbackOverlay.WithAlpha(pal.onSurface, 179)
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), 96, 48, 52, pal.onSurface, true)
    setupPreviewDraw.MetaLine(m.top, items, 0, 96, 124, 24, playbackOverlay.WithAlpha(pal.onSurface, 230))
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), 96, 168, 1300, 26, 2, faded)

    setupPreviewDraw.CardRow(m.top, items, tr("Continue Watching"), 96, 290, 313, 176, 6, pal, 0, "backdropUrl")
    ' The first two thumbs carry the progress bars a half watched title shows
    for i = 0 to 1
        trackX = 96 + i * 337 + 12
        setupPreviewDraw.Round(m.top, trackX, 290 + 52 + 176 - 24, 289, 12, 6, "0x0000008A")
        setupPreviewDraw.Round(m.top, trackX, 290 + 52 + 176 - 24, 289 * (0.35 + i * 0.35), 12, 6, pal.accent)
    end for
    setupPreviewDraw.CardRow(m.top, items, tr("Recently Added"), 96, 650, 160, 240, 10, pal, 3)
end sub

sub drawModern(pal as object, items as object)
    cardTop = 112
    cardHeight = 384
    focusWidth = 683
    setupPreviewDraw.TextLabel(m.top, tr("Continue Watching"), 96, 60, 32, pal.onSurface, true)

    ' The focused card: wide art on a ring in the text color, rounded on that ring
    setupPreviewDraw.Round(m.top, 90, cardTop - 6, focusWidth + 12, cardHeight + 12, 14, pal.onSurface)
    setupPreviewDraw.RoundArt(m.top, 96, cardTop, focusWidth, cardHeight, setupPreviewDraw.ItemField(items, 0, "backdropUrl"), pal.surfaceVariant, 8, pal.onSurface)
    textY = cardTop + cardHeight + 16
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), 96, textY, 26, pal.onSurface, true)
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "year"), 96, textY + 36, 24, playbackOverlay.WithAlpha(pal.onSurface, 153), false)
    setupPreviewDraw.Score(m.top, items, 0, 96, textY + 76, 28, pal.onSurface)
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), 96, textY + 118, 1600, 24, 3, playbackOverlay.WithAlpha(pal.onSurface, 179))

    for i = 1 to 6
        x = 96 + focusWidth + 24 + (i - 1) * 280
        setupPreviewDraw.RoundArt(m.top, x, cardTop, 256, cardHeight, setupPreviewDraw.ItemField(items, i, "posterUrl"), pal.surfaceVariant, 8, pal.background)
        name = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "title"), x, textY, 26, pal.onSurface, true)
        name.width = 256
        setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "year"), x, textY + 36, 24, playbackOverlay.WithAlpha(pal.onSurface, 153), false)
    end for

    setupPreviewDraw.CardRow(m.top, items, tr("Recently Added"), 96, 790, 256, 384, 8, pal, 3)
end sub

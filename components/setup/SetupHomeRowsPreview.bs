import "pkg:/components/setup/setupPreviewDraw.bs"

' Home rows in the two styles with the library's own art. Classic leads with the info area over
' compact rows. Modern's whole point is the focused card, so its preview holds the first card in
' that state with the text block it grows underneath.

' The real Home's left inset, which leaves the focused card's ring room inside the stage
const ROW_LEFT = 111

' Home's own layout, kept in step with Home.xml and HomeRows.bs: where the rows sit in each style,
' the band above the cards that holds a row's title, the room under the cards for their captions,
' and the room a widened Modern card's details take
const CLASSIC_ROWS_TOP = 450
const MODERN_ROWS_TOP = 170
const DETAILS_TOP = 120
const ROW_TITLE_BAND = 56
const CLASSIC_CAPTION_ROOM = 118
const MODERN_CAPTION_ROOM = 123
const MODERN_INFO_ROOM = 292
const CARD_GAP = 20

sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)
    rows = m.top.rows ?? []
    if rows.count() > 0
        drawBackdrop(setupPreviewDraw.ItemField(rows[0].items, 0, "backdropUrl"))
        drawFocusedRows(pal, rows)
        return
    end if
    drawBackdrop(setupPreviewDraw.ItemField(items, 0, "backdropUrl"))
    if m.top.modern
        drawModern(pal, items)
    else
        drawClassic(pal, items)
    end if
end sub

' The first card's backdrop where Home's placeBackdrop puts it for the style, dimmed the way Home
' dims it behind the rows
sub drawBackdrop(uri as string)
    style = m.top.backdrop
    if uri = "" or not inArray(["fullScreen", "corner", "top"], style) then return
    mask = m.top.createChild("MaskGroup")
    art = mask.createChild("Poster")
    art.width = 1920
    art.height = 1080
    art.loadDisplayMode = "scaleToFill"
    if style = "corner"
        mask.translation = [1920 - 1344, 0]
        mask.maskUri = "pkg:/images/backdropCornerMask.png"
        mask.maskSize = [1344, 810]
        art.width = 1344
        art.height = 810
        art.loadDisplayMode = "scaleToZoom"
    else if style = "top"
        mask.maskUri = "pkg:/images/backdropTopMask.webp"
        mask.maskSize = [1920, 1080]
    end if
    art.opacity = 0.3
    art.uri = `${uri}&blur=${getHomeBackdropBlurAmount()}`
end sub

sub drawClassic(pal as object, items as object)
    faded = playbackOverlay.WithAlpha(pal.onSurface, 179)
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), ROW_LEFT, 48, 52, pal.onSurface, true)
    setupPreviewDraw.MetaLine(m.top, items, 0, ROW_LEFT, 124, 24, playbackOverlay.WithAlpha(pal.onSurface, 230))
    ' The scores take the overview's first line, the way the real info area moves it down for them
    scoresRow = setupPreviewDraw.RatingsLine(m.top, m.top.ratings, ROW_LEFT, 166, { singleLine: true, iconHeight: 28, valueSize: 24, nameSize: 18, labelFont: "font:SmallestSystemFont", labelColor: "#FFFFFF", ratingSpacing: 10, maxWidth: 1703 })
    if isValid(scoresRow)
        setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), ROW_LEFT, 218, 1300, 26, 1, faded)
    else
        setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), ROW_LEFT, 168, 1300, 26, 2, faded)
    end if

    setupPreviewDraw.CardRow(m.top, items, tr("Continue Watching"), ROW_LEFT, 290, 313, 176, 6, pal, 0, "backdropUrl")
    ' The first two thumbs carry the progress bars a half watched title shows
    for i = 0 to 1
        trackX = ROW_LEFT + i * 337 + 12
        setupPreviewDraw.Round(m.top, trackX, 290 + 52 + 176 - 24, 289, 12, 6, "0x0000008A")
        setupPreviewDraw.Round(m.top, trackX, 290 + 52 + 176 - 24, 289 * (0.35 + i * 0.35), 12, 6, pal.accent)
    end for
    setupPreviewDraw.CardRow(m.top, items, tr("Recently Added"), ROW_LEFT, 650, 160, 240, 10, pal, 3)
end sub

sub drawModern(pal as object, items as object)
    cardTop = 112
    cardHeight = 384
    focusWidth = 683
    setupPreviewDraw.TextLabel(m.top, tr("Continue Watching"), ROW_LEFT, 60, 32, pal.onSurface, true)

    ' The focused card: wide art on a ring in the text color, rounded on that ring
    setupPreviewDraw.Round(m.top, ROW_LEFT - 6, cardTop - 6, focusWidth + 12, cardHeight + 12, 14, pal.onSurface)
    setupPreviewDraw.RoundArt(m.top, ROW_LEFT, cardTop, focusWidth, cardHeight, setupPreviewDraw.ItemField(items, 0, "backdropUrl"), pal.surfaceVariant, 8, pal.onSurface)
    textY = cardTop + cardHeight + 16
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), ROW_LEFT, textY, 26, pal.onSurface, true)
    setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "year"), ROW_LEFT, textY + 36, 24, playbackOverlay.WithAlpha(pal.onSurface, 153), false)
    overviewY = textY + 118
    if isValid(m.top.ratings) and isValid(m.top.ratings.data)
        ' The settings preview draws the plugin's scores the real card shows here, and the overview
        ' moves up when there are none
        overviewY = textY + 76
        scoresRow = setupPreviewDraw.RatingsLine(m.top, m.top.ratings, ROW_LEFT, overviewY, { labelFont: "font:SmallestBoldSystemFont", ratingSpacing: 14, maxWidth: 1703 })
        if isValid(scoresRow) then overviewY += scoresRow.boundingRect().height + 12
    else
        setupPreviewDraw.Score(m.top, items, 0, ROW_LEFT, textY + 76, 28, pal.onSurface)
    end if
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), ROW_LEFT, overviewY, 1600, 24, 3, playbackOverlay.WithAlpha(pal.onSurface, 179))

    for i = 1 to 6
        x = ROW_LEFT + focusWidth + 24 + (i - 1) * 280
        setupPreviewDraw.RoundArt(m.top, x, cardTop, 256, cardHeight, setupPreviewDraw.ItemField(items, i, "posterUrl"), pal.surfaceVariant, 8, pal.background)
        name = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "title"), x, textY, 26, pal.onSurface, true)
        name.width = 256
        setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "year"), x, textY + 36, 24, playbackOverlay.WithAlpha(pal.onSurface, 153), false)
    end for

    setupPreviewDraw.CardRow(m.top, items, tr("Recently Added"), ROW_LEFT, 790, 256, 384, 8, pal, 3)
end sub

' Home with the remote on the first card of the first row. Classic shows that card's details above
' the rows. Modern moves the rows up, widens the card when its row does and puts its details under
' it, sliding the cards after it aside. The rows below follow until the screen runs out.
sub drawFocusedRows(pal as object, rows as object)
    modern = m.top.modern
    focused = rows[0].items
    if not modern then drawDetails(pal, focused)

    y = CLASSIC_ROWS_TOP
    if modern then y = MODERN_ROWS_TOP
    spacing = homeRowsVerticalSpacing(modern)
    for r = 0 to rows.count() - 1
        if y >= 1080 then exit for
        row = rows[r]
        room = CLASSIC_CAPTION_ROOM
        if modern then room = MODERN_CAPTION_ROOM
        if modern and row.modernCards = true then room = MODERN_INFO_ROOM
        drawRow(pal, row, y, r = 0, modern)
        y += ROW_TITLE_BAND + room + row.cell[1] + spacing
    end for
end sub

' The focused card's title, facts and overview where Home's details section puts them
sub drawDetails(pal as object, items as object)
    title = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), ROW_LEFT, DETAILS_TOP, 48, pal.onSurface, true)
    title.width = 1703
    title.height = 96
    title.vertAlign = "bottom"
    setupPreviewDraw.MetaLine(m.top, items, 0, ROW_LEFT, DETAILS_TOP + 114, 24, playbackOverlay.WithAlpha(pal.onSurface, 230))
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), ROW_LEFT, DETAILS_TOP + 160, 1200, 24, 3, playbackOverlay.WithAlpha(pal.onSurface, 217))
end sub

sub drawRow(pal as object, row as object, y as float, focusedRow as boolean, modern as boolean)
    name = setupPreviewDraw.TextLabel(m.top, row.title, ROW_LEFT, y + 20, 36, pal.onSurface, false)
    name.width = 1703
    cardTop = y + ROW_TITLE_BAND
    width = row.cell[0]
    height = row.cell[1]
    wide = focusedRow and modern and row.modernCards = true
    field = "posterUrl"
    if row.imageType = "thumb" or row.imageType = "banner" then field = "wideUrl"
    x = ROW_LEFT
    items = row.items ?? []
    for i = 0 to items.count() - 1
        if x >= 1920 then exit for
        focused = focusedRow and i = 0
        cardWidth = width
        uri = setupPreviewDraw.ItemField(items, i, field)
        if focused and wide
            cardWidth = row.wideWidth
            uri = setupPreviewDraw.ItemField(items, i, "wideUrl")
        end if
        setupPreviewDraw.RoundArt(m.top, x, cardTop, cardWidth, height, uri, pal.surfaceVariant, 8, pal.background)
        ' Home's own focus frame over the card
        if focused then setupPreviewDraw.Shape(m.top, "pkg:/images/posterFocus.9.png", x, cardTop, cardWidth, height, "0xFFFFFFFF")
        if focused and modern
            drawFocusedCaption(pal, items, x, cardTop + height + 14, cardWidth + CARD_GAP - 8, wide)
        else
            caption = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, i, "title"), x, cardTop + height + 12, 28, pal.onSurface, false)
            caption.width = cardWidth
        end if
        x += cardWidth + CARD_GAP
    end for
end sub

' Modern's focused card names itself in bold with its facts under it, and a widened one adds its overview
sub drawFocusedCaption(pal as object, items as object, x as float, y as float, width as float, wide as boolean)
    ' A widened card's details run on past it, and a narrow one's stop short of the next card
    name = setupPreviewDraw.TextLabel(m.top, setupPreviewDraw.ItemField(items, 0, "title"), x, y, 36, pal.onSurface, true)
    if not wide then name.width = width
    setupPreviewDraw.MetaLine(m.top, items, 0, x, y + 42, 24, playbackOverlay.WithAlpha(pal.onSurface, 204))
    if wide then setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(items, 0, "overview"), x, y + 80, 1703, 22, 3, playbackOverlay.WithAlpha(pal.onSurface, 221))
end sub

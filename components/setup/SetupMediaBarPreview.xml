<?xml version="1.0" encoding="utf-8"?>
<component name="SetupMediaBarPreview" extends="Group">
  <interface>
    <field id="mode" type="string" value="moonfin" />
    <!-- Set by the settings live preview. The wizard leaves them alone and draws the saved overlay
         with no scores. -->
    <field id="overlayColor" type="string" />
    <field id="overlayOpacity" type="float" value="-1" />
    <field id="ratings" type="assocarray" />
    <field id="items" type="array" onChange="redraw" />
  </interface>
</component>

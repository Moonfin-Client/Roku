import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/galleryGlow.bs"

' Home wearing one of the media bar styles, laid out to the real mode's geometry
' with the library's own art and text, so the pick is made by looking.

' With Peek Home Rows on, Home puts the first row this far down and the bar lays itself out above it
const PEEK_ROWS_TOP = 890
' MakD's column ends this far above where the rows start
const MAKD_COLUMN_LIFT = 35
const MAKD_LEFT = 77
const MAKD_WIDTH = 883

sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    m.pal = setupPreviewDraw.Palette()
    ' The settings live preview hands in the overlay it's trying, and the wizard keeps the saved one
    if m.top.overlayColor <> "" then m.pal.overlay = formatOverlayColor(m.top.overlayColor, m.pal.overlay)
    if m.top.overlayOpacity >= 0 then m.pal.overlayOpacity = m.top.overlayOpacity
    m.items = m.top.items
    m.scores = m.top.ratings
    ' How far the bar's content rises, or its art shrinks, to stay clear of a peeking row
    m.lift = 0
    if m.top.rowPeek then m.lift = 1080 - PEEK_ROWS_TOP
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, m.pal.background)

    mode = m.top.mode
    if isStringEqual(mode, "makd")
        drawMakd()
    else if isStringEqual(mode, "bookshelf")
        drawBookshelf()
    else if isStringEqual(mode, "gallery")
        drawGallery()
    else if isStringEqual(mode, "banner")
        drawBanner()
    else if isStringEqual(mode, "aya")
        drawAya()
    else if isStringEqual(mode, "off")
        drawOff()
    else
        setupPreviewDraw.Hero(m.top, m.items, m.pal, false, m.scores, m.lift, m.top.pages)
        release = releaseLabel()
        if isValid(release) then release.translation = [80, 365]
    end if
    if m.top.rowPeek then drawPeekRow()
end sub

' Home's first row with its title and the top of its cards showing under the bar, or the sample
' row when Settings wasn't opened over Home
sub drawPeekRow()
    peek = m.top.peek
    if isValid(peek) and isValidAndNotEmpty(peek.rows)
        setupPreviewDraw.HomeRow(m.top, peek.rows[0], 111, m.pal, peek.ink, false)
        return
    end if
    setupPreviewDraw.CardRow(m.top, m.items, tr("Continue Watching"), 111, PEEK_ROWS_TOP, 300, 169, 6, m.pal, 1, "backdropUrl")
end sub

' The sample series' new release label, which the settings live preview sets while the banner is on
function releaseLabel() as dynamic
    found = setupPreviewDraw.Entry(m.items, 0)
    if not isValid(found.newRelease) then return invalid
    label = m.top.createChild("MediaBarNewReleaseLabel")
    label.release = found.newRelease
    return label
end function

' makd's Classic layout: full bleed art under a light shade and a corner wash, fading into the page
' at its foot, with the logo, facts, genres, overview and buttons stacked up from the column's foot
' at the left, and the dots at the right on the same line
sub drawMakd()
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    ' The overlay color and opacity, which at the default 0.5 give the original's 20% and 65%
    tint = makdTint(m.pal.overlay)
    shade = setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, tint)
    shade.opacity = m.pal.overlayOpacity * 0.4
    washOpacity = m.pal.overlayOpacity * 1.3
    if washOpacity > 1 then washOpacity = 1
    setupPreviewDraw.Scrim(m.top, "pkg:/images/makd/wash130.webp", 0, 0, 1920, 1080, tint, washOpacity)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/makd/fadeBottom.webp", 0, 994, 1920, 86, m.pal.background, 1.0)

    ' The column ends above the peeking row, or at the screen's foot without one
    columnBottom = 1080 - m.lift - MAKD_COLUMN_LIFT
    y = columnBottom - 50
    drawMakdButtons(y)
    y -= 26

    overview = setupPreviewDraw.ItemField(m.items, 0, "overview")
    if overview <> ""
        paragraph = setupPreviewDraw.Paragraph(m.top, overview, MAKD_LEFT, 0, MAKD_WIDTH, 20, 3, "0xFFFFFFFF")
        paragraph.height = 0
        overviewHeight = paragraph.boundingRect().height
        paragraph.height = overviewHeight
        y -= overviewHeight
        paragraph.translation = [MAKD_LEFT, y]
        y -= 18
    end if

    found = setupPreviewDraw.Entry(m.items, 0)
    genres = []
    if isValid(found.genres) then genres = found.genres
    if genres.count() > 0
        y -= 27
        x = MAKD_LEFT
        for i = 0 to genres.count() - 1
            if i = 3 then exit for
            if i > 0
                setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", x + 5, y + 10, 7, 7, "0xFFFFFF8C")
                x += 17
            end if
            label = setupPreviewDraw.TextLabel(m.top, genres[i], x, y + 2, 20, "0xFFFFFFFF", false)
            x += label.boundingRect().width
        end for
        y -= 18
    end if

    y -= 28
    drawMakdFacts(found, y)
    y -= 18
    release = releaseLabel()
    if isValid(release)
        y -= release.labelHeight
        release.translation = [MAKD_LEFT, y]
        y -= 18
    end if
    y -= 8

    m.makdLogoBottom = y
    logoUri = setupPreviewDraw.ItemField(m.items, 0, "logoUrl")
    if logoUri <> ""
        ' scaleToFit centers the logo in its box, so the box narrows to it once it loads
        m.makdLogo = setupPreviewDraw.Logo(m.top, m.items, 0, MAKD_LEFT, y - 238, MAKD_WIDTH, 238)
        m.makdLogo.observeFieldScoped("loadStatus", "onMakdLogoLoaded")
    else
        title = setupPreviewDraw.Logo(m.top, m.items, 0, MAKD_LEFT, y - 238, MAKD_WIDTH, 238)
        title.font = "font:SmallSystemFont"
        title.font.size = 80
    end if

    count = m.top.pages
    if count > 5 then count = 5
    if count > 1
        dotsLeft = 1862 - count * 20
        for i = 0 to count - 1
            dot = setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", dotsLeft + i * 20 + 5, columnBottom - 10, 10, 10, "0xCECECE99")
            if i = 0
                dot.blendColor = "0xFFFFFFFF"
                dot.scaleRotateCenter = [5, 5]
                dot.scale = [1.7, 1.7]
            end if
        end for
    end if
end sub

sub onMakdLogoLoaded()
    logo = m.makdLogo
    if logo.loadStatus <> "ready" or logo.bitmapHeight <= 0 then return
    fit = 1.0
    if logo.bitmapWidth > MAKD_WIDTH then fit = MAKD_WIDTH / logo.bitmapWidth
    if logo.bitmapHeight * fit > 238 then fit = 238 / logo.bitmapHeight
    logo.width = logo.bitmapWidth * fit
    logo.height = logo.bitmapHeight * fit
    logo.translation = [MAKD_LEFT, m.makdLogoBottom - logo.height]
end sub

' The community star, year, rating badge and runtime, dotted apart
sub drawMakdFacts(found as object, y as float)
    facts = []
    if isValidAndNotEmpty(found.communityRating) then facts.push({ star: true, text: found.communityRating })
    if isValidAndNotEmpty(found.year) then facts.push({ text: found.year })
    if isValidAndNotEmpty(found.officialRating) then facts.push({ badge: true, text: found.officialRating })
    if isValidAndNotEmpty(found.runtime) then facts.push({ text: found.runtime })
    x = MAKD_LEFT
    for i = 0 to facts.count() - 1
        fact = facts[i]
        if i > 0
            setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", x + 10, y + 10, 7, 7, "0xFFFFFF8C")
            x += 27
        end if
        if fact.star ?? false
            setupPreviewDraw.Icon(m.top, "pkg:/images/sharp_star_white_18dp.webp", x, y, 28, "0xF2B01EFF")
            x += 32
        end if
        if fact.badge ?? false
            badge = setupPreviewDraw.Shape(m.top, "pkg:/images/details/badgefill6.9.png", x, y, 0, 27, "0xFFFFFFCC")
            label = setupPreviewDraw.TextLabel(m.top, fact.text, x + 10, y + 2, 20, "0x000000FF", true)
            badge.width = label.boundingRect().width + 20
            x += badge.width
        else
            label = setupPreviewDraw.TextLabel(m.top, fact.text, x, y + 2, 20, "0xFFFFFFFF", true)
            x += label.boundingRect().width
        end if
    end for
end sub

' Info with the bar's focus ring on it, a white Play, and Favorite
sub drawMakdButtons(y as float)
    x = MAKD_LEFT
    for each kind in ["info", "play", "favorite"]
        if kind = "play"
            fill = setupPreviewDraw.Shape(m.top, "pkg:/images/details/surface8.9.png", x, y, 0, 50, "0xFFFFFFFF")
            setupPreviewDraw.Icon(m.top, "pkg:/images/icons/play.webp", x + 13, y + 14, 22, "0x000000FF")
            label = setupPreviewDraw.TextLabel(m.top, tr("Play"), x + 41, y + 12, 18, "0x000000FF", true)
            fill.width = 54 + label.boundingRect().width
            x += fill.width + 15
        else
            setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", x, y, 50, 50, "0x00000073")
            setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circleRing.webp", x, y, 50, 50, "0xFFFFFF59")
            icon = "pkg:/images/icons/info_outline.webp"
            if kind = "favorite" then icon = "pkg:/images/icons/favorite_outline.webp"
            setupPreviewDraw.Icon(m.top, icon, x + 14, y + 14, 22, "0xFFFFFFFF")
            if kind = "info" then setupPreviewDraw.Shape(m.top, "pkg:/images/icons/focusRing.webp", x - 6, y - 6, 62, 62, "0xFFFFFFFF")
            x += 65
        end if
    end for
end sub

' The real shelf: the open book standing face out at the left, then a run of spines tinted
' from the shelf's own colors, each with its number and its title up the side
sub drawBookshelf()
    spineColors = ["0xBF441BFF", "0xae792dFF", "0xD98934FF", "0x870F19FF", "0x7A5334FF", "0x592B2BFF", "0x30A49CFF", "0x6C7851FF"]
    shelf = m.top.createChild("Poster")
    shelf.width = 1920
    shelf.height = 1080
    shelf.loadDisplayMode = "scaleToZoom"
    shelf.uri = "pkg:/images/bookshelfBg.webp"
    ' Over a peeking row the art ends on it, and the books shrink to stand on its ledge
    shelf.translation = [0, -m.lift]
    books = m.top.createChild("Group")
    shrink = (PEEK_ROWS_TOP - 26 - 223 - 30) / 800
    if m.lift > 0 then books.scale = [shrink, shrink]
    books.scaleRotateCenter = [0, 30]

    setupPreviewDraw.Shape(books, "pkg:/images/bookWide.webp", 59, 30, 620, 850, spineColors[0])
    setupPreviewDraw.Art(books, 127, 30, 560, 800, setupPreviewDraw.ItemField(m.items, 0, "posterUrl"), m.pal.surfaceVariant)

    ' A spine for each title after the open book, as far as the shelf runs
    spines = m.top.pages - 1
    if spines > 19 then spines = 19
    for i = 1 to spines
        x = 694 + (i - 1) * 65
        setupPreviewDraw.Shape(books, "pkg:/images/bookSpine.png", x, 90, 60, 740, spineColors[i mod 8])
        number = setupPreviewDraw.TextLabel(books, Right("0" + (i + 1).toStr(), 2), x + 14, 105, 22, "0xE5D9C3FF", true)
        number.width = 32
        number.horizAlign = "center"
        spineTitle = setupPreviewDraw.TextLabel(books, UCase(setupPreviewDraw.ItemField(m.items, i, "title")), x + 15, 795, 22, "0xE5D9C3FF", true)
        spineTitle.width = 620
        spineTitle.height = 30
        spineTitle.horizAlign = "center"
        spineTitle.rotation = 1.5708
    end for
end sub

' One wide panel open on the current title, its facts and overview on the left and who made it
' on the right, with the next few folded into narrow panels that carry their titles on their side
sub drawGallery()
    panelX = 24
    panelY = 97
    ' The panels end as far above a peeking row as they do above the foot of the screen
    panelHeight = 951 - m.lift
    found = setupPreviewDraw.Entry(m.items, 0)
    glowColor = galleryGlow.ForGenres(found.genres)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/glow.png", panelX - 56, panelY - 303, 1600, 1600, glowColor, 0.42)

    setupPreviewDraw.Art(m.top, panelX, panelY, 1478, panelHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/panelscrim.webp", panelX, panelY, 1478, panelHeight, "0xFFFFFFFF", 1)
    setupPreviewDraw.Corners(m.top, panelX, panelY, 1478, panelHeight, 14, m.pal.background)

    textX = panelX + 48
    title = setupPreviewDraw.TextLabel(m.top, UCase(setupPreviewDraw.ItemField(m.items, 0, "title")), textX, panelY + 40, 64, "0xFFFFFFFF", true)
    title.width = 812
    title.wrap = true
    title.maxLines = 2
    pillY = panelY + 40 + title.boundingRect().height + 24
    release = releaseLabel()
    if isValid(release)
        release.translation = [textX, pillY]
        pillY += release.labelHeight + 24
    end if
    pillX = textX
    for each pill in galleryPills(found)
        pillX = drawGalleryPill(pill, pillX, pillY, glowColor) + 14
    end for
    ' The gallery's row only ever carries the community score
    scoresRow = setupPreviewDraw.RatingsLine(m.top, communityOnly(m.scores), textX, pillY + 78, { labelFont: "font:SmallestBoldSystemFont", labelColor: "#FFFFFF", iconHeight: 26, ratingSpacing: 16 })
    overviewY = pillY + 78
    if isValid(scoresRow) then overviewY += scoresRow.boundingRect().height + 26
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), textX, overviewY, 812, 30, 4, "0xFFFFFFE6")

    creditsX = panelX + 888
    creditsY = panelY + 40
    credits = setupPreviewDraw.Round(m.top, creditsX, creditsY, 542, 220, 18, "0x000000")
    credits.opacity = 0.55
    setupPreviewDraw.Ring(m.top, creditsX, creditsY, 542, 220, 18, "0xFFFFFF1F")
    setupPreviewDraw.TextLabel(m.top, UCase(tr("Director")), creditsX + 36, creditsY + 32, 22, m.pal.accent, true)
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 66, 240, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))
    setupPreviewDraw.TextLabel(m.top, UCase(tr("Starring")), creditsX + 36, creditsY + 112, 22, m.pal.accent, true)
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 146, 320, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 182, 280, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))

    for i = 1 to 4
        x = panelX + 1478 + 6 + (i - 1) * 98
        art = setupPreviewDraw.Art(m.top, x, panelY, 92, panelHeight, setupPreviewDraw.ItemField(m.items, i, "backdropUrl"), "0x00000000")
        art.opacity = 0.35
        setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/panelscrim.webp", x, panelY, 92, panelHeight, "0xFFFFFFFF", 1)
        setupPreviewDraw.Corners(m.top, x, panelY, 92, panelHeight, 14, m.pal.background)

        number = setupPreviewDraw.TextLabel(m.top, Right("0" + (i + 1).toStr(), 2), x, panelY + 16, 28, "0xFFFFFFD9", true)
        number.width = 92
        number.horizAlign = "center"
        lineInk = playbackOverlay.WithAlpha(m.pal.accent, 179)
        setupPreviewDraw.Rect(m.top, x + 45, panelY + 96, 2, 48, lineInk)
        setupPreviewDraw.Rect(m.top, x + 45, panelY + panelHeight - 111, 2, 48, lineInk)
        sideTitle = setupPreviewDraw.TextLabel(m.top, UCase(setupPreviewDraw.ItemField(m.items, i, "title")), x + 66, panelY + 160, 28, "0xFFFFFFFF", true)
        sideTitle.width = 664
        sideTitle.height = 40
        sideTitle.horizAlign = "center"
        sideTitle.vertAlign = "center"
        sideTitle.rotation = -1.5708
    end for
end sub

' Runtime, the outlined age rating, the year, then the genres tinted with the panel's glow
function galleryPills(found as object) as object
    pills = []
    if isValidAndNotEmpty(found.runtime) then pills.push({ text: found.runtime, look: "plain" })
    if isValidAndNotEmpty(found.officialRating) then pills.push({ text: found.officialRating, look: "outlined" })
    if isValidAndNotEmpty(found.year) then pills.push({ text: found.year, look: "plain" })
    if isValid(found.genres)
        for each genre in found.genres
            pills.push({ text: genre, look: "tinted" })
        end for
    end if
    return pills
end function

function drawGalleryPill(pill as object, x as float, y as float, glowColor as string) as float
    if pill.look = "outlined"
        fill = setupPreviewDraw.Ring(m.top, x, y, 0, 52, 8, "0xFFFFFF8C")
    else
        fill = setupPreviewDraw.Round(m.top, x, y, 0, 52, 8, "0x00000059")
        if pill.look = "tinted" then fill.blendColor = playbackOverlay.WithAlpha(glowColor, 77)
    end if
    label = setupPreviewDraw.TextLabel(m.top, pill.text, x + 20, y, 24, "0xFFFFFFFF", true)
    label.height = 52
    label.vertAlign = "center"
    pillWidth = label.boundingRect().width + 40
    fill.width = pillWidth
    return x + pillWidth
end function

' The wide rounded banner across the top of the screen with the logo and facts in its bottom corner
' and the page marks in its top one, then the rows carrying on underneath
sub drawBanner()
    cardX = 44
    cardY = 4
    cardWidth = 1832
    cardHeight = 535
    setupPreviewDraw.Art(m.top, cardX, cardY, cardWidth, cardHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/banner/cardgradient.webp", cardX, cardY, cardWidth, cardHeight, "0xFFFFFFFF", 1)
    ' There's no corner piece for the card's 23 on the stage, so it takes the nearest one
    setupPreviewDraw.Corners(m.top, cardX, cardY, cardWidth, cardHeight, 18, m.pal.background)

    ' The block sits on the foot of the card, so the scores under the facts lift the rest
    lift = liftForScores(setupPreviewDraw.RatingsLine(m.top, m.scores, cardX + 33, 0, smallScores()), 512, 13)
    ' The label sits between the logo and the facts, so it lifts the logo
    release = releaseLabel()
    shift = 0
    if isValid(release) then shift = release.labelHeight + 13
    setupPreviewDraw.Logo(m.top, m.items, 0, cardX + 33, 381 - lift - shift, 400, 93, 46)
    if isValid(release) then release.translation = [cardX + 33, 381 - lift - shift + 106]
    setupPreviewDraw.MetaLine(m.top, m.items, 0, cardX + 33, 484 - lift, 24, "0xFFFFFFBF")

    ' The banner shows at most seven marks, through a window that holds the current one
    marks = m.top.pages
    if marks > 7 then marks = 7
    marksX = cardX + cardWidth - 30 - (27 + (marks - 1) * 17)
    setupPreviewDraw.Rect(m.top, marksX, cardY + 20, 27, 10, "0xFFFFFFFF")
    for i = 1 to marks - 1
        setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", marksX + 34 + (i - 1) * 17, cardY + 20, 10, 10, "0xFFFFFF66")
    end for

    setupPreviewDraw.CardRow(m.top, m.items, tr("Recently Added"), 111, 571, 170, 255, 10, m.pal, 1)
end sub

' Artwork first in a rounded frame with the logo in its top corner and the page marks in the
' other, and the first row peeking in under it
sub drawAya()
    frameX = 80
    frameY = 150
    frameWidth = 1760
    frameHeight = 702
    if m.top.rowPeek then frameHeight = 708
    setupPreviewDraw.RoundArt(m.top, frameX, frameY, frameWidth, frameHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant, 18, m.pal.background)
    setupPreviewDraw.Logo(m.top, m.items, 0, frameX + 44, frameY + 40, 340, 100, 52)
    release = releaseLabel()
    if isValid(release) then release.translation = [frameX + 44, frameY + 153]

    marksX = frameX + frameWidth - 24 - (16 + (m.top.pages - 1) * 15)
    setupPreviewDraw.Rect(m.top, marksX, frameY + 22, 16, 4, "0xFFFFFFFF")
    for i = 1 to m.top.pages - 1
        setupPreviewDraw.Rect(m.top, marksX + 21 + (i - 1) * 15, frameY + 22, 10, 4, "0xFFFFFF4D")
    end for

    ' Peek Home Rows draws Home's own row there instead
    if not m.top.rowPeek then setupPreviewDraw.CardRow(m.top, m.items, tr("Continue Watching"), frameX, 890, 300, 169, 6, m.pal, 1, "backdropUrl")
end sub

' No media bar at all, the rows start at the top of the screen
sub drawOff()
    setupPreviewDraw.CardRow(m.top, m.items, tr("Continue Watching"), 80, 48, 300, 169, 6, m.pal, 0, "backdropUrl")
    setupPreviewDraw.CardRow(m.top, m.items, tr("Recently Added"), 80, 400, 170, 255, 10, m.pal, 3)
    setupPreviewDraw.CardRow(m.top, m.items, tr("Next Up"), 80, 820, 300, 169, 6, m.pal, 6, "backdropUrl")
end sub

function smallScores() as object
    return { labelFont: "font:SmallestBoldSystemFont", labelColor: "#FFFFFF", iconHeight: 24, ratingSpacing: 16 }
end function

' A row of scores is drawn before the block it joins, so it's moved to end at the foot and the
' rest of the block is lifted by its height and the gap. Returns that lift.
function liftForScores(scoresRow as dynamic, foot as float, gap as float) as float
    if not isValid(scoresRow) then return 0
    height = scoresRow.boundingRect().height
    scoresRow.translation = [scoresRow.translation[0], foot - height]
    return height + gap
end function

function communityOnly(scores as object) as object
    if not isValid(scores) or not isValid(scores.data) then return scores
    kept = []
    for each rating in scores.data
        if rating.source = "stars" then kept.push(rating)
    end for
    return { data: kept, showNames: scores.showNames, showBadges: scores.showBadges }
end function

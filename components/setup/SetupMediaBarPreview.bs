import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/galleryGlow.bs"

' Home wearing one of the media bar styles, laid out to the real mode's geometry
' with the library's own art and text, so the pick is made by looking.
sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    m.pal = setupPreviewDraw.Palette()
    ' The settings live preview hands in the overlay it's trying, and the wizard keeps the saved one
    if m.top.overlayColor <> "" then m.pal.overlay = formatOverlayColor(m.top.overlayColor, m.pal.overlay)
    if m.top.overlayOpacity >= 0 then m.pal.overlayOpacity = m.top.overlayOpacity
    m.items = m.top.items
    m.scores = m.top.ratings
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, m.pal.background)

    mode = m.top.mode
    if isStringEqual(mode, "makd")
        drawMakd()
    else if isStringEqual(mode, "bookshelf")
        drawBookshelf()
    else if isStringEqual(mode, "gallery")
        drawGallery()
    else if isStringEqual(mode, "banner")
        drawBanner()
    else if isStringEqual(mode, "aya")
        drawAya()
    else if isStringEqual(mode, "off")
        drawOff()
    else
        setupPreviewDraw.Hero(m.top, m.items, m.pal, false, m.scores)
    end if
end sub

' Full bleed artwork washed with the overlay color from the left and the bottom, the logo
' and a column of facts and overview on the left, the page marks in the far corner
sub drawMakd()
    tint = m.pal.overlay
    strength = 0.78 * m.pal.overlayOpacity
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x00000040")
    setupPreviewDraw.FadeRight(m.top, 0, 0, 1500, 1080, tint, strength)
    setupPreviewDraw.FadeUp(m.top, 0, 420, 1920, 660, tint, strength)

    ' The scores sit between the facts and the overview, and the block keeps its foot where it was
    lift = liftForScores(setupPreviewDraw.RatingsLine(m.top, m.scores, 100, 0, smallScores()), 900, 14)
    setupPreviewDraw.Logo(m.top, m.items, 0, 100, 300, 640, 260, 64)
    setupPreviewDraw.MetaLine(m.top, m.items, 0, 100, 862 - lift, 24, "0xFFFFFFE6")
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), 100, 914, 806, 28, 3, "0xFFFFFFE0")

    dotsBg = setupPreviewDraw.Round(m.top, 1738, 1000, 142, 38, 19, "0x000000")
    dotsBg.opacity = 0.55
    setupPreviewDraw.Dots(m.top, 1809, 1010, 5, 14, 18, 10, "0xFFFFFF73")
end sub

' The real shelf: the open book standing face out at the left, then a run of spines tinted
' from the shelf's own colors, each with its number and its title up the side
sub drawBookshelf()
    spineColors = ["0xBF441BFF", "0xae792dFF", "0xD98934FF", "0x870F19FF", "0x7A5334FF", "0x592B2BFF", "0x30A49CFF", "0x6C7851FF"]
    shelf = m.top.createChild("Poster")
    shelf.width = 1920
    shelf.height = 1080
    shelf.loadDisplayMode = "scaleToZoom"
    shelf.uri = "pkg:/images/bookshelfBg.webp"

    setupPreviewDraw.Shape(m.top, "pkg:/images/bookWide.png", 59, 30, 620, 850, spineColors[0])
    setupPreviewDraw.Art(m.top, 127, 30, 560, 800, setupPreviewDraw.ItemField(m.items, 0, "posterUrl"), m.pal.surfaceVariant)

    for i = 1 to 19
        x = 694 + (i - 1) * 65
        setupPreviewDraw.Shape(m.top, "pkg:/images/bookSpine.png", x, 90, 60, 740, spineColors[i mod 8])
        number = setupPreviewDraw.TextLabel(m.top, Right("0" + (i + 1).toStr(), 2), x + 14, 105, 22, "0xE5D9C3FF", true)
        number.width = 32
        number.horizAlign = "center"
        spineTitle = setupPreviewDraw.TextLabel(m.top, UCase(setupPreviewDraw.ItemField(m.items, i, "title")), x + 15, 795, 22, "0xE5D9C3FF", true)
        spineTitle.width = 620
        spineTitle.height = 30
        spineTitle.horizAlign = "center"
        spineTitle.rotation = 1.5708
    end for
end sub

' One wide panel open on the current title, its facts and overview on the left and who made it
' on the right, with the next few folded into narrow panels that carry their titles on their side
sub drawGallery()
    panelX = 24
    panelY = 97
    panelHeight = 951
    found = setupPreviewDraw.Entry(m.items, 0)
    glowColor = galleryGlow.ForGenres(found.genres)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/glow.png", panelX - 56, panelY - 303, 1600, 1600, glowColor, 0.42)

    setupPreviewDraw.Art(m.top, panelX, panelY, 1478, panelHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/panelscrim.webp", panelX, panelY, 1478, panelHeight, "0xFFFFFFFF", 1)
    setupPreviewDraw.Corners(m.top, panelX, panelY, 1478, panelHeight, 14, m.pal.background)

    textX = panelX + 48
    title = setupPreviewDraw.TextLabel(m.top, UCase(setupPreviewDraw.ItemField(m.items, 0, "title")), textX, panelY + 40, 64, "0xFFFFFFFF", true)
    title.width = 812
    title.wrap = true
    title.maxLines = 2
    pillY = panelY + 40 + title.boundingRect().height + 24
    pillX = textX
    for each pill in galleryPills(found)
        pillX = drawGalleryPill(pill, pillX, pillY, glowColor) + 14
    end for
    ' The gallery's row only ever carries the community score
    scoresRow = setupPreviewDraw.RatingsLine(m.top, communityOnly(m.scores), textX, pillY + 78, { labelFont: "font:SmallestBoldSystemFont", labelColor: "#FFFFFF", iconHeight: 26, ratingSpacing: 16 })
    overviewY = pillY + 78
    if isValid(scoresRow) then overviewY += scoresRow.boundingRect().height + 26
    setupPreviewDraw.Paragraph(m.top, setupPreviewDraw.ItemField(m.items, 0, "overview"), textX, overviewY, 812, 30, 4, "0xFFFFFFE6")

    creditsX = panelX + 888
    creditsY = panelY + 40
    credits = setupPreviewDraw.Round(m.top, creditsX, creditsY, 542, 220, 18, "0x000000")
    credits.opacity = 0.55
    setupPreviewDraw.Ring(m.top, creditsX, creditsY, 542, 220, 18, "0xFFFFFF1F")
    setupPreviewDraw.TextLabel(m.top, UCase(tr("Director")), creditsX + 36, creditsY + 32, 22, m.pal.accent, true)
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 66, 240, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))
    setupPreviewDraw.TextLabel(m.top, UCase(tr("Starring")), creditsX + 36, creditsY + 112, 22, m.pal.accent, true)
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 146, 320, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))
    setupPreviewDraw.Round(m.top, creditsX + 36, creditsY + 182, 280, 24, 12, playbackOverlay.WithAlpha(m.pal.onSurface, 31))

    for i = 1 to 4
        x = panelX + 1478 + 6 + (i - 1) * 98
        art = setupPreviewDraw.Art(m.top, x, panelY, 92, panelHeight, setupPreviewDraw.ItemField(m.items, i, "backdropUrl"), "0x00000000")
        art.opacity = 0.35
        setupPreviewDraw.Scrim(m.top, "pkg:/images/gallery/panelscrim.webp", x, panelY, 92, panelHeight, "0xFFFFFFFF", 1)
        setupPreviewDraw.Corners(m.top, x, panelY, 92, panelHeight, 14, m.pal.background)

        number = setupPreviewDraw.TextLabel(m.top, Right("0" + (i + 1).toStr(), 2), x, panelY + 16, 28, "0xFFFFFFD9", true)
        number.width = 92
        number.horizAlign = "center"
        lineInk = playbackOverlay.WithAlpha(m.pal.accent, 179)
        setupPreviewDraw.Rect(m.top, x + 45, panelY + 96, 2, 48, lineInk)
        setupPreviewDraw.Rect(m.top, x + 45, panelY + 840, 2, 48, lineInk)
        sideTitle = setupPreviewDraw.TextLabel(m.top, UCase(setupPreviewDraw.ItemField(m.items, i, "title")), x + 66, panelY + 160, 28, "0xFFFFFFFF", true)
        sideTitle.width = 664
        sideTitle.height = 40
        sideTitle.horizAlign = "center"
        sideTitle.vertAlign = "center"
        sideTitle.rotation = -1.5708
    end for
end sub

' Runtime, the outlined age rating, the year, then the genres tinted with the panel's glow
function galleryPills(found as object) as object
    pills = []
    if isValidAndNotEmpty(found.runtime) then pills.push({ text: found.runtime, look: "plain" })
    if isValidAndNotEmpty(found.officialRating) then pills.push({ text: found.officialRating, look: "outlined" })
    if isValidAndNotEmpty(found.year) then pills.push({ text: found.year, look: "plain" })
    if isValid(found.genres)
        for each genre in found.genres
            pills.push({ text: genre, look: "tinted" })
        end for
    end if
    return pills
end function

function drawGalleryPill(pill as object, x as float, y as float, glowColor as string) as float
    if pill.look = "outlined"
        fill = setupPreviewDraw.Ring(m.top, x, y, 0, 52, 8, "0xFFFFFF8C")
    else
        fill = setupPreviewDraw.Round(m.top, x, y, 0, 52, 8, "0x00000059")
        if pill.look = "tinted" then fill.blendColor = playbackOverlay.WithAlpha(glowColor, 77)
    end if
    label = setupPreviewDraw.TextLabel(m.top, pill.text, x + 20, y, 24, "0xFFFFFFFF", true)
    label.height = 52
    label.vertAlign = "center"
    pillWidth = label.boundingRect().width + 40
    fill.width = pillWidth
    return x + pillWidth
end function

' The wide rounded banner below the navbar with the logo and facts in its bottom corner and the
' page marks in its top one, then the rows carrying on underneath
sub drawBanner()
    cardX = 60
    cardY = 130
    cardWidth = 1800
    cardHeight = 424
    setupPreviewDraw.Art(m.top, cardX, cardY, cardWidth, cardHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant)
    setupPreviewDraw.Scrim(m.top, "pkg:/images/banner/cardgradient.webp", cardX, cardY, cardWidth, cardHeight, "0xFFFFFFFF", 1)
    setupPreviewDraw.Corners(m.top, cardX, cardY, cardWidth, cardHeight, 16, m.pal.background)

    ' The block sits on the foot of the card, so the scores under the facts lift the rest
    lift = liftForScores(setupPreviewDraw.RatingsLine(m.top, m.scores, cardX + 44, 0, smallScores()), 528, 8)
    setupPreviewDraw.Logo(m.top, m.items, 0, cardX + 44, 396 - lift, 340, 90, 48)
    setupPreviewDraw.MetaLine(m.top, m.items, 0, cardX + 44, 500 - lift, 24, "0xFFFFFFBF")

    marksX = cardX + cardWidth - 26 - 78
    setupPreviewDraw.Rect(m.top, marksX, cardY + 18, 22, 8, "0xFFFFFFFF")
    for i = 1 to 4
        setupPreviewDraw.Shape(m.top, "pkg:/images/icons/circle.webp", marksX + 28 + (i - 1) * 14, cardY + 18, 8, 8, "0xFFFFFF66")
    end for

    setupPreviewDraw.CardRow(m.top, m.items, tr("Recently Added"), cardX, 598, 170, 255, 10, m.pal, 1)
end sub

' Artwork first in a rounded frame with the logo in its top corner and the page marks in the
' other, and the first row peeking in under it
sub drawAya()
    frameX = 80
    frameY = 150
    frameWidth = 1760
    frameHeight = 702
    setupPreviewDraw.RoundArt(m.top, frameX, frameY, frameWidth, frameHeight, setupPreviewDraw.ItemField(m.items, 0, "backdropUrl"), m.pal.surfaceVariant, 18, m.pal.background)
    setupPreviewDraw.Logo(m.top, m.items, 0, frameX + 44, frameY + 40, 340, 100, 52)

    marksX = frameX + frameWidth - 24 - 76
    setupPreviewDraw.Rect(m.top, marksX, frameY + 22, 16, 4, "0xFFFFFFFF")
    for i = 1 to 4
        setupPreviewDraw.Rect(m.top, marksX + 21 + (i - 1) * 15, frameY + 22, 10, 4, "0xFFFFFF4D")
    end for

    setupPreviewDraw.CardRow(m.top, m.items, tr("Continue Watching"), frameX, 890, 300, 169, 6, m.pal, 1, "backdropUrl")
end sub

' No media bar at all, the rows start at the top of the screen
sub drawOff()
    setupPreviewDraw.CardRow(m.top, m.items, tr("Continue Watching"), 80, 48, 300, 169, 6, m.pal, 0, "backdropUrl")
    setupPreviewDraw.CardRow(m.top, m.items, tr("Recently Added"), 80, 400, 170, 255, 10, m.pal, 3)
    setupPreviewDraw.CardRow(m.top, m.items, tr("Next Up"), 80, 820, 300, 169, 6, m.pal, 6, "backdropUrl")
end sub

function smallScores() as object
    return { labelFont: "font:SmallestBoldSystemFont", labelColor: "#FFFFFF", iconHeight: 24, ratingSpacing: 16 }
end function

' A row of scores is drawn before the block it joins, so it's moved to end at the foot and the
' rest of the block is lifted by its height and the gap. Returns that lift.
function liftForScores(scoresRow as dynamic, foot as float, gap as float) as float
    if not isValid(scoresRow) then return 0
    height = scoresRow.boundingRect().height
    scoresRow.translation = [scoresRow.translation[0], foot - height]
    return height + gap
end function

function communityOnly(scores as object) as object
    if not isValid(scores.data) then return scores
    kept = []
    for each rating in scores.data
        if rating.source = "stars" then kept.push(rating)
    end for
    return { data: kept, showNames: scores.showNames, showBadges: scores.showBadges }
end function

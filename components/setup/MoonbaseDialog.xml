<?xml version="1.0" encoding="utf-8"?>
<component name="MoonbaseDialog" extends="JFGroup">
    <interface>
        <field id="serverType" type="string" />
        <field id="isAdmin" type="boolean" />
        <!-- Set once Moonbase went onto the server, read when the dialog closes -->
        <field id="installed" type="boolean" value="false" />
        <field id="wasClosed" type="boolean" alwaysNotify="true" />
        <function name="open" />
    </interface>
</component>

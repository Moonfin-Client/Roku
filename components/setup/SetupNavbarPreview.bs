import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

' A miniature home screen with the navigation drawn where the choice would
' put it, the pill bar across the top or a rail down the left. The screen
' behind it is the featured hero home actually opens on, and the chrome uses
' the app's real icons and logo.
sub init()
    redraw()
end sub

function navIcons() as object
    return [
        "pkg:/images/icons/home.webp",
        "pkg:/images/icons/search-light.webp",
        "pkg:/images/icons/shuffle.webp",
        "pkg:/images/icons/masks.webp",
        "pkg:/images/icons/library.webp",
        "pkg:/images/icons/settings.webp"
    ]
end function

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    leftNav = isStringEqual(m.top.position, "left")

    if isValid(m.top.screen)
        ' It sits on the page color the app's own screens use
        setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, themeChrome.Token("background", "0x101010FF"))
        m.top.appendChild(m.top.screen)
    else
        setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)
        setupPreviewDraw.Hero(m.top, items, pal, leftNav)
    end if

    buttons = m.top.buttons
    if not isValid(buttons) or buttons.count() = 0
        buttons = []
        for each uri in navIcons()
            buttons.push({ uri: uri, label: "" })
        end for
    end if
    expanded = m.top.expanded

    if leftNav and m.top.collapsedRail and not expanded
        drawCollapsedRail(buttons, pal)
        return
    end if

    if leftNav
        railWidth = 110
        if expanded then railWidth = 340
        railColor = m.top.barColor
        if railColor = "" then railColor = pal.surface
        setupPreviewDraw.Rect(m.top, 0, 0, railWidth, 1080, railColor)
        person = setupPreviewDraw.Icon(m.top, "pkg:/images/baseline_person_white_48dp.webp", 33, 60, 44, pal.onSurfaceDim)
        drawAvatar(person, 33, 60, 44)
        index = 0
        for each button in buttons
            color = pal.onSurfaceDim
            if index = 0 then color = pal.onSurface
            drawButtonIcon(m.top, button, 33, 380 + index * 70, 44, color)
            if expanded
                name = setupPreviewDraw.TextLabel(m.top, button.label, 100, 380 + index * 70, 28, color, true)
                name.width = railWidth - 116
                name.height = 44
                name.vertAlign = "center"
            end if
            index++
        end for
        ' The real rail only shows its clock while it's open, centered across its foot
        if expanded and m.top.showClock
            clock = setupPreviewDraw.TextLabel(m.top, clockText(m.top.clock24), 0, 1028, 22, "0xFFFFFF80", false)
            clock.width = railWidth
            clock.height = 26
            clock.horizAlign = "center"
        end if
        return
    end if

    logo = m.top.createChild("Poster")
    logo.translation = [64, 36]
    logo.width = 56
    logo.height = 56
    logo.loadDisplayMode = "scaleToFit"
    logo.uri = "pkg:/images/logo.webp"
    drawAvatar(logo, 64, 36, 56)

    ' An expanded bar names each button beside its icon, so the pill is measured first
    names = []
    widths = []
    for each button in buttons
        width = 40.0
        if expanded and button.label <> ""
            name = setupPreviewDraw.TextLabel(m.top, button.label, 0, 46, 26, pal.onSurface, true)
            name.height = 40
            name.vertAlign = "center"
            names.push(name)
            width = 40 + 12 + name.boundingRect().width
        else
            names.push(invalid)
        end if
        widths.push(width)
    end for
    pillWidth = 70.0
    for each width in widths
        pillWidth = pillWidth + width + 26
    end for
    pillWidth = pillWidth - 26
    ' The real bar stops growing at 1400 and scrolls what's past it
    if pillWidth > 1400 then pillWidth = 1400
    pillX = 960 - pillWidth / 2

    barColor = m.top.barColor
    if barColor = "" then barColor = "0x22252BE6"
    setupPreviewDraw.Round(m.top, pillX, 28, pillWidth, 76, 38, barColor)
    row = m.top.createChild("Group")
    row.clippingRect = [pillX + 16, 28, pillWidth - 32, 76]
    x = pillX + 32
    for index = 0 to buttons.count() - 1
        color = pal.onSurfaceDim
        if index = 0 then color = pal.onSurface
        drawButtonIcon(row, buttons[index], x, 46, 40, color)
        name = names[index]
        if isValid(name)
            ' Back on top of the pill
            m.top.removeChild(name)
            row.appendChild(name)
            name.translation = [x + 52, 46]
            name.color = color
        end if
        x = x + widths[index] + 26
    end for

    if m.top.showClock
        clock = setupPreviewDraw.TextLabel(m.top, clockText(m.top.clock24), 1560, 28, 30, pal.onSurface, false)
        clock.width = 300
        clock.height = 76
        clock.horizAlign = "right"
        clock.vertAlign = "center"
    end if
end sub

' The real collapsed sidebar: no panel, the user's picture at the top and the icons centered in the
' band between it and the clock, each dimmed while the rail doesn't have the focus
sub drawCollapsedRail(buttons as object, pal as object)
    person = setupPreviewDraw.Icon(m.top, "pkg:/images/baseline_person_white_48dp.webp", 24, 34, 50, pal.onSurface)
    drawAvatar(person, 24, 34, 50)
    ' Each row is 56 tall with 3 above and below, and its 38 icon sits 24 in and 9 down
    rowHeight = 62
    top = 118 + (894 - buttons.count() * rowHeight) / 2
    if top < 118 then top = 118
    for i = 0 to buttons.count() - 1
        drawButtonIcon(m.top, buttons[i], 24, top + i * rowHeight + 3 + 9, 38, playbackOverlay.WithAlpha(pal.onSurface, 153))
    end for
end sub

sub drawButtonIcon(parent as object, button as object, x as float, y as float, size as float, color as string)
    if not isValidAndNotEmpty(button.glyph)
        setupPreviewDraw.Icon(parent, button.uri, x, y, size, color)
        return
    end if
    glyph = parent.createChild("Label")
    glyph.font = CreateObject("roSGNode", "Font")
    glyph.font.uri = settingsGlyphs.FONT_URI
    glyph.font.size = size
    glyph.text = settingsGlyphs.Char(button.glyph)
    glyph.translation = [x, y]
    glyph.width = size
    glyph.height = size
    glyph.horizAlign = "center"
    glyph.vertAlign = "center"
    glyph.color = color
end sub

' The signed in user's picture over the stand in, which only goes once the picture has loaded, so
' a user without one keeps it
sub drawAvatar(standIn as object, x as float, y as float, size as float)
    if not isValidAndNotEmpty(m.top.avatar) then return
    mask = m.top.createChild("MaskGroup")
    mask.maskUri = "pkg:/images/icons/circle.webp"
    mask.maskSize = [size, size]
    mask.translation = [x, y]
    picture = mask.createChild("Poster")
    picture.width = size
    picture.height = size
    picture.loadDisplayMode = "scaleToZoom"
    m.avatarStandIn = standIn
    picture.observeField("loadStatus", "onAvatarStatus")
    picture.uri = m.top.avatar
end sub

sub onAvatarStatus(event as object)
    if event.getData() = "ready" then m.avatarStandIn.visible = false
end sub

function clockText(clock24 as boolean) as string
    now = CreateObject("roDateTime")
    now.ToLocalTime()
    hours = now.GetHours()
    minutes = Right("0" + now.GetMinutes().toStr(), 2)
    if clock24 then return `${Right("0" + hours.toStr(), 2)}:${minutes}`
    suffix = "AM"
    if hours >= 12 then suffix = "PM"
    hours = hours mod 12
    if hours = 0 then hours = 12
    return `${hours}:${minutes} ${suffix}`
end function

<?xml version="1.0" encoding="utf-8"?>
<!-- A row of anime marker pills: filler or canon, recap, then subbed or dubbed. Only the
     marker redraws the row, so the other fields are set before it. -->
<component name="AnimeMarkerPills" extends="Group">
    <interface>
        <field id="marker" type="assocarray" onChange="onMarkerChanged" />
        <!-- normal, compact or large -->
        <field id="pillSize" type="string" value="normal" />
        <!-- How many pills at most, where 0 shows them all -->
        <field id="maxPills" type="integer" value="0" />
        <!-- Swaps each tint for a dark scrim, for a pill drawn over artwork -->
        <field id="overlay" type="boolean" value="false" />
        <!-- The widest the row may run, where 0 leaves it free -->
        <field id="maxWidth" type="float" value="0" />
        <!-- Read back after a draw, since callers lay out around the row -->
        <field id="rowWidth" type="float" value="0" />
        <field id="rowHeight" type="float" value="0" />
    </interface>
</component>

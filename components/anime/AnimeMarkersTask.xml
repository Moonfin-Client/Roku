<?xml version="1.0" encoding="utf-8"?>
<!-- Asks the plugin for one batch of anime markers on behalf of AnimeMarkerStore -->
<component name="AnimeMarkersTask" extends="Task">
    <interface>
        <!-- { series: [...], items: [...] }, as AnimeMarkerStore builds it -->
        <field id="job" type="assocarray" />
        <field id="result" type="assocarray" />
    </interface>
</component>

import "pkg:/source/utils/animeMarkers.bs"
import "pkg:/source/utils/misc.bs"

' Shared by every card and screen that draws anime marker pills. The host supplies
' showAnimeMarker(marker), which is handed the marker whenever it changes and an empty
' one when there is nothing to draw.

' Where a card pill sits over its artwork, and how far up it moves to clear a progress bar
const ANIME_CARD_PILL_EDGE = 8
const ANIME_CARD_PILL_ABOVE_PROGRESS = 26

' Follows one item's marker, asking the shared store for it. A card passes delayed so its
' artwork draws before the pills arrive.
sub watchAnimeMarker(node as dynamic, json as dynamic, delayed = false as boolean)
    stopWatchingAnimeMarker()
    showAnimeMarker({})

    if type(node) <> "roSGNode" then return

    lookup = animeMarkers.LookupFor(json)
    if not isValid(lookup) then return

    if not animeMarkerStore().callFunc("requestMarker", { node: node, lookup: lookup, delayed: delayed }) then return

    node.observeFieldScoped("animeMarker", "onWatchedAnimeMarkerChanged")
    m.animeMarkerNode = node
    showAnimeMarker(node.animeMarker)
end sub

sub stopWatchingAnimeMarker()
    if isValid(m.animeMarkerNode) then m.animeMarkerNode.unobserveFieldScoped("animeMarker")
    m.animeMarkerNode = invalid
end sub

sub onWatchedAnimeMarkerChanged()
    if isValid(m.animeMarkerNode) then showAnimeMarker(m.animeMarkerNode.animeMarker)
end sub

' One store for the whole app, made on first use. That first use is always a card or a
' screen, so it belongs to the render thread its timers and task need.
function animeMarkerStore() as object
    if not m.global.hasField("animeMarkerStore")
        m.global.addFields({ animeMarkerStore: CreateObject("roSGNode", "AnimeMarkerStore") })
    end if

    return m.global.animeMarkerStore
end function

' The single pill a card draws over its artwork, bottom left. Made the first time there is
' something to show and kept on the card after that.
function drawAnimeCardPill(pills as dynamic, parent as object, marker as dynamic, cardWidth as float, cardHeight as float, aboveProgress as boolean) as dynamic
    if not isValid(pills)
        if not animeMarkers.HasPills(marker) then return invalid

        pills = parent.createChild("AnimeMarkerPills")
        pills.pillSize = "compact"
        pills.maxPills = 1
        pills.overlay = true
    end if

    pills.maxWidth = cardWidth - (ANIME_CARD_PILL_EDGE * 2)
    pills.marker = marker ?? {}

    bottom = aboveProgress ? ANIME_CARD_PILL_ABOVE_PROGRESS : ANIME_CARD_PILL_EDGE
    pills.translation = [ANIME_CARD_PILL_EDGE, cardHeight - bottom - pills.rowHeight]

    return pills
end function

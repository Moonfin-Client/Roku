<?xml version="1.0" encoding="utf-8"?>
<!-- The one cache of anime markers for the whole app. It sits on the global node and keeps
     its state inside rather than in a global field, since every read of a global field
     hands back a copy and a long series table would be copied on each card. Lookups
     answer by stamping an animeMarker field on the node they were asked for. -->
<component name="AnimeMarkerStore" extends="Node">
    <interface>
        <!-- { node, lookup, delayed }, returning false when the feature is off -->
        <function name="requestMarker" />
        <function name="clearMarkers" />
    </interface>
</component>

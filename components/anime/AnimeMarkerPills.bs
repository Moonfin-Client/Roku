import "pkg:/source/utils/animeMarkers.bs"
import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"

const PILL_GAP = 8
const PILL_BORDER = 1

' A pill that cant show this much of its label is left off rather than cut to nothing
const PILL_MIN_LABEL = 40

' The scrim a card overlay puts behind each label, so it reads over any artwork
const PILL_OVERLAY_FILL = "#000000B8"

sub init()
    m.top.visible = false
end sub

sub onMarkerChanged()
    m.top.removeChildrenIndex(m.top.getChildCount(), 0)

    entries = animeMarkers.PillsFor(m.top.marker)
    while m.top.maxPills > 0 and entries.count() > m.top.maxPills
        entries.pop()
    end while

    ' Most cards have no marker, so an empty row skips the font lookups
    if entries.count() = 0
        m.top.rowWidth = 0
        m.top.rowHeight = 0
        m.top.visible = false
        return
    end if

    metrics = pillMetrics(m.top.pillSize)
    fontSize = fontApply.ThemeTextSize(metrics.fontSize)
    for each entry in entries
        buildPill(entry, metrics, fontSize)
    end for

    ' A theme font draws at its own width, so it goes on before anything is measured
    fontApply.ApplyThemeFonts(m.top)

    x = 0
    height = metrics.lineHeight + ((metrics.padV + PILL_BORDER) * 2)
    placed = 0
    for each pill in m.top.getChildren(-1, 0)
        room = invalid
        if m.top.maxWidth > 0 then room = m.top.maxWidth - x

        width = sizePill(pill, metrics, height, room)
        if width = 0 then exit for

        pill.translation = [x, 0]
        x += width + PILL_GAP
        placed++
    end for

    ' Whatever ran out of room goes
    m.top.removeChildrenIndex(m.top.getChildCount() - placed, placed)

    m.top.rowWidth = placed > 0 ? x - PILL_GAP : 0
    m.top.rowHeight = placed > 0 ? height : 0
    m.top.visible = placed > 0
end sub

' The type runs a step larger than the padding, corners and line height would suggest, since
' the system font draws small for its size
function pillMetrics(pillSize as string) as object
    if pillSize = "compact"
        return {
            fontSize: 16, lineHeight: 20, padH: 9, padV: 1,
            fillUri: "pkg:/images/details/surface8.9.png", borderUri: "pkg:/images/details/outline8.9.png"
        }
    end if

    if pillSize = "large"
        return {
            fontSize: 23, lineHeight: 29, padH: 14, padV: 3,
            fillUri: "pkg:/images/details/surface11.9.png", borderUri: "pkg:/images/details/outline11.9.png"
        }
    end if

    return {
        fontSize: 18, lineHeight: 23, padH: 11, padV: 2,
        fillUri: "pkg:/images/playback/surface9.9.png", borderUri: "pkg:/images/details/outline9.9.png"
    }
end function

' A pill's fill, border and label, which sizePill measures and lays out once the font is final
sub buildPill(entry as object, metrics as object, fontSize as integer)
    colors = animeMarkers.ToneColors(entry.tone)
    pill = m.top.createChild("Group")

    fill = pill.createChild("Poster")
    fill.uri = metrics.fillUri
    fill.blendColor = m.top.overlay ? PILL_OVERLAY_FILL : colors.fill

    border = pill.createChild("Poster")
    border.uri = metrics.borderUri
    border.blendColor = colors.border

    label = pill.createChild("Label")
    label.font = "font:SmallestBoldSystemFont"
    label.font.size = fontSize
    label.color = colors.text
    label.text = entry.label
    label.height = metrics.lineHeight
    label.vertAlign = "center"
    label.translation = [metrics.padH + PILL_BORDER, metrics.padV + PILL_BORDER]
end sub

' Returns the pill's width, or 0 when there is no longer room for it
function sizePill(pill as object, metrics as object, height as float, room as dynamic) as float
    inset = metrics.padH + PILL_BORDER
    label = pill.getChild(2)

    textWidth = label.boundingRect().width
    if isValid(room) and textWidth + (inset * 2) > room
        textWidth = room - (inset * 2)
        if textWidth < PILL_MIN_LABEL then return 0

        label.width = textWidth
        label.ellipsisText = "..."
    end if

    width = textWidth + (inset * 2)
    for i = 0 to 1
        layer = pill.getChild(i)
        layer.width = width
        layer.height = height
    end for

    return width
end function

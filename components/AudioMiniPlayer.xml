<?xml version="1.0" encoding="utf-8"?>
<component name="AudioMiniPlayer" extends="Group">
  <children>
    <Group id="pill" visible="false" translation="[0, 106]">
      <Poster id="pillFill" uri="pkg:/images/playback/surface41.9.png" height="88" />
      <Poster id="pillBorder" uri="pkg:/images/playback/outline41.9.png" height="88" blendColor="#FFFFFF" opacity=".15" />

      <Poster uri="pkg:/images/icons/musicNote.png" width="32" height="32" translation="[48, 28]" opacity=".6" />
      <MaskGroup maskUri="pkg:/images/miniPlayerArtMask.png" maskSize="[64, 64]" translation="[32, 12]">
        <Poster id="albumCover" width="64" height="64" loadDisplayMode="scaleToFill" />
      </MaskGroup>

      <Poster id="titleFocus" uri="pkg:/images/playback/surface17.9.png" height="64" translation="[108, 12]" blendColor="#FFFFFF" opacity=".22" visible="false" />
      <ScrollingText id="song" translation="[120, 24]" maxWidth="560" height="40" vertAlign="center">
        <Font role="font" uri="font:BoldSystemFontFile" size="26" />
      </ScrollingText>
      <Label id="songMeasure" visible="false">
        <Font role="font" uri="font:BoldSystemFontFile" size="26" />
      </Label>

      <!-- Built in init, one disc and icon per action -->
      <Group id="buttons" translation="[0, 12]" />
    </Group>
  </children>
  <interface>
    <field id="active" type="boolean" value="false" />
    <field id="songTitle" type="string" />
    <field id="artistName" type="string" />
    <field id="artUri" type="string" />
    <field id="isPlaying" type="boolean" />
    <function name="setup" />
    <function name="setVisible" />
    <function name="isVisible" />
    <function name="runAction" />
    <function name="focusTitle" />
  </interface>
</component>

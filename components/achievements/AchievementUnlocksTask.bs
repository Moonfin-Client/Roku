import "pkg:/source/api/Achievements.bs"
import "pkg:/source/utils/misc.bs"

' How often newly unlocked badges are asked for. The plugin gives each user 60 requests a minute
' across all of its routes, and a read is one or two of them.
const UNLOCK_POLL_MS = 30000

sub init()
    m.top.functionName = "pollUnlocks"
end sub

' Reads once straight away and then on every interval until the task is stopped. The switch on
' the achievements screen hands over the settings it saved, so the reads follow it without
' waiting for the settings to be read again.
sub pollUnlocks()
    port = CreateObject("roMessagePort")
    m.top.observeField("control", port)
    m.global.observeFieldScoped("unlockToastSettings", port)

    state = achievements.NewUnlockState()
    clock = CreateObject("roTimespan")
    while true
        found = achievements.ReadUnlocks(state)
        if isValid(found) then m.top.unlocks = found

        clock.Mark()
        remaining = UNLOCK_POLL_MS
        while remaining > 0
            msg = wait(remaining, port)
            if type(msg) = "roSGNodeEvent"
                if msg.getField() = "control" and LCase(msg.getData()) = "stop"
                    m.global.unobserveFieldScoped("unlockToastSettings")
                    return
                end if
                if msg.getField() = "unlockToastSettings" then achievements.AdoptUnlockSettings(state, msg.getData())
            end if
            remaining = UNLOCK_POLL_MS - clock.TotalMilliseconds()
        end while
    end while
end sub

import "pkg:/source/api/Achievements.bs"
import "pkg:/source/utils/misc.bs"

' The panel asks for everything at once when it opens, and the leaderboard, the recap, a badge,
' the activity feed, the stats, the loadout, the shop, the appearance, the unlock notification
' switch and what the viewer spends or wears ask again as they work. All of it goes over the
' network, so none of it runs on the render thread.

sub init()
    m.top.functionName = "loadAchievements"
end sub

sub loadAchievements()
    request = m.top.request
    kind = chainLookupReturn(request, "kind", "overview")

    if kind = "leaderboard"
        m.top.result = { kind: kind, entries: achievements.FetchLeaderboard(request.category) }
        return
    end if

    if kind = "recap"
        m.top.result = { kind: kind, recap: achievements.FetchRecap(request.period) }
        return
    end if

    if kind = "chase"
        m.top.result = { kind: kind, chase: achievements.FetchBadgeChase(request.badgeId) }
        return
    end if

    if kind = "activity"
        m.top.result = { kind: kind, activity: achievements.FetchActivity() }
        return
    end if

    if kind = "stats"
        m.top.result = { kind: kind, stats: achievements.FetchStats() }
        return
    end if

    if kind = "cosmetics"
        m.top.result = { kind: kind, cosmetics: achievements.FetchCosmetics() }
        return
    end if

    if kind = "wear"
        wear = request.worn ? achievements.UnequipCosmetic(request.cosmeticKind) : achievements.EquipCosmetic(request.cosmeticId)
        m.top.result = { kind: kind, worn: request.worn, cosmeticId: request.cosmeticId, cosmeticKind: request.cosmeticKind, wear: wear }
        return
    end if

    if kind = "powerups"
        m.top.result = { kind: kind, powerUps: achievements.FetchPowerUps() }
        return
    end if

    ' The catalogue carries no bank, so the two are read together
    if kind = "shop"
        m.top.result = { kind: kind, items: achievements.FetchShopPowerUps(), powerUps: achievements.FetchPowerUps() }
        return
    end if

    if kind = "buy"
        m.top.result = { kind: kind, purchase: achievements.BuyShopItem(request.itemId) }
        return
    end if

    if kind = "usePowerUp"
        m.top.result = { kind: kind, spend: achievements.UsePowerUp(request.powerUpType) }
        return
    end if

    if kind = "reroll"
        m.top.result = { kind: kind, weekly: request.weekly, reroll: achievements.RerollQuests(request.weekly) }
        return
    end if

    if kind = "unlockToasts"
        m.top.result = { kind: kind, settings: achievements.FetchUnlockToastSettings() }
        return
    end if

    if kind = "saveUnlockToasts"
        m.top.result = { kind: kind, settings: achievements.SaveUnlockToasts(request.enabled) }
        return
    end if

    m.top.result = { kind: "overview", overview: achievements.LoadOverview() }
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Asks the plugin for newly unlocked badges every so often, for as long as the user is signed in -->
<component name="AchievementUnlocksTask" extends="Task">
    <interface>
        <!-- The badges a read turned up that the user wants to hear about, with how to show them -->
        <field id="unlocks" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

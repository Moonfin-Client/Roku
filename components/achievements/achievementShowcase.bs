import "pkg:/source/utils/achievementsIcons.bs"
import "pkg:/source/utils/achievementsModel.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeChrome.bs"

const ACHIEVEMENT_SHOWCASE_ITEM = 150
const ACHIEVEMENT_SHOWCASE_AVATAR = 84
const ACHIEVEMENT_SHOWCASE_ICON = 44
const ACHIEVEMENT_SHOWCASE_TITLE_GAP = 10
const ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT = 50

' The badges someone chose to show off, as many as fit across the width, drawn into target.
' Answers the height they take.
function drawAchievementShowcase(target as object, badges as object, font as object, width as integer) as float
    target.removeChildrenIndex(target.getChildCount(), 0)

    perRow = Int(width / ACHIEVEMENT_SHOWCASE_ITEM)
    x = 0
    count = 0
    for each badge in badges
        if count >= perRow then exit for

        color = achievementsModel.RarityColor(badge.rarity)
        item = target.createChild("Group")
        item.translation = [x, 0]

        inset = (ACHIEVEMENT_SHOWCASE_ITEM - ACHIEVEMENT_SHOWCASE_AVATAR) / 2

        fill = item.createChild("Poster")
        fill.uri = "pkg:/images/tracks/panel20.9.png"
        fill.loadDisplayMode = "scaleToFit"
        fill.blendColor = themeChrome.WithAlpha(color, "2E")
        fill.width = ACHIEVEMENT_SHOWCASE_AVATAR
        fill.height = ACHIEVEMENT_SHOWCASE_AVATAR
        fill.translation = [inset, 0]

        border = item.createChild("Poster")
        border.uri = "pkg:/images/tracks/panelborder20.9.png"
        border.loadDisplayMode = "scaleToFit"
        border.blendColor = themeChrome.WithAlpha(color, "73")
        border.width = ACHIEVEMENT_SHOWCASE_AVATAR
        border.height = ACHIEVEMENT_SHOWCASE_AVATAR
        border.translation = [inset, 0]

        icon = item.createChild("Poster")
        icon.uri = achievementsIcons.PathFor(badge.icon)
        icon.failedBitmapUri = "pkg:/images/achievements/emoji_events.png"
        icon.width = ACHIEVEMENT_SHOWCASE_ICON
        icon.height = ACHIEVEMENT_SHOWCASE_ICON
        icon.blendColor = themeChrome.WithAlpha(color, "FF")
        iconInset = (ACHIEVEMENT_SHOWCASE_AVATAR - ACHIEVEMENT_SHOWCASE_ICON) / 2
        icon.translation = [inset + iconInset, iconInset]

        title = item.createChild("Label")
        title.font = font
        title.color = "#FFFFFFE6"
        title.width = ACHIEVEMENT_SHOWCASE_ITEM
        title.height = ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT
        title.horizAlign = "center"
        title.wrap = true
        title.maxLines = 2
        title.translation = [0, ACHIEVEMENT_SHOWCASE_AVATAR + ACHIEVEMENT_SHOWCASE_TITLE_GAP]
        title.text = badge.title

        x += ACHIEVEMENT_SHOWCASE_ITEM
        count++
    end for

    themeApply.ApplyToItem(target)
    return ACHIEVEMENT_SHOWCASE_AVATAR + ACHIEVEMENT_SHOWCASE_TITLE_GAP + ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT
end function

import "pkg:/source/utils/achievementsIcons.bs"
import "pkg:/source/utils/achievementsModel.bs"
import "pkg:/source/utils/contentNodes.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/relativeTime.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeChrome.bs"

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"

' The Achievement Badges panel. Every screen renders from the one load so moving between them
' costs nothing, and only the leaderboard and the recap ask the server for anything more.
'
' The panel keeps its own stack of views rather than pushing scenes, so BACK walks back through
' them one at a time and lands on the settings entry it was opened from.

const ACHIEVEMENT_PANEL_X = 1146
const ACHIEVEMENT_PANEL_WIDTH = 747
const ACHIEVEMENT_PANEL_TOP = 80
const ACHIEVEMENT_TAB_BAR_HEIGHT = 63
const ACHIEVEMENT_SECTION_GAP = 24
const ACHIEVEMENT_CHIP_HEIGHT = 44
const ACHIEVEMENT_CHIP_GAP = 10
const ACHIEVEMENT_CHIP_PAD = 18
const ACHIEVEMENT_CHIP_ICON = 26
const ACHIEVEMENT_CHIP_ICON_INSET = 14
const ACHIEVEMENT_CHIP_ICON_GAP = 10
const ACHIEVEMENT_SHOWCASE_ITEM = 150
const ACHIEVEMENT_SHOWCASE_AVATAR = 84
const ACHIEVEMENT_SHOWCASE_ICON = 44
const ACHIEVEMENT_SHOWCASE_TITLE_GAP = 10
const ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT = 50

' The rank block, read top to bottom
const ACHIEVEMENT_RANK_AVATAR = 88
const ACHIEVEMENT_RANK_ROW_GAP = 18
const ACHIEVEMENT_RANK_BAR_HEIGHT = 10
const ACHIEVEMENT_RANK_BAR_GAP = 10
const ACHIEVEMENT_RANK_NOTE_HEIGHT = 30
const ACHIEVEMENT_CHIPS_GAP = 20
const ACHIEVEMENT_SHOWCASE_GAP = 12

sub init()
    m.path = m.top.findNode("path")
    m.header = m.top.findNode("header")
    m.rankRow = m.top.findNode("rankRow")
    m.rankFill = m.top.findNode("rankFill")
    m.rankBorder = m.top.findNode("rankBorder")
    m.rankIcon = m.top.findNode("rankIcon")
    m.rankName = m.top.findNode("rankName")
    m.rankScore = m.top.findNode("rankScore")
    m.rankBarTrack = m.top.findNode("rankBarTrack")
    m.rankBarFill = m.top.findNode("rankBarFill")
    m.rankNote = m.top.findNode("rankNote")
    m.chips = m.top.findNode("chips")
    m.chipFont = m.top.findNode("chipFont")
    m.showcase = m.top.findNode("showcase")

    m.tabBar = m.top.findNode("tabBar")
    m.tabBar.maxWidth = ACHIEVEMENT_PANEL_WIDTH
    m.tabBar.observeField("activated", "onTabActivated")
    m.tabBar.observeField("escape", "onTabEscape")

    m.rowList = m.top.findNode("rowList")
    m.rowList.observeField("itemSelected", "onRowSelected")
    m.rowList.observeField("itemFocused", "onRowFocused")

    m.skipHeadingTimer = m.top.findNode("skipHeadingTimer")
    m.skipHeadingTimer.observeField("fire", "onSkipHeadingTimer")
    m.lastFocusIndex = 0
    m.pendingFocusIndex = -1
    m.restoringFocus = false

    m.message = m.top.findNode("message")
    m.retryButton = m.top.findNode("retryButton")
    m.retryFocus = m.top.findNode("retryFocus")
    m.top.findNode("retryLabel").text = tr("Retry")

    m.loadTask = m.top.findNode("loadTask")
    m.loadTask.observeField("result", "onLoadResult")
    m.unlockToastsTask = m.top.findNode("unlockToastsTask")
    m.unlockToastsTask.observeField("result", "onUnlockToastsResult")

    m.chipFont.font.size = 22
    m.rankName.font.size = 34
    m.rankScore.font.size = 24
    m.rankNote.font.size = 22

    m.accent = themeChrome.Accent()
    m.overview = invalid
    m.loading = true
    m.view = "overview"
    m.stack = []
    m.badgeFilter = achievementsModel.BadgeFilters()[0]
    m.openCategories = {}
    m.board = boardIds()[0]
    m.period = ACHIEVEMENTS_DEFAULT_PERIOD
    m.boardEntries = []
    m.recap = invalid
    m.rows = []
    m.retryKind = ""
    m.badgeId = ""
    m.chase = invalid
    m.activity = []
    m.stats = invalid
    m.cosmetics = invalid
    m.cosmeticKind = COSMETIC_AVATAR
    m.powerUps = invalid
    m.shopItems = []
    m.shopBank = 0
    m.spendProblem = ""
    m.spendBusy = false
    m.powerUpType = ""
    m.shopItemId = ""
    m.rerollBusy = false
    m.rerollFailed = false
    m.rerollWeekly = false
    m.spendPrompt = invalid
    m.spendIndex = -1
    ' Left invalid until the plugin says which way the switch is
    m.unlockToasts = invalid
    m.unlockToastsBusy = false
    m.unlockToastsProblem = ""

    m.top.optionsAvailable = false
    themeApply.ApplyToItem(m.top)
end sub

sub OnScreenShown(_isReturning = false as boolean)
    if isValid(m.overview) or not m.loading then return
    startLoad({ kind: "overview" })
end sub

sub startLoad(request as object)
    ' A reroll, a spend or a purchase answers one row, so the list stays on screen rather than
    ' blanking to a spinner
    m.loading = request.kind <> "reroll" and request.kind <> "usePowerUp" and request.kind <> "buy" and request.kind <> "wear"
    render()
    m.loadTask.control = TaskControl.STOP
    m.loadTask.request = request
    m.loadTask.control = TaskControl.RUN
end sub

sub onLoadResult(event as object)
    result = event.getData()
    if not isValid(result) then return

    m.loading = false
    if result.kind = "reroll"
        applyReroll(result.weekly, result.reroll)
    else if result.kind = "chase"
        m.chase = result.chase
    else if result.kind = "activity"
        m.activity = result.activity
    else if result.kind = "stats"
        m.stats = result.stats
    else if result.kind = "cosmetics"
        m.cosmetics = result.cosmetics.count() > 0 ? result.cosmetics : invalid
    else if result.kind = "wear"
        applyWear(result)
    else if result.kind = "powerups"
        m.powerUps = result.powerUps
    else if result.kind = "shop"
        m.shopItems = result.items
        m.shopBank = isValid(result.powerUps) ? result.powerUps.bank : 0
    else if result.kind = "usePowerUp"
        applySpend(result.spend)
    else if result.kind = "buy"
        applyPurchase(result.purchase)
    else if result.kind = "leaderboard"
        m.boardEntries = result.entries
    else if result.kind = "recap"
        m.recap = result.recap
    else
        m.overview = result.overview
        if isValid(m.overview)
            m.boardEntries = m.overview.leaderboard
            m.recap = m.overview.recap
            if m.overview.unlockToastsEnabled then startUnlockToastsTask({ kind: "unlockToasts" })
        end if
    end if

    render()
    if result.kind = "reroll" or result.kind = "usePowerUp" or result.kind = "buy" then focusRow(m.spendIndex)
end sub

' ===== Views =====

sub pushView(view as string)
    m.stack.push({ view: m.view, index: m.rowList.itemFocused })
    m.view = view
    render()
end sub

function popView() as boolean
    if m.stack.count() = 0 then return false

    held = m.stack.pop()
    m.view = held.view

    ' The shop spends from the bank the loadout shows, so coming back reads it again
    if m.view = "loadout"
        startLoad({ kind: "powerups" })
        return true
    end if

    render()
    focusRow(held.index)
    return true
end function

sub render()
    m.path.text = breadcrumb()

    isOverview = m.view = "overview"
    hasOverview = isValid(m.overview)

    m.header.visible = isOverview and hasOverview and not m.loading
    m.tabBar.visible = false
    m.rowList.visible = false
    m.message.visible = false
    m.retryButton.visible = false
    m.retryKind = ""

    if m.loading and not hasOverview
        showMessage(tr("Loading..."))
        return
    end if

    if not hasOverview
        showLoadFailed("overview")
        return
    end if

    if isOverview
        drawRankHeader()
        m.rows = overviewRows()
    else if m.view = "badges"
        showTabs(achievementsModel.BadgeFilters(), [tr("All"), tr("Unlocked"), tr("Locked")], m.badgeFilter)
        m.rows = badgeRows()
    else if m.view = "badge"
        m.rows = badgeViewRows()
    else if m.view = "activity"
        m.rows = activityRows()
    else if m.view = "stats"
        m.rows = statsRows()
    else if m.view = "appearance"
        if not m.loading and not isValid(m.cosmetics)
            showLoadFailed("cosmetics")
            return
        end if
        showTabs(cosmeticKinds(), [tr("Avatars"), tr("Titles")], m.cosmeticKind)
        m.rows = appearanceRows()
    else if m.view = "loadout"
        if not m.loading and not isValid(m.powerUps)
            showLoadFailed("powerups")
            return
        end if
        m.rows = loadoutRows()
    else if m.view = "shop"
        m.rows = shopRows()
    else if m.view = "quests"
        m.rows = questRows()
    else if m.view = "leaderboard"
        showTabs(boardIds(), boardLabels(), m.board)
        m.rows = boardRows()
    else if m.view = "recap"
        showTabs(recapPeriods(), [tr("Week"), tr("Month"), tr("Year")], m.period)
        drawRecapChips()
        m.rows = recapRows()
    else if m.view = "library"
        m.rows = libraryRows()
    end if

    if m.loading and m.view <> "overview"
        showMessage(tr("Loading..."))
        return
    end if

    if m.rows.count() = 0
        showMessage(tr("Nothing here yet."))
        return
    end if

    commitRows()
end sub

function breadcrumb() as string
    title = tr("Achievement Badges")
    if m.view = "badges" then return `${title} / ${tr("Badges")}`
    if m.view = "badge" then return `${title} / ${tr("Badges")} / ${badgeName()}`
    if m.view = "quests" then return `${title} / ${tr("Quests")}`
    if m.view = "activity" then return `${title} / ${tr("Activity")}`
    if m.view = "leaderboard" then return `${title} / ${tr("Leaderboard")}`
    if m.view = "stats" then return `${title} / ${tr("Stats")}`
    if m.view = "recap" then return `${title} / ${tr("Recap")}`
    if m.view = "loadout" then return `${title} / ${tr("Loadout")}`
    if m.view = "appearance" then return `${title} / ${tr("Appearance")}`
    if m.view = "shop" then return `${title} / ${tr("Loadout")} / ${tr("Shop")}`
    if m.view = "library" then return `${title} / ${tr("Library completion")}`
    return title
end function

' What a screen shows when the plugin answered it with nothing
sub showLoadFailed(retryKind as string)
    showMessage(tr("Could not load your achievements."))
    m.retryKind = retryKind
    m.retryButton.visible = true
    m.retryFocus.visible = true
    m.retryButton.setFocus(true)
end sub

sub showMessage(text as string)
    m.message.text = text
    m.message.visible = true
end sub

sub showTabs(ids as object, labels as object, activeId as string)
    tabs = []
    active = 0
    index = 0
    for each id in ids
        tabs.push({ id: id, label: labels[index] })
        if id = activeId then active = index
        index++
    end for

    m.tabBar.tabs = tabs
    m.tabBar.expanded = false
    m.tabBar.focusIndex = active
    m.tabBar.selectedIndex = active
    m.tabBar.visible = true
end sub

' Every row in the panel is the same component, so a view only has to say what its rows carry
sub commitRows()
    content = CreateObject("roSGNode", "ContentNode")
    height = 120
    for each row in m.rows
        if row.height > height then height = row.height
    end for

    for each row in m.rows
        row.height = height
        node = content.createChild("ContentNode")
        node.addFields({ rowData: row })
    end for

    top = listTop()
    ' Only as many rows as the panel has room for, so the list scrolls rather than running off
    ' the bottom of the screen
    rows = Int((1080 - top - ACHIEVEMENT_SECTION_GAP) / (height + 10))
    if rows < 1 then rows = 1

    m.rowList.itemSize = [ACHIEVEMENT_PANEL_WIDTH, height]
    m.rowList.numRows = rows
    m.rowList.translation = [ACHIEVEMENT_PANEL_X, top]
    m.lastFocusIndex = 0
    m.pendingFocusIndex = -1
    m.rowList.content = content
    m.rowList.visible = true
    if not m.tabBar.isInFocusChain() then m.rowList.setFocus(true)
end sub

' The list starts under whatever the view drew above it
function listTop() as integer
    top = ACHIEVEMENT_PANEL_TOP
    if m.tabBar.visible then top += ACHIEVEMENT_TAB_BAR_HEIGHT + ACHIEVEMENT_SECTION_GAP

    if m.view = "overview" then return top + m.headerHeight + ACHIEVEMENT_SECTION_GAP
    if m.view = "recap" then return top + m.chipsHeight + ACHIEVEMENT_SECTION_GAP
    return top
end function

' ===== Header =====

sub drawRankHeader()
    y = 0
    rank = m.overview.rank
    m.rankRow.visible = isValid(rank)

    if isValid(rank)
        color = achievementsModel.ParseHexColor(rank.tier.color)
        if color = "" then color = m.accent

        m.rankFill.blendColor = themeChrome.WithAlpha(color, "2E")
        m.rankBorder.blendColor = themeChrome.WithAlpha(color, "73")
        ' What the profile wears stands in for the tier's own look
        avatar = achievementsModel.WornAvatarIcon(m.overview.cosmetics)
        worn = achievementsModel.WornTitle(m.overview.cosmetics)
        m.rankIcon.uri = achievementsIcons.PathFor(avatar <> "" ? avatar : rank.tier.icon)
        m.rankIcon.blendColor = themeChrome.WithAlpha(color, "FF")
        m.rankName.text = worn <> "" ? worn : rank.tier.name
        m.rankScore.text = substitute(tr("{0} points"), rank.score.toStr())
        m.rankRow.translation = [0, y]
        y += ACHIEVEMENT_RANK_AVATAR + ACHIEVEMENT_RANK_ROW_GAP

        m.rankBarTrack.visible = true
        m.rankBarTrack.translation = [0, y]
        m.rankBarFill.width = ACHIEVEMENT_PANEL_WIDTH * achievementsModel.Clamp(rank.progressToNext / 100)
        m.rankBarFill.color = color
        y += ACHIEVEMENT_RANK_BAR_HEIGHT + ACHIEVEMENT_RANK_BAR_GAP

        m.rankNote.visible = true
        if isValid(rank.nextTier)
            remaining = rank.nextTier.minScore - rank.score
            if remaining < 0 then remaining = 0
            m.rankNote.text = substitute(tr("{0} points to {1}"), remaining.toStr(), rank.nextTier.name)
        else
            m.rankNote.text = tr("Top rank reached")
        end if
        m.rankNote.translation = [0, y]
        y += ACHIEVEMENT_RANK_NOTE_HEIGHT
    else
        m.rankBarTrack.visible = false
        m.rankNote.visible = false
    end if

    if isValid(m.overview.summary)
        if isValid(rank) then y += ACHIEVEMENT_CHIPS_GAP
        m.chips.translation = [0, y]
        y += drawChips(summaryChips())
    end if

    if m.overview.equipped.count() > 0
        y += ACHIEVEMENT_SHOWCASE_GAP
        m.showcase.translation = [0, y]
        y += drawShowcase()
    end if

    m.headerHeight = y
end sub

function summaryChips() as object
    summary = m.overview.summary
    return [
        { icon: "military_tech", label: substitute(tr("{0} of {1} badges"), summary.unlocked.toStr(), summary.total.toStr()) },
        { icon: "percent", label: formatPercent(summary.percentage) },
        { icon: "local_fire_department", label: substitute(tr("{0} day streak"), summary.currentWatchStreak.toStr()) },
        { icon: "emoji_events", label: substitute(tr("Best: {0} days"), summary.bestWatchStreak.toStr()) }
    ]
end function

sub drawRecapChips()
    if not isValid(m.recap)
        m.chips.removeChildrenIndex(m.chips.getChildCount(), 0)
        m.chipsHeight = 0
        m.header.visible = false
        return
    end if

    m.header.visible = true
    m.rankRow.visible = false
    m.rankBarTrack.visible = false
    m.rankNote.visible = false
    m.showcase.visible = false
    m.header.translation = [ACHIEVEMENT_PANEL_X, ACHIEVEMENT_PANEL_TOP + ACHIEVEMENT_TAB_BAR_HEIGHT + ACHIEVEMENT_SECTION_GAP]
    m.chips.translation = [0, 0]

    m.chipsHeight = drawChips([
        { icon: "movie", label: `${m.recap.moviesWatched} ${tr("Movies")}` },
        { icon: "live_tv", label: `${m.recap.episodesWatched} ${tr("Episodes")}` },
        { icon: "calendar_month", label: substitute(tr("{0} days watched"), m.recap.daysWatched.toStr()) },
        { icon: "military_tech", label: substitute(tr("{0} badges earned"), m.recap.badgesUnlocked.toStr()) }
    ])
end sub

' Chips wrap once the row runs out of panel, the way they do on a page that is wider
function drawChips(entries as object) as float
    m.chips.removeChildrenIndex(m.chips.getChildCount(), 0)

    x = 0
    y = 0
    for each entry in entries
        chip = m.chips.createChild("Group")

        fill = chip.createChild("Poster")
        fill.uri = "pkg:/images/tracks/panel20.9.png"
        fill.loadDisplayMode = "scaleToFit"
        fill.blendColor = "#FFFFFF14"
        fill.height = ACHIEVEMENT_CHIP_HEIGHT

        icon = chip.createChild("Poster")
        icon.uri = achievementsIcons.PathFor(entry.icon)
        icon.width = ACHIEVEMENT_CHIP_ICON
        icon.height = ACHIEVEMENT_CHIP_ICON
        icon.blendColor = "#FFFFFFCC"
        icon.translation = [ACHIEVEMENT_CHIP_ICON_INSET, (ACHIEVEMENT_CHIP_HEIGHT - ACHIEVEMENT_CHIP_ICON) / 2]

        label = chip.createChild("Label")
        label.font = m.chipFont.font
        label.color = "#FFFFFFE6"
        label.height = ACHIEVEMENT_CHIP_HEIGHT
        label.vertAlign = "center"
        label.translation = [ACHIEVEMENT_CHIP_ICON_INSET + ACHIEVEMENT_CHIP_ICON + ACHIEVEMENT_CHIP_ICON_GAP, 0]
        label.text = entry.label

        width = label.boundingRect().width + ACHIEVEMENT_CHIP_ICON_INSET + ACHIEVEMENT_CHIP_ICON + ACHIEVEMENT_CHIP_ICON_GAP + ACHIEVEMENT_CHIP_PAD
        fill.width = width

        if x > 0 and x + width > ACHIEVEMENT_PANEL_WIDTH
            x = 0
            y += ACHIEVEMENT_CHIP_HEIGHT + ACHIEVEMENT_CHIP_GAP
        end if

        chip.translation = [x, y]
        x += width + ACHIEVEMENT_CHIP_GAP
    end for

    themeApply.ApplyToItem(m.chips)
    return y + ACHIEVEMENT_CHIP_HEIGHT
end function

' The badges the viewer chose to show off, as many as the panel holds
function drawShowcase() as float
    m.showcase.removeChildrenIndex(m.showcase.getChildCount(), 0)
    m.showcase.visible = true

    perRow = Int(ACHIEVEMENT_PANEL_WIDTH / ACHIEVEMENT_SHOWCASE_ITEM)
    x = 0
    count = 0
    for each badge in m.overview.equipped
        if count >= perRow then exit for

        color = achievementsModel.RarityColor(badge.rarity)
        item = m.showcase.createChild("Group")
        item.translation = [x, 0]

        inset = (ACHIEVEMENT_SHOWCASE_ITEM - ACHIEVEMENT_SHOWCASE_AVATAR) / 2

        fill = item.createChild("Poster")
        fill.uri = "pkg:/images/tracks/panel20.9.png"
        fill.loadDisplayMode = "scaleToFit"
        fill.blendColor = themeChrome.WithAlpha(color, "2E")
        fill.width = ACHIEVEMENT_SHOWCASE_AVATAR
        fill.height = ACHIEVEMENT_SHOWCASE_AVATAR
        fill.translation = [inset, 0]

        border = item.createChild("Poster")
        border.uri = "pkg:/images/tracks/panelborder20.9.png"
        border.loadDisplayMode = "scaleToFit"
        border.blendColor = themeChrome.WithAlpha(color, "73")
        border.width = ACHIEVEMENT_SHOWCASE_AVATAR
        border.height = ACHIEVEMENT_SHOWCASE_AVATAR
        border.translation = [inset, 0]

        icon = item.createChild("Poster")
        icon.uri = achievementsIcons.PathFor(badge.icon)
        icon.failedBitmapUri = "pkg:/images/achievements/emoji_events.png"
        icon.width = ACHIEVEMENT_SHOWCASE_ICON
        icon.height = ACHIEVEMENT_SHOWCASE_ICON
        icon.blendColor = themeChrome.WithAlpha(color, "FF")
        iconInset = (ACHIEVEMENT_SHOWCASE_AVATAR - ACHIEVEMENT_SHOWCASE_ICON) / 2
        icon.translation = [inset + iconInset, iconInset]

        title = item.createChild("Label")
        title.font = m.chipFont.font
        title.color = "#FFFFFFE6"
        title.width = ACHIEVEMENT_SHOWCASE_ITEM
        title.height = ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT
        title.horizAlign = "center"
        title.wrap = true
        title.maxLines = 2
        title.translation = [0, ACHIEVEMENT_SHOWCASE_AVATAR + ACHIEVEMENT_SHOWCASE_TITLE_GAP]
        title.text = badge.title

        x += ACHIEVEMENT_SHOWCASE_ITEM
        count++
    end for

    themeApply.ApplyToItem(m.showcase)
    return ACHIEVEMENT_SHOWCASE_AVATAR + ACHIEVEMENT_SHOWCASE_TITLE_GAP + ACHIEVEMENT_SHOWCASE_TITLE_HEIGHT
end function

' ===== Rows =====

function overviewRows() as object
    rows = []
    unlocked = 0
    for each badge in m.overview.badges
        if badge.unlocked then unlocked++
    end for

    if m.overview.unlockToastsEnabled
        rows.push(unlockToastsRow())
        if m.unlockToastsProblem <> "" then rows.push(headingRow(m.unlockToastsProblem))
    end if

    rows.push(navRow("badges", tr("Badges"), substitute(tr("{0} of {1} badges"), unlocked.toStr(), m.overview.badges.count().toStr()), "military_tech", m.overview.badges.count() > 0))

    if m.overview.questsEnabled and isValid(m.overview.quests) and not m.overview.quests.isEmpty
        done = 0
        for each quest in m.overview.quests.daily
            if quest.completed then done++
        end for
        for each quest in m.overview.quests.weekly
            if quest.completed then done++
        end for
        rows.push(navRow("quests", tr("Quests"), substitute(tr("{0} completed"), done.toStr()), "task_alt", true))
    end if

    if m.overview.activityEnabled
        rows.push(navRow("activity", tr("Activity"), tr("What the server has unlocked lately"), "bolt", true))
    end if

    if m.overview.leaderboardEnabled
        rows.push(navRow("leaderboard", tr("Leaderboard"), tr("How you compare with other users on this server"), "leaderboard", true))
    end if

    rows.push(navRow("stats", tr("Stats"), tr("Your records and how the server is doing"), "bar_chart", true))

    rows.push(navRow("recap", tr("Recap"), tr("What you watched recently"), "insights", true))

    rows.push(navRow("loadout", tr("Loadout"), tr("Score to spend and the boosts you hold"), "backpack", true))

    if not achievementsModel.CosmeticsAreEmpty(m.overview.cosmetics)
        rows.push(navRow("appearance", tr("Appearance"), tr("The avatar and title on your profile"), "face_5", true))
    end if

    libraries = m.overview.libraryCompletion.count()
    if libraries > 0
        rows.push(navRow("library", tr("Library completion"), substitute(tr("{0} libraries"), libraries.toStr()), "collections_bookmark", true))
    end if

    return rows
end function

' The plugin's own unlock notification switch, which jellyfin-web follows too, so flipping it here
' changes it for every client the user signs in on
function unlockToastsRow() as object
    return {
        kind: "toggle",
        title: tr("Unlock notifications"),
        caption: tr("Show a notification when you unlock a badge"),
        icon: "notifications_active",
        tint: m.accent,
        toggleOn: m.unlockToasts = true,
        height: 120
    }
end function

function navRow(view as string, title as string, caption as string, icon as string, enabled as boolean) as object
    return {
        kind: "nav",
        view: enabled ? view : "",
        title: title,
        caption: caption,
        icon: icon,
        tint: m.accent,
        height: 120
    }
end function

function badgeRows() as object
    rows = []
    groups = achievementsModel.GroupBadges(m.overview.badges, m.badgeFilter, tr("Other"))

    for each group in groups
        open = isValid(m.openCategories[group.category])
        rows.push({
            kind: "category",
            category: group.category,
            title: group.category,
            caption: substitute(tr("{0} of {1} badges"), group.unlocked.toStr(), group.badges.count().toStr()),
            icon: open ? "folder_open" : "folder",
            tint: m.accent,
            height: 120
        })

        if not open then continue for
        for each badge in group.badges
            rows.push(badgeRow(badge))
        end for
    end for

    return rows
end function

function badgeRow(badge as object) as object
    color = achievementsModel.RarityColor(badge.rarity)
    showsProgress = not badge.unlocked and badge.targetValue > 0

    row = {
        kind: "badge",
        badgeId: badge.id,
        title: badgeTitle(badge),
        caption: "",
        icon: badge.icon,
        tint: color,
        locked: not badge.unlocked,
        trailingTop: badge.rarity,
        trailingColor: color,
        trailingBottom: substitute(tr("{0} pts"), badge.score.toStr()),
        height: 150
    }

    if badge.description <> "" and not badge.descriptionHidden then row.caption = badge.description

    if showsProgress
        row.showBar = true
        row.barValue = badge.progress
        row.barColor = color
        row.progressText = `${badge.currentValue} / ${badge.targetValue}`
    else if badge.unlocked and badge.unlockedAt > 0
        row.progressText = substitute(tr("Unlocked {0}"), mediumDate(badge.unlockedAt))
    end if

    return row
end function

function badgeTitle(badge as object) as string
    return badge.isSecret ? tr("Hidden achievement") : badge.title
end function

function badgeForId(badgeId as string) as dynamic
    if not isValid(m.overview) then return invalid

    for each badge in m.overview.badges
        if badge.id = badgeId then return badge
    end for
    return invalid
end function

function badgeName() as string
    badge = badgeForId(m.badgeId)
    if not isValid(badge) then return ""

    return badgeTitle(badge)
end function

' One badge on its own, with what the plugin suggests watching for it
function badgeViewRows() as object
    rows = []
    badge = badgeForId(m.badgeId)
    if not isValid(badge) then return rows

    heading = headingRow(badgeTitle(badge))
    if badge.description <> "" and not badge.descriptionHidden then heading.caption = badge.description
    rows.push(heading)

    ' The badge carries its own figures, so they stand in when the chase had nothing to say
    current = isValid(m.chase) ? m.chase.current : badge.currentValue
    target = isValid(m.chase) ? m.chase.target : badge.targetValue

    rows.push(headingRow(tr("Progress")))

    progress = headingRow(`${current} / ${target}`)
    progress.showBar = true
    progress.barValue = badge.progress
    progress.barColor = achievementsModel.RarityColor(badge.rarity)
    rows.push(progress)

    rows.push(headingRow(tr("Suggested items to watch")))

    items = isValid(m.chase) ? m.chase.items : []
    if items.count() = 0
        rows.push(headingRow(tr("Nothing to suggest for this badge.")))
        return rows
    end if

    for each item in items
        rows.push(chaseRow(item))
    end for

    return rows
end function

function chaseRow(item as object) as object
    parts = []
    if item.type <> "" then parts.push(item.type)
    if item.year > 0 then parts.push(item.year.toStr())
    if item.runtimeMinutes > 0 then parts.push(substitute(tr("{0} min"), item.runtimeMinutes.toStr()))

    return {
        kind: "chase",
        itemId: item.id,
        itemType: item.type,
        title: item.name,
        caption: parts.join(" · "),
        height: 120
    }
end function

' The panel names the three consumables itself, since the plugin only describes them in English
function powerUpText(powerUpType as string) as object
    if powerUpType = "XpBoost"
        return { name: tr("XP Boost"), body: tr("Doubles score for an hour. Using it again restarts the hour.") }
    end if

    if powerUpType = "DoubleCredit"
        return { name: tr("Double Credit"), body: tr("The next thing you finish counts twice towards badges.") }
    end if

    if powerUpType = "StreakFreeze"
        return { name: tr("Streak Freeze"), body: tr("Covers one missed day. Only one can be banked.") }
    end if

    return { name: powerUpType, body: "" }
end function

function heldLabel(count as integer) as string
    if count <= 0 then return tr("None held")
    if count = 1 then return tr("1 held")

    return substitute(tr("{0} held"), count.toStr())
end function

' The score a viewer still has to spend, above whatever it can be spent on. Every row in the
' list takes the same height, so the figure rides with its heading rather than sitting a whole
' row below it.
function scoreBankRow(bank as integer) as object
    row = headingRow(tr("Score bank"))
    row.caption = substitute(tr("{0} points"), bank.toStr())

    return row
end function

function loadoutRows() as object
    rows = []
    if not isValid(m.powerUps) then return rows

    rows.push(scoreBankRow(m.powerUps.bank))

    rows.push(headingRow(tr("Power-ups")))
    for each slot in m.powerUps.slots
        rows.push(powerUpRow(slot))
    end for

    rows.push(navRow("shop", tr("Shop"), tr("Spend score on more boosts"), "storefront", true))

    if m.spendProblem <> "" then rows.push(noteRow(m.spendProblem))

    return rows
end function

' The row keeps its press only while there is one to spend, but it is never dimmed, since holding
' none is already said underneath and a greyed row is harder to read from a sofa
function powerUpRow(slot as object) as object
    text = powerUpText(slot.type)
    held = heldLabel(slot.count)

    row = {
        kind: "powerup",
        powerUpType: slot.type,
        offered: slot.count > 0 and not m.spendBusy,
        title: text.name,
        caption: text.body,
        icon: slot.icon,
        tint: m.accent,
        progressText: slot.active ? `${held} · ${tr("Running now")}` : held,
        height: 150
    }

    if slot.active then row.progressColor = m.accent

    return row
end function

function shopRows() as object
    rows = [scoreBankRow(m.shopBank)]

    if m.shopItems.count() = 0
        rows.push(noteRow(tr("Nothing for sale right now.")))
        return rows
    end if

    for each item in m.shopItems
        rows.push(shopRow(item))
    end for

    if m.spendProblem <> "" then rows.push(noteRow(m.spendProblem))

    return rows
end function

function shopRow(item as object) as object
    text = powerUpText(item.type)
    affordable = item.priceScore <= m.shopBank and not m.spendBusy

    title = text.name
    if item.bundleSize > 1 then title = substitute(tr("{0} ×{1}"), text.name, item.bundleSize.toStr())

    return {
        kind: "shop",
        itemId: item.id,
        offered: affordable,
        title: title,
        caption: text.body,
        icon: "storefront",
        tint: m.accent,
        trailingTop: substitute(tr("{0} points"), item.priceScore.toStr()),
        trailingColor: affordable ? m.accent : "#FFFFFFB3",
        height: 150
    }
end function

function activityRows() as object
    rows = []
    for each entry in m.activity
        rows.push(activityRow(entry))
    end for

    return rows
end function

function activityRow(entry as object) as object
    return {
        kind: "activity",
        title: substitute(tr("{0} unlocked {1}"), entry.userName, entry.badgeTitle),
        icon: entry.icon,
        tint: achievementsModel.RarityColor(entry.rarity),
        progressText: relativeTime.Label(entry.at),
        height: 120
    }
end function

' The counters worth showing, in the order they read best. The plugin sends more than this. What
' is left out is either a duplicate of something here, like minutes beside hours, or plumbing a
' badge counts on that means nothing on its own.
function statGroups() as object
    return [
        {
            header: tr("Watched"),
            rows: [
                ["TotalItemsWatched", tr("Items watched")],
                ["MoviesWatched", tr("Films watched")],
                ["SeriesCompleted", tr("Series finished")],
                ["TotalHoursWatched", tr("Hours watched")],
                ["DaysWatched", tr("Days watched")],
                ["RewatchCount", tr("Rewatches")]
            ]
        },
        {
            header: tr("Bests"),
            rows: [
                ["BestWatchStreak", tr("Best watch streak")],
                ["BestLoginStreak", tr("Best login streak")],
                ["MaxEpisodesInSingleDay", tr("Most episodes in a day")],
                ["MaxMoviesInSingleDay", tr("Most films in a day")],
                ["LongestItemMinutes", tr("Longest single item")],
                ["BestComboCount", tr("Best combo")]
            ]
        },
        {
            header: tr("Habits"),
            rows: [
                ["LateNightSessions", tr("Late night sessions")],
                ["EarlyMorningSessions", tr("Early morning sessions")],
                ["WeekendSessions", tr("Weekend sessions")],
                ["DaysLoggedIn", tr("Days signed in")]
            ]
        },
        {
            header: tr("Variety"),
            rows: [
                ["UniqueLibrariesVisited", tr("Libraries visited")],
                ["UniqueGenresWatched", tr("Genres watched")],
                ["UniqueDecadesWatched", tr("Decades watched")],
                ["UniqueCountriesWatched", tr("Countries watched")],
                ["UniqueLanguagesWatched", tr("Languages watched")]
            ]
        }
    ]
end function

function statsRows() as object
    rows = []
    if not isValid(m.stats) then return rows

    for each group in statGroups()
        section = []
        for each entry in group.rows
            key = entry[0]
            if m.stats.records.doesExist(key) then section.push(statRow(entry[1], statValue(key, m.stats.records[key])))
        end for

        if section.count() = 0 then continue for
        rows.push(headingRow(group.header))
        rows.append(section)
    end for

    if m.stats.watchClock.count() > 0
        rows.push(headingRow(tr("When you watch")))
        busiest = busiestHour()
        if busiest > 0 then rows.push({ kind: "clock", hours: m.stats.watchClock, busiest: busiest, height: 120 })
    end if

    if m.stats.server.count() > 0
        rows.push(headingRow(tr("This server")))
        rows.append(serverRows())
    end if

    return rows
end function

function busiestHour() as integer
    busiest = 0
    for each count in m.stats.watchClock
        if count > busiest then busiest = count
    end for

    return busiest
end function

function statRow(label as string, value as string) as object
    return {
        kind: "stat",
        title: label,
        trailingTop: value,
        height: 120
    }
end function

' The one counter that is a run time rather than a tally
function statValue(key as string, count as integer) as string
    if key = "LongestItemMinutes" then return substitute(tr("{0} min"), count.toStr())

    return count.toStr()
end function

function serverRows() as object
    server = m.stats.server
    rows = [
        statRow(tr("Users"), server.users.toStr()),
        statRow(tr("Badges unlocked"), server.badgesUnlocked.toStr()),
        statRow(tr("Items watched"), server.itemsWatched.toStr()),
        statRow(tr("Films watched"), server.moviesWatched.toStr()),
        statRow(tr("Series finished"), server.seriesCompleted.toStr()),
        statRow(tr("Score earned"), server.score.toStr())
    ]

    if server.mostCommonBadge <> "" then rows.push(statRow(tr("Most common badge"), server.mostCommonBadge))

    return rows
end function

function cosmeticKinds() as object
    return [COSMETIC_AVATAR, COSMETIC_RANK_TITLE]
end function

function appearanceRows() as object
    rows = []
    if not isValid(m.cosmetics) then return rows

    rows.push(scoreBankRow(m.cosmetics.bank))
    for each item in achievementsModel.CosmeticsOf(m.cosmetics, m.cosmeticKind)
        rows.push(cosmeticRow(item))
    end for

    if m.spendProblem <> "" then rows.push(noteRow(m.spendProblem))

    return rows
end function

' One avatar or title, and whichever of wearing or buying it allows. There is nothing to do with
' one that has to be earned and has not been, or one the bank is short of. It is never dimmed,
' since whatever blocks a press already shows in the row as a price or the score still needed.
function cosmeticRow(item as object) as object
    wearing = achievementsModel.EquippedCosmetic(m.cosmetics, item.kind) = item.id
    held = achievementsModel.OwnsCosmetic(m.cosmetics, item)
    affordable = item.priceScore <= m.cosmetics.bank

    row = {
        kind: "cosmetic",
        cosmeticId: item.id,
        cosmeticKind: item.kind,
        worn: wearing,
        held: held,
        offered: not m.spendBusy and (held or (not item.isEarned and affordable)),
        title: item.name,
        icon: item.icon,
        tint: m.accent,
        height: 150
    }

    if wearing
        row.progressText = tr("Equipped")
        row.progressColor = m.accent
        row.trailingIcon = "check_circle"
    else if held
        row.progressText = tr("Owned")
    else if item.isEarned
        row.caption = substitute(tr("Earned at {0} lifetime score"), item.milestoneScore.toStr())
        row.showBar = true
        row.barValue = achievementsModel.Clamp(m.cosmetics.lifetimeScore / item.milestoneScore)
        row.barColor = m.accent
    else
        row.trailingTop = substitute(tr("{0} points"), item.priceScore.toStr())
        row.trailingColor = affordable ? m.accent : "#FFFFFFB3"
    end if

    return row
end function

' Puts one on, or takes it off when it is already the one worn
sub wearCosmetic(row as object)
    m.spendIndex = m.rowList.itemFocused
    m.spendBusy = true
    m.spendProblem = ""
    render()
    focusRow(m.spendIndex)

    startLoad({ kind: "wear", worn: row.worn, cosmeticId: row.cosmeticId, cosmeticKind: row.cosmeticKind })
end sub

sub applyWear(result as object)
    m.spendBusy = false
    wear = result.wear

    if wear.outcome <> COSMETIC_CHANGED
        m.spendProblem = tr("Could not change how the profile looks.")
        if wear.outcome = COSMETIC_REFUSED and isValidAndNotEmpty(wear.message) then m.spendProblem = wear.message
        return
    end if

    ' The answer carries the row it was given back, so the slot it fills is still known after the
    ' trip even if the viewer has moved to the other tab
    slot = result.worn ? "" : result.cosmeticId
    if result.cosmeticKind = COSMETIC_AVATAR
        m.cosmetics.avatarId = slot
    else
        m.cosmetics.titleId = slot
    end if

    ' The rank header behind this screen is drawn from what the profile wears, so it takes the
    ' same answer rather than asking for the whole panel again
    m.overview.cosmetics = m.cosmetics
end sub

sub openAppearance()
    m.cosmetics = invalid
    m.cosmeticKind = COSMETIC_AVATAR
    m.spendProblem = ""
    m.loading = true
    pushView("appearance")
    startLoad({ kind: "cosmetics" })
end sub

sub openStats()
    m.stats = invalid
    m.loading = true
    pushView("stats")
    startLoad({ kind: "stats" })
end sub

sub openActivity()
    m.activity = []
    m.loading = true
    pushView("activity")
    startLoad({ kind: "activity" })
end sub

sub openShop()
    m.shopItems = []
    m.shopBank = 0
    m.spendProblem = ""
    m.loading = true
    pushView("shop")
    startLoad({ kind: "shop" })
end sub

sub openLoadout()
    m.powerUps = invalid
    m.spendProblem = ""
    ' The screen opens on its loading line rather than flashing an empty loadout
    m.loading = true
    pushView("loadout")
    startLoad({ kind: "powerups" })
end sub

function questRows() as object
    rows = []
    quests = m.overview.quests
    if not isValid(quests) then return rows

    if quests.daily.count() > 0
        rows.push(headingRow(tr("Daily")))
        for each quest in quests.daily
            rows.push(questRow(quest))
        end for
        rows.push(rerollRow(false, quests.dailyRerollsLeft))
    end if

    if quests.weekly.count() > 0
        rows.push(headingRow(tr("Weekly")))
        for each quest in quests.weekly
            rows.push(questRow(quest))
        end for
        rows.push(rerollRow(true, quests.weeklyRerollsLeft))
    end if

    ' The failure sits under the sets rather than replacing them, so the quests stay readable
    if m.rerollFailed then rows.push(headingRow(tr("Could not reroll those quests.")))

    return rows
end function

function questRow(quest as object) as object
    return {
        kind: "quest",
        title: quest.title,
        caption: quest.description,
        icon: quest.completed ? "check_circle" : quest.icon,
        tint: m.accent,
        showBar: true,
        barValue: quest.progress,
        barColor: m.accent,
        progressText: `${quest.current} / ${quest.target}`,
        trailingTop: substitute(tr("+{0}"), quest.reward.toStr()),
        trailingColor: m.accent,
        height: 160
    }
end function

function rerollRow(weekly as boolean, rerollsLeft as integer) as object
    spent = rerollsLeft <= 0
    offered = not spent and not m.rerollBusy

    caption = tr("Swap this set for a different one")
    if spent
        caption = weekly ? tr("Used this week, comes back Monday UTC") : tr("Used today, comes back at midnight UTC")
    end if

    return {
        kind: "reroll",
        weekly: weekly,
        offered: offered,
        dimmed: not offered,
        title: weekly ? tr("Reroll weekly quests") : tr("Reroll daily quests"),
        caption: caption,
        icon: "casino",
        tint: m.accent,
        height: 120
    }
end function

' A heading is not a focus stop and the list only scrolls as far as focus goes, so anything the
' viewer has to read at the end of a list is a row of its own to keep it reachable
function noteRow(text as string) as object
    return { kind: "note", title: text, height: 120 }
end function

function headingRow(title as string) as object
    return { kind: "heading", title: title, height: 70 }
end function

function recapPeriods() as object
    return ["week", ACHIEVEMENTS_DEFAULT_PERIOD, "year"]
end function

function boardIds() as object
    ' The plugin has no category name for the overall board, but a tab still needs an id of
    ' its own
    return ["score", "movies", "episodes", "hours", "streak", "series", "unlocked"]
end function

function boardLabels() as object
    return [tr("Score"), tr("Movies"), tr("Episodes"), tr("Hours"), tr("Streak"), tr("Series"), tr("Badges")]
end function

function boardRows() as object
    rows = []
    place = 1
    for each entry in m.boardEntries
        caption = ""
        if isValid(entry.customTitle)
            caption = entry.customTitle
        else if isValid(entry.unlocked)
            total = isValid(entry.total) ? entry.total : 0
            caption = substitute(tr("{0} of {1} badges"), entry.unlocked.toStr(), total.toStr())
        end if

        rows.push({
            kind: "board",
            gutter: place.toStr(),
            title: entry.userName,
            caption: caption,
            trailingTop: achievementsModel.LeaderboardValue(entry).toStr(),
            height: 120
        })
        place++
    end for
    return rows
end function

function recapRows() as object
    rows = []
    if not isValid(m.recap) then return rows

    appendCounts(rows, tr("Genres"), m.recap.topGenres)
    appendCounts(rows, tr("Top directors"), m.recap.topDirectors)
    appendCounts(rows, tr("Top actors"), m.recap.topActors)
    return rows
end function

sub appendCounts(rows as object, title as string, counts as object)
    if counts.count() = 0 then return

    rows.push(headingRow(title))
    for each count in counts
        rows.push({ kind: "count", title: count.name, trailingTop: count.count.toStr(), height: 100 })
    end for
end sub

function libraryRows() as object
    names = []
    for each name in m.overview.libraryCompletion
        names.push(name)
    end for
    names.sort()

    rows = []
    for each name in names
        percent = m.overview.libraryCompletion[name]
        rows.push({
            kind: "library",
            title: name,
            showBar: true,
            barValue: achievementsModel.Clamp(percent / 100),
            barColor: m.accent,
            trailingTop: `${percent}%`,
            height: 130
        })
    end for
    return rows
end function

' ===== Helpers =====

' One decimal place, kept even on a round number so the figure does not change width
function formatPercent(value as float) as string
    tenths = Int(value * 10 + 0.5)
    return `${Int(tenths / 10)}.${tenths mod 10}%`
end function

function mediumDate(seconds as integer) as string
    months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    date = CreateObject("roDateTime")
    date.FromSeconds(seconds)
    month = date.GetMonth()
    if month < 1 or month > 12 then return ""
    return `${months[month - 1]} ${date.GetDayOfMonth()}, ${date.GetYear()}`
end function

' ===== Badges =====

sub openBadge(badgeId as string)
    m.badgeId = badgeId
    m.chase = invalid
    ' The screen opens on its loading line rather than flashing an empty list of suggestions
    m.loading = true
    pushView("badge")
    startLoad({ kind: "chase", badgeId: badgeId })
end sub

' Details fetches the full record by id, so the seed only has to say which item this was
sub openChaseItem(row as object)
    node = contentNodes.ForType(row.itemType)
    if not isValid(node) then return

    node.json = {
        Id: row.itemId,
        Name: row.title,
        Type: row.itemType,
        ImageTags: {},
        BackdropImageTags: [],
        UserData: {}
    }
    m.top.selectedItem = node
end sub

' ===== Spending =====

' Spending something the viewer only gets so many of is worth asking about, since there is no
' way back
sub askSpend(title as string, message as string, chosen as string)
    m.spendIndex = m.rowList.itemFocused

    m.spendPrompt = CreateObject("roSGNode", "ListPromptDialog")
    m.spendPrompt.dialogTitle = title
    m.spendPrompt.message = message
    m.spendPrompt.options = [tr("Cancel"), tr("Confirm")]
    m.spendPrompt.returnFocus = m.rowList
    m.spendPrompt.observeField("optionSelected", chosen)

    m.top.getScene().appendChild(m.spendPrompt)
    m.spendPrompt.callFunc("showDialog")
end sub

sub closeSpendPrompt()
    if not isValid(m.spendPrompt) then return

    m.spendPrompt.unobserveField("optionSelected")
    m.top.getScene().removeChild(m.spendPrompt)
    m.spendPrompt = invalid
end sub

sub askReroll(weekly as boolean)
    m.rerollWeekly = weekly
    askSpend(tr("Reroll these quests?"), tr("You get one daily and one weekly reroll, and this spends it."), "onRerollChosen")
end sub

sub onRerollChosen(event as object)
    chosen = event.getData()
    closeSpendPrompt()
    if chosen <> 1 then return

    m.rerollBusy = true
    m.rerollFailed = false
    render()
    focusRow(m.spendIndex)
    startLoad({ kind: "reroll", weekly: m.rerollWeekly })
end sub

sub askUsePowerUp(powerUpType as string)
    m.powerUpType = powerUpType
    askSpend(tr("Use this power-up?"), tr("It's spent as soon as you confirm."), "onUsePowerUpChosen")
end sub

' Both spending screens answer a confirm the same way, so only what it starts differs
function spendConfirmed(event as object) as boolean
    chosen = event.getData()
    closeSpendPrompt()
    if chosen <> 1 then return false

    m.spendBusy = true
    m.spendProblem = ""
    render()
    focusRow(m.spendIndex)
    return true
end function

sub onUsePowerUpChosen(event as object)
    if not spendConfirmed(event) then return

    startLoad({ kind: "usePowerUp", powerUpType: m.powerUpType })
end sub

sub askBuy(itemId as string)
    m.shopItemId = itemId
    askSpend(tr("Buy this?"), tr("It comes straight out of your score bank."), "onBuyChosen")
end sub

sub onBuyChosen(event as object)
    if not spendConfirmed(event) then return

    startLoad({ kind: "buy", itemId: m.shopItemId })
end sub

sub applyPurchase(result as object)
    m.spendBusy = false
    if result.outcome = PURCHASE_BOUGHT
        if result.bankAfter >= 0 then m.shopBank = result.bankAfter
        ' The shop and the appearance screen buy through the same route, so one bought from the
        ' appearance screen is added to what the profile owns here
        if m.view = "appearance"
            m.cosmetics.owned.push(m.shopItemId)
            if result.bankAfter >= 0 then m.cosmetics.bank = result.bankAfter
        end if
        return
    end if

    m.spendProblem = tr("Could not buy that.")
    if result.outcome = PURCHASE_REFUSED and isValidAndNotEmpty(result.message) then m.spendProblem = result.message
end sub

' Spending one costs no score, so only the inventory moves
sub applySpend(result as object)
    m.spendBusy = false
    if result.outcome = POWER_UP_USED
        if isValid(m.powerUps) then m.powerUps.slots = result.slots
        return
    end if

    m.spendProblem = tr("Could not use that power-up.")
    if result.outcome = POWER_UP_REFUSED and isValidAndNotEmpty(result.message) then m.spendProblem = result.message
end sub

' The server is the authority on what is left, so its answer settles the row whether it handed
' back a fresh set or refused
sub applyReroll(weekly as boolean, result as object)
    m.rerollBusy = false
    m.rerollFailed = result.outcome = REROLL_FAILED
    if m.rerollFailed then return

    quests = m.overview.quests
    if not isValid(quests) then return

    swapped = result.outcome = REROLLED
    left = swapped ? result.rerollsLeft : 0

    if weekly
        if swapped then quests.weekly = result.quests
        quests.weeklyRerollsLeft = left
    else
        if swapped then quests.daily = result.quests
        quests.dailyRerollsLeft = left
    end if
end sub

' ===== Unlock notifications =====

sub startUnlockToastsTask(request as object)
    m.unlockToastsTask.control = TaskControl.STOP
    m.unlockToastsTask.request = request
    m.unlockToastsTask.control = TaskControl.RUN
end sub

' The switch flips straight away and goes back if the plugin wont take it. It does nothing until
' the plugin says which way it is, so it cant flip the wrong way.
sub toggleUnlockToasts(index as integer)
    if not isValid(m.unlockToasts) or m.unlockToastsBusy then return

    m.unlockToasts = not m.unlockToasts
    m.unlockToastsBusy = true
    m.unlockToastsProblem = ""
    render()
    focusRow(index)
    startUnlockToastsTask({ kind: "saveUnlockToasts", enabled: m.unlockToasts })
end sub

sub onUnlockToastsResult(event as object)
    result = event.getData()
    if not isValid(result) then return

    if result.kind = "unlockToasts"
        if not isValid(result.settings) then return
        m.unlockToasts = result.settings.enabled
        ' The switch is drawn off until the plugin answers
        if not m.unlockToasts then return
    else
        m.unlockToastsBusy = false
        if isValid(result.settings)
            ' The unlock reads pick the new settings up from here rather than waiting to read them
            m.global.unlockToastSettings = result.settings
            return
        end if
        m.unlockToasts = not m.unlockToasts
        m.unlockToastsProblem = tr("Could not save your settings.")
    end if

    if m.view <> "overview" or m.loading or not isValid(m.overview) then return

    ' The note under the switch comes and goes, so a row further down keeps the cursor
    index = m.rowList.itemFocused
    count = m.rows.count()
    render()
    if index > 0 then index += m.rows.count() - count
    focusRow(index)
end sub

' ===== Input =====

sub onTabActivated()
    index = m.tabBar.activated
    if index < 0 then return

    if m.view = "badges"
        filters = achievementsModel.BadgeFilters()
        if index >= filters.count() then return
        m.badgeFilter = filters[index]
        render()
        return
    end if

    if m.view = "leaderboard"
        ids = boardIds()
        if index >= ids.count() then return
        m.board = ids[index]
        ' The overall board came with the panel, so only a category costs a call
        if m.board = boardIds()[0]
            m.boardEntries = m.overview.leaderboard
            render()
        else
            startLoad({ kind: "leaderboard", category: m.board })
        end if
        return
    end if

    if m.view = "appearance"
        kinds = cosmeticKinds()
        if index >= kinds.count() then return
        m.cosmeticKind = kinds[index]
        render()
        return
    end if

    if m.view = "recap"
        periods = recapPeriods()
        if index >= periods.count() then return
        m.period = periods[index]
        ' The month came with the panel, so only another period costs a call
        if m.period = ACHIEVEMENTS_DEFAULT_PERIOD
            m.recap = m.overview.recap
            render()
        else
            startLoad({ kind: "recap", period: m.period })
        end if
    end if
end sub

sub onTabEscape()
    if m.tabBar.escape = "down" and m.rowList.visible then m.rowList.setFocus(true)
end sub

' A heading names what follows rather than being a row of its own, so focus carries on the way
' it was going rather than resting there
sub onRowFocused()
    focused = m.rowList.itemFocused
    if focused < 0 or focused >= m.rows.count() then return

    if isFocusStop(m.rows[focused])
        m.restoringFocus = false
        m.lastFocusIndex = focused
        return
    end if

    direction = focused >= m.lastFocusIndex ? 1 : -1

    ' The list keeps UP for itself while it has a row above, so a screen that opens on a heading
    ' hands the cursor to the tabs from here. A list still on its way to the row the screen asked
    ' for is passing through rather than being walked up.
    if direction = -1 and not m.restoringFocus and m.tabBar.visible and not stopsAbove(focused)
        m.tabBar.setFocus(true)
        return
    end if

    target = focused + direction
    while target >= 0 and target < m.rows.count() and not isFocusStop(m.rows[target])
        target += direction
    end while

    ' Nothing but headings that way, so focus goes back where it started
    if target < 0 or target >= m.rows.count() then target = m.lastFocusIndex

    m.pendingFocusIndex = target
    m.skipHeadingTimer.control = "start"
end sub

' A heading names what follows and the clock is a picture, so the cursor has no business on
' either of them
function isFocusStop(row as object) as boolean
    return row.kind <> "heading" and row.kind <> "clock"
end function

' Whether any row above this one can take the cursor
function stopsAbove(index as integer) as boolean
    for i = 0 to index - 1
        if isFocusStop(m.rows[i]) then return true
    end for

    return false
end function

' Puts the cursor back on a row after the list is built again. The list focuses its first row
' as soon as it has content, and that row is a heading, so the skip it queued is dropped first
sub focusRow(index as integer)
    if index < 0 or index >= m.rows.count() then return

    m.skipHeadingTimer.control = "stop"
    m.pendingFocusIndex = -1
    m.restoringFocus = true
    m.lastFocusIndex = index
    m.rowList.jumpToItem = index
end sub

sub onSkipHeadingTimer()
    if m.pendingFocusIndex < 0 then return

    target = m.pendingFocusIndex
    m.pendingFocusIndex = -1
    m.restoringFocus = false
    m.lastFocusIndex = target
    m.rowList.jumpToItem = target
end sub

sub onRowSelected()
    index = m.rowList.itemSelected
    if index < 0 or index >= m.rows.count() then return

    row = m.rows[index]
    if row.kind = "nav"
        if row.view = "activity"
            openActivity()
        else if row.view = "stats"
            openStats()
        else if row.view = "appearance"
            openAppearance()
        else if row.view = "loadout"
            openLoadout()
        else if row.view = "shop"
            openShop()
        else if isValidAndNotEmpty(row.view)
            pushView(row.view)
        end if
        return
    end if

    if row.kind = "toggle"
        toggleUnlockToasts(index)
        return
    end if

    if row.kind = "badge"
        openBadge(row.badgeId)
        return
    end if

    if row.kind = "chase"
        openChaseItem(row)
        return
    end if

    if row.kind = "powerup"
        if row.offered then askUsePowerUp(row.powerUpType)
        return
    end if

    if row.kind = "shop"
        if row.offered then askBuy(row.itemId)
        return
    end if

    if row.kind = "cosmetic"
        if not row.offered then return
        if row.held
            wearCosmetic(row)
        else
            askBuy(row.cosmeticId)
        end if
        return
    end if

    if row.kind = "reroll"
        if row.offered then askReroll(row.weekly)
        return
    end if

    if row.kind = "category"
        ' A category opens onto its badges in place, the way a folder does
        if isValid(m.openCategories[row.category])
            m.openCategories.delete(row.category)
        else
            m.openCategories[row.category] = true
        end if
        render()
        m.rowList.jumpToItem = index
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.retryKind <> ""
        if key = KeyCode.OK
            startLoad({ kind: m.retryKind })
            return true
        end if
        if key = KeyCode.BACK
            if popView() then return true
            m.top.closed = true
            return true
        end if
        return false
    end if

    if key = KeyCode.UP and m.rowList.isInFocusChain() and m.rowList.itemFocused = 0 and m.tabBar.visible
        m.tabBar.setFocus(true)
        return true
    end if

    if key = KeyCode.BACK
        if popView() then return true
        m.top.closed = true
        return true
    end if

    return false
end function

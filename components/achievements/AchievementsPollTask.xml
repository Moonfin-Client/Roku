<?xml version="1.0" encoding="utf-8"?>
<!-- Asks the plugin for newly unlocked badges, the friends list and the chats every so often, for as long as the user is signed in -->
<component name="AchievementsPollTask" extends="Task">
    <interface>
        <!-- The badges a read turned up that the user wants to hear about, with how to show them -->
        <field id="unlocks" type="assocarray" alwaysNotify="true" />
        <!-- The chats that got a message from someone else since the last read -->
        <field id="incoming" type="array" alwaysNotify="true" />
    </interface>
</component>

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const MENU_WIDTH = 522
const MENU_PAD_Y = 12
const MENU_MAX_HEIGHT = 972
const TITLE_PAD_X = 29
const TITLE_PAD_TOP = 17
const TITLE_PAD_BOTTOM = 12
const TITLE_SIZE = 23
const ROW_INSET = 8
const ROW_PAD_X = 21
const ROW_PAD_Y = 12
const ROW_BORDER = 2
const ROW_FOCUS_FILL = 0.1
const ICON_SIZE = 32
const ICON_GAP = 23
const LABEL_SIZE = 23

' A confirmation keeps the title, then its question over a row of answers set to the right
const CONFIRM_PAD_BOTTOM = 23
const QUESTION_SIZE = 20
const QUESTION_PAD_BOTTOM = 23
const QUESTION_LINE_GAP = 8
const ANSWER_ROW_PAD_X = 21
const ANSWER_GAP = 12
const ANSWER_PAD_X = 26
const ANSWER_PAD_Y = 12

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelBorder = m.top.findNode("panelBorder")
    m.heading = m.top.findNode("menuHeading")
    m.questionText = m.top.findNode("questionText")
    m.rowWindow = m.top.findNode("rowWindow")
    m.rows = m.top.findNode("rows")
    m.answerRow = m.top.findNode("answerRow")

    m.heading.font.size = TITLE_SIZE
    m.heading.width = MENU_WIDTH - (TITLE_PAD_X * 2)
    m.questionText.font.size = QUESTION_SIZE
    m.questionText.width = MENU_WIDTH - (TITLE_PAD_X * 2)
    m.questionText.lineSpacing = QUESTION_LINE_GAP

    m.top.findNode("rowFont").font.size = LABEL_SIZE
    m.top.findNode("answerFont").font.size = QUESTION_SIZE
    m.top.findNode("strongFont").font.size = QUESTION_SIZE

    m.rowHeight = (ROW_BORDER * 2) + (ROW_PAD_Y * 2) + ICON_SIZE
    m.targets = []
    m.focusIndex = 0
    m.firstVisible = 0
    m.visibleRows = 0
    m.confirming = false

    themeApply.ApplyToItem(m.top)

    ' A theme font swaps each label's font for one of its own, so they are read after it
    m.rowFont = m.top.findNode("rowFont").font
    m.answerFont = m.top.findNode("answerFont").font
    m.strongFont = m.top.findNode("strongFont").font
end sub

sub showMenu()
    m.confirming = isValidAndNotEmpty(m.top.answers)
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    m.answerRow.removeChildrenIndex(m.answerRow.getChildCount(), 0)
    m.targets = []

    top = MENU_PAD_Y
    m.heading.text = m.top.menuTitle
    m.heading.visible = m.top.menuTitle <> ""
    if m.heading.visible
        m.heading.translation = [TITLE_PAD_X, top + TITLE_PAD_TOP]
        top += TITLE_PAD_TOP + m.heading.boundingRect().height + TITLE_PAD_BOTTOM
    end if

    m.questionText.visible = m.confirming
    m.answerRow.visible = m.confirming
    m.rowWindow.visible = not m.confirming

    if m.confirming
        panelHeight = layoutQuestion(top) + CONFIRM_PAD_BOTTOM
    else
        panelHeight = layoutRows(top) + MENU_PAD_Y
    end if

    for each layer in [m.panelFill, m.panelBorder]
        layer.width = MENU_WIDTH
        layer.height = panelHeight
    end for
    m.panel.translation = [(1920 - MENU_WIDTH) / 2, (1080 - panelHeight) / 2]

    ' The first row, or the first answer, which for a confirmation is the one that changes nothing
    markFocus(0)
    m.top.visible = true
    m.top.setFocus(true)
end sub

' Each row is an icon and a label, washed and ringed while it has focus
function layoutRows(top as float) as float
    rowWidth = MENU_WIDTH - (ROW_INSET * 2)
    labelLeft = ROW_BORDER + ROW_PAD_X + ICON_SIZE + ICON_GAP

    rowTop = 0
    for each menuEntry in m.top.entries
        row = m.rows.createChild("Group")
        row.translation = [ROW_INSET, rowTop]
        focusLayers = addFocusLayers(row, rowWidth, m.rowHeight)

        icon = row.createChild("Poster")
        icon.uri = menuEntry.icon
        icon.width = ICON_SIZE
        icon.height = ICON_SIZE
        icon.translation = [ROW_BORDER + ROW_PAD_X, ROW_BORDER + ROW_PAD_Y]

        text = row.createChild("Label")
        text.font = m.rowFont
        text.color = "#FFFFFF"
        text.vertAlign = "center"
        text.width = rowWidth - labelLeft - ROW_PAD_X - ROW_BORDER
        text.height = m.rowHeight
        text.translation = [labelLeft, 0]
        text.text = menuEntry.label

        m.targets.push({ id: menuEntry.id, fill: focusLayers.fill, ring: focusLayers.ring })
        rowTop += m.rowHeight
    end for

    ' The panel stops at nine tenths of the screen, and a longer list scrolls inside it
    m.visibleRows = Int((MENU_MAX_HEIGHT - top - MENU_PAD_Y) / m.rowHeight)
    if m.visibleRows > m.targets.count() then m.visibleRows = m.targets.count()
    if m.visibleRows < 1 then m.visibleRows = 1
    windowHeight = m.visibleRows * m.rowHeight

    m.firstVisible = 0
    m.rows.translation = [0, 0]
    m.rowWindow.translation = [0, top]
    m.rowWindow.clippingRect = [0, 0, MENU_WIDTH, windowHeight]

    return top + windowHeight
end function

' The answers line up from the right edge, the last one outermost
function layoutQuestion(top as float) as float
    m.questionText.text = m.top.question
    m.questionText.translation = [TITLE_PAD_X, top]
    top += m.questionText.boundingRect().height + QUESTION_PAD_BOTTOM

    built = []
    tallest = 0
    for each answer in m.top.answers
        button = m.answerRow.createChild("Group")
        focusLayers = addFocusLayers(button, 0, 0)

        text = button.createChild("Label")
        text.font = isValid(answer.strong) and answer.strong ? m.strongFont : m.answerFont
        text.color = "#FFFFFF"
        text.text = answer.label
        text.translation = [ANSWER_PAD_X + ROW_BORDER, ANSWER_PAD_Y + ROW_BORDER]
        textSize = text.boundingRect()

        buttonWidth = textSize.width + ((ANSWER_PAD_X + ROW_BORDER) * 2)
        buttonHeight = textSize.height + ((ANSWER_PAD_Y + ROW_BORDER) * 2)
        if buttonHeight > tallest then tallest = buttonHeight
        for each layer in [focusLayers.fill, focusLayers.ring]
            layer.width = buttonWidth
            layer.height = buttonHeight
        end for

        m.targets.push({ id: answer.id, fill: focusLayers.fill, ring: focusLayers.ring })
        built.push({ node: button, width: buttonWidth })
    end for

    right = MENU_WIDTH - ANSWER_ROW_PAD_X
    for i = built.count() - 1 to 0 step -1
        right -= built[i].width
        built[i].node.translation = [right, 0]
        right -= ANSWER_GAP
    end for

    m.answerRow.translation = [0, top]
    return top + tallest
end function

function addFocusLayers(parent as object, width as integer, height as integer) as object
    fill = parent.createChild("Poster")
    fill.uri = "pkg:/images/playback/surface9.9.png"
    fill.opacity = ROW_FOCUS_FILL
    fill.width = width
    fill.height = height
    fill.visible = false

    ring = parent.createChild("Poster")
    ring.uri = "pkg:/images/itemMenu/rowborder9.9.png"
    ring.width = width
    ring.height = height
    ring.visible = false

    return { fill: fill, ring: ring }
end function

sub markFocus(index as integer)
    if m.targets.count() = 0 then return
    if index < 0 then index = 0
    if index >= m.targets.count() then index = m.targets.count() - 1

    m.focusIndex = index
    for i = 0 to m.targets.count() - 1
        m.targets[i].fill.visible = i = index
        m.targets[i].ring.visible = i = index
    end for

    if m.confirming then return

    if index < m.firstVisible then m.firstVisible = index
    if index >= m.firstVisible + m.visibleRows then m.firstVisible = index - m.visibleRows + 1
    m.rows.translation = [0, -m.firstVisible * m.rowHeight]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A dismissed menu can still hold focus, and swallowing keys there would strand the screen
    if not m.top.visible then return false

    if key = KeyCode.BACK or key = KeyCode.OPTIONS
        closeMenu("")
        return true
    end if

    backward = KeyCode.UP
    forward = KeyCode.DOWN
    if m.confirming
        backward = KeyCode.LEFT
        forward = KeyCode.RIGHT
    end if

    if key = backward
        markFocus(m.focusIndex - 1)
    else if key = forward
        markFocus(m.focusIndex + 1)
    else if key = KeyCode.OK
        if m.focusIndex < m.targets.count() then closeMenu(m.targets[m.focusIndex].id)
    end if

    ' Nothing gets past the menu while it is up
    return true
end function

' The owner takes this node out of the scene as soon as it is told, so focus moves first
sub closeMenu(choice as string)
    m.top.visible = false
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)

    if choice = ""
        m.top.dismissed = true
    else
        m.top.chosen = choice
    end if
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- The card menu: a titled panel of icon rows over a dimmed screen. Given answers instead of
     entries it asks a yes or no question in the same panel, which is how taking a title out of
     a collection is confirmed. -->
<component name="ItemContextMenu" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.55" />

    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/details/surface12.9.png" blendColor="#1E1E28" />
      <Poster id="panelBorder" uri="pkg:/images/itemMenu/panelborder12.9.png" opacity="0.12" />
      <Label id="menuHeading" font="font:MediumBoldSystemFont" color="#FFFFFF" wrap="true" maxLines="2" />
      <Label id="questionText" font="font:SmallSystemFont" color="#FFFFFFB3" wrap="true" visible="false" />
      <!-- A list taller than the screen scrolls inside this window -->
      <Group id="rowWindow">
        <Group id="rows" />
      </Group>
      <Group id="answerRow" visible="false" />
    </Group>

    <!-- Never shown, they only lend their fonts to the rows and answers built at runtime -->
    <Label id="rowFont" font="font:MediumSystemFont" visible="false" />
    <Label id="answerFont" font="font:SmallSystemFont" visible="false" />
    <Label id="strongFont" font="font:SmallBoldSystemFont" visible="false" />
  </children>

  <interface>
    <field id="menuTitle" type="string" value="" />
    <!-- Array of { id, label, icon } -->
    <field id="entries" type="array" />
    <!-- The question, and the answers as an array of { id, label, strong }, for a confirmation -->
    <field id="question" type="string" value="" />
    <field id="answers" type="array" />
    <!-- Where focus goes when the menu closes, otherwise it is stranded on a hidden node -->
    <field id="returnFocus" type="node" />

    <field id="chosen" type="string" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />

    <function name="showMenu" />
  </interface>
</component>

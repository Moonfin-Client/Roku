' A short note near the foot of the screen, for whichever screen imports this. It runs in that
' screen's scope, so m is the screen.
sub showItemMenuToast(message as string)
    ' A task can answer after its screen has gone behind another one
    scene = m.top.getScene()
    if not isValid(scene) then return

    toast = scene.findNode("itemMenuToast")
    if isValid(toast)
        ' Lifted back to the front, over whatever opened since the last one
        scene.removeChild(toast)
    else
        toast = CreateObject("roSGNode", "ItemMenuToast")
        toast.id = "itemMenuToast"
    end if

    scene.appendChild(toast)
    toast.message = message
end sub

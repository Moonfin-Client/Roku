<?xml version="1.0" encoding="utf-8"?>
<!-- A short note near the foot of the screen that fades out on its own, for what the card
     menu did once there is no dialog left to say it in -->
<component name="ItemMenuToast" extends="Group">
  <children>
    <Group id="toastBody" opacity="0">
      <Poster id="toastFill" uri="pkg:/images/details/surface12.9.png" blendColor="#1E1E28" opacity="0.94" />
      <Poster id="toastBorder" uri="pkg:/images/itemMenu/panelborder12.9.png" opacity="0.12" />
      <Label id="toastText" font="font:SmallSystemFont" color="#FFFFFF" />
    </Group>

    <!-- In quickly, held, then out, over three seconds -->
    <Animation id="toastFade" duration="3" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator
        key="[0.0, 0.1, 0.85, 1.0]"
        keyValue="[0.0, 1.0, 1.0, 0.0]"
        fieldToInterp="toastBody.opacity" />
    </Animation>
    <Timer id="toastTimer" duration="3" repeat="false" />
  </children>

  <interface>
    <!-- Setting it shows the note, and setting it again while one is up starts over -->
    <field id="message" type="string" alwaysNotify="true" onChange="onMessageChanged" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The server side of the card menu, off the render thread. A card from another signed in
     server is answered by that server. -->
<component name="ItemMenuTask" extends="Task">
  <interface>
    <!-- { op, itemId, server } plus whatever the op needs -->
    <field id="request" type="assocarray" />
    <!-- { request, success, status, message, data } -->
    <field id="response" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const TOAST_FONT_SIZE = 18
const TOAST_PAD_X = 28
const TOAST_PAD_Y = 14
const TOAST_BOTTOM = 60
const TOAST_MAX_TEXT_WIDTH = 1600

sub init()
    m.body = m.top.findNode("toastBody")
    m.fill = m.top.findNode("toastFill")
    m.border = m.top.findNode("toastBorder")
    m.text = m.top.findNode("toastText")
    m.text.font.size = TOAST_FONT_SIZE

    m.fade = m.top.findNode("toastFade")
    m.timer = m.top.findNode("toastTimer")
    m.timer.observeField("fire", "onToastDone")

    themeApply.ApplyToItem(m.top)
end sub

sub onMessageChanged()
    m.text.width = 0
    m.text.text = m.top.message

    size = m.text.boundingRect()
    textWidth = size.width
    if textWidth > TOAST_MAX_TEXT_WIDTH
        textWidth = TOAST_MAX_TEXT_WIDTH
        m.text.width = textWidth
    end if

    width = textWidth + (TOAST_PAD_X * 2)
    height = size.height + (TOAST_PAD_Y * 2)
    for each layer in [m.fill, m.border]
        layer.width = width
        layer.height = height
    end for
    m.text.translation = [TOAST_PAD_X, TOAST_PAD_Y]
    m.body.translation = [(1920 - width) / 2, 1080 - TOAST_BOTTOM - height]

    ' The fade only draws it, so stopping it on the way to a restart takes nothing down
    m.fade.control = "stop"
    m.fade.control = "start"
    m.timer.control = "stop"
    m.timer.control = "start"
end sub

' Faded out, so it leaves the scene rather than sitting there unseen
sub onToastDone()
    parent = m.top.getParent()
    if isValid(parent) then parent.removeChild(m.top)
end sub

import "pkg:/components/itemMenu/itemMenuHost.bs"
import "pkg:/source/utils/misc.bs"

' The card menu as the detail screens share it. Each screen finds the card its rows have in focus
' and hands it to showItemMenu, and everything else about the menu is the same on all of them.
'
' Hooks each screen provides:
'   sub collectionMemberRemoved(itemId as string)

' A card on a collection's own page can be taken back out of that collection
function itemMenuPageOptions() as object
    page = chainLookupReturn(m.top, "itemContent.json", invalid)
    if not isValid(page) or not isStringEqual(page.Type, "BoxSet") then return {}

    return { inCollection: true, collectionId: page.Id ?? "", collectionName: page.Name ?? "" }
end function

' The page's own item as the menu takes it, so the action row's playlist, collection, artwork
' and identify buttons open the same dialogs a card does
function pageMenuSubject() as object
    return { card: invalid, json: chainLookupReturn(m.top, "itemContent.json", {}), options: {}, entries: [], returnFocus: seerrFocusTarget() }
end function

' The card a grid has in focus, for the screens whose rows are plain grids
function itemMenuGridCard(grid as dynamic) as dynamic
    if not isValid(grid) or not isValid(grid.content) then return invalid

    index = grid.itemFocused
    if index < 0 or index >= grid.content.getChildCount() then return invalid
    return grid.content.getChild(index)
end function

' A title taken out of the collection a page shows leaves that page at once, and new metadata or
' artwork for the page's own item only shows once the page loads it again. Everything else on a
' detail page is read again when it is next opened.
sub itemMenuChanged(action as string, _card as dynamic, menuJson as object)
    if action = "removeFromCollection"
        collectionMemberRemoved(menuJson.Id ?? "")
    else if action = "metadata" and isStringEqual(menuJson.Id, chainLookupReturn(m.top, "itemContent.json.Id", ""))
        m.top.itemContent = m.top.itemContent
    end if
end sub

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/userDataSync.bs"

' A screen holding items lays each watched or favorite change over its own copies, so its lists
' redraw them without a reload. These run in the host screen's scope.
'
' Hook each screen provides:
'   sub userDataApplied(changes as object)   anything beyond the lists, such as a header

sub observeUserData()
    m.global.observeField("userDataChanged", "onUserDataChanged")
end sub

sub onUserDataChanged(event as object)
    changes = event.getData()
    if not isValidAndNotEmpty(changes) then return
    userDataSync.ApplyToLists(m.top, changes)
    userDataApplied(changes)
end sub

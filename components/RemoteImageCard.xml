<?xml version="1.0" encoding="utf-8"?>
<!-- One offered image: the picture over where it came from, framed when focused -->
<component name="RemoteImageCard" extends="Group">
  <children>
    <Poster id="image" width="384" height="216" translation="[8, 8]" loadDisplayMode="scaleToFill" />
    <Poster id="frame" uri="pkg:/images/details/cardborderfocus.9.png" width="400" height="232" opacity="0" />
    <Label id="provider" font="font:SmallestSystemFont" color="#FFFFFFB3" width="384" horizAlign="center" translation="[8, 232]" maxLines="1" />
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>
</component>

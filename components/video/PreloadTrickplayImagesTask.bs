import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"

sub init()
    m.top.functionName = "preloadTrickplayImagesTask"
end sub

sub preloadTrickplayImagesTask()
    fs = CreateObject("roFileSystem")

    if m.top.method = "ADD"
        loaded = []
        for each sheet in m.top.sheets
            file = `tmp:/${m.top.videoID}-${sheet}.jpg`
            if not fs.Exists(file)
                if isValidAndNotEmpty(m.top.sheetUrls)
                    if sheet < m.top.sheetUrls.Count() and isValidAndNotEmpty(m.top.sheetUrls[sheet])
                        transfer = CreateObject("roUrlTransfer")
                        transfer.SetUrl(m.top.sheetUrls[sheet])
                        setCertificateAuthority(transfer)
                        transfer.GetToFile(file)
                    end if
                else
                    APIRequest(`Videos/${m.top.videoID}/Trickplay/${m.top.trickplayWidth}/${sheet}.jpg?ApiKey=${get_user_setting("token")}`).gettofile(file)
                end if
            end if
            if fs.Exists(file) then loaded.push(sheet)
        end for
        m.top.loaded = loaded
        return
    end if

    if m.top.method = "REMOVE"
        for each sheet in m.top.sheets
            file = `tmp:/${m.top.videoID}-${sheet}.jpg`
            if fs.Exists(file) then fs.Delete(file)
        end for
    end if
end sub

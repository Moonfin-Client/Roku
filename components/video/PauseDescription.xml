<?xml version="1.0" encoding="utf-8"?>
<component name="PauseDescription" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTextChanged" />
    <field id="overview" type="string" onChange="onTextChanged" />
  </interface>
  <children>
    <!-- Black from 85% on the left to 30% on the right: a flat 30% under the card gradient, which
         runs from 90% to nothing -->
    <Rectangle width="1920" height="1080" color="0x0000004D" />
    <Poster uri="pkg:/images/banner/cardgradient.webp" width="1920" height="1080" loadDisplayMode="scaleToFill" opacity="0.873" />

    <!-- Each line has a dark copy just behind it for its shadow -->
    <LayoutGroup id="shadows" translation="[98, 222]" layoutDirection="vert" itemSpacings="[16]">
      <Label id="pausedShadow" color="0x000000CC" width="920">
        <Font role="font" uri="font:BoldSystemFontFile" size="26" />
      </Label>
      <Label id="titleShadow" color="0x000000CC" width="920">
        <Font role="font" uri="font:BoldSystemFontFile" size="64" />
      </Label>
      <Label id="overviewShadow" color="0x000000CC" width="920" wrap="true" maxLines="8">
        <Font role="font" uri="font:SystemFontFile" size="30" />
      </Label>
    </LayoutGroup>
    <LayoutGroup id="lines" translation="[96, 220]" layoutDirection="vert" itemSpacings="[16]">
      <Label id="paused" color="0xFFFFFFFF" width="920">
        <Font role="font" uri="font:BoldSystemFontFile" size="26" />
      </Label>
      <Label id="title" color="0xFFFFFFFF" width="920">
        <Font role="font" uri="font:BoldSystemFontFile" size="64" />
      </Label>
      <Label id="overview" color="0xFFFFFFFF" width="920" wrap="true" maxLines="8">
        <Font role="font" uri="font:SystemFontFile" size="30" />
      </Label>
    </LayoutGroup>
    <!-- Never shown, it measures one line of the overview's font -->
    <Label id="overviewLine" text="Ag" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="30" />
    </Label>
  </children>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The Playback Information panel, which keeps focus itself since its rows don't take it -->
<component name="PlaybackInfoDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/playback/panel33.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/playback/panelborder33.9.png" />
      <Label id="title" color="#FFFFFF" />
      <Rectangle id="titleRule" height="2" color="#FFFFFF14" />
      <Group id="viewport">
        <Group id="rows" />
      </Group>
      <Poster id="thumb" uri="pkg:/images/playback/scrollthumb5.9.png" width="5" blendColor="#FFFFFF4D" visible="false" />
    </Group>
    <Animation id="scroll" duration="0.12" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollRows" key="[0.0, 1.0]" fieldToInterp="rows.translation" />
      <Vector2DFieldInterpolator id="scrollThumb" key="[0.0, 1.0]" fieldToInterp="thumb.translation" />
    </Animation>
  </children>
  <interface>
    <!-- [{ title, rows: [{ label, value, bold } or { note }] }] from playbackFacts.Build -->
    <field id="sections" type="array" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

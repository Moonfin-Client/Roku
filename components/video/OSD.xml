<?xml version="1.0" encoding="utf-8"?>
<component name="OSD" extends="Group">
  <children>
    <!-- Fades behind the title and the controls -->
    <Poster id="topFade" uri="pkg:/images/playback/fadedown.webp" width="1920" height="206" loadDisplayMode="scaleToFill" />
    <Poster id="bottomFade" uri="pkg:/images/playback/fadeup.webp" translation="[0, 868]" width="1920" height="212" loadDisplayMode="scaleToFill" />

    <!-- The title logo, and under it an episode's "S1:E2 - Name" on one line. Without a logo the
         series name sits above that line instead. -->
    <Poster id="logo" translation="[24, 12]" height="108" loadDisplayMode="scaleToFit" visible="false" />
    <LayoutGroup id="videoInfo" layoutDirection="vert" itemSpacings="[4]" translation="[24, 12]">
      <Label id="itemSecondary" color="#FFFFFFB3" width="1310" visible="false" />
      <Label id="itemTitle" color="#FFFFFF" width="1310" />
    </LayoutGroup>

    <!-- Not drawn, but its time feeds the clock slots and Ends at -->
    <Clock id="clock" visible="false" />

    <!-- Live TV swaps the title for the channel and what it airs, and the seek bar for the
         current program's span -->
    <Group id="liveHeader" translation="[24, 12]" visible="false">
      <Poster id="liveBadgeFill" uri="pkg:/images/livetv/fill6.9.png" blendColor="#00A4DC" />
      <Label id="liveBadgeLabel" color="#FFFFFF" />
      <Label id="liveChannelName" color="#FFFFFF" />
      <Label id="liveProgramName" color="#FFFFFFB3" />
    </Group>
    <Group id="liveTimeline" translation="[24, 892]" visible="false">
      <Label id="liveEpisodeLine" color="#FFFFFFB3" width="1872" />
      <Rectangle id="liveTrack" translation="[0, 40]" width="1872" height="4" color="#FFFFFF3D" />
      <Rectangle id="liveFill" translation="[0, 40]" width="0" height="4" color="#00A4DC" />
      <Label id="liveStartLabel" translation="[0, 50]" color="#FFFFFF8A" />
      <Label id="liveEndLabel" translation="[1572, 50]" color="#FFFFFF8A" horizAlign="right" width="300" />
    </Group>

    <Label id="aboveLeft" color="#FFFFFFB3" horizAlign="left" vertAlign="center" width="608" height="33" />
    <Label id="aboveCenter" color="#FFFFFFB3" horizAlign="center" vertAlign="center" width="608" height="33" />
    <Label id="aboveRight" color="#FFFFFFB3" horizAlign="right" vertAlign="center" width="608" height="33" />
    <Label id="belowLeft" color="#FFFFFFB3" horizAlign="left" vertAlign="center" width="608" height="33" />
    <Label id="belowCenter" color="#FFFFFFB3" horizAlign="center" vertAlign="center" width="608" height="33" />
    <Label id="belowRight" color="#FFFFFFB3" horizAlign="right" vertAlign="center" width="608" height="33" />

    <Group id="seekbarGroup">
      <Rectangle id="progressBarBackground" width="1872" height="6" color="#404040">
        <Rectangle id="progressBar" width="0" height="6" />
      </Rectangle>
      <!-- Chapter starts, over the fill -->
      <Group id="chapterMarks" />
      <Poster id="progressIndicator" uri="pkg:/images/playback/dot84.webp" width="21" height="21" />
    </Group>

    <LayoutGroup id="transportControls" layoutDirection="horiz" horizAlignment="left">
      <OsdButton id="itemBack" glyph="skip_previous_rounded" label="Previous" />
      <OsdButton id="rewind" label="Seek back" />
      <OsdButton id="videoPlayPause" glyph="play_arrow_rounded" label="Play" />
      <OsdButton id="fastForward" label="Seek forward" />
      <OsdButton id="itemNext" glyph="skip_next_rounded" label="Next" />
      <OsdButton id="jumpToLive" glyph="live_tv_rounded" label="Jump to Live" />
    </LayoutGroup>
    <!-- Filled at runtime from the arrangement the viewer chose, so the row carries only what they
         kept and in the order they put it -->
    <LayoutGroup id="secondaryControls" layoutDirection="horiz" horizAlignment="left" />

    <!-- What the focused button does, in a label just above it -->
    <Group id="focusLabel" visible="false">
      <Poster id="focusLabelFill" uri="pkg:/images/livetv/fill12.9.png" blendColor="#000000C7" />
      <Poster id="focusLabelRing" uri="pkg:/images/livetv/stroke12w1_5.9.png" blendColor="#FFFFFF73" />
      <Label id="focusLabelText" color="#FFFFFF" translation="[17, 2]" height="49" vertAlign="center" />
    </Group>

    <Timer id="inactivityTimer" duration="1" repeat="true" />
  </children>
  <interface>
    <field id="itemTitleText" type="string" />
    <field id="itemSecondaryText" type="string" />
    <field id="logoImage" type="string" />
    <field id="inactiveTimeout" type="integer" />
    <field id="progressPercentage" type="float" />
    <!-- Where a scrub on the seek bar is aiming, in seconds, or -1 when nothing is being scrubbed.
         The player owns the scrub and the bar only draws it. -->
    <field id="scrubPosition" type="float" value="-1" onChange="onScrubPositionChanged" />
    <field id="positionTime" type="float" />
    <field id="videoEndingTime" type="string" />
    <field id="remainingPositionTime" type="float" />
    <field id="playbackState" type="string" alwaysNotify="true" />
    <field id="action" type="string" alwaysNotify="true" />
    <field id="hasFocus" type="boolean" alwaysNotify="true" />
    <field id="focusTarget" type="string" value="seekbar" />
    <!-- What the skip button over the controls is offering: "segment", "preroll" or "" for none.
         The remote reaches it with Up from the seek bar. -->
    <field id="skipButton" type="string" />
    <function name="focusOnSeekbar" />

    <!-- The player owns the media, so it says which buttons have anything to open -->
    <field id="hasChapters" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="hasEpisodes" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="hasPeople" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="canFavorite" type="boolean" value="false" onChange="buildSecondaryControls" />
    <!-- Where each chapter starts, in milliseconds -->
    <field id="chapterStarts" type="array" onChange="drawChapterMarks" />
    <field id="hasSubtitles" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="hasAudioChoice" type="boolean" value="false" onChange="buildSecondaryControls" />
    <!-- The state a few buttons wear: the favorite heart, the speed they read and the bitrate cap -->
    <field id="isFavorite" type="boolean" value="false" onChange="applyButtonStates" />
    <field id="playbackSpeed" type="float" value="1.0" onChange="applyButtonStates" />
    <field id="bitrateCapped" type="boolean" value="false" onChange="applyButtonStates" />

    <!-- A Live TV channel: { number, name }, and the program airing on it -->
    <field id="liveMode" type="boolean" value="false" onChange="applyLiveMode" />
    <!-- Set while a live stream keeps a minute or more to rewind, which brings back the seek bar,
         the seek buttons and Jump to Live -->
    <field id="liveRewind" type="boolean" value="false" onChange="applyLiveMode" />
    <!-- The stretch that can be rewound, as { start, edge } in seconds on the player's clock -->
    <field id="liveWindow" type="assocarray" />
    <field id="liveChannel" type="assocarray" onChange="renderLive" />
    <field id="liveProgram" type="assocarray" onChange="renderLive" />
    <!-- The player says when the program airing can be recorded, and how its recording stands:
         record, scheduled, series, skipped or empty -->
    <field id="recordable" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="recordMark" type="string" value="" onChange="applyRecordMark" />
  </interface>
</component>

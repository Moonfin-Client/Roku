<?xml version="1.0" encoding="utf-8"?>
<component name="OSD" extends="Group">
  <children>
    <!-- Header section with media info -->
    <LayoutGroup id="videoInfo" layoutDirection="vert" translation="[103,61]">
      <ScrollingText id="itemTitle" font="font:LargeBoldSystemFont" maxWidth="1500" />
      <LayoutGroup id="episodeInfo" layoutDirection="horiz" itemSpacings="[10]">
        <Text id="itemSeason" font="font:MediumSystemFont" color="0xffffffFF" />
        <Text id="itemEpisode" font="font:MediumSystemFont" color="0xffffffFF" />
        <Text id="itemEpisodeEnd" font="font:MediumSystemFont" color="0xffffffFF" />
      </LayoutGroup>
    </LayoutGroup>

    <Clock id="clock" translation="[1618, 61]" />

    <!-- Transport controls (below seekbar) -->
    <LayoutGroup id="transportControls" itemSpacings="[20]" layoutDirection="horiz" horizAlignment="left" translation="[103,920]">
      <IconButton id="itemBack" padding="20" icon="pkg:/images/icons/osd/previous.png" height="80" width="120" />
      <IconButton id="rewind" padding="20" icon="pkg:/images/icons/osd/rewind.png" height="80" width="120" />
      <IconButton id="videoPlayPause" padding="20" icon="pkg:/images/icons/osd/play.png" height="80" width="120" />
      <IconButton id="fastForward" padding="20" icon="pkg:/images/icons/osd/forward.png" height="80" width="120" />
      <IconButton id="itemNext" padding="20" icon="pkg:/images/icons/osd/next.png" height="80" width="120" />
    </LayoutGroup>

    <!-- Progress bar and time display -->
    <Group id="seekbarGroup" translation="[103,820]">
      <Rectangle id="progressBarBackground" width="1714" height="8">
        <Rectangle id="progressBar" width="0" height="8" />
      </Rectangle>
    </Group>
    <Poster id="progressIndicator" uri="pkg:/images/icons/circle.png" width="20" height="20" translation="[103,812]" loadDisplayMode="scaleToFit" />

    <Text id="aboveRight" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="right" width="300" translation="[1517,780]" />
    <Text id="belowLeft" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="left" width="300" translation="[103,855]" />
    <Text id="belowRight" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="right" width="300" translation="[1517,855]" />
    <Text id="aboveLeft" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="left" width="300" translation="[103,780]" />
    <Text id="aboveCenter" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="center" width="300" translation="[810,780]" />
    <Text id="belowCenter" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="center" width="300" translation="[810,855]" />

    <!-- Secondary controls. Filled at runtime from the arrangement the viewer chose, so the
         row carries only what they kept and in the order they put it -->
    <LayoutGroup id="secondaryControls" itemSpacings="[20]" layoutDirection="horiz" horizAlignment="left" translation="[843,920]" />

    <!-- Item preview labels (show on focus) -->
    <ExpandingLabel
      translation="[200, 885]"
      id="previousItem"
      visible="false"
      icon=""
      iconHeight="32"
      iconWidth="32"
      iconAlign="left"
      text=""
      backgroundColor="0x00000095"
      maxWidth="500"
      horizAlign="left"
      horizOffset="64"
      alignmentSide="right"
      fontSize="27"
      padding="[20, 10]"
    />

    <ExpandingLabel
      translation="[1520, 885]"
      id="nextItem"
      visible="false"
      icon=""
      iconHeight="32"
      iconWidth="32"
      iconAlign="left"
      text=""
      backgroundColor="0x00000095"
      maxWidth="500"
      horizAlign="left"
      fontSize="27"
      padding="[20, 10]"
    />

    <Timer id="inactivityTimer" duration="1" repeat="true" />
  </children>
  <interface>
    <field id="itemTitleText" type="string" />
    <field id="itemSubtitleText" type="string" />
    <field id="seasonNumber" type="integer" />
    <field id="episodeNumber" type="integer" />
    <field id="episodeNumberEnd" type="integer" />
    <field id="logoImage" type="string" />
    <field id="previousItemIcon" type="string" />
    <field id="previousItemTitleText" type="string" />
    <field id="nextItemIcon" type="string" />
    <field id="nextItemTitleText" type="string" />
    <field id="inactiveTimeout" type="integer" />
    <field id="progressPercentage" type="float" />
    <field id="positionTime" type="float" />
    <field id="videoEndingTime" type="string" />
    <field id="remainingPositionTime" type="float" />
    <field id="playbackState" type="string" alwaysNotify="true" />
    <field id="action" type="string" alwaysNotify="true" />
    <field id="showChapterList" type="boolean" alwaysNotify="true" />
    <field id="hasFocus" type="boolean" alwaysNotify="true" />
    <field id="focusTarget" type="string" value="seekbar" />

    <!-- The player owns the media, so it says whether these two have anything to open -->
    <field id="hasChapters" type="boolean" value="false" onChange="buildSecondaryControls" />
    <field id="hasSubtitles" type="boolean" value="false" onChange="buildSecondaryControls" />
  </interface>
</component>

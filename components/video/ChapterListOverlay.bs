import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

const PANEL_WIDTH = 1800
const PANEL_PAD = 30
const PANEL_BOTTOM = 60
const ROW_LEFT = 36
const CARD_WIDTH = 316
const CARD_GAP = 24
const CARD_INSET = 8
const TEXT_INSET = 12
const THUMB_WIDTH = 300
const THUMB_HEIGHT = 169
const TEXT_GAP = 12
const LINE_GAP = 4
const FOCUS_SCALE = 1.04
' Cards past each end of the visible row that load their image ahead of a scroll
const THUMB_MARGIN = 2

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelBorder = m.top.findNode("panelBorder")
    m.title = m.top.findNode("title")
    m.titleRule = m.top.findNode("titleRule")
    m.viewport = m.top.findNode("viewport")
    m.rows = m.top.findNode("rows")
    m.footer = m.top.findNode("footer")
    m.entrance = m.top.findNode("entrance")
    m.entranceSlide = m.top.findNode("entranceSlide")

    playbackOverlay.SetFont(m.title, 30, true)
    playbackOverlay.SetFont(m.footer, 18, false)
    m.title.text = tr("Chapters")
    m.footer.text = tr("Press BACK to close")

    m.palette = playbackOverlay.Palette()
    m.visuals = []
    m.focusIndex = 0
    m.scrollCol = 0
end sub

sub open()
    chapters = m.top.chapters ?? []
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    m.visuals = []

    titleBottom = PANEL_PAD + m.title.boundingRect().height + 18
    m.titleRule.translation = [2, titleBottom]
    viewportTop = titleBottom + 1 + 24

    m.nameHeight = 0
    m.timeHeight = 0
    for i = 0 to chapters.count() - 1
        m.visuals.push(buildCard(chapters[i], i = m.top.currentIndex))
    end for
    m.cardHeight = CARD_INSET + THUMB_HEIGHT + TEXT_GAP + m.nameHeight + LINE_GAP + m.timeHeight + TEXT_INSET
    for i = 0 to m.visuals.count() - 1
        layoutCard(m.visuals[i], i)
    end for

    m.visibleCards = Int((PANEL_WIDTH - ROW_LEFT * 2 + CARD_GAP) / (CARD_WIDTH + CARD_GAP))
    if m.visibleCards > m.visuals.count() then m.visibleCards = m.visuals.count()
    if m.visibleCards < 1 then m.visibleCards = 1
    rowWidth = m.visibleCards * (CARD_WIDTH + CARD_GAP) - CARD_GAP

    m.viewport.translation = [ROW_LEFT, viewportTop]
    ' Room for the focused card to grow, but less than the gap, so the next card stays hidden
    m.viewport.clippingRect = [-12, -12, rowWidth + 24, m.cardHeight + 24]
    footerTop = viewportTop + m.cardHeight + 24
    m.footer.translation = [0, footerTop]
    panelHeight = footerTop + m.footer.boundingRect().height + PANEL_PAD
    m.panelFill.height = panelHeight
    m.panelBorder.height = panelHeight

    panelX = (1920 - PANEL_WIDTH) / 2
    panelY = 1080 - PANEL_BOTTOM - panelHeight
    m.entranceSlide.keyValue = [[panelX, panelY + 30], [panelX, panelY]]
    m.entrance.control = "start"

    m.focusIndex = m.top.currentIndex
    if m.focusIndex < 0 or m.focusIndex >= m.visuals.count() then m.focusIndex = 0
    m.scrollCol = 0
    applyFocus()
end sub

function buildCard(chapter as object, isCurrent as boolean) as object
    group = m.rows.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = "pkg:/images/livetv/fill10.9.png"
    border = group.createChild("Poster")
    border.uri = "pkg:/images/playback/stroke10w2.9.png"

    thumbBack = group.createChild("Rectangle")
    thumbBack.color = "#FFFFFF14"
    thumbBack.width = THUMB_WIDTH
    thumbBack.height = THUMB_HEIGHT
    thumbBack.translation = [CARD_INSET, CARD_INSET]
    ' Under the image, so it stands in while the image loads and when there is none
    glyph = group.createChild("Label")
    glyph.font = CreateObject("roSGNode", "Font")
    glyph.font.uri = settingsGlyphs.FONT_URI
    glyph.font.size = 64
    glyph.color = "#FFFFFF4D"
    glyph.horizAlign = "center"
    glyph.vertAlign = "center"
    glyph.width = THUMB_WIDTH
    glyph.height = THUMB_HEIGHT
    glyph.translation = [CARD_INSET, CARD_INSET]
    glyph.text = settingsGlyphs.Char("movie_outlined")
    thumb = group.createChild("Poster")
    thumb.width = THUMB_WIDTH
    thumb.height = THUMB_HEIGHT
    thumb.loadDisplayMode = "scaleToZoom"
    thumb.translation = [CARD_INSET, CARD_INSET]

    name = group.createChild("ScrollingLabel")
    playbackOverlay.SetFont(name, 24, false)
    name.color = "#FFFFFF"
    name.repeatCount = 0
    name.text = chapter.name

    time = group.createChild("Label")
    playbackOverlay.SetFont(time, 22, true)
    time.color = m.palette.accent
    time.text = secondsToHuman(Int(chapter.startSeconds), false)

    if name.boundingRect().height > m.nameHeight then m.nameHeight = name.boundingRect().height
    if time.boundingRect().height > m.timeHeight then m.timeHeight = time.boundingRect().height

    return { group: group, fill: fill, border: border, thumb: thumb, thumbUrl: chapter.thumbUrl ?? "", name: name, time: time, isCurrent: isCurrent }
end function

sub layoutCard(visual as object, index as integer)
    visual.group.translation = [index * (CARD_WIDTH + CARD_GAP), 0]
    visual.group.scaleRotateCenter = [CARD_WIDTH / 2, m.cardHeight / 2]
    visual.fill.width = CARD_WIDTH
    visual.fill.height = m.cardHeight
    visual.border.width = CARD_WIDTH
    visual.border.height = m.cardHeight

    nameTop = CARD_INSET + THUMB_HEIGHT + TEXT_GAP
    visual.name.translation = [TEXT_INSET, nameTop]
    visual.name.maxWidth = CARD_WIDTH - TEXT_INSET * 2
    visual.name.height = m.nameHeight
    visual.time.translation = [TEXT_INSET, nameTop + m.nameHeight + LINE_GAP]
end sub

' The focused card lifts, and the chapter playing now keeps an accent wash
sub applyFocus()
    if m.focusIndex < m.scrollCol then m.scrollCol = m.focusIndex
    if m.focusIndex >= m.scrollCol + m.visibleCards then m.scrollCol = m.focusIndex - m.visibleCards + 1

    for i = 0 to m.visuals.count() - 1
        visual = m.visuals[i]
        focused = i = m.focusIndex
        if focused
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 77)
            visual.border.blendColor = m.palette.accent
        else if visual.isCurrent
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 64)
            visual.border.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 153)
        else
            visual.fill.blendColor = "#FFFFFF14"
            visual.border.blendColor = "#FFFFFF26"
        end if
        scale = 1.0
        if focused then scale = FOCUS_SCALE
        visual.group.scale = [scale, scale]
        ' A long name scrolls on the focused card only, the rest stay ellipsized
        repeatCount = 0
        if focused then repeatCount = -1
        if visual.name.repeatCount <> repeatCount then visual.name.repeatCount = repeatCount

        if visual.thumb.uri = "" and visual.thumbUrl <> "" and i >= m.scrollCol - THUMB_MARGIN and i < m.scrollCol + m.visibleCards + THUMB_MARGIN
            visual.thumb.uri = visual.thumbUrl
        end if
    end for

    m.rows.translation = [-m.scrollCol * (CARD_WIDTH + CARD_GAP), 0]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = KeyCode.LEFT
        if m.focusIndex > 0
            m.focusIndex--
            applyFocus()
        end if
        return true
    end if
    if key = KeyCode.RIGHT
        if m.focusIndex < m.visuals.count() - 1
            m.focusIndex++
            applyFocus()
        end if
        return true
    end if
    if key = KeyCode.OK
        chapters = m.top.chapters ?? []
        if m.focusIndex < chapters.count() then m.top.selected = chapters[m.focusIndex].startSeconds
        return true
    end if
    if key = KeyCode.BACK
        m.top.dismissed = true
        return true
    end if
    ' Play and pause reach the player, everything else stays in the row
    return key <> KeyCode.PLAY
end function

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"

const PANEL_WIDTH = 1400
const PANEL_MAX_HEIGHT = 918
const PANEL_PAD = 30
const ROW_WIDTH = 1396
const ROW_PAD_X = 30
const ROW_PAD_Y = 25
const ROW_BORDER = 2
const TIME_MIN_WIDTH = 120
const TIME_GAP = 30

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelBorder = m.top.findNode("panelBorder")
    m.title = m.top.findNode("title")
    m.titleRule = m.top.findNode("titleRule")
    m.viewport = m.top.findNode("viewport")
    m.rows = m.top.findNode("rows")
    m.footer = m.top.findNode("footer")
    m.entrance = m.top.findNode("entrance")
    m.entranceSlide = m.top.findNode("entranceSlide")

    playbackOverlay.SetFont(m.title, 30, true)
    playbackOverlay.SetFont(m.footer, 18, false)
    m.title.text = tr("Chapters")
    m.footer.text = tr("Press BACK to close")

    m.palette = playbackOverlay.Palette()
    m.visuals = []
    m.focusIndex = 0
    m.scrollRow = 0
end sub

sub open()
    chapters = m.top.chapters ?? []
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    m.visuals = []

    titleBottom = PANEL_PAD + m.title.boundingRect().height + 18
    m.titleRule.translation = [2, titleBottom]
    viewportTop = titleBottom + 1 + 18

    m.rowHeight = 0
    for i = 0 to chapters.count() - 1
        m.visuals.push(buildRow(chapters[i], i = m.top.currentIndex))
    end for
    for each visual in m.visuals
        layoutRow(visual)
    end for

    footerHeight = m.footer.boundingRect().height
    room = PANEL_MAX_HEIGHT - viewportTop - 20 - footerHeight - PANEL_PAD
    m.visibleRows = 1
    if m.rowHeight > 0 then m.visibleRows = Int(room / m.rowHeight)
    if m.visibleRows < 1 then m.visibleRows = 1
    if m.visibleRows > chapters.count() then m.visibleRows = chapters.count()

    viewportHeight = m.visibleRows * m.rowHeight
    m.viewport.translation = [0, viewportTop]
    ' The panel's own edges cut the focused row where it grows past them
    m.viewport.clippingRect = [2, -6, ROW_WIDTH, viewportHeight + 12]
    m.footer.translation = [0, viewportTop + viewportHeight + 20]
    panelHeight = viewportTop + viewportHeight + 20 + footerHeight + PANEL_PAD
    m.panelFill.height = panelHeight
    m.panelBorder.height = panelHeight

    top = Int((1080 - panelHeight) / 2)
    m.entranceSlide.keyValue = [[(1920 - PANEL_WIDTH) / 2, top + 30], [(1920 - PANEL_WIDTH) / 2, top]]
    m.entrance.control = "start"

    m.focusIndex = m.top.currentIndex
    if m.focusIndex < 0 or m.focusIndex >= m.visuals.count() then m.focusIndex = 0
    m.scrollRow = 0
    applyFocus()
end sub

function buildRow(chapter as object, isCurrent as boolean) as object
    group = m.rows.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = "pkg:/images/livetv/fill10.9.png"
    border = group.createChild("Poster")
    border.uri = "pkg:/images/playback/stroke10w2.9.png"

    time = group.createChild("Label")
    playbackOverlay.SetFont(time, 26, true)
    time.color = m.palette.accent
    time.vertAlign = "center"
    time.text = secondsToHuman(Int(chapter.startSeconds), false)

    name = group.createChild("Label")
    playbackOverlay.SetFont(name, 24, false)
    name.color = "#FFFFFF"
    name.vertAlign = "center"
    name.text = chapter.name

    contentHeight = time.boundingRect().height
    if name.boundingRect().height > contentHeight then contentHeight = name.boundingRect().height
    rowHeight = contentHeight + ROW_PAD_Y * 2 + ROW_BORDER * 2
    if rowHeight > m.rowHeight then m.rowHeight = rowHeight

    return { group: group, fill: fill, border: border, time: time, name: name, isCurrent: isCurrent }
end function

sub layoutRow(visual as object)
    visual.group.scaleRotateCenter = [ROW_WIDTH / 2, m.rowHeight / 2]
    visual.fill.width = ROW_WIDTH
    visual.fill.height = m.rowHeight
    visual.border.width = ROW_WIDTH
    visual.border.height = m.rowHeight

    timeWidth = visual.time.boundingRect().width
    if timeWidth < TIME_MIN_WIDTH then timeWidth = TIME_MIN_WIDTH
    visual.time.translation = [ROW_BORDER + ROW_PAD_X, 0]
    visual.time.height = m.rowHeight
    nameLeft = ROW_BORDER + ROW_PAD_X + timeWidth + TIME_GAP
    visual.name.translation = [nameLeft, 0]
    visual.name.height = m.rowHeight
    visual.name.width = ROW_WIDTH - nameLeft - ROW_BORDER - ROW_PAD_X
end sub

' The focused row lifts and slides right, and the chapter playing now keeps an accent wash
sub applyFocus()
    for i = 0 to m.visuals.count() - 1
        visual = m.visuals[i]
        focused = i = m.focusIndex
        if focused
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 77)
            visual.border.blendColor = m.palette.accent
        else if visual.isCurrent
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 64)
            visual.border.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 153)
        else
            visual.fill.blendColor = "#FFFFFF14"
            visual.border.blendColor = "#FFFFFF26"
        end if
        scale = 1.0
        shift = 0
        if focused
            scale = 1.03
            shift = 8
        end if
        visual.group.scale = [scale, scale]
        visual.group.translation = [2 + shift, i * m.rowHeight]
    end for

    if m.focusIndex < m.scrollRow then m.scrollRow = m.focusIndex
    if m.focusIndex >= m.scrollRow + m.visibleRows then m.scrollRow = m.focusIndex - m.visibleRows + 1
    m.rows.translation = [0, -m.scrollRow * m.rowHeight]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = KeyCode.UP
        if m.focusIndex > 0
            m.focusIndex--
            applyFocus()
        end if
        return true
    end if
    if key = KeyCode.DOWN
        if m.focusIndex < m.visuals.count() - 1
            m.focusIndex++
            applyFocus()
        end if
        return true
    end if
    if key = KeyCode.OK
        chapters = m.top.chapters ?? []
        if m.focusIndex < chapters.count() then m.top.selected = chapters[m.focusIndex].startSeconds
        return true
    end if
    if key = KeyCode.BACK
        m.top.dismissed = true
        return true
    end if
    ' Play and pause reach the player, everything else stays in the list
    return key <> KeyCode.PLAY
end function

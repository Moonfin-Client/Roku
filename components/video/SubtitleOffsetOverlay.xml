<?xml version="1.0" encoding="utf-8"?>
<component name="SubtitleOffsetOverlay" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

        <Group id="panel" translation="[660, 340]">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" width="600" height="399"
                blendColor="#1E1E1E" opacity="0.98" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="600" height="399"
                blendColor="#FFFFFF" opacity="0.15" />

            <Label id="title" font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center"
                width="520" height="48" translation="[40, 40]" />

            <Group id="decrease" translation="[100, 123]" scaleRotateCenter="[40, 40]">
                <Poster id="decreaseFill" uri="pkg:/images/details/btnfill.9.png" width="80" height="80" />
                <Poster id="decreaseBorder" uri="pkg:/images/details/btnborderfocus.9.png" width="80" height="80" />
                <Label id="decreaseLabel" font="font:MediumSystemFont" color="#FFFFFF" text="−"
                    horizAlign="center" vertAlign="center" width="80" height="80" />
            </Group>

            <Label id="value" font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center"
                vertAlign="center" width="200" height="80" translation="[200, 123]" />

            <Group id="increase" translation="[420, 123]" scaleRotateCenter="[40, 40]">
                <Poster id="increaseFill" uri="pkg:/images/details/btnfill.9.png" width="80" height="80" />
                <Poster id="increaseBorder" uri="pkg:/images/details/btnborderfocus.9.png" width="80" height="80" />
                <Label id="increaseLabel" font="font:MediumSystemFont" color="#FFFFFF" text="+"
                    horizAlign="center" vertAlign="center" width="80" height="80" />
            </Group>

            <Group id="reset">
                <Poster id="resetFill" uri="pkg:/images/details/surface8.9.png" />
                <Poster id="resetBorder" uri="pkg:/images/details/outline6.9.png" />
                <Label id="resetLabel" font="font:SmallSystemFont" color="#FFFFFF" horizAlign="center"
                    vertAlign="center" />
            </Group>

            <Group id="close">
                <Poster id="closeFill" uri="pkg:/images/details/surface8.9.png" />
                <Label id="closeLabel" font="font:SmallSystemFont" horizAlign="center" vertAlign="center" />
            </Group>
        </Group>
    </children>

    <interface>
        <!-- In milliseconds, and positive holds the subtitles back -->
        <field id="offset" type="integer" value="0" onChange="drawValue" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
</component>

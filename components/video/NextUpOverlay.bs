import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"

' Sizes are the other clients' values scaled by 1.45, which is how they map
' their TV layout onto 1920x1080
const CARD_WIDTH = 493
const CARD_WIDTH_MINIMAL = 435
const THUMB_HEIGHT = 277
const EDGE = 20
const HEADER_TOP = 17
const TITLE_BOTTOM = 15
const BODY_PAD = 20
const BODY_PAD_MINIMAL = 15
const BUTTON_HEIGHT = 64
const BUTTON_GAP = 15
const BUTTON_PAD = 23
const RING_SIZE = 32
const RING_GAP = 13
const ICON_SIZE = 29
const PILL_PAD_H = 12
const PILL_PAD_V = 3
const PILL_GAP = 9
const RING_ICON_SIZE = 17
const HEADER_GAP = 12
const HEADER_GAP_MINIMAL = 9
const TITLE_GAP = 20
const TITLE_GAP_MINIMAL = 15

const BUTTON_PLAY = 0

sub init()
    m.fill = m.top.findNode("fill")
    m.thumbMask = m.top.findNode("thumbMask")
    m.thumb = m.top.findNode("thumb")
    m.eyebrow = m.top.findNode("eyebrow")
    m.countdown = m.top.findNode("countdown")
    m.pill = m.top.findNode("pill")
    m.pillFill = m.top.findNode("pillFill")
    m.pillText = m.top.findNode("pillText")
    m.title = m.top.findNode("title")
    m.playButton = m.top.findNode("playButton")
    m.playFill = m.top.findNode("playFill")
    m.playRingTrack = m.top.findNode("playRingTrack")
    m.playRingProgress = m.top.findNode("playRingProgress")
    m.playRingIcon = m.top.findNode("playRingIcon")
    m.playIcon = m.top.findNode("playIcon")
    m.playText = m.top.findNode("playText")
    m.dismissButton = m.top.findNode("dismissButton")
    m.dismissFill = m.top.findNode("dismissFill")
    m.dismissBorder = m.top.findNode("dismissBorder")
    m.dismissIcon = m.top.findNode("dismissIcon")

    ' A Font node needs a real font file, so the size goes on the system font
    m.eyebrow.font.size = 17
    m.countdown.font.size = 17
    m.pillText.font.size = 16
    m.title.font.size = 23
    m.playText.font.size = 22

    m.eyebrow.text = tr("Up Next")
    m.playText.text = tr("Play Next")

    m.top.observeField("seriesTitle", "onContentChanged")
    m.top.observeField("episodeTitle", "onContentChanged")
    m.top.observeField("episodeLabel", "onContentChanged")
    m.top.observeField("thumbUri", "onContentChanged")
    m.top.observeField("isMinimal", "onContentChanged")
    m.top.observeField("showRing", "onContentChanged")
    m.top.observeField("showTimer", "onContentChanged")
    m.top.observeField("secondsRemaining", "onTimerChanged")
    m.top.observeField("progress", "onProgressChanged")
    m.top.observeField("palette", "onFocusChanged")
    m.top.observeField("focusedButton", "onFocusChanged")

    onFocusChanged()
end sub

sub onProgressChanged()
    uri = `pkg:/images/playback/ring22/${playbackOverlay.RingFrame(m.top.progress)}.png`
    if not isStringEqual(m.playRingProgress.uri, uri) then m.playRingProgress.uri = uri
end sub

sub onTimerChanged()
    if not m.top.showTimer
        m.countdown.visible = false
        return
    end if

    seconds = m.top.secondsRemaining
    if seconds < 0 then seconds = 0

    m.countdown.visible = true
    m.countdown.text = tr("Ends in {time}").Replace("{time}", playbackOverlay.ClockText(seconds))
end sub

' Core swaps the accent onto whichever button holds focus and leaves the other
' one on its resting colours
sub onFocusChanged()
    palette = m.top.palette
    if not isValidAndNotEmpty(palette) then palette = playbackOverlay.Palette()

    m.fill.blendColor = palette.surface
    m.eyebrow.color = playbackOverlay.WithAlpha(palette.onSurface, 217)
    m.countdown.color = playbackOverlay.WithAlpha(palette.onSurface, 179)
    m.pillText.color = palette.onSurface
    m.title.color = palette.onSurface

    if m.top.focusedButton = BUTTON_PLAY
        m.playFill.blendColor = palette.accent
        playInk = palette.onAccent
        m.dismissFill.blendColor = playbackOverlay.WithAlpha(palette.onSurface, 20)
        m.dismissFill.opacity = 1.0
        m.dismissBorder.blendColor = palette.chipBorder
    else
        m.playFill.blendColor = playbackOverlay.WithAlpha(palette.surfaceVariant, 230)
        playInk = palette.onSurface
        m.dismissFill.blendColor = palette.accent
        m.dismissFill.opacity = 0.24
        m.dismissBorder.blendColor = palette.accent
    end if

    m.playText.color = playInk
    m.playIcon.blendColor = playInk
    m.playRingProgress.blendColor = playInk
    m.playRingIcon.blendColor = playInk
    m.playRingTrack.blendColor = playbackOverlay.WithAlpha(playInk, 61)
    m.dismissIcon.blendColor = palette.onSurface

    m.pillFill.blendColor = palette.accent
    m.pillFill.opacity = 0.22
end sub

sub onContentChanged()
    hasThumb = isValidAndNotEmpty(m.top.thumbUri) and not m.top.isMinimal
    width = m.top.isMinimal ? CARD_WIDTH_MINIMAL : CARD_WIDTH
    pad = m.top.isMinimal ? BODY_PAD_MINIMAL : BODY_PAD

    m.top.overlayWidth = width
    m.fill.width = width

    m.playRingTrack.visible = m.top.showRing
    m.playRingProgress.visible = m.top.showRing
    m.playRingIcon.visible = m.top.showRing
    m.playIcon.visible = not m.top.showRing

    onTimerChanged()
    layoutPill()

    m.title.width = width - (EDGE * 2)
    m.title.text = isValidAndNotEmpty(m.top.episodeTitle) ? m.top.episodeTitle : m.top.seriesTitle

    m.thumbMask.visible = hasThumb
    if hasThumb then m.thumb.uri = m.top.thumbUri

    if hasThumb
        layoutOverThumb(width)
        bodyTop = THUMB_HEIGHT
    else
        bodyTop = layoutInBody(width, pad)
    end if

    height = layoutButtons(width, bodyTop, pad)
    m.fill.height = height
    m.top.overlayHeight = height
end sub

' With artwork the eyebrow, countdown and title sit on top of the image
sub layoutOverThumb(width as float)
    m.eyebrow.translation = [EDGE, HEADER_TOP]
    m.countdown.width = width - (EDGE * 2)
    m.countdown.translation = [EDGE, HEADER_TOP]

    titleHeight = m.title.boundingRect().height
    titleTop = THUMB_HEIGHT - TITLE_BOTTOM - titleHeight
    m.title.translation = [EDGE, titleTop]

    if m.pill.visible
        m.pill.translation = [EDGE, titleTop - PILL_GAP - m.pillFill.height]
    end if
end sub

' Without artwork they stack down the body instead, and the function returns
' where the button row starts
function layoutInBody(width as float, pad as float) as float
    cursor = pad

    m.eyebrow.translation = [pad, cursor]
    m.countdown.width = width - (pad * 2)
    m.countdown.translation = [pad, cursor]
    cursor += m.eyebrow.boundingRect().height + (m.top.isMinimal ? HEADER_GAP_MINIMAL : HEADER_GAP)

    if m.pill.visible
        m.pill.translation = [pad, cursor]
        cursor += m.pillFill.height + PILL_GAP
    end if

    m.title.width = width - (pad * 2)
    m.title.translation = [pad, cursor]
    cursor += m.title.boundingRect().height + (m.top.isMinimal ? TITLE_GAP_MINIMAL : TITLE_GAP)

    return cursor
end function

function layoutButtons(width as float, bodyTop as float, pad as float) as float
    top = bodyTop + pad

    dismissLeft = width - pad - BUTTON_HEIGHT
    playWidth = dismissLeft - BUTTON_GAP - pad

    m.playButton.translation = [pad, top]
    m.playFill.width = playWidth

    contentWidth = (m.top.showRing ? RING_SIZE : ICON_SIZE) + RING_GAP + m.playText.boundingRect().width
    contentLeft = (playWidth - contentWidth) / 2
    if contentLeft < BUTTON_PAD then contentLeft = BUTTON_PAD

    m.playRingTrack.translation = [contentLeft, (BUTTON_HEIGHT - RING_SIZE) / 2]
    m.playRingProgress.translation = [contentLeft, (BUTTON_HEIGHT - RING_SIZE) / 2]
    m.playRingIcon.translation = [contentLeft + ((RING_SIZE - RING_ICON_SIZE) / 2), (BUTTON_HEIGHT - RING_ICON_SIZE) / 2]
    m.playIcon.translation = [contentLeft, (BUTTON_HEIGHT - ICON_SIZE) / 2]
    m.playText.translation = [contentLeft + (m.top.showRing ? RING_SIZE : ICON_SIZE) + RING_GAP, 0]

    m.dismissButton.translation = [dismissLeft, top]

    return top + BUTTON_HEIGHT + pad
end function

sub layoutPill()
    if not isValidAndNotEmpty(m.top.episodeLabel)
        m.pill.visible = false
        return
    end if

    m.pill.visible = true
    m.pillText.text = m.top.episodeLabel

    textRect = m.pillText.boundingRect()
    m.pillText.translation = [PILL_PAD_H, PILL_PAD_V]
    m.pillFill.width = textRect.width + (PILL_PAD_H * 2)
    m.pillFill.height = textRect.height + (PILL_PAD_V * 2)
end sub

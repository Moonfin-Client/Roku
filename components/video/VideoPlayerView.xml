<?xml version="1.0" encoding="utf-8"?>
<component name="VideoPlayerView" extends="Video">
  <interface>
    <field id="backPressed" type="boolean" alwaysNotify="true" />
    <field id="selectSubtitlePressed" type="boolean" alwaysNotify="true" />
    <field id="selectAudioPressed" type="boolean" alwaysNotify="true" />
    <field id="selectPlaybackInfoPressed" type="boolean" alwaysNotify="true" />
    <field id="PlaySessionId" type="string" />
    <field id="Subtitles" type="array" />
    <field id="SelectedSubtitle" type="integer" value="-2" alwaysNotify="true" />
    <field id="previousSubtitleWasEncoded" type="boolean" />
    <field id="container" type="string" />
    <field id="directPlaySupported" type="boolean" />
    <field id="systemOverlay" type="boolean" value="false" />
    <field id="showID" type="string" />
    <field id="lastFocus" type="node" />

    <field id="transcodeParams" type="assocarray" />
    <field id="transcodeAvailable" type="boolean" value="false" />
    <field id="retryWithTranscoding" type="boolean" value="false" />
    <field id="isTranscoded" type="boolean" />
    <field id="disableNextEpisodeAutoPlay" type="boolean" value="false" />

    <field id="videoId" type="string" />
    <field id="mediaSourceId" type="string" />
    <field id="fullSubtitleData" type="array" />
    <field id="fullAudioData" type="array" />
    <field id="audioIndex" type="integer" />
    <field id="allowCaptions" type="boolean" value="false" />
  </interface>

  <children>
    <Rectangle id="pauseOverlay" width="1920" height="1080" color="0x000000AA" visible="false" />
    <Group id="captionGroup" translation="[0,0]" />
    <timer id="playbackTimer" repeat="true" duration="30" />
    <timer id="bufferCheckTimer" repeat="true" />
    <timer id="scrubTimer" repeat="true" duration="0.3" />
    <timer id="nextUpTimer" repeat="true" duration="0.1" />
    <timer id="startDelayTimer" repeat="false" />
    <!-- Live TV: the airing program is checked every minute, the carousel's guide data is warmed
         once a tune settles, and a channel switch that hasnt started playing by the timeout fails -->
    <timer id="liveProgramTimer" repeat="true" duration="60" />
    <timer id="prewarmTimer" repeat="false" duration="1" />
    <timer id="switchTimer" repeat="false" duration="35" />
    <OSD id="osd" visible="false" inactiveTimeout="0" />

    <LoadingAnimation id="loadingLayer" visible="false" />
    <!-- After a seek with a preview to look at, buffering keeps quiet this long -->
    <timer id="seekGraceTimer" repeat="false" duration="3" />

    <!-- The frame a scrub on the seek bar is aiming at, in a box centered over the bar -->
    <Group id="seekPreview" visible="false">
      <Poster id="seekPreviewFill" uri="pkg:/images/details/surface8.9.png" blendColor="#000000F2" />
      <Poster id="seekPreviewBorder" uri="pkg:/images/playback/stroke8w2.9.png" blendColor="#FFFFFF33" />
      <Group id="seekPreviewFrame" translation="[10, 10]" />
      <Label id="seekPreviewTime" color="#FFFFFF" horizAlign="center" />
    </Group>
    <Animation id="seekPreviewEntrance" duration="0.15" repeat="false" easeFunction="outCubic">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="seekPreview.opacity" />
      <Vector2DFieldInterpolator id="seekPreviewSlide" key="[0.0, 1.0]" fieldToInterp="seekPreview.translation" />
    </Animation>
    <timer id="seekSettleTimer" repeat="false" duration="0.6" />

    <Text id="videoEndingTime" font="font:SmallSystemFont" color="0xffffffFF" horizAlign="right" width="200" translation="[1617,900]" visible="false" />

    <NextUpOverlay id="nextUp" visible="false" />

    <SkipSegmentOverlay id="skipSegment" visible="false" />

    <Group id="scrubInfo" visible="false" translation="[103,900]">
      <Text id="scrubSpeedDisplay" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="right" width="100" translation="[1612,55]" />
      <Rectangle id="scrubProgressBackground" width="1714" height="6" color="0x555555AA" translation="[0,30]">
        <Rectangle id="scrubProgressBar" width="0" height="6" color="0x00a4dcFF" />
      </Rectangle>
      <Text id="scrubTimeDisplay" font="font:MediumSystemFont" color="0xffffffFF" horizAlign="left" width="400" translation="[0,55]" />
    </Group>

    <AudioSelector id="audioSelector" visible="false" />
    <SubtitleSelector id="subtitleSelector" visible="false" />
    <SubtitleDownloadDialog id="subtitleDownloadDialog" visible="false" />
    <SubtitleOffsetOverlay id="subtitleOffsetOverlay" visible="false" />
  </children>
</component>
<?xml version="1.0" encoding="utf-8"?>
<component name="VideoPlayerView" extends="Video">
  <interface>
    <field id="backPressed" type="boolean" alwaysNotify="true" />
    <field id="selectSubtitlePressed" type="boolean" alwaysNotify="true" />
    <field id="selectAudioPressed" type="boolean" alwaysNotify="true" />
    <field id="selectPlaybackInfoPressed" type="boolean" alwaysNotify="true" />
    <field id="PlaySessionId" type="string" />
    <!-- The second subtitle track's stream index, or -1, and how far its lines are held back in ms -->
    <field id="secondarySubtitleIndex" type="integer" value="-1" />
    <field id="secondarySubtitleDelay" type="integer" value="0" />
    <field id="Subtitles" type="array" />
    <field id="SelectedSubtitle" type="integer" value="-2" alwaysNotify="true" />
    <function name="reloadWithSubtitle" />
    <function name="selectEmbeddedSubtitle" />
    <function name="offersSecondarySubtitles" />
    <function name="secondarySubtitleCandidates" />
    <function name="selectSecondarySubtitle" />
    <function name="releaseSecondaryIfPrimary" />
    <function name="showPlaybackInfo" />
    <!-- Brings the controls back with focus on the button named, once a menu it opened closes -->
    <function name="showControlsOn" />
    <!-- Lets a watch party go, when the room moves this device on to another video -->
    <function name="wpDetach" />
    <field id="previousSubtitleWasEncoded" type="boolean" />
    <field id="container" type="string" />
    <field id="directPlaySupported" type="boolean" />
    <field id="systemOverlay" type="boolean" value="false" />
    <field id="showID" type="string" />
    <field id="lastFocus" type="node" />

    <field id="transcodeParams" type="assocarray" />
    <field id="transcodeAvailable" type="boolean" value="false" />
    <field id="retryWithTranscoding" type="boolean" value="false" />
    <field id="isTranscoded" type="boolean" />

    <field id="videoId" type="string" />
    <field id="mediaSourceId" type="string" />
    <field id="fullSubtitleData" type="array" />
    <field id="fullAudioData" type="array" />
    <field id="audioIndex" type="integer" />
    <field id="allowCaptions" type="boolean" value="false" />
    <!-- A Live TV channel is playing, whose end the live recovery handles rather than the queue -->
    <field id="isLiveChannel" type="boolean" value="false" />
    <!-- Up while the card saying when the next episode airs shows, so the end of the episode waits for it -->
    <field id="holdAtEnd" type="boolean" value="false" />
  </interface>

  <children>
    <!-- A light dim behind the controls, so they stay readable over bright scenes -->
    <Rectangle id="pauseOverlay" width="1920" height="1080" color="0x0000004D" visible="false" />
    <Group id="captionGroup" translation="[0,0]" />
    <Group id="secondaryCaptionGroup" />
    <timer id="playbackTimer" repeat="true" duration="30" />
    <timer id="bufferCheckTimer" repeat="true" />
    <timer id="nextUpTimer" repeat="true" duration="0.1" />
    <timer id="startDelayTimer" repeat="false" />
    <!-- How long a skip prompt shows by itself before it only comes back with the controls -->
    <timer id="skipAutoHideTimer" repeat="false" />
    <!-- Live TV: the airing program is checked every minute, the carousel's guide data is warmed
         once a tune settles, and a channel switch that hasnt started playing by the timeout fails -->
    <timer id="liveProgramTimer" repeat="true" duration="60" />
    <timer id="prewarmTimer" repeat="false" duration="1" />
    <timer id="switchTimer" repeat="false" duration="35" />
    <!-- The live recovery's held retry, the wait before a recovered channel gets its budget back,
         and the stall watchdog. It sets each one's time itself. -->
    <timer id="liveRetryTimer" repeat="false" />
    <timer id="liveProvenTimer" repeat="false" />
    <timer id="liveWatchdogTimer" repeat="false" />
    <!-- How long a re-resolve waits on the stop that ends a served channel's job on the server -->
    <timer id="liveStopWaitTimer" repeat="false" duration="3" />
    <OSD id="osd" visible="false" inactiveTimeout="0" />

    <LoadingAnimation id="loadingLayer" visible="false" />
    <LiveFailedCard id="liveFailedCard" visible="false" />
    <!-- After a seek with a preview to look at, buffering keeps quiet this long -->
    <timer id="seekGraceTimer" repeat="false" duration="3" />

    <!-- The frame a scrub on the seek bar is aiming at, in a tile over the thumb -->
    <Group id="seekPreview" visible="false">
      <Poster id="seekPreviewFill" uri="pkg:/images/details/surface8.9.png" blendColor="#000000" />
      <Group id="seekPreviewFrame" />
      <Poster id="seekPreviewBorder" uri="pkg:/images/playback/stroke8w2.9.png" />
    </Group>
    <Animation id="seekPreviewEntrance" duration="0.15" repeat="false" easeFunction="outCubic">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="seekPreview.opacity" />
    </Animation>
    <timer id="seekSettleTimer" repeat="false" duration="0.6" />
    <timer id="heldSeekStart" repeat="false" duration="0.35" />
    <timer id="heldSeekRepeat" repeat="true" duration="0.11" />

    <NextUpOverlay id="nextUp" visible="false" />

    <SkipSegmentOverlay id="skipSegment" visible="false" />

    <!-- Says a picked subtitle is still on its way, above the seek bar or in the corner once the
         controls hide -->
    <Group id="subtitleFetch" visible="false">
      <Poster id="subtitleFetchBg" uri="pkg:/images/makd/dotspill14.9.png" blendColor="#0000008A" />
      <Poster id="subtitleFetchTrack" uri="pkg:/images/playback/ring22/40.webp" width="20" height="20" blendColor="#FFFFFF33" />
      <Poster id="subtitleFetchArc" uri="pkg:/images/playback/ring22/10.webp" width="20" height="20" scaleRotateCenter="[10, 10]" />
      <Label id="subtitleFetchLabel" color="#FFFFFFB3" />
    </Group>
    <Animation id="subtitleFetchSpin" duration="1.6" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="subtitleFetchArc.rotation" />
    </Animation>
    <!-- A subtitle the server answers right away doesn't flash the indicator -->
    <timer id="subtitleFetchDelay" repeat="false" duration="0.5" />

    <!-- While the controls are up, the airing program's recording is read again once a minute -->
    <timer id="recordStateTimer" repeat="true" duration="60" />
    <!-- Answers each recording action, over the player whether the controls are up or not -->
    <Group id="recordToast" visible="false" opacity="0">
      <Poster id="recordToastFill" uri="pkg:/images/livetv/fill12.9.png" blendColor="#1E1E28F0" />
      <Poster id="recordToastBorder" uri="pkg:/images/livetv/stroke12w1.9.png" blendColor="#FFFFFF1F" />
      <Label id="recordToastText" color="#FFFFFF" translation="[28, 14]" />
    </Group>
    <Animation id="recordToastFade" duration="3" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 0.1, 0.85, 1.0]" keyValue="[0.0, 1.0, 1.0, 0.0]" fieldToInterp="recordToast.opacity" />
    </Animation>

    <AudioSelector id="audioSelector" visible="false" />
    <SubtitleSelector id="subtitleSelector" visible="false" />
    <SubtitleDownloadDialog id="subtitleDownloadDialog" visible="false" />
    <SubtitleOffsetOverlay id="subtitleOffsetOverlay" visible="false" />
    <SubtitleAppearanceOverlay id="subtitleAppearance" visible="false" />
  </children>
</component>
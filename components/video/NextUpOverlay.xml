<?xml version="1.0" encoding="utf-8"?>

<!-- Up Next card, matching the overlay the other clients show. They author their
     TV layout at 1920/1.45 and scale it up, so every size here is the Core value
     times 1.45. -->
<component name="NextUpOverlay" extends="Group">
  <interface>
    <field id="seriesTitle" type="string" />
    <field id="episodeTitle" type="string" />
    <field id="episodeLabel" type="string" />
    <field id="thumbUri" type="string" />
    <field id="secondsRemaining" type="integer" value="0" />
    <field id="progress" type="float" value="1.0" />
    <field id="showRing" type="boolean" value="true" />
    <field id="showTimer" type="boolean" value="true" />
    <field id="isMinimal" type="boolean" value="false" />
    <field id="palette" type="assocarray" />
    <field id="focusedButton" type="integer" value="0" />
    <field id="overlayWidth" type="float" value="493" />
    <field id="overlayHeight" type="float" value="0" />
  </interface>

  <children>
    <Poster id="fill" uri="pkg:/images/playback/surface26.9.png" blendColor="0x1A1A1AFF" opacity="0.55" />

    <MaskGroup id="thumbMask" maskUri="pkg:/images/playback/thumb_mask.png" maskOffset="[0,0,0,0]" visible="false">
      <Poster id="thumb" width="493" height="277" loadDisplayMode="scaleToFill" />
      <Poster id="scrim" uri="pkg:/images/playback/thumb_scrim.png" width="493" height="277" />
    </MaskGroup>

    <Label id="eyebrow" color="0xFFFFFFD9" font="font:MediumBoldSystemFont" />

    <Label id="countdown" horizAlign="right" color="0xFFFFFFB3" font="font:MediumBoldSystemFont" />

    <Group id="pill" visible="false">
      <Poster id="pillFill" uri="pkg:/images/playback/surface9.9.png" />
      <Label id="pillText" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
    </Group>

    <Label id="title" wrap="true" maxLines="2" ellipsisText="..." color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />

    <Group id="playButton">
      <Poster id="playFill" uri="pkg:/images/playback/surface17.9.png" height="64" />
      <Poster id="playRingTrack" uri="pkg:/images/playback/ring22/40.png" width="32" height="32" blendColor="0xFFFFFF3D" />
      <Poster id="playRingProgress" uri="pkg:/images/playback/ring22/40.png" width="32" height="32" blendColor="0xFFFFFFFF" />
      <Poster id="playRingIcon" uri="pkg:/images/playback/play_arrow_sm.png" width="17" height="17" blendColor="0xFFFFFFFF" />
      <Poster id="playIcon" uri="pkg:/images/playback/play_arrow.png" width="29" height="29" blendColor="0xFFFFFFFF" visible="false" />
      <Label id="playText" vertAlign="center" height="64" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
    </Group>

    <Group id="dismissButton">
      <Poster id="dismissFill" uri="pkg:/images/playback/surface17.9.png" width="64" height="64" />
      <Poster id="dismissBorder" uri="pkg:/images/playback/outline17.9.png" width="64" height="64" />
      <Poster id="dismissIcon" uri="pkg:/images/playback/close.png" width="29" height="29" translation="[17, 17]" blendColor="0xFFFFFFFF" />
    </Group>
  </children>
</component>

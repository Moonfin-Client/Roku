import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/themeChrome.bs"

const CARD_PADDING = 32
const MESSAGE_SIZE = 32
const MESSAGE_GAP = 24
const BUTTON_HEIGHT = 72
const BUTTON_PADDING = 30
const BUTTON_TEXT_SIZE = 39
const BUTTON_MIN_WIDTH = 72
const BUTTON_MAX_WIDTH = 450
' Room kept around the button so it can grow when focused
const BUTTON_MARGIN_X = 18
const BUTTON_MARGIN_Y = 3
const BUTTON_FOCUS_SCALE = 1.05

sub init()
    m.card = m.top.findNode("card")
    m.cardFill = m.top.findNode("cardFill")
    m.cardBorder = m.top.findNode("cardBorder")
    m.message = m.top.findNode("message")
    m.retryButton = m.top.findNode("retryButton")
    m.retryFill = m.top.findNode("retryFill")
    m.retryLabel = m.top.findNode("retryLabel")

    playbackOverlay.SetFont(m.message, MESSAGE_SIZE, true)
    playbackOverlay.SetFont(m.retryLabel, BUTTON_TEXT_SIZE, true)
    m.retryLabel.text = tr("Retry")

    ' Retry is the only thing on the card, so it always shows focused
    m.retryFill.blendColor = themeChrome.Token("buttonFocused", "#FFFFFF")
    m.retryLabel.color = themeChrome.Token("onButtonFocused", "#000000FF")
    layoutCard()
end sub

sub layoutCard()
    m.message.text = tr("Failed to play {name}").Replace("{name}", m.top.channelName)
    m.message.width = 0
    messageRect = m.message.boundingRect()

    m.retryLabel.width = 0
    labelWidth = m.retryLabel.boundingRect().width
    buttonWidth = labelWidth + BUTTON_PADDING * 2
    if buttonWidth < BUTTON_MIN_WIDTH then buttonWidth = BUTTON_MIN_WIDTH
    if buttonWidth > BUTTON_MAX_WIDTH then buttonWidth = BUTTON_MAX_WIDTH

    contentWidth = messageRect.width
    if buttonWidth + BUTTON_MARGIN_X * 2 > contentWidth then contentWidth = buttonWidth + BUTTON_MARGIN_X * 2
    cardWidth = contentWidth + CARD_PADDING * 2
    buttonTop = CARD_PADDING + messageRect.height + MESSAGE_GAP + BUTTON_MARGIN_Y
    cardHeight = buttonTop + BUTTON_HEIGHT + BUTTON_MARGIN_Y + CARD_PADDING

    m.message.width = contentWidth
    m.message.translation = [CARD_PADDING, CARD_PADDING]

    m.retryLabel.width = buttonWidth
    m.retryLabel.height = BUTTON_HEIGHT
    m.retryFill.width = buttonWidth
    m.retryFill.height = BUTTON_HEIGHT
    m.retryFill.scaleRotateCenter = [buttonWidth / 2, BUTTON_HEIGHT / 2]
    m.retryFill.scale = [BUTTON_FOCUS_SCALE, BUTTON_FOCUS_SCALE]
    m.retryButton.translation = [(cardWidth - buttonWidth) / 2, buttonTop]

    for each surface in [m.cardFill, m.cardBorder]
        surface.width = cardWidth
        surface.height = cardHeight
    end for
    m.card.translation = [(1920 - cardWidth) / 2, (1080 - cardHeight) / 2]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or key <> KeyCode.OK then return false
    m.top.retry = true
    return true
end function

import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/liveWindow.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/osdControls.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/themeChrome.bs"

const LOGO_HEIGHT = 108
' A wide logo can take a third of the screen, then it shrinks to fit
const LOGO_MAX_WIDTH = 652
const HEADER_X = 24
const HEADER_Y = 12
' Where the episode line starts under a logo, lifted for the room a Roku label leaves over its text
const TITLE_UNDER_LOGO_Y = 112
const BAR_X = 24
const BAR_Y = 931
const THUMB_SIZE = 21
' A time row is a 33 tall line 6 off the bar
const TIME_ROW_HEIGHT = 33
const TIME_ROW_GAP = 6
const FOCUS_LABEL_HEIGHT = 53
const FOCUS_LABEL_GAP = 12

sub init()
    m.transportControls = m.top.findNode("transportControls")
    m.secondaryControls = m.top.findNode("secondaryControls")

    m.inactivityTimer = m.top.findNode("inactivityTimer")
    m.videoInfo = m.top.findNode("videoInfo")
    m.itemTitle = m.top.findNode("itemTitle")
    m.itemSecondary = m.top.findNode("itemSecondary")
    m.logo = m.top.findNode("logo")
    m.logo.observeField("loadStatus", "onLogoLoadStatusChanged")
    playbackOverlay.SetFont(m.itemTitle, 27, true)
    playbackOverlay.SetFont(m.itemSecondary, 21, false)
    m.videoPlayPause = m.top.findNode("videoPlayPause")
    settings = m.global.session.user.settings
    ' Each label's id names its setting, playback.timeAboveLeft and so on. The modes are read once
    ' here since the labels redraw on every position tick.
    m.timeSlots = []
    columns = [48, 656, 1264]
    for each slot in ["AboveLeft", "AboveCenter", "AboveRight", "BelowLeft", "BelowCenter", "BelowRight"]
        label = m.top.findNode(LCase(slot.Left(1)) + slot.Mid(1))
        above = slot.Left(5) = "Above"
        playbackOverlay.SetFont(label, 18, above)
        m.timeSlots.push({ label: label, mode: settings["playback.time" + slot] ?? "none", above: above, x: columns[m.timeSlots.count() mod 3] })
    end for
    m.clock = m.top.findNode("clock")
    ' A slot showing the clock turns over with it, paused or not
    m.clock.findNode("clockTime").observeField("text", "updateOSDTime")
    m.progressBar = m.top.findNode("progressBar")
    m.progressBarBackground = m.top.findNode("progressBarBackground")
    m.progressIndicator = m.top.findNode("progressIndicator")
    m.chapterMarks = m.top.findNode("chapterMarks")
    m.markedDuration = 0
    m.seekbarGroup = m.top.findNode("seekbarGroup")
    ' Kept here since live TV takes these out of the row, and a removed node can't be found again
    m.itemBackButton = m.top.findNode("itemBack")
    m.itemNextButton = m.top.findNode("itemNext")
    m.rewindButton = m.top.findNode("rewind")
    m.fastForwardButton = m.top.findNode("fastForward")
    m.jumpToLiveButton = m.top.findNode("jumpToLive")
    m.focusLabel = m.top.findNode("focusLabel")
    m.focusLabelText = m.top.findNode("focusLabelText")
    playbackOverlay.SetFont(m.focusLabelText, 18, true)
    m.focusLabelLayers = [m.top.findNode("focusLabelFill"), m.top.findNode("focusLabelRing")]
    for each layer in m.focusLabelLayers
        layer.height = FOCUS_LABEL_HEIGHT
    end for
    m.liveHeader = m.top.findNode("liveHeader")
    m.liveBadgeFill = m.top.findNode("liveBadgeFill")
    m.liveBadgeLabel = m.top.findNode("liveBadgeLabel")
    m.liveChannelName = m.top.findNode("liveChannelName")
    m.liveProgramName = m.top.findNode("liveProgramName")
    m.liveTimeline = m.top.findNode("liveTimeline")
    m.liveEpisodeLine = m.top.findNode("liveEpisodeLine")
    m.liveTrack = m.top.findNode("liveTrack")
    m.liveFill = m.top.findNode("liveFill")
    m.liveStartLabel = m.top.findNode("liveStartLabel")
    m.liveEndLabel = m.top.findNode("liveEndLabel")
    liveTvGuide.SetFont(m.liveBadgeLabel, 24, true)
    liveTvGuide.SetFont(m.liveChannelName, 27, true)
    liveTvGuide.SetFont(m.liveProgramName, 21, false)
    liveTvGuide.SetFont(m.liveEpisodeLine, 21, false)
    liveTvGuide.SetFont(m.liveStartLabel, 18, false)
    liveTvGuide.SetFont(m.liveEndLabel, 18, false)

    m.top.observeField("visible", "onVisibleChanged")
    m.top.observeField("hasFocus", "onFocusChanged")
    m.top.observeField("progressPercentage", "onProgressPercentageChanged")
    m.top.observeField("playbackState", "onPlaybackStateChanged")
    ' Ends-at is recalculated on a clock timer, so it moves while paused when position doesn't
    m.top.observeField("videoEndingTime", "updateOSDTime")

    m.top.observeField("itemTitleText", "layoutHeader")
    m.top.observeField("itemSecondaryText", "layoutHeader")
    m.top.observeField("logoImage", "onLogoImageChanged")

    m.focusedButtonIndex = 0
    m.currentButtonGroup = "seekbar"

    m.seekbarGroup.setFocus(true)
    m.accent = themeChrome.Token("rangeProgress", "#00a4dc")
    m.progressBar.color = m.accent
    m.progressIndicator.blendColor = m.accent
    m.deviceInfo = CreateObject("roDeviceInfo")
    layoutBar()

    m.transportControls.translation = [buttonLayout.OSD_ROW_X, buttonLayout.OSD_ROW_Y]
    m.transportControls.itemSpacings = [buttonLayout.OSD_SPACING]
    m.secondaryControls.itemSpacings = [buttonLayout.OSD_SPACING]
    for each button in m.transportControls.getChildren(-1, 0)
        button.label = tr(button.label)
    end for
    m.skipBack = osdControls.SkipSeconds(settings, -1)
    m.skipForward = osdControls.SkipSeconds(settings, 1)
    applySeekGlyphs()
    ' Jump to Live only joins the row while a live stream has a window to rewind
    setButtonInGroup(m.transportControls, m.jumpToLiveButton, false, 0)

    buildSecondaryControls()
end sub

' Live TV seeks inside its window with plain arrows
sub applySeekGlyphs()
    if m.top.liveMode
        m.rewindButton.glyph = "fast_rewind_rounded"
        m.fastForwardButton.glyph = "fast_forward_rounded"
        return
    end if
    m.rewindButton.glyph = osdControls.SeekGlyph(-1, m.skipBack)
    m.fastForwardButton.glyph = osdControls.SeekGlyph(1, m.skipForward)
end sub

' The bar drops into the space of a time row below it that has nothing to show
sub layoutBar()
    belowEmpty = true
    for each slot in m.timeSlots
        if not slot.above and slot.mode <> "none" and slot.mode <> "" then belowEmpty = false
    end for
    barY = BAR_Y
    if belowEmpty then barY += TIME_ROW_HEIGHT + TIME_ROW_GAP
    m.seekbarGroup.translation = [BAR_X, barY]
    for each slot in m.timeSlots
        if slot.above then slot.label.translation = [slot.x, barY - TIME_ROW_HEIGHT - TIME_ROW_GAP] else slot.label.translation = [slot.x, barY + 6 + 8]
    end for
    drawBarAt(m.top.progressPercentage)
end sub

function secondaryCandidates() as object
    if m.top.liveMode then return liveCandidates()
    return buttonLayout.OsdCandidates(m.top.hasChapters, m.top.hasEpisodes, m.top.hasSubtitles, m.top.hasPeople, m.top.canFavorite)
end function

' The live row: the channel carousel and the guide lead, with nothing to seek or step through
function liveCandidates() as object
    candidates = [
        { id: "channels", nodeId: "showChannels", glyph: "grid_view_rounded", label: "Channels" },
        { id: "guide", nodeId: "showGuide", glyph: "list_rounded", label: "Guide" }
    ]
    if m.top.hasAudioChoice
        candidates.push({ id: "audio", nodeId: "showAudioMenu", glyph: "audiotrack_rounded", label: "Audio" })
    end if
    if m.top.hasSubtitles
        candidates.push({ id: "subtitles", nodeId: "showSubtitleMenu", glyph: "subtitles_rounded", label: "Subtitles" })
    end if
    if m.top.recordable
        candidates.push({ id: "record", nodeId: "showRecord", glyph: "fiber_manual_record", label: "Record" })
    end if
    candidates.push({ id: "info", nodeId: "showVideoInfoPopup", glyph: "info_outline_rounded", label: "Playback Information" })
    return candidates
end function

sub applyRecordMark()
    button = m.secondaryControls.findNode("showRecord")
    if not isValid(button) then return
    mark = m.top.recordMark
    button.glyph = "fiber_manual_record"
    if mark = "series" or mark = "skipped" then button.glyph = "fiber_smart_record"
    button.iconColor = "#FFFFFF"
    if mark = "series" or mark = "record" then button.iconColor = "#F44336"
    if mark = "skipped" then button.iconColor = "#9E9E9E"
end sub

' The heart and its label follow the favorite, speed reads as text, and a bitrate cap tints its button
sub applyButtonStates()
    favorite = m.secondaryControls.findNode("toggleFavorite")
    if isValid(favorite)
        favorite.glyph = m.top.isFavorite ? "favorite" : "favorite_border"
        favorite.iconColor = m.top.isFavorite ? "#CF6679" : "#FFFFFF"
        favorite.label = m.top.isFavorite ? tr("Remove from Favorites") : tr("Add to Favorites")
    end if
    speed = m.secondaryControls.findNode("showSpeedMenu")
    if isValid(speed) then speed.text = osdControls.SpeedLabel(m.top.playbackSpeed)
    quality = m.secondaryControls.findNode("showQualityMenu")
    if isValid(quality) then quality.iconColor = m.top.bitrateCapped ? m.accent : "#FFFFFF"
    showFocusLabel()
end sub

' A live stream with a window to rewind seeks on the bar from its start to the live point, with
' Seek back, Play, Seek forward and Jump to Live. Without one it only plays and pauses.
sub applyLiveMode()
    live = m.top.liveMode
    rewind = live and m.top.liveRewind
    m.videoInfo.visible = not live
    m.liveHeader.visible = live
    m.liveTimeline.visible = live
    m.chapterMarks.visible = not live
    for each slot in m.timeSlots
        slot.label.visible = not live
    end for
    m.seekbarGroup.visible = not live or rewind
    m.liveTrack.visible = live and not rewind
    if live
        focused = invalid
        if m.currentButtonGroup = "transport" then focused = m.transportControls.getChild(m.focusedButtonIndex)
        setButtonInGroup(m.transportControls, m.itemBackButton, false, 0)
        setButtonInGroup(m.transportControls, m.itemNextButton, false, 0)
        setButtonInGroup(m.transportControls, m.rewindButton, rewind, 0)
        setButtonInGroup(m.transportControls, m.fastForwardButton, rewind, m.transportControls.getChildCount())
        setButtonInGroup(m.transportControls, m.jumpToLiveButton, rewind, m.transportControls.getChildCount())
        ' The button that had focus keeps it wherever it moved, or play takes it when it went away
        if isValid(focused)
            index = playPauseIndex()
            for i = 0 to m.transportControls.getChildCount() - 1
                if m.transportControls.getChild(i).isSameNode(focused) then index = i
            end for
            focusOnTransportControls(index)
        end if
    end if
    applySeekGlyphs()
    onPlaybackStateChanged()
    buildSecondaryControls()
    renderLive()
end sub

' The channel number in a badge, then the channel's name over the program's
sub renderLive()
    if not m.top.liveMode then return
    channel = m.top.liveChannel
    program = m.top.liveProgram

    number = chainLookupReturn(channel, "number", "")
    m.liveBadgeFill.visible = number <> ""
    m.liveBadgeLabel.visible = number <> ""
    infoLeft = 0
    badgeHeight = 0
    if number <> ""
        m.liveBadgeLabel.text = number
        rect = m.liveBadgeLabel.boundingRect()
        m.liveBadgeFill.width = rect.width + 30
        m.liveBadgeFill.height = rect.height + 12
        badgeHeight = m.liveBadgeFill.height
        infoLeft = m.liveBadgeFill.width + 18
    end if

    m.liveChannelName.text = chainLookupReturn(channel, "name", "")
    nameHeight = m.liveChannelName.boundingRect().height
    programName = chainLookupReturn(program, "Name", "")
    m.liveProgramName.visible = programName <> ""
    m.liveProgramName.text = programName
    infoHeight = nameHeight
    if programName <> "" then infoHeight += 3 + m.liveProgramName.boundingRect().height

    rowHeight = infoHeight
    if badgeHeight > rowHeight then rowHeight = badgeHeight
    m.liveBadgeFill.translation = [0, (rowHeight - badgeHeight) / 2]
    m.liveBadgeLabel.translation = [15, (rowHeight - badgeHeight) / 2 + 6]
    m.liveChannelName.translation = [infoLeft, (rowHeight - infoHeight) / 2]
    m.liveChannelName.width = 1500 - infoLeft
    m.liveProgramName.translation = [infoLeft, (rowHeight - infoHeight) / 2 + nameHeight + 3]
    m.liveProgramName.width = 1500 - infoLeft

    updateLiveTimeline()
end sub

' With a rewind window the bar runs from its start to the live point, the left label is the time
' of day being watched and the right one how far behind live it is. Otherwise it's the current
' program's span, or a clock and a LIVE tag without guide data.
sub updateLiveTimeline()
    program = m.top.liveProgram
    now = liveTvGuide.NowSeconds()
    hasProgram = isValid(program) and isValid(program.startSec) and program.endSec > program.startSec

    episodeLine = ""
    if hasProgram then episodeLine = liveTvGuide.EpisodeLine(program)
    m.liveEpisodeLine.text = episodeLine
    m.liveEpisodeLine.visible = episodeLine <> ""
    m.liveEpisodeLine.translation = [0, 40 - 6 - m.liveEpisodeLine.boundingRect().height]

    window = m.top.liveWindow
    if m.top.liveRewind and isValid(window) and isValid(window.edge)
        position = m.top.positionTime
        if m.top.scrubPosition >= 0 then position = m.top.scrubPosition
        behind = liveWindow.Behind(window, position)
        atLive = behind <= LIVE_AT_LIVE_SECONDS
        m.liveFill.visible = false
        m.liveStartLabel.text = liveTvGuide.ClockTime(now - Int(behind))
        m.liveEndLabel.text = atLive ? tr("LIVE") : "-" + secondsToHuman(Int(behind), false)
        m.jumpToLiveButton.iconColor = atLive ? "#F44336" : "#FFFFFF"
        return
    end if

    m.liveFill.visible = hasProgram
    if hasProgram
        m.liveFill.width = m.liveTrack.width * liveTvGuide.ProgressAt(program, now)
        m.liveStartLabel.text = liveTvGuide.ClockTime(program.startSec)
        m.liveEndLabel.text = liveTvGuide.ClockTime(program.endSec)
    else
        m.liveStartLabel.text = liveTvGuide.ClockTime(now)
        m.liveEndLabel.text = tr("LIVE")
    end if
end sub

sub buildSecondaryControls()
    if not isValid(m.secondaryControls) then return

    m.secondaryControls.removeChildrenIndex(m.secondaryControls.getChildCount(), 0)

    order = chainLookupReturn(m.global.session, `user.settings.\`${OSD_ORDER_SETTING}\``, invalid)
    hidden = chainLookupReturn(m.global.session, `user.settings.\`${OSD_HIDDEN_SETTING}\``, invalid)

    ' The remote's options key belongs to the system while a video plays, so chat has a button here
    if m.top.inParty
        m.secondaryControls.appendChild(buttonLayout.OsdButton("showWatchParty", "people_alt_rounded", "Watch party"))
        m.secondaryControls.appendChild(buttonLayout.OsdButton("showWatchPartyChat", "chat_bubble_outline", "Chat and reactions"))
    end if
    syncPlayManager = m.global.syncPlayManager
    if not m.top.inParty and isValid(syncPlayManager) and syncPlayManager.callFunc("isEnabled")
        m.secondaryControls.appendChild(buttonLayout.OsdButton("showSyncPlayMenu", "sync", "SyncPlay"))
    end if
    for each candidate in buttonLayout.Arrange(secondaryCandidates(), order, hidden)
        m.secondaryControls.appendChild(buttonLayout.OsdButton(candidate.nodeId, candidate.glyph, candidate.label))
    end for

    applyRecordMark()
    applyButtonStates()
    positionSecondaryControls()
end sub

' A previewPosition below zero means use the live playback position
function formatOSDTimeSlot(slotMode as string, previewPosition as float) as string
    if slotMode = "none" or slotMode = "" then return ""

    totalTime = m.top.positionTime + m.top.remainingPositionTime
    position = previewPosition >= 0 ? previewPosition : m.top.positionTime

    if slotMode = "elapsed" then return secondsToHuman(position, false)
    if slotMode = "endsAt" then return tr("Ends at") + " " + endingTimeAt(previewPosition, totalTime - position)
    if slotMode = "time" then return m.clock.callFunc("getFormattedTime", m.clock.callFunc("getCurrentTime"), true)
    if slotMode = "timeRemaining" then return "-" + secondsToHuman(totalTime - position, false)
    ' Both spellings are accepted because either can be the stored value
    if slotMode = "totalDuration" or slotMode = "totalTime" then return secondsToHuman(totalTime, false)
    return ""
end function

' A scrub moves the end with it, working from where it aims rather than where playback is
function endingTimeAt(previewPosition as float, remaining as float) as string
    if previewPosition < 0 then return m.top.videoEndingTime
    return m.clock.callFunc("getFormattedTime", m.clock.callFunc("getCurrentTime") + Int(remaining), true)
end function

' Every slot is assigned so that switching one to None clears whatever it was holding
sub renderOSDTimeSlots(previewPosition as float)
    for each slot in m.timeSlots
        slot.label.text = formatOSDTimeSlot(slot.mode, previewPosition)
    end for
end sub

' Observer callbacks receive an event argument when they declare a parameter, so this stays bare
sub updateOSDTime()
    renderOSDTimeSlots(-1)
end sub

sub onProgressPercentageChanged()
    ' The duration is only known once the stream has started, and a live one keeps growing
    if abs(osdDurationSeconds() - m.markedDuration) > 1 then drawChapterMarks()
    ' A scrub keeps the bar on where it is aiming until it lands
    if m.top.scrubPosition >= 0 then return
    drawBarAt(m.top.progressPercentage)
    updateOSDTime()
end sub

sub onScrubPositionChanged()
    if m.top.scrubPosition < 0
        drawBarAt(m.top.progressPercentage)
        updateOSDTime()
        return
    end if
    duration = osdDurationSeconds()
    fraction = 0
    if duration > 0 then fraction = m.top.scrubPosition / duration
    if m.top.liveRewind and isValid(m.top.liveWindow) then fraction = liveWindow.Progress(m.top.liveWindow, m.top.scrubPosition)
    drawBarAt(fraction)
    renderOSDTimeSlots(m.top.scrubPosition)
    if m.top.liveMode then updateLiveTimeline()
end sub

' The fill and the thumb, the thumb centered on the end of the fill
sub drawBarAt(fraction as float)
    m.progressBar.width = m.progressBarBackground.width * fraction
    m.progressIndicator.translation = [m.progressBarBackground.width * fraction - THUMB_SIZE / 2, 3 - THUMB_SIZE / 2]
end sub

function osdDurationSeconds() as float
    return m.top.positionTime + m.top.remainingPositionTime
end function

' A mark at the very start or past the end has nothing to mark, and two chapters starting
' together share one
sub drawChapterMarks()
    m.chapterMarks.removeChildrenIndex(m.chapterMarks.getChildCount(), 0)
    duration = osdDurationSeconds()
    m.markedDuration = duration
    if m.top.liveMode or duration <= 0 then return
    if m.global.session.user.settings["playback.showChapterMarkers"] <> true then return

    durationMs = duration * 1000
    drawn = {}
    for each startMs in m.top.chapterStarts
        if startMs <= 0 or startMs >= durationMs or drawn.DoesExist(startMs.toStr()) then continue for
        drawn[startMs.toStr()] = true
        mark = m.chapterMarks.createChild("Rectangle")
        mark.width = 3
        mark.height = 14.5
        mark.color = "#FFFFFFE6"
        mark.translation = [m.progressBarBackground.width * startMs / durationMs - 1.5, m.progressBarBackground.height / 2 - 7.25]
    end for
end sub

sub onPlaybackStateChanged()
    playing = LCase(m.top.playbackState) = "playing"
    m.videoPlayPause.glyph = playing ? "pause_rounded" : "play_arrow_rounded"
    m.videoPlayPause.label = playing ? tr("Pause") : tr("Play")
    showFocusLabel()
end sub

' The logo takes the top line when there is one, and the series name steps aside for it
sub layoutHeader()
    hasLogo = m.logo.visible
    m.itemTitle.text = m.top.itemTitleText
    m.itemTitle.visible = m.top.itemTitleText <> ""
    m.itemSecondary.text = m.top.itemSecondaryText
    m.itemSecondary.visible = not hasLogo and m.top.itemSecondaryText <> ""
    top = HEADER_Y
    if hasLogo then top = TITLE_UNDER_LOGO_Y
    m.videoInfo.translation = [HEADER_X, top]
end sub

' The logo keeps the box's height and only takes the width it needs, so it sits flush left with
' the line under it. One too wide for its share of the screen comes down to fit it.
sub onLogoLoadStatusChanged()
    status = LCase(m.logo.loadStatus)
    if status = "ready" and m.logo.bitmapHeight > 0
        height = LOGO_HEIGHT
        width = m.logo.bitmapWidth * height / m.logo.bitmapHeight
        if width > LOGO_MAX_WIDTH
            width = LOGO_MAX_WIDTH
            height = width * m.logo.bitmapHeight / m.logo.bitmapWidth
        end if
        m.logo.width = width
        m.logo.height = height
        m.logo.visible = true
        layoutHeader()
    else if status = "failed"
        m.logo.visible = false
        layoutHeader()
    end if
end sub

sub onLogoImageChanged()
    m.logo.visible = false
    m.logo.height = LOGO_HEIGHT
    m.logo.uri = m.top.logoImage
    layoutHeader()
end sub

sub setButtonInGroup(group as object, button as object, show as boolean, insertIndex as integer)
    if not isValid(group) or not isValid(button) then return

    isInGroup = isValid(button.getParent())
    if show
        if not isInGroup
            group.insertChild(button, insertIndex)
        end if
    else
        if isInGroup
            group.removeChild(button)
        end if
    end if
    positionSecondaryControls()
end sub

sub positionSecondaryControls()
    if not isValid(m.transportControls) or not isValid(m.secondaryControls) then return

    m.secondaryControls.translation = [buttonLayout.OsdSecondaryX(m.transportControls.getChildCount()), buttonLayout.OSD_ROW_Y]
end sub

function getControlGroup(groupName as string)
    if groupName = "secondary"
        return m.secondaryControls
    end if

    return m.transportControls
end function

sub clearAllButtonFocus()
    for each child in m.transportControls.getChildren(-1, 0)
        child.focus = false
    end for

    for each child in m.secondaryControls.getChildren(-1, 0)
        child.focus = false
    end for

    m.transportControls.setFocus(false)
    m.secondaryControls.setFocus(false)
    m.seekbarGroup.setFocus(false)
    m.focusLabel.visible = false
    m.progressIndicator.blendColor = m.accent
end sub

sub focusControlGroup(groupName as string, targetIndex as integer)
    buttonGroup = getControlGroup(groupName)
    if not isValid(buttonGroup) or buttonGroup.getChildCount() = 0 then return

    target = targetIndex
    if target < 0 or target >= buttonGroup.getChildCount() then target = 0

    clearAllButtonFocus()
    m.currentButtonGroup = groupName
    m.focusedButtonIndex = target

    buttonGroup.getChild(target).focus = true
    buttonGroup.setFocus(true)
    showFocusLabel()
end sub

sub showFocusLabel()
    if not isValid(m.focusLabel) then return
    if m.currentButtonGroup = "seekbar"
        m.focusLabel.visible = false
        return
    end if
    buttonGroup = getControlGroup(m.currentButtonGroup)
    button = buttonGroup.getChild(m.focusedButtonIndex)
    if not isValid(button) or button.label = ""
        m.focusLabel.visible = false
        return
    end if

    m.focusLabelText.width = 0
    m.focusLabelText.text = button.label
    textWidth = m.focusLabelText.boundingRect().width
    m.focusLabelText.width = textWidth
    width = textWidth + 34
    for each layer in m.focusLabelLayers
        layer.width = width
    end for

    center = buttonGroup.translation[0] + m.focusedButtonIndex * (buttonLayout.OSD_BUTTON_SIZE + buttonLayout.OSD_SPACING) + buttonLayout.OSD_BUTTON_SIZE / 2
    x = center - width / 2
    if x < 0 then x = 0
    if x > 1920 - width then x = 1920 - width
    m.focusLabel.translation = [x, buttonLayout.OSD_ROW_Y - FOCUS_LABEL_GAP - FOCUS_LABEL_HEIGHT]
    m.focusLabel.visible = true
end sub

' The remote leaves the controls for the skip button, and comes back to the seek bar
sub focusSkipButton()
    clearAllButtonFocus()
    m.currentButtonGroup = "seekbar"
    m.focusedButtonIndex = 0
    m.top.action = "focusskip"
end sub

sub focusOnSeekbar()
    clearAllButtonFocus()
    m.currentButtonGroup = "seekbar"
    m.focusedButtonIndex = 0
    m.seekbarGroup.setFocus(true)
    m.progressIndicator.blendColor = "#FFFFFF"
end sub

sub focusOnTransportControls(index = invalid)
    targetIndex = playPauseIndex()
    if isValid(index)
        targetIndex = index
    end if

    focusControlGroup("transport", targetIndex)
end sub

' Found rather than counted, since which transport buttons are in the row varies
function playPauseIndex() as integer
    for i = 0 to m.transportControls.getChildCount() - 1
        child = m.transportControls.getChild(i)
        if isValid(child) and LCase(child.id) = "videoplaypause" then return i
    end for

    return 0
end function

' A button can be named, so the one that opened a menu gets focus back when it closes. Otherwise
' the controls open on the seek bar, or on play when live TV has no bar.
sub resetFocusToDefaultButton()
    for i = 0 to m.secondaryControls.getChildCount() - 1
        if isStringEqual(m.secondaryControls.getChild(i).id, m.top.focusTarget)
            focusControlGroup("secondary", i)
            return
        end if
    end for
    for i = 0 to m.transportControls.getChildCount() - 1
        if isStringEqual(m.transportControls.getChild(i).id, m.top.focusTarget)
            focusControlGroup("transport", i)
            return
        end if
    end for

    if m.top.liveMode and not m.top.liveRewind
        focusOnTransportControls()
    else
        focusOnSeekbar()
    end if
end sub

sub onVisibleChanged()
    if m.top.visible
        resetFocusToDefaultButton()
        m.inactivityTimer.observeField("fire", "inactiveCheck")
        m.inactivityTimer.control = "start"
        return
    end if

    m.focusLabel.visible = false
    m.inactivityTimer.unobserveField("fire")
    m.inactivityTimer.control = "stop"
end sub

sub onFocusChanged()
    if m.top.hasfocus
        if m.currentButtonGroup = "secondary"
            m.secondaryControls.setFocus(true)
        else if m.currentButtonGroup = "transport"
            m.transportControls.setFocus(true)
        else
            m.seekbarGroup.setFocus(true)
        end if
    end if
end sub

' Hides the controls once the remote has been still for the timeout, unless a dialog is up or the
' timeout is zero, which the player sets while paused
sub inactiveCheck()
    if m.top.liveMode then updateLiveTimeline()
    if m.global.sceneManager.callFunc("isDialogOpen") then return
    if m.top.inactiveTimeout = 0 then return

    if m.deviceInfo.timeSinceLastKeypress() >= m.top.inactiveTimeout
        m.top.action = "hide"
    end if
end sub

sub onButtonSelected()
    ' OK on the bar lands a paused scrub and plays, or toggles playback when theres none
    if m.currentButtonGroup = "seekbar"
        m.top.action = "scrubcommit"
        return
    end if

    selectedButton = getControlGroup(m.currentButtonGroup).getChild(m.focusedButtonIndex)
    if not isValid(selectedButton) then return
    m.top.action = selectedButton.id
end sub

' Transport and the buttons after it make one row: Right runs off the end of the first group onto
' the second and stops at the last button, and Left stops at the first
sub moveAlongRow(direction as integer)
    buttonGroup = getControlGroup(m.currentButtonGroup)
    target = m.focusedButtonIndex + direction
    if target >= 0 and target < buttonGroup.getChildCount()
        focusControlGroup(m.currentButtonGroup, target)
    else if direction > 0 and m.currentButtonGroup = "transport" and m.secondaryControls.getChildCount() > 0
        focusControlGroup("secondary", 0)
    else if direction < 0 and m.currentButtonGroup = "secondary" and m.transportControls.getChildCount() > 0
        focusControlGroup("transport", m.transportControls.getChildCount() - 1)
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "OK"
        onButtonSelected()
        return true
    end if

    if key = "play"
        m.top.action = "videoplaypause"
        return true
    end if

    ' The remote's seek keys skip by the set lengths, and Fast Forward also skips a pre-roll or a
    ' segment when one is offered
    if key = "rewind" or key = "replay"
        m.top.action = "rewindkey"
        return true
    end if
    if key = "fastforward"
        m.top.action = "fastforwardkey"
        return true
    end if

    if key = "right" or key = "left"
        direction = 1
        if key = "left" then direction = -1
        if m.currentButtonGroup = "seekbar"
            m.top.action = `scrub,${direction}`
        else
            moveAlongRow(direction)
        end if
        return true
    end if

    if key = "down"
        if m.currentButtonGroup = "seekbar"
            ' Leaving the bar lands a paused scrub where it was aiming, still paused
            m.top.action = "scrubsettle"
            focusOnTransportControls()
        end if
        return true
    end if

    if key = "up"
        ' Up during live playback opens the channel carousel, over the controls or not
        if m.top.liveMode
            m.top.action = "showchannels"
            return true
        end if

        if m.currentButtonGroup <> "seekbar"
            focusOnSeekbar()
        else if m.top.skipButton <> ""
            ' The skip button sits just above the seek bar
            focusSkipButton()
        end if
        return true
    end if

    ' Back goes to the player first, which takes a skip prompt down before it hides the controls
    if key = "back"
        m.top.action = "backkey"
        return true
    end if

    ' All other keys hide the menu
    m.top.action = "hide"
    return true
end function

import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

const LOGO_RIGHT_PADDING = 30
const CONTROLS_ROW_X = 103
const CONTROLS_ROW_Y = 920
const CONTROLS_ITEM_SPACING = 20
const CONTROLS_GROUP_GAP = 40
const TRANSPORT_BTN_W = 120
const SECONDARY_BTN_PAD = 16

sub init()
    m.transportControls = m.top.findNode("transportControls")
    m.secondaryControls = m.top.findNode("secondaryControls")

    m.inactivityTimer = m.top.findNode("inactivityTimer")
    m.videoInfo = m.top.findNode("videoInfo")
    m.itemTitle = m.top.findNode("itemTitle")
    m.videoPlayPause = m.top.findNode("videoPlayPause")
    m.belowLeft = m.top.findNode("belowLeft")
    m.aboveRight = m.top.findNode("aboveRight")
    m.belowRight = m.top.findNode("belowRight")
    m.aboveLeft = m.top.findNode("aboveLeft")
    m.aboveCenter = m.top.findNode("aboveCenter")
    m.belowCenter = m.top.findNode("belowCenter")
    m.clock = m.top.findNode("clock")
    ' A slot showing the clock turns over with it, paused or not
    m.clock.findNode("clockTime").observeField("text", "updateOSDTime")
    m.progressBar = m.top.findNode("progressBar")
    m.progressBarBackground = m.top.findNode("progressBarBackground")
    m.progressIndicator = m.top.findNode("progressIndicator")
    m.seekbarGroup = m.top.findNode("seekbarGroup")
    m.nextItem = m.top.FindNode("nextItem")
    m.previousItem = m.top.FindNode("previousItem")
    m.itemBackButton = m.top.findNode("itemBack")
    m.itemNextButton = m.top.findNode("itemNext")
    m.liveHeader = m.top.findNode("liveHeader")
    m.liveBadgeFill = m.top.findNode("liveBadgeFill")
    m.liveBadgeLabel = m.top.findNode("liveBadgeLabel")
    m.liveChannelName = m.top.findNode("liveChannelName")
    m.liveProgramName = m.top.findNode("liveProgramName")
    m.liveTimeline = m.top.findNode("liveTimeline")
    m.liveEpisodeLine = m.top.findNode("liveEpisodeLine")
    m.liveTrack = m.top.findNode("liveTrack")
    m.liveFill = m.top.findNode("liveFill")
    m.liveStartLabel = m.top.findNode("liveStartLabel")
    m.liveEndLabel = m.top.findNode("liveEndLabel")
    liveTvGuide.SetFont(m.liveBadgeLabel, 24, true)
    liveTvGuide.SetFont(m.liveChannelName, 27, true)
    liveTvGuide.SetFont(m.liveProgramName, 21, false)
    liveTvGuide.SetFont(m.liveEpisodeLine, 21, false)
    liveTvGuide.SetFont(m.liveStartLabel, 18, false)
    liveTvGuide.SetFont(m.liveEndLabel, 18, false)

    m.top.observeField("visible", "onVisibleChanged")
    m.top.observeField("hasFocus", "onFocusChanged")
    m.top.observeField("progressPercentage", "onProgressPercentageChanged")
    m.top.observeField("playbackState", "onPlaybackStateChanged")
    ' Ends-at is recalculated on a clock timer, so it moves while paused when position doesn't
    m.top.observeField("videoEndingTime", "updateOSDTime")

    m.top.observeField("itemTitleText", "onItemTitleTextChanged")
    m.top.observeField("itemSubtitleText", "onItemSubtitleTextChanged")
    m.top.observeField("seasonNumber", "onSeasonNumberChanged")
    m.top.observeField("episodeNumber", "onEpisodeNumberChanged")
    m.top.observeField("episodeNumberEnd", "onEpisodeNumberEndChanged")
    m.top.observeField("logoImage", "onLogoImageChanged")

    m.top.observeField("previousItemIcon", "onPreviousItemIconChanged")
    m.top.observeField("previousItemTitleText", "onPreviousItemTitleTextChanged")
    m.top.observeField("nextItemIcon", "onNextItemIconChanged")
    m.top.observeField("nextItemTitleText", "onNextItemTitleTextChanged")

    m.focusedButtonIndex = 0
    m.currentButtonGroup = "seekbar"
    m.logoMoved = false

    m.seekbarGroup.setFocus(true)
    m.progressIndicator.blendColor = themeChrome.Token("rangeThumb", "0xFFFFFFFF")
    m.deviceInfo = CreateObject("roDeviceInfo")

    m.progressBarBackground.color = ColorPalette.BLACK77
    m.progressBar.color = themeChrome.Token("rangeProgress", "#00a4dc")

    transportButtons = m.transportControls.getChildren(-1, 0)
    for each button in transportButtons
        button.background = ColorPalette.DARKGREY
        button.focusBackground = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    end for

    if isValid(m.itemBackButton)
        setButtonInGroup(m.transportControls, m.itemBackButton, true, 0)
    end if

    if isValid(m.itemNextButton)
        setButtonInGroup(m.transportControls, m.itemNextButton, isValidAndNotEmpty(m.nextItem.text), m.transportControls.getChildCount())
    end if

    buildSecondaryControls()
end sub

' A button whose media has nothing to show is left out here rather than built and hidden.
' The node id stays the action the player already answers to, so the catalogue id is only
' ever used for arranging.
function secondaryCandidates() as object
    if m.top.liveMode then return liveCandidates()

    candidates = [
        { id: "speed", nodeId: "showSpeedMenu", icon: "pkg:/images/icons/settings.png" }
    ]

    if m.top.hasChapters
        candidates.push({ id: "chapters", nodeId: "chapterList", icon: "pkg:/images/icons/osd/chapters.png" })
    end if

    if m.top.hasSubtitles
        candidates.push({ id: "subtitles", nodeId: "showSubtitleMenu", icon: "pkg:/images/icons/osd/subtitles.png" })
    end if

    candidates.push({ id: "audio", nodeId: "showAudioMenu", icon: "pkg:/images/icons/osd/audio.png" })
    candidates.push({ id: "info", nodeId: "showVideoInfoPopup", icon: "pkg:/images/icons/osd/info.png" })

    return candidates
end function

' The live row: the channel carousel and the guide lead, with nothing to seek or step through
function liveCandidates() as object
    candidates = [
        { id: "channels", nodeId: "showChannels", icon: "pkg:/images/icons/osd/channels.png" },
        { id: "guide", nodeId: "showGuide", icon: "pkg:/images/icons/osd/guide.png" }
    ]
    if m.top.hasAudioChoice
        candidates.push({ id: "audio", nodeId: "showAudioMenu", icon: "pkg:/images/icons/osd/audio.png" })
    end if
    if m.top.hasSubtitles
        candidates.push({ id: "subtitles", nodeId: "showSubtitleMenu", icon: "pkg:/images/icons/osd/subtitles.png" })
    end if
    candidates.push({ id: "info", nodeId: "showVideoInfoPopup", icon: "pkg:/images/icons/osd/info.png" })
    return candidates
end function

sub applyLiveMode()
    live = m.top.liveMode
    m.videoInfo.visible = not live
    m.liveHeader.visible = live
    m.liveTimeline.visible = live
    for each node in [m.seekbarGroup, m.progressIndicator, m.aboveLeft, m.aboveCenter, m.aboveRight, m.belowLeft, m.belowCenter, m.belowRight]
        node.visible = not live
    end for
    if live
        for each id in ["itemBack", "rewind", "fastForward", "itemNext"]
            setButtonInGroup(m.transportControls, m.top.findNode(id), false, 0)
        end for
    end if
    buildSecondaryControls()
    renderLive()
end sub

' The channel number in a badge, then the channel's name over the program's
sub renderLive()
    if not m.top.liveMode then return
    channel = m.top.liveChannel
    program = m.top.liveProgram

    number = chainLookupReturn(channel, "number", "")
    m.liveBadgeFill.visible = number <> ""
    m.liveBadgeLabel.visible = number <> ""
    infoLeft = 0
    badgeHeight = 0
    if number <> ""
        m.liveBadgeLabel.text = number
        rect = m.liveBadgeLabel.boundingRect()
        m.liveBadgeFill.width = rect.width + 30
        m.liveBadgeFill.height = rect.height + 12
        badgeHeight = m.liveBadgeFill.height
        infoLeft = m.liveBadgeFill.width + 18
    end if

    m.liveChannelName.text = chainLookupReturn(channel, "name", "")
    nameHeight = m.liveChannelName.boundingRect().height
    programName = chainLookupReturn(program, "Name", "")
    m.liveProgramName.visible = programName <> ""
    m.liveProgramName.text = programName
    infoHeight = nameHeight
    if programName <> "" then infoHeight += 3 + m.liveProgramName.boundingRect().height

    rowHeight = infoHeight
    if badgeHeight > rowHeight then rowHeight = badgeHeight
    m.liveBadgeFill.translation = [0, (rowHeight - badgeHeight) / 2]
    m.liveBadgeLabel.translation = [15, (rowHeight - badgeHeight) / 2 + 6]
    m.liveChannelName.translation = [infoLeft, (rowHeight - infoHeight) / 2]
    m.liveChannelName.width = 1500 - infoLeft
    m.liveProgramName.translation = [infoLeft, (rowHeight - infoHeight) / 2 + nameHeight + 3]
    m.liveProgramName.width = 1500 - infoLeft

    updateLiveTimeline()
end sub

' The live timeline is the current program's span, not a seek bar. Without guide data it falls
' back to a clock and a LIVE tag.
sub updateLiveTimeline()
    program = m.top.liveProgram
    now = liveTvGuide.NowSeconds()
    hasProgram = isValid(program) and isValid(program.startSec) and program.endSec > program.startSec

    episodeLine = ""
    if hasProgram then episodeLine = liveTvGuide.EpisodeLine(program)
    m.liveEpisodeLine.text = episodeLine
    m.liveEpisodeLine.visible = episodeLine <> ""
    m.liveEpisodeLine.translation = [0, 40 - 6 - m.liveEpisodeLine.boundingRect().height]

    m.liveFill.visible = hasProgram
    if hasProgram
        m.liveFill.width = m.liveTrack.width * liveTvGuide.ProgressAt(program, now)
        m.liveStartLabel.text = liveTvGuide.ClockTime(program.startSec)
        m.liveEndLabel.text = liveTvGuide.ClockTime(program.endSec)
    else
        m.liveStartLabel.text = liveTvGuide.ClockTime(now)
        m.liveEndLabel.text = tr("LIVE")
    end if
end sub

sub buildSecondaryControls()
    if not isValid(m.secondaryControls) then return

    m.secondaryControls.removeChildrenIndex(m.secondaryControls.getChildCount(), 0)

    order = chainLookupReturn(m.global.session, `user.settings.\`${OSD_ORDER_SETTING}\``, invalid)
    hidden = chainLookupReturn(m.global.session, `user.settings.\`${OSD_HIDDEN_SETTING}\``, invalid)
    accent = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    for each candidate in buttonLayout.Arrange(secondaryCandidates(), order, hidden)
        button = createObject("roSGNode", "IconButton")
        button.id = candidate.nodeId
        button.icon = candidate.icon
        button.padding = SECONDARY_BTN_PAD
        button.height = 65
        button.width = 100
        button.background = ColorPalette.DARKGREY
        button.focusBackground = accent
        m.secondaryControls.appendChild(button)
    end for

    positionSecondaryControls()
end sub

' A previewPosition below zero means use the live playback position
function formatOSDTimeSlot(slotKey as string, previewPosition as float) as string
    slotMode = m.global.session.user.settings[slotKey] ?? "none"
    if slotMode = "none" or slotMode = "" then return ""

    totalTime = m.top.positionTime + m.top.remainingPositionTime
    position = previewPosition >= 0 ? previewPosition : m.top.positionTime

    if slotMode = "elapsed" then return secondsToHuman(position, true)
    if slotMode = "endsAt" then return tr("Ends at") + " " + endingTimeAt(previewPosition, totalTime - position)
    if slotMode = "time" then return m.clock.callFunc("getFormattedTime", m.clock.callFunc("getCurrentTime"), true)
    if slotMode = "timeRemaining" then return "-" + secondsToHuman(totalTime - position, true)
    ' Both spellings are accepted because either can be the stored value
    if slotMode = "totalDuration" or slotMode = "totalTime" then return secondsToHuman(totalTime, true)
    return ""
end function

' A scrub moves the end with it, working from where it aims rather than where playback is
function endingTimeAt(previewPosition as float, remaining as float) as string
    if previewPosition < 0 then return m.top.videoEndingTime
    return m.clock.callFunc("getFormattedTime", m.clock.callFunc("getCurrentTime") + Int(remaining), true)
end function

' Every slot is assigned so that switching one to None clears whatever it was holding
sub renderOSDTimeSlots(previewPosition as float)
    m.aboveLeft.text = formatOSDTimeSlot("playback.timeAboveLeft", previewPosition)
    m.aboveRight.text = formatOSDTimeSlot("playback.timeAboveRight", previewPosition)
    m.belowLeft.text = formatOSDTimeSlot("playback.timeBelowLeft", previewPosition)
    m.belowRight.text = formatOSDTimeSlot("playback.timeBelowRight", previewPosition)
    m.aboveCenter.text = formatOSDTimeSlot("playback.timeAboveCenter", previewPosition)
    m.belowCenter.text = formatOSDTimeSlot("playback.timeBelowCenter", previewPosition)
end sub

' Observer callbacks receive an event argument when they declare a parameter, so this stays bare
sub updateOSDTime()
    renderOSDTimeSlots(-1)
end sub

' onProgressPercentageChanged: Handler for changes to m.top.progressPercentage param
'
sub onProgressPercentageChanged()
    ' A scrub keeps the bar on where it is aiming until it lands
    if m.top.scrubPosition >= 0 then return
    drawBarAt(m.top.progressPercentage)
    updateOSDTime()
end sub

sub onScrubPositionChanged()
    if m.top.scrubPosition < 0
        drawBarAt(m.top.progressPercentage)
        updateOSDTime()
        return
    end if
    duration = osdDurationSeconds()
    fraction = 0
    if duration > 0 then fraction = m.top.scrubPosition / duration
    drawBarAt(fraction)
    renderOSDTimeSlots(m.top.scrubPosition)
end sub

' The fill and the thumb, the thumb centered on the end of the fill
sub drawBarAt(fraction as float)
    m.progressBar.width = m.progressBarBackground.width * fraction
    m.progressIndicator.translation = [103 + m.progressBarBackground.width * fraction - 10, 812]
end sub

function osdDurationSeconds() as float
    return m.top.positionTime + m.top.remainingPositionTime
end function


' onPlaybackStateChanged: Handler for changes to m.top.playbackState param
'
sub onPlaybackStateChanged()
    if LCase(m.top.playbackState) = "playing"
        m.videoPlayPause.icon = "pkg:/images/icons/osd/pause.png"
        return
    end if

    m.videoPlayPause.icon = "pkg:/images/icons/osd/play.png"
end sub

' onItemTitleTextChanged: Handler for changes to m.top.itemTitleText param.
'
sub onItemTitleTextChanged()
    m.itemTitle.text = m.top.itemTitleText
end sub

sub onItemSubtitleTextChanged()
    itemSeason = m.top.findNode("itemSeason")
    itemSeason.font.size = 32
    itemSeason.text = m.top.itemSubtitleText
end sub

' onSeasonNumberChanged: Handler for changes to m.top.seasonNumber param.
'
sub onSeasonNumberChanged()
    m.top.unobserveField("seasonNumber")
    itemSeason = m.top.findNode("itemSeason")
    itemSeason.font.size = 32
    itemSeason.text = `S${m.top.seasonNumber}`
end sub

' onEpisodeNumberChanged: Handler for changes to m.top.episodeNumber param.
'
sub onEpisodeNumberChanged()
    m.top.unobserveField("episodeNumber")
    itemEpisode = m.top.findNode("itemEpisode")
    itemEpisode.font.size = 32
    itemEpisode.text = `E${m.top.episodeNumber}`
end sub

' onEpisodeNumberEndChanged: Handler for changes to m.top.episodeNumberEnd param.
'
sub onEpisodeNumberEndChanged()
    m.top.unobserveField("episodeNumberEnd")
    itemEpisodeEnd = m.top.findNode("itemEpisodeEnd")
    itemEpisodeEnd.font.size = 32
    itemEpisodeEnd.text = `-${m.top.episodeNumberEnd}`
end sub

' onLogoLoadStatusChanged: Handler for changes to logo image's status.
'
' @param {dynamic} event - field change event
sub onLogoLoadStatusChanged(event)
    if LCase(event.GetData()) = "ready"
        logoImage = event.getRoSGNode()
        logoImage.unobserveField("loadStatus")

        ' Move video info below the logo based on the logo height if not already moved
        if not m.logoMoved
            m.videoInfo.translation = `[${m.videoInfo.translation[0]}, ${m.videoInfo.translation[1] + logoImage.bitmapHeight + LOGO_RIGHT_PADDING}]`
            m.logoMoved = true
        end if
    end if
end sub

' onLogoImageChanged: Handler for changes to m.top.logoImage param.
'
sub onLogoImageChanged()
    if isValidAndNotEmpty(m.top.logoImage)
        logoImage = createObject("roSGNode", "Poster")
        logoImage.Id = "logoImage"
        logoImage.observeField("loadStatus", "onLogoLoadStatusChanged")
        logoImage.uri = m.top.logoImage
        logoImage.translation = [103, 61]
        m.top.appendChild(logoImage)
    end if
end sub

' onPreviousItemIconChanged: Handler for changes to m.top.previousItemIcon param.
'
sub onPreviousItemIconChanged()
    m.previousItem.icon = m.top.previousItemIcon
end sub

' onPreviousItemTitleTextChanged: Handler for changes to m.top.previousItemTitleText param.
'
sub onPreviousItemTitleTextChanged()
    m.previousItem.text = m.top.previousItemTitleText

    if isValid(m.itemBackButton) and not m.top.liveMode
        setButtonInGroup(m.transportControls, m.itemBackButton, true, 0)
        positionSecondaryControls()
    end if
end sub

' onNextItemIconChanged: Handler for changes to m.top.nextItemIcon param.
'
sub onNextItemIconChanged()
    m.nextItem.icon = m.top.nextItemIcon
end sub

' onNextItemTitleTextChanged: Handler for changes to m.top.nextItemTitleText param.
'
sub onNextItemTitleTextChanged()
    m.nextItem.text = m.top.nextItemTitleText

    if isValid(m.itemNextButton) and not m.top.liveMode
        setButtonInGroup(m.transportControls, m.itemNextButton, isValidAndNotEmpty(m.nextItem.text), m.transportControls.getChildCount())
        positionSecondaryControls()
    end if
end sub

sub setButtonInGroup(group as object, button as object, show as boolean, insertIndex as integer)
    if not isValid(group) or not isValid(button) then return

    isInGroup = isValid(button.getParent())
    if show
        if not isInGroup
            group.insertChild(button, insertIndex)
        end if
    else
        if isInGroup
            group.removeChild(button)
        end if
    end if
end sub

sub positionSecondaryControls()
    if not isValid(m.transportControls) or not isValid(m.secondaryControls) then return

    count = m.transportControls.getChildCount()
    if count = 0
        totalWidth = 0
    else
        totalWidth = count * TRANSPORT_BTN_W + (count - 1) * CONTROLS_ITEM_SPACING
    end if

    m.secondaryControls.translation = [CONTROLS_ROW_X + totalWidth + CONTROLS_GROUP_GAP, CONTROLS_ROW_Y]
end sub

function isButtonNavigable(button) as boolean
    if not isValid(button) then return false
    if not isValid(button.focus) then return false
    if isValid(button.visible) and button.visible = false then return false
    return true
end function

function getNavigableIndexFrom(buttonGroup as object, startIndex as integer, direction as integer) as integer
    if direction = 0 or not isValid(buttonGroup) then return -1

    childCount = buttonGroup.getChildCount()
    i = startIndex

    while i >= 0 and i < childCount
        button = buttonGroup.getChild(i)
        if isButtonNavigable(button)
            return i
        end if

        i = i + direction
    end while

    return -1
end function

function getFirstNavigableIndex(buttonGroup as object) as integer
    return getNavigableIndexFrom(buttonGroup, 0, 1)
end function

function getLastNavigableIndex(buttonGroup as object) as integer
    if not isValid(buttonGroup) then return -1
    return getNavigableIndexFrom(buttonGroup, buttonGroup.getChildCount() - 1, -1)
end function

function getControlGroup(groupName as string)
    if groupName = "secondary"
        return m.secondaryControls
    end if

    return m.transportControls
end function

sub clearAllButtonFocus()
    for each child in m.transportControls.getChildren(-1, 0)
        if isValid(child.focus)
            child.focus = false
        end if
    end for

    for each child in m.secondaryControls.getChildren(-1, 0)
        if isValid(child.focus)
            child.focus = false
        end if
    end for

    m.transportControls.setFocus(false)
    m.secondaryControls.setFocus(false)
    m.seekbarGroup.setFocus(false)
end sub

sub focusControlGroup(groupName as string, targetIndex as integer, fallbackDirection as integer)
    buttonGroup = getControlGroup(groupName)
    if not isValid(buttonGroup) then return

    target = targetIndex
    if target < 0 or target >= buttonGroup.getChildCount()
        target = -1
    end if

    if target = -1 or not isButtonNavigable(buttonGroup.getChild(target))
        if fallbackDirection < 0
            target = getLastNavigableIndex(buttonGroup)
        else
            target = getFirstNavigableIndex(buttonGroup)
        end if
    end if

    if target = -1 then return

    clearAllButtonFocus()
    m.currentButtonGroup = groupName
    m.focusedButtonIndex = target

    focusedButton = buttonGroup.getChild(target)
    focusedButton.focus = true
    buttonGroup.setFocus(true)

    if groupName = "transport"
        checkDisplaySiblingItem(focusedButton.id)
    else
        checkDisplaySiblingItem("")
    end if
end sub

sub focusOnSeekbar()
    clearAllButtonFocus()
    m.currentButtonGroup = "seekbar"
    m.focusedButtonIndex = 0
    m.seekbarGroup.setFocus(true)
end sub

sub focusOnTransportControls(index = invalid)
    targetIndex = playPauseIndex()
    if isValid(index)
        targetIndex = index
    end if

    focusControlGroup("transport", targetIndex, 1)
end sub

' Found rather than counted, since which transport buttons are in the row varies
function playPauseIndex() as integer
    for i = 0 to m.transportControls.getChildCount() - 1
        child = m.transportControls.getChild(i)
        if isValid(child) and LCase(child.id) = "videoplaypause" then return i
    end for

    return 0
end function

sub focusOnSecondaryControls(index = invalid)
    targetIndex = getFirstNavigableIndex(m.secondaryControls)
    if isValid(index)
        targetIndex = index
    end if

    focusControlGroup("secondary", targetIndex, 1)
end sub

sub resetFocusToDefaultButton()
    ' Live TV has no seek bar to start on
    if m.top.liveMode
        if m.top.focusTarget = "secondary" then focusOnSecondaryControls() else focusOnTransportControls()
        return
    end if

    if m.top.focusTarget = "video" or m.top.focusTarget = "transport"
        focusOnTransportControls()
    else if m.top.focusTarget = "secondary"
        focusOnSecondaryControls()
    else
        focusOnSeekbar()
    end if
end sub

' onVisibleChanged: Handler for changes to the visibility of this menu.
'
sub onVisibleChanged()
    if m.top.visible
        resetFocusToDefaultButton()
        m.inactivityTimer.observeField("fire", "inactiveCheck")
        m.inactivityTimer.control = "start"
        return
    end if

    m.inactivityTimer.unobserveField("fire")
    m.inactivityTimer.control = "stop"
end sub

' onFocusChanged: Handler for changes to the focus of this menu.
'
sub onFocusChanged()
    if m.top.hasfocus
        if m.currentButtonGroup = "secondary"
            m.secondaryControls.setFocus(true)
        else if m.currentButtonGroup = "transport"
            m.transportControls.setFocus(true)
        else
            m.seekbarGroup.setFocus(true)
        end if
    end if
end sub

' inactiveCheck: Checks if the time since last keypress is greater than or equal to the allowed inactive time of the menu.
'
sub inactiveCheck()
    if m.top.liveMode then updateLiveTimeline()

    ' If user is currently seeing a dialog box, ignore inactive check
    if m.global.sceneManager.callFunc("isDialogOpen")
        return
    end if

    ' If inactiveTimeout is 0, keep OSD visible (don't auto-hide)
    if m.top.inactiveTimeout = 0
        return
    end if

    if m.deviceInfo.timeSinceLastKeypress() >= m.top.inactiveTimeout
        checkDisplaySiblingItem("")
        m.top.action = "hide"
    end if
end sub

' onButtonSelected: Handler for selection of buttons from the menu.
'
sub onButtonSelected()
    ' OK on the bar lands a paused scrub and plays, or toggles playback when theres none
    if m.currentButtonGroup = "seekbar"
        m.top.action = "scrubcommit"
        return
    end if

    if m.currentButtonGroup = "secondary"
        selectedButton = m.secondaryControls.getChild(m.focusedButtonIndex)
    else if m.currentButtonGroup = "transport"
        selectedButton = m.transportControls.getChild(m.focusedButtonIndex)
    else
        return
    end if

    if not isValid(selectedButton) or not isValid(selectedButton.id)
        return
    end if

    if LCase(selectedButton.id) = "chapterlist"
        m.top.showChapterList = not m.top.showChapterList
    end if

    checkDisplaySiblingItem("")

    m.top.action = selectedButton.id
end sub

' checkDisplaySiblingItem: Determine visible state for both previous and next item popups
'
sub checkDisplaySiblingItem(selectedButtonID as string)
    if not isValidAndNotEmpty(selectedButtonID) then selectedButtonID = ""

    selectedButtonID = LCase(selectedButtonID)

    showNextItem = false

    if selectedButtonID = "itemnext"
        showNextItem = true
    end if

    if not isValidAndNotEmpty(m.nextItem.text)
        showNextItem = false
    end if

    m.nextItem.visible = showNextItem

    showPreviousItem = false

    if selectedButtonID = "itemback"
        showPreviousItem = true
    end if

    if not isValidAndNotEmpty(m.previousItem.text)
        showPreviousItem = false
    end if

    m.previousItem.visible = showPreviousItem

end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "OK"
        onButtonSelected()
        return true
    end if

    if key = "play"
        checkDisplaySiblingItem("")
        m.top.action = "videoplaypause"
        return true
    end if

    if key = "right"
        if m.currentButtonGroup = "seekbar"
            m.top.action = "scrub,1"
            return true
        end if

        if m.currentButtonGroup = "transport" or m.currentButtonGroup = "secondary"
            buttonGroup = getControlGroup(m.currentButtonGroup)
            nextIndex = getNavigableIndexFrom(buttonGroup, m.focusedButtonIndex + 1, 1)

            if nextIndex <> -1
                focusControlGroup(m.currentButtonGroup, nextIndex, 1)
            else if m.currentButtonGroup = "transport"
                focusOnSecondaryControls()
            else
                firstTransportIndex = getFirstNavigableIndex(m.transportControls)
                focusOnTransportControls(firstTransportIndex)
            end if
        end if

        return true
    end if

    if key = "left"
        if m.currentButtonGroup = "seekbar"
            m.top.action = "scrub,-1"
            return true
        end if

        if m.currentButtonGroup = "transport" or m.currentButtonGroup = "secondary"
            buttonGroup = getControlGroup(m.currentButtonGroup)
            previousIndex = getNavigableIndexFrom(buttonGroup, m.focusedButtonIndex - 1, -1)

            if previousIndex <> -1
                focusControlGroup(m.currentButtonGroup, previousIndex, -1)
            else if m.currentButtonGroup = "secondary"
                lastTransportIndex = getLastNavigableIndex(m.transportControls)
                focusOnTransportControls(lastTransportIndex)
            end if
        end if

        return true
    end if

    if key = "down"
        if m.currentButtonGroup = "seekbar"
            ' Leaving the bar lands a paused scrub where it was aiming, still paused
            m.top.action = "scrubsettle"
            focusOnTransportControls()
        else if m.currentButtonGroup = "transport"
            checkDisplaySiblingItem("")
            m.top.action = "hide"
        else if m.currentButtonGroup = "secondary"
            checkDisplaySiblingItem("")
            m.top.action = "hide"
        end if

        return true
    end if

    if key = "up"
        ' Up during live playback opens the channel carousel, over the controls or not
        if m.top.liveMode
            checkDisplaySiblingItem("")
            m.top.action = "showchannels"
            return true
        end if

        if m.currentButtonGroup = "secondary"
            focusOnSeekbar()

        else if m.currentButtonGroup = "transport"
            focusOnSeekbar()
        end if

        return true
    end if

    ' All other keys hide the menu
    checkDisplaySiblingItem("")
    m.top.action = "hide"
    return true
end function

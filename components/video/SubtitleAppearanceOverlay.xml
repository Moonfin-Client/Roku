<?xml version="1.0" encoding="utf-8"?>
<component name="SubtitleAppearanceOverlay" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000F2" />
    <Group id="panel">
      <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" width="700" blendColor="#1E1E1EFA" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="700" blendColor="#FFFFFF26" />
      <Label id="title" color="#FFFFFF" horizAlign="center" width="600" translation="[50, 50]" />
      <Group id="viewport">
        <Group id="rows" />
      </Group>
      <Group id="close">
        <Poster id="closeFill" uri="pkg:/images/details/surface8.9.png" blendColor="#FFFFFF1A" />
        <Label id="closeLabel" horizAlign="center" vertAlign="center" />
      </Group>
    </Group>
  </children>
  <interface>
    <!-- Set while HDR plays, so a separate HDR style is the one edited -->
    <field id="isHdr" type="boolean" value="false" />
    <field id="changed" type="integer" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

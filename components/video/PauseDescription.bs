const OVERVIEW_PITCH = 42

' The title and overview of what's paused, over a dark wash, shown while the controls are away.
' The settings preview draws this same component.
sub init()
    m.title = m.top.findNode("title")
    m.titleShadow = m.top.findNode("titleShadow")
    m.overview = m.top.findNode("overview")
    m.overviewShadow = m.top.findNode("overviewShadow")
    spacing = OVERVIEW_PITCH - m.top.findNode("overviewLine").boundingRect().height
    m.overview.lineSpacing = spacing
    m.overviewShadow.lineSpacing = spacing
    paused = UCase(tr("Paused"))
    m.top.findNode("paused").text = paused
    m.top.findNode("pausedShadow").text = paused
end sub

sub onTextChanged()
    m.title.text = m.top.title
    m.titleShadow.text = m.top.title
    m.overview.text = m.top.overview
    m.overviewShadow.text = m.top.overview
end sub

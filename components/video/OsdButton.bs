import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/settingsGlyphs.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.ring = m.top.findNode("ring")
    m.face = m.top.findNode("face")
    m.glyphFont = CreateObject("roSGNode", "Font")
    m.glyphFont.uri = settingsGlyphs.FONT_URI
    m.glyphFont.size = 42
end sub

sub render()
    m.face.color = m.top.iconColor
    if m.top.text <> ""
        playbackOverlay.SetFont(m.face, 27, false)
        m.face.text = m.top.text
        return
    end if
    m.face.font = m.glyphFont
    m.face.text = settingsGlyphs.Char(m.top.glyph)
end sub

sub onFocusChanged()
    m.fill.visible = m.top.focus
    m.ring.visible = m.top.focus
end sub

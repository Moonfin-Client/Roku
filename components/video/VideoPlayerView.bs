import "pkg:/components/anime/animeMarkerWatch.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/MediaSegmentAction.bs"
import "pkg:/source/enums/MediaSegmentType.bs"
import "pkg:/source/enums/PlaybackMethod.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/TimerControl.bs"
import "pkg:/source/enums/VideoControl.bs"
import "pkg:/source/utils/blockedContent.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/diagnostics.bs"
import "pkg:/source/utils/embyFeatures.bs"
import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/liveTvLastChannel.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"

const REPLAY_RETRIES = 3

' The other clients pin these overlays 24 in from the right and 120 up from the
' bottom, scaled by 1.45 onto our 1920x1080
const OVERLAY_EDGE = 35
const OVERLAY_BOTTOM = 174
const NEXT_UP_TICK_MS = 100
const NEXT_UP_PLAY = 0
const NEXT_UP_DISMISS = 1

sub init()
    m.top.observeField("availableAudioTracks", "onAvailableAudioTracksChanged")

    ' Carries on through the rest of the queue, the way it does in the other clients
    m.subtitleOffset = m.global.queueManager.callFunc("getSubtitleOffset")

    m.liveChannel = invalid
    m.lineup = []
    m.carouselPrograms = {}
    m.carousel = invalid
    m.channelSwitch = invalid
    m.suppressStopReport = false
    m.selectionRevision = 0
    m.liveTasks = []
    m.top.findNode("liveProgramTimer").observeField("fire", "refreshLiveProgram")
    m.top.findNode("prewarmTimer").observeField("fire", "prewarmCarousel")
    m.top.findNode("switchTimer").observeField("fire", "onSwitchTimeout")

    activeNav = getActiveNav(m.top.getScene())
    if isValid(activeNav) then activeNav.visible = false
    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    m.top.id = currentItem.id

    m.top.seekMode = "accurate"

    preferredSubtitle = m.global.queueManager.callFunc("getPreferredSubtitleTrack")
    m.top.SelectedSubtitle = isChainValid(preferredSubtitle, "StreamIndex") ? preferredSubtitle.StreamIndex : SubtitleSelection.NOTSET
    m.originalClosedCaptionState = invalid

    ' Load meta data
    m.LoadMetaDataTask = CreateObject("roSGNode", "LoadVideoContentTask")
    m.LoadMetaDataTask.selectedSubtitleIndex = m.top.SelectedSubtitle
    m.LoadMetaDataTask.itemId = currentItem.id
    m.LoadMetaDataTask.itemType = currentItem.type
    m.LoadMetaDataTask.selectedAudioStreamIndex = currentItem.selectedAudioStreamIndex

    m.itemServerData = getServerInfoFromItem(currentItem)
    if isValid(m.itemServerData)
        m.LoadMetaDataTask.serverUrl = m.itemServerData.serverUrl
        m.LoadMetaDataTask.serverUserId = m.itemServerData.userId
        m.LoadMetaDataTask.serverAuthToken = m.itemServerData.authToken
    else
        m.itemServerData = invalid
    end if

    m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN

    m.PreloadTrickplayImagesTask = CreateObject("roSGNode", "PreloadTrickplayImagesTask")
    m.PreloadTrickplayImagesTask.observeField("loaded", "onSheetsLoaded")
    m.PreloadTrickplayImagesTask.observeField("state", "onSheetTaskState")
    m.sheetState = {}
    m.sheetQueue = []
    m.scrubHold = { active: false, wasPlaying: false, target: invalid }
    m.pendingSeek = invalid
    m.pendingPreview = invalid
    m.previewSheet = -1
    m.seekPreview = m.top.findNode("seekPreview")
    m.seekPreviewFrame = m.top.findNode("seekPreviewFrame")
    m.seekPreviewTime = m.top.findNode("seekPreviewTime")
    playbackOverlay.SetFont(m.seekPreviewTime, 20, true)
    m.seekSettleTimer = m.top.findNode("seekSettleTimer")
    m.seekSettleTimer.observeField("fire", "onSeekSettled")

    ' The loading animation stands in for the bars the device would draw, and for the app's
    ' spinner that was up while this screen opened
    m.top.retrievingBarVisibilityAuto = false
    m.top.retrievingBar.visible = false
    m.top.bufferingBarVisibilityAuto = false
    m.top.bufferingBar.visible = false
    m.loadingLayer = m.top.findNode("loadingLayer")
    m.loadingLayer.label = tr("Loading Stream...")
    m.streamLoading = true
    m.seekClock = CreateObject("roTimespan")
    m.seekNoted = false
    m.seekGraceTimer = m.top.findNode("seekGraceTimer")
    m.seekGraceTimer.observeField("fire", "updateLoadingLayer")
    m.top.observeField("seek", "noteSeek")
    m.LoadMetaDataTask.observeField("state", "onLoadTaskState")
    stopLoadingSpinner()
    updateLoadingLayer()

    m.canUseFastReplace = false
    m.positionTranslation = m.top.trickPlayBar.getChild(3)
    m.positionText = m.top.trickPlayBar.getChild(8)
    m.top.trickplaybar.observeField("visible", "onTrickPlayBarVisibleChange")
    m.positionText.observeField("text", "onTrickPlayBarTextChange")

    m.chapterOverlay = invalid
    m.osd = m.top.findNode("osd")
    m.pauseOverlay = m.top.findNode("pauseOverlay")
    m.osd.observeField("action", "onOSDAction")
    m.clock = m.osd.findNode("clock")
    currentTimeTimer = m.clock.findNode("currentTimeTimer")
    currentTimeTimer.observeField("fire", "setVideoEndingTime")

    m.playbackTimer = m.top.findNode("playbackTimer")
    m.bufferCheckTimer = m.top.findNode("bufferCheckTimer")
    m.startDelayTimer = m.top.findNode("startDelayTimer")
    m.startDelayTimer.observeField("fire", "onStartDelayElapsed")
    m.top.observeField("state", "onState")
    m.top.observeField("content", "onContentChange")
    m.top.observeField("selectedSubtitle", "onSubtitleChange")
    m.top.observeField("audioIndex", "onAudioIndexChange")

    ' Get sibling data and pass to OSD
    setSiblingData()

    ' Custom Caption Function
    m.top.observeField("allowCaptions", "onAllowCaptionsChange")

    m.playbackTimer.observeField("fire", "ReportPlayback")
    m.bufferPercentage = 0 ' Track whether content is being loaded
    m.playReported = false
    m.bufferCheckTimer.duration = 30
    m.playbackRetries = 0 ' Track retry attempts for buffering failures
    m.lastBufferError = 0 ' Timestamp of last buffering error
    m.playbackSpeed = 1.0
    m.speedDialogActive = false

    m.videoEndingTime = m.top.findNode("videoEndingTime")

    ' Scrubbing
    m.scrubActive = false
    m.scrubDirection = 0
    m.scrubSpeedIndex = 3
    m.scrubSpeeds = [-168, -50, -10, 10, 50, 168]
    m.scrubPosition = 0
    m.scrubPositionStart = 0

    m.scrubTimer = m.top.findNode("scrubTimer")
    m.scrubTimer.observeField("fire", "onScrubTimer")

    m.scrubTime = m.top.findNode("scrubTimeDisplay")
    m.progressBar = m.top.findNode("scrubProgressBar")
    m.scrubSpeed = m.top.findNode("scrubSpeedDisplay")

    m.subtitleOffsetOverlay = m.top.findNode("subtitleOffsetOverlay")
    m.subtitleOffsetOverlay.observeField("offset", "onSubtitleOffsetChanged")
    m.subtitleOffsetOverlay.observeField("closed", "onSubtitleOffsetClosed")

    m.nextUp = m.top.findNode("nextUp")

    m.skipSegmentButton = m.top.findNode("skipSegment")

    palette = playbackOverlay.Palette()
    m.skipSegmentButton.palette = palette
    m.nextUp.palette = palette

    ' Both overlays size themselves around their text, so they report back and we
    ' pin them to the corner
    m.skipSegmentButton.observeField("overlayWidth", "onSkipSegmentResized")
    m.nextUp.observeField("overlayWidth", "onNextUpResized")
    m.nextUp.observeField("overlayHeight", "onNextUpResized")

    applyOverlayCountdownPreference()

    m.nextUpTimer = m.top.findNode("nextUpTimer")
    m.nextUpTimer.observeField("fire", "onNextUpTick")
    m.nextUpDismissed = false
    m.nextUpElapsedMs = 0

    'Play Next Episode button
    m.nextupbuttonseconds = (m.global.session.user.settings["playback.nextupbuttonseconds"] ?? "30").ToInt()

    ' Skip segment tracking
    m.mediaSegmentDismissed = {}
    m.currentSegmentType = invalid

    m.checkedForNextEpisode = false
    m.getNextEpisodeTask = createObject("roSGNode", "GetNextEpisodeTask")
    m.getNextEpisodeTask.observeField("nextEpisodeData", "onNextEpisodeDataLoaded")

    m.top.trickPlayBar.filledBarBlendColor = ColorPalette.TRIADBLUE
    m.top.enableTrickPlay = false
end sub

sub onAvailableAudioTracksChanged()
    if not isValidAndNotEmpty(m.top.availableAudioTracks) then return

    preferredAudioTrackName = m.global.queueManager.callFunc("getPreferredAudioTrackName")

    for each audioTrack in m.top.availableAudioTracks
        if isStringEqual(audioTrack.LookupCI("name"), preferredAudioTrackName)
            m.global.queueManager.callFunc("setPreferredAudioTrackIndex", audioTrack.LookupCI("Track").toint())
            m.top.audioIndex = audioTrack.LookupCI("Track")

            ' Save the current video position
            if m.top.position <> 0
                m.global.queueManager.callFunc("setTopStartingPoint", int(m.top.position) * 10000000&)
            end if

            m.top.control = VideoControl.STOP

            m.LoadMetaDataTask.selectedAudioStreamIndex = m.top.audioIndex
            m.LoadMetaDataTask.itemId = m.top.id
            m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
            m.LoadMetaDataTask.control = TaskControl.RUN

            exit for
        end if
    end for
end sub

' setSiblingData: Set the icon and title text for the previous and next items
'
sub setSiblingData()
    previousItemTitleText = m.global.queueManager.callFunc("getPreviousItemTitleAndIcon")
    if isValidAndNotEmpty(previousItemTitleText)
        m.osd.previousItemIcon = previousItemTitleText[0]
        m.osd.previousItemTitleText = previousItemTitleText[1]
    else
        m.osd.previousItemIcon = string.EMPTY
        m.osd.previousItemTitleText = string.EMPTY
    end if

    nextItemTitleText = m.global.queueManager.callFunc("getNextItemTitleAndIcon")
    if isValidAndNotEmpty(nextItemTitleText)
        m.osd.nextItemIcon = nextItemTitleText[0]
        m.osd.nextItemTitleText = nextItemTitleText[1]
    else
        m.osd.nextItemIcon = string.EMPTY
        m.osd.nextItemTitleText = string.EMPTY
    end if
end sub

' handleChapterSkipAction: Handles user command to skip chapters in playing video
'
sub handleChapterSkipAction(action as string)
    if not isValidAndNotEmpty(m.chapters) then return

    currentChapter = getCurrentChapterIndex()

    if action = "chapternext"
        gotoChapter = currentChapter + 1
        ' If there is no next chapter, exit
        if gotoChapter > m.chapters.count() - 1 then return

        newPosition = m.chapters[gotoChapter].StartPositionTicks / 10000000#
        m.top.seek = newPosition
        setVideoEndingTime(newPosition)
        m.positionText.text = secondsToHuman(newPosition, true)
        return
    end if

    if action = "chapterback"
        gotoChapter = currentChapter - 1
        ' If there is no previous chapter, restart current chapter
        if gotoChapter < 0 then gotoChapter = 0

        newPosition = m.chapters[gotoChapter].StartPositionTicks / 10000000#
        m.top.seek = newPosition
        setVideoEndingTime(newPosition)
        m.positionText.text = secondsToHuman(newPosition, true)
        return
    end if
end sub

' handleItemSkipAction: Handles user command to skip items
'
' @param {string} action - skip action to take
sub handleItemSkipAction(action as string)
    if action = "itemnext"
        ' If there is something next in the queue, play it
        if m.global.queueManager.callFunc("getPosition") < m.global.queueManager.callFunc("getCount") - 1
            m.top.unobserveField("state")
            m.top.control = VideoControl.STOP
            m.global.sceneManager.callFunc("clearPreviousScene")
            m.global.queueManager.callFunc("moveForward")
            m.global.queueManager.callFunc("playQueue")
        end if

        return
    end if

    if action = "itemback"
        currentPos = isValid(m.top.position) ? m.top.position : 0
        queuePos = isChainValid(m.global, "queueManager") ? m.global.queueManager.callFunc("getPosition") : 0
        if not isValid(queuePos) then queuePos = 0

        if currentPos > 3 or queuePos <= 0
            m.top.seek = 0
            setVideoEndingTime(0)
            m.positionText.text = secondsToHuman(0, true)
        else
            m.top.unobserveField("state")
            m.top.control = VideoControl.STOP
            m.global.sceneManager.callFunc("clearPreviousScene")
            m.global.queueManager.callFunc("moveBack")
            m.global.queueManager.callFunc("playQueue")
        end if

        return
    end if
end sub

' handleRewindAction: Handles user command to start rewinding scrub
'
sub handleRewindAction()
    if m.scrubActive
        if m.scrubDirection = -1
            if m.scrubSpeedIndex > 0
                m.scrubSpeedIndex = m.scrubSpeedIndex - 1
            end if
        else
            m.scrubDirection = -1
            m.scrubSpeedIndex = 2
        end if
        return
    end if

    startScrubbing(-1)
end sub

' handleFastForwardAction: Handles user command to start fast forward scrub
'
sub handleFastForwardAction()
    if m.scrubActive
        if m.scrubDirection = 1
            if m.scrubSpeedIndex < m.scrubSpeeds.count() - 1
                m.scrubSpeedIndex = m.scrubSpeedIndex + 1
            end if
        else
            m.scrubDirection = 1
            m.scrubSpeedIndex = 3
        end if
        return
    end if

    startScrubbing(1)
end sub

' startScrubbing: starts scrub mode, setting direction, speed, and UI state while pausing playback
' and initializing scrub tracking
'
sub startScrubbing(direction as integer)
    if m.scrubActive then return
    dropScrub()

    m.scrubActive = true
    m.scrubDirection = direction
    m.scrubSpeedIndex = direction = 1 ? 3 : 2
    m.scrubPositionStart = m.top.position
    m.scrubPosition = m.top.position

    m.top.control = VideoControl.PAUSE

    m.pauseOverlay.visible = true
    m.scrubInfo = m.top.findNode("scrubInfo")
    m.scrubInfo.visible = true

    m.scrubTimer.control = "start"
end sub

' stopScrubbing: stops scrub mode, applies the final seek position, restores playback state,
' and hides scrub UI elements
'
sub stopScrubbing()
    m.scrubTimer.control = "stop"
    m.scrubActive = false
    m.scrubDirection = 0

    m.top.seek = m.scrubPosition

    m.scrubInfo = m.top.findNode("scrubInfo")
    if isValid(m.scrubInfo)
        m.scrubInfo.visible = false
    end if

    trickplayImage = m.top.findNode("trickplayImage")
    if isValid(trickplayImage) then trickplayImage.visible = false

    m.top.control = VideoControl.RESUME
    m.pauseOverlay.visible = false
    hideSegmentSkipButton()
end sub

' onScrubTimer: updates scrub position, UI, and speed indicator on each timer tick while scrubbing playback
'
sub onScrubTimer()
    if not m.scrubActive then return

    speed = m.scrubSpeeds[m.scrubSpeedIndex]
    m.scrubPosition = m.scrubPosition + speed * m.scrubTimer.duration

    if m.scrubPosition < 0 then m.scrubPosition = 0
    if m.scrubPosition > m.top.duration then m.scrubPosition = m.top.duration


    if isValid(m.scrubTime)
        m.scrubTime.text = secondsToHuman(m.scrubPosition, true) + " / " + secondsToHuman(m.top.duration, true)
    end if

    if isValid(m.progressBar) and m.top.duration > 0
        scrubPct = m.scrubPosition / m.top.duration
        m.progressBar.width = 1714 * scrubPct
    end if

    if m.scrubSpeedIndex = 3 or m.scrubSpeedIndex = 2
        m.scrubSpeed.text = tr("3x")
    else if m.scrubSpeedIndex = 4 or m.scrubSpeedIndex = 1
        m.scrubSpeed.text = tr("15x")
    else if m.scrubSpeedIndex = 5 or m.scrubSpeedIndex = 0
        m.scrubSpeed.text = tr("50x")
    end if

    m.positionText.text = secondsToHuman(m.scrubPosition, true)
    setVideoEndingTime(m.scrubPosition)

    ' Show the trickplay frame at the scrub position
    prefetchSheets(m.scrubPosition * 1000, speed > 0)
    displayTrickplayImage(m.scrubPosition)
end sub

' handleHideAction: Handles action to hide OSD menu
'
' @param {boolean} resume - controls whether or not to resume video playback when sub is called
'
sub handleHideAction(resume as boolean)
    settleHeldScrub()
    m.osd.visible = false
    m.osd.hasFocus = false
    m.osd.setFocus(false)
    m.top.setFocus(true)
    ' Hide dark overlay when OSD is hidden (only if playing)
    if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
        m.pauseOverlay.visible = false
    end if
    if resume
        m.top.control = VideoControl.RESUME
    end if
end sub

sub handleChapterListAction()
    if not isValidAndNotEmpty(m.chapters) or isValid(m.chapterOverlay) then return

    chapters = []
    for i = 0 to m.chapters.count() - 1
        name = m.chapters[i].LookupCI("Name")
        if not isValidAndNotEmpty(name) then name = tr("Chapter") + " " + (i + 1).toStr()
        chapters.push({ name: name, startSeconds: (m.chapters[i].LookupCI("StartPositionTicks") ?? 0) / 10000000# })
    end for

    handleHideAction(false)
    m.chapterOverlay = CreateObject("roSGNode", "ChapterListOverlay")
    m.chapterOverlay.observeField("selected", "onChapterPicked")
    m.chapterOverlay.observeField("dismissed", "closeChapterList")
    m.top.appendChild(m.chapterOverlay)
    m.chapterOverlay.chapters = chapters
    m.chapterOverlay.currentIndex = currentChapterIndexAt(m.top.position)
    m.chapterOverlay.callFunc("open")
    m.chapterOverlay.setFocus(true)
end sub

' The chapter the playhead is in, where a chapter runs until the next one starts
function currentChapterIndexAt(position as float) as integer
    index = 0
    for i = 0 to m.chapters.count() - 1
        if position >= (m.chapters[i].LookupCI("StartPositionTicks") ?? 0) / 10000000# then index = i
    end for
    return index
end function

' Picking a chapter jumps to it and hands back to the controls, on the Chapters button
sub onChapterPicked()
    dropScrub()
    seekTime = m.chapterOverlay.selected
    closeChapterList()
    duration = m.top.duration
    if duration > 1 and seekTime > duration - 1 then seekTime = duration - 1
    m.top.seek = seekTime
    m.positionText.text = secondsToHuman(seekTime, true)
end sub

sub closeChapterList()
    if not isValid(m.chapterOverlay) then return
    m.chapterOverlay.unobserveField("selected")
    m.chapterOverlay.unobserveField("dismissed")
    ' Focus comes back to the player before the list goes, since removing the focused node lets the
    ' firmware put focus anywhere
    m.top.setFocus(true)
    m.top.removeChild(m.chapterOverlay)
    m.chapterOverlay = invalid
    prepareOSD()
    showOSD("chapterList")
end sub

' getCurrentChapterIndex: Finds current chapter index
'
' @return {integer} indicating index of current chapter within chapter data or 0 if chapter lookup fails
'
function getCurrentChapterIndex() as integer
    if not isValidAndNotEmpty(m.chapters) then return 0

    ' Give a 15 second buffer to compensate for user expectation and roku video position inaccuracy
    ' Web client uses 10 seconds, but this wasn't enough for Roku in testing
    currentPosition = m.top.position + 15
    currentChapter = 0

    for i = m.chapters.count() - 1 to 0 step -1
        if currentPosition >= (m.chapters[i].StartPositionTicks / 10000000#)
            currentChapter = i
            exit for
        end if
    end for

    return currentChapter
end function

' handleVideoPlayPauseAction: Handles action to either play or pause the video content
'
sub handleVideoPlayPauseAction()
    if resumeHeldScrub() then return

    ' If video is paused, resume it
    if m.top.state = "paused"
        handleHideAction(true)
        return
    end if

    ' Pause video
    m.top.control = VideoControl.PAUSE
end sub

sub handleShowSubtitleMenuAction()
    if not isValidAndNotEmpty(m.top.fullSubtitleData) then return

    handleHideAction(false)
    m.top.selectSubtitlePressed = true
end sub

sub handleShowAudioMenuAction()
    if not isValidAndNotEmpty(m.top.fullAudioData) then return

    handleHideAction(false)
    m.top.selectAudioPressed = true
end sub

sub handleShowSpeedMenuAction()
    if m.speedDialogActive then return

    speedOptions = [
        { value: "0.5", label: "0.5x" },
        { value: "0.75", label: "0.75x" },
        { value: "1.0", label: "1.0x" },
        { value: "1.25", label: "1.25x" },
        { value: "1.5", label: "1.5x" },
        { value: "2.0", label: "2.0x" }
    ]

    speedData = { data: [] }
    for each speedOption in speedOptions
        optionData = {
            Name: speedOption.value,
            description: speedOption.label
        }

        if Val(speedOption.value) = m.playbackSpeed
            optionData.selected = true
        end if

        speedData.data.push(optionData)
    end for

    handleHideAction(false)
    m.global.sceneManager.callFunc("radioDialog", tr("Playback Speed"), speedData)
    m.global.sceneManager.observeFieldScoped("returnData", "onSpeedDialogResult")
    m.speedDialogActive = true
end sub

sub applyPlaybackSpeed(speed as float)
    if m.top.hasField("playbackRate")
        m.top.playbackRate = speed
        m.playbackSpeed = speed
        return
    end if

    if m.top.hasField("rate")
        m.top.rate = speed
        m.playbackSpeed = speed
        return
    end if

    if m.top.hasField("playbackSpeed")
        m.top.playbackSpeed = speed
        m.playbackSpeed = speed
        return
    end if

    m.global.sceneManager.callFunc("userMessage", tr("Playback speed is not supported on this Roku model"))
end sub

sub onSpeedDialogResult()
    if not m.speedDialogActive then return

    m.global.sceneManager.unobserveFieldScoped("returnData")
    m.speedDialogActive = false

    returnData = m.global.sceneManager.returnData
    if returnData = invalid then return
    if returnData.Name = invalid then return

    selectedSpeed = returnData.Name.ToFloat()
    if selectedSpeed <= 0 then return

    applyPlaybackSpeed(selectedSpeed)
end sub

' handleShowVideoInfoPopupAction: Handles action to show video info popup
'
sub handleShowVideoInfoPopupAction()
    m.top.selectPlaybackInfoPressed = true
end sub

' onOSDAction: Process action events from OSD to their respective handlers
'
sub onOSDAction()
    action = LCase(m.osd.action)

    if action = "hide"
        handleHideAction(false)
        return
    end if

    if action = "play"
        handleHideAction(true)
        return
    end if

    if action.Left(6) = "scrub,"
        scrubBy(action.Mid(6).ToInt())
        return
    end if

    if action = "scrubcommit"
        if not resumeHeldScrub() then handleVideoPlayPauseAction()
        return
    end if

    if action = "scrubsettle"
        settleHeldScrub()
        return
    end if

    if action = "rewind"
        handleRewindAction()
        return
    end if

    if action = "fastforward"
        handleFastForwardAction()
        return
    end if

    if action = "chapterback" or action = "chapternext"
        handleChapterSkipAction(action)
        return
    end if

    if action = "chapterlist"
        handleChapterListAction()
        return
    end if

    if action = "showspeedmenu"
        handleShowSpeedMenuAction()
        return
    end if

    if action = "videoplaypause"
        handleVideoPlayPauseAction()
        return
    end if

    if action = "showsubtitlemenu"
        handleShowSubtitleMenuAction()
        return
    end if

    if action = "showaudiomenu"
        handleShowAudioMenuAction()
        return
    end if

    if action = "showvideoinfopopup"
        handleShowVideoInfoPopupAction()
        return
    end if

    if action = "itemback" or action = "itemnext"
        handleItemSkipAction(action)
        return
    end if

    if action = "showsyncmenu"
        handleShowsyncmenuAction()
        return
    end if

    if action = "showchannels"
        openCarousel()
        return
    end if

    if action = "showguide"
        openGuide()
        return
    end if
end sub

sub handleShowsyncmenuAction()
    handleHideAction(false)

    m.subtitleOffsetOverlay.offset = m.subtitleOffset
    m.subtitleOffsetOverlay.visible = true
end sub

sub hidesyncmenuAction()
    if not m.subtitleOffsetOverlay.visible then return

    m.subtitleOffsetOverlay.visible = false
    m.top.setFocus(true)
end sub

sub onSubtitleOffsetChanged()
    m.subtitleOffset = m.subtitleOffsetOverlay.offset
    m.global.queueManager.callFunc("setSubtitleOffset", m.subtitleOffset)
end sub

' Closing hands back to the controls, the way the other clients do
sub onSubtitleOffsetClosed()
    m.subtitleOffsetOverlay.visible = false
    showOSD()
end sub

' Only setup caption items if captions are allowed
sub onAllowCaptionsChange()
    if not m.top.allowCaptions then return

    m.captionGroup = m.top.findNode("captionGroup")
    m.captionGroup.createchildren(9, "LayoutGroup")
    m.captionTask = createObject("roSGNode", "captionTask")
    m.captionTask.observeField("currentCaption", "updateCaption")
    m.captionTask.observeField("useThis", "checkCaptionMode")
    m.top.observeField("subtitleTrack", "loadCaption")
    m.top.observeField("globalCaptionMode", "toggleCaption")

    if m.global.session.user.settings["playback.subs.custom"]
        m.top.suppressCaptions = true
        toggleCaption()
    else
        m.top.suppressCaptions = false
    end if
end sub

' Set caption url to server subtitle track
sub loadCaption()
    if m.top.suppressCaptions
        m.captionTask.url = m.top.subtitleTrack
    end if
end sub

' Toggles visibility of custom subtitles and sets captionTask's player state
sub toggleCaption()
    m.captionTask.playerState = m.top.state + m.top.globalCaptionMode
    if LCase(m.top.globalCaptionMode) = "on"
        m.captionTask.playerState = m.top.state + m.top.globalCaptionMode + "w"
        m.captionGroup.visible = true
    else
        m.captionGroup.visible = false
    end if
end sub

' Removes old subtitle lines and adds new subtitle lines
sub updateCaption()
    m.captionGroup.removeChildrenIndex(m.captionGroup.getChildCount(), 0)
    m.captionGroup.appendChildren(m.captionTask.currentCaption)
end sub

' Event handler for when selectedSubtitle changes
sub onSubtitleChange()
    switchWithoutRefresh = true

    if m.top.SelectedSubtitle <> SubtitleSelection.NONE
        ' If the global caption mode is off, then Roku can't display the subtitles natively and needs a video stop/start
        if LCase(m.top.globalCaptionMode) <> "on" then switchWithoutRefresh = false
    end if

    ' If previous subtitle was encoded, then we need to a video stop/start to change subtitle content
    if m.top.previousSubtitleWasEncoded then switchWithoutRefresh = false

    if switchWithoutRefresh then return

    ' Save the current video position
    m.global.queueManager.callFunc("setTopStartingPoint", int(m.top.position) * 10000000&)

    m.top.control = VideoControl.STOP

    m.LoadMetaDataTask.selectedSubtitleIndex = m.top.SelectedSubtitle
    m.LoadMetaDataTask.itemId = m.top.id
    m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN
end sub

' Event handler for when audioIndex changes
sub onAudioIndexChange()
    ' Skip initial audio index setting
    if m.top.position = 0 then return

    ' Save the current video position
    m.global.queueManager.callFunc("setTopStartingPoint", int(m.top.position) * 10000000&)

    m.top.control = VideoControl.STOP

    m.LoadMetaDataTask.selectedAudioStreamIndex = m.top.audioIndex
    m.LoadMetaDataTask.itemId = m.top.id
    m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN
end sub

sub onPlaybackErrorDialogClosed(msg)
    sourceNode = msg.getRoSGNode()
    sourceNode.unobserveField("buttonSelected")
    sourceNode.unobserveField("wasClosed")

    m.global.sceneManager.callFunc("popScene")
end sub

sub onPlaybackErrorButtonSelected(msg)
    sourceNode = msg.getRoSGNode()
    sourceNode.close = true
end sub

sub showPlaybackErrorDialog(errorMessage as string)
    dialog = createObject("roSGNode", "Dialog")
    dialog.title = tr("Error During Playback")
    dialog.buttons = [tr("OK")]
    dialog.message = errorMessage
    dialog.observeField("buttonSelected", "onPlaybackErrorButtonSelected")
    dialog.observeField("wasClosed", "onPlaybackErrorDialogClosed")
    m.top.getScene().dialog = dialog
end sub

' Restart the stream we already have, which clears a passing hiccup without the
' cost of asking the server again
sub retryPlaybackInPlace()
    currentPosition = m.top.position
    m.top.control = VideoControl.STOP
    m.top.seek = currentPosition
    m.top.control = VideoControl.PLAY
end sub

' Ask the server for playback again from where we are, the way picking the item
' off the detail screen does. A stream the server has already torn down cant be
' brought back by restarting the same URL, which is why replaying by hand works
' when the in place retry does not.
sub retryPlaybackFromServer()
    if m.top.position > 0
        m.global.queueManager.callFunc("setTopStartingPoint", int(m.top.position) * 10000000&)
    end if

    m.top.control = VideoControl.STOP

    m.LoadMetaDataTask.selectedSubtitleIndex = m.top.SelectedSubtitle
    m.LoadMetaDataTask.selectedAudioStreamIndex = m.top.audioIndex
    m.LoadMetaDataTask.itemId = m.top.id
    m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN
end sub

sub onVideoContentLoaded()
    m.LoadMetaDataTask.unobserveField("content")
    m.LoadMetaDataTask.control = TaskControl.STOP

    videoContent = m.LoadMetaDataTask.content
    m.LoadMetaDataTask.content = []

    stopLoadingSpinner()

    hidesyncmenuAction()

    ' A blocked rating ends it before anything plays, and quietly, the same as backing out
    if isValid(videoContent) and chainLookupReturn(videoContent[0], "blocked", false) = true
        m.global.queueManager.callFunc("clear")
        m.global.sceneManager.callFunc("popScene")
        return
    end if

    ' If we have nothing to play, return to previous screen. A channel switch goes back to the
    ' channel that was working instead.
    if not isValid(videoContent) or not isValid(videoContent[0])
        if isValid(m.channelSwitch)
            finishChannelSwitch(false)
            return
        end if
        showPlaybackErrorDialog(tr("There was an error retrieving the data for this item from the server."))
        return
    end if

    m.isTranscoded = videoContent[0].isTranscoded
    burnInSubtitles = chainLookupReturn(m.global, "session.user.settings.`playback.subs.burnin`", true)


    if m.isTranscoded and burnInSubtitles
        videoContent[0].content.SubtitleTracks = []
    end if

    m.top.content = videoContent[0].content
    m.top.PlaySessionId = videoContent[0].PlaySessionId
    m.top.videoId = videoContent[0].id
    m.top.container = videoContent[0].container
    m.top.mediaSourceId = videoContent[0].mediaSourceId
    m.top.fullSubtitleData = videoContent[0].fullSubtitleData
    m.osd.hasSubtitles = isValidAndNotEmpty(m.top.fullSubtitleData)
    m.top.fullAudioData = videoContent[0].fullAudioData
    m.top.audioIndex = videoContent[0].audioIndex
    m.top.transcodeParams = videoContent[0].transcodeparams
    m.chapters = videoContent[0].chapters
    m.osd.hasChapters = isValidAndNotEmpty(m.chapters)
    chapterStarts = []
    for each chapter in m.chapters ?? []
        ticks = chapter.LookupCI("StartPositionTicks")
        if isValid(ticks) then chapterStarts.push(Int(ticks / 10000#))
    end for
    m.osd.chapterStarts = chapterStarts
    m.trickplay = videoContent[0].trickplay
    m.top.showID = videoContent[0].showID
    m.mediaSegments = videoContent[0].mediaSegments

    ' A new item gets its own prompts, so an earlier dismissal doesn't carry over
    m.mediaSegmentDismissed = {}
    m.nextUpDismissed = false
    hideNextItem()
    hideSegmentSkipButton()

    m.osd.itemTitleText = m.top.content.title

    ' A Live TV channel shows its channel and program in the controls, and gets the channel carousel
    m.liveChannel = videoContent[0].liveChannel
    m.osd.liveMode = isValid(m.liveChannel)
    if isValid(m.liveChannel) then onLiveChannelTuned()

    resetEmbyPreview()
    m.trickplayDataFinal = invalid
    ' Check if this is a live stream to skip trickplay
    isLiveStream = isValid(videoContent[0].content) and videoContent[0].content.live = true

    startEmbyPreview(isLiveStream)

    ' A new item starts its scrub state and sheets over
    m.scrubHold = { active: false, wasPlaying: false, target: invalid }
    hideSeekPreview()
    if m.sheetsFor <> m.top.id
        m.sheetState = {}
        m.sheetQueue = []
        m.previewSheet = -1
        m.sheetsFor = m.top.id
    end if

    if isValidAndNotEmpty(m.trickplay) and not isLiveStream
        ' Keyed by media source, which is the item itself unless it has more than one version
        trickplayData = m.trickplay.LookupCI(m.top.mediaSourceId) ?? m.trickplay.LookupCI(m.top.id)
        if isValidAndNotEmpty(trickplayData)
            m.trickplayDataFinal = trickplayData.lookupCI(trickplayWidthFor(trickplayData))

            if isValidAndNotEmpty(m.trickplayDataFinal)
                ' Convert interval to seconds
                m.iconInterval = m.trickplayDataFinal.Interval / 1000

                m.canUseFastReplace = (m.trickplayDataFinal.TileHeight * m.trickplayDataFinal.Height) * (m.trickplayDataFinal.TileWidth * m.trickplayDataFinal.Width) < 2000000
            end if
        end if
    end if

    ' If video is an episode, attempt to add season and episode numbers to OSD
    if m.top.content.contenttype = 4
        if isValid(videoContent[0].seasonNumber)
            m.osd.seasonNumber = videoContent[0].seasonNumber
        end if

        if isValid(videoContent[0].episodeNumber)
            m.osd.episodeNumber = videoContent[0].episodeNumber
        end if

        if isValid(videoContent[0].episodeNumberEnd)
            m.osd.episodeNumberEnd = videoContent[0].episodeNumberEnd
        end if
    end if

    ' Attempt to add logo to OSD. A live channel has its badge and name there instead.
    if isValidAndNotEmpty(videoContent[0].logoImage) and not isValid(m.liveChannel)
        m.osd.logoImage = videoContent[0].logoImage

        ' Don't show both the logo and the video title if this isn't an episode or trailer
        if m.top.content.contenttype <> 4 and videoContent[0].extraType <> "trailer"
            m.osd.itemTitleText = string.EMPTY
        end if
    end if

    setSiblingData()

    ' Allow custom captions for non intro videos unless the video is being transcoded and burn subtitles are enabled
    if not m.LoadMetaDataTask.isIntro
        m.top.allowCaptions = not (m.isTranscoded and burnInSubtitles)
    end if

    ' Allow default subtitles
    m.top.unobserveField("selectedSubtitle")

    ' Set subtitleTrack property if subs are natively supported by Roku
    selectedSubtitle = invalid
    updatedSubtitleData = []
    for each subtitle in m.top.fullSubtitleData
        if m.isTranscoded and burnInSubtitles
            subtitle.IsEncoded = true
            updatedSubtitleData.push(subtitle)
        end if

        if subtitle.Index = videoContent[0].selectedSubtitle
            selectedSubtitle = subtitle
        end if
    end for

    if m.isTranscoded and burnInSubtitles
        m.top.fullSubtitleData = updatedSubtitleData
        m.top.globalCaptionMode = "Off"
    end if

    if isValid(selectedSubtitle)
        availableSubtitleTrackIndex = availSubtitleTrackIdx(selectedSubtitle.Track.TrackName)
        if availableSubtitleTrackIndex <> SubtitleSelection.NONE
            if not selectedSubtitle.IsEncoded
                if selectedSubtitle.IsForced
                    ' If IsForced, make sure to remember the Roku global setting so we can set it back when the video is done playing.
                    m.originalClosedCaptionState = m.top.globalCaptionMode
                end if
                m.top.globalCaptionMode = "On"
                m.top.subtitleTrack = m.top.availableSubtitleTracks[availableSubtitleTrackIndex].TrackName
            end if
        end if
    end if

    ' Check if video content selected a subtitle
    if m.top.selectedSubtitle <> videoContent[0].selectedSubtitle
        m.top.selectedSubtitle = videoContent[0].selectedSubtitle
    end if

    m.top.observeField("selectedSubtitle", "onSubtitleChange")

    if isValid(m.top.audioIndex)
        m.top.audioTrack = m.top.audioIndex.toStr()
    else
        m.top.audioTrack = "2"
    end if

    m.top.setFocus(true)

    ' Hold the play command rather than starting and pausing, which would trip the
    ' pause overlay and the unpause rewind
    startDelay = getVideoStartDelaySeconds()
    if startDelay > 0
        m.startDelayTimer.duration = startDelay
        m.startDelayTimer.control = "start"
        return
    end if

    m.top.control = VideoControl.PLAY
end sub

function getVideoStartDelaySeconds() as integer
    value = get_user_setting("playback.videoStartDelay")
    if not isValidAndNotEmpty(value) then return 0

    seconds = value.ToInt()
    if seconds < 0 then return 0
    if seconds > 30 then return 30

    return seconds
end function

sub onStartDelayElapsed()
    m.top.control = VideoControl.PLAY
end sub

sub displayTrickplayImage(trickPosition as integer)
    if m.global.session.user.settings["playback.trickplay.enabled"] = false then return
    if displayEmbyPreview(trickPosition) then return
    if not isValid(m.trickplayDataFinal) then return

    ' Index of trickplay image that matches seek timestamp - out of all trickplay images
    iconIndex = fix(trickPosition / m.iconInterval)

    ' Index of tileset that trickplay image is located in
    tileIndex = Fix(iconIndex / (m.trickplayDataFinal.TileHeight * m.trickplayDataFinal.TileWidth))

    ' Index of trickplay image within tileset
    tileIconIndex = iconIndex - (tileIndex * (m.trickplayDataFinal.TileHeight * m.trickplayDataFinal.TileWidth))

    ' Index of row trickplay image is on within tileset
    iconRow = fix(tileIconIndex / m.trickplayDataFinal.TileHeight)

    ' Index of column trickplay image is on within tileset
    iconColumn = tileIconIndex mod m.trickplayDataFinal.TileWidth

    ' Translation values for trickplay images
    offsetHoriz = 100
    offsetVert = 900 - m.trickplayDataFinal.Height

    if m.scrubActive
        if m.top.duration > 0
            scrubPct = m.scrubPosition / m.top.duration
            offsetHoriz = 103 + 1714 * scrubPct - m.trickplayDataFinal.Width / 2
        else
            offsetHoriz = 103
        end if
    else if isValid(m.positionTranslation)
        ' If we can get translation data for the trickplaybar's thumb icon, use it so the trickplay images can move left/right with seeking
        if m.positionTranslation.translation[0] = 0 then return
        offsetHoriz = m.positionTranslation.translation[0] - 50
    end if

    maxOffsetHoriz = 1920 - m.trickplayDataFinal.Width
    if offsetHoriz > maxOffsetHoriz then offsetHoriz = maxOffsetHoriz

    if offsetHoriz < 0 then offsetHoriz = 0

    trickplayImage = m.top.findNode("trickplayImage")

    ' Trickplayimage node doesn't exist, create it
    if not isValid(trickplayImage)
        newTrickplayImage = createObject("roSGNode", "Poster")
        newTrickplayImage.uri = `tmp:/${m.top.id}-${tileIndex}.jpg`
        newTrickplayImage.id = `trickplayImage`
        newTrickplayImage.loadDisplayMode = "noScale"
        newTrickplayImage.height = m.trickplayDataFinal.Height * m.trickplayDataFinal.TileHeight
        newTrickplayImage.width = m.trickplayDataFinal.Width * m.trickplayDataFinal.TileWidth
        newTrickplayImage.translation = `[${offsetHoriz - (iconColumn * m.trickplayDataFinal.Width)},  ${offsetVert - (iconRow * m.trickplayDataFinal.Height)}]`
        newTrickplayImage.clippingRect = `[${iconColumn * m.trickplayDataFinal.Width}, ${iconRow * m.trickplayDataFinal.Height}, ${m.trickplayDataFinal.Width}, ${m.trickplayDataFinal.Height}]`
        m.top.appendChild(newTrickplayImage)
        return
    end if

    ' If we've changed tiles, remove existing trickplayImage node
    ' Otherwise loading the next image will fail. 'cause Roku.
    if trickplayImage.uri <> `tmp:/${m.top.id}-${tileIndex}.jpg`
        if not m.canUseFastReplace
            m.top.removeChild(trickplayImage)
            return
        end if

        trickplayImage.uri = `tmp:/${m.top.id}-${tileIndex}.jpg`
    end if

    ' Move clippingRect to next trickplay image within tileset - offsetting translation by an equal amount so it doesn't move
    trickplayImage.translation = `[${offsetHoriz - (iconColumn * m.trickplayDataFinal.Width)},  ${offsetVert - (iconRow * m.trickplayDataFinal.Height)}]`
    trickplayImage.clippingRect = `[${iconColumn * m.trickplayDataFinal.Width}, ${iconRow * m.trickplayDataFinal.Height}, ${m.trickplayDataFinal.Width}, ${m.trickplayDataFinal.Height}]`
    trickplayImage.visible = true
end sub

' Event handler for when video content field changes
sub onContentChange()
    if not isValid(m.top.content) then return
    m.top.observeField("position", "onPositionChanged")
end sub

sub onNextEpisodeDataLoaded()
    m.checkedForNextEpisode = true

    if not isChainValid(m.getNextEpisodeTask, "nextEpisodeData.Items") then return
    targetId = m.top.id

    ' A blocked episode never comes up next, though the one playing always stays in
    episodes = []
    targetIndex = -1
    for each ep in m.getNextEpisodeTask.nextEpisodeData.Items
        epId = ep.id ?? ep.Id
        if not isValidAndNotEmpty(epId) and isValid(ep.json)
            epId = ep.json.id ?? ep.json.Id
        end if
        isTarget = isStringEqual(epId, targetId)
        if isTarget or not blockedContent.IsBlockedNow(ep)
            if isTarget and targetIndex < 0 then targetIndex = episodes.count()
            episodes.push(ep)
        end if
    end for

    if targetIndex < 0
        m.nextupbuttonseconds = 0
        return
    end if

    ' If current episode is the last episode in series, disable next up button timer
    if targetIndex >= episodes.count() - 1
        m.nextupbuttonseconds = 0
    end if

    ' Pre-fetch adjacent episode window (up to 5 previous / 20 next) into queueManager
    queuePos = isChainValid(m.global, "queueManager") ? m.global.queueManager.callFunc("getPosition") : 0
    queueCount = isChainValid(m.global, "queueManager") ? m.global.queueManager.callFunc("getCount") : 0
    if not isValid(queuePos) then queuePos = 0
    if not isValid(queueCount) then queueCount = 0

    if queuePos = 0 and queueCount <= 1
        startIndex = targetIndex - 5
        if startIndex < 0 then startIndex = 0

        endIndex = targetIndex + 20
        if endIndex >= episodes.count() then endIndex = episodes.count() - 1

        windowQueue = []
        for i = startIndex to endIndex
            ep = episodes[i]
            epId = ep.id ?? ep.Id
            if not isValidAndNotEmpty(epId) and isValid(ep.json)
                epId = ep.json.id ?? ep.json.Id
            end if
            if isStringEqual(LCase(epId), LCase(targetId)) and isValid(m.top.content)
                if isValid(m.top.content.startingPoint) then ep.startingPoint = m.top.content.startingPoint
                if isValid(m.top.content.selectedAudioStreamIndex) then ep.selectedAudioStreamIndex = m.top.content.selectedAudioStreamIndex
            end if
            windowQueue.push(ep)
        end for

        m.global.queueManager.callFunc("set", windowQueue)
        m.global.queueManager.callFunc("setPosition", targetIndex - startIndex)
        setSiblingData()
    end if
end sub

sub hideSegmentSkipButton()
    m.currentSegmentEndTicks = 0
    m.currentSegmentStartTicks = 0
    m.currentSegmentType = invalid
    m.skipSegmentButton.visible = false
end sub

sub onSkipSegmentResized()
    m.skipSegmentButton.translation = [1920 - OVERLAY_EDGE - m.skipSegmentButton.overlayWidth, 1080 - OVERLAY_BOTTOM - m.skipSegmentButton.overlayHeight]
end sub

sub onNextUpResized()
    m.nextUp.translation = [1920 - OVERLAY_EDGE - m.nextUp.overlayWidth, 1080 - OVERLAY_BOTTOM - m.nextUp.overlayHeight]
end sub

' One setting drives the ring and the timer on both overlays
sub applyOverlayCountdownPreference()
    mode = m.global.session.user.settings["playback.mediasegments.countdown"] ?? "both"

    showRing = isStringEqual(mode, "progressbar") or isStringEqual(mode, "both")
    showTimer = isStringEqual(mode, "timer") or isStringEqual(mode, "both")

    m.skipSegmentButton.showRing = showRing
    m.skipSegmentButton.showTimer = showTimer
    m.nextUp.showRing = showRing
    m.nextUp.showTimer = showTimer
end sub

sub displaySegmentSkipButton(segmentType as string, endticks as double)
    m.currentSegmentEndTicks = endticks
    m.currentSegmentType = segmentType

    if isValidAndNotEmpty(m.mediaSegmentDismissed) and m.mediaSegmentDismissed.DoesExist(m.currentSegmentType) then return

    ' Check if user has specific instructions for this media segment type
    userSetting = m.global.session.user.settings[`playback.mediasegments.${segmentType}`]
    if isValid(userSetting)

        ' User doesn't want anything to happen for this media segment type
        if isStringEqual(userSetting, MediaSegmentAction.NONE) then return

        ' User wants to auto-skip this media segment type
        if isStringEqual(userSetting, MediaSegmentAction.SKIP)
            skipCurrentSegment()
            return
        end if
    end if

    if m.osd.visible then return ' Don't show if OSD is visible

    ' The end of an episode can be handed to the Up Next card instead of offering
    ' a skip that lands in the same place
    if isStringEqual(segmentType, MediaSegmentType.OUTRO)
        if toBoolean(m.global.session.user.settings["playback.replaceskipoutrowithnextup"] ?? false)
            if displayNextItem() then return
        end if
    end if

    m.skipSegmentButton.segmentType = segmentType
    m.skipSegmentButton.visible = true
end sub

sub hideNextItem()
    m.nextUp.visible = false
    m.nextUpTimer.control = TimerControl.STOP
end sub

' Returns whether the card is up, so the caller can fall back to a skip button
function displayNextItem() as boolean
    if m.nextUp.visible then return true
    if m.nextUpDismissed then return false
    if isStringEqual(nextUpBehaviour(), "disabled") then return false

    ' Disable for mixed playlists
    if m.global.queueManager.callFunc("getQueueUniqueTypes").count() <> 1 then return false

    ' Disable if we're at the end of the queue
    if m.global.queueManager.callFunc("getPosition") >= m.global.queueManager.callFunc("getCount") - 1 then return false

    ' Only show if next in queue is an episode
    currentQueuePosition = m.global.queueManager.callFunc("getPosition")
    nextItem = m.global.queueManager.callFunc("getItemByIndex", currentQueuePosition + 1)
    if not isValid(nextItem) then return false
    if not isStringEqual(nextItem.lookupCI("Type"), ItemType.EPISODE) then return false

    isMinimal = isStringEqual(nextUpBehaviour(), "minimal")
    m.nextUp.isMinimal = isMinimal

    thumbUri = string.EMPTY
    if not isMinimal
        imageTags = nextItem.lookupCI("ImageTags")
        primaryTag = chainLookupReturn(imageTags, ImageType.PRIMARY, invalid)
        if isValid(primaryTag)
            thumbUri = ImageURL(nextItem.lookupCI("id"), ImageType.PRIMARY, { "maxWidth": 400, "Tag": primaryTag })
        end if
    end if
    m.nextUp.thumbUri = thumbUri

    m.nextUp.seriesTitle = nextItem.lookupCI("SeriesName") ?? string.EMPTY
    m.nextUp.episodeTitle = nextItem.lookupCI("name") ?? string.EMPTY
    m.nextUp.episodeLabel = episodeLabelFor(nextItem)
    ' A fresh node each time, so a marker stamped for the last episode cant show on this one.
    ' The queue holds plain items or content nodes carrying them.
    watchAnimeMarker(CreateObject("roSGNode", "Node"), nextItem.json ?? nextItem)

    m.nextUp.focusedButton = NEXT_UP_PLAY
    m.nextUpElapsedMs = 0
    m.nextUp.progress = 1.0
    m.nextUp.secondsRemaining = Int(nextUpTimeoutMs() / 1000)

    m.nextUp.visible = true

    if nextUpTimeoutMs() > 0
        m.nextUpTimer.control = TimerControl.START
    end if

    return true
end function

' The next episode's anime markers ride along on the Up Next card
sub showAnimeMarker(marker as dynamic)
    m.nextUp.animeMarker = marker ?? {}
end sub

function episodeLabelFor(item as object) as string
    episodeNumber = item.lookupCI("IndexNumber")
    if not isValid(episodeNumber) then return string.EMPTY

    seasonNumber = item.lookupCI("ParentIndexNumber")
    season = isValid(seasonNumber) ? seasonNumber.toStr() : "?"

    return `S${season}:E${episodeNumber}`
end function

function nextUpBehaviour() as string
    return m.global.session.user.settings["playback.nextupbehavior"] ?? "extended"
end function

function nextUpTimeoutMs() as integer
    return (m.global.session.user.settings["playback.nextuptimeout"] ?? "7000").ToInt()
end function

' Runs the card's countdown, then acts on whatever the user asked for
sub onNextUpTick()
    if not m.nextUp.visible then return

    total = nextUpTimeoutMs()
    if total <= 0 then return

    m.nextUpElapsedMs += NEXT_UP_TICK_MS

    remaining = total - m.nextUpElapsedMs
    if remaining < 0 then remaining = 0

    m.nextUp.progress = remaining / total
    m.nextUp.secondsRemaining = Int((remaining + 999) / 1000)

    if remaining > 0 then return

    hideNextItem()
    if isAutoplayNextEpisodeEnabled()
        playNextUpItem()
    else
        cancelNextItem()
    end if
end sub

sub playNextUpItem()
    hideNextItem()
    hideSegmentSkipButton()
    handleItemSkipAction("itemnext")
end sub

' Dismissing keeps the card down for the rest of the episode
sub cancelNextItem()
    m.nextUpDismissed = true
    hideNextItem()
end sub

sub updateSegmentCountdown(currentPositionTicks as longinteger)
    if not m.skipSegmentButton.visible then return

    m.skipSegmentButton.secondsRemaining = Int((m.currentSegmentEndTicks - currentPositionTicks) / 10000000&)

    span = m.currentSegmentEndTicks - m.currentSegmentStartTicks
    if span <= 0
        m.skipSegmentButton.progress = 0
        return
    end if

    progress = (m.currentSegmentEndTicks - currentPositionTicks) / span
    if progress < 0 then progress = 0
    if progress > 1 then progress = 1

    m.skipSegmentButton.progress = progress
end sub

sub checkSegmentSkipButton()
    if not isValidAndNotEmpty(m.mediaSegments) then return

    matchFound = false

    currentPositionTicks = int(m.top.position) * 10000000&
    for i = 0 to m.mediaSegments.TotalRecordCount - 1
        mediaSegment = m.mediaSegments.items[i]

        if currentPositionTicks < mediaSegment.StartTicks then continue for

        ' Don't display skip button if we are within 5 seconds of the segment end time
        if currentPositionTicks >= (mediaSegment.EndTicks - 50000000) then continue for

        ' Current position is between media segment's start and end ticks. Display a skip button
        displaySegmentSkipButton(mediaSegment.type, mediaSegment.EndTicks)
        m.currentSegmentStartTicks = mediaSegment.StartTicks
        updateSegmentCountdown(currentPositionTicks)

        matchFound = true

        exit for
    end for

    ' Check if no match was found but the skip segment button is visible
    if not matchFound
        if m.skipSegmentButton.visible
            hideSegmentSkipButton()
        end if
    end if
end sub

' When Video Player state changes
sub onPositionChanged()
    ' Pass video position data into OSD
    if m.top.duration = 0
        m.osd.progressPercentage = 0
    else
        m.osd.progressPercentage = m.top.position / m.top.duration
    end if

    ' Ensure position text is accurate
    m.positionText.text = secondsToHuman(m.top.position, true)

    m.osd.positionTime = m.top.position
    m.osd.remainingPositionTime = m.top.duration - m.top.position

    ' A positive offset holds the subtitles back, so the task is asked for an earlier moment
    if isValid(m.captionTask)
        newPos = Int(m.top.position * 1000) - m.subtitleOffset
        m.captionTask.currentPos = newPos
    end if

    ' Check if dialog is open
    m.dialog = m.top.getScene().findNode("dialogBackground")
    if not isValid(m.dialog)
        ' Do not show Next Episode button for intro videos
        if not m.LoadMetaDataTask.isIntro
            checkSegmentSkipButton()
            checkNextUp()
        end if
    end if
end sub

' The card comes up as the item runs out
sub checkNextUp()
    if m.nextUp.visible then return
    if m.top.duration <= 0 then return
    if m.osd.visible then return
    if m.top.trickPlayBar.visible then return

    remaining = m.top.duration - m.top.position
    threshold = isStringEqual(nextUpBehaviour(), "extended") ? 1 : 0.5

    if remaining > threshold then return

    if displayNextItem() then hideSegmentSkipButton()
end sub

'
' When Video Player state changes
sub onState()
    if isValid(m.captionTask)
        m.captionTask.playerState = m.top.state + m.top.globalCaptionMode
    end if

    if isStringEqual(m.top.state, MediaPlaybackState.PLAYING) or isStringEqual(m.top.state, MediaPlaybackState.ERROR)
        m.streamLoading = false
    end if
    updateLoadingLayer()

    ' Pass video state into OSD
    m.osd.playbackState = m.top.state

    ' Handle OSD visibility based on playback state
    if isStringEqual(m.top.state, MediaPlaybackState.PAUSED)
        m.wasPaused = true
        ' Keep OSD visible when paused
        if not m.scrubActive and not isValid(m.chapterOverlay)
            if not m.osd.visible
                showOSD()
            end if
        end if
        ' Disable auto-hide timer when paused
        m.osd.inactiveTimeout = 0
        ' Show dark overlay when paused
        m.pauseOverlay.visible = true
    else if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
        ' Enable auto-hide timer when playing (5 seconds)
        m.osd.inactiveTimeout = 5
        ' Hide dark overlay when playing
        m.pauseOverlay.visible = false

        if m.wasPaused ?? false
            m.wasPaused = false
            unpauseRewindSec = val(m.global.session.user.settings["playback.unpauseRewind"] ?? "0")
            if unpauseRewindSec > 0 and m.top.position > unpauseRewindSec
                newPos = m.top.position - unpauseRewindSec
                if newPos < 0 then newPos = 0
                m.top.seek = newPos
            end if
        end if
    end if

    ' When buffering, start timer to monitor buffering process
    if isStringEqual(m.top.state, MediaPlaybackState.BUFFERING) and m.bufferCheckTimer <> invalid
        ' Roku reports the fill of the buffer it is filling now, so the mark to beat
        ' starts again with it. Carrying the old one over made every later buffer
        ' look stalled the moment the check ran.
        m.bufferPercentage = 0

        ' start timer
        m.bufferCheckTimer.control = "start"
        m.bufferCheckTimer.ObserveField("fire", "bufferCheck")
    else if isStringEqual(m.top.state, MediaPlaybackState.ERROR)

        if isValid(m.channelSwitch)
            finishChannelSwitch(false)
        else if not m.playReported and m.top.transcodeAvailable
            m.top.retryWithTranscoding = true ' If playback was not reported, retry with transcoding
            ' Stop playback and exit player
            m.top.control = VideoControl.STOP
            m.top.backPressed = true
        else if not m.playReported and m.top.content.live
            if m.playbackRetries < REPLAY_RETRIES
                diagnostics.Playback("Live TV playback failed, retrying with remux forced", diagnostics.LEVEL_WARN)
                m.playbackRetries = m.playbackRetries + 1
                m.global.queueManager.callFunc("setForceTranscode", PlaybackMethod.FORCELIVETVREMUX)

                m.top.control = VideoControl.STOP

                m.LoadMetaDataTask.itemId = m.top.id
                m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
                m.LoadMetaDataTask.control = TaskControl.RUN
            else
                diagnostics.Playback(`Live TV playback failed after ${m.playbackRetries} attempts, showing the error`, diagnostics.LEVEL_ERROR)
                showPlaybackErrorDialog(tr("Live TV Playback Failed"))

                ' Stop playback and exit player
                m.top.control = VideoControl.STOP
                m.top.backPressed = true
                return
            end if
        else
            ' Reset retry counter if more than 30 seconds have passed since last error
            currentTime = CreateObject("roDateTime").AsSeconds()
            if m.playbackRetries > 0 and (currentTime - m.lastBufferError) > 30
                diagnostics.Playback(`Playback stabilised, resetting retry count from ${m.playbackRetries}`)
                m.playbackRetries = 0
            end if

            ' Attempt to retry playback up to REPLAY_RETRIES times before showing error
            if m.playbackRetries < REPLAY_RETRIES
                m.playbackRetries = m.playbackRetries + 1
                m.lastBufferError = currentTime

                if m.playbackRetries = 1
                    diagnostics.Playback(`Player error, restarting the stream, retry ${m.playbackRetries} of ${REPLAY_RETRIES}`, diagnostics.LEVEL_WARN)
                    retryPlaybackInPlace()
                else
                    diagnostics.Playback(`Player error, asking the server for playback again, retry ${m.playbackRetries} of ${REPLAY_RETRIES}`, diagnostics.LEVEL_WARN)
                    retryPlaybackFromServer()
                end if
            else
                ' All retries exhausted, show error and exit
                diagnostics.Playback(`Playback failed after ${REPLAY_RETRIES} retries`, diagnostics.LEVEL_ERROR)
                showPlaybackErrorDialog(tr("Error During Playback"))

                ' Stop playback and exit player
                m.top.control = VideoControl.STOP
                m.top.backPressed = true
            end if
        end if
    else if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
        ' Reset retry counter when playback is successful
        if m.playbackRetries > 0
            diagnostics.Playback("Playback resumed after a retry")
            m.playbackRetries = 0
            m.bufferCheckTimer.duration = 30
        end if

        ' Check if next episode is available
        if isValid(m.top.showID)
            if m.top.showID <> string.EMPTY and not m.checkedForNextEpisode and m.top.content.contenttype = 4
                m.getNextEpisodeTask.showID = m.top.showID
                m.getNextEpisodeTask.videoID = m.top.id
                m.getNextEpisodeTask.control = TaskControl.RUN
            end if
        end if

        if m.playReported = false
            ReportPlayback("start")
            m.playReported = true
        else
            ReportPlayback()
        end if
        m.playbackTimer.control = "start"

        ' The stop from a channel switch always lands before the next channel plays, so one that
        ' never came cant swallow a later stop
        m.suppressStopReport = false
        if isValid(m.channelSwitch) and m.top.id = m.channelSwitch.target.Id then finishChannelSwitch(true)
    else if isStringEqual(m.top.state, MediaPlaybackState.PAUSED)
        m.playbackTimer.control = "stop"
        ReportPlayback()
    else if isStringEqual(m.top.state, MediaPlaybackState.STOPPED)
        m.playbackTimer.control = "stop"
        if m.suppressStopReport
            m.suppressStopReport = false
        else
            ReportPlayback("stop")
        end if
        m.playReported = false
    else if isStringEqual(m.top.state, MediaPlaybackState.FINISHED)
        m.playbackTimer.control = "stop"
        ReportPlayback("stop")
        m.playReported = false
    end if
end sub

sub onTrickPlayBarVisibleChange()
    trickplayImage = m.top.findNode("trickplayImage")
    if isValid(trickplayImage)
        trickplayImage.visible = m.top.trickPlayBar.visible
    end if

    if not m.top.content.live
        if isValid(m.videoEndingTime)
            m.videoEndingTime.visible = m.top.trickPlayBar.visible
        end if
    end if

    ' Don't show both the trickplay bar and the skip segment button at the same time
    if m.top.trickPlayBar.visible
        if m.skipSegmentButton.visible
            hideSegmentSkipButton()
        end if
    end if
end sub

sub setVideoEndingTime(videoSeekPosition = 0 as integer)
    m.clock = m.osd.findNode("clock")
    if not isValid(m.clock) then return
    if not isValid(m.top.content) then return

    if m.top.content.live then return

    currentTime = m.clock.callFunc("getCurrentTime")
    remainingTime = getremainingTime(videoSeekPosition)

    videoEndingTime = m.clock.callFunc("getFormattedTime", (currentTime + remainingTime), false)

    m.videoEndingTime.text = videoEndingTime
    m.osd.videoEndingTime = videoEndingTime
end sub

function getRemainingTime(videoSeekPosition = 0 as integer)
    if not isChainValid(m.positionText, "text")
        return m.top.duration - m.top.position
    end if

    seekTime = 0#
    seekPosition = m.positionText.text.split(":")

    if seekPosition.count() = 3
        ' hours -> seconds
        seekTime += seekPosition[0].toint() * 3600
        ' minutes -> seconds
        seekTime += seekPosition[1].toint() * 60
    end if

    ' minutes -> seconds
    if seekPosition.count() = 2
        seekTime += seekPosition[0].toint() * 60
    end if

    ' add seconds
    seekTime += seekPosition[seekPosition.count() - 1].toint()

    if videoSeekPosition > 0
        seekTime = videoSeekPosition
    end if

    seekTime = seekTime = 0 ? m.top.position : seekTime

    return m.top.duration - seekTime
end function

sub onTrickPlayBarTextChange()
    if not m.top.trickPlayBar.visible then return

    m.nextupbuttonseconds = (m.global.session.user.settings["playback.nextupbuttonseconds"] ?? "30").ToInt()
    m.currentSegmentType = invalid
    m.mediaSegmentDismissed = {}
    m.nextUpDismissed = false

    setVideoEndingTime(0)

    ' If Roku has pulled thumbnailtiles from the video stream, use them instead
    if not m.global.session.user.settings["playback.trickplay.forcecustom"]
        if isValidAndNotEmpty(m.top.thumbnailTiles)
            return
        end if
    end if

    if not isValid(m.positionText)
        displayTrickplayImage(m.top.position)
        return
    end if

    seekTime = 0
    seekPosition = m.positionText.text.split(":")

    if seekPosition.count() = 3
        ' hours -> seconds
        seekTime += seekPosition[0].toint() * 3600
        ' minutes -> seconds
        seekTime += seekPosition[1].toint() * 60
    end if

    ' minutes -> seconds
    if seekPosition.count() = 2
        seekTime += seekPosition[0].toint() * 60
    end if

    ' add seconds
    seekTime += seekPosition[seekPosition.count() - 1].toint()

    seekTime = seekTime = 0 ? m.top.position : seekTime

    displayTrickplayImage(seekTime)
end sub

'
' Report playback to server
sub ReportPlayback(state = "update" as string, ownTask = false as boolean)

    if m.top.position = invalid then return

    params = {
        "ItemId": m.top.id,
        "PlaySessionId": m.top.PlaySessionId,
        "PositionTicks": int(m.top.position) * 10000000&, 'Ensure a LongInteger is used
        "IsPaused": isStringEqual(m.top.state, MediaPlaybackState.PAUSED),
        "UserId": m.global.session.user.id
    }

    if isValid(m.itemServerData)
        params.serverData = m.itemServerData
        params.UserId = m.itemServerData.userId
    end if
    if isValid(m.top.content) and isValid(m.top.content.live) and m.top.content.live
        params.append({
            "MediaSourceId": m.top.transcodeParams.MediaSourceId,
            "LiveStreamId": m.top.transcodeParams.LiveStreamId
        })
        m.bufferCheckTimer.duration = 30
    end if

    if inArray(["stop", "finished"], state) and isValid(m.originalClosedCaptionState)
        m.top.globalCaptionMode = m.originalClosedCaptionState
        m.originalClosedCaptionState = invalid
    end if

    ' Report playstate via worker task
    playstateTask = m.global.playstateTask
    if ownTask
        ' Held until it finishes, or a task nothing references can be collected mid flight
        playstateTask = CreateObject("roSGNode", "PlaystateTask")
        m.ownReportTask = playstateTask
    end if
    playstateTask.setFields({ status: state, params: params })
    playstateTask.control = TaskControl.RUN
end sub

'
' Check the the buffering has not hung
sub bufferCheck()

    if m.top.state <> "buffering"
        ' If video is not buffering, stop timer
        m.bufferCheckTimer.control = "stop"
        m.bufferCheckTimer.unobserveField("fire")
        return
    end if

    if m.top.bufferingStatus <> invalid

        ' Check that the buffering percentage is increasing
        if m.top.bufferingStatus["percentage"] > m.bufferPercentage
            m.bufferPercentage = m.top.bufferingStatus["percentage"]
            ' Reset retry counter if buffering is progressing
            if m.playbackRetries > 0
                m.playbackRetries = 0
                m.bufferCheckTimer.duration = 30
            end if
        else if m.top.content.live = true
            m.top.callFunc("refresh")
        else
            ' Reset retry counter if more than 30 seconds have passed since last error
            currentTime = CreateObject("roDateTime").AsSeconds()
            if m.playbackRetries > 0 and (currentTime - m.lastBufferError) > 30
                diagnostics.Playback(`Buffering stabilised, resetting retry count from ${m.playbackRetries}`)
                m.playbackRetries = 0
                m.bufferCheckTimer.duration = 30
            end if

            ' Attempt to retry playback up to REPLAY_RETRIES times
            if m.playbackRetries < REPLAY_RETRIES
                m.playbackRetries = m.playbackRetries + 1
                m.lastBufferError = currentTime

                ' Extend buffer check duration for subsequent retries to allow more time
                m.bufferCheckTimer.duration = 30 + (m.playbackRetries * 15)

                if m.playbackRetries = 1
                    diagnostics.Playback(`Buffering stalled, restarting the stream, retry ${m.playbackRetries} of ${REPLAY_RETRIES}`, diagnostics.LEVEL_WARN)
                    retryPlaybackInPlace()
                else
                    diagnostics.Playback(`Buffering stalled, asking the server for playback again, retry ${m.playbackRetries} of ${REPLAY_RETRIES}`, diagnostics.LEVEL_WARN)
                    retryPlaybackFromServer()
                end if
            else
                ' All retries exhausted, show error
                diagnostics.Playback(`Buffering failed after ${REPLAY_RETRIES} retries`, diagnostics.LEVEL_ERROR)
                showPlaybackErrorDialog(tr("There was an error retrieving the data for this item from the server."))

                ' Stop playback and exit player
                m.top.control = VideoControl.STOP
                m.top.backPressed = true
            end if
        end if
    end if

end sub

' stateAllowsOSD: Check if current video state allows showing the OSD
'
' @return {boolean} indicating if video state allows the OSD to show
function stateAllowsOSD() as boolean
    validStates = ["playing", "paused", "stopped"]
    return inArray(validStates, m.top.state)
end function


' availSubtitleTrackIdx: Returns Roku's index for requested subtitle track
'
' @param {string} tracknameToFind - TrackName for subtitle we're looking to match
' @return {integer} indicating Roku's index for requested subtitle track. Returns SubtitleSelection.NONE if not found
function availSubtitleTrackIdx(tracknameToFind as string) as integer
    idx = 0
    for each availTrack in m.top.availableSubtitleTracks
        ' The TrackName must contain the URL we supplied originally, though
        ' Roku mangles the name a bit, so we check if the URL is a substring, rather
        ' than strict equality
        if Instr(1, availTrack.TrackName, tracknameToFind)
            return idx
        end if
        idx = idx + 1
    end for
    return SubtitleSelection.NONE
end function

sub skipCurrentSegment()
    seekPosition = m.currentSegmentEndTicks / 10000000#

    if seekPosition > (m.top.duration - 2)
        if m.global.queueManager.callFunc("getPosition") < m.global.queueManager.callFunc("getCount") - 1
            handleItemSkipAction("itemnext")
            return
        else
            seekPosition = m.top.duration - 1
        end if
    end if

    m.top.seek = seekPosition
end sub

sub prepareOSD()
    setSiblingData()
    if m.skipSegmentButton.visible
        hideSegmentSkipButton()
    end if
end sub

sub showOSD(focusTarget = "seekbar" as string)
    m.osd.focusTarget = focusTarget
    m.osd.visible = true
    m.osd.hasFocus = true
    m.osd.setFocus(true)
    m.pauseOverlay.visible = true
    ' The controls coming up is the cue that a scrub may follow, so the sheets ahead start loading
    if not m.scrubHold.active then prefetchSheets(m.top.position * 1000, true)
end sub

' ------------------------------------------------------------------------------------------------
' Loading
' ------------------------------------------------------------------------------------------------

' Every load of the item, the first or a reload for a track or channel change, is covered until
' a frame plays
sub onLoadTaskState()
    if m.LoadMetaDataTask.state <> "run" then return
    m.streamLoading = true
    updateLoadingLayer()
end sub

sub noteSeek()
    m.seekNoted = true
    m.seekClock.Mark()
    m.seekGraceTimer.control = "stop"
    m.seekGraceTimer.control = "start"
end sub

' Dimmed over the screen until a stream first plays, and plain while it buffers after that. A seek
' with a preview to look at keeps buffering quiet while the preview shows and a moment after.
sub updateLoadingLayer()
    behindPreview = trickplayPreviewOn() and (m.seekPreview.visible or (m.seekNoted and m.seekClock.TotalMilliseconds() < m.seekGraceTimer.duration * 1000))
    buffering = isStringEqual(m.top.state, MediaPlaybackState.BUFFERING) and not behindPreview
    show = m.streamLoading or buffering
    if not show
        if m.loadingLayer.active then m.loadingLayer.active = false
        return
    end if
    if m.loadingLayer.active and m.loadingLayer.dimmed = m.streamLoading then return
    m.loadingLayer.active = false
    m.loadingLayer.dimmed = m.streamLoading
    m.loadingLayer.active = true
end sub

' ------------------------------------------------------------------------------------------------
' Scrubbing on the seek bar
' ------------------------------------------------------------------------------------------------

function seekStepSeconds() as integer
    seconds = (m.global.session.user.settings["playback.seekStep"] ?? "10").toStr().toInt()
    if seconds <= 0 then seconds = 10
    return seconds
end function

function trickplayPreviewOn() as boolean
    return m.global.session.user.settings["playback.trickplay.enabled"] <> false and isValid(m.trickplayDataFinal)
end function

' The widest sheet that is no wider than 320, or the narrowest there is
function trickplayWidthFor(widths as object) as string
    best = invalid
    smallest = invalid
    for each key in widths
        width = key.toInt()
        if not isValid(smallest) or width < smallest then smallest = width
        if width <= 320 and (not isValid(best) or width > best) then best = width
    end for
    if not isValid(best) then best = smallest
    return best.toStr()
end function

' Each press moves by the seek step. With pause while scrubbing on and a preview to scrub by, the
' first press pauses and later ones only move the target. Otherwise every press seeks.
sub scrubBy(direction as integer)
    duration = m.top.duration
    if duration <= 0 then return
    limit = duration - 1
    delta = direction * seekStepSeconds()

    pauseSetting = m.global.session.user.settings["playback.trickplay.pauseWhileScrubbing"]
    if not m.scrubHold.active and pauseSetting <> false and trickplayPreviewOn()
        wasPlaying = isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
        m.scrubHold = { active: true, wasPlaying: wasPlaying, target: invalid }
        if wasPlaying then m.top.control = VideoControl.PAUSE
    end if
    m.seekSettleTimer.control = "stop"

    if m.scrubHold.active
        target = clampSeconds((m.scrubHold.target ?? m.top.position) + delta, limit)
        m.scrubHold.target = target
    else
        ' A seek is still landing while the presses come, so each builds on where the last one aimed
        target = clampSeconds((m.pendingSeek ?? m.top.position) + delta, limit)
        m.pendingSeek = target
        m.top.seek = target
        m.seekSettleTimer.control = "start"
    end if

    m.osd.scrubPosition = target
    showSeekPreview(target)
    prefetchSheets(target * 1000, direction > 0)
end sub

function clampSeconds(value as float, limit as float) as float
    if value < 0 then return 0
    if value > limit then return limit
    return value
end function

sub onSeekSettled()
    m.pendingSeek = invalid
    hideSeekPreview()
end sub

' Lands a paused scrub and plays from there, even when playback was paused before it
function resumeHeldScrub() as boolean
    if not m.scrubHold.active then return false
    target = m.scrubHold.target
    m.scrubHold = { active: false, wasPlaying: false, target: invalid }
    if isValid(target) then m.top.seek = target
    hideSeekPreview()
    ' The scrub made this pause, so the unpause rewind has nothing to undo
    m.wasPaused = false
    m.top.control = VideoControl.RESUME
    return true
end function

' Seeks to where the scrub was aiming but stays paused, so play picks up from there
sub settleHeldScrub()
    if not m.scrubHold.active or not isValid(m.scrubHold.target) then return
    m.top.seek = m.scrubHold.target
    m.scrubHold.target = invalid
    hideSeekPreview()
end sub

' Gives up on the scrub without seeking, and plays on when it was the scrub that paused
sub dropScrub()
    m.seekSettleTimer.control = "stop"
    m.pendingSeek = invalid
    wasPlaying = m.scrubHold.active and m.scrubHold.wasPlaying
    m.scrubHold = { active: false, wasPlaying: false, target: invalid }
    hideSeekPreview()
    if wasPlaying then m.top.control = VideoControl.RESUME
end sub

' The frame nearest the target in a box centered over the bar. Until a sheet arrives the frame
' already showing stays.
sub showSeekPreview(target as float)
    if not trickplayPreviewOn() then return
    info = m.trickplayDataFinal
    thumb = Int(target * 1000 / info.Interval)
    if thumb < 0 or thumb >= info.ThumbnailCount
        m.seekPreview.visible = false
        return
    end if
    perSheet = info.TileWidth * info.TileHeight
    sheet = Int(thumb / perSheet)
    inSheet = thumb mod perSheet

    m.seekPreviewTime.text = secondsToHuman(Int(target), false)
    if m.sheetState[sheet.toStr()] = "loaded"
        m.pendingPreview = invalid
        if m.previewSheet <> sheet
            ' A new sheet goes in a new poster, since changing a large poster's uri can fail to load
            m.seekPreviewFrame.removeChildrenIndex(m.seekPreviewFrame.getChildCount(), 0)
            poster = m.seekPreviewFrame.createChild("Poster")
            poster.loadDisplayMode = "noScale"
            poster.width = info.Width * info.TileWidth
            poster.height = info.Height * info.TileHeight
            poster.uri = `tmp:/${m.top.id}-${sheet}.jpg`
            m.previewSheet = sheet
        end if
        m.seekPreviewFrame.getChild(0).translation = [- (inSheet mod info.TileWidth) * info.Width, -Int(inSheet / info.TileWidth) * info.Height]
    else
        m.pendingPreview = target
    end if

    if m.seekPreview.visible then return
    layoutSeekPreview()
    m.seekPreview.visible = true
    m.top.findNode("seekPreviewEntrance").control = "start"
end sub

' 160 above the bar, with 8 of padding inside a 2 border, and the time under the frame
sub layoutSeekPreview()
    info = m.trickplayDataFinal
    m.seekPreviewFrame.clippingRect = [0, 0, info.Width, info.Height]
    timeHeight = m.seekPreviewTime.boundingRect().height
    m.seekPreviewTime.width = info.Width
    m.seekPreviewTime.translation = [10, 10 + info.Height + 8]
    width = info.Width + 20
    height = 10 + info.Height + 8 + timeHeight + 10
    for each id in ["seekPreviewFill", "seekPreviewBorder"]
        m.top.findNode(id).width = width
        m.top.findNode(id).height = height
    end for
    left = 960 - width / 2
    top = 828 - 160 - height
    m.top.findNode("seekPreviewSlide").keyValue = [[left, top + 10], [left, top]]
end sub

sub hideSeekPreview()
    m.pendingPreview = invalid
    m.seekPreview.visible = false
    m.osd.scrubPosition = -1
end sub

' The sheet at the position, the next six steps the way things are moving, and two steps back
sub prefetchSheets(positionMs as float, forward as boolean)
    if not trickplayPreviewOn() then return
    info = m.trickplayDataFinal
    perSheet = info.TileWidth * info.TileHeight
    stepMs = seekStepSeconds() * 1000
    direction = forward ? 1 : -1
    lastMs = (info.ThumbnailCount - 1) * info.Interval
    endMs = (m.top.duration - 1) * 1000
    if endMs < lastMs then lastMs = endMs

    targets = [positionMs]
    for k = 1 to 6
        targets.push(positionMs + direction * k * stepMs)
    end for
    for k = 1 to 2
        targets.push(positionMs - direction * k * stepMs)
    end for

    for each moment in targets
        if moment < 0 then moment = 0
        if moment > lastMs then moment = lastMs
        sheet = Int(Int(moment / info.Interval) / perSheet)
        if not m.sheetState.DoesExist(sheet.toStr())
            m.sheetState[sheet.toStr()] = "pending"
            m.sheetQueue.push(sheet)
        end if
    end for
    runSheetTask()
end sub

sub runSheetTask()
    task = m.PreloadTrickplayImagesTask
    if m.sheetQueue.count() = 0 or task.state = "run" then return
    task.videoID = m.top.id
    task.trickplayWidth = m.trickplayDataFinal.Width
    task.method = "ADD"
    task.sheets = m.sheetQueue
    m.sheetQueue = []
    task.control = TaskControl.RUN
end sub

' A sheet that failed to load is forgotten, so a later pass asks for it again
sub onSheetsLoaded()
    task = m.PreloadTrickplayImagesTask
    if task.videoID <> m.top.id then return
    loaded = {}
    for each sheet in task.loaded
        loaded[sheet.toStr()] = true
    end for
    for each sheet in task.sheets
        if loaded.DoesExist(sheet.toStr())
            m.sheetState[sheet.toStr()] = "loaded"
        else
            m.sheetState.Delete(sheet.toStr())
        end if
    end for
    if isValid(m.pendingPreview) then showSeekPreview(m.pendingPreview)
end sub

' Sheets asked for while a fetch was running go once it finishes
sub onSheetTaskState()
    if m.PreloadTrickplayImagesTask.state = "stop" then runSheetTask()
end sub

' ------------------------------------------------------------------------------------------------
' Live TV
' ------------------------------------------------------------------------------------------------

' The guide data only comes from the signed in server. A channel from another server still gets its
' card, without a schedule.
function liveOnSignedInServer() as boolean
    if not isValid(m.liveChannel) then return false
    channelServer = m.liveChannel.serverUrl ?? ""
    if channelServer = "" then return true
    return LCase(channelServer).Replace("/", "") = LCase(chainLookupReturn(m.global, "session.server.url", "")).Replace("/", "")
end function

function currentChannelEntry() as object
    return { Id: m.liveChannel.id, Name: m.liveChannel.name, ChannelNumber: m.liveChannel.number, ImageTags: m.liveChannel.imageTags ?? {} }
end function

function lineupHas(lineup as dynamic, channelId as string) as boolean
    if not isValid(lineup) then return false
    for each channel in lineup
        if channel.Id = channelId then return true
    end for
    return false
end function

sub sendLiveRequest(request as object, handler as string)
    task = CreateObject("roSGNode", "LiveTvRequestTask")
    task.request = request
    task.observeField("response", handler)
    task.control = TaskControl.RUN
    m.liveTasks.push(task)
end sub

sub releaseLiveTask(task as object)
    task.unobserveField("response")
    kept = []
    for each running in m.liveTasks
        if not running.isSameNode(task) then kept.push(running)
    end for
    m.liveTasks = kept
end sub

sub onLiveChannelTuned()
    m.osd.liveChannel = { number: m.liveChannel.number, name: m.liveChannel.name }
    m.osd.liveProgram = {}
    m.osd.hasAudioChoice = isValid(m.top.fullAudioData) and m.top.fullAudioData.count() > 1
    refreshLiveProgram()
    m.top.findNode("liveProgramTimer").control = TimerControl.START

    ' Every tune is remembered, so the guide opens on it and Back from the guide returns to it
    if liveOnSignedInServer() then liveTvLastChannel.Remember(m.liveChannel.id)
    prepareLineup()
end sub

' The program airing on the channel, for the controls' name, episode line and progress. When
' nothing covers now, the earliest program in the fetch stands in. A failed or empty fetch leaves
' whatever was showing.
sub refreshLiveProgram()
    if not isValid(m.liveChannel) or not liveOnSignedInServer() then return
    now = liveTvGuide.NowSeconds()
    sendLiveRequest({ kind: "programs", ids: [m.liveChannel.id], from: now - 1800, upto: now + 10800, tag: m.liveChannel.id }, "onLiveProgramLoaded")
end sub

sub onLiveProgramLoaded(event as object)
    releaseLiveTask(event.getRoSGNode())
    response = event.getData()
    if not response.ok or not isValid(m.liveChannel) or response.tag <> m.liveChannel.id then return
    programs = response.programs
    if programs.count() = 0 then return
    programs.SortBy("startSec")
    program = liveTvGuide.ProgramAiringAt(programs, liveTvGuide.NowSeconds())
    if not isValid(program) then program = programs[0]
    m.osd.liveProgram = program
end sub

' The lineup is the guide's, in the guide's order, when playback started there. Anywhere else it is
' every channel in the saved sort, or just this channel when it isnt in the lineup.
sub prepareLineup()
    id = m.liveChannel.id
    if lineupHas(m.lineup, id)
        schedulePrewarm()
        return
    end if
    guideLineup = m.global.queueManager.callFunc("getLiveTvLineup")
    if lineupHas(guideLineup, id)
        m.lineup = guideLineup
        schedulePrewarm()
        return
    end if
    m.lineup = [currentChannelEntry()]
    if liveOnSignedInServer() then sendLiveRequest({ kind: "channels" }, "onLineupLoaded")
end sub

sub onLineupLoaded(event as object)
    releaseLiveTask(event.getRoSGNode())
    response = event.getData()
    if not response.ok or not isValid(m.liveChannel) then return
    channels = liveTvGuide.SortChannels(response.items, liveTvGuide.NormalizeSort(m.global.session.user.settings["livetv.channelSortBy"]))
    if lineupHas(channels, m.liveChannel.id) then m.lineup = channels
    schedulePrewarm()
end sub

' A tune is often one step of channel surfing, so the fetch waits for it to settle rather than
' firing on every step
sub schedulePrewarm()
    if m.lineup.count() < 2 or not liveOnSignedInServer() then return
    timer = m.top.findNode("prewarmTimer")
    timer.control = TimerControl.STOP
    timer.control = TimerControl.START
end sub

' Keeps the carousel's guide data loaded while it is closed, so the first Up press opens onto real
' cards instead of placeholders
sub prewarmCarousel()
    if not isValid(m.liveChannel) then return
    missing = []
    for each id in liveTvGuide.CarouselNeighborhood(m.lineup, m.liveChannel.id, 4)
        if not m.carouselPrograms.DoesExist(id) then missing.push(id)
    end for
    if missing.count() = 0 then return
    start = liveTvGuide.LeftEdge(liveTvGuide.NowSeconds())
    sendLiveRequest({ kind: "programs", ids: missing, from: start, upto: start + liveTvGuide.DefaultWindow() }, "onPrewarmLoaded")
end sub

sub onPrewarmLoaded(event as object)
    releaseLiveTask(event.getRoSGNode())
    response = event.getData()
    if not response.ok then return
    for each id in response.ids
        m.carouselPrograms[id] = []
    end for
    for each program in response.programs
        id = program.LookupCI("ChannelId")
        list = m.carouselPrograms[id] ?? []
        list.push(program)
        m.carouselPrograms[id] = list
    end for
end sub

sub openCarousel()
    if isValid(m.carousel) or not isValid(m.liveChannel) then return
    m.carouselPriorOsd = m.osd.visible
    ' The strip takes every key while it shows, so nothing behind it should hold focus
    handleHideAction(false)

    m.carousel = CreateObject("roSGNode", "ChannelCarousel")
    m.carousel.observeField("selected", "onCarouselSelected")
    m.carousel.observeField("dismissed", "onCarouselDismissed")
    m.carousel.observeField("showControls", "onCarouselShowControls")
    m.top.appendChild(m.carousel)
    m.carousel.programs = m.carouselPrograms
    m.carousel.selectionRevision = m.selectionRevision
    m.carousel.currentChannelId = m.liveChannel.id
    m.carousel.model = { lineup: m.lineup, currentChannelId: m.liveChannel.id, sortBy: m.global.session.user.settings["livetv.channelSortBy"] }
    m.carousel.setFocus(true)
end sub

' Hands back to the controls as they were, or opens them on play and pause when Down asked for them
sub closeCarousel(revealControls = false as boolean)
    if not isValid(m.carousel) then return
    m.carousel.unobserveField("selected")
    m.carousel.unobserveField("dismissed")
    m.carousel.unobserveField("showControls")
    ' Focus comes back to the player before the strip goes, since removing the focused node lets
    ' the firmware put focus anywhere
    m.top.setFocus(true)
    m.top.removeChild(m.carousel)
    m.carousel = invalid
    if revealControls or m.carouselPriorOsd
        prepareOSD()
        showOSD("transport")
    end if
end sub

sub onCarouselDismissed()
    closeCarousel()
end sub

sub onCarouselShowControls()
    closeCarousel(true)
end sub

' One switch at a time, and picking the channel already playing just closes the carousel
sub onCarouselSelected(event as object)
    channel = event.getData()
    if isValid(m.channelSwitch) or not isValid(m.liveChannel) then return
    if channel.Id = m.liveChannel.id
        closeCarousel()
        return
    end if
    startChannelSwitch(channel, currentChannelEntry())
end sub

' A channel picked in the carousel has to start playing before the carousel goes away. When it
' doesnt, the channel that was working plays again and the carousel stays up on it. A restore has
' no previous channel of its own, so how it ends only ends the switch.
sub startChannelSwitch(target as object, previous as dynamic)
    m.channelSwitch = { target: target, previous: previous }
    timer = m.top.findNode("switchTimer")
    timer.control = TimerControl.STOP
    timer.control = TimerControl.START
    tuneChannel(target)
end sub

' Loads the next channel into this same player, the way a new audio track reloads the stream
sub tuneChannel(channel as object)
    queue = m.global.queueManager
    guideLineup = queue.callFunc("getLiveTvLineup")

    ' Reported here, since the stop the player sends for itself would name the next channel. It
    ' goes on a task of its own, because closing a live stream can hold the server up for a while
    ' and the next channel's start report would be dropped behind it.
    if m.playReported then ReportPlayback("stop", true)
    m.suppressStopReport = true
    m.playReported = false
    m.playbackRetries = 0
    m.top.control = VideoControl.STOP

    queue.callFunc("clear")
    queue.callFunc("setLiveTvLineup", guideLineup)
    queue.callFunc("push", { id: channel.Id, type: "video" })
    m.top.id = channel.Id
    m.LoadMetaDataTask.itemId = channel.Id
    m.LoadMetaDataTask.itemType = "video"
    m.LoadMetaDataTask.observeField("content", "onVideoContentLoaded")
    m.LoadMetaDataTask.control = TaskControl.RUN
end sub

sub finishChannelSwitch(succeeded as boolean)
    pending = m.channelSwitch
    if not isValid(pending) then return
    m.top.findNode("switchTimer").control = TimerControl.STOP
    m.channelSwitch = invalid
    if not succeeded and isValid(m.carousel)
        m.carousel.notice = tr("Failed to play {name}").Replace("{name}", pending.target.Name ?? "")
    end if
    if not isValid(pending.previous) then return
    if succeeded
        closeCarousel()
        return
    end if
    m.selectionRevision++
    if isValid(m.carousel)
        m.carousel.currentChannelId = pending.previous.Id
        m.carousel.selectionRevision = m.selectionRevision
    end if
    startChannelSwitch(pending.previous, invalid)
end sub

' A switch that hasnt started playing by then counts as failed
sub onSwitchTimeout()
    finishChannelSwitch(false)
end sub

' The guide button always lands on the guide, not wherever playback was launched from. When the
' player was opened from the guide, going back to it drops the player so Back doesnt bounce through
' the guide twice.
sub openGuide()
    closeCarousel()
    m.top.findNode("liveProgramTimer").control = TimerControl.STOP
    m.global.queueManager.callFunc("clear")
    m.top.control = VideoControl.STOP
    sceneManager = m.global.sceneManager
    sceneManager.callFunc("popScene")
    active = sceneManager.callFunc("getActiveScene")
    if not isValid(active) or not active.isSubtype("LiveTvGuide")
        sceneManager.callFunc("pushScene", CreateObject("roSGNode", "LiveTvGuide"))
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    ' The OK that picks Offset in the subtitle picker carries on up to here once the picker has
    ' closed, so the offset panel takes the remote back rather than letting it open the controls
    if m.subtitleOffsetOverlay.visible
        m.subtitleOffsetOverlay.setFocus(true)
        return true
    end if

    ' Play and pause work under the chapter list without bringing the controls up behind it
    if isValid(m.chapterOverlay)
        if press and key = KeyCode.PLAY
            if m.top.state = "paused" then m.top.control = VideoControl.RESUME else m.top.control = VideoControl.PAUSE
        end if
        m.chapterOverlay.setFocus(true)
        return true
    end if

    ' The Up Next card owns the remote while it is up, the same two buttons Core
    ' offers and left and right between them
    if m.nextUp.visible and not m.top.trickPlayBar.visible
        if not press then return false

        if key = KeyCode.LEFT
            m.nextUp.focusedButton = NEXT_UP_PLAY
            return true
        end if

        if key = KeyCode.RIGHT
            m.nextUp.focusedButton = 1
            return true
        end if

        if key = KeyCode.OK
            if m.nextUp.focusedButton = NEXT_UP_PLAY
                playNextUpItem()
            else
                cancelNextItem()
            end if
            return true
        end if
    end if

    if m.skipSegmentButton.visible and not m.top.trickPlayBar.visible
        if key = KeyCode.OK and press
            skipCurrentSegment()
            hideSegmentSkipButton()
            return true
        end if
    end if

    if not press then return false

    if m.scrubActive
        if key = KeyCode.OK or key = KeyCode.PLAY
            stopScrubbing()
            return true
        end if

        if key = KeyCode.LEFT or key = KeyCode.RIGHT
            stopScrubbing()
            return true
        end if

        if key = KeyCode.REWIND
            if m.scrubDirection = 1
                stopScrubbing()
            else
                handleRewindAction()
            end if
            return true
        end if

        if key = KeyCode.FASTFORWRD
            if m.scrubDirection = -1
                stopScrubbing()
            else
                handleFastForwardAction()
            end if
            return true
        end if
    end if

    ' Handle rewind/fast forward/replay remote buttons
    if key = KeyCode.REWIND or key = KeyCode.FASTFORWRD or key = KeyCode.REPLAY
        if not m.top.trickPlayBar.visible
            if not stateAllowsOSD() then return true

            if key = KeyCode.FASTFORWRD
                handleFastForwardAction()
            else
                handleRewindAction()
            end if

            return true
        end if
    end if

    if key = KeyCode.LEFT or key = KeyCode.RIGHT
        if not m.osd.visible and not m.top.trickPlayBar.visible
            if not stateAllowsOSD() then return true

            skipFwd = val(m.global.session.user.settings["playback.skipForwardLength"] ?? "10")
            skipBack = val(m.global.session.user.settings["playback.skipBackLength"] ?? "10")
            if skipFwd <= 0 then skipFwd = 10
            if skipBack <= 0 then skipBack = 10

            if key = KeyCode.RIGHT
                newPosition = m.top.position + skipFwd
                if newPosition > m.top.duration then newPosition = m.top.duration
            else
                newPosition = m.top.position - skipBack
                if newPosition < 0 then newPosition = 0
            end if

            m.top.seek = newPosition
            setVideoEndingTime(newPosition)
            m.positionText.text = secondsToHuman(newPosition, true)
            return true
        end if
    end if

    if key = KeyCode.DOWN and not m.top.trickPlayBar.visible
        if not m.LoadMetaDataTask.isIntro
            if not stateAllowsOSD() then return true

            prepareOSD()
            showOSD("seekbar")
            return true
        end if

    else if key = KeyCode.UP and not m.top.trickPlayBar.visible
        if not m.LoadMetaDataTask.isIntro
            ' Up during live playback opens the channel carousel, even while the stream buffers
            if isValid(m.liveChannel)
                openCarousel()
                return true
            end if

            if not stateAllowsOSD() then return true

            prepareOSD()
            showOSD("transport")
            return true
        end if

    else if key = KeyCode.OK and not m.top.trickPlayBar.visible
        if not m.LoadMetaDataTask.isIntro
            if not stateAllowsOSD() then return true

            prepareOSD()
            showOSD()
            return true
        end if

        return false
    end if

    if not m.LoadMetaDataTask.isIntro
        if key = KeyCode.PLAY and not m.top.trickPlayBar.visible
            if resumeHeldScrub() then return true
            if not stateAllowsOSD() then return true

            if m.top.state = "paused"
                m.top.control = VideoControl.RESUME
                return true
            end if

            m.top.control = VideoControl.PAUSE
            prepareOSD()
            showOSD()
            return true
        end if
    end if

    if key = KeyCode.BACK
        if m.scrubActive
            stopScrubbing()
            return true
        end if

        if m.nextUp.visible
            cancelNextItem()
            return true
        end if

        if m.skipSegmentButton.visible
            if isValid(m.currentSegmentType)
                m.mediaSegmentDismissed[m.currentSegmentType] = true
            end if
            hideSegmentSkipButton()
            return true
        end if

        resetEmbyPreview()
        sheets = []
        for each sheetKey in m.sheetState
            sheets.push(sheetKey.toInt())
        end for
        m.PreloadTrickplayImagesTask.videoID = m.top.id
        m.PreloadTrickplayImagesTask.sheets = sheets
        m.PreloadTrickplayImagesTask.method = "REMOVE"
        m.PreloadTrickplayImagesTask.control = TaskControl.RUN

        currentTimeTimer = m.clock.findNode("currentTimeTimer")
        if isValid(currentTimeTimer) then currentTimeTimer.control = TimerControl.STOP

        m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
        m.global.queueManager.callFunc("clear")
        m.top.control = VideoControl.STOP
    end if

    return false
end function

sub resetEmbyPreview()
    if isValid(m.embyPreviewTask)
        m.embyPreviewTask.unobserveField("result")
        m.embyPreviewTask.control = "STOP"
        m.embyPreviewTask = invalid
    end if
    m.embyPreview = invalid
    poster = m.top.findNode("trickplayImage")
    if isValid(poster) then m.top.removeChild(poster)
end sub

sub startEmbyPreview(isLive as boolean)
    if isLive then return
    server = m.itemServerData
    if not isValid(server)
        server = activeServerContext()
        if not isValid(server) then return
    end if
    if not isEmbyServer(server.serverUrl) then return
    m.embyPreviewTask = CreateObject("roSGNode", "EmbyPreviewTask")
    m.embyPreviewTask.server = server
    m.embyPreviewTask.itemId = m.top.videoId
    m.embyPreviewTask.mediaSourceId = m.top.mediaSourceId
    m.embyPreviewTask.observeField("result", "onEmbyPreviewReady")
    m.embyPreviewTask.control = "RUN"
end sub

sub onEmbyPreviewReady(event as object)
    m.embyPreview = event.getData()
end sub

function displayEmbyPreview(position as integer) as boolean
    if not isValid(m.embyPreview) then return false
    frames = m.embyPreview.frames
    if not isValidAndNotEmpty(frames) then return false
    frame = embyFeatures.FrameIndex(frames, position * 10000000&)
    poster = m.top.findNode("trickplayImage")
    if frame < 0
        if isValid(poster) then poster.visible = false
        return true
    end if
    if not isValid(poster)
        poster = CreateObject("roSGNode", "Poster")
        poster.id = "trickplayImage"
        poster.width = 320
        poster.height = m.embyPreview.height
        poster.loadDisplayMode = "scaleToFit"
        m.top.appendChild(poster)
    end if
    x = 100
    if m.top.duration > 0 then x = 103 + 1714 * position / m.top.duration - 160
    if x < 0 then x = 0
    if x > 1600 then x = 1600
    poster.translation = [x, 900 - m.embyPreview.height]
    if poster.uri <> frames[frame].url then poster.uri = frames[frame].url
    poster.visible = true
    return true
end function

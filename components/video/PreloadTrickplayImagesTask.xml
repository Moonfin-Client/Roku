<?xml version="1.0" encoding="utf-8"?>

<component name="PreloadTrickplayImagesTask" extends="Task">
    <interface>
        <field id="videoID" type="string" />
        <!-- ADD fetches the listed sheets that arent on disk yet, REMOVE deletes them -->
        <field id="method" type="string" />
        <field id="sheets" type="array" />
        <field id="trickplayWidth" type="integer" />
        <!-- After an ADD, the listed sheets that are on disk -->
        <field id="loaded" type="array" alwaysNotify="true" />
    </interface>
</component>

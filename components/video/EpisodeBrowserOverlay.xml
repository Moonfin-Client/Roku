<?xml version="1.0" encoding="utf-8"?>
<component name="EpisodeBrowserOverlay" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/playback/panel33.9.png" />
      <Poster id="panelBorder" uri="pkg:/images/playback/panelborder33.9.png" />
      <Poster id="logo" height="60" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="title" color="#FFFFFF" visible="false" />
      <Rectangle id="titleRule" height="2" color="#FFFFFF14" />
      <DetailTabBar id="seasonBar" visible="false" escapeLeft="true" />
      <Group id="viewport">
        <Group id="rows" />
      </Group>
      <Label id="message" color="#FFFFFFB3" />
    </Group>
  </children>
  <interface>
    <field id="seriesName" type="string" />
    <!-- The series logo the player shows in its corner, and its width over its height -->
    <field id="logoUri" type="string" />
    <field id="logoAspect" type="float" value="0" />
    <field id="playingId" type="string" />
    <!-- The playing episode's season number, so the browser opens there -->
    <field id="seasonNumber" type="integer" value="-1" />
    <!-- Every episode of the series, set once the request comes back -->
    <field id="episodes" type="array" alwaysNotify="true" onChange="onEpisodesLoaded" />
    <field id="selected" type="node" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

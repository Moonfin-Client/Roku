<?xml version="1.0" encoding="utf-8"?>
<component name="EpisodeBrowserOverlay" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000D9" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/tracks/panel20.9.png" width="1400" blendColor="#181818F0" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="1400" blendColor="#FFFFFF29" />
      <Label id="title" color="#FFFFFF" />
      <Group id="tabsViewport">
        <Group id="tabs" />
      </Group>
      <Rectangle id="titleRule" width="1396" height="1" color="#FFFFFF14" />
      <Group id="viewport">
        <Group id="rows" />
      </Group>
      <Label id="message" color="#FFFFFFB3" horizAlign="center" vertAlign="center" />
      <Label id="footer" color="#FFFFFF6B" horizAlign="center" width="1400" />
    </Group>
    <Animation id="entrance" duration="0.3" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="entranceSlide" key="[0.0, 1.0]" fieldToInterp="panel.translation" />
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="panel.opacity" />
    </Animation>
  </children>
  <interface>
    <field id="seriesName" type="string" />
    <field id="playingId" type="string" />
    <!-- The playing episode's season number, so the browser opens there -->
    <field id="seasonNumber" type="integer" value="-1" />
    <!-- Every episode of the series, set once the request comes back -->
    <field id="episodes" type="array" alwaysNotify="true" onChange="onEpisodesLoaded" />
    <field id="selected" type="node" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/animeMarkers.bs"
import "pkg:/source/utils/episodeBrowser.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/nouveauLayout.bs"
import "pkg:/source/utils/playbackOverlay.bs"

const PANEL_WIDTH = 1269
const PANEL_PAD_Y = 33
const PANEL_BORDER = 2
const TITLE_PAD_X = 40
const TITLE_SIZE = 33
const LOGO_HEIGHT = 60
const TITLE_PAD_BOTTOM = 20
const RULE_GAP = 13
' A set height, so changing season doesn't resize the dialog
const CONTENT_HEIGHT = 756
const TABS_LEFT = 33
const TABS_PAD_TOP = 7
const TABS_PAD_BOTTOM = 20
const LIST_PAD_X = 33
const ROW_WIDTH = 1203
' The row's 14px padding inside its 3px border
const ROW_INSET = 17
const ROW_MIN_HEIGHT = 214
const ROW_GAP = 14
const THUMB_WIDTH = 320
const THUMB_HEIGHT = 180
const TEXT_GAP = 26
const TEXT_PAD_TOP = 4
const NUMBER_GAP = 6
const PILLS_GAP = 8
const OVERVIEW_GAP = 10
const PROGRESS_INSET = 6
const PROGRESS_HEIGHT = 12
const BADGE_SIZE = 26
const BADGE_INSET = 8
' Stills load only for the rows on screen and about two rows either side, so a long season
' doesn't ask for every picture at once
const THUMB_MARGIN = 456

sub init()
    m.panel = m.top.findNode("panel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelBorder = m.top.findNode("panelBorder")
    m.logo = m.top.findNode("logo")
    m.title = m.top.findNode("title")
    m.titleRule = m.top.findNode("titleRule")
    m.seasonBar = m.top.findNode("seasonBar")
    m.viewport = m.top.findNode("viewport")
    m.rows = m.top.findNode("rows")
    m.message = m.top.findNode("message")

    playbackOverlay.SetFont(m.title, TITLE_SIZE, true)
    playbackOverlay.SetFont(m.message, 26, false)
    m.logo.observeField("loadStatus", "onLogoLoadStatus")
    m.seasonBar.observeField("selectedIndex", "onSeasonPicked")
    m.seasonBar.observeField("escape", "onSeasonBarEscape")
    m.restackTimer = CreateObject("roSGNode", "Timer")
    m.restackTimer.duration = 0.05
    m.restackTimer.observeField("fire", "onRestack")

    m.palette = playbackOverlay.Palette()
    m.hideOverview = toBoolean(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.hideMediaDescription`", false))
    m.opened = false
    m.loaded = false
    m.numbers = []
    m.buckets = {}
    m.seasonIndex = 0
    m.visuals = []
    m.focusIndex = 0
    m.scrollY = 0
    m.listHeight = CONTENT_HEIGHT
    m.contentHeight = 0
    m.zone = "rows"
end sub

sub open()
    m.opened = true
    m.panelFill.blendColor = playbackOverlay.WithAlpha(m.palette.surface, 230)
    m.panelBorder.blendColor = m.palette.chipBorder

    ' The header is the logo the player shows, since the name the server holds can be in another
    ' language than the logo people know the show by
    if isValidAndNotEmpty(m.top.logoUri) and m.top.logoAspect > 0
        logoWidth = LOGO_HEIGHT * m.top.logoAspect
        if logoWidth > PANEL_WIDTH - TITLE_PAD_X * 2 then logoWidth = PANEL_WIDTH - TITLE_PAD_X * 2
        m.logo.width = logoWidth
        m.logo.uri = m.top.logoUri
        m.logo.visible = true
    end if
    layoutPanel()
    render()
end sub

sub onLogoLoadStatus()
    if LCase(m.logo.loadStatus) <> "failed" or not m.logo.visible then return
    m.logo.visible = false
    layoutPanel()
    layoutBody()
    applyFocus()
end sub

sub layoutPanel()
    m.title.visible = not m.logo.visible
    titleHeight = LOGO_HEIGHT
    if m.title.visible
        title = m.top.seriesName
        if not isValidAndNotEmpty(title) then title = tr("Episodes")
        m.title.text = title
        m.title.width = PANEL_WIDTH - TITLE_PAD_X * 2
        titleHeight = m.title.boundingRect().height
    end if
    m.logo.translation = [TITLE_PAD_X, PANEL_PAD_Y]
    m.title.translation = [TITLE_PAD_X, PANEL_PAD_Y]

    ruleTop = PANEL_PAD_Y + titleHeight + TITLE_PAD_BOTTOM
    m.titleRule.translation = [PANEL_BORDER, ruleTop]
    m.titleRule.width = PANEL_WIDTH - PANEL_BORDER * 2
    m.contentTop = ruleTop + m.titleRule.height + RULE_GAP

    panelHeight = m.contentTop + CONTENT_HEIGHT + PANEL_PAD_Y
    for each layer in [m.panelFill, m.panelBorder]
        layer.width = PANEL_WIDTH
        layer.height = panelHeight
    end for
    m.panel.translation = [Int((1920 - PANEL_WIDTH) / 2), Int((1080 - panelHeight) / 2)]
end sub

sub onEpisodesLoaded()
    m.loaded = true
    if m.opened then render()
end sub

sub render()
    if not m.loaded
        layoutBody()
        showMessage(tr("Loading..."))
        return
    end if

    grouped = nouveauLayout.GroupEpisodesBySeason(episodeBrowser.PlayableOnly(m.top.episodes))
    m.numbers = grouped.numbers
    m.buckets = grouped.buckets
    if m.numbers.count() = 0
        layoutBody()
        showMessage(tr("Nothing here yet."))
        return
    end if

    opening = nouveauLayout.EffectiveSeason(m.numbers, m.top.seasonNumber, invalid)
    m.seasonIndex = 0
    for i = 0 to m.numbers.count() - 1
        if m.numbers[i] = opening then m.seasonIndex = i
    end for

    tabs = []
    for each number in m.numbers
        tabs.push({ id: number.toStr(), label: nouveauLayout.SeasonLabel(number) })
    end for
    m.seasonBar.maxWidth = ROW_WIDTH
    m.seasonBar.focusIndex = m.seasonIndex
    m.seasonBar.selectedIndex = m.seasonIndex
    m.seasonBar.tabs = tabs
    layoutBody()
    showSeason(true)
end sub

' The tabs only show for a series with more than one season, and the list takes their room
' when they don't
sub layoutBody()
    hasTabs = m.numbers.count() > 1
    m.seasonBar.visible = hasTabs
    listTop = m.contentTop
    if hasTabs
        m.seasonBar.translation = [TABS_LEFT, m.contentTop + TABS_PAD_TOP]
        listTop += TABS_PAD_TOP + m.seasonBar.boundingRect().height + TABS_PAD_BOTTOM
    end if
    m.listHeight = m.contentTop + CONTENT_HEIGHT - listTop

    m.viewport.translation = [0, listTop]
    m.viewport.clippingRect = [0, 0, PANEL_WIDTH, m.listHeight]
    m.message.translation = [LIST_PAD_X + 8, listTop + 24]
end sub

sub showMessage(text as string)
    clearRows()
    m.message.text = text
    m.message.visible = true
end sub

sub clearRows()
    for each visual in m.visuals
        visual.episode.unobserveFieldScoped("animeMarker")
    end for
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    m.visuals = []
end sub

' The first time, the list opens on the playing episode just below the top. A season picked on
' the tabs starts from its first episode.
sub showSeason(onPlaying as boolean)
    m.message.visible = false
    clearRows()
    season = m.buckets[m.numbers[m.seasonIndex].toStr()] ?? []

    m.focusIndex = 0
    playingRow = -1
    for i = 0 to season.count() - 1
        isPlaying = isStringEqual(season[i].id, m.top.playingId)
        m.visuals.push(buildRow(season[i], isPlaying))
        if isPlaying then playingRow = i
    end for
    stackRows()

    m.scrollY = 0
    if onPlaying and playingRow >= 0
        m.focusIndex = playingRow
        furthest = scrollLimit()
        m.scrollY = m.visuals[playingRow].top - episodeBrowser.SCROLL_PADDING
        if m.scrollY > furthest then m.scrollY = furthest
        if m.scrollY < 0 then m.scrollY = 0
    end if
    applyFocus()
end sub

function buildRow(episode as object, isPlaying as boolean) as object
    group = m.rows.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = "pkg:/images/livetv/fill15.9.png"
    fill.width = ROW_WIDTH
    border = group.createChild("Poster")
    border.uri = "pkg:/images/livetv/stroke15w3.9.png"
    border.width = ROW_WIDTH

    thumbBack = group.createChild("Rectangle")
    thumbBack.color = "#FFFFFF14"
    thumbBack.width = THUMB_WIDTH
    thumbBack.height = THUMB_HEIGHT
    thumbBack.translation = [ROW_INSET, ROW_INSET]
    thumb = group.createChild("Poster")
    thumb.width = THUMB_WIDTH
    thumb.height = THUMB_HEIGHT
    thumb.loadDisplayMode = "scaleToZoom"
    thumb.translation = [ROW_INSET, ROW_INSET]

    fraction = episodeBrowser.WatchedFraction(episode)
    if fraction > 0
        trackWidth = THUMB_WIDTH - PROGRESS_INSET * 2
        trackTop = ROW_INSET + THUMB_HEIGHT - PROGRESS_INSET - PROGRESS_HEIGHT
        track = group.createChild("Poster")
        track.uri = "pkg:/images/livetv/fill6.9.png"
        track.blendColor = "#0000008A"
        track.width = trackWidth
        track.height = PROGRESS_HEIGHT
        track.translation = [ROW_INSET + PROGRESS_INSET, trackTop]
        barWidth = Int(trackWidth * fraction)
        if barWidth < PROGRESS_HEIGHT then barWidth = PROGRESS_HEIGHT
        bar = group.createChild("Poster")
        bar.uri = "pkg:/images/livetv/fill6.9.png"
        bar.blendColor = m.palette.accent
        bar.width = barWidth
        bar.height = PROGRESS_HEIGHT
        bar.translation = [ROW_INSET + PROGRESS_INSET, trackTop]
    end if
    if chainLookupReturn(episode, "json.UserData.Played", false) = true
        check = group.createChild("PlayedCheckmark")
        check.width = BADGE_SIZE
        check.height = BADGE_SIZE
        check.translation = [ROW_INSET + THUMB_WIDTH - BADGE_INSET - BADGE_SIZE, ROW_INSET + BADGE_INSET]
        check.data = { played: true }
    end if

    textLeft = ROW_INSET + THUMB_WIDTH + TEXT_GAP
    textWidth = ROW_WIDTH - textLeft - ROW_INSET
    lineLabel = group.createChild("Label")
    playbackOverlay.SetFont(lineLabel, 22, true)
    lineLabel.color = "#FFFFFF99"
    lineLabel.width = textWidth
    lineLabel.text = episodeBrowser.RowLine(episode)

    nameLabel = group.createChild("Label")
    playbackOverlay.SetFont(nameLabel, 30, true)
    nameLabel.color = "#FFFFFF"
    nameLabel.wrap = true
    nameLabel.width = textWidth
    nameLabel.text = chainLookupReturn(episode, "json.Name", "")

    overviewLabel = invalid
    overview = chainLookupReturn(episode, "json.Overview", "")
    if not m.hideOverview and isValidAndNotEmpty(overview)
        overviewLabel = group.createChild("Label")
        playbackOverlay.SetFont(overviewLabel, 22, false)
        overviewLabel.color = "#FFFFFFB8"
        overviewLabel.wrap = true
        overviewLabel.maxLines = 3
        overviewLabel.width = textWidth
        overviewLabel.text = overview
    end if

    visual = {
        group: group, fill: fill, border: border, thumb: thumb, episode: episode, isPlaying: isPlaying,
        textLeft: textLeft, textWidth: textWidth, pills: invalid,
        lineLabel: lineLabel, nameLabel: nameLabel, overviewLabel: overviewLabel,
        lineHeight: lineLabel.boundingRect().height, nameHeight: nameLabel.boundingRect().height,
        overviewHeight: 0, top: 0, height: ROW_MIN_HEIGHT
    }
    if isValid(overviewLabel) then visual.overviewHeight = overviewLabel.boundingRect().height

    ' Filler, canon, recap and subbed or dubbed, when the server knows them for this series
    lookup = animeMarkers.LookupFor(episode.json)
    if isValid(lookup) and animeMarkerStore().callFunc("requestMarker", { node: episode, lookup: lookup })
        episode.observeFieldScoped("animeMarker", "onRowMarker")
        drawRowPills(visual, episode.animeMarker)
    end if
    layoutRow(visual)
    return visual
end function

sub drawRowPills(visual as object, marker as dynamic)
    if not isValid(visual.pills)
        if not animeMarkers.HasPills(marker) then return
        visual.pills = visual.group.createChild("AnimeMarkerPills")
        visual.pills.pillSize = "compact"
        visual.pills.maxWidth = visual.textWidth
    end if
    visual.pills.marker = marker ?? {}
end sub

sub onRowMarker(event as object)
    node = event.getRoSGNode()
    for each visual in m.visuals
        if visual.episode.isSameNode(node)
            drawRowPills(visual, node.animeMarker)
            layoutRow(visual)
            ' One answer stamps every episode of the series at once, so the rows move once after it
            m.restackTimer.control = "start"
            return
        end if
    end for
end sub

sub onRestack()
    stackRows()
    applyFocus()
end sub

' Stacks the row's number, title, pills and overview, and makes the row as tall as they need
sub layoutRow(visual as object)
    y = ROW_INSET + TEXT_PAD_TOP
    visual.lineLabel.translation = [visual.textLeft, y]
    y += visual.lineHeight + NUMBER_GAP
    visual.nameLabel.translation = [visual.textLeft, y]
    y += visual.nameHeight
    if isValid(visual.pills) and visual.pills.visible
        y += PILLS_GAP
        visual.pills.translation = [visual.textLeft, y]
        y += visual.pills.rowHeight
    end if
    if isValid(visual.overviewLabel)
        y += OVERVIEW_GAP
        visual.overviewLabel.translation = [visual.textLeft, y]
        y += visual.overviewHeight
    end if

    visual.height = y + ROW_INSET
    if visual.height < ROW_MIN_HEIGHT then visual.height = ROW_MIN_HEIGHT
    visual.fill.height = visual.height
    visual.border.height = visual.height
end sub

sub stackRows()
    top = 0
    for each visual in m.visuals
        visual.group.translation = [LIST_PAD_X, top]
        visual.top = top
        top += visual.height + ROW_GAP
    end for
    m.contentHeight = top
end sub

function scrollLimit() as float
    furthest = m.contentHeight - m.listHeight
    if furthest < 0 then return 0
    return furthest
end function

' Only the row with the remote gets the accent border, so it can't be mistaken for the playing
' one, which keeps a lighter wash
sub applyFocus()
    for i = 0 to m.visuals.count() - 1
        visual = m.visuals[i]
        if m.zone = "rows" and i = m.focusIndex
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 77)
            visual.border.blendColor = m.palette.accent
            visual.border.visible = true
        else if visual.isPlaying
            visual.fill.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 46)
            visual.border.blendColor = playbackOverlay.WithAlpha(m.palette.accent, 128)
            visual.border.visible = true
        else
            visual.fill.blendColor = "#FFFFFF0F"
            visual.border.visible = false
        end if

        if visual.thumb.uri = "" and visual.top < m.scrollY + m.listHeight + THUMB_MARGIN and visual.top + visual.height > m.scrollY - THUMB_MARGIN
            visual.thumb.uri = visual.episode.posterURL
        end if
    end for
    m.rows.translation = [0, -m.scrollY]
end sub

sub focusRow(index as integer)
    m.focusIndex = index
    visual = m.visuals[index]
    m.scrollY = episodeBrowser.ScrollToShow(m.scrollY, visual.top, visual.height, m.listHeight, scrollLimit())
    applyFocus()
end sub

sub onSeasonPicked()
    index = m.seasonBar.selectedIndex
    if index < 0 or index >= m.numbers.count() or index = m.seasonIndex then return
    m.seasonIndex = index
    showSeason(false)
end sub

' Down from the tabs lands on the topmost row in view
sub onSeasonBarEscape()
    if m.seasonBar.escape <> "down" or m.visuals.count() = 0 then return
    target = m.visuals.count() - 1
    for i = 0 to m.visuals.count() - 1
        if m.visuals[i].top + m.visuals[i].height > m.scrollY
            target = i
            exit for
        end if
    end for
    m.zone = "rows"
    m.seasonBar.setFocus(false)
    m.top.setFocus(true)
    focusRow(target)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = KeyCode.BACK
        m.top.dismissed = true
        return true
    end if
    ' Play and pause reach the player, everything else stays in the browser
    if m.zone = "tabs" then return key <> KeyCode.PLAY
    return onRowsKey(key)
end function

function onRowsKey(key as string) as boolean
    if key = KeyCode.UP
        if m.focusIndex > 0
            focusRow(m.focusIndex - 1)
        else if m.seasonBar.visible
            m.zone = "tabs"
            m.seasonBar.focusIndex = m.seasonIndex
            m.seasonBar.setFocus(true)
            applyFocus()
        end if
        return true
    end if
    if key = KeyCode.DOWN
        if m.focusIndex < m.visuals.count() - 1 then focusRow(m.focusIndex + 1)
        return true
    end if
    if key = KeyCode.OK
        if m.focusIndex < m.visuals.count() then m.top.selected = m.visuals[m.focusIndex].episode
        return true
    end if
    return key <> KeyCode.PLAY
end function

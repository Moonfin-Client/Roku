import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playbackOverlay.bs"

' Sizes are the other clients' values scaled by 1.45, which is how they map
' their TV layout onto 1920x1080
const PAD_LEFT = 29
const PAD_RIGHT = 23
const HEIGHT = 82
const ICON_SIZE = 29
const ICON_GAP = 13
const TIMER_GAP = 12
const RING_GAP = 19
const RING_SIZE = 52

sub init()
    m.border = m.top.findNode("border")
    m.fill = m.top.findNode("fill")
    m.icon = m.top.findNode("icon")
    m.label = m.top.findNode("label")
    m.timer = m.top.findNode("timer")
    m.ring = m.top.findNode("ring")
    m.ringTrack = m.top.findNode("ringTrack")
    m.ringProgress = m.top.findNode("ringProgress")
    m.ringIcon = m.top.findNode("ringIcon")
    m.ringNumber = m.top.findNode("ringNumber")

    ' A Font node needs a real font file, so the size goes on the system font
    m.label.font.size = 22
    m.timer.font.size = 20
    m.ringNumber.font.size = 20

    m.top.observeField("segmentType", "onContentChanged")
    m.top.observeField("secondsRemaining", "onContentChanged")
    m.top.observeField("progress", "onProgressChanged")
    m.top.observeField("showRing", "onContentChanged")
    m.top.observeField("showTimer", "onContentChanged")
    m.top.observeField("palette", "onPaletteChanged")

    onPaletteChanged()
end sub

sub onPaletteChanged()
    palette = m.top.palette
    if not isValidAndNotEmpty(palette) then palette = playbackOverlay.Palette()

    m.border.blendColor = palette.accent
    m.icon.blendColor = palette.accent
    m.ringProgress.blendColor = palette.accent
    m.ringIcon.blendColor = palette.accent

    m.fill.blendColor = palette.surface
    m.label.color = palette.onSurface
    m.ringNumber.color = palette.onSurface
    m.timer.color = playbackOverlay.WithAlpha(palette.onSurface, 128)
    m.ringTrack.blendColor = playbackOverlay.WithAlpha(palette.onSurface, 41)
end sub

sub onProgressChanged()
    uri = `pkg:/images/playback/ring36/${playbackOverlay.RingFrame(m.top.progress)}.png`
    if not isStringEqual(m.ringProgress.uri, uri) then m.ringProgress.uri = uri
end sub

' Core shows the seconds inside the ring once under a minute is left, and puts
' the timer beside the label the rest of the time
sub onContentChanged()
    seconds = m.top.secondsRemaining
    if seconds < 0 then seconds = 0

    showRing = m.top.showRing
    numberInRing = m.top.showTimer and showRing and seconds < 60
    showInlineTimer = m.top.showTimer and not numberInRing

    m.label.text = tr("Skip {segment}").Replace("{segment}", playbackOverlay.SegmentLabel(m.top.segmentType))

    m.ring.visible = showRing
    m.ringNumber.visible = numberInRing
    m.ringIcon.visible = not numberInRing
    if numberInRing then m.ringNumber.text = seconds.toStr()

    m.timer.visible = showInlineTimer
    if showInlineTimer
        m.timer.text = tr("Ends in {time}").Replace("{time}", playbackOverlay.ClockText(seconds))
    end if

    layoutOverlay(showRing, showInlineTimer)
end sub

sub layoutOverlay(showRing as boolean, showInlineTimer as boolean)
    cursor = PAD_LEFT + ICON_SIZE + ICON_GAP

    m.label.translation = [cursor, 0]
    cursor += m.label.boundingRect().width

    if showInlineTimer
        cursor += TIMER_GAP
        m.timer.translation = [cursor, 0]
        cursor += m.timer.boundingRect().width
    end if

    if showRing
        cursor += RING_GAP
        m.ring.translation = [cursor, (HEIGHT - RING_SIZE) / 2]
        cursor += RING_SIZE
    end if

    width = cursor + PAD_RIGHT
    m.border.width = width
    m.fill.width = width
    m.top.overlayWidth = width
end sub

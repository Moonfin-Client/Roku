import "pkg:/source/utils/watchPartyModel.bs"

' A watch party's hold on the player, with every name starting with wp so the player's own stay clear.

const WPP_TICK_SECONDS = 0.5
const WPP_REPORT_SECONDS = 2
' The ready wait hears from each player more often, so the start isn't held up
const WPP_WAITING_REPORT_SECONDS = 0.5
' After a correcting seek the stream needs a moment before drift means anything again
const WPP_SETTLE_SECONDS = 5
const WPP_MAX_LEAD = 5
' The server starts anyway this long after a start, whoever isn't ready
const WPP_READY_WAIT_SECONDS = 10
' A transcode left paused this long may be gone from the server, and picking it up again jumps
const WPP_STALE_PAUSE_SECONDS = 30
' About how long a reloaded stream takes to play
const WPP_RELOAD_SECONDS = 2.5
' Near the end the player is left to run out, since a seek past it starts the stream over
const WPP_END_SECONDS = 2

sub wpAttach()
    m.wp = invalid
    party = m.global.watchParty
    if not isValid(party) or not party.inRoom then return
    room = party.room
    if room.phase <> "playing" or toString(room.selected_content_id ?? "") <> m.top.id then return

    m.wp = {
        session: party,
        loaded: false,
        holding: room.playback_state = "waiting",
        reference: watchPartyModel.ReferenceFromRoom(room),
        pending: invalid,
        commandId: "",
        expectPaused: invalid,
        ourSeek: -1,
        userSeek: -1,
        lead: 0.5,
        corrected: false,
        settleAt: 0,
        landingUntil: 0,
        lineUp: false,
        pausedAt: 0,
        playing: false,
        positionAt: -1,
        reportedAt: -100,
        buffering: false,
        clock: CreateObject("roTimespan"),
        panel: invalid
    }

    ' A player opening on a paused room starts out playing, so it pauses where the room is
    if not m.wp.holding and not m.wp.reference.playing
        m.wp.expectPaused = true
        m.wp.lineUp = true
    end if

    overlay = CreateObject("roSGNode", "WatchPartyOverlay")
    overlay.observeField("quickBarClosed", "wpOnQuickBarClosed")
    overlay.peopleVisible = m.osd.visible
    m.top.appendChild(overlay)
    m.wp.overlay = overlay
    m.osd.inParty = true
    m.osd.observeFieldScoped("visible", "wpOnControlsVisible")

    party.observeFieldScoped("command", "wpOnCommand")
    party.observeFieldScoped("room", "wpOnRoom")
    party.observeFieldScoped("inRoom", "wpOnInRoom")
    ' Scoped, so the party lets go of them without taking the player's own observers along
    m.top.observeFieldScoped("state", "wpOnState")
    m.top.observeFieldScoped("seek", "wpOnSeek")
    m.top.observeFieldScoped("position", "wpOnPosition")

    m.wpTicker = CreateObject("roSGNode", "Timer")
    m.wpTicker.duration = WPP_TICK_SECONDS
    m.wpTicker.repeat = true
    m.wpTicker.observeField("fire", "wpTick")
    m.wpTicker.control = "start"
    m.wpCommandTimer = CreateObject("roSGNode", "Timer")
    m.wpCommandTimer.repeat = false
    m.wpCommandTimer.observeField("fire", "wpRunPending")
    m.wpSeekTimer = CreateObject("roSGNode", "Timer")
    m.wpSeekTimer.duration = 0.6
    m.wpSeekTimer.repeat = false
    m.wpSeekTimer.observeField("fire", "wpSendUserSeek")

    ' The start that sent everyone here can land before this player existed
    last = party.command
    if type(last) = "roAssociativeArray" and last.playback_state = "waiting" and room.playback_state = "waiting" then wpSchedule(last)
    if m.wp.holding then wpShowWaiting()
    if room.chat_enabled <> false or room.reactions_enabled <> false then party.toast = { text: tr("Chat and reactions are in the controls") }
end sub

function wpActive() as boolean
    return isValid(m.wp)
end function

' Holding at the start until the room says go, when the controls stay away
function wpHolding() as boolean
    return isValid(m.wp) and m.wp.holding
end function

' The player keeps going on its own once the party's over, and a viewer who closes the video stays
' in the party as not watching.
sub wpDetach(closedByViewer = false as boolean)
    if not isValid(m.wp) then return
    party = m.wp.session
    if closedByViewer and party.inRoom then party.callFunc("send", [{ "type": "state_report", "session_id": invalid, "position_seconds": 0, "is_paused": true, "status": "not_watching" }])
    for each name in ["command", "room", "inRoom"]
        party.unobserveFieldScoped(name)
    end for
    for each name in ["state", "seek", "position"]
        m.top.unobserveFieldScoped(name)
    end for
    m.osd.unobserveFieldScoped("visible")
    m.wpTicker.control = "stop"
    m.wpCommandTimer.control = "stop"
    m.wpSeekTimer.control = "stop"
    wpClosePanel()
    m.wp.overlay.callFunc("release")
    m.wp.overlay.setFocus(false)
    m.top.setFocus(true)
    m.top.removeChild(m.wp.overlay)
    m.osd.inParty = false
    m.wp = invalid
end sub

sub wpOnControlsVisible()
    if isValid(m.wp) then m.wp.overlay.peopleVisible = m.osd.visible
end sub

sub wpOnInRoom()
    if isValid(m.wp) and not m.wp.session.inRoom then wpDetach()
end sub

' Back in the lobby the video closes, the way it does for everyone
sub wpOnRoom()
    if not isValid(m.wp) then return
    room = m.wp.session.room
    if room.phase = "lobby"
        wpDetach()
        active = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(active) and active.isSameNode(m.top)
            m.global.queueManager.callFunc("clear")
            m.top.control = "stop"
            m.global.sceneManager.callFunc("popScene")
        end if
        return
    end if
    ' The anchor follows the host's reports, except one a command set for later, which waits for the
    ' command.
    anchorAt = watchPartyModel.ParseTime(room.anchor_at)
    if not m.wp.holding and not isValid(m.wp.pending) and anchorAt > 0 and anchorAt <= m.wp.session.callFunc("serverNow")
        m.wp.reference = watchPartyModel.ReferenceFromRoom(room)
    end if
    if m.wp.holding and not isValid(m.wp.pending) then wpShowWaiting()
end sub

' ===== Commands =====

sub wpOnCommand(event as object)
    if isValid(m.wp) then wpSchedule(event.getData())
end sub

sub wpSchedule(command as object)
    m.wp.pending = command
    delay = watchPartyModel.DelayUntil(watchPartyModel.ParseTime(command.execute_at), m.wp.session.callFunc("serverNow"))
    if command.countdown = true then m.wp.overlay.center = { mode: "countdown", seconds: delay }
    if delay < 0.05
        wpRunPending()
        return
    end if
    m.wpCommandTimer.control = "stop"
    m.wpCommandTimer.duration = delay
    m.wpCommandTimer.control = "start"
end sub

sub wpRunPending()
    if not isValid(m.wp) or not isValid(m.wp.pending) then return
    command = m.wp.pending
    m.wp.pending = invalid
    m.wp.reference = watchPartyModel.ReferenceFromCommand(command)
    m.wp.commandId = toString(command.command_id ?? "")
    m.wp.corrected = false
    m.wp.settleAt = m.wp.clock.TotalMilliseconds() / 1000 + WPP_SETTLE_SECONDS
    ' Whatever seek was landing has landed or is replaced, so only a seek for this command counts
    m.wp.landingUntil = 0

    if command.playback_state = "waiting"
        m.wp.holding = true
        wpShowWaiting()
        if m.wp.loaded then wpHoldAt(m.wp.reference.position)
        return
    end if

    ' A held start already lined up paused, and a paused seek can leave the position stale until
    ' the player plays
    held = m.wp.holding
    m.wp.holding = false
    m.wp.overlay.center = {}
    if m.wp.reference.playing
        target = watchPartyModel.ExpectedPosition(m.wp.reference, m.wp.session.callFunc("serverNow"))
        ' The viewer's own seek already took the player there
        ownSeek = command.action = "seek" and toString(command.by_member_id ?? "") = m.wp.session.callFunc("selfId")
        if not ownSeek and not held and watchPartyModel.NeedsSeek(target, wpPosition()) and not wpNearEnd(target)
            ' A seek lands a moment late, so it aims ahead by the lead the drift checks learn
            wpSeek(target + m.wp.lead)
            m.wp.corrected = true
        end if
        stale = m.wp.clock.TotalMilliseconds() / 1000 - m.wp.pausedAt > WPP_STALE_PAUSE_SECONDS
        if m.top.state = "paused" and stale and m.isTranscoded = true
            ' So the stream starts afresh where the room will be once it plays
            m.wp.expectPaused = invalid
            m.wp.landingUntil = m.wp.clock.TotalMilliseconds() / 1000 + WPP_SETTLE_SECONDS
            retryPlaybackFromServer(target + WPP_RELOAD_SECONDS)
        else if m.top.state = "paused"
            m.wp.expectPaused = false
            m.top.control = "resume"
        else if m.top.state = "buffering"
            m.wp.expectPaused = false
        else if m.top.state <> "playing" and m.top.state <> "finished"
            m.wp.expectPaused = false
            m.top.control = "play"
        end if
    else
        m.wp.lineUp = true
        if m.top.state = "paused"
            wpLineUp()
        else
            m.wp.expectPaused = true
            m.top.control = "pause"
        end if
    end if
    ' A player told to play is still paused for a moment, so it reports once it plays, or the room
    ' would hear it paused and mark it catching up
    if m.wp.reference.playing and m.top.state <> "playing"
        m.wp.reportedAt = -100
    else
        wpReport()
    end if
end sub

' A paused player can seek to where the room stopped without anyone seeing it, once per command
' since a seek can land a little off.
sub wpLineUp()
    if not m.wp.lineUp then return
    m.wp.lineUp = false
    if m.wp.reference.playing or not watchPartyModel.NeedsSeek(m.wp.reference.position, m.top.position, true) then return
    m.wp.expectPaused = true
    wpSeek(m.wp.reference.position)
end sub

function wpNearEnd(target as double) as boolean
    return m.top.duration > 0 and target > m.top.duration - WPP_END_SECONDS
end function

' The player notes its position every half second, so in between it's carried on by the clock
function wpPosition() as double
    position = m.top.position + 0#
    if not m.wp.playing or m.wp.positionAt < 0 then return position
    gap = m.wp.clock.TotalMilliseconds() / 1000 - m.wp.positionAt
    if gap > 0 and gap < 1 then position += gap
    return position
end function

sub wpOnPosition()
    if isValid(m.wp) then m.wp.positionAt = m.wp.clock.TotalMilliseconds() / 1000
end sub

' Paused where the room starts, which is when this device is ready
sub wpHoldAt(position as double)
    if m.top.state <> "paused"
        m.wp.expectPaused = true
        m.top.control = "pause"
    end if
    if watchPartyModel.NeedsSeek(position, m.top.position, true) then wpSeek(position)
end sub

sub wpSeek(target as double)
    if target < 0 then target = 0
    m.wp.landingUntil = m.wp.clock.TotalMilliseconds() / 1000 + WPP_SETTLE_SECONDS
    m.wp.ourSeek = target
    m.top.seek = target
end sub

' Whose players the start waits on, and how long it still will
sub wpShowWaiting()
    room = m.wp.session.room
    names = []
    if type(room.members) = "roArray"
        for each member in room.members
            if member.connected <> false and member.is_self <> true and member.status <> "ready" and member.status <> "in_sync" and member.status <> "not_watching" then names.push(toString(member.display_name ?? ""))
        end for
    end if
    last = m.wp.session.command
    seconds = WPP_READY_WAIT_SECONDS
    if type(last) = "roAssociativeArray" and last.playback_state = "waiting"
        seconds = watchPartyModel.ParseTime(last.execute_at) + WPP_READY_WAIT_SECONDS - m.wp.session.callFunc("serverNow")
    end if
    m.wp.overlay.center = { mode: "waiting", names: names, seconds: seconds }
end sub

' ===== What this viewer does =====

function wpRoomAllows(action as string) as boolean
    room = m.wp.session.room
    if room.self_role = "host" then return true
    policy = room.guest_control_policy
    if policy = "everyone" then return true
    return policy = "guests_can_pause" and action <> "seek"
end function

sub wpRefuse()
    m.wp.session.toast = { text: tr("Only the host can control playback.") }
end sub

sub wpRequest(action as string, position as double, paused as boolean)
    m.wp.session.callFunc("send", [{ "type": "transport_request", "action": action, "position_seconds": position, "is_paused": paused }])
end sub

sub wpOnState()
    if not isValid(m.wp) then return
    state = m.top.state
    ' Where it was as the state changed, and the clock carries it on again from the next note
    position = wpPosition()
    m.wp.playing = state = "playing"
    m.wp.positionAt = -1
    if state = "paused" then m.wp.pausedAt = m.wp.clock.TotalMilliseconds() / 1000

    if state = "playing" and not m.wp.loaded
        m.wp.loaded = true
        if m.wp.holding
            wpHoldAt(m.wp.reference.position)
            return
        end if
    end if

    if state = "buffering"
        wpNoteStall()
        return
    end if
    m.wp.buffering = false

    if m.wp.holding
        if state = "paused"
            m.wp.expectPaused = invalid
            wpReport()
        else if state = "playing"
            ' A seek to the start can land playing, and the start is the room's to give
            m.top.control = "pause"
        end if
        return
    end if

    ' A state the room asked for, asked again if the player landed on the other one
    if isValid(m.wp.expectPaused)
        if (state = "paused") = m.wp.expectPaused
            m.wp.expectPaused = invalid
            if state = "paused" then wpLineUp()
            ' A paused seek has landed once the player is paused again with nothing more to line up,
            ' and the room only hears so from a report, since none go out while paused
            if state = "paused" and not isValid(m.wp.expectPaused) and m.wp.landingUntil > 0
                m.wp.landingUntil = 0
                wpReport()
            end if
        else if state = "paused"
            m.top.control = "resume"
        else if state = "playing"
            m.top.control = "pause"
        end if
        return
    end if

    ' A command about to run decides instead, and a player that never played has nothing to ask for.
    if isValid(m.wp.pending) or not m.wp.loaded then return
    ' The player can change state by itself, such as resuming after it switches the audio track, and
    ' only a change right after a key press is the viewer's
    viewers = CreateObject("roDeviceInfo").TimeSinceLastKeypress() <= 2
    if state = "paused" and m.wp.reference.playing
        if viewers and wpRoomAllows("pause")
            wpRequest("pause", position, true)
        else
            if viewers then wpRefuse()
            m.wp.expectPaused = false
            m.top.control = "resume"
        end if
    else if state = "playing" and not m.wp.reference.playing
        ' The room's play starts everyone at its time from where the room paused, this player too,
        ' so it waits paused for it
        if viewers and wpRoomAllows("play") then wpRequest("play", m.wp.reference.position, false)
        if viewers and not wpRoomAllows("play") then wpRefuse()
        m.wp.expectPaused = true
        m.wp.lineUp = true
        m.top.control = "pause"
    end if
end sub

' A seek still landing isn't a stall, since a host's stall pauses the room and a paused room has
' nothing to wait for.
sub wpNoteStall()
    if m.wp.buffering or not m.wp.loaded or m.wp.holding or not m.wp.reference.playing then return
    if m.wp.clock.TotalMilliseconds() / 1000 < m.wp.landingUntil then return
    m.wp.buffering = true
    m.wp.session.callFunc("send", [{ "type": "buffering", "position_seconds": m.top.position, "is_paused": false }])
end sub

sub wpOnSeek(event as object)
    if not isValid(m.wp) then return
    target = event.getData()
    if m.wp.ourSeek >= 0 and Abs(target - m.wp.ourSeek) < 0.01
        m.wp.ourSeek = -1
        return
    end if
    if m.wp.holding or not m.wp.loaded then return
    if not wpRoomAllows("seek")
        wpRefuse()
        wpSeek(watchPartyModel.ExpectedPosition(m.wp.reference, m.wp.session.callFunc("serverNow")))
        return
    end if
    ' A held key seeks many times, so only where it lands goes to the room, and drift waits for it too.
    m.wp.userSeek = target
    m.wp.settleAt = m.wp.clock.TotalMilliseconds() / 1000 + WPP_SETTLE_SECONDS
    m.wp.landingUntil = m.wp.settleAt
    m.wpSeekTimer.control = "stop"
    m.wpSeekTimer.control = "start"
end sub

sub wpSendUserSeek()
    if not isValid(m.wp) or m.wp.userSeek < 0 then return
    wpRequest("seek", m.wp.userSeek, m.top.state = "paused")
    m.wp.userSeek = -1
end sub

' ===== Reports and drift =====

sub wpTick()
    if not isValid(m.wp) then return
    ' A player that closed some other way has left the screen
    if not isValid(m.top.getParent())
        wpDetach(true)
        return
    end if
    elapsed = m.wp.clock.TotalMilliseconds() / 1000
    ' A seek that is still loading once its landing time is up has stalled
    if m.top.state = "buffering" then wpNoteStall()

    if m.wp.holding
        if elapsed - m.wp.reportedAt >= WPP_WAITING_REPORT_SECONDS then wpReport()
        return
    end if

    room = m.wp.session.room
    playing = m.top.state = "playing"
    if playing and m.wp.reference.playing and room.self_role <> "host" and not isValid(m.wp.pending) and elapsed >= m.wp.settleAt
        expected = watchPartyModel.ExpectedPosition(m.wp.reference, m.wp.session.callFunc("serverNow"))
        position = wpPosition()
        if watchPartyModel.NeedsSeek(expected, position) and not wpNearEnd(expected)
            ' Each seek aims ahead by however far the last one fell short, but a miss bigger than any
            ' lead is the stream jumping, not the seek.
            if m.wp.corrected and Abs(expected - position) < WPP_MAX_LEAD then m.wp.lead = m.wp.lead + (expected - position)
            if m.wp.lead < 0 then m.wp.lead = 0
            if m.wp.lead > WPP_MAX_LEAD then m.wp.lead = WPP_MAX_LEAD
            wpSeek(expected + m.wp.lead)
            m.wp.corrected = true
            m.wp.settleAt = elapsed + WPP_SETTLE_SECONDS
        else
            m.wp.corrected = false
        end if
    end if

    if playing and elapsed - m.wp.reportedAt >= WPP_REPORT_SECONDS then wpReport()
end sub

' The server judges in step or catching up from the position, so a report only names its status
' while waiting to start, or while a seek of this player's own is still landing.
sub wpReport()
    elapsed = m.wp.clock.TotalMilliseconds() / 1000
    m.wp.reportedAt = elapsed
    report = {
        "type": "state_report",
        "session_id": wpSessionId(),
        "command_id": m.wp.commandId,
        "position_seconds": wpPosition(),
        "is_paused": m.top.state <> "playing",
        "is_ready": true
    }
    if m.wp.holding
        report["is_ready"] = m.wp.loaded and m.top.state = "paused"
        ' The countdown's play has put the ready ones in sync, which a status here would undo
        countdown = isValid(m.wp.pending) and m.wp.pending.playback_state <> "waiting"
        if not countdown
            report["status"] = "joining"
            if report["is_ready"] then report["status"] = "ready"
        end if
    else if not m.wp.buffering and elapsed < m.wp.landingUntil
        report["status"] = "catching_up"
    end if
    m.wp.session.callFunc("send", [report])
end sub

' A report needs a session to count, and the item stands in until the stream brings its play
' session id.
function wpSessionId() as string
    if isValidAndNotEmpty(m.top.PlaySessionId) then return m.top.PlaySessionId
    return m.top.id
end function

' ===== Panel and quick bar =====

sub wpOpenQuickBar()
    if not isValid(m.wp) then return
    handleHideAction(false)
    m.wp.overlay.quickBarOpen = true
end sub

sub wpOnQuickBarClosed()
    if not isValid(m.wp) then return
    m.wp.overlay.setFocus(false)
    m.top.setFocus(true)
end sub

sub wpOpenPanel()
    if not isValid(m.wp) or isValid(m.wp.panel) then return
    handleHideAction(false)
    panel = CreateObject("roSGNode", "WatchPartyPanel")
    panel.observeField("closed", "wpClosePanel")
    m.top.appendChild(panel)
    panel.setFocus(true)
    m.wp.panel = panel
end sub

sub wpClosePanel()
    if not isValid(m.wp) or not isValid(m.wp.panel) then return
    panel = m.wp.panel
    m.wp.panel = invalid
    panel.unobserveField("closed")
    panel.callFunc("release")
    panel.setFocus(false)
    m.top.setFocus(true)
    m.top.removeChild(panel)
end sub

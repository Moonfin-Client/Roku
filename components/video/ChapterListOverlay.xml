<?xml version="1.0" encoding="utf-8"?>
<component name="ChapterListOverlay" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#000000F2" />
    <Group id="panel">
      <Poster id="panelFill" uri="pkg:/images/tracks/panel20.9.png" width="1800" blendColor="#181818F0" />
      <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="1800" blendColor="#FFFFFF29" />
      <Label id="title" color="#FFFFFF" translation="[36, 30]" />
      <Rectangle id="titleRule" width="1796" height="1" translation="[2, 0]" color="#FFFFFF14" />
      <Group id="viewport">
        <Group id="rows" />
      </Group>
      <Label id="footer" color="#FFFFFF6B" horizAlign="center" width="1800" />
    </Group>
    <Animation id="entrance" duration="0.3" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="entranceSlide" key="[0.0, 1.0]" fieldToInterp="panel.translation" />
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="panel.opacity" />
    </Animation>
  </children>
  <interface>
    <!-- [{ name, startSeconds, thumbUrl }] in playback order, thumbUrl "" when the chapter has no image.
         Cast & Crew passes a caption in place of the start. -->
    <field id="chapters" type="array" />
    <field id="currentIndex" type="integer" value="0" />
    <!-- The title over the row, Chapters when left empty -->
    <field id="heading" type="string" value="" />
    <!-- Round photos for people in place of the chapters' wide frames -->
    <field id="round" type="boolean" value="false" />
    <!-- The start of the chapter picked, in seconds, and which card it was -->
    <field id="selected" type="float" alwaysNotify="true" />
    <field id="selectedIndex" type="integer" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>

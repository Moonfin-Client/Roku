<?xml version="1.0" encoding="utf-8"?>

<!-- Skip Intro / Skip Outro capsule, matching the overlay the other clients show.
     They author their TV layout at 1920/1.45 and scale it up, so every size here
     is the Core value times 1.45. -->
<component name="SkipSegmentOverlay" extends="Group">
  <interface>
    <field id="segmentType" type="string" />
    <field id="secondsRemaining" type="integer" value="0" />
    <field id="progress" type="float" value="1.0" />
    <field id="showRing" type="boolean" value="true" />
    <field id="showTimer" type="boolean" value="true" />
    <field id="palette" type="assocarray" />
    <field id="overlayWidth" type="float" value="0" />
    <field id="overlayHeight" type="float" value="82" />
  </interface>

  <children>
    <Poster id="border" uri="pkg:/images/playback/outline41.9.png" height="82" />
    <Poster id="fill" uri="pkg:/images/playback/surface41.9.png" blendColor="0x1A1A1AFF" opacity="0.55" height="82" />

    <Poster id="icon" uri="pkg:/images/playback/skip_next.png" width="29" height="29" translation="[29, 27]" />

    <Label id="label" vertAlign="center" height="82" color="0xFFFFFFFF" translation="[71, 0]" font="font:MediumBoldSystemFont" />

    <Label id="timer" vertAlign="center" height="82" color="0xFFFFFF80" font="font:MediumBoldSystemFont" />

    <Group id="ring">
      <Poster id="ringTrack" uri="pkg:/images/playback/ring36/40.png" width="52" height="52" blendColor="0xFFFFFF29" />
      <Poster id="ringProgress" uri="pkg:/images/playback/ring36/40.png" width="52" height="52" />
      <Poster id="ringIcon" uri="pkg:/images/playback/skip_next_sm.png" width="22" height="22" translation="[15, 15]" />
      <Label id="ringNumber" width="52" height="52" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false" font="font:MediumBoldSystemFont" />
    </Group>
  </children>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A channel the live recovery gave up on. It stays up until the viewer retries, tunes elsewhere or
     leaves, and Retry always holds focus, so OK retries. -->
<component name="LiveFailedCard" extends="Group">
  <interface>
    <field id="channelName" type="string" onChange="layoutCard" />
    <field id="retry" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Group id="card">
      <Poster id="cardFill" uri="pkg:/images/livetv/fill28.9.png" blendColor="#000000DE" />
      <Poster id="cardBorder" uri="pkg:/images/livetv/stroke28w1.9.png" blendColor="#FFFFFF1A" />
      <Label id="message" color="#FFFFFF" horizAlign="center" />
      <Group id="retryButton">
        <Poster id="retryFill" uri="pkg:/images/livetv/fill6.9.png" />
        <Label id="retryLabel" horizAlign="center" vertAlign="center" />
      </Group>
    </Group>
  </children>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- A round player control: a glyph or a short text, with a faint fill
     and a white ring while it has focus -->
<component name="OsdButton" extends="Group">
  <children>
    <Poster id="fill" uri="pkg:/images/playback/dot84.webp" width="84" height="84" blendColor="#FFFFFF" opacity="0.22" visible="false" />
    <Poster id="ring" uri="pkg:/images/playback/ring84s3.webp" width="84" height="84" visible="false" />
    <Label id="face" width="84" height="84" horizAlign="center" vertAlign="center" color="#FFFFFF" />
  </children>
  <interface>
    <!-- A name from the icon font, or a few characters of text in its place -->
    <field id="glyph" type="string" onChange="render" />
    <field id="text" type="string" onChange="render" />
    <field id="iconColor" type="color" value="#FFFFFF" onChange="render" />
    <field id="label" type="string" />
    <field id="focus" type="boolean" onChange="onFocusChanged" />
  </interface>
</component>

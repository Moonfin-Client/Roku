import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/achievementsModel.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/libraryOrder.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/serverMessages.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/unreadBadge.bs"

' The rail, sized the way the other clients size theirs
const SIDEBAR_COLLAPSED_WIDTH = 78
const SIDEBAR_EXPANDED_WIDTH = 280
const SECTION_PAD = 10
const ITEM_PAD = 14
const ICON_SIZE = 38
const ITEM_HEIGHT = 56
const ITEM_MARGIN = 3
const LABEL_LEFT = 76
const LABEL_SIZE = 20
const LIB_ITEM_HEIGHT = 50
const LIB_LABEL_LEFT = 74
const CLOCK_SIZE = 18

' The items sit in the band between the user button and the clock
const NAV_AREA_TOP = 118
const NAV_AREA_HEIGHT = 894

' The music card takes the foot of that band while music plays
const MUSIC_CARD_BAND = 148
const MUSIC_CARD_INNER = 236

sub init()
    m.top.id = "sidebar"

    m.bgSolid = m.top.findNode("sidebarBgSolid")
    m.bgEdge = m.top.findNode("sidebarBgEdge")

    m.focusPill = m.top.findNode("focusPill")
    m.focusPillAnim = m.top.findNode("focusPillAnim")
    m.focusPillPosInterp = m.top.findNode("focusPillPosInterp")
    m.focusPillWidthInterp = m.top.findNode("focusPillWidthInterp")

    m.expandAnim = m.top.findNode("expandAnim")
    m.collapseAnim = m.top.findNode("collapseAnim")
    m.bgSolidOpacityExpand = m.top.findNode("bgSolidOpacityExpand")
    m.bgEdgeOpacityExpand = m.top.findNode("bgEdgeOpacityExpand")
    m.bgSolidOpacityCollapse = m.top.findNode("bgSolidOpacityCollapse")
    m.bgEdgeOpacityCollapse = m.top.findNode("bgEdgeOpacityCollapse")

    m.slideUpAnim = m.top.findNode("slideUp")
    m.slideDownAnim = m.top.findNode("slideDown")
    m.sidebarContent = m.top.findNode("sidebarContent")

    m.userAvatar = m.top.findNode("userAvatar")
    m.userHighlight = m.top.findNode("userHighlight")
    m.userName = m.top.findNode("userName")

    m.navItemsGroup = m.top.findNode("navItemsGroup")
    m.navScrollClip = m.top.findNode("navScrollClip")
    m.scrollAnim = m.top.findNode("scrollAnim")
    m.scrollPosInterp = m.top.findNode("scrollPosInterp")
    m.sidebarClock = m.top.findNode("sidebarClock")
    m.navAreaHeight = NAV_AREA_HEIGHT
    setupMusicCard()

    ' The rows borrow this font, so it is sized before any of them are built
    m.navLabelFont = m.top.findNode("navLabelFont").font
    m.navLabelFont.size = LABEL_SIZE

    m.isExpanded = false
    m.scrollY = 0
    m.selectedIndex = 0
    m.avatarSelected = false
    m.sidebarHasFocus = false
    m.firstFocusShow = true
    m.navItems = []
    m.libraryData = []
    m.libraryItems = []
    m.libraryButtons = []
    m.librariesExpanded = false
    m.multiServerTask = invalid
    m.lastNavbarSettings = { shuffle: invalid, favorites: invalid, genres: invalid, libraries: invalid, seerr: invalid, showSeerr: invalid, showMessages: invalid, alwaysExpanded: invalid }

    m.bgOpacity = 0.88
    m.bgColor = "0x000000FF"

    m.homeItem = createNavItem("home", "pkg:/images/icons/home.png", "Home")
    m.searchItem = createNavItem("search", "pkg:/images/icons/search-light.png", "Search")
    m.shuffleItem = createNavItem("shuffle", "pkg:/images/icons/shuffle.png", "Shuffle", "0xFFFFFF")
    m.favoritesItem = createNavItem("favorites", "pkg:/images/icons/heart.png", "Favorites", "0xFFFFFF")
    m.genresItem = createNavItem("genres", "pkg:/images/icons/masks.png", "Genres", "0xFFFFFF")
    m.liveTvItem = createNavItem("livetv", "pkg:/images/icons/livetv.png", "Live TV", "0xFFFFFF")
    m.seerrItem = createNavItem("seerr", "pkg:/images/icons/settings/seerr.png", "Seerr")
    m.librariesItem = createNavItem("libraries", "pkg:/images/icons/library.png", "Libraries")
    m.messagesItem = createNavItem("messages", "pkg:/images/icons/messages.png", "Messages")
    m.friendsItem = createNavItem("friends", "pkg:/images/icons/friends.png", "Friends")
    m.settingsItem = createNavItem("settings", "pkg:/images/icons/settings.png", "Settings")

    loadNavbarSettings()
    m.global.observeField("session", "onSessionChanged")
    m.global.observeField("overlaySettingsChanged", "onOverlaySettingsChanged")
    m.global.observeField("serverMessagesChanged", "onServerMessagesChanged")
    m.global.observeField("social", "applyFriendsBadge")
    m.top.observeField("focusedChild", "onFocusChanged")

    styleRail()
    rebuildNavItems()
    if m.navbarAlwaysExpanded then expandSidebar()
    applyOverlaySettings()
end sub

' The clock sits centred across the foot of the rail, so it only reads once the
' rail is open
sub styleRail()
    m.navScrollClip.translation = [0, NAV_AREA_TOP]
    m.navScrollClip.clippingRect = [0, 0, SIDEBAR_EXPANDED_WIDTH, m.navAreaHeight]

    clockTime = m.sidebarClock.findNode("clockTime")
    if not isValid(clockTime) then return

    clockTime.font.size = CLOCK_SIZE
    clockTime.horizAlign = "center"
    clockTime.vertAlign = "top"
    clockTime.width = SIDEBAR_EXPANDED_WIDTH
    clockTime.height = CLOCK_SIZE + 4
    clockTime.color = "#FFFFFF80"

    m.sidebarClock.visible = false
end sub

' The button comes and goes with the list, and the badge follows the count
sub onServerMessagesChanged()
    rebuildNavItems()
end sub

function createNavItem(id as string, iconUri as string, labelText as string, blendColor = "" as string) as object
    btn = createObject("roSGNode", "Group")
    btn.id = id + "Btn"

    icon = createObject("roSGNode", "Poster")
    icon.uri = iconUri
    icon.width = ICON_SIZE
    icon.height = ICON_SIZE
    icon.loadDisplayMode = "scaleToFit"
    icon.translation = [SECTION_PAD + ITEM_PAD, (ITEM_HEIGHT - ICON_SIZE) / 2]
    icon.opacity = 0.6
    if blendColor <> "" then icon.blendColor = blendColor
    btn.appendChild(icon)

    label = createObject("roSGNode", "Label")
    label.text = labelText
    label.font = m.navLabelFont
    label.color = "#FFFFFF"
    label.height = ITEM_HEIGHT
    label.vertAlign = "center"
    label.translation = [LABEL_LEFT, 0]
    label.visible = false
    label.opacity = 0.6
    btn.appendChild(label)

    return { id: id, btn: btn, icon: icon, label: label, isLibChild: false, y: 0, badge: invalid, badgeLabel: invalid }
end function

function createLibraryChildItem(lib as object, labelText as string) as object
    btn = createObject("roSGNode", "Group")
    btn.id = "lib_" + lib.id

    label = createObject("roSGNode", "Label")
    label.text = labelText
    label.font = m.navLabelFont
    label.color = "#FFFFFF"
    label.height = LIB_ITEM_HEIGHT
    label.vertAlign = "center"
    label.translation = [LIB_LABEL_LEFT, 0]
    label.visible = false
    label.opacity = 0.5
    btn.appendChild(label)

    return { id: "lib_" + lib.id, btn: btn, icon: invalid, label: label, isLibChild: true, y: 0, lib: lib }
end function

' A library as a full row of its own, led by the glyph Library Order shows for its type
function createLibraryButton(lib as object, labelText as string) as object
    item = createNavItem("lib_" + lib.id, "", labelText)
    glyph = createObject("roSGNode", "Label")
    glyph.font = createObject("roSGNode", "Font")
    glyph.font.uri = settingsGlyphs.FONT_URI
    glyph.font.size = ICON_SIZE
    glyph.text = settingsGlyphs.Char(libraryOrder.Icon(lib))
    glyph.width = ICON_SIZE
    glyph.height = ICON_SIZE
    glyph.horizAlign = "center"
    glyph.vertAlign = "center"
    glyph.color = "#FFFFFF"
    glyph.translation = item.icon.translation
    glyph.opacity = item.icon.opacity
    ' A theme font would draw letters in place of the glyph, and an empty base font keeps it out
    glyph.addField("themeBaseFont", "node", false)
    item.btn.replaceChild(glyph, 0)
    item.icon = glyph
    ' A long library name ends in an ellipsis inside the pill rather than running off the rail
    item.label.width = SIDEBAR_EXPANDED_WIDTH - SECTION_PAD - ITEM_PAD - LABEL_LEFT
    item.lib = lib
    return item
end function

sub rebuildNavItems()
    m.navItemsGroup.removeChildrenIndex(m.navItemsGroup.getChildCount(), 0)

    m.navItems = []
    m.navItems.push(m.homeItem)
    m.navItems.push(m.searchItem)

    if m.shuffleButtonEnabled then m.navItems.push(m.shuffleItem)
    if m.genresButtonEnabled then m.navItems.push(m.genresItem)
    if m.favoritesButtonEnabled then m.navItems.push(m.favoritesItem)

    kids = kidsMode.Enabled()

    ' The guide has a button of its own, so the library list drops Live TV rather than offering a
    ' second way to the same screen
    showLiveTv = not kids and m.liveTvButtonEnabled and liveTvLibraryIndex() >= 0
    if showLiveTv then m.navItems.push(m.liveTvItem)

    seerrEnabled = parseBoolSetting(m.global.session.user.settings["seerr.enabled"])
    if not kids and seerrEnabled and m.seerrButtonEnabled
        m.navItems.push(m.seerrItem)
    end if

    individually = not kids and m.librariesEnabled and m.librariesIndividually
    if not kids and m.librariesEnabled and not individually then m.navItems.push(m.librariesItem)

    if individually or m.librariesExpanded
        libraries = individually ? m.libraryButtons : m.libraryItems
        for i = 0 to libraries.count() - 1
            if showLiveTv and isLiveTvLibrary(m.libraryData[i]) then continue for
            m.navItems.push(libraries[i])
        end for
    end if

    if m.messagesButtonEnabled and serverMessages.All().count() > 0
        m.navItems.push(m.messagesItem)
    end if

    ' Only where the Achievement Badges plugin has friends switched on, so it never takes a
    ' colour slot for a button that cant open
    if not kids and m.friendsButtonEnabled and socialAvailable() then m.navItems.push(m.friendsItem)

    m.navItems.push(m.settingsItem)

    for each item in m.navItems
        m.navItemsGroup.appendChild(item.btn)
    end for

    if m.selectedIndex >= m.navItems.count() then m.selectedIndex = m.navItems.count() - 1
    if m.selectedIndex < 0 then m.selectedIndex = 0

    layoutSidebar()
    unreadBadge.Apply(m.messagesItem, ICON_SIZE, serverMessages.UnreadCount())
    applyFriendsBadge()
end sub

function socialAvailable() as boolean
    return achievementsModel.SocialAvailable(chainLookupReturn(m.global, "session.achievementsInfo", invalid))
end function

' Friend requests waiting plus unread messages, which the button wears
sub applyFriendsBadge()
    unreadBadge.Apply(m.friendsItem, ICON_SIZE, achievementsModel.SocialBadgeCount(m.global.social))
end sub

function itemHeight(item as object) as integer
    if item.isLibChild then return LIB_ITEM_HEIGHT

    return ITEM_HEIGHT
end function

' A library row sits tight under the one above it, the rest carry a margin
function itemMargin(item as object) as integer
    if item.isLibChild then return 0

    return ITEM_MARGIN
end function

function navContentHeight() as integer
    total = 0
    for each item in m.navItems
        total += itemHeight(item) + (itemMargin(item) * 2)
    end for

    return total
end function

sub layoutSidebar()
    ' The rail holds its items in the middle, and only gives that up once there
    ' are more of them than the band can show
    total = navContentHeight()
    yCursor = 0
    if total < m.navAreaHeight then yCursor = (m.navAreaHeight - total) / 2

    for i = 0 to m.navItems.count() - 1
        item = m.navItems[i]
        isFocused = (not m.avatarSelected and m.cardFocus < 0 and i = m.selectedIndex and m.sidebarHasFocus)

        if isValid(item.icon)
            item.icon.opacity = isFocused ? 1.0 : 0.6
        end if

        item.label.visible = m.isExpanded
        item.label.opacity = isFocused ? 1.0 : (item.isLibChild ? 0.5 : 0.6)

        yCursor += itemMargin(item)
        item.y = yCursor
        item.btn.translation = [0, yCursor]
        yCursor += itemHeight(item) + itemMargin(item)
    end for

    if m.avatarSelected
        highlightUser()
    else
        dehighlightUser()
    end if

    scrollToFocusedItem()
    positionFocusPill()
    paintMusicCard()
end sub

sub scrollToFocusedItem()
    if m.avatarSelected or m.selectedIndex < 0 or m.selectedIndex >= m.navItems.count() then return

    focusedItem = m.navItems[m.selectedIndex]
    itemTop = focusedItem.y
    itemBottom = itemTop + itemHeight(focusedItem)

    totalContentHeight = navContentHeight()
    if totalContentHeight <= m.navAreaHeight
        if m.scrollY <> 0
            m.scrollY = 0
            m.navItemsGroup.translation = [0, 0]
        end if
        return
    end if

    targetScroll = m.scrollY
    viewPad = 10

    if itemTop + targetScroll < viewPad
        targetScroll = - (itemTop - viewPad)
    end if

    if itemBottom + targetScroll > m.navAreaHeight - viewPad
        targetScroll = - (itemBottom - m.navAreaHeight + viewPad)
    end if

    maxScroll = 0
    minScroll = - (totalContentHeight - m.navAreaHeight)
    if minScroll > 0 then minScroll = 0
    if targetScroll > maxScroll then targetScroll = maxScroll
    if targetScroll < minScroll then targetScroll = minScroll

    if targetScroll <> m.scrollY
        m.scrollY = targetScroll
        if isValid(m.scrollPosInterp) and isValid(m.scrollAnim)
            currentPos = m.navItemsGroup.translation
            m.scrollPosInterp.keyValue = [[currentPos[0], currentPos[1]], [0, targetScroll]]
            m.scrollAnim.control = "start"
        else
            m.navItemsGroup.translation = [0, targetScroll]
        end if
    end if
end sub

sub positionFocusPill()
    if m.avatarSelected or m.cardFocus >= 0 or not m.sidebarHasFocus
        m.focusPill.visible = false
        m.top.focusRect = []
        return
    end if

    if m.selectedIndex < 0 or m.selectedIndex >= m.navItems.count()
        m.focusPill.visible = false
        m.top.focusRect = []
        return
    end if

    item = m.navItems[m.selectedIndex]
    railWidth = m.isExpanded ? SIDEBAR_EXPANDED_WIDTH : SIDEBAR_COLLAPSED_WIDTH

    pillX = SECTION_PAD
    pillY = m.scrollY + item.y
    pillWidth = railWidth - (SECTION_PAD * 2)
    pillHeight = itemHeight(item)
    m.top.focusRect = [pillX, m.navScrollClip.translation[1] + pillY, pillWidth, pillHeight]

    if m.firstFocusShow or not m.focusPill.visible
        m.focusPill.translation = [pillX, pillY]
        m.focusPill.width = pillWidth
        m.focusPill.height = pillHeight
        m.focusPill.visible = true
        m.firstFocusShow = false
    else
        currentPos = m.focusPill.translation
        currentWidth = m.focusPill.width

        if isValid(m.focusPillPosInterp) and isValid(m.focusPillWidthInterp) and isValid(m.focusPillAnim)
            m.focusPillPosInterp.keyValue = [[currentPos[0], currentPos[1]], [pillX, pillY]]
            m.focusPillWidthInterp.keyValue = [currentWidth, pillWidth]
            m.focusPillAnim.control = "start"
        else
            m.focusPill.translation = [pillX, pillY]
            m.focusPill.width = pillWidth
        end if

        m.focusPill.height = pillHeight
        m.focusPill.visible = true
    end if
end sub

sub expandSidebar()
    if m.isExpanded then return
    m.isExpanded = true

    m.collapseAnim.control = "stop"

    m.bgSolidOpacityExpand.keyValue = [m.bgSolid.opacity, m.bgOpacity]
    m.bgEdgeOpacityExpand.keyValue = [m.bgEdge.opacity, m.bgOpacity]
    m.expandAnim.control = "start"

    m.userName.visible = true
    applyClockSetting()
    for each item in m.navItems
        item.label.visible = true
    end for

    positionFocusPill()
    paintMusicCard()
end sub

sub collapseSidebar()
    if m.navbarAlwaysExpanded then return
    if not m.isExpanded then return
    m.isExpanded = false

    m.expandAnim.control = "stop"

    m.bgSolidOpacityCollapse.keyValue = [m.bgSolid.opacity, 0]
    m.bgEdgeOpacityCollapse.keyValue = [m.bgEdge.opacity, 0]
    m.collapseAnim.control = "start"

    m.userName.visible = false
    m.sidebarClock.visible = false
    for each item in m.navItems
        item.label.visible = false
    end for

    positionFocusPill()
    paintMusicCard()
end sub

sub onFocusChanged()
    if m.top.hasFocus() and isValid(m.navItemsGroup)
        m.navItemsGroup.setFocus(true)
    end if

    hasFocus = m.top.isInFocusChain()
    if hasFocus <> m.sidebarHasFocus
        m.sidebarHasFocus = hasFocus
        group = m.global.sceneManager.callFunc("getActiveScene")
        if hasFocus and isValid(group)
            if group.focusedChild <> invalid
                focused = group.focusedChild
                while focused.hasFocus() = false and focused.focusedChild <> invalid
                    focused = focused.focusedChild
                end while
                if not focused.isSameNode(m.top) and not focused.isSubType("Sidebar")
                    group.lastFocus = focused
                end if
            end if
            expandSidebar()
        else
            m.cardFocus = -1
            collapseSidebar()
            if m.librariesExpanded then collapseLibraries()
        end if
        layoutSidebar()
    end if
end sub

sub loadLibraries()
    m.libraryData = []
    m.libraryItems = []
    m.libraryButtons = []
    m.librariesExpanded = false

    if isMultiServerEnabled()
        sessions = getAllServerSessions()
        if sessions.count() > 0
            loadMultiServerLibraries(sessions)
            return
        end if
    end if

    m.loadLibrariesTask = CreateObject("roSGNode", "LoadLibrariesTask")
    m.loadLibrariesTask.userId = m.global.session.user.id
    m.loadLibrariesTask.observeFieldScoped("result", "onLoadLibrariesComplete")
    m.loadLibrariesTask.control = TaskControl.RUN
end sub

sub onLoadLibrariesComplete(msg as object)
    node = msg.getRoSGNode()
    if not isValid(node) then return
    node.unobserveFieldScoped("result")

    data = node.result
    if not isChainValid(data, "items") then return

    views = data.LookupCI("items")
    if isEmbyServer() then views = withoutHiddenViews(views, chainLookupReturn(m.global, "session.user.configuration.MyMediaExcludes", []))
    for each item in views
        libData = {
            id: item.LookupCI("Id"),
            name: item.LookupCI("name"),
            type: item.LookupCI("Type"),
            collectionType: item.LookupCI("CollectionType")
        }
        m.libraryData.push(libData)
        m.libraryItems.push(createLibraryChildItem(libData, libData.name))
        m.libraryButtons.push(createLibraryButton(libData, libData.name))
    end for

    rebuildNavItems()
end sub

sub loadMultiServerLibraries(sessions as object)
    if not isValid(m.multiServerTask)
        m.multiServerTask = CreateObject("roSGNode", "MultiServerTask")
    else
        m.multiServerTask.callFunc("reset")
    end if

    m.multiServerTask.sessions = sessions
    m.multiServerTask.endpoint = "/UserViews"
    m.multiServerTask.params = { UserId: "{userId}" }
    m.multiServerTask.addFields({ metadata: { multipleServers: (sessions.count() > 1) } })
    m.multiServerTask.observeField("isComplete", "onMultiServerLibrariesLoaded")
    m.multiServerTask.control = TaskControl.RUN
end sub

sub onMultiServerLibrariesLoaded(msg as object)
    node = msg.getRoSGNode()
    if not isValid(node) then return
    node.unobserveField("isComplete")

    results = node.results
    if not isValidAndNotEmpty(results) then return

    uniqueServers = {}
    for each item in results
        if isValidAndNotEmpty(item._serverId) then uniqueServers[item._serverId] = true
    end for
    multipleServers = (uniqueServers.count() > 1)

    allLibs = []
    for each item in results
        if not isValidAndNotEmpty(item.Id) or not isValidAndNotEmpty(item.Name) then continue for

        serverSuffix = ""
        if multipleServers and isValidAndNotEmpty(item._serverName)
            serverSuffix = " (" + item._serverName + ")"
        end if

        allLibs.push({
            id: item.Id, name: item.Name,
            type: item.LookupCI("Type"), collectionType: item.LookupCI("CollectionType"),
            serverUrl: item._serverUrl, userId: item._userId, authToken: item._authToken,
            serverId: item._serverId, serverName: item._serverName, serverSuffix: serverSuffix
        })
    end for

    for each lib in librariesByServer(allLibs)
        m.libraryData.push(lib)
        displayName = lib.name
        if not isValidAndNotEmpty(displayName) then displayName = "Library"
        displayName += lib.serverSuffix
        m.libraryItems.push(createLibraryChildItem(lib, displayName))
        m.libraryButtons.push(createLibraryButton(lib, displayName))
    end for

    rebuildNavItems()
end sub

sub expandLibraries()
    if m.librariesExpanded or m.libraryItems.count() = 0 then return
    m.librariesExpanded = true
    rebuildNavItems()
end sub

sub collapseLibraries()
    if not m.librariesExpanded then return
    m.librariesExpanded = false
    rebuildNavItems()
end sub

sub loadNavbarSettings()
    m.shuffleButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_shuffle"], m.global.session.user.settings["show_shuffle_button"], true)
    m.favoritesButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_favorites"], invalid, true)
    m.genresButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_genres"], invalid, true)
    m.liveTvButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_livetv"], invalid, true)
    m.librariesEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_libraries"], invalid, true)
    m.librariesIndividually = parseBoolSetting(m.global.session.user.settings["navbar.show_libraries_individually"], invalid, false)
    m.seerrButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_seerr"], invalid, true)
    m.messagesButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_messages"], invalid, false)
    m.friendsButtonEnabled = parseBoolSetting(m.global.session.user.settings["navbar.show_friends"], invalid, false)
    m.navbarAlwaysExpanded = parseBoolSetting(m.global.session.user.settings["navbar.alwaysExpanded"], invalid, false)

    m.lastNavbarSettings = {
        shuffle: m.global.session.user.settings["navbar.show_shuffle"],
        favorites: m.global.session.user.settings["navbar.show_favorites"],
        genres: m.global.session.user.settings["navbar.show_genres"],
        liveTv: m.global.session.user.settings["navbar.show_livetv"],
        libraries: m.global.session.user.settings["navbar.show_libraries"],
        individually: m.global.session.user.settings["navbar.show_libraries_individually"],
        seerr: m.global.session.user.settings["seerr.enabled"],
        showSeerr: m.global.session.user.settings["navbar.show_seerr"],
        showMessages: m.global.session.user.settings["navbar.show_messages"],
        showFriends: m.global.session.user.settings["navbar.show_friends"],
        social: socialAvailable(),
        alwaysExpanded: m.global.session.user.settings["navbar.alwaysExpanded"]
    }
end sub

function parseBoolSetting(primary as dynamic, fallback = invalid as dynamic, defaultVal = false as boolean) as boolean
    val = primary
    if not isValid(val) then val = fallback
    if not isValid(val) then return defaultVal

    if type(val) = "String" or type(val) = "roString"
        return (LCase(val) = "true")
    else if type(val) = "Integer" or type(val) = "roInt"
        return (val = 1)
    end if
    return (val = true)
end function

sub onSessionChanged()
    applyClockSetting()
    currentSettings = {
        shuffle: parseBoolSetting(m.global.session.user.settings["navbar.show_shuffle"]),
        favorites: parseBoolSetting(m.global.session.user.settings["navbar.show_favorites"]),
        genres: parseBoolSetting(m.global.session.user.settings["navbar.show_genres"]),
        liveTv: parseBoolSetting(m.global.session.user.settings["navbar.show_livetv"], invalid, true),
        libraries: parseBoolSetting(m.global.session.user.settings["navbar.show_libraries"]),
        individually: parseBoolSetting(m.global.session.user.settings["navbar.show_libraries_individually"]),
        seerr: parseBoolSetting(m.global.session.user.settings["seerr.enabled"]),
        showSeerr: parseBoolSetting(m.global.session.user.settings["navbar.show_seerr"], invalid, true),
        showMessages: parseBoolSetting(m.global.session.user.settings["navbar.show_messages"], invalid, false),
        showFriends: parseBoolSetting(m.global.session.user.settings["navbar.show_friends"], invalid, false),
        social: socialAvailable(),
        alwaysExpanded: parseBoolSetting(m.global.session.user.settings["navbar.alwaysExpanded"])
    }
    lastSettings = {
        shuffle: parseBoolSetting(m.lastNavbarSettings.shuffle),
        favorites: parseBoolSetting(m.lastNavbarSettings.favorites),
        genres: parseBoolSetting(m.lastNavbarSettings.genres),
        liveTv: parseBoolSetting(m.lastNavbarSettings.liveTv, invalid, true),
        libraries: parseBoolSetting(m.lastNavbarSettings.libraries),
        individually: parseBoolSetting(m.lastNavbarSettings.individually),
        seerr: parseBoolSetting(m.lastNavbarSettings.seerr),
        showSeerr: parseBoolSetting(m.lastNavbarSettings.showSeerr, invalid, true),
        showMessages: parseBoolSetting(m.lastNavbarSettings.showMessages, invalid, false),
        showFriends: parseBoolSetting(m.lastNavbarSettings.showFriends, invalid, false),
        social: m.lastNavbarSettings.social = true,
        alwaysExpanded: parseBoolSetting(m.lastNavbarSettings.alwaysExpanded)
    }
    if currentSettings.shuffle <> lastSettings.shuffle or currentSettings.favorites <> lastSettings.favorites or currentSettings.genres <> lastSettings.genres or currentSettings.liveTv <> lastSettings.liveTv or currentSettings.libraries <> lastSettings.libraries or currentSettings.individually <> lastSettings.individually or currentSettings.seerr <> lastSettings.seerr or currentSettings.showSeerr <> lastSettings.showSeerr or currentSettings.showMessages <> lastSettings.showMessages or currentSettings.showFriends <> lastSettings.showFriends or currentSettings.social <> lastSettings.social or currentSettings.alwaysExpanded <> lastSettings.alwaysExpanded
        loadNavbarSettings()
        rebuildNavItems()
        if m.navbarAlwaysExpanded
            expandSidebar()
        else if not m.sidebarHasFocus
            collapseSidebar()
        end if
    end if
    applyOverlaySettings()
end sub

sub onOverlaySettingsChanged(_event as object)
    applyOverlaySettings()
    applyClockSetting()
end sub

' The clock only shows while the rail is open, and not at all with the setting off
sub applyClockSetting()
    m.sidebarClock.visible = m.isExpanded = true and get_user_setting_bool("ui.showClock", true)
end sub

sub applyOverlaySettings()
    if not isValid(m.global) or not isValid(m.global.session) then return

    opacity = 0.88
    if isValid(m.global.session.user) and isValid(m.global.session.user.settings)
        opacitySetting = m.global.session.user.settings["navbar.opacity"]
        if not isValid(opacitySetting)
            opacitySetting = m.global.session.user.settings["ui.overlayOpacity"]
        end if
        if isValid(opacitySetting)
            opacity = opacitySetting.toFloat()
            if opacity < 0.6 then opacity = 0.6
        end if
    end if

    color = "0x000000FF"
    if isValid(m.global.session.user) and isValid(m.global.session.user.settings)
        navColor = m.global.session.user.settings["navbar.color"]
        if not isValid(navColor)
            navColor = m.global.session.user.settings["ui.overlayColor"]
        end if
        color = formatOverlayColor(navColor, color)
    end if

    m.bgOpacity = opacity
    m.bgColor = color

    m.bgSolid.color = color
    m.bgEdge.blendColor = color

    if m.isExpanded
        m.bgSolid.opacity = m.bgOpacity
        m.bgEdge.opacity = m.bgOpacity
    end if
end sub

sub updateShuffleButtonVisibility()
    rebuildNavItems()
end sub

sub onVisibleChange()
    if m.top.disableMoveAnimation
        m.slideUpAnim.control = "stop"
        m.slideDownAnim.control = "stop"
        if isValid(m.sidebarContent) then m.sidebarContent.translation = [0, 0]
        return
    end if
    if m.top.isVisible
        m.slideUpAnim.control = "stop"
        m.slideDownAnim.control = "start"
    else
        m.slideDownAnim.control = "stop"
        m.slideUpAnim.control = "start"
    end if
end sub

sub updateUser()
    if isValid(m.userName) then m.userName.text = m.top.currentUser
end sub

sub updateUserProfileImage()
    m.userAvatar.observeField("loadStatus", "onPosterLoadStatusChanged")
    if isValid(m.userAvatar) then m.userAvatar.uri = m.top.currentUserProfileImage
end sub

sub onPosterLoadStatusChanged()
    if m.userAvatar.loadStatus <> PosterLoadStatus.LOADING
        m.userAvatar.unobserveField("loadStatus")
    end if
    if m.userAvatar.loadStatus = PosterLoadStatus.FAILED
        if m.userAvatar.loadWidth = 0 then m.userAvatar.uri = "pkg:/images/baseline_person_white_48dp.png"
    end if
end sub

sub highlightUser()
    if isValid(m.userHighlight)
        m.userHighlight.visible = true
        m.userHighlight.blendColor = formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT), ColorPalette.HIGHLIGHT)
    end if
end sub

sub dehighlightUser()
    if isValid(m.userHighlight)
        m.userHighlight.visible = false
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.cardFocus >= 0 then return handleMusicCardKey(key)

    maxIndex = m.navItems.count() - 1

    if key = KeyCode.UP
        if m.avatarSelected
            return true
        else if m.selectedIndex = 0
            m.avatarSelected = true
            m.selectedIndex = -1
            layoutSidebar()
            return true
        else
            m.selectedIndex = m.selectedIndex - 1
            layoutSidebar()
            return true
        end if

    else if key = KeyCode.DOWN
        if m.avatarSelected
            m.avatarSelected = false
            m.selectedIndex = 0
            layoutSidebar()
            return true
        else if m.selectedIndex < maxIndex
            m.selectedIndex = m.selectedIndex + 1
            layoutSidebar()
        else if m.musicCard.visible
            m.cardFocus = 0
            layoutSidebar()
        end if
        return true

    else if key = KeyCode.RIGHT
        return handleRightKey()

    else if key = KeyCode.OK
        return handleOKKey()
    end if

    return false
end function

function handleRightKey() as boolean
    group = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(group) and isValid(group.lastFocus)
        dehighlightUser()
        group.lastFocus.setFocus(true)
        return true
    end if
    return false
end function

function handleOKKey() as boolean
    if m.avatarSelected
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group) then group.lastFocus = m.top

        dialog = m.top.getScene().findNode("accountDialog")
        if isValid(dialog)
            dialog.returnFocus = m.top
            dialog.callFunc("showDialog")
        end if
        dehighlightUser()
        return true
    end if

    if m.selectedIndex < 0 or m.selectedIndex >= m.navItems.count() then return false

    item = m.navItems[m.selectedIndex]

    if item.id = "home"
        while m.global.sceneManager.callFunc("getSceneCount") > 1
            m.global.sceneManager.callFunc("popScene")
        end while
        m.top.itemSelected = "home"
        return true

    else if item.id = "search"
        m.top.itemSelected = "search"
        return true

    else if item.id = "shuffle"
        m.top.showShuffleDialog = not m.top.showShuffleDialog
        return true

    else if item.id = "favorites"
        m.top.favoritesPressed = not m.top.favoritesPressed
        return true

    else if item.id = "genres"
        m.top.genresPressed = not m.top.genresPressed
        return true

    else if item.id = "livetv"
        index = liveTvLibraryIndex()
        if index >= 0 then m.top.librarySelected = libraryNodeFor(m.libraryData[index])
        return true

    else if item.id = "seerr"
        seerrDiscovery = CreateObject("roSGNode", "SeerrDiscoveryScreen")
        m.global.sceneManager.callFunc("pushScene", seerrDiscovery)
        return true

    else if item.id = "messages"
        m.global.sceneManager.callFunc("serverMessagesDialog")
        return true

    else if item.id = "friends"
        m.global.sceneManager.callFunc("friends")
        return true

    else if item.id = "settings"
        m.global.sceneManager.callFunc("settings")
        return true

    else if item.id = "libraries"
        if m.librariesExpanded
            collapseLibraries()
        else
            expandLibraries()
            if m.libraryItems.count() > 0
                m.selectedIndex = m.selectedIndex + 1
            end if
            layoutSidebar()
        end if
        return true

    else if isValid(item.lib)
        ' The item holds its own library, since two servers can share a library id
        m.top.librarySelected = libraryNodeFor(item.lib)
        return true
    end if

    return false
end function

function libraryNodeFor(libInfo as object) as object
    libraryNode = createObject("roSGNode", "LibraryData")
    libraryNode.id = libInfo.id
    libraryNode.libraryId = libInfo.id
    libraryNode.title = libInfo.name
    libraryNode.collectionType = libInfo.collectionType

    if isValidAndNotEmpty(libInfo.serverUrl)
        libraryNode.serverUrl = libInfo.serverUrl
        libraryNode.userId = libInfo.userId
        libraryNode.authToken = libInfo.authToken
        libraryNode.serverId = libInfo.serverId
        libraryNode.serverName = libInfo.serverName
    end if
    return libraryNode
end function

function isLiveTvLibrary(libInfo as object) as boolean
    return isStringEqual(libInfo.collectionType, "livetv")
end function

function liveTvLibraryIndex() as integer
    for i = 0 to m.libraryData.count() - 1
        if isLiveTvLibrary(m.libraryData[i]) then return i
    end for
    return -1
end function

' Previous, play or pause, next and stop, with play a size up
sub setupMusicCard()
    m.cardFocus = -1
    m.musicCard = m.top.findNode("musicCard")
    m.musicCardArt = m.top.findNode("musicCardArt")
    m.musicCardTitle = m.top.findNode("musicCardTitle")
    m.musicCardArtist = m.top.findNode("musicCardArtist")
    m.musicCardRowFocus = m.top.findNode("musicCardRowFocus")
    m.musicCardArtMask = m.top.findNode("musicCardArtMask")
    m.musicCardNote = m.top.findNode("musicCardNote")
    m.musicCardButtons = m.top.findNode("musicCardButtons")
    m.musicCardParts = [m.top.findNode("musicCardFill"), m.top.findNode("musicCardBorder"), m.musicCardTitle, m.musicCardArtist, m.musicCardButtons]
    m.musicCardActions = ["previous", "play", "next", "stop"]

    sizes = [38, 44, 38, 38]
    icons = ["pkg:/images/icons/previous.png", "", "pkg:/images/playback/skip_next.png", "pkg:/images/icons/stop.png"]
    gap = (MUSIC_CARD_INNER - 158) / 5
    left = 12 + gap
    for i = 0 to sizes.count() - 1
        size = sizes[i]
        iconSize = size = 44 ? 26 : 22
        button = m.musicCardButtons.createChild("Group")
        button.translation = [left, (44 - size) / 2]

        disc = button.createChild("Poster")
        disc.uri = "pkg:/images/icons/circle.png"
        disc.width = size
        disc.height = size

        icon = button.createChild("Poster")
        icon.uri = icons[i]
        icon.width = iconSize
        icon.height = iconSize
        icon.translation = [(size - iconSize) / 2, (size - iconSize) / 2]

        left += size + gap
    end for
end sub

sub onMusicPlayerSet()
    for each field in ["active", "songTitle", "artistName", "artUri", "isPlaying"]
        m.top.musicPlayer.observeField(field, "onMusicStateChanged")
    end for
    onMusicStateChanged()
end sub

sub onMusicStateChanged()
    shown = m.top.musicPlayer.active = true
    if shown <> m.musicCard.visible
        m.musicCard.visible = shown
        m.navAreaHeight = shown ? NAV_AREA_HEIGHT - MUSIC_CARD_BAND : NAV_AREA_HEIGHT
        m.navScrollClip.clippingRect = [0, 0, SIDEBAR_EXPANDED_WIDTH, m.navAreaHeight]

        if not shown and m.cardFocus >= 0
            m.cardFocus = -1
            m.selectedIndex = m.navItems.count() - 1
        end if
        layoutSidebar()
        return
    end if

    paintMusicCard()
end sub

' The closed rail shows the art in a circle, the open one the whole card
sub paintMusicCard()
    if not isValid(m.top.musicPlayer) or not m.musicCard.visible then return
    player = m.top.musicPlayer

    for each part in m.musicCardParts
        part.visible = m.isExpanded
    end for

    if m.isExpanded
        m.musicCardArtMask.maskUri = "pkg:/images/miniPlayerArtMask.png"
        m.musicCardArtMask.translation = [12, 12]
    else
        m.musicCardArtMask.maskUri = "pkg:/images/icons/circle.png"
        m.musicCardArtMask.translation = [3, 40]
    end if
    m.musicCardNote.translation = [m.musicCardArtMask.translation[0] + 13, m.musicCardArtMask.translation[1] + 13]

    m.musicCardArt.uri = player.artUri
    m.musicCardTitle.text = player.songTitle
    m.musicCardArtist.text = player.artistName
    m.musicCardRowFocus.visible = m.cardFocus = 0

    for i = 0 to m.musicCardActions.count() - 1
        button = m.musicCardButtons.getChild(i)
        focused = m.cardFocus = i + 1
        disc = button.getChild(0)
        disc.opacity = focused ? 1.0 : 0.1

        icon = button.getChild(1)
        icon.blendColor = focused ? "0x101010FF" : ColorPalette.WHITE
        if m.musicCardActions[i] = "play"
            icon.uri = player.isPlaying ? "pkg:/images/icons/pause.png" : "pkg:/images/icons/play.png"
        end if
    end for
end sub

' The art row opens the player and sits above the buttons. Right past the last button leaves
' for the page like the rail items do.
function handleMusicCardKey(key as string) as boolean
    if key = KeyCode.UP
        if m.cardFocus > 0
            m.cardFocus = 0
        else
            m.cardFocus = -1
            m.selectedIndex = m.navItems.count() - 1
        end if
        layoutSidebar()
        return true
    end if

    if key = KeyCode.DOWN
        if m.cardFocus = 0 then m.cardFocus = 2
        paintMusicCard()
        return true
    end if

    if key = KeyCode.LEFT
        if m.cardFocus > 1 then m.cardFocus -= 1
        paintMusicCard()
        return true
    end if

    if key = KeyCode.RIGHT
        if m.cardFocus >= 1 and m.cardFocus < m.musicCardActions.count()
            m.cardFocus += 1
            paintMusicCard()
            return true
        end if
        return handleRightKey()
    end if

    if key = KeyCode.REPLAY then return handleRightKey()

    if key = KeyCode.OK
        if m.cardFocus = 0
            m.top.musicPlayer.callFunc("runAction", "open")
        else
            m.top.musicPlayer.callFunc("runAction", m.musicCardActions[m.cardFocus - 1])
        end if
        return true
    end if

    return false
end function

' The replay key's way into the card
sub focusMusicPlayer()
    if not m.musicCard.visible then return

    m.avatarSelected = false
    m.cardFocus = 0
    m.top.setFocus(true)
    layoutSidebar()
end sub

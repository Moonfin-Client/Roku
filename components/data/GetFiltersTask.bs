import "pkg:/source/utils/config.bs"
import "pkg:/source/api/sdk.bs"

sub init()
    m.top.functionName = "getFiltersTask"
end sub

' Genres arrive as plain names from the older endpoint and as objects from the newer
' one, so both shapes fold down to a list of names
function facetNames(list as dynamic) as object
    names = []
    if not isValidAndNotEmpty(list) then return names

    for each entry in list
        if type(entry) = "roAssociativeArray"
            if isValidAndNotEmpty(entry.Name) then names.push(entry.Name)
        else if isValidAndNotEmpty(entry)
            names.push(entry)
        end if
    end for

    return names
end function

' Languages carry a display name beside the code the query takes
function facetLanguages(list as dynamic) as object
    languages = []
    if not isValidAndNotEmpty(list) then return languages

    for each entry in list
        if type(entry) = "roAssociativeArray" and isValidAndNotEmpty(entry.Value)
            languages.push({
                name: isValidAndNotEmpty(entry.Name) ? entry.Name : entry.Value,
                value: entry.Value
            })
        end if
    end for

    return languages
end function

function firstNonEmpty(a as object, b as object) as object
    return a.count() > 0 ? a : b
end function

' A server without the newer endpoint still gives up genres, ratings, tags and years
' through the older one
sub getFiltersTask()
    legacy = api.items.GetFilters(m.top.params)
    if not isValid(legacy) then legacy = {}

    current = api.items.GetFilters2(m.top.params)
    if not isValid(current) then current = {}

    years = []
    if isValidAndNotEmpty(legacy.Years)
        for each year in legacy.Years
            if type(year) = "roInt" or type(year) = "Integer" then years.push(year)
        end for
    end if

    m.top.filters = {
        genres: firstNonEmpty(facetNames(legacy.Genres), facetNames(current.Genres)),
        officialRatings: facetNames(legacy.OfficialRatings),
        tags: firstNonEmpty(facetNames(legacy.Tags), facetNames(current.Tags)),
        years: years,
        audioLanguages: facetLanguages(current.AudioLanguages),
        subtitleLanguages: facetLanguages(current.SubtitleLanguages)
    }
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="HomeData" extends="ContentNode">
  <interface>
    <field id="id" type="string" />
    <field id="name" type="string" />
    <field id="labelText" type="string" />
    <field id="subTitle" type="string" />
    <field id="thumbnailURL" type="string" />
    <field id="iconURL" type="string" />
    <field id="posterURL" type="string" />
    <field id="widePosterURL" type="string" />
    <field id="backdropURL" type="string" />
    <field id="type" type="string" />
    <!-- The signed in server's details for image URLs (activeImageContext), set before json by a row that builds many cards -->
    <field id="imageContext" type="assocarray" />
    <field id="json" type="assocarray" onChange="setData" />
    <!-- Set by a row task when its row matches the copy Home drew from the launch cache, which Home then keeps -->
    <field id="sameAsCached" type="bool" value="false" />
    <field id="collectionType" type="string" />
    <!-- The id Moonbase knows the item by, set by the row task so its labels can be asked for in one batch. -->
    <field id="labelId" type="string" />
    <!-- The labels a card draws, which can arrive after the card is shown. Fetch hands each id a list of them. -->
    <field id="posterLabels" type="array" />
    <!-- A card's own size, which only a row of cards that differ in size sets. The row lays them out by FHDItemWidth. -->
    <field id="imageWidth" type="integer" value="464" />
    <field id="imageHeight" type="integer" value="270" />
    <field id="FHDItemWidth" type="float" value="464" />
    <field id="bannerURL" type="string" />
    <field id="PlayedPercentage" type="float" value="0" />
    <field id="usePoster" type="bool" value="false" />
    <field id="isWatched" type="bool" value="false" />
    <field id="selectedAudioStreamIndex" type="integer" value="0" />
    <field id="startingPoint" type="longinteger" value="0" />
    <field id="seerrStatus" type="integer" value="0" />
  </interface>
</component>
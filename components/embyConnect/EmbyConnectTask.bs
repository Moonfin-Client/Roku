import "pkg:/source/api/EmbyConnect.bs"

sub init()
    m.top.functionName = "execute"
end sub

sub execute()
    result = { error: "network" }
    try
        if m.top.mode = "authenticate"
            result = embyConnect.Authenticate(m.top.username, m.top.password)
        else
            result = embyConnect.Exchange(m.top.server, m.top.connectUserId)
        end if
    catch error
        result = { error: "response" }
    end try
    m.top.password = ""
    m.top.server = {}
    if not m.top.cancelRequested
        m.top.result = result
        ' Keep ownership of a newly created token until the scene accepts it.
        port = CreateObject("roMessagePort")
        while not m.top.accepted and not m.top.cancelRequested
            wait(100, port)
        end while
    end if
    if m.top.cancelRequested and isValidAndNotEmpty(result.accessToken)
        embyConnect.Revoke(result.serverUrl, result.user.Id, result.accessToken)
    end if
    m.top.result = {}
    m.top.completed = true
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="AudioPlayerView" extends="JFScreen">
  <children>
    <Rectangle id="background" width="1920" height="1080" color="#000000" visible="false" />
    <Poster id="backdrop" opacity=".45" loadDisplayMode="scaleToZoom" width="1920" height="1080" />

    <Group id="qualityBadge" visible="false" translation="[1840, 44]">
      <Poster id="qualityPill" uri="pkg:/images/icons/pill-focus.9.png" height="48" blendColor="#FFFFFF" opacity=".12" />
      <Label id="qualityText" height="48" vertAlign="center" color="#DDDDDD" font="font:SmallestBoldSystemFont" />
    </Group>

    <ScreenMask maskUri="pkg:/images/audioCoverMask.webp" size="[480, 480]" translation="[80, 120]">
      <Poster id="albumCover" width="480" height="480" />
    </ScreenMask>

    <ScrollingText id="song" translation="[80, 624]" font="font:MediumBoldSystemFont" maxWidth="540" height="62" />
    <ScrollingText id="artist" translation="[80, 692]" maxWidth="540" height="38" />
    <ScrollingText id="album" translation="[80, 734]" maxWidth="540" height="34" color="#999999" />

    <MarkupList id="queueList" translation="[660, 140]" itemComponentName="AudioQueueRow" itemSize="[1180, 96]" itemSpacing="[0, 8]" numRows="6" drawFocusFeedback="true" focusBitmapUri="pkg:/images/playback/listFocus.9.png" focusFootprintBlendColor="0x00000000" vertFocusAnimationStyle="fixedFocus" visible="false" />
    <MarkupList id="lyricsCursor" translation="[660, 140]" itemComponentName="LyricLineRow" itemSize="[1180, 60]" itemSpacing="[0, 8]" numRows="10" drawFocusFeedback="true" focusBitmapUri="pkg:/images/playback/listFocus.9.png" focusFootprintBlendColor="0x00000000" vertFocusAnimationStyle="fixedFocus" visible="false" />

    <Rectangle id="seekBar" translation="[80, 872]" width="1760" height="8">
      <Rectangle id="bufferPosition" height="8" />
      <Rectangle id="playPosition" height="8" />
      <Poster id="thumb" width="25" height="25" uri="pkg:/images/icons/circle.webp" visible="false" translation="[0, -9]" />
    </Rectangle>

    <Text id="positionTimestamp" width="200" height="25" font="font:SmallestSystemFont" translation="[80,892]" color="#999999" text="0:00" />
    <Text id="totalLengthTimestamp" width="200" height="25" horizAlign="right" font="font:SmallestSystemFont" translation="[1640,892]" color="#999999" />

    <Rectangle id="seekPosition" visible="false" color="0x00000090" height="40" width="110" translation="[80, 820]">
      <Text text="0:00" id="seekTimestamp" width="110" height="40" horizAlign="center" vertAlign="center" font="font:SmallestSystemFont" />
    </Rectangle>

    <!-- Dock buttons are built in setupButtons -->
    <Group id="buttons" translation="[0, 932]" />

    <Animation id="bufferPositionAnimation" duration="1" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="bufferPositionAnimationWidth" key="[0.0, 1.0]" fieldToInterp="bufferPosition.width" />
    </Animation>
    <Animation id="playPositionAnimation" duration="1" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="playPositionAnimationWidth" key="[0.0, 1.0]" fieldToInterp="playPosition.width" />
    </Animation>
  </children>
  <interface>
    <field id="state" type="string" />
    <field id="returnOnStop" type="boolean" />
  </interface>
</component>
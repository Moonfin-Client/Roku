<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick Access and Immersive music libraries. Immersive leads with the album being
     listened to over its blurred cover, with the categories in tabs above it. Quick Access
     puts the categories and playlists in a rail and starts with a grid of recent albums and
     playlists. Both are built once the library has loaded, and Classic keeps the grid. -->
<component name="MusicLibraryScreen" extends="JFScreen">
  <children>
    <Rectangle id="background" width="1920" height="1080" color="#000018" />

    <!-- Every section, scrolled as one -->
    <Group id="page" />

    <!-- Quick Access keeps its rail still while the page scrolls past it -->
    <Group id="rail" visible="false">
      <Rectangle id="railBg" width="248" height="1080" color="#FFFFFF" opacity="0.03" />
      <Group id="railList" />
    </Group>

    <LibrarySortDialog id="sortDialog" visible="false" />

    <Animation id="scrollAnim" duration="0.2" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="page.translation" />
    </Animation>
  </children>

  <interface>
    <field id="parentItem" type="node" onChange="loadLibrary" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <!-- Never set, it's only here for the observer Home puts on every library screen -->
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <field id="genreItemSelected" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

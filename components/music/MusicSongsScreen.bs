import "pkg:/components/music/musicCategoryHost.bs"
import "pkg:/source/enums/ItemType.bs"

const MIX_HEIGHT = 225
const MIX_GAP = 30
const LIST_GAP = 60
const LIST_ROW = 75
const LIST_SHOWN = 5

sub categoryLoad()
    m.category = "songs"
    m.right = 1920 - CATEGORY_INSET
    m.total = -1
    m.top5 = []
    m.fresh5 = []
    library = { parentId: m.libraryId, includeItemTypes: "Audio", recursive: true }
    categoryRequest("count", "Items", songQuery(library, { limit: 0 }), "onSongCount")
    categoryRequest("top", "Items", songQuery(mixQuery("mostPlayed"), { limit: LIST_SHOWN }), "onTopSongs")
    categoryRequest("fresh", "Items", songQuery(mixQuery("fresh"), { limit: LIST_SHOWN }), "onFreshSongs")
    setRows("main", songRows())
    focusFirstItem("main")
end sub

function songQuery(base as object, extra as object) as object
    params = {}
    params.append(base)
    params.append(extra)
    params.fields = "PrimaryImageAspectRatio"
    return params
end function

function mixQuery(mix as string) as object
    params = { parentId: m.libraryId, includeItemTypes: "Audio", recursive: true, limit: 100 }
    if mix = "everything"
        params.sortBy = "Random"
        params.limit = 300
    else if mix = "mostPlayed"
        params.filters = "IsPlayed"
        params.sortBy = "PlayCount,SortName"
        params.sortOrder = "Descending"
    else if mix = "fresh"
        params.sortBy = "DateCreated,SortName"
        params.sortOrder = "Descending"
    else
        params.isFavorite = true
        params.sortBy = "DatePlayed,SortName"
        params.sortOrder = "Ascending"
    end if
    return params
end function

sub onSongCount(event as object)
    data = categoryResponse(event, "count")
    if not isValid(data) then return
    m.total = totalOf(data, 0)
    setRows("main", songRows())
end sub

sub onTopSongs(event as object)
    data = categoryResponse(event, "top")
    if not isValid(data) then return
    m.top5 = responseItems(data)
    setRows("main", songRows())
end sub

sub onFreshSongs(event as object)
    data = categoryResponse(event, "fresh")
    if not isValid(data) then return
    m.fresh5 = responseItems(data)
    setRows("main", songRows())
end sub

function songRows() as object
    header = headerRow(tr("Songs"), musicCategories.CountText(m.total, tr("1 song"), tr("{count} songs")), m.left)
    allSongs = pillSpec(tr("All Songs A to Z"), "sort_by_alpha")
    placeButtons(header, [{ spec: allSongs, action: { do: "allSongs" }, key: "allSongs" }], m.right - specWidth(allSongs), HEADER_HEIGHT - PILL_HEIGHT, 0)
    rows = [categoryStrip(), header]

    y = m.contentTop
    if m.total = 0
        rows.push(emptyRow(tr("No items found"), y))
        return rows
    end if
    mixes = newRow(y, MIX_HEIGHT)
    mixWidth = (m.right - m.left - MIX_GAP * 3) \ 4
    cards = [
        { id: "everything", eyebrow: tr("Shuffle"), title: tr("Everything"), line: tr("300 songs at random"), color: m.accent, ink: m.onAccent },
        { id: "mostPlayed", eyebrow: tr("Mix"), title: tr("Most Played"), line: tr("Your top 100"), color: "#B4472F", ink: "#FFFFFF" },
        { id: "fresh", eyebrow: tr("Mix"), title: tr("Fresh Arrivals"), line: tr("The newest 100 songs"), color: "#14505C", ink: "#FFFFFF" },
        { id: "rediscover", eyebrow: tr("Mix"), title: tr("Rediscover"), line: tr("Favorites you haven't played lately"), color: "#4D3B72", ink: "#FFFFFF" }
    ]
    for i = 0 to cards.count() - 1
        card = cards[i]
        spec = { kind: "mix", width: mixWidth, height: MIX_HEIGHT, leading: UCase(card.eyebrow), title: card.title, subtitle: card.line, glyph: "play_arrow", color: card.color, ink: card.ink }
        addCell(mixes, m.left + i * (mixWidth + MIX_GAP), 0, mixWidth, MIX_HEIGHT, spec, { mix: card.id }, "mix:" + card.id)
    end for
    rows.push(mixes)

    ' Most Played is left out while nothing has been played, and the newest songs move over
    lists = []
    if m.top5.count() > 0 then lists.push({ title: tr("Most Played"), items: m.top5, ranked: true })
    if m.fresh5.count() > 0 then lists.push({ title: tr("Recently Added"), items: m.fresh5, ranked: false })
    if lists.count() = 0 then return rows

    y += MIX_HEIGHT + 45
    columnWidth = (m.right - m.left - LIST_GAP) \ 2
    headings = newRow(y, 54)
    for i = 0 to lists.count() - 1
        heading = labelDecor(lists[i].title, m.left + i * (columnWidth + LIST_GAP), 0, 33, true, m.ink)
        heading.height = 54
        heading.vertAlign = "center"
        headings.decor.push(heading)
    end for
    rows.push(headings)
    y += 54

    for line = 0 to LIST_SHOWN - 1
        row = newRow(y + line * LIST_ROW, LIST_ROW)
        for i = 0 to lists.count() - 1
            if line < lists[i].items.count()
                item = lists[i].items[line]
                addCell(row, m.left + i * (columnWidth + LIST_GAP), 0, columnWidth, LIST_ROW, listSpec(item, line, lists[i].ranked, columnWidth), { song: item }, i.toStr() + ":" + toString(item.Id))
            end if
        end for
        if row.cells.count() > 0 then rows.push(row)
    end for
    return rows
end function

function listSpec(item as object, index as integer, ranked as boolean, width as integer) as object
    spec = { kind: "row", width: width, height: LIST_ROW, title: item.Name ?? "", subtitle: subtitleOf(item), image: coverOf(item, 54), glyph: "music_note", artSize: 54, titleSize: 22, subtitleSize: 20, trailingSize: 20, padX: 18, gap: 21 }
    if ranked
        spec.leading = (index + 1).toStr()
        spec.rank = true
        spec.leadingSize = 27
        spec.leadingWidth = 33
        spec.trailing = musicCategories.CountText(chainLookupReturn(item, "UserData.PlayCount", 0), tr("1 play"), tr("{count} plays"))
    else
        spec.trailing = runtimeOf(item)
    end if
    return spec
end function

sub openAllSongs()
    group = CreateObject("roSGNode", "VisualLibraryScene")
    group.mediaType = ItemType.MUSICARTIST
    group.entry = { id: "songs", view: "Albums", itemType: "Audio" }
    group.parentItem = m.top.parentItem
    pushRelayed(group)
end sub

' =====================================================================
' HOOKS
' =====================================================================

sub categoryActivate(action as object)
    if isValid(action.mix)
        requestTracks(mixQuery(action.mix), "", action.mix = "rediscover")
    else if isValid(action.song)
        playSong(action.song)
    else if action.do = "allSongs"
        openAllSongs()
    end if
end sub

sub categoryFocused()
end sub

function categoryBack() as boolean
    return false
end function

sub categoryRowShown(_regionId as string, _index as integer)
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Everything the Quick Access and Immersive music libraries draw, fetched in one run -->
<component name="LoadMusicLibraryTask" extends="Task">
  <interface>
    <field id="libraryId" type="string" />
    <!-- SortName, ProductionYear or DateCreated, from the screen's Sort & Filter -->
    <field id="sortKey" type="string" value="SortName" />
    <field id="result" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

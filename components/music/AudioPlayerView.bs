import "pkg:/components/itemMenu/itemMenuHost.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/enums/TaskControl.bs"

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

const DOCK_BUTTON_SIZE = 88
const DOCK_PLAY_SIZE = 104
const DOCK_GAP = 24

sub init()
    m.top.overhangVisible = false

    hideAudioMiniPlayer()

    m.top.optionsAvailable = false
    m.inScrubMode = false
    m.lastRecordedPositionTimestamp = 0
    m.scrubTimestamp = -1
    m.hasLyrics = false
    m.showQueue = false
    m.isFavorite = false
    m.favoriteOverrides = {}
    m.dockFocus = "play"

    m.playlistTypeCount = m.global.queueManager.callFunc("getQueueUniqueTypes").count()

    ' The settings can't change while this screen is up, and each read copies the whole session
    m.accent = themeChrome.Accent()
    m.onAccent = themeChrome.OnAccent()
    m.cursor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    setupAudioNode()
    setupAnimationTasks()
    setupInfoNodes()
    setupButtons()
    setupDataTasks()
    setupScreenSaver()

    moveSeekbarThumb(0)

    m.screenSaverTimeout = 300

    m.LoadScreenSaverTimeoutTask.observeField("content", "onScreensaverTimeoutLoaded")
    m.LoadScreenSaverTimeoutTask.control = TaskControl.RUN

    m.di = CreateObject("roDeviceInfo")

    m.song = m.top.findNode("song")
    m.song.font.size = 48

    m.artist = m.top.findNode("artist")
    m.artist.font.size = 28
    m.artist.color = m.accent

    m.album = m.top.findNode("album")
    m.album.font.size = 24

    m.seekBar.color = "0xFFFFFF26"
    m.bufferPosition.color = "0xFFFFFF33"
    m.playPosition.color = m.accent
    m.queueList.focusBitmapBlendColor = m.cursor
    m.queueList.observeField("itemSelected", "onQueueItemSelected")
    m.lyricsCursor.focusBitmapBlendColor = m.cursor
    m.lyricsCursor.observeField("itemSelected", "onLyricLineSelected")
    m.lyricStarts = []

    m.buttons.setFocus(true)
    layoutDock()
    loadQueueList()
    showPanel()

    ' The mini player can open this on a paused track too, which gets no position updates
    if m.global.audioPlayer.state = "playing" or m.global.audioPlayer.state = "paused"
        onAudioDataChanged()
        audioPositionChanged()
    end if
end sub

function audioArtworkURL(item as dynamic, id as string, imageType as string, params = {} as object) as string
    serverData = getServerInfoFromItem(item)
    if not isValid(serverData) then return ImageURL(id, imageType, params)

    targetParams = { "quality": "90" }
    targetParams.Append(params)
    if isEmbyServer(serverData.serverUrl) then targetParams.api_key = serverData.authToken
    return buildURLForServer(serverData.serverUrl, "Items/" + id + "/Images/" + imageType, targetParams, serverData.userId)
end function

' Album art first, the way the song lists and the mini player show it, then the track's own.
' Album song lists queue bare nodes, which carry AlbumId as a field.
function audioArtId(item as object) as string
    if isValidAndNotEmpty(item.AlbumId) then return item.AlbumId
    if isValidAndNotEmpty(item.id) then return item.id
    return ""
end function

function currentItemJson() as object
    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if not isValid(currentItem) then return {}
    if isValid(currentItem.json) then return currentItem.json
    return currentItem
end function

sub onScreensaverTimeoutLoaded()
    data = m.LoadScreenSaverTimeoutTask.content
    m.LoadScreenSaverTimeoutTask.unobserveField("content")
    if isValid(data)
        m.screenSaverTimeout = data
    end if
end sub

sub setupScreenSaver()
    m.screenSaverBackground = m.top.FindNode("screenSaverBackground")

    ' Album Art Screensaver
    m.screenSaverAlbumCover = m.top.FindNode("screenSaverAlbumCover")
    m.screenSaverAlbumAnimation = m.top.findNode("screenSaverAlbumAnimation")
    m.screenSaverAlbumCoverFadeIn = m.top.findNode("screenSaverAlbumCoverFadeIn")

    ' Jellyfin Screensaver
    m.PosterOne = m.top.findNode("PosterOne")
    m.PosterOne.uri = "pkg:/images/channel-poster_sd.jpg"
    m.BounceAnimation = m.top.findNode("BounceAnimation")
    m.PosterOneFadeIn = m.top.findNode("PosterOneFadeIn")
end sub

sub setupAnimationTasks()
    m.playPositionAnimation = m.top.FindNode("playPositionAnimation")
    m.playPositionAnimationWidth = m.top.FindNode("playPositionAnimationWidth")

    m.bufferPositionAnimation = m.top.FindNode("bufferPositionAnimation")
    m.bufferPositionAnimationWidth = m.top.FindNode("bufferPositionAnimationWidth")
end sub

' Creates tasks to gather data needed to render Scene and play song
sub setupDataTasks()
    ' Load meta data
    m.LoadMetaDataTask = CreateObject("roSGNode", "LoadItemsTask")
    m.LoadMetaDataTask.itemsToLoad = "metaData"

    m.LoadScreenSaverTimeoutTask = CreateObject("roSGNode", "LoadScreenSaverTimeoutTask")
end sub

' Creates audio node used to play song(s)
sub setupAudioNode()
    m.global.audioPlayer.observeFieldScoped("position", "audioPositionChanged")
    m.global.audioPlayer.observeFieldScoped("bufferingStatus", "bufferPositionChanged")
    m.global.audioPlayer.observeFieldScoped("audioData", "onAudioDataChanged")
    m.global.audioPlayer.observeFieldScoped("loopmode", "paintDock")
    m.global.audioPlayer.observeFieldScoped("state", "paintDock")
end sub

' Creates audio node used to play song(s)
sub unobserveAll()
    m.global.audioPlayer.unobserveFieldScoped("position")
    m.global.audioPlayer.unobserveFieldScoped("bufferingStatus")
    m.global.audioPlayer.unobserveFieldScoped("audioData")
    m.global.audioPlayer.unobserveFieldScoped("loopmode")
    m.global.audioPlayer.unobserveFieldScoped("state")
end sub

function dockButtonSize(id as string) as integer
    if id = "play" then return DOCK_PLAY_SIZE
    return DOCK_BUTTON_SIZE
end function

' Each dock button is a disc, its icon and a focus ring, painted by paintDock
sub setupButtons()
    m.buttons = m.top.findNode("buttons")
    m.dockIcons = {
        "favorite": "pkg:/images/icons/heart.png",
        "addToPlaylist": "pkg:/images/icons/add_to_playlist.png",
        "shuffle": "pkg:/images/icons/shuffle.png",
        "previous": "pkg:/images/icons/previous.png",
        "next": "pkg:/images/playback/skip_next.png",
        "loop": "pkg:/images/icons/repeat.png",
        "lyrics": "pkg:/images/icons/lyrics.png",
        "queue": "pkg:/images/icons/details.png"
    }

    m.dock = {}
    for each id in ["favorite", "addToPlaylist", "shuffle", "previous", "play", "next", "loop", "lyrics", "queue"]
        size = dockButtonSize(id)
        button = m.buttons.createChild("Group")
        button.id = id

        disc = button.createChild("Poster")
        disc.uri = "pkg:/images/icons/circle.png"
        disc.width = size
        disc.height = size

        iconSize = size / 2
        icon = button.createChild("Poster")
        icon.width = iconSize
        icon.height = iconSize
        icon.translation = [(size - iconSize) / 2, (size - iconSize) / 2]

        ring = button.createChild("Poster")
        ring.uri = "pkg:/images/icons/focusRing.png"
        ring.width = size + 12
        ring.height = size + 12
        ring.translation = [-6, -6]
        ring.blendColor = m.cursor

        if id = "play"
            disc.blendColor = m.accent
            icon.blendColor = m.onAccent
        end if

        m.dock[id] = button
    end for
end sub

' Favorite and add to playlist on the left, the transport in the middle and the panel toggles on
' the right. A mixed queue can't shuffle or loop.
sub layoutDock()
    hidden = {}
    if m.playlistTypeCount > 1 then hidden = { "shuffle": true, "loop": true }

    ' Without lyrics Up Next is the only panel, so there's nothing to toggle
    if not m.hasLyrics
        hidden["lyrics"] = true
        hidden["queue"] = true
    end if

    dockGroups = [
        { x: 80, align: 0, ids: ["favorite", "addToPlaylist"] },
        { x: 960, align: 0.5, ids: ["shuffle", "previous", "play", "next", "loop"] },
        { x: 1840, align: 1, ids: ["lyrics", "queue"] }
    ]

    m.dockOrder = []
    for each dockGroup in dockGroups
        shown = []
        groupWidth = 0
        for each id in dockGroup.ids
            button = m.dock[id]
            button.visible = not hidden.DoesExist(id)
            if button.visible
                shown.push(id)
                groupWidth += dockButtonSize(id)
            end if
        end for
        if shown.count() > 1 then groupWidth += DOCK_GAP * (shown.count() - 1)

        left = dockGroup.x - groupWidth * dockGroup.align
        for each id in shown
            buttonSize = dockButtonSize(id)
            m.dock[id].translation = [left, (DOCK_PLAY_SIZE - buttonSize) / 2]
            left += buttonSize + DOCK_GAP
            m.dockOrder.push(id)
        end for
    end for

    if not inArray(m.dockOrder, m.dockFocus) then m.dockFocus = "play"
    paintDock()
end sub

function dockButtonActive(id as string) as boolean
    if id = "favorite" then return m.isFavorite
    if id = "shuffle" then return m.global.queueManager.callFunc("getIsShuffled") = true
    if id = "loop" then return m.global.audioPlayer.loopMode <> ""
    if id = "lyrics" then return not m.queueList.visible
    if id = "queue" then return m.queueList.visible
    return false
end function

function dockIcon(id as string) as string
    if id = "play"
        if m.global.audioPlayer.state = "playing" then return "pkg:/images/icons/pause.png"
        return "pkg:/images/icons/play.png"
    end if
    if id = "loop" and m.global.audioPlayer.loopMode = "one" then return "pkg:/images/icons/repeat_one.png"
    return m.dockIcons[id]
end function

' Play sits on an accent disc, a toggle that is on is tinted with the accent, and the ring in the
' cursor color shows which button the remote is on
sub paintDock()
    if not isValid(m.dockOrder) then return

    dockFocused = m.buttons.hasFocus()

    for each id in m.dockOrder
        button = m.dock[id]
        disc = button.getChild(0)
        icon = button.getChild(1)
        focused = dockFocused and id = m.dockFocus

        icon.uri = dockIcon(id)
        button.getChild(2).visible = focused

        if id <> "play"
            active = dockButtonActive(id)
            icon.blendColor = active ? m.accent : ColorPalette.WHITE

            if focused
                disc.blendColor = ColorPalette.WHITE
                disc.opacity = .24
            else if active
                disc.blendColor = m.accent
                disc.opacity = .25
            else
                disc.blendColor = ColorPalette.WHITE
                disc.opacity = .08
            end if
        end if
    end for
end sub

sub moveDockFocus(delta as integer)
    index = 0
    for i = 0 to m.dockOrder.count() - 1
        if m.dockOrder[i] = m.dockFocus then index = i
    end for

    index += delta
    if index < 0 or index >= m.dockOrder.count() then return
    m.dockFocus = m.dockOrder[index]
    paintDock()
end sub

function activateDockButton(id as string) as boolean
    if id = "play" then return playAction()
    if id = "previous" then return previousClicked()
    if id = "next" then return nextClicked()
    if id = "shuffle" then return shuffleClicked()
    if id = "loop" then return loopClicked()
    if id = "favorite" then return favoriteClicked()
    if id = "addToPlaylist" then return addToPlaylistClicked()

    if id = "lyrics" or id = "queue"
        wantsQueue = id = "queue"
        if wantsQueue = m.queueList.visible
            ' OK on the panel that is already showing steps into it
            enterPanel()
        else
            m.showQueue = wantsQueue
            showPanel()
        end if
        return true
    end if

    return false
end function

' Lyrics fill the right side unless Up Next is toggled on or the track has none. They follow
' playback until the cursor steps in, and then the whole song is listed.
sub showPanel()
    lyricsShown = m.hasLyrics and not m.showQueue
    cursoring = lyricsShown and m.lyricsCursor.isInFocusChain()
    if isValid(m.lyrics) then m.lyrics.visible = lyricsShown and not cursoring
    m.lyricsCursor.visible = cursoring
    m.queueList.visible = not lyricsShown
    paintDock()
end sub

' Up from the seek bar, Options, or OK on the toggle that's showing lands on the playing track or
' the line being sung
sub enterPanel()
    if m.queueList.visible
        m.queueList.jumpToItem = currentQueueRow()
        exitScrubMode(m.queueList)
        return
    end if

    m.lyricsCursor.jumpToItem = activeLyricLine()
    exitScrubMode(m.lyricsCursor)
    showPanel()
end sub

sub leavePanel()
    setFocusOnThumb()
    showPanel()
end sub

' A list that was hidden under the cursor still holds focus, so it has to be showing to count
function panelHasFocus() as boolean
    return (m.queueList.visible and m.queueList.isInFocusChain()) or (m.lyricsCursor.visible and m.lyricsCursor.isInFocusChain())
end function

function currentQueueRow() as integer
    row = m.global.queueManager.callFunc("getPosition")
    last = m.global.queueManager.callFunc("getCount") - 1
    if row > last then row = last
    if row < 0 then row = 0
    return row
end function

' The last position this screen saw, which a track change resets to 0 before the player does
function activeLyricLine() as integer
    position = Int(m.lastRecordedPositionTimestamp) * 10000000&
    active = 0
    for i = 0 to m.lyricStarts.count() - 1
        if m.lyricStarts[i] <= position then active = i
    end for
    return active
end function

' Up Next lists the whole queue. Outside the panel it scrolls to the playing track, and inside
' it the cursor stays on its row.
sub loadQueueList()
    queue = m.global.queueManager.callFunc("getQueue")
    playing = currentQueueRow()
    keepRow = m.queueList.itemFocused
    inPanel = m.queueList.isInFocusChain()

    content = CreateObject("roSGNode", "ContentNode")
    for i = 0 to queue.count() - 1
        content.appendChild(queueRow(queue[i], i = playing))
    end for

    m.queueList.content = content
    m.queuePlayingRow = playing
    if not inPanel or keepRow < 0 or keepRow >= queue.count() then keepRow = playing
    m.queueList.jumpToItem = keepRow
end sub

function queueRow(queueItem as object, isCurrent as boolean) as object
    itemJson = queueItem
    if isValid(queueItem.json) then itemJson = queueItem.json

    row = CreateObject("roSGNode", "ContentNode")
    row.title = itemJson.Name ?? itemJson.title ?? ""
    if isValidAndNotEmpty(itemJson.Artists)
        row.description = itemJson.Artists.join(", ")
    else if isString(itemJson.AlbumArtist)
        row.description = itemJson.AlbumArtist
    end if
    row.HDPosterUrl = audioArtworkURL(queueItem, audioArtId(itemJson), ImageType.PRIMARY, { "maxHeight": 84, "maxWidth": 84 })
    if isCurrent then row.addFields({ isCurrent: true })
    return row
end function

' A track change in the same queue only moves the marker, so a long queue isn't rebuilt
sub moveQueueMarker()
    content = m.queueList.content
    if not isValid(content) or content.getChildCount() <> m.global.queueManager.callFunc("getCount")
        loadQueueList()
        return
    end if

    playing = currentQueueRow()
    for each row in [m.queuePlayingRow, playing]
        content.replaceChild(queueRow(m.global.queueManager.callFunc("getItemByIndex", row), row = playing), row)
    end for
    m.queuePlayingRow = playing
    if not m.queueList.isInFocusChain() then m.queueList.jumpToItem = playing
end sub

sub onQueueItemSelected()
    picked = m.queueList.itemSelected
    if picked = currentQueueRow() then return

    ' playNext steps on from the track before, and knows what to do when that one is a video
    m.global.queueManager.callFunc("setPosition", picked - 1)
    m.global.audioPlayer.callFunc("playNext")
end sub

sub loadLyricLines(lines as object)
    m.lyricStarts = []
    content = CreateObject("roSGNode", "ContentNode")
    for each line in lines
        row = content.createChild("ContentNode")
        row.title = line.text ?? ""
        m.lyricStarts.push(line.start ?? 0)
    end for
    m.lyricsCursor.content = content
end sub

sub onLyricLineSelected()
    seconds = m.lyricStarts[m.lyricsCursor.itemSelected] / 10000000.0
    m.global.audioPlayer.seek = seconds
    if isValid(m.lyrics) then m.lyrics.callFunc("findPosition", seconds)
end sub

function favoriteClicked() as boolean
    itemJson = currentItemJson()
    if not isValidAndNotEmpty(itemJson.Id) then return true

    m.isFavorite = not m.isFavorite
    m.favoriteOverrides[itemJson.Id] = m.isFavorite
    paintDock()
    runItemMenuTask(itemMenuRequest(audioMenuSubject(itemJson), "favorite", { value: m.isFavorite }), "onFavoriteSaved")
    return true
end function

' The heart flips at once, so a refusal puts it back
sub onFavoriteSaved(event as object)
    response = event.getData()
    releaseItemMenuTask(event.getRoSGNode(), "response")
    if response.success then return

    itemId = response.request.itemId
    m.favoriteOverrides[itemId] = not response.request.value
    if isStringEqual(currentItemJson().Id, itemId)
        m.isFavorite = not response.request.value
        paintDock()
    end if
end sub

function addToPlaylistClicked() as boolean
    itemJson = currentItemJson()
    if isValidAndNotEmpty(itemJson.Id) then itemMenuLoadPicker(audioMenuSubject(itemJson), "playlists")
    return true
end function

function audioMenuSubject(itemJson as object) as object
    return { card: invalid, json: itemJson, options: {}, entries: [], returnFocus: m.buttons }
end function

' Nothing on this screen shows what the playlist picker changes
sub itemMenuChanged(_action as string, _card as dynamic, _menuJson as object)
end sub

sub setupInfoNodes()
    m.albumCover = m.top.findNode("albumCover")
    m.backDrop = m.top.findNode("backdrop")
    m.background = m.top.findNode("background")
    m.playPosition = m.top.findNode("playPosition")
    m.bufferPosition = m.top.findNode("bufferPosition")
    m.seekBar = m.top.findNode("seekBar")
    m.thumb = m.top.findNode("thumb")
    m.positionTimestamp = m.top.findNode("positionTimestamp")
    m.seekPosition = m.top.findNode("seekPosition")
    m.seekTimestamp = m.top.findNode("seekTimestamp")
    m.totalLengthTimestamp = m.top.findNode("totalLengthTimestamp")
    m.queueList = m.top.findNode("queueList")
    m.lyricsCursor = m.top.findNode("lyricsCursor")
    m.qualityBadge = m.top.findNode("qualityBadge")
    m.qualityPill = m.top.findNode("qualityPill")
    m.qualityText = m.top.findNode("qualityText")
end sub

sub bufferPositionChanged()
    if m.inScrubMode then return

    if not isValid(m.global.audioPlayer.bufferingStatus)
        bufferPositionBarWidth = m.seekBar.width
    else
        bufferPositionBarWidth = m.seekBar.width * m.global.audioPlayer.bufferingStatus.percentage
    end if

    ' Ensure position bar is never wider than the seek bar
    if bufferPositionBarWidth > m.seekBar.width
        bufferPositionBarWidth = m.seekBar.width
    end if

    ' Use animation to make the display smooth
    m.bufferPositionAnimationWidth.keyValue = [m.bufferPosition.width, bufferPositionBarWidth]
    m.bufferPositionAnimation.control = "start"
end sub

sub audioPositionChanged()
    stopLoadingSpinner()

    if m.global.audioPlayer.position = 0
        m.playPosition.width = 0
    end if

    if not isValid(m.global.audioPlayer.position)
        playPositionBarWidth = 0
    else if not isValid(m.songDuration)
        playPositionBarWidth = 0
    else
        songPercentComplete = m.global.audioPlayer.position / m.songDuration
        playPositionBarWidth = m.seekBar.width * songPercentComplete
    end if

    ' Ensure position bar is never wider than the seek bar
    if playPositionBarWidth > m.seekBar.width
        playPositionBarWidth = m.seekBar.width
    end if

    if not m.inScrubMode
        moveSeekbarThumb(playPositionBarWidth)
        ' Change the seek position timestamp
        seekText = secondsToHuman(m.global.audioPlayer.position, false)
        if m.hasLyrics
            seekText += " • Seeking will likely cause lyrics to desync"
        end if

        m.seekTimestamp.text = seekText
    end if

    ' Use animation to make the display smooth
    m.playPositionAnimationWidth.keyValue = [m.playPosition.width, playPositionBarWidth]
    m.playPositionAnimation.control = "start"

    ' Update displayed position timestamp
    if isValid(m.global.audioPlayer.position)
        m.lastRecordedPositionTimestamp = m.global.audioPlayer.position
        m.positionTimestamp.text = secondsToHuman(m.global.audioPlayer.position, false)
        if isValid(m.lyrics)
            m.lyrics.positionTime = m.global.audioPlayer.position
        end if
    else
        m.lastRecordedPositionTimestamp = 0
        m.positionTimestamp.text = "0:00"
        if isValid(m.lyrics)
            m.lyrics.positionTime = 0
        end if
    end if

    ' Only fall into screensaver logic if the user has screensaver enabled in Roku settings
    if m.screenSaverTimeout > 0
        if m.di.TimeSinceLastKeypress() >= m.screenSaverTimeout - 2
            if not screenSaverActive()
                startScreenSaver()
            end if
        end if
    end if
end sub

function screenSaverActive() as boolean
    return m.screenSaverBackground.visible or m.screenSaverAlbumCover.opacity > 0 or m.PosterOne.opacity > 0
end function

sub startScreenSaver()
    m.screenSaverBackground.visible = true

    if m.albumCover.uri = ""
        ' Logo Screensaver
        m.PosterOne.visible = true
        m.PosterOneFadeIn.control = "start"
        m.BounceAnimation.control = "start"
    else
        ' Album Art Screensaver
        m.screenSaverAlbumCoverFadeIn.control = "start"
        m.screenSaverAlbumAnimation.control = "start"
    end if
end sub

sub endScreenSaver()
    m.PosterOneFadeIn.control = "pause"
    m.screenSaverAlbumCoverFadeIn.control = "pause"
    m.screenSaverAlbumAnimation.control = "pause"
    m.BounceAnimation.control = "pause"
    m.screenSaverBackground.visible = false
    m.screenSaverAlbumCover.opacity = 0
    m.PosterOne.opacity = 0
end sub

' A paused track keeps its mini player, anything else that isn't playing stops
sub displayMiniPlayer()
    state = m.global.audioPlayer.state
    if not isStringEqual(state, MediaPlaybackState.PLAYING) and not isStringEqual(state, MediaPlaybackState.PAUSED)
        m.global.queueManager.callFunc("clear")
        m.global.audioPlayer.control = "stop"
        return
    end if

    if m.playlistTypeCount > 1 then return

    scene = m.top.getScene()
    if not isValid(scene) then return

    audioMiniPlayer = scene.findNode("audioMiniPlayer")
    if not isValid(audioMiniPlayer) then return

    audioMiniPlayer.callFunc("setVisible", true)
end sub

function playAction() as boolean
    if m.global.audioPlayer.state = "playing"
        m.global.audioPlayer.control = "pause"
    else if m.global.audioPlayer.state = "paused"
        m.global.audioPlayer.control = "resume"
    else if m.global.audioPlayer.state = "finished"
        m.global.audioPlayer.control = "play"
    end if

    return true
end function

function stopClicked() as boolean
    m.global.queueManager.callFunc("clear")
    m.global.audioPlayer.control = "stop"
    if m.top.returnOnStop
        unobserveAll()
        m.global.sceneManager.callFunc("popScene")
    end if
    return true
end function

function previousClicked() as boolean
    m.global.audioPlayer.callFunc("playPrevious")
    return true
end function

function loopClicked() as boolean

    if m.global.audioPlayer.loopMode = ""
        m.global.audioPlayer.loopMode = "all"
    else if m.global.audioPlayer.loopMode = "all"
        m.global.audioPlayer.loopMode = "one"
    else
        m.global.audioPlayer.loopMode = ""
    end if

    return true
end function

function nextClicked() as boolean
    m.global.audioPlayer.callFunc("playNext")
    return true
end function

sub toggleShuffleEnabled()
    m.global.queueManager.callFunc("toggleShuffle")
end sub

function findCurrentSongIndex(songList) as integer
    if not isValidAndNotEmpty(songList) then return 0

    for i = 0 to songList.count() - 1
        if songList[i].id = m.global.queueManager.callFunc("getCurrentItem").id
            return i
        end if
    end for

    return 0
end function

function shuffleClicked() as boolean
    currentSongIndex = findCurrentSongIndex(m.global.queueManager.callFunc("getUnshuffledQueue"))

    toggleShuffleEnabled()

    if not m.global.queueManager.callFunc("getIsShuffled")
        m.global.queueManager.callFunc("setPosition", currentSongIndex)
    end if

    loadQueueList()
    paintDock()
    return true
end function

sub onAudioDataChanged()
    stopLoadingSpinner()
    data = m.global.audioPlayer.audioData

    if not isValidAndNotEmpty(data)
        ' If the last item finished playing,
        if m.global.queueManager.callFunc("getPosition") = m.global.queueManager.callFunc("getCount") - 1
            if m.top.returnOnStop
                unobserveAll()
                m.global.sceneManager.callFunc("popScene")
                return
            end if
        end if

        m.top.state = "finished"
        return
    end if

    data = data[0]
    ' Reset buffer bar without animation
    m.bufferPosition.width = 0
    m.hasLyrics = false
    wasInPanel = panelHasFocus()

    ' Focus stays where it was, only a scrub in progress is dropped
    m.inScrubMode = false
    resetSeekbarThumb()
    m.lastRecordedPositionTimestamp = 0
    m.positionTimestamp.text = "0:00"
    m.playPosition.width = 0

    useMetaTask = false
    currentItem = m.global.queueManager.callFunc("getCurrentItem")

    if not isValid(currentItem.RunTimeTicks)
        useMetaTask = true
    end if

    if not isValid(currentItem.AlbumArtist)
        useMetaTask = true
    end if

    if not isValid(currentItem.name)
        useMetaTask = true
    end if

    if not isValid(currentItem.Artists)
        useMetaTask = true
    end if

    itemJson = currentItemJson()
    favoriteOverride = m.favoriteOverrides[itemJson.Id ?? ""]
    if isValid(favoriteOverride)
        m.isFavorite = favoriteOverride
    else
        m.isFavorite = chainLookupReturn(itemJson, "UserData.IsFavorite", false) = true
    end if

    if useMetaTask
        setTaskServerFromItem(m.LoadMetaDataTask, currentItem)
        m.LoadMetaDataTask.itemId = currentItem.id
        m.LoadMetaDataTask.observeField("content", "onMetaDataLoaded")
        m.LoadMetaDataTask.control = TaskControl.RUN
    else
        setArtwork(currentItem, itemJson)
        setOnScreenTextValues(currentItem)
        m.songDuration = currentItem.RunTimeTicks / 10000000.0

        ' Update displayed total audio length
        musicDisplay = m.global.session.user.settings["playback.musicTimeDisplay"] ?? "elapsed"
        if musicDisplay = "remaining"
            m.totalLengthTimestamp.text = "-" + ticksToHuman(currentItem.RunTimeTicks)
        else
            m.totalLengthTimestamp.text = ticksToHuman(currentItem.RunTimeTicks)
        end if
    end if

    setQualityBadge(data.qualityLabel)

    ' Validate lyrics data and for now only support timed lyrics
    if data.hasLyrics
        if not isValid(data.lyricdata) then data.hasLyrics = false
    end if

    if data.hasLyrics
        if not isValidAndNotEmpty(data.lyricdata.Lyrics) then data.hasLyrics = false
    end if

    if data.hasLyrics
        if not isValidAndNotEmpty(data.lyricdata.Lyrics[0]) then data.hasLyrics = false
    end if

    if data.hasLyrics
        if not isValid(data.lyricdata.Lyrics[0].start) then data.hasLyrics = false
    end if

    moveDisplayElements(data.hasLyrics)

    if data.haslyrics
        m.hasLyrics = true
        m.seekTimestamp.text = m.seekTimestamp.text + " • Seeking will likely cause lyrics to desync"
        if isValid(m.lyrics)
            m.lyrics.lyricdata = data.lyricdata
        end if
        loadLyricLines(data.lyricdata.Lyrics)
    end if

    moveQueueMarker()
    layoutDock()
    showPanel()

    ' The panel can swap under the cursor, lyrics coming or going with the track
    if wasInPanel and not panelHasFocus() then enterPanel()
    if m.lyricsCursor.isInFocusChain() then m.lyricsCursor.jumpToItem = activeLyricLine()
end sub

sub moveDisplayElements(hasLyrics as boolean)
    if hasLyrics
        m.seekTimestamp.width = 620
        m.seekPosition.width = 620
        showLyrics()
    else
        m.seekTimestamp.width = 110
        m.seekPosition.width = 110
        hideLyrics()
    end if
end sub

sub showLyrics()
    ' make sure if we have old lyrics up and showing that we clear those first
    if isValid(m.lyrics)
        hideLyrics()
    end if

    m.lyrics = CreateObject("roSGNode", "Lyrics")
    m.lyrics.translation = "[660, 220]"
    m.lyrics.width = 1180
    m.lyrics.findNode("currentLine").color = m.accent
    m.top.insertChild(m.lyrics, 2)
end sub

sub hideLyrics()
    if not isValid(m.lyrics) then return

    m.top.removeChild(m.lyrics)
    m.lyrics = invalid
end sub

sub onMetaDataLoaded()
    data = m.LoadMetaDataTask.content[0]
    m.LoadMetaDataTask.unobserveField("content")
    if isValidAndNotEmpty(data) and isValid(data.json)
        setArtwork(data, data.json)
        setPosterImage(data.posterURL)
        setOnScreenTextValues(data.json)

        if not m.favoriteOverrides.DoesExist(data.json.Id ?? "")
            m.isFavorite = chainLookupReturn(data.json, "UserData.IsFavorite", false) = true
            paintDock()
        end if

        if isValid(data.json.RunTimeTicks)
            m.songDuration = data.json.RunTimeTicks / 10000000.0

            ' Update displayed total audio length
            m.totalLengthTimestamp.text = ticksToHuman(data.json.RunTimeTicks)
            if m.global.audioPlayer.state = "paused" then audioPositionChanged()
        end if
    end if
end sub

' The cover, and a heavily blurred copy of it behind everything
sub setArtwork(item as object, itemJson as object)
    artId = audioArtId(itemJson)
    if artId = "" then return

    setPosterImage(audioArtworkURL(item, artId, ImageType.PRIMARY, { "maxHeight": 480, "maxWidth": 480 }))
    setBackdropImage(audioArtworkURL(item, artId, ImageType.PRIMARY, { "maxHeight": 360, "maxWidth": 360, "blur": 18 }))
end sub

' Set poster image on screen
sub setPosterImage(posterURL)
    if isValid(posterURL)
        if m.albumCover.uri <> posterURL
            m.albumCover.uri = posterURL
            m.screenSaverAlbumCover.uri = posterURL
        end if
    end if
end sub

' Populate on screen text variables
sub setOnScreenTextValues(json)
    if isValid(json)
        if isValidAndNotEmpty(json.Artists)
            setFieldTextValue("artist", json.Artists[0].replace(chr(8208), "-"))
        end if

        if isValidAndNotEmpty(json.name)
            setFieldTextValue("song", json.name)
        end if

        if isString(json.Album)
            setFieldTextValue("album", json.Album)
        else
            setFieldTextValue("album", "")
        end if
    end if
end sub

sub setQualityBadge(label as dynamic)
    if not isValidAndNotEmpty(label)
        m.qualityBadge.visible = false
        return
    end if

    m.qualityText.text = label
    pillWidth = m.qualityText.boundingRect().width + 40
    m.qualityText.translation = [20, 0]
    m.qualityPill.width = pillWidth
    m.qualityBadge.translation = [1840 - pillWidth, 44]
    m.qualityBadge.visible = true
end sub

' Add backdrop image to screen
sub setBackdropImage(data)
    if not isValid(data)
        m.background.visible = false
        return
    end if

    if isStringEqual(data, string.EMPTY)
        m.background.visible = false
        return
    end if

    if m.backDrop.uri <> data
        m.backDrop.uri = data
        m.background.visible = true
    end if
end sub

' processScrubAction: Handles +/- seeking for the audio trickplay bar
'
' @param {integer} seekStep - seconds to move the trickplay position (negative values allowed)
sub processScrubAction(seekStep as integer)
    ' Prepare starting playStart property value
    if m.scrubTimestamp = -1
        m.scrubTimestamp = m.lastRecordedPositionTimestamp
    end if

    ' Don't let seek to go past the end of the song
    if m.scrubTimestamp + seekStep > m.songDuration - 5
        return
    end if

    if seekStep > 0
        ' Move seek forward
        m.scrubTimestamp += seekStep
    else if m.scrubTimestamp >= Abs(seekStep)
        ' If back seek won't go below 0, move seek back
        m.scrubTimestamp += seekStep
    else
        ' Back seek would go below 0, set to 0 directly
        m.scrubTimestamp = 0
    end if

    ' Move the seedbar thumb forward
    songPercentComplete = m.scrubTimestamp / m.songDuration
    playPositionBarWidth = m.seekBar.width * songPercentComplete

    moveSeekbarThumb(playPositionBarWidth)

    ' Change the displayed position timestamp
    seekText = secondsToHuman(m.scrubTimestamp, false)
    if m.hasLyrics
        seekText += " • Seeking will likely cause lyrics to desync"
    end if
    m.seekTimestamp.text = seekText
end sub

' resetSeekbarThumb: Resets the thumb to the playing position
'
sub resetSeekbarThumb()
    m.scrubTimestamp = -1
    moveSeekbarThumb(m.playPosition.width)
end sub

' moveSeekbarThumb: Positions the thumb on the seekbar
'
' @param {float} playPositionBarWidth - width of the play position bar
sub moveSeekbarThumb(playPositionBarWidth as float)
    ' Center the thumb on the play position bar
    thumbPostionLeft = playPositionBarWidth - 10

    ' Don't let thumb go below 0
    if thumbPostionLeft < 0 then thumbPostionLeft = 0

    ' Don't let thumb go past end of seekbar
    if thumbPostionLeft > m.seekBar.width - 25
        thumbPostionLeft = m.seekBar.width - 25
    end if

    ' Move the thumb
    m.thumb.translation = [thumbPostionLeft, m.thumb.translation[1]]

    ' Move the seek position element so it follows the thumb, without leaving the screen
    popupLeft = m.seekBar.translation[0] + thumbPostionLeft - (m.seekPosition.width / 2)
    if popupLeft < 40 then popupLeft = 40
    if popupLeft > 1880 - m.seekPosition.width then popupLeft = 1880 - m.seekPosition.width
    m.seekPosition.translation = [popupLeft, m.seekPosition.translation[1]]
end sub

' exitScrubMode: Moves player out of scrub mode state,  resets back to standard play mode
'
sub exitScrubMode(nodeReceivingFocus = m.buttons as dynamic)
    if not isValid(nodeReceivingFocus)
        nodeReceivingFocus = m.buttons
    end if

    focusOn(nodeReceivingFocus)

    if m.seekPosition.visible
        m.seekPosition.visible = false
    end if

    resetSeekbarThumb()

    m.inScrubMode = false
    m.thumb.visible = false

    paintDock()
end sub

sub setFocusOnThumb()
    m.thumb.visible = true

    if not m.seekPosition.visible
        m.seekPosition.visible = true
    end if

    focusOn(m.thumb)
    paintDock()
end sub

' A node keeps reporting hasFocus after focus moves to one outside it, so the others let go first
sub focusOn(target as object)
    for each node in [m.buttons, m.thumb, m.queueList, m.lyricsCursor]
        if not node.isSameNode(target) then node.setFocus(false)
    end for
    target.setFocus(true)
end sub

' The dock, the seek bar and the panel are stacked, and Up and Down walk between them
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A key that ends the screensaver does nothing else
    if screenSaverActive()
        endScreenSaver()
        return true
    end if

    ' The lists keep Up, Down and OK. Left, Back and Down past the last row go back to the seek bar.
    if m.queueList.hasFocus() or m.lyricsCursor.hasFocus()
        if key = KeyCode.LEFT or key = KeyCode.BACK or key = KeyCode.DOWN
            leavePanel()
            return true
        end if

        if key = KeyCode.PLAY then return playAction()
        return true
    end if

    if m.thumb.hasFocus()
        if key = KeyCode.RIGHT
            m.inScrubMode = true
            processScrubAction(10)
            return true
        end if

        if key = KeyCode.LEFT
            m.inScrubMode = true
            processScrubAction(-10)
            return true
        end if

        if key = KeyCode.UP
            enterPanel()
            return true
        end if

        if key = KeyCode.DOWN
            exitScrubMode(m.buttons)
            return true
        end if

        if key = KeyCode.OK or key = KeyCode.PLAY
            if m.inScrubMode
                startLoadingSpinner()
                m.inScrubMode = false
                m.global.audioPlayer.seek = m.scrubTimestamp
                if isValid(m.lyrics)
                    m.lyrics.callFunc("findPosition", m.scrubTimestamp)
                end if
                return true
            end if

            return playAction()
        end if
    end if

    if m.buttons.hasFocus()
        if key = KeyCode.UP
            setFocusOnThumb()
            return true
        end if

        if key = KeyCode.OK
            return activateDockButton(m.dockFocus)
        end if

        if key = KeyCode.RIGHT
            moveDockFocus(1)
            return true
        end if

        if key = KeyCode.LEFT
            moveDockFocus(-1)
            return true
        end if

        if key = KeyCode.DOWN then return true
    end if

    if key = KeyCode.OPTIONS
        enterPanel()
        return true
    end if

    if key = KeyCode.PLAY
        return playAction()
    else if key = KeyCode.BACK
        if m.playlistTypeCount > 1
            stopClicked()
        else
            displayMiniPlayer()
        end if

        unobserveAll()
        ' This doesn't return true, so Back still reaches the scene manager
    else if key = KeyCode.REWIND
        return previousClicked()
    else if key = KeyCode.FASTFORWRD
        return nextClicked()
    end if

    return false
end function

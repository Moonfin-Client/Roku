<?xml version="1.0" encoding="utf-8"?>
<!-- What every music category screen is built on: a main page and a side column that scroll
     on their own, and the fields the music library hands it. Each screen fills the rows of its
     regions through musicCategoryHost.bs, which builds only the rows in view. -->
<component name="MusicCategoryScreen" extends="JFScreen">
  <children>
    <!-- Quick Access puts the categories in a rail down the left instead of the strip -->
    <Rectangle id="railBg" visible="false" width="248" height="1080" opacity="0.03" />
    <Group id="railRegion" />
    <Group id="mainRegion" />
    <!-- Playlists clips its right side under the header, which nothing else needs -->
    <Group id="sideClip">
      <Group id="sideRegion" />
    </Group>

    <Animation id="mainScroll" duration="0.2" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="mainScrollInterp" key="[0.0, 1.0]" fieldToInterp="mainRegion.translation" />
    </Animation>
    <Animation id="sideScroll" duration="0.2" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="sideScrollInterp" key="[0.0, 1.0]" fieldToInterp="sideRegion.translation" />
    </Animation>
    <Animation id="railScroll" duration="0.2" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="railScrollInterp" key="[0.0, 1.0]" fieldToInterp="railRegion.translation" />
    </Animation>
  </children>

  <interface>
    <field id="parentItem" type="node" />
    <!-- Which list or tab a See All asked for -->
    <field id="start" type="string" />
    <!-- Opened from another category's strip or rail, so the remote starts there -->
    <field id="fromStrip" type="boolean" value="false" />
    <!-- The category the strip or rail asked for, which the music library swaps this screen for -->
    <field id="switchCategory" type="string" alwaysNotify="true" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="genreItemSelected" type="assocarray" alwaysNotify="true" />
  </interface>
</component>

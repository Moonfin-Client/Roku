import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

sub itemContentChanged()
    row = m.top.itemContent
    if not isValid(row) then return

    isCurrent = row.hasField("isCurrent")
    color = isCurrent ? themeChrome.Accent() : ColorPalette.WHITE

    title = m.top.findNode("title")
    title.text = row.title
    title.color = color
    m.top.findNode("artist").text = row.description
    m.top.findNode("thumb").uri = row.HDPosterUrl

    nowPlaying = m.top.findNode("nowPlaying")
    nowPlaying.visible = isCurrent
    nowPlaying.blendColor = color
end sub

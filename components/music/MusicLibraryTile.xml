<?xml version="1.0" encoding="utf-8"?>
<!-- One stop on the Quick Access and Immersive music libraries: a cover card, a song row, a
     quick tile, a genre tile, a rail entry or a button, as setup is told. The screen moves the
     focus, so a tile only draws whether it has it. -->
<component name="MusicLibraryTile" extends="Group">
  <children>
    <Group id="face">
      <Poster id="fill" visible="false" />
      <Poster id="artBg" uri="pkg:/images/details/surface11.9.png" blendColor="#FFFFFF" opacity="0.06" visible="false" />
      <MaskGroup id="artMask" visible="false">
        <Poster id="art" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="glyph" horizAlign="center" vertAlign="center" />
      <Label id="leading" horizAlign="right" vertAlign="center" />
      <Label id="title" />
      <Label id="subtitle" />
      <Label id="trailing" vertAlign="center" />
      <Poster id="ring" visible="false" />
    </Group>
  </children>

  <interface>
    <field id="focus" type="boolean" value="false" onChange="applyState" />
    <!-- The song the album was left on -->
    <field id="highlighted" type="boolean" value="false" onChange="applyState" />
    <function name="setup" />
  </interface>
</component>

import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/settingsGlyphs.bs"
import "pkg:/source/utils/themeChrome.bs"

const COVER_MASK = "pkg:/images/musicCoverMask.webp"
const THUMB_MASK = "pkg:/images/musicThumbMask.webp"
const ROUND_MASK = "pkg:/images/icons/circle.webp"
const PILL = "pkg:/images/icons/pill-focus.9.png"
const PILL_RING = "pkg:/images/details/tabborderfocus.9.png"
const BOX = "pkg:/images/details/surface11.9.png"
const BOX_RING = "pkg:/images/details/outline11.9.png"
const TILE = "pkg:/images/details/surface12.9.png"
const CIRCLE = "pkg:/images/icons/circle.webp"
const CIRCLE_RING = "pkg:/images/icons/circleRing.webp"
' A card's focus ring stands this far out from its cover
const RING_INSET = 5

sub init()
    m.face = m.top.findNode("face")
    m.fill = m.top.findNode("fill")
    m.artBg = m.top.findNode("artBg")
    m.artMask = m.top.findNode("artMask")
    m.art = m.top.findNode("art")
    m.glyph = m.top.findNode("glyph")
    m.leading = m.top.findNode("leading")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.trailing = m.top.findNode("trailing")
    m.ring = m.top.findNode("ring")

    m.accent = themeChrome.Accent()
    m.ink = themeChrome.OnBackground()
    m.focusFill = themeChrome.Token("buttonFocused", "0xFFFFFFFF")
    m.focusInk = themeChrome.Token("onButtonFocused", "0x000000FF")
    m.ring.blendColor = m.accent
    m.kind = ""
    m.grow = 1.0
end sub

' args: kind (card, row, quick, genre, mix, rail or button), width, height, title, subtitle,
' trailing, leading (a track number, or a mix's eyebrow), image, round, art (a rail entry with
' a cover), glyph (the icon, or what shows while there's no image), color (a genre's or a
' mix's), ink (a mix's), selected (a rail entry), text sizes and spacing for cards and rows and,
' for a button, glyphSize, textSize, padX, bold, fill, fillOpacity, ink, iconInk, minWidth, pill
' (a pill's ring on a button with no icon), pressFill (filled on focus rather than ringed),
' focusFill and focusInk. Hands back the width, which a button takes from its words.
function setup(args as object) as integer
    m.kind = args.kind
    width = args.width ?? 0
    height = args.height ?? width
    m.color = args.color
    m.selected = args.selected = true

    m.title.text = args.title ?? ""
    m.subtitle.text = args.subtitle ?? ""
    m.trailing.text = args.trailing ?? ""
    m.leading.text = args.leading ?? ""
    m.glyphColor = themeChrome.WithAlpha(m.ink, "4D")
    m.glyphSize = Int(width / 3)

    if m.kind = "card"
        layoutCard(args, width)
    else if m.kind = "row"
        layoutRow(args, width, height)
    else if m.kind = "quick"
        layoutQuick(width, height)
    else if m.kind = "genre"
        layoutGenre(width, height)
    else if m.kind = "mix"
        layoutMix(args, width, height)
    else if m.kind = "rail"
        layoutRail(width, height, args.art = true)
    else
        width = layoutButton(args, height)
    end if

    image = args.image ?? ""
    m.art.uri = image
    m.glyph.visible = image = "" and isValidAndNotEmpty(args.glyph)

    ' A theme puts its own font on every label, the glyph's too, so the glyph goes on after
    fontApply.ApplyThemeFonts(m.face)
    glyphFont = CreateObject("roSGNode", "Font")
    glyphFont.uri = settingsGlyphs.FONT_URI
    glyphFont.size = m.glyphSize
    m.glyph.font = glyphFont
    m.glyph.text = settingsGlyphs.Char(args.glyph ?? "music_note")

    applyState()
    return width
end function

' The cover with its name and who it's by under it
sub layoutCard(args as object, size as integer)
    if args.round = true
        placeArt(0, 0, size, ROUND_MASK)
        placeRing(-RING_INSET, -RING_INSET, size + RING_INSET * 2, size + RING_INSET * 2, CIRCLE_RING)
    else
        placeArt(0, 0, size, COVER_MASK)
        placeRing(-RING_INSET, -RING_INSET, size + RING_INSET * 2, size + RING_INSET * 2, BOX_RING)
    end if
    titleSize = args.titleSize ?? 13
    textGap = args.textGap ?? 6
    textWidth = args.textWidth ?? size
    textX = (size - textWidth) / 2
    setFont(m.title, titleSize, true)
    setFont(m.subtitle, args.subtitleSize ?? 12, false)
    m.subtitle.color = themeChrome.WithAlpha(m.ink, "99")
    for each label in [m.title, m.subtitle]
        label.width = textWidth
        label.maxLines = 1
        if args.centered = true then label.horizAlign = "center"
    end for
    m.title.translation = [textX, size + textGap]
    m.subtitle.translation = [textX, size + textGap + Int(titleSize * 1.4)]
    m.face.scaleRotateCenter = [size / 2, size / 2]
    m.grow = 1.05
end sub

' A song: its number or its rank, its cover when it's given one, its name over who it's by,
' and its length at the end
sub layoutRow(args as object, width as integer, height as integer)
    placeBox(width, height, BOX, BOX_RING)
    padX = args.padX ?? 8
    gap = args.gap ?? 14
    m.rank = args.rank = true
    m.leadingSize = args.leadingSize ?? 14
    x = padX
    if m.leading.text <> ""
        leadingWidth = args.leadingWidth ?? 28
        setFont(m.leading, m.leadingSize, m.rank)
        m.leading.width = leadingWidth
        m.leading.height = height
        m.leading.translation = [x, 0]
        x += leadingWidth + gap
    end if
    if isValid(args.image) or isValid(args.glyph)
        artSize = args.artSize ?? 44
        placeArt(x, (height - artSize) / 2, artSize, THUMB_MASK)
        m.glyphSize = Int(artSize * 0.46)
        x += artSize + gap
    end if

    right = width - padX
    if m.trailing.text <> ""
        setFont(m.trailing, args.trailingSize ?? 13, false)
        trailingWidth = measuredWidth(m.trailing)
        m.trailing.height = height
        m.trailing.translation = [right - trailingWidth, 0]
        right -= trailingWidth + 12
    end if

    titleSize = args.titleSize ?? 15
    subtitleSize = args.subtitleSize ?? 13
    setFont(m.title, titleSize, true)
    setFont(m.subtitle, subtitleSize, false)
    for each label in [m.title, m.subtitle]
        label.width = right - x
        label.maxLines = 1
    end for
    if m.subtitle.text = ""
        m.title.height = height
        m.title.vertAlign = "center"
        m.title.translation = [x, 0]
    else
        titleLine = Int(titleSize * 4 / 3 + 0.5)
        top = (height - titleLine - Int(subtitleSize * 1.4)) / 2
        m.title.translation = [x, top]
        m.subtitle.translation = [x, top + titleLine]
    end if
end sub

' An album or playlist to jump back into, its cover at the start and its name beside it
sub layoutQuick(width as integer, height as integer)
    placeBox(width, height, BOX, BOX_RING)
    placeArt(0, 0, height, THUMB_MASK)
    setFont(m.title, 14, true)
    m.title.width = width - height - 22
    m.title.height = height
    m.title.maxLines = 2
    m.title.wrap = true
    m.title.vertAlign = "center"
    m.title.translation = [height + 12, 0]
    m.face.scaleRotateCenter = [width / 2, height / 2]
    m.grow = 1.02
end sub

' A genre: its name over a solid color
sub layoutGenre(width as integer, height as integer)
    placeBox(width, height, TILE, BOX_RING)
    setFont(m.title, 18, true)
    m.title.width = width - 24
    m.title.maxLines = 1
    m.title.translation = [12, height - 34]
    m.face.scaleRotateCenter = [width / 2, height / 2]
    m.grow = 1.02
end sub

' A mix or a genre station: a solid color with an eyebrow, a title and a line under it, and
' either a play circle in the corner or a chip with an icon and a word at the bottom
sub layoutMix(args as object, width as integer, height as integer)
    placeBox(width, height, TILE, BOX_RING)
    ' The ring stands off the tile, since a tile in the accent would hide one on its edge
    placeRing(-RING_INSET, -RING_INSET, width + RING_INSET * 2, height + RING_INSET * 2, BOX_RING)
    m.mixInk = args.ink ?? "#FFFFFF"
    padX = 27
    y = 24
    if m.leading.text <> ""
        setFont(m.leading, 18, true)
        m.leading.horizAlign = "left"
        m.leading.vertAlign = "top"
        m.leading.width = width - padX * 2
        m.leading.translation = [padX, y]
        y += 27
    end if
    titleSize = args.titleSize ?? 36
    setFont(m.title, titleSize, true)
    setFont(m.subtitle, 21, false)
    for each label in [m.title, m.subtitle]
        label.width = width - padX * 2
        label.maxLines = 1
    end for
    m.title.translation = [padX, y]
    m.subtitle.translation = [padX, y + Int(titleSize * 1.3)]
    m.face.scaleRotateCenter = [width / 2, height / 2]
    m.grow = 1.03

    m.artBg.visible = true
    if m.trailing.text = ""
        playSize = 72
        m.artBg.uri = CIRCLE
        m.artBg.width = playSize
        m.artBg.height = playSize
        m.artBg.translation = [width - 24 - playSize, height - 24 - playSize]
        m.glyphSize = 39
        m.glyph.width = playSize
        m.glyph.height = playSize
        m.glyph.translation = m.artBg.translation
        return
    end if

    chipHeight = 54
    chipY = height - 24 - chipHeight
    m.glyphSize = 30
    m.glyph.width = m.glyphSize
    m.glyph.height = chipHeight
    m.glyph.translation = [padX + 15, chipY]
    setFont(m.trailing, 21, true)
    m.trailing.height = chipHeight
    m.trailing.translation = [padX + 15 + m.glyphSize + 9, chipY]
    m.artBg.uri = PILL
    m.artBg.width = 15 + m.glyphSize + 9 + measuredWidth(m.trailing) + 21
    m.artBg.height = chipHeight
    m.artBg.translation = [padX, chipY]
end sub

' A rail entry: an icon, or a playlist's cover, and its name
sub layoutRail(width as integer, height as integer, withArt as boolean)
    placeBox(width, height, BOX, BOX_RING)
    x = 12
    if withArt
        placeArt(x, (height - 32) / 2, 32, THUMB_MASK)
        m.glyphSize = 16
        x += 32 + 12
        setFont(m.title, 14, true)
    else
        m.glyph.width = 20
        m.glyph.height = height
        m.glyph.translation = [x, 0]
        m.glyphSize = 20
        x += 20 + 12
        setFont(m.title, 15, true)
    end if
    m.title.width = width - x - 12
    m.title.height = height
    m.title.maxLines = 1
    m.title.vertAlign = "center"
    m.title.translation = [x, 0]
end sub

' A pill with an icon and a word, a bare word, or a circle with only an icon
function layoutButton(args as object, height as integer) as integer
    m.restFill = args.fill ?? "#FFFFFF"
    m.restFillOpacity = args.fillOpacity ?? 0.0
    m.restInk = args.ink ?? m.ink
    m.iconInk = args.iconInk ?? m.restInk
    m.pressFill = args.pressFill = true
    m.pressedFill = args.focusFill ?? m.focusFill
    m.pressedInk = args.focusInk ?? m.focusInk
    m.glyphSize = args.glyphSize ?? 22
    hasGlyph = isValidAndNotEmpty(args.glyph)

    if m.title.text = ""
        width = height
        placeBox(width, height, CIRCLE, CIRCLE_RING)
        m.glyph.width = width
        m.glyph.height = height
        return width
    end if

    padX = args.padX ?? 24
    setFont(m.title, args.textSize ?? 16, args.bold <> false)
    textWidth = measuredWidth(m.title)
    m.title.height = height
    m.title.vertAlign = "center"
    width = padX + textWidth + padX
    if hasGlyph then width += m.glyphSize + 8
    x = padX
    if isValid(args.minWidth) and args.minWidth > width
        x += (args.minWidth - width) / 2
        width = args.minWidth
    end if
    if hasGlyph
        m.glyph.width = m.glyphSize
        m.glyph.height = height
        m.glyph.translation = [x, 0]
        x += m.glyphSize + 8
    end if
    m.title.translation = [x, 0]
    ringUri = BOX_RING
    if hasGlyph or args.pill = true then ringUri = PILL_RING
    placeBox(width, height, PILL, ringUri)
    return width
end function

sub setFont(label as object, size as integer, bold as boolean)
    if bold
        label.font = "font:MediumBoldSystemFont"
    else
        label.font = "font:MediumSystemFont"
    end if
    label.font.size = size
end sub

' A label reports back the width it was given, so that has to go before its words are measured.
' The theme's font goes on first, since that's the one it's drawn in.
function measuredWidth(label as object) as integer
    fontApply.ApplyThemeFonts(label)
    label.width = 0
    width = label.boundingRect().width
    label.width = width
    return width
end function

sub placeBox(width as integer, height as integer, fillUri as string, ringUri as string)
    m.fill.uri = fillUri
    m.fill.width = width
    m.fill.height = height
    placeRing(0, 0, width, height, ringUri)
end sub

sub placeArt(x as integer, y as integer, size as integer, maskUri as string)
    m.artMask.maskUri = maskUri
    m.artMask.maskSize = [size, size]
    m.artMask.translation = [x, y]
    m.artMask.visible = true
    m.art.width = size
    m.art.height = size
    m.art.loadWidth = size
    m.art.loadHeight = size
    if maskUri = ROUND_MASK then m.artBg.uri = CIRCLE
    m.artBg.width = size
    m.artBg.height = size
    m.artBg.translation = [x, y]
    m.artBg.visible = true
    m.glyph.width = size
    m.glyph.height = size
    m.glyph.translation = [x, y]
end sub

sub placeRing(x as integer, y as integer, width as integer, height as integer, uri as string)
    m.ring.uri = uri
    m.ring.width = width
    m.ring.height = height
    m.ring.translation = [x, y]
end sub

sub applyState()
    if m.kind = "" then return
    focused = m.top.focus
    lit = m.top.highlighted

    m.ring.visible = focused
    m.face.scale = focused ? [m.grow, m.grow] : [1.0, 1.0]
    m.title.color = m.ink
    m.glyph.color = m.glyphColor

    if m.kind = "row"
        applyRowState(focused, lit)
    else if m.kind = "quick"
        m.fill.visible = true
        m.fill.blendColor = "#FFFFFF"
        m.fill.opacity = 0.08
    else if m.kind = "genre"
        m.fill.visible = true
        m.fill.blendColor = m.color
        m.fill.opacity = 1.0
        m.title.color = "#FFFFFF"
    else if m.kind = "mix"
        m.fill.visible = true
        m.fill.blendColor = m.color
        m.fill.opacity = 1.0
        soft = themeChrome.WithAlpha(m.mixInk, "D9")
        m.title.color = m.mixInk
        m.leading.color = soft
        m.subtitle.color = soft
        m.trailing.color = m.mixInk
        ' A chip sits on a dark wash with the tile's ink on it, the play circle is the ink with
        ' the tile's color cut out of it
        chip = m.trailing.text <> ""
        m.glyph.color = chip ? m.mixInk : m.color
        m.artBg.blendColor = chip ? "#000000" : m.mixInk
        m.artBg.opacity = chip ? 0.3 : 1.0
    else if m.kind = "rail"
        tint = m.selected ? m.accent : themeChrome.WithAlpha(m.ink, "DB")
        m.title.color = tint
        m.glyph.color = tint
        m.fill.visible = m.selected
        m.fill.blendColor = m.accent
        m.fill.opacity = 0.16
    else if m.kind = "button"
        applyButtonState(focused)
    end if
end sub

' A focused song fills solid with dark words. The one the album was left on is tinted with its
' number picked out.
sub applyRowState(focused as boolean, lit as boolean)
    m.fill.visible = focused or lit
    if focused
        m.fill.blendColor = m.focusFill
        m.fill.opacity = 1.0
        m.title.color = themeChrome.WithAlpha(m.focusInk, "DE")
        soft = themeChrome.WithAlpha(m.focusInk, "99")
    else
        m.fill.blendColor = m.accent
        m.fill.opacity = 0.16
        soft = themeChrome.WithAlpha(m.ink, "A6")
    end if
    m.subtitle.color = soft
    m.trailing.color = soft
    m.leading.color = (lit or m.rank) and not focused ? m.accent : soft
    if m.leading.text <> "" then setFont(m.leading, m.leadingSize, lit or m.rank)
end sub

' Hero buttons fill on focus, the others get a ring
sub applyButtonState(focused as boolean)
    pressed = focused and m.pressFill
    m.ring.visible = focused and not m.pressFill
    m.fill.visible = pressed or m.restFillOpacity > 0
    m.fill.blendColor = pressed ? m.pressedFill : m.restFill
    m.fill.opacity = pressed ? 1.0 : m.restFillOpacity
    m.title.color = pressed ? m.pressedInk : m.restInk
    m.glyph.color = pressed ? m.pressedInk : m.iconInk
end sub

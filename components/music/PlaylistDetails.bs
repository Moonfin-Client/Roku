import "pkg:/components/itemMenu/itemMenuHost.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/ViewLoadStatus.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/detailButtons.bs"
import "pkg:/source/utils/detailSectionLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/playlistSortFilter.bs"

sub init()
    m.loadStatus = ViewLoadStatus.INIT
    m.top.optionsAvailable = false
    m.top.overhangVisible = false

    m.backdrop = m.top.findNode("backdrop")
    m.playlistCover = m.top.findNode("playlistCover")
    m.playedIndicator = m.top.findNode("playedIndicator")

    ' A hidden poster takes its badge with it, and the details move into its place
    if not detailSectionLayout.Shows("poster")
        m.playlistCover.visible = false
        m.playedIndicator.visible = false
        m.top.findNode("playlistInfo").translation = [0, 0]
    end if

    m.playlistLabel = m.top.findNode("playlistLabel")
    m.playlistTitle = m.top.findNode("playlistTitle")
    m.playlistMeta = m.top.findNode("playlistMeta")
    m.playlistOverview = m.top.findNode("playlistOverview")
    m.buttonRow = m.top.findNode("buttonRow")
    m.itemList = m.top.findNode("itemList")
    m.itemsLabel = m.top.findNode("itemsLabel")
    m.itemCount = m.top.findNode("itemCount")
    m.scrollableContent = m.top.findNode("scrollableContent")

    m.buttonGroups = []
    m.currentButtonIndex = 0

    m.itemList.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.favoriteTask = CreateObject("roSGNode", "FavoriteItemsTask")

    m.emptyState = m.top.findNode("emptyState")
    m.emptyText = m.top.findNode("emptyText")
    if isValid(m.emptyText) then m.emptyText.text = tr("This playlist is empty")

    m.sortBy = playlistSortFilter.SORT_ORDER
    m.sortDirection = playlistSortFilter.DIR_ASCENDING
    m.playedFilter = playlistSortFilter.PLAYED_ALL
    m.favoriteOnly = false
    m.mediaTypeFilter = ""
    m.allRows = invalid
    m.activeRows = invalid

    m.isFirstRun = true
end sub

' ============================================
' Screen lifecycle
' ============================================

sub OnScreenShown(_isReturning = false as boolean)
    m.top.shufflePlay = false

    hideContentNav(m.top.getScene())

    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group) then group.lastFocus = m.top.lastFocus
    else if m.buttonGroups.count() > 0
        m.buttonGroups[0].setFocus(true)
        m.top.lastFocus = m.buttonGroups[0]
        highlightButton(0)
    end if

    if m.isFirstRun
        m.isFirstRun = false
        return
    end if
end sub

sub OnScreenHidden()
end sub

' ============================================
' Data loading
' ============================================

sub onPageContentChanged()
    pageContent = m.top.pageContent
    if not isValid(pageContent) then return

    startLoadingSpinner()

    json = pageContent.json
    if not isValid(json) then return

    imgParams = { "maxHeight": 420, "maxWidth": 420 }
    m.playlistCover.uri = ImageURL(json.Id, "Primary", imgParams)

    m.playedIndicator.data = {
        favorite: chainLookupReturn(json, "UserData.IsFavorite", false)
    }

    m.backdrop.uri = ImageURL(json.Id, "Backdrop", { "maxWidth": 1920 })

    m.playlistTitle.text = isValid(json.name) ? json.name : ""

    overview = json.LookupCI("Overview")
    if isValidAndNotEmpty(overview)
        m.playlistOverview.text = overview
        m.playlistOverview.visible = true
    else
        m.playlistOverview.visible = false
    end if

    m.metaYear = invalid
    if isValid(json.ProductionYear) then m.metaYear = stri(json.ProductionYear).trim()
    setMeta(json.ChildCount, json.RunTimeTicks)

    buildButtons()
end sub

' The count and running time come from the server until the list arrives, then follow the list,
' so a row taken out shows straight away
sub setMeta(count as dynamic, ticks as dynamic)
    metaParts = []
    if isValid(count)
        metaParts.push(count = 1 ? "1 Item" : `${stri(count).trim()} Items`)
        m.itemCount.text = stri(count).trim()
    end if
    runtime = runtimeText(ticks)
    if runtime <> "" then metaParts.push(runtime)
    if isValid(m.metaYear) then metaParts.push(m.metaYear)
    m.playlistMeta.text = metaParts.join(" · ")
end sub

sub setMetaFromList()
    content = m.itemList.content
    ticks = 0
    for each row in content.getChildren(-1, 0)
        ticks += row.RunTimeTicks
    end for
    setMeta(content.getChildCount(), ticks)
end sub

function runtimeText(ticks as dynamic) as string
    if not isValid(ticks) or type(ticks) = "String" or type(ticks) = "roString" then return ""

    totalMins = int(ticks / 600000000.0)
    if totalMins >= 60
        hours = int(totalMins / 60)
        mins = totalMins mod 60
        if mins > 0 then return `${stri(hours).trim()} hr ${stri(mins).trim()} min`
        return `${stri(hours).trim()} hr`
    end if
    if totalMins > 0 then return `${stri(totalMins).trim()} min`
    return ""
end function

sub onListDataChanged()
    listData = m.top.listData
    if not isValid(listData) then return

    ' A row the menu moves or takes out notifies here too, and playlistRowsChanged redraws for that
    if listData.isSameNode(m.itemList.content) then return

    m.allRows = listData
    ' The list shows the rows playback reads, so a row moved or taken out plays from where it now sits
    m.itemList.content = listData
    requestPlaylistPermission(chainLookupReturn(m.top, "pageContent.id", ""))
    applySortAndFilter()

    stopLoadingSpinner()
    m.loadStatus = ViewLoadStatus.LOADED

    ' Set initial focus to first button
    if m.buttonGroups.count() > 0
        m.buttonGroups[0].setFocus(true)
        m.top.lastFocus = m.buttonGroups[0]
        highlightButton(0)
    end if
end sub

sub applySortAndFilter()
    if not isValid(m.allRows) then return

    rawItems = m.allRows.getChildren(-1, 0)
    options = {
        sortBy: m.sortBy,
        sortDirection: m.sortDirection,
        playedFilter: m.playedFilter,
        favoriteOnly: m.favoriteOnly,
        mediaTypeFilter: m.mediaTypeFilter
    }

    filtered = playlistSortFilter.SortAndFilter(rawItems, options)

    if playlistSortFilter.IsDefault(options)
        activeNode = m.allRows
    else
        activeNode = CreateObject("roSGNode", "ContentNode")
        for each row in filtered
            activeNode.appendChild(row.clone(false))
        end for
    end if
    m.activeRows = activeNode
    m.top.activeTracks = activeNode
    m.itemList.content = activeNode

    count = filtered.count()
    ticks = 0
    for each row in filtered
        if isValid(row.RunTimeTicks) and type(row.RunTimeTicks) <> "String" and type(row.RunTimeTicks) <> "roString"
            ticks += row.RunTimeTicks
        end if
    end for
    setMeta(count, ticks)

    if count = 0
        if isValid(m.emptyState) then m.emptyState.visible = true
        if isValid(m.emptyText)
            if rawItems.count() = 0
                m.emptyText.text = tr("This playlist is empty")
            else
                m.emptyText.text = tr("No tracks match the active filters")
            end if
        end if
        m.itemList.visible = false
    else
        if isValid(m.emptyState) then m.emptyState.visible = false
        m.itemList.visible = true
    end if

    buildButtons()
end sub

' ============================================
' Buttons
' ============================================

sub buildButtons()
    m.buttonRow.removeChildrenIndex(m.buttonRow.getChildCount(), 0)
    m.buttonGroups = []

    count = isValid(m.activeRows) ? m.activeRows.getChildCount() : (isValid(m.allRows) ? m.allRows.getChildCount() : 0)

    if count > 0
        addButton({
            icon: "pkg:/images/icons/detail_play.png",
            label: tr("Play All"),
            action: "playAll",
            id: "playAllButton"
        })
    end if

    if count > 1
        addButton({
            icon: "pkg:/images/icons/detail_shuffle.png",
            label: tr("Shuffle"),
            action: "shuffle",
            id: "shuffleButton"
        })
    end if

    m.isFavorite = chainLookupReturn(m.top.pageContent, "json.UserData.IsFavorite", false)
    addButton({
        icon: "pkg:/images/icons/detail_favorite.png",
        label: m.isFavorite ? tr("Favorited") : tr("Favorite"),
        action: "favorite",
        id: "favoriteButton"
    })

    sortLabel = tr("Sort")
    if m.sortBy <> playlistSortFilter.SORT_ORDER or m.sortDirection <> playlistSortFilter.DIR_ASCENDING
        sortLabel = tr("Sort") + ": " + playlistSortFilter.SortLabel(m.sortBy)
    end if
    addButton({
        icon: "pkg:/images/icons/library_sortaz.png",
        label: sortLabel,
        action: "sort",
        id: "sortButton"
    })

    filterCount = playlistSortFilter.ActiveFilterCount({
        playedFilter: m.playedFilter,
        favoriteOnly: m.favoriteOnly,
        mediaTypeFilter: m.mediaTypeFilter
    })
    filterLabel = tr("Filter")
    if filterCount > 0
        filterLabel = tr("Filter") + ` (${stri(filterCount).trim()})`
    end if
    addButton({
        icon: "pkg:/images/icons/filter_off.png",
        label: filterLabel,
        action: "filter",
        id: "filterButton"
    })

    if not playlistSortFilter.IsDefault({
        sortBy: m.sortBy,
        sortDirection: m.sortDirection,
        playedFilter: m.playedFilter,
        favoriteOnly: m.favoriteOnly,
        mediaTypeFilter: m.mediaTypeFilter
    })
        addButton({
            icon: "pkg:/images/icons/detail_restart.png",
            label: tr("Reset"),
            action: "reset",
            id: "resetButton"
        })
    end if

    if m.currentButtonIndex >= m.buttonGroups.count()
        m.currentButtonIndex = 0
    end if
end sub

sub addButton(config as object)
    buttonGroup = detailButtons.createButton(config, m.buttonGroups.count())
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    m.buttonRow.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

sub highlightButton(index as integer)
    detailButtons.highlight(index, m.buttonGroups)
end sub

sub unhighlightAllButtons()
    detailButtons.unhighlightAll(m.buttonGroups)
end sub

sub onButtonFocusChanged(event as object)
    button = event.getRoSGNode()
    if button <> invalid and button.buttonIndex <> invalid
        if button.hasFocus() or button.isInFocusChain()
            m.currentButtonIndex = button.buttonIndex
            highlightButton(m.currentButtonIndex)
        end if
    end if
end sub

' ============================================
' Button actions
' ============================================

sub handleButtonSelect()
    if m.currentButtonIndex < 0 or m.currentButtonIndex >= m.buttonGroups.count() then return

    button = m.buttonGroups[m.currentButtonIndex]
    if not isValid(button) then return

    action = button.buttonAction

    if action = "playAll"
        m.top.playAll = true
    else if action = "shuffle"
        m.top.shufflePlay = true
    else if action = "favorite"
        toggleFavorite()
    else if action = "sort"
        openSortDialog()
    else if action = "filter"
        openFilterDialog()
    else if action = "reset"
        resetSortAndFilter()
    end if
end sub

sub openSortDialog()
    sortData = { data: [] }
    for each opt in playlistSortFilter.SortOptions()
        item = {
            Title: opt.label,
            Name: opt.id,
            Track: { description: opt.label }
        }
        if opt.id = m.sortBy then item.selected = true
        sortData.data.push(item)
    end for

    m.global.sceneManager.callFunc("radioDialog", tr("Sort By"), sortData)
    m.global.sceneManager.observeFieldScoped("returnData", "onSortDialogResult")
end sub

sub onSortDialogResult()
    m.global.sceneManager.unobserveFieldScoped("returnData")
    returnData = m.global.sceneManager.returnData
    if returnData <> invalid and returnData.Name <> invalid
        newSort = returnData.Name
        if newSort <> m.sortBy
            m.sortBy = newSort
            if newSort = playlistSortFilter.SORT_RANDOM
                m.sortDirection = playlistSortFilter.DIR_ASCENDING
            end if
            applySortAndFilter()
            focusButtons()
            if newSort <> playlistSortFilter.SORT_RANDOM
                openSortOrderDialog()
            end if
            return
        else if newSort <> playlistSortFilter.SORT_RANDOM
            openSortOrderDialog()
            return
        end if
    end if
    focusButtons()
end sub

sub openSortOrderDialog()
    orderData = {
        data: [
            { Title: tr("Ascending"), Name: playlistSortFilter.DIR_ASCENDING, Track: { description: tr("Ascending") }, selected: m.sortDirection = playlistSortFilter.DIR_ASCENDING },
            { Title: tr("Descending"), Name: playlistSortFilter.DIR_DESCENDING, Track: { description: tr("Descending") }, selected: m.sortDirection = playlistSortFilter.DIR_DESCENDING }
        ]
    }
    m.global.sceneManager.callFunc("radioDialog", tr("Order"), orderData)
    m.global.sceneManager.observeFieldScoped("returnData", "onSortOrderDialogResult")
end sub

sub onSortOrderDialogResult()
    m.global.sceneManager.unobserveFieldScoped("returnData")
    returnData = m.global.sceneManager.returnData
    if returnData <> invalid and returnData.Name <> invalid
        m.sortDirection = returnData.Name
        applySortAndFilter()
    end if
    focusButtons()
end sub

sub openFilterDialog()
    filterData = {
        data: [
            { Title: tr("Status: All"), Name: "status_all", Track: { description: tr("All") }, selected: m.playedFilter = playlistSortFilter.PLAYED_ALL },
            { Title: tr("Status: Unplayed"), Name: "status_unplayed", Track: { description: tr("Unplayed") }, selected: m.playedFilter = playlistSortFilter.PLAYED_UNPLAYED },
            { Title: tr("Status: Played"), Name: "status_played", Track: { description: tr("Played") }, selected: m.playedFilter = playlistSortFilter.PLAYED_PLAYED },
            { Title: m.favoriteOnly ? tr("Favorites Only: Yes") : tr("Favorites Only: No"), Name: "favorite_toggle", Track: { description: tr("Favorites Only") }, selected: m.favoriteOnly }
        ]
    }
    if isValid(m.allRows)
        types = playlistSortFilter.AvailableMediaTypes(m.allRows.getChildren(-1, 0))
        if types.count() > 1
            filterData.data.push({ Title: tr("Media: All"), Name: "media_all", Track: { description: tr("All") }, selected: m.mediaTypeFilter = "" or m.mediaTypeFilter = "all" })
            for each t in types
                filterData.data.push({ Title: tr("Media: ") + t, Name: "media_" + t, Track: { description: t }, selected: m.mediaTypeFilter = t })
            end for
        end if
    end if

    m.global.sceneManager.callFunc("radioDialog", tr("Filter"), filterData)
    m.global.sceneManager.observeFieldScoped("returnData", "onFilterDialogResult")
end sub

sub onFilterDialogResult()
    m.global.sceneManager.unobserveFieldScoped("returnData")
    returnData = m.global.sceneManager.returnData
    if returnData <> invalid and returnData.Name <> invalid
        name = returnData.Name
        if name = "status_all"
            m.playedFilter = playlistSortFilter.PLAYED_ALL
        else if name = "status_unplayed"
            m.playedFilter = playlistSortFilter.PLAYED_UNPLAYED
        else if name = "status_played"
            m.playedFilter = playlistSortFilter.PLAYED_PLAYED
        else if name = "favorite_toggle"
            m.favoriteOnly = not m.favoriteOnly
        else if name = "media_all"
            m.mediaTypeFilter = "all"
        else if name.Left(6) = "media_"
            m.mediaTypeFilter = name.Mid(6)
        end if
        applySortAndFilter()
    end if
    focusButtons()
end sub

sub resetSortAndFilter()
    m.sortBy = playlistSortFilter.SORT_ORDER
    m.sortDirection = playlistSortFilter.DIR_ASCENDING
    m.playedFilter = playlistSortFilter.PLAYED_ALL
    m.favoriteOnly = false
    m.mediaTypeFilter = ""
    applySortAndFilter()
    focusButtons()
end sub

' The server is asked on a task and the page shows the new state straight away. The state is
' kept here rather than written back into pageContent, which would load the page again.
sub toggleFavorite()
    if not isChainValid(m.top.pageContent, "json") then return

    m.isFavorite = not m.isFavorite
    m.favoriteTask.itemId = m.top.pageContent.json.Id
    m.favoriteTask.favTask = m.isFavorite ? "favorite" : "unfavorite"
    m.favoriteTask.control = TaskControl.RUN

    m.playedIndicator.data = {
        favorite: m.isFavorite
    }

    favoriteLabel = m.top.findNode("favoriteButtonText")
    if isValid(favoriteLabel) then favoriteLabel.text = m.isFavorite ? tr("Favorited") : tr("Favorite")
end sub

' ============================================
' Item list helpers
' ============================================

function getFocusedItem() as dynamic
    if m.itemList.isInFocusChain()
        itemFocused = m.itemList.itemFocused
        if isValid(m.itemList.content)
            return m.itemList.content.getChild(itemFocused)
        end if
    end if
    return invalid
end function

' ============================================
' Scrolling
' ============================================

sub scrollContentTo(yOffset as integer)
    if isValid(m.scrollableContent)
        m.scrollableContent.translation = [0, yOffset]
    end if
end sub

' ============================================
' Key handling
' ============================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Determine what's focused
    ' Determine what's focused
    isButtonFocused = false
    if m.buttonGroups.count() > 0
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                isButtonFocused = true
                exit for
            end if
        end for
    end if

    isItemListFocused = m.itemList.isInFocusChain()

    if isButtonFocused
        if key = KeyCode.LEFT
            if m.currentButtonIndex > 0
                newIndex = m.currentButtonIndex - 1
                m.buttonGroups[newIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[newIndex]
                m.currentButtonIndex = newIndex
                highlightButton(newIndex)
                setLastFocus(m.buttonGroups[newIndex])
            else
                return FocusSidebar(m.top)
            end if
            return true

        else if key = KeyCode.RIGHT
            if m.currentButtonIndex < m.buttonGroups.count() - 1
                newIndex = m.currentButtonIndex + 1
                m.buttonGroups[newIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[newIndex]
                m.currentButtonIndex = newIndex
                highlightButton(newIndex)
                setLastFocus(m.buttonGroups[newIndex])
            end if
            return true

        else if key = KeyCode.OK
            handleButtonSelect()
            return true

        else if key = KeyCode.DOWN
            if m.itemList.visible and isValid(m.activeRows) and m.activeRows.getChildCount() > 0
                m.itemList.setFocus(true)
                m.top.lastFocus = m.itemList
                setLastFocus(m.itemList)
                unhighlightAllButtons()
                scrollContentTo(-420)
            end if
            return true

        else if key = KeyCode.UP
            ' Nothing sits above this screen, so the key is consumed
            return true
        end if
    end if

    if isItemListFocused
        if key = KeyCode.UP
            if m.itemList.itemFocused = 0 and m.buttonGroups.count() > 0
                focusButtons()
                return true
            end if
            return false

        else if key = KeyCode.OK
            m.top.playlistItemSelected = m.itemList.itemFocused
            return true

        else if key = KeyCode.PLAY
            m.top.playlistItemSelected = m.itemList.itemFocused
            return true

        else if key = KeyCode.OPTIONS
            row = getFocusedItem()
            if isValid(row)
                opts = playlistRowOptions(row, chainLookupReturn(m.top, "pageContent.id", ""))
                if not playlistSortFilter.IsDefault({
                    sortBy: m.sortBy,
                    sortDirection: m.sortDirection,
                    playedFilter: m.playedFilter,
                    favoriteOnly: m.favoriteOnly,
                    mediaTypeFilter: m.mediaTypeFilter
                })
                    if isValid(opts.playlist) then opts.playlist.canManage = false
                end if
                showItemMenu(row, opts)
            end if
            return true
        end if
    end if

    if key = KeyCode.BACK
        if isItemListFocused
            focusButtons()
            return true
        end if

        return false
    end if

    return false
end function

' ============================================
' Row menu
' ============================================

' A row moved or taken out by the menu, with the cursor going to the row now at index
sub playlistRowsChanged(index as integer)
    applySortAndFilter()

    count = m.itemList.content.getChildCount()
    if count = 0
        focusButtons()
        return
    end if
    m.itemList.jumpToItem = index < count ? index : count - 1
end sub

' The rows show their watched mark, which the menu keeps up to date itself
sub itemMenuChanged(_action as string, _card as dynamic, _menuJson as object)
end sub

sub focusButtons()
    scrollContentTo(0)
    if m.buttonGroups.count() = 0 then return
    m.buttonGroups[m.currentButtonIndex].setFocus(true)
    m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
    highlightButton(m.currentButtonIndex)
    setLastFocus(m.buttonGroups[m.currentButtonIndex])
end sub

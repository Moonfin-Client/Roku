import "pkg:/components/anime/animeMarkerWatch.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/episodeLabels.bs"
import "pkg:/source/utils/libraryCard.bs"
import "pkg:/source/utils/misc.bs"

' The modern details screen folds the number into the title as E1 with the runtime under it.
' The classic season screen keeps its own layout.
const MODERN_TITLE_SIZE = 24
const MODERN_META_SIZE = 20
const MODERN_META_TOP = 34
const MODERN_OVERVIEW_TOP = 66
const MODERN_PILLS_GAP = 8
const CLASSIC_PILLS_GAP = 10

sub init()
    m.episodeThumbnail = m.top.findNode("episodeThumbnail")
    m.episodeNumber = m.top.findNode("episodeNumber")
    m.episodeRuntime = m.top.findNode("episodeRuntime")
    m.episodeTitle = m.top.findNode("episodeTitle")
    m.episodeOverview = m.top.findNode("episodeOverview")
    m.progressBackground = m.top.findNode("progressBackground")
    m.progressBar = m.top.findNode("progressBar")
    m.playedIndicator = m.top.findNode("playedIndicator")
    m.rowBackground = m.top.findNode("rowBackground")
    m.focusInAnimation = m.top.findNode("focusInAnimation")
    m.focusOutAnimation = m.top.findNode("focusOutAnimation")
end sub

sub itemContentChanged()
    itemData = m.top.itemContent
    if not isValid(itemData) then return

    m.playedIndicator.data = {
        played: chainLookupReturn(itemData, "watched", false),
        unplayedCount: chainLookupReturn(itemData, "json.UserData.UnplayedItemCount", 0)
    }

    hideMediaDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.hideMediaDescription`", false), false)
    m.episodeOverview.text = (not hideMediaDesc and isValid(itemData.overview)) ? itemData.overview : ""

    if not isChainValid(itemData, "json")
        watchAnimeMarker(invalid, invalid)
        return
    end if

    indexNumber = ""
    if isValid(itemData.json.indexNumber)
        indexNumber = `Episode ${itemData.json.indexNumber}`
        if isValid(itemData.json.indexNumberEnd)
            indexNumber = `Episode ${itemData.json.indexNumber}-${itemData.json.indexNumberEnd}`
        end if
    end if
    m.episodeNumber.text = indexNumber

    m.episodeTitle.text = isValid(itemData.title) ? itemData.title : ""

    thumbUri = itemData.posterURL
    if isValidAndNotEmpty(thumbUri)
        ' Blur unwatched if setting is enabled
        if m.global.session.user.settings["ui.tvshows.blurunwatched"] = true
            if not chainLookupReturn(itemData, "json.UserData.Played", false)
                thumbUri += "&blur=15"
            end if
        end if
        m.episodeThumbnail.uri = thumbUri
    end if

    if isValid(itemData.json.LookupCI("RunTimeTicks"))
        ticks = itemData.json.RunTimeTicks
        if type(ticks) = "roInt" or type(ticks) = "LongInteger"
            runMins = int(ticks / 600000000.0)
            if runMins < 2
                m.episodeRuntime.text = "1 min"
            else
                m.episodeRuntime.text = `${stri(runMins).trim()} min`
            end if
        end if
    end if

    playedPct = chainLookupReturn(itemData, "json.UserData.PlayedPercentage", 0)
    if playedPct > 0
        m.progressBackground.visible = true
        m.progressBar.visible = true
        m.progressBar.width = int(m.episodeThumbnail.width * playedPct / 100)
    else
        m.progressBackground.visible = false
        m.progressBar.visible = false
    end if

    parent = itemData.getParent()
    m.modernRow = isValid(parent) and parent.hasField("modernRows") and parent.modernRows
    if m.modernRow then showModernText(itemData.json, hideMediaDesc)

    watchAnimeMarker(itemData, itemData.json)
end sub

sub showModernText(json as object, hideMediaDesc as boolean)
    m.episodeNumber.text = ""

    m.episodeTitle.translation = [0, 0]
    m.episodeTitle.font.size = MODERN_TITLE_SIZE
    m.episodeTitle.text = episodeLabels.CardTitle(json.Name, json.IndexNumber)

    m.episodeRuntime.translation = [0, MODERN_META_TOP]
    m.episodeRuntime.horizAlign = "left"
    m.episodeRuntime.width = 400
    m.episodeRuntime.font.size = MODERN_META_SIZE
    m.episodeRuntime.color = "#FFFFFF99"
    m.episodeRuntime.text = libraryCard.FormatDuration(json.RunTimeTicks)

    m.episodeOverview.text = hideMediaDesc ? "" : chainLookupReturn(json, "Overview", "")
    m.episodeOverview.translation = [0, modernOverviewTop()]
    m.episodeOverview.maxLines = 2
    m.episodeOverview.font.size = MODERN_META_SIZE
    m.episodeOverview.color = "#FFFFFFCC"
end sub

function modernOverviewTop() as float
    if m.episodeRuntime.text <> "" then return MODERN_OVERVIEW_TOP
    return MODERN_META_TOP
end function

' The classic list ends the top line with the pills after the runtime, so the runtime steps left
' to make room. The modern one gives them a line of their own under the runtime, and the
' overview moves down under them.
sub showAnimeMarker(marker as dynamic)
    if not isValid(m.animePills)
        if not animeMarkers.HasPills(marker) then return

        m.animePills = m.top.findNode("textContent").createChild("AnimeMarkerPills")
        m.animePills.pillSize = m.modernRow ? "large" : "compact"
        m.runtimeLeft = m.episodeRuntime.translation[0]
    end if

    m.animePills.marker = marker ?? {}

    if m.modernRow
        overviewTop = modernOverviewTop()
        if m.animePills.visible
            m.animePills.translation = [0, overviewTop]
            overviewTop += m.animePills.rowHeight + MODERN_PILLS_GAP
        end if
        m.episodeOverview.translation = [0, overviewTop]
        return
    end if

    runtimeLeft = m.runtimeLeft
    if m.animePills.visible
        lineRight = m.runtimeLeft + m.episodeRuntime.width
        lineHeight = m.episodeNumber.boundingRect().height
        runtimeHeight = m.episodeRuntime.boundingRect().height
        if runtimeHeight > lineHeight then lineHeight = runtimeHeight

        pillsTop = (lineHeight - m.animePills.rowHeight) / 2
        if pillsTop < 0 then pillsTop = 0

        m.animePills.translation = [lineRight - m.animePills.rowWidth, pillsTop]
        runtimeLeft -= m.animePills.rowWidth + CLASSIC_PILLS_GAP
    end if

    m.episodeRuntime.translation = [runtimeLeft, 0]
end sub

sub focusChanged()
    if m.top.itemHasFocus
        m.focusOutAnimation.control = "stop"
        m.focusInAnimation.control = "start"

        if m.global.device.isAudioGuideEnabled = true
            txt2Speech = CreateObject("roTextToSpeech")
            txt2Speech.Flush()
            txt2Speech.Say(m.episodeTitle.text)
            txt2Speech.Say(m.episodeOverview.text)
        end if
    else
        m.focusInAnimation.control = "stop"
        m.focusOutAnimation.control = "start"
    end if
end sub

import "pkg:/components/itemMenu/itemMenuHost.bs"
import "pkg:/components/userDataHost.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/ViewLoadStatus.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/detailActions.bs"
import "pkg:/source/utils/detailButtons.bs"
import "pkg:/source/utils/detailSectionLayout.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrButtons.bs"
import "pkg:/source/utils/seerrDetailHost.bs"

' The movie page's row metrics, so the two rows read the same
const SEASON_ROW_WIDTH = 1728
const SEASON_BUTTON_WIDTH = 157
const SEASON_BUTTON_GAP = 12
const SEASON_SCROLL_PAD = 40
' Where the episodes sit and how far Down scrolls with one row of buttons
const SEASON_EPISODES_HEADER_Y = 650
const SEASON_EPISODES_Y = 690
const SEASON_EPISODES_SCROLL = 460

sub init()
    observeUserData()
    m.loadStatus = ViewLoadStatus.INIT
    m.top.optionsAvailable = false

    m.backdrop = m.top.findNode("backdrop")
    m.seasonPoster = m.top.findNode("seasonPoster")
    m.playedIndicator = m.top.findNode("playedIndicator")

    ' A hidden poster takes its badge with it, and the details move into its place
    if not detailSectionLayout.Shows("poster")
        m.seasonPoster.visible = false
        m.playedIndicator.visible = false
        m.top.findNode("seasonInfo").translation = [0, 0]
    end if

    m.seriesName = m.top.findNode("seriesName")
    m.seasonTitle = m.top.findNode("seasonTitle")
    m.seasonMeta = m.top.findNode("seasonMeta")
    m.buttonRow = m.top.findNode("buttonRow")
    m.buttonRowExtra = m.top.findNode("buttonRowExtra")
    m.buttonRowContainer = m.top.findNode("buttonRowContainer")
    m.episodeListHeader = m.top.findNode("episodeListHeader")
    m.overflowMenu = m.top.findNode("overflowMenu")
    m.overflowMenu.observeField("chosenAction", "onOverflowAction")
    m.overflowMenu.observeField("closed", "closeOverflowMenu")
    m.episodeList = m.top.findNode("episodeList")
    m.episodesLabel = m.top.findNode("episodesLabel")
    m.episodeCount = m.top.findNode("episodeCount")
    m.scrollableContent = m.top.findNode("scrollableContent")

    m.buttonGroups = []
    m.currentButtonIndex = 0
    m.primaryCount = 0
    m.overflowActions = []
    m.rowScrolls = false
    m.rowOffset = 0
    m.episodesScroll = SEASON_EPISODES_SCROLL

    m.episodeList.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.tvExtrasTask = createObject("roSGNode", "TVExtrasTask")
    m.tvExtrasTask.observeField("results", "onExtrasDataLoaded")

    m.playstateTask = createObject("roSGNode", "PlaystateTask")
    m.playstateTask.observeField("state", "onPlaystateTaskStateChange")
    m.favoriteTask = createObject("roSGNode", "FavoriteItemsTask")
    m.favoriteTask.observeField("state", "onFavoriteTaskStateChange")

    m.top.observeField("seerrButtonsStale", "onSeerrButtonsStale")

    m.isFirstRun = true
end sub

' ============================================
' Screen lifecycle
' ============================================

sub OnScreenShown(_isReturning = false as boolean)
    m.top.shufflePlay = false

    hideContentNav(m.top.getScene())

    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group) then group.lastFocus = m.top.lastFocus
    else if m.buttonGroups.count() > 0
        focusButton(0)
    end if

    if m.isFirstRun
        m.isFirstRun = false
        return
    end if

    m.top.refreshSeasonDetailsData = not m.top.refreshSeasonDetailsData
end sub

sub OnScreenHidden()
end sub

' ============================================
' Data loading
' ============================================

sub onSeasonDataChanged()
    startLoadingSpinner()
end sub

sub onEpisodeObjectsChanged()
    objects = m.top.objects
    if not isValid(objects) or not isValid(objects.Items) then return

    content = CreateObject("roSGNode", "ContentNode")
    for each item in objects.Items
        content.appendChild(item)
    end for
    m.episodeList.content = content

    totalCount = objects.Items.count()
    m.episodeCount.text = stri(totalCount).trim()

    updateSeason()
end sub

sub updateSeason()
    seasonData = m.top.seasonData
    if not isValid(seasonData) or not isChainValid(seasonData, "json") then return

    json = seasonData.json

    m.playedIndicator.data = {
        played: chainLookupReturn(json, "UserData.Played", false),
        favorite: chainLookupReturn(json, "UserData.IsFavorite", false),
        unplayedCount: chainLookupReturn(json, "UserData.UnplayedItemCount", 0)
    }

    imgParams = { "maxHeight": 495, "maxWidth": 330 }
    m.seasonPoster.uri = ImageURL(json.Id, "Primary", imgParams)

    backdropId = isValidAndNotEmpty(json.SeriesId) ? json.SeriesId : json.Id
    m.backdrop.uri = ImageURL(backdropId, "Backdrop", { "maxWidth": 1920 })

    seriesNameText = json.LookupCI("SeriesName")
    if isValidAndNotEmpty(seriesNameText)
        m.seriesName.text = seriesNameText
    end if

    m.seasonTitle.text = isValid(json.name) ? json.name : ""

    metaParts = []
    if isChainValid(json, "RecursiveItemCount")
        count = json.RecursiveItemCount
        metaParts.push(count = 1 ? "1 Episode" : `${stri(count).trim()} Episodes`)
    end if
    if isValid(json.productionYear)
        metaParts.push(stri(json.productionYear).trim())
    end if
    officialRating = json.LookupCI("OfficialRating")
    if isValidAndNotEmpty(officialRating)
        metaParts.push(officialRating)
    end if
    m.seasonMeta.text = metaParts.join(" · ")

    ' A refresh after a toggle or a play keeps focus where it was
    firstLoad = m.loadStatus <> ViewLoadStatus.LOADED
    if firstLoad then buildButtons() else rebuildButtonsKeepingFocus()
    loadSeerrBlock(json)

    m.tvExtrasTask.seasonID = json.Id
    m.tvExtrasTask.control = TaskControl.RUN

    stopLoadingSpinner()
    m.loadStatus = ViewLoadStatus.LOADED

    if firstLoad then focusButton(0)
end sub

sub onExtrasDataLoaded()
    m.top.extrasObjects = m.tvExtrasTask.results
end sub

' ============================================
' Buttons
' ============================================

' Resume and Play lead, then the arranged buttons the other detail pages offer, wrapping onto a
' second line, scrolling sideways on All or folding behind More past the viewer's count
sub buildButtons()
    m.buttonRow.removeChildrenIndex(m.buttonRow.getChildCount(), 0)
    m.buttonRowExtra.removeChildrenIndex(m.buttonRowExtra.getChildCount(), 0)
    m.buttonGroups = []
    m.overflowActions = []
    m.currentButtonIndex = 0

    configs = []
    if m.top.displayResumeButton
        configs.push({ icon: "pkg:/images/icons/detail_play.webp", label: tr("Resume"), action: "resume", id: "resumeButton" })
    end if
    configs.push({ icon: "pkg:/images/icons/detail_play.webp", label: tr("Play"), action: "play", id: "playButton" })
    leading = configs.count()

    json = chainLookup(m.top, "itemContent.json")
    isWatched = chainLookupReturn(json, "UserData.Played", false)
    isFavorited = chainLookupReturn(json, "UserData.IsFavorite", false)
    candidates = [
        { id: "shuffle", config: { icon: "pkg:/images/icons/detail_shuffle.webp", label: tr("Shuffle"), action: "shuffle", id: "shuffleButton" } },
        { id: "watched", config: { icon: "pkg:/images/icons/detail_watched.webp", label: isWatched ? tr("Watched") : tr("Unwatched"), action: "watched", id: "watchedButton" } },
        { id: "favorite", config: { icon: "pkg:/images/icons/detail_favorite.webp", label: isFavorited ? tr("Favorited") : tr("Favorite"), action: "favorite", id: "favoriteButton" } }
    ]
    if isValidAndNotEmpty(chainLookupReturn(json, "SeriesId", ""))
        candidates.push({ id: "goToSeries", config: { icon: "pkg:/images/icons/detail_series.webp", label: tr("Go to Series"), action: "goToSeries", id: "goToSeriesButton" } })
    end if
    ' The series' Seerr actions, once Seerr has answered about it
    for each candidate in seerrButtons.Candidates(m.seerrDetails, "tv")
        candidates.push(candidate)
    end for
    for each candidate in detailActionCandidates(json)
        candidates.push(candidate)
    end for

    offered = buttonLayout.InCatalogueOrder(candidates)
    arranged = kidsMode.Enabled() ? kidsMode.KeepButtons(offered) : buttonLayout.Arrange(offered, m.global.session.user.settings[DETAIL_ORDER_SETTING], m.global.session.user.settings[DETAIL_HIDDEN_SETTING])
    for each candidate in arranged
        configs.push(candidate.config)
    end for

    limit = 0
    if not kidsMode.Enabled() then limit = buttonLayout.MaxVisibleSetting()
    m.rowScrolls = limit = -1
    split = buttonLayout.CountSplit(configs.count(), buttonLayout.ApplyButtonLimit(limit, { maxVisible: 0, overflowAsMenu: false, countCapped: false }))
    if split.needsOverflow
        keep = split.visibleCount
        if keep < leading then keep = leading
        shown = []
        for i = 0 to configs.count() - 1
            if i < keep
                shown.push(configs[i])
            else
                m.overflowActions.push(configs[i])
            end if
        end for
        shown.push({ icon: "pkg:/images/icons/admin_controls.webp", label: tr("More"), action: "toggleMoreActions", id: "moreActionsButton" })
        configs = shown
    end if

    capacity = Int((SEASON_ROW_WIDTH + SEASON_BUTTON_GAP) / (SEASON_BUTTON_WIDTH + SEASON_BUTTON_GAP))
    m.primaryCount = 0
    for each config in configs
        row = m.buttonRow
        if not m.rowScrolls and m.buttonGroups.count() >= capacity then row = m.buttonRowExtra
        addButton(config, row)
        if row.isSameNode(m.buttonRow) then m.primaryCount = m.buttonGroups.count()
    end for
    if m.overflowMenu.visible then m.overflowMenu.actions = m.overflowActions

    m.buttonRowExtra.visible = m.buttonGroups.count() > m.primaryCount
    shift = 0
    if m.buttonRowExtra.visible
        m.buttonRowExtra.translation = [0, 27 + m.buttonRow.boundingRect().height]
        shift = m.buttonRowExtra.translation[1] - 9
    end if
    m.episodeListHeader.translation = [96, SEASON_EPISODES_HEADER_Y + shift]
    m.episodeList.translation = [96, SEASON_EPISODES_Y + shift]
    m.episodesScroll = SEASON_EPISODES_SCROLL + shift
    m.rowOffset = 0
    placeButtonRows()
end sub

' Seerr answers after the row is drawn, so it's drawn again with focus kept where it was
sub onSeerrButtonsStale()
    rebuildButtonsKeepingFocus()
end sub

sub rebuildButtonsKeepingFocus()
    hadFocus = false
    for each button in m.buttonGroups
        if button.isInFocusChain() then hadFocus = true
    end for
    index = m.currentButtonIndex
    buildButtons()
    if index > m.buttonGroups.count() - 1 then index = m.buttonGroups.count() - 1
    if hadFocus and index >= 0 then focusButton(index)
end sub

sub addButton(config as object, row as object)
    buttonGroup = detailButtons.createButton(config, m.buttonGroups.count())
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    row.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

' A row that scrolls is clipped to its room and moved along to keep the focused button in view.
' Any other row sits centered.
sub placeButtonRows()
    stride = SEASON_BUTTON_WIDTH + SEASON_BUTTON_GAP
    if not m.rowScrolls
        m.buttonRowContainer.clippingRect = BUTTON_NO_CLIP
        centerButtonRowInContainer(m.buttonRow, m.primaryCount, SEASON_BUTTON_WIDTH, SEASON_BUTTON_GAP, 96)
        centerButtonRowInContainer(m.buttonRowExtra, m.buttonGroups.count() - m.primaryCount, SEASON_BUTTON_WIDTH, SEASON_BUTTON_GAP, 96)
        return
    end if

    focusLeft = SEASON_SCROLL_PAD + m.currentButtonIndex * stride
    rowWidth = SEASON_SCROLL_PAD * 2 + m.buttonGroups.count() * stride - SEASON_BUTTON_GAP
    if focusLeft < m.rowOffset then m.rowOffset = focusLeft - SEASON_SCROLL_PAD
    if focusLeft + SEASON_BUTTON_WIDTH > m.rowOffset + SEASON_ROW_WIDTH then m.rowOffset = focusLeft + SEASON_BUTTON_WIDTH - SEASON_ROW_WIDTH + SEASON_SCROLL_PAD
    if m.rowOffset > rowWidth - SEASON_ROW_WIDTH then m.rowOffset = rowWidth - SEASON_ROW_WIDTH
    if m.rowOffset < 0 then m.rowOffset = 0
    m.buttonRowContainer.clippingRect = [0, -100, SEASON_ROW_WIDTH, 400]
    m.buttonRow.translation = [SEASON_SCROLL_PAD - m.rowOffset, m.buttonRow.translation[1]]
end sub

sub focusButton(index as integer)
    if index < 0 or index >= m.buttonGroups.count() then return
    m.buttonGroups[index].setFocus(true)
    m.top.lastFocus = m.buttonGroups[index]
    m.currentButtonIndex = index
    highlightButton(index)
    setLastFocus(m.buttonGroups[index])
    if m.rowScrolls then placeButtonRows()
end sub

function isExtraRowIndex(index as integer) as boolean
    return index >= m.primaryCount
end function

' ===== More =====

sub openOverflowMenu()
    if m.overflowActions.count() = 0 then return
    m.overflowMenu.actions = m.overflowActions
    m.overflowMenu.visible = true
    m.overflowMenu.setFocus(true)
end sub

' A toggle changes in place, so the menu stays open on it. Anything else opens something of its own.
sub onOverflowAction(event as object)
    action = event.getData()
    if not isValidAndNotEmpty(action) then return
    if action <> "watched" and action <> "favorite" then closeOverflowMenu()
    runAction(action)
end sub

sub closeOverflowMenu()
    if not m.overflowMenu.visible then return
    m.overflowMenu.visible = false
    focusButton(m.currentButtonIndex)
end sub

sub highlightButton(index as integer)
    detailButtons.highlight(index, m.buttonGroups)
end sub

sub unhighlightAllButtons()
    detailButtons.unhighlightAll(m.buttonGroups)
end sub

sub onButtonFocusChanged(event as object)
    button = event.getRoSGNode()
    if button <> invalid and button.buttonIndex <> invalid
        if button.hasFocus() or button.isInFocusChain()
            m.currentButtonIndex = button.buttonIndex
            highlightButton(m.currentButtonIndex)
        end if
    end if
end sub

' ============================================
' Button actions
' ============================================

sub handleButtonSelect()
    if m.currentButtonIndex < 0 or m.currentButtonIndex >= m.buttonGroups.count() then return

    button = m.buttonGroups[m.currentButtonIndex]
    if not isValid(button) or not isValid(button.buttonAction) then return
    runAction(button.buttonAction)
end sub

sub runAction(action as string)
    if action = "resume"
        if isValid(m.top.seasonData)
            itemToPlay = m.top.seasonData.clone(false)
            itemToPlay.quickplayFromResume = true
            m.top.quickPlayNode = itemToPlay
        end if
    else if action = "play"
        m.top.playSeasonFromStart = true
    else if action = "shuffle"
        m.top.shufflePlay = true
        m.top.playSeasonFromStart = true
    else if action = "watched"
        toggleWatched()
    else if action = "favorite"
        toggleFavorite()
    else if action = "toggleMoreActions"
        openOverflowMenu()
    else if action = "goToSeries"
        m.top.buttonSelected = "goToSeries-button"
    else if action = "personalRating"
        showRatingPrompt()
    else if action = "addToPlaylist"
        itemMenuLoadPicker(seasonMenuSubject(), "playlists")
    else if action = "addToCollection"
        itemMenuLoadPicker(seasonMenuSubject(), "collections")
    else if action = "deleteItem"
        confirmDelete()
    else if action = "changeArtwork"
        itemMenuShowArtwork(seasonMenuSubject())
    else if action = "adminControls"
        itemMenuShowIdentify(seasonMenuSubject(), false)
    else if Left(action, 5) = "seerr"
        startSeerrRequest(action)
    end if
end sub

function seasonMenuSubject() as object
    return { card: invalid, json: chainLookupReturn(m.top, "itemContent.json", {}), options: {}, entries: [], returnFocus: seerrFocusTarget() }
end function

sub toggleWatched()
    seasonData = m.top.seasonData
    if not isChainValid(seasonData, "json") then return

    isPlayed = chainLookupReturn(seasonData, "json.UserData.Played", false)

    m.playstateTask.itemId = seasonData.json.Id
    if isPlayed
        m.playstateTask.status = "unmarkPlayed"
    else
        m.playstateTask.status = "markPlayed"
    end if
    m.playstateTask.control = TaskControl.RUN
end sub

sub onPlaystateTaskStateChange()
    if m.playstateTask.state = "stop"
        flipUserData("Played")
        m.top.refreshSeasonDetailsData = not m.top.refreshSeasonDetailsData
    end if
end sub

sub toggleFavorite()
    seasonData = m.top.seasonData
    if not isChainValid(seasonData, "json") then return

    isFavorite = chainLookupReturn(seasonData, "json.UserData.IsFavorite", false)

    m.favoriteTask.itemId = seasonData.json.Id
    m.favoriteTask.favTask = isFavorite ? "unfavorite" : "favorite"
    m.favoriteTask.control = TaskControl.RUN
end sub

sub onFavoriteTaskStateChange()
    if m.favoriteTask.state = "stop"
        flipUserData("IsFavorite")
        m.top.refreshSeasonDetailsData = not m.top.refreshSeasonDetailsData
    end if
end sub

' The refresh reads the episodes again but not the season, so its own mark is turned here
sub flipUserData(key as string)
    seasonData = m.top.seasonData
    if not isChainValid(seasonData, "json.UserData") then return
    json = seasonData.json
    json.UserData[key] = not (json.UserData[key] = true)
    seasonData.json = json
    rebuildButtonsKeepingFocus()
end sub

' ============================================
' Episode list helpers
' ============================================

function getFocusedItem() as dynamic
    if m.episodeList.isInFocusChain()
        itemFocused = m.episodeList.itemFocused
        if isValid(m.episodeList.content)
            return m.episodeList.content.getChild(itemFocused)
        end if
    end if
    return invalid
end function

sub updateObjects()
    if isValid(m.top.episodeObjects)
        onEpisodeObjectsChanged()
    end if
end sub

' ============================================
' Scrolling
' ============================================

sub scrollContentTo(yOffset as integer)
    if isValid(m.scrollableContent)
        m.scrollableContent.translation = [0, yOffset]
    end if
end sub

' ============================================
' Key handling
' ============================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.overflowMenu.visible then return false

    ' Determine what's focused
    isButtonFocused = false
    if m.buttonGroups.count() > 0
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                isButtonFocused = true
                exit for
            end if
        end for
    end if

    isEpisodeListFocused = m.episodeList.isInFocusChain()

    if isButtonFocused
        index = m.currentButtonIndex
        rowFirst = 0
        rowLast = m.primaryCount - 1
        if isExtraRowIndex(index)
            rowFirst = m.primaryCount
            rowLast = m.buttonGroups.count() - 1
        end if

        if key = KeyCode.LEFT
            if index > rowFirst
                focusButton(index - 1)
            else if index = 0
                return FocusSidebar(m.top)
            end if
            return true

        else if key = KeyCode.RIGHT
            if index < rowLast then focusButton(index + 1)
            return true

        else if key = KeyCode.OK
            handleButtonSelect()
            return true

        else if key = KeyCode.DOWN
            if not isExtraRowIndex(index) and m.buttonRowExtra.visible
                column = index
                if m.primaryCount + column > m.buttonGroups.count() - 1 then column = m.buttonGroups.count() - 1 - m.primaryCount
                focusButton(m.primaryCount + column)
                return true
            end if
            m.episodeList.setFocus(true)
            m.top.lastFocus = m.episodeList
            setLastFocus(m.episodeList)
            unhighlightAllButtons()
            scrollContentTo(-m.episodesScroll)
            return true

        else if key = KeyCode.UP
            if isExtraRowIndex(index)
                column = index - m.primaryCount
                if column >= m.primaryCount then column = m.primaryCount - 1
                focusButton(column)
                return true
            end if
            m.top.lastFocus = m.buttonGroups[index]
            return FocusOverhang(m.top)
        end if
    end if

    if isEpisodeListFocused
        if key = KeyCode.UP
            if m.episodeList.itemFocused = 0
                if m.buttonGroups.count() > 0
                    focusButton(m.currentButtonIndex)
                    scrollContentTo(0)
                    return true
                end if
            end if
            return false

        else if key = KeyCode.OK
            focusedItem = getFocusedItem()
            if isValid(focusedItem)
                m.top.selectedItem = focusedItem
            end if
            return true

        else if key = KeyCode.PLAY
            focusedItem = getFocusedItem()
            if isValid(focusedItem)
                m.top.quickPlayNode = focusedItem
            end if
            return true

        else if key = KeyCode.OPTIONS
            return showItemMenu(getFocusedItem())
        end if
    end if

    if key = KeyCode.BACK
        if isEpisodeListFocused
            if m.buttonGroups.count() > 0 then focusButton(m.currentButtonIndex)
            scrollContentTo(0)
            return true
        end if

        return false
    end if

    return false
end function

' The rows here are read again when the page is next opened, so nothing is redrawn here
sub itemMenuChanged(_action as string, _card as dynamic, _menuJson as object)
end sub

sub userDataApplied(_changes as object)
end sub

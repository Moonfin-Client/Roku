<?xml version="1.0" encoding="utf-8"?>
<component name="RemoteSubtitleTask" extends="Task">
    <interface>
        <field id="itemId" type="string" />
        <!-- Set to search for a language, or to download one result by its id -->
        <field id="language" type="string" />
        <field id="subtitleId" type="string" />
        <!-- With findNewTrack on, a download waits for the server to list a subtitle whose index
             isnt one of these, and answers with it -->
        <field id="findNewTrack" type="boolean" value="false" />
        <field id="existingIndexes" type="array" />
        <field id="mediaSourceId" type="string" />
        <field id="result" type="assocarray" />
    </interface>
</component>

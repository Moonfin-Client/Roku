import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "runTask"
end sub

' One task for both halves of the job, since a download is only ever asked for
' from the list a search just produced
sub runTask()
    if isValidAndNotEmpty(m.top.subtitleId)
        download()
        return
    end if

    search()
end sub

sub search()
    results = api.items.SearchRemoteSubtitles(m.top.itemId, m.top.language)
    if not isValid(results)
        m.top.result = { kind: "search", failed: true }
        return
    end if

    ' The server answers with a bare array on some versions and a wrapper on
    ' others, so both shapes are unpacked here
    list = results
    if type(results) = "roAssociativeArray" then list = results.LookupCI("SearchResults") ?? []

    m.top.result = { kind: "search", failed: false, results: list }
end sub

sub download()
    api.items.DownloadRemoteSubtitles(m.top.itemId, m.top.subtitleId)
    m.top.result = { kind: "download" }
end sub

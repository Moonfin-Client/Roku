import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/remoteSubtitles.bs"
import "pkg:/source/utils/trackDialog.bs"

sub init()
    m.resultsMenu = m.top.findNode("resultsMenu")
    m.resultsMenu.observeField("itemSelected", "onResultSelected")

    m.top.findNode("title").text = tr("Download Subtitles")

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.top.findNode("title"),
        titleRule: m.top.findNode("titleRule"),
        list: m.resultsMenu
    }

    m.results = []
    m.top.observeField("visible", "onVisibleChanged")
end sub

sub onVisibleChanged()
    if m.top.visible then m.resultsMenu.setFocus(true)
end sub

sub startSearch()
    m.results = []
    render(tr("Searching..."))

    m.task = startTask({ language: m.top.language })
end sub

sub onTaskResult(event as object)
    result = event.getData()
    if not isValid(result) then return

    if result.kind = "download"
        m.top.visible = false
        return
    end if

    if result.failed
        render(tr("Subtitle search failed"))
        return
    end if

    m.results = result.results
    if m.results.count() = 0
        render(tr("No remote subtitles found"))
        return
    end if

    render("")
end sub

' One row per result, or a single row saying what is going on instead
sub render(status as string)
    content = CreateObject("roSGNode", "ContentNode")
    rowHeight = trackDialog.FlaggedRowHeight()

    if status <> ""
        row = content.CreateChild("SubtitleTrackListData")
        row.title = status
        row.action = "status"
        row.rowHeight = rowHeight
    else
        for each result in m.results
            row = content.CreateChild("SubtitleTrackListData")
            row.title = remoteSubtitles.Text(result, "Name")
            if row.title = "" then row.title = remoteSubtitles.Text(result, "Author")
            if row.title = "" then row.title = tr("Subtitle")
            row.description = remoteSubtitles.Details(result)
            row.flags = remoteSubtitles.Flags(result)
            row.index = remoteSubtitles.Text(result, "Id")
            row.rowHeight = rowHeight
        end for
    end if

    cancel = content.CreateChild("SubtitleTrackListData")
    cancel.title = tr("Cancel")
    cancel.action = "cancel"
    cancel.dimmed = true
    cancel.dividerAbove = true
    cancel.rowHeight = rowHeight

    trackDialog.Layout(m.parts, content.getChildCount(), rowHeight)
    m.resultsMenu.content = content
    m.resultsMenu.jumpToItem = 0
end sub

function startTask(fields as object) as object
    if isValid(m.task) then m.task.unobserveFieldScoped("result")

    task = createObject("roSGNode", "RemoteSubtitleTask")
    task.itemId = m.top.itemId
    task.setFields(fields)
    task.observeFieldScoped("result", "onTaskResult")
    task.control = TaskControl.RUN

    return task
end function

sub onResultSelected()
    row = m.resultsMenu.content.getChild(m.resultsMenu.itemSelected)
    if not isValid(row) then return

    if row.action = "cancel"
        m.top.visible = false
        return
    end if

    if row.action = "status" then return

    render(tr("Downloading subtitle..."))

    m.task = startTask({ subtitleId: row.index })
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A dialog that has been dismissed can still be holding focus, and swallowing
    ' keys there would leave the screen behind it unable to move
    if not m.top.visible then return false

    if key = KeyCode.BACK
        m.top.visible = false
        return true
    end if

    if key = KeyCode.LEFT or key = KeyCode.RIGHT or key = KeyCode.PLAY or key = KeyCode.FASTFORWRD or key = KeyCode.REWIND or key = KeyCode.REPLAY
        return true
    end if

    if key = KeyCode.UP or key = KeyCode.DOWN or key = KeyCode.OK
        if not m.resultsMenu.isInFocusChain()
            m.resultsMenu.setFocus(true)
        end if
        return true
    end if

    return false
end function

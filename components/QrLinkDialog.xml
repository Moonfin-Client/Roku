<?xml version="1.0" encoding="utf-8"?>
<component name="QrLinkDialog" extends="JFGroup">
    <children>
        <!-- Centered on the 1920 by 1080 screen -->
        <Rectangle
            id="contentContainer"
            color="0x00000000"
            width="900"
            height="850"
            translation="[510, 115]"
        >
            <Poster
                id="dialogBackground"
                uri="pkg:/images/dialog.9.png"
                width="900"
                height="850"
            />

            <Rectangle id="textContainer" color="0x00000000" width="900" height="850" clippingRect="[0, 0, 900, 850]">
                <Label
                    id="titleLabel"
                    color="0xFFFFFFFF"
                    horizAlign="center"
                    width="820"
                    height="50"
                    translation="[40, 40]"
                >
                    <Font role="font" uri="font:BoldSystemFontFile" size="40" />
                </Label>

                <Label
                    id="messageLabel"
                    color="0xEFEFEFFF"
                    horizAlign="center"
                    wrap="true"
                    width="780"
                    height="130"
                    translation="[60, 100]"
                >
                    <Font role="font" uri="font:SystemFontFile" size="26" />
                </Label>

                <Label
                    id="footerLabel"
                    color="0xEFEFEFFF"
                    horizAlign="center"
                    wrap="true"
                    width="780"
                    translation="[60, 570]"
                >
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
            </Rectangle>

            <QRCode
                id="qrCode"
                width="300"
                height="300"
                pixel="7"
                translation="[300, 250]"
            />

            <LabelList
                id="buttonList"
                vertFocusAnimationStyle="floatingFocus"
                textHorizAlign="center"
                color="0xFFFFFFFF"
                focusedColor="0xFFFFFFFF"
                itemSize="[740, 60]"
                numRows="1"
                translation="[80, 740]"
            >
                <ContentNode id="buttonContent" role="content"></ContentNode>
            </LabelList>
        </Rectangle>
    </children>

    <interface>
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="message" type="string" alias="messageLabel.text" />
        <field id="footer" type="string" alias="footerLabel.text" />
        <field id="url" type="string" alias="qrCode.text" />
        <field id="wasClosed" type="boolean" alwaysNotify="true" />
    </interface>
</component>

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"

' The search field the other clients show, a rounded pill carrying whatever has
' been typed so far. Typing happens on the keyboard that opens under it.
const SEARCH_PILL_WIDTH = 1728
const SEARCH_PILL_HEIGHT = 76
const SEARCH_ICON_SIZE = 36
const SEARCH_ICON_INSET = 28
const SEARCH_TEXT_SIZE = 30

sub init()
    m.pill = m.top.findNode("pill")
    m.searchIcon = m.top.findNode("searchIcon")
    m.ring = m.top.findNode("ring")
    m.queryText = m.top.findNode("queryText")

    m.pill.width = SEARCH_PILL_WIDTH
    m.pill.height = SEARCH_PILL_HEIGHT
    if themeChrome.IsActive() then m.pill.blendColor = themeChrome.SurfaceVariant()

    m.ring.width = SEARCH_PILL_WIDTH
    m.ring.height = SEARCH_PILL_HEIGHT
    m.ring.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")

    m.searchIcon.width = SEARCH_ICON_SIZE
    m.searchIcon.height = SEARCH_ICON_SIZE
    m.searchIcon.translation = [SEARCH_ICON_INSET, (SEARCH_PILL_HEIGHT - SEARCH_ICON_SIZE) / 2]

    textLeft = SEARCH_ICON_INSET + SEARCH_ICON_SIZE + 20
    m.queryText.font.size = SEARCH_TEXT_SIZE
    m.queryText.height = SEARCH_PILL_HEIGHT
    m.queryText.width = SEARCH_PILL_WIDTH - textLeft - SEARCH_ICON_INSET
    m.queryText.vertAlign = "center"
    m.queryText.translation = [textLeft, 0]

    onQueryChanged()
end sub

' Nothing typed yet leaves the prompt standing in its place, drawn back so it
' reads as a placeholder rather than a search anyone made
sub onQueryChanged()
    if isValidAndNotEmpty(m.top.query)
        m.queryText.text = m.top.query
        m.queryText.color = "#FFFFFF"
        return
    end if

    m.queryText.text = tr("Search")
    m.queryText.color = "#FFFFFF80"
end sub

' Ringed while the keyboard is filling it, so it is clear which field the keys
' are going into
sub onFocusedChanged()
    m.ring.visible = m.top.focused
end sub

import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/api/Items.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/SeerrUtils.bs"

' How long the rest of the results wait for people before showing without them, and how long
' people get in all before they are given up on
const PEOPLE_GRACE_MS = 1000
const PEOPLE_TIMEOUT_MS = 10000

sub init()
    m.top.functionName = "search"
end sub

sub search()
    query = m.top.query
    requestToken = m.top.requestToken

    if query = invalid or query = ""
        publishSearchResults({ Items: [], TotalRecordCount: 0 }, "", requestToken, true)
        return
    end if

    allSessions = []

    if m.top.enableMultiServer and isMultiServerEnabled()
        allSessions = getAllServerSessions()
    end if

    if allSessions.Count() = 0
        ' A server with hints answers people along with everything else
        people = invalid
        if not serverSupportsSearchHints() then people = startPeopleSearch(query)
        clock = CreateObject("roTimespan")
        results = normalizeSearchResults(searchMedia(query, m.top.liveTv))

        if isValid(people)
            ' With nothing else to show, the results wait for people instead of coming up empty
            allowance = PEOPLE_TIMEOUT_MS - clock.TotalMilliseconds()
            if results.Items.Count() > 0 and allowance > PEOPLE_GRACE_MS then allowance = PEOPLE_GRACE_MS
            found = peopleSearchResults(people, allowance)
            if isValid(found)
                appendSearchResults(results, found)
                people = invalid
            end if
        end if

        publishSearchResults(results, query, requestToken, false)
        if isSearchRequestStale(requestToken) then return
        shown = results.Items.Count()
        appendSeerrResults(results, query)
        if isSearchRequestStale(requestToken) then return

        if isValid(people)
            ' Seerr results dont wait on people either
            if results.Items.Count() > shown then publishSearchResults(results, query, requestToken, false)
            found = peopleSearchResults(people, PEOPLE_TIMEOUT_MS - clock.TotalMilliseconds())
            if not isValid(found) then people.AsyncCancel()
            if isSearchRequestStale(requestToken) then return
            if isValidAndNotEmpty(found) then appendSearchResults(results, found)
        end if

        publishSearchResults(results, query, requestToken, true)
        return
    end if

    port = CreateObject("roMessagePort")
    activeRequests = {}
    allItems = []
    hintItems = []

    for each userSession in allSessions
        for each kind in ["items", "persons", "hints"]
            started = startSearchRequest(userSession, port, kind, query)
            if not isValid(started) then continue for
            if started.DoesExist("answered")
                takeSearchAnswer(kind, started.answered, userSession, allItems, hintItems)
            else
                activeRequests[started.id] = { session: userSession, type: kind, request: started.request }
            end if
        end for
    end for

    startTime = CreateObject("roDateTime").AsSeconds()

    while activeRequests.Count() > 0
        msg = wait(500, port)

        currentTime = CreateObject("roDateTime").AsSeconds()
        if currentTime - startTime > 10
            for each requestId in activeRequests
                requestInfo = activeRequests[requestId]
                if isValid(requestInfo) and isValid(requestInfo.request)
                    requestInfo.request.AsyncCancel()
                end if
            end for
            exit while
        end if

        if msg = invalid then continue while

        if type(msg) = "roUrlEvent"
            requestId = msg.GetSourceIdentity().ToStr()
            requestInfo = activeRequests[requestId]

            if isValid(requestInfo)
                activeRequests.Delete(requestId)
                if msg.GetResponseCode() = 200 then takeSearchAnswer(requestInfo.type, ParseJson(msg.GetString()), requestInfo.session, allItems, hintItems)
            end if
        end if
    end while

    ' Hints are the only route a plugin has, and they are merged once every server
    ' has answered so the fuller item record wins where both found the same thing
    seenIds = {}
    for each node in allItems
        if isValidAndNotEmpty(node.id) then seenIds[node.id] = true
    end for

    for each node in hintItems
        if isValidAndNotEmpty(node.id)
            if seenIds.DoesExist(node.id) then continue for
            seenIds[node.id] = true
        end if
        allItems.push(node)
    end for

    results = normalizeSearchResults({
        Items: allItems,
        TotalRecordCount: allItems.Count()
    })

    publishSearchResults(results, query, requestToken, false)
    if isSearchRequestStale(requestToken) then return

    appendSeerrResults(results, query)
    if isSearchRequestStale(requestToken) then return

    publishSearchResults(results, query, requestToken, true)
end sub

sub takeSearchAnswer(kind as string, data as dynamic, userSession as object, allItems as object, hintItems as object)
    if kind = "hints"
        if not isChainValid(data, "SearchHints") then return
        for each hint in data.SearchHints
            hintItem = itemFromSearchHint(hint)
            if isValid(hintItem)
                searchNode = transformToSearchData(hintItem, userSession)
                if isValid(searchNode) then hintItems.push(searchNode)
            end if
        end for
    else if isChainValid(data, "Items")
        for each item in data.Items
            searchNode = transformToSearchData(item, userSession)
            if isValid(searchNode) then allItems.push(searchNode)
        end for
    end if
end sub

sub appendSearchResults(results as object, items as object)
    results.Items.Append(items)
    results.TotalRecordCount = results.Items.Count()
end sub

sub appendSeerrResults(results as object, query as string)
    if kidsMode.Enabled() then return

    config = GetSeerrConfig()
    if config = invalid or not SeerrParseBool(config.enabled, false) then return

    seerrResults = SearchSeerr(query, 1500)
    if not isValidAndNotEmpty(seerrResults) then return

    if not isValid(results.Items) or type(results.Items) <> "roArray"
        results.Items = []
    end if

    for each seerrItem in seerrResults
        results.Items.push(seerrItem)
    end for

    results.TotalRecordCount = results.Items.Count()
end sub

function startSearchRequest(userSession as object, port as object, searchType as string, query as string) as object
    url = ""

    if searchType = "items"
        url = buildURLForSession(userSession, "/Items", {
            searchTerm: query,
            fields: "ChildCount,ItemCounts,Genres,RecursiveItemCount,ImageTags,BackdropImageTags",
            IncludeItemTypes: "LiveTvChannel,Movie,BoxSet,Series,Episode,Video,Audio,MusicAlbum,MusicArtist,Playlist",
            EnableTotalRecordCount: false,
            ImageTypeLimit: 1,
            Recursive: true,
            limit: 100
        })
    else if searchType = "persons"
        url = buildURLForSession(userSession, "/Persons", {
            userId: userSession.userId,
            searchTerm: query,
            EnableTotalRecordCount: false,
            ImageTypeLimit: 1,
            limit: 100
        })
    else if searchType = "hints"
        url = buildURLForSession(userSession, "/Search/Hints", {
            userId: userSession.userId,
            searchTerm: query,
            limit: 100,
            includePeople: true,
            includeMedia: true,
            includeArtists: true,
            includeGenres: false,
            includeStudios: false
        })
    end if

    if url = "" then return invalid

    authHeader = buildAuthHeaderForSession(userSession)

    request = CreateObject("roUrlTransfer")
    request.SetUrl(url)
    addServerAuthorization(request, authHeader, userSession.serverUrl)
    request.AddHeader("Content-Type", "application/json")
    request.SetCertificatesFile("common:/certs/ca-bundle.crt")
    request.InitClientCertificates()
    request.SetMessagePort(port)
    request.EnableEncodings(true)

    ' A Plex server only answers through its bridge, which answers right away
    if plexUrls.Owns(url) then return { answered: getJson(request) }

    if request.AsyncGetToString()
        return {
            id: request.GetIdentity().ToStr(),
            request: request
        }
    end if

    return invalid
end function

function transformToSearchData(item as object, userSession as object) as object
    if not isValid(item) then return invalid

    tmp = CreateObject("roSGNode", "SearchData")

    item._serverUrl = userSession.serverUrl
    item._userId = userSession.userId
    item._authToken = userSession.authToken
    item._serverName = userSession.serverName

    if isValidAndNotEmpty(item.Id) and isValidAndNotEmpty(userSession.serverUrl)
        imgParams = { maxWidth: 300, quality: 90 }
        if isValid(item.ImageTags) and isValidAndNotEmpty(item.ImageTags.Primary)
            imgParams.tag = item.ImageTags.Primary
        end if
        tmp.image = PosterImageForServer(userSession.serverUrl, item.Id, imgParams)
    end if
    tmp.id = item.LookupCI("Id")
    tmp.title = item.LookupCI("Name")
    tmp.AlbumArtist = item.LookupCI("AlbumArtist")
    tmp.album = item.LookupCI("Album")
    tmp.type = item.LookupCI("Type")
    tmp.RunTimeTicks = item.LookupCI("RunTimeTicks")
    tmp.ProductionYear = item.LookupCI("ProductionYear")
    tmp.EndDate = item.LookupCI("EndDate")
    tmp.OfficialRating = item.LookupCI("OfficialRating")
    tmp.IndexNumber = item.LookupCI("IndexNumber")
    tmp.seriesname = item.LookupCI("SeriesName")
    tmp.SeasonName = item.LookupCI("SeasonName")
    tmp.IndexNumberEnd = item.LookupCI("IndexNumberEnd")
    tmp.ParentIndexNumber = item.LookupCI("ParentIndexNumber")
    tmp.json = item

    return tmp
end function

function normalizeSearchResults(results as dynamic) as object
    if not isValid(results) or type(results) = "roArray"
        return { Items: [], TotalRecordCount: 0 }
    end if

    items = results.Items
    if not isValid(items) or type(items) <> "roArray"
        items = []
    end if

    totalRecordCount = results.TotalRecordCount
    if not isValid(totalRecordCount)
        totalRecordCount = items.Count()
    end if

    return {
        Items: items,
        TotalRecordCount: totalRecordCount
    }
end function

sub publishSearchResults(results as object, query as string, requestToken as string, isComplete as boolean)
    payload = normalizeSearchResults(results)
    payload.Items = parentalControls.WithoutBlockedItems(payload.Items)
    payload.query = query
    payload.requestToken = requestToken
    payload.isComplete = isComplete
    m.top.results = payload
end sub

function isSearchRequestStale(requestToken as string) as boolean
    currentToken = m.top.requestToken
    if not isValid(currentToken) or not isValid(requestToken)
        return false
    end if
    return currentToken <> requestToken
end function

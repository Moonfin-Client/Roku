<?xml version="1.0" encoding="utf-8"?>
<component name="SearchRow" extends="RowList">
  <interface>
    <field id="itemData" type="assocarray" onChange="getData" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="showItemTitles" type="string" value="showalways" />
    <!-- Which group is on show, empty meaning every group as its own row -->
    <field id="activeGroup" type="string" />
    <!-- What was found per group, for the tabs above to label themselves -->
    <field id="groupSummary" type="array" />
  </interface>
</component>
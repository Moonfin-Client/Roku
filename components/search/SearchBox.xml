<?xml version="1.0" encoding="utf-8"?>
<component name="SearchBox" extends="Group">
    <children>
        <Poster id="pill" uri="pkg:/images/details/btnfill.9.png" blendColor="0x2a2e40FF" />
        <Poster id="searchIcon" uri="pkg:/images/icons/search-light.png" />
        <Poster id="ring" uri="pkg:/images/details/btnborderfocus.9.png" visible="false" />
        <Label id="queryText" />
    </children>

    <interface>
        <field id="search_values" type="string" alwaysNotify="true" />
        <!-- A library header gives the pill far less room than the search screen does -->
        <field id="boxWidth" type="float" value="1728" onChange="layoutBox" />
        <field id="boxHeight" type="float" value="76" onChange="layoutBox" />
        <field id="placeholder" type="string" onChange="onQueryChanged" />
        <field id="query" type="string" onChange="onQueryChanged" />
        <field id="focused" type="boolean" onChange="onFocusedChanged" />
    </interface>
</component>

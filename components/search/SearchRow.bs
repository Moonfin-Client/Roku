import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/api/Items.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/searchGroups.bs"

' The room a card leaves under its artwork, and the air around a row
const CARD_TEXT_HEIGHT = 56
const ROW_PADDING = 60
const GRID_ROW_PADDING = 20
const CARD_GAP = 20
const CONTENT_WIDTH = 1728

sub init()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "OK"
        focusedArray = m.top.rowItemFocused

        if isValidAndNotEmpty(focusedArray) and focusedArray.count() = 2
            rowContent = m.top.content.getChild(focusedArray[0])

            if isValid(rowContent)
                selectedItem = rowContent.getChild(focusedArray[1])

                if isValid(selectedItem)
                    m.top.selectedItem = selectedItem
                    return true
                end if
            end if
        end if
    end if

    return false
end function

function getData()
    data = CreateObject("roSGNode", "ContentNode")
    m.rowItemSizes = []
    m.rowHeights = []

    itemData = m.top.itemData
    if not isValid(itemData) then return data

    items = chainLookup(itemData, "items")
    if not isValid(items) then return data

    buckets = {}
    seerrItems = []
    for each item in items
        if item.isSeerrResult <> invalid and item.isSeerrResult = true
            seerrItems.push(item)
        else if isValid(item.type)
            key = groupKeyFor(item.type)
            if key <> ""
                if not isValid(buckets[key]) then buckets[key] = []
                buckets[key].push(item)
            end if
        end if
    end for

    summary = []
    if seerrItems.count() > 0
        summary.push({ key: "seerr", title: "Seerr", count: seerrItems.count() })
    end if

    for each entry in searchGroups.Catalogue()
        bucket = buckets[entry.key]
        if not isValidAndNotEmpty(bucket) then continue for

        buckets[entry.key] = dedupeByName(bucket)
        summary.push({ key: entry.key, title: entry.title, count: buckets[entry.key].count() })
    end for
    m.top.groupSummary = summary

    ' One group on its own fills the screen as a grid, while every group shares
    ' the screen as a row apiece
    if m.top.activeGroup = "seerr"
        appendGrid(data, seerrItems, searchGroups.ASPECT_POSTER)
    else if m.top.activeGroup <> ""
        for each entry in searchGroups.Catalogue()
            if entry.key <> m.top.activeGroup then continue for
            if isValidAndNotEmpty(buckets[entry.key])
                appendGrid(data, buckets[entry.key], searchGroups.AspectFor(entry.types[0]))
            end if
        end for
    else
        for each entry in searchGroups.Catalogue()
            if not isValidAndNotEmpty(buckets[entry.key]) then continue for

            appendRow(data, entry.title, buckets[entry.key], searchGroups.AspectFor(entry.types[0]))
        end for

        if seerrItems.count() > 0
            appendRow(data, "Seerr", seerrItems, searchGroups.ASPECT_POSTER)
        end if
    end if

    m.top.rowHeights = m.rowHeights
    m.top.rowItemSize = m.rowItemSizes
    m.top.content = data
    return data
end function

function groupKeyFor(itemType as string) as string
    lowered = LCase(itemType)
    for each entry in searchGroups.Catalogue()
        for each candidate in entry.types
            if lowered = candidate then return entry.key
        end for
    end for

    return ""
end function

' The same title can come back more than once across libraries, so only the
' first copy of each is kept
function dedupeByName(bucket as object) as object
    seen = {}
    unique = []
    for each item in bucket
        if unique.count() >= searchGroups.RESULT_CAP then exit for

        name = LCase(chainLookupReturn(item, "json.Name", ""))
        if name <> "" and isValid(seen[name]) then continue for

        seen[name] = true
        unique.push(item)
    end for

    return unique
end function

' A grid is the same cards broken into as many rows as the width takes, with
' no headings since the tab above already names them
sub appendGrid(data as object, bucket as object, aspect as string)
    card = searchGroups.CardSize(aspect)
    perRow = Int(CONTENT_WIDTH / (card.width + CARD_GAP))
    if perRow < 1 then perRow = 1

    index = 0
    while index < bucket.count()
        row = data.CreateChild("ContentNode")
        for offset = 0 to perRow - 1
            if index + offset >= bucket.count() then exit for

            item = bucket[index + offset]
            item.imageDimensions = [card.width, card.image]
            row.appendChild(item)
        end for

        m.rowItemSizes.push([card.width, card.image + CARD_TEXT_HEIGHT])
        m.rowHeights.push(card.image + CARD_TEXT_HEIGHT + GRID_ROW_PADDING)
        index += perRow
    end while
end sub

sub appendRow(data as object, title as string, bucket as object, aspect as string)
    card = searchGroups.CardSize(aspect)
    row = data.CreateChild("ContentNode")
    row.title = title + " (" + Str(bucket.count()).trim() + ")"

    for each item in bucket
        item.imageDimensions = [card.width, card.image]
        row.appendChild(item)
    end for

    m.rowItemSizes.push([card.width, card.image + CARD_TEXT_HEIGHT])
    m.rowHeights.push(card.image + CARD_TEXT_HEIGHT + ROW_PADDING)
end sub

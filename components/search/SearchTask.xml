<?xml version="1.0" encoding="utf-8"?>

<component name="SearchTask" extends="Task">
  <interface>
    <field id="query" type="string" />
    <field id="results" type="assocarray" />
    <field id="requestToken" type="string" value="" />
    <field id="enableMultiServer" type="boolean" value="true" />
    <!-- Set once the server turns out to have Live TV, so its programs join the results -->
    <field id="liveTv" type="boolean" value="false" />
  </interface>
</component>
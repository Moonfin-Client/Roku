<?xml version="1.0" encoding="utf-8"?>
<component name="Sidebar" extends="Group">
    <children>
        <!-- Floating nav panel (expanded state) -->
        <Group id="navPanel" translation="[30, 30]" visible="false">
            <Poster id="panelBg" uri="pkg:/images/nav-panel-bg.9.png" width="300" height="400" opacity="0" />

            <!-- Avatar + username on left side of header -->
            <Group id="headerGroup" translation="[14, 14]">
                <MaskGroup id="avatarMask" maskUri="pkg:/images/icons/circle64.png" maskSize="[38, 38]" translation="[0, 0]">
                    <Poster id="userAvatar" uri="pkg:/images/baseline_person_white_48dp.png" width="38" height="38" loadDisplayMode="scaleToZoom" />
                </MaskGroup>
                <Poster id="userHighlight" uri="pkg:/images/icons/openCircle.png" width="38" height="38" translation="[0, 0]" loadDisplayMode="scaleToZoom" visible="false" />
                <Label id="userName" text="" font="font:SmallSystemFont" color="#FFFFFF" width="90" height="38" vertAlign="center" translation="[52, 0]" />
            </Group>

            <!-- Clock positioned right side of header, outside headerGroup to avoid overlap -->
            <Clock id="sidebarClock" translation="[90, 14]" />

            <!-- Nav items (scrollable) -->
            <Group id="navScrollClip" translation="[0, 72]" clippingRect="[0, -4, 300, 700]">
                <Poster id="focusPill" uri="pkg:/images/icons/pill-focus.9.png" width="276" height="44" visible="false" blendColor="0xFFFFFF" opacity="0.18" />
                <Group id="navItemsGroup" />
            </Group>
        </Group>

        <!-- Collapsed bubble -->
        <Group id="navBubble" translation="[30, 30]">
            <Poster id="bubbleBg" uri="pkg:/images/nav-bubble-bg.9.png" width="160" height="46" opacity="1.0" />
            <Poster id="bubbleChevron" uri="pkg:/images/icons/chevron-left.png" width="12" height="12" translation="[12, 17]" loadDisplayMode="scaleToFit" opacity="0.6" />
            <Poster id="bubbleIcon" uri="pkg:/images/icons/home.png" width="22" height="22" translation="[30, 12]" loadDisplayMode="scaleToFit" />
            <Label id="bubbleLabel" text="Home" font="font:SmallSystemFont" color="#FFFFFF" height="46" vertAlign="center" translation="[60, 0]" />
        </Group>

        <Animation id="expandAnim" duration="0.2" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="panelOpacityExpand" key="[0.0, 1.0]" fieldToInterp="panelBg.opacity" />
        </Animation>

        <Animation id="collapseAnim" duration="0.2" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="panelOpacityCollapse" key="[0.0, 1.0]" fieldToInterp="panelBg.opacity" />
        </Animation>

        <Animation id="focusPillAnim" duration="0.12" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="focusPillPosInterp" key="[0.0, 1.0]" fieldToInterp="focusPill.translation" />
        </Animation>

        <Animation id="scrollAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="scrollPosInterp" key="[0.0, 1.0]" fieldToInterp="navItemsGroup.translation" />
        </Animation>
    </children>

    <interface>
        <function name="highlightUser" />
        <function name="dehighlightUser" />
        <function name="updateShuffleButtonVisibility" />
        <function name="loadLibraries" />
        <field id="currentUserProfileImage" type="string" onChange="updateUserProfileImage" />
        <field id="currentUser" type="string" onChange="updateUser" />
        <field id="currentPage" type="string" value="home" onChange="onCurrentPageChanged" />
        <field id="showOptions" value="true" type="boolean" />
        <field id="itemSelected" type="string" alwaysNotify="true" />
        <field id="librarySelected" type="node" alwaysNotify="true" />
        <field id="isVisible" value="true" type="boolean" onChange="onVisibleChange" />
        <field id="disableMoveAnimation" value="false" type="boolean" />
        <field id="shufflePressed" type="boolean" alwaysNotify="true" />
        <field id="favoritesPressed" type="boolean" alwaysNotify="true" />
        <field id="genresPressed" type="boolean" alwaysNotify="true" />
        <field id="moviesPressed" type="boolean" alwaysNotify="true" />
        <field id="showsPressed" type="boolean" alwaysNotify="true" />
    </interface>
</component>

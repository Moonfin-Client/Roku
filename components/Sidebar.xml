<?xml version="1.0" encoding="utf-8"?>
<component name="Sidebar" extends="Group">
    <children>
        <Group id="sidebarContent">
            <Rectangle id="sidebarBgSolid" translation="[0, 0]" width="264" height="1080" color="0x000000FF" opacity="0" />
            <Poster id="sidebarBgEdge" translation="[264, 0]" width="16" height="1080" uri="pkg:/images/sidebar-edge-gradient.png" blendColor="0x000000" opacity="0" loadDisplayMode="scaleToFill" />

            <Group id="userSection" translation="[0, 34]">
                <MaskGroup id="avatarMask" maskUri="pkg:/images/icons/circle.png" maskSize="[50, 50]" translation="[24, 0]">
                    <Poster id="userAvatar" uri="pkg:/images/baseline_person_white_48dp.png" width="50" height="50" loadDisplayMode="scaleToZoom" />
                </MaskGroup>
                <Poster id="userHighlight" uri="pkg:/images/icons/openCircle.png" width="50" height="50" translation="[24, 0]" loadDisplayMode="scaleToZoom" visible="false" />
                <Label id="userName" text="" font="font:SmallSystemFont" color="#FFFFFF" height="50" vertAlign="center" translation="[76, 0]" visible="false" />
            </Group>

            <Group id="navScrollClip">
                <Poster id="focusPill" uri="pkg:/images/icons/pill-focus.9.png" visible="false" blendColor="0xFFFFFF" opacity="0.15" />
                <Group id="navItemsGroup" />
            </Group>

            <!-- The music card sits under the items, and its buttons are built in init -->
            <Group id="musicCard" visible="false" translation="[10, 872]">
                <Poster id="musicCardFill" uri="pkg:/images/playback/surface17.9.png" width="260" height="132" blendColor="#FFFFFF" opacity=".08" />
                <Poster id="musicCardBorder" uri="pkg:/images/playback/outline17.9.png" width="260" height="132" blendColor="#FFFFFF" opacity=".15" />
                <Poster id="musicCardRowFocus" uri="pkg:/images/playback/surface17.9.png" translation="[4, 4]" width="252" height="68" blendColor="#FFFFFF" opacity=".15" visible="false" />
                <Poster id="musicCardNote" uri="pkg:/images/icons/musicNote.png" width="26" height="26" opacity=".6" />
                <MaskGroup id="musicCardArtMask" maskSize="[52, 52]">
                    <Poster id="musicCardArt" width="52" height="52" loadDisplayMode="scaleToFill" />
                </MaskGroup>
                <Label id="musicCardTitle" translation="[76, 14]" width="172" height="26" color="#FFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="20" />
                </Label>
                <Label id="musicCardArtist" translation="[76, 42]" width="172" height="22" color="#FFFFFF" opacity=".6">
                    <Font role="font" uri="font:SystemFontFile" size="16" />
                </Label>
                <Group id="musicCardButtons" translation="[0, 76]" />
            </Group>

            <Group id="footerSection" translation="[0, 1022]">
                <Clock id="sidebarClock" translation="[0, 16]" />
            </Group>
        </Group>

        <!-- Never shown, it just lends its size to the rows built at runtime -->
        <Label id="navLabelFont" font="font:SmallSystemFont" visible="false" />

        <Animation id="expandAnim" duration="0.2" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="bgSolidOpacityExpand" key="[0.0, 1.0]" fieldToInterp="sidebarBgSolid.opacity" />
            <FloatFieldInterpolator id="bgEdgeOpacityExpand" key="[0.0, 1.0]" fieldToInterp="sidebarBgEdge.opacity" />
        </Animation>

        <Animation id="collapseAnim" duration="0.2" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="bgSolidOpacityCollapse" key="[0.0, 1.0]" fieldToInterp="sidebarBgSolid.opacity" />
            <FloatFieldInterpolator id="bgEdgeOpacityCollapse" key="[0.0, 1.0]" fieldToInterp="sidebarBgEdge.opacity" />
        </Animation>

        <Animation id="focusPillAnim" duration="0.12" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="focusPillPosInterp" key="[0.0, 1.0]" fieldToInterp="focusPill.translation" />
            <FloatFieldInterpolator id="focusPillWidthInterp" key="[0.0, 1.0]" fieldToInterp="focusPill.width" />
        </Animation>

        <Animation id="scrollAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="scrollPosInterp" key="[0.0, 1.0]" fieldToInterp="navItemsGroup.translation" />
        </Animation>

        <Animation id="slideUp" duration=".5" repeat="false">
            <Vector2DFieldInterpolator key="[0.0, .5]" keyValue="[[0, 0], [-400, 0]]" fieldToInterp="sidebarContent.translation" />
        </Animation>
        <Animation id="slideDown" delay=".2" duration=".5" repeat="false">
            <Vector2DFieldInterpolator key="[0.0, .5]" keyValue="[[-400, 0], [0, 0]]" fieldToInterp="sidebarContent.translation" />
        </Animation>
    </children>

    <interface>
        <function name="highlightUser" />
        <function name="dehighlightUser" />
        <function name="updateShuffleButtonVisibility" />
        <function name="loadLibraries" />
        <function name="focusMusicPlayer" />
        <field id="currentUserProfileImage" type="string" onChange="updateUserProfileImage" />
        <field id="currentUser" type="string" onChange="updateUser" />
        <field id="showOptions" value="true" type="boolean" />
        <field id="itemSelected" type="string" alwaysNotify="true" />
        <field id="librarySelected" type="node" alwaysNotify="true" />
        <field id="isVisible" value="true" type="boolean" onChange="onVisibleChange" />
        <field id="disableMoveAnimation" value="false" type="boolean" />
        <field id="showShuffleDialog" type="boolean" alwaysNotify="true" />
        <field id="favoritesPressed" type="boolean" alwaysNotify="true" />
        <field id="genresPressed" type="boolean" alwaysNotify="true" />
        <field id="musicPlayer" type="node" onChange="onMusicPlayerSet" />
    </interface>
</component>
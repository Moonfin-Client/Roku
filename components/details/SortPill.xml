<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded button naming the order a list is in, which opens the picker for it -->
<component name="SortPill" extends="Group">
    <children>
        <Poster id="pillFill" uri="pkg:/images/icons/pill-focus.9.png" height="50"
            blendColor="#FFFFFF" opacity="0.08" />
        <Poster id="pillRing" uri="pkg:/images/details/tabborderfocus.9.png" height="50"
            blendColor="#FFFFFF" visible="false" />
        <Label id="pillText" font="font:SmallBoldSystemFont" color="#FFFFFF" height="50"
            vertAlign="center" translation="[22, 0]" />
    </children>
    <interface>
        <field id="text" type="string" onChange="onTextChanged" />
        <!-- How wide the pill came out, for a parent lining it up against an edge -->
        <field id="pillWidth" type="float" />
        <field id="selected" type="boolean" alwaysNotify="true" />
    </interface>
</component>

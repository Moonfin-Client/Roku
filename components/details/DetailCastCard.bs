import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const CAST_TEXT_GAP = 10

sub init()
    m.photoGroup = m.top.findNode("photoGroup")
    m.focusRing = m.top.findNode("focusRing")
    m.photo = m.top.findNode("photo")
    m.name = m.top.findNode("name")
    m.role = m.top.findNode("role")

    m.name.font.size = 20
    m.role.font.size = 18

    themeApply.ApplyToItem(m.top)
end sub

sub onContentChanged()
    cont = m.top.itemContent
    if not isValid(cont) then return

    m.name.text = cont.labelText
    m.role.text = cont.subTitle
    m.photo.uri = isValidAndNotEmpty(cont.posterURL) ? cont.posterURL : ""

    ' A name long enough to wrap pushes the role down, so the two never overlap
    m.role.translation = [0, m.name.translation[1] + m.name.boundingRect().height + CAST_TEXT_GAP]
end sub

sub onFocusChanged()
    focused = m.top.itemHasFocus
    m.focusRing.visible = focused
    m.photoGroup.scale = focused ? [1.08, 1.08] : [1.0, 1.0]
end sub

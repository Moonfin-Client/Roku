<?xml version="1.0" encoding="utf-8"?>
<component name="MinimalistEpisodeCard" extends="Group">
    <children>
        <!-- One episode in the rail: the still, its number, and the title -->
        <Group id="artwork">
            <MaskGroup id="artMask" maskUri="pkg:/images/details/nouveau/mask_landscape.webp">
                <!-- Holds the background a card with no still of its own is left showing, which
                    reads as artwork that is missing rather than as the wrong shape -->
                <Rectangle id="artBg" color="#FFFFFF" opacity="0.1" />
                <Poster id="artImage" loadDisplayMode="scaleToZoom" />
            </MaskGroup>

            <!-- Something to count along by for anyone who cannot read the title yet, which is why
                it sits on the artwork rather than in front of the title -->
            <Group id="numberBadge" visible="false">
                <Poster id="numberFill" uri="pkg:/images/details/badgefill6.9.png"
                    loadDisplayMode="scaleToFit" blendColor="#000000" opacity="0.78" />
                <Label id="numberText" font="font:SmallBoldSystemFont" color="#FFFFFF"
                    vertAlign="center" horizAlign="center" />
            </Group>

            <Group id="watchedBadge" visible="false">
                <Poster id="watchShadow" uri="pkg:/images/icons/circle.webp" width="22" height="22"
                    translation="[0, 2]" blendColor="#00000099" />
                <Poster id="watchBorder" uri="pkg:/images/icons/circle.webp" width="22" height="22"
                    blendColor="#FFFFFF" />
                <Poster id="watchBg" uri="pkg:/images/icons/circle.webp" width="19" height="19"
                    translation="[1.5, 1.5]" blendColor="#00A4DC" />
                <Poster id="watchIcon" uri="pkg:/images/icons/check_white.webp" width="13" height="13"
                    translation="[4.5, 4.5]" />
            </Group>

            <!-- Painted over the artwork rather than around it. Drawn around, it would make the
                focused card wider than its neighbours and knock the rail's scrolling out of step -->
            <Poster id="artFocus" uri="pkg:/images/details/cardborderfocus.9.png"
                loadDisplayMode="scaleToFit" blendColor="#FFFFFF" visible="false" />
        </Group>

        <!-- The rail sits straight on the artwork with no scrim under it, so the title carries its
            own separation -->
        <Label id="cardTitle" font="font:SmallBoldSystemFont" color="#FFFFFF"
            wrap="true" maxLines="2" />
    </children>
    <interface>
        <field id="cardData" type="assocarray" onChange="onCardDataChanged" />
        <!-- [card width, artwork height] -->
        <field id="cardSize" type="array" onChange="onCardSizeChanged" />
        <field id="focused" type="boolean" value="false" onChange="onFocusedChanged" />
        <field id="cardHeight" type="float" value="0" />
    </interface>
</component>

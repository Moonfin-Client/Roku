import "pkg:/components/posterLabels/posterLabelsDraw.bs"
import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

const MINIMALIST_CARD_TITLE_GAP = 8
const MINIMALIST_CARD_TITLE_LINES = 2
const MINIMALIST_BADGE_INSET = 8
const MINIMALIST_BADGE_PAD = 11
const MINIMALIST_NUMBER_HEIGHT = 26
const MINIMALIST_WATCHED_SIZE = 22

sub init()
    m.artMask = m.top.findNode("artMask")
    m.artBg = m.top.findNode("artBg")
    m.artImage = m.top.findNode("artImage")
    m.artFocus = m.top.findNode("artFocus")
    m.numberBadge = m.top.findNode("numberBadge")
    m.numberFill = m.top.findNode("numberFill")
    m.numberText = m.top.findNode("numberText")
    m.watchedBadge = m.top.findNode("watchedBadge")
    m.watchBorder = m.top.findNode("watchBorder")
    m.watchBg = m.top.findNode("watchBg")
    m.watchIcon = m.top.findNode("watchIcon")
    m.cardTitle = m.top.findNode("cardTitle")
    m.isCurrent = false
    m.numberHeight = MINIMALIST_NUMBER_HEIGHT
    m.badgeInset = MINIMALIST_BADGE_INSET

    m.numberFill.height = MINIMALIST_NUMBER_HEIGHT
    m.numberText.height = MINIMALIST_NUMBER_HEIGHT
    m.numberText.font.size = fontApply.ThemeTextSize(17)
    m.cardTitle.font.size = fontApply.ThemeTextSize(18)
    ' Room for both lines whatever size the theme's font came out at
    m.titleHeight = Int(m.cardTitle.font.size * 1.25) * MINIMALIST_CARD_TITLE_LINES + 4

    themeApply.ApplyToItem(m.top)
end sub

sub onCardSizeChanged()
    size = m.top.cardSize
    if not isValidAndNotEmpty(size) or size.count() < 2 then return

    width = size[0]
    height = size[1]

    ' A larger card counts along in a round badge, the way the other clients draw it
    scale = m.top.textScale
    if scale <> 1
        m.cardTitle.font.size = Int(fontApply.ThemeTextSize(18) * scale)
        m.titleHeight = Int(m.cardTitle.font.size * 1.25) * MINIMALIST_CARD_TITLE_LINES + 4
        m.numberHeight = Int(MINIMALIST_NUMBER_HEIGHT * scale * 1.2)
        m.badgeInset = Int(MINIMALIST_BADGE_INSET * scale)
        m.numberText.font.size = Int(fontApply.ThemeTextSize(17) * scale)
        m.numberFill.uri = "pkg:/images/icons/circle.webp"
        m.numberFill.height = m.numberHeight
        m.numberText.height = m.numberHeight
        m.watchedBadge.scale = [scale, scale]
    end if

    m.artMask.maskSize = [width, height]
    m.artBg.width = width
    m.artBg.height = height
    m.artImage.width = width
    m.artImage.height = height
    m.artFocus.width = width
    m.artFocus.height = height

    m.cardTitle.width = width
    m.cardTitle.height = m.titleHeight
    m.cardTitle.translation = [0, height + MINIMALIST_CARD_TITLE_GAP]

    m.watchedBadge.translation = [width - MINIMALIST_WATCHED_SIZE * scale - m.badgeInset, m.badgeInset]

    m.top.cardHeight = height + MINIMALIST_CARD_TITLE_GAP + m.titleHeight
    layoutNumber()
    if isValid(m.posterLabels) and m.posterLabels.visible then m.posterLabels.frame = posterLabelSpots()
end sub

sub onCardDataChanged()
    data = m.top.cardData
    if not isValid(data) then return

    m.artImage.uri = isValid(data.imageUrl) ? data.imageUrl : ""
    m.cardTitle.text = isValid(data.title) ? data.title : ""
    m.watchedBadge.visible = data.watched = true
    if m.watchedBadge.visible then paintWatchedBadge()

    ' A card with no number of its own carries the sentinel the screen sends in place of invalid
    hasNumber = isValid(data.number) and data.number >= 0
    m.numberText.text = hasNumber ? data.number.toStr() : ""
    m.numberBadge.visible = hasNumber
    layoutNumber()

    m.isCurrent = data.current = true
    showBorder()

    if isValidAndNotEmpty(data.posterLabels) or isValid(m.posterLabels) then m.posterLabels = drawPosterLabels(m.posterLabels, m.artMask, data.posterLabels, posterLabelSpots(), POSTER_LABEL_EPISODE_SCALE)
end sub

' The badge, its rim and the check take the theme's colors, the way the cards on every other screen do
sub paintWatchedBadge()
    onBadgeColor = themeChrome.Token("onBadge", "#FFFFFF")
    m.watchBorder.blendColor = onBadgeColor
    m.watchBg.blendColor = themeChrome.Token("badgeWatched", chainLookupReturn(m.global.session, "user.settings.colorPlayedCheckmarkBackground", "#0066CC"))
    m.watchIcon.blendColor = chainLookupReturn(m.global.session, "user.settings.colorPlayedCheckmarkIcon", onBadgeColor)
end sub

' Under the watched badge and over the episode number
function posterLabelSpots() as object
    size = m.top.cardSize
    width = 0
    height = 0
    if isValid(size) and size.count() > 1
        width = size[0]
        height = size[1]
    end if

    topRight = posterLabelsBelow(m.watchedBadge, MINIMALIST_WATCHED_SIZE * m.top.textScale, POSTER_LABEL_EDGE)
    return posterLabelFrame(width, height, POSTER_LABEL_EDGE, topRight, posterLabelsAbove(m.numberBadge, height, POSTER_LABEL_EDGE), POSTER_LABEL_EDGE)
end function

sub layoutNumber()
    if not m.numberBadge.visible then return

    if m.top.textScale <> 1 then m.numberText.width = 0
    width = m.numberText.boundingRect().width + MINIMALIST_BADGE_PAD * 2
    if m.top.textScale <> 1 and width < m.numberHeight then width = m.numberHeight
    m.numberText.width = width
    m.numberFill.width = width

    height = m.top.cardSize.count() > 1 ? m.top.cardSize[1] : 0
    m.numberBadge.translation = [m.badgeInset, height - m.numberHeight - m.badgeInset]
end sub

sub onFocusedChanged()
    showBorder()
end sub

' The episode the screen is showing keeps a blue border until focus takes it over
sub showBorder()
    m.artFocus.visible = m.top.focused or m.isCurrent
    m.artFocus.blendColor = m.top.focused ? "#FFFFFF" : "#00A4DCB3"
end sub

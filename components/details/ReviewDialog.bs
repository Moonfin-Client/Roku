import "pkg:/components/messages/messageBlocks.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/messageMarkdown.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/tmdbReviews.bs"

const PANEL_WIDTH = 1100
const PANEL_PAD_X = 32
const PANEL_PAD_Y = 28
const PANEL_MAX_HEIGHT = 864
const BODY_TOP = 116
const SCROLL_GUTTER = 24
const THUMB_MIN_HEIGHT = 40

sub init()
    m.panel = m.top.findNode("panel")
    m.panelBg = m.top.findNode("panelBg")
    m.panelBorder = m.top.findNode("panelBorder")
    m.initialFill = m.top.findNode("initialFill")
    m.initialLabel = m.top.findNode("initialLabel")
    m.avatarMask = m.top.findNode("avatarMask")
    m.avatar = m.top.findNode("avatar")
    m.author = m.top.findNode("author")
    m.meta = m.top.findNode("meta")
    m.viewport = m.top.findNode("viewport")
    m.body = m.top.findNode("body")
    m.scrollTrack = m.top.findNode("scrollTrack")
    m.scrollThumb = m.top.findNode("scrollThumb")

    m.initialLabel.font.size = 28
    m.author.font.size = 28
    m.meta.font.size = 19
    m.top.visible = false
    m.scrollTop = 0
end sub

sub showReview()
    review = m.top.review
    if not isValid(review) then return
    readPalette()

    m.panelBg.blendColor = m.surface
    m.initialFill.blendColor = m.buttonInk
    m.initialLabel.color = m.ink
    m.initialLabel.text = review.initial
    m.avatar.uri = review.avatarUrl
    m.avatarMask.visible = review.avatarUrl <> ""
    m.author.color = m.ink
    m.author.text = review.author
    m.meta.color = m.faint
    m.meta.text = tmdbReviews.MetaLine(review)

    m.body.removeChildrenIndex(m.body.getChildCount(), 0)
    width = PANEL_WIDTH - PANEL_PAD_X * 2 - SCROLL_GUTTER
    bodyHeight = drawBlocks(m.body, messageMarkdown.ParseBlocks(review.content), width)

    m.viewportHeight = bodyHeight
    room = PANEL_MAX_HEIGHT - BODY_TOP - PANEL_PAD_Y
    if m.viewportHeight > room then m.viewportHeight = room
    m.maxScroll = bodyHeight - m.viewportHeight
    m.viewport.clippingRect = [0, 0, width, m.viewportHeight]

    scrolls = m.maxScroll > 0
    m.scrollTrack.visible = scrolls
    m.scrollThumb.visible = scrolls
    if scrolls
        m.scrollTrack.color = m.buttonInk
        m.scrollThumb.color = m.faint
        m.scrollTrack.translation = [PANEL_WIDTH - PANEL_PAD_X - m.scrollTrack.width, BODY_TOP]
        m.scrollTrack.height = m.viewportHeight
        thumbHeight = m.viewportHeight * m.viewportHeight / bodyHeight
        if thumbHeight < THUMB_MIN_HEIGHT then thumbHeight = THUMB_MIN_HEIGHT
        m.scrollThumb.height = thumbHeight
    end if

    panelHeight = BODY_TOP + m.viewportHeight + PANEL_PAD_Y
    m.panelBg.height = panelHeight
    m.panelBorder.height = panelHeight
    m.panel.translation = [(1920 - PANEL_WIDTH) / 2, Int((1080 - panelHeight) / 2)]

    m.scrollTop = 0
    applyScroll()
    m.top.visible = true
    m.top.setFocus(true)
end sub

sub scrollBy(share as float)
    m.scrollTop += m.viewportHeight * share
    if m.scrollTop < 0 then m.scrollTop = 0
    if m.scrollTop > m.maxScroll then m.scrollTop = m.maxScroll
    applyScroll()
end sub

sub applyScroll()
    m.body.translation = [0, -m.scrollTop]
    if not m.scrollThumb.visible then return
    travel = m.viewportHeight - m.scrollThumb.height
    offset = 0
    if m.maxScroll > 0 then offset = travel * m.scrollTop / m.maxScroll
    m.scrollThumb.translation = [m.scrollTrack.translation[0], BODY_TOP + offset]
end sub

' The dialog stays in the scene for the next review, so it lets go of focus and its text here
sub closeReview()
    m.top.visible = false
    m.top.setFocus(false)
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
    m.top.returnFocus = invalid
    m.body.removeChildrenIndex(m.body.getChildCount(), 0)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not m.top.visible then return false
    if not press then return true

    if key = KeyCode.BACK or key = KeyCode.OK
        closeReview()
    else if key = KeyCode.UP
        scrollBy(-0.2)
    else if key = KeyCode.DOWN
        scrollBy(0.2)
    else if key = KeyCode.REWIND
        scrollBy(-0.66)
    else if key = KeyCode.FASTFORWRD
        scrollBy(0.66)
    end if
    ' Nothing gets past the dialog while it's up
    return true
end function

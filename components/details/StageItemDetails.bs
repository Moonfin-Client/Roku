import "pkg:/source/utils/minimalistRules.bs"

' Stage leads with the poster. It stands on the left with Play under it and a few circles under
' that, the title and everything about it sits beside the poster, and the rows of other titles run
' full width underneath.
'
' It's Nouveau's page laid out another way, so the loading, the rails, the Seerr block and the
' scrolling come from there. This file places the parts and walks the remote through them.

' The other clients lay this page out at 1150 by 647 points on a TV, so every size here is theirs
' at the 1.67 that takes it to this screen. A sidebar takes more room on the left than a nav along
' the top.
const STAGE_TOP = 172
const STAGE_SIDEBAR_INSET = 200
const STAGE_TOP_NAV_INSET = 80
const STAGE_RIGHT_INSET = 80
const STAGE_POSTER_WIDTH = 388
const STAGE_COLUMN_GAP = 68
const STAGE_OVERVIEW_WIDTH = 1436

' Play spans the poster, and up to three circles and More sit under it. The buttons are drawn at
' 75 and scaled up to the other clients' 90 and 87.
const STAGE_PLAY_HEIGHT = 90
const STAGE_PLAY_SCALE = 1.2
const STAGE_BUTTON_SIZE = 87
const STAGE_CIRCLE_SCALE = 1.16
const STAGE_PLAY_GAP = 27
const STAGE_CIRCLE_GAP = 21
const STAGE_CIRCLE_SPACING = 13
const STAGE_LABEL_ROOM = 40
const STAGE_MAX_BUTTONS = 5
const STAGE_KIDS_MAX_BUTTONS = 4

const STAGE_LOGO_WIDTH = 601
const STAGE_LOGO_HEIGHT = 173
const STAGE_SUBTITLE_GAP = 13
const STAGE_HERO_GAP = 17
const STAGE_TEXT_GAP = 20
const STAGE_TECH_CHIP_HEIGHT = 40
const STAGE_TECH_CHIP_PAD = 15
const STAGE_TECH_CHIP_GAP = 10
const STAGE_DOWNLOAD_WIDTH = 600
const STAGE_DOWNLOAD_HEIGHT = 38
' The reason line under the bar
const STAGE_REASON_GAP = 8

const STAGE_SECTION_GAP = 30
const STAGE_ROW_GAP = 47
const STAGE_TAB_GAP = 11
const STAGE_SEASON_BAR_HEIGHT = 71
const STAGE_HEADING_HEIGHT = 60
const STAGE_PAGE_TAIL = 80
const STAGE_EPISODE_WIDTH = 350
const STAGE_EPISODE_HEIGHT = 197
const STAGE_EPISODE_GAP = 34
const STAGE_EPISODE_TEXT = 1.67
const STAGE_POSTER_CARD_WIDTH = 250
const STAGE_POSTER_CARD_HEIGHT = 375
const STAGE_POSTER_CARD_GAP = 36
' How far SeerrCard's focus ring reaches past its poster
const STAGE_SEERR_RING = 8
const STAGE_CARD_TEXT = 1.3
const STAGE_PERSON_WIDTH = 174
const STAGE_PERSON_AVATAR = 150
const STAGE_PERSON_GAP = 20
const STAGE_EXTRA_WIDTH = 284
const STAGE_EXTRA_HEIGHT = 160
const STAGE_ROW_TITLE = 37
const STAGE_ROW_TITLE_GAP = 48
const STAGE_PEOPLE_TITLE_GAP = 2

' The page sits on the picture rather than beside it, so the darkening keeps a floor even with the
' slider at the bottom
const STAGE_MIN_SCRIM = 0.55
const STAGE_SCRIM_RANGE = 0.3

' A focused part is only scrolled to when some of it is off screen, and then only as far as it takes
const STAGE_SCROLL_TOP = 80
const STAGE_SCROLL_BOTTOM = 40
const STAGE_NAV_SHOWN = -24

sub init()
    page = m.sectionsGroup.getParent()
    m.hero = m.metadataRow.getParent()

    m.posterColumn = m.top.findNode("posterColumn")
    m.posterColumn.reparent(page, false)
    m.posterMask = m.top.findNode("posterMask")
    m.posterBg = m.top.findNode("posterBg")
    m.posterImage = m.top.findNode("posterImage")
    m.posterTrack = m.top.findNode("posterTrack")
    m.posterProgress = m.top.findNode("posterProgress")
    m.posterBadges = m.top.findNode("posterBadges")
    m.buttonRowContainer.reparent(m.posterColumn, false)

    m.stageSubtitle = m.top.findNode("stageSubtitle")
    m.tagline = m.top.findNode("tagline")
    m.downloadGroup = m.top.findNode("downloadGroup")
    m.downloadText = m.top.findNode("downloadText")
    m.downloadTrack = m.top.findNode("downloadTrack")
    m.downloadFill = m.top.findNode("downloadFill")
    m.downloadReason = m.top.findNode("downloadReason")
    m.downloadHeight = STAGE_DOWNLOAD_HEIGHT
    for each node in [m.stageSubtitle, m.tagline, m.downloadGroup]
        node.reparent(m.hero, false)
    end for
    ' Moonfin Core sets this overview at 25 px with 9 px between lines, and a theme keeps its own color
    m.overview.fontSize = 25
    m.overview.lineHeight = 1 + 9 / 25
    if not themeChrome.IsActive() then m.overview.findNode("overviewText").color = "#FFFFFFD1"
    m.ratingsRow.valueSize = 27
    m.ratingsRow.nameSize = 17
    m.ratingsRow.iconHeight = 34
    m.downloadTrack.translation = [0, 32]
    m.downloadFill.translation = [0, 32]
    m.downloadTrack.width = STAGE_DOWNLOAD_WIDTH
    m.downloadReason.width = STAGE_DOWNLOAD_WIDTH
    m.downloadReason.translation = [0, STAGE_DOWNLOAD_HEIGHT + STAGE_REASON_GAP]

    ' Stage's own parts are made after Nouveau's init has themed the page, so they're sized and themed
    ' here
    m.seerrHeading = m.top.findNode("seerrHeading")
    for each part in [[m.stageSubtitle, 46], [m.tagline, 28], [m.downloadText, 20], [m.downloadReason, 18], [m.seerrHeading, STAGE_ROW_TITLE]]
        part[0].font.size = fontApply.ThemeTextSize(part[1])
        themeApply.ApplyToItem(part[0])
    end for
    ' The themed colors, so a Not found yet line can borrow the reason's muted one and give it back
    m.downloadTextColor = m.downloadText.color

    ' Nouveau gives the genres and the badges rows of their own, and here they join the facts line
    for each id in ["metaGenres", "statusBadge", "upcomingBadge", "seerrPills"]
        m.top.findNode(id).reparent(m.metadataRow, false)
    end for
    m.genres.width = 0
    m.metaRowExcludes = {}

    m.trackChips = m.top.findNode("trackChips")
    m.factChips = m.top.findNode("factChips")
    for each node in [m.trackChips, m.factChips, m.seerrHeading]
        node.reparent(page, false)
    end for
    m.factChips.columns = true

    m.seasonBar.barPad = 8
    m.seasonBar.segmentPadX = 24
    m.seasonBar.textSize = 24
    m.seasonBar.thumbColor = themeChrome.Accent()
    m.seasonBar.thumbInk = themeChrome.OnAccent()
    m.posterProgress.color = themeChrome.Accent()

    m.logoImage.observeField("loadStatus", "onStageLogoLoaded")
    m.top.observeField("seerrTarget", "onStageSeerrTarget")

    m.pieces = []
    m.trackChoices = []
    m.factChoices = []
    m.posterHeight = Int(STAGE_POSTER_WIDTH * 1.5)
    m.logoBox = [STAGE_LOGO_WIDTH, STAGE_LOGO_HEIGHT]
    m.episodeCard = { width: STAGE_EPISODE_WIDTH, height: STAGE_EPISODE_HEIGHT, gap: STAGE_EPISODE_GAP, textScale: STAGE_EPISODE_TEXT }
    m.techChip = { height: STAGE_TECH_CHIP_HEIGHT, pad: STAGE_TECH_CHIP_PAD, gap: STAGE_TECH_CHIP_GAP, border: "#FFFFFF59", ink: "#FFFFFF" }
    placeColumns()
end sub

' The poster column sits in from whichever side the nav takes, and the column beside it fills the
' rest of the row
sub placeColumns()
    m.inset = STAGE_TOP_NAV_INSET
    if sidebarShown() then m.inset = STAGE_SIDEBAR_INSET
    m.besideX = m.inset + STAGE_POSTER_WIDTH + STAGE_COLUMN_GAP
    m.besideWidth = 1920 - STAGE_RIGHT_INSET - m.besideX

    m.posterColumn.translation = [m.inset, STAGE_TOP]
    m.hero.translation = [m.besideX, STAGE_TOP]
    for each node in [m.titleNode, m.stageSubtitle]
        node.width = m.besideWidth
    end for
    textWidth = m.besideWidth
    if textWidth > STAGE_OVERVIEW_WIDTH then textWidth = STAGE_OVERVIEW_WIDTH
    m.tagline.width = textWidth
    m.overview.maxWidth = textWidth
    m.ratingsRow.maxWidth = m.besideWidth
    m.trackChips.maxWidth = m.besideWidth
    m.factChips.maxWidth = m.besideWidth
end sub

' Runs from Nouveau's init, ahead of the theme fonts and before Stage's own parts exist
sub sizeHeroFonts()
    m.titleNode.font.size = fontApply.ThemeTextSize(63)
    m.top.findNode("statusBadgeText").font.size = fontApply.ThemeTextSize(23)
    m.top.findNode("upcomingBadgeText").font.size = fontApply.ThemeTextSize(23)
    m.badgeHeight = 34
    m.badgePadH = 12
    m.top.findNode("techChipFont").font = "font:SmallestBoldSystemFont"
    m.top.findNode("techChipFont").font.size = 20

    ' The facts line is bold white, the way the other clients write it
    metaSize = fontApply.ThemeTextSize(22)
    for each id in ["releaseYear", "officialRating", "seasonCount", "episodeNumber", "runtime", "endsAt", "metaGenres"]
        node = m.top.findNode(id)
        node.font = "font:SmallestBoldSystemFont"
        node.font.size = metaSize
        node.color = "#FFFFFF"
    end for
    m.top.findNode("runtimeIcon").blendColor = "#FFFFFF"
end sub

' ===== Content =====

' A title from Seerr arrives with only its TMDB id, so a series is marked as one before it draws,
' which is what gives it its seasons
sub onStageSeerrTarget()
    if isStringEqual(chainLookupReturn(m.top.seerrTarget, "mediaType", ""), "tv") then m.top.itemType = "series"
end sub

' Nouveau calls this once the facts are filled in, so the parts Stage draws its own way are set here
' before the rows start loading
sub loadSections()
    itemData = m.top.itemContent.json
    showHeader(itemData)

    ' Nothing in the library stands behind a Seerr title, so its people come off Seerr's credits
    if m.top.seerrOnly
        people = splitCastAndCrew(seerrPeople())
        if detailSectionLayout.Shows("cast") then m.sectionData.cast = people.cast
        if detailSectionLayout.Shows("crew") then m.sectionData.crew = people.crew
        rebuildSections()
        return
    end if

    task = CreateObject("roSGNode", "LoadExtrasTask")
    task.itemId = m.top.id
    task.itemType = m.top.itemType
    task.providerIds = itemData.ProviderIds ?? {}
    task.includeCollections = true
    if isSeries()
        task.isTVShow = true
        task.showID = m.top.itemContent.id
    end if
    useItemServer(task, itemData)
    task.observeField("content", "onExtrasLoaded")
    task.control = TaskControl.RUN

    ' The whole run comes at once and the season tabs pick which part of it shows. A season's own
    ' episodes are handed over by the screen that opened it.
    seriesId = ""
    if isSeries() then seriesId = m.top.id
    if isEpisode() and detailSectionLayout.Shows("moreEpisodes") then seriesId = chainLookupReturn(itemData, "SeriesId", "")
    if seriesId <> ""
        episodesTask = CreateObject("roSGNode", "NouveauSeriesEpisodesTask")
        episodesTask.seriesId = seriesId
        episodesTask.withLabels = true
        useItemServer(episodesTask, itemData)
        episodesTask.observeField("episodes", "onSeriesEpisodesLoaded")
        episodesTask.control = TaskControl.RUN
    end if

    rebuildSections()
end sub

' A title from another signed in server is asked about there
sub useItemServer(task as object, itemData as object)
    if not isValidAndNotEmpty(itemData._serverUrl) then return
    task.serverUrl = itemData._serverUrl
    task.serverUserId = itemData._userId
    task.serverAuthToken = itemData._authToken
end sub

function seerrPeople() as object
    people = []
    for each person in chainLookupReturn(m.top.itemContent, "json.People", [])
        node = CreateObject("roSGNode", "HomeData")
        node.json = person
        node.type = "Person"
        node.labelText = person.Name ?? ""
        node.posterURL = person._externalImageUrl ?? ""
        people.push(node)
    end for
    return people
end function

sub showHeader(itemData as object)
    showPoster(itemData)

    ' A season or an episode names its show first, then itself on the line under it
    m.titleNode.text = minimalistRules.Branding(itemData, m.top.itemType).title
    subtitle = ""
    if isEpisode()
        subtitle = itemData.Name ?? ""
        season = itemData.ParentIndexNumber
        episode = itemData.IndexNumber
        if isValid(season) and isValid(episode) then subtitle = `S${season}:E${episode} ${fontApply.ThemeSeparator()} ${subtitle}`
        ' The line under the name already numbers the episode, and the facts line names its rating
        setFieldText("episodeNumber", "")
        if isValid(itemData.OfficialRating) then setFieldText("officialRating", itemData.OfficialRating)
    else if isSeason()
        subtitle = itemData.Name ?? ""
    end if
    m.stageSubtitle.text = subtitle
    m.stageSubtitle.visible = subtitle <> ""

    m.tagline.visible = m.tagline.text <> ""
    fitWrappedLabel(m.tagline)

    layoutContainer()
end sub

' A wrapped label with no height can draw only its first line, so it gets the height its text takes.
' It's measured with no height set, since one that has a height reports that instead.
sub fitWrappedLabel(label as object)
    label.height = 0
    if label.text = "" then return
    label.height = label.boundingRect().height + 4
end sub

' An episode's still is wide, so it keeps its own shape rather than being cropped into a poster. With
' series thumbnails on, it shows its show's poster instead.
sub showPoster(itemData as object)
    width = STAGE_POSTER_WIDTH
    ownTag = chainLookupReturn(itemData, "ImageTags.Primary", "")
    seriesId = chainLookupReturn(itemData, "SeriesId", "")
    seriesTag = chainLookupReturn(itemData, "SeriesPrimaryImageTag", "")
    showsSeries = seriesId <> "" and seriesTag <> "" and ((isEpisode() and minimalistRules.UsesSeriesThumbnails()) or (isSeason() and ownTag = ""))
    external = chainLookupReturn(itemData, "_externalPosterUrl", "")
    wide = not showsSeries and external = "" and (isEpisode() or LCase(m.top.itemType) = "video")

    m.posterHeight = Int(width * 1.5)
    m.posterMask.maskUri = "pkg:/images/details/poster_mask.webp"
    if wide
        m.posterHeight = Int(width * 9 / 16)
        m.posterMask.maskUri = "pkg:/images/details/thumb_mask.webp"
    end if

    url = external
    if showsSeries
        url = minimalistRules.ImageUrlFor(itemData, seriesId, ImageType.PRIMARY, seriesTag, width, m.posterHeight)
    else if url = "" and ownTag <> ""
        url = minimalistRules.ImageUrlFor(itemData, itemData.id, ImageType.PRIMARY, ownTag, width, m.posterHeight)
    end if

    m.posterMask.maskSize = [width, m.posterHeight]
    m.posterBg.width = width
    m.posterBg.height = m.posterHeight
    m.posterImage.width = width
    m.posterImage.height = m.posterHeight
    m.posterImage.uri = url
    m.buttonRowContainer.translation = [0, m.posterHeight + STAGE_PLAY_GAP]

    updatePlayedIndicator()
end sub

' The favorite and watched badges and how far in it is, the way the other poster screens mark one
sub updatePlayedIndicator()
    itemData = chainLookupReturn(m.top.itemContent, "json", invalid)
    if not isValid(itemData) then return

    played = chainLookupReturn(itemData, "UserData.Played", false) = true
    m.posterBadges.translation = [STAGE_POSTER_WIDTH - 50, 10]
    m.posterBadges.favoriteOffset = [60 - STAGE_POSTER_WIDTH, 0]
    m.posterBadges.data = { played: played, favorite: chainLookupReturn(itemData, "UserData.IsFavorite", false) = true }
    m.posterBadges.visible = true

    percent = chainLookupReturn(itemData, "UserData.PlayedPercentage", 0)
    inProgress = not played and percent > 0 and percent < 100
    m.posterTrack.visible = inProgress
    m.posterProgress.visible = inProgress
    if not inProgress then return

    barWidth = STAGE_POSTER_WIDTH - 20
    m.posterTrack.translation = [10, m.posterHeight - 20]
    m.posterTrack.width = barWidth
    m.posterTrack.height = 10
    m.posterProgress.translation = [10, m.posterHeight - 20]
    m.posterProgress.width = Int(barWidth * percent / 100)
    m.posterProgress.height = 10
end sub

' The audio, subtitle and version pickers, each showing what it's set to. One the viewer hid from
' the buttons stays hidden here too.
function trackChoices(itemData as object) as object
    choices = []
    if m.top.seerrOnly or not inArray(["movie", "episode", "video", "musicvideo"], LCase(m.top.itemType)) then return choices

    hidden = buttonLayout.HiddenLookup(m.global.session.user.settings[DETAIL_HIDDEN_SETTING])
    audios = m.trackData.audios ?? []
    if audios.count() > 1 and not hidden.DoesExist("audio")
        choices.push({ icon: "pkg:/images/icons/detail_audio.webp", label: tr("Audio"), value: chosenTrack(audios), action: "audioTrack" })
    end if

    sources = itemData.MediaSources
    if isStringEqual(itemData.MediaType, "Video") and isValidAndNotEmpty(sources) and sources[0].Type <> "Placeholder" and not hidden.DoesExist("subtitles")
        choices.push({ icon: "pkg:/images/icons/osd/subtitles.webp", label: tr("Subtitles"), value: chosenTrack(m.trackData.subtitles ?? []), action: "subtitleTrack" })
    end if

    if isValid(sources) and sources.count() > 1 and not hidden.DoesExist("version")
        choices.push({ icon: "pkg:/images/icons/detail_version.webp", label: tr("Version"), value: chosenTrack(m.trackData.videos ?? []), action: "versionTrack" })
    end if
    return choices
end function

function chosenTrack(tracks as object) as string
    for each track in tracks
        if track.Selected = true
            if track.StreamIndex = SubtitleSelection.NONE then return tr("None")
            return track.Title ?? ""
        end if
    end for
    if tracks.count() > 0 then return tracks[0].Title ?? ""
    return tr("None")
end function

' Who directed and wrote a title and the studios behind it
function factChoices(itemData as object) as object
    choices = []
    ' Read off the item, since the people rail's list keeps someone who both wrote and directed
    ' only once
    if detailSectionLayout.Shows("crew")
        people = chainLookupReturn(itemData, "People", [])
        for each role in [["Director", tr("Director")], ["Writer", tr("Writer")]]
            for each person in people
                if isStringEqual(person.LookupCI("Type") ?? "", role[0])
                    node = CreateObject("roSGNode", "HomeData")
                    node.json = person
                    node.type = "Person"
                    choices.push({ label: role[1], value: person.LookupCI("Name") ?? "", person: node })
                end if
            end for
        end for
    end if

    if detailSectionLayout.Shows("studios")
        for each studio in itemData.Studios ?? []
            name = studio.LookupCI("Name") ?? ""
            if name <> "" then choices.push({ label: tr("Studio"), value: name, studio: { id: studio.LookupCI("Id") ?? "", name: name } })
        end for
    end if
    return choices
end function

' The chip row only needs the words, and the people behind the fact chips stay on this screen. Every
' section that lands rebuilds the page, so a row is only drawn again when its chips change.
sub showChips(row as object, choices as object)
    chips = []
    for each choice in choices
        chips.push({ icon: choice.icon ?? "", label: choice.label, value: choice.value })
    end for
    if FormatJson(chips) <> FormatJson(row.chips) then row.chips = chips
    row.visible = chips.count() > 0
end sub

' ===== Sections =====

' Beside the poster: an overview with more to read, the track chips, the people and studios behind
' a film, and a show's seasons and episodes. Full width under it: an episode's run, the cast,
' extras, collections, more like it and Seerr's rows.
sub rebuildSections()
    if not isChainValid(m.top.itemContent, "json") then return
    itemData = m.top.itemContent.json

    held = { zone: m.focusZone, key: "", stop: -1 }
    if held.zone = "rail" and m.focusRail >= 0 and m.focusRail < m.rails.count()
        held.key = m.rails[m.focusRail].key
        held.stop = m.rails[m.focusRail].node.focusedStop
    end if

    m.sectionsGroup.removeChildrenIndex(m.sectionsGroup.getChildCount(), 0)
    m.rails = []
    m.pieces = []
    m.seasonBar.visible = false

    if overviewCanScroll() then m.pieces.push({ zone: "overview", rail: -1, beside: true })

    m.trackChoices = trackChoices(itemData)
    showChips(m.trackChips, m.trackChoices)
    if m.trackChoices.count() > 0 then m.pieces.push({ zone: "chips", rail: -1, beside: true })

    ' A show leaves the people and studios out
    m.factChoices = []
    if not isSeries() and not isSeason() and not isEpisode() then m.factChoices = factChoices(itemData)
    showChips(m.factChips, m.factChoices)
    if m.factChoices.count() > 0 then m.pieces.push({ zone: "facts", rail: -1, beside: true })

    if m.top.seerrOnly
        if isSeries() then addSeerrSeasons()
    else if isSeries() or isSeason()
        addEpisodes(true)
    else if isEpisode()
        addEpisodes(false)
    end if

    addCastRail()
    addExtrasRail()
    for each collection in m.sectionData.parentCollections
        addPosterRail(collection.name, collection.items)
    end for
    addPosterRail(tr("More Like This"), m.sectionData.similar)

    seerrName = GetSeerrDisplayName()
    m.seerrHeading.visible = m.seerrBlock.visible
    if m.seerrBlock.visible
        m.seerrHeading.text = seerrName
        m.pieces.push({ zone: "seerr", rail: -1, beside: false })
    end if
    addPosterRail(`${seerrName} · ${tr("Recommendations")}`, m.sectionData.seerrRecommendations, true)
    addPosterRail(`${seerrName} · ${tr("Similar")}`, m.sectionData.seerrSimilar, true)

    layoutPage()
    buildChain()
    restoreStageFocus(held)
end sub

' Collections, More Like This and Seerr's titles all use the same poster size. Seerr's own rails
' draw the Requests page's cards.
sub addPosterRail(title as string, items as object, seerr = false as boolean)
    if items.count() = 0 then return
    if seerr
        cards = []
        for each item in items
            cards.push({ item: item })
        end for
        spec = { title: title, component: "StageSeerrCard", stopsPerCard: 1, cards: cards, leadsSection: false, focusOverhang: STAGE_SEERR_RING }
    else
        spec = posterSpec(title, items, false, true)
    end if
    spec.cardSize = [STAGE_POSTER_CARD_WIDTH, STAGE_POSTER_CARD_HEIGHT]
    spec.gap = STAGE_POSTER_CARD_GAP
    addRail(railSpec(spec, false, STAGE_ROW_TITLE_GAP), "poster", items)
    tagRail(false)
end sub

' The actors, while the people behind the camera sit beside the poster
sub addCastRail()
    cards = []
    for each person in m.sectionData.cast
        cards.push({ imageUrl: detailImages.ItemImageUrl(person), name: chainLookupReturn(person, "json.Name", ""), role: personRole(person) })
    end for
    if cards.count() = 0 then return
    spec = { title: tr("Cast"), component: "NouveauPeopleCard", gap: STAGE_PERSON_GAP, cardSize: [STAGE_PERSON_WIDTH, STAGE_PERSON_AVATAR], stopsPerCard: 1, cards: cards }
    addRail(railSpec(spec, false, STAGE_PEOPLE_TITLE_GAP), "person", m.sectionData.cast)
    tagRail(false)
end sub

sub addExtrasRail()
    cards = []
    for each extra in m.sectionData.extras
        name = chainLookupReturn(extra, "json.Name", "")
        cards.push({ imageUrl: detailImages.CardImageUrl(extra, m.backdrop.uri), title: name, subtitle: extraSubtitle(extra), placeholder: name })
    end for
    if cards.count() = 0 then return
    spec = { title: tr("Extras"), component: "NouveauCaptionCard", gap: STAGE_EPISODE_GAP, cardSize: [STAGE_EXTRA_WIDTH, STAGE_EXTRA_HEIGHT], stopsPerCard: 1, cards: cards }
    addRail(railSpec(spec, false, STAGE_ROW_TITLE_GAP), "extra", m.sectionData.extras)
    tagRail(false)
end sub

' Rows run on to the edge of the screen, with the row titles the other clients draw
function railSpec(spec as object, beside as boolean, titleGap as integer) as object
    spec.viewport = railViewport(beside)
    spec.titleSize = STAGE_ROW_TITLE
    spec.titleRegular = true
    spec.titleGap = titleGap
    spec.textScale = STAGE_CARD_TEXT
    return spec
end function

' How far a row runs before it's cut off, which is the edge of the screen from wherever it starts
function railViewport(beside as boolean) as float
    if beside then return 1920 - m.besideX
    return 1920 - m.inset
end function

' The rail just added becomes a part of the page. Its key finds it again after a rebuild, when
' the rails above it may have changed.
sub tagRail(beside as boolean)
    index = m.rails.count() - 1
    rail = m.rails[index]
    rail.beside = beside
    rail.key = rail.kind + ":" + rail.node.findNode("railTitle").text
    m.pieces.push({ zone: "rail", rail: index, beside: beside })
end sub

' The season tabs over a rail of episodes. Beside the poster it's a show's own run, and under it an
' episode's, starting on that episode's season.
sub addEpisodes(beside as boolean)
    grouped = nouveauLayout.GroupEpisodesBySeason(m.sectionData.episodes)
    m.seasonNumbers = grouped.numbers
    m.seasonBuckets = grouped.buckets
    if m.seasonNumbers.count() = 0 then return

    arrivedIn = invalid
    if isEpisode()
        arrivedIn = nouveauLayout.SeasonOf(m.top.itemContent)
    else
        for each episode in m.sectionData.episodes
            if chainLookupReturn(episode, "id", "") = m.sectionData.nextUpId
                arrivedIn = nouveauLayout.SeasonOf(episode)
                exit for
            end if
        end for
    end if
    m.activeSeason = nouveauLayout.EffectiveSeason(m.seasonNumbers, m.pickedSeason, arrivedIn)

    viewport = railViewport(beside)
    if m.seasonNumbers.count() > 1
        tabs = []
        active = 0
        for each option in nouveauLayout.SeasonOptions(m.seasonNumbers, m.sectionData.seasons)
            if option.id = m.activeSeason.toStr() then active = tabs.count()
            tabs.push({ id: option.id, label: option.label })
        end for
        m.seasonBar.maxWidth = viewport
        m.seasonBar.escapeLeft = beside
        m.seasonBar.tabs = tabs
        m.seasonBar.expanded = false
        m.seasonBar.focusIndex = active
        m.seasonBar.selectedIndex = active
        m.seasonBar.visible = true
        m.pieces.push({ zone: "seasons", rail: -1, beside: beside })
    end if

    episodes = m.seasonBuckets[m.activeSeason.toStr()] ?? []
    currentId = ""
    if isEpisode() and isValid(m.top.itemContent) then currentId = m.top.itemContent.id
    ' An episode's own season opens the rail on it, and any other season at its start
    startIndex = 0
    cards = []
    for each episode in episodes
        json = episode.json
        isCurrent = currentId <> "" and isStringEqual(chainLookupReturn(json, "Id", ""), currentId)
        if isCurrent then startIndex = cards.count()
        cards.push({
            imageUrl: minimalistRules.CardUrl(json, m.episodeCard.width),
            title: chainLookupReturn(json, "Name", ""),
            ' invalid doesn't survive the trip into a node's field, so a card with no number says so
            number: chainLookupReturn(json, "IndexNumber", -1),
            watched: chainLookupReturn(json, "UserData.Played", false),
            current: isCurrent,
            posterLabels: episode.LookupCI("posterLabels") ?? []
        })
    end for

    card = m.episodeCard
    addRail({ title: "", component: "MinimalistEpisodeCard", gap: card.gap, cardSize: [card.width, card.height], stopsPerCard: 1, cards: cards, viewport: viewport, textScale: card.textScale, startIndex: startIndex }, "episode", episodes)
    tagRail(beside)
end sub

' A series that's only in Seerr has nothing to play yet, so its seasons are cards that open the
' request dialog
sub addSeerrSeasons()
    seasons = chainLookupReturn(m.seerrDetails, "seasons", invalid)
    if type(seasons) <> "roArray" or seasons.count() = 0 then return

    markers = {}
    if isSeerrAvailabilityBadgesEnabled() then markers = GetSeerrSeasonMarkers(m.seerrDetails)
    posterBase = GetTmdbImageBaseUrls().posterW342
    cards = []
    for each season in seasons
        number = season.seasonNumber ?? 0
        name = season.name ?? ""
        if name = "" then name = nouveauLayout.SeasonLabel(number)
        poster = ""
        if isValidAndNotEmpty(season.posterPath) then poster = posterBase + season.posterPath
        cards.push({ imageUrl: poster, title: name, subtitle: seerrSeasonNote(markers[number.toStr()], season.episodeCount), placeholder: name })
    end for

    spec = { title: tr("Seasons"), component: "NouveauCaptionCard", gap: STAGE_POSTER_CARD_GAP, cardSize: [STAGE_POSTER_CARD_WIDTH, STAGE_POSTER_CARD_HEIGHT], stopsPerCard: 1, cards: cards }
    addRail(railSpec(spec, true, STAGE_ROW_TITLE_GAP), "seerrSeason", seasons)
    tagRail(true)
end sub

' Where Seerr has got to with a season, or else how many episodes it has
function seerrSeasonNote(status as dynamic, episodeCount as dynamic) as string
    if status = 5 then return tr("Available")
    if status = 4 then return tr("Partially Available")
    if status = 3 then return tr("Requested")
    if status = 2 then return tr("Pending")
    if not isValid(episodeCount) or episodeCount <= 0 then return ""
    return episodeCount.toStr()
end function

' ===== Layout =====

sub layoutHero()
    m.layingOut = true
    placeColumns()
    layoutMetadataRow()
    hideEpisodeHeader()
    m.personMeta.visible = false
    y = 0

    if m.logoGroup.visible
        m.logoGroup.translation = [0, 0]
        y = m.logoImage.height
    else if m.titleNode.visible
        m.titleNode.translation = [0, 0]
        y = m.titleNode.boundingRect().height
    end if

    if m.stageSubtitle.visible
        y += STAGE_SUBTITLE_GAP
        m.stageSubtitle.translation = [0, y]
        y += m.stageSubtitle.boundingRect().height
    end if

    if m.metaRowHeight > 0
        y += STAGE_HERO_GAP
        m.metadataRow.translation = [0, y]
        y += m.metaRowHeight
    end if

    if isValid(m.incompleteLine) and m.incompleteLine.visible
        m.incompleteLine.width = m.besideWidth
        m.incompleteLine.wrap = true
        y += INCOMPLETE_LINE_GAP
        m.incompleteLine.translation = [0, y]
        y += m.incompleteLine.boundingRect().height
    end if

    if m.techRow.visible
        y += STAGE_HERO_GAP
        m.techRow.translation = [0, y]
        y += STAGE_TECH_CHIP_HEIGHT
    end if

    if m.ratingsRow.visible
        y += STAGE_HERO_GAP
        m.ratingsRow.translation = [0, y]
        y += m.ratingsRow.boundingRect().height
    end if

    if m.tagline.visible
        y += STAGE_TEXT_GAP
        m.tagline.translation = [0, y]
        y += m.tagline.height
    end if

    if m.overview.visible
        y += STAGE_TEXT_GAP
        m.overview.translation = [0, y]
        y += m.overview.boxHeight
    end if

    if showDownload()
        y += STAGE_TEXT_GAP
        m.downloadGroup.translation = [0, y]
        y += m.downloadHeight
    end if

    m.heroHeight = y
    m.layingOut = false
end sub

' What the file is, as outlined chips under the facts line the way the other clients draw them
sub buildStreamSummary(itemData as object)
    m.techChips.removeChildrenIndex(m.techChips.getChildCount(), 0)
    m.top.findNode("techSize").visible = false
    badges = []
    if mediaBadges.Enabled() then badges = mediaBadges.Build(itemData, m.top.selectedVideoStreamId)

    font = m.top.findNode("techChipFont").font
    x = 0
    for each badge in badges
        if not isValidAndNotEmpty(badge) then continue for
        chip = m.techChips.createChild("Group")
        border = chip.createChild("Poster")
        border.uri = "pkg:/images/details/outline8.9.png"
        border.loadDisplayMode = "scaleToFit"
        border.blendColor = m.techChip.border
        border.height = m.techChip.height

        text = chip.createChild("Label")
        text.font = font
        text.color = m.techChip.ink
        text.text = badge
        width = text.boundingRect().width + m.techChip.pad * 2
        text.height = m.techChip.height
        text.vertAlign = "center"
        text.translation = [m.techChip.pad, 0]
        border.width = width
        chip.translation = [x, 0]
        x += width + m.techChip.gap
    end for
    m.techRow.visible = m.techChips.getChildCount() > 0
end sub

' How far along Seerr's download of the title is, where it's fetching one, with the arr's reason
' under the bar when it's stuck. Sets m.downloadHeight to the room it all takes.
function showDownload() as boolean
    shown = SeerrDetailDownload(chainLookupReturn(m.seerrDetails, "mediaInfo", invalid), m.seerrArrQueue)
    m.downloadGroup.visible = isValid(shown)
    m.downloadHeight = STAGE_DOWNLOAD_HEIGHT
    if not isValid(shown) then return false

    ' Nothing is downloading yet, so one muted line takes the bar's place
    m.downloadTrack.visible = not shown.notFoundYet
    m.downloadFill.visible = not shown.notFoundYet
    m.downloadText.color = shown.notFoundYet ? m.downloadReason.color : m.downloadTextColor
    m.downloadReason.text = ""
    m.downloadReason.visible = false
    if shown.notFoundYet
        m.downloadText.text = tr("Not found yet")
        return true
    end if

    summary = shown.summary
    track = ""
    if shown.is4k then track = `${tr("4K")} ${fontApply.ThemeSeparator()} `
    ' The long form only where it fits over the bar
    m.downloadText.text = track + SeerrDownloadLabel(summary, true, fontApply.ThemeSeparator())
    if m.downloadText.boundingRect().width > STAGE_DOWNLOAD_WIDTH then m.downloadText.text = track + SeerrDownloadLabel(summary, false, fontApply.ThemeSeparator())
    m.downloadFill.width = Int(STAGE_DOWNLOAD_WIDTH * summary.fraction)
    m.downloadFill.color = SeerrDownloadBarColor(summary.state, "#00A4DC")

    if isValidStringValue(summary.reason)
        m.downloadReason.text = summary.reason
        m.downloadReason.visible = true
        m.downloadHeight = STAGE_DOWNLOAD_HEIGHT + STAGE_REASON_GAP + m.downloadReason.boundingRect().height
    end if
    return true
end function

' The poster column holds still, the column beside it follows the header down, and the full width
' rows start under whichever of the two ends lower
sub layoutPage()
    columnBottom = STAGE_TOP + m.posterHeight + STAGE_PLAY_GAP + buttonColumnHeight()
    y = STAGE_TOP + m.heroHeight
    below = false
    previous = ""

    for each piece in m.pieces
        ' The overview is drawn in the header, so it only notes where it sits for scrolling to
        if piece.zone = "overview"
            piece.top = STAGE_TOP + m.overview.translation[1]
            piece.bottom = piece.top + m.overview.boxHeight
            continue for
        end if

        x = m.besideX
        gap = STAGE_SECTION_GAP
        if not piece.beside
            x = m.inset
            gap = STAGE_ROW_GAP
            if not below
                below = true
                if columnBottom > y then y = columnBottom
            end if
        end if
        if previous = "seasons" then gap = STAGE_TAB_GAP
        y += gap

        piece.top = y
        y += placePiece(piece, x, y)
        piece.bottom = y
        previous = piece.zone
    end for

    if not below and columnBottom > y then y = columnBottom
    m.pageHeight = y + STAGE_PAGE_TAIL
end sub

function placePiece(piece as object, x as float, y as float) as float
    if piece.zone = "chips"
        m.trackChips.translation = [x, y]
        return m.trackChips.rowHeight
    else if piece.zone = "facts"
        m.factChips.translation = [x, y]
        return m.factChips.rowHeight
    else if piece.zone = "seasons"
        m.seasonBar.translation = [x, y]
        return STAGE_SEASON_BAR_HEIGHT
    else if piece.zone = "rail"
        node = m.rails[piece.rail].node
        node.translation = [x, y]
        return node.railHeight
    else if piece.zone = "seerr"
        m.seerrHeading.translation = [x, y]
        m.seerrTop = y + STAGE_HEADING_HEIGHT
        m.seerrBlock.translation = [x, m.seerrTop]
        return STAGE_HEADING_HEIGHT + m.seerrBlock.blockHeight
    end if
    return 0
end function

function buttonColumnHeight() as float
    count = m.buttonGroups.count()
    if count = 0 then return 0
    if not hasLead() then return STAGE_BUTTON_SIZE + STAGE_LABEL_ROOM
    if count = 1 then return STAGE_PLAY_HEIGHT
    return STAGE_PLAY_HEIGHT + STAGE_CIRCLE_GAP + STAGE_BUTTON_SIZE + STAGE_LABEL_ROOM
end function

sub applyBackdropTreatment()
    amount = getBackdropBlurAmount() / 25.0
    if amount > 1 then amount = 1
    if amount < 0 then amount = 0
    m.backdropScrim.opacity = STAGE_MIN_SCRIM + amount * STAGE_SCRIM_RANGE
    m.backdrop.visible = get_user_setting_bool("ui.itemdetail.showBackdrop", true)
    for each layer in [m.backdropVignette, m.backdropTopScrim, m.backdropBottomScrim, m.backdropLeftScrim]
        layer.visible = false
    end for
end sub

' The picture is blurred the way the Background Blur setting asks, by the server
function backdropRequestParams(params as object) as object
    amount = getBackdropBlurAmount()
    if amount > 0 then params.blur = amount
    return params
end function

sub onLogoImageURIChanged()
    hasLogo = isValidAndNotEmpty(m.top.logoImageURI)
    m.logoImage.width = m.logoBox[0]
    m.logoImage.height = m.logoBox[1]
    m.logoImage.uri = hasLogo ? m.top.logoImageURI : ""
    m.logoGroup.visible = hasLogo
    m.titleNode.visible = not hasLogo
    layoutContainer()
end sub

' A logo fitted to its box would sit centered in it, so the box shrinks to the logo and the logo
' sits flush left over the facts
sub onStageLogoLoaded()
    status = LCase(m.logoImage.loadStatus)
    if status = "failed"
        m.logoGroup.visible = false
        m.titleNode.visible = true
        layoutContainer()
        return
    end if
    if status <> "ready" or m.logoImage.bitmapWidth <= 0 or m.logoImage.bitmapHeight <= 0 then return

    scale = m.logoBox[0] / m.logoImage.bitmapWidth
    if m.logoImage.bitmapHeight * scale > m.logoBox[1] then scale = m.logoBox[1] / m.logoImage.bitmapHeight
    m.logoImage.width = Int(m.logoImage.bitmapWidth * scale)
    m.logoImage.height = Int(m.logoImage.bitmapHeight * scale)
    layoutContainer()
end sub

' ===== Scrolling =====

sub scrollContentTo(targetY as integer)
    if m.scrollAnim = invalid or m.scrollInterp = invalid or m.scrollableContent = invalid then return
    m.scrollAnim.control = "stop"
    m.scrollInterp.keyValue = [[0, m.currentScrollY], [0, targetY]]
    m.currentScrollY = targetY
    m.scrollAnim.control = "start"
    ' The nav would sit over the rows the viewer moved down to, so it only shows at the top
    showNav(targetY > STAGE_NAV_SHOWN)
end sub

sub showNav(shown as boolean)
    nav = getActiveNav(m.top.getScene())
    if not isValid(nav) or nav.isSubType("Sidebar") then return
    if nav.isVisible <> shown then nav.isVisible = shown
end sub

sub OnScreenHidden()
    if isValid(m.themeMusicPlayer) then m.themeMusicPlayer.callFunc("stopMusic")
    showNav(true)
end sub

sub ensureVisible(top as float, bottom as float)
    target = m.currentScrollY
    if top + target < STAGE_SCROLL_TOP
        target = STAGE_SCROLL_TOP - top
    else if bottom + target > 1080 - STAGE_SCROLL_BOTTOM
        target = 1080 - STAGE_SCROLL_BOTTOM - bottom
        if top + target < STAGE_SCROLL_TOP then target = STAGE_SCROLL_TOP - top
    end if

    if target > 0 then target = 0
    lowest = lowestScroll()
    if target < lowest then target = lowest
    if target <> m.currentScrollY then scrollContentTo(target)
end sub

' Season tabs and their rail are one section, so landing on either brings in both
sub revealPiece(index as integer)
    if index < 0 or index >= m.pieces.count() then return
    piece = m.pieces[index]
    top = piece.top
    bottom = piece.bottom
    if piece.zone = "seasons" and index + 1 < m.pieces.count() then bottom = m.pieces[index + 1].bottom
    if index > 0 and m.pieces[index - 1].zone = "seasons" then top = m.pieces[index - 1].top
    ensureVisible(top, bottom)
end sub

sub scrollToSeerrFocus()
    if not m.seerrBlock.visible then return
    offset = m.seerrBlock.focusedOffset
    top = m.seerrTop + offset
    ' The first stop brings the heading over the block with it
    if offset = 0 then top = m.seerrTop - STAGE_HEADING_HEIGHT
    ensureVisible(top, m.seerrTop + offset + 160)
end sub

' ===== Focus =====

' Every part of the page that takes focus, in the order it sits: the column beside the poster,
' then the rows under it
sub buildChain()
    for i = 0 to m.pieces.count() - 1
        m.pieces[i].index = i
    end for
    m.chain = m.pieces
end sub

function pieceIndex(entry as object) as integer
    if isValid(entry.index) then return entry.index
    for i = 0 to m.pieces.count() - 1
        if m.pieces[i].zone = entry.zone and m.pieces[i].rail = entry.rail then return i
    end for
    return -1
end function

function chipRow(zone as string) as object
    if zone = "facts" then return m.factChips
    return m.trackChips
end function

function chipChoices(zone as string) as object
    if zone = "facts" then return m.factChoices
    return m.trackChoices
end function

function focusChainStop(entry as object) as boolean
    if entry.zone = "buttons"
        if m.buttonGroups.count() = 0 then return false
        toActions()
        return true
    end if

    index = pieceIndex(entry)
    if index < 0 then return false

    if entry.zone = "overview"
        if not overviewCanScroll() then return false
        clearZoneFocus()
        m.overview.setFocus(true)
        holdFocus("overview", -1, m.overview)
    else if entry.zone = "chips" or entry.zone = "facts"
        if chipChoices(entry.zone).count() = 0 then return false
        row = chipRow(entry.zone)
        clearZoneFocus()
        row.focusIndex = 0
        row.setFocus(true)
        holdFocus(entry.zone, -1, row)
    else if entry.zone = "seasons"
        if not m.seasonBar.visible then return false
        clearZoneFocus()
        m.seasonBar.setFocus(true)
        holdFocus("seasons", -1, m.seasonBar)
    else if entry.zone = "rail"
        if entry.rail < 0 or entry.rail >= m.rails.count() then return false
        node = m.rails[entry.rail].node
        held = node.focusedStop
        if held < 0 then held = node.entryStop
        clearZoneFocus()
        if not node.callFunc("focusStop", held) then return false
        holdFocus("rail", entry.rail, node)
    else if entry.zone = "seerr"
        if not m.seerrBlock.visible then return false
        clearZoneFocus()
        if not m.seerrBlock.callFunc("focusFirst") then return false
        ' The block reports where its focus went, which scrolls it into view
        holdFocus("seerr", -1, m.seerrBlock)
        return true
    else if entry.zone = "section"
        ' A part with nothing in it to press holds the remote itself
        clearZoneFocus()
        entry.node.setFocus(true)
        holdFocus("section", entry.rail, entry.node)
    else
        return false
    end if

    revealPiece(index)
    return true
end function

sub holdFocus(zone as string, rail as integer, node as object)
    m.focusZone = zone
    m.focusRail = rail
    m.top.lastFocus = node
    setLastFocus(node)
end sub

sub clearZoneFocus()
    if m.focusZone = "rail" and m.focusRail >= 0 and m.focusRail < m.rails.count()
        m.rails[m.focusRail].node.callFunc("clearFocus")
    else if m.focusZone = "chips" or m.focusZone = "facts"
        chipRow(m.focusZone).focusIndex = -1
    else if m.focusZone = "buttons"
        unhighlightAllButtons()
    end if
end sub

' Rows fill in behind the first paint, so whatever had the remote is put back where it was
sub restoreStageFocus(held as object)
    if held.zone = "rail"
        for i = 0 to m.rails.count() - 1
            node = m.rails[i].node
            if m.rails[i].key = held.key
                stopIndex = held.stop
                if stopIndex < 0 then stopIndex = node.entryStop
                if stopIndex > node.stopCount - 1 then stopIndex = node.stopCount - 1
                if stopIndex < 0 then stopIndex = 0
                if node.callFunc("focusStop", stopIndex)
                    holdFocus("rail", i, node)
                    revealPiece(pieceIndex({ zone: "rail", rail: i }))
                    return
                end if
            end if
        end for
    else if held.zone = "chips" or held.zone = "facts"
        count = chipChoices(held.zone).count()
        if count > 0
            row = chipRow(held.zone)
            if row.focusIndex > count - 1 then row.focusIndex = count - 1
            return
        end if
    else if held.zone = "seasons" and m.seasonBar.visible
        m.seasonBar.setFocus(true)
        return
    else if held.zone = "overview" and overviewCanScroll()
        return
    else if held.zone = "seerr" and m.seerrBlock.visible
        if m.seerrBlock.callFunc("focusFirst") then return
    end if

    ' What it was on has gone, so the buttons that are always there take it
    if held.zone <> "buttons" then toActions()
end sub

' Back to Play, with the page at its top
sub toActions()
    if m.buttonGroups.count() = 0 then return
    clearZoneFocus()
    m.focusZone = "buttons"
    m.focusRail = -1
    focusButton(0)
    if m.currentScrollY <> 0 then scrollContentTo(0)
end sub

' The screen isn't in the scene yet while init runs
function sidebarShown() as boolean
    scene = m.top.getScene()
    if not isValid(scene) then return false
    sidebar = scene.findNode("sidebar")
    return isValid(sidebar) and sidebar.visible
end function

' Up off the top of the page reaches a nav along the top. Coming back down lands on Play.
function focusTopNav() as boolean
    if sidebarShown() then return true

    if m.buttonGroups.count() > 0
        clearZoneFocus()
        m.focusZone = "buttons"
        m.focusRail = -1
        m.currentButtonIndex = 0
        m.top.lastFocus = m.buttonGroups[0]
        unhighlightAllButtons()
    end if
    if m.currentScrollY <> 0 then scrollContentTo(0)
    return FocusOverhang(m.top)
end function

' The top of the column beside the poster sits level with the poster, so Up from it goes to the nav
' when the nav runs along the top, and back to Play beside a sidebar
function stopUp() as boolean
    if moveChain(-1) then return true

    index = currentChainIndex()
    if index >= 0 and m.chain[index].beside and not sidebarShown() then return focusTopNav()
    toActions()
    return true
end function

function focusFirstBeside() as boolean
    for each entry in m.chain
        if entry.beside and focusChainStop(entry) then return true
    end for
    return false
end function

' Down from the buttons skips the column beside them, which is reached by going right
function focusBelowButtons() as boolean
    for each entry in m.chain
        if not entry.beside and focusChainStop(entry) then return true
    end for
    return focusFirstBeside()
end function

' A refresh builds the row again, and only takes focus back to it when the viewer was on it
sub focusFirstButton()
    if m.focusZone <> "buttons" or m.buttonGroups.count() = 0 then return
    m.buttonGroups[0].setFocus(true)
    highlightButton(0)
end sub

' A Seerr dialog opened from a season card hands focus back to that card's rail
function seerrFocusTarget() as object
    if m.focusZone = "rail" and m.focusRail >= 0 and m.focusRail < m.rails.count() then return m.rails[m.focusRail].node
    if m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count() then return m.buttonGroups[m.currentButtonIndex]
    return m.top
end function

' A chip opens its picker, and the chip shows the new pick once it closes
sub restoreFocusToButtons()
    if isValid(openTrackPicker()) then return

    if m.focusZone = "chips"
        m.trackChoices = trackChoices(m.top.itemContent.json)
        showChips(m.trackChips, m.trackChoices)
        layoutContainer()
        m.trackChips.setFocus(true)
        m.top.lastFocus = m.trackChips
        setLastFocus(m.trackChips)
        return
    end if

    if m.buttonGroups.count() > 0 and m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count()
        m.buttonGroups[m.currentButtonIndex].setFocus(true)
        m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
        setLastFocus(m.buttonGroups[m.currentButtonIndex])
    end if
end sub

' ===== Buttons =====

' The pickers are chips beside the poster here, so they stay out of the row. Play, or Request on a
' title that's only in Seerr, spans the poster, and the rest are circles that name themselves
' under them when focused.
sub appendButtonNode(config as object)
    if config.id = "audioTrackButton" or config.id = "subtitleButton" or config.id = "versionButton" then return

    ' A wide Play has room to say where Resume picks up on one line
    if m.buttonGroups.count() = 0 and config.id = "resumeButton" and isValidAndNotEmpty(config.detail)
        config.label = tr("Resume from ") + config.detail
        config.detail = ""
    end if

    buttonGroup = detailButtons.createModernButton(config, m.buttonGroups.count())
    if m.buttonGroups.count() = 0 and (buttonGroup.primary or m.top.seerrOnly)
        buttonGroup.spanWidth = leadSpan(buttonGroup)
        buttonGroup.leading = true
        buttonGroup.scale = [STAGE_PLAY_SCALE, STAGE_PLAY_SCALE]
    else
        buttonGroup.labelBelow = true
        buttonGroup.scale = [STAGE_CIRCLE_SCALE, STAGE_CIRCLE_SCALE]
    end if
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    m.buttonRow.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

' Play spans the poster, in the units the button draws in before it's scaled up
function leadSpan(_button as object) as float
    return STAGE_POSTER_WIDTH / STAGE_PLAY_SCALE
end function

function hasLead() as boolean
    return m.buttonGroups.count() > 0 and m.buttonGroups[0].spanWidth > 0
end function

sub commitButtonRow()
    split = buttonLayout.CountSplit(m.buttonGroups.count(), buttonCap())
    if split.needsOverflow
        ' Resume and Restart both stay in the row, the way every style keeps them
        keep = split.visibleCount
        if keep < 2 and m.buttonGroups.count() > 1 and m.buttonGroups[1].id = "restartButton" then keep = 2
        foldButtonsIntoMenu(keep)
    end if

    if m.currentButtonIndex >= m.buttonGroups.count() then m.currentButtonIndex = 0
    layoutButtonRow(m.currentButtonIndex)
end sub

' Play, three circles and More are what fit under the poster, so that's the most this style shows
' whatever the button limit says
function buttonCap() as object
    cap = { maxVisible: STAGE_MAX_BUTTONS, overflowAsMenu: true, countCapped: true }
    limit = viewerButtonLimit()
    if limit > 0 and limit + 1 < STAGE_MAX_BUTTONS then cap.maxVisible = limit + 1
    if kidsMode.Enabled() then cap = { maxVisible: STAGE_KIDS_MAX_BUTTONS, overflowAsMenu: false, countCapped: true }
    return cap
end function

sub layoutButtonRow(_focusIndex as integer)
    x = 0
    y = 0
    for i = 0 to m.buttonGroups.count() - 1
        button = m.buttonGroups[i]
        if i = 0 and button.spanWidth > 0
            button.translation = [0, 0]
            y = STAGE_PLAY_HEIGHT + STAGE_CIRCLE_GAP
        else
            button.translation = [x, y]
            x += STAGE_BUTTON_SIZE + STAGE_CIRCLE_SPACING
        end if
    end for
end sub

' ===== Keys =====

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A picker left open across a screensaver can come back without focus, which would leave this
    ' screen answering the remote from behind it
    picker = openTrackPicker()
    if isValid(picker)
        picker.setFocus(true)
        return true
    end if
    if m.overflowMenu.visible then return false

    if key = KeyCode.OPTIONS and m.focusZone = "rail" and m.focusRail >= 0 and m.focusRail < m.rails.count()
        rail = m.rails[m.focusRail]
        if rail.kind <> "poster" and rail.kind <> "episode" then return false
        index = rail.node.callFunc("cardIndexForStop", rail.node.focusedStop)
        if index < 0 or index >= rail.items.count() then return false
        return showItemMenu(rail.items[index], itemMenuPageOptions())
    end if

    if m.focusZone = "buttons"
        if buttonKey(key) then return true
    else if m.focusZone = "overview"
        ' The box itself takes OK, Back while open, and Up and Down while there's more to page through
        if key = KeyCode.UP then return stopUp()
        if key = KeyCode.DOWN then return moveDown()
        if key = KeyCode.LEFT
            toActions()
            return true
        end if
    else if m.focusZone = "chips" or m.focusZone = "facts"
        if chipKey(key) then return true
    else if m.focusZone = "rail"
        if railKey(key) then return true
    else if m.focusZone = "seerr"
        ' The block walks its own stops and only turns down a press at its edges
        if key = KeyCode.UP then return stopUp()
        if key = KeyCode.DOWN then return moveDown()
        if key = KeyCode.LEFT then return FocusSidebar(m.top)
    else if m.focusZone = "section"
        ' A part with nothing in it to press only moves up and down the page
        if key = KeyCode.UP then return stopUp()
        if key = KeyCode.DOWN then return moveDown()
        if key = KeyCode.LEFT or key = KeyCode.RIGHT then return true
    end if

    if key = KeyCode.BACK
        ' Back walks the page up before it leaves it
        if m.currentScrollY < 0
            toActions()
            return true
        end if
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

function buttonKey(key as string) as boolean
    index = m.currentButtonIndex
    last = m.buttonGroups.count() - 1
    if key = KeyCode.OK
        handleButtonSelect()
        return true
    end if

    ' Play sits over the circles, so Right leaves for the column beside the poster and Down drops
    ' to the circles
    if index = 0 and hasLead()
        if key = KeyCode.RIGHT
            if not focusFirstBeside() and last > 0 then focusButton(1)
        else if key = KeyCode.DOWN
            if last > 0
                focusButton(1)
            else
                focusBelowButtons()
            end if
        else if key = KeyCode.UP
            focusTopNav()
        else if key = KeyCode.LEFT
            if FocusSidebar(m.top) then unhighlightAllButtons()
        else
            return false
        end if
        return true
    end if

    if key = KeyCode.LEFT
        if index > 0
            focusButton(index - 1)
        else if FocusSidebar(m.top)
            unhighlightAllButtons()
        end if
    else if key = KeyCode.RIGHT
        if index < last
            focusButton(index + 1)
        else
            focusFirstBeside()
        end if
    else if key = KeyCode.UP
        if hasLead()
            focusButton(0)
        else
            focusTopNav()
        end if
    else if key = KeyCode.DOWN
        focusBelowButtons()
    else
        return false
    end if
    return true
end function

function chipKey(key as string) as boolean
    row = chipRow(m.focusZone)
    index = row.focusIndex
    if key = KeyCode.LEFT
        if index > 0
            row.focusIndex = index - 1
        else
            toActions()
        end if
        return true
    else if key = KeyCode.RIGHT
        if index < chipChoices(m.focusZone).count() - 1 then row.focusIndex = index + 1
        return true
    else if key = KeyCode.UP
        return stopUp()
    else if key = KeyCode.DOWN
        return moveDown()
    else if key = KeyCode.OK
        chipChosen(index)
        return true
    end if
    return false
end function

sub chipChosen(index as integer)
    choices = chipChoices(m.focusZone)
    if index < 0 or index >= choices.count() then return
    choice = choices[index]

    if m.focusZone = "chips"
        runButtonAction(choice.action)
    else if isValid(choice.person)
        m.top.selectedItem = choice.person
    else if isValidAndNotEmpty(choice.studio.id)
        m.top.studioSelected = { id: choice.studio.id, name: choice.studio.name, libraryId: chainLookupReturn(m.top.itemContent, "json.ParentId", "") }
    end if
end sub

' Left off the first card of a rail beside the poster goes back to Play, so it never scrolls over it
function railKey(key as string) as boolean
    if m.focusRail < 0 or m.focusRail >= m.rails.count() then return false
    rail = m.rails[m.focusRail]
    stopIndex = rail.node.focusedStop

    if key = KeyCode.LEFT
        if stopIndex > 0
            rail.node.callFunc("focusStop", stopIndex - 1)
            return true
        end if
        if rail.beside = true
            toActions()
            return true
        end if
        return FocusSidebar(m.top)
    else if key = KeyCode.RIGHT
        if stopIndex < rail.node.stopCount - 1 then rail.node.callFunc("focusStop", stopIndex + 1)
        return true
    else if key = KeyCode.UP
        return stopUp()
    else if key = KeyCode.DOWN
        return moveDown()
    else if key = KeyCode.OK
        selectRailItem()
        return true
    end if
    return false
end function

sub onSeasonBarEscape()
    direction = m.seasonBar.escape
    if direction = "up"
        stopUp()
    else if direction = "down"
        moveDown()
    else if direction = "left"
        toActions()
    end if
end sub

sub selectRailItem()
    if m.focusRail < 0 or m.focusRail >= m.rails.count() then return
    rail = m.rails[m.focusRail]
    index = rail.node.callFunc("cardIndexForStop", rail.node.focusedStop)
    if index < 0 or index >= rail.items.count() then return
    item = rail.items[index]

    if rail.kind = "episode"
        ' The episode already on screen plays rather than opening its own page again
        if picksItemOnScreen(item)
            playItemOnScreen()
        else
            m.top.selectedItem = item
        end if
    else if rail.kind = "seerrSeason"
        startSeerrRequest("seerrRequest")
    else if rail.kind = "poster" and isSeerrCard(item)
        ShowSeerrDetails(item)
    else
        m.top.selectedItem = item
    end if
end sub

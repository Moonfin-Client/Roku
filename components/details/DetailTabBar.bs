import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeChrome.bs"

sub init()
    m.barBg = m.top.findNode("barBg")
    m.focusPill = m.top.findNode("focusPill")
    m.focusRing = m.top.findNode("focusRing")
    m.labelRow = m.top.findNode("labelRow")
    m.pillAnim = m.top.findNode("pillAnim")
    m.pillPosInterp = m.top.findNode("pillPosInterp")
    m.pillWidthInterp = m.top.findNode("pillWidthInterp")
    m.labels = []
    m.tabX = []
    m.tabW = []
    m.scrollX = 0

    m.tabFont = m.top.findNode("tabFont").font
    m.top.observeField("focusedChild", "onFocusChanged")
    themeApply.ApplyToItem(m.top)
end sub

sub onTabsChanged()
    m.labelRow.removeChildrenIndex(m.labelRow.getChildCount(), 0)
    m.labels = []
    m.tabX = []
    m.tabW = []

    tabs = m.top.tabs
    if not isValidAndNotEmpty(tabs) then return

    m.barHeight = m.top.segmentHeight
    m.tabPadX = m.top.segmentPadX
    m.barPad = m.top.barPad
    m.tabFont.size = fontApply.ThemeTextSize(m.top.textSize)

    for each tabDef in tabs
        label = CreateObject("roSGNode", "Label")
        label.font = m.tabFont
        label.text = tabDef.label
        label.vertAlign = "center"
        label.horizAlign = "center"
        label.height = m.barHeight
        m.labelRow.appendChild(label)
        m.labels.push(label)
    end for

    ' A theme swaps in a wider font, so the tabs are measured only once the font
    ' they will actually be drawn in is in place. Measuring first left the longer
    ' labels trimmed to an ellipsis.
    fontApply.ApplyThemeFonts(m.labelRow)

    x = m.barPad
    for each label in m.labels
        width = label.boundingRect().width
        if width <= 0 then width = Len(label.text) * 15
        regionW = width + m.tabPadX * 2

        label.width = regionW
        label.translation = [x, m.barPad]
        m.tabX.push(x)
        m.tabW.push(regionW)
        x += regionW
    end for

    m.scrollX = 0
    m.labelRow.translation = [0, 0]

    m.barBg.width = x + m.barPad
    m.barBg.height = m.barHeight + m.barPad * 2

    ' A bar given a width it has to live inside keeps every tab and slides instead, so a set
    ' too wide for the room is still all reachable
    if m.top.maxWidth > 0 and m.barBg.width > m.top.maxWidth
        m.barBg.width = m.top.maxWidth
    end if
    ' A clip of no size clips everything away rather than nothing, so the bar always names a
    ' rectangle and simply makes it its own size when there is nothing to hold back
    m.top.clippingRect = [0, 0, m.barBg.width, m.barBg.height]

    if m.top.focusIndex >= tabs.count() then m.top.focusIndex = 0
    updateHighlight()
end sub

' Only the focused tab stands out, on the thumb the other clients slide along
' the track. Every other tab stays muted, including the one whose content is
' showing.
sub updateHighlight()
    hasFocus = m.top.isInFocusChain()

    ' The thumb says which tab is open and the ring says where the remote is. Where focus
    ' follows selection the two sit on the same tab, and where it does not the bar has to show
    ' both or there is nothing to say which tab the content below belongs to.
    opened = m.top.selectedIndex
    if opened < 0 or opened >= m.tabX.count()
        opened = hasFocus ? m.top.focusIndex : -1
    end if

    ' The picked tab stays in view when the bar opens or the pick changes without focus
    if hasFocus
        slideToTab(m.top.focusIndex)
    else if opened >= 0
        slideToTab(opened)
    end if

    for i = 0 to m.labels.count() - 1
        lit = i = opened or (hasFocus and i = m.top.focusIndex)
        m.labels[i].color = lit ? "#FFFFFF" : "#FFFFFFBF"
    end for

    if opened >= 0 and opened < m.tabX.count()
        moveFocusPill(opened)
        m.focusPill.opacity = hasFocus ? 0.22 : 0.12
    else
        m.focusPill.visible = false
    end if

    if hasFocus and m.top.focusIndex >= 0 and m.top.focusIndex < m.tabX.count()
        moveFocusRing(m.top.focusIndex)
    else
        m.focusRing.visible = false
    end if

    themeApply.ApplyToItem(m.top)
end sub

' The bar slides only far enough to keep the tab being walked to inside the room it has
sub slideToTab(index as integer)
    if m.top.maxWidth <= 0 then return
    if index < 0 or index >= m.tabX.count() then return

    left = m.tabX[index] + m.scrollX
    right = left + m.tabW[index]

    if left < m.barPad
        m.scrollX += m.barPad - left
    else if right > m.top.maxWidth - m.barPad
        m.scrollX -= right - (m.top.maxWidth - m.barPad)
    end if

    if m.scrollX > 0 then m.scrollX = 0
    m.labelRow.translation = [m.scrollX, 0]
end sub

sub moveFocusRing(index as integer)
    m.focusRing.translation = [m.tabX[index] + m.scrollX, m.barPad]
    m.focusRing.width = m.tabW[index]
    m.focusRing.height = m.barHeight
    m.focusRing.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")
    m.focusRing.visible = true
end sub

sub moveFocusPill(index as integer)
    targetX = m.tabX[index] + m.scrollX
    targetW = m.tabW[index]

    if not m.focusPill.visible
        m.focusPill.translation = [targetX, m.barPad]
        m.focusPill.width = targetW
        m.focusPill.height = m.barHeight
        m.focusPill.visible = true
    else
        m.pillPosInterp.keyValue = [m.focusPill.translation, [targetX, m.barPad]]
        m.pillWidthInterp.keyValue = [m.focusPill.width, targetW]
        m.pillAnim.control = "start"
    end if
end sub

sub onFocusChanged()
    updateHighlight()
end sub

sub focusTab(index as integer)
    if index < 0 or index >= m.labels.count() then return
    m.top.focusIndex = index
    if m.top.expanded then m.top.selectedIndex = index
    updateHighlight()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "right"
        if m.top.focusIndex >= m.labels.count() - 1
            if m.top.escapeRight then m.top.escape = key
            return true
        end if
        focusTab(m.top.focusIndex + 1)
        return true
    else if key = "left"
        if m.top.focusIndex <= 0
            if m.top.escapeLeft
                m.top.escape = key
                return true
            end if
            return FocusSidebar(m.top)
        end if
        focusTab(m.top.focusIndex - 1)
        return true
    else if key = "OK"
        ' With Expanded Tabs off, pressing OK on the open tab collapses it.
        if not m.top.expanded and m.top.selectedIndex = m.top.focusIndex
            m.top.selectedIndex = -1
        else
            m.top.selectedIndex = m.top.focusIndex
        end if
        m.top.activated = m.top.focusIndex
        return true
    else if key = "up" or key = "down"
        m.top.escape = key
        return true
    end if

    return false
end function

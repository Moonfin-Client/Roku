<?xml version="1.0" encoding="utf-8"?>
<component name="DetailFileInfo" extends="Group">
    <children>
        <Label id="heading" font="font:SmallBoldSystemFont" color="#FFFFFF" />
        <Group id="body" />
        <!-- Never shown, they lend their fonts to the rows built at runtime -->
        <Label id="nameFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="metaFont" font="font:SmallestSystemFont" visible="false" />
        <Label id="rowFont" font="font:SmallSystemFont" visible="false" />
        <Label id="rowBoldFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="linkFont" font="font:SmallestBoldSystemFont" visible="false" />
        <Label id="hintFont" font="font:SmallestSystemFont" visible="false" />
    </children>
    <interface>
        <!-- How far down the block the focused row sits, so the page can scroll it into view -->
        <field id="focusedOffset" type="integer" value="0" alwaysNotify="true" />
        <field id="retryRequested" type="boolean" alwaysNotify="true" />
        <function name="setContent" />
        <function name="setDirectPlay" />
        <function name="focusFirst" />
        <function name="clearFocus" />
    </interface>
</component>

' The classic action row, in the pixels detailButtons draws it
const CLASSIC_ROW_WIDTH = 1728
const CLASSIC_BUTTON_WIDTH = 157
const CLASSIC_BUTTON_GAP = 12

' The classic screen is laid out in the pixels the other clients lay it out in.
' Small text runs a little larger, since the Roku system font draws smaller than
' a browser does at the same size
const CLASSIC_TITLE_SIZE = 46
const CLASSIC_SERIES_NAME_SIZE = 26
const CLASSIC_PILL_TEXT_SIZE = 19
const CLASSIC_INFO_TEXT_SIZE = 24
const CLASSIC_BADGE_TEXT_SIZE = 19
const CLASSIC_METADATA_LABEL_SIZE = 18
const CLASSIC_METADATA_VALUE_SIZE = 23

const CLASSIC_LOGO_HEIGHT = 116
const CLASSIC_CODEC_GAP = 8
const CLASSIC_CONTENT_LEFT = 96
const CLASSIC_CONTENT_WIDTH = 1728
' Kept clear of the artwork on the right, which is a wide thumbnail on an episode
' rather than a poster
const CLASSIC_OVERVIEW_WIDTH = 1290
const CLASSIC_SEPARATOR_MARGIN = 7
const CLASSIC_PILL_PAD_X = 14
const CLASSIC_PILL_PAD_Y = 4
const CLASSIC_PILL_GAP = 12
const CLASSIC_INFO_ROW_HEIGHT = 34
const CLASSIC_CONTAINER_TOP = 130
' Each badge is an outline rather than a filled chip
const CLASSIC_BADGE_PAD_H = 12
const CLASSIC_BADGE_PAD_V = 4
const CLASSIC_BADGE_BORDER = "0xFFFFFF4D"
const CLASSIC_BADGE_INK = "0xFFFFFFCC"
' Each extras row is as tall as the row list makes them
const EXTRAS_ROW_HEIGHT = 425
const CLASSIC_BADGE_PAD_X = 11
const CLASSIC_BADGE_PAD_Y = 4
const CLASSIC_CELL_PAD_X = 20
const CLASSIC_CELL_PAD_Y = 14
const CLASSIC_CELL_GAP = 4

sub init()
    m.top.observeField("seerrButtonsStale", "onSeerrButtonsStale")
    m.global.queueManager.callFunc("setForceTranscode", PlaybackMethod.PLAYNORMALLY)
    m.performRotationCheck = true

    m.container = m.top.findNode("container")
    m.scrollableContent = m.top.findNode("scrollableContent")
    m.extrasGrid = m.top.findNode("extrasGrid")
    m.scrollAnim = m.top.findNode("scrollAnimation")
    m.scrollInterp = m.top.findNode("scrollInterpolator")
    m.currentScrollY = 0

    if m.extrasGrid <> invalid
        m.extrasGrid.observeField("itemFocused", "onExtrasRowChanged")
        m.extrasGrid.observeField("rowItemSize", "onExtrasRowsLoaded")
    end if

    m.seerrBlock = m.top.findNode("seerrBlock")
    if isValid(m.seerrBlock)
        m.seerrBlock.observeField("hasContent", "onSeerrBlockChanged")
        m.seerrBlock.observeField("focusedOffset", "onSeerrFocusMoved")
    end if

    m.top.optionsAvailable = false

    m.trackData = {}
    m.currentCodec = ""
    m.versionSelector = m.top.findNode("versionSelector")
    m.audioSelector = m.top.findNode("audioSelector")
    m.subtitleSelector = m.top.findNode("subtitleSelector")
    m.subtitleDownloadDialog = m.top.findNode("subtitleDownloadDialog")

    m.favoriteTask = m.top.findNode("favoriteTask")
    m.playstateTask = m.top.findNode("playstateTask")

    m.posterImage = m.top.findNode("posterImage")
    m.playedIndicator = m.top.findNode("playedIndicator")
    m.genresColumn = m.top.findNode("genresColumn")
    m.directorColumn = m.top.findNode("directorColumn")
    m.writersColumn = m.top.findNode("writersColumn")
    m.studioColumn = m.top.findNode("studioColumn")
    m.logoImage = m.top.findNode("logoImage")
    m.logoGroup = m.top.findNode("logoGroup")
    m.logoShadow = m.top.findNode("logoShadow")
    m.titleNode = m.top.findNode("title")
    m.overview = m.top.findNode("overview")
    m.overview.maxWidth = CLASSIC_OVERVIEW_WIDTH
    ' Opening the overview changes how much room it takes, so what sits under it
    ' moves down to make way
    m.overview.observeField("boxHeight", "onOverviewHeightChanged")

    m.buttonRow = m.top.findNode("buttonRow")
    m.buttonRowExtra = m.top.findNode("buttonRowExtra")
    m.buttonConfigs = []
    m.primaryCount = 0
    m.actionsExpanded = false
    m.currentButtonIndex = 0
    m.buttonGroups = []

    m.loadStatus = ViewLoadStatus.INIT
    m.global.queueManager.callFunc("setLastKnownItemID", string.empty)

    ' Shuffle task for series
    m.getShuffleEpisodesTask = createObject("roSGNode", "getShuffleEpisodesTask")

    m.top.observeField("itemContent", "itemContentChanged")

    m.audioSelector.observeField("audioStreamIndex", "onAudioStreamIndexChanged")
    m.subtitleSelector.observeField("subtitleStream", "onSubtitleStreamChanged")
    m.audioSelector.observeField("visible", "onAudioSelectorVisibleChanged")
    m.subtitleSelector.observeField("visible", "onSubtitleSelectorVisibleChanged")
    m.subtitleSelector.observeField("downloadRequested", "onSubtitleDownloadRequested")
    m.subtitleDownloadDialog.observeField("visible", "onSubtitleDownloadDialogVisibleChanged")
    m.versionSelector.observeField("videoStreamId", "onVersionSelected")
    m.versionSelector.observeField("visible", "onVersionSelectorVisibleChanged")

    m.themeMusicPlayer = m.top.findNode("themeMusicPlayer")

    m.posterMask = m.top.findNode("posterMask")

    ' Show title by default (logo replaces it when available)
    m.titleNode.visible = true

    sizeClassicFonts()
end sub

sub sizeClassicFonts()
    infoSize = fontApply.ThemeTextSize(CLASSIC_INFO_TEXT_SIZE)
    badgeSize = fontApply.ThemeTextSize(CLASSIC_BADGE_TEXT_SIZE)
    cellLabelSize = fontApply.ThemeTextSize(CLASSIC_METADATA_LABEL_SIZE)
    cellValueSize = fontApply.ThemeTextSize(CLASSIC_METADATA_VALUE_SIZE)

    for each id in ["releaseYear", "officialRating", "seasonCount", "runtime", "endsAt", "communityRating", "criticRating", "metaGenres", "tagline"]
        node = m.top.findNode(id)
        if isValid(node) then node.font.size = infoSize
    end for

    for each id in ["dot1", "dot3", "dot4", "dot5", "dot6", "dot7", "dot8", "dot9", "dot10"]
        dot = m.top.findNode(id)
        if isValid(dot)
            dot.font.size = infoSize
            dot.text = "•"
        end if
    end for

    statusText = m.top.findNode("statusBadgeText")
    if isValid(statusText) then statusText.font.size = badgeSize
    upcomingText = m.top.findNode("upcomingBadgeText")
    if isValid(upcomingText) then upcomingText.font.size = badgeSize

    badgeFont = m.top.findNode("codecBadgeFont")
    if isValid(badgeFont) then badgeFont.font.size = badgeSize

    ' Ratings read at the same size as the badges beside them
    ratingsRow = m.top.findNode("ratingsRow")
    if isValid(ratingsRow)
        ratingsRow.valueSize = badgeSize
        ratingsRow.nameSize = badgeSize
    end if

    for each id in ["genresHeader", "directorHeader", "writersHeader", "studioHeader"]
        node = m.top.findNode(id)
        if isValid(node) then node.font.size = cellLabelSize
    end for

    for each id in ["genres", "director", "writers", "studio"]
        node = m.top.findNode(id)
        if isValid(node) then node.font.size = cellValueSize
    end for

    m.top.findNode("seriesName").font.size = fontApply.ThemeTextSize(CLASSIC_SERIES_NAME_SIZE)
    m.top.findNode("episodePillText").font.size = fontApply.ThemeTextSize(CLASSIC_PILL_TEXT_SIZE)
    m.titleNode.font.size = CLASSIC_TITLE_SIZE
end sub

' ============================================
' Content changed handler
' ============================================

sub itemContentChanged()
    item = m.top.itemContent

    if isValid(m.extrasGrid)
        if isEpisode()
            m.extrasGrid.seasonID = item.seasonID
            m.extrasGrid.showID = item.showID
            m.extrasGrid.episodeID = item.id
        else if isSeries()
            m.extrasGrid.showID = item.id
        end if
    end if

    if not isChainValid(item, "json")
        if m.buttonRow <> invalid then m.buttonRow.visible = true
        stopLoadingSpinner()
        return
    end if

    itemData = item.json
    m.top.id = itemData.id

    loadSeerrBlock(itemData)

    if isValid(m.themeMusicPlayer) and not m.top.seerrOnly
        m.themeMusicPlayer.itemId = itemData.id
    end if

    playTextNode = m.top.findNode("playText")
    if isValid(playTextNode)
        playTextNode.text = tr("Play")
    end if

    m.top.trailerAvailable = isValidAndNotEmpty(itemData.RemoteTrailers) or isValidAndNotEmpty(itemData.LocalTrailerCount)

    updateButtonVisibility(itemData)

    if m.loadStatus = ViewLoadStatus.RELOAD
        return
    end if

    setBackdropImage(itemData)

    if not isSeries() and m.top.selectedVideoStreamId = "" and isValidAndNotEmpty(itemData.MediaSources)
        SetCurrentVideoCodec(itemData)
        m.top.selectedVideoStreamId = itemData.MediaSources[0].id
    end if

    if not isSeries()
        SetDefaultAudioTrack(itemData)
    end if

    setFieldText("releaseYear", "")
    setFieldText("officialRating", "")
    setFieldText("tagline", "")
    setFieldText("runtime", "")
    setFieldText("endsAt", "")
    setFieldText("seasonCount", "")
    setFieldText("criticRating", "")
    statusBadgeNode = m.top.findNode("statusBadge")
    if isValid(statusBadgeNode) then statusBadgeNode.visible = false
    upcomingBadgeNode = m.top.findNode("upcomingBadge")
    if isValid(upcomingBadgeNode) then upcomingBadgeNode.visible = false

    setPosterImage(itemData)

    if isEpisode()
        populateEpisodeMetadata(itemData, item)
    else if isSeries()
        populateSeriesMetadata(itemData)
    else
        populateMovieMetadata(itemData)
    end if

    populateRatings(itemData)
    fetchMDBListRatings(itemData)
    populateGenres(itemData)
    populateDirectors(itemData)
    populateWriters(itemData)
    populateStudio(itemData)
    updateColumnDividers()
    updateStatusBadge(itemData)
    updateUpcomingBadge(itemData)
    populateRuntime(itemData)

    setFieldText("title", itemData.name)

    hideMediaDesc = moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.hideMediaDescription`", false), false) and (isEpisode() or LCase(m.top.itemType) = "movie")

    taglineNode = m.top.findNode("tagline")
    if isValid(taglineNode)
        taglineNode.visible = not hideMediaDesc and isValidAndNotEmpty(taglineNode.text)
    end if

    overviewNode = m.top.findNode("overview")
    overviewText = itemData.overview
    if isValidAndNotEmpty(overviewText)
        overviewText = stripHtmlTags(overviewText)
    end if
    setFieldText("overview", overviewText)
    if isValid(overviewNode)
        overviewNode.visible = not hideMediaDesc and isValidAndNotEmpty(overviewText)
    end if

    if not isSeries()
        SetUpVideoOptions(itemData.mediaSources)
        SetUpAudioOptions(itemData.mediaStreams)
    end if

    if m.buttonRow <> invalid then m.buttonRow.visible = true

    ' Layout everything now that all content is populated
    layoutMetadataRow()
    layoutContainer()

    stopLoadingSpinner()
end sub

' ============================================
' Backdrop
' ============================================

' Which image stands in for the backdrop. The classic screen falls back from the
' backdrop straight to the item's own primary image
function backdropSourceFor(itemData as object) as object
    if isValidAndNotEmpty(itemData.BackdropImageTags)
        return { imageVersion: ImageType.BACKDROP, imageTag: itemData.BackdropImageTags[0], backdropItemId: itemData.id }
    else if isChainValid(itemData, "ImageTags.Primary")
        return { imageVersion: ImageType.PRIMARY, imageTag: itemData.ImageTags.Primary, backdropItemId: itemData.id }
    end if

    return { imageVersion: ImageType.BACKDROP, imageTag: invalid, backdropItemId: itemData.id }
end function

function backdropRequestParams(params as object) as object
    params.blur = getBackdropBlurAmount()
    return params
end function

' The modern screen scales its scrims to the blur setting. The classic screen
' draws a flat tint in XML, so there is nothing to do per show here
sub applyBackdropTreatment()
end sub

' ============================================
' Logo image (set from ShowScenes.bs via interface field)
' ============================================

sub onLogoImageURIChanged()
    if not isValid(m.logoImage) then return

    if isValidAndNotEmpty(m.top.logoImageURI)
        m.logoImage.uri = m.top.logoImageURI
        if isValid(m.logoShadow) then m.logoShadow.uri = m.top.logoImageURI
        if isValid(m.logoGroup) then m.logoGroup.visible = true
        if isValid(m.titleNode) then m.titleNode.visible = false
    else
        m.logoImage.uri = ""
        if isValid(m.logoShadow) then m.logoShadow.uri = ""
        if isValid(m.logoGroup) then m.logoGroup.visible = false
        if isValid(m.titleNode) then m.titleNode.visible = true
    end if

    ' Re-layout since logo/title visibility changed
    layoutContainer()
end sub

' ============================================
' Metadata population
' ============================================

' A pill drawn round a short run of text
function layoutBadge(bg as object, textNode as object, padX as integer, padY as integer) as integer
    textNode.translation = [padX, padY]
    bounds = textNode.boundingRect()
    bg.width = bounds.width + (padX * 2)
    bg.height = bounds.height + (padY * 2)
    return bg.width
end function

' The series name sits beside a pill carrying the season and episode, the way
' the other clients head an episode
sub layoutEpisodeHeader(itemData as object, item as object)
    header = m.top.findNode("episodeHeader")
    nameNode = m.top.findNode("seriesName")
    pill = m.top.findNode("episodePill")
    pillBg = m.top.findNode("episodePillBg")
    pillText = m.top.findNode("episodePillText")

    showName = ""
    if isValid(item.showName) and item.showName <> ""
        showName = item.showName
    else if isValid(itemData.SeriesName)
        showName = itemData.SeriesName
    end if

    nameNode.text = showName
    nameNode.visible = showName <> ""
    nameNode.translation = [0, 0]

    pill.visible = isAllValid([itemData.ParentIndexNumber, itemData.IndexNumber])
    if pill.visible
        pillText.text = "S" + itemData.ParentIndexNumber.toStr() + " E" + itemData.IndexNumber.toStr()
        layoutBadge(pillBg, pillText, CLASSIC_PILL_PAD_X, CLASSIC_PILL_PAD_Y)
    end if

    header.visible = nameNode.visible or pill.visible
    if not header.visible then return

    if pill.visible
        if nameNode.visible
            ' Centred against the taller series name beside it
            nameBounds = nameNode.boundingRect()
            pill.translation = [nameBounds.width + CLASSIC_PILL_GAP, (nameBounds.height - pillBg.height) / 2]
        else
            pill.translation = [0, 0]
        end if
    end if
end sub

sub populateEpisodeMetadata(itemData as object, item as object)
    layoutEpisodeHeader(itemData, item)

    if isValid(itemData.PremiereDate)
        airDate = CreateObject("roDateTime")
        airDate.FromISO8601String(itemData.PremiereDate)
        airDate.ToLocalTime()
        monthName = getMonthName(airDate.GetMonth())
        dateText = `${monthName} ${airDate.GetDayOfMonth()}, ${airDate.GetYear()}`
        setFieldText("releaseYear", dateText)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    populateStreamInfo(itemData)
end sub

sub populateRatings(itemData as object)
    communityRatingGroup = m.top.findNode("communityRatingGroup")
    criticRatingGroup = m.top.findNode("criticRatingGroup")

    if m.global.session.user.settings["ui.itemdetail.showRatings"]
        if isValid(itemData.communityRating) and moonfinPlugin.IsRatingSourceEnabled("stars")
            m.top.findNode("star").visible = true
            setFieldText("communityRating", int(itemData.communityRating * 10) / 10)
            if isValid(communityRatingGroup) then communityRatingGroup.visible = true
        else
            m.top.findNode("star").visible = false
            setFieldText("communityRating", "")
            if isValid(communityRatingGroup) then communityRatingGroup.visible = false
        end if

        ' Show the native critic rating up front. It's hidden again only once
        ' plugin display ratings actually arrive (see onFetchRatingsComplete)
        tomatoIcon = m.top.findNode("tomatoIcon")
        if isValid(itemData.CriticRating) and itemData.CriticRating > 0
            criticScore = itemData.CriticRating
            setFieldText("criticRating", criticScore.toStr() + "%")
            if isValid(tomatoIcon)
                tomatoIcon.uri = criticScore >= 60 ? "pkg:/images/fresh.png" : "pkg:/images/rotten.png"
                tomatoIcon.visible = true
            end if
            if isValid(criticRatingGroup) then criticRatingGroup.visible = true
        else
            setFieldText("criticRating", "")
            if isValid(tomatoIcon) then tomatoIcon.visible = false
            if isValid(criticRatingGroup) then criticRatingGroup.visible = false
        end if
    else
        setFieldText("communityRating", "")
        m.top.findNode("star").visible = false
        if isValid(communityRatingGroup) then communityRatingGroup.visible = false

        setFieldText("criticRating", "")
        tomatoIcon = m.top.findNode("tomatoIcon")
        if isValid(tomatoIcon) then tomatoIcon.visible = false
        if isValid(criticRatingGroup) then criticRatingGroup.visible = false
    end if
end sub

sub fetchMDBListRatings(itemData as object)
    ratingsRow = m.top.findNode("ratingsRow")
    if not isValid(ratingsRow) then return

    ratingsRow.visible = false
    ratingsRow.showNames = get_user_setting_bool("plugin.mdblist.showRatingNames", false)
    ' Badges only choose the chrome around each rating, so off means plain rather than hidden
    ratingsRow.showBadges = get_user_setting_bool("plugin.mdblist.showRatingBadges", true)

    if not moonfinPlugin.IsRatingsEnabled() and not moonfinPlugin.IsEpisodeRatingsEnabled() then return

    if isValid(m.fetchRatingsTask)
        m.fetchRatingsTask.unobserveField("ratings")
    end if

    m.fetchRatingsTask = createObject("roSGNode", "FetchRatingsTask")
    m.fetchRatingsTask.itemData = itemData
    m.fetchRatingsTask.observeField("ratings", "onFetchRatingsComplete")
    m.fetchRatingsTask.control = TaskControl.RUN
end sub

sub onFetchRatingsComplete()
    ratingsRow = m.top.findNode("ratingsRow")
    if not isValid(ratingsRow) or not isValid(m.fetchRatingsTask) then return

    result = m.fetchRatingsTask.ratings
    if not isValid(result) then return

    ' Plugin ratings arrived, now hide the native critic rating
    if isValidAndNotEmpty(result.data)
        setFieldText("criticRating", "")
        tomatoIcon = m.top.findNode("tomatoIcon")
        if isValid(tomatoIcon) then tomatoIcon.visible = false
        criticRatingGroup = m.top.findNode("criticRatingGroup")
        if isValid(criticRatingGroup) then criticRatingGroup.visible = false
    end if

    ratingsRow.ratingsData = result
    ' Dropping the native critic rating leaves a hole in the row, so the row is
    ' closed up again before anything is measured against it
    layoutMetadataRow()
    layoutContainer()
end sub

sub populateGenres(itemData as object)
    if isValidAndNotEmpty(itemData.genres)
        ' Only the first few, the way the other clients cut the list
        shownGenres = []
        for each genre in itemData.genres
            if shownGenres.count() >= 3 then exit for
            shownGenres.push(genre)
        end for
        setFieldText("genres", shownGenres.join(", "))
        setFieldText("metaGenres", shownGenres.join(" • "))
        if isValid(m.genresColumn) then m.genresColumn.visible = true
    else
        setFieldText("metaGenres", "")
        if isValid(m.genresColumn) then m.genresColumn.visible = false
    end if
end sub

sub populateStreamInfo(itemData as object)
    row = m.top.findNode("codecRow")
    if not isValid(row) then return

    row.removeChildrenIndex(row.getChildCount() - 1, 1)

    if not mediaBadges.Enabled()
        row.visible = false
        return
    end if

    labels = mediaBadges.Build(itemData)
    row.visible = labels.count() > 0
    if not row.visible then return

    measure = m.top.findNode("codecBadgeFont")
    xPos = 0
    for each label in labels
        measure.text = label
        bounds = measure.boundingRect()
        width = bounds.width + (CLASSIC_BADGE_PAD_H * 2)
        height = bounds.height + (CLASSIC_BADGE_PAD_V * 2)

        badge = row.createChild("Group")
        badge.translation = [xPos, 0]

        outline = badge.createChild("Poster")
        outline.uri = "pkg:/images/details/outline6.9.png"
        outline.width = width
        outline.height = height
        outline.blendColor = CLASSIC_BADGE_BORDER

        text = badge.createChild("Text")
        text.text = label
        text.font = measure.font
        text.color = CLASSIC_BADGE_INK
        text.width = width
        text.height = height
        text.horizAlign = "center"
        text.vertAlign = "center"

        xPos += width + CLASSIC_CODEC_GAP
    end for
end sub

sub populateDirectors(itemData as object)
    directors = []
    if isValid(itemData.people)
        for each person in itemData.people
            if LCase(person.type) = PersonType.DIRECTOR
                directors.push(person.name)
            end if
        end for
    end if

    if isValidAndNotEmpty(directors)
        directorHeaderNode = m.top.findNode("directorHeader")
        if isValid(directorHeaderNode)
            directorHeaderNode.text = directors.Count() > 1 ? "DIRECTORS" : "DIRECTOR"
        end if
        setFieldText("director", directors.join(", "))
        if isValid(m.directorColumn) then m.directorColumn.visible = true
    else
        if isValid(m.directorColumn) then m.directorColumn.visible = false
    end if
end sub

sub populateWriters(itemData as object)
    writers = []
    if isValid(itemData.people)
        for each person in itemData.people
            if LCase(person.type) = "writer"
                writers.push(person.name)
            end if
        end for
    end if

    if isValidAndNotEmpty(writers)
        setFieldText("writers", writers.join(", "))
        if isValid(m.writersColumn) then m.writersColumn.visible = true
    else
        if isValid(m.writersColumn) then m.writersColumn.visible = false
    end if
end sub

sub populateStudio(itemData as object)
    if isValidAndNotEmpty(itemData.Studios)
        studioNames = []
        for each studioObj in itemData.Studios
            if isValid(studioObj.Name)
                studioNames.push(studioObj.Name)
            end if
        end for

        if isValidAndNotEmpty(studioNames)
            setFieldText("studio", studioNames.join(", "))
            if isValid(m.studioColumn) then m.studioColumn.visible = true
        else
            if isValid(m.studioColumn) then m.studioColumn.visible = false
        end if
    else
        if isValid(m.studioColumn) then m.studioColumn.visible = false
    end if
end sub

sub updateColumnDividers()
    ' Manually position visible columns side-by-side (no LayoutGroup - it doesn't
    ' reliably collapse hidden children on Roku).
    columns = [m.genresColumn, m.directorColumn, m.writersColumn, m.studioColumn]
    dividers = [m.top.findNode("divider1"), m.top.findNode("divider2"), m.top.findNode("divider3")]
    metadataColumnsBg = m.top.findNode("metadataColumnsBg")
    metadataColumnsBorder = m.top.findNode("metadataColumnsBorder")

    ' Hide all dividers first
    for each div in dividers
        if isValid(div) then div.visible = false
    end for

    ' Collect visible columns in order
    visibleColumns = []
    for each col in columns
        if isValid(col) and col.visible
            visibleColumns.push(col)
        end if
    end for

    for each layer in [metadataColumnsBg, metadataColumnsBorder]
        if isValid(layer) then layer.visible = visibleColumns.count() > 0
    end for

    if visibleColumns.count() = 0 then return

    ' Cells share the content width evenly, so the card always runs the full
    ' width however many of them there are
    visibleCount = visibleColumns.count()
    divWidth = 1
    numDividers = visibleCount - 1
    colWidth = Int((CLASSIC_CONTENT_WIDTH - (numDividers * divWidth)) / visibleCount)

    xPos = 0
    cardHeight = 0
    placedDividers = []
    for i = 0 to visibleCount - 1
        visibleColumns[i].translation = [xPos, 0]
        cellHeight = layoutMetadataCell(visibleColumns[i], colWidth)
        if cellHeight > cardHeight then cardHeight = cellHeight
        xPos += colWidth

        if i < visibleCount - 1
            divider = getDividerBetween(visibleColumns[i], visibleColumns[i + 1], columns, dividers)
            if isValid(divider)
                divider.visible = true
                divider.translation = [xPos, 0]
                placedDividers.push(divider)
                xPos += divWidth
            end if
        end if
    end for

    for each layer in [metadataColumnsBg, metadataColumnsBorder]
        if isValid(layer)
            layer.width = CLASSIC_CONTENT_WIDTH
            layer.height = cardHeight
            layer.translation = [0, 0]
        end if
    end for

    for each divider in placedDividers
        divider.height = cardHeight
    end for
end sub

' A label over its value, both pinned to the left of the cell the way the other
' clients set them out. Returns how tall the cell came out, so the card can be
' sized around the tallest of them
function layoutMetadataCell(column as object, cellWidth as integer) as integer
    inner = cellWidth - (CLASSIC_CELL_PAD_X * 2)
    labelNode = column.getChild(0)
    valueNode = column.getChild(1)

    labelNode.width = inner
    labelNode.translation = [CLASSIC_CELL_PAD_X, CLASSIC_CELL_PAD_Y]

    valueTop = CLASSIC_CELL_PAD_Y + labelNode.boundingRect().height + CLASSIC_CELL_GAP
    valueNode.width = inner
    valueNode.translation = [CLASSIC_CELL_PAD_X, valueTop]

    return valueTop + valueNode.boundingRect().height + CLASSIC_CELL_PAD_Y
end function

function getDividerBetween(colA as object, colB as object, allColumns as object, allDividers as object) as object
    ' Find the indices of colA and colB in the full column list
    idxA = -1
    idxB = -1
    for i = 0 to allColumns.count() - 1
        if isValid(allColumns[i])
            if allColumns[i].isSameNode(colA) then idxA = i
            if allColumns[i].isSameNode(colB) then idxB = i
        end if
    end for

    ' Dividers sit between columns: divider[0] between col[0]-col[1], etc.
    ' Use the divider closest to the first column in the pair
    if idxA >= 0 and idxB >= 0 and idxA < allDividers.count()
        return allDividers[idxA]
    end if
    return invalid
end function

' ============================================
' Layout: metadata row (horizontal positioning)
' ============================================

sub layoutMetadataRow()
    ' Hide empty text nodes
    metadataIds = ["releaseYear", "officialRating", "seasonCount", "runtime", "endsAt", "metaGenres"]
    for each id in metadataIds
        node = m.top.findNode(id)
        if isValid(node)
            node.visible = (node.text <> "")
        end if
    end for

    ratingGroup = m.top.findNode("officialRatingGroup")
    if isValid(ratingGroup) then ratingGroup.visible = m.top.findNode("officialRating").text <> ""

    ' Hide all dots initially
    allDots = ["dot1", "dot3", "dot4", "dot5", "dot6", "dot7", "dot8", "dot9", "dot10"]
    for each dotId in allDots
        dot = m.top.findNode(dotId)
        if isValid(dot) then dot.visible = false
    end for

    ' Read user metadata order and hidden settings
    orderSetting = invalid
    hiddenSetting = invalid
    if isValid(m.global) and isValid(m.global.session) and isValid(m.global.session.user) and isValid(m.global.session.user.settings)
        orderSetting = m.global.session.user.settings[DETAIL_METADATA_ORDER_SETTING]
        hiddenSetting = m.global.session.user.settings[DETAIL_METADATA_HIDDEN_SETTING]
    end if

    hiddenLookup = detailMetadataLayout.HiddenLookup(hiddenSetting)

    ' Hide any items whose setting is explicitly hidden
    if isValid(hiddenLookup["year"])
        node = m.top.findNode("releaseYear")
        if isValid(node) then node.visible = false
    end if
    if isValid(hiddenLookup["parentalRating"])
        if isValid(ratingGroup) then ratingGroup.visible = false
        node = m.top.findNode("officialRating")
        if isValid(node) then node.visible = false
    end if
    if isValid(hiddenLookup["runtimeAndSeasons"])
        for each id in ["seasonCount", "runtime", "endsAt"]
            node = m.top.findNode(id)
            if isValid(node) then node.visible = false
        end for
    end if
    statusBadgeNode = m.top.findNode("statusBadge")
    if isValid(hiddenLookup["status"])
        if isValid(statusBadgeNode) then statusBadgeNode.visible = false
    end if
    upcomingBadgeNode = m.top.findNode("upcomingBadge")
    if isValid(hiddenLookup["upcomingEpisodeDate"])
        if isValid(upcomingBadgeNode) then upcomingBadgeNode.visible = false
    end if
    if isValid(hiddenLookup["genres"])
        node = m.top.findNode("metaGenres")
        if isValid(node) then node.visible = false
    end if

    ' Get active catalogue items in arranged order
    arranged = detailMetadataLayout.Arrange(detailMetadataLayout.DetailMetadata(), orderSetting, hiddenSetting)

    ' Build target node ids matching arranged categories
    orderedNodeIds = []
    for each item in arranged
        if item.id = "year"
            orderedNodeIds.push("releaseYear")
        else if item.id = "parentalRating"
            orderedNodeIds.push("officialRatingGroup")
        else if item.id = "runtimeAndSeasons"
            orderedNodeIds.push("seasonCount")
            orderedNodeIds.push("runtime")
            orderedNodeIds.push("endsAt")
            orderedNodeIds.push("communityRatingGroup")
            orderedNodeIds.push("criticRatingGroup")
        else if item.id = "status"
            orderedNodeIds.push("statusBadge")
        else if item.id = "upcomingEpisodeDate"
            orderedNodeIds.push("upcomingBadge")
        else if item.id = "genres"
            orderedNodeIds.push("metaGenres")
        end if
    end for

    spacing = CLASSIC_SEPARATOR_MARGIN

    visibleContent = []
    for each nodeId in orderedNodeIds
        contentNode = m.top.findNode(nodeId)
        if not isValid(contentNode) or not contentNode.visible then continue for
        visibleContent.push(contentNode)
    end for

    xPos = 0
    dotIdx = 0
    for i = 0 to visibleContent.count() - 1
        node = visibleContent[i]

        ' Insert dot before this item (if not first)
        if i > 0 and dotIdx < allDots.count()
            dotNode = m.top.findNode(allDots[dotIdx])
            dotIdx++
            if isValid(dotNode)
                dotNode.translation = [xPos, 0]
                dotNode.visible = true
                dotBounds = dotNode.boundingRect()
                xPos += dotBounds.width + spacing
            end if
        end if

        if node.id = "officialRatingGroup"
            badgeWidth = layoutBadge(m.top.findNode("officialRatingBg"), m.top.findNode("officialRating"), CLASSIC_BADGE_PAD_X, CLASSIC_BADGE_PAD_Y)
            node.translation = [xPos, -CLASSIC_BADGE_PAD_Y]
            xPos += badgeWidth + spacing
        else if node.id = "statusBadge"
            bg = m.top.findNode("statusBadgeBg")
            node.translation = [xPos, -STATUS_PAD_V]
            xPos += bg.width + spacing
        else if node.id = "upcomingBadge"
            bg = m.top.findNode("upcomingBadgeBg")
            node.translation = [xPos, -STATUS_PAD_V]
            xPos += bg.width + spacing
        else if node.id = "communityRatingGroup"
            layoutCommunityRating(node)
            node.translation = [xPos, 0]
            xPos += getCommunityRatingWidth() + spacing
        else if node.id = "criticRatingGroup"
            layoutCriticRating(node)
            node.translation = [xPos, 0]
            xPos += getCriticRatingWidth() + spacing
        else
            node.translation = [xPos, 0]
            bounds = node.boundingRect()
            xPos += bounds.width + spacing
        end if
    end for
end sub

sub layoutCommunityRating(_ratingGroup as object)
    starNode = m.top.findNode("star")
    ratingText = m.top.findNode("communityRating")
    if isValid(starNode) and starNode.visible
        starNode.translation = [0, 0]
        if isValid(ratingText)
            ratingText.translation = [25, 0] ' 20px star + 5px gap
        end if
    else if isValid(ratingText)
        ratingText.translation = [0, 0]
    end if
end sub

function getCommunityRatingWidth() as integer
    starNode = m.top.findNode("star")
    ratingText = m.top.findNode("communityRating")
    totalWidth = 0
    if isValid(starNode) and starNode.visible
        totalWidth += 25 ' 20px star + 5px gap
    end if
    if isValid(ratingText) and ratingText.text <> ""
        bounds = ratingText.boundingRect()
        totalWidth += bounds.width
    end if
    return totalWidth
end function

sub layoutCriticRating(_ratingGroup as object)
    tomatoNode = m.top.findNode("tomatoIcon")
    ratingText = m.top.findNode("criticRating")
    if isValid(tomatoNode) and tomatoNode.visible
        tomatoNode.translation = [0, 0]
        if isValid(ratingText)
            ratingText.translation = [25, 0] ' 20px icon + 5px gap
        end if
    else if isValid(ratingText)
        ratingText.translation = [0, 0]
    end if
end sub

function getCriticRatingWidth() as integer
    tomatoNode = m.top.findNode("tomatoIcon")
    ratingText = m.top.findNode("criticRating")
    totalWidth = 0
    if isValid(tomatoNode) and tomatoNode.visible
        totalWidth += 25 ' 20px icon + 5px gap
    end if
    if isValid(ratingText) and ratingText.text <> ""
        bounds = ratingText.boundingRect()
        totalWidth += bounds.width
    end if
    return totalWidth
end function

' ============================================
' Layout: vertical container positioning
' ============================================

sub layoutContainer()
    m.layingOut = true
    ' Children of the container Group are placed by hand, in the margins the
    ' other clients use, skipping anything hidden so there are no gaps
    yPos = 0

    episodeHeader = m.top.findNode("episodeHeader")
    if isValid(episodeHeader) and episodeHeader.visible
        episodeHeader.translation = [0, yPos]
        yPos += episodeHeader.boundingRect().height + 6
    end if

    logoGroup = m.top.findNode("logoGroup")
    titleNode = m.top.findNode("title")
    if isValid(logoGroup) and logoGroup.visible
        logoGroup.translation = [0, yPos]
        yPos += CLASSIC_LOGO_HEIGHT + 17 + 12
    else if isValid(titleNode) and titleNode.visible
        titleNode.translation = [0, yPos]
        yPos += titleNode.boundingRect().height + 12
    end if

    metadataRow = m.top.findNode("metadataRow")
    if isValid(metadataRow)
        metadataRow.translation = [0, yPos]
        yPos += CLASSIC_INFO_ROW_HEIGHT + 12
    end if

    codecRow = m.top.findNode("codecRow")
    if isValid(codecRow) and codecRow.visible
        yPos += 9
        codecRow.translation = [0, yPos]
        yPos += CLASSIC_INFO_ROW_HEIGHT
    end if

    ratingsRow = m.top.findNode("ratingsRow")
    if isValid(ratingsRow) and ratingsRow.visible
        ratingsRow.translation = [0, yPos]
        yPos += ratingsRow.boundingRect().height
    end if

    taglineNode = m.top.findNode("tagline")
    if isValid(taglineNode) and taglineNode.visible
        yPos += 9
        taglineNode.translation = [0, yPos]
        yPos += taglineNode.boundingRect().height
    end if

    overviewNode = m.top.findNode("overview")
    if isValid(overviewNode) and overviewNode.visible
        yPos += 12
        overviewNode.translation = [0, yPos]
        yPos += overviewNode.boxHeight
    end if

    placePoster(yPos)
    yPos += 23

    buttonRowContainer = m.top.findNode("buttonRowContainer")
    if isValid(buttonRowContainer)
        yPos += 12
        buttonRowContainer.translation = [0, yPos]
        ' Buttons with a label that wraps make the row taller, so it is measured
        ' rather than assumed
        rowHeight = 0
        if isValid(m.buttonRow) then rowHeight = m.buttonRow.boundingRect().height
        if isValid(m.buttonRowExtra) and m.buttonRowExtra.visible
            rowHeight = m.buttonRowExtra.translation[1] - 9 + m.buttonRowExtra.boundingRect().height
        end if
        yPos += 9 + rowHeight + 9 + 36
    end if

    metadataColumnsContainer = m.top.findNode("metadataColumnsContainer")
    metadataColumnsBg = m.top.findNode("metadataColumnsBg")
    if isValid(metadataColumnsContainer)
        metadataColumnsContainer.translation = [0, yPos]
        if isValid(metadataColumnsBg) and metadataColumnsBg.visible
            yPos += metadataColumnsBg.height + 40
        end if
    end if

    extrasGrid = m.top.findNode("extrasGrid")
    if isValid(extrasGrid)
        yPos += 8
        extrasGrid.translation = [0, yPos]
        yPos += extrasRowCount() * EXTRAS_ROW_HEIGHT
    end if

    if isValid(m.seerrBlock) and m.seerrBlock.visible
        m.seerrBlock.translation = [m.seerrBlock.translation[0], yPos + 40]
    end if

    m.layingOut = false
end sub

' Seerr is asked about a title only once the library has told us what it is
' A Seerr title arrives as a tmdb id, and the screen asks Seerr for the rest itself
function extrasRowCount() as integer
    if not isValid(m.extrasGrid) or not isValid(m.extrasGrid.content) then return 0
    return m.extrasGrid.content.getChildCount()
end function

' Each extras row lands separately, so the block is placed again as the rows stack up
sub onExtrasRowsLoaded()
    layoutContainer()
    updateSeerrSeasonMarkers()
end sub

sub onSeerrBlockChanged()
    m.seerrBlock.visible = m.seerrBlock.hasContent
    layoutContainer()
end sub

' Brings the focused section up near the top of the screen, the way entering the
' extras rows brings those up
sub scrollToSeerrFocus()
    if not isValid(m.seerrBlock) then return
    top = CLASSIC_CONTAINER_TOP + m.seerrBlock.translation[1] + m.seerrBlock.focusedOffset
    scrollContentTo(- (top - 200))
end sub

' The poster ends level with the text beside it, but stays put rather than riding
' off the top when there is little text to sit against. It hangs off the scrolling
' group rather than the text container, so the foot of the text is carried across
sub placePoster(headerBottom as integer)
    if not isValid(m.posterMask) or not m.posterMask.visible then return

    posterHeight = m.posterMask.boundingRect().height
    yPos = CLASSIC_CONTAINER_TOP + headerBottom - posterHeight
    if yPos < CLASSIC_CONTAINER_TOP then yPos = CLASSIC_CONTAINER_TOP

    m.posterMask.translation = [m.posterMask.translation[0], yPos]
    updatePlayedIndicator()
end sub

sub setPosterImage(itemData as object)
    if not isValid(m.posterImage) or not isValid(m.posterMask) then return

    ' A Seerr title has no library images, so it carries a finished TMDB url instead
    if isValidAndNotEmpty(itemData._externalPosterUrl)
        m.posterImage.uri = itemData._externalPosterUrl
        m.posterMask.visible = true
        return
    end if

    posterItemId = itemData.id
    imageTag = invalid
    posterImageType = ImageType.PRIMARY

    ' Episodes: prefer Thumb (landscape screenshot), fall back to Primary
    if isEpisode()
        seriesSource = invalid
        if moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.useSeriesThumbnails`", false), false)
            seriesSource = getSeriesThumbnailSource(itemData)
        end if

        if isValid(seriesSource)
            posterItemId = seriesSource.id
            imageTag = seriesSource.tag
            posterImageType = seriesSource.imageType
        else if isChainValid(itemData, "ImageTags.Thumb")
            imageTag = itemData.ImageTags.Thumb
            posterImageType = ImageType.THUMB
        else if isChainValid(itemData, "ImageTags.Primary")
            imageTag = itemData.ImageTags.Primary
            posterImageType = ImageType.PRIMARY
        end if

        m.posterMask.maskUri = "pkg:/images/details/thumb_mask.png"
        m.posterImage.width = 406
        m.posterImage.height = 229
    else
        if isChainValid(itemData, "ImageTags.Primary")
            imageTag = itemData.ImageTags.Primary
        end if

        m.posterMask.maskUri = "pkg:/images/details/poster_mask.png"
        m.posterImage.width = 239
        m.posterImage.height = 360
    end if

    ' Ends flush with the right of the content, whichever shape it is
    posterX = CLASSIC_CONTENT_LEFT + CLASSIC_CONTENT_WIDTH - m.posterImage.width
    m.posterMask.translation = [posterX, m.posterMask.translation[1]]

    if not isValid(imageTag)
        m.posterMask.visible = false
        return
    end if

    params = {}
    if isEpisode()
        params = {
            "maxWidth": 520,
            "maxHeight": 293,
            "quality": 90,
            "Tag": imageTag
        }
    else
        params = {
            "maxWidth": 400,
            "maxHeight": 600,
            "quality": 90,
            "Tag": imageTag
        }
    end if

    serverBaseUrl = invalid
    if isChainValid(itemData, "_serverUrl")
        serverBaseUrl = itemData._serverUrl
        if serverBaseUrl.right(1) = "/"
            serverBaseUrl = serverBaseUrl.left(serverBaseUrl.len() - 1)
        end if
    end if

    posterUrl = invalid
    if isValid(serverBaseUrl)
        posterUrl = buildImageURLForServer(serverBaseUrl, posterItemId, posterImageType, params)
    else
        posterUrl = ImageURL(posterItemId, posterImageType, params)
    end if

    if isValid(posterUrl)
        m.posterImage.uri = posterUrl
        m.posterMask.visible = true
        updatePlayedIndicator()
    else
        m.posterMask.visible = false
        m.playedIndicator.visible = false
    end if
end sub

sub updatePlayedIndicator()
    if not isValid(m.playedIndicator) then return

    itemContent = m.top.itemContent
    if not isChainValid(itemContent, "json") then return

    itemData = itemContent.json
    posterX = m.posterMask.translation[0]
    posterY = m.posterMask.translation[1]
    posterW = m.posterImage.width

    m.playedIndicator.translation = [posterX + posterW - 42, posterY]
    m.playedIndicator.favoriteOffset = [- (posterW - 42) + 4, 0]
    m.playedIndicator.visible = true
    m.playedIndicator.data = {
        played: chainLookupReturn(itemData, "UserData.Played", false),
        favorite: chainLookupReturn(itemData, "UserData.IsFavorite", false)
    }
end sub

' ============================================
' Button management
' ============================================

sub clearButtonRow()
    m.buttonConfigs = []
end sub

sub commitButtonRow()
    buildButtonRows()
end sub

sub centerButtonRow()
    centerButtonRowInContainer(m.buttonRow, m.primaryCount, CLASSIC_BUTTON_WIDTH, CLASSIC_BUTTON_GAP, 96)
    centerButtonRowInContainer(m.buttonRowExtra, m.buttonGroups.count() - m.primaryCount, CLASSIC_BUTTON_WIDTH, CLASSIC_BUTTON_GAP, 96)
end sub

' How one button config becomes a row entry. The classic screen queues configs and
' builds the rows in one pass, the modern one creates each node as it goes
sub appendButtonNode(config as object)
    m.buttonConfigs.push(config)
end sub

' Item types that own their whole action row. The classic screen sends seasons,
' albums and playlists to the legacy screens instead, so it has none
function typeSpecificButtons() as boolean
    return false
end function

' How a button carries its on/off state. The classic screen tints the icon, the
' modern one flips a field the button node watches
function markActiveButton(config as object, isActive as boolean, ink as string) as object
    config.activeInk = isActive ? ink : ""
    return config
end function

function primaryRowCapacity() as integer
    stride = CLASSIC_BUTTON_WIDTH + CLASSIC_BUTTON_GAP
    fits = (CLASSIC_ROW_WIDTH + CLASSIC_BUTTON_GAP) / stride
    if fits < 3 then return 3
    return Int(fits)
end function

' The row holds as many buttons as fit across the screen. Anything past that folds
' under a trailing More, which opens a second row underneath, the way the other
' clients handle a long action row.
sub buildButtonRows()
    m.buttonRow.removeChildrenIndex(m.buttonRow.getChildCount(), 0)
    m.buttonRowExtra.removeChildrenIndex(m.buttonRowExtra.getChildCount(), 0)
    m.buttonGroups = []

    configs = m.buttonConfigs
    capacity = primaryRowCapacity()
    overflows = configs.count() > capacity

    primary = configs
    extra = []
    if overflows
        primary = []
        for i = 0 to capacity - 2
            primary.push(configs[i])
        end for
        for i = capacity - 1 to configs.count() - 1
            extra.push(configs[i])
        end for
    end if

    for each config in primary
        appendButton(config, m.buttonRow)
    end for

    if overflows
        appendButton(moreButtonConfig(), m.buttonRow)
    end if

    m.primaryCount = m.buttonGroups.count()

    for each config in extra
        appendButton(config, m.buttonRowExtra)
    end for

    m.buttonRowExtra.visible = m.actionsExpanded and extra.count() > 0
    if not m.buttonRowExtra.visible then m.actionsExpanded = false

    if m.buttonRowExtra.visible
        m.buttonRowExtra.translation = [0, 27 + m.buttonRow.boundingRect().height]
    end if

    centerButtonRow()
    layoutContainer()
end sub

sub appendButton(config as object, row as object)
    buttonGroup = detailButtons.createButton(config, m.buttonGroups.count())
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    row.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

' Whether an index sits on the second row, so the arrows stay inside their own row
function isExtraRowIndex(index as integer) as boolean
    return index >= m.primaryCount
end function

function rowStart(index as integer) as integer
    return isExtraRowIndex(index) ? m.primaryCount : 0
end function

function rowEnd(index as integer) as integer
    return isExtraRowIndex(index) ? m.buttonGroups.count() - 1 : m.primaryCount - 1
end function

sub toggleMoreActions()
    m.actionsExpanded = not m.actionsExpanded
    index = m.currentButtonIndex
    buildButtonRows()
    focusButton(index)
end sub

sub highlightButton(index as integer)
    detailButtons.highlight(index, m.buttonGroups)
end sub

sub unhighlightAllButtons()
    detailButtons.unhighlightAll(m.buttonGroups)
end sub

' ============================================
' Button actions
' ============================================

' Actions only one screen offers. The classic screen sends seasons, albums and
' playlists to the legacy screens, so it has none of its own
sub handleScreenButtonAction(_action as string)
end sub

' How a toggle button shows its new state. The classic screen writes the label node
' that detailButtons.createButton names "<id>Text"
sub setToggleButtonLabel(buttonId as string, label as string, _isActive as boolean)
    node = m.top.findNode(buttonId + "Text")
    if isValid(node)
        node.text = label
    end if
end sub

' The classic screen lists the streams as a codec row, the modern one as tech chips
sub buildStreamSummary(itemData as object)
    populateStreamInfo(itemData)
end sub

' The classic stream row changes height with the codec list, so the stack below it
' is laid out again
sub refreshAfterVersionChange()
    layoutMetadataRow()
    layoutContainer()
end sub

' How far the page scrolls to put the content area in view. The classic screen
' keeps a fixed offset, the modern one works it out from the overview
function contentScrollOffset() as integer
    return -500
end function

' ============================================
' Key event handling
' ============================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A picker left open across a screensaver can come back without focus, which
    ' would leave this screen answering the remote from behind it
    picker = openTrackPicker()
    if isValid(picker)
        picker.setFocus(true)
        return true
    end if

    if key = KeyCode.UP and isValid(m.overview) and m.overview.isInFocusChain()
        m.top.lastFocus = m.overview
        setLastFocus(m.overview)
        return FocusNav(m.top)
    end if

    if key = KeyCode.DOWN and isValid(m.overview) and m.overview.isInFocusChain()
        if m.buttonGroups.count() > 0
            m.buttonGroups[m.currentButtonIndex].setFocus(true)
            m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
            highlightButton(m.currentButtonIndex)
            setLastFocus(m.buttonGroups[m.currentButtonIndex])
        end if
        return true
    end if

    if key = KeyCode.UP and m.buttonGroups.count() > 0 and not isExtraRowIndex(m.currentButtonIndex)
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                unhighlightAllButtons()
                if overviewCanScroll()
                    m.overview.setFocus(true)
                    m.top.lastFocus = m.overview
                    setLastFocus(m.overview)
                else
                    m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                    return FocusOverhang(m.top)
                end if
                return true
            end if
        end for
    end if

    ' The Seerr block sits below the extras rows, so the two hand focus back and forth
    if isValid(m.seerrBlock) and m.seerrBlock.visible
        if key = KeyCode.DOWN and isValid(m.extrasGrid) and m.extrasGrid.isInFocusChain()
            lastRow = 0
            if isValid(m.extrasGrid.content) then lastRow = m.extrasGrid.content.getChildCount() - 1
            if m.extrasGrid.itemFocused >= lastRow and m.seerrBlock.callFunc("focusFirst")
                setLastFocus(m.seerrBlock)
                m.top.lastFocus = m.seerrBlock
                scrollToSeerrFocus()
                return true
            end if
        end if

        if key = KeyCode.UP and m.seerrBlock.isInFocusChain()
            if isValid(m.extrasGrid) and isValid(m.extrasGrid.content)
                m.extrasGrid.setFocus(true)
                setLastFocus(m.extrasGrid)
                m.top.lastFocus = m.extrasGrid
                scrollContentTo(contentScrollOffset())
            else if m.buttonGroups.count() > 0
                m.buttonGroups[m.currentButtonIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                highlightButton(m.currentButtonIndex)
                setLastFocus(m.buttonGroups[m.currentButtonIndex])
                scrollContentTo(0)
            end if
            return true
        end if
    end if

    if key = KeyCode.UP and m.extrasGrid <> invalid and m.extrasGrid.isInFocusChain()
        if m.extrasGrid.itemFocused = 0
            if m.buttonGroups.count() > 0
                m.buttonGroups[m.currentButtonIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                highlightButton(m.currentButtonIndex)
                setLastFocus(m.buttonGroups[m.currentButtonIndex])
                scrollContentTo(0)
                return true
            end if
        end if
        return false
    end if

    isButtonFocused = false
    if m.buttonGroups.count() > 0
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                isButtonFocused = true
                exit for
            end if
        end for
    end if

    if isButtonFocused
        if key = KeyCode.LEFT
            if m.currentButtonIndex > rowStart(m.currentButtonIndex)
                focusButton(m.currentButtonIndex - 1)
            else
                return FocusSidebar(m.top)
            end if
            return true
        else if key = KeyCode.RIGHT
            if m.currentButtonIndex < rowEnd(m.currentButtonIndex)
                focusButton(m.currentButtonIndex + 1)
            end if
            return true
        else if key = KeyCode.OK
            handleButtonSelect()
            return true
        else if key = KeyCode.UP and isExtraRowIndex(m.currentButtonIndex)
            ' Back to the same column on the first row, or to More where the row is shorter
            column = m.currentButtonIndex - m.primaryCount
            if column >= m.primaryCount then column = m.primaryCount - 1
            focusButton(column)
            return true
        else if key = KeyCode.DOWN and m.actionsExpanded and not isExtraRowIndex(m.currentButtonIndex)
            column = m.currentButtonIndex
            if m.primaryCount + column > m.buttonGroups.count() - 1 then column = m.buttonGroups.count() - 1 - m.primaryCount
            focusButton(m.primaryCount + column)
            return true
        else if key = KeyCode.DOWN
            if m.extrasGrid <> invalid and m.extrasGrid.content <> invalid
                m.extrasGrid.setFocus(true)
                m.top.lastFocus = m.extrasGrid
                setLastFocus(m.extrasGrid)
                unhighlightAllButtons()
                scrollContentTo(contentScrollOffset())
            else if isValid(m.seerrBlock) and m.seerrBlock.visible and m.seerrBlock.callFunc("focusFirst")
                m.top.lastFocus = m.seerrBlock
                setLastFocus(m.seerrBlock)
                unhighlightAllButtons()
                scrollToSeerrFocus()
            end if
            return true
        end if
    end if

    if key = KeyCode.BACK
        if m.extrasGrid <> invalid and m.extrasGrid.isInFocusChain()
            if m.buttonGroups.count() > 0
                m.buttonGroups[m.currentButtonIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                highlightButton(m.currentButtonIndex)
                setLastFocus(m.buttonGroups[m.currentButtonIndex])
            end if
            scrollContentTo(0)
            return true
        end if

        if isValid(m.overview) and m.overview.isInFocusChain()
            if m.buttonGroups.count() > 0
                m.buttonGroups[m.currentButtonIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                highlightButton(m.currentButtonIndex)
                setLastFocus(m.buttonGroups[m.currentButtonIndex])
            end if
            return true
        end if

        return false
    end if

    if key = KeyCode.PLAY and m.extrasGrid <> invalid and m.extrasGrid.hasFocus()
        if isValid(m.extrasGrid.focusedItem)
            m.top.quickPlayNode = m.extrasGrid.focusedItem
            return true
        end if
        return false
    end if

    return false
end function


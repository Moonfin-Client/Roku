<?xml version="1.0" encoding="utf-8"?>
<!-- Nouveau's page laid out around the poster. What Stage adds is moved into Nouveau's scrolling
    page when it starts, so the dialogs Nouveau draws last stay on top of it. -->
<component name="StageItemDetails" extends="NouveauItemDetails">
    <children>
        <Group id="stageParts" visible="false">
            <!-- The poster with Play and the circles under it -->
            <Group id="posterColumn">
                <MaskGroup id="posterMask" maskUri="pkg:/images/details/poster_mask.webp">
                    <Rectangle id="posterBg" color="#FFFFFF" opacity="0.06" />
                    <Poster id="posterImage" loadDisplayMode="scaleToZoom" />
                </MaskGroup>
                <Rectangle id="posterTrack" color="#0000008A" visible="false" />
                <Rectangle id="posterProgress" color="#00A4DC" visible="false" />
                <PlayedCheckmark id="posterBadges" visible="false" />
            </Group>

            <!-- The line under the show's name or logo on a season or an episode -->
            <Label id="stageSubtitle" font="font:MediumBoldSystemFont" color="#FFFFFF" wrap="true"
                maxLines="2" visible="false" />
            <Label id="tagline" font="font:SmallestSystemFont" color="#FFFFFFB3" wrap="true"
                maxLines="2" visible="false" />
            <Group id="downloadGroup" visible="false">
                <Label id="downloadText" font="font:SmallestBoldSystemFont" color="#FFFFFFCC" />
                <Rectangle id="downloadTrack" height="6" color="#FFFFFF33" />
                <Rectangle id="downloadFill" height="6" color="#00A4DC" />
                <!-- The arr's own words for why a download is stuck -->
                <Label id="downloadReason" font="font:SmallestSystemFont" color="#FFFFFF99" wrap="true"
                    maxLines="3" />
            </Group>

            <StageChipRow id="trackChips" focusable="true" />
            <StageChipRow id="factChips" focusable="true" />
            <Label id="seerrHeading" font="font:LargeBoldSystemFont" color="#FFFFFF" visible="false" />
        </Group>
    </children>
</component>

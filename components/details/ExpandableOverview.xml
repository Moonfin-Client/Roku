<?xml version="1.0" encoding="utf-8"?>
<component name="ExpandableOverview" extends="Group">
    <children>
        <!-- Only text with more to show gets a box drawn round it, since that box
            is also what takes focus -->
        <Poster id="boxFill" uri="pkg:/images/details/surface17.9.png" loadDisplayMode="scaleToFit"
            blendColor="#FFFFFF" opacity="0.02" visible="false" />
        <Poster id="boxBorder" uri="pkg:/images/details/cardborder.9.png" loadDisplayMode="scaleToFit"
            blendColor="#FFFFFF14" visible="false" />
        <Poster id="boxFocus" uri="pkg:/images/details/cardborderfocus.9.png" loadDisplayMode="scaleToFit"
            blendColor="#FFFFFF" visible="false" />

        <!-- Clipped so the text can be paged without a scroll bar over it -->
        <Group id="textClip">
            <Label id="overviewText" wrap="true" color="#FFFFFFD9" />
        </Group>
        <Label id="readMore" font="font:SmallBoldSystemFont" visible="false" />
    </children>

    <interface>
        <field id="text" type="string" onChange="onContentChanged" />
        <field id="maxWidth" type="float" onChange="onContentChanged" />
        <field id="fontSize" type="integer" value="26" onChange="onContentChanged" />
        <field id="expanded" type="boolean" value="false" />
        <field id="canToggle" type="boolean" value="false" />
        <field id="boxHeight" type="float" value="0" />
        <function name="toggle" />
        <function name="collapse" />
    </interface>
</component>

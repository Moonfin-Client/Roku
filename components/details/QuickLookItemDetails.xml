<?xml version="1.0" encoding="utf-8"?>
<!-- Premiere's page in a drawer down the right, over a dimmed view of the screen the title was picked
    on. What Quick Look adds is moved into place when it starts, under the dialogs Nouveau draws
    last. -->
<component name="QuickLookItemDetails" extends="PremiereItemDetails">
    <children>
        <Group id="quickLookParts" visible="false">
            <Rectangle id="dim" width="1920" height="1080" color="#0000009E" />
            <Group id="drawer" translation="[960, 0]">
                <!-- The page scrolls in the room over Open full page -->
                <Group id="drawerPage" clippingRect="[0, 0, 960, 953]" />
                <!-- A little of the text color over the page color, the way the other clients
                    raise the drawer off the screen under it -->
                <Rectangle id="drawerTint" width="960" height="1080" color="#FFFFFF" opacity="0.03" />
                <Rectangle id="drawerEdge" width="2" height="1080" color="#FFFFFF1A" />
                <Group id="openFullPage" translation="[43, 966]" focusable="true">
                    <Poster id="openFill" uri="pkg:/images/details/btnfill.9.png" width="874"
                        height="77" opacity="0" />
                    <Poster id="openBorder" uri="pkg:/images/details/btnborder.9.png" width="874"
                        height="77" blendColor="#FFFFFF" opacity="0.25" />
                    <Label id="openLabel" font="font:SmallestBoldSystemFont" height="77"
                        vertAlign="center" color="#FFFFFF" />
                    <Poster id="openChevron" uri="pkg:/images/icons/chevron-right.webp" width="30"
                        height="30" blendColor="#FFFFFF" />
                </Group>
            </Group>

            <!-- Says Back closes the drawer, over the top of the picture -->
            <Group id="closeHint">
                <Poster id="closeHintFill" uri="pkg:/images/login/fill23.9.png" height="46"
                    blendColor="#000000" opacity="0.5" />
                <Label id="closeHintText" font="font:SmallestSystemFont" height="46"
                    vertAlign="center" color="#FFFFFFD9" />
            </Group>

            <!-- How far into the title the viewer is, and how long is left -->
            <Group id="progressRow" visible="false">
                <Rectangle id="progressTrack" width="250" height="7" color="#FFFFFF26" />
                <Rectangle id="progressFill" height="7" color="#00A4DC" />
                <Label id="progressText" font="font:SmallestSystemFont" color="#FFFFFFBF" />
            </Group>

            <!-- A show's seasons. The row takes focus as a whole and the screen moves along it. -->
            <Group id="seasonCards" focusable="true" visible="false">
                <Group id="seasonTrack" />
            </Group>
            <!-- Who made a film and when it came out, a column each -->
            <Group id="factColumns" visible="false" />
            <Group id="streamingRow" visible="false" />

            <!-- Never shown, they lend their fonts to the parts built at runtime -->
            <Label id="seasonNameFont" font="font:SmallestBoldSystemFont" visible="false" />
            <Label id="seasonCountFont" font="font:SmallestSystemFont" visible="false" />
            <Label id="factLabelFont" font="font:SmallestSystemFont" visible="false" />
            <Label id="factValueFont" font="font:SmallestBoldSystemFont" visible="false" />
        </Group>

        <!-- The drawer slides in from the right as the dim fades up, and back out on Back -->
        <Animation id="slide" duration="0.26" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="slideInterp" key="[0.0, 1.0]"
                keyValue="[[1920, 0], [960, 0]]" fieldToInterp="drawer.translation" />
            <FloatFieldInterpolator id="dimInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]"
                fieldToInterp="dim.opacity" />
        </Animation>
    </children>
</component>

import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/detailImages.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/nouveauLayout.bs"

' Which summary cards an item gets, in what order, and what each one opens.
'
' A card is an AA: id, title, optional modalTitle, subtitle, imageUrl, iconKey and
' sections. A section is an AA: kind, title, count, items and options, with aspect for its
' artwork, id, collapsible and expanded for a season that folds, tags and mediaType for the
' Seerr chips, and facts for the Seerr facts.


' "1h 32m", "2h", or "48m". The shared formatter says "2h 0m" for a round number
' of hours, which reads badly in a subtitle.
function spotlightRuntimeLabel(ticks as dynamic) as string
    totalMinutes = 0
    if isValid(ticks) then totalMinutes = int(ticks / 600000000)
    hours = int(totalMinutes / 60)
    minutes = totalMinutes mod 60
    if hours > 0 and minutes > 0 then return hours.toStr() + "h " + minutes.toStr() + "m"
    if hours > 0 then return hours.toStr() + "h"
    return minutes.toStr() + "m"
end function

function spotlightCountLabel(count as integer, one as string, many as string) as string
    if count = 1 then return one
    return many.replace("{count}", count.toStr())
end function

function spotlightJoinSubtitle(parts as object) as string
    joined = ""
    for each part in parts
        if isValidAndNotEmpty(part)
            if isValidAndNotEmpty(joined) then joined += " · "
            joined += part
        end if
    end for
    return joined
end function

' A cast list can name the same person twice, once as an actor and once as a
' guest star, so the repeats are folded into one entry carrying both roles.
function spotlightDedupePeople(people as object) as object
    out = []
    byKey = {}
    if not isValidAndNotEmpty(people) then return out

    for each person in people
        if not isValid(person) then continue for
        key = ""
        if isValid(person.id) then key = person.id.toStr()
        if not isValidAndNotEmpty(key) and isValidAndNotEmpty(chainLookupReturn(person, "json.Name", "")) then key = person.json.Name
        if not isValidAndNotEmpty(key) then continue for

        held = byKey[key]
        if isValid(held)
            ' Fold the roles of a repeat entry into the one already kept
            for each role in [held.subTitle, person.subTitle]
                if isValidAndNotEmpty(role) and held.subTitle.Instr(role) < 0
                    if isValidAndNotEmpty(held.subTitle) then held.subTitle += " · "
                    held.subTitle += role
                end if
            end for
        else
            byKey[key] = person
            out.push(person)
        end if
    end for
    return out
end function

function spotlightPersonKey(person as object) as string
    if isValidAndNotEmpty(person.id) then return person.id.toStr()
    return chainLookupReturn(person, "json.Name", "")
end function

' A role written in block capitals reads as shouting next to the rest, and one person
' can arrive with several jobs run together in a single field
function spotlightNormalizeRoles(role as string) as object
    roles = []
    for each part in CreateObject("roRegex", "[;,]", "").Split(role)
        part = part.Trim()
        if part = "" then continue for
        if Len(part) > 1 and part = UCase(part) then part = Left(part, 1) + LCase(Mid(part, 2))
        if not inArray(roles, part) then roles.push(part)
    end for
    return roles
end function

' Actors in Cast, directors then writers merged into Crew, and the first 20 of each.
' Somebody who both directed and acted belongs with the crew, so their name is kept out
' of the cast. The role under each face is the role itself.
function spotlightSplitPeople(people as object) as object
    directors = []
    writers = []
    crewNames = {}
    for each person in people
        personType = chainLookupReturn(person, "json.Type", "")
        if personType = "Director" then directors.push(person)
        if personType = "Writer" then writers.push(person)
        name = chainLookupReturn(person, "json.Name", "")
        if (personType = "Director" or personType = "Writer") and name <> "" then crewNames[name] = true
    end for

    cast = []
    for each person in people
        if cast.count() >= 20 then exit for
        personType = chainLookupReturn(person, "json.Type", "")
        if personType <> "Actor" and personType <> "GuestStar" then continue for
        if crewNames.DoesExist(chainLookupReturn(person, "json.Name", "")) then continue for
        person.subTitle = chainLookupReturn(person, "json.Role", "").Trim()
        cast.push(person)
    end for

    merged = []
    byKey = {}
    for each group in [{ people: directors, fallback: tr("Director") }, { people: writers, fallback: tr("Writer") }]
        for each person in group.people
            key = chainLookupReturn(person, "json.Id", "")
            if key = "" then key = chainLookupReturn(person, "json.Name", "")
            if key = "" then continue for

            role = chainLookupReturn(person, "json.Role", "").Trim()
            if role = "" then role = group.fallback

            held = byKey[key]
            if not isValid(held)
                held = { node: person, roles: [] }
                byKey[key] = held
                merged.push(held)
            end if
            for each part in spotlightNormalizeRoles(role)
                if not inArray(held.roles, part) then held.roles.push(part)
            end for
        end for
    end for

    crew = []
    for each held in merged
        if crew.count() >= 20 then exit for
        held.node.subTitle = held.roles.join(Chr(10))
        crew.push(held.node)
    end for

    return { cast: cast, crew: crew }
end function

const SPOTLIGHT_EXTRA_ORDER = ["extras", "behindTheScenes", "deletedScenes", "featurettes", "interviews", "scenes", "shorts", "trailers"]

' Anything the server files as some other kind, or leaves unmarked, goes under Extras
function spotlightExtraCategory(extra as object) as string
    extraType = chainLookupReturn(extra, "json.ExtraType", "")
    if extraType = "BehindTheScenes" then return "behindTheScenes"
    if extraType = "DeletedScene" then return "deletedScenes"
    if extraType = "Featurette" then return "featurettes"
    if extraType = "Interview" then return "interviews"
    if extraType = "Scene" then return "scenes"
    if extraType = "Short" then return "shorts"
    if extraType = "Trailer" then return "trailers"
    return "extras"
end function

function spotlightExtraCategoryLabel(category as string) as string
    labels = {
        extras: tr("Extras"),
        behindTheScenes: tr("Behind the Scenes"),
        deletedScenes: tr("Deleted Scenes"),
        featurettes: tr("Featurettes"),
        interviews: tr("Interviews"),
        scenes: tr("Scenes"),
        shorts: tr("Shorts"),
        trailers: tr("Trailers")
    }
    return labels[category]
end function

' One section per kind of extra, each keeping the order the server gave it
function spotlightExtraSections(extras as object) as object
    buckets = {}
    for each extra in extras
        category = spotlightExtraCategory(extra)
        if not buckets.DoesExist(category) then buckets[category] = []
        buckets[category].push(extra)
    end for

    sections = []
    for each category in SPOTLIGHT_EXTRA_ORDER
        items = buckets[category]
        if isValidAndNotEmpty(items)
            sections.push({ kind: "media", title: spotlightExtraCategoryLabel(category), count: items.count(), items: items, aspect: "landscape", isExtras: true })
        end if
    end for
    return sections
end function

function spotlightChapterImageUrl(itemData as object, index as integer, tag as string, maxWidth as integer) as string
    path = `Items/${itemData.Id}/Images/Chapter/${index.toStr()}`
    serverUrl = itemData._serverUrl
    if isValidAndNotEmpty(serverUrl)
        if serverUrl.right(1) = "/" then serverUrl = serverUrl.left(serverUrl.len() - 1)
        return `${serverUrl}/${path}?maxWidth=${maxWidth.toStr()}&quality=90&tag=${tag}`
    end if
    return buildURL(path, { maxWidth: maxWidth, quality: 90, tag: tag })
end function

' The first chapter that has a picture of its own
function spotlightFirstChapterImageUrl(itemData as object) as string
    chapters = itemData.Chapters
    if not isValidAndNotEmpty(chapters) then return ""

    for i = 0 to chapters.count() - 1
        tag = chapters[i].ImageTag
        if isValidAndNotEmpty(tag) then return spotlightChapterImageUrl(itemData, i, tag, 480)
    end for
    return ""
end function

function spotlightChapterNodes(itemData as object) as object
    nodes = []
    chapters = itemData.Chapters
    if not isValidAndNotEmpty(chapters) then return nodes

    for i = 0 to chapters.count() - 1
        chapter = chapters[i]
        ticks = chapter.StartPositionTicks ?? 0

        name = chapter.Name
        if not isValidAndNotEmpty(name) then name = tr("Chapter") + " " + (i + 1).toStr()

        thumbUrl = ""
        if isValidAndNotEmpty(chapter.ImageTag) then thumbUrl = spotlightChapterImageUrl(itemData, i, chapter.ImageTag, 400)

        node = CreateObject("roSGNode", "ContentNode")
        node.addFields({ name: name, timeText: secondsToHuman(Int(ticks / 10000000), false), thumbUrl: thumbUrl, startTicks: ticks })
        nodes.push(node)
    end for
    return nodes
end function

' Audio runs short enough to read as minutes and seconds. Anything longer, an audiobook
' chapter or an episode, reads better in hours and minutes.
function spotlightTrackRuntime(ticks as dynamic, isAudio as boolean) as string
    if not isValid(ticks) or ticks <= 0 then return ""

    totalSeconds = Int(ticks / 10000000)
    if isAudio then return Int(totalSeconds / 60).toStr() + ":" + Right("0" + (totalSeconds mod 60).toStr(), 2)

    totalMinutes = Int(totalSeconds / 60)
    hours = Int(totalMinutes / 60)
    if hours > 0 then return `${hours.toStr()}h ${(totalMinutes mod 60).toStr()}m`
    return `${totalMinutes.toStr()}m`
end function

' An episode leads with its series, since its own name says little about where it sits
function spotlightTrackSubtitle(json as object, isAudiobook as boolean, showAlbum as boolean) as string
    if json.Type = "Episode"
        name = json.Name ?? ""
        if isValid(json.ParentIndexNumber) and isValid(json.IndexNumber) then return `S${json.ParentIndexNumber.toStr()}:E${json.IndexNumber.toStr()} - ${name}`
        return name
    end if
    if isAudiobook then return ""

    artist = json.AlbumArtist ?? ""
    if isValidAndNotEmpty(json.Artists) then artist = json.Artists.join(", ")
    if showAlbum and isValidAndNotEmpty(json.Album)
        if artist <> "" then return `${json.Album} • ${artist}`
        return json.Album
    end if
    return artist
end function

' The rows of a track list as nodes the modal draws. Each keeps its place in the list it
' came from, since that is the position playback is asked for. A playlist counts its own
' positions, since its tracks carry the numbers they had on their own albums.
function spotlightTrackNodes(tracks as object, countsPositions as boolean, isAudiobook as boolean) as object
    nodes = []
    for position = 0 to tracks.count() - 1
        track = tracks[position]
        json = track.json

        number = position + 1
        if not countsPositions and isValid(json.IndexNumber) then number = json.IndexNumber

        title = json.Name ?? ""
        if json.Type = "Episode" and isValidAndNotEmpty(json.SeriesName) then title = json.SeriesName

        detailParts = []
        subtitle = spotlightTrackSubtitle(json, isAudiobook, countsPositions)
        if subtitle <> "" then detailParts.push(subtitle)
        runtime = spotlightTrackRuntime(json.RunTimeTicks, json.Type = "Audio")
        if runtime <> "" then detailParts.push(runtime)

        node = CreateObject("roSGNode", "ContentNode")
        node.id = json.Id ?? ""
        node.addFields({
            numberText: number.toStr(),
            titleText: title,
            detailText: detailParts.join(" • "),
            trackIndex: track.index,
            disc: json.ParentIndexNumber ?? 1
        })
        nodes.push(node)
    end for
    return nodes
end function

' An album that spans more than one disc lists each under its own heading
function spotlightTrackSections(tracks as object, title as string, groupByDisc as boolean) as object
    discs = []
    byDisc = {}
    for each track in tracks
        key = track.disc.toStr()
        if not byDisc.DoesExist(key)
            byDisc[key] = []
            discs.push(track.disc)
        end if
        byDisc[key].push(track)
    end for

    if not groupByDisc or discs.count() < 2 then return [{ kind: "tracks", title: title, count: tracks.count(), items: tracks }]

    sections = []
    for each disc in discs
        items = byDisc[disc.toStr()]
        sections.push({ kind: "tracks", title: tr("Disc {number}").replace("{number}", disc.toStr()), count: 0, items: items })
    end for
    return sections
end function

' Where a title was released, or where its year starts when that is all it has
function spotlightReleasedSeconds(item as object) as dynamic
    premiere = chainLookupReturn(item, "json.PremiereDate", "")
    if Len(premiere) >= 10
        date = CreateObject("roDateTime")
        date.FromISO8601String(Left(premiere, 10) + "T00:00:00Z")
        return date.AsSeconds()
    end if

    year = chainLookupReturn(item, "json.ProductionYear", 0)
    if year > 0
        date = CreateObject("roDateTime")
        date.FromISO8601String(year.toStr() + "-01-01T00:00:00Z")
        return date.AsSeconds()
    end if
    return invalid
end function

' Slots the titles the library is missing in by release date, leaving the order the
' server gave the library alone. Each lands in front of the first title released after
' it, or at the end when nothing is.
function spotlightMergeMissing(library as object, missing as object) as object
    merged = []
    merged.append(library)
    if not isValidAndNotEmpty(missing) then return merged

    for each item in missing
        released = spotlightReleasedSeconds(item)
        at = merged.count()
        if isValid(released)
            for i = 0 to merged.count() - 1
                other = spotlightReleasedSeconds(merged[i])
                if isValid(other) and released < other
                    at = i
                    exit for
                end if
            end for
        end if

        placed = []
        for i = 0 to merged.count() - 1
            if i = at then placed.push(item)
            placed.push(merged[i])
        end for
        if at = merged.count() then placed.push(item)
        merged = placed
    end for
    return merged
end function

' Which artwork a summary card leads with, and the landscape thumbnail a wider
' card takes, both shared with the Nouveau screen
function spotlightItemImageUrl(_serverUrl as string, item as object) as string
    return detailImages.ItemImageUrl(item)
end function

function spotlightLandscapeImageUrl(_serverUrl as string, item as object) as string
    return detailImages.LandscapeImageUrl(item)
end function

function spotlightFirstPosterUrl(serverUrl as string, items as object) as string
    if not isValidAndNotEmpty(items) then return ""
    for each item in items
        url = spotlightItemImageUrl(serverUrl, item)
        if isValidAndNotEmpty(url) then return url
    end for
    return ""
end function

function spotlightFirstLandscapeUrl(serverUrl as string, items as object) as string
    if not isValidAndNotEmpty(items) then return ""
    for each item in items
        url = spotlightLandscapeImageUrl(serverUrl, item)
        if isValidAndNotEmpty(url) then return url
    end for
    return ""
end function

' Each card is built as an AA the screen can render directly.
function spotlightCardsFor(state as object) as object
    builder = spotlightCardBuilder(state)
    return builder.build()
end function
function spotlightCardBuilder(state as object) as object
    ' Every entry here is a builder that reads s off m, so they are dispatched
    ' as members of this object rather than called by name. Calling one by name
    ' would bind m to the screen, whose s does not exist.
    return {
        s: state,
        build: spotlightBuilderBuild,
        factories: spotlightBuilderFactories,
        makeCard: spotlightBuilderMakeCard,
        peopleCard: spotlightBuilderPeopleCard,
        similarCard: spotlightBuilderSimilarCard,
        seasonsCard: spotlightBuilderSeasonsCard,
        episodesCard: spotlightBuilderEpisodesCard,
        moreEpisodesCard: spotlightBuilderMoreEpisodesCard,
        seerrDetailsCard: spotlightBuilderSeerrDetailsCard,
        tracksCard: spotlightBuilderTracksCard,
        playlistCard: spotlightBuilderPlaylistCard,
        albumsCard: spotlightBuilderAlbumsCard,
        boxSetItemsCard: spotlightBuilderBoxSetItemsCard,
        chaptersExtrasCard: spotlightBuilderChaptersExtrasCard,
        collectionsCard: spotlightBuilderCollectionsCard
    }
end function

' The card ids this item qualifies for, in the order the band draws them. An array
' on purpose, because an associative array iterates in hash order and scrambles the
' band. An id whose builder is still missing is skipped by build.
function spotlightBuilderFactories() as object
    s = m.s
    if isValid(s.seerrOnly) and s.seerrOnly = true
        return ["seerr_details", "people", "similar"]
    end if

    itemType = LCase(chainLookupReturn(s.item, "json.Type", chainLookupReturn(s.item, "Type", "")))
    if itemType = "series"
        return ["seasons", "people", "chapters_extras", "similar", "collections"]
    else if itemType = "season"
        return ["episodes", "people", "chapters_extras", "similar"]
    else if itemType = "episode"
        return ["episodes", "people", "chapters_extras", "similar"]
    else if itemType = "musicalbum" or itemType = "audiobook" or itemType = "book"
        return ["tracks", "similar"]
    else if itemType = "playlist"
        return ["playlist"]
    else if itemType = "musicartist"
        return ["albums", "similar"]
    else if itemType = "person"
        return ["filmography"]
    else if itemType = "boxset"
        return ["boxset_items", "people", "playlist_order"]
    end if
    return ["people", "chapters_extras", "similar", "collections"]
end function

function spotlightBuilderBuild() as object
    factories = m.factories()
    cards = []
    for each key in factories
        card = m.makeCard(key)
        if isValid(card) then cards.push(card)
    end for
    return cards
end function

function spotlightBuilderMakeCard(id as string) as dynamic
    if id = "people" then return m.peopleCard()
    if id = "similar" then return m.similarCard()
    if id = "seasons" then return m.seasonsCard()
    if id = "episodes"
        if LCase(chainLookupReturn(m.s.item, "json.Type", "")) = "episode" then return m.moreEpisodesCard()
        return m.episodesCard()
    end if
    if id = "seerr_details" then return m.seerrDetailsCard()
    if id = "tracks" then return m.tracksCard()
    if id = "playlist" then return m.playlistCard()
    if id = "albums" then return m.albumsCard()
    if id = "boxset_items" then return m.boxSetItemsCard()
    if id = "chapters_extras" then return m.chaptersExtrasCard()
    if id = "collections" then return m.collectionsCard()
    return invalid
end function

' The people behind the item, plus its studios
function spotlightBuilderPeopleCard() as dynamic
    s = m.s
    people = spotlightDedupePeople(s.cast)
    crewItems = s.crew
    studioCards = s.studioCards
    if people.count() = 0 and crewItems.count() = 0 and studioCards.count() = 0 then return invalid

    ' Someone in both the cast and the crew is still one person
    keys = {}
    for each group in [people, crewItems]
        for each person in group
            key = spotlightPersonKey(person)
            if key <> "" then keys[key] = true
        end for
    end for

    subtitleParts = []
    if keys.count() > 0 then subtitleParts.push(spotlightCountLabel(keys.count(), tr("1 person"), tr("{count} people")))
    if studioCards.count() > 0 then subtitleParts.push(spotlightCountLabel(studioCards.count(), tr("1 studio"), tr("{count} studios")))

    cardSections = []
    if people.count() > 0 then cardSections.push({ kind: "people", title: tr("Cast"), count: people.count(), items: people })
    if crewItems.count() > 0 then cardSections.push({ kind: "people", title: tr("Crew"), count: crewItems.count(), items: crewItems })
    if studioCards.count() > 0 then cardSections.push({ kind: "studios", title: tr("Studios"), count: studioCards.count(), items: studioCards })

    return {
        id: "people",
        title: tr("Cast, Crew, and Studios"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: s.fallbackImageUrl,
        iconKey: "people",
        sections: cardSections
    }
end function

function spotlightBuilderChaptersExtrasCard() as dynamic
    s = m.s
    itemData = chainLookupReturn(s.item, "json", {})
    chapters = spotlightChapterNodes(itemData)
    extras = s.extras
    if chapters.count() = 0 and extras.count() = 0 then return invalid

    subtitleParts = []
    if chapters.count() > 0 then subtitleParts.push(spotlightCountLabel(chapters.count(), tr("1 chapter"), tr("{count} chapters")))
    if extras.count() > 0 then subtitleParts.push(spotlightCountLabel(extras.count(), tr("1 extra"), tr("{count} extras")))

    cardImage = spotlightFirstChapterImageUrl(itemData)
    if cardImage = "" and extras.count() > 0 then cardImage = spotlightLandscapeImageUrl(s.serverUrl, extras[0])
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    cardSections = []
    if chapters.count() > 0 then cardSections.push({ kind: "chapters", title: tr("Chapters"), count: chapters.count(), items: chapters })
    cardSections.append(spotlightExtraSections(extras))

    return {
        id: "chapters_extras",
        title: tr("Chapters and Extras"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: cardImage,
        iconKey: "chapters_extras",
        sections: cardSections
    }
end function

' Each collection the title is in, led by the collection itself so there is a way into
' it, then its titles with any the library is missing slotted in by release date
function spotlightBuilderCollectionsCard() as dynamic
    s = m.s
    collections = s.parentCollections
    if collections.count() = 0 then return invalid

    cardSections = []
    cardImage = ""
    for each collection in collections
        sectionItems = [collection.boxSet]
        sectionItems.append(spotlightMergeMissing(collection.items, collection.missing))
        cardSections.push({ kind: "media", title: collection.name, count: sectionItems.count(), items: sectionItems, aspect: "portrait" })

        if cardImage = "" then cardImage = spotlightFirstLandscapeUrl(s.serverUrl, collection.items)
    end for
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    return {
        id: "collections",
        title: tr("Collections"),
        subtitle: spotlightCountLabel(collections.count(), tr("1 collection"), tr("{count} collections")),
        imageUrl: cardImage,
        iconKey: "collections",
        sections: cardSections
    }
end function

' The similar card: library similar items first, then what Seerr recommends and
' holds as similar. Named for where the list actually came from.
function spotlightBuilderSimilarCard() as dynamic
    s = m.s
    similar = s.similar
    recommendations = []
    seerrSimilar = []
    if isValidAndNotEmpty(s.seerrRecommendations) then recommendations = s.seerrRecommendations
    if isValidAndNotEmpty(s.seerrSimilar) then seerrSimilar = s.seerrSimilar
    if similar.count() = 0 and recommendations.count() = 0 and seerrSimilar.count() = 0 then return invalid

    if isValidAndNotEmpty(s.similarSource) and s.similarSource = "moonfin"
        libraryTitle = tr("Moonfin Recommends")
    else if isValidAndNotEmpty(s.similarSource) and s.similarSource = "tmdb"
        libraryTitle = tr("TMDb")
    else
        libraryTitle = tr("Similar")
    end if

    total = similar.count() + recommendations.count() + seerrSimilar.count()
    cardSections = []
    ' What Seerr knows about the title itself, ahead of the lists. A Seerr only title keeps these
    ' on its own Details card, so repeating them would show them twice.
    if not s.seerrOnly
        if s.seerrChipCount > 0 then cardSections.push({ kind: "seerrChips", tags: s.seerrTags, mediaType: s.seerrMediaType })
        if s.seerrFacts.count() > 0 then cardSections.push({ kind: "seerrFacts", facts: s.seerrFacts })
    end if
    if similar.count() > 0 then cardSections.push({ kind: "media", title: libraryTitle, count: similar.count(), items: similar, aspect: "portrait" })
    if recommendations.count() > 0 then cardSections.push({ kind: "seerr", title: tr("Recommendations (Seerr)"), count: recommendations.count(), items: recommendations })
    if seerrSimilar.count() > 0
        seerrTitle = similar.count() > 0 ? tr("Similar (Seerr)") : tr("Similar")
        cardSections.push({ kind: "seerr", title: seerrTitle, count: seerrSimilar.count(), items: seerrSimilar })
    end if

    cardImage = ""
    if similar.count() > 0
        cardImage = spotlightLandscapeImageUrl(s.serverUrl, similar[0])
    else if recommendations.count() > 0
        cardImage = spotlightFirstLandscapeUrl(s.serverUrl, recommendations)
    else if seerrSimilar.count() > 0
        cardImage = spotlightFirstLandscapeUrl(s.serverUrl, seerrSimilar)
    end if
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    return {
        id: "similar",
        title: tr("Recommendations"),
        subtitle: spotlightCountLabel(total, tr("1 title"), tr("{count} titles")),
        imageUrl: cardImage,
        iconKey: "similar",
        sections: cardSections
    }
end function

' Seerr's tags and facts get a card rather than a place on the hero, where nothing above the
' action row has a path into them
function spotlightBuilderSeerrDetailsCard() as dynamic
    s = m.s
    chipCount = s.seerrChipCount
    factCount = s.seerrFacts.count()
    if chipCount = 0 and factCount = 0 then return invalid

    subtitleParts = []
    if factCount > 0 then subtitleParts.push(spotlightCountLabel(factCount, tr("1 fact"), tr("{count} facts")))
    if chipCount > 0 then subtitleParts.push(spotlightCountLabel(chipCount, tr("1 tag"), tr("{count} tags")))

    ' The modal opens on its first section, so the chips lead and the remote lands on something
    ' it can press
    cardSections = []
    if chipCount > 0 then cardSections.push({ kind: "seerrChips", title: tr("Genres and Tags"), count: chipCount, tags: s.seerrTags, mediaType: s.seerrMediaType })
    if factCount > 0 then cardSections.push({ kind: "seerrFacts", facts: s.seerrFacts })

    return {
        id: "seerr_details",
        title: tr("Details"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: s.fallbackImageUrl,
        iconKey: "seerr_details",
        sections: cardSections
    }
end function

function spotlightBuilderSeasonsCard() as dynamic
    s = m.s
    seasonItems = s.seasons
    if seasonItems.count() = 0 then return invalid

    episodeCount = s.seriesEpisodes.count()
    if episodeCount = 0 then episodeCount = chainLookupReturn(s.item, "json.RecursiveItemCount", 0)

    showName = ""
    itemName = chainLookupReturn(s.item, "json.Name", "")
    if isValidAndNotEmpty(itemName) then showName = itemName

    cardSections = [{ kind: "media", title: tr("Seasons"), count: seasonItems.count(), items: seasonItems, aspect: "portrait" }]
    subtitleParts = [spotlightCountLabel(seasonItems.count(), tr("1 season"), tr("{count} seasons"))]
    if episodeCount > 0 then subtitleParts.push(spotlightCountLabel(episodeCount, tr("1 episode"), tr("{count} episodes")))

    cardImage = spotlightFirstPosterUrl(s.serverUrl, seasonItems)
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    return {
        id: "seasons",
        title: tr("Seasons"),
        modalTitle: isValidAndNotEmpty(showName) ? showName : tr("Seasons"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: cardImage,
        sections: cardSections
    }
end function

function spotlightBuilderEpisodesCard() as dynamic
    s = m.s
    episodeItems = s.episodes
    if episodeItems.count() = 0 then episodeItems = s.seriesEpisodes
    if episodeItems.count() = 0 then return invalid

    seriesName = chainLookupReturn(s.item, "json.SeriesName", "")
    itemName = chainLookupReturn(s.item, "json.Name", "")
    cardModalTitle = itemName
    if isValidAndNotEmpty(seriesName) then cardModalTitle = seriesName + " - " + itemName

    cardImage = spotlightFirstPosterUrl(s.serverUrl, episodeItems)
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    return {
        id: "episodes",
        title: tr("Episodes"),
        modalTitle: cardModalTitle,
        subtitle: spotlightCountLabel(episodeItems.count(), tr("1 episode"), tr("{count} episodes")),
        imageUrl: cardImage,
        iconKey: "episodes",
        sections: [{ kind: "media", title: tr("Episodes"), count: episodeItems.count(), items: episodeItems, aspect: "landscape" }]
    }
end function

' The whole run rather than just this episode's season, a foldable section per season with only
' the one being watched left open
function spotlightBuilderMoreEpisodesCard() as dynamic
    s = m.s
    all = s.seriesEpisodes
    if all.count() = 0 then all = s.episodes
    if all.count() = 0 then return invalid

    currentSeason = chainLookupReturn(s.item, "json.ParentIndexNumber", invalid)
    ordered = []
    for each episode in all
        ordered.push({ season: spotlightEpisodeSeason(episode, currentSeason), index: chainLookupReturn(episode, "json.IndexNumber", 0), node: episode })
    end for
    ordered.SortBy("index")
    ordered.SortBy("season")

    groups = []
    for each entry in ordered
        if groups.count() = 0 or groups[groups.count() - 1].season <> entry.season then groups.push({ season: entry.season, items: [] })
        groups[groups.count() - 1].items.push(entry.node)
    end for

    ' A show with one season has nothing to choose between, so it opens. Otherwise the season
    ' number says which one is being watched, and where an episode carries no number the section
    ' holding it does.
    itemId = chainLookupReturn(s.item, "json.Id", "")
    seasonId = chainLookupReturn(s.item, "json.SeasonId", "")
    cardSections = []
    for each group in groups
        expanded = groups.count() = 1
        if not expanded and isValid(currentSeason)
            expanded = group.season = currentSeason
        else if not expanded
            for each episode in group.items
                if chainLookupReturn(episode, "json.Id", "") = itemId or (seasonId <> "" and chainLookupReturn(episode, "json.SeasonId", "") = seasonId) then expanded = true
            end for
        end if

        cardSections.push({
            kind: "media",
            title: nouveauLayout.SeasonLabel(group.season),
            count: group.items.count(),
            items: group.items,
            aspect: "landscape",
            id: `season-${group.season}`,
            collapsible: true,
            expanded: expanded
        })
    end for

    subtitleParts = []
    if groups.count() > 1 then subtitleParts.push(spotlightCountLabel(groups.count(), tr("1 season"), tr("{count} seasons")))
    subtitleParts.push(spotlightCountLabel(all.count(), tr("1 episode"), tr("{count} episodes")))

    cardImage = spotlightFirstPosterUrl(s.serverUrl, all)
    if not isValidAndNotEmpty(cardImage) then cardImage = s.fallbackImageUrl

    return {
        id: "episodes",
        title: tr("More Episodes"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: cardImage,
        iconKey: "episodes",
        sections: cardSections
    }
end function

' An episode with no season of its own goes with the one being watched, or the first
function spotlightEpisodeSeason(episode as object, currentSeason as dynamic) as integer
    season = chainLookupReturn(episode, "json.ParentIndexNumber", invalid)
    if isValid(season) then return season
    if isValid(currentSeason) then return currentSeason
    return 1
end function

function spotlightBuilderTracksCard() as dynamic
    s = m.s
    tracks = s.albumTracks
    if tracks.count() = 0 then return invalid

    totalTicks = 0
    for each ticks in s.albumTrackTicks
        totalTicks += ticks
    end for

    subtitleParts = [spotlightCountLabel(tracks.count(), tr("1 track"), tr("{count} tracks"))]
    if totalTicks > 0 then subtitleParts.push(spotlightRuntimeLabel(totalTicks))

    itemType = LCase(chainLookupReturn(s.item, "json.Type", ""))
    return {
        id: "tracks",
        title: tr("Track List"),
        subtitle: spotlightJoinSubtitle(subtitleParts),
        imageUrl: spotlightItemImageUrl(s.serverUrl, s.item),
        iconKey: "tracks",
        sections: spotlightTrackSections(tracks, tr("Track List"), itemType = "musicalbum")
    }
end function


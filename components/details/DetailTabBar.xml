<?xml version="1.0" encoding="utf-8"?>
<component name="DetailTabBar" extends="Group">
    <children>
        <!-- Single rounded container behind all tabs, on the glass the other
            clients rest theirs on -->
        <Poster id="barBg" uri="pkg:/images/icons/pill-focus.9.png" width="200" height="63"
            blendColor="#FFFFFF" opacity="0.08" />
        <!-- One thumb that slides to the focused tab, with its outline over it -->
        <Poster id="focusPill" uri="pkg:/images/icons/pill-focus.9.png" width="100" height="55"
            blendColor="#FFFFFF" opacity="0.22" visible="false" />
        <Poster id="focusRing" uri="pkg:/images/details/tabborderfocus.9.png" width="100" height="55"
            blendColor="#FFFFFF" visible="false" />
        <Group id="labelRow" />
        <!-- Never shown, it just lends its font to the tabs built at runtime -->
        <Label id="tabFont" font="font:MediumBoldSystemFont" visible="false" />
        <Animation id="pillAnim" duration="0.15" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="pillPosInterp" key="[0.0, 1.0]" fieldToInterp="focusPill.translation" />
            <FloatFieldInterpolator id="pillWidthInterp" key="[0.0, 1.0]" fieldToInterp="focusPill.width" />
        </Animation>
    </children>
    <interface>
        <!-- Array of { id, label } describing each tab -->
        <field id="tabs" type="array" onChange="onTabsChanged" />
        <!-- Index of the tab whose content is shown, -1 when collapsed -->
        <field id="selectedIndex" type="integer" value="-1" alwaysNotify="true" />
        <!-- With Expanded Tabs on, focus follows selection -->
        <field id="expanded" type="boolean" value="true" />
        <field id="focusIndex" type="integer" value="0" />
        <!-- Fires the direction when focus leaves the bar -->
        <field id="escape" type="string" alwaysNotify="true" />
        <!-- The index the viewer pressed, which a screen reads when it wants to tell a
            press from the focus merely passing over a tab -->
        <field id="activated" type="integer" value="-1" alwaysNotify="true" />
        <!-- Right off the last tab fires escape too, for a bar with something beside it -->
        <field id="escapeRight" type="boolean" value="false" />
        <!-- Left off the first tab fires escape too, for a screen with no nav to hand it to -->
        <field id="escapeLeft" type="boolean" value="false" />
        <!-- How big the tabs are drawn, read when the tabs are set -->
        <field id="segmentHeight" type="integer" value="55" />
        <field id="segmentPadX" type="integer" value="22" />
        <field id="barPad" type="integer" value="4" />
        <field id="textSize" type="integer" value="23" />
        <!-- The room the bar has. Past it the tabs slide rather than running off the edge -->
        <field id="maxWidth" type="float" value="0" />
    </interface>
</component>

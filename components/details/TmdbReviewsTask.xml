<?xml version="1.0" encoding="utf-8"?>
<component name="TmdbReviewsTask" extends="Task">
    <interface>
        <!-- { tmdbId, mediaType } from tmdbReviews.Target -->
        <field id="target" type="assocarray" />
        <!-- The reviews as tmdbReviews.Parse hands them over, set once, empty when there are none -->
        <field id="reviews" type="array" alwaysNotify="true" />
    </interface>
</component>

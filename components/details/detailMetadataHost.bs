import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/detailMetadataLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/upcomingEpisode.bs"

import "pkg:/source/enums/ImageType.bs"

const STATUS_PAD_H = 12
const STATUS_PAD_V = 3
const STATUS_CONTINUING_COLOR = "#2E7D32"
const STATUS_ENDED_COLOR = "#B71C1C"

' The title, year, runtime and tagline block, shared by the classic and modern detail
' screens so both behave the same. These run in the host screen's scope, so m is
' whichever screen imported them. Each screen keeps its own init() and node
' observers, this file has none.
'
' Hooks each screen provides:
'   sub buildStreamSummary(itemData as object)
'   function backdropSourceFor(itemData as object) as object
'   function backdropRequestParams(params as object) as object

sub updateStatusBadge(itemData as object)
    badge = m.top.findNode("statusBadge")
    if not isValid(badge) then return

    label = m.top.findNode("statusBadgeText")
    bg = m.top.findNode("statusBadgeBg")
    if not isValid(label) or not isValid(bg) then return

    text = ""
    badgeColor = STATUS_CONTINUING_COLOR
    if isSeries() and isValid(itemData.Status)
        if isStringEqual(itemData.Status, "Continuing")
            text = tr("Continuing")
        else if isStringEqual(itemData.Status, "Ended")
            text = tr("Ended")
            badgeColor = STATUS_ENDED_COLOR
        end if
    end if

    if text = ""
        badge.visible = false
        return
    end if

    label.width = 0
    label.height = 0
    label.text = text
    bounds = label.boundingRect()

    bg.width = bounds.width + STATUS_PAD_H * 2
    bg.height = bounds.height + STATUS_PAD_V * 2
    bg.blendColor = badgeColor
    label.width = bg.width
    label.height = bg.height
    badge.visible = true
end sub

sub updateUpcomingBadge(itemData as object)
    badge = m.top.findNode("upcomingBadge")
    if not isValid(badge) then return

    label = m.top.findNode("upcomingBadgeText")
    icon = m.top.findNode("upcomingBadgeIcon")
    bg = m.top.findNode("upcomingBadgeBg")
    if not isValid(label) or not isValid(bg) then return

    text = ""
    if isSeries()
        text = upcomingEpisode.ResolveUpcomingEpisodeText(itemData, m.global)
    end if

    if text = ""
        badge.visible = false
        return
    end if

    label.width = 0
    label.height = 0
    label.text = text
    bounds = label.boundingRect()

    iconW = 18
    iconGap = 6
    if isValid(icon)
        iconW = icon.width
    end if

    contentW = iconW + iconGap + bounds.width
    bg.width = contentW + STATUS_PAD_H * 2
    bg.height = bounds.height + STATUS_PAD_V * 2
    bg.blendColor = "#00A4DC"

    if isValid(icon)
        icon.translation = [STATUS_PAD_H, (bg.height - icon.height) / 2]
    end if
    label.translation = [STATUS_PAD_H + iconW + iconGap, (bg.height - bounds.height) / 2]
    label.width = bounds.width
    label.height = bounds.height

    badge.visible = true
end sub

sub hideEpisodeHeader()
    episodeHeaderNode = m.top.findNode("episodeHeader")
    if isValid(episodeHeaderNode)
        episodeHeaderNode.visible = false
    end if
end sub

sub populateMovieMetadata(itemData as object)
    hideEpisodeHeader()

    if isValid(itemData.PremiereDate)
        releaseDate = CreateObject("roDateTime")
        releaseDate.FromISO8601String(itemData.PremiereDate)
        setFieldText("releaseYear", stri(releaseDate.GetYear()).trim())
    else if isValid(itemData.productionYear)
        setFieldText("releaseYear", itemData.productionYear)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    if isValidAndNotEmpty(itemData.Taglines)
        setFieldText("tagline", itemData.Taglines[0])
    end if

    buildStreamSummary(itemData)
end sub

sub populateSeriesMetadata(itemData as object)
    hideEpisodeHeader()

    if isValid(itemData.productionYear)
        setFieldText("releaseYear", itemData.productionYear)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    if isChainValid(itemData, "ChildCount") and itemData.ChildCount > 0
        seasonText = stri(itemData.ChildCount).trim()
        if itemData.ChildCount = 1
            seasonText += " Season"
        else
            seasonText += " Seasons"
        end if
        setFieldText("seasonCount", seasonText)
    end if

    if isValidAndNotEmpty(itemData.Taglines)
        setFieldText("tagline", itemData.Taglines[0])
    end if
end sub

sub populateRuntime(itemData as object)
    ' Series don't have runtime or an ends at value, so the season count shows instead
    if isSeries()
        setFieldText("runtime", "")
        setFieldText("endsAt", "")
        return
    end if

    if type(itemData.RunTimeTicks) = "LongInteger"
        setFieldText("runtime", getFormattedRuntime(itemData.RunTimeTicks))
        endsAtText = tr("Ends at %1").Replace("%1", getEndTimeFromTicks(itemData.RunTimeTicks))
        setFieldText("endsAt", endsAtText)
    else
        setFieldText("runtime", "")
        setFieldText("endsAt", "")
    end if
end sub

function getMonthName(month as integer) as string
    months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if month >= 1 and month <= 12
        return months[month - 1]
    end if
    return ""
end function

sub setBackdropImage(itemData as object)
    backdropPoster = m.top.findNode("backdrop")
    if not isValid(backdropPoster) then return

    ' A Seerr title has no library images, so it carries finished TMDB urls instead
    if isValidAndNotEmpty(itemData._externalBackdropUrl)
        backdropPoster.uri = itemData._externalBackdropUrl
        return
    end if

    serverBaseUrl = invalid
    if isChainValid(itemData, "_serverUrl")
        serverBaseUrl = itemData._serverUrl
        if serverBaseUrl.right(1) = "/"
            serverBaseUrl = serverBaseUrl.left(serverBaseUrl.len() - 1)
        end if
    end if

    backdropSource = backdropSourceFor(itemData)
    if not isValid(backdropSource.imageTag) then return

    params = backdropRequestParams({
        "maxWidth": 1920,
        "maxHeight": 1080,
        "quality": 90,
        "Tag": backdropSource.imageTag
    })

    backdropUrl = invalid
    if isValid(serverBaseUrl)
        backdropUrl = buildImageURLForServer(serverBaseUrl, backdropSource.backdropItemId, backdropSource.imageVersion, params)
    else
        backdropUrl = ImageURL(backdropSource.backdropItemId, backdropSource.imageVersion, params)
    end if

    if isValid(backdropUrl)
        backdropPoster.uri = backdropUrl
    end if
end sub

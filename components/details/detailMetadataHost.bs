import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/detailMetadataLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/multiserver.bs"
import "pkg:/source/utils/seerrStatusPills.bs"
import "pkg:/source/utils/themeChrome.bs"

import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/TaskControl.bs"

const STATUS_PAD_H = 12
const STATUS_PAD_V = 3
const STATUS_CONTINUING_COLOR = "#2E7D32"
const STATUS_ENDED_COLOR = "#B71C1C"
const SEERR_PILL_PAD_H = 15
const SEERR_PILL_PAD_V = 6
const SEERR_PILL_GAP = 12

' The title, year, runtime and tagline block, shared by the classic and modern detail
' screens so both behave the same. These run in the host screen's scope, so m is
' whichever screen imported them. Each screen keeps its own init() and node
' observers, this file has none.
'
' Hooks each screen provides:
'   sub buildStreamSummary(itemData as object)
'   function backdropSourceFor(itemData as object) as object
'   function backdropRequestParams(params as object) as object

sub updateStatusBadge(itemData as object)
    badge = m.top.findNode("statusBadge")
    if not isValid(badge) then return

    label = m.top.findNode("statusBadgeText")
    bg = m.top.findNode("statusBadgeBg")
    if not isValid(label) or not isValid(bg) then return

    text = ""
    badgeColor = STATUS_CONTINUING_COLOR
    if isSeries() and isValidAndNotEmpty(itemData.Status)
        if isStringEqual(itemData.Status, "Ended")
            text = tr("Ended")
            badgeColor = STATUS_ENDED_COLOR
        else if isStringEqual(itemData.Status, "Continuing")
            text = tr("Continuing")
        else if m.statusShowsAnyValue ?? false
            ' Spotlight shows whatever else the server calls it, Unreleased or a Seerr title's
            ' Canceled or In Production, as the server wrote it
            text = itemData.Status
        end if
    end if

    if text = ""
        badge.visible = false
        return
    end if

    label.width = 0
    label.height = 0
    label.text = text
    bounds = label.boundingRect()

    bg.width = bounds.width + STATUS_PAD_H * 2
    bg.height = bounds.height + STATUS_PAD_V * 2
    bg.blendColor = badgeColor
    label.width = bg.width
    label.height = bg.height
    badge.visible = true
end sub

' What Seerr says about the title, one pill per quality track. It stays quiet unless there is more
' to the story than owning it, since a green Available on every title in the library is noise.
sub updateSeerrPills()
    group = m.top.findNode("seerrPills")
    if not isValid(group) then return

    group.removeChildrenIndex(group.getChildCount(), 0)
    m.seerrPillsSize = { width: 0, height: 0 }

    pills = []
    if GetSeerrConfig().enabled then pills = seerrStatusPills.Build(m.seerrDetails)
    group.visible = pills.count() > 0
    if not group.visible then return

    font = m.top.findNode("statusBadgeText").font
    x = 0
    height = 0
    for each pill in pills
        colors = seerrStatusPills.Colors(pill.tone)
        chip = group.createChild("Group")

        fill = chip.createChild("Poster")
        fill.uri = "pkg:/images/details/surface8.9.png"
        fill.loadDisplayMode = "scaleToFit"
        fill.blendColor = colors.fill

        border = chip.createChild("Poster")
        border.uri = "pkg:/images/details/outline8.9.png"
        border.loadDisplayMode = "scaleToFit"
        border.blendColor = colors.border

        label = chip.createChild("Label")
        label.font = font
        label.color = colors.text
        label.text = pill.text
        label.translation = [SEERR_PILL_PAD_H, SEERR_PILL_PAD_V]

        bounds = label.boundingRect()
        width = bounds.width + SEERR_PILL_PAD_H * 2
        pillHeight = bounds.height + SEERR_PILL_PAD_V * 2
        fill.width = width
        fill.height = pillHeight
        border.width = width
        border.height = pillHeight
        chip.translation = [x, 0]

        x += width + SEERR_PILL_GAP
        if pillHeight > height then height = pillHeight
    end for

    m.seerrPillsSize = { width: x - SEERR_PILL_GAP, height: height }
end sub

' The air date comes over the network, so the badge draws when the task answers
' rather than holding the screen up while it asks
sub updateUpcomingBadge(itemData as object)
    badge = m.top.findNode("upcomingBadge")
    if not isValid(badge) then return

    badge.visible = false
    if not isSeries() and not (m.upcomingIncludesSeasons = true and LCase(m.top.itemType) = "season") then return

    if isValid(m.upcomingEpisodeTask)
        m.upcomingEpisodeTask.unobserveField("text")
        m.upcomingEpisodeTask.control = TaskControl.STOP
    end if

    m.upcomingEpisodeTask = createObject("roSGNode", "FetchUpcomingEpisodeTask")
    m.upcomingEpisodeTask.itemData = itemData
    m.upcomingEpisodeTask.observeField("text", "onUpcomingEpisodeResolved")
    m.upcomingEpisodeTask.control = TaskControl.RUN
end sub

sub onUpcomingEpisodeResolved(event as object)
    drawUpcomingBadge(event.getData())
    layoutMetadataRow()
    layoutContainer()
end sub

sub drawUpcomingBadge(text as string)
    badge = m.top.findNode("upcomingBadge")
    if not isValid(badge) then return

    label = m.top.findNode("upcomingBadgeText")
    icon = m.top.findNode("upcomingBadgeIcon")
    bg = m.top.findNode("upcomingBadgeBg")
    if not isValid(label) or not isValid(bg) then return

    if text = ""
        badge.visible = false
        return
    end if

    label.width = 0
    label.height = 0
    label.text = text
    bounds = label.boundingRect()

    iconW = 0
    iconGap = 0
    if isValid(icon)
        iconW = icon.width
        iconGap = 6
    end if

    contentW = iconW + iconGap + bounds.width
    bg.width = contentW + STATUS_PAD_H * 2
    bg.height = bounds.height + STATUS_PAD_V * 2
    bg.blendColor = themeChrome.Accent()

    if isValid(icon)
        icon.translation = [STATUS_PAD_H, (bg.height - icon.height) / 2]
    end if
    label.translation = [STATUS_PAD_H + iconW + iconGap, (bg.height - bounds.height) / 2]
    label.width = bounds.width
    label.height = bounds.height

    badge.visible = true
end sub

sub hideEpisodeHeader()
    episodeHeaderNode = m.top.findNode("episodeHeader")
    if isValid(episodeHeaderNode)
        episodeHeaderNode.visible = false
    end if
end sub

sub populateMovieMetadata(itemData as object)
    hideEpisodeHeader()

    if isValid(itemData.PremiereDate)
        releaseDate = CreateObject("roDateTime")
        releaseDate.FromISO8601String(itemData.PremiereDate)
        setFieldText("releaseYear", stri(releaseDate.GetYear()).trim())
    else if isValid(itemData.productionYear)
        setFieldText("releaseYear", itemData.productionYear)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    if isValidAndNotEmpty(itemData.Taglines)
        setFieldText("tagline", itemData.Taglines[0])
    end if

    buildStreamSummary(itemData)
end sub

sub populateSeriesMetadata(itemData as object)
    hideEpisodeHeader()

    if isValid(itemData.productionYear)
        setFieldText("releaseYear", itemData.productionYear)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    if isChainValid(itemData, "ChildCount") and itemData.ChildCount > 0
        seasonText = stri(itemData.ChildCount).trim()
        if itemData.ChildCount = 1
            seasonText += " Season"
        else
            seasonText += " Seasons"
        end if
        setFieldText("seasonCount", seasonText)
    end if

    if isValidAndNotEmpty(itemData.Taglines)
        setFieldText("tagline", itemData.Taglines[0])
    end if
end sub

sub populateSeasonMetadata(itemData as object)
    episodeHeaderNode = m.top.findNode("episodeHeader")
    if isValid(episodeHeaderNode)
        if isValidAndNotEmpty(itemData.SeriesName)
            episodeHeaderNode.text = itemData.SeriesName
            episodeHeaderNode.visible = true
        else
            episodeHeaderNode.visible = false
        end if
    end if

    if isValid(itemData.productionYear)
        setFieldText("releaseYear", itemData.productionYear)
    else if isValid(itemData.PremiereDate)
        d = CreateObject("roDateTime")
        d.FromISO8601String(itemData.PremiereDate)
        setFieldText("releaseYear", stri(d.GetYear()).trim())
    end if

    epCount = 0
    if isChainValid(itemData, "ChildCount") then epCount = itemData.ChildCount
    if epCount = 0 and isValid(m.seasonEpisodes) then epCount = m.seasonEpisodes.count()
    if epCount > 0
        countText = stri(epCount).trim() + " "
        if epCount = 1
            countText += tr("Episode")
        else
            countText += tr("Episodes")
        end if
        setFieldText("seasonCount", countText)
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if
end sub

sub populateRuntime(itemData as object)
    ' Series don't have runtime or an ends at value, so the season count shows instead
    if isSeries()
        setFieldText("runtime", "")
        setFieldText("endsAt", "")
        return
    end if

    if type(itemData.RunTimeTicks) = "LongInteger"
        setFieldText("runtime", getFormattedRuntime(itemData.RunTimeTicks))
        endsAtText = tr("Ends at %1").Replace("%1", getEndTimeFromTicks(itemData.RunTimeTicks))
        setFieldText("endsAt", endsAtText)
    else
        setFieldText("runtime", "")
        setFieldText("endsAt", "")
    end if
end sub

function getMonthName(month as integer) as string
    months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if month >= 1 and month <= 12
        return months[month - 1]
    end if
    return ""
end function

sub setBackdropImage(itemData as object)
    backdropPoster = m.top.findNode("backdrop")
    if not isValid(backdropPoster) then return

    ' A Seerr title has no library images, so it carries finished TMDB urls instead
    if isValidAndNotEmpty(itemData._externalBackdropUrl)
        backdropPoster.uri = itemData._externalBackdropUrl
        return
    end if

    serverBaseUrl = invalid
    if isChainValid(itemData, "_serverUrl")
        serverBaseUrl = itemData._serverUrl
        if serverBaseUrl.right(1) = "/"
            serverBaseUrl = serverBaseUrl.left(serverBaseUrl.len() - 1)
        end if
    end if

    backdropSource = backdropSourceFor(itemData)
    if not isValid(backdropSource.imageTag) then return

    params = backdropRequestParams({
        "maxWidth": 1920,
        "maxHeight": 1080,
        "quality": 90,
        "Tag": backdropSource.imageTag
    })

    backdropUrl = invalid
    if isValid(serverBaseUrl)
        backdropUrl = buildImageURLForServer(serverBaseUrl, backdropSource.backdropItemId, backdropSource.imageVersion, params)
    else
        backdropUrl = ImageURL(backdropSource.backdropItemId, backdropSource.imageVersion, params)
    end if

    if isValid(backdropUrl)
        backdropPoster.uri = backdropUrl
    end if
end sub

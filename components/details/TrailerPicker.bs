import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

' The 1280x720 design scaled up by half for the 1920x1080 screen
const PANEL_WIDTH = 642
const PAD_X = 36
const HEADER_TOP = 36
const ICON_GAP = 15
const DIVIDER_GAP = 24
const LIST_GAP = 18
const ROW_INSET = 18
const ROW_PAD = 15
const ROW_GAP = 6
const THUMB_WIDTH = 204
const THUMB_HEIGHT = 114
const TEXT_GAP = 21
const LINE_GAP = 6
const BADGE_PAD_X = 8
const BADGE_PAD_Y = 3
const BADGE_INSET = 6
const CHIP_GAP = 12

sub init()
    m.icon = m.top.findNode("icon")
    m.heading = m.top.findNode("heading")
    m.countLabel = m.top.findNode("countLabel")
    m.subheading = m.top.findNode("subheading")
    m.divider = m.top.findNode("divider")
    m.rowWindow = m.top.findNode("rowWindow")
    m.rows = m.top.findNode("rows")

    m.heading.font.size = 30
    m.countLabel.font.size = 21
    m.subheading.font.size = 21
    m.top.findNode("rowTitleFont").font.size = 23
    m.top.findNode("metaFont").font.size = 18
    m.top.findNode("badgeFont").font.size = 16
    m.heading.text = tr("Trailers")

    themeApply.ApplyToItem(m.top)

    ' A theme font swaps each label's font for one of its own, so they're read after it
    m.rowTitleFont = m.top.findNode("rowTitleFont").font
    m.metaFont = m.top.findNode("metaFont").font
    m.badgeFont = m.top.findNode("badgeFont").font

    m.rowHeight = THUMB_HEIGHT + (ROW_PAD * 2)
    m.entries = []
    m.entryByVideoId = {}
    m.entryByVideoId.SetModeCaseSensitive()
    m.focusIndex = 0
    m.firstVisible = 0
    m.visibleRows = 1
end sub

sub showPicker()
    trailers = m.top.trailers ?? []
    m.countLabel.text = tr("{count} trailers").Replace("{count}", trailers.count().ToStr())
    m.subheading.text = m.top.itemName

    titleLeft = PAD_X + m.icon.width + ICON_GAP
    textWidth = PANEL_WIDTH - titleLeft - PAD_X
    m.heading.translation = [titleLeft, HEADER_TOP]
    headingHeight = m.heading.boundingRect().height
    m.icon.translation = [PAD_X, HEADER_TOP + (headingHeight - m.icon.height) / 2]
    m.countLabel.width = textWidth
    m.countLabel.height = headingHeight
    m.countLabel.translation = [titleLeft, HEADER_TOP]
    m.subheading.width = textWidth
    m.subheading.translation = [titleLeft, HEADER_TOP + headingHeight]
    dividerTop = HEADER_TOP + headingHeight + m.subheading.boundingRect().height + DIVIDER_GAP
    m.divider.translation = [0, dividerTop]

    for i = 0 to trailers.count() - 1
        entry = buildRow(trailers[i], i * (m.rowHeight + ROW_GAP))
        m.entries.push(entry)
        if entry.videoId <> "" then m.entryByVideoId[entry.videoId] = entry
    end for

    listTop = dividerTop + LIST_GAP
    windowHeight = 1080 - listTop - LIST_GAP
    m.visibleRows = Int((windowHeight + ROW_GAP) / (m.rowHeight + ROW_GAP))
    if m.visibleRows < 1 then m.visibleRows = 1
    m.rowWindow.translation = [ROW_INSET, listTop]
    m.rowWindow.clippingRect = [0, 0, PANEL_WIDTH - (ROW_INSET * 2), windowHeight]

    markFocus(0)
    requestDetails(trailers)
    m.top.visible = true
    m.top.setFocus(true)
end sub

' A thumbnail with the length over its corner, then the title, the channel and a Subtitled chip
function buildRow(trailer as object, top as integer) as object
    rowWidth = PANEL_WIDTH - (ROW_INSET * 2)
    row = m.rows.createChild("Group")
    row.translation = [0, top]

    fill = row.createChild("Poster")
    fill.uri = "pkg:/images/playback/surface9.9.png"
    fill.blendColor = "#0F3A47"
    fill.width = rowWidth
    fill.height = m.rowHeight
    fill.visible = false

    thumbBg = row.createChild("Poster")
    thumbBg.uri = "pkg:/images/details/surface8.9.png"
    thumbBg.blendColor = "#FFFFFF"
    thumbBg.opacity = 0.08
    thumbBg.width = THUMB_WIDTH
    thumbBg.height = THUMB_HEIGHT
    thumbBg.translation = [ROW_PAD, ROW_PAD]

    thumbMask = row.createChild("MaskGroup")
    thumbMask.maskUri = "pkg:/images/details/nouveau/mask_landscape.png"
    thumbMask.maskSize = [THUMB_WIDTH, THUMB_HEIGHT]
    thumbMask.translation = [ROW_PAD, ROW_PAD]
    thumb = thumbMask.createChild("Poster")
    thumb.loadDisplayMode = "scaleToZoom"
    thumb.width = THUMB_WIDTH
    thumb.height = THUMB_HEIGHT
    thumb.uri = trailer.thumb ?? ""

    badge = row.createChild("Group")
    badgeFill = badge.createChild("Poster")
    badgeFill.uri = "pkg:/images/details/badgefill6.9.png"
    badgeFill.blendColor = "#000000"
    badgeFill.opacity = 0.78
    badgeText = badge.createChild("Label")
    badgeText.font = m.badgeFont
    badgeText.color = "#FFFFFF"
    badgeText.translation = [BADGE_PAD_X, BADGE_PAD_Y]

    title = row.createChild("Label")
    title.font = m.rowTitleFont
    title.color = "#FFFFFF"
    title.wrap = true
    title.maxLines = 2
    title.width = rowWidth - ROW_PAD - THUMB_WIDTH - TEXT_GAP - ROW_PAD
    title.text = trailer.title ?? ""
    if title.text = "" then title.text = tr("Trailer")

    meta = row.createChild("Label")
    meta.font = m.metaFont
    meta.color = "#FFFFFF99"

    chip = row.createChild("Group")
    chip.visible = trailer.subtitled = true
    chipFill = chip.createChild("Poster")
    chipFill.uri = "pkg:/images/details/badgefill6.9.png"
    chipFill.blendColor = "#FFFFFF"
    chipFill.opacity = 0.16
    chipText = chip.createChild("Label")
    chipText.font = m.badgeFont
    chipText.color = "#FFFFFFCC"
    chipText.text = tr("Subtitled")
    chipText.translation = [BADGE_PAD_X, BADGE_PAD_Y]
    chipSize = chipText.boundingRect()
    chipFill.width = chipSize.width + (BADGE_PAD_X * 2)
    chipFill.height = chipSize.height + (BADGE_PAD_Y * 2)

    ring = row.createChild("Poster")
    ring.uri = "pkg:/images/itemMenu/rowborder9.9.png"
    ring.width = rowWidth
    ring.height = m.rowHeight
    ring.visible = false

    entry = { videoId: trailer.videoId ?? "", fill: fill, ring: ring, title: title, titleHeight: title.boundingRect().height, meta: meta, chip: chip, chipFill: chipFill, badge: badge, badgeFill: badgeFill, badgeText: badgeText }
    showDetails(entry, trailer.seconds ?? 0, trailer.meta ?? "")
    return entry
end function

' The length and channel can arrive after the row is drawn, so the text is laid out again then
sub showDetails(entry as object, seconds as integer, metaText as string)
    entry.badge.visible = seconds > 0
    if seconds > 0
        entry.badgeText.text = secondsToHuman(seconds, false)
        badgeSize = entry.badgeText.boundingRect()
        entry.badgeFill.width = badgeSize.width + (BADGE_PAD_X * 2)
        entry.badgeFill.height = badgeSize.height + (BADGE_PAD_Y * 2)
        entry.badge.translation = [ROW_PAD + THUMB_WIDTH - BADGE_INSET - entry.badgeFill.width, ROW_PAD + THUMB_HEIGHT - BADGE_INSET - entry.badgeFill.height]
    end if

    textLeft = ROW_PAD + THUMB_WIDTH + TEXT_GAP
    lineLeft = textLeft
    lineRight = textLeft + entry.title.width
    lineHeight = 0
    metaHeight = 0
    entry.meta.text = metaText
    entry.meta.visible = metaText <> ""
    if entry.meta.visible
        entry.meta.width = 0
        metaSize = entry.meta.boundingRect()
        metaHeight = metaSize.height
        lineHeight = metaHeight
        roomLeft = lineRight - lineLeft
        if entry.chip.visible then roomLeft -= entry.chipFill.width + CHIP_GAP
        if metaSize.width > roomLeft then entry.meta.width = roomLeft
        lineLeft += entry.meta.boundingRect().width + CHIP_GAP
    end if
    if entry.chip.visible and entry.chipFill.height > lineHeight then lineHeight = entry.chipFill.height

    blockHeight = entry.titleHeight
    if lineHeight > 0 then blockHeight += LINE_GAP + lineHeight
    top = ROW_PAD + (THUMB_HEIGHT - blockHeight) / 2
    entry.title.translation = [textLeft, top]
    lineTop = top + entry.titleHeight + LINE_GAP
    entry.meta.translation = [textLeft, lineTop + (lineHeight - metaHeight) / 2]
    entry.chip.translation = [lineLeft, lineTop + (lineHeight - entry.chipFill.height) / 2]
end sub

sub requestDetails(trailers as object)
    videoIds = []
    for each trailer in trailers
        if isValidAndNotEmpty(trailer.videoId) then videoIds.push(trailer.videoId)
    end for
    if videoIds.count() = 0 then return

    m.detailsTask = CreateObject("roSGNode", "TrailerPreviewTask")
    m.detailsTask.functionName = "lookupDetails"
    m.detailsTask.observeFieldScoped("answer", "onDetails")
    m.detailsTask.request = { videoIds: videoIds }
    m.detailsTask.control = "RUN"
end sub

sub onDetails(event as object)
    found = event.getData().details
    if type(found) <> "roArray" then return
    for each details in found
        entry = m.entryByVideoId[details.videoId]
        if isValid(entry) and not entry.badge.visible then showDetails(entry, details.seconds, details.author)
    end for
end sub

sub markFocus(index as integer)
    if m.entries.count() = 0 then return
    if index < 0 then index = 0
    if index >= m.entries.count() then index = m.entries.count() - 1

    m.focusIndex = index
    for i = 0 to m.entries.count() - 1
        m.entries[i].fill.visible = i = index
        m.entries[i].ring.visible = i = index
    end for

    if index < m.firstVisible then m.firstVisible = index
    if index >= m.firstVisible + m.visibleRows then m.firstVisible = index - m.visibleRows + 1
    m.rows.translation = [0, -m.firstVisible * (m.rowHeight + ROW_GAP)]
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A closed picker can still hold focus, and swallowing keys there would strand the screen
    if not m.top.visible then return false

    if key = KeyCode.BACK
        closePicker(-1)
    else if key = KeyCode.UP
        markFocus(m.focusIndex - 1)
    else if key = KeyCode.DOWN
        markFocus(m.focusIndex + 1)
    else if key = KeyCode.OK
        closePicker(m.focusIndex)
    end if

    ' Nothing gets past the picker while it's up
    return true
end function

' The owner takes this node out of the scene as soon as it's told, so focus moves first
sub closePicker(index as integer)
    if isValid(m.detailsTask) then m.detailsTask.unobserveFieldScoped("answer")
    m.top.visible = false
    m.top.setFocus(false)
    if isValid(m.top.returnFocus) then m.top.returnFocus.setFocus(true)
    m.top.trailerChosen = index
end sub

<?xml version="1.0" encoding="utf-8"?>
<component name="ModernDetailButton" extends="Group">
    <children>
        <!-- Everything a frosted button grows on focus, so its name over it keeps its size -->
        <Group id="face">
            <!-- The ring of light round a frosted Play that has focus -->
            <Poster id="frostGlow" uri="pkg:/images/details/frost/fill51.9.png" blendColor="#FFFFFF"
                opacity="0.3" visible="false" />
            <!-- Rounded pill background that grows to the right when focused, with
                a hairline round it -->
            <Poster id="btnBg" uri="pkg:/images/details/btnfill.9.png" loadDisplayMode="scaleToFit"
                width="75" height="75" blendColor="#FFFFFF" opacity="0.06" />
            <Poster id="btnBorder" uri="pkg:/images/details/btnborder.9.png" loadDisplayMode="scaleToFit"
                width="75" height="75" blendColor="#FFFFFF" opacity="0.35" />
            <Poster id="btnBorderFocus" uri="pkg:/images/details/btnborderfocus.9.png" loadDisplayMode="scaleToFit"
                width="75" height="75" blendColor="#FFFFFF" visible="false" />
            <Poster id="btnIcon" width="35" height="35" translation="[20, 20]" />
            <Group id="btnText" translation="[92, 0]" opacity="0">
                <!-- A label too long for the pill scrolls while it has focus, with a second copy
                    trailing the first behind a dot so the start comes round again without a jump -->
                <Group id="labelClip">
                    <Group id="labelTrack">
                        <Label id="btnLabel" font="font:MediumBoldSystemFont" vertAlign="center"
                            height="75" color="#101114" />
                        <Poster id="labelDot" uri="pkg:/images/icons/circle.webp" width="6" height="6"
                            opacity="0.7" visible="false" />
                        <Label id="btnLabelCopy" font="font:MediumBoldSystemFont" vertAlign="center"
                            height="75" color="#101114" visible="false" />
                    </Group>
                </Group>
                <Label id="btnDetail" font="font:MediumBoldSystemFont" vertAlign="center"
                    height="19" color="#101114" opacity="0.8" visible="false" />
            </Group>
        </Group>
        <!-- A circle that keeps its size on focus names itself under it instead -->
        <Label id="belowLabel" font="font:SmallestBoldSystemFont" color="#FFFFFF" horizAlign="center"
            width="220" translation="[-72.5, 84]" visible="false" />
        <!-- A frosted circle names itself in a small dark chip over it -->
        <Group id="frostTip" visible="false">
            <Poster id="frostTipFill" uri="pkg:/images/login/fill23.9.png" blendColor="#242428F7" />
            <Label id="frostTipLabel" font="font:SmallestBoldSystemFont" color="#FFFFFF" />
        </Group>
        <Timer id="marqueeRest" duration="1.5" repeat="false" />
        <Animation id="marqueeAnim" repeat="false" easeFunction="linear">
            <Vector2DFieldInterpolator id="marqueeInterp" key="[0.0, 1.0]" keyValue="[[0, 0], [0, 0]]"
                fieldToInterp="labelTrack.translation" />
        </Animation>
        <Animation id="expandAnim" duration="0.15" repeat="false" easeFunction="outQuad">
            <FloatFieldInterpolator id="bgWidthInterp" key="[0.0, 1.0]" keyValue="[75, 75]"
                fieldToInterp="btnBg.width" />
            <FloatFieldInterpolator id="borderWidthInterp" key="[0.0, 1.0]" keyValue="[75, 75]"
                fieldToInterp="btnBorder.width" />
            <FloatFieldInterpolator id="borderFocusWidthInterp" key="[0.0, 1.0]" keyValue="[75, 75]"
                fieldToInterp="btnBorderFocus.width" />
            <FloatFieldInterpolator id="labelOpacityInterp" key="[0.0, 1.0]" keyValue="[0, 0]"
                fieldToInterp="btnText.opacity" />
        </Animation>
    </children>
    <interface>
        <field id="iconUri" type="string" onChange="onIconChanged" />
        <field id="labelText" type="string" onChange="onLabelChanged" />
        <!-- The second line the resume button spells its position out on -->
        <field id="detailText" type="string" onChange="onLabelChanged" />
        <!-- Watched and favourite carry a colour once they are set -->
        <field id="active" type="boolean" value="false" onChange="onActiveChanged" />
        <field id="buttonAction" type="string" />
        <field id="buttonIndex" type="integer" />
        <field id="highlighted" type="boolean" value="false" onChange="onHighlightChanged" />
        <!-- A row that keeps one button carrying its word at rest sets this on it -->
        <field id="leading" type="boolean" value="false" onChange="onHighlightChanged" />
        <!-- Play and Resume grow to fit their label, where every other button scrolls a long one -->
        <field id="primary" type="boolean" value="false" onChange="onLabelChanged" />
        <!-- How wide the label shows once the pill opens, which the row lays itself out by -->
        <field id="labelWidth" type="float" value="0" />
        <!-- A fixed width the pill always takes, with its icon and label centered in it -->
        <field id="spanWidth" type="float" value="0" onChange="onLabelChanged" />
        <!-- Focus fills the circle without opening it, and the label shows under it -->
        <field id="labelBelow" type="boolean" value="false" onChange="onHighlightChanged" />
        <!-- Frost's toolbar: a leading button is a white pill and the rest are bare icons that take a
            lighter platter when focused, with the label floating over them -->
        <field id="frosted" type="boolean" value="false" onChange="onLabelChanged" />
        <!-- How wide a frosted button is, which the toolbar lays itself out by -->
        <field id="faceWidth" type="float" value="0" />
    </interface>
</component>

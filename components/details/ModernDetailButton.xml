<?xml version="1.0" encoding="utf-8"?>
<component name="ModernDetailButton" extends="Group">
    <children>
        <!-- Rounded pill background that grows to the right when focused -->
        <Poster id="btnBg" uri="pkg:/images/icons/circle.png" loadDisplayMode="scaleToFit"
            width="75" height="75" blendColor="#444444" opacity="0.6" />
        <Poster id="btnIcon" width="35" height="35" translation="[20, 20]" />
        <Group id="btnText" translation="[92, 0]" opacity="0">
            <Label id="btnLabel" font="font:MediumBoldSystemFont" vertAlign="center"
                height="75" color="#101114" />
            <Label id="btnDetail" font="font:MediumBoldSystemFont" vertAlign="center"
                height="19" color="#101114" opacity="0.8" visible="false" />
        </Group>
        <Animation id="expandAnim" duration="0.15" repeat="false" easeFunction="outQuad">
            <FloatFieldInterpolator id="bgWidthInterp" key="[0.0, 1.0]" keyValue="[75, 75]"
                fieldToInterp="btnBg.width" />
            <FloatFieldInterpolator id="labelOpacityInterp" key="[0.0, 1.0]" keyValue="[0, 0]"
                fieldToInterp="btnText.opacity" />
        </Animation>
    </children>
    <interface>
        <field id="iconUri" type="string" onChange="onIconChanged" />
        <field id="labelText" type="string" onChange="onLabelChanged" />
        <!-- The second line the resume button spells its position out on -->
        <field id="detailText" type="string" onChange="onLabelChanged" />
        <!-- Watched and favourite carry a colour once they are set -->
        <field id="active" type="boolean" value="false" onChange="onActiveChanged" />
        <field id="buttonAction" type="string" />
        <field id="buttonIndex" type="integer" />
        <field id="highlighted" type="boolean" value="false" onChange="onHighlightChanged" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="SpotlightItemDetails" extends="JFScreen">
    <children>
        <!-- Spotlight puts the artwork first: a full page backdrop with a left
            to right fade under the hero, a rise from the bottom under the card
            band, and a vignette -->
        <Rectangle id="backdropBlack" width="1920" height="1080" color="#0B0D10" />
        <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToFill" opacity="1.0" />
        <Rectangle id="backdropScrim" width="1920" height="1080" color="#000000" opacity="0.4" />
        <Poster id="backdropLeftScrim" width="1400" height="1080" uri="pkg:/images/sidebar-edge-gradient.png"
            blendColor="0x0B0D10" loadDisplayMode="scaleToFill" />
        <Poster id="backdropBottomScrim" width="1920" height="440" translation="[0, 640]"
            uri="pkg:/images/seerr_gradient.png" blendColor="0x0B0D10" loadDisplayMode="scaleToFill" opacity="0.85" />

        <Group id="scrollableContent" translation="[0, 0]">
            <Group id="container" translation="[96, 130]">
                <!-- Hero column: tagline, title (or logo), person born line, meta
                    row, tech row, ratings, seerr facts, overview, buttons -->
                <Text id="tagline" font="font:SmallestBoldSystemFont" width="960"
                    maxLines="1" color="#6EA8FE" visible="false" />

                <Group id="logoGroup" visible="false">
                    <Poster id="logoImage" loadDisplayMode="scaleToFit" width="480" height="120" />
                </Group>

                <!-- The series name over an episode title -->
                <Text id="episodeHeader" font="font:SmallSystemFont" width="950"
                    color="#FFFFFFB3" visible="false" />

                <Text id="title" font="font:LargeBoldSystemFont" width="1000" wrap="true"
                    maxLines="2" color="#FFFFFF" visible="false" />

                <!-- Person birth year and place under the avatar -->
                <Text id="personBorn" font="font:SmallSystemFont" color="#FFFFFFB3" visible="false" />

                <Group id="metadataRow">
                    <Text id="releaseYear" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Text id="officialRating" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Text id="seasonCount" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Text id="episodeNumber" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Group id="statusBadge" visible="false">
                        <Poster id="statusBadgeBg" uri="pkg:/images/details/surface12.9.png"
                            loadDisplayMode="scaleToFit" />
                        <Label id="statusBadgeText" font="font:SmallestBoldSystemFont"
                            color="#FFFFFF" vertAlign="center" horizAlign="center" />
                    </Group>
                    <Group id="upcomingBadge" visible="false">
                        <Poster id="upcomingBadgeBg" uri="pkg:/images/details/surface12.9.png"
                            loadDisplayMode="scaleToFit" />
                        <Poster id="upcomingBadgeIcon" uri="pkg:/images/details/calendar.png"
                            width="18" height="18" blendColor="#FFFFFF" />
                        <Label id="upcomingBadgeText" font="font:SmallestBoldSystemFont"
                            color="#FFFFFF" vertAlign="center" horizAlign="center" />
                    </Group>
                    <Group id="runtimeGroup">
                        <Poster id="runtimeIcon" uri="pkg:/images/details/schedule.png"
                            width="20" height="20" blendColor="#FFFFFFBF" />
                        <Text id="runtime" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    </Group>
                    <Text id="endsAt" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Text id="metaGenres" font="font:SmallestSystemFont" color="#FFFFFFBF" />
                    <Group id="metaSeparators" />
                </Group>

                <Group id="techRow" visible="false">
                    <Text id="techSize" font="font:SmallestBoldSystemFont" color="#FFFFFFBF" />
                    <Text id="techSeparator" font="font:SmallestSystemFont"
                        color="#FFFFFF80" visible="false" />
                    <Group id="techChips" />
                    <Text id="techChipFont" font="font:SmallestSystemFont" visible="false" />
                </Group>

                <RatingsRow id="ratingsRow" visible="false" />

                <ExpandableOverview id="overview" visible="false" />

                <Rectangle id="buttonRowContainer" width="1728" height="75" color="#00000000">
                    <Group id="buttonRow" />
                </Rectangle>
                <Rectangle id="buttonRowExtraContainer" width="1728" height="75"
                    color="#00000000" visible="false">
                    <Group id="buttonRowExtra" />
                </Rectangle>

                <SeerrDetailBlock id="seerrBlock" visible="false" />

                <UpNextCard id="upNextCard" visible="false" />

                <!-- Extras loader, hidden. ShowScenes builds a detail group by
                    finding this node and calling loadParts on it, so every
                    detail style has to declare one. -->
                <ExtrasRowList id="extrasGrid"
                    numRows="5"
                    rowFocusAnimationStyle="floatingFocus"
                    itemSpacing="[60, 60]"
                    rowLabelOffset="[[9, 24]]"
                    showRowLabel="true"
                    showRowCounter="true"
                    visible="false"
                    drawFocusFeedback="true"
                    itemComponentName="ExtrasItem"
                    focusBitmapUri="pkg:/images/hd_focus.9.png" />
            </Group>

            <!-- The band of summary cards under the hero -->
            <Group id="cardBand" />
        </Group>

        <!-- The open card's sections, over a scrim -->
        <SpotlightSectionModal id="sectionModal" visible="false" />

        <AudioSelector id="audioSelector" visible="false" />
        <SubtitleSelector id="subtitleSelector" visible="false" />
        <SubtitleDownloadDialog id="subtitleDownloadDialog" visible="false" />
        <VersionSelector id="versionSelector" visible="false" />
        <ThemeMusicPlayer id="themeMusicPlayer" />
        <FavoriteItemsTask id="favoriteTask" />
        <PlaystateTask id="playstateTask" />

        <Animation id="scrollAnimation" duration="0.5" repeat="false" easeFunction="inOutQuad">
            <Vector2DFieldInterpolator id="scrollInterpolator"
                key="[0.0, 1.0]"
                keyValue="[[0, 0], [0, 0]]"
                fieldToInterp="scrollableContent.translation" />
        </Animation>
    </children>
    <interface>
        <field id="seerrButtonsStale" type="boolean" alwaysNotify="true" />
        <field id="buttonSelected" type="string" alwaysNotify="true" />
        <field id="studioSelected" type="assocarray" alwaysNotify="true" />
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="itemContent" type="node" />
        <field id="seerrTarget" type="assocarray" onChange="onSeerrTargetChanged" />
        <field id="seerrOnly" type="boolean" value="false" />
        <field id="itemType" type="string" value="movie" />
        <field id="trailerAvailable" type="bool" value="false" />
        <field id="additionalParts" type="assocarray" />
        <field id="selectedPart" type="assocarray" onChange="onSelectedPartChanged" />
        <field id="selectedAudioStreamIndex" type="integer" />
        <field id="selectedVideoStreamId" type="string" />
        <field id="quickPlayNode" type="node" alwaysNotify="true" />
        <field id="refreshMovieDetailsData" type="bool" alwaysNotify="true" />
        <field id="refreshEpisodeDetailsData" type="bool" alwaysNotify="true" />
        <field id="refreshSeriesDetailsData" type="bool" alwaysNotify="true" />
        <field id="logoImageURI" type="string" onChange="onLogoImageURIChanged" />
        <field id="seasonData" type="node" />
        <field id="pageContent" type="node" />
        <field id="albumData" type="node" />
        <field id="listData" type="node" />
        <field id="playAlbumSelected" type="bool" alwaysNotify="true" />
        <field id="shuffleAlbumSelected" type="bool" alwaysNotify="true" />
        <field id="instantMixSelected" type="bool" alwaysNotify="true" />
        <field id="playSong" type="integer" alwaysNotify="true" />
        <field id="playAll" type="bool" alwaysNotify="true" />
        <field id="playArtistSelected" type="bool" alwaysNotify="true" />
        <field id="selectedAlbum" type="node" alwaysNotify="true" />
        <field id="playlistItemSelected" type="integer" alwaysNotify="true" />
        <field id="displayResumeButton" type="bool" onChange="onDisplayResumeButtonChange" />
        <field id="shufflePlay" type="bool" value="false" />
        <field id="playSeasonFromStart" type="bool" alwaysNotify="true" />
        <field id="refreshSeasonDetailsData" type="bool" alwaysNotify="true" />
        <field id="seasonSelected" type="node" alwaysNotify="true" />
        <field id="playSeriesFromStart" type="bool" alwaysNotify="true" />
        <field id="seasonEpisodesData" type="assocarray" onChange="onSeasonEpisodesLoaded" />
    </interface>
</component>

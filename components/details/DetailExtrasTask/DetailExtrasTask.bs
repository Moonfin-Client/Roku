import "pkg:/source/api/baserequest.bs"

sub init()
    m.top.functionName = "loadExtras"
end sub

sub loadExtras()
    try
        target = m.top.target
        item = m.top.item
        server = m.top.server
        trailerPath = "Items/" + item.Id + "/LocalTrailers"
        if isEmbyServer(server.serverUrl) then trailerPath = "Users/" + server.userId + "/" + trailerPath
        req = APIRequestForServer(server.serverUrl, server.userId, server.authToken, trailerPath)
        trailers = optionalJson(req)
        if type(trailers) = "roAssociativeArray" then trailers = trailers.Items
        currentItem = chainLookupReturn(target, "itemContent.json.Id", "")
        if currentItem = item.Id then target.trailerAvailable = isValidAndNotEmpty(item.RemoteTrailers) or isValidAndNotEmpty(trailers)
        if m.top.includeParts and currentItem = item.Id
            req = APIRequestForServer(server.serverUrl, server.userId, server.authToken, "Videos/" + item.Id + "/AdditionalParts", { UserId: server.userId })
            parts = optionalJson(req)
            if type(parts) = "roArray" then parts = { Items: parts, TotalRecordCount: parts.Count() }
            if isChainValid(target, "itemContent.json.Id")
                if target.itemContent.json.Id = item.Id and type(parts) = "roAssociativeArray" then target.additionalParts = { masterID: item.Id, parts: parts }
            end if
        end if
    catch error
        print "[Details] optional extras failed: "; error.number
    end try
    m.top.target = invalid
end sub

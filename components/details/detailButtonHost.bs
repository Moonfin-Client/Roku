import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/detailActions.bs"
import "pkg:/source/utils/detailButtons.bs"
import "pkg:/source/utils/detailCompatibility.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/seerrButtons.bs"
import "pkg:/source/utils/seerrDetailHost.bs"

import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/ViewLoadStatus.bs"

' The action row, shared by the classic and modern detail screens so both behave the
' same. These run in the host screen's scope, so m is whichever screen imported them.
' Each screen keeps its own init() and node observers, this file has none.
'
' Hooks each screen provides:
'   sub appendButtonNode(config as object)
'   sub clearButtonRow()
'   sub commitButtonRow()
'   function typeSpecificButtons() as boolean
'   function markActiveButton(config as object, isActive as boolean, ink as string) as object
'   sub setToggleButtonLabel(buttonId as string, label as string, isActive as boolean)
'   sub handleScreenButtonAction(action as string)
'   sub highlightButton(index as integer)
'   sub updatePlayedIndicator()
'
' A screen that folds buttons behind More Actions also keeps m.overflowMenu, a
' NouveauOverflowMenu observed into onOverflowAction and onOverflowClosed.

' How far past the edge a row scrolls to bring a button into view
const BUTTON_ROW_SCROLL_MARGIN = 50

sub addArrangedButtons(candidates as object)
    order = m.global.session.user.settings[DETAIL_ORDER_SETTING]
    hidden = m.global.session.user.settings[DETAIL_HIDDEN_SETTING]

    for each candidate in seerrButtons.Candidates(m.seerrDetails, seerrMediaType())
        candidates.push(candidate)
    end for

    for each candidate in detailActionCandidates(m.top.itemContent.json)
        candidates.push(candidate)
    end for

    ' Kids Mode sets the saved arrangement aside rather than filtering it, since its own short row
    ' is the point and a reorder would otherwise put a button it hides back
    offered = buttonLayout.InCatalogueOrder(candidates)
    arranged = kidsMode.Enabled() ? kidsMode.KeepButtons(offered) : buttonLayout.Arrange(offered, order, hidden)

    for each candidate in arranged
        addButton(candidate.config)
    end for
end sub

' The Action Buttons on Screen setting laid over the cap a style asks for. Returns how many
' buttons stay in the row, or -1 when nothing folds. Play, Resume and Restart count toward the
' cap but never fold, so the row always keeps those.
function cappedButtonCount(buttons as object, styleCap as object) as integer
    leading = 0
    for each button in buttons
        if button.id <> "resumeButton" and button.id <> "restartButton" and button.id <> "playButton" then exit for
        leading++
    end for

    split = buttonLayout.CountSplit(buttons.count(), buttonLayout.ApplyButtonLimit(viewerButtonLimit(), styleCap))
    if not split.needsOverflow then return -1
    if split.visibleCount > leading then return split.visibleCount
    return leading
end function

' Kids Mode's row is its own short allow list, so the viewer's cap is one more setting it
' sets aside
function viewerButtonLimit() as integer
    if kidsMode.Enabled() then return 0
    return buttonLayout.MaxVisibleSetting()
end function

' Whether the viewer asked for every button in one row that scrolls sideways
function buttonRowScrolls() as boolean
    return viewerButtonLimit() = -1
end function

' Everything from keep on moves behind a trailing More Actions button whose menu holds them
sub foldButtonsIntoMenu(keep as integer)
    m.overflowActions = []
    if keep < 0 or keep >= m.buttonGroups.count() then return

    for i = keep to m.buttonGroups.count() - 1
        button = m.buttonGroups[i]
        m.overflowActions.push({ icon: button.iconUri, label: button.labelText, action: button.buttonAction, id: button.id })
    end for

    while m.buttonGroups.count() > keep
        m.buttonRow.removeChild(m.buttonGroups[m.buttonGroups.count() - 1])
        m.buttonGroups.pop()
    end while

    appendButtonNode({
        icon: "pkg:/images/icons/dotDotDot.png",
        label: tr("More Actions"),
        action: "toggleMoreActions",
        id: "moreActionsButton"
    })

    ' A toggle leaves the menu open, so a row rebuilt behind it hands the menu its new labels
    if m.overflowMenu.visible
        for each entry in m.overflowActions
            m.overflowMenu.callFunc("relabel", entry.action, entry.label)
        end for
    end if
end sub

sub openOverflowMenu()
    if not isValidAndNotEmpty(m.overflowActions) then return

    m.overflowMenu.actions = m.overflowActions
    m.overflowMenu.visible = true
    m.overflowMenu.setFocus(true)
end sub

sub onOverflowAction(event as object)
    action = event.getData()
    if not isValidAndNotEmpty(action) then return

    ' A toggle changes in place, so the menu stays open on it. Anything else opens something of
    ' its own.
    if action <> "watched" and action <> "favorite" then closeOverflowMenu()
    dispatchOverflowAction(action)
end sub

sub onOverflowClosed()
    closeOverflowMenu()
end sub

sub closeOverflowMenu()
    m.overflowMenu.visible = false
    m.overflowMenu.setFocus(false)
    focusButton(m.currentButtonIndex)
end sub

' The dispatcher reads whichever button has the row's focus, so a hidden action is run by
' standing the More button in for it
sub dispatchOverflowAction(action as string)
    held = m.currentButtonIndex
    more = m.buttonGroups.count() - 1
    if more < 0 then return

    standIn = m.buttonGroups[more].buttonAction
    m.buttonGroups[more].buttonAction = action
    m.currentButtonIndex = more
    handleButtonSelect()
    m.buttonGroups[more].buttonAction = standIn
    m.currentButtonIndex = held
end sub

' A toggle hidden behind More changes in place, so the menu row and the entry it reopens from
' take the new label
sub relabelOverflowAction(buttonId as string, label as string)
    if not isValid(m.overflowActions) then return

    for each entry in m.overflowActions
        if entry.id = buttonId
            entry.label = label
            if m.overflowMenu.visible then m.overflowMenu.callFunc("relabel", entry.action, label)
        end if
    end for
end sub

' A row wider than its room scrolls sideways to keep the focused button in view. Returns the
' offset the row moves left by.
function buttonRowScrollOffset(focusLeft as float, focusRight as float, rowWidth as float, viewport as float) as float
    offset = m.buttonRowOffset ?? 0
    if focusRight > focusLeft
        if focusLeft < offset then offset = focusLeft - BUTTON_ROW_SCROLL_MARGIN
        if focusRight > offset + viewport then offset = focusRight - viewport + BUTTON_ROW_SCROLL_MARGIN
    end if

    furthest = rowWidth - viewport
    if offset > furthest then offset = furthest
    if offset < 0 then offset = 0
    m.buttonRowOffset = offset
    return offset
end function

' Puts the finished row in its room. A row that scrolls is clipped to the room and moved along
' to keep the focused button in view, and any other row sits where it was put.
sub placeButtonRow(clip as object, scrolls as boolean, focusLeft as float, focusRight as float, rowWidth as float, viewport as float)
    offset = 0
    if scrolls
        offset = buttonRowScrollOffset(focusLeft, focusRight, rowWidth, viewport)
        clip.clippingRect = [0, -100, viewport, 400]
    else
        clip.clippingRect = BUTTON_NO_CLIP
        m.buttonRowOffset = 0
    end if
    m.buttonRow.translation = [-offset, m.buttonRow.translation[1]]
end sub

sub onButtonFocusChanged(event as object)
    button = event.getRoSGNode()
    if button <> invalid and button.buttonIndex <> invalid
        if button.hasFocus() or button.isInFocusChain()
            m.currentButtonIndex = button.buttonIndex
            highlightButton(m.currentButtonIndex)
        end if
    end if
end sub

sub focusButton(index as integer)
    if index < 0 or index >= m.buttonGroups.count() then return

    m.buttonGroups[index].setFocus(true)
    m.top.lastFocus = m.buttonGroups[index]
    m.currentButtonIndex = index
    highlightButton(index)
    setLastFocus(m.buttonGroups[index])
end sub

sub focusFirstButton()
    if m.buttonGroups.count() > 0
        m.buttonGroups[0].setFocus(true)
        highlightButton(0)
    end if
end sub

sub focusFirstVisibleButton()
    firstVisibleIndex = 0
    for i = 0 to m.buttonGroups.count() - 1
        if m.buttonGroups[i].visible
            firstVisibleIndex = i
            exit for
        end if
    end for

    if firstVisibleIndex < m.buttonGroups.count()
        m.currentButtonIndex = firstVisibleIndex
        m.buttonGroups[firstVisibleIndex].setFocus(true)
        highlightButton(firstVisibleIndex)
        setLastFocus(m.buttonGroups[firstVisibleIndex])
    end if
end sub

' The Seerr payload lands after the row is first drawn, so it is drawn again with the
' Seerr entries in, keeping focus where it was rather than snapping to the front
sub onSeerrButtonsStale()
    hadFocus = false
    focusIndex = 0
    for i = 0 to m.buttonGroups.count() - 1
        if m.buttonGroups[i].isInFocusChain()
            hadFocus = true
            focusIndex = i
            exit for
        end if
    end for

    clearButtonRow()
    addButtons(m.top.itemContent.json)
    commitButtonRow()
    updateSeerrSeasonMarkers()

    ' The availability pills in the facts line come from the same answer
    updateSeerrPills()
    layoutMetadataRow()
    layoutContainer()

    if hadFocus and m.buttonGroups.count() > 0
        if focusIndex >= m.buttonGroups.count() then focusIndex = m.buttonGroups.count() - 1
        m.currentButtonIndex = focusIndex
        m.buttonGroups[focusIndex].setFocus(true)
        highlightButton(focusIndex)
    end if
end sub

sub updateButtonVisibility(itemData as object)
    clearButtonRow()

    addButtons(itemData)
    commitButtonRow()

    if m.buttonGroups.count() > 0
        m.currentButtonIndex = 0
        timer = CreateObject("roSGNode", "Timer")
        timer.duration = 0.05
        timer.repeat = false
        timer.observeField("fire", "focusFirstButton")
        timer.control = "start"
        m.focusTimer = timer
    end if
end sub

sub addButton(config as object)
    ' A Seerr title has nothing in the library behind it, so only the actions that reach
    ' Seerr itself are worth offering
    if m.top.seerrOnly and Left(config.id, 5) <> "seerr" then return
    appendButtonNode(config)
end sub

sub addButtons(itemData as object)
    if isSeries()
        addSeriesButtons()
        return
    end if

    if typeSpecificButtons() then return

    positionTicks = 0&
    if isValid(itemData.UserData) and itemData.UserData.PlaybackPositionTicks > 0
        positionTicks = itemData.UserData.PlaybackPositionTicks
    end if
    hasProgress = positionTicks > 0

    if hasProgress
        addButton({
            icon: "pkg:/images/icons/detail_play.png",
            label: tr("Resume"),
            detail: getFormattedRuntime(positionTicks),
            action: "resume",
            id: "resumeButton"
        })
    end if

    ' With a resume point on offer the second button starts over instead, which
    ' is how the other clients pair the two
    addButton({
        icon: hasProgress ? "pkg:/images/icons/detail_restart.png" : "pkg:/images/icons/detail_play.png",
        label: hasProgress ? tr("Restart") : tr("Play"),
        action: hasProgress ? "restart" : "play",
        id: hasProgress ? "restartButton" : "playButton"
    })

    ' Pushed in the catalogue's order, since that is what decides where a button
    ' the user never placed ends up
    candidates = []

    if isValid(itemData.MediaSources) and itemData.MediaSources.Count() > 1
        candidates.push({
            id: "version", config: {
                icon: "pkg:/images/icons/detail_version.png",
                label: tr("Versions"),
                action: "versionTrack",
                id: "versionButton"
            }
        })
    end if

    if isValid(itemData.MediaStreams)
        audioCount = 0
        for each stream in itemData.MediaStreams
            if stream.Type = "Audio" then audioCount++
        end for
        if audioCount > 1
            candidates.push({
                id: "audio", config: {
                    icon: "pkg:/images/icons/detail_audio.png",
                    label: tr("Audio"),
                    action: "audioTrack",
                    id: "audioTrackButton"
                }
            })
        end if
    end if

    ' Only a video with a real source has subtitles to pick, so music never offers them
    mediaSources = itemData.MediaSources
    if isStringEqual(itemData.MediaType, "Video") and isValidAndNotEmpty(mediaSources) and mediaSources[0].Type <> "Placeholder"
        candidates.push({
            id: "subtitles", config: {
                icon: "pkg:/images/icons/detail_subtitle.png",
                label: tr("Subtitle"),
                action: "subtitleTrack",
                id: "subtitleButton"
            }
        })
    end if

    m.builtExtrasSignature = detailExtrasSignature()
    if isValidAndNotEmpty(chainLookup(m.top, "additionalParts.parts.Items"))
        candidates.push({ id: "parts", config: { icon: "pkg:/images/icons/detail_play.png", label: tr("Parts"), action: "parts", id: "partButton" } })
    end if

    if m.top.trailerAvailable then candidates.push(trailerCandidate())

    candidates.push(watchedCandidate(itemData))
    candidates.push(favoriteCandidate(itemData))

    if isEpisode()
        candidates.push({
            id: "goToSeries", config: {
                icon: "pkg:/images/icons/detail_series.png",
                label: tr("Go to Series"),
                action: "goToSeries",
                id: "goToSeriesButton"
            }
        })
    end if

    addArrangedButtons(candidates)
end sub

sub addSeriesButtons()
    hasResume = m.top.displayResumeButton
    if hasResume
        addButton({
            icon: "pkg:/images/icons/detail_play.png",
            label: tr("Resume"),
            action: "seriesResume",
            id: "resumeButton"
        })
    end if

    ' With a resume point on offer the second button starts over instead, which
    ' is how the other clients pair the two
    addButton({
        icon: hasResume ? "pkg:/images/icons/detail_restart.png" : "pkg:/images/icons/detail_play.png",
        label: hasResume ? tr("Restart") : tr("Play"),
        action: "seriesPlay",
        id: "playButton"
    })

    itemData = chainLookupReturn(m.top.itemContent, "json", {})
    candidates = []
    candidates.push({
        id: "shuffle", config: {
            icon: "pkg:/images/icons/detail_shuffle.png",
            label: tr("Shuffle"),
            action: "seriesShuffle",
            id: "shuffleButton"
        }
    })

    if m.top.trailerAvailable then candidates.push(trailerCandidate())

    candidates.push(watchedCandidate(itemData))
    candidates.push(favoriteCandidate(itemData))

    addArrangedButtons(candidates)
end sub

function trailerCandidate() as object
    return { id: "trailer", config: { icon: "pkg:/images/icons/detail_trailer.png", label: tr("Trailer"), action: "trailer", id: "trailerButton" } }
end function

function watchedCandidate(itemData as object) as object
    isWatched = chainLookupReturn(itemData, "UserData.Played", false)
    return { id: "watched", config: markActiveButton({ icon: "pkg:/images/icons/detail_watched.png", label: isWatched ? tr("Watched") : tr("Unwatched"), action: "watched", id: "watchedButton" }, isWatched, CLASSIC_WATCHED_INK) }
end function

function favoriteCandidate(itemData as object) as object
    isFavorited = chainLookupReturn(itemData, "UserData.IsFavorite", false)
    return { id: "favorite", config: markActiveButton({ icon: "pkg:/images/icons/detail_favorite.png", label: isFavorited ? tr("Favorited") : tr("Favorite"), action: "favorite", id: "favoriteButton" }, isFavorited, CLASSIC_FAVORITE_INK) }
end function

sub handleButtonSelect()
    if m.currentButtonIndex < 0 or m.currentButtonIndex >= m.buttonGroups.count() then return

    buttonGroup = m.buttonGroups[m.currentButtonIndex]
    if buttonGroup = invalid then return

    buttonAction = buttonGroup.buttonAction
    if buttonAction = invalid then return

    if Left(buttonAction, 5) = "seerr"
        startSeerrRequest(buttonAction)
        return
    end if

    if buttonAction = "toggleMoreActions"
        openOverflowMenu()
        return
    end if

    m.loadStatus = ViewLoadStatus.RELOAD

    if buttonAction = "resume"
        startLoadingSpinner()
        itemContent = m.top.itemContent
        if itemContent <> invalid and isValid(itemContent.json)
            playbackPositionTicks = chainLookup(itemContent, "json.UserData.PlaybackPositionTicks") ?? 0
            itemContent.startingPoint = playbackPositionTicks
            selectPlaybackSource(itemContent, m.top.selectedVideoStreamId)
            itemContent.selectedAudioStreamIndex = m.top.selectedAudioStreamIndex
            m.global.queueManager.callFunc("clear")
            m.global.queueManager.callFunc("push", itemContent)
            m.global.queueManager.callFunc("playQueue")
        end if
    else if buttonAction = "play"
        m.top.buttonSelected = "play-button"
    else if buttonAction = "restart"
        m.top.buttonSelected = "playFromBeginning-button"
    else if buttonAction = "parts"
        m.top.buttonSelected = "part-button"
    else if buttonAction = "trailer"
        m.top.buttonSelected = "trailer-button"
    else if buttonAction = "audioTrack"
        if isValid(m.trackData.audios)
            m.audioSelector.audioTracks = m.trackData.audios
            m.audioSelector.visible = true
            m.audioSelector.setFocus(true)
            setLastFocus(m.audioSelector)
        end if
    else if buttonAction = "subtitleTrack"
        subtitleTracks = invalid
        if isValid(m.trackData)
            subtitleTracks = m.trackData.subtitles
        end if

        if not isValid(subtitleTracks)
            preferredSubtitle = m.global.queueManager.callFunc("getPreferredSubtitleTrack")
            selectedSubtitle = isChainValid(preferredSubtitle, "StreamIndex") ? preferredSubtitle.StreamIndex : SubtitleSelection.NONE
            subtitleTracks = [{
                "StreamIndex": SubtitleSelection.NONE,
                "json": {},
                "Title": "None",
                "Description": "None",
                "Selected": selectedSubtitle = SubtitleSelection.NONE
            }]
        end if

        m.subtitleSelector.subtitleTracks = subtitleTracks
        m.subtitleSelector.visible = true
        m.subtitleSelector.setFocus(true)
        setLastFocus(m.subtitleSelector)
    else if buttonAction = "watched"
        toggleWatched()
    else if buttonAction = "personalRating"
        showRatingPrompt()
    else if buttonAction = "addToPlaylist"
        showPlaylistPicker()
    else if buttonAction = "addToCollection"
        showCollectionPicker()
    else if buttonAction = "deleteItem"
        confirmDelete()
    else if buttonAction = "changeArtwork"
        showArtworkPicker()
    else if buttonAction = "adminControls"
        showIdentify()
    else if buttonAction = "goToSeries"
        m.top.buttonSelected = "goToSeries-button"
    else if buttonAction = "favorite"
        toggleFavorite()
    else if buttonAction = "versionTrack"
        if isValid(m.trackData.videos)
            m.versionSelector.videoTracks = m.trackData.videos
            m.versionSelector.visible = true
            m.versionSelector.setFocus(true)
            setLastFocus(m.versionSelector)
        end if
    else if buttonAction = "seriesResume"
        itemContent = m.top.itemContent
        if isValid(itemContent)
            itemContent.quickplayFromResume = true
            m.top.quickPlayNode = itemContent
        end if
    else if buttonAction = "seriesPlay"
        m.top.playSeriesFromStart = not m.top.playSeriesFromStart
    else if buttonAction = "seriesShuffle"
        if isValid(m.top.itemContent) and isValid(m.top.itemContent.id)
            m.getShuffleEpisodesTask.showID = m.top.itemContent.id
            m.getShuffleEpisodesTask.observeField("data", "onShuffleEpisodeDataLoaded")
            m.getShuffleEpisodesTask.control = "RUN"
        end if
    else
        handleScreenButtonAction(buttonAction)
    end if
end sub

sub toggleWatched()
    itemContent = m.top.itemContent
    if itemContent = invalid or not isValid(itemContent.json) then return

    itemData = itemContent.json
    currentWatched = false
    if hasValidProperties(itemData, "UserData", "Played")
        currentWatched = itemData.UserData.Played
    end if

    newWatchedState = not currentWatched

    itemServerInfo = getServerInfoFromItem(itemContent)
    taskParams = {}

    if newWatchedState
        date = CreateObject("roDateTime")
        dateStr = date.ToISOString()
        taskParams["DatePlayed"] = dateStr
        taskParams["PlaybackPositionTicks"] = 0
        if isValid(itemServerInfo) and isValidAndNotEmpty(itemServerInfo.serverUrl)
            taskParams["serverData"] = {
                serverUrl: itemServerInfo.serverUrl,
                userId: itemServerInfo.userId,
                authToken: itemServerInfo.authToken
            }
        end if
        m.playstateTask.status = "markPlayed"
        m.playstateTask.itemId = itemData.id
        m.playstateTask.params = taskParams
        m.playstateTask.control = TaskControl.RUN
        itemData.UserData.PlaybackPositionTicks = 0
    else
        if isValid(itemServerInfo) and isValidAndNotEmpty(itemServerInfo.serverUrl)
            taskParams["serverData"] = {
                serverUrl: itemServerInfo.serverUrl,
                userId: itemServerInfo.userId,
                authToken: itemServerInfo.authToken
            }
        end if
        m.playstateTask.status = "unmarkPlayed"
        m.playstateTask.itemId = itemData.id
        m.playstateTask.params = taskParams
        m.playstateTask.control = TaskControl.RUN
    end if

    itemData.UserData.Played = newWatchedState
    itemContent.watched = newWatchedState
    ' json is a node field, so the read handed back a copy and nothing else sees the change
    ' until it goes back
    itemContent.json = itemData

    updatePlayedIndicator()

    setToggleButtonLabel("watchedButton", newWatchedState ? tr("Watched") : tr("Unwatched"), newWatchedState)
    relabelOverflowAction("watchedButton", newWatchedState ? tr("Watched") : tr("Unwatched"))

    if m.buttonGroups.count() > 0 and m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count()
        highlightButton(m.currentButtonIndex)
    end if
end sub

sub toggleFavorite()
    itemContent = m.top.itemContent
    if itemContent = invalid or not isValid(itemContent.json) then return

    itemData = itemContent.json
    currentFavorite = false
    if hasValidProperties(itemData, "UserData", "IsFavorite")
        currentFavorite = itemData.UserData.IsFavorite
    end if

    newFavoriteState = not currentFavorite

    itemServerInfo = getServerInfoFromItem(itemContent)
    if isValid(itemServerInfo) and isValidAndNotEmpty(itemServerInfo.serverUrl)
        m.favoriteTask.serverData = {
            serverUrl: itemServerInfo.serverUrl,
            userId: itemServerInfo.userId,
            authToken: itemServerInfo.authToken
        }
    else
        m.favoriteTask.serverData = invalid
    end if

    if newFavoriteState
        m.favoriteTask.favTask = "favorite"
    else
        m.favoriteTask.favTask = "unfavorite"
    end if
    m.favoriteTask.itemId = itemData.id
    m.favoriteTask.control = TaskControl.RUN

    if not isValid(itemData.UserData)
        itemData.UserData = {}
    end if
    itemData.UserData.IsFavorite = newFavoriteState
    itemContent.favorite = newFavoriteState
    itemContent.json = itemData

    updatePlayedIndicator()

    setToggleButtonLabel("favoriteButton", newFavoriteState ? tr("Favorited") : tr("Favorite"), newFavoriteState)
    relabelOverflowAction("favoriteButton", newFavoriteState ? tr("Favorited") : tr("Favorite"))

    if m.buttonGroups.count() > 0 and m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count()
        highlightButton(m.currentButtonIndex)
    end if
end sub

sub onDetailExtrasChanged()
    if not isChainValid(m.top.itemContent, "json") then return
    if not isValid(m.buttonGroups) then return
    if isValid(m.builtExtrasSignature) and detailExtrasSignature() = m.builtExtrasSignature then return

    focusedId = ""
    selectedId = ""
    previousIndex = m.currentButtonIndex
    if previousIndex >= 0 and previousIndex < m.buttonGroups.Count()
        if isValid(m.buttonGroups[previousIndex]) then selectedId = m.buttonGroups[previousIndex].id
    end if
    for each button in m.buttonGroups
        if button.isInFocusChain()
            focusedId = button.id
            selectedId = focusedId
        end if
    end for

    clearButtonRow()
    addButtons(m.top.itemContent.json)
    commitButtonRow()

    if selectedId <> ""
        for i = 0 to m.buttonGroups.Count() - 1
            if m.buttonGroups[i].id = selectedId
                m.currentButtonIndex = i
                if focusedId <> "" then focusButton(i)
                return
            end if
        end for
    end if

    if focusedId <> ""
        focusFirstVisibleButton()
    else if m.buttonGroups.Count() > 0
        if previousIndex < 0 then previousIndex = 0
        if previousIndex >= m.buttonGroups.Count() then previousIndex = m.buttonGroups.Count() - 1
        m.currentButtonIndex = previousIndex
    end if
end sub

' The row only needs rebuilding when a late trailer or parts answer changes which buttons it holds
function detailExtrasSignature() as string
    hasParts = isValidAndNotEmpty(chainLookup(m.top, "additionalParts.parts.Items"))
    return m.top.trailerAvailable.ToStr() + "|" + hasParts.ToStr()
end function

' LocalTrailerCount arrives as a number, which isValidAndNotEmpty always reads as empty
function detailHasTrailer(itemData as object) as boolean
    if isValidAndNotEmpty(itemData.RemoteTrailers) then return true
    localTrailers = itemData.LocalTrailerCount
    countType = LCase(type(localTrailers))
    if countType = "integer" or countType = "roint" or countType = "rointeger" or countType = "longinteger" or countType = "rolonginteger" then return localTrailers > 0
    return false
end function

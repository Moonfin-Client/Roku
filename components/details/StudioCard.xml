<?xml version="1.0" encoding="utf-8"?>
<component name="StudioCard" extends="Group">
    <children>
        <Group id="imageGroup" scaleRotateCenter="[120, 65]">
            <Poster id="cardBg" uri="pkg:/images/details/surface12.9.png" loadDisplayMode="scaleToFit"
                width="240" height="130" blendColor="#FFFFFF" opacity="0.1" />
            <Poster id="logo" width="200" height="90" translation="[20, 20]"
                loadDisplayMode="scaleToFit" visible="false" />
            <Poster id="placeholder" uri="pkg:/images/icons/go_to_series.png" width="60" height="60"
                translation="[90, 35]" opacity="0.4" visible="false" />
            <Poster id="focusRing" uri="pkg:/images/details/cardfocus12.9.png" loadDisplayMode="scaleToFit"
                width="240" height="130" blendColor="#FFFFFF99" visible="false" />
        </Group>
        <Label id="name" width="240" translation="[0, 142]" horizAlign="center" wrap="true"
            maxLines="2" color="#FFFFFFCC" font="font:SmallSystemFont" />
    </children>
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="drawFocusFeedback" type="boolean" value="false" />
    </interface>
</component>

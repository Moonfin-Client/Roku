import "pkg:/components/details/detailPopulationHost.bs"
import "pkg:/components/details/detailScreenHost.bs"
import "pkg:/components/details/detailTrackHost.bs"
import "pkg:/components/itemMenu/itemMenuDetailHost.bs"
import "pkg:/components/personCreditsHost.bs"
import "pkg:/components/userDataHost.bs"

import "pkg:/source/api/Image.bs"
import "pkg:/source/utils/detailButtons.bs"
import "pkg:/source/utils/detailImages.bs"
import "pkg:/source/utils/fileFacts.bs"
import "pkg:/source/utils/fontApply.bs"
import "pkg:/source/utils/mediaBadges.bs"
import "pkg:/source/utils/misc.bs"

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeChrome.bs"

' Geometry follows the other clients' next up card, which is written in the same
' 1920x1080 pixels this screen is
const UPNEXT_TEXT_WIDTH = 330
const UPNEXT_FOOT_GAP = 17
const UPNEXT_REMAINING_GAP = 17
const UPNEXT_PROGRESS_HEIGHT = 6
const UPNEXT_LINE_SPACING = 6

sub init()
    m.label = m.top.findNode("upNextLabel")
    m.overview = m.top.findNode("overview")
    m.foot = m.top.findNode("foot")
    m.progressTrack = m.top.findNode("progressTrack")
    m.progressBar = m.top.findNode("progressBar")
    m.remaining = m.top.findNode("remaining")
    m.thumb = m.top.findNode("thumb")
    m.cardFocus = m.top.findNode("cardFocus")

    m.label.font.size = 17
    m.overview.font.size = 17
    m.overview.lineSpacing = UPNEXT_LINE_SPACING
    m.remaining.font.size = 16

    applyPalette()
    m.top.observeField("focusedChild", "onFocusChanged")
    themeApply.ApplyToItem(m.top)
end sub

' The label and the progress fill both ride on the accent, the way they do on
' the other clients
sub applyPalette()
    accent = themeChrome.IsActive() ? themeChrome.Accent() : "#00A4DC"
    m.label.color = accent
    m.progressBar.color = accent
end sub

sub onDataChanged()
    m.label.text = m.top.title
    m.overview.text = m.top.overviewText
    m.overview.visible = isValidAndNotEmpty(m.top.overviewText)
    m.thumb.uri = m.top.thumbUrl

    pct = m.top.progress
    if pct < 0 then pct = 0
    if pct > 100 then pct = 100

    m.progressTrack.visible = pct > 0
    m.progressBar.visible = pct > 0
    m.remaining.text = m.top.remainingText
    m.remaining.visible = isValidAndNotEmpty(m.top.remainingText)

    layoutFoot(pct)
end sub

' The bar takes whatever the remaining time leaves behind, and with no bar the
' time sits hard right on its own
sub layoutFoot(pct as float)
    m.foot.translation = [0, m.overview.boundingRect().height + UPNEXT_FOOT_GAP]

    remainingWidth = 0
    if m.remaining.visible
        m.remaining.width = 0
        remainingWidth = m.remaining.boundingRect().width
        m.remaining.width = UPNEXT_TEXT_WIDTH
    end if

    trackWidth = UPNEXT_TEXT_WIDTH - remainingWidth - UPNEXT_REMAINING_GAP
    if trackWidth < 0 then trackWidth = 0

    m.progressTrack.width = trackWidth
    m.progressBar.width = trackWidth * (pct / 100)

    footHeight = m.remaining.visible ? m.remaining.boundingRect().height : UPNEXT_PROGRESS_HEIGHT
    barY = (footHeight - UPNEXT_PROGRESS_HEIGHT) / 2
    m.progressTrack.translation = [0, barY]
    m.progressBar.translation = [0, barY]
end sub

sub onFocusChanged()
    m.cardFocus.visible = m.top.isInFocusChain()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "OK"
        m.top.selected = true
        return true
    else if key = "up" or key = "down" or key = "left"
        m.top.escape = key
        return true
    end if
    return false
end function

import "pkg:/source/utils/misc.bs"

sub init()
    m.card = m.top.findNode("card")
end sub

' A copy for the card, so the fields it reads don't end up on the node the screen opens
sub drawCard()
    item = m.top.cardData?.item
    size = m.top.cardSize
    if type(item) <> "roSGNode" or not isValid(size) or size.count() <> 2 then return

    node = CreateObject("roSGNode", "ContentNode")
    node.title = item.title
    node.sdPosterUrl = item.sdPosterUrl
    node.addFields({
        mediaType: item.mediaType ?? "",
        mediaInfoStatus: item.mediaInfoStatus ?? 0,
        cardKind: "poster",
        posterSize: size,
        maskUri: "pkg:/images/seerr/gridMask189.webp",
        ' Stage's rails clip a grown card, so focus only rings it
        focusStyle: "ring",
        cardSubtitle: item.releaseYear ?? ""
    })
    m.card.itemContent = node

    bounds = m.card.boundingRect()
    m.top.cardHeight = bounds.y + bounds.height
end sub

sub onFocusChanged()
    m.card.itemHasFocus = m.top.focused
    m.card.focusPercent = m.top.focused ? 1.0 : 0.0
end sub

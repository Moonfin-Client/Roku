<?xml version="1.0" encoding="utf-8"?>
<!-- A Seerr title in Stage's rails, drawn with the Requests page's own card so the two look alike.
     Takes the rail's card fields and hands SeerrCard the content node it expects. -->
<component name="StageSeerrCard" extends="Group">
    <children>
        <SeerrCard id="card" />
    </children>
    <interface>
        <!-- { item }: the Seerr title's content node -->
        <field id="cardData" type="assocarray" onChange="drawCard" />
        <!-- [poster width, poster height] -->
        <field id="cardSize" type="array" onChange="drawCard" />
        <field id="focused" type="boolean" onChange="onFocusChanged" />
        <field id="cardHeight" type="float" value="0" />
        <!-- Set by the rail, but the card keeps the Requests page's text sizes -->
        <field id="textScale" type="float" value="1" />
    </interface>
</component>

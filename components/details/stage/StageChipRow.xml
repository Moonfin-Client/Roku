<?xml version="1.0" encoding="utf-8"?>
<component name="StageChipRow" extends="Group">
    <children>
        <!-- One chip per entry, each naming what it is and what it is set to -->
        <Group id="track" />
        <!-- Never shown, they lend their fonts to the chips built at runtime -->
        <Label id="labelFont" font="font:SmallestSystemFont" visible="false" />
        <Label id="valueFont" font="font:SmallestBoldSystemFont" visible="false" />
        <Label id="headingFont" font="font:SmallestBoldSystemFont" visible="false" />
    </children>
    <interface>
        <!-- [{ label, value, icon }] -->
        <field id="chips" type="array" onChange="onChipsChanged" />
        <!-- The room the row has before it wraps onto another line -->
        <field id="maxWidth" type="float" value="1278" />
        <field id="focusIndex" type="integer" value="-1" onChange="showFocus" />
        <field id="rowHeight" type="float" value="0" />
        <!-- Lays the chips out in a box with a column per label, set ahead of chips -->
        <field id="columns" type="boolean" value="false" />
    </interface>
</component>

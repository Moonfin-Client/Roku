<?xml version="1.0" encoding="utf-8"?>
<component name="NouveauRail" extends="Group">
    <children>
        <!-- The heading sits inside the rail so that bringing the rail's top into
            view necessarily brings its heading with it -->
        <Label id="railTitle" font="font:LargeBoldSystemFont" color="#FFFFFF" visible="false" />
        <Group id="viewport">
            <Group id="track" />
        </Group>
    </children>
    <interface>
        <field id="stopCount" type="integer" value="0" />
        <field id="railHeight" type="float" value="0" />
        <field id="focusedStop" type="integer" value="-1" />
        <!-- Where focus coming into the rail lands: the card it opened on -->
        <field id="entryStop" type="integer" value="0" />
        <function name="setContent" />
        <function name="focusStop" />
        <function name="clearFocus" />
        <function name="cardIndexForStop" />
        <function name="partForStop" />
    </interface>
</component>

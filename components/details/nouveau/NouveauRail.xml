<?xml version="1.0" encoding="utf-8"?>
<component name="NouveauRail" extends="Group">
    <children>
        <!-- The heading sits inside the rail so that bringing the rail's top into
            view necessarily brings its heading with it -->
        <Label id="railTitle" font="font:LargeBoldSystemFont" color="#FFFFFF" visible="false" />
        <Group id="viewport">
            <Group id="track" />
        </Group>
        <!-- Each press starts the glide again from wherever the track is, so holding a direction
            keeps the track moving instead of stopping at every card -->
        <Animation id="glide" duration="0.2" repeat="false" easeFunction="outQuad">
            <Vector2DFieldInterpolator id="glideInterp" key="[0.0, 1.0]" keyValue="[[0, 0], [0, 0]]" fieldToInterp="track.translation" />
        </Animation>
        <!-- With Card Focus Expansion on, the focused card grows over the same time. The driver's
            opacity runs 0 to 1, and each frame sizes the card that grows and the one that shrinks. -->
        <Group id="growDriver" visible="false" opacity="0" />
        <Animation id="grow" duration="0.2" repeat="false" easeFunction="outQuad">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="growDriver.opacity" />
        </Animation>
    </children>
    <interface>
        <field id="stopCount" type="integer" value="0" />
        <field id="railHeight" type="float" value="0" />
        <field id="focusedStop" type="integer" value="-1" />
        <!-- Where focus coming into the rail lands: the card it opened on -->
        <field id="entryStop" type="integer" value="0" />
        <function name="setContent" />
        <function name="focusStop" />
        <function name="clearFocus" />
        <function name="resetPlacement" />
        <function name="cardIndexForStop" />
        <function name="partForStop" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="NouveauSeriesEpisodesTask" extends="Task">
    <interface>
        <field id="seriesId" type="string" />
        <!-- A show from another server is asked for there -->
        <field id="serverUrl" type="string" value="" />
        <field id="serverUserId" type="string" value="" />
        <field id="serverAuthToken" type="string" value="" />
        <!-- Only the screens that draw poster labels ask for them -->
        <field id="withLabels" type="boolean" value="false" />
        <field id="episodes" type="array" alwaysNotify="true" />
    </interface>
</component>

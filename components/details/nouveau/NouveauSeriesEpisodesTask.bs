import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/utils/misc.bs"

' A series arrives as one flat run of episodes and the screen shows a season at a
' time, so the whole run is fetched once and the selector only changes which part
' of it is drawn rather than asking the server again.

sub init()
    m.top.functionName = "loadSeriesEpisodes"
end sub

sub loadSeriesEpisodes()
    if not isValidAndNotEmpty(m.top.seriesId)
        m.top.episodes = []
        return
    end if

    remote = isValidAndNotEmpty(m.top.serverUrl)
    params = {
        "UserId": remote ? m.top.serverUserId : m.global.session.user.id,
        "fields": "Overview,MediaSources,MediaStreams"
    }
    if remote
        data = getJson(APIRequestForServer(m.top.serverUrl, m.top.serverUserId, m.top.serverAuthToken, `Shows/${m.top.seriesId}/Episodes`, params))
    else
        data = api.shows.GetEpisodes(m.top.seriesId, params)
    end if

    if not isChainValid(data, "Items")
        m.top.episodes = []
        return
    end if

    results = []
    for each item in data.Items
        node = CreateObject("roSGNode", "TVEpisodeData")
        imageParams = { "maxWidth": 600, "maxHeight": 340, "quality": "90" }
        if remote
            item._serverUrl = m.top.serverUrl
            item._userId = m.top.serverUserId
            item._authToken = m.top.serverAuthToken
            if isEmbyServer(m.top.serverUrl) then imageParams.api_key = m.top.serverAuthToken
            node.posterURL = buildURLForServer(m.top.serverUrl, `Items/${item.Id}/Images/Primary`, imageParams)
        else
            node.posterURL = api.items.GetImageURL(item.LookupCI("id"), ImageType.PRIMARY, 0, imageParams)
        end if
        node.json = item
        node.overview = item.overview
        results.push(node)
    end for

    m.top.episodes = results
end sub

import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

' Two lines each, then the card gives up rather than pushing the rail taller than
' its neighbours
const NOUVEAU_PERSON_NAME_GAP = 16
const NOUVEAU_PERSON_NAME_HEIGHT = 42
const NOUVEAU_PERSON_ROLE_GAP = 6
const NOUVEAU_PERSON_ROLE_HEIGHT = 37
const NOUVEAU_PERSON_RING = 2

sub init()
    m.avatarGroup = m.top.findNode("avatarGroup")
    m.avatarRing = m.top.findNode("avatarRing")
    m.avatarMask = m.top.findNode("avatarMask")
    m.avatarBg = m.top.findNode("avatarBg")
    m.avatarImage = m.top.findNode("avatarImage")
    m.personName = m.top.findNode("personName")
    m.personRole = m.top.findNode("personRole")

    m.personName.font.size = 16
    m.personRole.font.size = 14

    themeApply.ApplyToItem(m.top)
end sub

sub onCardSizeChanged()
    size = m.top.cardSize
    if not isValidAndNotEmpty(size) or size.count() < 2 then return

    width = size[0]
    avatar = size[1]
    scale = m.top.textScale
    ' Left alone at 1, so a theme font keeps the size it was given
    if scale <> 1
        m.personName.font.size = Int(16 * scale)
        m.personRole.font.size = Int(14 * scale)
    end if
    nameHeight = Int(NOUVEAU_PERSON_NAME_HEIGHT * scale)
    roleHeight = Int(NOUVEAU_PERSON_ROLE_HEIGHT * scale)

    m.avatarGroup.translation = [(width - avatar) / 2, 0]
    m.avatarRing.width = avatar + NOUVEAU_PERSON_RING * 2
    m.avatarRing.height = avatar + NOUVEAU_PERSON_RING * 2
    m.avatarRing.translation = [-NOUVEAU_PERSON_RING, -NOUVEAU_PERSON_RING]
    m.avatarMask.maskSize = [avatar, avatar]
    m.avatarBg.width = avatar
    m.avatarBg.height = avatar
    m.avatarImage.width = avatar
    m.avatarImage.height = avatar

    nameY = avatar + NOUVEAU_PERSON_NAME_GAP
    m.personName.translation = [0, nameY]
    m.personName.width = width
    m.personName.height = nameHeight
    m.personRole.translation = [0, nameY + nameHeight + NOUVEAU_PERSON_ROLE_GAP]
    m.personRole.width = width
    m.personRole.height = roleHeight

    height = nameY + nameHeight + NOUVEAU_PERSON_ROLE_GAP + roleHeight
    m.top.cardHeight = height
end sub

sub onCardDataChanged()
    data = m.top.cardData
    if not isValid(data) then return

    m.avatarImage.uri = isValid(data.imageUrl) ? data.imageUrl : ""
    m.personName.text = isValid(data.name) ? data.name : ""
    m.personRole.text = isValid(data.role) ? data.role : ""
    m.personRole.visible = isValidAndNotEmpty(m.personRole.text)

    onCardSizeChanged()
end sub

sub onFocusChanged()
    m.avatarRing.blendColor = m.top.focused ? "#FFFFFF" : "#FFFFFF1A"
end sub

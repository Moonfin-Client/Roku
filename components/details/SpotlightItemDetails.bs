' The Spotlight detail screen: the artwork first, with summary cards under the hero
' that open what they name. The band is one focusable row of SpotlightSummaryCard
' nodes, and an open card becomes a SpotlightSectionModal over the page. The hero,
' buttons and backdrop are shared with the modern screen through the host files.

' Card band metrics
const SPOTLIGHT_PAGE_PAD = 40
const SPOTLIGHT_CARD_GAP = 16
const SPOTLIGHT_MAX_CARD_H = 200
const SPOTLIGHT_MIN_CARD_H = 120
const SPOTLIGHT_CARD_H_SHARE = 0.28
const SPOTLIGHT_CARD_WIDE_RATIO = 1.7777
' The hero column, which the band under it matches
const SPOTLIGHT_HERO_GAP = 10
const SPOTLIGHT_HERO_WIDTH = 1100
const SPOTLIGHT_OVERVIEW_WIDTH = 800
const BUTTON_COLLAPSED_WIDTH = 75
const BUTTON_ROW_GAP = 12
const BUTTON_LABEL_PAD = 41

sub init()
    m.loadStatus = ViewLoadStatus.INIT

    m.titleNode = m.top.findNode("title")
    m.overview = m.top.findNode("overview")
    m.overview.observeField("boxHeight", "onOverviewHeightChanged")
    m.statusBadge = m.top.findNode("statusBadge")
    m.upcomingBadge = m.top.findNode("upcomingBadge")
    m.metaSeparators = m.top.findNode("metaSeparators")
    m.runtimeGroup = m.top.findNode("runtimeGroup")
    m.techRow = m.top.findNode("techRow")
    m.techRowHeight = 40
    m.metaRowHeight = 34
    m.logoGroup = m.top.findNode("logoGroup")
    m.logoImage = m.top.findNode("logoImage")
    m.buttonRow = m.top.findNode("buttonRow")
    m.buttonRowExtra = m.top.findNode("buttonRowExtra")
    m.upNextCard = m.top.findNode("upNextCard")
    m.upNextCard.observeField("selected", "onUpNextSelected")
    m.upNextCard.observeField("escape", "onUpNextEscape")
    m.upNextItem = invalid

    m.backdrop = m.top.findNode("backdrop")
    m.backdropScrim = m.top.findNode("backdropScrim")
    m.backdropLeftScrim = m.top.findNode("backdropLeftScrim")
    m.backdropBottomScrim = m.top.findNode("backdropBottomScrim")

    ' The scene watches this node for a selection, so a person or title opened from
    ' a card is handed over the same way the modern screen hands one over
    m.extrasGrid = m.top.findNode("extrasGrid")

    m.buttonGroups = []
    m.sectionItems = []
    m.cards = []
    m.cardState = invalid
    m.openCardIndex = -1
    m.currentButtonIndex = 0
    m.sectionModal = m.top.findNode("sectionModal")
    m.sectionModal.observeField("sectionItemSelected", "onModalItemSelected")
    m.sectionModal.observeField("modalClosed", "onModalClosed")
    m.cardBand = m.top.findNode("cardBand")

    m.favoriteTask = m.top.findNode("favoriteTask")
    m.playstateTask = m.top.findNode("playstateTask")
    m.themeMusicPlayer = m.top.findNode("themeMusicPlayer")

    ' The pickers the action row opens, which the button host reaches through m
    m.audioSelector = m.top.findNode("audioSelector")
    m.subtitleSelector = m.top.findNode("subtitleSelector")
    m.subtitleDownloadDialog = m.top.findNode("subtitleDownloadDialog")
    m.versionSelector = m.top.findNode("versionSelector")

    m.scrollableContent = m.top.findNode("scrollableContent")
    m.scrollAnim = m.top.findNode("scrollAnimation")
    m.scrollInterp = m.top.findNode("scrollInterpolator")
    m.currentScrollY = 0

    m.top.observeField("itemContent", "itemContentChanged")

    ' The track host already knows how to hand focus back when a picker closes, it
    ' just needs to be told when that happens
    m.audioSelector.observeField("audioStreamIndex", "onAudioStreamIndexChanged")
    m.audioSelector.observeField("visible", "onAudioSelectorVisibleChanged")
    m.subtitleSelector.observeField("subtitleStream", "onSubtitleStreamChanged")
    m.subtitleSelector.observeField("visible", "onSubtitleSelectorVisibleChanged")
    m.subtitleSelector.observeField("downloadRequested", "onSubtitleDownloadRequested")
    m.subtitleDownloadDialog.observeField("visible", "onSubtitleDownloadDialogVisibleChanged")
    m.versionSelector.observeField("videoStreamId", "onVersionSelected")
    m.versionSelector.observeField("visible", "onVersionSelectorVisibleChanged")

    m.seasonEpisodes = []
    m.tabGrid = invalid
    m.seerrBlock = m.top.findNode("seerrBlock")
    m.seerrRecommendations = []
    m.seerrSimilar = []
    if isValid(m.seerrBlock)
        m.seerrBlock.observeField("recommendationItems", "onSeerrRecommendations")
        m.seerrBlock.observeField("similarItems", "onSeerrSimilar")
    end if

    m.top.optionsAvailable = false

    sizeHeroFonts()
    themeApply.ApplyToItem(m.top)
end sub

sub sizeHeroFonts()
    heroSize = fontApply.ThemeTextSize(24)
    badgeSize = fontApply.ThemeTextSize(24)

    for each id in ["releaseYear", "officialRating", "seasonCount", "episodeNumber", "runtime", "endsAt", "metaGenres", "tagline"]
        node = m.top.findNode(id)
        if isValid(node) then node.font.size = heroSize
    end for

    m.top.findNode("statusBadgeText").font.size = badgeSize
    m.overview.fontSize = 22
    m.overview.maxWidth = SPOTLIGHT_OVERVIEW_WIDTH
    m.titleNode.font.size = 52
end sub

' ===== Content =====

sub itemContentChanged()
    try
        renderDetailContent()
    catch error
        print "[Details] render failed: "; error.number; " "; error.message
        m.detailErrorDialog = CreateObject("roSGNode", "Dialog")
        m.detailErrorDialog.title = tr("Unable to load item details. Check the server connection and try again.")
        m.detailErrorDialog.buttons = [tr("OK")]
        m.detailErrorDialog.observeField("buttonSelected", "onDetailErrorDismissed")
        m.top.getScene().dialog = m.detailErrorDialog
    end try
    stopLoadingSpinner()
end sub

sub onDetailErrorDismissed()
    m.detailErrorDialog.close = true
    m.global.sceneManager.callFunc("popScene")
end sub

sub renderDetailContent()
    item = m.top.itemContent

    if not isChainValid(item, "json")
        if m.buttonRow <> invalid then m.buttonRow.visible = true
        stopLoadingSpinner()
        return
    end if

    itemData = item.json
    m.top.id = itemData.id

    loadSeerrBlock(itemData)

    if isValid(m.themeMusicPlayer) and not m.top.seerrOnly
        m.themeMusicPlayer.itemId = itemData.id
    end if

    m.top.trailerAvailable = isValidAndNotEmpty(itemData.RemoteTrailers) or isValidAndNotEmpty(itemData.LocalTrailerCount)

    updateButtonVisibility(itemData)

    if m.loadStatus = ViewLoadStatus.RELOAD
        buildAndShowCards()
        return
    end if

    applyBackdropTreatment()

    for each id in ["releaseYear", "episodeNumber", "officialRating", "seasonCount", "runtime", "endsAt", "metaGenres", "tagline", "episodeHeader"]
        setFieldText(id, "")
    end for
    m.statusBadge.visible = false

    if isEpisode()
        populateEpisodeMetadataCompact(itemData)
    else if isSeries()
        populateSeriesMetadata(itemData)
    else if isSeason()
        populateSeasonMetadata(itemData)
    else if isMusic()
        populateMusicMetadata(itemData)
    else
        populateMovieMetadata(itemData)
    end if

    populateRatings(itemData)
    fetchMDBListRatings(itemData)
    populateGenres(itemData)
    updateStatusBadge(itemData)
    populateRuntime(itemData)
    setBackdropImage(itemData)

    setFieldText("title", itemData.name)
    m.titleNode.visible = isValidAndNotEmpty(itemData.name) and not m.logoGroup.visible

    hideMediaDesc = hidesMediaDescription() and (isEpisode() or LCase(m.top.itemType) = "movie")

    taglineNode = m.top.findNode("tagline")
    if isValid(taglineNode)
        taglineNode.visible = not hideMediaDesc and isValidAndNotEmpty(taglineNode.text)
    end if

    overviewText = itemData.overview
    if isValidAndNotEmpty(overviewText)
        overviewText = stripHtmlTags(overviewText)
    end if
    m.overview.text = overviewText
    m.overview.visible = not hideMediaDesc and isValidAndNotEmpty(overviewText)

    if m.buttonRow <> invalid then m.buttonRow.visible = true

    layoutHero()
    loadExtrasForCards()
    stopLoadingSpinner()
end sub

' The extras load feeds the cards, the same way the modern screen's tab grid is
' fed. One poll timer covers the loader answering after the hero is up.
' Season episodes arrive from the factory as { Items: [TVEpisodeData...] }
sub onSeasonEpisodesLoaded()
    data = m.top.seasonEpisodesData
    if not isValid(data) or not isValid(data.Items) then return

    m.seasonEpisodes = data.Items

    if isChainValid(m.top.itemContent, "json")
        populateSeasonMetadata(m.top.itemContent.json)
        layoutMetadataRow()
    end if

    updateCardState({ episodes: m.seasonEpisodes })
end sub

sub loadExtrasForCards()
    loadTask = CreateObject("roSGNode", "LoadExtrasTask")
    loadTask.itemId = m.top.id

    if isEpisode()
        loadTask.isEpisode = true
        loadTask.showID = m.top.itemContent.showID
        loadTask.seasonID = m.top.itemContent.seasonID
    else if isSeries()
        loadTask.isTVShow = true
        loadTask.showID = m.top.itemContent.id
    end if

    item = m.top.itemContent
    if isValid(item) and isChainValid(item, "json")
        itemData = item.json
        if isValidAndNotEmpty(itemData._serverUrl)
            loadTask.serverUrl = itemData._serverUrl
            loadTask.serverUserId = itemData._userId
            loadTask.serverAuthToken = itemData._authToken
        end if
    end if

    loadTask.observeField("content", "onExtrasForCardsLoaded")
    loadTask.control = "RUN"
end sub

sub onExtrasForCardsLoaded(event as object)
    content = event.getData()
    if not isValid(content) then return

    ' Split the flat rows the loader returns into the card state the builder
    ' reads
    state = {}

    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        if not isValid(row) then continue for

        items = []
        for j = 0 to row.getChildCount() - 1
            items.push(row.getChild(j))
        end for

        rowTitle = row.title
        if rowTitle = "seasons"
            state.seasons = items
        else if rowTitle = "episodes"
            state.episodes = items
        else if rowTitle = "people"
            people = splitCastAndCrew(items)
            state.cast = people.cast
            state.crew = people.crew
        else if rowTitle = "similar"
            state.similar = items
        end if
    end for

    updateCardState(state)
end sub

' The extras loader, the season episodes and Seerr all answer at their own pace, so
' each fills its own part of the state rather than replacing the lot
sub updateCardState(over as object)
    if not isValid(m.cardState) then m.cardState = spotlightCardState()

    for each key in over
        m.cardState[key] = over[key]
    end for

    buildAndShowCards(m.cardState)
end sub

' The card builder state, everything the builders read off m.s
function spotlightCardState(over = invalid) as object
    state = {
        item: m.top.itemContent,
        serverUrl: "",
        settings: {},
        seerrOnly: m.top.seerrOnly,
        seasons: [],
        episodes: isValid(m.seasonEpisodes) ? m.seasonEpisodes : [],
        seriesEpisodes: [],
        similar: [],
        similarSource: "",
        extras: [],
        cast: [],
        crew: [],
        nextUp: [],
        collectionItems: [],
        albumTracks: [],
        artistAlbums: [],
        playlistItems: [],
        seerrRecommendations: m.seerrRecommendations,
        seerrSimilar: m.seerrSimilar,
        fallbackImageUrl: m.backdrop.uri
    }
    if isValid(over)
        for each key in over
            state[key] = over[key]
        end for
    end if
    return state
end function

sub onSeerrRecommendations(event as object)
    m.seerrRecommendations = event.getData()
    rebuildCardsWithSeerr()
end sub

sub onSeerrSimilar(event as object)
    m.seerrSimilar = event.getData()
    rebuildCardsWithSeerr()
end sub

' The library rows are already in hand by the time Seerr answers, so they are carried
' over rather than fetched again
sub rebuildCardsWithSeerr()
    updateCardState({ seerrRecommendations: m.seerrRecommendations, seerrSimilar: m.seerrSimilar })
end sub

sub buildAndShowCards(state = invalid)
    if not isValid(state) then state = spotlightCardState()
    m.cardState = state

    m.cards = spotlightCardsFor(state)
    drawCardBand()
    stopLoadingSpinner()
end sub

' Draw the band: one SpotlightSummaryCard per card, sized against the screen so
' the band fits under the hero without scrolling
sub drawCardBand()
    m.cardBand.removeChildrenIndex(m.cardBand.getChildCount(), 0)
    if m.cards.count() = 0 then return

    ' The band matches the hero column so the two line up down the left edge, and it
    ' sits on the bottom padding the way the page splits its space
    bandWidth = SPOTLIGHT_HERO_WIDTH
    cardHeight = SPOTLIGHT_MAX_CARD_H
    if cardHeight > 1080 * SPOTLIGHT_CARD_H_SHARE then cardHeight = 1080 * SPOTLIGHT_CARD_H_SHARE
    if cardHeight < SPOTLIGHT_MIN_CARD_H then cardHeight = SPOTLIGHT_MIN_CARD_H
    m.cardBand.translation = [SPOTLIGHT_PAGE_PAD, 1080 - SPOTLIGHT_PAGE_PAD - cardHeight]

    even = (bandWidth - (m.cards.count() - 1) * SPOTLIGHT_CARD_GAP) / m.cards.count()
    cardWidth = even
    maxWidth = cardHeight * SPOTLIGHT_CARD_WIDE_RATIO
    if cardWidth > maxWidth then cardWidth = maxWidth

    x = 0
    idx = 0
    for each card in m.cards
        node = CreateObject("roSGNode", "SpotlightSummaryCard")
        ' roSGNode has no way to ask a child what index it sits at, so stamp
        ' the position on the node itself while we know it.
        node.addFields({ cardIndex: idx })
        node.cardData = card
        node.cardSize = [cardWidth, cardHeight]
        node.translation = [x, 0]
        node.observeField("focusedChild", "onCardFocusChanged")
        m.cardBand.appendChild(node)
        x += cardWidth + SPOTLIGHT_CARD_GAP
        idx++
    end for
end sub

sub onCardFocusChanged(event as object)
    focused = event.getRoSGNode()
    if not isValid(focused) then return

    isFocused = focused.hasFocus() or focused.isInFocusChain()
    focused.focused = isFocused
    if isFocused
        m.openCardIndex = focused.cardIndex
    end if
end sub

' An episode's hero carries the series name over its own title, then the usual
' season and episode numbers in the facts row
sub populateEpisodeMetadataCompact(itemData as object)
    hideEpisodeHeader()

    if isValidAndNotEmpty(itemData.SeriesName)
        header = m.top.findNode("episodeHeader")
        if isValid(header)
            header.text = itemData.SeriesName
            header.visible = true
        end if
    end if

    if isValid(itemData.PremiereDate)
        releaseDate = CreateObject("roDateTime")
        releaseDate.FromISO8601String(itemData.PremiereDate)
        setFieldText("releaseYear", stri(releaseDate.GetYear()).trim())
    end if

    if itemData.ParentIndexNumber <> invalid and itemData.IndexNumber <> invalid
        setFieldText("episodeNumber", "S" + itemData.ParentIndexNumber.toStr() + ":E" + itemData.IndexNumber.toStr())
    end if

    buildStreamSummary(itemData)
end sub

' The file facts in the tech row under the facts line, read off the first media
' source the way the modern screen does
sub buildStreamSummary(itemData as object)
    techRow = m.top.findNode("techRow")
    if not isValid(techRow) then return

    sizeNode = m.top.findNode("techSize")

    if isChainValid(itemData, "MediaSources[0].MediaStreams")
        streams = itemData.MediaSources[0].MediaStreams
        sizeBytes = chainLookupReturn(itemData, "MediaSources[0].Size", 0)
        if sizeBytes > 0
            if isValid(sizeNode) then setFieldText("techSize", formatFileSize(sizeBytes))
        end if

        for each stream in streams
            if isValid(stream) and stream.LookupCI("type") = "Video" and isValidAndNotEmpty(stream.LookupCI("codec"))
                codec = UCase(stream.LookupCI("codec"))
                addTechChip(codec)
                exit for
            end if
        end for
    end if

    techRow.visible = techRow.getChildCount() > 0 and (isValid(sizeNode) and isValidAndNotEmpty(sizeNode.text) or m.top.findNode("techChips").getChildCount() > 0)
end sub

sub addTechChip(label as string)
    chipsGroup = m.top.findNode("techChips")
    if not isValid(chipsGroup) then return

    chipBg = m.top.createChild("Rectangle")
    chipBg.width = label.len() * 14 + 24
    chipBg.height = 36
    chipBg.color = "#000000"
    chipBg.opacity = 0.0

    chip = m.top.createChild("Label")
    chip.text = label
    chip.font = "font:SmallestSystemFont"
    chip.color = "#FFFFFFCC"
    if isValid(chipsGroup) then chipsGroup.appendChild(chip)
end sub

' The button host calls this when a button takes focus
sub highlightButton(index as integer)
    detailButtons.highlightModern(index, m.buttonGroups)
    layoutButtonRow(index)
end sub

sub unhighlightAllButtons()
    detailButtons.unhighlightAllModern(m.buttonGroups)
    layoutButtonRow(-1)
end sub

' ===== Item type helpers =====

function isSeason() as boolean
    return LCase(m.top.itemType) = "season"
end function

function isAlbum() as boolean
    return LCase(m.top.itemType) = "musicalbum"
end function

function isArtist() as boolean
    return LCase(m.top.itemType) = "musicartist"
end function

function isPlaylist() as boolean
    return LCase(m.top.itemType) = "playlist"
end function

function isMusic() as boolean
    return isAlbum() or isArtist() or isPlaylist()
end function

' The music metadata path lives in the modern screen, so Spotlight keeps its own
' compact version: the facts line reads off the same fields
sub populateMusicMetadata(itemData as object)
    hideEpisodeHeader()
end sub

' The season path shares the series metadata host

' ===== Up next =====

sub onUpNextSelected()
    if isValid(m.upNextItem) then m.top.selectedItem = m.upNextItem
end sub

sub onUpNextEscape()
end sub

' ===== Button host hooks =====

sub appendButtonNode(config as object)
    buttonGroup = detailButtons.createModernButton(config, m.buttonGroups.count())
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    m.buttonRow.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

sub clearButtonRow()
    if isValid(m.buttonRow)
        m.buttonRow.removeChildrenIndex(m.buttonRow.getChildCount(), 0)
    end if
    if isValid(m.buttonRowExtra)
        m.buttonRowExtra.removeChildrenIndex(m.buttonRowExtra.getChildCount(), 0)
    end if
    m.buttonGroups = []
end sub

sub commitButtonRow()
    layoutButtonRow(0)
end sub

' Item types that own their whole action row. Spotlight matches the modern
' screen here, so anything the host does not handle falls through to the
' default set.
function typeSpecificButtons() as boolean
    return false
end function

function markActiveButton(config as object, isActive as boolean, ink as string) as object
    config.active = isActive
    if isValid(config.iconUri) then config.icon = config.iconUri
    if isValidAndNotEmpty(ink) then config.ink = ink
    return config
end function

sub setToggleButtonLabel(buttonId as string, label as string, isActive as boolean)
    for each button in m.buttonGroups
        if isValid(button) and button.id = buttonId
            labelNode = button.findNode("btnLabel")
            if isValid(labelNode) then labelNode.text = label
            icon = button.findNode("btnIcon")
            ' The favorite heart tints when the state is active
            if isValid(icon) then icon.blendColor = isActive ? "#CC3333" : "#FFFFFF"
        end if
    end for
end sub

sub handleScreenButtonAction(action as string)
    ' The host's own dispatcher covers every action this screen offers
    onButtonAction(action)
end sub

sub toggleMoreActions()
    ' Spotlight keeps the action row short enough to never need the overflow
end sub

sub updatePlayedIndicator()
    ' No played indicator on the Spotlight hero
end sub

sub refreshAfterVersionChange()
    ' A version swap replaces the whole item payload, so the screen re-reads it
    m.top.refreshMovieDetailsData = not m.top.refreshMovieDetailsData
end sub

' ===== Modal =====

sub openFocusedCard()
    if m.openCardIndex < 0 or m.openCardIndex >= m.cards.count() then return

    ' Shown first so the sections it builds can take the remote, and focused through
    ' the card rather than the group, which would take it straight back off them
    m.sectionModal.visible = true
    m.sectionModal.card = m.cards[m.openCardIndex]
end sub

sub onModalClosed()
    m.sectionModal.visible = false

    ' Back lands on the card that opened the modal
    if m.openCardIndex >= 0 and m.openCardIndex < m.cardBand.getChildCount()
        card = m.cardBand.getChild(m.openCardIndex)
        if isValid(card)
            card.setFocus(true)
            m.top.lastFocus = card
        end if
    end if
end sub

sub onModalItemSelected(event as object)
    item = event.getData()
    if not isValid(item) then return

    if isValid(m.extrasGrid)
        m.extrasGrid.selectedItem = item
        return
    end if

    ' People inside a card open the person screen, everything else opens its
    ' own detail screen
    ' The main loop routes person selections through CreatePersonView, so a
    ' person found inside a card is handed over the same way a cast click is
    m.top.selectedItem = item
end sub

' ===== Focus =====

' Which card in the band has the remote, or -1 when the band does not
function focusedCardIndex() as integer
    for i = 0 to m.cardBand.getChildCount() - 1
        child = m.cardBand.getChild(i)
        if isValid(child) and (child.hasFocus() or child.isInFocusChain()) then return i
    end for
    return -1
end function

function buttonHasFocus() as boolean
    for each button in m.buttonGroups
        if isValid(button) and (button.hasFocus() or button.isInFocusChain()) then return true
    end for
    return false
end function

sub focusCard(index as integer)
    if index < 0 or index >= m.cardBand.getChildCount() then return

    card = m.cardBand.getChild(index)
    if not isValid(card) then return

    unhighlightAllButtons()
    m.openCardIndex = index
    card.setFocus(true)
    m.top.lastFocus = card
    setLastFocus(card)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' An open modal answers the remote itself
    if m.sectionModal.visible
        if key = KeyCode.BACK
            m.sectionModal.visible = false
            onModalClosed()
            return true
        end if
        return false
    end if

    if isValid(m.overview) and m.overview.isInFocusChain()
        if key = KeyCode.UP
            m.top.lastFocus = m.overview
            setLastFocus(m.overview)
            return FocusNav(m.top)
        else if key = KeyCode.DOWN
            if m.buttonGroups.count() > 0
                focusButton(m.currentButtonIndex)
                return true
            end if
        else if key = KeyCode.LEFT
            return FocusSidebar(m.top)
        end if
    end if

    cardIndex = focusedCardIndex()
    onButtons = buttonHasFocus()

    if cardIndex >= 0
        if key = KeyCode.LEFT
            if cardIndex > 0
                focusCard(cardIndex - 1)
                return true
            end if
            return FocusSidebar(m.top)
        else if key = KeyCode.RIGHT
            if cardIndex < m.cardBand.getChildCount() - 1 then focusCard(cardIndex + 1)
            return true
        else if key = KeyCode.UP
            ' The band sits under the action row, so up goes back to the primary button
            if m.buttonGroups.count() > 0
                focusButton(0)
                return true
            end if
        else if key = KeyCode.OK
            openFocusedCard()
            return true
        end if
    else if onButtons
        if key = KeyCode.LEFT
            if m.currentButtonIndex > 0
                focusButton(m.currentButtonIndex - 1)
                return true
            end if
            unhighlightAllButtons()
            return FocusSidebar(m.top)
        else if key = KeyCode.RIGHT
            if m.currentButtonIndex < m.buttonGroups.count() - 1 then focusButton(m.currentButtonIndex + 1)
            return true
        else if key = KeyCode.DOWN
            if m.cardBand.getChildCount() > 0
                focusCard(0)
                return true
            end if
        else if key = KeyCode.UP
            ' Into the overview where there is more of it to read, otherwise straight
            ' on up to the navbar
            if overviewCanScroll()
                focusOverview()
                return true
            end if
            m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
            unhighlightAllButtons()
            return FocusNav(m.top)
        else if key = KeyCode.OK
            handleButtonSelect()
            return true
        end if
    end if

    if key = KeyCode.BACK
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

' The action row is centered across the screen on every detail screen
sub focusOverview()
    unhighlightAllButtons()
    m.overview.setFocus(true)
    m.top.lastFocus = m.overview
    setLastFocus(m.overview)
end sub

sub onLogoImageURIChanged()
    if not isValid(m.logoImage) then return

    hasLogo = isValidAndNotEmpty(m.top.logoImageURI)
    m.logoImage.uri = hasLogo ? m.top.logoImageURI : ""

    if isEpisode()
        m.logoImage.width = 360
        m.logoImage.height = 72
    else
        m.logoImage.width = 480
        m.logoImage.height = 120
    end if

    m.logoGroup.visible = hasLogo
    m.titleNode.visible = isEpisode() or not hasLogo

    layoutContainer()
end sub
' Button actions reach this screen through the button host's dispatcher, which
' reads the config the button was built with. Spotlight handles the actions its
' hero shows and lets the host cover playback ones through the same queue calls
' the modern screen uses.
sub onButtonAction(action as string)
    item = m.top.itemContent
    if not isValid(item) then return

    if action = "play" or action = "resume"
        m.global.queueManager.callFunc("clear")
        m.global.queueManager.callFunc("push", item)
        m.global.queueManager.callFunc("playQueue")
    else if action = "favorite"
        toggleItemFavorite()
    end if
end sub

sub toggleItemFavorite()
    if not isChainValid(m.top.itemContent, "json") then return
    itemData = m.top.itemContent.json
    newStatus = not chainLookupReturn(itemData, "UserData.IsFavorite", false)

    m.favoriteTask.itemId = itemData.id
    m.favoriteTask.favTask = newStatus ? "favorite" : "unfavorite"
    m.favoriteTask.control = "RUN"

    if not isChainValid(itemData, "UserData")
        itemData.UserData = { "IsFavorite": newStatus }
    else
        itemData.UserData.IsFavorite = newStatus
    end if
end sub

' ===== Hero layout =====

' The Spotlight hero is one column, so each row sits under the last one the way
' layoutContainer does on the modern screen, minus the tab grid below
sub layoutContainer()
    layoutHero()
end sub

sub layoutHero()
    m.heroY = 0

    ' The tagline sits over the title rather than under the overview
    tagline = m.top.findNode("tagline")
    if isValid(tagline) and tagline.visible
        tagline.translation = [0, m.heroY]
        m.heroY += tagline.boundingRect().height + SPOTLIGHT_HERO_GAP
    end if

    if m.logoGroup.visible
        m.logoGroup.translation = [0, m.heroY]
        m.heroY += m.logoImage.height + SPOTLIGHT_HERO_GAP
    end if

    header = m.top.findNode("episodeHeader")
    if header.visible
        header.translation = [0, m.heroY]
        m.heroY += header.boundingRect().height + SPOTLIGHT_HERO_GAP
    end if

    if m.titleNode.visible
        m.titleNode.translation = [0, m.heroY]
        m.heroY += m.titleNode.boundingRect().height + SPOTLIGHT_HERO_GAP
    end if

    personBorn = m.top.findNode("personBorn")
    if isValid(personBorn) and personBorn.visible
        personBorn.translation = [0, m.heroY]
        m.heroY += personBorn.boundingRect().height + SPOTLIGHT_HERO_GAP
    end if

    metadataRow = m.top.findNode("metadataRow")
    layoutMetadataRow()
    metadataRow.translation = [0, m.heroY]
    m.heroY += m.metaRowHeight + SPOTLIGHT_HERO_GAP

    if m.techRow.visible
        m.techRow.translation = [0, m.heroY]
        m.heroY += m.techRowHeight + SPOTLIGHT_HERO_GAP
    end if

    ratingsRow = m.top.findNode("ratingsRow")
    if ratingsRow.visible
        ratingsRow.translation = [0, m.heroY]
        m.heroY += ratingsRow.boundingRect().height + SPOTLIGHT_HERO_GAP
    end if

    if m.overview.visible
        m.overview.translation = [0, m.heroY]
        m.heroY += m.overview.boxHeight + SPOTLIGHT_HERO_GAP
    end if

    if m.buttonRow <> invalid
        m.buttonRow.translation = [0, m.heroY]
    end if
end sub

' The modern screen scrolls its content when the hero runs long. Spotlight
' keeps the hero compact instead, so the page never scrolls.
function contentScrollOffset() as integer
    return 0
end function

sub applyBackdropTreatment()
    if not isValid(m.backdropScrim) then return

    opacityFactor = getBackdropBlurAmount() / 25.0
    m.backdropScrim.opacity = 0.80 * opacityFactor

    gradientScale = 0.3 + 0.7 * opacityFactor
    if isValid(m.backdropLeftScrim) then m.backdropLeftScrim.opacity = gradientScale
    if isValid(m.backdropBottomScrim) then m.backdropBottomScrim.opacity = gradientScale
end sub

' ===== Seerr block =====

' The modal IS the Seerr block here: the modern screen's seerr tab becomes part
' of the similar card's sections. A Seerr-only title still gets its facts drawn
' inline through the same host calls.
sub scrollToSeerrFocus()
    ' nothing to scroll, the band never leaves the page
end sub

' ===== Buttons =====

' The host builds the row, and this screen only sets the metrics its layout needs
sub layoutButtonRow(focusIndex as integer)
    x = 0
    for i = 0 to m.buttonGroups.count() - 1
        button = m.buttonGroups[i]
        if button = invalid then continue for
        button.translation = [x, 0]
        width = BUTTON_COLLAPSED_WIDTH
        if i = focusIndex
            labelNode = button.findNode("btnLabel")
            if isValid(labelNode) then width = BUTTON_COLLAPSED_WIDTH + labelNode.boundingRect().width + BUTTON_LABEL_PAD
        end if
        x += width + BUTTON_ROW_GAP
    end for
end sub

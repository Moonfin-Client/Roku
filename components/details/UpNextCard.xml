<?xml version="1.0" encoding="utf-8"?>
<component name="UpNextCard" extends="Group">
    <children>
        <Poster id="cardFill" uri="pkg:/images/details/surface17.9.png" loadDisplayMode="scaleToFit"
            width="594" height="174" blendColor="#1E1E28" opacity="0.82" />

        <!-- Rounded off at the bottom right so the artwork keeps the card's corner -->
        <MaskGroup id="thumbMask" maskUri="pkg:/images/details/upnext_thumb_mask.png"
            translation="[376, 49]">
            <Rectangle id="thumbBg" width="218" height="125" color="#1A1D22" />
            <Poster id="thumb" width="218" height="125" loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <Poster id="playIcon" uri="pkg:/images/details/play_arrow.png" width="58" height="58"
            translation="[456, 82]" opacity="0.95" />

        <Label id="upNextLabel" translation="[23, 17]" width="548" font="font:SmallSystemFont"
            color="#00A4DC" />

        <Group id="textGroup" translation="[23, 49]">
            <Label id="overview" width="330" wrap="true" maxLines="3" font="font:SmallSystemFont"
                color="#FFFFFFB3" />
            <Group id="foot">
                <Rectangle id="progressTrack" width="330" height="6" color="#FFFFFF" opacity="0.2" />
                <Rectangle id="progressBar" width="0" height="6" color="#00A4DC" />
                <Label id="remaining" width="330" horizAlign="right" font="font:SmallestSystemFont"
                    color="#FFFFFFB3" />
            </Group>
        </Group>

        <!-- Borders go last so they sit over the artwork -->
        <Poster id="cardBorder" uri="pkg:/images/details/cardborder.9.png" loadDisplayMode="scaleToFit"
            width="594" height="174" blendColor="#FFFFFF1F" />
        <Poster id="cardFocus" uri="pkg:/images/details/cardborderfocus.9.png" loadDisplayMode="scaleToFit"
            width="594" height="174" blendColor="#FFFFFF" visible="false" />
    </children>
    <interface>
        <field id="thumbUrl" type="string" onChange="onDataChanged" />
        <field id="title" type="string" onChange="onDataChanged" />
        <field id="overviewText" type="string" onChange="onDataChanged" />
        <field id="remainingText" type="string" onChange="onDataChanged" />
        <field id="progress" type="float" value="0" onChange="onDataChanged" />
        <field id="selected" type="boolean" alwaysNotify="true" />
        <field id="escape" type="string" alwaysNotify="true" />
    </interface>
</component>

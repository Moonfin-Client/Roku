' Premiere centers the title over a backdrop that fills the first screen, with the buttons and
' ratings under it. Everything else sits in framed sections further down the page.
'
' It's Stage's page laid out another way, so the loading, the chips, the rails and the keys come
' from there. This file places the parts, frames the sections and walks the remote through them.

' Moonfin Core lays a TV out at 1150 by 647 points, so every size here is its own at the 1.67 that
' takes it to this screen. A sidebar takes more room on the left than a nav along the top.
const PREMIERE_INSET = 154
const PREMIERE_SIDEBAR_INSET = 200

const PREMIERE_LOGO_WIDTH = 868
const PREMIERE_LOGO_HEIGHT = 238
const PREMIERE_TITLE_SIZE = 100
const PREMIERE_SUBTITLE_SIZE = 40
const PREMIERE_SUBTITLE_GAP = 17
const PREMIERE_META_GAP = 20
const PREMIERE_TECH_GAP = 10
const PREMIERE_TAGLINE_SIZE = 27
const PREMIERE_TEXT_GAP = 20
const PREMIERE_OVERVIEW_SIZE = 23
const PREMIERE_OVERVIEW_GAP = 17
const PREMIERE_OVERVIEW_PITCH = 35
const PREMIERE_OVERVIEW_WIDTH = 1269

' Play is a pill as wide as its label with the circles after it, and the row keeps room under them
' for the name a focused circle shows
const PREMIERE_ACTIONS_GAP = 37
const PREMIERE_PLAY_HEIGHT = 90
const PREMIERE_LABEL_ROOM = 37
const PREMIERE_BUTTON_GAP = 14
const PREMIERE_MAX_BUTTONS = 6
' What the pill adds around its label, the same as a circle that opens up to show one
const PREMIERE_LEAD_ROOM = 119
const PREMIERE_RATINGS_GAP = 27
const PREMIERE_ARROW = 50
const PREMIERE_ARROW_GAP = 20
const PREMIERE_FOOT_GAP = 20

const PREMIERE_SECTION_GAP = 40
const PREMIERE_FRAME_PAD = 30
const PREMIERE_FRAME_TOP = 27
const PREMIERE_SECTION_TITLE = 23
const PREMIERE_SECTION_TITLE_GAP = 20
const PREMIERE_TABS_GAP = 30
const PREMIERE_TITLE_INK = "#FFFFFFBF"
' Where a section sits on screen once the remote enters it
const PREMIERE_SECTION_TOP = 40
const PREMIERE_PAGE_TAIL = 107
' The room a rail keeps over and under its cards
const PREMIERE_RAIL_CLEARANCE = 20

' The episode rail fits as many cards as it can at the size it prefers, with a third of one more
' peeking in at the edge
const PREMIERE_EPISODE_PREFERRED = 444
const PREMIERE_EPISODE_MIN = 284
const PREMIERE_EPISODE_MAX = 568
const PREMIERE_EPISODE_GAP = 33
const PREMIERE_EPISODE_PEEK = 0.35

sub init()
    page = m.sectionsGroup.getParent()
    parts = m.top.findNode("premiereParts")

    ' The picture and its shading scroll with the page, under everything else on it
    backdrop = m.top.findNode("heroBackdrop")
    parts.removeChild(backdrop)
    page.insertChild(backdrop, 0)
    m.top.removeChild(m.backdrop)
    backdrop.insertChild(m.backdrop, 0)
    m.heroVignette = m.top.findNode("heroVignette")
    m.heroFade = m.top.findNode("heroFade")
    m.heroFadeDim = m.top.findNode("heroFadeDim")

    m.sectionFrames = m.top.findNode("sectionFrames")
    parts.removeChild(m.sectionFrames)
    page.insertChild(m.sectionFrames, 1)

    m.heroOverview = m.top.findNode("heroOverview")
    m.moreBelow = m.top.findNode("moreBelow")
    for each node in [m.heroOverview, m.moreBelow, m.buttonRowContainer, m.ratingsRow]
        node.reparent(m.hero, false)
    end for
    m.sectionStop = m.top.findNode("sectionStop")
    m.sectionTitleFont = m.top.findNode("sectionTitleFont")
    m.sectionStop.reparent(page, false)

    ' There's no poster here, and the overview Nouveau fills in is only read, since this one shows
    ' all of it rather than four lines and a Read More
    m.posterColumn.visible = false
    m.overview.reparent(parts, false)

    sizeLabel(m.titleNode, PREMIERE_TITLE_SIZE)
    sizeLabel(m.stageSubtitle, PREMIERE_SUBTITLE_SIZE)
    sizeLabel(m.tagline, PREMIERE_TAGLINE_SIZE)
    sizeLabel(m.heroOverview, PREMIERE_OVERVIEW_SIZE)
    sizeLabel(m.sectionTitleFont, PREMIERE_SECTION_TITLE)
    for each node in [m.titleNode, m.stageSubtitle, m.tagline]
        node.horizAlign = "center"
    end for
    if not themeChrome.IsActive() then m.tagline.color = "#FFFFFFD1"

    m.logoBox = [PREMIERE_LOGO_WIDTH, PREMIERE_LOGO_HEIGHT]
    ' The people and studios get a share of the box by how much text each column holds, the way
    ' Moonfin Core weighs them on this page
    m.factChips.weighByText = true
    ' Moonfin Core leaves Seerr's collection banner off this page
    m.seerrBlock.showCollection = false
    m.sections = []
    m.litSection = -1
    m.overviewLine = 0
end sub

' A theme swaps a label's font for one it shares with other labels, so the size goes on the font the
' label started with
sub sizeLabel(label as object, size as integer)
    font = label.font
    if label.hasField("themeBaseFont") and isValid(label.themeBaseFont) then font = label.themeBaseFont
    font.size = fontApply.ThemeTextSize(size)
    themeApply.ApplyToItem(label)
end sub

' The page sits in from whichever side the nav takes, and everything on it centers in what's left
sub placeColumns()
    m.left = PREMIERE_INSET
    if sidebarShown() then m.left = PREMIERE_SIDEBAR_INSET
    m.contentWidth = 1920 - PREMIERE_INSET - m.left
    m.hero.translation = [m.left, 0]
    for each node in [m.titleNode, m.stageSubtitle, m.tagline]
        node.width = m.contentWidth
    end for

    m.ratingsRow.maxWidth = m.contentWidth
    inner = m.contentWidth - PREMIERE_FRAME_PAD * 2
    m.trackChips.maxWidth = inner
    m.factChips.maxWidth = inner
    m.seerrBlock.blockWidth = inner

    fits = Int((inner + PREMIERE_EPISODE_GAP) / (PREMIERE_EPISODE_PREFERRED + PREMIERE_EPISODE_GAP))
    if fits < 1 then fits = 1
    width = nouveauLayout.FractionalRailWidth(inner, fits + PREMIERE_EPISODE_PEEK, PREMIERE_EPISODE_GAP)
    if width < PREMIERE_EPISODE_MIN then width = PREMIERE_EPISODE_MIN
    if width > PREMIERE_EPISODE_MAX then width = PREMIERE_EPISODE_MAX
    m.episodeCard = { width: width, height: Int(width * 9 / 16), gap: PREMIERE_EPISODE_GAP, textScale: STAGE_EPISODE_TEXT }
end sub

' The backdrop stands in for the poster on this page
sub showPoster(_itemData as object)
end sub

sub updatePlayedIndicator()
end sub

' ===== Hero =====

' The title and what's said about it sit at the foot of the first screen over the buttons, all of it
' centered
sub layoutHero()
    m.layingOut = true
    placeColumns()
    layoutMetadataRow()
    hideEpisodeHeader()
    m.personMeta.visible = false
    width = m.contentWidth

    ' From the foot of the screen up: the arrow, the ratings, the buttons and the gap over them
    bottom = 1080 - PREMIERE_FOOT_GAP
    m.moreBelow.visible = m.sections.count() > 0
    if m.moreBelow.visible
        bottom -= PREMIERE_ARROW
        m.moreBelow.translation = [(width - PREMIERE_ARROW) / 2, bottom]
        bottom -= PREMIERE_ARROW_GAP
    end if
    if m.ratingsRow.visible
        ratings = m.ratingsRow.boundingRect()
        bottom -= ratings.height
        m.ratingsRow.translation = [(width - ratings.width) / 2, bottom]
        bottom -= PREMIERE_RATINGS_GAP
    end if
    rowTop = bottom - PREMIERE_LABEL_ROOM - PREMIERE_PLAY_HEIGHT
    m.buttonRowContainer.translation = [0, rowTop]

    ' What sits over the overview, each with the gap above it
    parts = []
    if m.logoGroup.visible
        parts.push({ node: m.logoGroup, x: (width - m.logoImage.width) / 2, height: m.logoImage.height, gap: 0 })
    else if m.titleNode.visible
        m.titleNode.text = UCase(m.titleNode.text)
        fitWrappedLabel(m.titleNode)
        parts.push({ node: m.titleNode, x: 0, height: m.titleNode.height, gap: 0 })
    end if
    if m.stageSubtitle.visible
        fitWrappedLabel(m.stageSubtitle)
        parts.push({ node: m.stageSubtitle, x: 0, height: m.stageSubtitle.height, gap: PREMIERE_SUBTITLE_GAP })
    end if
    if m.metaRowHeight > 0 then parts.push({ node: m.metadataRow, x: (width - m.metaRowWidth) / 2, height: m.metaRowHeight, gap: PREMIERE_META_GAP })
    if isValid(m.incompleteLine) and m.incompleteLine.visible
        m.incompleteLine.width = width
        m.incompleteLine.wrap = true
        m.incompleteLine.horizAlign = "center"
        parts.push({ node: m.incompleteLine, x: 0, height: m.incompleteLine.boundingRect().height, gap: INCOMPLETE_LINE_GAP })
    end if
    if m.techRow.visible then parts.push({ node: m.techRow, x: (width - techRowWidth()) / 2, height: STAGE_TECH_CHIP_HEIGHT, gap: PREMIERE_TECH_GAP })
    if m.tagline.visible
        fitWrappedLabel(m.tagline)
        parts.push({ node: m.tagline, x: 0, height: m.tagline.height, gap: PREMIERE_TEXT_GAP })
    end if

    used = 0
    for each part in parts
        used += part.gap + part.height
    end for
    downloadHeight = 0
    if showDownload() then downloadHeight = PREMIERE_TEXT_GAP + m.downloadHeight

    ' The whole overview shows, unless it would push the title off the top, when it gives up the
    ' lines there's no room for
    textBottom = rowTop - PREMIERE_ACTIONS_GAP
    lines = fitOverview(textBottom - used - downloadHeight - PREMIERE_OVERVIEW_GAP)
    if lines > 0 then used += PREMIERE_OVERVIEW_GAP + lines * PREMIERE_OVERVIEW_PITCH

    y = textBottom - used - downloadHeight
    for each part in parts
        y += part.gap
        part.node.translation = [part.x, y]
        y += part.height
    end for
    if lines > 0
        y += PREMIERE_OVERVIEW_GAP
        ' Each line sits in the middle of its pitch, the way the other clients space a paragraph
        m.heroOverview.translation = [(width - m.heroOverview.width) / 2, y + m.heroOverview.lineSpacing / 2]
        y += lines * PREMIERE_OVERVIEW_PITCH
    end if
    if downloadHeight > 0 then m.downloadGroup.translation = [(width - STAGE_DOWNLOAD_WIDTH) / 2, y + PREMIERE_TEXT_GAP]

    m.layingOut = false
end sub

' How many lines of the overview fit in the room, with the label set up to show them
function fitOverview(room as float) as integer
    label = m.heroOverview
    label.visible = false
    text = ""
    if m.overview.visible then text = m.overview.text
    if text = "" or room < PREMIERE_OVERVIEW_PITCH then return 0

    ' A line is measured once the theme's font is in, and the gap between lines makes up the rest of
    ' the pitch
    if m.overviewLine = 0
        label.width = 0
        label.height = 0
        label.maxLines = 1
        label.text = "Ag"
        m.overviewLine = label.boundingRect().height
        spacing = PREMIERE_OVERVIEW_PITCH - m.overviewLine
        if spacing < 0 then spacing = 0
        label.lineSpacing = spacing
    end if

    label.width = PREMIERE_OVERVIEW_WIDTH
    if label.width > m.contentWidth then label.width = m.contentWidth
    label.height = 0
    label.maxLines = 0
    label.text = text
    needed = Int((label.boundingRect().height + label.lineSpacing) / PREMIERE_OVERVIEW_PITCH + 0.5)
    lines = Int(room / PREMIERE_OVERVIEW_PITCH)
    if needed < lines then lines = needed
    if lines < 1 then return 0

    label.maxLines = lines
    ' A wrapped label with no height can stop at its first line
    label.height = lines * PREMIERE_OVERVIEW_PITCH
    label.visible = true
    return lines
end function

' The file's chips run on from the left of their row, so the row is as wide as the last one ends
function techRowWidth() as float
    count = m.techChips.getChildCount()
    if count = 0 then return 0
    chip = m.techChips.getChild(count - 1)
    return chip.translation[0] + chip.getChild(0).width
end function

' The picture stays sharp, since it's the point of this style. The blur slider darkens its edges and
' its foot instead.
sub applyBackdropTreatment()
    amount = getBackdropBlurAmount() / 25.0
    if amount > 1 then amount = 1
    if amount < 0 then amount = 0
    shade = 0.6 + amount * 0.4

    m.backdrop.visible = get_user_setting_bool("ui.itemdetail.showBackdrop", true)
    for each layer in [m.backdropScrim, m.backdropVignette, m.backdropTopScrim, m.backdropBottomScrim, m.backdropLeftScrim]
        layer.visible = false
    end for

    ' The shading fades into the page, whatever color the theme gives it
    base = m.top.getChild(0).color
    for each layer in [m.heroVignette, m.heroFade, m.heroFadeDim]
        layer.blendColor = base
    end for
    m.heroVignette.opacity = shade
    m.heroFadeDim.opacity = shade
end sub

function backdropRequestParams(params as object) as object
    return params
end function

' ===== Sections =====

' Moonfin Core's order down the page: the episodes or Seerr's seasons, audio and subtitles, the people
' and studios behind the title, the cast, extras, collections, more like it, and then Seerr's own
' sections
sub rebuildSections()
    if not isChainValid(m.top.itemContent, "json") then return
    itemData = m.top.itemContent.json

    held = { zone: m.focusZone, key: "", stop: -1 }
    current = currentChainIndex()
    if current >= 0 then held.key = m.pieces[current].key
    if held.zone = "rail" and m.focusRail >= 0 and m.focusRail < m.rails.count()
        held.key = m.rails[m.focusRail].key
        held.stop = m.rails[m.focusRail].node.focusedStop
    end if

    m.sectionsGroup.removeChildrenIndex(m.sectionsGroup.getChildCount(), 0)
    m.rails = []
    m.pieces = []
    m.sections = []
    m.seasonBar.visible = false

    if m.top.seerrOnly
        openSection("")
        if isSeries() then addSeerrSeasons()
    else if isSeries() or isSeason() or isEpisode()
        openSection(tr("Episodes"))
        addEpisodes(false)
    end if

    m.trackChoices = trackChoices(itemData)
    showChips(m.trackChips, m.trackChoices)
    openSection(tr("Audio & Subtitles"))
    if m.trackChoices.count() > 0 then m.pieces.push({ zone: "chips", rail: -1 })

    m.factChoices = factChoices(itemData)
    showChips(m.factChips, m.factChoices)
    openSection(tr("Details"))
    if m.factChoices.count() > 0 then m.pieces.push({ zone: "facts", rail: -1 })

    openSection("")
    addCastRail()
    openSection("")
    addExtrasRail()
    for each collection in m.sectionData.parentCollections
        openSection("")
        addPosterRail(collection.name, collection.items)
    end for
    openSection("")
    addPosterRail(tr("More Like This"), m.sectionData.similar)

    seerrName = GetSeerrDisplayName()
    openSection(seerrName)
    if m.seerrBlock.visible
        ' Seerr's numbers and streaming services have nothing to press, so without its tags the
        ' section itself is the stop
        if m.seerrBlock.findNode("tagsChip").visible
            m.pieces.push({ zone: "seerr", rail: -1, key: "seerr" })
        else
            m.pieces.push(wholeStop("seerr"))
        end if
    end if
    openSection("")
    addPosterRail(`${seerrName} · ${tr("Recommendations")}`, m.sectionData.seerrRecommendations, true)
    openSection("")
    addPosterRail(`${seerrName} · ${tr("Similar")}`, m.sectionData.seerrSimilar, true)

    closeSections()
    ' The arrow under the buttons only shows once there's something under it
    if (m.sections.count() > 0) <> m.moreBelow.visible then layoutHero()
    layoutPage()
    buildChain()
    restorePremiereFocus(held)
end sub

' The parts added after this belong to a new section, with its title over them in capitals
sub openSection(title as string)
    m.sections.push({ title: UCase(title), first: m.pieces.count() })
end sub

' A section with nothing in it to press is a stop of its own
function wholeStop(key as string) as object
    return { zone: "section", rail: m.pieces.count(), key: key, node: m.sectionStop }
end function

' A section nothing was added to is dropped, and every part learns which section it's in. Nothing
' here sits beside a poster, which the keys Stage hands down ask about.
sub closeSections()
    kept = []
    for i = 0 to m.sections.count() - 1
        section = m.sections[i]
        lastPiece = m.pieces.count() - 1
        if i + 1 < m.sections.count() then lastPiece = m.sections[i + 1].first - 1
        if lastPiece >= section.first
            section.last = lastPiece
            kept.push(section)
        end if
    end for
    m.sections = kept

    for i = 0 to kept.count() - 1
        for p = kept[i].first to kept[i].last
            piece = m.pieces[p]
            piece.section = i
            piece.beside = false
            if not isValid(piece.key) then piece.key = ""
        end for
        kept[i].whole = kept[i].first = kept[i].last and m.pieces[kept[i].first].zone = "section"
    end for
    for each rail in m.rails
        rail.beside = false
    end for
end sub

' Every row carries its title in capitals the way the frames over the other sections do, and is cut
' off at the edge of its frame
function railSpec(spec as object, _beside as boolean, _titleGap as integer) as object
    spec.viewport = railViewport(false)
    spec.title = UCase(spec.title)
    spec.titleSize = PREMIERE_SECTION_TITLE
    spec.titleGap = 0
    spec.textScale = STAGE_CARD_TEXT
    return spec
end function

function railViewport(_beside as boolean) as float
    return m.contentWidth - PREMIERE_FRAME_PAD
end function

' ===== Layout =====

' The sections run down the page under the first screen, each in a frame that lights up while the
' remote is in it
sub layoutPage()
    m.sectionFrames.removeChildrenIndex(m.sectionFrames.getChildCount(), 0)
    x = m.left
    y = 1080

    for each section in m.sections
        y += PREMIERE_SECTION_GAP
        section.top = y
        frame = m.sectionFrames.createChild("Group")
        frame.translation = [x, y]
        section.fill = frameShape(frame, "pkg:/images/login/fill23.9.png")
        section.border = frameShape(frame, "pkg:/images/login/stroke23w3.9.png")

        inner = y + PREMIERE_FRAME_TOP
        if section.title <> ""
            heading = frame.createChild("Label")
            heading.font = m.sectionTitleFont.font
            heading.color = PREMIERE_TITLE_INK
            heading.text = section.title
            heading.translation = [PREMIERE_FRAME_PAD, PREMIERE_FRAME_TOP]
            inner += heading.boundingRect().height + PREMIERE_SECTION_TITLE_GAP
        end if

        previous = ""
        for i = section.first to section.last
            piece = m.pieces[i]
            if previous = "seasons" then inner += PREMIERE_TABS_GAP
            piece.top = section.top
            inner += placePiece(piece, x + PREMIERE_FRAME_PAD, inner)
            piece.bottom = inner
            previous = piece.zone
        end for

        y = inner + PREMIERE_FRAME_PAD
        section.fill.height = y - section.top
        section.border.height = y - section.top
    end for

    m.pageHeight = y + PREMIERE_PAGE_TAIL
    lightSection(m.litSection)
end sub

function frameShape(frame as object, uri as string) as object
    shape = frame.createChild("Poster")
    shape.uri = uri
    shape.width = m.contentWidth
    shape.opacity = 0
    return shape
end function

function placePiece(piece as object, x as float, y as float) as float
    if piece.zone = "chips"
        m.trackChips.translation = [x, y]
        return m.trackChips.rowHeight
    else if piece.zone = "facts"
        m.factChips.translation = [x, y]
        return m.factChips.rowHeight
    else if piece.zone = "seasons"
        m.seasonBar.translation = [x, y]
        return STAGE_SEASON_BAR_HEIGHT
    else if piece.zone = "rail"
        node = m.rails[piece.rail].node
        title = node.findNode("railTitle")
        title.color = PREMIERE_TITLE_INK
        ' A row under the frame's own title sits right under it, without the room it keeps over its cards
        lift = 0
        if not title.visible then lift = PREMIERE_RAIL_CLEARANCE
        node.translation = [x, y - lift]
        return node.railHeight - lift - PREMIERE_RAIL_CLEARANCE
    end if

    ' Seerr's block, whether or not it has anything in it to press
    m.seerrBlock.translation = [x, y]
    m.seerrTop = y
    return m.seerrBlock.blockHeight
end function

' The frame a remote is in shows its edge, and one with nothing to press in it fills in as well
sub lightSection(index as integer)
    m.litSection = index
    for i = 0 to m.sections.count() - 1
        section = m.sections[i]
        if not isValid(section.fill) then continue for
        lit = i = index
        section.border.opacity = 0
        section.fill.opacity = 0
        if lit and section.whole
            section.border.opacity = 1
            section.fill.opacity = 0.07
        else if lit
            section.border.opacity = 0.18
        end if
    end for
end sub

' ===== Focus =====

' A section the remote enters comes up to the top of the screen, as far as the page goes
sub revealPiece(index as integer)
    if index < 0 or index >= m.pieces.count() then return
    section = m.pieces[index].section
    lightSection(section)
    target = PREMIERE_SECTION_TOP - m.sections[section].top
    if target > 0 then target = 0
    lowest = lowestScroll()
    if target < lowest then target = lowest
    if target <> m.currentScrollY then scrollContentTo(target)
end sub

sub scrollToSeerrFocus()
    for i = 0 to m.pieces.count() - 1
        if m.pieces[i].key = "seerr" then revealPiece(i)
    end for
end sub

' The sections with nothing to press share a zone, so each is told apart by where it sits
function currentChainIndex() as integer
    for i = 0 to m.chain.count() - 1
        entry = m.chain[i]
        if entry.zone = m.focusZone and entry.rail = m.focusRail then return i
    end for
    return -1
end function

' Up and Down walk the parts of a section and then the sections. Going up, a section is entered where
' it starts, the same as going down.
function moveChain(direction as integer) as boolean
    index = currentChainIndex()
    if index < 0 then index = 0
    target = index + direction
    if direction < 0 and target >= 0 and m.chain[target].section <> m.chain[index].section
        target = m.sections[m.chain[target].section].first
    end if

    while target >= 0 and target < m.chain.count()
        if focusChainStop(m.chain[target]) then return true
        target += direction
    end while
    return false
end function

' Back to whichever button was focused last, with the page at its top
sub toActions()
    if m.buttonGroups.count() = 0 then return
    clearZoneFocus()
    m.focusZone = "buttons"
    m.focusRail = -1
    lightSection(-1)
    index = m.currentButtonIndex
    if index < 0 or index >= m.buttonGroups.count() then index = 0
    focusButton(index)
    if m.currentScrollY <> 0 then scrollContentTo(0)
end sub

' Coming back to the page brings up the section the remote was left in, where the other styles go
' back to the top
sub OnScreenShown(_isReturning = false as boolean)
    applyBackdropTreatment()

    picker = openTrackPicker()
    if isValid(picker)
        picker.setFocus(true)
    else if _isReturning and isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        setLastFocus(m.top.lastFocus)
        index = currentChainIndex()
        if index >= 0
            revealPiece(index)
        else
            scrollContentTo(0)
        end if
    else
        focusFirstVisibleButton()
    end if

    if m.loadStatus = ViewLoadStatus.INIT
        m.loadStatus = ViewLoadStatus.FIRSTLOAD
        return
    end if

    m.loadStatus = ViewLoadStatus.RELOAD
    if isEpisode()
        m.top.refreshEpisodeDetailsData = not m.top.refreshEpisodeDetailsData
    else if isSeries()
        m.top.refreshSeriesDetailsData = not m.top.refreshSeriesDetailsData
    else
        m.top.refreshMovieDetailsData = not m.top.refreshMovieDetailsData
    end if
end sub

' Rows fill in behind the first paint, so whatever had the remote is put back where it was, with its
' section kept at the top
sub restorePremiereFocus(held as object)
    if held.zone = "section"
        for each piece in m.pieces
            if piece.zone = "section" and piece.key = held.key and focusChainStop(piece) then return
        end for
        toActions()
        return
    end if

    restoreStageFocus(held)
    index = currentChainIndex()
    if index >= 0
        revealPiece(index)
    else
        lightSection(-1)
    end if
end sub

' ===== Buttons =====

' Play, or Request on a title that's only in Seerr, is as wide as its label and keeps it showing
function leadSpan(button as object) as float
    return PREMIERE_LEAD_ROOM + button.labelWidth
end function

' Play leads the row rather than standing over it
function hasLead() as boolean
    return false
end function

' Play, four circles and More keep the row about as wide as the title, unless the viewer set a limit
function buttonCap() as object
    return buttonLayout.ApplyButtonLimit(viewerButtonLimit(), { maxVisible: PREMIERE_MAX_BUTTONS, overflowAsMenu: true, countCapped: true })
end function

sub layoutButtonRow(_focusIndex as integer)
    widths = []
    total = -PREMIERE_BUTTON_GAP
    for each button in m.buttonGroups
        buttonWidth = STAGE_BUTTON_SIZE
        if button.spanWidth > 0 then buttonWidth = button.spanWidth * STAGE_PLAY_SCALE
        widths.push(buttonWidth)
        total += buttonWidth + PREMIERE_BUTTON_GAP
    end for

    x = (m.contentWidth - total) / 2
    for i = 0 to m.buttonGroups.count() - 1
        buttonHeight = STAGE_BUTTON_SIZE
        if m.buttonGroups[i].spanWidth > 0 then buttonHeight = PREMIERE_PLAY_HEIGHT
        m.buttonGroups[i].translation = [x, (PREMIERE_PLAY_HEIGHT - buttonHeight) / 2]
        x += widths[i] + PREMIERE_BUTTON_GAP
    end for
end sub

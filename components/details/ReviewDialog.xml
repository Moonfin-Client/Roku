<?xml version="1.0" encoding="utf-8"?>
<!-- A whole TMDB review over the details screen. Up and Down scroll a long one, Back closes it. -->
<component name="ReviewDialog" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.85" />

        <Group id="panel">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" width="1100" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" width="1100"
                blendColor="#FFFFFF" opacity="0.16" />

            <Poster id="initialFill" uri="pkg:/images/icons/circle.webp" width="64" height="64" translation="[32, 28]" />
            <Label id="initialLabel" font="font:MediumBoldSystemFont" width="64" height="64" translation="[32, 28]"
                horizAlign="center" vertAlign="center" />
            <MaskGroup id="avatarMask" maskUri="pkg:/images/icons/circle.webp" maskSize="[64, 64]" translation="[32, 28]">
                <Poster id="avatar" width="64" height="64" loadDisplayMode="scaleToZoom" />
            </MaskGroup>
            <Label id="author" font="font:MediumBoldSystemFont" width="952" translation="[116, 30]" />
            <Label id="meta" font="font:SmallSystemFont" width="952" translation="[116, 70]" />

            <!-- The text scrolls behind this window -->
            <Group id="viewport" translation="[32, 116]">
                <Group id="body" />
            </Group>
            <Rectangle id="scrollTrack" width="6" visible="false" />
            <Rectangle id="scrollThumb" width="6" visible="false" />
        </Group>
    </children>
    <interface>
        <!-- One review as tmdbReviews.Parse hands it over -->
        <field id="review" type="assocarray" />
        <!-- Where focus goes when the dialog closes, otherwise it's stranded -->
        <field id="returnFocus" type="node" />
        <function name="showReview" />
    </interface>
</component>

import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/tmdbReviews.bs"

const REVIEWS_TIMEOUT_MS = 10000
' Reviews can run to thousands of words each, so the session cache starts over once it holds a dozen titles
const REVIEWS_CACHE_SIZE = 12

sub init()
    m.top.functionName = "fetchReviews"
end sub

' A title asked about again this session is answered from the cache. A failed answer isn't
' kept, so the next visit asks again.
sub fetchReviews()
    request = m.top.target
    language = m.global.session.user.settings["ui.language"] ?? ""
    if language = "" then language = chainLookupReturn(m.global, "device.locale", "en")
    language = language.Replace("_", "-")
    key = request.mediaType + ":" + request.tmdbId + ":" + language

    if not m.global.hasField("tmdbReviewsCache") then m.global.addFields({ tmdbReviewsCache: {} })
    cache = m.global.tmdbReviewsCache
    if cache.DoesExist(key)
        m.top.reviews = cache[key]
        return
    end if

    response = getJsonWithin(APIRequest("/Moonfin/Tmdb/Reviews", { tmdbId: request.tmdbId, type: request.mediaType, language: language }), REVIEWS_TIMEOUT_MS)
    reviews = tmdbReviews.Parse(response)
    if type(response) = "roAssociativeArray" and (response.LookupCI("success") ?? false) = true
        if cache.count() >= REVIEWS_CACHE_SIZE then cache = {}
        cache[key] = reviews
        m.global.tmdbReviewsCache = cache
    end if
    m.top.reviews = reviews
end sub

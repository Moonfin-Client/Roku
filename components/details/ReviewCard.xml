<?xml version="1.0" encoding="utf-8"?>
<!-- One TMDB review: who wrote it, their score and when, over the first few lines of it -->
<component name="ReviewCard" extends="Group">
    <children>
        <Poster id="cardFill" uri="pkg:/images/details/surface12.9.png" width="560" height="300"
            blendColor="#FFFFFF" opacity="0.06" />
        <Poster id="cardBorder" uri="pkg:/images/details/cardborder.9.png" loadDisplayMode="scaleToFit"
            width="560" height="300" blendColor="#FFFFFF14" />

        <Poster id="initialFill" uri="pkg:/images/icons/circle.png" width="64" height="64"
            translation="[24, 24]" blendColor="#FFFFFF26" />
        <Label id="initialLabel" font="font:MediumBoldSystemFont" color="#FFFFFF" width="64" height="64"
            translation="[24, 24]" horizAlign="center" vertAlign="center" />
        <MaskGroup id="avatarMask" maskUri="pkg:/images/icons/circle.png" maskSize="[64, 64]" translation="[24, 24]">
            <Poster id="avatar" width="64" height="64" loadDisplayMode="scaleToZoom" />
        </MaskGroup>

        <Label id="author" font="font:MediumBoldSystemFont" color="#FFFFFF" width="432" translation="[104, 26]" />
        <Label id="meta" font="font:SmallSystemFont" color="#FFFFFFA6" width="432" translation="[104, 62]" />
        <Label id="preview" font="font:SmallSystemFont" color="#FFFFFFCC" width="512" translation="[24, 112]"
            wrap="true" maxLines="5" ellipsisText="..." />

        <Poster id="cardFocus" uri="pkg:/images/details/cardborderfocus.9.png" loadDisplayMode="scaleToFit"
            width="560" height="300" blendColor="#FFFFFF" visible="false" />
    </children>
    <interface>
        <!-- A grid hands over a node holding the review, a Nouveau rail the review itself -->
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="cardData" type="assocarray" onChange="onCardData" />
        <field id="cardSize" type="array" />
        <field id="focused" type="boolean" onChange="onFocus" />
        <field id="cardHeight" type="float" value="300" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The trailers of a title in a panel down the right of the details screen, opened by the
     trailer button when there is more than one to choose from -->
<component name="TrailerPicker" extends="Group">
    <children>
        <Rectangle id="dim" width="1920" height="1080" color="#000000" opacity="0.3" />

        <Group id="panel" translation="[1278, 0]">
            <!-- Run past the screen's top, bottom and right edges so only the left corners and
                 the left edge of the border show -->
            <Poster id="panelFill" uri="pkg:/images/details/surface12.9.png" translation="[0, -2]"
                width="666" height="1084" blendColor="#1C1C1F" opacity="0.97" />
            <Poster id="panelBorder" uri="pkg:/images/itemMenu/panelborder12.9.png" translation="[0, -2]"
                width="666" height="1084" opacity="0.12" />

            <Poster id="icon" uri="pkg:/images/icons/detail_trailer.png" width="36" height="36" />
            <Label id="heading" font="font:MediumBoldSystemFont" color="#FFFFFF" />
            <Label id="countLabel" font="font:SmallSystemFont" color="#FFFFFF99" horizAlign="right"
                vertAlign="center" />
            <Label id="subheading" font="font:SmallSystemFont" color="#FFFFFF99" />
            <Rectangle id="divider" width="642" height="1" color="#FFFFFF" opacity="0.1" />

            <!-- A list taller than the screen scrolls inside this window -->
            <Group id="rowWindow">
                <Group id="rows" />
            </Group>
        </Group>

        <!-- Never shown, they only lend their fonts to the rows built at runtime -->
        <Label id="rowTitleFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="metaFont" font="font:SmallSystemFont" visible="false" />
        <Label id="badgeFont" font="font:SmallestBoldSystemFont" visible="false" />
    </children>

    <interface>
        <field id="itemName" type="string" value="" />
        <!-- Array of { item, videoId, title, subtitled, thumb, seconds, meta }, where item is a
             server trailer to play and videoId a YouTube one -->
        <field id="trailers" type="array" />
        <!-- Where focus goes when the picker closes, otherwise it's stranded on a hidden node -->
        <field id="returnFocus" type="node" />
        <!-- The index of the trailer to play, or -1 once the picker was closed without one -->
        <field id="trailerChosen" type="integer" alwaysNotify="true" />

        <function name="showPicker" />
    </interface>
</component>

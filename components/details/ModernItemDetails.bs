' Spacing and colours for the two rows of facts under the title, taken from
' the other clients
const TECH_GAP = 9
const TECH_CHIP_PAD_H = 12
const TECH_CHIP_PAD_V = 4
const TECH_CHIP_BORDER = "#FFFFFF4D"
const TECH_CHIP_INK = "#FFFFFFCC"
const HERO_GAP = 9
const HERO_TAGLINE_GAP = 20
const HERO_OVERVIEW_GAP = 12
const HERO_ACTIONS_GAP = 35
const HERO_ACTIONS_TIGHT_GAP = 17
const HERO_TABS_GAP = 23
const TAB_CONTENT_GAP = 12
' The hero runs the full content width on its own, and gives up half of it when
' a next episode card sits alongside
const CONTENT_WIDTH = 1728
const HERO_WIDTH = 1595
const HERO_WIDTH_WITH_UP_NEXT = 960
' Kept clear of the artwork on the right
const OVERVIEW_WIDTH = 1100
const UP_NEXT_WIDTH = 594
const UP_NEXT_TOP_GAP = 14
' The hero's small copy. Bigger than the other clients ask for, because the Roku
' system font draws smaller than a browser does at the same size.
const HERO_TEXT_SIZE = 24
const HERO_BADGE_TEXT_SIZE = 19
const OVERVIEW_TEXT_SIZE = 26
' The other clients show this many people per tab at most
const PEOPLE_LIMIT = 20
const BUTTON_ROW_HEIGHT = 75
const TAB_BAR_HEIGHT = 63
const BUTTON_COLLAPSED_WIDTH = 75
const BUTTON_ROW_GAP = 12
const BUTTON_LABEL_PAD = 41
' Where each tab sits in the bar
const TAB_RANK_SEASONS = 0
const TAB_RANK_EPISODES = 1
const TAB_RANK_ITEMS = 2
const TAB_RANK_CAST = 3
const TAB_RANK_CREW = 4
const TAB_RANK_STUDIOS = 5
const TAB_RANK_CHAPTERS = 6
const TAB_RANK_EXTRAS = 7
const TAB_RANK_DETAILS = 8
const TAB_RANK_COLLECTION = 9
const TAB_RANK_OTHER = 10

sub init()
    m.top.observeField("seerrButtonsStale", "onSeerrButtonsStale")
    m.global.queueManager.callFunc("setForceTranscode", PlaybackMethod.PLAYNORMALLY)
    m.performRotationCheck = true

    m.container = m.top.findNode("container")
    m.scrollableContent = m.top.findNode("scrollableContent")
    m.extrasGrid = m.top.findNode("extrasGrid")
    m.scrollAnim = m.top.findNode("scrollAnimation")
    m.scrollInterp = m.top.findNode("scrollInterpolator")
    m.currentScrollY = 0

    if m.extrasGrid <> invalid
        m.extrasGrid.observeField("itemFocused", "onExtrasRowChanged")
    end if

    m.top.optionsAvailable = false

    m.trackData = {}
    m.currentCodec = ""
    m.versionSelector = m.top.findNode("versionSelector")
    m.audioSelector = m.top.findNode("audioSelector")
    m.subtitleSelector = m.top.findNode("subtitleSelector")
    m.subtitleDownloadDialog = m.top.findNode("subtitleDownloadDialog")

    m.favoriteTask = m.top.findNode("favoriteTask")
    m.playstateTask = m.top.findNode("playstateTask")

    m.posterImage = m.top.findNode("posterImage")
    m.playedIndicator = m.top.findNode("playedIndicator")
    m.metadataRow = m.top.findNode("metadataRow")
    m.metaSeparators = m.top.findNode("metaSeparators")
    m.techRow = m.top.findNode("techRow")
    m.techChips = m.top.findNode("techChips")
    m.statusBadge = m.top.findNode("statusBadge")
    m.upcomingBadge = m.top.findNode("upcomingBadge")
    m.upcomingIncludesSeasons = true
    m.runtimeGroup = m.top.findNode("runtimeGroup")
    m.metaRowHeight = 0
    m.techRowHeight = 0
    m.logoImage = m.top.findNode("logoImage")
    m.logoGroup = m.top.findNode("logoGroup")
    m.logoShadow = m.top.findNode("logoShadow")
    m.titleNode = m.top.findNode("title")
    m.overview = m.top.findNode("overview")
    ' Opening the overview changes how much room it takes, so the rest of the
    ' hero moves down to make way for it
    m.overview.observeField("boxHeight", "onOverviewHeightChanged")

    m.buttonRow = m.top.findNode("buttonRow")
    m.buttonRowContainer = m.top.findNode("buttonRowContainer")
    m.overflowMenu = m.top.findNode("overflowMenu")
    m.overflowMenu.observeField("chosenAction", "onOverflowAction")
    m.overflowMenu.observeField("closed", "onOverflowClosed")
    m.overflowActions = []
    m.currentButtonIndex = 0
    m.buttonGroups = []

    m.loadStatus = ViewLoadStatus.INIT
    m.global.queueManager.callFunc("setLastKnownItemID", string.empty)

    ' Shuffle task for series
    m.getShuffleEpisodesTask = createObject("roSGNode", "getShuffleEpisodesTask")

    m.top.observeField("itemContent", "itemContentChanged")
    m.top.observeField("trailerAvailable", "onDetailExtrasChanged")
    m.top.observeField("additionalParts", "onDetailExtrasChanged")

    m.audioSelector.observeField("audioStreamIndex", "onAudioStreamIndexChanged")
    m.subtitleSelector.observeField("subtitleStream", "onSubtitleStreamChanged")
    m.audioSelector.observeField("visible", "onAudioSelectorVisibleChanged")
    m.subtitleSelector.observeField("visible", "onSubtitleSelectorVisibleChanged")
    m.subtitleSelector.observeField("downloadRequested", "onSubtitleDownloadRequested")
    m.subtitleDownloadDialog.observeField("visible", "onSubtitleDownloadDialogVisibleChanged")
    m.versionSelector.observeField("videoStreamId", "onVersionSelected")
    m.versionSelector.observeField("visible", "onVersionSelectorVisibleChanged")

    m.themeMusicPlayer = m.top.findNode("themeMusicPlayer")

    m.titleNode.visible = true

    ' Modern tab bar setup
    m.tabBar = m.top.findNode("tabBar")
    m.tabGrid = m.top.findNode("tabGrid")
    m.tabGrid.observeField("itemSelected", "onTabGridItemSelected")
    m.castGrid = m.top.findNode("castGrid")
    m.castGrid.observeField("itemSelected", "onCastGridItemSelected")
    m.studioGrid = m.top.findNode("studioGrid")
    m.studioGrid.observeField("itemSelected", "onStudioGridSelected")
    m.chaptersGrid = m.top.findNode("chaptersGrid")
    m.extrasTabsBuilt = false
    m.seerrBlock = m.top.findNode("seerrBlock")
    if isValid(m.seerrBlock)
        m.seerrBlock.observeField("hasContent", "onSeerrBlockChanged")
        m.seerrBlock.observeField("focusedOffset", "onSeerrFocusMoved")
    end if
    m.chaptersGrid.observeField("itemSelected", "onChapterSelected")
    m.episodeRowGrid = m.top.findNode("episodeRowGrid")
    m.episodeRowGrid.observeField("itemSelected", "onEpisodeRowSelected")
    m.seasonEpisodes = invalid
    m.trackGrid = m.top.findNode("trackGrid")
    m.trackGrid.observeField("itemSelected", "onTrackSelected")
    m.artistAlbumGrid = m.top.findNode("artistAlbumGrid")
    m.artistAlbumGrid.observeField("itemSelected", "onArtistAlbumSelected")
    m.musicList = invalid
    m.activeGrid = m.tabGrid
    m.studioData = []
    m.chapterData = []
    m.studioLogosTask = CreateObject("roSGNode", "FetchStudioLogosTask")
    m.studioLogosTask.observeField("companies", "onStudioLogos")
    m.upNextCard = m.top.findNode("upNextCard")
    m.upNextCard.observeField("selected", "onUpNextSelected")
    m.upNextCard.observeField("escape", "onUpNextEscape")
    m.upNextItem = invalid
    m.fileInfo = m.top.findNode("fileInfo")
    m.fileInfo.observeField("focusedOffset", "onFileInfoFocusMoved")
    m.fileInfo.observeField("retryRequested", "probeFileInfo")
    m.fileInfoSubtitle = SubtitleSelection.NONE
    m.top.observeField("selectedAudioStreamIndex", "onFileInfoTracksChanged")
    m.subtitleSelector.observeField("subtitleStream", "onFileInfoTracksChanged")
    m.extrasGrid.visible = false
    m.sectionItems = []
    m.sectionSize = []
    m.sectionTabs = []
    m.tabsBuilt = false
    m.tabBar.expanded = getExpandedTabsSetting()
    m.tabBar.observeField("selectedIndex", "onTabSelected")
    m.tabBar.observeField("escape", "onTabBarEscape")
    m.extrasGrid.observeField("hasItems", "onExtrasContentReady")

    m.tabTimer = CreateObject("roSGNode", "Timer")
    m.tabTimer.duration = 0.25
    m.tabTimer.repeat = false
    m.tabTimer.observeField("fire", "onTabTimer")
    m.tabPollCount = 0
    m.tabTimer.control = "start"

    sizeHeroFonts()
    themeApply.ApplyToItem(m.top)
end sub

' The other clients set every size in this block explicitly, so the system
' fonts are resized to match rather than left at their stock sizes.
sub sizeHeroFonts()
    heroSize = fontApply.ThemeTextSize(HERO_TEXT_SIZE)
    badgeSize = fontApply.ThemeTextSize(HERO_BADGE_TEXT_SIZE)

    for each id in ["releaseYear", "officialRating", "seasonCount", "episodeNumber", "runtime", "endsAt", "metaGenres", "techSize", "techSeparator", "tagline"]
        node = m.top.findNode(id)
        if isValid(node) then node.font.size = heroSize
    end for

    m.top.findNode("statusBadgeText").font.size = badgeSize
    upcomingText = m.top.findNode("upcomingBadgeText")
    if isValid(upcomingText) then upcomingText.font.size = badgeSize
    m.top.findNode("techChipFont").font.size = badgeSize

    ' Ratings read at the same size as the badges beside them
    ratingsRow = m.top.findNode("ratingsRow")
    if isValid(ratingsRow)
        ratingsRow.valueSize = badgeSize
        ratingsRow.nameSize = badgeSize
    end if

    ' The overview does its own theme sizing, so it takes the plain size rather
    ' than the bumped one
    m.overview.fontSize = OVERVIEW_TEXT_SIZE
    m.top.findNode("techSeparator").text = fontApply.ThemeSeparator()

    ' The title is already large enough to read whatever font it is drawn in
    m.top.findNode("episodeHeader").font.size = 20
    m.top.findNode("title").font.size = 52
end sub

function getExpandedTabsSetting() as boolean
    return moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.expandedTabs`", true), true)
end function

function getUseSeriesThumbnailsSetting() as boolean
    return moonfinPlugin.ParseBoolSetting(chainLookupReturn(m.global.session, "user.settings.`ui.itemdetail.useSeriesThumbnails`", false), false)
end function

' The extras loader flips hasItems before the rows finish building, so build
' now if the rows are present, otherwise retry shortly.
sub onExtrasContentReady()
    if m.tabsBuilt then return
    content = m.extrasGrid.content
    if isValid(content) and not content.hasField("modernManaged") and content.getChildCount() > 0
        buildTabsFromContent(content)
    else
        m.tabTimer.control = "start"
    end if
end sub

sub onTabTimer()
    if m.tabsBuilt then return
    content = m.extrasGrid.content
    if isValid(content) and not content.hasField("modernManaged") and content.getChildCount() > 0
        buildTabsFromContent(content)
    else if m.tabPollCount < 20
        m.tabPollCount = m.tabPollCount + 1
        m.tabTimer.control = "start"
    end if
end sub

' Capture each loaded row's items and card size as a tab, then show one section
' at a time as a grid.
sub buildTabsFromContent(content as object)
    m.extrasTabsBuilt = true
    m.sectionItems = []
    m.sectionSize = []
    m.sectionTabs = []
    m.upNextItem = invalid
    sizes = m.extrasGrid.rowItemSize

    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)

        ' The next episode becomes the up next card, not a tab.
        rowTitle = row.title
        if isValid(rowTitle) and LCase(rowTitle).Instr("next episode") >= 0
            if row.getChildCount() > 0 then m.upNextItem = row.getChild(0)
            continue for
        end if

        items = []
        for j = 0 to row.getChildCount() - 1
            items.push(row.getChild(j))
        end for

        ' An episode lists the whole season it sits in as rows, the way a season does
        if row.hasField("seasonRun")
            m.seasonEpisodes = row.seasonRun
            m.sectionTabs.push({ label: tr("Episodes"), kind: "episodes", index: -1, rank: TAB_RANK_EPISODES })
            continue for
        end if

        ' The loader hands over one row of people, which the other clients show
        ' as two tabs
        if isStringEqual(rowTitle, tr("Cast"))
            people = splitCastAndCrewLimited(items)
            if people.cast.count() > 0 then pushSection(people.cast, [160, 265], tr("Cast"), "cast", TAB_RANK_CAST)
            if people.crew.count() > 0 then pushSection(people.crew, [160, 265], tr("Crew"), "cast", TAB_RANK_CREW)
            continue for
        end if

        sz = [200, 300]
        if isValid(sizes) and i < sizes.count() and isValid(sizes[i]) then sz = sizes[i]

        label = row.title
        if not isValidAndNotEmpty(label) then label = tr("More")
        rowKind = row.hasField("rowKind") ? row.rowKind : ""
        rank = TAB_RANK_OTHER
        if rowKind = "collectionItems"
            label = tr("Items")
            rank = TAB_RANK_ITEMS
            m.collectionMembers = items
        else if rowKind = "parentCollection"
            rank = TAB_RANK_COLLECTION
        else if isStringEqual(rowTitle, tr("Seasons"))
            rank = TAB_RANK_SEASONS
        else if isStringEqual(rowTitle, tr("Special Features"))
            label = tr("Extras")
            rank = TAB_RANK_EXTRAS
        end if
        pushSection(items, sz, label, "section", rank)
    end for

    buildStudioData()
    if m.studioData.count() > 0
        m.sectionTabs.push({ label: tr("Studios"), kind: "studios", index: -1, rank: TAB_RANK_STUDIOS })
        startStudioLogoFetch()
    end if

    buildChapterData()
    if m.chapterData.count() > 0
        m.sectionTabs.push({ label: tr("Chapters"), kind: "chapters", index: -1, rank: TAB_RANK_CHAPTERS })
    end if

    if hasDetailsInfo()
        m.sectionTabs.push({ label: tr("Details"), kind: "details", index: -1, rank: TAB_RANK_DETAILS })
    end if

    ' The tabs run in a fixed order, whatever order the loader handed its rows over in. The sort
    ' is stable, so tabs of one rank keep theirs.
    m.sectionTabs.SortBy("rank")
    appendSeerrTab()

    showUpNextCard()
    buildTabBar()
    updateSeerrSeasonMarkers()
end sub

' Everything Seerr adds to a title goes in one tab rather than several
sub appendSeerrTab()
    if not isValid(m.sectionTabs) then m.sectionTabs = []
    if not isValid(m.seerrBlock) or not m.seerrBlock.hasContent then return

    for each tabDef in m.sectionTabs
        if tabDef.kind = "seerr" then return
    end for

    m.sectionTabs.push({ label: GetSeerrDisplayName(), kind: "seerr", index: -1 })
end sub

' Seerr answers after the tabs are already up, so the bar gains the tab then and
' keeps whichever one the viewer was on
' A Seerr title brings no library rows with it, so its tab is the only one the bar gets.
' The rebuild waits a beat because doing it while the hero is still settling leaves the
' screen half drawn.
sub onSeerrBlockChanged()
    if not isValid(m.seerrTabTimer)
        m.seerrTabTimer = CreateObject("roSGNode", "Timer")
        m.seerrTabTimer.duration = 0.1
        m.seerrTabTimer.repeat = false
        m.seerrTabTimer.observeField("fire", "rebuildTabsWithSeerr")
        m.top.appendChild(m.seerrTabTimer)
    end if

    m.seerrTabTimer.control = "start"
end sub

sub rebuildTabsWithSeerr()
    selected = m.tabBar.selectedIndex
    appendSeerrTab()
    buildTabBar()

    ' Putting the bar up marks the tabs as built, which would stop the extras rows from ever
    ' adding theirs. A Seerr title has no extras coming, so only a library one hands it back.
    if not m.extrasTabsBuilt and not m.top.seerrOnly then m.tabsBuilt = false

    if selected >= 0 and selected < m.sectionTabs.count()
        m.tabBar.selectedIndex = selected
    end if
end sub

' The Seerr section is one of the tab grids here, so it is scrolled to relative to
' the tab content rather than from the top of the page
sub scrollToSeerrFocus()
    scrollContentTo(contentScrollOffset() - m.seerrBlock.focusedOffset)
end sub

' A Seerr title arrives as a tmdb id, and the screen asks Seerr for the rest itself
sub pushSection(items as object, size as object, label as string, kind as string, rank as integer)
    m.sectionItems.push(items)
    m.sectionSize.push(size)
    m.sectionTabs.push({ label: label, kind: kind, index: m.sectionItems.count() - 1, rank: rank })
end sub

' The shared split, plus what this screen's grids need: a person credited more
' than once keeps their jobs on separate lines, and each list is cut to what its
' grid can hold.
function splitCastAndCrewLimited(people as object) as object
    crew = []
    crewByName = {}

    for each person in people
        personType = LCase(chainLookupReturn(person, "json.Type", ""))
        if personType <> "director" and personType <> "writer" then continue for

        name = chainLookupReturn(person, "json.Name", "")
        key = LCase(name)
        existing = crewByName[key]
        if isValid(existing)
            if existing.subTitle.Instr(person.subTitle) < 0
                existing.subTitle = existing.subTitle + Chr(10) + person.subTitle
            end if
            continue for
        end if

        crewByName[key] = person
        crew.push(person)
    end for

    cast = []
    for each person in people
        personType = LCase(chainLookupReturn(person, "json.Type", ""))
        if personType <> "actor" and personType <> "gueststar" then continue for
        if isValid(crewByName[LCase(chainLookupReturn(person, "json.Name", ""))]) then continue for
        cast.push(person)
        if cast.count() = PEOPLE_LIMIT then exit for
    end for

    while crew.count() > PEOPLE_LIMIT
        crew.pop()
    end while

    return { cast: cast, crew: crew }
end function

sub showUpNextCard()
    if not isValid(m.upNextItem)
        m.upNextCard.visible = false
        centerButtonRow()
        return
    end if

    ep = m.upNextItem
    season = chainLookupReturn(ep, "json.ParentIndexNumber", invalid)
    episode = chainLookupReturn(ep, "json.IndexNumber", invalid)

    parts = [tr("Next Up")]
    if isValid(season) and isValid(episode) then parts.push(`S${season}:E${episode}`)
    parts.push(chainLookupReturn(ep, "json.Name", ""))
    m.upNextCard.title = parts.join(" - ")

    overviewText = chainLookupReturn(ep, "json.Overview", "")
    if hidesMediaDescription()
        overviewText = ""
    else if isValidAndNotEmpty(overviewText)
        overviewText = stripHtmlTags(overviewText)
    end if
    m.upNextCard.overviewText = overviewText

    leftTicks = chainLookupReturn(ep, "json.RunTimeTicks", 0) - chainLookupReturn(ep, "json.UserData.PlaybackPositionTicks", 0)
    if leftTicks > 0
        m.upNextCard.remainingText = tr("%1 remaining").Replace("%1", getFormattedRuntime(leftTicks))
    else
        m.upNextCard.remainingText = ""
    end if

    m.upNextCard.thumbUrl = upNextThumbUrl(ep)
    m.upNextCard.progress = chainLookupReturn(ep, "json.UserData.PlayedPercentage", 0)
    m.upNextCard.visible = true

    ' The row has less room beside the card, so it lays itself out again
    centerButtonRow()
end sub


function upNextThumbUrl(ep as object) as string
    if not isChainValid(ep, "json") then return ""
    j = ep.json
    id = j.LookupCI("Id")
    tag = invalid
    imgType = ImageType.PRIMARY

    seriesSource = invalid
    if getUseSeriesThumbnailsSetting()
        seriesSource = getSeriesThumbnailSource(j)
    end if

    if isValid(seriesSource)
        id = seriesSource.id
        tag = seriesSource.tag
        imgType = seriesSource.imageType
    else if isChainValid(j, "ImageTags.Primary")
        tag = j.ImageTags.Primary
    end if

    if not isValid(tag) then return ""

    params = { "maxWidth": 500, "maxHeight": 281, "quality": 90, "Tag": tag }
    if isChainValid(j, "_serverUrl")
        serverBase = j._serverUrl
        if serverBase.right(1) = "/" then serverBase = serverBase.left(serverBase.len() - 1)
        return buildImageURLForServer(serverBase, id, imgType, params)
    end if
    return ImageURL(id, imgType, params)
end function

sub onUpNextSelected()
    if isValid(m.upNextItem) then m.extrasGrid.selectedItem = m.upNextItem
end sub

sub onUpNextEscape()
    dir = m.upNextCard.escape
    if dir = "up"
        m.top.lastFocus = m.upNextCard
        FocusNav(m.top)
    else if dir = "left" and overviewCanScroll()
        focusOverview()
    else
        focusButtonsFromTabs()
    end if
end sub

sub focusOverview()
    m.overview.setFocus(true)
    m.top.lastFocus = m.overview
    setLastFocus(m.overview)
end sub

sub focusUpNext()
    m.upNextCard.setFocus(true)
    m.top.lastFocus = m.upNextCard
    setLastFocus(m.upNextCard)
end sub

' Collects the Jellyfin studios (names carry the logo lookup), then the TMDB
' fetch fills in logo urls where the names line up.
sub buildStudioData()
    m.studioData = []
    if not isChainValid(m.top.itemContent, "json.Studios") then return
    for each studio in m.top.itemContent.json.Studios
        name = studio.LookupCI("Name")
        if isValidAndNotEmpty(name)
            m.studioData.push({ name: name, id: studio.LookupCI("Id"), logoUrl: "" })
        end if
    end for
end sub

sub onStudioGridSelected()
    idx = m.studioGrid.itemSelected
    if idx < 0 or idx >= m.studioData.count() then return
    s = m.studioData[idx]
    if not isValidAndNotEmpty(s.id) then return
    m.top.studioSelected = {
        id: s.id,
        name: s.name,
        libraryId: chainLookupReturn(m.top.itemContent, "json.ParentId", "")
    }
end sub

sub startStudioLogoFetch()
    if not moonfinPlugin.IsTmdbEnabled() then return
    itemData = m.top.itemContent.json
    tmdbId = moonfinPlugin.GetTmdbId(itemData.ProviderIds)
    if not isValidAndNotEmpty(tmdbId) then return
    m.studioLogosTask.itemType = itemData.LookupCI("Type")
    m.studioLogosTask.tmdbId = tmdbId
    m.studioLogosTask.control = "RUN"
end sub

sub onStudioLogos()
    result = m.studioLogosTask.companies
    if not isValid(result) or result.success <> true then return
    index = studioLogos.Index(result.data)
    for each studio in m.studioData
        studio.logoUrl = studioLogos.LogoUrlFor(studio.name, index)
    end for

    if m.studioGrid.visible then populateStudioGrid()
end sub

sub populateStudioGrid()
    gridContent = CreateObject("roSGNode", "ContentNode")
    for each studio in m.studioData
        card = gridContent.createChild("ContentNode")
        card.addField("name", "string", false)
        card.addField("logoUrl", "string", false)
        card.name = studio.name
        card.logoUrl = studio.logoUrl
    end for
    m.studioGrid.content = gridContent
end sub

sub buildChapterData()
    m.chapterData = []
    if not isChainValid(m.top.itemContent, "json.Chapters") then return
    itemData = m.top.itemContent.json
    itemId = itemData.LookupCI("Id")
    chapters = itemData.Chapters

    serverBase = invalid
    if isChainValid(itemData, "_serverUrl")
        serverBase = itemData._serverUrl
        if serverBase.right(1) = "/" then serverBase = serverBase.left(serverBase.len() - 1)
    end if

    seriesThumbUrl = ""
    if getUseSeriesThumbnailsSetting()
        seriesSource = getSeriesThumbnailSource(itemData)
        if isValid(seriesSource)
            stParams = { "maxWidth": 400, "quality": 90, "Tag": seriesSource.tag }
            if isValid(serverBase)
                if isEmbyServer(serverBase) then stParams.api_key = itemData._authToken ?? ""
                seriesThumbUrl = buildImageURLForServer(serverBase, seriesSource.id, seriesSource.imageType, stParams)
            else
                seriesThumbUrl = ImageURL(seriesSource.id, seriesSource.imageType, stParams)
            end if
        end if
    end if

    for i = 0 to chapters.count() - 1
        ch = chapters[i]
        startTicks = ch.LookupCI("StartPositionTicks")
        name = ch.LookupCI("Name")
        if not isValidAndNotEmpty(name) then name = tr("Chapter") + " " + (i + 1).toStr()

        secs = 0
        if isValid(startTicks) then secs = int(startTicks / 10000000)

        thumbUrl = ""
        if seriesThumbUrl <> ""
            thumbUrl = seriesThumbUrl
        else
            imageTag = ch.LookupCI("ImageTag")
            if isValidAndNotEmpty(imageTag)
                path = "Items/" + itemId + "/Images/Chapter/" + i.toStr()
                params = { "maxWidth": 400, "tag": imageTag }
                if isValid(serverBase)
                    if isEmbyServer(serverBase) then params.api_key = itemData._authToken ?? ""
                    thumbUrl = buildURLForServer(serverBase, path, params)
                else
                    thumbUrl = buildURL(path, params)
                end if
            end if
        end if

        m.chapterData.push({ thumbUrl: thumbUrl, name: name, timeText: secondsToHuman(secs, true), startTicks: startTicks })
    end for
end sub

sub populateChapterGrid()
    gridContent = CreateObject("roSGNode", "ContentNode")
    for each chapter in m.chapterData
        card = gridContent.createChild("ContentNode")
        card.addField("name", "string", false)
        card.addField("timeText", "string", false)
        card.addField("thumbUrl", "string", false)
        card.name = chapter.name
        card.timeText = chapter.timeText
        card.thumbUrl = chapter.thumbUrl
    end for
    m.chaptersGrid.content = gridContent
end sub

' Season episodes arrive from the factory as { Items: [TVEpisodeData...] }.
sub onSeasonEpisodesLoaded()
    data = m.top.seasonEpisodesData
    if not isValid(data) or not isValid(data.Items) then return
    m.seasonEpisodes = data.Items

    ' Refresh the episode count in the metadata now that episodes are in.
    if isChainValid(m.top.itemContent, "json")
        populateSeasonMetadata(m.top.itemContent.json)
        layoutMetadataRow()
    end if

    buildSeasonTabs()
end sub

sub buildSeasonTabs()
    m.sectionTabs = []
    m.sectionTabs.push({ label: tr("Episodes"), kind: "episodes", index: -1 })
    if hasDetailsInfo()
        m.sectionTabs.push({ label: tr("Details"), kind: "details", index: -1 })
    end if
    buildTabBar()
end sub

sub populateEpisodeRowGrid()
    if not isValid(m.seasonEpisodes) then return
    gridContent = CreateObject("roSGNode", "ContentNode")
    gridContent.addFields({ modernRows: true })
    for each ep in m.seasonEpisodes
        gridContent.appendChild(ep)
    end for
    m.episodeRowGrid.content = gridContent
end sub

sub onEpisodeRowSelected()
    idx = m.episodeRowGrid.itemSelected
    if not isValid(m.seasonEpisodes) or idx < 0 or idx >= m.seasonEpisodes.count() then return
    m.top.selectedItem = m.seasonEpisodes[idx]
end sub

' Album/artist tracks/albums come in on albumData, playlists on listData.
sub onMusicDataChanged()
    if isValid(m.top.albumData)
        m.musicList = m.top.albumData
    else if isValid(m.top.listData)
        m.musicList = m.top.listData
    end if
    if not isValid(m.musicList) then return

    if isChainValid(m.top.itemContent, "json")
        populateMusicMetadata(m.top.itemContent.json)
        layoutMetadataRow()
    end if

    buildMusicTabs()
end sub

sub buildMusicTabs()
    m.sectionTabs = []
    if isArtist()
        m.sectionTabs.push({ label: tr("Albums"), kind: "albums", index: -1 })
    else
        m.sectionTabs.push({ label: tr("Tracks"), kind: "tracks", index: -1 })
    end if
    if hasDetailsInfo()
        m.sectionTabs.push({ label: tr("Details"), kind: "details", index: -1 })
    end if
    buildTabBar()
end sub

' Playlist rows arrive ready, but album songs need PlaylistItemData nodes built.
sub populateTrackGrid()
    if not isValid(m.musicList) then return
    if isPlaylist()
        m.trackGrid.content = m.musicList
        return
    end if

    content = CreateObject("roSGNode", "ContentNode")
    albumName = chainLookupReturn(m.top.pageContent, "json.name", "")
    for each item in m.musicList.getChildren(-1, 0)
        tmp = CreateObject("roSGNode", "PlaylistItemData")
        tmp.id = item.id
        tmp.title = item.title
        tmp.type = "Audio"
        tmp.RunTimeTicks = item.RunTimeTicks
        if isValid(item.LookupCI("ArtistItems")) and item.ArtistItems.count() > 0
            names = []
            for each a in item.ArtistItems
                if isValid(a.LookupCI("Name")) then names.push(a.Name)
            end for
            tmp.artists = names
        else if isValid(item.LookupCI("artists"))
            tmp.artists = item.artists
        end if
        if isValidAndNotEmpty(albumName) then tmp.album = albumName
        tmp.IndexNumber = item.LookupCI("trackNumber")
        content.appendChild(tmp)
    end for
    m.trackGrid.content = content
end sub

sub onTrackSelected()
    if isPlaylist()
        m.top.playlistItemSelected = m.trackGrid.itemSelected
    else
        m.top.playSong = m.trackGrid.itemSelected
    end if
end sub

sub onArtistAlbumSelected()
    idx = m.artistAlbumGrid.itemSelected
    if not isValid(m.musicList) or idx < 0 or idx >= m.musicList.getChildCount() then return
    m.top.selectedAlbum = m.musicList.getChild(idx)
end sub

sub onChapterSelected()
    idx = m.chaptersGrid.itemSelected
    if idx < 0 or idx >= m.chapterData.count() then return
    startTicks = m.chapterData[idx].startTicks
    itemContent = m.top.itemContent
    if not isValid(itemContent) then return

    itemContent.startingPoint = startTicks
    selectPlaybackSource(itemContent, m.top.selectedVideoStreamId)
    itemContent.selectedAudioStreamIndex = m.top.selectedAudioStreamIndex
    m.global.queueManager.callFunc("clear")
    m.global.queueManager.callFunc("push", itemContent)
    m.global.queueManager.callFunc("playQueue")
end sub

' The Details tab lists what the file is made of, so it only earns a place on a
' video with a real source whose streams the server listed
function hasDetailsInfo() as boolean
    itemData = chainLookupReturn(m.top.itemContent, "json", invalid)
    if not isValid(itemData) or not isStringEqual(itemData.MediaType, "Video") then return false
    if not isValidAndNotEmpty(itemData.MediaSources) or (itemData.MediaSources[0].Type ?? "") = "Placeholder" then return false
    return isValidAndNotEmpty(chainLookupReturn(fileInfoSource(), "MediaStreams", invalid))
end function

' The version picked in the version picker, otherwise the first one
function fileInfoSource() as dynamic
    sources = chainLookupReturn(m.top.itemContent, "json.MediaSources", [])
    if sources.count() = 0 then return invalid
    for each candidate in sources
        if isValid(candidate.Id) and candidate.Id = m.top.selectedVideoStreamId then return candidate
    end for
    return sources[0]
end function

sub showFileInfo()
    source = fileInfoSource()
    video = invalid
    audio = []
    subtitles = []
    for each stream in chainLookupReturn(source, "MediaStreams", [])
        streamType = chainLookupReturn(stream, "Type", "")
        if streamType = "Video" and not isValid(video) then video = stream
        if streamType = "Audio" then audio.push(stream)
        if streamType = "Subtitle" then subtitles.push(stream)
    end for

    ' The audio picker keeps a place in the stream list, while a track knows itself by its own index
    activeAudio = m.top.selectedAudioStreamIndex
    streams = chainLookupReturn(m.top.itemContent, "json.MediaStreams", [])
    if activeAudio >= 0 and activeAudio < streams.count() then activeAudio = chainLookupReturn(streams[activeAudio], "Index", activeAudio)

    added = fileFacts.AddedOn(chainLookupReturn(m.top.itemContent, "json.DateCreated", invalid))
    if added <> "" then added = Substitute(tr("Date Added: {0}"), added)

    m.fileInfo.callFunc("setContent", {
        fileName: fileFacts.FileName(source),
        sizeLine: fileFacts.SizeLine(source),
        added: added,
        videoLine: fileFacts.VideoLines(video).join("  •  "),
        audioLines: fileInfoTrackLines(audio, activeAudio, false),
        subtitleLines: fileInfoTrackLines(subtitles, m.fileInfoSubtitle, true)
    })
    probeFileInfo()
end sub

function fileInfoTrackLines(streams as object, activeIndex as integer, includeForced as boolean) as object
    lines = []
    for each stream in streams
        lines.push({
            text: fileFacts.TrackLine(stream, includeForced),
            active: activeIndex >= 0 and chainLookupReturn(stream, "Index", -1) = activeIndex
        })
    end for
    return lines
end function

' Asked again whenever the tab opens or a pick changes what would play, since the answer
' depends on the tracks as much as the file
sub probeFileInfo()
    if isValid(m.fileInfoTask) then m.fileInfoTask.unobserveField("result")
    m.fileInfo.callFunc("setDirectPlay", { state: "loading" })

    task = CreateObject("roSGNode", "DetailPlaybackInfoTask")
    task.itemJson = m.top.itemContent.json
    task.mediaSourceId = chainLookupReturn(fileInfoSource(), "Id", "")
    task.audioStreamIndex = m.top.selectedAudioStreamIndex
    task.subtitleStreamIndex = m.fileInfoSubtitle
    task.observeField("result", "onFileInfoProbed")
    task.control = TaskControl.RUN
    m.fileInfoTask = task
end sub

sub onFileInfoProbed(event as object)
    result = event.getData()
    if isValid(result) then m.fileInfo.callFunc("setDirectPlay", result)
end sub

' The subtitle pick arrives here before the shared handler has stored it, so it is read off
' the event rather than asked for again
sub onFileInfoTracksChanged(event as object)
    if event.getField() = "subtitleStream"
        m.fileInfoSubtitle = chainLookupReturn(event.getData(), "StreamIndex", SubtitleSelection.NONE)
    end if
    if m.fileInfo.visible then showFileInfo()
end sub

sub onFileInfoFocusMoved()
    if not m.fileInfo.isInFocusChain() then return
    scrollContentTo(contentScrollOffset() - m.fileInfo.focusedOffset)
end sub

sub buildTabBar()
    tabDefs = []
    for each t in m.sectionTabs
        tabDefs.push({ id: t.label, label: t.label })
    end for
    m.tabBar.tabs = tabDefs
    m.tabsBuilt = tabDefs.count() > 0

    if m.tabsBuilt and m.tabBar.expanded
        m.tabBar.selectedIndex = 0
    else
        m.tabBar.selectedIndex = -1
    end if

    layoutContainer()
end sub

sub onTabSelected()
    idx = m.tabBar.selectedIndex
    m.tabGrid.visible = false
    m.studioGrid.visible = false
    m.chaptersGrid.visible = false
    m.episodeRowGrid.visible = false
    m.trackGrid.visible = false
    m.artistAlbumGrid.visible = false
    m.fileInfo.visible = false
    m.castGrid.visible = false
    if isValid(m.seerrBlock) then m.seerrBlock.visible = false
    m.activeGrid = invalid

    if idx < 0 or idx >= m.sectionTabs.count() then return

    tabDef = m.sectionTabs[idx]
    if tabDef.kind = "details"
        m.fileInfoSubtitle = chainLookupReturn(m.global.queueManager.callFunc("getPreferredSubtitleTrack"), "StreamIndex", SubtitleSelection.NONE)
        showFileInfo()
        m.fileInfo.visible = true
        m.activeGrid = m.fileInfo
    else if tabDef.kind = "episodes"
        populateEpisodeRowGrid()
        m.episodeRowGrid.visible = true
        m.activeGrid = m.episodeRowGrid
    else if tabDef.kind = "tracks"
        populateTrackGrid()
        m.trackGrid.visible = true
        m.activeGrid = m.trackGrid
    else if tabDef.kind = "albums"
        m.artistAlbumGrid.content = m.musicList
        m.artistAlbumGrid.visible = true
        m.activeGrid = m.artistAlbumGrid
    else if tabDef.kind = "cast"
        populateCastGrid(tabDef.index)
        m.castGrid.visible = true
        m.activeGrid = m.castGrid
    else if tabDef.kind = "studios"
        populateStudioGrid()
        m.studioGrid.visible = true
        m.activeGrid = m.studioGrid
    else if tabDef.kind = "chapters"
        populateChapterGrid()
        m.chaptersGrid.visible = true
        m.activeGrid = m.chaptersGrid
    else if tabDef.kind = "seerr"
        m.seerrBlock.visible = true
        m.activeGrid = m.seerrBlock
    else
        showSectionGrid(tabDef.index)
        m.tabGrid.visible = true
        m.activeGrid = m.tabGrid
    end if
end sub

sub showSectionGrid(index as integer)
    if index < 0 or index >= m.sectionItems.count() then return
    items = m.sectionItems[index]
    size = m.sectionSize[index]
    cardW = size[0]
    cardH = size[1]
    spacing = 30

    m.tabGrid.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    cols = int(1728 / (cardW + spacing))
    if cols < 1 then cols = 1

    m.tabGrid.itemSize = [cardW, cardH]
    m.tabGrid.rowHeights = [cardH]
    m.tabGrid.itemSpacing = [spacing, 30]
    m.tabGrid.numColumns = cols

    gridContent = CreateObject("roSGNode", "ContentNode")
    for each item in items
        gridContent.appendChild(item)
    end for
    m.tabGrid.content = gridContent
end sub

sub populateCastGrid(index as integer)
    if index < 0 or index >= m.sectionItems.count() then return

    content = CreateObject("roSGNode", "ContentNode")
    for each person in m.sectionItems[index]
        content.appendChild(person)
    end for
    m.castGrid.content = content
end sub

sub onCastGridItemSelected()
    idx = m.castGrid.itemSelected
    content = m.castGrid.content
    if isValid(content) and idx >= 0 and idx < content.getChildCount()
        m.extrasGrid.selectedItem = content.getChild(idx)
    end if
end sub

sub onTabGridItemSelected()
    idx = m.tabGrid.itemSelected
    content = m.tabGrid.content
    if isValid(content) and idx >= 0 and idx < content.getChildCount()
        m.extrasGrid.selectedItem = content.getChild(idx)
    end if
end sub

sub onTabBarEscape()
    dir = m.tabBar.escape
    if dir = "up"
        focusButtonsFromTabs()
    else if dir = "down"
        scrollAmount = contentScrollOffset()
        ' The Seerr and Details tabs hold blocks of their own rather than a grid
        block = invalid
        if isValid(m.activeGrid) and isValid(m.seerrBlock) and m.activeGrid.isSameNode(m.seerrBlock) then block = m.seerrBlock
        if isValid(m.activeGrid) and m.activeGrid.isSameNode(m.fileInfo) then block = m.fileInfo
        if isValid(block)
            if block.callFunc("focusFirst")
                m.top.lastFocus = block
                setLastFocus(block)
                scrollContentTo(scrollAmount)
            end if
            return
        end if

        if isValid(m.activeGrid) and m.activeGrid.visible and isValid(m.activeGrid.content)
            m.activeGrid.setFocus(true)
            m.top.lastFocus = m.activeGrid
            setLastFocus(m.activeGrid)
            scrollContentTo(scrollAmount)
        end if
    end if
end sub

sub focusButtonsFromTabs()
    if m.buttonGroups.count() > 0
        m.buttonGroups[m.currentButtonIndex].setFocus(true)
        m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
        highlightButton(m.currentButtonIndex)
        setLastFocus(m.buttonGroups[m.currentButtonIndex])
    end if
    scrollContentTo(0)
end sub

' ============================================
' Content changed handler
' ============================================

sub itemContentChanged()
    try
        renderDetailContent()
    catch error
        print "[Details] render failed: "; error.number; " "; error.message
        m.detailErrorDialog = CreateObject("roSGNode", "Dialog")
        m.detailErrorDialog.title = tr("Unable to load item details. Check the server connection and try again.")
        m.detailErrorDialog.buttons = [tr("OK")]
        m.detailErrorDialog.observeField("buttonSelected", "onDetailErrorDismissed")
        m.top.getScene().dialog = m.detailErrorDialog
    end try
    stopLoadingSpinner()
end sub

sub onDetailErrorDismissed()
    m.detailErrorDialog.close = true
    m.global.sceneManager.callFunc("popScene")
end sub

sub renderDetailContent()
    item = m.top.itemContent

    ' The item type is a separate field, so it can say episode or series while the
    ' content read here has not arrived yet
    if isValid(item) and isValid(m.extrasGrid)
        if isEpisode()
            m.extrasGrid.seasonID = item.seasonID
            m.extrasGrid.showID = item.showID
            m.extrasGrid.episodeID = item.id
        else if isSeries()
            m.extrasGrid.showID = item.id
        end if
    end if

    if not isChainValid(item, "json")
        if m.buttonRow <> invalid then m.buttonRow.visible = true
        stopLoadingSpinner()
        return
    end if

    itemData = item.json
    m.top.id = itemData.id

    loadSeerrBlock(itemData)

    if isValid(m.themeMusicPlayer) and not m.top.seerrOnly
        m.themeMusicPlayer.itemId = itemData.id
    end if

    playTextNode = m.top.findNode("playText")
    if isValid(playTextNode)
        playTextNode.text = tr("Play")
    end if

    m.top.trailerAvailable = detailHasTrailer(itemData)

    updateButtonVisibility(itemData)

    if m.loadStatus = ViewLoadStatus.RELOAD
        if isCollection() then refreshCollectionMembers()
        return
    end if

    setBackdropImage(itemData)

    if not isSeries() and not isSeason() and not isMusic() and m.top.selectedVideoStreamId = "" and isValidAndNotEmpty(itemData.MediaSources)
        SetCurrentVideoCodec(itemData)
        m.top.selectedVideoStreamId = itemData.MediaSources[0].id
    end if

    if not isSeries() and not isSeason() and not isMusic()
        SetDefaultAudioTrack(itemData)
    end if

    for each id in ["releaseYear", "episodeNumber", "officialRating", "seasonCount", "runtime", "endsAt", "metaGenres", "tagline", "episodeHeader"]
        setFieldText(id, "")
    end for
    m.statusBadge.visible = false
    if isValid(m.upcomingBadge) then m.upcomingBadge.visible = false

    setPosterImage(itemData)

    if isEpisode()
        populateEpisodeMetadata(itemData, item)
    else if isSeries()
        populateSeriesMetadata(itemData)
    else if isSeason()
        populateSeasonMetadata(itemData)
    else if isMusic()
        populateMusicMetadata(itemData)
    else
        populateMovieMetadata(itemData)
    end if

    populateRatings(itemData)
    fetchMDBListRatings(itemData)
    watchAnimeMarker(item, m.top.seerrOnly ? invalid : itemData)
    populateGenres(itemData)
    updateStatusBadge(itemData)
    updateUpcomingBadge(itemData)
    updateSeerrPills()
    populateRuntime(itemData)

    setFieldText("title", itemData.name)

    hideMediaDesc = hidesMediaDescription() and (isEpisode() or LCase(m.top.itemType) = "movie")

    taglineNode = m.top.findNode("tagline")
    if isValid(taglineNode)
        taglineNode.visible = not hideMediaDesc and isValidAndNotEmpty(taglineNode.text)
    end if

    overviewNode = m.top.findNode("overview")
    overviewText = itemData.overview
    if isValidAndNotEmpty(overviewText)
        overviewText = stripHtmlTags(overviewText)
    end if
    setFieldText("overview", overviewText)
    if isValid(overviewNode)
        overviewNode.visible = not hideMediaDesc and isValidAndNotEmpty(overviewText)
    end if

    if not isSeries() and not isSeason() and not isMusic()
        SetUpVideoOptions(itemData.mediaSources)
        SetUpAudioOptions(itemData.mediaStreams)
    end if

    if m.buttonRow <> invalid then m.buttonRow.visible = true

    ' Layout everything now that all content is populated
    layoutMetadataRow()
    layoutContainer()

    stopLoadingSpinner()
end sub

' ============================================
' Item type helper
' ============================================

function collectionMembers() as object
    return m.collectionMembers ?? []
end function

function isSeason() as boolean
    return LCase(m.top.itemType) = "season"
end function

function isAlbum() as boolean
    return LCase(m.top.itemType) = "musicalbum"
end function

function isArtist() as boolean
    return LCase(m.top.itemType) = "musicartist"
end function

function isPlaylist() as boolean
    return LCase(m.top.itemType) = "playlist"
end function

function isMusic() as boolean
    return isAlbum() or isArtist() or isPlaylist()
end function

' ============================================
' Backdrop
' ============================================



' The modern screen skips the server-side blur and instead reuses ui.backdrop.detailBlurAmount
' to scale its backdrop scrim and edge gradients. The factors below match the Moonfin core
' client so a given value renders the same backdrop on both.
sub applyBackdropTreatment()
    backdropScrim = m.top.findNode("backdropScrim")
    if not isValid(backdropScrim) then return

    opacityFactor = getBackdropBlurAmount() / 25.0

    backdropScrim.opacity = 0.80 * opacityFactor

    gradientScale = 0.3 + 0.7 * opacityFactor

    backdropLeftScrim = m.top.findNode("backdropLeftScrim")
    if isValid(backdropLeftScrim)
        backdropLeftScrim.opacity = gradientScale
    end if

    backdropBottomScrim = m.top.findNode("backdropBottomScrim")
    if isValid(backdropBottomScrim)
        backdropBottomScrim.opacity = gradientScale
    end if
end sub

' ============================================
' Logo image (set from ShowScenes.bs via interface field)
' ============================================

sub onLogoImageURIChanged()
    if not isValid(m.logoImage) then return

    hasLogo = isValidAndNotEmpty(m.top.logoImageURI)

    if hasLogo
        m.logoImage.uri = m.top.logoImageURI
        m.logoShadow.uri = m.top.logoImageURI
    else
        m.logoImage.uri = ""
        m.logoShadow.uri = ""
    end if

    ' An episode's logo belongs to the series, so its own name is still spelled
    ' out underneath. Everywhere else the logo stands in for the title.
    m.logoGroup.visible = hasLogo
    m.titleNode.visible = isEpisode() or not hasLogo

    sizeLogo()
    updateEpisodeHeader()

    ' Re-layout since logo/title visibility changed
    layoutContainer()
end sub

' A series logo gets more room than a title logo, since the episode name is
' carried by the text underneath rather than by the artwork.
sub sizeLogo()
    if isEpisode()
        width = 522
        height = 131
    else
        width = 435
        height = 109
    end if

    for each node in [m.logoImage, m.logoShadow]
        node.width = width
        node.height = height
    end for
end sub

' The series name above an episode title, needed only when there is no series
' logo to carry it. Other item types set their own header and keep it.
sub updateEpisodeHeader()
    if not isEpisode() then return

    header = m.top.findNode("episodeHeader")
    header.visible = not m.logoGroup.visible and isValidAndNotEmpty(header.text)
end sub

' ============================================
' Metadata population
' ============================================

sub populateEpisodeMetadata(itemData as object, item as object)
    seriesName = ""
    if isValid(item.showName) and item.showName <> ""
        seriesName = item.showName
    else if isValid(itemData.SeriesName)
        seriesName = itemData.SeriesName
    end if
    setFieldText("episodeHeader", seriesName)
    updateEpisodeHeader()

    if isValid(itemData.PremiereDate)
        airDate = CreateObject("roDateTime")
        airDate.FromISO8601String(itemData.PremiereDate)
        airDate.ToLocalTime()
        monthName = getMonthName(airDate.GetMonth())
        dateText = `${monthName} ${airDate.GetDayOfMonth()}, ${airDate.GetYear()}`
        setFieldText("releaseYear", dateText)
    end if

    if isAllValid([itemData.ParentIndexNumber, itemData.IndexNumber])
        setFieldText("episodeNumber", "S" + itemData.ParentIndexNumber.toStr() + ":E" + itemData.IndexNumber.toStr())
    end if

    if isValid(itemData.officialRating)
        setFieldText("officialRating", itemData.officialRating)
    end if

    buildTechRow(itemData)
end sub


sub populateMusicMetadata(itemData as object)
    episodeHeaderNode = m.top.findNode("episodeHeader")
    listCount = 0
    if isValid(m.musicList) then listCount = m.musicList.getChildCount()

    if isAlbum()
        artistName = itemData.AlbumArtist
        if not isValidAndNotEmpty(artistName) and isValidAndNotEmpty(itemData.Artists) then artistName = itemData.Artists[0]
        if isValid(episodeHeaderNode)
            if isValidAndNotEmpty(artistName)
                episodeHeaderNode.text = artistName
                episodeHeaderNode.visible = true
            else
                episodeHeaderNode.visible = false
            end if
        end if
        if listCount = 0 and isChainValid(itemData, "ChildCount") then listCount = itemData.ChildCount
        if listCount > 0 then setFieldText("seasonCount", stri(listCount).trim() + " " + tr("Songs"))
        if isValid(itemData.RunTimeTicks) and itemData.RunTimeTicks > 0 then setFieldText("runtime", ticksToHuman(itemData.RunTimeTicks))
        if isValid(itemData.productionYear) then setFieldText("releaseYear", itemData.productionYear)
    else if isPlaylist()
        if isValid(episodeHeaderNode) then episodeHeaderNode.visible = false
        if listCount = 0 and isChainValid(itemData, "ChildCount") then listCount = itemData.ChildCount
        if listCount > 0 then setFieldText("seasonCount", stri(listCount).trim() + " " + tr("Songs"))
        if isValid(itemData.RunTimeTicks) and itemData.RunTimeTicks > 0 then setFieldText("runtime", ticksToHuman(itemData.RunTimeTicks))
    else
        if isValid(episodeHeaderNode) then episodeHeaderNode.visible = false
        if listCount > 0 then setFieldText("seasonCount", stri(listCount).trim() + " " + tr("Albums"))
    end if
end sub

' The size of the file and the chips describing what is in it. Series and
' seasons have no size of their own, theirs is the sum of their children.
sub buildTechRow(itemData as object)
    m.techChips.removeChildrenIndex(m.techChips.getChildCount(), 0)
    sizeNode = m.top.findNode("techSize")
    separator = m.top.findNode("techSeparator")
    sizeNode.text = ""
    separator.visible = false

    if not mediaBadges.Enabled()
        m.techRow.visible = false
        return
    end if

    source = invalid
    if isValidAndNotEmpty(itemData.MediaSources) then source = itemData.MediaSources[0]

    if isValid(source) and not isSeries() and not isSeason()
        sizeNode.text = fileFacts.FormatSize(source.Size)
    end if

    labels = mediaBadges.Build(itemData)
    sizeNode.visible = sizeNode.text <> ""
    m.techRow.visible = sizeNode.visible or labels.count() > 0
    if not m.techRow.visible then return

    xPos = 0
    rowHeight = 0
    if sizeNode.visible
        sizeBounds = sizeNode.boundingRect()
        rowHeight = sizeBounds.height
        xPos = sizeBounds.width
        if labels.count() > 0
            separator.visible = true
            xPos += META_DOT_MARGIN
            separator.translation = [xPos, 0]
            xPos += separator.boundingRect().width + META_DOT_MARGIN + TECH_GAP
        end if
    end if

    chipHeight = layoutTechChips(labels)
    if chipHeight > rowHeight then rowHeight = chipHeight
    m.techRowHeight = rowHeight

    if sizeNode.visible
        sizeNode.translation = [0, (rowHeight - sizeNode.boundingRect().height) / 2]
        if separator.visible
            separator.translation = [separator.translation[0], (rowHeight - separator.boundingRect().height) / 2]
        end if
    end if
    m.techChips.translation = [xPos, (rowHeight - chipHeight) / 2]
end sub

' Returns the height of the tallest chip so the row can centre on it
function layoutTechChips(labels as object) as float
    chipFont = m.top.findNode("techChipFont").font
    xPos = 0
    rowHeight = 0
    for each text in labels
        chip = CreateObject("roSGNode", "Group")

        bg = CreateObject("roSGNode", "Poster")
        bg.uri = "pkg:/images/details/outline6.9.png"
        bg.loadDisplayMode = "scaleToFit"
        bg.blendColor = TECH_CHIP_BORDER

        label = CreateObject("roSGNode", "Label")
        label.font = chipFont
        label.color = TECH_CHIP_INK
        label.text = text

        chip.appendChild(bg)
        chip.appendChild(label)
        m.techChips.appendChild(chip)

        bounds = label.boundingRect()
        bg.width = bounds.width + TECH_CHIP_PAD_H * 2
        bg.height = bounds.height + TECH_CHIP_PAD_V * 2
        label.translation = [TECH_CHIP_PAD_H, TECH_CHIP_PAD_V]
        chip.translation = [xPos, 0]

        xPos += bg.width + TECH_GAP
        if bg.height > rowHeight then rowHeight = bg.height
    end for

    return rowHeight
end function

' ============================================
' Layout: metadata row (horizontal positioning)
' ============================================




' ============================================
' Layout: vertical container positioning
' ============================================

sub layoutContainer()
    m.layingOut = true
    m.heroY = 0
    m.heroPlaced = false

    ' With a card alongside, the title block spans the full width above both
    ' rather than being squeezed into half a screen
    hasUpNext = m.upNextCard.visible
    titleWidth = hasUpNext ? CONTENT_WIDTH : HERO_WIDTH
    m.titleNode.width = titleWidth
    m.top.findNode("episodeHeader").width = titleWidth
    m.top.findNode("tagline").width = hasUpNext ? HERO_WIDTH_WITH_UP_NEXT : HERO_WIDTH
    m.overview.maxWidth = hasUpNext ? HERO_WIDTH_WITH_UP_NEXT : OVERVIEW_WIDTH

    header = m.top.findNode("episodeHeader")
    if header.visible then placeHeroRow(header, header.boundingRect().height, HERO_GAP)
    if m.logoGroup.visible then placeHeroRow(m.logoGroup, m.logoImage.height, HERO_GAP)
    if m.titleNode.visible then placeHeroRow(m.titleNode, m.titleNode.boundingRect().height, HERO_GAP)

    placeHeroRow(m.metadataRow, m.metaRowHeight, HERO_GAP)
    if isValid(m.animePills) and m.animePills.visible then placeHeroRow(m.animePills, m.animePills.rowHeight, HERO_GAP)
    if m.techRow.visible then placeHeroRow(m.techRow, m.techRowHeight, HERO_GAP)

    ratingsRow = m.top.findNode("ratingsRow")
    if ratingsRow.visible then placeHeroRow(ratingsRow, ratingsRow.boundingRect().height, HERO_GAP)

    if hasUpNext
        m.upNextCard.translation = [CONTENT_WIDTH - UP_NEXT_WIDTH, m.heroY + UP_NEXT_TOP_GAP]
    end if

    tagline = m.top.findNode("tagline")
    if tagline.visible then placeHeroRow(tagline, tagline.boundingRect().height, HERO_TAGLINE_GAP)

    overview = m.top.findNode("overview")
    if overview.visible then placeHeroRow(overview, overview.boxHeight, HERO_OVERVIEW_GAP)

    ' The technical row already pushes the hero down, so the buttons close the
    ' gap rather than letting the column run long
    buttonGap = m.techRow.visible ? HERO_ACTIONS_TIGHT_GAP : HERO_ACTIONS_GAP
    placeHeroRow(m.buttonRowContainer, BUTTON_ROW_HEIGHT, buttonGap)

    placeHeroRow(m.tabBar, TAB_BAR_HEIGHT, HERO_TABS_GAP)

    contentY = m.heroY + TAB_CONTENT_GAP
    for each id in ["fileInfo", "tabGrid", "castGrid", "studioGrid", "chaptersGrid", "episodeRowGrid", "trackGrid", "artistAlbumGrid", "seerrBlock"]
        grid = m.top.findNode(id)
        if isValid(grid) then grid.translation = [0, contentY]
    end for

    m.layingOut = false
end sub

' Places one hero row under the last, leaving the gap it asked for
sub placeHeroRow(node as object, height as float, gap as float)
    if m.heroPlaced then m.heroY += gap
    node.translation = [0, m.heroY]
    m.heroY += height
    m.heroPlaced = true
end sub

' The pills for an anime episode or movie, between the facts and the technical row
sub showAnimeMarker(marker as dynamic)
    if not isValid(m.animePills)
        if not animeMarkers.HasPills(marker) then return

        m.animePills = m.container.createChild("AnimeMarkerPills")
        m.animePills.pillSize = "large"
    end if

    wasShown = m.animePills.visible
    m.animePills.marker = marker ?? {}
    if wasShown or m.animePills.visible then layoutContainer()
end sub

' ============================================
' Poster image (primary/cover art)
' ============================================

sub setPosterImage(itemData as object)
    ' The modern layout keeps the top-right area for the up next card, so there
    ' is no cover poster.
    if isValid(itemData) and isValid(m.posterImage)
        m.posterImage.visible = false
        m.playedIndicator.visible = false
    end if
end sub

sub updatePlayedIndicator()
    if not isValid(m.playedIndicator) then return

    itemContent = m.top.itemContent
    if not isChainValid(itemContent, "json") then return

    itemData = itemContent.json
    posterX = m.posterImage.translation[0]
    posterW = m.posterImage.width

    m.playedIndicator.translation = [posterX + posterW - 42, 140]
    m.playedIndicator.favoriteOffset = [- (posterW - 42) + 4, 0]
    m.playedIndicator.visible = true
    m.playedIndicator.data = {
        played: chainLookupReturn(itemData, "UserData.Played", false),
        favorite: chainLookupReturn(itemData, "UserData.IsFavorite", false)
    }
end sub

' ============================================
' Button management
' ============================================

sub clearButtonRow()
    m.buttonRow.removeChildrenIndex(m.buttonRow.getChildCount(), 0)
    m.buttonGroups = []
end sub

' The row keeps every button and scrolls sideways, unless the viewer capped how many stay on
' screen, in which case the rest go behind More Actions
sub commitButtonRow()
    foldButtonsIntoMenu(cappedButtonCount(m.buttonGroups, { maxVisible: 0, overflowAsMenu: false, countCapped: false }))
    if m.currentButtonIndex >= m.buttonGroups.count() then m.currentButtonIndex = 0
    centerButtonRow()
end sub

sub centerButtonRow()
    layoutButtonRow(m.currentButtonIndex)
end sub

sub addSeasonButtons()
    hasResume = m.top.displayResumeButton
    if hasResume
        addButton({ icon: "pkg:/images/icons/detail_play.png", label: tr("Resume"), action: "seasonResume", id: "resumeButton" })
    end if

    addButton({
        icon: hasResume ? "pkg:/images/icons/detail_restart.png" : "pkg:/images/icons/detail_play.png",
        label: hasResume ? tr("Restart") : tr("Play"),
        action: "seasonPlay",
        id: "playButton"
    })

    isWatched = chainLookupReturn(m.top.itemContent, "json.UserData.Played", false)
    isFavorited = chainLookupReturn(m.top.itemContent, "json.UserData.IsFavorite", false)

    addArrangedButtons([
        { id: "shuffle", config: { icon: "pkg:/images/icons/detail_shuffle.png", label: tr("Shuffle"), action: "seasonShuffle", id: "shuffleButton" } },
        { id: "watched", config: { icon: "pkg:/images/icons/detail_watched.png", label: isWatched ? tr("Watched") : tr("Unwatched"), active: isWatched, action: "watched", id: "watchedButton" } },
        { id: "favorite", config: { icon: "pkg:/images/icons/detail_favorite.png", label: isFavorited ? tr("Favorited") : tr("Favorite"), active: isFavorited, action: "favorite", id: "favoriteButton" } }
    ])
end sub

' Music keeps its own row. The other clients give albums, artists and playlists
' screens of their own, so this row is not the one being arranged.
sub addMusicButtons()
    if isPlaylist()
        addButton({ icon: "pkg:/images/icons/detail_play.png", label: tr("Play"), action: "musicPlayAll", id: "playButton" })

        isWatched = chainLookupReturn(m.top.itemContent, "json.UserData.Played", false)
        isFavorited = chainLookupReturn(m.top.itemContent, "json.UserData.IsFavorite", false)

        addArrangedButtons([
            { id: "shuffle", config: { icon: "pkg:/images/icons/detail_shuffle.png", label: tr("Shuffle"), action: "musicShufflePlaylist", id: "shuffleButton" } },
            { id: "watched", config: { icon: "pkg:/images/icons/detail_watched.png", label: isWatched ? tr("Watched") : tr("Unwatched"), active: isWatched, action: "watched", id: "watchedButton" } },
            { id: "favorite", config: { icon: "pkg:/images/icons/detail_favorite.png", label: isFavorited ? tr("Favorited") : tr("Favorite"), active: isFavorited, action: "favorite", id: "favoriteButton" } }
        ])
        return
    end if

    if isArtist()
        addButton({ icon: "pkg:/images/icons/detail_play.png", label: tr("Play"), action: "musicPlayArtist", id: "playButton" })
        addButton({ icon: "pkg:/images/icons/instantMix.png", label: tr("Instant Mix"), action: "musicInstantMix", id: "instantMixButton" })
    else
        addButton({ icon: "pkg:/images/icons/detail_play.png", label: tr("Play All"), action: "musicPlayAlbum", id: "playButton" })
        addButton({ icon: "pkg:/images/icons/detail_shuffle.png", label: tr("Shuffle"), action: "musicShuffleAlbum", id: "shuffleButton" })
        addButton({ icon: "pkg:/images/icons/instantMix.png", label: tr("Instant Mix"), action: "musicInstantMix", id: "instantMixButton" })
    end if

    isFavorited = chainLookupReturn(m.top.itemContent, "json.UserData.IsFavorite", false)
    addButton({ icon: "pkg:/images/icons/detail_favorite.png", label: isFavorited ? tr("Favorited") : tr("Favorite"), active: isFavorited, action: "favorite", id: "favoriteButton" })
end sub

' How one button config becomes a row entry. The classic screen queues configs and
' builds the rows in one pass, the modern one creates each node as it goes
sub appendButtonNode(config as object)
    buttonGroup = detailButtons.createModernButton(config, m.buttonGroups.count())
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    m.buttonRow.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

' Item types that own their whole action row
function typeSpecificButtons() as boolean
    if isCollection()
        addCollectionButtons()
        return true
    end if

    if isSeason()
        addSeasonButtons()
        return true
    end if

    if isMusic()
        addMusicButtons()
        return true
    end if

    return false
end function

' How a button carries its on/off state. The classic screen tints the icon, the
' modern one flips a field the button node watches
function markActiveButton(config as object, isActive as boolean, _ink as string) as object
    config.active = isActive
    return config
end function

' Lays the pill buttons out left to right, giving the focused one room for its
' expanded label so the ones after it shift along.
sub layoutButtonRow(focusIndex as integer)
    x = 0
    focusLeft = 0
    focusRight = 0
    for i = 0 to m.buttonGroups.count() - 1
        button = m.buttonGroups[i]
        if button = invalid then continue for
        button.translation = [x, 0]
        width = BUTTON_COLLAPSED_WIDTH
        if i = focusIndex
            width = BUTTON_COLLAPSED_WIDTH + button.labelWidth + BUTTON_LABEL_PAD
            focusLeft = x
            focusRight = x + width
        end if
        x += width + BUTTON_ROW_GAP
    end for

    ' Beside the up next card the row keeps to the room the card leaves it
    viewport = CONTENT_WIDTH
    if m.upNextCard.visible then viewport = CONTENT_WIDTH - UP_NEXT_WIDTH - (BUTTON_ROW_GAP * 2)
    placeButtonRow(m.buttonRowContainer, true, focusLeft, focusRight, x - BUTTON_ROW_GAP, viewport)
end sub

sub highlightButton(index as integer)
    detailButtons.highlightModern(index, m.buttonGroups)
    layoutButtonRow(index)
end sub

sub unhighlightAllButtons()
    detailButtons.unhighlightAllModern(m.buttonGroups)
    layoutButtonRow(-1)
end sub

' ============================================
' Button actions
' ============================================

' Actions only one screen offers, the season and music rows the classic screen
' never draws
sub handleScreenButtonAction(action as string)
    if action = "collectionPlay" or action = "collectionShuffle"
        playCollection(action = "collectionShuffle")
    else if action = "seasonResume"
        ep = findSeasonResumeEpisode()
        if isValid(ep) then m.top.quickPlayNode = ep
    else if action = "seasonPlay"
        m.top.playSeasonFromStart = not m.top.playSeasonFromStart
    else if action = "seasonShuffle"
        m.top.shufflePlay = true
        m.top.playSeasonFromStart = not m.top.playSeasonFromStart
    else if action = "musicPlayAlbum"
        m.top.playAlbumSelected = not m.top.playAlbumSelected
    else if action = "musicShuffleAlbum"
        m.top.shuffleAlbumSelected = not m.top.shuffleAlbumSelected
    else if action = "musicInstantMix"
        m.top.instantMixSelected = not m.top.instantMixSelected
    else if action = "musicPlayArtist"
        m.top.playArtistSelected = not m.top.playArtistSelected
    else if action = "musicPlayAll"
        m.top.playAll = not m.top.playAll
    else if action = "musicShufflePlaylist"
        m.top.shufflePlay = not m.top.shufflePlay
    end if
end sub

' The first episode with saved progress, otherwise the first unplayed one.
function findSeasonResumeEpisode() as object
    if not isValid(m.seasonEpisodes) then return invalid
    firstUnplayed = invalid
    for each ep in m.seasonEpisodes
        if chainLookupReturn(ep, "json.UserData.PlaybackPositionTicks", 0) > 0 then return ep
        if not isValid(firstUnplayed) and not chainLookupReturn(ep, "json.UserData.Played", false) then firstUnplayed = ep
    end for
    return firstUnplayed
end function

' How a toggle button shows its new state. The modern button node carries its own
' label and active fields
sub setToggleButtonLabel(buttonId as string, label as string, isActive as boolean)
    node = m.top.findNode(buttonId)
    if isValid(node)
        node.labelText = label
        node.active = isActive
    end if
end sub

' The classic screen lists the streams as a codec row, the modern one as tech chips
sub buildStreamSummary(itemData as object)
    buildTechRow(itemData)
end sub

sub refreshAfterVersionChange()
    layoutMetadataRow()
    if m.fileInfo.visible then showFileInfo()
end sub

' How far the page moves so the tab content clears the header. The description is
' most of that height, so a title without one already sits high enough to leave alone.
function contentScrollOffset() as integer
    if not isValid(m.overview) or not m.overview.visible then return 0
    return -500
end function

' ============================================
' Key event handling
' ============================================

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.overflowMenu.visible then return false

    ' A picker left open across a screensaver can come back without focus, which
    ' would leave this screen answering the remote from behind it
    picker = openTrackPicker()
    if isValid(picker)
        picker.setFocus(true)
        return true
    end if

    if key = KeyCode.UP and isValid(m.overview) and m.overview.isInFocusChain()
        m.top.lastFocus = m.overview
        setLastFocus(m.overview)
        return FocusNav(m.top)
    end if

    if key = KeyCode.RIGHT and isValid(m.overview) and m.overview.isInFocusChain()
        if isValid(m.upNextCard) and m.upNextCard.visible
            focusUpNext()
            return true
        end if
    end if

    if key = KeyCode.DOWN and isValid(m.overview) and m.overview.isInFocusChain()
        if m.buttonGroups.count() > 0
            m.buttonGroups[m.currentButtonIndex].setFocus(true)
            m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
            highlightButton(m.currentButtonIndex)
            setLastFocus(m.buttonGroups[m.currentButtonIndex])
        end if
        return true
    end if

    if key = KeyCode.UP and m.buttonGroups.count() > 0
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                unhighlightAllButtons()
                if overviewCanScroll()
                    focusOverview()
                else if isValid(m.upNextCard) and m.upNextCard.visible
                    focusUpNext()
                else
                    m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                    return FocusNav(m.top)
                end if
                return true
            end if
        end for
    end if

    ' The Seerr and Details tabs hold blocks rather than grids, and they have
    ' already had their say by the time an up press reaches here
    if key = KeyCode.UP and ((isValid(m.seerrBlock) and m.seerrBlock.isInFocusChain()) or m.fileInfo.isInFocusChain())
        if isValid(m.tabBar) and m.tabsBuilt
            m.tabBar.setFocus(true)
            m.top.lastFocus = m.tabBar
            setLastFocus(m.tabBar)
            scrollContentTo(0)
            return true
        end if
        return false
    end if

    if key = KeyCode.UP and isValid(m.activeGrid) and m.activeGrid.isInFocusChain()
        if m.activeGrid.itemFocused < m.activeGrid.numColumns
            if isValid(m.tabBar) and m.tabsBuilt
                m.tabBar.setFocus(true)
                m.top.lastFocus = m.tabBar
                setLastFocus(m.tabBar)
                scrollContentTo(0)
                return true
            end if
        end if
        return false
    end if

    isButtonFocused = false
    if m.buttonGroups.count() > 0
        for each btn in m.buttonGroups
            if btn.hasFocus() or btn.isInFocusChain()
                isButtonFocused = true
                exit for
            end if
        end for
    end if

    if isButtonFocused
        if key = KeyCode.LEFT
            if m.currentButtonIndex > 0
                focusButton(m.currentButtonIndex - 1)
            else
                return FocusSidebar(m.top)
            end if
            return true
        else if key = KeyCode.RIGHT
            if m.currentButtonIndex < m.buttonGroups.count() - 1
                focusButton(m.currentButtonIndex + 1)
            else if m.upNextCard.visible
                ' The next up card sits beside the row with nothing else near it, so the end of
                ' the row is the way across
                unhighlightAllButtons()
                focusUpNext()
            end if
            return true
        else if key = KeyCode.OK
            handleButtonSelect()
            return true
        else if key = KeyCode.DOWN
            if isValid(m.tabBar) and m.tabsBuilt
                m.tabBar.setFocus(true)
                m.top.lastFocus = m.tabBar
                setLastFocus(m.tabBar)
                unhighlightAllButtons()
                scrollContentTo(0)
            end if
            return true
        end if
    end if

    if key = KeyCode.BACK
        if isValid(m.tabBar) and m.tabBar.isInFocusChain()
            focusButtonsFromTabs()
            return true
        end if

        if isValid(m.activeGrid) and m.activeGrid.isInFocusChain()
            if m.activeGrid.isSameNode(m.fileInfo) then m.fileInfo.callFunc("clearFocus")
            if isValid(m.tabBar) and m.tabsBuilt
                m.tabBar.setFocus(true)
                m.top.lastFocus = m.tabBar
                setLastFocus(m.tabBar)
            end if
            scrollContentTo(0)
            return true
        end if

        if isValid(m.overview) and m.overview.isInFocusChain()
            if m.buttonGroups.count() > 0
                m.buttonGroups[m.currentButtonIndex].setFocus(true)
                m.top.lastFocus = m.buttonGroups[m.currentButtonIndex]
                highlightButton(m.currentButtonIndex)
                setLastFocus(m.buttonGroups[m.currentButtonIndex])
            end if
            return true
        end if

        return false
    end if

    if key = KeyCode.PLAY and m.tabGrid <> invalid and m.tabGrid.isInFocusChain()
        content = m.tabGrid.content
        idx = m.tabGrid.itemFocused
        if isValid(content) and idx >= 0 and idx < content.getChildCount()
            m.top.quickPlayNode = content.getChild(idx)
            return true
        end if
        return false
    end if

    return false
end function

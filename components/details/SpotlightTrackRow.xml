<?xml version="1.0" encoding="utf-8"?>
<component name="SpotlightTrackRow" extends="Group">
    <children>
        <Poster id="rowFill" uri="pkg:/images/details/surface12.9.png" loadDisplayMode="scaleToFit"
            width="1526" height="76" blendColor="#FFFFFF" opacity="0" />
        <Poster id="rowBorder" uri="pkg:/images/details/cardfocus12.9.png" loadDisplayMode="scaleToFit"
            width="1526" height="76" blendColor="#FFFFFF" visible="false" />
        <Label id="number" font="font:MediumSystemFont" color="#FFFFFF80" horizAlign="right"
            vertAlign="center" width="52" height="76" translation="[16, 0]" />
        <Label id="title" font="font:MediumSystemFont" color="#FFFFFF" width="1410" translation="[84, 11]" />
        <Label id="detail" font="font:SmallSystemFont" color="#FFFFFF99" width="1410" translation="[84, 42]" />
    </children>
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>
</component>

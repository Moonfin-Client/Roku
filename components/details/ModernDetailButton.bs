import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeChrome.bs"
import "pkg:/source/utils/themeApply.bs"

' The colour the other clients mark a set toggle with
const ACTIVE_INK = "#FF4757"
const ACTIVE_FILL_OPACITY = 0.18

' The glass the other clients rest their buttons on, and the hairline round it
const RESTING_FILL_OPACITY = 0.06
const BORDER_OPACITY = 0.35
const FOCUSED_FILL_OPACITY = 0.95

' The circle is square, so this is both its collapsed width and its height
const BUTTON_SIZE = 75

' Two stacked lines, at the leading the other clients set
const LABEL_LINE_HEIGHT = 21
const DETAIL_LINE_HEIGHT = 19

sub init()
    m.bg = m.top.findNode("btnBg")
    m.icon = m.top.findNode("btnIcon")
    m.text = m.top.findNode("btnText")
    m.label = m.top.findNode("btnLabel")
    m.detail = m.top.findNode("btnDetail")
    m.anim = m.top.findNode("expandAnim")
    m.border = m.top.findNode("btnBorder")
    m.borderFocus = m.top.findNode("btnBorderFocus")
    m.bgWidthInterp = m.top.findNode("bgWidthInterp")
    m.borderWidthInterp = m.top.findNode("borderWidthInterp")
    m.borderFocusWidthInterp = m.top.findNode("borderFocusWidthInterp")
    m.labelOpacityInterp = m.top.findNode("labelOpacityInterp")
    m.collapsedWidth = BUTTON_SIZE
    ' What the pill adds around the label once it opens up: the padding either
    ' side of the text plus the room the circle gains on the left
    m.labelPad = 44

    m.label.font.size = 19
    m.detail.font.size = 17

    themeApply.ApplyToItem(m.top)
    applyRestingColours()
end sub

' A button that has never held focus has to match one that has given it up
sub applyRestingColours()
    m.border.visible = true
    m.borderFocus.visible = false

    if m.top.active
        m.bg.blendColor = ACTIVE_INK
        m.bg.opacity = ACTIVE_FILL_OPACITY
        m.icon.blendColor = ACTIVE_INK
        return
    end if

    m.bg.blendColor = themeChrome.Token("buttonNormal", "#FFFFFF")
    m.bg.opacity = RESTING_FILL_OPACITY
    m.icon.blendColor = themeChrome.Token("onButtonNormal", "#FFFFFFFF")
end sub

sub onActiveChanged()
    if not m.top.highlighted then applyRestingColours()
end sub

sub onIconChanged()
    m.icon.uri = m.top.iconUri
end sub

sub onLabelChanged()
    m.label.text = m.top.labelText
    m.detail.text = m.top.detailText

    hasDetail = isValidAndNotEmpty(m.top.detailText)
    m.detail.visible = hasDetail

    if hasDetail
        top = (BUTTON_SIZE - (LABEL_LINE_HEIGHT + DETAIL_LINE_HEIGHT)) / 2
        m.label.height = LABEL_LINE_HEIGHT
        m.label.translation = [0, top]
        m.detail.translation = [0, top + LABEL_LINE_HEIGHT]
    else
        m.label.height = BUTTON_SIZE
        m.label.translation = [0, 0]
    end if
end sub

sub onHighlightChanged()
    textWidth = m.label.boundingRect().width
    if m.detail.visible and m.detail.boundingRect().width > textWidth
        textWidth = m.detail.boundingRect().width
    end if
    expandedWidth = m.collapsedWidth + textWidth + m.labelPad

    if m.top.highlighted
        m.bg.blendColor = themeChrome.Token("buttonFocused", "#FFFFFF")
        m.bg.opacity = FOCUSED_FILL_OPACITY
        m.icon.blendColor = themeChrome.Token("onButtonFocused", "#000000FF")
        m.border.visible = false
        m.borderFocus.visible = true
        m.borderFocus.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")
        targetWidth = expandedWidth
        m.labelOpacityInterp.keyValue = [m.text.opacity, 1]
    else
        applyRestingColours()
        targetWidth = m.collapsedWidth
        m.labelOpacityInterp.keyValue = [m.text.opacity, 0]
    end if

    m.bgWidthInterp.keyValue = [m.bg.width, targetWidth]
    m.borderWidthInterp.keyValue = [m.border.width, targetWidth]
    m.borderFocusWidthInterp.keyValue = [m.borderFocus.width, targetWidth]

    m.anim.control = "start"
end sub

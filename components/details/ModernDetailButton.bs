import "pkg:/source/utils/buttonLayout.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/themeChrome.bs"

' The colour the other clients mark a set toggle with
const ACTIVE_INK = "#FF4757"
const ACTIVE_FILL_OPACITY = 0.18

' The glass the other clients rest their buttons on, and the hairline round it
const RESTING_FILL_OPACITY = 0.06
const BORDER_OPACITY = 0.35
const FOCUSED_FILL_OPACITY = 0.95

' The circle is square, so this is both its collapsed width and its height
const BUTTON_SIZE = 75

' Two stacked lines, at the leading the other clients set
const LABEL_LINE_HEIGHT = 21
const DETAIL_LINE_HEIGHT = 19

' The widest a label shows before it scrolls, the gap the dot sits in between the two copies,
' and the pace in milliseconds a pixel
const MARQUEE_WIDTH = 175
const MARQUEE_GAP = 24
const MARQUEE_DOT = 6
const MARQUEE_MS_PER_PIXEL = 34.48

' Frost's toolbar, in its 1280 by 720 stage's points at the 1.5 that takes them to this screen
const FROSTED_SIZE = 90
const FROSTED_ICON = 38
const FROSTED_PILL_ICON = 29
const FROSTED_PILL_PAD = 42
const FROSTED_PILL_GAP = 15
const FROSTED_PILL_MIN = 300
const FROSTED_LABEL_MAX = 450
const FROSTED_LABEL_SIZE = 29
const FROSTED_GLOW = 6
const FROSTED_PILL_GROW = 1.06
const FROSTED_CIRCLE_GROW = 1.12
const FROSTED_TIP_GAP = 24
const FROSTED_TIP_PAD_X = 21
const FROSTED_TIP_PAD_Y = 10.5
const FROSTED_TIP_SIZE = 21

sub init()
    m.bg = m.top.findNode("btnBg")
    m.icon = m.top.findNode("btnIcon")
    m.text = m.top.findNode("btnText")
    m.label = m.top.findNode("btnLabel")
    m.detail = m.top.findNode("btnDetail")
    m.anim = m.top.findNode("expandAnim")
    m.border = m.top.findNode("btnBorder")
    m.borderFocus = m.top.findNode("btnBorderFocus")
    m.bgWidthInterp = m.top.findNode("bgWidthInterp")
    m.borderWidthInterp = m.top.findNode("borderWidthInterp")
    m.borderFocusWidthInterp = m.top.findNode("borderFocusWidthInterp")
    m.labelOpacityInterp = m.top.findNode("labelOpacityInterp")
    m.labelClip = m.top.findNode("labelClip")
    m.labelTrack = m.top.findNode("labelTrack")
    m.labelCopy = m.top.findNode("btnLabelCopy")
    m.labelDot = m.top.findNode("labelDot")
    m.marqueeRest = m.top.findNode("marqueeRest")
    m.marqueeRest.observeField("fire", "runMarquee")
    m.marqueeAnim = m.top.findNode("marqueeAnim")
    m.marqueeAnim.observeField("state", "onMarqueeState")
    m.labelNaturalWidth = 0
    m.marqueeInterp = m.top.findNode("marqueeInterp")
    m.belowLabel = m.top.findNode("belowLabel")
    m.face = m.top.findNode("face")
    m.frostGlow = m.top.findNode("frostGlow")
    m.frostTip = m.top.findNode("frostTip")
    m.frostTipFill = m.top.findNode("frostTipFill")
    m.frostTipLabel = m.top.findNode("frostTipLabel")
    m.frostSized = false
    m.collapsedWidth = BUTTON_SIZE
    ' What the pill adds around the label once it opens up: the padding either
    ' side of the text plus the room the circle gains on the left
    m.labelPad = 44

    m.label.font.size = 19
    m.labelCopy.font.size = 19
    m.detail.font.size = 17
    m.belowLabel.font.size = 17
    m.frostTipLabel.font.size = FROSTED_TIP_SIZE

    themeApply.ApplyToItem(m.top)
    applyRestingColours()
end sub

' A button that has never held focus has to match one that has given it up
sub applyRestingColours()
    if m.top.frosted
        drawFrosted()
        return
    end if
    m.border.visible = true
    m.borderFocus.visible = false

    ' A pill that spans its column is filled with the accent at rest, the way the other clients
    ' draw a full width Play
    if m.top.spanWidth > 0
        m.border.visible = false
        m.bg.blendColor = themeChrome.Accent()
        m.bg.opacity = 1
        m.icon.blendColor = themeChrome.OnAccent()
        return
    end if

    if m.top.active
        m.bg.blendColor = ACTIVE_INK
        m.bg.opacity = ACTIVE_FILL_OPACITY
        m.icon.blendColor = ACTIVE_INK
        return
    end if

    m.bg.blendColor = themeChrome.Token("buttonNormal", "#FFFFFF")
    m.bg.opacity = RESTING_FILL_OPACITY
    m.icon.blendColor = themeChrome.Token("onButtonNormal", "#FFFFFFFF")
end sub

sub onActiveChanged()
    if m.top.frosted or not m.top.highlighted then applyRestingColours()
end sub

sub onIconChanged()
    m.icon.uri = m.top.iconUri
end sub

sub onLabelChanged()
    if m.top.frosted
        if not m.frostSized then sizeFont(m.label, FROSTED_LABEL_SIZE)
        m.frostSized = true
        ' A label given a width reports that width, so it's measured with none
        m.label.width = 0
    end if
    m.label.text = m.top.labelText
    m.detail.text = m.top.detailText

    hasDetail = isValidAndNotEmpty(m.top.detailText)
    m.detail.visible = hasDetail

    if hasDetail
        top = (BUTTON_SIZE - (LABEL_LINE_HEIGHT + DETAIL_LINE_HEIGHT)) / 2
        m.label.height = LABEL_LINE_HEIGHT
        m.label.translation = [0, top]
        m.detail.translation = [0, top + LABEL_LINE_HEIGHT]
    else
        m.label.height = BUTTON_SIZE
        m.label.translation = [0, 0]
    end if

    m.belowLabel.text = m.top.labelText
    m.labelCopy.text = m.top.labelText
    m.labelCopy.height = m.label.height
    naturalWidth = m.label.boundingRect().width
    m.labelNaturalWidth = naturalWidth
    m.labelCopy.translation = [naturalWidth + MARQUEE_GAP, m.label.translation[1]]
    m.labelDot.translation = [naturalWidth + (MARQUEE_GAP - MARQUEE_DOT) / 2, m.label.translation[1] + (m.label.height - MARQUEE_DOT) / 2]

    shownWidth = naturalWidth
    if labelOverflows() then shownWidth = MARQUEE_WIDTH
    m.labelClip.clippingRect = shownWidth < naturalWidth ? [0, 0, shownWidth, BUTTON_SIZE] : BUTTON_NO_CLIP
    m.top.labelWidth = shownWidth
    centerInSpan()

    if m.top.frosted
        drawFrosted()
    else if m.top.highlighted
        startMarquee()
    end if
end sub

sub centerInSpan()
    left = 20
    if m.top.spanWidth > 0
        textWidth = m.top.labelWidth
        if m.detail.visible and m.detail.boundingRect().width > textWidth then textWidth = m.detail.boundingRect().width
        left = (m.top.spanWidth - (72 + textWidth)) / 2
        if left < 20 then left = 20
    end if
    m.icon.translation = [left, 20]
    m.text.translation = [left + 72, 0]
end sub

sub inkLabels(ink as string)
    m.label.color = ink
    m.labelCopy.color = ink
    m.labelDot.blendColor = ink
    m.detail.color = ink
end sub

' Whether the label is wider than its pill, which is what makes it scroll
function labelOverflows() as boolean
    return not m.top.primary and m.labelNaturalWidth > MARQUEE_WIDTH + 0.5
end function

' It rests, scrolls one copy along at a steady pace, snaps back to where it began and goes again
sub startMarquee()
    stopMarquee()
    if not labelOverflows() then return

    m.labelCopy.visible = true
    m.labelDot.visible = true
    m.marqueeRest.control = "start"
end sub

sub runMarquee()
    if not m.top.highlighted then return

    distance = m.labelNaturalWidth + MARQUEE_GAP
    m.marqueeInterp.keyValue = [[0, 0], [-distance, 0]]
    m.marqueeAnim.duration = distance * MARQUEE_MS_PER_PIXEL / 1000
    m.marqueeAnim.control = "start"
end sub

sub onMarqueeState()
    if m.marqueeAnim.state <> "stopped" then return

    m.labelTrack.translation = [0, 0]
    if m.top.highlighted and labelOverflows() then m.marqueeRest.control = "start"
end sub

sub stopMarquee()
    m.marqueeRest.control = "stop"
    m.marqueeAnim.control = "stop"
    m.labelTrack.translation = [0, 0]
    m.labelCopy.visible = false
    m.labelDot.visible = false
end sub

sub onHighlightChanged()
    if m.top.frosted
        drawFrosted()
        return
    end if
    textWidth = m.top.labelWidth
    if m.detail.visible and m.detail.boundingRect().width > textWidth
        textWidth = m.detail.boundingRect().width
    end if
    expandedWidth = m.collapsedWidth + textWidth + m.labelPad
    if m.top.spanWidth > 0 then expandedWidth = m.top.spanWidth
    m.belowLabel.visible = m.top.labelBelow and m.top.highlighted

    if m.top.highlighted
        m.bg.blendColor = themeChrome.Token("buttonFocused", "#FFFFFF")
        m.bg.opacity = FOCUSED_FILL_OPACITY
        m.icon.blendColor = themeChrome.Token("onButtonFocused", "#000000FF")
        inkLabels(themeChrome.Token("onButtonFocused", "#000000FF"))
        m.border.visible = false
        m.borderFocus.visible = true
        m.borderFocus.blendColor = themeChrome.Token("inputBorderFocused", "#FFFFFF")
        targetWidth = m.top.labelBelow ? m.collapsedWidth : expandedWidth
        m.labelOpacityInterp.keyValue = [m.text.opacity, m.top.labelBelow ? 0 : 1]
        if not m.top.labelBelow then startMarquee()
    else
        stopMarquee()
        applyRestingColours()
        ' A leading button carries its word whether or not it holds focus, and on
        ' the resting glass that word needs the light ink rather than the dark one
        ' the focused pill takes
        inkLabels(m.top.spanWidth > 0 ? themeChrome.OnAccent() : themeChrome.Token("onButtonNormal", "#FFFFFFFF"))
        targetWidth = m.top.leading ? expandedWidth : m.collapsedWidth
        m.labelOpacityInterp.keyValue = [m.text.opacity, m.top.leading ? 1 : 0]
    end if

    m.bgWidthInterp.keyValue = [m.bg.width, targetWidth]
    m.borderWidthInterp.keyValue = [m.border.width, targetWidth]
    m.borderFocusWidthInterp.keyValue = [m.borderFocus.width, targetWidth]

    m.anim.control = "start"
end sub

' A theme swaps a label's font for one it shares with other labels, so the size goes on the font the
' label started with
sub sizeFont(label as object, size as integer)
    font = label.font
    if label.hasField("themeBaseFont") and isValid(label.themeBaseFont) then font = label.themeBaseFont
    font.size = size
    themeApply.ApplyToItem(label)
end sub

' Frost's toolbar draws a leading button as a white pill and every other one as a bare icon. Focus
' lights the pill and grows it a little, or gives an icon a lighter platter, grows it more and names
' it in a chip over it.
sub drawFrosted()
    stopMarquee()
    m.anim.control = "stop"
    focused = m.top.highlighted
    m.border.visible = false
    m.borderFocus.visible = false
    m.belowLabel.visible = false
    m.detail.visible = false
    m.bg.uri = "pkg:/images/details/frost/fill45.9.png"
    m.bg.blendColor = "#FFFFFF"
    m.bg.height = FROSTED_SIZE
    scale = 1

    if m.top.leading
        labelWidth = m.labelNaturalWidth
        if labelWidth > FROSTED_LABEL_MAX
            labelWidth = FROSTED_LABEL_MAX
            m.label.width = labelWidth
        end if
        content = FROSTED_PILL_ICON + FROSTED_PILL_GAP + labelWidth
        width = content + FROSTED_PILL_PAD * 2
        if width < FROSTED_PILL_MIN then width = FROSTED_PILL_MIN
        left = (width - content) / 2

        m.bg.width = width
        m.bg.opacity = 0.86
        m.icon.blendColor = "#000000"
        m.icon.width = FROSTED_PILL_ICON
        m.icon.height = FROSTED_PILL_ICON
        m.icon.translation = [left, (FROSTED_SIZE - FROSTED_PILL_ICON) / 2]
        m.label.height = FROSTED_SIZE
        m.label.translation = [0, 0]
        m.labelClip.clippingRect = BUTTON_NO_CLIP
        m.text.translation = [left + FROSTED_PILL_ICON + FROSTED_PILL_GAP, 0]
        m.text.opacity = 1
        inkLabels("#000000")
        m.frostGlow.translation = [-FROSTED_GLOW, -FROSTED_GLOW]
        m.frostGlow.width = width + FROSTED_GLOW * 2
        m.frostGlow.height = FROSTED_SIZE + FROSTED_GLOW * 2
        m.frostGlow.visible = focused
        m.frostTip.visible = false
        if focused
            m.bg.opacity = 1
            scale = FROSTED_PILL_GROW
        end if
    else
        width = FROSTED_SIZE
        m.bg.width = width
        m.bg.opacity = 0
        m.icon.blendColor = frostedInk()
        m.icon.width = FROSTED_ICON
        m.icon.height = FROSTED_ICON
        m.icon.translation = [(FROSTED_SIZE - FROSTED_ICON) / 2, (FROSTED_SIZE - FROSTED_ICON) / 2]
        m.text.opacity = 0
        m.frostGlow.visible = false
        m.frostTip.visible = focused
        if focused
            m.bg.opacity = 0.32
            scale = FROSTED_CIRCLE_GROW
            placeFrostedTip()
        end if
    end if

    m.face.scaleRotateCenter = [width / 2, FROSTED_SIZE / 2]
    m.face.scale = [scale, scale]
    m.top.faceWidth = width
end sub

function frostedInk() as string
    if not m.top.active then return "#FFFFFF"
    if m.top.id = "favoriteButton" then return "#FF375F"
    if m.top.id = "seerrWatchlistButton" then return "#0A84FF"
    return "#30D158"
end function

' Centered over the circle as it sits before it grows, so the chip holds still as focus moves on
sub placeFrostedTip()
    m.frostTipLabel.text = m.top.labelText
    bounds = m.frostTipLabel.boundingRect()
    tipWidth = bounds.width + FROSTED_TIP_PAD_X * 2
    tipHeight = bounds.height + FROSTED_TIP_PAD_Y * 2
    m.frostTipFill.width = tipWidth
    m.frostTipFill.height = tipHeight
    m.frostTipLabel.translation = [FROSTED_TIP_PAD_X, FROSTED_TIP_PAD_Y]
    m.frostTip.translation = [(FROSTED_SIZE - tipWidth) / 2, -FROSTED_TIP_GAP - tipHeight]
end sub

import "pkg:/source/utils/misc.bs"

' One track in a Spotlight track list: its number, its title, and a second line with the
' artist and runtime. The whole row lights up on focus rather than just a ring.

sub init()
    m.rowFill = m.top.findNode("rowFill")
    m.rowBorder = m.top.findNode("rowBorder")
    m.number = m.top.findNode("number")
    m.title = m.top.findNode("title")
    m.detail = m.top.findNode("detail")

    m.number.font.size = 22
    m.title.font.size = 22
    m.detail.font.size = 18
end sub

sub onContentChanged()
    cont = m.top.itemContent
    if not isValid(cont) then return

    m.number.text = cont.numberText
    m.title.text = cont.titleText
    m.detail.text = cont.detailText
end sub

sub onFocusChanged()
    focused = m.top.itemHasFocus
    m.rowFill.opacity = focused ? 0.14 : 0
    m.rowBorder.visible = focused
end sub

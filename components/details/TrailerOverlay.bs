import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' How far a skip button moves through the trailer, in seconds
const TRAILER_SEEK_STEP = 10

sub init()
    m.top.overhangVisible = false
    m.video = m.top.findNode("trailerVideo")
    m.loadingLabel = m.top.findNode("loadingLabel")
    m.loadingLabel.text = tr("Loading trailer...")
    m.top.findNode("closeLabel").text = tr("Close")

    m.segments = []
    m.video.notificationInterval = 0.5
    m.video.observeFieldScoped("state", "onVideoState")
    m.video.observeFieldScoped("position", "onVideoPosition")
    m.top.observeFieldScoped("videoId", "onVideoIdChanged")
end sub

sub onVideoIdChanged()
    if not isValidAndNotEmpty(m.top.videoId) then return
    m.task = CreateObject("roSGNode", "TrailerPreviewTask")
    m.task.observeFieldScoped("answer", "onAnswer")
    m.task.request = { requestId: 0, videoId: m.top.videoId, index: 0, captions: false, language: "" }
    m.task.control = "RUN"
end sub

' Nothing to play closes the overlay again without a word
sub onAnswer(event as object)
    answer = event.getData()
    if not isValidAndNotEmpty(answer.url)
        close()
        return
    end if

    m.segments = answer.segments
    content = CreateObject("roSGNode", "ContentNode")
    content.url = answer.url
    content.streamFormat = answer.format
    m.video.content = content
    m.video.mute = get_user_setting_bool("ui.home.mediaBarTrailerMuted", false)
    m.video.control = "play"
end sub

sub onVideoState()
    if m.video.state = "playing" then m.loadingLabel.visible = false
    if m.video.state = "error" then close()
end sub

sub onVideoPosition()
    position = m.video.position
    for each segment in m.segments
        if position >= segment.start and position < segment.finish - 0.5
            m.video.seek = segment.finish
            exit for
        end if
    end for
end sub

' Once only, since a second pop would take the detail screen with it
sub close()
    if m.closed = true then return
    m.closed = true
    if isValid(m.task) then m.task.unobserveFieldScoped("answer")
    m.video.control = "stop"
    ' The screen holds itself as its last focus, which would keep it alive once it is gone
    m.top.lastFocus = invalid
    m.global.sceneManager.callFunc("popScene")
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = KeyCode.OK or key = KeyCode.BACK
        close()
    else if key = KeyCode.PLAY
        m.video.control = (m.video.state = "paused") ? "resume" : "pause"
    else if key = KeyCode.FASTFORWRD or key = KeyCode.RIGHT
        m.video.seek = m.video.position + TRAILER_SEEK_STEP
    else if key = KeyCode.REWIND or key = KeyCode.LEFT
        target = m.video.position - TRAILER_SEEK_STEP
        if target < 0 then target = 0
        m.video.seek = target
    end if
    return true
end function

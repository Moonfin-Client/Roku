<?xml version="1.0" encoding="utf-8"?>
<!-- Stage's page laid out another way. What Premiere adds is moved into the scrolling page when it
    starts, so the dialogs Nouveau draws last stay on top of it. -->
<component name="PremiereItemDetails" extends="StageItemDetails">
    <children>
        <Group id="premiereParts" visible="false">
            <!-- The picture fills the first screen and scrolls away with it. It darkens toward its
                edges and fades into the page at its foot. -->
            <Group id="heroBackdrop">
                <Poster id="heroVignette" width="1920" height="1080" loadDisplayMode="scaleToFill"
                    uri="pkg:/images/details/premiere/vignette.webp" />
                <Poster id="heroFade" width="1920" height="1080" loadDisplayMode="scaleToFill"
                    uri="pkg:/images/details/premiere/fade.webp" />
                <Poster id="heroFadeDim" width="1920" height="1080" loadDisplayMode="scaleToFill"
                    uri="pkg:/images/details/premiere/fade_dim.webp" />
            </Group>

            <!-- A frame for each section down the page, drawn under what it holds -->
            <Group id="sectionFrames" />

            <Label id="heroOverview" font="font:SmallestSystemFont" color="#FFFFFFD1" wrap="true"
                horizAlign="center" />
            <!-- Tells a remote there's more under the first screen -->
            <Poster id="moreBelow" uri="pkg:/images/icons/keyboard_arrow_down.webp" width="50"
                height="50" blendColor="#FFFFFFA6" visible="false" />

            <!-- Holds the remote while a section with nothing to press in it is the stop -->
            <Group id="sectionStop" focusable="true" />
            <!-- Never shown, it lends its font to the section titles built at runtime -->
            <Label id="sectionTitleFont" font="font:SmallestBoldSystemFont" visible="false" />
        </Group>
    </children>
</component>

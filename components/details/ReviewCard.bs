import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"
import "pkg:/source/utils/tmdbReviews.bs"

sub init()
    m.initialLabel = m.top.findNode("initialLabel")
    m.avatarMask = m.top.findNode("avatarMask")
    m.avatar = m.top.findNode("avatar")
    m.author = m.top.findNode("author")
    m.meta = m.top.findNode("meta")
    m.preview = m.top.findNode("preview")
    m.cardFocus = m.top.findNode("cardFocus")

    m.initialLabel.font.size = 28
    m.author.font.size = 24
    m.meta.font.size = 19
    m.preview.font.size = 20
    m.ownsRing = true

    themeApply.ApplyToItem(m.top)
end sub

sub onItemContent()
    content = m.top.itemContent
    if not isValid(content) or not content.hasField("review") then return
    ' Only a grid that draws no focus of its own asks the card for a ring
    m.ownsRing = content.hasField("ownFocusRing") and content.ownFocusRing = true
    showReview(content.review)
end sub

sub onCardData()
    m.ownsRing = true
    showReview(m.top.cardData)
end sub

sub showReview(review as object)
    m.author.text = review.author
    m.meta.text = tmdbReviews.MetaLine(review)
    m.preview.text = review.preview
    m.initialLabel.text = review.initial
    m.avatar.uri = review.avatarUrl
    m.avatarMask.visible = review.avatarUrl <> ""
end sub

sub onFocus()
    m.cardFocus.visible = m.ownsRing and (m.top.itemHasFocus or m.top.focused)
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- Stage's page drawn as a glass window over a blurred copy of the art, with its parts in a tab bar
    under the buttons. What Frost adds is moved into Nouveau's page when it starts, so the dialogs Nouveau
    draws last stay on top of it. -->
<component name="FrostItemDetails" extends="StageItemDetails">
    <children>
        <Group id="frostParts" visible="false">
            <!-- A 1280 by 720 stage at 1.5, stretched to the room the nav leaves -->
            <Group id="frostStage">
                <Group id="frostWindow" translation="[36, 18]">
                    <!-- Glass in the theme's surface, under a rim in its ink -->
                    <Poster id="frostWindowGlass" uri="pkg:/images/details/frost/window.9.png" width="1848" height="843">
                        <Poster id="frostWindowRim" uri="pkg:/images/details/frost/window_rim.9.png" width="1848" height="843" />
                    </Poster>
                    <!-- Overview shows the art in the window, darkening toward its foot and its left -->
                    <MaskGroup id="frostArt" maskUri="pkg:/images/details/frost/window_mask.webp"
                        maskSize="[1848, 843]">
                        <Poster id="frostArtImage" width="1848" height="843" loadDisplayMode="scaleToZoom" />
                        <Poster id="frostFadeUp" uri="pkg:/images/details/frost/fade_up.webp" width="1848" height="843"
                            loadDisplayMode="scaleToFill" />
                        <Poster id="frostFadeRight" uri="pkg:/images/details/frost/fade_right.webp" width="1848" height="843"
                            loadDisplayMode="scaleToFill" />
                    </MaskGroup>

                    <!-- Overview, laid out from the window's foot up -->
                    <Group id="frostOverview">
                        <Group id="frostColumn">
                            <!-- How far in the viewer is, or where Seerr has got to with a title only it has -->
                            <Group id="frostStatus" visible="false">
                                <Poster id="frostStatusDot" uri="pkg:/images/icons/circle.webp" width="15" height="15" />
                                <Rectangle id="frostStatusTrack" width="165" height="7.5" color="#FFFFFF40" />
                                <Rectangle id="frostStatusFill" height="7.5" color="#FFFFFF" />
                                <Label id="frostStatusText" color="#EBEBF5CC" />
                                <!-- The arr's own words for why a download is stuck -->
                                <Label id="frostStatusNote" color="#EBEBF599" wrap="true" maxLines="3" visible="false" />
                            </Group>
                            <Group id="frostRatings" visible="false">
                                <Rectangle width="1560" height="1.5" color="#FFFFFF24" />
                                <Rectangle width="1560" height="1.5" color="#FFFFFF24" translation="[0, 148.5]" />
                            </Group>
                            <Group id="frostRow" />
                        </Group>
                    </Group>

                    <!-- Every other tab names the title over the tab -->
                    <Group id="frostHeader" translation="[84, 48]" visible="false">
                        <Label id="frostCaps" color="#EBEBF59E" />
                        <Label id="frostTabName" color="#FFFFFF" translation="[0, 30]" />
                    </Group>
                    <Group id="frostPane">
                        <Group id="frostPaneTrack" />
                    </Group>
                    <Group id="frostPicker" />
                </Group>

                <Group id="frostToolbar">
                    <Poster id="frostToolbarGlass" uri="pkg:/images/details/frost/toolbar.9.png" height="114">
                        <Poster id="frostToolbarRim" uri="pkg:/images/details/frost/toolbar_rim.9.png" height="114" />
                    </Poster>
                </Group>

                <!-- The title's parts as tabs in a capsule under the buttons -->
                <Group id="frostTabBar">
                    <Poster id="frostTabBarGlass" uri="pkg:/images/details/frost/tabbar.9.png" height="90">
                        <Poster id="frostTabBarRim" uri="pkg:/images/details/frost/tabbar_rim.9.png" height="90" />
                    </Poster>
                    <Group id="frostTabRow" />
                </Group>
            </Group>

            <!-- The whole overview, over the page -->
            <Group id="frostReadMore" visible="false">
                <Rectangle id="frostReadMoreShade" width="1920" height="1080" color="#00000080" />
                <Poster id="frostReadMorePanel" uri="pkg:/images/details/frost/fill60.9.png"
                    blendColor="#242428F7" />
                <Label id="frostReadMoreTitle" color="#FFFFFF" wrap="true" />
                <Label id="frostReadMoreMeta" color="#EBEBF5A6" />
                <Label id="frostReadMoreText" color="#FFFFFFEB" wrap="true" />
            </Group>

            <!-- Holds the remote while the tab bar or a tab's content has it, since their parts are
                drawn lit rather than focused -->
            <Group id="frostFocus" focusable="true" />
            <!-- Never shown, they lend their fonts to the parts built at runtime -->
            <Group id="frostFonts" visible="false" />
        </Group>

        <Animation id="frostArtAnim" duration="0.5" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator id="frostArtInterp" key="[0.0, 1.0]" keyValue="[1.0, 1.0]"
                fieldToInterp="frostArt.opacity" />
        </Animation>
        <Animation id="frostScrollAnim" duration="0.35" repeat="false" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="frostScrollInterp" key="[0.0, 1.0]"
                keyValue="[[0, 0], [0, 0]]" fieldToInterp="frostPaneTrack.translation" />
        </Animation>
    </children>
</component>

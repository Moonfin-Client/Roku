<?xml version="1.0" encoding="utf-8"?>
<component name="ItemDetails" extends="JFScreen">
    <children>
        <!-- Full-screen backdrop -->
        <Rectangle id="backdropBlack" width="1920" height="1080" color="#000000" visible="true" />
        <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToFill" opacity="0.4" visible="true" />
        <Rectangle id="backdropTint" width="1920" height="1080" color="#F2000000" opacity="1.0" visible="true" />

        <!-- Scrollable content -->
        <Group id="scrollableContent" translation="[0, 0]">
            <!-- Cover art, rounded the way the other clients round it. Each shape
                 carries its own mask so the corners stay round -->
            <MaskGroup id="posterMask" translation="[1585, 140]" visible="false"
                maskUri="pkg:/images/details/poster_mask.png">
                <Poster id="posterImage" width="239" height="360"
                    loadDisplayMode="scaleToFill" />
            </MaskGroup>
            <PlayedCheckmark id="playedIndicator" visible="false" />

            <Group id="container"
                translation="[96, 130]">

                <!-- Series name beside a pill holding the season and episode -->
                <Group id="episodeHeader" visible="false">
                    <Text id="seriesName" font="font:MediumSystemFont" color="#FFFFFFB3" />
                    <Group id="episodePill" visible="false">
                        <Poster id="episodePillBg" uri="pkg:/images/details/surface17.9.png"
                            blendColor="#FFFFFF" opacity="0.15" />
                        <Text id="episodePillText" font="font:SmallBoldSystemFont"
                            color="#FFFFFFE6" />
                    </Group>
                </Group>

                <!-- Logo with drop shadow (Group so shadow overlaps, not stacks) -->
                <Group id="logoGroup" visible="false">
                    <Poster id="logoShadow" visible="true" loadDisplayMode="scaleToFit"
                        width="507" height="116" blendColor="0x000000" opacity="0.6"
                        translation="[3, 3]" />
                    <Poster id="logoImage" visible="true" loadDisplayMode="scaleToFit"
                        width="507" height="116" />
                </Group>

                <!-- Title (shown when no logo available) -->
                <Text id="title" font="font:LargeBoldSystemFont" width="1350" wrap="true"
                    maxLines="2" color="#FFFFFF" visible="false" />

                <!-- Metadata row: built dynamically via layoutMetadataRow() -->
                <Group id="metadataRow">
                    <Text id="releaseYear" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    <Text id="dot1" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Group id="officialRatingGroup">
                        <Poster id="officialRatingBg" uri="pkg:/images/details/badgefill6.9.png"
                            blendColor="#FFFFFF" opacity="0.15" />
                        <Text id="officialRating" font="font:SmallestSystemFont" color="#FFFFFFE6" />
                    </Group>
                    <Text id="dot3" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Text id="seasonCount" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    <Text id="dot6" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Text id="runtime" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    <Text id="dot4" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Text id="endsAt" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    <Text id="dot5" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Group id="communityRatingGroup">
                        <Poster id="star" uri="pkg:/images/sharp_star_white_18dp.png"
                            height="20" width="20" blendColor="#FFD700" visible="false" />
                        <Text id="communityRating" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    </Group>
                    <Text id="dot7" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Group id="criticRatingGroup" visible="false">
                        <Poster id="tomatoIcon" uri="pkg:/images/fresh.png"
                            height="20" width="20" visible="false" />
                        <Text id="criticRating" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                    </Group>
                    <Text id="dot8" font="font:SmallestSystemFont" color="#FFFFFF80"
                        visible="false" />
                    <Text id="metaGenres" font="font:SmallestBoldSystemFont" color="#FFFFFFE6" />
                </Group>

                <!-- Filled in at runtime, one badge per thing the file turns out to be -->
                <Group id="codecRow">
                    <!-- Never drawn, it only lends its font to the badges built beside it -->
                    <Text id="codecBadgeFont" font="font:SmallestBoldSystemFont" visible="false" />
                </Group>

                <!-- MDBList ratings row (plugin) -->
                <RatingsRow id="ratingsRow" visible="false" />

                <!-- Tagline -->
                <Text id="tagline" font="font:SmallestSystemFont" wrap="true" maxLines="2"
                    width="1350" color="#FFFFFFB3" visible="false" />

                <!-- Overview, which opens in place when there is more to read -->
                <ExpandableOverview id="overview" visible="false" />

                <!-- Button row (centered across screen) -->
                <Rectangle id="buttonRowContainer" width="1728" height="140"
                    color="#00000000">
                    <LayoutGroup id="buttonRow" layoutDirection="horiz"
                        itemSpacings="[12]" translation="[0, 9]" />
                    <!-- Whatever did not fit the first row, revealed by More -->
                    <LayoutGroup id="buttonRowExtra" layoutDirection="horiz"
                        itemSpacings="[12]" translation="[0, 155]" visible="false" />
                </Rectangle>

                <!-- Genres, director, writers and studio, on the card the other
                     clients rest them on -->
                <Group id="metadataColumnsContainer">
                    <Poster id="metadataColumnsBg" uri="pkg:/images/details/surface12.9.png"
                        blendColor="#FFFFFF" opacity="0.03" visible="false" />
                    <Poster id="metadataColumnsBorder" uri="pkg:/images/details/cardborder12.9.png"
                        blendColor="#FFFFFF" opacity="0.06" visible="false" />
                    <Group id="metadataColumns">
                        <Group id="genresColumn" visible="false">
                            <Text id="genresHeader" text="GENRES"
                                font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
                            <Text id="genres" font="font:SmallestSystemFont" color="#FFFFFFD9" />
                        </Group>
                        <Rectangle id="divider1" width="1" color="#FFFFFF"
                            opacity="0.15" visible="false" />
                        <Group id="directorColumn" visible="false">
                            <Text id="directorHeader" text="DIRECTOR"
                                font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
                            <Text id="director" font="font:SmallestSystemFont" color="#FFFFFFD9" />
                        </Group>
                        <Rectangle id="divider2" width="1" color="#FFFFFF"
                            opacity="0.15" visible="false" />
                        <Group id="writersColumn" visible="false">
                            <Text id="writersHeader" text="WRITERS"
                                font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
                            <Text id="writers" font="font:SmallestSystemFont" color="#FFFFFFD9" />
                        </Group>
                        <Rectangle id="divider3" width="1" color="#FFFFFF"
                            opacity="0.15" visible="false" />
                        <Group id="studioColumn" visible="false">
                            <Text id="studioHeader" text="STUDIO"
                                font="font:SmallestBoldSystemFont" color="#FFFFFF66" />
                            <Text id="studio" font="font:SmallestSystemFont" color="#FFFFFFD9" />
                        </Group>
                    </Group>
                </Group>

                <!-- Cast, Crew, Similar items -->
                <ExtrasRowList id="extrasGrid"
                    numRows="5"
                    rowFocusAnimationStyle="floatingFocus"
                    itemSpacing="[60, 60]"
                    rowLabelOffset="[[9, 24]]"
                    showRowLabel="true"
                    showRowCounter="true"
                    visible="true"
                    drawFocusFeedback="true"
                    itemComponentName="ExtrasItem"
                    focusBitmapUri="pkg:/images/hd_focus.9.png" />

                <SeerrDetailBlock id="seerrBlock" translation="[105, 0]" visible="false" />
            </Group>
        </Group>

        <AudioSelector id="audioSelector" visible="false" />
        <SubtitleSelector id="subtitleSelector" visible="false" />
        <SubtitleDownloadDialog id="subtitleDownloadDialog" visible="false" />
        <VersionSelector id="versionSelector" visible="false" />
        <ThemeMusicPlayer id="themeMusicPlayer" />
        <FavoriteItemsTask id="favoriteTask" />
        <PlaystateTask id="playstateTask" />

        <!-- Smooth scroll animation for page transitions -->
        <Animation id="scrollAnimation" duration="0.5" repeat="false" easeFunction="inOutQuad">
            <Vector2DFieldInterpolator id="scrollInterpolator"
                key="[0.0, 1.0]"
                keyValue="[[0, 0], [0, 0]]"
                fieldToInterp="scrollableContent.translation" />
        </Animation>
    </children>
    <interface>
        <!-- Flipped once the Seerr payload lands, so the row redraws with its entries in -->
        <field id="seerrButtonsStale" type="boolean" alwaysNotify="true" />
        <field id="buttonSelected" type="string" alwaysNotify="true" />
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="itemContent" type="node" />
        <!-- A Seerr title with no library counterpart, which the screen fetches and dresses itself -->
        <field id="seerrTarget" type="assocarray" onChange="onSeerrTargetChanged" />
        <field id="seerrOnly" type="boolean" value="false" />
        <field id="itemType" type="string" value="movie" />
        <field id="trailerAvailable" type="bool" value="false" />
        <field id="selectedPart" type="assocarray" onChange="onSelectedPartChanged" />
        <field id="selectedAudioStreamIndex" type="integer" />
        <field id="selectedVideoStreamId" type="string" />
        <field id="quickPlayNode" type="node" alwaysNotify="true" />
        <field id="refreshMovieDetailsData" type="bool" alwaysNotify="true" />
        <field id="refreshEpisodeDetailsData" type="bool" alwaysNotify="true" />
        <field id="refreshSeriesDetailsData" type="bool" alwaysNotify="true" />
        <field id="logoImageURI" type="string" onChange="onLogoImageURIChanged" />
        <field id="seasonData" type="node" />
        <field id="seasonSelected" type="node" alwaysNotify="true" />
        <field id="playSeriesFromStart" type="bool" alwaysNotify="true" />
        <field id="displayResumeButton" type="bool" onChange="onDisplayResumeButtonChange" />
    </interface>
</component>
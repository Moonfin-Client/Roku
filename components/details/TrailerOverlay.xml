<?xml version="1.0" encoding="utf-8"?>
<!-- A YouTube trailer played over the detail screen, closed with OK or Back -->
<component name="TrailerOverlay" extends="JFScreen">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000EB" />
        <Video id="trailerVideo" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />
        <Label id="loadingLabel" width="1920" height="1080" horizAlign="center" vertAlign="center"
            font="font:MediumSystemFont" color="#FFFFFFB3" />
        <Group id="captions" translation="[192, 680]" visible="false">
            <Label id="captionShadow" translation="[2, 2]" width="1536" height="324"
                font="font:MediumBoldSystemFont" color="0x000000CC" horizAlign="center" vertAlign="bottom" wrap="true" />
            <Label id="caption" width="1536" height="324" font="font:MediumBoldSystemFont"
                color="0xFFFFFFFF" horizAlign="center" vertAlign="bottom" wrap="true" />
        </Group>
        <Group id="closeButton" translation="[1688, 48]">
            <Poster id="closeFill" uri="pkg:/images/details/btnfill.9.png" width="184" height="60"
                blendColor="#FFFFFF" opacity="0.95" />
            <Label id="closeLabel" width="184" height="60" horizAlign="center" vertAlign="center"
                font="font:MediumBoldSystemFont" color="#101114" />
        </Group>
    </children>
    <interface>
        <field id="videoId" type="string" />
    </interface>
</component>

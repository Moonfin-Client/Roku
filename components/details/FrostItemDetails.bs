import "pkg:/components/posterLabels/posterLabelsDraw.bs"
import "pkg:/source/utils/seerrFacts.bs"

' Frost floats the title in a glass window over a blurred, dimmed copy of its own art. The buttons sit
' in a toolbar over the window's foot, and the title's parts are tabs in a bar under that. Only
' Overview shows the art, so the other tabs read as glass.
'
' It's Stage's page drawn another way, so the loading, the facts, the pickers and the buttons come
' from there. This file draws the window, the toolbar and the tab bar and walks the remote through
' them.

' The page is laid out on a 1280 by 720 stage, so every size here is a stage point at the 1.5 that
' takes it to this screen. The stage stretches to the shape of the room the nav leaves, and
' everything on it is placed from its edges.
const FROST_NAV_ROOM = 100
const FROST_SIDEBAR_ROOM = 78
const FROST_WINDOW_X = 36
const FROST_WINDOW_Y = 18
const FROST_WINDOW_FOOT = 219
const FROST_CONTENT_FOOT = 75
const FROST_TOOLBAR_FOOT = 159
const FROST_TAB_BAR_FOOT = 54

const FROST_TAB_BAR_PAD = 9
const FROST_TAB_HEIGHT = 72
const FROST_TAB_GAP = 6
const FROST_TAB_PAD = 27
const FROST_TAB_ICON = 33
const FROST_TAB_ICON_GAP = 15

const FROST_TOOLBAR_PAD = 12
const FROST_BUTTON_GAP = 9
const FROST_MAX_BUTTONS = 6

' Overview, from the title down
const FROST_PAD_X = 84
const FROST_TEXT_WIDTH = 1470
const FROST_TITLE_GAP = 18
const FROST_PART_GAP = 21
const FROST_BADGE_GAP = 21
const FROST_STATUS_HEIGHT = 33
const FROST_STATUS_BAR = 165
const FROST_STATUS_GAP = 18
const FROST_STATUS_DOT = 15
' The reason line under a stuck download
const FROST_STATUS_NOTE_GAP = 6
const FROST_RATINGS_WIDTH = 1560
const FROST_RATINGS_HEIGHT = 150
const FROST_LEFT_WIDTH = 996
const FROST_TEXT_PAD_X = 18
const FROST_TEXT_PAD_Y = 15
const FROST_TEXT_PITCH = 39
const FROST_TEXT_LINES = 3
const FROST_CREDIT_TOP = 9
const FROST_CREDIT_ROOM = 960
const FROST_CREDIT_GAP = 10.5
const FROST_CREDITS_GAP = 27
const FROST_SIDE_X = 1110
const FROST_SIDE_TOP = 3
const FROST_TRACK_WIDTH = 534
const FROST_TRACK_HEIGHT = 60
const FROST_TRACK_GAP = 9
const FROST_TRACK_PAD = 21
const FROST_TRACK_ICON = 27
const FROST_UNFOLD = 18
const FROST_PROVIDER_LOGO = 78

' The other tabs
const FROST_SCROLL_PAD = 6
const FROST_ROW_HEIGHT = 180
const FROST_ROW_GAP = 12
const FROST_STILL_WIDTH = 288
const FROST_STILL_HEIGHT = 162
const FROST_ROW_TEXT_X = 330
const FROST_EPISODE_SIDE = 210
const FROST_POSTER_MARK = 39
const FROST_PILL_HEIGHT = 63
const FROST_PILL_PAD = 30
const FROST_PICKER_PAD = 6
const FROST_PICKER_RIGHT = 72
const FROST_PICKER_TOP = 66
const FROST_PICKER_ROOM = 1056
const FROST_PERSON_HEIGHT = 306
const FROST_AVATAR = 174
const FROST_DETAIL_COLUMN_GAP = 42
const FROST_DETAIL_GROUP_GAP = 24
const FROST_DETAIL_INSET = 27
const FROST_DETAIL_ROW_PAD = 13.5
const FROST_DETAIL_LOGO = 45

' The whole overview, opened from its first lines
const FROST_DIALOG_X = 300
const FROST_DIALOG_Y = 180
const FROST_DIALOG_WIDTH = 1320
const FROST_DIALOG_PAD_X = 78
const FROST_DIALOG_PAD_Y = 66
const FROST_DIALOG_PITCH = 48

const FROST_PLATTER = "#FFFFFF24"
const FROST_CLEAR = "#FFFFFF00"
const FROST_MUTED = "#EBEBF59E"
const FROST_SOFT = "#EBEBF5A6"

sub init()
    ' Nouveau's own page goes, and Frost's parts take its place under the dialogs it draws last
    m.sectionsGroup.getParent().visible = false
    parts = m.top.findNode("frostParts")
    parts.reparent(m.scrollableContent, false)
    parts.visible = true

    for each id in ["frostStage", "frostWindowGlass", "frostWindowRim", "frostArt", "frostArtImage", "frostFadeUp", "frostFadeRight", "frostOverview", "frostColumn", "frostStatus", "frostStatusDot", "frostStatusTrack", "frostStatusFill", "frostStatusText", "frostStatusNote", "frostRatings", "frostRow", "frostHeader", "frostCaps", "frostTabName", "frostPane", "frostPaneTrack", "frostPicker", "frostTabBar", "frostTabBarGlass", "frostTabBarRim", "frostTabRow", "frostToolbar", "frostToolbarGlass", "frostToolbarRim", "frostReadMore", "frostReadMoreShade", "frostReadMorePanel", "frostReadMoreTitle", "frostReadMoreMeta", "frostReadMoreText", "frostFocus", "frostFonts", "frostArtAnim", "frostArtInterp", "frostScrollAnim", "frostScrollInterp"]
        m[id] = m.top.findNode(id)
    end for

    ' The title, its facts and its scores move into the window, and the buttons into the toolbar
    for each node in [m.titleNode, m.metadataRow, m.techRow]
        node.reparent(m.frostColumn, false)
    end for
    m.ratingsRow.reparent(m.frostRatings, false)
    m.ratingsRow.translation = [0, 0]
    m.buttonRowContainer.reparent(m.frostToolbar, false)

    m.titleNode.width = FROST_TEXT_WIDTH
    m.metaRowWrapWidth = FROST_TEXT_WIDTH
    m.techChip = { height: 33, pad: 9, gap: 9, border: frostInk("#EBEBF58C"), ink: frostInk("#EBEBF5D9") }
    m.ratingsRow.columns = true
    m.ratingsRow.labelFont = "font:SmallestBoldSystemFont"
    m.ratingsRow.valueFont = "font:SmallestBoldSystemFont"
    m.ratingsRow.nameSize = 18
    m.ratingsRow.valueSize = 42
    m.ratingsRow.columnsWidth = FROST_RATINGS_WIDTH
    m.ratingsRow.columnsHeight = FROST_RATINGS_HEIGHT

    m.backdropVignette.uri = "pkg:/images/details/frost/vignette.webp"
    themeParts()

    m.fonts = {}
    m.frostStatusText.font = frostFont(false, 24)
    m.frostStatusNote.font = frostFont(false, 20)
    m.frostStatusNote.width = FROST_TEXT_WIDTH
    m.frostCaps.font = frostFont(true, 21)
    m.frostTabName.font = frostFont(true, 54)
    m.frostReadMoreTitle.font = frostFont(true, 54)
    m.frostReadMoreMeta.font = frostFont(false, 24)
    m.frostReadMoreText.font = frostFont(false, 30)

    m.frostFocus.observeField("focusedChild", "onFrostFocusChanged")

    m.tabs = ["overview", "details"]
    m.tabSignature = ""
    m.tabId = "overview"
    m.segment = {}
    m.railIndex = 0
    m.tabParts = []
    m.spot = invalid
    m.memory = {}
    m.textPart = invalid
    m.trackParts = []
    m.tiles = []
    m.paneItems = []
    m.paneKind = ""
    m.chipParts = []
    m.scrollTop = 0
    m.paneHeight = 0
    m.contentHeight = 0
    m.chipScroll = 0
    m.chipRow = 0
    m.chipRoom = 0
    m.readMoreOpen = false
    placeStage()
end sub

' A label's font, sized and themed once and shared by every label that asks for the same one
function frostFont(bold as boolean, size as integer) as object
    key = `${bold}${size}`
    if isValid(m.fonts[key]) then return m.fonts[key]

    label = m.frostFonts.createChild("Label")
    label.font = "font:SmallestSystemFont"
    if bold then label.font = "font:SmallestBoldSystemFont"
    label.font.size = fontApply.ThemeTextSize(size)
    themeApply.ApplyToItem(label)
    m.fonts[key] = label.font
    return label.font
end function

' How tall one line of a font is, measured once
function fontLine(bold as boolean, size as integer) as float
    key = `line${bold}${size}`
    if not isValid(m.fonts[key]) then m.fonts[key] = frostLabel(m.frostFonts, "Ag", frostFont(bold, size), "#FFFFFF").boundingRect().height
    return m.fonts[key]
end function

' Runs from Nouveau's init, ahead of the theme fonts
sub sizeHeroFonts()
    m.titleNode.font.size = fontApply.ThemeTextSize(96)
    m.top.findNode("statusBadgeText").font.size = fontApply.ThemeTextSize(21)
    m.top.findNode("upcomingBadgeText").font.size = fontApply.ThemeTextSize(21)
    m.badgeHeight = 33
    m.badgePadH = 11
    m.top.findNode("techChipFont").font = "font:SmallestBoldSystemFont"
    m.top.findNode("techChipFont").font.size = 18

    metaSize = fontApply.ThemeTextSize(27)
    for each id in ["releaseYear", "officialRating", "seasonCount", "episodeNumber", "runtime", "endsAt", "metaGenres"]
        node = m.top.findNode(id)
        node.font = "font:SmallestSystemFont"
        node.font.size = metaSize
        node.color = frostInk("#EBEBF5C7")
    end for
    m.top.findNode("runtimeIcon").blendColor = frostInk("#EBEBF5C7")
end sub

' ===== Content =====

' The title in words, never its logo, with an episode's rating on its facts line the way Stage writes it
sub showHeader(itemData as object)
    m.titleNode.text = itemData.Name ?? ""
    m.titleNode.visible = true
    if isEpisode() and isValid(itemData.OfficialRating) then setFieldText("officialRating", itemData.OfficialRating)
    layoutContainer()
end sub

sub onLogoImageURIChanged()
end sub

' Marking the title watched or unwatched takes its progress line away, so the hero is laid out again
sub updatePlayedIndicator()
    layoutContainer()
end sub

' The art blurred and dimmed behind everything, and sharp in the window
sub applyBackdropTreatment()
    shown = get_user_setting_bool("ui.itemdetail.showBackdrop", true)
    m.backdrop.visible = shown
    m.frostArtImage.visible = shown
    m.backdropScrim.opacity = 0.55
    m.backdropVignette.opacity = 1
    for each layer in [m.backdropTopScrim, m.backdropBottomScrim, m.backdropLeftScrim]
        layer.visible = false
    end for
end sub

' The server blurs the picture behind the window and sends it small, since it's stretched over the
' screen. A Seerr title's picture comes from TMDB, which can't blur it, so it's only taken small.
sub setBackdropImage(itemData as object)
    m.frostArtImage.uri = backdropImageUrl(itemData, { "maxWidth": 1920, "maxHeight": 1080, "quality": 90 }) ?? ""
    m.backdrop.loadWidth = 0
    m.backdrop.loadHeight = 0
    if isValidAndNotEmpty(itemData._externalBackdropUrl)
        m.backdrop.uri = itemData._externalBackdropUrl.Replace("/w1280/", "/w300/")
        m.backdrop.loadWidth = 96
        m.backdrop.loadHeight = 54
        return
    end if
    m.backdrop.uri = backdropImageUrl(itemData, { "maxWidth": 480, "maxHeight": 270, "quality": 90, "blur": 6 }) ?? ""
end sub

' ===== Data =====

' A library title: Overview, its episodes or its cast, extras, titles like it, Seerr's tab and the
' details. A title only Seerr has: Overview, its seasons or its cast, what Seerr finds related and
' the details. Each shows only with something in it and its section switched on.
function frostTabs() as object
    tabs = ["overview"]
    show = isSeries() or isSeason() or isEpisode()
    castOn = not show and detailSectionLayout.Shows("cast") and m.sectionData.cast.count() > 0
    if m.top.seerrOnly
        if show and seerrSeasons().count() > 0 then tabs.push("seasons")
        if castOn then tabs.push("cast")
        if tabSegments("related").count() > 0 then tabs.push("related")
    else
        if show and (not isEpisode() or detailSectionLayout.Shows("moreEpisodes")) then tabs.push("episodes")
        if castOn then tabs.push("cast")
        if detailSectionLayout.Shows("extras") and m.sectionData.extras.count() > 0 then tabs.push("extras")
        if detailSectionLayout.Shows("moreLikeThis") and m.sectionData.similar.count() > 0 then tabs.push("related")
        if tabSegments("seerr").count() > 0 then tabs.push("seerr")
    end if
    tabs.push("details")
    return tabs
end function

function tabLabel(tabId as string) as string
    if tabId = "seerr" then return GetSeerrDisplayName()
    labels = { overview: tr("Overview"), episodes: tr("Episodes"), seasons: tr("Seasons"), cast: tr("Cast & Crew"), extras: tr("Extras"), related: tr("More Like This") }
    return labels[tabId] ?? tr("Details")
end function

function tabIcon(tabId as string) as string
    ' Seerr's tab wears the icon the nav gives Seerr
    if tabId = "seerr" then return "pkg:/images/icons/settings/seerr.webp"
    icons = { overview: "smart_display_outlined", episodes: "format_list_bulleted", seasons: "layers_outlined", cast: "people_outline", extras: "video_library_outlined", related: "grid_view" }
    glyph = icons[tabId] ?? "info_outline"
    return `pkg:/images/icons/${glyph}.webp`
end function

' The segments a tab splits into, each only when Seerr has something for it and its section is on
function tabSegments(tabId as string) as object
    keys = []
    seerrTab = tabId = "seerr" and not m.top.seerrOnly
    if not seerrTab and not (tabId = "related" and m.top.seerrOnly) then return keys
    if detailSectionLayout.Shows("seerrRecommendations") and m.sectionData.seerrRecommendations.count() > 0 then keys.push("rec")
    if detailSectionLayout.Shows("seerrSimilar") and m.sectionData.seerrSimilar.count() > 0 then keys.push("sim")
    if seerrTab and aboutGroups(true).count() > 0 then keys.push("about")
    return keys
end function

function segmentLabel(key as string) as string
    if key = "rec" then return tr("Recommendations")
    if key = "sim" then return tr("Similar")
    return tr("About")
end function

' The segment picked in a tab, else its first
function shownSegment(tabId as string) as string
    keys = tabSegments(tabId)
    if keys.count() = 0 then return ""
    picked = m.segment[tabId] ?? ""
    if inArray(keys, picked) then return picked
    return keys[0]
end function

function seerrSeasons() as object
    seasons = chainLookupReturn(m.seerrDetails, "seasons", invalid)
    if type(seasons) <> "roArray" then return []
    return seasons
end function

' The people of one kind on the title, as the item lists them
function peopleNamed(kind as string) as object
    names = []
    for each person in chainLookupReturn(m.top.itemContent, "json.People", [])
        name = person.LookupCI("Name") ?? ""
        if name <> "" and isStringEqual(person.LookupCI("Type") ?? "", kind) then names.push(name)
    end for
    return names
end function

function joinedNames(list as dynamic) as string
    names = []
    if type(list) <> "roArray" then return ""
    for each entry in list
        name = ""
        if type(entry) = "roAssociativeArray" then name = entry.LookupCI("Name") ?? ""
        if name <> "" then names.push(name)
    end for
    return names.join(", ")
end function

' The lead actors and the directors under the overview
function frostCredits() as object
    lines = []
    if detailSectionLayout.Shows("cast")
        names = []
        for each person in m.sectionData.cast
            name = chainLookupReturn(person, "json.Name", "")
            if name <> "" then names.push(name)
            if names.count() = 3 then exit for
        end for
        if names.count() > 0 then lines.push([tr("Cast"), names.join(", ")])
    end if
    if detailSectionLayout.Shows("crew")
        directors = peopleNamed("Director")
        if directors.count() > 0
            directorLabel = isEpisode() ? tr("Episode Director") : tr("Director")
            lines.push([directorLabel, directors.join(", ")])
        end if
    end if
    return lines
end function

' The line under the facts: how far into the title the viewer is and how long is left, or for a
' title only Seerr has, where Seerr has got to with it
function statusLine() as dynamic
    if m.top.seerrOnly then return seerrStatusLine()

    target = chainLookupReturn(m.top.itemContent, "json", invalid)
    number = ""
    if isSeries()
        target = nextUpJson()
        season = chainLookupReturn(target, "ParentIndexNumber", invalid)
        episode = chainLookupReturn(target, "IndexNumber", invalid)
        if isValid(season) and isValid(episode) then number = `S${season}:E${episode} ${fontApply.ThemeSeparator()} `
    end if

    runtime = chainLookupReturn(target, "RunTimeTicks", 0)
    position = chainLookupReturn(target, "UserData.PlaybackPositionTicks", 0)
    if chainLookupReturn(target, "UserData.Played", false) = true or runtime <= 0 or position <= 0 or position >= runtime then return invalid
    ' Ticks come as 32 or 64 bit integers, which mixed divide as integers, so the share is a double
    return { dot: "", bar: (position * 1#) / runtime, barColor: frostColor("rangeProgress", "#FFFFFF"), label: number + tr("%1 remaining").Replace("%1", getFormattedRuntime(runtime - position)) }
end function

' A download in progress shows how far along it is, with the arr's reason under it when it's stuck,
' and anything else Seerr's word for the title
function seerrStatusLine() as dynamic
    mediaInfo = chainLookupReturn(m.seerrDetails, "mediaInfo", invalid)
    shown = SeerrDetailDownload(mediaInfo, m.seerrArrQueue)
    if isValid(shown)
        if shown.notFoundYet then return { dot: seerrStatusPills.Colors("gray").border, bar: -1, barColor: "", label: tr("Not found yet") }
        summary = shown.summary
        color = SeerrDownloadBarColor(summary.state, seerrStatusPills.Colors("purple").border)
        return { dot: color, bar: summary.fraction, barColor: color, label: SeerrDownloadLabel(summary, true, fontApply.ThemeSeparator()), note: summary.reason }
    end if
    if not isValid(m.seerrDetails) then return invalid

    pills = seerrStatusPills.Build(m.seerrDetails)
    if pills.count() = 0 then pills = [seerrStatusPills.TrackPill(chainLookupReturn(mediaInfo, "status", 0), false)]
    texts = []
    for each pill in pills
        texts.push(pill.text)
    end for
    return { dot: seerrStatusPills.Colors(pills[0].tone).border, bar: -1, barColor: "", label: texts.join(` ${fontApply.ThemeSeparator()} `) }
end function

function nextUpJson() as dynamic
    for each episode in m.sectionData.episodes
        if chainLookupReturn(episode, "id", "") = m.sectionData.nextUpId then return episode.json
    end for
    return invalid
end function

' The season picked, else the one the viewer is in, else the first that isn't Specials
function shownSeason() as dynamic
    if m.seasonNumbers.count() = 0 then return invalid
    current = m.pickedSeason
    if not isValid(current) and isEpisode() then current = chainLookupReturn(m.top.itemContent, "json.ParentIndexNumber", invalid)
    if not isValid(current) then current = chainLookupReturn(nextUpJson(), "ParentIndexNumber", invalid)
    for each number in m.seasonNumbers
        if isValid(current) and number = current then return number
    end for
    for each number in m.seasonNumbers
        if number > 0 then return number
    end for
    return m.seasonNumbers[0]
end function

' The episode the viewer would carry on with, or this page's own
function startEpisode() as integer
    wanted = m.sectionData.nextUpId
    if isEpisode() then wanted = m.top.itemContent.id
    for i = 0 to m.paneItems.count() - 1
        if chainLookupReturn(m.paneItems[i], "id", "") = wanted then return i
    end for
    return 0
end function

' Grouped label and value rows: the facts straight under the Details title, then the languages and
' the file, or for a title only Seerr has, Seerr's own groups
function infoGroups(itemData as object) as object
    information = []
    if detailSectionLayout.Shows("studios")
        studios = joinedNames(itemData.Studios)
        if studios <> "" then information.push([tr("Studios"), studios])
    end if
    released = itemData.PremiereDate ?? ""
    if Len(released) >= 10
        date = CreateObject("roDateTime")
        date.FromISO8601String(Left(released, 10) + "T00:00:00Z")
        information.push([tr("Release Date"), date.AsDateString("short-month-no-weekday")])
    end if
    runtime = itemData.RunTimeTicks ?? 0
    if runtime > 0 then information.push([tr("Runtime"), getFormattedRuntime(runtime)])
    if isValidAndNotEmpty(itemData.OfficialRating) then information.push([tr("Parental Rating"), itemData.OfficialRating])
    if detailSectionLayout.Shows("crew")
        for each role in [["Director", tr("Director")], ["Writer", tr("Writer")]]
            names = peopleNamed(role[0])
            if names.count() > 0
                label = role[1]
                if isEpisode()
                    if role[0] = "Director"
                        label = tr("Episode Director")
                    else if role[0] = "Writer"
                        label = tr("Episode Writer")
                    end if
                end if
                information.push([label, names.join(", ")])
            end if
        end for
    end if
    if isValidAndNotEmpty(itemData.Genres) then information.push([tr("Genres"), itemData.Genres.join(", ")])

    groups = []
    if information.count() > 0 then groups.push({ heading: "", rows: information })
    if m.top.seerrOnly
        groups.append(aboutGroups(false))
        return groups
    end if

    source = fileFacts.PickedSource(itemData, m.top.selectedVideoStreamId)
    streams = []
    if isValid(source) and type(source.MediaStreams) = "roArray" then streams = source.MediaStreams
    languages = []
    for each kind in [["Audio", tr("Audio")], ["Subtitle", tr("Subtitles")]]
        found = []
        for each stream in streams
            if isStringEqual(stream.Type ?? "", kind[0])
                language = UCase(stream.Language ?? "")
                if language = "" then language = "?"
                if not inArray(found, language) then found.push(language)
            end if
        end for
        if found.count() > 0 then languages.push([kind[1], found.join(", ")])
    end for

    media = []
    if isValid(source) and detailSectionLayout.Shows("mediaInfo")
        sources = itemData.MediaSources ?? []
        if sources.count() > 1
            versions = joinedNames(sources)
            if versions <> "" then media.push([tr("Version"), versions])
        end if
        diskName = fileFacts.DiskName(source)
        if diskName <> "" then media.push([tr("File"), diskName])
        for each stream in streams
            if isStringEqual(stream.Type ?? "", "Video")
                media.push([tr("Video"), fileFacts.VideoLines(stream).join(` ${fontApply.ThemeSeparator()} `)])
                exit for
            end if
        end for
        if isValidAndNotEmpty(source.Container) then media.push([tr("Container"), UCase(source.Container)])
        size = fileFacts.FormatSize(source.Size ?? 0)
        if size <> "" then media.push([tr("Size"), size])
    end if

    if languages.count() > 0 then groups.push({ heading: tr("Audio & Subtitles"), rows: languages })
    if media.count() > 0 then groups.push({ heading: tr("Media info"), rows: media })
    return groups
end function

' Seerr's numbers, where it streams and its tags, each with its section switched on. A title only
' Seerr has already names its genres in its facts.
function aboutGroups(withGenres as boolean) as object
    groups = []
    details = m.seerrDetails
    if not isValid(details) then return groups

    if detailSectionLayout.Shows("seerrStats")
        rows = []
        for each fact in seerrFacts.Build(details, seerrMediaType())
            rows.push([fact.label, fact.value])
        end for
        if rows.count() > 0 then groups.push({ heading: tr("Stats"), rows: rows })
    end if
    if detailSectionLayout.Shows("seerrStreaming")
        rows = []
        for each provider in SeerrStreamingProviders(details, SeerrStreamingRegion())
            logo = ""
            if isValidAndNotEmpty(provider.logoPath) then logo = seerrFacts.LOGO_BASE + provider.logoPath
            rows.push([provider.name, "", logo])
        end for
        if rows.count() > 0 then groups.push({ heading: tr("Streaming on"), rows: rows })
    end if
    if detailSectionLayout.Shows("seerrGenresTags")
        rows = []
        genres = joinedNames(details.genres)
        if withGenres and genres <> "" then rows.push([tr("Genres"), genres])
        keywords = joinedNames(details.keywords)
        if keywords <> "" then rows.push([tr("Tags"), keywords])
        if rows.count() > 0 then groups.push({ heading: tr("Tags"), rows: rows })
    end if
    return groups
end function

' The services a title only Seerr has streams on: the first by name, the rest after it
function watchCard() as dynamic
    if not m.top.seerrOnly or not detailSectionLayout.Shows("seerrStreaming") then return invalid
    providers = SeerrStreamingProviders(m.seerrDetails, SeerrStreamingRegion())
    if providers.count() = 0 then return invalid
    others = []
    for i = 1 to providers.count() - 1
        others.push(providers[i].name)
    end for
    logo = ""
    if isValidAndNotEmpty(providers[0].logoPath) then logo = seerrFacts.LOGO_BASE + providers[0].logoPath
    return { name: providers[0].name, sub: others.join(", "), logo: logo }
end function

' ===== Sections =====

' Every loader that lands draws the tabs again, keeping the one on screen and where the remote is
sub rebuildSections()
    if not isChainValid(m.top.itemContent, "json") then return

    m.tabs = frostTabs()
    m.tabSignature = tabSignature(m.tabs)
    if not inArray(m.tabs, m.tabId) then m.tabId = "overview"
    grouped = nouveauLayout.GroupEpisodesBySeason(m.sectionData.episodes)
    m.seasonNumbers = grouped.numbers
    m.seasonBuckets = grouped.buckets

    ' The nav only shows once the screen is in the scene, so the stage takes its room here
    placeStage()
    layoutButtonRow(m.currentButtonIndex)
    buildTabBar()
    layoutHero()
    showTab(m.tabId, true)

    if m.focusZone = "tabs"
        m.railIndex = tabIndex(m.tabId)
        paintTabBar()
    else if m.focusZone = "content" and not spotExists(m.spot)
        enterContent()
    end if
end sub

function tabSignature(tabs as object) as string
    return `${tabs.join(",")}|${tabSegments("seerr").join(",")}|${tabSegments("related").join(",")}`
end function

' Seerr's details land without a section of their own, so the tabs are drawn again when they bring
' a tab or a segment with them
sub layoutPage()
    if not isChainValid(m.top.itemContent, "json") then return
    if tabSignature(frostTabs()) <> m.tabSignature then rebuildSections()
end sub

' The nav takes its room off the screen, and the stage stretches to the shape of what's left rather
' than boxing a 16 by 9 inside it. The window fills the stage less its margins.
sub placeStage()
    roomX = 0
    roomY = 0
    if sidebarShown()
        roomX = FROST_SIDEBAR_ROOM
    else
        roomY = FROST_NAV_ROOM
    end if
    roomWidth = 1920 - roomX
    roomHeight = 1080 - roomY
    m.stageWidth = 1080 * roomWidth / roomHeight
    if m.stageWidth < 1920 then m.stageWidth = 1920
    m.stageHeight = m.stageWidth * roomHeight / roomWidth
    scale = roomWidth / m.stageWidth
    m.frostStage.scale = [scale, scale]
    m.frostStage.translation = [roomX, roomY]

    m.windowWidth = m.stageWidth - FROST_WINDOW_X * 2
    m.windowHeight = m.stageHeight - FROST_WINDOW_Y - FROST_WINDOW_FOOT
    for each node in [m.frostWindowGlass, m.frostWindowRim, m.frostArtImage, m.frostFadeUp, m.frostFadeRight]
        node.width = m.windowWidth
        node.height = m.windowHeight
    end for
    m.frostArt.maskSize = [m.windowWidth, m.windowHeight]
end sub

function tabIndex(tabId as string) as integer
    for i = 0 to m.tabs.count() - 1
        if m.tabs[i] = tabId then return i
    end for
    return 0
end function

' Puts a tab on screen. Only Overview shows the art, and every other tab names the title over itself.
sub showTab(tabId as string, keepScroll = false as boolean)
    sameTab = tabId = m.tabId
    m.tabId = tabId
    overview = tabId = "overview"
    m.frostOverview.visible = overview
    m.frostHeader.visible = not overview
    fadeArt(overview)
    if not overview
        m.frostCaps.text = UCase(m.titleNode.text)
        m.frostTabName.text = tabLabel(tabId)
    end if
    if not (keepScroll and sameTab) then m.scrollTop = 0
    buildPane()
    paintTabBar()
end sub

sub fadeArt(shown as boolean)
    target = 0
    if shown then target = 1
    if m.frostArt.opacity = target and m.frostArtAnim.state <> "running" then return
    m.frostArtAnim.control = "stop"
    m.frostArtInterp.keyValue = [m.frostArt.opacity, target]
    m.frostArtAnim.control = "start"
end sub

' ===== Tab bar =====

' The tabs run across a capsule centered under the buttons, each with its icon and its name. A row
' too wide for the stage shrinks to fit.
sub buildTabBar()
    m.frostTabRow.removeChildrenIndex(m.frostTabRow.getChildCount(), 0)
    m.tabParts = []
    x = FROST_TAB_BAR_PAD
    labelX = FROST_TAB_PAD + FROST_TAB_ICON + FROST_TAB_ICON_GAP
    for each tabId in m.tabs
        holder = m.frostTabRow.createChild("Group")
        fill = frostShape(holder, "pkg:/images/login/fill36.9.png", 0, 0, 0, FROST_TAB_HEIGHT, FROST_CLEAR)
        icon = frostShape(holder, tabIcon(tabId), FROST_TAB_PAD, (FROST_TAB_HEIGHT - FROST_TAB_ICON) / 2, FROST_TAB_ICON, FROST_TAB_ICON, frostInk("#FFFFFF"))
        icon.loadDisplayMode = "scaleToFit"
        label = frostLabel(holder, tabLabel(tabId), frostFont(true, 24), frostInk("#FFFFFF"))
        tabWidth = labelX + label.boundingRect().width + FROST_TAB_PAD
        label.translation = [labelX, 0]
        label.height = FROST_TAB_HEIGHT
        label.vertAlign = "center"
        fill.width = tabWidth
        holder.translation = [x, FROST_TAB_BAR_PAD]
        holder.scaleRotateCenter = [tabWidth / 2, FROST_TAB_HEIGHT / 2]
        m.tabParts.push({ group: holder, fill: fill })
        x += tabWidth + FROST_TAB_GAP
    end for

    width = x - FROST_TAB_GAP + FROST_TAB_BAR_PAD
    m.frostTabBarGlass.width = width
    m.frostTabBarRim.width = width
    scale = 1
    if width > m.windowWidth then scale = m.windowWidth / width
    m.frostTabBar.scale = [scale, scale]
    m.frostTabBar.translation = [(m.stageWidth - width * scale) / 2, m.stageHeight - FROST_TAB_BAR_FOOT - 90 * scale]
    paintTabBar()
end sub

' The tab on screen keeps a faint platter and the one with the remote a focused one
sub paintTabBar()
    holding = m.focusZone = "tabs" and m.frostFocus.hasFocus()
    for i = 0 to m.tabParts.count() - 1
        part = m.tabParts[i]
        lit = holding and i = m.railIndex
        color = FROST_CLEAR
        if m.tabs[i] = m.tabId then color = frostInk("#FFFFFF29")
        if lit then color = frostColor("buttonFocused", "#FFFFFF61")
        part.fill.blendColor = color
        scale = 1
        if lit then scale = 1.04
        part.group.scale = [scale, scale]
    end for
end sub

' ===== Overview =====

' From the window's foot up: the title, its facts with the file's badges after them, the status line,
' the scores, and the overview and its credits beside the track pickers
sub layoutHero()
    m.layingOut = true
    layoutMetadataRow()
    hideEpisodeHeader()
    m.personMeta.visible = false

    fitWrappedLabel(m.titleNode)
    m.titleNode.translation = [0, 0]
    y = m.titleNode.height + FROST_TITLE_GAP
    y = placeFacts(y)
    if isValid(m.incompleteLine) and m.incompleteLine.visible
        m.incompleteLine.width = FROST_TEXT_WIDTH
        m.incompleteLine.wrap = true
        y += INCOMPLETE_LINE_GAP
        m.incompleteLine.translation = [0, y]
        y += m.incompleteLine.boundingRect().height
    end if

    y = placeStatus(y)
    m.frostRatings.visible = m.ratingsRow.visible
    if m.frostRatings.visible
        y += FROST_PART_GAP
        m.frostRatings.translation = [0, y]
        y += FROST_RATINGS_HEIGHT
    end if

    y += FROST_PART_GAP
    y += buildRow(y)
    m.frostColumn.translation = [FROST_PAD_X, m.windowHeight - FROST_CONTENT_FOOT - y]
    m.layingOut = false

    if m.focusZone = "content" and spotExists(m.spot) then paintSpot(m.spot, m.frostFocus.hasFocus())
end sub

' The facts line with the file's badges after it, or under it when the line has no room left.
' Returns where the next part goes.
function placeFacts(y as float) as float
    m.metadataRow.translation = [0, y]
    lineHeight = m.metaRowHeight
    chipsWidth = 0
    count = m.techChips.getChildCount()
    if m.techRow.visible and count > 0
        chip = m.techChips.getChild(count - 1)
        chipsWidth = chip.translation[0] + chip.getChild(0).width
    end if
    if chipsWidth = 0 then return y + lineHeight

    x = 0
    if m.metaRowHeight > 0 then x = m.metaRowWidth + FROST_BADGE_GAP
    if x + chipsWidth <= FROST_TEXT_WIDTH
        if m.techChip.height > lineHeight
            m.metadataRow.translation = [0, y + (m.techChip.height - lineHeight) / 2]
            lineHeight = m.techChip.height
        end if
        m.techRow.translation = [x, y + (lineHeight - m.techChip.height) / 2]
        return y + lineHeight
    end if
    m.techRow.translation = [0, y + lineHeight + 9]
    return y + lineHeight + 9 + m.techChip.height
end function

function placeStatus(y as float) as float
    info = statusLine()
    m.frostStatus.visible = isValid(info)
    if not m.frostStatus.visible then return y

    middle = FROST_STATUS_HEIGHT / 2
    x = 0
    m.frostStatusDot.visible = info.dot <> ""
    if m.frostStatusDot.visible
        m.frostStatusDot.blendColor = info.dot
        m.frostStatusDot.translation = [0, middle - FROST_STATUS_DOT / 2]
        x += FROST_STATUS_DOT + FROST_STATUS_GAP
    end if
    showsBar = info.bar >= 0
    m.frostStatusTrack.visible = showsBar
    m.frostStatusFill.visible = showsBar
    if showsBar
        m.frostStatusTrack.translation = [x, middle - 3.75]
        m.frostStatusFill.translation = [x, middle - 3.75]
        m.frostStatusFill.width = Int(FROST_STATUS_BAR * info.bar)
        m.frostStatusFill.color = info.barColor
        x += FROST_STATUS_BAR + FROST_STATUS_GAP
    end if
    m.frostStatusText.text = info.label
    m.frostStatusText.translation = [x, 0]
    m.frostStatusText.height = FROST_STATUS_HEIGHT
    m.frostStatusText.vertAlign = "center"
    m.frostStatus.translation = [0, y + FROST_PART_GAP]

    m.frostStatusNote.visible = isValidStringValue(info.note)
    if not m.frostStatusNote.visible then return y + FROST_PART_GAP + FROST_STATUS_HEIGHT
    m.frostStatusNote.text = info.note
    m.frostStatusNote.translation = [0, FROST_STATUS_HEIGHT + FROST_STATUS_NOTE_GAP]
    return y + FROST_PART_GAP + FROST_STATUS_HEIGHT + FROST_STATUS_NOTE_GAP + m.frostStatusNote.boundingRect().height
end function

' The overview's first lines with its credits under it, and beside them the track pickers, or where
' a title only Seerr has streams. Returns how tall the row is.
function buildRow(top as float) as float
    m.frostRow.removeChildrenIndex(m.frostRow.getChildCount(), 0)
    m.frostRow.translation = [0, top]
    m.textPart = invalid
    m.trackParts = []

    leftHeight = 0
    text = ""
    if m.overview.visible then text = m.overview.text
    itemData = chainLookupReturn(m.top.itemContent, "json", invalid)
    if text <> ""
        ' The platter reaches past the text, so the text lines up with the title
        holder = m.frostRow.createChild("Group")
        holder.translation = [-FROST_TEXT_PAD_X, 0]
        platter = frostShape(holder, "pkg:/images/login/fill30.9.png", 0, 0, FROST_LEFT_WIDTH, 0, FROST_CLEAR)
        label = frostLabel(holder, "", frostFont(false, 27), frostInk("#FFFFFFE6"))
        textLines = wrapLines(label, text, FROST_LEFT_WIDTH - FROST_TEXT_PAD_X * 2, FROST_TEXT_PITCH, FROST_TEXT_LINES, fontLine(false, 27))
        label.translation = [FROST_TEXT_PAD_X, FROST_TEXT_PAD_Y]
        boxHeight = FROST_TEXT_PAD_Y * 2 + textLines * FROST_TEXT_PITCH
        platter.height = boxHeight
        holder.scaleRotateCenter = [FROST_LEFT_WIDTH / 2, boxHeight / 2]
        m.textPart = { platter: platter, rest: FROST_CLEAR, lit: frostColor("buttonFocused", FROST_PLATTER), grows: holder, grow: 1.02 }
        leftHeight = boxHeight
    end if

    creditLines = frostCredits()
    if creditLines.count() > 0
        creditRow = m.frostRow.createChild("Group")
        creditRow.translation = [0, leftHeight + FROST_CREDIT_TOP]
        leftHeight += FROST_CREDIT_TOP + placeCredits(creditRow, creditLines)
    end if

    m.trackChoices = []
    if isValid(itemData) then m.trackChoices = trackChoices(itemData)
    sideHeight = 0
    for i = 0 to m.trackChoices.count() - 1
        y = FROST_SIDE_TOP + i * (FROST_TRACK_HEIGHT + FROST_TRACK_GAP)
        m.trackParts.push(trackRow(m.trackChoices[i], y))
        sideHeight = y + FROST_TRACK_HEIGHT
    end for
    card = watchCard()
    if isValid(card) then sideHeight = placeWatchCard(card)

    if sideHeight > leftHeight then return sideHeight
    return leftHeight
end function

' Each credit's label then its names on one line, the last names cut short where the line runs out
function placeCredits(parent as object, lines as object) as float
    x = 0
    height = 0
    for i = 0 to lines.count() - 1
        if i > 0 then x += FROST_CREDITS_GAP
        if x >= FROST_CREDIT_ROOM then exit for
        for each part in [[lines[i][0], true, frostInk(FROST_MUTED)], [lines[i][1], false, frostInk("#FFFFFFEB")]]
            label = frostLabel(parent, part[0], frostFont(part[1], 24), part[2])
            bounds = label.boundingRect()
            if bounds.height > height then height = bounds.height
            label.translation = [x, 0]
            labelWidth = bounds.width
            if x + labelWidth > FROST_CREDIT_ROOM
                labelWidth = FROST_CREDIT_ROOM - x
                label.width = labelWidth
            end if
            x += labelWidth
            if part[1] then x += FROST_CREDIT_GAP
            if x >= FROST_CREDIT_ROOM then exit for
        end for
    end for
    return height
end function

function trackRow(choice as object, y as float) as object
    holder = m.frostRow.createChild("Group")
    holder.translation = [FROST_SIDE_X - FROST_PAD_X, y]
    holder.scaleRotateCenter = [FROST_TRACK_WIDTH / 2, FROST_TRACK_HEIGHT / 2]
    fill = frostShape(holder, "pkg:/images/login/fill30.9.png", 0, 0, FROST_TRACK_WIDTH, FROST_TRACK_HEIGHT, frostInk("#FFFFFF1A"))
    frostShape(holder, choice.icon, FROST_TRACK_PAD, (FROST_TRACK_HEIGHT - FROST_TRACK_ICON) / 2, FROST_TRACK_ICON, FROST_TRACK_ICON, frostInk("#FFFFFF"))

    label = frostLabel(holder, choice.label, frostFont(true, 24), frostInk("#FFFFFF"))
    labelWidth = label.boundingRect().width
    label.translation = [FROST_TRACK_PAD + FROST_TRACK_ICON + 15, 0]
    label.height = FROST_TRACK_HEIGHT
    label.vertAlign = "center"

    unfoldX = FROST_TRACK_WIDTH - FROST_TRACK_PAD - FROST_UNFOLD
    valueX = FROST_TRACK_PAD + FROST_TRACK_ICON + 15 + labelWidth + 15
    value = frostLabel(holder, choice.value, frostFont(false, 24), frostInk("#EBEBF5B8"))
    value.translation = [valueX, 0]
    value.width = unfoldX - 15 - valueX
    value.height = FROST_TRACK_HEIGHT
    value.vertAlign = "center"
    value.horizAlign = "right"
    frostShape(holder, "pkg:/images/icons/unfold_more.webp", unfoldX, (FROST_TRACK_HEIGHT - FROST_UNFOLD) / 2, FROST_UNFOLD, FROST_UNFOLD, frostInk("#FFFFFF99"))
    return { platter: fill, rest: frostInk("#FFFFFF1A"), lit: frostColor("buttonFocused", "#FFFFFF52"), grows: holder, grow: 1.04 }
end function

' Where a title only Seerr has streams, in place of the track pickers. Returns where it ends.
function placeWatchCard(card as object) as float
    x = FROST_SIDE_X - FROST_PAD_X
    heading = frostLabel(m.frostRow, UCase(tr("Streaming on")), frostFont(true, 20), frostInk(FROST_MUTED))
    heading.translation = [x + 24, FROST_SIDE_TOP]
    top = FROST_SIDE_TOP + heading.boundingRect().height + 12
    cardHeight = FROST_PROVIDER_LOGO + 36
    frostShape(m.frostRow, "pkg:/images/login/fill33.9.png", x, top, FROST_TRACK_WIDTH, cardHeight, frostInk("#FFFFFF1A"))
    if card.logo <> ""
        frostArt(m.frostRow, card.logo, x + 18, top + 18, FROST_PROVIDER_LOGO, FROST_PROVIDER_LOGO, "pkg:/images/details/frost/logo_mask.webp")
    end if
    textX = x + 18 + FROST_PROVIDER_LOGO + 21
    parts = []
    name = frostLabel(m.frostRow, card.name, frostFont(true, 27), frostInk("#FFFFFF"))
    name.width = FROST_TRACK_WIDTH - (textX - x) - 24
    parts.push(name)
    if card.sub <> ""
        others = frostLabel(m.frostRow, card.sub, frostFont(false, 23), frostInk("#EBEBF5AD"))
        others.width = name.width
        parts.push(others)
    end if
    stackCentered(parts, textX, cardHeight, 0)
    for each part in parts
        part.translation = [textX, part.translation[1] + top]
    end for
    return top + cardHeight
end function

' ===== Tabs =====

sub buildPane()
    m.frostPaneTrack.removeChildrenIndex(m.frostPaneTrack.getChildCount(), 0)
    m.frostPicker.removeChildrenIndex(m.frostPicker.getChildCount(), 0)
    m.tiles = []
    m.paneItems = []
    m.chipParts = []
    m.contentHeight = 0
    m.paneKind = m.tabId
    m.frostPane.visible = m.tabId <> "overview"
    if m.tabId = "overview" then return

    keys = tabSegments(m.tabId)
    if keys.count() > 0
        shown = shownSegment(m.tabId)
        labels = []
        for each key in keys
            labels.push(segmentLabel(key))
        end for
        buildPicker(labels, keys, shown)
        m.paneKind = "posters"
        if shown = "about" then m.paneKind = "about"
    else if m.tabId = "related"
        m.paneKind = "posters"
    end if

    if m.paneKind = "episodes"
        buildEpisodes()
    else if m.paneKind = "seasons"
        buildSeasons()
    else if m.paneKind = "cast"
        buildCast()
    else if m.paneKind = "extras"
        buildExtras()
    else if m.paneKind = "posters"
        buildPosters()
    else
        buildInfo()
    end if

    ' What's left of the scroll after the tab changed under it
    furthest = m.contentHeight - m.paneHeight
    if furthest < 0 then furthest = 0
    if m.scrollTop > furthest then m.scrollTop = furthest
    m.frostScrollAnim.control = "stop"
    m.frostPaneTrack.translation = [0, -m.scrollTop]

    if m.focusZone = "content" and spotExists(m.spot) then paintSpot(m.spot, m.frostFocus.hasFocus())
end sub

' A tab's content runs from its top to a little over the window's foot, inset the same either side
sub setPane(inset as float, top as float)
    m.paneWidth = m.windowWidth - inset * 2
    m.paneHeight = m.windowHeight - FROST_CONTENT_FOOT - top
    m.frostPane.translation = [inset, top]
    m.frostPane.clippingRect = [0, 0, m.paneWidth, m.paneHeight]
end sub

' A tile in a grid of columns, with its platter under it and the part of it that grows
function gridTile(index as integer, columns as integer, width as float, gap as float, tileHeight as float, runGap as float, platterUri as string) as object
    columnWidth = (width - gap * (columns - 1)) / columns
    group = m.frostPaneTrack.createChild("Group")
    row = index \ columns
    y = FROST_SCROLL_PAD + row * (tileHeight + runGap)
    group.translation = [(index mod columns) * (columnWidth + gap), y]
    platter = frostShape(group, platterUri, 0, 0, columnWidth, tileHeight, FROST_CLEAR)
    m.contentHeight = y + tileHeight + FROST_SCROLL_PAD
    m.rowPitch = tileHeight + runGap
    return { group: group, platter: platter, rest: FROST_CLEAR, lit: frostColor("buttonFocused", FROST_PLATTER), grows: invalid, grow: 1, row: row, width: columnWidth, top: y, height: tileHeight }
end function

' The picked season's episodes in a list, under pills for the seasons
sub buildEpisodes()
    setPane(60, 162)
    season = shownSeason()
    if not isValid(season) then return
    m.paneItems = m.seasonBuckets[season.toStr()] ?? []
    if m.seasonNumbers.count() > 1
        labels = []
        for each option in nouveauLayout.SeasonOptions(m.seasonNumbers, m.sectionData.seasons)
            labels.push(option.label)
        end for
        buildPicker(labels, m.seasonNumbers, season)
    end if

    textWidth = m.paneWidth - 33 - FROST_EPISODE_SIDE - 33 - FROST_ROW_TEXT_X
    sideRight = m.paneWidth - 33
    for i = 0 to m.paneItems.count() - 1
        json = m.paneItems[i].json
        tile = gridTile(i, 1, m.paneWidth, 0, FROST_ROW_HEIGHT, FROST_ROW_GAP, "pkg:/images/livetv/fill42.9.png")
        still = ""
        tag = chainLookupReturn(json, "ImageTags.Primary", "")
        if tag <> "" then still = minimalistRules.ImageUrlFor(json, json.Id ?? "", ImageType.PRIMARY, tag, 576)
        tile.grows = frostArt(tile.group, still, 9, 9, FROST_STILL_WIDTH, FROST_STILL_HEIGHT, "pkg:/images/details/frost/episode_mask.webp")
        ' The tick and the progress sit beside the still, so its corners are the labels' own
        drawPosterLabels(invalid, tile.grows, m.paneItems[i].LookupCI("posterLabels"), posterLabelFrame(FROST_STILL_WIDTH, FROST_STILL_HEIGHT, POSTER_LABEL_EDGE, POSTER_LABEL_EDGE, POSTER_LABEL_EDGE, POSTER_LABEL_EDGE), POSTER_LABEL_EPISODE_SCALE)
        tile.grow = 1.05

        parts = []
        number = json.IndexNumber
        if isValid(number) then parts.push(frostLabel(tile.group, UCase(`${tr("Episode")} ${number}`), frostFont(true, 20), frostInk(FROST_MUTED)))
        name = frostLabel(tile.group, json.Name ?? "", frostFont(true, 30), frostInk("#FFFFFF"))
        name.width = textWidth
        parts.push(name)
        overview = json.Overview ?? ""
        if overview <> ""
            about = frostLabel(tile.group, "", frostFont(false, 23), frostInk(FROST_SOFT))
            wrapLines(about, overview, textWidth, 30, 2, fontLine(false, 23))
            parts.push(about)
        end if
        stackCentered(parts, FROST_ROW_TEXT_X, FROST_ROW_HEIGHT, 4.5)

        ' The runtime with a check once watched, and how much is left under it part way through
        played = chainLookupReturn(json, "UserData.Played", false) = true
        percent = chainLookupReturn(json, "UserData.PlayedPercentage", 0)
        runtime = json.RunTimeTicks ?? 0
        side = []
        length = invalid
        if runtime > 0
            length = frostLabel(tile.group, getFormattedRuntime(runtime), frostFont(false, 23), frostInk("#EBEBF5B8"))
            side.push(length)
        end if
        partial = not played and percent > 0
        left = invalid
        if partial and runtime > 0
            left = frostLabel(tile.group, tr("%1 remaining").Replace("%1", getFormattedRuntime(runtime * (100 - percent) / 100)), frostFont(false, 21), frostInk("#EBEBF5B8"))
        end if
        rowHeight = fontLine(false, 23)
        total = rowHeight
        if partial then total += 12 + 7.5
        if isValid(left) then total += 12 + left.boundingRect().height
        y = (FROST_ROW_HEIGHT - total) / 2
        x = sideRight
        if isValid(length)
            x -= length.boundingRect().width
            length.translation = [x, y]
            x -= 10.5
        end if
        if played then frostShape(tile.group, "pkg:/images/icons/check_circle.webp", x - 25.5, y + (rowHeight - 25.5) / 2, 25.5, 25.5, frostInk("#EBEBF599"))
        y += rowHeight
        if partial
            y += 12
            for each part in [[frostColor("rangeTrack", "#FFFFFF40"), 150], [frostColor("rangeProgress", "#FFFFFF"), 150 * percent / 100]]
                bar = tile.group.createChild("Rectangle")
                bar.color = part[0]
                bar.translation = [sideRight - 150, y]
                bar.width = part[1]
                bar.height = 7.5
            end for
            y += 7.5
        end if
        if isValid(left) then left.translation = [sideRight - left.boundingRect().width, y + 12]
        m.tiles.push(tile)
    end for
end sub

' Lays parts out one under another with a gap, centered in the room
sub stackCentered(parts as object, x as float, room as float, gap as float)
    total = -gap
    for each part in parts
        total += gap + part.boundingRect().height
    end for
    y = (room - total) / 2
    for each part in parts
        part.translation = [x, y]
        y += part.boundingRect().height + gap
    end for
end sub

' Pills over the tab's content, right aligned, for the seasons or the segments. A row too wide for its
' room slides.
sub buildPicker(labels as object, keys as object, shown as dynamic)
    clip = m.frostPicker.createChild("Group")
    fill = frostShape(clip, "pkg:/images/login/fill36.9.png", 0, 0, 0, FROST_PILL_HEIGHT + FROST_PICKER_PAD * 2, frostInk("#FFFFFF14"))
    track = clip.createChild("Group")
    m.chipTrack = track

    x = FROST_PICKER_PAD
    for i = 0 to labels.count() - 1
        holder = track.createChild("Group")
        chip = frostShape(holder, "pkg:/images/login/fill30.9.png", 0, 0, 0, FROST_PILL_HEIGHT, FROST_CLEAR)
        label = frostLabel(holder, labels[i], frostFont(true, 24), frostInk(FROST_SOFT))
        chipWidth = label.boundingRect().width + FROST_PILL_PAD * 2
        chip.width = chipWidth
        label.width = chipWidth
        label.height = FROST_PILL_HEIGHT
        label.horizAlign = "center"
        label.vertAlign = "center"
        holder.translation = [x, FROST_PICKER_PAD]
        holder.scaleRotateCenter = [chipWidth / 2, FROST_PILL_HEIGHT / 2]
        m.chipParts.push({ group: holder, fill: chip, label: label, left: x, width: chipWidth, key: keys[i], selected: keys[i] = shown })
        x += chipWidth + FROST_PICKER_PAD
    end for

    m.chipRow = x
    room = x
    if room > FROST_PICKER_ROOM then room = FROST_PICKER_ROOM
    fill.width = room
    clip.clippingRect = [0, -10, room, FROST_PILL_HEIGHT + FROST_PICKER_PAD * 2 + 20]
    m.chipRoom = room
    if m.chipScroll > m.chipRow - room then m.chipScroll = m.chipRow - room
    m.frostPicker.translation = [m.windowWidth - FROST_PICKER_RIGHT - room, FROST_PICKER_TOP]
    track.translation = [-m.chipScroll, 0]
    for i = 0 to m.chipParts.count() - 1
        paintChip(i, false)
    end for
end sub

' A Seerr show's seasons, each its poster at its own shape beside its name, with where Seerr has got
' to with it on the right
sub buildSeasons()
    setPane(60, 162)
    m.paneItems = seerrSeasons()
    markers = GetSeerrSeasonMarkers(m.seerrDetails)
    posterBase = GetTmdbImageBaseUrls().posterW342
    for i = 0 to m.paneItems.count() - 1
        season = m.paneItems[i]
        number = season.seasonNumber ?? 0
        tile = gridTile(i, 1, m.paneWidth, 0, FROST_ROW_HEIGHT, FROST_ROW_GAP, "pkg:/images/livetv/fill42.9.png")
        art = ""
        if isValidAndNotEmpty(season.posterPath) then art = posterBase + season.posterPath
        tile.grows = frostArt(tile.group, art, 9, 9, 108, 162, "pkg:/images/details/frost/season_mask.webp")
        tile.grow = 1.05

        name = season.name ?? ""
        if name = "" then name = nouveauLayout.SeasonLabel(number)
        caps = UCase(nouveauLayout.SeasonLabel(number))
        aired = season.airDate ?? ""
        if Len(aired) >= 4 then caps += ` ${fontApply.ThemeSeparator()} ${Left(aired, 4)}`
        parts = [frostLabel(tile.group, caps, frostFont(true, 20), frostInk(FROST_MUTED)), frostLabel(tile.group, name, frostFont(true, 33), frostInk("#FFFFFF"))]
        count = season.episodeCount ?? 0
        if count > 0 then parts.push(frostLabel(tile.group, `${count} ${tr("Episodes")}`, frostFont(false, 23), frostInk(FROST_SOFT)))
        stackCentered(parts, 150, FROST_ROW_HEIGHT, 3)

        status = markers[number.toStr()] ?? 0
        pill = seerrStatusPills.TrackPill(status, false)
        label = frostLabel(tile.group, pill.text, frostFont(true, 24), frostInk("#FFFFFF"))
        pillWidth = 24 + 15 + 13.5 + label.boundingRect().width + 24
        pillX = m.paneWidth - 39 - pillWidth
        pillY = (FROST_ROW_HEIGHT - 51) / 2
        frostShape(tile.group, "pkg:/images/login/fill23.9.png", pillX, pillY, pillWidth, 51, frostInk("#FFFFFF14"))
        frostShape(tile.group, "pkg:/images/icons/circle.webp", pillX + 24, pillY + 18, 15, 15, statusColor(status))
        label.translation = [pillX + 24 + 15 + 13.5, pillY]
        label.height = 51
        label.vertAlign = "center"
        m.tiles.push(tile)
    end for
end sub

' The color a Seerr status carries, on a season's dot and on a poster's mark
function statusColor(status as integer) as string
    if status = 4 or status = 5 then return "#22C55E"
    if status = 3 then return "#9333EA"
    if status = 2 then return "#EAB308"
    if status = 6 or status = 7 then return "#EF4444"
    return frostInk("#FFFFFF8A")
end function

' Seerr's mark on a poster: a check once it's in, a filled dash part way, and a clock while it's on
' its way
sub statusDot(parent as object, status as integer, x as float, y as float, size as float)
    circle = "pkg:/images/icons/circle.webp"
    color = statusColor(status)
    frostShape(parent, circle, x, y, size, size, color)
    if status = 4
        glyphSize = size * 0.65
        frostShape(parent, "pkg:/images/icons/remove_rounded.webp", x + (size - glyphSize) / 2, y + (size - glyphSize) / 2, glyphSize, glyphSize, "#FFFFFF")
        return
    end if

    glyph = "schedule_rounded"
    if status = 5 then glyph = "check_rounded"
    ring = size * 0.075
    glyphSize = size * 0.6
    frostShape(parent, circle, x + ring, y + ring, size - ring * 2, size - ring * 2, "#FFFFFF")
    frostShape(parent, `pkg:/images/icons/${glyph}.webp`, x + (size - glyphSize) / 2, y + (size - glyphSize) / 2, glyphSize, glyphSize, color)
end sub

' Five across, each a round photo over the name and the part
sub buildCast()
    setPane(72, 162)
    m.paneItems = m.sectionData.cast
    for i = 0 to m.paneItems.count() - 1
        person = m.paneItems[i]
        tile = gridTile(i, 5, m.paneWidth, 0, FROST_PERSON_HEIGHT, FROST_ROW_GAP, "pkg:/images/details/frost/fill45.9.png")
        photo = tile.group.createChild("Group")
        photo.translation = [(tile.width - FROST_AVATAR) / 2, 21]
        photo.scaleRotateCenter = [FROST_AVATAR / 2, FROST_AVATAR / 2]
        mask = photo.createChild("MaskGroup")
        mask.maskUri = "pkg:/images/icons/circle.webp"
        mask.maskSize = [FROST_AVATAR, FROST_AVATAR]
        frostShape(mask, "pkg:/images/icons/circle.webp", 0, 0, FROST_AVATAR, FROST_AVATAR, frostColor("surface", "#1C1C1E"))
        url = detailImages.ItemImageUrl(person)
        if url = ""
            frostShape(photo, "pkg:/images/icons/person.webp", (FROST_AVATAR - 60) / 2, (FROST_AVATAR - 60) / 2, 60, 60, frostInk(FROST_MUTED))
        else
            image = frostShape(mask, url, 0, 0, FROST_AVATAR, FROST_AVATAR, "#FFFFFF")
            image.loadDisplayMode = "scaleToZoom"
        end if
        tile.grows = photo
        tile.grow = 1.06

        y = 21 + FROST_AVATAR + 18
        for each entry in [[chainLookupReturn(person, "json.Name", ""), true, 27, frostInk("#FFFFFF")], [personRole(person), false, 23, frostInk(FROST_SOFT)]]
            if entry[0] <> ""
                label = frostLabel(tile.group, entry[0], frostFont(entry[1], entry[2]), entry[3])
                label.translation = [12, y]
                label.width = tile.width - 24
                label.horizAlign = "center"
                y += fontLine(entry[1], entry[2])
            end if
        end for
        m.tiles.push(tile)
    end for
end sub

' Three across, each a wide thumbnail over its name
sub buildExtras()
    setPane(60, 168)
    m.paneItems = m.sectionData.extras
    columnWidth = (m.paneWidth - 30) / 3
    thumbWidth = columnWidth - 30
    for i = 0 to m.paneItems.count() - 1
        extra = m.paneItems[i]
        tile = gridTile(i, 3, m.paneWidth, 15, 15 + 288 + 21 + fontLine(true, 27) + 24, 15, "pkg:/images/details/frost/fill45.9.png")
        tile.grows = frostArt(tile.group, detailImages.ItemImageUrl(extra), 15, 15, thumbWidth, 288, "pkg:/images/details/frost/extra_mask.webp")
        tile.grow = 1.04
        label = frostLabel(tile.group, chainLookupReturn(extra, "json.Name", ""), frostFont(true, 27), frostInk("#FFFFFF"))
        label.translation = [21, 15 + 288 + 21]
        label.width = thumbWidth - 12
        m.tiles.push(tile)
    end for
end sub

' Seven posters across. A title from Seerr carries its mark in the corner and its status under its name.
sub buildPosters()
    setPane(60, 168)
    if m.tabId = "related" and not m.top.seerrOnly
        m.paneItems = m.sectionData.similar
    else if shownSegment(m.tabId) = "sim"
        m.paneItems = m.sectionData.seerrSimilar
    else
        m.paneItems = m.sectionData.seerrRecommendations
    end if

    withStatus = false
    for each item in m.paneItems
        if seerrCard(item) then withStatus = true
    end for
    style = seerrBadgeStyle()
    posterWidth = (m.paneWidth - 54) / 7 - 24
    posterHeight = posterWidth * 1.5
    tileHeight = 12 + posterHeight + 15 + fontLine(true, 23) + 18
    if withStatus then tileHeight += 3 + fontLine(false, 20)

    for i = 0 to m.paneItems.count() - 1
        item = m.paneItems[i]
        tile = gridTile(i, 7, m.paneWidth, 9, tileHeight, 9, "pkg:/images/login/fill36.9.png")
        tile.grows = tile.group.createChild("Group")
        tile.grows.translation = [12, 12]
        tile.grows.scaleRotateCenter = [posterWidth / 2, posterHeight / 2]
        tile.grow = 1.05
        art = frostArt(tile.grows, detailImages.ItemImageUrl(item), 0, 0, posterWidth, posterHeight, "pkg:/images/details/frost/poster_mask.webp")
        name = frostLabel(tile.group, chainLookupReturn(item, "json.Name", chainLookupReturn(item, "title", "")), frostFont(true, 23), frostInk("#FFFFFFE6"))
        name.translation = [15, 12 + posterHeight + 15]
        name.width = posterWidth - 6

        if seerrCard(item)
            status = 0
            if item.hasField("mediaInfoStatus") and isValid(item.mediaInfoStatus) then status = item.mediaInfoStatus
            if style = "badge" and status >= 2 and status <= 5 then statusDot(tile.grows, status, posterWidth - 12 - FROST_POSTER_MARK, 12, FROST_POSTER_MARK)
            ' The art's mask rounds the banner's corners with the poster's
            if style = "banner" then drawSeerrStatus(invalid, art.getChild(0), status, posterWidth)
            pill = seerrStatusPills.TrackPill(status, false)
            color = seerrStatusPills.Colors(pill.tone).border
            if pill.tone = "gray" then color = frostInk(FROST_MUTED)
            statusText = frostLabel(tile.group, pill.text, frostFont(false, 20), color)
            statusText.translation = [15, 12 + posterHeight + 15 + fontLine(true, 23) + 3]
            statusText.width = posterWidth - 6
        end if
        m.tiles.push(tile)
    end for
end sub

' Grouped label and value cards in two columns, the first group on the left and the rest on the
' right. The whole of it is one stop, so there's somewhere to land and Back and the toolbar are a
' press away.
sub buildInfo()
    setPane(84, 168)
    groups = []
    if m.paneKind = "about"
        groups = aboutGroups(true)
    else
        groups = infoGroups(m.top.itemContent.json)
    end if
    columnWidth = (m.paneWidth - FROST_DETAIL_COLUMN_GAP) / 2
    cards = []
    columnTop = [0, 0]
    for i = 0 to groups.count() - 1
        column = 0
        if i > 0 then column = 1
        x = column * (columnWidth + FROST_DETAIL_COLUMN_GAP)
        y = columnTop[column]
        if y > 0 then y += FROST_DETAIL_GROUP_GAP
        if groups[i].heading <> ""
            heading = frostLabel(m.frostPaneTrack, UCase(groups[i].heading), frostFont(true, 20), frostInk(FROST_MUTED))
            heading.translation = [x + FROST_DETAIL_INSET, y]
            y += heading.boundingRect().height + 10.5
        end if
        card = frostShape(m.frostPaneTrack, "pkg:/images/login/fill33.9.png", x, y, columnWidth, 0, frostInk("#FFFFFF0F"))
        cards.push(card)
        cardTop = y
        rows = groups[i].rows
        for r = 0 to rows.count() - 1
            labelX = x + FROST_DETAIL_INSET
            logo = rows[r][2] ?? ""
            if logo <> ""
                frostArt(m.frostPaneTrack, logo, labelX, y + FROST_DETAIL_ROW_PAD, FROST_DETAIL_LOGO, FROST_DETAIL_LOGO, "pkg:/images/details/frost/logo_mask.webp")
                labelX += FROST_DETAIL_LOGO + 24
            end if
            label = frostLabel(m.frostPaneTrack, rows[r][0], frostFont(false, 24), frostInk(FROST_MUTED))
            labelBounds = label.boundingRect()
            rowHeight = labelBounds.height
            if logo <> "" and FROST_DETAIL_LOGO > rowHeight then rowHeight = FROST_DETAIL_LOGO
            label.translation = [labelX, y + FROST_DETAIL_ROW_PAD + (rowHeight - labelBounds.height) / 2]
            if rows[r][1] <> ""
                valueX = labelX + labelBounds.width + 24
                valueWidth = x + columnWidth - FROST_DETAIL_INSET - valueX
                if valueWidth < 60 then valueWidth = 60
                value = frostLabel(m.frostPaneTrack, "", frostFont(false, 24), frostInk("#FFFFFFF0"))
                wrapLines(value, rows[r][1], valueWidth, labelBounds.height, 2, labelBounds.height)
                value.horizAlign = "right"
                value.translation = [valueX, y + FROST_DETAIL_ROW_PAD]
                if value.height > rowHeight then rowHeight = value.height
            end if
            y += rowHeight + FROST_DETAIL_ROW_PAD * 2
            if r < rows.count() - 1
                rule = m.frostPaneTrack.createChild("Rectangle")
                rule.color = frostInk("#FFFFFF14")
                rule.translation = [x + FROST_DETAIL_INSET, y - 1.5]
                rule.width = columnWidth - FROST_DETAIL_INSET
                rule.height = 1.5
            end if
        end for
        card.height = y - cardTop
        columnTop[column] = y
    end for

    m.tiles.push({ platters: cards, rest: frostInk("#FFFFFF0F"), lit: frostColor("buttonFocused", "#FFFFFF1F"), grows: invalid, grow: 1, row: 0 })
end sub

' A title Seerr found, which carries Seerr's status rather than a library item's
function seerrCard(item as dynamic) as boolean
    return isSeerrCard(item) or (isValid(item) and item.hasField("mediaInfoStatus"))
end function

' ===== Theme =====

' The parts drawn from white art take their colors here, and so do Frost's own labels, which the
' theme would otherwise only blend toward its ink
sub themeParts()
    m.backdropScrim.color = frostColor("background", "#000000")
    m.backdropVignette.blendColor = frostColor("background", "#000000")
    for each fade in [m.frostFadeUp, m.frostFadeRight]
        fade.blendColor = frostColor("background", "#0C0C0E")
    end for
    m.frostWindowGlass.blendColor = frostColor("surface", "#1C1C20")
    for each glass in [m.frostToolbarGlass, m.frostTabBarGlass]
        glass.blendColor = frostColor("surface", "#303036")
    end for
    for each rim in [m.frostWindowRim, m.frostToolbarRim, m.frostTabBarRim]
        rim.blendColor = frostInk("#FFFFFF")
    end for
    ' The hairlines above and below the scores
    for i = 0 to 1
        m.frostRatings.getChild(i).color = frostInk("#FFFFFF24")
    end for
    m.frostStatusTrack.color = frostColor("rangeTrack", "#FFFFFF40")
    m.frostReadMoreShade.color = frostColor("background", "#00000080")
    m.frostReadMorePanel.blendColor = frostColor("surface", "#242428F7")
    for each part in [[m.titleNode, "#FFFFFF"], [m.frostStatusText, "#EBEBF5CC"], [m.frostCaps, "#EBEBF59E"], [m.frostTabName, "#FFFFFF"], [m.frostReadMoreTitle, "#FFFFFF"], [m.frostReadMoreMeta, "#EBEBF5A6"], [m.frostReadMoreText, "#FFFFFFEB"]]
        part[0].color = frostInk(part[1])
    end for
end sub

' A part's color in the active theme's role, at the strength Frost gives the part. Progress bars take
' the theme's range colors as they are, and with no theme on Frost keeps its own look.
function frostColor(role as string, original as string) as string
    ' Read once, since every label and platter on the page asks
    if not isValid(m.frostColors)
        m.frostColors = { active: themeChrome.IsActive() }
        if m.frostColors.active
            m.frostColors.append({
                onBackground: themeChrome.OnBackground(),
                buttonFocused: themeChrome.Token("buttonFocused", "#FFFFFF"),
                surface: themeChrome.Surface(),
                background: themeChrome.Background(),
                rangeProgress: themeChrome.Token("rangeProgress", "#00A4DC"),
                rangeTrack: formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorHomeRowItemProgressBackground", ""), "0x404040FF")
            })
        end if
    end if
    if not m.frostColors.active then return original

    color = m.frostColors[role]
    if role = "rangeProgress" or role = "rangeTrack" then return color

    alpha = "FF"
    hex = themeChrome.BareHex(original)
    if hex.len() = 8 then alpha = hex.right(2)
    return themeChrome.WithAlpha(color, alpha)
end function

function frostInk(original as string) as string
    return frostColor("onBackground", original)
end function

' ===== Drawing helpers =====

function frostLabel(parent as object, text as string, font as object, color as string) as object
    label = parent.createChild("Label")
    label.font = font
    label.color = color
    label.text = text
    return label
end function

function frostShape(parent as object, uri as string, x as float, y as float, width as float, height as float, color as string) as object
    shape = parent.createChild("Poster")
    shape.uri = uri
    shape.translation = [x, y]
    shape.width = width
    shape.height = height
    shape.blendColor = color
    return shape
end function

' A picture rounded by its mask over a dark box, in a group that grows about its middle
function frostArt(parent as object, uri as string, x as float, y as float, width as float, height as float, maskUri as string) as object
    holder = parent.createChild("Group")
    holder.translation = [x, y]
    holder.scaleRotateCenter = [width / 2, height / 2]
    mask = holder.createChild("MaskGroup")
    mask.maskUri = maskUri
    mask.maskSize = [width, height]
    frostShape(mask, "pkg:/images/login/fill13.9.png", 0, 0, width, height, frostColor("surface", "#1C1C1E"))
    if uri <> ""
        image = frostShape(mask, uri, 0, 0, width, height, "#FFFFFF")
        image.loadDisplayMode = "scaleToZoom"
    end if
    return holder
end function

' Wraps text at a width and line pitch, up to a count of lines. A wrapped label with no height can
' draw only its first line, so it gets the height its lines take. Returns the lines it shows.
function wrapLines(label as object, text as string, width as float, pitch as float, most as integer, lineHeight as float) as integer
    spacing = pitch - lineHeight
    if spacing < 0 then spacing = 0
    label.wrap = true
    label.lineSpacing = spacing
    label.maxLines = 0
    label.width = width
    label.height = 0
    label.text = text
    if text = "" then return 0
    needed = Int((label.boundingRect().height + spacing) / pitch + 0.5)
    if needed < 1 then needed = 1
    if needed > most then needed = most
    label.maxLines = needed
    label.height = needed * pitch
    return needed
end function

' ===== Focus =====

' The parts of the tab on screen a spot can name
function spotExists(spot as dynamic) as boolean
    if not isValid(spot) then return false
    if spot.kind = "text" then return isValid(m.textPart) and m.tabId = "overview"
    if spot.kind = "track" then return m.tabId = "overview" and spot.index < m.trackParts.count()
    if spot.kind = "chip" then return m.tabId <> "overview" and spot.index < m.chipParts.count()
    return m.tabId <> "overview" and spot.index < m.tiles.count()
end function

sub paintSpot(spot as dynamic, lit as boolean)
    if not spotExists(spot) then return
    if spot.kind = "text"
        paintPart(m.textPart, lit)
    else if spot.kind = "track"
        paintPart(m.trackParts[spot.index], lit)
    else if spot.kind = "chip"
        paintChip(spot.index, lit)
    else
        paintPart(m.tiles[spot.index], lit)
    end if
end sub

' A lit part takes the focused platter and grows a little. It's never a solid fill or border.
sub paintPart(part as object, lit as boolean)
    color = part.rest
    if lit then color = part.lit
    if isValid(part.platter) then part.platter.blendColor = color
    for each platter in part.platters ?? []
        platter.blendColor = color
    end for
    if not isValid(part.grows) then return
    scale = 1
    if lit then scale = part.grow
    part.grows.scale = [scale, scale]
end sub

sub paintChip(index as integer, lit as boolean)
    chip = m.chipParts[index]
    color = FROST_CLEAR
    if chip.selected then color = frostInk("#FFFFFF2E")
    if lit then color = frostColor("buttonFocused", "#FFFFFF61")
    chip.fill.blendColor = color
    chip.label.color = frostInk(FROST_SOFT)
    if lit or chip.selected then chip.label.color = frostInk("#FFFFFF")
    scale = 1
    if lit then scale = 1.06
    chip.group.scale = [scale, scale]
end sub

sub onFrostFocusChanged()
    if m.focusZone = "content" then paintSpot(m.spot, m.frostFocus.hasFocus())
    paintTabBar()
end sub

sub holdRemote()
    if not m.frostFocus.hasFocus() then m.frostFocus.setFocus(true)
    m.top.lastFocus = m.frostFocus
    setLastFocus(m.frostFocus)
end sub

sub leaveZone()
    if m.focusZone = "buttons"
        unhighlightAllButtons()
    else if m.focusZone = "content"
        paintSpot(m.spot, false)
    end if
end sub

sub focusTab(index as integer)
    if index < 0 or index >= m.tabs.count() then return
    leaveZone()
    m.focusZone = "tabs"
    m.railIndex = index
    holdRemote()
    ' Moving onto a tab puts it on screen
    if m.tabs[index] <> m.tabId then showTab(m.tabs[index])
    paintTabBar()
end sub

sub focusSpot(spot as object)
    leaveZone()
    m.focusZone = "content"
    m.spot = spot
    if spot.kind <> "chip" then m.memory[m.tabId] = spot
    holdRemote()
    paintSpot(spot, true)
    if spot.kind = "tile" then revealTile(spot.index)
    if spot.kind = "chip" then revealChip(spot.index)
    paintTabBar()
end sub

' OK on a tab, or Up off the toolbar: where the remote was in that tab, or where it starts
sub enterContent()
    spot = m.memory[m.tabId]
    if not spotExists(spot) then spot = startSpot()
    if isValid(spot)
        focusSpot(spot)
    else
        focusTab(tabIndex(m.tabId))
    end if
end sub

function startSpot() as dynamic
    if m.tabId = "overview"
        if isValid(m.textPart) then return { kind: "text", index: 0 }
        if m.trackParts.count() > 0 then return { kind: "track", index: 0 }
        return invalid
    end if
    if m.tiles.count() = 0 then return invalid
    if m.paneKind = "episodes" then return { kind: "tile", index: startEpisode() }
    return { kind: "tile", index: 0 }
end function

' Down off the content or Up off the tab bar: the button the toolbar last had, or Play
sub frostToActions()
    if m.buttonGroups.count() = 0 then return
    leaveZone()
    m.focusZone = "buttons"
    index = m.currentButtonIndex
    if index < 0 or index >= m.buttonGroups.count() then index = 0
    focusButton(index)
    paintTabBar()
end sub

' Back from anywhere but Play on Overview lands there, with every tab starting over
sub goHome()
    m.memory = {}
    if m.tabId <> "overview" then showTab("overview")
    m.currentButtonIndex = 0
    frostToActions()
end sub

' A list or grid moves so the row over the focused one stays in sight, as long as the focused one
' still fits, and only as far as it goes
sub revealTile(index as integer)
    if m.paneKind = "details" or m.paneKind = "about" then return
    tile = m.tiles[index]
    target = (tile.row - 1) * m.rowPitch
    fits = tile.top + tile.height + FROST_SCROLL_PAD - m.paneHeight
    if target < fits then target = fits
    furthest = m.contentHeight - m.paneHeight
    if target > furthest then target = furthest
    if target < 0 then target = 0
    if target = m.scrollTop then return
    m.frostScrollAnim.control = "stop"
    m.frostScrollInterp.keyValue = [m.frostPaneTrack.translation, [0, -target]]
    m.scrollTop = target
    m.frostScrollAnim.control = "start"
end sub

sub revealChip(index as integer)
    if m.chipRow <= m.chipRoom then return
    chip = m.chipParts[index]
    target = chip.left - 0.2 * (m.chipRoom - chip.width)
    furthest = m.chipRow - m.chipRoom
    if target > furthest then target = furthest
    if target < 0 then target = 0
    m.chipScroll = target
    m.chipTrack.translation = [-target, 0]
end sub

function selectedChip() as integer
    for i = 0 to m.chipParts.count() - 1
        if m.chipParts[i].selected then return i
    end for
    return 0
end function

' ===== Choosing =====

sub selectSpot()
    spot = m.spot
    if not spotExists(spot) then return
    if spot.kind = "text"
        openReadMore()
    else if spot.kind = "track"
        runButtonAction(m.trackChoices[spot.index].action)
    else if spot.kind = "chip"
        key = m.chipParts[spot.index].key
        if m.paneKind = "episodes"
            m.pickedSeason = key
        else
            m.segment[m.tabId] = key
        end if
        m.memory.Delete(m.tabId)
        buildPane()
    else
        selectTile(spot.index)
    end if
end sub

sub selectTile(index as integer)
    if index >= m.paneItems.count() then return
    item = m.paneItems[index]
    if m.paneKind = "episodes"
        ' The episode already on screen plays rather than opening its own page again
        if picksItemOnScreen(item)
            playItemOnScreen()
        else
            m.top.selectedItem = item
        end if
    else if m.paneKind = "seasons"
        startSeerrRequest("seerrRequest", item.seasonNumber ?? 0)
    else if m.paneKind = "posters" and seerrCard(item)
        ShowSeerrDetails(item)
    else
        m.top.selectedItem = item
    end if
end sub

' The whole overview over the page, under the title's name and its facts
sub openReadMore()
    width = FROST_DIALOG_WIDTH - FROST_DIALOG_PAD_X * 2
    m.frostReadMoreTitle.text = m.titleNode.text
    m.frostReadMoreTitle.width = width
    fitWrappedLabel(m.frostReadMoreTitle)
    facts = []
    for each id in ["metaGenres", "releaseYear", "runtime"]
        text = m.top.findNode(id).text
        if text <> "" then facts.push(text)
    end for
    m.frostReadMoreMeta.text = facts.join(` ${fontApply.ThemeSeparator()} `)
    metaHeight = 0
    if m.frostReadMoreMeta.text <> "" then metaHeight = 9 + fontLine(false, 24)

    left = FROST_DIALOG_X + FROST_DIALOG_PAD_X
    y = FROST_DIALOG_Y + FROST_DIALOG_PAD_Y
    m.frostReadMoreTitle.translation = [left, y]
    y += m.frostReadMoreTitle.height
    m.frostReadMoreMeta.translation = [left, y + 9]
    y += metaHeight + 33
    room = 1080 - 60 - FROST_DIALOG_PAD_Y - y
    lines = wrapLines(m.frostReadMoreText, m.overview.text, width, FROST_DIALOG_PITCH, Int(room / FROST_DIALOG_PITCH), fontLine(false, 30))
    m.frostReadMoreText.translation = [left, y]
    y += lines * FROST_DIALOG_PITCH + FROST_DIALOG_PAD_Y
    m.frostReadMorePanel.translation = [FROST_DIALOG_X, FROST_DIALOG_Y]
    m.frostReadMorePanel.width = FROST_DIALOG_WIDTH
    m.frostReadMorePanel.height = y - FROST_DIALOG_Y
    m.frostReadMore.visible = true
    m.readMoreOpen = true
end sub

' A picker opened from a track row hands back to the row, which shows the new pick
sub restoreFocusToButtons()
    if isValid(openTrackPicker()) then return
    if m.focusZone = "content"
        layoutHero()
        holdRemote()
        paintSpot(m.spot, true)
        return
    end if
    if m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count() then focusButton(m.currentButtonIndex)
end sub

' A Seerr dialog opened from a season hands focus back to the tab
function seerrFocusTarget() as object
    if m.focusZone = "content" or m.focusZone = "tabs" then return m.frostFocus
    if m.currentButtonIndex >= 0 and m.currentButtonIndex < m.buttonGroups.count() then return m.buttonGroups[m.currentButtonIndex]
    return m.top
end function

' ===== Buttons =====

' The toolbar leaves the pickers out, since Overview has them. Play, or Request on a title only Seerr
' has, is an accent pill, and the rest are icons that name themselves over them when focused.
sub appendButtonNode(config as object)
    if config.id = "audioTrackButton" or config.id = "subtitleButton" or config.id = "versionButton" then return

    ' The pill has room to say where Resume picks up
    if m.buttonGroups.count() = 0 and config.id = "resumeButton" and isValidAndNotEmpty(config.detail)
        config.label = tr("Resume from ") + config.detail
        config.detail = ""
    end if

    buttonGroup = detailButtons.createModernButton(config, m.buttonGroups.count())
    buttonGroup.frosted = true
    buttonGroup.leading = m.buttonGroups.count() = 0 and (buttonGroup.primary or m.top.seerrOnly)
    buttonGroup.observeField("focusedChild", "onButtonFocusChanged")
    m.buttonRow.appendChild(buttonGroup)
    m.buttonGroups.push(buttonGroup)
end sub

' Play, four circles and More are what fit over the window's foot, or fewer when the viewer set a
' lower limit. The toolbar can't scroll, so a limit of every button still stops at that.
function buttonCap() as object
    cap = { maxVisible: FROST_MAX_BUTTONS, overflowAsMenu: true, countCapped: true }
    limit = viewerButtonLimit()
    if limit > 0 and limit + 1 < FROST_MAX_BUTTONS then cap.maxVisible = limit + 1
    return cap
end function

' The buttons run left to right in a capsule centered under the window, with a little more room after
' the pill
sub layoutButtonRow(_focusIndex as integer)
    x = 0
    for each button in m.buttonGroups
        button.translation = [x, 0]
        x += button.faceWidth + FROST_BUTTON_GAP
        if button.leading then x += FROST_BUTTON_GAP
    end for
    m.frostToolbar.visible = m.buttonGroups.count() > 0
    if not m.frostToolbar.visible then return

    last = m.buttonGroups.peek()
    glassWidth = last.translation[0] + last.faceWidth + FROST_TOOLBAR_PAD * 2
    left = (m.stageWidth - glassWidth) / 2
    top = m.stageHeight - FROST_TOOLBAR_FOOT - 114
    m.frostToolbarGlass.width = glassWidth
    m.frostToolbarRim.width = glassWidth
    m.frostToolbarGlass.translation = [left, top]
    m.buttonRowContainer.translation = [left + FROST_TOOLBAR_PAD, top + FROST_TOOLBAR_PAD]
end sub

' ===== Keys =====

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A picker left open across a screensaver can come back without focus, which would leave this
    ' screen answering the remote from behind it
    picker = openTrackPicker()
    if isValid(picker)
        picker.setFocus(true)
        return true
    end if
    if m.overflowMenu.visible then return false

    if m.readMoreOpen
        if key = KeyCode.OK or key = KeyCode.BACK
            m.frostReadMore.visible = false
            m.readMoreOpen = false
        end if
        return true
    end if

    if key = KeyCode.BACK
        if m.tabId = "overview" and m.focusZone = "buttons" and m.currentButtonIndex = 0 or m.buttonGroups.count() = 0
            m.global.sceneManager.callFunc("popScene")
        else
            goHome()
        end if
        return true
    end if

    if m.focusZone = "buttons" then return toolbarKey(key)
    if m.focusZone = "tabs" then return tabKey(key)
    if m.focusZone = "content" then return contentKey(key)
    return false
end function

' Left and Right move along the toolbar, Up goes back into the tab and Down to its place in the bar
function toolbarKey(key as string) as boolean
    index = m.currentButtonIndex
    if key = KeyCode.OK
        handleButtonSelect()
    else if key = KeyCode.LEFT
        if index > 0
            focusButton(index - 1)
        else if FocusSidebar(m.top)
            unhighlightAllButtons()
        end if
    else if key = KeyCode.RIGHT
        if index < m.buttonGroups.count() - 1 then focusButton(index + 1)
    else if key = KeyCode.UP
        enterContent()
    else if key = KeyCode.DOWN
        focusTab(tabIndex(m.tabId))
    else
        return false
    end if
    return true
end function

' Left and Right walk the tabs, Left off the first reaching a sidebar docked there, Up goes back to the
' toolbar and OK into the tab
function tabKey(key as string) as boolean
    index = m.railIndex
    if key = KeyCode.LEFT
        if index > 0
            focusTab(index - 1)
        else
            FocusSidebar(m.top)
        end if
    else if key = KeyCode.RIGHT
        if index < m.tabs.count() - 1 then focusTab(index + 1)
    else if key = KeyCode.UP
        frostToActions()
    else if key = KeyCode.OK
        enterContent()
    else if key <> KeyCode.DOWN
        return false
    end if
    return true
end function

' Off the content's top edge to a nav along the top, where there's one
sub toTopNav()
    if not sidebarShown() then FocusOverhang(m.top)
end sub

' Left off the left edge goes to a sidebar docked there, Up off the top to a nav along the top, and
' Down off the bottom to the toolbar. The other edges hold.
function contentKey(key as string) as boolean
    spot = m.spot
    if not spotExists(spot) then return false
    if key = KeyCode.OK
        selectSpot()
        return true
    end if

    if spot.kind = "text"
        if key = KeyCode.LEFT
            FocusSidebar(m.top)
        else if key = KeyCode.UP
            toTopNav()
        else if key = KeyCode.RIGHT
            if m.trackParts.count() > 0 then focusSpot({ kind: "track", index: 0 })
        else if key = KeyCode.DOWN
            frostToActions()
        end if
    else if spot.kind = "track"
        if key = KeyCode.LEFT
            if isValid(m.textPart)
                focusSpot({ kind: "text", index: 0 })
            else
                FocusSidebar(m.top)
            end if
        else if key = KeyCode.UP
            if spot.index > 0
                focusSpot({ kind: "track", index: spot.index - 1 })
            else
                toTopNav()
            end if
        else if key = KeyCode.DOWN
            if spot.index < m.trackParts.count() - 1
                focusSpot({ kind: "track", index: spot.index + 1 })
            else
                frostToActions()
            end if
        end if
    else if spot.kind = "chip"
        if key = KeyCode.LEFT
            if spot.index > 0
                focusSpot({ kind: "chip", index: spot.index - 1 })
            else
                FocusSidebar(m.top)
            end if
        else if key = KeyCode.RIGHT
            if spot.index < m.chipParts.count() - 1 then focusSpot({ kind: "chip", index: spot.index + 1 })
        else if key = KeyCode.UP
            toTopNav()
        else if key = KeyCode.DOWN
            if m.tiles.count() > 0 then focusSpot(startSpot())
        end if
    else
        gridKey(key, spot.index)
    end if
    return true
end function

sub gridKey(key as string, index as integer)
    columns = gridColumns()
    count = m.tiles.count()
    if key = KeyCode.LEFT
        if index mod columns = 0
            FocusSidebar(m.top)
        else
            focusSpot({ kind: "tile", index: index - 1 })
        end if
    else if key = KeyCode.RIGHT
        if index mod columns < columns - 1 and index < count - 1 then focusSpot({ kind: "tile", index: index + 1 })
    else if key = KeyCode.UP
        if index >= columns
            focusSpot({ kind: "tile", index: index - columns })
        else if m.chipParts.count() > 0
            focusSpot({ kind: "chip", index: selectedChip() })
        else
            toTopNav()
        end if
    else if key = KeyCode.DOWN
        if index \ columns = (count - 1) \ columns
            frostToActions()
        else
            below = index + columns
            if below > count - 1 then below = count - 1
            focusSpot({ kind: "tile", index: below })
        end if
    end if
end sub

function gridColumns() as integer
    if m.paneKind = "cast" then return 5
    if m.paneKind = "extras" then return 3
    if m.paneKind = "posters" then return 7
    return 1
end function

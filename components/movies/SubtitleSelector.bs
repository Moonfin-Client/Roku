import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"
import "pkg:/source/utils/trackLabels.bs"

sub init()
    m.subtitleMenu = m.top.findNode("subtitleMenu")
    m.subtitleMenu.observeField("itemSelected", "onSubtitleItemSelected")

    m.top.findNode("title").text = tr("Subtitle Track")
    m.offsetIndex = -1

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.top.findNode("title"),
        titleRule: m.top.findNode("titleRule"),
        list: m.subtitleMenu
    }

    m.top.observeField("visible", "onVisibleChanged")
end sub

sub onVisibleChanged()
    if m.top.visible then m.subtitleMenu.setFocus(true)
end sub

' None stays first, and the tracks follow in the order the viewer's settings score them
function orderedTracks(tracks as object) as object
    noneTracks = []
    selectableTracks = []
    settings = isValid(m.global) and isValid(m.global.session) ? m.global.session.user.settings : {}

    for each track in tracks
        if track.StreamIndex = SubtitleSelection.NONE
            noneTracks.push(track)
        else
            track.score = trackLabels.ScoreSubtitle(track.json, settings)
            selectableTracks.push(track)
        end if
    end for

    selectableTracks.sortBy("score", "r")
    noneTracks.append(selectableTracks)

    return noneTracks
end function

sub subtitleTracksSet()
    if not isValid(m.top.subtitleTracks) or m.top.mode = "slot" then return
    secondary = m.top.mode = "secondary"
    m.top.findNode("title").text = secondary ? tr("Secondary Subtitle Track") : tr("Subtitle Track")

    subtitleContent = CreateObject("roSGNode", "ContentNode")
    index = 0
    position = 0
    selectedSubtitleIndex = 0

    ' The second track's list comes already in its own order, its preferred language first
    tracks = secondary ? m.top.subtitleTracks : orderedTracks(m.top.subtitleTracks)
    for each subtitle in tracks
        entry = subtitleContent.CreateChild("SubtitleTrackListData")
        entry.json = subtitle.json
        entry.index = subtitle.StreamIndex.toStr()
        entry.StreamIndex = subtitle.StreamIndex

        if subtitle.StreamIndex = SubtitleSelection.NONE
            entry.title = tr("None")
        else
            position = position + 1
            entry.title = trackLabels.NumberedName(position, subtitle.Title, tr("Subtitle"))
            entry.description = trackLabels.SubtitleDetail(subtitle.json, subtitle.Title)
        end if

        if isValid(subtitle.Selected) and subtitle.Selected
            selectedSubtitleIndex = index
            entry.selected = true
        end if
        index = index + 1
    end for

    m.offsetIndex = -1
    m.appearanceIndex = -1
    if m.top.showOffset
        offset = subtitleContent.CreateChild("SubtitleTrackListData")
        offset.title = tr("Offset")
        offset.description = trackLabels.OffsetDetail(m.top.offset)
        offset.action = "offset"
        offset.dividerAbove = true
        m.offsetIndex = subtitleContent.getChildCount() - 1

        appearance = subtitleContent.CreateChild("SubtitleTrackListData")
        appearance.title = tr("Appearance")
        appearance.action = "appearance"
        m.appearanceIndex = subtitleContent.getChildCount() - 1
    end if

    if not secondary
        download = subtitleContent.CreateChild("SubtitleTrackListData")
        download.title = tr("Download subtitles...")
        download.description = tr("Search using OpenSubtitles")
        download.action = "download"
        download.dividerAbove = not m.top.showOffset
    end if

    showList(subtitleContent, selectedSubtitleIndex)
end sub

' Ends the list with Cancel and shows it
sub showList(content as object, focusIndex as integer)
    cancel = content.CreateChild("SubtitleTrackListData")
    cancel.title = tr("Cancel")
    cancel.action = "cancel"
    cancel.dimmed = true
    cancel.dividerAbove = true

    trackDialog.Layout(m.parts, content.getChildCount())

    m.subtitleMenu.content = content
    m.subtitleMenu.jumpToItem = focusIndex
end sub

' Which of the two tracks to pick, each with what it's set to now
sub buildSlots()
    if m.top.mode <> "slot" or not isValid(m.top.slotDetails) then return
    m.top.findNode("title").text = tr("Subtitles")

    content = CreateObject("roSGNode", "ContentNode")
    for each slot in [["primary", "Primary"], ["secondary", "Secondary"]]
        entry = content.CreateChild("SubtitleTrackListData")
        entry.title = tr(slot[1])
        entry.description = m.top.slotDetails[slot[0]]
        entry.action = slot[0]
    end for
    m.offsetIndex = -1
    m.appearanceIndex = -1
    showList(content, 0)
end sub

sub onSubtitleItemSelected()
    selectedItem = m.subtitleMenu.content.getChild(m.subtitleMenu.itemSelected)
    if not isValid(selectedItem) then return

    if selectedItem.action = "cancel"
        m.top.visible = false
        return
    end if

    if selectedItem.action = "primary" or selectedItem.action = "secondary"
        m.top.slotChosen = selectedItem.action
        return
    end if

    if selectedItem.action = "download"
        m.top.downloadRequested = true
        m.top.visible = false
        return
    end if

    if selectedItem.action = "offset"
        m.top.offsetRequested = true
        m.top.visible = false
        return
    end if

    if selectedItem.action = "appearance"
        m.top.appearanceRequested = true
        m.top.visible = false
        return
    end if

    m.top.subtitleStream = selectedItem
    m.top.visible = false
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A picker that has been dismissed can still be holding focus, and swallowing
    ' keys there would leave the screen behind it unable to move
    if not m.top.visible then return false

    if key = KeyCode.BACK
        m.top.visible = false
        return true
    end if

    ' Left from any track goes straight to Offset, and Right to Appearance
    if key = KeyCode.LEFT and m.offsetIndex >= 0 and m.subtitleMenu.itemFocused < m.offsetIndex
        m.subtitleMenu.jumpToItem = m.offsetIndex
        return true
    end if
    if key = KeyCode.RIGHT and m.appearanceIndex >= 0 and m.subtitleMenu.itemFocused < m.offsetIndex
        m.subtitleMenu.jumpToItem = m.appearanceIndex
        return true
    end if

    if key = KeyCode.LEFT or key = KeyCode.RIGHT or key = KeyCode.PLAY or key = KeyCode.FASTFORWRD or key = KeyCode.REWIND or key = KeyCode.REPLAY
        return true
    end if

    if key = KeyCode.UP or key = KeyCode.DOWN or key = KeyCode.OK
        if not m.subtitleMenu.isInFocusChain()
            m.subtitleMenu.setFocus(true)
        end if
        return true
    end if

    return false
end function

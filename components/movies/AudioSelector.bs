import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"
import "pkg:/source/utils/trackLabels.bs"

sub init()
    m.audioMenu = m.top.findNode("audioMenu")
    m.audioMenu.observeField("itemSelected", "onAudioItemSelected")

    m.top.findNode("title").text = tr("Audio Track")

    m.parts = {
        panel: m.top.findNode("panel"),
        panelBg: m.top.findNode("panelBg"),
        panelBorder: m.top.findNode("panelBorder"),
        title: m.top.findNode("title"),
        titleRule: m.top.findNode("titleRule"),
        list: m.audioMenu
    }

    m.top.observeField("visible", "onVisibleChanged")
end sub

sub onVisibleChanged()
    if m.top.visible then m.audioMenu.setFocus(true)
end sub

sub audioTracksSet()
    if not isValid(m.top.audioTracks) then return

    audioContent = CreateObject("roSGNode", "ContentNode")
    index = 0
    selectedAudioIndex = 0

    for each audio in m.top.audioTracks
        entry = audioContent.CreateChild("AudioTrackListData")
        entry.title = trackLabels.NumberedName(index + 1, audio.Title, tr("Audio"))
        entry.description = trackLabels.AudioDetail(audio)
        entry.streamName = audio.RokuTrackName
        entry.streamIndex = audio.StreamIndex
        if isValid(audio.Selected) and audio.Selected
            selectedAudioIndex = index
            entry.selected = true
        end if
        index = index + 1
    end for

    cancel = audioContent.CreateChild("AudioTrackListData")
    cancel.title = tr("Cancel")
    cancel.action = "cancel"
    cancel.dimmed = true
    cancel.dividerAbove = true

    trackDialog.Layout(m.parts, audioContent.getChildCount())

    m.audioMenu.content = audioContent
    m.audioMenu.jumpToItem = selectedAudioIndex
end sub

sub onAudioItemSelected()
    selectedItem = m.audioMenu.content.getChild(m.audioMenu.itemSelected)
    if not isValid(selectedItem) then return

    if selectedItem.action = "cancel"
        m.top.visible = false
        return
    end if

    m.top.audioStreamIndex = selectedItem.streamIndex
    m.top.audioStreamName = selectedItem.streamName
    m.top.visible = false
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' A picker that has been dismissed can still be holding focus, and swallowing
    ' keys there would leave the screen behind it unable to move
    if not m.top.visible then return false

    if key = KeyCode.BACK
        m.top.visible = false
        return true
    end if

    if key = KeyCode.LEFT or key = KeyCode.RIGHT or key = KeyCode.PLAY or key = KeyCode.FASTFORWRD or key = KeyCode.REWIND or key = KeyCode.REPLAY
        return true
    end if

    if key = KeyCode.UP or key = KeyCode.DOWN or key = KeyCode.OK
        if not m.audioMenu.isInFocusChain()
            m.audioMenu.setFocus(true)
        end if
        return true
    end if

    return false
end function

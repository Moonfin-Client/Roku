<?xml version="1.0" encoding="utf-8"?>
<component name="SubtitleSelector" extends="Group">
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#000000" opacity="0.95" />

        <!-- The panel is placed and sized around however many tracks there are -->
        <Group id="panel">
            <Poster id="panelBg" uri="pkg:/images/tracks/panel20.9.png" />
            <Poster id="panelBorder" uri="pkg:/images/tracks/panelborder20.9.png" blendColor="#FFFFFF" opacity="0.16" />
            <Label id="title" font="font:MediumBoldSystemFont" color="#FFFFFF" />
            <Rectangle id="titleRule" color="#FFFFFF" opacity="0.08" />
            <MarkupList
                id="subtitleMenu"
                itemComponentName="TrackListItem"
                drawFocusFeedback="false"
                vertFocusAnimationStyle="floatingFocus" />
        </Group>
    </children>

    <interface>
        <field id="subtitleTracks" type="array" onChange="subtitleTracksSet" />
        <field id="subtitleStream" type="node" />
        <!-- Only the player's picker offers an offset and an appearance, and only where it draws the
             subtitles itself -->
        <field id="showOffset" type="boolean" value="false" />
        <!-- How far the subtitles are moved, in milliseconds, which the Offset row shows -->
        <field id="offset" type="integer" value="0" />
        <field id="offsetRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="appearanceRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="downloadRequested" type="boolean" value="false" alwaysNotify="true" />
        <!-- primary lists the tracks, slot asks which of the two tracks to pick first, and
             secondary lists the tracks the second one can be -->
        <field id="mode" type="string" value="primary" />
        <!-- The Primary and Secondary rows' details. Setting it builds the slot list -->
        <field id="slotDetails" type="assocarray" onChange="buildSlots" />
        <field id="slotChosen" type="string" alwaysNotify="true" />
    </interface>
</component>

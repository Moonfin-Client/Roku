import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/trackDialog.bs"

' One row of a track picker, sized the way the other clients size theirs. Rows
' are flat and full width, told apart from their neighbours by the indicator
' rather than by a card around each one.
const INDICATOR_SIZE = 30
const INDICATOR_GAP = 18
const NAME_SIZE = 24
const INFO_SIZE = 20
const FLAG_SIZE = 16
const FLAG_PAD_X = 10
const FLAG_PAD_Y = 2
const FLAG_INK = "#FFFFFFD9"
const DIM_INK = "#FFFFFF8C"
const IDLE_INDICATOR = "#FFFFFF8C"
const FOCUS_OPACITY = 0.3
const CHEVRON_SIZE = 28
const CHEVRON_GAP = 10
const CHEVRON_INK = "#FFFFFFD9"
const CHEVRON_END_INK = "#FFFFFF33"

sub init()
    m.rowBg = m.top.findNode("rowBg")
    m.divider = m.top.findNode("divider")
    m.indicator = m.top.findNode("indicator")
    m.trackName = m.top.findNode("trackName")
    m.trackInfo = m.top.findNode("trackInfo")

    m.trackName.font.size = NAME_SIZE
    m.trackInfo.font.size = INFO_SIZE

    m.accent = formatSceneGraphColor(chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT), ColorPalette.HIGHLIGHT)
    m.rowBg.color = m.accent

    m.rowBg.width = trackDialog.PANEL_WIDTH
    m.rowBg.height = trackDialog.RowHeight()

    m.divider.width = trackDialog.PANEL_WIDTH - (trackDialog.ROW_PAD_X * 2)
    m.divider.height = 1
    m.divider.translation = [trackDialog.ROW_PAD_X, trackDialog.DIVIDER_MARGIN]

    m.indicator.width = INDICATOR_SIZE
    m.indicator.height = INDICATOR_SIZE

    m.moveLeft = m.top.findNode("moveLeft")
    m.moveRight = m.top.findNode("moveRight")
    for each chevron in [m.moveLeft, m.moveRight]
        chevron.width = CHEVRON_SIZE
        chevron.height = CHEVRON_SIZE
    end for

    m.flags = m.top.findNode("flags")
    m.flagFont = m.top.findNode("flagFont").font
    m.flagFont.size = FLAG_SIZE

    m.textLeft = trackDialog.ROW_PAD_X + INDICATOR_SIZE + INDICATOR_GAP
    textWidth = trackDialog.PANEL_WIDTH - m.textLeft - trackDialog.ROW_PAD_X
    m.trackName.maxWidth = textWidth
    m.trackInfo.maxWidth = textWidth
end sub

sub onContentChanged()
    content = m.top.itemContent
    if not isValid(content) then return

    selected = content.selected = true
    m.indicator.uri = selected ? "pkg:/images/tracks/checked.png" : "pkg:/images/tracks/unchecked.png"
    m.indicator.blendColor = selected ? m.accent : IDLE_INDICATOR

    m.trackName.text = content.title ?? ""
    m.trackName.color = content.dimmed = true ? DIM_INK : "#FFFFFF"

    m.trackInfo.text = content.description ?? ""
    m.trackInfo.visible = m.trackInfo.text <> ""

    m.divider.visible = content.dividerAbove = true
    buildFlags(content.flags)
    layoutChevrons(content)

    ' A row giving up part of itself to a divider lays its content out in what is
    ' left, so every row still takes the same stride down the list
    rowHeight = content.rowHeight > 0 ? content.rowHeight : trackDialog.RowHeight()
    top = m.divider.visible ? trackDialog.DividerBand() : 0
    band = rowHeight - top
    used = trackDialog.ROW_NAME_LINE
    if m.trackInfo.visible then used += trackDialog.ROW_INFO_LINE
    if m.flags.visible then used += trackDialog.ROW_FLAG_LINE
    contentTop = top + ((band - used) / 2)

    m.indicator.translation = [trackDialog.ROW_PAD_X, top + ((band - INDICATOR_SIZE) / 2)]
    m.trackName.translation = [m.textLeft, contentTop]
    m.trackInfo.translation = [m.textLeft, contentTop + trackDialog.ROW_NAME_LINE]

    flagTop = contentTop + trackDialog.ROW_NAME_LINE
    if m.trackInfo.visible then flagTop += trackDialog.ROW_INFO_LINE
    m.flags.translation = [m.textLeft, flagTop]
end sub

' The chevrons sit at the trailing edge, and the one pointing where a row cannot go is
' dimmed so the ends of the list read as ends
sub layoutChevrons(content as object)
    m.reorderable = content.reorderable = true
    if not m.reorderable
        m.moveLeft.visible = false
        m.moveRight.visible = false
        return
    end if

    rowHeight = content.rowHeight > 0 ? content.rowHeight : trackDialog.RowHeight()
    top = m.divider.visible ? trackDialog.DividerBand() : 0
    chevronTop = top + (((rowHeight - top) - CHEVRON_SIZE) / 2)

    right = trackDialog.PANEL_WIDTH - trackDialog.ROW_PAD_X - CHEVRON_SIZE
    m.moveRight.translation = [right, chevronTop]
    m.moveLeft.translation = [right - CHEVRON_SIZE - CHEVRON_GAP, chevronTop]

    m.moveLeft.blendColor = content.canMoveLeft = true ? CHEVRON_INK : CHEVRON_END_INK
    m.moveRight.blendColor = content.canMoveRight = true ? CHEVRON_INK : CHEVRON_END_INK

    ' The text stops short of them so a long name cannot run underneath
    room = m.moveLeft.translation[0] - CHEVRON_GAP - m.textLeft
    m.trackName.maxWidth = room
    m.trackInfo.maxWidth = room
end sub

' What the provider says about an upload, drawn as badges of its own. The fill
' goes down first so it sits behind, and is sized once the label it wraps has
' been measured
sub buildFlags(badgeText as dynamic)
    m.flags.removeChildrenIndex(m.flags.getChildCount(), 0)
    m.flags.visible = isValidAndNotEmpty(badgeText)
    if not m.flags.visible then return

    for each flag in badgeText
        badge = m.flags.createChild("Group")

        fill = badge.createChild("Poster")
        fill.uri = "pkg:/images/tracks/flag6.9.png"
        fill.blendColor = "#FFFFFF"
        fill.opacity = 0.16

        label = badge.createChild("Label")
        label.font = m.flagFont
        label.color = FLAG_INK
        label.text = UCase(flag)
        label.translation = [FLAG_PAD_X, FLAG_PAD_Y]

        rect = label.boundingRect()
        fill.width = rect.width + (FLAG_PAD_X * 2)
        fill.height = rect.height + (FLAG_PAD_Y * 2)
    end for
end sub

' The list keeps its cursor where it was after handing focus on, so the row only
' washes over while the list still holds it. A name too long for the row scrolls
' while it is the one being read, since that is the only way to see the end of it
sub onFocusChanged()
    focused = m.top.focusPercent > 0.5 and m.top.itemHasFocus

    m.rowBg.opacity = focused ? FOCUS_OPACITY : 0

    showMove = focused and m.reorderable = true
    m.moveLeft.visible = showMove
    m.moveRight.visible = showMove
    m.trackName.repeatCount = focused ? - 1 : 0
    m.trackInfo.repeatCount = focused ? - 1 : 0
end sub

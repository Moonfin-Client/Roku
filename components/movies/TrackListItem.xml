<?xml version="1.0" encoding="utf-8"?>
<component name="TrackListItem" extends="Group">
    <children>
        <Rectangle id="rowBg" color="#00A4DC" opacity="0" />
        <!-- Sets the actions at the foot of a picker apart from the tracks -->
        <Rectangle id="divider" color="#FFFFFF" opacity="0.08" visible="false" />
        <Poster id="indicator" />
        <ScrollingText id="trackName" font="font:MediumBoldSystemFont" color="#FFFFFF" repeatCount="0" />
        <ScrollingText id="trackInfo" font="font:SmallSystemFont" color="#FFFFFFB3" repeatCount="0" />
        <!-- Shown on the focused row of a picker that reorders, so the keys that move a row
             are on screen rather than something the viewer has to be told about -->
        <Poster id="moveLeft" uri="pkg:/images/icons/chevron-left.png" visible="false" />
        <Poster id="moveRight" uri="pkg:/images/icons/chevron-right.png" visible="false" />
        <LayoutGroup id="flags" layoutDirection="horiz" vertAlignment="center" itemSpacings="[6]" />
        <!-- Never shown, it just lends its size to the badges built at runtime -->
        <Label id="flagFont" font="font:SmallestBoldSystemFont" visible="false" />
    </children>

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>
</component>

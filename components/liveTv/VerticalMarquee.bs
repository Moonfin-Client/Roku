import "pkg:/source/utils/misc.bs"

sub init()
    m.viewport = m.top.findNode("viewport")
    m.text = m.top.findNode("text")
    m.pauseTimer = m.top.findNode("pauseTimer")
    m.holdTimer = m.top.findNode("holdTimer")
    m.scroll = m.top.findNode("scroll")
    m.scrollInterp = m.top.findNode("scrollInterp")

    m.pauseTimer.observeField("fire", "startScroll")
    m.holdTimer.observeField("fire", "restart")
    m.scroll.observeField("state", "onScrollState")
    m.maxOffset = 0
end sub

sub onModelChanged()
    stopCycle()
    model = m.top.model
    if not isValid(model) then return

    m.text.font = "font:SmallestSystemFont"
    m.text.font.size = model.fontSize
    m.text.color = model.color
    m.text.width = model.width

    ' A wrapped line sits further below the one above it than a lone line is tall, so both are
    ' measured and the viewport holds exactly the lines asked for
    m.text.text = "Ag"
    lineHeight = m.text.boundingRect().height
    m.text.text = "Ag" + chr(10) + "Ag"
    linePitch = m.text.boundingRect().height - lineHeight
    m.text.text = model.text ?? ""
    viewportHeight = lineHeight + linePitch * (model.lines - 1)

    m.viewport.clippingRect = [0, 0, model.width, viewportHeight]
    m.top.viewportHeight = viewportHeight
    m.text.translation = [0, 0]

    textHeight = m.text.boundingRect().height
    m.maxOffset = textHeight - viewportHeight
    if m.maxOffset <= 0.5
        m.top.viewportHeight = textHeight
        return
    end if

    m.pace = model.msPerPixel / 1000
    m.holdSeconds = viewportHeight * m.pace
    m.pauseTimer.duration = model.pauseMs / 1000
    m.pauseTimer.control = "start"
end sub

sub stopCycle()
    m.pauseTimer.control = "stop"
    m.holdTimer.control = "stop"
    m.scroll.control = "stop"
end sub

sub startScroll()
    m.scroll.duration = m.maxOffset * m.pace
    m.scrollInterp.keyValue = [[0, 0], [0, -m.maxOffset]]
    m.scroll.control = "start"
end sub

sub onScrollState()
    if m.scroll.state <> "stopped" or m.maxOffset <= 0.5 then return
    if m.text.translation[1] > -m.maxOffset + 0.5 then return
    m.holdTimer.duration = m.holdSeconds
    m.holdTimer.control = "start"
end sub

sub restart()
    m.text.translation = [0, 0]
    m.pauseTimer.control = "start"
end sub

<?xml version="1.0" encoding="utf-8"?>
<!-- The Live TV guide: genre filters, a hero previewing the focused program, the window bar, and
     a grid of channels against time. Focus inside the grid is the guide's own, resolved against the
     selection's clock time rather than by geometry. -->
<component name="LiveTvGuide" extends="JFScreen">
  <children>
    <Rectangle id="page" width="1920" height="1080" color="#000000FF" />

    <Group id="chipRail" translation="[50, 12]" />

    <LiveTvGuideHero id="hero" translation="[35, 59]" />

    <Group id="windowBar" translation="[47, 271]">
      <Label id="windowLabel" color="#FFFFFFCC" vertAlign="center" height="40" />
    </Group>

    <Group id="guideSection" translation="[35, 314]">
      <Group id="ruler" />
      <Rectangle id="rulerDivider" translation="[0, 34]" width="1850" height="1" color="#8EC8F054" />
      <Group id="gridViewport" translation="[0, 35]" clippingRect="[0, 0, 1850, 708]">
        <Group id="rows" />
      </Group>
      <Spinner id="spinner" visible="false" />
      <Label id="stateMessage" color="#FFFFFFB3" horizAlign="center" vertAlign="center" width="1850" height="708" translation="[0, 35]" visible="false" />
    </Group>

    <Group id="numberOverlay" visible="false">
      <Poster id="numberFill" uri="pkg:/images/livetv/fill18.9.png" blendColor="#000000D9" />
      <Label id="numberText" color="#FFFFFF" translation="[36, 18]" />
    </Group>

    <Group id="toast" visible="false">
      <Poster id="toastFill" uri="pkg:/images/livetv/fill12.9.png" blendColor="#1E1E28E6" />
      <Label id="toastText" color="#FFFFFF" translation="[28, 14]" />
    </Group>

    <Timer id="clockTimer" duration="15" repeat="true" />
    <Timer id="reanchorTimer" repeat="false" />
    <Timer id="numberTimer" duration="1.5" repeat="false" />
    <Timer id="toastTimer" duration="3" repeat="false" />
    <Timer id="artworkTimer" duration="0.5" repeat="false" />
    <Animation id="scrollAnimation" duration="0.2" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="rows.translation" />
    </Animation>
  </children>
</component>

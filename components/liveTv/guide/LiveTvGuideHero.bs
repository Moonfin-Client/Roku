import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/misc.bs"

const HERO_WIDTH = 1850
const HERO_HEIGHT = 209
const HERO_PLATE_WIDTH = 157
const HERO_PAD = 17
const HERO_PAD_WITH_PLATE = 12

sub init()
    m.plate = m.top.findNode("plate")
    m.plateFill = m.top.findNode("plateFill")
    m.logo = m.top.findNode("logo")
    m.artworkMask = m.top.findNode("artworkMask")
    m.artwork = m.top.findNode("artwork")
    m.textBlock = m.top.findNode("textBlock")
    m.channelLine = m.top.findNode("channelLine")
    m.channelTitle = m.top.findNode("channelTitle")
    m.badge = m.top.findNode("badge")
    m.badgeFill = m.top.findNode("badgeFill")
    m.badgeBorder = m.top.findNode("badgeBorder")
    m.badgeLabel = m.top.findNode("badgeLabel")
    m.meta = m.top.findNode("meta")
    m.programLine = m.top.findNode("programLine")
    m.programTitle = m.top.findNode("programTitle")
    m.programSubtitle = m.top.findNode("programSubtitle")
    m.titleLarge = m.top.findNode("titleLarge")
    m.metaLine = m.top.findNode("metaLine")
    m.synopsis = m.top.findNode("synopsis")

    liveTvGuide.SetFont(m.channelTitle, 23, true)
    liveTvGuide.SetFont(m.badgeLabel, 15, true)
    liveTvGuide.SetFont(m.meta, 20, false)
    liveTvGuide.SetFont(m.programTitle, 35, true)
    liveTvGuide.SetFont(m.programSubtitle, 29, false)
    liveTvGuide.SetFont(m.titleLarge, 32, false)
    liveTvGuide.SetFont(m.metaLine, 20, false)

    m.logo.observeField("loadStatus", "onLogoStatus")
    m.failedUrl = ""
end sub

' A logo that wont load leaves the plate standing, so the text doesnt jump
sub onLogoStatus()
    if m.logo.loadStatus = "failed"
        m.failedUrl = m.logo.uri
        m.logo.visible = false
    end if
end sub

function oneDecimal(value as dynamic) as string
    tenths = Int(value * 10 + 0.5)
    return Int(tenths / 10).toStr() + "." + (tenths mod 10).toStr()
end function

sub render()
    model = m.top.model
    if not isValid(model) then return

    plateUrl = model.programImageUrl ?? ""
    usingArtwork = plateUrl <> ""
    if not usingArtwork then plateUrl = model.channelLogoUrl ?? ""
    showPlate = plateUrl <> ""

    m.plate.visible = showPlate
    if showPlate
        m.plateFill.visible = not usingArtwork
        m.artworkMask.visible = usingArtwork
        if usingArtwork
            m.logo.visible = false
            if m.artwork.uri <> plateUrl then m.artwork.uri = plateUrl
        else
            if m.logo.uri <> plateUrl
                m.failedUrl = ""
                m.logo.uri = plateUrl
            end if
            m.logo.visible = m.failedUrl <> plateUrl
        end if
    end if

    ' Highest priority first, so whatever the line cant fit is the least important thing on it
    parts = []
    if model.isLive = true then parts.push(tr("Live"))
    if isValidAndNotEmpty(model.timeLabel) then parts.push(model.timeLabel)
    if isValidAndNotEmpty(model.genreLabel) then parts.push(tr(model.genreLabel))
    if isValidAndNotEmpty(model.officialRating) then parts.push(model.officialRating)
    if isValid(model.communityRating) then parts.push(oneDecimal(model.communityRating))
    meta = parts.join("  ·  ")

    textLeft = HERO_PAD
    if showPlate then textLeft = HERO_PLATE_WIDTH + HERO_PAD_WITH_PLATE
    width = HERO_WIDTH - textLeft - HERO_PAD

    hasChannelPreview = isValidAndNotEmpty(model.channelLogoUrl) or isValid(model.programTitle)
    m.channelLine.visible = hasChannelPreview
    m.programLine.visible = false
    m.titleLarge.visible = not hasChannelPreview
    m.metaLine.visible = false

    y = 0
    if hasChannelPreview
        y = layoutChannelLine(model, meta, width)
        if isValidAndNotEmpty(model.programTitle)
            y += 3
            m.programLine.visible = true
            m.programLine.translation = [0, y]
            y += layoutProgramLine(model, width)
        end if
    else
        m.titleLarge.text = model.title ?? ""
        m.titleLarge.width = width
        m.titleLarge.translation = [0, 0]
        y = m.titleLarge.boundingRect().height
        if meta <> ""
            m.metaLine.visible = true
            m.metaLine.text = meta
            m.metaLine.width = width
            m.metaLine.translation = [0, y + 6]
            y += 6 + m.metaLine.boundingRect().height
        end if
    end if

    synopsis = model.synopsis ?? ""
    m.synopsis.visible = synopsis <> ""
    if synopsis <> ""
        y += 6
        m.synopsis.translation = [0, y]
        m.synopsis.model = {
            text: synopsis,
            width: width,
            lines: 3,
            fontSize: 23,
            color: "#FFFFFFB8",
            msPerPixel: GUIDE_DESCRIPTION_MS_PER_PIXEL,
            pauseMs: 1600
        }
        y += m.synopsis.viewportHeight
    end if

    ' The block sits centered in the band whatever it holds
    m.textBlock.translation = [textLeft, Int((HERO_HEIGHT - y) / 2)]
end sub

' The title, the premiere or repeat badge and the metadata on one line, the title and the
' metadata giving up room in proportion when it runs out
function layoutChannelLine(model as object, meta as string, width as integer) as integer
    m.channelTitle.width = 0
    m.channelTitle.text = model.title ?? ""
    titleNatural = m.channelTitle.boundingRect().width

    badgeWidth = 0
    badgeText = model.badgeLabel ?? ""
    m.badge.visible = badgeText <> ""
    if badgeText <> ""
        m.badgeLabel.text = UCase(badgeText)
        labelRect = m.badgeLabel.boundingRect()
        badgeWidth = labelRect.width + 18
        badgeHeight = labelRect.height + 6
        for each layer in [m.badgeFill, m.badgeBorder]
            layer.width = badgeWidth
            layer.height = badgeHeight
        end for
    end if

    m.meta.width = 0
    m.meta.text = meta
    m.meta.visible = meta <> ""
    metaNatural = 0
    if meta <> "" then metaNatural = m.meta.boundingRect().width

    fixed = 0
    if badgeWidth > 0 then fixed += 12 + badgeWidth
    if metaNatural > 0 then fixed += 14
    titleWidth = titleNatural
    metaWidth = metaNatural
    overflow = titleNatural + metaNatural + fixed - width
    if overflow > 0 and titleNatural + metaNatural > 0
        titleWidth = titleNatural - overflow * titleNatural / (titleNatural + metaNatural)
        metaWidth = metaNatural - overflow * metaNatural / (titleNatural + metaNatural)
    end if

    m.channelTitle.width = titleWidth
    titleHeight = m.channelTitle.boundingRect().height
    lineHeight = titleHeight
    if badgeWidth > 0 and m.badgeFill.height > lineHeight then lineHeight = m.badgeFill.height

    m.channelTitle.translation = [0, (lineHeight - titleHeight) / 2]
    x = titleWidth
    if badgeWidth > 0
        x += 12
        m.badge.translation = [x, (lineHeight - m.badgeFill.height) / 2]
        x += badgeWidth
    end if
    if metaNatural > 0
        x += 14
        m.meta.width = metaWidth
        m.meta.translation = [x, (lineHeight - m.meta.boundingRect().height) / 2]
    end if
    return lineHeight
end function

' The program name with its episode title and numbering after it in a lighter weight. What runs
' out of room is cut from the end, the subtitle first.
function layoutProgramLine(model as object, width as integer) as integer
    m.programTitle.width = 0
    m.programTitle.text = model.programTitle
    titleNatural = m.programTitle.boundingRect().width
    titleWidth = titleNatural
    if titleWidth > width then titleWidth = width
    m.programTitle.width = titleWidth
    titleHeight = m.programTitle.boundingRect().height

    subtitle = model.programSubtitle ?? ""
    room = width - titleWidth
    m.programSubtitle.visible = subtitle <> "" and room > 30
    if m.programSubtitle.visible
        m.programSubtitle.width = 0
        m.programSubtitle.text = subtitle
        if m.programSubtitle.boundingRect().width > room then m.programSubtitle.width = room
        subHeight = m.programSubtitle.boundingRect().height
        ' Set on the title's baseline, the way the two read as one line
        m.programSubtitle.translation = [titleWidth, titleHeight - subHeight - (35 - 29) * 0.2]
    end if
    return titleHeight
end function

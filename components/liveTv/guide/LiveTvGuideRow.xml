<?xml version="1.0" encoding="utf-8"?>
<!-- One channel's timeline: the channel cell, then its programs laid out against the window. The
     guide owns focus and navigation, the row only draws what it is handed. -->
<component name="LiveTvGuideRow" extends="Group">
  <children>
    <Group id="channelCell" translation="[9, 0]">
      <Poster id="channelFill" uri="pkg:/images/livetv/fill15.9.png" width="278" height="87" blendColor="#353940F0" />
      <Poster id="channelBorder" uri="pkg:/images/livetv/stroke15w1_5.9.png" width="278" height="87" blendColor="#00A4DCB3" visible="false" />
      <Poster id="logo" translation="[12, 0]" width="91" height="87" loadDisplayMode="scaleToFit" />
      <Poster id="logoFallback" uri="pkg:/images/livetv/tv.png" translation="[46, 32]" width="23" height="23" blendColor="#FFFFFF80" visible="false" />
      <Group id="channelText" translation="[112, 0]">
        <Poster id="favorite" uri="pkg:/images/livetv/favorite.png" width="15" height="15" blendColor="#F44336" visible="false" />
        <Poster id="numberChip" uri="pkg:/images/livetv/fill10.9.png" blendColor="#FFFFFF1F" visible="false" />
        <Label id="numberLabel" color="#FFFFFFD9" visible="false" />
        <Label id="channelName" color="#FFFFFF" horizAlign="right" width="154" />
        <ScrollingText id="channelNameScroll" color="#FFFFFF" horizAlign="right" maxWidth="154" repeatCount="-1" visible="false" />
      </Group>
    </Group>
    <Rectangle id="divider" translation="[296, 0]" width="1" height="87" color="#8EC8F054" />
    <Group id="programs" translation="[297, 0]" />
    <Label id="measure" visible="false" />
  </children>
  <interface>
    <!-- { channel, cells, windowStart, pxPerSec, logoUri } -->
    <field id="model" type="assocarray" onChange="render" />
    <field id="focusCell" type="integer" value="-1" onChange="applyFocus" />
    <field id="focusChannel" type="boolean" value="false" onChange="applyFocus" />
    <!-- The clock the cells read their live and ended state from -->
    <field id="now" type="integer" onChange="applyClock" />
  </interface>
</component>

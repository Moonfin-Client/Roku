<?xml version="1.0" encoding="utf-8"?>
<!-- The guide's popups over a scrim: a program's details and actions, the channel sort and the
     date picker. Every key stays inside until it closes. -->
<component name="LiveTvGuideDialog" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" />
    <Group id="box">
      <Poster id="surface" uri="pkg:/images/livetv/fill42.9.png" blendColor="#1A1A1AFF" />
      <Label id="title" color="#FFFFFF" wrap="true" />
      <Group id="body" />
      <Group id="actions" />
    </Group>
  </children>
  <interface>
    <!-- program: { type, title, time, episode, overview, chips, buttons: [{ id, label, danger, isDefault }] }
         recording: { type, title, subtitle, overview, meta, buttons }
         confirm: { type, title, text, buttons }
         sort or date: { type, title, options: [{ label, selected }] }
         Any of them can carry width, surfaceColor, titleGap and dangerColor -->
    <field id="model" type="assocarray" onChange="build" />
    <!-- { id } for a button, { option } for a list row -->
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <!-- Set while an action runs, so a second OK cant send it again -->
    <field id="busy" type="boolean" value="false" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- The quick channel changer over live playback. The centered card is the selection, the strip
     wraps at both ends, and holding left or right runs through the lineup. -->
<component name="ChannelCarousel" extends="Group">
  <children>
    <Group id="overlay" translation="[0, 1080]">
      <Poster id="shade" uri="pkg:/images/livetv/carousel_shade.png" width="1920" height="473" />
      <Group id="header" translation="[71, 57]">
        <Label id="headerTitle" color="#FFFFFF" width="1778" />
        <Label id="headerMeta" color="#FFFFFFB3" width="1778" translation="[0, 37]" />
        <VerticalMarquee id="headerOverview" translation="[0, 67]" />
      </Group>
      <Group id="strip" translation="[48, 206]" clippingRect="[0, 0, 1824, 219]">
        <Group id="track" />
      </Group>
    </Group>
    <Group id="notice" visible="false">
      <Poster id="noticeFill" uri="pkg:/images/livetv/fill12.9.png" blendColor="#1E1E28E6" />
      <Label id="noticeText" color="#FFFFFF" translation="[28, 14]" />
    </Group>
    <Animation id="slide" duration="0.18" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="slideInterp" key="[0.0, 1.0]" fieldToInterp="overlay.translation" />
    </Animation>
    <Animation id="trackMove" duration="0.11" repeat="false" easeFunction="linear">
      <Vector2DFieldInterpolator id="trackInterp" key="[0.0, 1.0]" fieldToInterp="track.translation" />
    </Animation>
    <Timer id="holdStart" duration="0.35" repeat="false" />
    <Timer id="holdRepeat" duration="0.11" repeat="true" />
    <Timer id="settle" duration="0.15" repeat="false" />
    <Timer id="inactivity" duration="120" repeat="false" />
    <Timer id="noticeTimer" duration="4" repeat="false" />
    <Timer id="exitTimer" duration="0.14" repeat="false" />
  </children>
  <interface>
    <!-- { lineup, currentChannelId, sortBy } -->
    <field id="model" type="assocarray" onChange="onModel" />
    <!-- Programs the player kept warm, channel id to its programs -->
    <field id="programs" type="assocarray" />
    <field id="currentChannelId" type="string" onChange="onCurrentChannelChanged" />
    <field id="selectionRevision" type="integer" onChange="onCurrentChannelChanged" />
    <field id="notice" type="string" alwaysNotify="true" onChange="showNotice" />
    <field id="selected" type="assocarray" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <field id="showControls" type="boolean" alwaysNotify="true" />
  </interface>
</component>

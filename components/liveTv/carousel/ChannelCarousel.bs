import "pkg:/source/api/baserequest.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/liveTvGuide.bs"
import "pkg:/source/utils/misc.bs"

const OVERLAY_HEIGHT = 473
const STRIP_WIDTH = 1824
const CARD_HEIGHT = 219
' Landing on a channel with nothing cached fetches straight away, at most this often
const BLIND_LOAD_THROTTLE_MS = 500

sub init()
    m.overlay = m.top.findNode("overlay")
    m.headerTitle = m.top.findNode("headerTitle")
    m.headerMeta = m.top.findNode("headerMeta")
    m.headerOverview = m.top.findNode("headerOverview")
    m.track = m.top.findNode("track")
    m.notice = m.top.findNode("notice")
    m.noticeFill = m.top.findNode("noticeFill")
    m.noticeText = m.top.findNode("noticeText")
    m.slide = m.top.findNode("slide")
    m.slideInterp = m.top.findNode("slideInterp")
    m.trackMove = m.top.findNode("trackMove")
    m.trackInterp = m.top.findNode("trackInterp")

    liveTvGuide.SetFont(m.headerTitle, 29, true)
    liveTvGuide.SetFont(m.headerMeta, 20, false)
    liveTvGuide.SetFont(m.noticeText, 20, false)

    ' The layout is worked out in television canvas points, then scaled up to the screen
    layout = liveTvGuide.CarouselLayoutFor(STRIP_WIDTH / GUIDE_TV_CANVAS_SCALE)
    m.pitch = layout.pitch * GUIDE_TV_CANVAS_SCALE
    m.cardWidth = layout.width * GUIDE_TV_CANVAS_SCALE
    m.visibleCards = layout.count
    m.leading = (STRIP_WIDTH - m.cardWidth) / 2
    ' The cards drawn either side of the centered one, a couple past what shows so a move never
    ' reveals an empty slot
    m.renderRadius = Int((m.visibleCards + 1) / 2) + 2

    m.top.findNode("holdStart").observeField("fire", "onHoldStart")
    m.top.findNode("holdRepeat").observeField("fire", "onHoldRepeat")
    m.top.findNode("settle").observeField("fire", "onSettled")
    m.top.findNode("inactivity").observeField("fire", "dismiss")
    m.top.findNode("noticeTimer").observeField("fire", "hideNotice")
    m.top.findNode("exitTimer").observeField("fire", "onExited")

    m.channels = []
    m.rawIndex = 0
    m.holdDirection = 0
    m.cards = {}
    m.freeCards = []
    m.programs = {}
    m.loading = false
    m.loadAgain = false
    m.lastBlindMs = -100000
    m.clock = CreateObject("roTimespan")
    m.dismissed = false
    m.tasks = []
    m.measure = CreateObject("roSGNode", "Label")
    liveTvGuide.SetFont(m.measure, 20, false)
    m.widths = {}
end sub

sub onModel()
    model = m.top.model
    m.channels = liveTvGuide.SortChannels(model.lineup ?? [], liveTvGuide.NormalizeSort(model.sortBy))
    seeded = m.top.programs
    if isValid(seeded)
        for each id in seeded
            m.programs[id] = seeded[id]
        end for
    end if

    m.rawIndex = 0
    for i = 0 to m.channels.count() - 1
        if m.channels[i].Id = model.currentChannelId then m.rawIndex = i
    end for
    m.syncedChannelId = model.currentChannelId
    m.syncedRevision = m.top.selectionRevision

    m.track.translation = [-m.rawIndex * m.pitch, 0]
    renderCards()
    updateHeader()
    scheduleVisibleLoad()
    resetInactivity()

    m.slideInterp.keyValue = [[0, 1080], [0, 1080 - OVERLAY_HEIGHT]]
    m.slide.control = "start"
end sub

' ------------------------------------------------------------------------------------------------
' Data
' ------------------------------------------------------------------------------------------------

function centeredIndex() as integer
    return liveTvGuide.ChannelIndexFor(m.rawIndex, m.channels.count())
end function

function centeredChannel() as dynamic
    if m.channels.count() = 0 then return invalid
    return m.channels[centeredIndex()]
end function

function currentProgram(channelId as string) as dynamic
    return liveTvGuide.ProgramAiringAt(m.programs[channelId], liveTvGuide.NowSeconds())
end function

sub scheduleVisibleLoad()
    settle = m.top.findNode("settle")
    channel = centeredChannel()
    if isValid(channel) and not m.programs.DoesExist(channel.Id)
        if m.clock.TotalMilliseconds() - m.lastBlindMs >= BLIND_LOAD_THROTTLE_MS
            m.lastBlindMs = m.clock.TotalMilliseconds()
            loadVisible()
            return
        end if
    end if
    m.pendingLoad = true
    settle.control = "stop"
    settle.control = "start"
end sub

' Cached cards stay when a newly visible channel cant be loaded
sub loadVisible()
    if m.loading
        m.loadAgain = true
        return
    end if
    channel = centeredChannel()
    if not isValid(channel) then return
    missing = []
    for each id in liveTvGuide.CarouselNeighborhood(m.channels, channel.Id, m.visibleCards)
        if not m.programs.DoesExist(id) then missing.push(id)
    end for
    if missing.count() = 0 then return

    m.loading = true
    start = liveTvGuide.LeftEdge(liveTvGuide.NowSeconds())
    task = CreateObject("roSGNode", "LiveTvRequestTask")
    task.request = { kind: "programs", ids: missing, from: start, upto: start + liveTvGuide.DefaultWindow() }
    task.observeField("response", "onProgramsLoaded")
    task.control = "RUN"
    m.tasks.push(task)
end sub

sub onProgramsLoaded(event as object)
    task = event.getRoSGNode()
    task.unobserveField("response")
    m.tasks = []
    m.loading = false
    response = event.getData()
    if response.ok
        for each id in response.ids
            m.programs[id] = []
        end for
        for each program in response.programs
            id = program.LookupCI("ChannelId")
            if not m.programs.DoesExist(id) then m.programs[id] = []
            list = m.programs[id]
            list.push(program)
            m.programs[id] = list
        end for
        refreshCards()
        if m.holdDirection = 0 then updateHeader()
    end if
    if m.loadAgain
        m.loadAgain = false
        loadVisible()
    end if
end sub

sub onSettled()
    ' A held press settles before the header or data follow it
    if m.holdDirection <> 0
        m.top.findNode("settle").control = "start"
        return
    end if
    updateHeader()
    if m.pendingLoad = true
        m.pendingLoad = false
        loadVisible()
    end if
end sub

' ------------------------------------------------------------------------------------------------
' The header
' ------------------------------------------------------------------------------------------------

function timeRange(program as object) as string
    return liveTvGuide.ClockTime(program.startSec) + " - " + liveTvGuide.ClockTime(program.endSec)
end function

' It keeps the height of all its lines whether the centered program fills them or not, so the strip
' never shifts as the selection moves
sub updateHeader()
    channel = centeredChannel()
    if not isValid(channel)
        clearHeader()
        return
    end if
    program = currentProgram(channel.Id)

    suffix = ""
    name = channel.Name ?? ""
    parts = []
    overview = ""
    if isValid(program)
        name = program.LookupCI("Name") ?? name
        label = liveTvGuide.SeasonEpisodeLabel(program)
        if label <> "" then suffix = " (" + label + ")"
        ' Some sources repeat the program name as the episode title, and twice reads as a glitch
        episodeTitle = liveTvGuide.EpisodeTitleOf(program)
        if episodeTitle <> "" and episodeTitle <> program.LookupCI("Name") then name += " - " + episodeTitle
        ' The channel number and call sign are on the centered card already
        parts.push(timeRange(program))
        rating = program.LookupCI("OfficialRating")
        if isString(rating) and rating.Trim() <> "" then parts.push(rating.Trim())
        parts.append(liveTvGuide.CategoryLabels(program))
        overview = program.LookupCI("Overview") ?? ""
    end if

    m.headerTitle.text = name + suffix
    m.headerMeta.text = parts.join(GUIDE_META_SEPARATOR)
    m.headerOverview.visible = overview <> ""
    if overview <> ""
        m.headerOverview.model = { text: overview, width: 1778, lines: 2, fontSize: 26, color: "#FFFFFF99", msPerPixel: GUIDE_DESCRIPTION_MS_PER_PIXEL, pauseMs: 1600 }
    end if
end sub

sub clearHeader()
    m.headerTitle.text = ""
    m.headerMeta.text = ""
    m.headerOverview.visible = false
end sub

' ------------------------------------------------------------------------------------------------
' Cards
' ------------------------------------------------------------------------------------------------

' A hint of the program's genre over the dark base, so the card carries a little color without
' competing with its own text
function cardBackground(genre as dynamic, centered as boolean) as string
    tint = [37, 37, 37]
    if isValid(genre) then tint = [Val(Mid(genre.hex, 1, 2), 16), Val(Mid(genre.hex, 3, 2), 16), Val(Mid(genre.hex, 5, 2), 16)]
    alpha = 0.14
    if centered then alpha = 0.22
    hex = ""
    for each value in tint
        mixed = cint(value * alpha + 26 * (1 - alpha))
        byte = StrI(mixed, 16)
        if Len(byte) < 2 then byte = "0" + byte
        hex += UCase(byte)
    end for
    opacity = 0.74
    if centered then opacity = 0.88
    return liveTvGuide.Tint(hex, opacity)
end function

function createCard() as object
    group = CreateObject("roSGNode", "Group")
    fill = addPoster(group, "pkg:/images/livetv/fill15.9.png", m.cardWidth, CARD_HEIGHT)
    border = addPoster(group, "pkg:/images/livetv/stroke15w3.9.png", m.cardWidth, CARD_HEIGHT)
    border.blendColor = "#" + GUIDE_ACCENT
    bar = addPoster(group, "pkg:/images/livetv/genrebar6r15.9.png", 6, CARD_HEIGHT)

    favorite = addPoster(group, "pkg:/images/livetv/favorite.png", 25.5, 25.5)
    favorite.blendColor = "#F44336"
    number = CreateObject("roSGNode", "Label")
    liveTvGuide.SetFont(number, 32, true)
    number.color = "#FFFFFF"
    group.appendChild(number)
    name = CreateObject("roSGNode", "Label")
    liveTvGuide.SetFont(name, 23, true)
    name.color = "#FFFFFF"
    group.appendChild(name)
    timerIcon = addPoster(group, "pkg:/images/livetv/record.png", 25.5, 25.5)
    timerIcon.blendColor = "#E0685C"
    logo = addPoster(group, "", 90, 61)
    logo.loadDisplayMode = "scaleToFit"

    title = CreateObject("roSGNode", "Label")
    liveTvGuide.SetFont(title, 23, false)
    title.color = "#FFFFFF"
    title.wrap = true
    title.maxLines = 2
    group.appendChild(title)
    placeholder = addPoster(group, "pkg:/images/livetv/fill6.9.png", m.cardWidth - 39, 14.5)
    placeholder.blendColor = "#FFFFFF1F"
    placeholderShort = addPoster(group, "pkg:/images/livetv/fill6.9.png", (m.cardWidth - 39) / 2, 11.5)
    placeholderShort.blendColor = "#FFFFFF1F"
    meta = CreateObject("roSGNode", "Label")
    liveTvGuide.SetFont(meta, 20, false)
    meta.color = "#FFFFFF99"
    group.appendChild(meta)

    track = addPoster(group, "pkg:/images/livetv/fill3.9.png", m.cardWidth - 29, 6)
    track.blendColor = "#404040"
    progress = addPoster(group, "pkg:/images/livetv/fill3.9.png", 0, 6)
    progress.blendColor = "#" + GUIDE_ACCENT

    m.track.appendChild(group)
    return { group: group, fill: fill, border: border, bar: bar, favorite: favorite, number: number, name: name, timerIcon: timerIcon, logo: logo, title: title, placeholder: placeholder, placeholderShort: placeholderShort, meta: meta, track: track, progress: progress }
end function

function addPoster(parent as object, uri as string, width as float, height as float) as object
    poster = CreateObject("roSGNode", "Poster")
    poster.uri = uri
    poster.width = width
    poster.height = height
    parent.appendChild(poster)
    return poster
end function

' One channel in the strip. The program block mirrors the guide cell, a title over a muted
' metadata line, with room for a second title line since the card is much taller than a row.
sub drawCard(visual as object, channel as object, centered as boolean)
    now = liveTvGuide.NowSeconds()
    program = currentProgram(channel.Id)
    genre = liveTvGuide.GenreFor(program)
    visual.fill.blendColor = cardBackground(genre, centered)
    visual.border.visible = centered
    tint = GUIDE_ACCENT
    if isValid(genre) then tint = genre.hex
    visual.bar.blendColor = "#" + tint

    ' The header row: favorite, number, name, the recording mark, and the logo held against the
    ' trailing edge
    x = 23
    headerTop = 16
    visual.favorite.visible = liveTvGuide.IsFavoriteChannel(channel)
    if visual.favorite.visible
        visual.favorite.translation = [x, headerTop + (61 - 25.5) / 2]
        x += 25.5 + 6
    end if
    numberText = channel.LookupCI("ChannelNumber") ?? ""
    visual.number.text = numberText
    visual.number.visible = numberText <> ""
    if numberText <> ""
        rect = visual.number.boundingRect()
        visual.number.translation = [x, headerTop + (61 - rect.height) / 2]
        x += rect.width + 9
    end if

    edge = m.cardWidth - 16
    logoTag = chainLookupReturn(channel, "ImageTags.Primary", "")
    visual.logo.visible = logoTag <> ""
    if logoTag <> ""
        uri = buildURL(Substitute("/Items/{0}/Images/Primary", channel.Id), { maxHeight: 80, tag: logoTag }) ?? ""
        if visual.logo.uri <> uri then visual.logo.uri = uri
        visual.logo.translation = [edge - 90, headerTop]
        edge -= 90 + 12
    end if
    timer = liveTvGuide.HasTimer(program) or liveTvGuide.HasSeriesTimer(program)
    visual.timerIcon.visible = timer
    if timer
        edge -= 25.5
        visual.timerIcon.translation = [edge, headerTop + (61 - 25.5) / 2]
        edge -= 4
    end if
    visual.name.text = channel.Name ?? ""
    visual.name.width = edge - x
    visual.name.translation = [x, headerTop + (61 - visual.name.boundingRect().height) / 2]

    contentTop = headerTop + 61 + 11.5
    contentWidth = m.cardWidth - 39
    loadingProgram = not isValid(program) and not m.programs.DoesExist(channel.Id)
    visual.title.visible = isValid(program)
    visual.placeholder.visible = loadingProgram
    visual.placeholderShort.visible = loadingProgram
    y = contentTop
    if isValid(program)
        visual.title.text = program.LookupCI("Name") ?? ""
        visual.title.width = contentWidth
        visual.title.translation = [23, y]
        y += visual.title.boundingRect().height
    else if loadingProgram
        visual.placeholder.translation = [23, y]
        visual.placeholderShort.translation = [23, y + 14.5 + 8.5]
    end if

    items = []
    if isValid(program)
        items.push(timeRange(program))
        rating = program.LookupCI("OfficialRating")
        if isString(rating) and rating.Trim() <> "" then items.push(rating.Trim())
        items.append(liveTvGuide.CategoryLabels(program))
    end if
    fitted = liveTvGuide.FittingItems(items, contentWidth, m.measure, m.widths)
    visual.meta.visible = fitted.count() > 0
    visual.meta.text = fitted.join(GUIDE_META_SEPARATOR)
    visual.meta.width = contentWidth
    visual.meta.translation = [23, y]

    ' Reads as a seekbar rather than card structure, inset from the genre bar and both edges
    visual.track.visible = isValid(program)
    visual.progress.visible = isValid(program)
    if isValid(program)
        visual.track.translation = [17.5, CARD_HEIGHT - 11.5 - 6]
        visual.progress.translation = [17.5, CARD_HEIGHT - 11.5 - 6]
        progress = liveTvGuide.ProgressAt(program, now)
        visual.progress.width = (m.cardWidth - 29) * progress
        visual.progress.visible = progress > 0.02
    end if
end sub

' Draws the cards around the centered one at their place in the endless strip. A lineup that fits
' is drawn at its real count, centered, and still wraps.
sub renderCards()
    count = m.channels.count()
    if count = 0 then return

    wanted = {}
    if count <= m.visibleCards
        middle = Int(count / 2)
        for i = 0 to count - 1
            wanted[(m.rawIndex + i - middle).toStr()] = true
        end for
    else
        for raw = m.rawIndex - m.renderRadius to m.rawIndex + m.renderRadius
            wanted[raw.toStr()] = true
        end for
    end if

    kept = {}
    for each key in m.cards
        if wanted.DoesExist(key)
            kept[key] = m.cards[key]
        else
            m.cards[key].group.visible = false
            m.freeCards.push(m.cards[key])
        end if
    end for
    m.cards = kept

    for each key in wanted
        raw = key.toInt()
        visual = m.cards[key]
        if not isValid(visual)
            if m.freeCards.count() > 0 then visual = m.freeCards.pop() else visual = createCard()
            m.cards[key] = visual
        end if
        visual.group.visible = true
        visual.group.translation = [m.leading + raw * m.pitch, 0]
        drawCard(visual, m.channels[liveTvGuide.ChannelIndexFor(raw, count)], raw = m.rawIndex)
    end for
end sub

sub refreshCards()
    count = m.channels.count()
    for each key in m.cards
        raw = key.toInt()
        drawCard(m.cards[key], m.channels[liveTvGuide.ChannelIndexFor(raw, count)], raw = m.rawIndex)
    end for
end sub

' ------------------------------------------------------------------------------------------------
' Motion
' ------------------------------------------------------------------------------------------------

sub moveBy(delta as integer)
    count = m.channels.count()
    if count <= 1 or delta = 0 then return
    before = centeredIndex()
    m.rawIndex += delta

    if count <= m.visibleCards
        m.track.translation = [-m.rawIndex * m.pitch, 0]
    else
        ' One card's travel takes exactly one hold repeat, on a linear curve, so a repeat landing
        ' mid flight carries on at the same speed
        m.trackMove.control = "stop"
        m.trackInterp.keyValue = [m.track.translation, [-m.rawIndex * m.pitch, 0]]
        m.trackMove.control = "start"
    end if
    renderCards()

    if centeredIndex() <> before
        clearHeader()
        scheduleVisibleLoad()
    end if
end sub

' The player went back to the channel that was working after a switch failed, so the strip goes
' back to it too
sub onCurrentChannelChanged()
    if m.channels.count() = 0 then return
    if m.syncedChannelId = m.top.currentChannelId and m.syncedRevision = m.top.selectionRevision then return
    m.syncedChannelId = m.top.currentChannelId
    m.syncedRevision = m.top.selectionRevision
    index = -1
    for i = 0 to m.channels.count() - 1
        if m.channels[i].Id = m.top.currentChannelId then index = i
    end for
    if index < 0 or index = centeredIndex() then return
    endHold()
    m.rawIndex = m.rawIndex - centeredIndex() + index
    m.trackMove.control = "stop"
    m.track.translation = [-m.rawIndex * m.pitch, 0]
    renderCards()
    updateHeader()
    scheduleVisibleLoad()
end sub

sub beginHold(direction as integer)
    m.holdDirection = direction
    moveBy(direction)
    m.top.findNode("holdRepeat").control = "stop"
    holdStart = m.top.findNode("holdStart")
    holdStart.control = "stop"
    holdStart.control = "start"
end sub

' The first repeat fires a moment after the press, so a single press moves exactly one channel,
' then one channel every interval reads as continuous motion
sub onHoldStart()
    if m.holdDirection = 0 then return
    moveBy(m.holdDirection)
    m.top.findNode("holdRepeat").control = "start"
end sub

sub onHoldRepeat()
    if m.holdDirection = 0 then return
    moveBy(m.holdDirection)
end sub

sub endHold()
    m.holdDirection = 0
    m.top.findNode("holdStart").control = "stop"
    m.top.findNode("holdRepeat").control = "stop"
end sub

' ------------------------------------------------------------------------------------------------
' Leaving
' ------------------------------------------------------------------------------------------------

sub resetInactivity()
    inactivity = m.top.findNode("inactivity")
    inactivity.control = "stop"
    if not m.dismissed then inactivity.control = "start"
end sub

' Slides the strip away before telling the player, which then gives focus back
sub dismiss()
    if m.dismissed then return
    m.dismissed = true
    endHold()
    m.top.findNode("inactivity").control = "stop"
    m.slide.control = "stop"
    ' The way out is a touch quicker than the way in, so leaving never holds the picture back
    m.slide.duration = 0.14
    m.slide.easeFunction = "inCubic"
    m.slideInterp.keyValue = [m.overlay.translation, [0, 1080]]
    m.slide.control = "start"
    m.top.findNode("exitTimer").control = "start"
end sub

sub onExited()
    m.top.dismissed = true
end sub

sub showNotice()
    message = m.top.notice
    if not isValidAndNotEmpty(message) then return
    m.noticeText.text = message
    rect = m.noticeText.boundingRect()
    m.noticeFill.width = rect.width + 56
    m.noticeFill.height = rect.height + 28
    m.notice.translation = [(1920 - m.noticeFill.width) / 2, 1080 - 60 - m.noticeFill.height]
    m.notice.visible = true
    noticeTimer = m.top.findNode("noticeTimer")
    noticeTimer.control = "stop"
    noticeTimer.control = "start"
end sub

sub hideNotice()
    m.notice.visible = false
end sub

' ------------------------------------------------------------------------------------------------
' Keys
' ------------------------------------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if m.dismissed then return true

    if not press
        if key = KeyCode.LEFT or key = KeyCode.RIGHT then endHold()
        return true
    end if

    resetInactivity()
    if key = KeyCode.BACK
        dismiss()
    else if key = KeyCode.DOWN
        m.dismissed = true
        endHold()
        m.top.findNode("inactivity").control = "stop"
        m.top.showControls = true
    else if key = KeyCode.OK
        endHold()
        channel = centeredChannel()
        if isValid(channel) then m.top.selected = channel
    else if key = KeyCode.LEFT or key = KeyCode.RIGHT
        direction = 1
        if key = KeyCode.LEFT then direction = -1
        ' A press in the direction already held counts as one. A new direction starts over.
        if m.holdDirection <> direction then beginHold(direction)
    end if
    ' Up does nothing here, and taking it keeps focus from wandering behind the strip
    return true
end function

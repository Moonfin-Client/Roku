<?xml version="1.0" encoding="utf-8"?>
<!-- Record on a program that may already be airing, shared by the guide and the player. It asks the
     plugin for a future showing behind a spinner, offers the Record prompt when there is anything
     to offer, sets the timer, then asks for the future showing if the viewer chose it. Every key
     stays inside until outcome is set. -->
<component name="RecordAiring" extends="Group">
  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="#0000008A" visible="false" />
    <Spinner id="spinner" visible="false" />
  </children>
  <interface>
    <!-- { program, channel }, where channel is a line such as 16.1 WPTODT when the caller has one -->
    <field id="request" type="assocarray" onChange="onRequest" />
    <!-- recorded, recordedWithLaterShowing, recordedLaterShowingFailed, laterShowingOnly,
         laterShowingOnlyFailed, failed when the timer couldnt be set, or cancelled -->
    <field id="outcome" type="string" alwaysNotify="true" />
    <!-- Set by a screen that moved on, so nothing gets recorded from here -->
    <field id="abort" type="boolean" alwaysNotify="true" onChange="onAbort" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<!-- One Live TV call to the server, for the guide, the recordings screen and the channel carousel.
     A fresh task runs each request, so a slow one never holds up the next. -->
<component name="LiveTvRequestTask" extends="Task">
  <interface>
    <!-- { kind, tag, ... } where kind names the call and tag comes back untouched -->
    <field id="request" type="assocarray" />
    <!-- { kind, tag, ok, ... } -->
    <field id="response" type="assocarray" />
  </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>
<component name="RatingsRow" extends="Group">
    <interface>
        <field id="ratingsData" type="assocarray" onChange="onRatingsDataChanged" />
        <field id="labelFont" type="string" value="font:SmallestSystemFont" />
        <field id="valueFont" type="string" value="font:SmallBoldSystemFont" />
        <field id="valueSize" type="integer" value="24" />
        <field id="nameSize" type="integer" value="16" />
        <field id="showBadges" type="boolean" value="true" />
        <field id="labelColor" type="string" value="#CCCCCC" />
        <field id="iconHeight" type="integer" value="32" />
        <field id="ratingSpacing" type="integer" value="20" />
        <field id="showNames" type="boolean" value="false" />
    </interface>
    <children>
        <LayoutGroup id="ratingsLayout" layoutDirection="horiz" />
    </children>
</component>
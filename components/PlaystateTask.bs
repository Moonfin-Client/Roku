import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/userDataSync.bs"

sub init()
    m.top.functionName = "PlaystateUpdate"
end sub

sub PlaystateUpdate()
    status = m.top.status
    requestParams = m.top.params

    ' Extract server data if present
    serverData = invalid
    if isValid(requestParams) and isValid(requestParams.serverData)
        serverData = requestParams.serverData
    else
    end if

    if status = "start"
        url = "Sessions/Playing"
    else if status = "stop"
        url = "Sessions/Playing/Stopped"
    else if status = "update"
        url = "Sessions/Playing/Progress"
    else if status = "markPlayed" or status = "unmarkPlayed"
        if isValidAndNotEmpty(m.top.itemId) then setPlayed(m.top.itemId, status = "markPlayed", requestParams, serverData)
        return
    else
        ' Unknown State
        return
    end if

    params = PlaystateDefaults(requestParams)

    if isValid(serverData)
        ' Multi-server: Make request to specific server
        resp = createPlaystateRequest(url, serverData)
    else
        ' Single-server: Use default API
        resp = APIRequest(url)
    end if

    if status <> "stop"
        postJson(resp, params)
        return
    end if

    ' Jellyfin lets go of a live stream on a stop only when it saw that session start, and only
    ' once for every viewer sharing it. A session that never started stops without its stream
    ' and closes it here, so the stream is let go of exactly once.
    closeOwnStream = m.top.closeLiveStream and isValidAndNotEmpty(requestParams.LiveStreamId) and not isEmbyServer(serverData?.serverUrl ?? "")
    if closeOwnStream
        stopParams = {}
        stopParams.Append(requestParams)
        stopParams.Delete("LiveStreamId")
        params = PlaystateDefaults(stopParams)
    end if

    resp.AddHeader("Content-Type", "application/json")
    code = requestResponse(resp, "POST", params).status
    closeEmbyPlayback(serverData, requestParams, code >= 200 and code < 300)
    if closeOwnStream then closeUnstartedLiveStream(serverData, requestParams)
end sub

' Closes the live stream of a Jellyfin session that never reported its start
sub closeUnstartedLiveStream(serverData as dynamic, params as object)
    if not isValid(serverData)
        serverData = activeServerContext()
        if not isValid(serverData) then return
    end if

    req =APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "LiveStreams/Close", { LiveStreamId: params.LiveStreamId })
    postVoid(req)
end sub

' Release tuners and transcoding sessions explicitly when playback stops. A stop the server took
' already let its live stream go, and closing it again could cut off someone else sharing it
sub closeEmbyPlayback(serverData as dynamic, params as object, liveStreamReleased = false as boolean)
    if not isValid(serverData)
        serverData = activeServerContext()
        if not isValid(serverData) then return
    end if
    if not isEmbyServer(serverData.serverUrl) then return
    if isValidAndNotEmpty(params.LiveStreamId) and not liveStreamReleased
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "LiveStreams/Close", { LiveStreamId: params.LiveStreamId })
        postVoid(req)
    end if
    if isValidAndNotEmpty(params.PlaySessionId)
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "Videos/ActiveEncodings", { DeviceId: getAuthHeaderContext().deviceId, PlaySessionId: params.PlaySessionId })
        deleteVoid(req)
    end if
end sub

function PlaystateDefaults(params = {} as object)
    new_params = {
        '"CanSeek": false
        '"Item": "{}", ' TODO!
        '"NowPlayingQueue": "[]", ' TODO!
        '"PlaylistItemId": "",
        '"ItemId": id,
        '"SessionId": "", ' TODO!
        '"MediaSourceId": id,
        '"AudioStreamIndex": 1,
        '"SubtitleStreamIndex": 0,
        "IsPaused": false,
        '"IsMuted": false,
        "PositionTicks": 0
        '"PlaybackStartTimeTicks": 0,
        '"VolumeLevel": 100,
        '"Brightness": 100,
        '"AspectRatio": "16x9",
        '"PlayMethod": "DirectStream"
        '"LiveStreamId": "",
        '"PlaySessionId": "",
        '"RepeatMode": "RepeatNone"
    }

    paramsArray = params.items()
    for i = 0 to paramsArray.count() - 1
        item = paramsArray[i]
        ' Skip serverData - it's not part of the API request body
        if item.key <> "serverData"
            new_params[item.key] = item.value
        end if
    end for
    return FormatJson(new_params)
end function

' createPlaystateRequest: Create API request for playstate updates
function createPlaystateRequest(endpoint as string, serverData as object) as object
    return APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, endpoint)
end function

' Marks the item played or not, on its own server when it has one, and tells the open lists
' once the server has taken it
sub setPlayed(itemId as string, played as boolean, requestParams as dynamic, serverData as dynamic)
    if isValid(serverData)
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "UserPlayedItems/" + itemId, { UserId: serverData.userId })
    else if played
        req = APIRequest(`userplayeditems/${itemId}`, requestParams ?? {})
    else
        req = APIRequest(`userplayeditems/${itemId}`, { userId: m.global.session.user.id })
    end if
    if userDataSync.Send(req, played) then userDataSync.Publish(itemId, userDataSync.PlayedPatch(played))
end sub

' normalizeServerUrl: Ensure server URL doesn't have trailing slash
function normalizeServerUrl(url as string) as string
    if url.right(1) = "/"
        return url.left(url.len() - 1)
    end if
    return url
end function

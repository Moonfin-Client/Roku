import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/config.bs"

sub init()
    m.top.functionName = "PlaystateUpdate"
end sub

sub PlaystateUpdate()
    status = m.top.status
    requestParams = m.top.params

    ' Extract server data if present
    serverData = invalid
    if isValid(requestParams) and isValid(requestParams.serverData)
        serverData = requestParams.serverData
    else
    end if

    if status = "start"
        url = "Sessions/Playing"
    else if status = "stop"
        url = "Sessions/Playing/Stopped"
    else if status = "update"
        url = "Sessions/Playing/Progress"
    else if status = "markPlayed"
        ' Mark item as played
        if isValidAndNotEmpty(m.top.itemId)
            if isValid(serverData)
                ' Multi-server: Use server-specific request
                markPlayedMultiServer(m.top.itemId, serverData)
            else
                ' Single-server: Use default API
                api.users.MarkPlayed(m.top.itemId, requestParams)
            end if
        end if
        return
    else if status = "unmarkPlayed"
        ' Unmark item as played
        if isValidAndNotEmpty(m.top.itemId)
            if isValid(serverData)
                ' Multi-server: Use server-specific request
                unmarkPlayedMultiServer(m.top.itemId, serverData)
            else
                ' Single-server: Use default API
                api.users.UnmarkPlayed(m.top.itemId, { userId: m.global.session.user.id })
            end if
        end if
        return
    else
        ' Unknown State
        return
    end if

    params = PlaystateDefaults(requestParams)

    if isValid(serverData)
        ' Multi-server: Make request to specific server
        resp = createPlaystateRequest(url, serverData)
    else
        ' Single-server: Use default API
        resp = APIRequest(url)
    end if

    postJson(resp, params)
    if status = "stop"
        closeEmbyPlayback(serverData, requestParams)
    end if
end sub

' Release tuners and transcoding sessions explicitly when playback stops.
sub closeEmbyPlayback(serverData as dynamic, params as object)
    if not isValid(serverData)
        serverData = { serverUrl: get_url(), userId: m.global.session.user.id, authToken: m.global.session.user.authToken }
    end if
    if not isEmbyServer(serverData.serverUrl) then return
    if isValidAndNotEmpty(params.LiveStreamId)
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "LiveStreams/Close", { LiveStreamId: params.LiveStreamId })
        postVoid(req)
    end if
    if isValidAndNotEmpty(params.PlaySessionId)
        req = APIRequestForServer(serverData.serverUrl, serverData.userId, serverData.authToken, "Videos/ActiveEncodings", { DeviceId: getAuthHeaderContext().deviceId, PlaySessionId: params.PlaySessionId })
        deleteVoid(req)
    end if
end sub

function PlaystateDefaults(params = {} as object)
    new_params = {
        '"CanSeek": false
        '"Item": "{}", ' TODO!
        '"NowPlayingQueue": "[]", ' TODO!
        '"PlaylistItemId": "",
        '"ItemId": id,
        '"SessionId": "", ' TODO!
        '"MediaSourceId": id,
        '"AudioStreamIndex": 1,
        '"SubtitleStreamIndex": 0,
        "IsPaused": false,
        '"IsMuted": false,
        "PositionTicks": 0
        '"PlaybackStartTimeTicks": 0,
        '"VolumeLevel": 100,
        '"Brightness": 100,
        '"AspectRatio": "16x9",
        '"PlayMethod": "DirectStream"
        '"LiveStreamId": "",
        '"PlaySessionId": "",
        '"RepeatMode": "RepeatNone"
    }

    paramsArray = params.items()
    for i = 0 to paramsArray.count() - 1
        item = paramsArray[i]
        ' Skip serverData - it's not part of the API request body
        if item.key <> "serverData"
            new_params[item.key] = item.value
        end if
    end for
    return FormatJson(new_params)
end function

' createPlaystateRequest: Create API request for playstate updates
function createPlaystateRequest(endpoint as string, serverData as object) as object
    normalizedUrl = normalizeServerUrl(serverData.serverUrl)
    fullUrl = normalizedUrl + "/" + endpoint

    req = createObject("roUrlTransfer")
    req.SetCertificatesFile("common:/certs/ca-bundle.crt")
    req.InitClientCertificates()
    req.SetUrl(fullUrl)
    req.AddHeader(serverAuthHeaderName(serverData.serverUrl), buildAuthHeaderForServer(serverData))
    req.AddHeader("Content-Type", "application/json")

    return req
end function

' markPlayedMultiServer: Mark item as played on specific server
sub markPlayedMultiServer(itemId as string, serverData as object)
    normalizedUrl = normalizeServerUrl(serverData.serverUrl)
    url = normalizedUrl + "/Users/" + serverData.userId + "/PlayedItems/" + itemId

    req = createObject("roUrlTransfer")
    req.SetCertificatesFile("common:/certs/ca-bundle.crt")
    req.InitClientCertificates()
    req.SetUrl(url)
    req.AddHeader(serverAuthHeaderName(serverData.serverUrl), buildAuthHeaderForServer(serverData))
    req.AddHeader("Content-Type", "application/json")

    req.PostFromString("")
end sub

' unmarkPlayedMultiServer: Unmark item as played on specific server
sub unmarkPlayedMultiServer(itemId as string, serverData as object)
    normalizedUrl = normalizeServerUrl(serverData.serverUrl)
    url = normalizedUrl + "/Users/" + serverData.userId + "/PlayedItems/" + itemId

    req = createObject("roUrlTransfer")
    req.SetCertificatesFile("common:/certs/ca-bundle.crt")
    req.InitClientCertificates()
    req.SetUrl(url)
    req.AddHeader(serverAuthHeaderName(serverData.serverUrl), buildAuthHeaderForServer(serverData))
    req.AddHeader("Content-Type", "application/json")

    req.SetRequest("DELETE")
    req.GetToString()
end sub

' normalizeServerUrl: Ensure server URL doesn't have trailing slash
function normalizeServerUrl(url as string) as string
    if url.right(1) = "/"
        return url.left(url.len() - 1)
    end if
    return url
end function

<?xml version="1.0" encoding="utf-8"?>

<!-- Resolves the item ids from a SyncPlay queue update into queue entries the
    player can start, keeping metadata fetches off the render thread -->
<component name="SyncPlayQueueLoadTask" extends="Task">
    <interface>
        <!-- The raw socket message that carries the PlayQueue update -->
        <field id="playQueueJson" type="string" />

        <!-- { items, playingItemIndex, startPositionTicks, isPlaying, reason, shuffleMode } -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

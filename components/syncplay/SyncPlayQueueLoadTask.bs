import "pkg:/source/utils/misc.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/sdk.bs"

sub init()
    m.top.functionName = "execute"
end sub

sub execute()
    update = ParseJson(m.top.playQueueJson)
    if isValid(update) and isValid(update.MessageType) and isValid(update.Data) then update = update.Data
    if isValid(update) and isValid(update.Type) and isValid(update.Data) then update = update.Data
    if not isValid(update)
        m.top.result = { items: [], playingItemIndex: -1 }
        return
    end if

    playlist = update.Playlist
    if type(playlist) <> "roArray" then playlist = []

    ids = []
    for each entry in playlist
        if isValid(entry.ItemId) then ids.Push(entry.ItemId)
    end for

    itemsById = {}
    if ids.Count() > 0
        data = api.items.Get({
            userid: m.global.session.user.id,
            ids: ids.Join(","),
            Fields: "MediaSources,UserData,Chapters,Trickplay",
            EnableTotalRecordCount: false
        })
        if isChainValid(data, "Items")
            for each item in data.Items
                itemsById[item.Id] = item
            end for
        end if
    end if

    items = []
    for each entry in playlist
        json = itemsById[entry.ItemId]
        if isValid(json)
            items.Push({
                id: entry.ItemId,
                type: LCase(json.Type ?? ""),
                json: json,
                syncPlayPlaylistItemId: entry.PlaylistItemId
            })
        else
            ' An item this account can't see keeps its slot so the indexes still line up
            items.Push({
                id: entry.ItemId,
                type: "",
                json: {},
                syncPlayPlaylistItemId: entry.PlaylistItemId,
                syncPlayUnavailable: true
            })
        end if
    end for

    m.top.result = {
        items: items,
        playingItemIndex: update.PlayingItemIndex ?? -1,
        startPositionTicks: update.StartPositionTicks ?? 0,
        isPlaying: update.IsPlaying ?? false,
        reason: update.Reason ?? "",
        shuffleMode: update.ShuffleMode ?? ""
    }
end sub

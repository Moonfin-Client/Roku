<?xml version="1.0" encoding="utf-8"?>

<!-- Keeps this device in its SyncPlay group and its playback locked to the group's -->
<component name="SyncPlayManager" extends="Group">
  <children>
    <timer id="commandTimer" repeat="false" />
    <timer id="pingTimer" repeat="true" duration="10" />
    <timer id="driftTimer" repeat="true" duration="2" />
    <timer id="readyCheckTimer" repeat="false" duration="0.4" />
    <timer id="bufferDebounceTimer" repeat="false" duration="0.35" />
    <timer id="readyWatchdogTimer" repeat="true" duration="2.5" />
    <timer id="waitPauseTimer" repeat="false" />
    <timer id="seekDebounceTimer" repeat="false" duration="0.25" />
  </children>
  <interface>
    <field id="syncPlayActive" type="boolean" value="false" />
    <field id="groupId" type="string" />
    <field id="groupName" type="string" />
    <field id="participants" type="array" />
    <field id="groupState" type="string" value="Idle" />
    <field id="currentPlaylistItemId" type="string" />
    <field id="shuffleMode" type="string" value="Sorted" />

    <function name="disable" />
    <function name="isEnabled" />
    <function name="shouldIntercept" />
    <function name="showGroupsDialog" />
    <function name="requestPause" />
    <function name="requestUnpause" />
    <function name="requestSeek" />
    <function name="requestNext" />
    <function name="requestPrevious" />
    <function name="requestSetNewQueue" />
    <function name="requestSetShuffleMode" />
    <function name="registerVideoView" />
    <function name="unregisterVideoView" />
    <function name="onVideoState" />
    <function name="onAppWake" />
  </interface>
</component>

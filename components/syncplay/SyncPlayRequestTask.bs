import "pkg:/source/utils/misc.bs"
import "pkg:/source/api/baserequest.bs"

sub init()
    m.top.functionName = "execute"
end sub

sub execute()
    routes = {
        list: { path: "/syncplay/list", verb: "GET" },
        newGroup: { path: "/syncplay/new", verb: "POST" },
        join: { path: "/syncplay/join", verb: "POST" },
        leave: { path: "/syncplay/leave", verb: "POST" },
        pause: { path: "/syncplay/pause", verb: "POST" },
        unpause: { path: "/syncplay/unpause", verb: "POST" },
        seek: { path: "/syncplay/seek", verb: "POST" },
        buffering: { path: "/syncplay/buffering", verb: "POST" },
        ready: { path: "/syncplay/ready", verb: "POST" },
        ping: { path: "/syncplay/ping", verb: "POST" },
        nextItem: { path: "/syncplay/nextitem", verb: "POST" },
        previousItem: { path: "/syncplay/previousitem", verb: "POST" },
        setNewQueue: { path: "/syncplay/setnewqueue", verb: "POST" },
        setShuffleMode: { path: "/syncplay/setshufflemode", verb: "POST" },
        setIgnoreWait: { path: "/syncplay/setignorewait", verb: "POST" }
    }

    route = routes[m.top.method]
    if route = invalid
        m.top.response = { method: m.top.method, code: 0, body: invalid }
        return
    end if

    req = APIRequest(route.path)
    if not isValid(req)
        m.top.response = { method: m.top.method, code: 0, body: invalid }
        return
    end if

    port = CreateObject("roMessagePort")
    req.setMessagePort(port)
    req.AddHeader("Content-Type", "application/json")
    body = "{}"
    if isValid(m.top.payload) and m.top.payload.Count() > 0 then body = FormatJson(m.top.payload)

    ' A lost ready or buffering report leaves the whole group waiting, so those are tried again
    attempts = 1
    if m.top.method = "ready" or m.top.method = "buffering" then attempts = 3
    code = 0
    parsedBody = invalid
    for attempt = 1 to attempts
        if route.verb = "GET"
            req.AsyncGetToString()
        else
            req.AsyncPostFromString(body)
        end if
        resp = wait(15000, port)
        if type(resp) = "roUrlEvent"
            code = resp.GetResponseCode()
            respString = resp.GetString()
            if isValidAndNotEmpty(respString) then parsedBody = ParseJson(respString)
        else
            req.AsyncCancel()
            code = 0
        end if
        if code > 0 and code < 500 then exit for
        if attempt < attempts then sleep(1200)
    end for

    m.top.response = { method: m.top.method, code: code, body: parsedBody }
end sub

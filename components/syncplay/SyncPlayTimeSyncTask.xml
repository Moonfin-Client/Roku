<?xml version="1.0" encoding="utf-8"?>

<!-- Measures the clock offset between this device and the server so SyncPlay
    command timestamps can be converted to local time. -->
<component name="SyncPlayTimeSyncTask" extends="Task">
    <interface>
        <field id="shutdown" type="boolean" value="false" />
        <!-- Set true to run a fresh burst of measurements, for example after a reconnect -->
        <field id="syncNow" type="boolean" value="false" />

        <!-- Add this to local epoch ms to get server epoch ms -->
        <field id="timeOffsetMs" type="integer" value="0" alwaysNotify="true" />
        <field id="roundTripTimeMs" type="integer" value="500" alwaysNotify="true" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>

<!-- message stays alwaysNotify so two identical messages in a row both arrive, and observers read
    event.getData() so quick writes aren't lost -->
<component name="SyncPlayTransport" extends="Task">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="shutdown" type="boolean" value="false" />

        <!-- disconnected, connecting, connected, reconnecting, or gone when the server refused the token -->
        <field id="connectionState" type="string" value="disconnected" alwaysNotify="true" />
        <field id="message" type="string" alwaysNotify="true" />
    </interface>
</component>

<?xml version="1.0" encoding="utf-8"?>

<!-- Fire once task for one outbound SyncPlay REST call, so command latency never
    blocks the render thread and calls never collide on a shared task node -->
<component name="SyncPlayRequestTask" extends="Task">
    <interface>
        <field id="method" type="string" />
        <field id="payload" type="assocarray" />

        <!-- { method, code, body } -->
        <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
</component>

import "pkg:/source/api/Achievements.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "runFriends"
end sub

' The answer carries the request back, so the screen can tell what it was for and whether it is
' still on the screen that asked
sub runFriends()
    request = m.top.request
    kind = request.kind
    result = { kind: kind, request: request }

    if kind = "profile"
        result.profile = achievements.FetchPublicProfile(request.userId)
        result.blocked = achievements.FetchBlocked()
    else if kind = "people"
        result.people = achievements.FetchServerUsers()
    else if kind = "privacy"
        result.privacy = achievements.FetchSocialPrivacy()
        result.blocked = achievements.FetchBlocked()
    else if kind = "savePrivacy"
        result.saved = achievements.SaveSocialPrivacy(request.privacy)
    else if kind = "conversation"
        result.conversation = achievements.FetchConversation(request.conversationId)
    else if kind = "messages"
        result.messages = achievements.FetchMessages(request.conversationId)
    else if kind = "openDirect"
        result.conversationId = achievements.OpenDirectChat(request.userId)
    else if kind = "attachment"
        result.path = achievements.FetchAttachment(request.attachmentId)
    else if kind = "write"
        result.write = runWrite(request)
    end if

    m.top.result = result
end sub

function runWrite(request as object) as object
    op = request.op
    if op = "friendRequest" then return achievements.SendFriendRequest(request.userId)
    if op = "acceptFriend" then return achievements.AcceptFriendRequest(request.userId)
    if op = "removeFriend" then return achievements.RemoveFriend(request.userId)
    if op = "setBlocked" then return achievements.SetBlocked(request.userId, request.blocked)
    if op = "sendMessage" then return achievements.SendMessage(request.conversationId, request.text)
    if op = "editMessage" then return achievements.EditMessage(request.messageId, request.text)
    if op = "deleteMessage" then return achievements.DeleteMessage(request.messageId)
    if op = "clearConversation" then return achievements.ClearConversation(request.conversationId)
    if op = "createGroup" then return achievements.CreateGroup(request.title, request.memberIds)
    if op = "renameGroup" then return achievements.RenameGroup(request.conversationId, request.title)
    if op = "addMember" then return achievements.AddGroupMember(request.conversationId, request.userId)
    if op = "removeMember" then return achievements.RemoveGroupMember(request.conversationId, request.userId)
    if op = "setAdmin" then return achievements.SetGroupAdmin(request.conversationId, request.userId, request.admin)
    return { ok: false, message: "" }
end function

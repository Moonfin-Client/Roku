<?xml version="1.0" encoding="utf-8"?>
<component name="FriendsScreen" extends="JFScreen">
    <interface>
        <!-- Raised when the last view is left, so whoever opened the panel takes it away -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- What a friend is watching, picked to open, for whoever opened the panel to act on -->
        <field id="openItem" type="assocarray" alwaysNotify="true" />
    </interface>
    <children>
        <!-- The panel the settings screens use, so an entry opened from settings keeps the
            place it was opened from in view -->
        <Rectangle width="1920" height="1080" color="#000000" opacity="0.70" />
        <Rectangle translation="[1120, 0]" width="800" height="1080" color="#101010" />

        <ScrollingText id="path" translation="[1146, 22]" font="font:SmallBoldSystemFont" maxWidth="747" />

        <!-- Rows differ in height, so the list is drawn here and scrolled by hand -->
        <Group id="viewport" translation="[1146, 80]" clippingRect="[0, 0, 747, 976]">
            <Group id="list" />
        </Group>
        <Animation id="scrollAnimation" duration="0.18" repeat="false" easeFunction="outQuad">
            <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="list.translation" />
        </Animation>

        <!-- Never shown, these lend their fonts to the rows built at runtime -->
        <Label id="titleFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="captionFont" font="font:SmallestSystemFont" visible="false" />
        <Label id="bodyFont" font="font:SmallSystemFont" visible="false" />
        <Label id="buttonFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="metaFont" font="font:SmallestSystemFont" visible="false" />
        <Label id="senderFont" font="font:SmallestBoldSystemFont" visible="false" />
        <Label id="nameFont" font="font:LargeBoldSystemFont" visible="false" />
        <Label id="avatarFont" font="font:SmallBoldSystemFont" visible="false" />
        <Label id="avatarLargeFont" font="font:LargeBoldSystemFont" visible="false" />

        <!-- An open chat asks for new messages this often -->
        <Timer id="chatTimer" duration="10" repeat="true" />
    </children>
</component>

import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/parentalFilter.bs"

' Read off the items rather than the filters route, which can answer with an empty rating list.
' Capped at fifteen pages so a huge library cant pin the screen on a spinner.
const RATINGS_PAGE_SIZE = 200
const RATINGS_MAX_PAGES = 15
const RATED_TYPES = "Movie,Series,Episode,Video,MusicVideo,Book,AudioBook"

sub init()
    m.top.functionName = "readRatings"
end sub

sub readRatings()
    discovered = {}
    ratings = []
    startIndex = 0

    for pages = 1 to RATINGS_MAX_PAGES
        response = api.items.Get({
            UserId: m.global.session.user.id,
            IncludeItemTypes: RATED_TYPES,
            Recursive: true,
            Fields: "OfficialRating",
            StartIndex: startIndex,
            Limit: RATINGS_PAGE_SIZE,
            EnableTotalRecordCount: true
        })
        if not isValid(response)
            m.top.result = { ratings: [], failed: true }
            return
        end if

        page = chainLookupReturn(response, "Items", [])
        for each item in page
            rating = parentalFilter.Normalize(chainLookupReturn(item, "OfficialRating", ""))
            if rating <> "" and not discovered.DoesExist(rating)
                discovered[rating] = true
                ratings.push(rating)
            end if
        end for

        if page.count() < RATINGS_PAGE_SIZE then exit for
        startIndex += page.count()
        total = chainLookupReturn(response, "TotalRecordCount", invalid)
        if isValid(total) and startIndex >= total then exit for
    end for

    m.top.result = { ratings: ratings, failed: false }
end sub

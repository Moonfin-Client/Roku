import "pkg:/source/utils/themeApply.bs"

const BLOCKED_ICON_SIZE = 48
const BLOCKED_ICON_GAP = 16

sub init()
    m.top.optionsAvailable = false
    m.notice = m.top.findNode("notice")
    m.lock = m.top.findNode("lock")
    m.message = m.top.findNode("message")

    m.message.font.size = 22
    m.message.text = tr("This isn't available")
    themeApply.ApplyToItem(m.top)

    textSize = m.message.boundingRect()
    width = textSize.width
    if width < BLOCKED_ICON_SIZE then width = BLOCKED_ICON_SIZE
    m.lock.translation = [(width - BLOCKED_ICON_SIZE) / 2, 0]
    m.message.width = width
    m.message.translation = [0, BLOCKED_ICON_SIZE + BLOCKED_ICON_GAP]

    height = BLOCKED_ICON_SIZE + BLOCKED_ICON_GAP + textSize.height
    m.notice.translation = [(1920 - width) / 2, (1080 - height) / 2]
end sub

sub OnScreenShown(_isReturning = false as boolean)
    m.top.setFocus(true)
end sub

sub testLibraryOrder()
    libraries = [
        { id: "z-music", serverName: "Zulu" },
        { id: "a-shows", serverName: "Alpha" },
        { id: "z-anime", serverName: "Zulu" },
        { id: "a-movies", serverName: "Alpha" }
    ]
    assertEqual(libraryIds(librariesByServer(libraries)), "a-shows,a-movies,z-music,z-anime", "Each server keeps its own library order, servers by name")
    assertEqual(libraryIds(librariesByServer([])), "", "No libraries, nothing to order")

    single = [{ id: "movies", Id: "movies" }, { id: "shows", Id: "shows" }, { id: "music", Id: "music" }]
    assertEqual(libraryIds(libraryOrder.Move(single, 0, 1)), "shows,movies,music", "A library moves one place")
    assertEqual(libraryIds(libraryOrder.Move(single, 2, 1)), "movies,music,shows", "A library moves back a place")
    assertEqual(libraryOrder.Move(single, 0, -1), invalid, "Nothing moves past the start")
    assertEqual(libraryOrder.Move(single, 2, 3), invalid, "Nothing moves past the end")
    assertEqual(libraryOrder.Move(single, -1, 0), invalid, "Nothing moves without a focused library")
    assertEqual(libraryIds(single), "movies,shows,music", "Moving leaves the list it was given alone")

    mixed = [
        { id: "a-shows", Id: "a-shows", serverUrl: "https://alpha" },
        { id: "a-movies", Id: "a-movies", serverUrl: "https://alpha" },
        { id: "z-music", Id: "z-music", serverUrl: "https://zulu" }
    ]
    assertEqual(libraryOrder.Move(mixed, 1, 2), invalid, "A library stays among its own server's libraries")
    assertEqual(libraryOrder.IsLastOfServer(mixed, 1), true, "The last of a server's run ends there")
    assertEqual(libraryOrder.IsFirstOfServer(mixed, 2), true, "The next server's run starts again")
    assertEqual(libraryOrder.IsFirstOfServer(mixed, 1), false, "A library inside a run can move back")
    groups = libraryOrder.ByServer(mixed)
    assertEqual(groups.Count(), 2, "Each server is told its own order")
    assertEqual(groups[0].serverUrl + " " + groups[0].ids.Join(","), "https://alpha a-shows,a-movies", "Only its own libraries")
    assertEqual(groups[1].serverUrl + " " + groups[1].ids.Join(","), "https://zulu z-music", "In the order on screen")
    groups = libraryOrder.ByServer(single)
    assertEqual(groups.Count().ToStr() + " " + groups[0].ids.Join(","), "1 movies,shows,music", "A single server is one group")

    hidden = libraryOrder.HiddenIds([{ MyMediaExcludes: ["shows"] }, invalid, { MyMediaExcludes: ["music"] }])
    assertEqual(hidden.DoesExist("shows") and hidden.DoesExist("music") and not hidden.DoesExist("movies"), true, "A library hidden on any account is marked")

    assertEqual(libraryOrder.Icon({ CollectionType: "tvshows", Name: "Shows" }), "tv_rounded", "Each kind of library has its icon")
    assertEqual(libraryOrder.Icon({ CollectionType: "mixed", Name: "Retro Games" }), "sports_esports", "A mixed library named for games shows a controller")
    assertEqual(libraryOrder.Icon({ CollectionType: "movies", Name: "Game Night" }), "movie_rounded", "A movie library keeps its own icon whatever its name")
    assertEqual(libraryOrder.Icon({ Name: "Other" }), "video_library_rounded", "Anything else is a video library")
end sub

function libraryIds(libraries as object) as string
    ids = []
    for each library in libraries
        ids.push(library.id)
    end for
    return ids.Join(",")
end function

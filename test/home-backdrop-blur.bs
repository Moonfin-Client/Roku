sub testHomeBackdropBlur()
    m.global = { session: { user: { settings: { "ui.backdrop.homeBlurAmount": "10" } } } }
    seerrBackdrop = "https://image.tmdb.org/t/p/w1280/y0reRTsewsPh0ePtgvDeLIsb5Wk.jpg"
    assertEqual(blurMatchingLoadWidth(seerrBackdrop), 96, "A Seerr backdrop loads small to match the server's medium blur")
    assertEqual(blurMatchingLoadWidth("http://jellyfin.test/Items/1/Images/Backdrop?maxheight=1080&blur=10"), 0, "A backdrop the server blurred stays full size")
    m.global.session.user.settings["ui.backdrop.homeBlurAmount"] = "20"
    assertEqual(blurMatchingLoadWidth(seerrBackdrop), 48, "A heavier blur loads it smaller")
    m.global.session.user.settings["ui.backdrop.homeBlurAmount"] = "0"
    assertEqual(blurMatchingLoadWidth(seerrBackdrop), 0, "No blur leaves it full size")
end sub

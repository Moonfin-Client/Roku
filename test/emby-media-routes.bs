sub testEmbyMediaRoutes()
    routes = [
        ["/userviews", "Users/local/Views"],
        ["/useritems/resume", "Users/local/Items/Resume"],
        ["/items/latest", "Users/local/Items/Latest"],
        ["/items/", "Users/local/Items"],
        ["/items/suggestions", "Users/local/Suggestions"],
        ["/userviews/groupingoptions", "Users/local/GroupingOptions"],
        ["userfavoriteitems/movie-id", "Users/local/FavoriteItems/movie-id"],
        ["userplayeditems/movie-id", "Users/local/PlayedItems/movie-id"]
    ]
    for each route in routes
        assertEqual(serverCompatiblePath(route[0], {}, "local", true), route[1], "Emby user-scoped route " + route[0])
        assertEqual(serverCompatiblePath(route[0], {}, "local", false), route[0], "Jellyfin route unchanged " + route[0])
    end for
    assertEqual(serverCompatiblePath("/items/latest", { UserId: "selected" }, "active", true), "Users/selected/Items/Latest", "Explicit user wins over active user")
    assertEqual(serverCompatiblePath("/Users/local/Items/id", {}, "local", true), "/Users/local/Items/id", "Existing favorites/detail route stays intact")
    assertEqual(serverCompatiblePath("/items/id/Images/Primary", {}, "local", true), "/items/id/Images/Primary", "Do not rewrite image routes")
    assertEqual(serverCompatiblePath("/items/id/PlaybackInfo", {}, "local", true), "/items/id/PlaybackInfo", "Do not rewrite playback routes")
    assertEqual(validItemMetadata({ ResponseStatus: { ErrorCode: "UnauthorizedAccessException" } }), false, "Do not hand server error object to detail UI")
    assertEqual(validItemMetadata([]), false, "Reject detail response arrays")
    assertEqual(validItemMetadata(invalid), false, "Reject missing detail response")
    assertEqual(validItemMetadata({ Id: "film", Type: "Movie" }), true, "Allow media metadata with optional UserData absent")
    url = buildURLForServer("https://emby.test/emby", serverCompatiblePath("/userviews", {}, "local", true))
    assertEqual(url, "https://emby.test/emby/Users/local/Views", "Preserve Emby domain base path for home")
end sub

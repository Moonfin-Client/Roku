sub testItemMenuPlaylistRows()
    movie = { Id: "m1", Type: "Movie", Name: "A movie", UserData: {} }

    assertEqual(menuEntryIds(movie, { canManage: true, first: false, last: false }), "play,viewDetails,watched,favorite,addToPlaylist,removeFromPlaylist,moveUp,moveDown", "A playlist row gets its own entries, View Details right after Play")
    assertEqual(menuEntryIds(movie, { canManage: true, first: true, last: false }).Instr("moveUp"), -1, "The first row cant move up")
    assertEqual(menuEntryIds(movie, { canManage: true, first: false, last: true }).Instr("moveDown"), -1, "The last row cant move down")
    assertEqual(menuEntryIds(movie, { canManage: false }), "play,viewDetails,watched,favorite,addToPlaylist", "A playlist that cant be changed only adds View Details")

    song = { Id: "a1", Type: "Audio", Name: "A song", UserData: {} }
    assertEqual(menuEntryIds(song, { canManage: true, first: true, last: true }), "play,watched,favorite,addToPlaylist,removeFromPlaylist", "A song has no page to open")

    homeVideo = { Id: "v1", Type: "Video", Name: "A home video", UserData: {} }
    assertEqual(menuEntryIds(homeVideo, { canManage: true, first: false, last: false }), "removeFromPlaylist,moveUp,moveDown", "A home video in a playlist can still be taken out or moved")
    assertEqual(menuEntryIds(homeVideo, { canManage: false }), "", "A playlist that cant be changed gives a home video nothing")
    musicVideo = { Id: "mv1", Type: "MusicVideo", Name: "A music video", UserData: {} }
    assertEqual(menuEntryIds(musicVideo, { canManage: true, first: true, last: true }), "removeFromPlaylist", "A music video in a playlist can still be taken out")
    assertEqual(menuEntryIds(homeVideo, invalid), "", "A home video outside a playlist still gets no menu")

    assertEqual(menuEntryIds(movie, invalid), "play,watched,favorite,addToPlaylist", "A card outside a playlist gets none of them")

    savedGlobal = m.global
    m.global = { serverIdentity: { url: "https://emby.test", serverType: "emby" }, session: { server: { url: "https://emby.test", serverType: "emby", version: "4.10.0.40" } } }
    assertEqual(playlistRenumbersAfterDelete(), true, "Emby 4.10 numbers a playlist again after a delete")
    m.global.session.server.version = "4.9.5.0"
    assertEqual(playlistRenumbersAfterDelete(), false, "Older Emby keeps the ids it listed")
    m.global = { serverIdentity: { url: "https://jellyfin.test", serverType: "jellyfin" }, session: { server: { url: "https://jellyfin.test", serverType: "jellyfin", version: "10.11.10" } } }
    assertEqual(playlistRenumbersAfterDelete(), false, "Jellyfin keeps the ids it listed")
    m.global = savedGlobal

    ' What Emby 4.10 listed around deleting the second of five rows held as 10 to 14
    listed = [{ id: "a", entryId: "10" }, { id: "c", entryId: "12" }, { id: "d", entryId: "13" }, { id: "e", entryId: "14" }]
    assertEqual(playlistRenumbered(playlistEntries(["a", "c", "d", "e"], ["10", "12", "13", "14"]), listed), false, "Right after the delete the old ids are still listed")
    assertEqual(playlistRenumbered(playlistEntries(["a", "c", "d", "e"], ["10", "11", "12", "13"]), listed), true, "A moment later the rows after it have new ids")
    assertEqual(playlistRenumbered(playlistEntries(["a", "c", "d", "e"], ["20", "21", "22", "23"]), listed), true, "Another playlist changing first moves the whole numbering")
    ' The same delete with a row at 11 that a parental block hides
    hidden = [{ id: "a", entryId: "10" }, { id: "c", entryId: "13" }, { id: "d", entryId: "14" }]
    assertEqual(playlistRenumbered(playlistEntries(["a", "x", "c", "d"], ["10", "11", "13", "14"]), hidden), false, "A hidden row is skipped rather than read as a change")
    assertEqual(playlistRenumbered(playlistEntries(["a", "x", "c", "d"], ["10", "11", "12", "13"]), hidden), true, "The rows after it still show the renumber")
    twice = [{ id: "a", entryId: "10" }, { id: "a", entryId: "12" }]
    assertEqual(playlistRenumbered(playlistEntries(["a", "a"], ["10", "11"]), twice), true, "A title in the playlist twice is matched in order")
    assertEqual(playlistRenumbered(playlistEntries(["a", "c"], ["10", "11"]), []), true, "Nothing left to compare isnt waited on")
end sub

function playlistEntries(itemIds as object, entryIds as object) as object
    items = []
    for i = 0 to itemIds.Count() - 1
        items.push({ Id: itemIds[i], PlaylistItemId: entryIds[i] })
    end for
    return items
end function

function menuEntryIds(item as object, playlist as dynamic) as string
    ids = []
    for each entry in itemMenu.BuildEntries(item, { isAdmin: false, isJellyfin: true, canManageCollections: false, inCollection: false, playlist: playlist })
        ids.push(entry.id)
    end for
    return ids.Join(",")
end function

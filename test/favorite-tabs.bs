sub testFavoriteTabs()
    assertEqual(favoriteTabs.Cycle(favoriteTabs.ImageSizes(), "large"), "extraLarge", "Image size steps to the next size")
    assertEqual(favoriteTabs.Cycle(favoriteTabs.ImageSizes(), "extraLarge"), "small", "Image size wraps back round to the smallest")
    assertEqual(favoriteTabs.Cycle(favoriteTabs.GridDirections(), "vertical"), "horizontal", "Grid direction turns sideways")
    assertEqual(favoriteTabs.Cycle(favoriteTabs.ViewStyles(), "unknown"), "home", "A value the list doesn't know starts it over")
    assertEqual(favoriteTabs.SettingLabel("extraLarge"), "Extra Large", "Extra large reads as two words")
    assertEqual(favoriteTabs.ChosenTypeFilter("all").types, "Movie,Series,Episode,Person", "All asks for the same types the other clients do")

    metrics = favoriteTabs.CardMetrics("portrait", "medium", 1824, true)
    assertEqual(metrics.showServerBadge, true, "Pooled cards say which server they came from")
    assertEqual(metrics.showUnplayedCount, false, "A favorite series shows the watched check, never a count")

    nodes = [
        testFavoriteNode("Ángel", ""),
        testFavoriteNode("The Matrix", "Matrix"),
        testFavoriteNode("2001", ""),
        testFavoriteNode("東京", ""),
        testFavoriteNode("Avatar", "")
    ]
    assertEqual(testFavoriteNames(favoriteTabs.FilterByStartLetter(nodes, "A")), "Ángel,Avatar", "A takes the accented name too")
    assertEqual(testFavoriteNames(favoriteTabs.FilterByStartLetter(nodes, "M")), "The Matrix", "The letter follows the sort name")
    assertEqual(testFavoriteNames(favoriteTabs.FilterByStartLetter(nodes, "#")), "2001,東京", "# gathers numbers and other scripts")
    assertEqual(favoriteTabs.FilterByStartLetter(nodes, "").count(), 5, "No letter keeps everything")

    items = [
        { Name: "b", CommunityRating: 7.0, DateCreated: "2024-01-02", RunTimeTicks: 300 },
        { Name: "a", CommunityRating: 7.0, DateCreated: "2024-01-03", RunTimeTicks: 100 },
        { Name: "C", CommunityRating: 9.1, DateCreated: "2024-01-01", RunTimeTicks: 200, UserData: { LastPlayedDate: "2024-05-01" } },
        { Name: "d", SortName: "0d" }
    ]
    assertEqual(testFavoriteNames(favoriteTabs.SortItems(items, "SortName")), "d,a,b,C", "Name sorts on the sort name whatever the case")
    assertEqual(testFavoriteNames(favoriteTabs.SortItems(items, "CommunityRating")), "C,a,b,d", "Ratings run highest first and ties stay alphabetical")
    assertEqual(testFavoriteNames(favoriteTabs.SortItems(items, "Runtime")), "d,a,C,b", "Runtime runs shortest first")
    assertEqual(testFavoriteNames(favoriteTabs.SortItems(items, "DatePlayed")), "C,d,a,b", "Only what's been played moves ahead of the rest")
    assertEqual(testFavoriteNames(favoriteTabs.SortItems(items, "DateCreated")), "a,b,C,d", "Date added runs newest first")
end sub

function testFavoriteNode(name as string, sortName as string) as object
    json = { Name: name }
    if sortName <> "" then json.SortName = sortName
    return { json: json }
end function

function testFavoriteNames(entries as object) as string
    names = []
    for each entry in entries
        if isValid(entry.json)
            names.push(entry.json.Name)
        else
            names.push(entry.Name)
        end if
    end for
    return names.join(",")
end function

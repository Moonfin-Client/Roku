sub testSilo()
    ' Detection and public info
    assertEqual(detectServerType({ ProductName: "Silo", Version: "1.0.0", Id: "abc" }), "silo", "Silo detection")
    assertEqual(isSiloSystemInfo({ server_version: "527e4043", api_major: 2 }), true, "Silo's system info is recognised")
    assertEqual(isSiloSystemInfo({ server_version: "527e4043", api_major: "2" }), false, "A text api_major isn't Silo's")
    assertEqual(isSiloSystemInfo({ Version: "10.9.0" }), false, "Jellyfin's info isn't Silo's")
    info = siloMap.PublicInfo({ server_version: "1.2.3", api_major: 2 }, { server_id: "srv-1" }, { server_name: "Home Silo", login_subtitle: " Welcome " }, { needs_setup: true })
    assertEqual(info.Id, "srv-1", "Public info takes the server id from identity")
    assertEqual(info.ServerName, "Home Silo", "Public info takes the branded name")
    assertEqual(info.ProductName, "Silo", "Public info names the product")
    assertEqual(info.StartupWizardCompleted, false, "needs_setup means the wizard isn't done")
    assertEqual(info.LoginDisclaimer, "Welcome", "The login subtitle becomes the disclaimer")
    assertEqual(siloMap.PublicInfo({ server_version: "1", api_major: 2 }, invalid, invalid, invalid).ServerName, "Silo", "An unbranded server is called Silo")

    ' Profiles as users
    account = { id: 7, username: "owner", role: "admin", download_allowed: true }
    user = siloMap.ProfileToUser({ id: "p-1", name: "Kid", is_primary: false, has_pin: true, is_child: true }, account)
    assertEqual(user.Id, "p-1", "A profile's id is the user id")
    assertEqual(user.SiloAccountId, "7", "The account id is kept as text")
    assertEqual(user.Policy.IsAdministrator, false, "Only the primary profile of an admin account administers")
    assertEqual(user.SiloHasPin, true, "A PIN profile says so")
    primary = siloMap.ProfileToUser({ id: "p-0", name: "", is_primary: true }, account)
    assertEqual(primary.Policy.IsAdministrator, true, "The admin account's primary profile administers")
    assertEqual(primary.Name, "owner", "A nameless profile takes the account's name")

    ' Settings
    config = siloMap.SettingsToConfiguration({ "ui.library_order": [3, 1, "x", 0], "playback.subtitle_mode": "off", "playback.show_forced_subtitles": false, "playback.auto_play_next": false, "playback.audio_language": " eng " })
    assertEqual(config.OrderedViews.Join(","), "3,1", "Library order keeps positive ids as text")
    assertEqual(config.SubtitleMode, "None", "Off without forced subtitles is None")
    assertEqual(config.EnableNextEpisodeAutoPlay, false, "Autoplay follows the setting")
    assertEqual(config.AudioLanguagePreference, "eng", "Audio language is trimmed")
    assertEqual(siloMap.SubtitleModeToJellyfin("off", true), "OnlyForced", "Off with forced subtitles is OnlyForced")
    assertEqual(siloMap.SubtitleModeToJellyfin("auto"), "Default", "Auto is Default")
    back = siloMap.ConfigurationToSettings({ SubtitleMode: "OnlyForced", OrderedViews: ["2", "2", "5"], EnableNextEpisodeAutoPlay: true }, {})
    assertEqual(back["playback.subtitle_mode"], "off", "OnlyForced is Silo's off")
    assertEqual(back["playback.show_forced_subtitles"], true, "OnlyForced shows forced subtitles")
    assertEqual(FormatJson(back["ui.library_order"]), "[2,5]", "Library order goes back as unique numbers")
    assertEqual(back["playback.audio_language"], invalid, "An empty language is no setting")

    ' Tokens
    now = 1000000
    tokens = { access: "a", refresh: "r", expiresAt: now + 3600, lifetime: 3600 }
    assertEqual(silo.NeedsRefresh(tokens, now), false, "A fresh token isn't refreshed")
    assertEqual(silo.NeedsRefresh(tokens, now + 2900), true, "A token past four fifths of its life is refreshed")
    assertEqual(silo.NeedsRefresh({ access: "a", refresh: "", expiresAt: now, lifetime: 3600 }, now), false, "No refresh token, no refresh")
    assertEqual(silo.NeedsStreamRefresh(tokens, now + 100), false, "A stream token under a tenth used is kept")
    assertEqual(silo.NeedsStreamRefresh(tokens, now + 400), true, "A stream token past a tenth of its life is refreshed first")

    ' Requests
    assertEqual(silo.ServerKey(" HTTP://Silo.Test:8090/ "), "http://silo.test:8090", "Server keys are lowercase without a trailing slash")
    assertEqual(silo.ServerKey("silo.test"), "http://silo.test", "A bare host is http")
    assertEqual(silo.CleanDeviceId("Roku 4800/x#1"), "Roku4800x1", "Device ids keep only what Silo accepts")
    assertEqual(silo.EncodeQuery({ keys: ["a b", "c"] }), "keys=a%20b&keys=c", "Lists repeat their key")
    assertEqual(silo.EncodeQuery({ limit: 20, sorted: true, gone: invalid }), "limit=20&sorted=true", "Numbers and booleans are written, invalid is left out")
    assertEqual(silo.PathOf("http://silo.test/api/v2/x?token=secret"), "/api/v2/x", "Logged paths drop the query")
    problem = silo.ProblemOf({ type: "https://siloserver.org/docs/api/v2/problems/not_found", title: "Not found", status: 404 })
    assertEqual(problem.code, "not_found", "A problem's code is the last segment of its type")
    assertEqual(silo.ProblemOf({ items: [] }), invalid, "Other bodies aren't problems")
    assertEqual(silo.IsClientUpgradeRequired({ status: 410, problem: { code: "client_upgrade_required" } }), true, "A retired API asks for an upgrade")

    ' Routing
    m.global.serverIdentity = { url: "http://silo.test:8090", serverType: "silo" }
    assertEqual(silo.ServerOfUrl("http://silo.test:8090/Items?Ids=1"), "http://silo.test:8090", "Jellyfin paths on a Silo are routed")
    assertEqual(silo.ServerOfUrl("http://silo.test:8090/api/v2/catalog"), "", "Native paths go out as they are")
    assertEqual(silo.ServerOfUrl("http://silo.test:80901/Items"), "", "Another port isn't the same server")
    parsed = silo.ParseRequest("get", "http://silo.test:8090/Users/p-9/Items/movie%2Dtmdb%2D1?Fields=Overview%2CGenres&Limit=5&Flag", invalid)
    assertEqual(parsed.route.Join("/"), "users/p-9/items/movie-tmdb-1", "Paths are split and decoded")
    assertEqual(parsed.segments[1], "p-9", "Segments keep their case")
    assertEqual(parsed.query.Fields, "Overview,Genres", "Query values are decoded")
    assertEqual(parsed.query.Flag, "", "A bare query key is kept")
    assertEqual(parsed.method, "GET", "Methods are upper case")
    m.global.serverIdentity = { url: "", serverType: "" }

    ' Artwork
    assertEqual(silo.ImageURL("http://silo.test", "Items/movie-1/Images/Primary", { tag: "/api/v2/artwork/a.webp?sig=x", maxHeight: 300 }), "http://silo.test/api/v2/artwork/a.webp?sig=x", "A Silo image tag is the picture's address")
    silo.RegisterImage("http://silo.test", "movie-2", "Backdrop", "/api/v2/artwork/b.webp", 1)
    assertEqual(silo.ImageURL("http://silo.test/", "/Items/movie-2/Images/Backdrop/1", {}), "http://silo.test/api/v2/artwork/b.webp", "Pictures mapped in this thread are found without a tag")
    assertEqual(silo.ImageURL("http://silo.test", "Items/movie-3/Images/Primary", {}), "", "An unknown picture is none")
    assertEqual(silo.ResolveUrl("https://silo.test", "//cdn.test/x.jpg"), "https://cdn.test/x.jpg", "Scheme-relative pictures take the server's scheme")
    assertEqual(silo.ResolveUrl("https://silo.test", "https://cdn.test/x.jpg"), "https://cdn.test/x.jpg", "Absolute pictures are kept")
end sub

sub testSiloCatalog()
    ' Ids
    assertEqual(siloMap.TypeOfId("episode-imdb-tt1-2-3"), "episode", "Ids say their type")
    assertEqual(siloMap.TypeOfId("42"), "", "A number has no type")
    assertEqual(siloMap.SeasonIdFor("series-imdb-tt1", 2), "season-imdb-tt1-2", "A season id comes from its series")
    season = siloMap.ParseSeasonId("season-imdb-tt1-12")
    assertEqual(season.seriesId + "/" + season.seasonNumber.ToStr(), "series-imdb-tt1/12", "Season ids name their series and number")
    episode = siloMap.ParseEpisodeId("episode-tmdb-9-0-4")
    assertEqual(episode.seriesId + "/" + episode.seasonNumber.ToStr() + "/" + episode.episodeNumber.ToStr(), "series-tmdb-9/0/4", "Episode ids name series, season and episode")
    assertEqual(siloMap.ParseEpisodeId("movie-1"), invalid, "Other ids aren't episodes")
    libBox = siloMap.ParseCollectionId("silo-libcollection:3:abc")
    assertEqual(libBox.libraryId + "/" + libBox.id, "3/abc", "Library collection ids carry the library")
    assertEqual(siloMap.ParseCollectionId("silo-collection:7").libraryId, "", "Personal collections have no library")
    assertEqual(siloMap.ParseCollectionId("silo-libcollection:3"), invalid, "A library collection id needs both parts")
    assertEqual(siloMap.GenreNameOf(siloMap.GenreId("Sci-Fi & Fantasy")), "Sci-Fi & Fantasy", "Genre ids carry their names")
    assertEqual(siloMap.LibraryIdOf("12"), "12", "Numbers are library ids")
    assertEqual(siloMap.LibraryIdOf("movie-1"), "", "Titles aren't libraries")

    ' Query mapping
    assertEqual(FormatJson(siloMap.TypesForQuery("Movie,BoxSet,Series")), "[""movie"",""series""]", "Types Silo can't serve drop out")
    assertEqual(siloMap.TypesForQuery("MusicAlbum").Count(), 0, "Nothing Silo has is an empty list")
    assertEqual(siloMap.TypesForQuery(invalid), invalid, "No types named is no filter")
    assertEqual(FormatJson(siloMap.TypesForQuery(invalid, "Video")), "[""movie"",""episode""]", "Video media is films and episodes")
    assertEqual(siloMap.CatalogScopeFor(["movie", "series"]), "video", "Films and shows are the video scope")
    assertEqual(siloMap.SearchScopeFor(["movie", "series", "episode"], true), "video_with_episodes", "Searches take episodes along when Silo can")
    assertEqual(siloMap.SortFor("SortName,ProductionYear", "Descending"), "-title", "The first sort term is Silo's sort")
    assertEqual(siloMap.SortFor("Random", "Ascending"), "", "Random isn't one of Silo's sorts")
    assertEqual(siloMap.WantsRandom("Random"), true, "Random is noticed")
    groups = siloMap.RuleGroups({ genres: ["Drama", "Drama"], filters: ["IsUnplayed", "IsFavorite"], isHd: false })
    assertEqual(groups.Count(), 6, "Genres, unwatched, favorites and three not-HD groups")
    assertEqual(groups[0].rules.Count(), 1, "A repeated genre is asked once")
    assertEqual(groups[1].rules[0].field + " " + groups[1].rules[0].value.ToStr(), "watched false", "Unplayed is not watched")

    ' Libraries
    views = siloMap.LibrariesToViews([{ id: 2, type: "series", name: "TV", sort_order: 2 }, { id: 1, type: "movies", name: "Films", sort_order: 1 }, { id: 3, type: "audiobooks", name: "Books" }], "http://silo.test")
    assertEqual(views.Count(), 2, "Audiobook libraries aren't shown")
    assertEqual(views[0].Id + views[0].CollectionType, "1movies", "Libraries follow Silo's order and type")
    ordered = siloMap.InViewOrder(views, ["2"])
    assertEqual(ordered[0].Id, "2", "The profile's own order comes first")

    ' Items
    dto = siloMap.ItemToBaseItem({ content_id: "episode-tmdb-5-1-2", title: "Pilot", season_number: 1, episode_number: 2, series_id: "series-tmdb-5", series_title: "Show", still_url: "/a/still.webp", runtime: 30, user_state: { played: false, is_favorite: true }, position_seconds: 600, duration_seconds: 1800 }, "http://silo.test")
    assertEqual(dto.Type, "Episode", "Episodes map to Episode")
    assertEqual(dto.SeasonId, "season-tmdb-5-1", "Episodes name their season")
    assertEqual(dto.ImageTags.Primary, "/a/still.webp", "An episode's still is its picture")
    assertEqual(dto.UserData.IsFavorite, true, "Favorites carry over")
    assertEqual(dto.UserData.PlaybackPositionTicks, 6000000000&, "Positions are ticks")
    assertEqual(Int(dto.UserData.PlayedPercentage), 33, "Progress is a percentage")
    assertEqual(dto.RunTimeTicks, 18000000000&, "Runtime minutes become ticks")
    keys = []
    for each key in dto.ImageTags
        keys.Push(key)
    end for
    assertEqual(keys.Join(","), "Primary", "Image types keep Jellyfin's casing")
    movie = siloMap.ItemToBaseItem({ content_id: "movie-1", type: "movie", title: "The Film", rating_tmdb: 7.26, extras: [{ kind: "trailer", content_id: "x-1" }, { kind: "featurette", content_id: "x-2" }], cast: [{ name: "B", order: 2 }, { name: "A", order: 1, person_id: 9 }], crew: [{ name: "C", job: "Director" }] }, "http://silo.test")
    assertEqual(movie.SortName, "Film, The", "Leading articles move to the end of the sort name")
    assertEqual(movie.CommunityRating, 7.3, "Ratings keep one decimal")
    assertEqual(movie.LocalTrailerCount.ToStr() + "/" + movie.SpecialFeatureCount.ToStr(), "1/1", "Extras are counted by kind")
    assertEqual(movie.People[0].Name + movie.People[0].Id + movie.People[1].Name + movie.People[2].Type, "A9BDirector", "Cast in billing order, then crew")
    assertEqual(siloMap.ItemToBaseItem({ content_id: "book-1", type: "audiobook" }, "http://silo.test"), invalid, "Types the app can't show are left out")

    ' Paging
    state = silo.NewPageState()
    silo.AddPage(state, 0, { items: [1, 2, 3], nextCursor: "c2", windowCursor: "w", hasMore: true, total: 7, totalExact: true })
    assertEqual(FormatJson(silo.PageItemsAt(state, 1, 5)), "[2,3]", "Kept pages answer what they hold")
    assertEqual(silo.PageTotalFor(state, 3), 7, "An exact total is the total")
    silo.AddPage(state, 3, { items: [4], nextCursor: "", windowCursor: "", hasMore: false, total: -1, totalExact: false })
    assertEqual(state.knownEnd, 4, "A last page ends the list")
    assertEqual(silo.PageSignature("/c", { limit: 5, cursor: "x", type: "movie", a: 1 }), "/c?a=1&type=""movie""", "Signatures leave the paging out")
    assertEqual(FormatJson(silo.Slice([1, 2, 3, 4], 1, 2).Items), "[2,3]", "Slices page a list")
    assertEqual(silo.Slice([1, 2], 5, 2).Items.Count(), 0, "A slice past the end is empty")
end sub

function RegistryReadAll(section as string) as dynamic
    if section = "ServerTypes" then return m.serverTypes
    return {}
end function

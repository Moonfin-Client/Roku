sub testExternalRows()
    assertEqual(chartItemType("tv/popular"), "Series", "A TV chart holds shows")
    assertEqual(chartItemType("trending/tv/day"), "Series", "Trending TV too")
    assertEqual(chartItemType("movie/top_rated"), "Movie", "A movie chart holds movies")
    assertEqual(chartItemType("trending/all/week"), "", "The chart that mixes both leaves each result to say")
    assertEqual(chartItemType("top250movies"), "", "An IMDb chart is left alone")

    show = { type: "Series", providerIds: { Tmdb: "1585", Imdb: "tt0000001" } }
    assertEqual(providerKeys(show).Join(","), "tmdb.Series.1585,imdb.tt0000001", "A show is keyed by its type with its TMDB id and by its IMDb id alone")
    assertEqual(providerKeys({ Type: "Movie", ProviderIds: { Tmdb: 1585 } }).Join(","), "tmdb.Movie.1585", "A movie with the same TMDB id is a different key")
    assertEqual(providerKeys({ Type: "Episode", ProviderIds: { Tmdb: "7" } }).Count(), 0, "Only movies and shows are keyed by TMDB id")
    assertEqual(providerKeys({ Type: "Movie" }).Count(), 0, "No ids, no keys")

    index = {}
    indexByProviderIds(index, { Type: "Series", ProviderIds: { Tmdb: "1585" } }, "dragon-tales")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Tmdb: "1585", Imdb: "tt0038650" } }, "wonderful-life")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Imdb: "tt0038650" } }, "a-copy")
    assertEqual(index["tmdb.Series.1585"], "dragon-tales", "The show keeps its key")
    assertEqual(index["tmdb.Movie.1585"], "wonderful-life", "The movie keeps its own")
    assertEqual(index["imdb.tt0038650"], "wonderful-life", "The first title with an id keeps it")
end sub

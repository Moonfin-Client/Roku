sub testExternalRows()
    assertEqual(externalList.ChartItemType("tv/popular"), "Series", "A TV chart holds shows")
    assertEqual(externalList.ChartItemType("trending/tv/day"), "Series", "Trending TV too")
    assertEqual(externalList.ChartItemType("movie/top_rated"), "Movie", "A movie chart holds movies")
    assertEqual(externalList.ChartItemType("trending/all/week"), "", "The chart that mixes both leaves each result to say")
    assertEqual(externalList.ChartItemType("top250movies"), "", "An IMDb chart is left alone")

    show = { type: "Series", providerIds: { Tmdb: "1585", Imdb: "tt0000001" } }
    assertEqual(providerKeys(show).Join(","), "tmdb.Series.1585,imdb.tt0000001", "A show is keyed by its type with its TMDB id and by its IMDb id alone")
    assertEqual(providerKeys({ Type: "Movie", ProviderIds: { Tmdb: 1585 } }).Join(","), "tmdb.Movie.1585", "A movie with the same TMDB id is a different key")
    assertEqual(providerKeys({ Type: "Episode", ProviderIds: { Tmdb: "7" } }).Count(), 0, "Only movies and shows are keyed by TMDB id")
    assertEqual(providerKeys({ Type: "Movie" }).Count(), 0, "No ids, no keys")

    index = {}
    indexByProviderIds(index, { Type: "Series", ProviderIds: { Tmdb: "1585" } }, "dragon-tales")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Tmdb: "1585", Imdb: "tt0038650" } }, "wonderful-life")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Imdb: "tt0038650" } }, "a-copy")
    assertEqual(index["tmdb.Series.1585"], "dragon-tales", "The show keeps its key")
    assertEqual(index["tmdb.Movie.1585"], "wonderful-life", "The movie keeps its own")
    assertEqual(index["imdb.tt0038650"], "wonderful-life", "The first title with an id keeps it")

    savedGlobal = m.global
    m.global = { device: { locale: "es_ES" } }
    assertEqual(externalList.Localized({ source: "imdb" }).language, "es-ES", "The device locale goes out as a language tag")

    m.global = {}
    assertEqual(externalList.Localized({ source: "imdb" }).DoesExist("language"), false, "No locale sends no language")
    m.global = savedGlobal
end sub

' The order the IMDb, TMDB and Seerr rows' sort settings put a list in
sub testExternalRowSorting()
    chart = [
        { name: "Metropolis", productionYear: 1927, rating: 8.3 },
        { name: "M", productionYear: 1931, rating: 8.3 },
        { name: "City Lights", productionYear: 1931, rating: 8.5 },
        { name: "The Kid", productionYear: 1921, rating: 8.2 }
    ]
    assertEqual(sortedNames(chart, "none", "ascending"), "Metropolis,M,City Lights,The Kid", "The list's own order stays without a sort")
    assertEqual(sortedNames(chart, "releaseDate", "ascending"), "The Kid,Metropolis,City Lights,M", "Oldest first, with a shared year going to the name")
    assertEqual(sortedNames(chart, "releaseDate", "descending"), "City Lights,M,Metropolis,The Kid", "Newest first, and a tie still goes to the name in order")
    assertEqual(sortedNames(chart, "rating", "descending"), "City Lights,M,Metropolis,The Kid", "Highest rated first")
    assertEqual(sortedNames(chart, "name", "descending"), "The Kid,Metropolis,M,City Lights", "Names run backward")
    assertEqual(sortedNames([{ name: "A", popularity: 12 }, { name: "B", popularity: 80 }, { name: "C" }], "popularity", "descending"), "B,A,C", "A title without a popularity counts as zero")
    assertEqual(sortedNames(chart, "shuffle", "ascending").Split(",").Count(), 4, "A shuffle keeps every title")

    entry = externalList.SortEntry({ title: "Parasite", release_date: "2019-05-30", vote_average: 8.5, popularity: 40.5 }, "card")
    assertEqual(entry.name, "parasite", "A Seerr movie sorts by its title")
    assertEqual(entry.year, 2019, "and the year it was released")
    assertEqual(entry.rating, 8.5, "and Seerr's vote average")
    assertEqual(entry.value, "card", "The card goes along with it")
    assertEqual(externalList.SortEntry({ name: "Severance", first_air_date: "2022-02-18" }, invalid).year, 2022, "A Seerr show goes by its first air date")
end sub

function sortedNames(items as object, sortBy as string, sortOrder as string) as string
    entries = []
    for each item in items
        entries.push(externalList.SortEntry(item, item.name))
    end for
    return externalList.Sorted(entries, sortBy, sortOrder).Join(",")
end function

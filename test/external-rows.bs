sub testExternalRows()
    assertEqual(externalList.ChartItemType("tv/popular"), "Series", "A TV chart holds shows")
    assertEqual(externalList.ChartItemType("trending/tv/day"), "Series", "Trending TV too")
    assertEqual(externalList.ChartItemType("movie/top_rated"), "Movie", "A movie chart holds movies")
    assertEqual(externalList.ChartItemType("trending/all/week"), "", "The chart that mixes both leaves each result to say")
    assertEqual(externalList.ChartItemType("top250movies"), "", "An IMDb chart is left alone")

    show = { type: "Series", providerIds: { Tmdb: "1585", Imdb: "tt0000001" } }
    assertEqual(providerKeys(show).Join(","), "tmdb.Series.1585,imdb.tt0000001", "A show is keyed by its type with its TMDB id and by its IMDb id alone")
    assertEqual(providerKeys({ Type: "Movie", ProviderIds: { Tmdb: 1585 } }).Join(","), "tmdb.Movie.1585", "A movie with the same TMDB id is a different key")
    assertEqual(providerKeys({ Type: "Episode", ProviderIds: { Tmdb: "7" } }).Count(), 0, "Only movies and shows are keyed by TMDB id")
    assertEqual(providerKeys({ Type: "Movie" }).Count(), 0, "No ids, no keys")

    index = {}
    indexByProviderIds(index, { Type: "Series", ProviderIds: { Tmdb: "1585" } }, "dragon-tales")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Tmdb: "1585", Imdb: "tt0038650" } }, "wonderful-life")
    indexByProviderIds(index, { Type: "Movie", ProviderIds: { Imdb: "tt0038650" } }, "a-copy")
    assertEqual(index["tmdb.Series.1585"], "dragon-tales", "The show keeps its key")
    assertEqual(index["tmdb.Movie.1585"], "wonderful-life", "The movie keeps its own")
    assertEqual(index["imdb.tt0038650"], "wonderful-life", "The first title with an id keeps it")

    sampleA = { name: "Zebra", premiereDate: "2024-05-20", communityRating: 7.5, popularity: 100.0 }
    sampleB = { name: "Alpha", premiereDate: "2020-01-15", communityRating: 8.9, popularity: 50.0 }
    sampleC = { name: "Beta", productionYear: 1994, communityRating: 9.3, popularity: 200.0 }
    sampleD = { name: "Gamma", productionYear: 0, communityRating: 0.0, popularity: 0.0 }
    items = [sampleA, sampleB, sampleC, sampleD]

    noneSorted = externalList.SortItems(items, "none", "ascending")
    assertEqual(noneSorted[0].name, "Zebra", "None leaves original order")
    assertEqual(noneSorted[1].name, "Alpha", "None leaves original order")

    nameAsc = externalList.SortItems(items, "name", "ascending")
    assertEqual(nameAsc[0].name, "Alpha", "Name asc: Alpha first")
    assertEqual(nameAsc[1].name, "Beta", "Name asc: Beta second")
    assertEqual(nameAsc[2].name, "Gamma", "Name asc: Gamma third")
    assertEqual(nameAsc[3].name, "Zebra", "Name asc: Zebra last")

    nameDesc = externalList.SortItems(items, "name", "descending")
    assertEqual(nameDesc[0].name, "Zebra", "Name desc: Zebra first")
    assertEqual(nameDesc[1].name, "Gamma", "Name desc: Gamma second")
    assertEqual(nameDesc[2].name, "Beta", "Name desc: Beta third")
    assertEqual(nameDesc[3].name, "Alpha", "Name desc: Alpha last")

    dateAsc = externalList.SortItems(items, "releaseDate", "ascending")
    assertEqual(dateAsc[0].name, "Beta", "Date asc: 1994 first")
    assertEqual(dateAsc[1].name, "Alpha", "Date asc: 2020 second")
    assertEqual(dateAsc[2].name, "Zebra", "Date asc: 2024 third")
    assertEqual(dateAsc[3].name, "Gamma", "Date asc: missing date last")

    dateDesc = externalList.SortItems(items, "releaseDate", "descending")
    assertEqual(dateDesc[0].name, "Zebra", "Date desc: 2024 first")
    assertEqual(dateDesc[1].name, "Alpha", "Date desc: 2020 second")
    assertEqual(dateDesc[2].name, "Beta", "Date desc: 1994 third")
    assertEqual(dateDesc[3].name, "Gamma", "Date desc: missing date last")

    ratingDesc = externalList.SortItems(items, "rating", "descending")
    assertEqual(ratingDesc[0].name, "Beta", "Rating desc: 9.3 first")
    assertEqual(ratingDesc[1].name, "Alpha", "Rating desc: 8.9 second")
    assertEqual(ratingDesc[2].name, "Zebra", "Rating desc: 7.5 third")
    assertEqual(ratingDesc[3].name, "Gamma", "Rating desc: 0 last")

    popDesc = externalList.SortItems(items, "popularity", "descending")
    assertEqual(popDesc[0].name, "Beta", "Pop desc: 200 first")
    assertEqual(popDesc[1].name, "Zebra", "Pop desc: 100 second")
    assertEqual(popDesc[2].name, "Alpha", "Pop desc: 50 third")
    assertEqual(popDesc[3].name, "Gamma", "Pop desc: 0 last")

    tie1 = { name: "First", premiereDate: "2024-01-01" }
    tie2 = { name: "Second", premiereDate: "2024-01-01" }
    tiesSorted = externalList.SortItems([tie1, tie2], "releaseDate", "descending")
    assertEqual(tiesSorted[0].name, "First", "Stable sort preserves order of equal elements")
    assertEqual(tiesSorted[1].name, "Second", "Stable sort preserves order of equal elements")
end sub

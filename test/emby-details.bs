sub testEmbyDetails()
    m.top = { selectedVideoStreamId: "source" }
    m.trackData = {}
    m.performRotationCheck = false
    SetUpVideoOptions([{ Id: "source", Name: "Film", MediaStreams: [] }])
    assertEqual(m.trackData.videos.Count(), 1, "Detail version picker tolerates absent VideoType")
    SetUpVideoOptions([{ Id: "source", Name: "Film", VideoType: 0, MediaStreams: [] }])
    assertEqual(m.trackData.videos.Count(), 1, "Accept numeric video type")
    SetUpVideoOptions([invalid, { VideoType: "Iso", MediaStreams: [] }])
    assertEqual(m.trackData.videos.Count(), 0, "Ignore malformed source and preserve ISO handling")
    item = normalizeDetailMetadata({ Id: "movie", Type: "Movie", MediaSources: [{ Id: "source", MediaStreams: [{ Type: "Audio", Index: 3 }] }] })
    assertEqual(item.MediaStreams[0].Index, 3, "Use Emby streams nested under media source")
    assertEqual(item.UserData.PlaybackPositionTicks, 0&, "Default absent playback position safely")
    item = normalizeDetailMetadata({ MediaSources: invalid, MediaStreams: {}, UserData: { IsFavorite: true, PlaybackPositionTicks: 1200000000& } })
    assertEqual(item.MediaSources.Count(), 0, "Missing sources are an empty list")
    assertEqual(item.MediaStreams.Count(), 0, "Malformed streams are an empty list")
    assertEqual(item.UserData.IsFavorite, true, "Preserve real favorite state")
    assertEqual(item.UserData.PlaybackPositionTicks, 1200000000&, "Preserve real resume point")

    before = [{ Type: "Video" }, { Type: "Audio" }, { Type: "Audio" }, { Type: "Subtitle" }]
    after = [{ Type: "Subtitle" }, { Type: "Video" }, { Type: "Audio" }, { Type: "Audio" }, { Type: "Subtitle" }]
    assertEqual(audioOrdinal(before, 2), 1, "The second audio stream is the second whatever sits before it")
    assertEqual(audioStreamPosition(after, audioOrdinal(before, 2)), 3, "A downloaded subtitle listed first moves the picked audio down one place")
    assertEqual(audioOrdinal(before, 3), -1, "A subtitle isnt an audio pick")
    assertEqual(audioStreamPosition(after, 5), -1, "An audio stream that isnt there is no place")
end sub

' An Emby channel item's placeholder source is left off PlaybackInfo, and a pinned source that fails
' is asked for again without its id
sub testPlaceholderSource()
    placeholder = { Type: "Movie", MediaSources: [{ Id: "ph", MediaStreams: [] }] }
    assertEqual(isStreamlessStaticSource(placeholder, "ph"), true, "A single source with no streams is a placeholder")
    assertEqual(isStreamlessStaticSource(placeholder, "other"), false, "Another id isn't the placeholder")
    assertEqual(isStreamlessStaticSource({ Type: "TvChannel", MediaSources: [{ Id: "ph" }] }, "ph"), false, "A live channel keeps its source id")
    assertEqual(isStreamlessStaticSource({ Type: "Movie", MediaStreams: [{ Type: "Video" }], MediaSources: [{ Id: "ph" }] }, "ph"), false, "An item that lists its streams was probed")
    assertEqual(isStreamlessStaticSource({ Type: "Movie", MediaSources: [{ Id: "a" }, { Id: "b" }] }, "a"), false, "Several versions aren't a placeholder")

    assertEqual(isUnprobedPlaceholder({ Id: "ph", MediaStreams: [] }), true, "A returned source with nothing playable is the placeholder")
    assertEqual(isUnprobedPlaceholder({ Id: "ph", SupportsDirectPlay: true }), false, "A source that direct plays isn't a placeholder")
    assertEqual(isUnprobedPlaceholder({ Id: "live", LiveStreamId: "1" }), false, "A live stream isn't a placeholder")
    probed = probedSources({ MediaSources: [{ Id: "ph", MediaStreams: [] }, { Id: "real", MediaStreams: [{ Type: "Video" }] }] })
    assertEqual(probed.Count(), 1, "Only probed sources are kept")
    assertEqual(probed[0].Id, "real", "The probed source is the real file")

    assertEqual(canRetryWithoutMediaSourceId({ MediaSources: [{ Id: "rec" }] }, "rec"), true, "A single version recording asks again without its id")
    assertEqual(canRetryWithoutMediaSourceId({ MediaSources: [{ Id: "a" }, { Id: "b" }] }, "b"), false, "A picked version of several keeps its id")
    assertEqual(canRetryWithoutMediaSourceId({ MediaSources: [{ Id: "a" }, { Id: "b" }] }, "gone"), true, "A stale id asks again")
    assertEqual(canRetryWithoutMediaSourceId({ MediaSources: [{ Id: "a" }] }, ""), false, "Nothing pinned has nothing to retry")
end sub

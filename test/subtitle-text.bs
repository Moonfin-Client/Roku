sub testSubtitleText()
    srt = Chr(65279) + "1" + Chr(13) + Chr(10) + "00:00:01,500 --> 00:00:03,250" + Chr(13) + Chr(10) + "<i>Hello</i>" + Chr(13) + Chr(10) + "there" + Chr(13) + Chr(10) + Chr(13) + Chr(10) + "2" + Chr(13) + Chr(10) + "01:02:03,4 --> 01:02:05,000" + Chr(13) + Chr(10) + "{\an8}Up top"
    cues = subtitleText.Parse(srt)
    assertEqual(cues.Count(), 2, "Each SRT block is a cue")
    assertEqual(cues[0]["start"], 1500, "An SRT start is read in milliseconds")
    assertEqual(cues[0]["end"], 3250, "An SRT end is read in milliseconds")
    assertEqual(cues[0]["text"].Join("|"), "Hello|there", "Tags come off and each line stays its own")
    assertEqual(cues[1]["start"], 3723400, "Hours count, and a short fraction is tenths")
    assertEqual(cues[1]["text"].Join("|"), "Up top", "A position override comes off")

    vtt = "WEBVTT" + Chr(10) + Chr(10) + "00:05.000 --> 00:06.500 line:90%" + Chr(10) + "No hours"
    cues = subtitleText.Parse(vtt)
    assertEqual(cues.Count(), 1, "The WebVTT header is no cue")
    assertEqual(cues[0]["start"], 5000, "A WebVTT time can leave out the hours")
    assertEqual(cues[0]["end"], 6500, "Cue settings after the time are skipped")

    ass = "[Script Info]" + Chr(10) + "Title: x" + Chr(10) + Chr(10) + "[Events]" + Chr(10) + "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text" + Chr(10) + "Dialogue: 0,0:00:10.50,0:00:12.00,Default,,0,0,0,,{\b1}Bold,\Nand a comma" + Chr(10) + "Dialogue: 0,0:00:13.00,0:00:14.00,Default,,0,0,0,,{\p1}"
    cues = subtitleText.Parse(ass)
    assertEqual(cues.Count(), 1, "A Dialogue line with nothing left to show is dropped")
    assertEqual(cues[0]["start"], 10500, "An ASS time is read in milliseconds")
    assertEqual(cues[0]["end"], 12000, "An ASS end is read too")
    assertEqual(cues[0]["text"].Join("|"), "Bold,|and a comma", "The text keeps its commas and breaks on \N")
end sub

' A collection's playlist in each order it can be put in, and the titles the library is missing
' slotted into a collection's own page
sub testCollectionSort()
    carol = { json: { Id: "c", Name: "Carol", PremiereDate: "2001-01-01" } }
    alpha = { json: { Id: "a", Name: "alpha", PremiereDate: "1999-01-01" } }
    bravo = { json: { Id: "b", Name: "Bravo", PremiereDate: "2010-01-01" } }
    library = [carol, alpha, bravo]

    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_SERVER, [])), "c,a,b", "A collection keeps the order the server sent by default")
    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_RELEASE_ASCENDING, [])), "a,c,b", "Release order goes oldest first")
    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_RELEASE_DESCENDING, [])), "b,c,a", "and turns round on request")
    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_ALPHABETICAL, [])), "a,b,c", "Alphabetical ignores case")
    assertEqual(cardIds(library), "c,a,b", "Sorting leaves the list it was given alone")

    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_CUSTOM, ["b", "a", "c"])), "b,a,c", "Custom follows a saved order")
    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_CUSTOM, ["b"])), "b,a,c", "Titles added since the order was saved go on the end in release order")
    assertEqual(cardIds(collectionSort.Apply(library, collectionSort.SORT_CUSTOM, ["x", "b", "b"])), "b,a,c", "A saved order lists each title once and skips one that's gone")

    undated = { json: { Id: "u", Name: "Undated" } }
    yearOnly = { json: { Id: "y", Name: "Year Only", ProductionYear: 2005 } }
    twin = { json: { Id: "t", Name: "Twin", PremiereDate: "2001-01-01" } }
    mixed = [undated, bravo, yearOnly, twin, carol]
    assertEqual(cardIds(collectionSort.Apply(mixed, collectionSort.SORT_RELEASE_ASCENDING, [])), "c,t,y,b,u", "Release order falls back to the year, puts undated titles last and settles ties by name")
    assertEqual(cardIds(collectionSort.Apply(mixed, collectionSort.SORT_RELEASE_DESCENDING, [])), "u,b,y,t,c", "Descending puts undated titles first and ties from Z to A")
    same = collectionSort.Apply([{ json: { Id: "1", Name: "Same" } }, { json: { Id: "2", Name: "same" } }], collectionSort.SORT_ALPHABETICAL, [])
    assertEqual(cardIds(same), "1,2", "Titles that tie keep the server's order")

    rows = collectionSort.Choices(collectionSort.SORT_CUSTOM, true)
    assertEqual(choiceNames(rows), "server,releaseAscending,releaseDescending,alphabetical,custom", "Every order is offered once there's a saved one")
    assertEqual(choiceNames(collectionSort.Choices(collectionSort.SORT_SERVER, false)), "server,releaseAscending,releaseDescending,alphabetical", "Without a saved order Custom isn't offered")
    assertEqual(rows[4].selected, true, "The order in use is marked")
    assertEqual(rows[0].DoesExist("selected"), false, "and no other")
    assertEqual(rows[1].description, "Release Order (Ascending)", "Each row is named for its order")
    assertEqual(collectionSort.Label(collectionSort.SORT_CUSTOM), "Custom Order", "The custom order is named without promising a gesture")
    assertEqual(collectionSort.Label(collectionSort.SORT_SERVER), "Server Order", "The server's order is named for it")
    assertEqual(collectionSort.Initial(["b"]), collectionSort.SORT_CUSTOM, "A saved order opens the page on Custom")
    assertEqual(collectionSort.Initial([]), collectionSort.SORT_SERVER, "Without one it opens on the server's order")
    assertEqual(collectionSort.Initial(invalid), collectionSort.SORT_SERVER, "and so it does when Moonbase has nothing to say")

    missingCard = { json: { Id: "seerr-movie-9", Name: "Missing", Type: "Movie", SeerrMissing: true, SeerrItem: { id: 9 } } }
    movie = { json: { Id: "m", Name: "Movie", Type: "Movie" } }
    episode = { json: { Id: "e", Name: "Episode", Type: "Episode" } }
    show = { json: { Id: "s", Name: "Show", Type: "Series" } }
    assertEqual(cardIds(collectionPlaylist([movie, missingCard, show, episode])), "m,e", "A title the library is missing stays out of the play queue, and so does a series, but an episode goes in")
    assertEqual(itemMenu.IsFromSeerr(missingCard.json), true, "A missing title gets no card menu, so nothing offers to edit the collection with it")

    unchanged = [slotTitle("B", "1990-01-01", invalid), slotTitle("A", "1980-01-01", invalid)]
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease(unchanged, [])), "B,A", "The library list is left alone when nothing is missing")
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease([slotTitle("First", "1980-01-01", invalid), slotTitle("Third", "2000-01-01", invalid)], [slotTitle("Second", "1990-01-01", invalid)])), "First,Second,Third", "A missing title goes in front of the first one released after it")
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease([slotTitle("Later", "2000-01-01", invalid), slotTitle("Earlier", "1980-01-01", invalid)], [slotTitle("Missing", "1990-01-01", invalid)])), "Missing,Later,Earlier", "without the rest being sorted again")
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease([slotTitle("A", "1980-01-01", invalid)], [slotTitle("Undated", invalid, invalid)])), "A,Undated", "A missing title with no date goes at the end")
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease([slotTitle("A", invalid, 1980), slotTitle("C", invalid, 2000)], [slotTitle("B", invalid, 1990)])), "A,B,C", "The production year stands in for a date on either side")
    assertEqual(missingNames(seerrMissingCollection.SlotByRelease([slotTitle("A", "1980-01-01", invalid)], [slotTitle("B", "1990-01-01", invalid)])), "A,B", "It goes on the end when everything in the library came out earlier")
end sub

function choiceNames(rows as object) as string
    names = []
    for each row in rows
        names.push(row.Name)
    end for
    return names.Join(",")
end function

function slotTitle(name as string, premiere as dynamic, year as dynamic) as object
    return { Name: name, PremiereDate: premiere, ProductionYear: year }
end function

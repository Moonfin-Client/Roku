sub testRatingsScope()
    savedGlobal = m.global
    m.global = {
        session: {
            pluginInfo: { installed: true },
            user: { settings: { "plugin.enabled": "true", "plugin.mdblist.enabled": false, "ui.home.ratings.enabled": true, "plugin.tmdb.episodeRatings": true, "ui.home.ratings.episodeRatings": "false" } }
        }
    }

    assertEqual(moonfinPlugin.RatingsSetting("", "ratingSources"), "plugin.mdblist.ratingSources", "Every other screen reads the global sources")
    assertEqual(moonfinPlugin.RatingsSetting("", "episodeRatings"), "plugin.tmdb.episodeRatings", "Every other screen reads the global episode switch")
    assertEqual(moonfinPlugin.RatingsSetting("home", "ratingSources"), "ui.home.ratings.ratingSources", "Home rows read their own sources")
    assertEqual(moonfinPlugin.RatingsSetting("mediaBar", "showRatingBadges"), "ui.mediaBar.ratings.showRatingBadges", "The media bar reads its own badges")

    assertEqual(moonfinPlugin.IsRatingsEnabled(), false, "The details screens follow the global switch")
    assertEqual(moonfinPlugin.IsRatingsEnabled("home"), true, "Home rows follow their own switch")
    assertEqual(moonfinPlugin.IsRatingsEnabled("mediaBar"), true, "A media bar switch nobody set reads as on")
    assertEqual(moonfinPlugin.IsEpisodeRatingsEnabled(), true, "Episode ratings on the details screens follow the global switch")
    assertEqual(moonfinPlugin.IsEpisodeRatingsEnabled("home"), false, "Episode ratings on Home follow the home switch")

    m.global.session.user.settings["plugin.enabled"] = "false"
    assertEqual(moonfinPlugin.IsRatingsEnabled("home"), false, "Without the plugin no surface fetches ratings")

    m.global = savedGlobal
end sub

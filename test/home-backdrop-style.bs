sub testHomeBackdropStyle()
    styles = [
        [{}, "fullScreen", "Nothing stored fills the screen, as the switch always defaulted on"],
        [{ "ui.home.showBackdrop": true }, "fullScreen", "A switch turned on before the style existed fills the screen"],
        [{ "ui.home.showBackdrop": false, "ui.home.backdropStyle": "corner" }, "off", "The switch off wins over the style"],
        [{ "ui.home.showBackdrop": "false", "ui.home.backdropStyle": "fullScreen" }, "off", "A synced false is off"],
        [{ "ui.home.showBackdrop": "true", "ui.home.backdropStyle": "corner" }, "corner", "Corner sits in the corner"],
        [{ "ui.home.backdropStyle": "Corner" }, "corner", "The style is read without case"],
        [{ "ui.home.showBackdrop": "true", "ui.home.backdropStyle": "top" }, "top", "Top runs across the top half"],
        [{ "ui.home.showBackdrop": true, "ui.home.backdropStyle": "off" }, "fullScreen", "An app that only knows the switch turning it back on gets the full screen"],
        [{ "ui.home.showBackdrop": true, "ui.home.backdropStyle": "something new" }, "fullScreen", "A style this app doesn't know fills the screen"]
    ]
    for each entry in styles
        assertEqual(getHomeBackdropStyle(entry[0]), entry[1], entry[2])
    end for
    assertEqual(getHomeBackdropStyle(invalid), "fullScreen", "No settings fills the screen")
end sub

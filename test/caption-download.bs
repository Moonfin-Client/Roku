sub testCaptionDownload()
    assertEqual(trackAddress("{video}http://jellyfin.test/Videos/1/2/Subtitles/3/0/Stream.vtt?ApiKey=key"), "http://jellyfin.test/Videos/1/2/Subtitles/3/0/Stream.vtt", "The address comes out of the name the device wraps it in")
    assertEqual(trackAddress("https://jellyfin.test/Videos/1/2/Subtitles/3/0/Stream.vtt"), "https://jellyfin.test/Videos/1/2/Subtitles/3/0/Stream.vtt", "An address on its own is kept whole")
    assertEqual(trackAddress("{video}http://plex.test:32400/library/streams/41?X-Plex-Token=abc-1_2"), "http://plex.test:32400/library/streams/41?X-Plex-Token=abc-1_2", "A Plex sidecar keeps the token it's read with")
    assertEqual(trackAddress("eia608/1"), "", "A track the device reads from the stream has no address")
    assertEqual(trackAddress(""), "", "No track has no address")
end sub

sub testPlexMapper()
    movie = plexMapper.ItemToJellyfin({
        "ratingKey": "1715",
        "type": "movie",
        "title": "10 Cloverfield Lane",
        "contentRating": "PG-13",
        "rating": 9.1,
        "ratingImage": "rottentomatoes://image.rating.ripe",
        "audienceRating": 7.9,
        "thumb": "/library/metadata/1715/thumb/1792104771",
        "art": "/library/metadata/1715/art/1792104771",
        "duration": 6213916,
        "viewOffset": 1800000,
        "lastViewedAt": 1792123617,
        "originallyAvailableAt": "2016-03-10",
        "Image": [{ "type": "clearLogo", "url": "/library/metadata/1715/clearLogo/1" }],
        "Guids": [{ "id": "imdb://tt1179933" }, { "id": "tmdb://333371" }],
        "Role": [{ "id": 3053, "tag": "John Goodman", "role": "Howard", "thumb": "https://metadata-static.plex.tv/people/goodman.jpg" }],
        "Media": [{
            "container": "mkv",
            "bitrate": 9536,
            "Part": [{
                "key": "/library/parts/3721/1700000000/file.mkv",
                "file": "/media/Movies/10 Cloverfield Lane (2016).mkv",
                "Stream": [
                    { "streamType": 1, "index": 0, "codec": "h264", "width": 1920, "colorTrc": "smpte2084" },
                    { "streamType": 2, "index": 1, "codec": "eac3", "channels": 6 }
                ]
            }]
        }]
    })
    assertEqual(movie.Type, "Movie", "A Plex movie is a Movie")
    assertEqual(movie.RunTimeTicks, 62139160000&, "Its runtime is in ticks")
    assertEqual(movie.CommunityRating, 7.9, "The audience score is the community rating")
    assertEqual(movie.CriticRating, 91, "The critic score is out of a hundred")
    assertEqual(movie.PremiereDate, "2016-03-10T00:00:00.000Z", "The release date is a full date")
    assertEqual(movie.ImageTags.Primary, "/library/metadata/1715/thumb/1792104771", "The poster keeps its Plex path")
    assertEqual(movie.ImageTags.Logo, "/library/metadata/1715/clearLogo/1", "The logo comes from the clear logo image")
    assertEqual(movie.BackdropImageTags[0], "/library/metadata/1715/art/1792104771", "The backdrop keeps its Plex path")
    assertEqual(movie.ProviderIds.Imdb, "tt1179933", "The IMDb id comes from the guids")
    assertEqual(movie.ProviderIds.Tmdb, "333371", "The TMDB id comes from the guids")
    assertEqual(movie.People[0].Id, "person-3053", "A cast member's id says it's a person")
    assertEqual(movie.People[0].Role, "Howard", "A cast member keeps the role")
    assertEqual(movie.People[0].PrimaryImageTag, "https://metadata-static.plex.tv/people/goodman.jpg", "A cast photo is plex.tv's address")
    assertEqual(movie.UserData.PlaybackPositionTicks, 18000000000&, "The resume point is in ticks")
    assertEqual(Int(movie.UserData.PlayedPercentage * 100), 2896, "The played share follows the resume point")
    assertEqual(movie.UserData.LastPlayedDate, "2026-10-16T04:06:57Z", "The last play is a full date")
    assertEqual(movie.MediaSources[0].Id, "1715-0", "A source id names the version")
    assertEqual(movie.MediaSources[0].Bitrate, 9536000, "A source bitrate is in bits")
    assertEqual(movie.MediaSources[0].DirectStreamUrl, "/library/parts/3721/1700000000/file.mkv", "A source plays from its part")
    assertEqual(movie.MediaStreams[0].VideoRange, "HDR", "PQ video is HDR")
    assertEqual(movie.MediaStreams[0].VideoRangeType, "HDR10", "PQ video with no Dolby Vision is HDR10")
    assertEqual(inArray([5, 7, 8, 10], invalid), false, "A stream with no Dolby Vision profile has none of the listed ones")

    episode = plexMapper.ItemToJellyfin({
        "ratingKey": "17100",
        "parentRatingKey": "17099",
        "grandparentRatingKey": "17098",
        "type": "episode",
        "title": "Countdown",
        "grandparentTitle": "3 Body Problem",
        "parentTitle": "Season 1",
        "index": 1,
        "parentIndex": 1,
        "thumb": "/library/metadata/17100/thumb/1",
        "art": "/library/metadata/17098/art/1",
        "grandparentThumb": "/library/metadata/17098/thumb/1",
        "viewCount": 1,
        "Image": [{ "type": "clearLogo", "url": "/library/metadata/17098/clearLogo/1" }]
    })
    assertEqual(episode.SeriesId, "17098", "An episode points at its show")
    assertEqual(episode.SeasonId, "17099", "An episode points at its season")
    assertEqual(episode.BackdropImageTags.Count(), 0, "The show's art isn't the episode's own")
    assertEqual(episode.ParentBackdropItemId, "17098", "The backdrop comes from the show")
    assertEqual(episode.ParentLogoImageTag, "/library/metadata/17098/clearLogo/1", "The logo comes from the show")
    assertEqual(episode.UserData.Played, true, "A viewed episode is played")
    assertEqual(episode.MediaSources, invalid, "An episode with no media has no sources")

    show = plexMapper.ItemToJellyfin({ "ratingKey": "17098", "type": "show", "childCount": 1, "leafCount": 8, "viewedLeafCount": 1, "userRating": 10 })
    assertEqual(show.Type, "Series", "A Plex show is a Series")
    assertEqual(show.RecursiveItemCount, 8, "A show counts its episodes")
    assertEqual(show.UserData.UnplayedItemCount, 7, "A show counts the episodes left")
    assertEqual(show.UserData.IsFavorite, true, "A 10 is a favorite")

    captions = plexMapper.ItemToJellyfin({ "ratingKey": "1804", "type": "movie", "Media": [{ "Part": [{ "Stream": [
        { "id": 9480, "index": 0, "streamType": 1, "codec": "h264" },
        { "id": 9481, "index": 1, "streamType": 2, "codec": "eac3" },
        { "id": 9482, "index": 0, "streamType": 3, "codec": "eia_608", "embeddedInVideo": "1" },
        { "id": 9483, "streamType": 3, "codec": "srt", "key": "/library/streams/9483" }
    ] }] }] })
    assertEqual(captions.MediaStreams.Count(), 3, "Captions carried in the video are left out")
    assertEqual(captions.MediaStreams[2].Index, 9483, "A sidecar is numbered by its stream id")
    assertEqual(captions.MediaStreams[2].DeliveryUrl, "/library/streams/9483", "A sidecar is read from its own address")
    assertEqual(captions.MediaStreams[2].DeliveryMethod, "External", "A sidecar is delivered as a file")

    stack = { "ratingKey": "23071", "type": "movie", "title": "Stack Test", "duration": 200000, "Media": [{ "duration": 200000, "Part": [
        { "id": 1, "key": "/library/parts/1/file.mkv", "file": "/m/Stack Test pt1.mkv", "duration": 120000 },
        { "id": 2, "key": "/library/parts/2/file.mkv", "file": "/m/Stack Test pt2.mkv", "duration": 80000 }
    ] }] }
    assertEqual(plexMapper.ItemToJellyfin(stack).PartCount, 2, "A split movie counts its files")
    second = plexMapper.AdditionalParts(stack, 0)[0]
    assertEqual(second.Id, "part-23071-0-1", "A later file is a part item")
    assertEqual(second.Name, "Stack Test pt2", "A part is named for its file")
    assertEqual(second.RunTimeTicks, 800000000&, "A part runs as long as its file")
    assertEqual(plexMapper.PartOf(second.Id).partIndex, 1, "A part id names its file")
    assertEqual(plexMapper.SourceOf("23071-1").mediaIndex, 1, "A source id names its version")
    assertEqual(plexMapper.SourceOf("23071").mediaIndex, 0, "A bare id is the first version")

    chapters = plexMapper.ItemToJellyfin({ "ratingKey": "19722", "type": "episode", "Chapter": [{ "startTimeOffset": -40, "tag": "Opening" }, { "startTimeOffset": 60000, "thumb": "/library/media/1/chapterImages/2" }] }).Chapters
    assertEqual(chapters[0].StartPositionTicks, 0, "A chapter never starts before zero")
    assertEqual(chapters[0].Name, "Opening", "A chapter keeps its name")
    assertEqual(chapters[1].StartPositionTicks, 600000000&, "A chapter start is in ticks")
    assertEqual(chapters[1].ImageTag, "/library/media/1/chapterImages/2", "A chapter keeps its picture")

    assertEqual(plexPlayback.HlsAudio("AC3,mp3,flac,pcm"), "ac3,mp3", "A transcode only ends in audio Plex can stream, in the profile's order")
    assertEqual(plexPlayback.HlsAudio("flac,pcm"), "aac", "A list with none Plex can stream ends in aac")
    assertEqual(plexPlayback.HlsAudio(invalid), "aac", "No list ends in aac")
    assertEqual(plexPlayback.Names("hevc,h265,mpeg4 avc", "h264"), "hevc,h264", "The device profile's codec aliases go by Plex's names")

    plex = "http://plex.test:32400"
    url = plexUrls.ImageURL(plex, "17100", "Backdrop", { maxWidth: 1280, tag: "/library/metadata/17098/art/1" }, "tok")
    assertEqual(url.Left(Len(plex + "/photo/:/transcode?")), plex + "/photo/:/transcode?", "A sized image goes through the photo transcoder")
    for each piece in ["width=1280", "height=5120", "url=%2Flibrary%2Fmetadata%2F17098%2Fart%2F1", "X-Plex-Token=tok"]
        assertEqual(Instr(1, url, piece) > 0, true, "The transcoded image asks for " + piece)
    end for
    assertEqual(plexUrls.ImageURL(plex, "person-1", "Primary", { tag: "https://metadata-static.plex.tv/p.jpg" }, "tok"), "https://metadata-static.plex.tv/p.jpg", "A cast photo stays as it is")
    assertEqual(plexUrls.ImageURL(plex, "section-1", "Primary", {}, "tok"), "", "A library has no picture of its own")
    assertEqual(plexUrls.Str(1969753000), "1969753000", "A large id is written out in full")
    assertEqual(plexUrls.Str(1.78), "1.78", "A fraction is written as it is")
    assertEqual(plexUrls.Query({ "profile": "a b+c" }), "profile=a%20b%2Bc", "A space goes as %20, never as a plus")
    assertEqual(plexUrls.IsNative("/library/parts/1/file.mkv"), true, "A Plex path is Plex's own")
    assertEqual(plexUrls.IsNative("/Items/1"), false, "A Jellyfin route is the bridge's")
end sub

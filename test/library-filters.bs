sub testLibraryFilters()
    tags = facetLabels(["action", "Amélie", "anime", "biopic", "comedy", "cult", "drama", "heist", "noir", "western"])

    assertEqual(libraryFilters.FacetRows(tags, [], "", 50).searchable, true, "A list of ten values offers a search")
    short = []
    for i = 0 to 8
        short.push(tags[i])
    end for
    assertEqual(libraryFilters.FacetRows(short, [], "", 50).searchable, false, "A shorter list is left to scroll")

    assertEqual(facetValues(libraryFilters.FacetRows(tags, [], "AMELIE", 50).visible), "Amélie", "The search ignores case and accents")
    assertEqual(facetValues(libraryFilters.FacetRows(tags, [], " an", 50).visible), "anime", "The search ignores spaces around what was typed")

    nothing = libraryFilters.FacetRows(tags, [], "zzz", 50)
    assertEqual(nothing.noMatches, true, "A search that finds nothing says so")
    assertEqual(nothing.visible.count(), 0, "And lists nothing")
    assertEqual(libraryFilters.FacetRows([tags[0], tags[1], tags[2]], [], "zzz", 50).visible.count(), 3, "A short list stays whole whatever is typed")

    languages = []
    for i = 0 to tags.count() - 1
        languages.push({ value: "code" + i.toStr(), label: tags[i].label })
    end for
    assertEqual(facetValues(libraryFilters.FacetRows(languages, [], "noir", 50).visible), "code8", "A language is found by its name, not its code")

    paged = libraryFilters.FacetRows(tags, ["western"], "", 2)
    assertEqual(facetValues(paged.visible), "action,Amélie,western", "A picked value stays on screen past the page limit")
    assertEqual(paged.remaining, 7, "And the rest are counted")
end sub

function facetLabels(names as object) as object
    options = []
    for each name in names
        options.push({ value: name, label: name })
    end for
    return options
end function

function facetValues(options as object) as string
    values = []
    for each option in options
        values.push(option.value)
    end for
    return values.Join(",")
end function

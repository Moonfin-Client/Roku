sub testSubtitleBurnIn()
    m.global = { queueManager: { force: PlaybackMethod.PLAYNORMALLY, callFunc: testQueueManagerCall } }
    streams = [
        { Type: "Subtitle", Codec: "subrip", Index: 1, IsTextSubtitleStream: true, DeliveryMethod: "External" },
        { Type: "Subtitle", Codec: "PGSSUB", Index: 2, IsTextSubtitleStream: false, DeliveryMethod: "Encode" },
        { Type: "Subtitle", Codec: "ass", Index: 3, IsTextSubtitleStream: true, DeliveryMethod: "Encode" },
        { Type: "Subtitle", Codec: "subrip", Index: 4, IsTextSubtitleStream: true, DeliveryMethod: "Hls" }
    ]
    audioOnly = "/videos/1/master.m3u8?VideoCodec=h264&TranscodeReasons=AudioChannelsNotSupported"
    m.playbackInfo = { MediaSources: [{ TranscodingUrl: audioOnly, MediaStreams: streams }] }

    assertEqual(shouldBurnInSubtitle(SubtitleSelection.NONE), false, "No subtitle leaves nothing to burn in")
    assertEqual(shouldBurnInSubtitle(1), false, "An SRT sent as its own file isnt burned into an audio transcode")
    assertEqual(shouldBurnInSubtitle(4), false, "A text subtitle the server sends in the stream isnt burned in either")
    assertEqual(shouldBurnInSubtitle(2), true, "A picture subtitle is still burned in")
    assertEqual(shouldBurnInSubtitle(3), true, "A text subtitle the server has to encode is still burned in")
    assertEqual(shouldBurnInSubtitle(9), true, "A subtitle missing from the answer is burned in as before")

    m.playbackInfo.MediaSources[0].TranscodingUrl = "/videos/1/master.m3u8?TranscodeReasons=ContainerNotSupported,AudioCodecNotSupported"
    assertEqual(shouldBurnInSubtitle(1), false, "A remux for the container and audio still copies the video")
    m.playbackInfo.MediaSources[0].TranscodingUrl = "/videos/1/master.m3u8?TranscodeReasons=AudioCodecNotSupported,VideoBitrateNotSupported"
    assertEqual(shouldBurnInSubtitle(1), true, "Once the video is encoded again the SRT is burned in")
    assertEqual(shouldBurnInSubtitle(SubtitleSelection.NONE), true, "A video transcode burns in whatever is picked later, as it always has")
    m.playbackInfo.MediaSources[0].TranscodingUrl = "/videos/1/master.m3u8?VideoCodec=h264"
    assertEqual(shouldBurnInSubtitle(1), true, "A transcode that gives no reason is burned in as before")

    m.playbackInfo.MediaSources[0].TranscodingUrl = audioOnly
    m.global.queueManager.force = PlaybackMethod.FORCETRANSCODEDISABLEREMUX
    assertEqual(shouldBurnInSubtitle(1), true, "A forced video transcode burns the SRT in")
    m.global.queueManager.force = PlaybackMethod.FORCETRANSCODEALLOWREMUX
    assertEqual(shouldBurnInSubtitle(1), false, "A forced remux still copies the video")

    m.playbackInfo = { MediaSources: [] }
    assertEqual(shouldBurnInSubtitle(1), true, "An answer with no media source is burned in as before")
end sub

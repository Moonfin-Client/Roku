' What the settings preview draws for the audio and Collections Row Options
sub testRowOptionsPreview()
    assertEqual(rowOptionsPreview.Group("ui.home.audioRowsSortOrder"), "audio", "The audio sort order changes the Audio row")
    assertEqual(rowOptionsPreview.Group("ui.home.collectionsRowShowEpisodes"), "collections", "Show Episodes changes the Collections rows")
    assertEqual(rowOptionsPreview.Group("ui.home.genresRowSortBy"), "", "Another row's setting isn't one of them")

    picked = { "pluginDynamic:collections:s:collection:1": "Sci-Fi" }
    arranged = ["resume", "pluginDynamic:collections:s:collection:1", "collections", "audio", "latestmedia"]
    assertEqual(rowOptionsPreview.EditedRow("ui.home.audioRowsSortBy", arranged, picked), "audio", "The audio settings draw the Audio row")
    assertEqual(rowOptionsPreview.EditedRow("ui.home.collectionsRowSortBy", arranged, picked), "pluginDynamic:collections:s:collection:1", "The Collections sort draws whichever of its rows Home reaches first")
    assertEqual(rowOptionsPreview.EditedRow("ui.home.collectionsRowShowEpisodes", ["collections", "pluginDynamic:collections:s:collection:1"], picked), "pluginDynamic:collections:s:collection:1", "Show Episodes skips the Collections row, which it doesn't change")
    assertEqual(rowOptionsPreview.EditedRow("ui.home.collectionsRowShowEpisodes", ["collections"], {}), "", "and with no collection added as a row it has none")
    assertEqual(rowOptionsPreview.EditedRow("ui.home.audioRowsSortBy", ["resume"], picked), "", "A row off in Rows isn't drawn")

    on = { "ui.home.displayAudioRows": "true", "ui.home.displayCollectionsRows": "true" }
    assertEqual(rowOptionsPreview.Blocked("ui.home.audioRowsSortBy", on, "audio"), "", "A row on Home can be drawn")
    assertEqual(rowOptionsPreview.Blocked("ui.home.displayAudioRows", { "ui.home.displayAudioRows": "false" }, "audio"), "display", "Its Display switch off keeps it off, even while Rows has it on")
    assertEqual(rowOptionsPreview.Blocked("ui.home.collectionsRowSortOrder", on, ""), "rows", "Every row off in Rows keeps it off")
    assertEqual(rowOptionsPreview.Blocked("ui.home.collectionsRowShowEpisodes", on, ""), "picked", "Show Episodes with no collection added as a row says so")
    assertEqual(rowOptionsPreview.Blocked("ui.home.genresRowSortBy", on, ""), "", "Another row's setting isn't blocked")

    assertEqual(rowOptionsPreview.Status("ui.home.displayAudioRows", "display"), "Turn on Display Audio Rows, then turn the row on in Rows", "The inspector names the switch to turn on first")
    assertEqual(rowOptionsPreview.Status("ui.home.audioRowsSortBy", ""), "", "and says nothing extra when the row can be drawn")
    assertEqual(rowOptionsPreview.Notice("ui.home.audioRowsSortBy", "rows"), "The Audio row is off. To show it, go to Rows and turn on Music under Disabled.", "The note names the row the way Rows lists it")
    assertEqual(rowOptionsPreview.Notice("ui.home.displayAudioRows", "display"), "The Audio row is off. To show it, turn this on, then go to Rows and turn on Music under Disabled.", "On its Display switch the note says to turn this on")
    assertEqual(rowOptionsPreview.Notice("ui.home.audioRowsSortBy", "display"), "The Audio row is off. To show it, turn on Display Audio Rows, then go to Rows and turn on Music under Disabled.", "and on a sort it names the switch")
    assertEqual(rowOptionsPreview.Notice("ui.home.collectionsRowShowEpisodes", "display"), "The Collections row is off. To show it, turn on Display Collections Rows, then go to Rows and turn on Collections under Disabled.", "the same for the Collections settings")
    assertEqual(rowOptionsPreview.Notice("ui.home.audioRowsSortBy", "empty"), "There's no music to show, so Home leaves the Audio row out.", "and says when there's nothing to show")

    assertEqual(rowOptionsPreview.Caption("ui.home.collectionsRowSortBy", "collections", arranged), "", "The Collections row needs no note")
    assertEqual(rowOptionsPreview.Caption("ui.home.collectionsRowSortBy", "pluginDynamic:collections:s:collection:1", ["pluginDynamic:collections:s:collection:1"]), "The Collections row is off, so this only changes the collections added as rows of their own.", "A collection row alone says the Collections row is off")
    assertEqual(rowOptionsPreview.Caption("ui.home.collectionsRowSortBy", "pluginDynamic:collections:s:collection:1", arranged), "", "A collection row ahead of the Collections row doesn't call that row off")
    assertEqual(rowOptionsPreview.Caption("ui.home.collectionsRowShowEpisodes", "pluginDynamic:collections:s:collection:1", arranged), "This only changes a collection added as a row of its own. The Collections row looks the same.", "Show Episodes says the Collections row doesn't change")
    assertEqual(rowOptionsPreview.Caption("ui.home.audioRowsSortBy", "audio", arranged), "", "The audio settings need no note")

    shown = ["resume", "pluginDynamic:collections:s:collection:1", "collections", "audio", "latestmedia", "latestmedia"]
    assertEqual(rowOptionsPreview.RowsAfter("collections", arranged, shown), 3, "The rows below start right after the edited one")
    assertEqual(rowOptionsPreview.RowsAfter("audio", arranged, ["resume", "latestmedia", "latestmedia"]), 1, "A row Home doesn't have yet sits where Rows puts it")
    assertEqual(rowOptionsPreview.RowsAfter("audio", arranged, ["resume", "audio", "Recently Added in Movies"]), 2, "A row Rows doesn't name goes with the one before it")
    assertEqual(rowOptionsPreview.RowsAfter("latestmedia", arranged, ["resume", "latestmedia"]), 2, "The last row has none below it")
    assertEqual(rowOptionsPreview.RowsAfter("audio", ["resume"], ["resume"]), -1, "A row Rows doesn't have has no place")
end sub

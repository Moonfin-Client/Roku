' How a person's credits are ordered and grouped by the Display options on their page
sub testPersonCredits()
    roles = personCredits.Shaped([personCredit({ character: "Pilot" }), personCredit({ character: "Narrator" }), personCredit({ id: 2, title: "Another", character: "Guard" })], false, true)
    assertEqual(roles.count(), 2, "Roles on the same title are joined onto one entry")
    assertEqual(roles[0]._role, "Pilot, Narrator", "naming every role")
    assertEqual(roles[1]._role, "Guard", "and a title with one role keeps it")

    crew = personCredits.Shaped([personCredit({ job: "Writer" }), personCredit({ job: "Writer" }), personCredit({ job: "Producer" })], true, true)
    assertEqual(crew.count(), 1, "A crew member's jobs on a title are joined too")
    assertEqual(crew[0]._role, "Writer, Producer", "with a repeated job named once")
    assertEqual(personCredits.Shaped([personCredit({ department: "Sound" })], true, true)[0]._role, "Sound", "A crew credit with no job names its department")

    shared = personCredits.Shaped([personCredit({ id: 7, mediaType: "movie" }), personCredit({ id: 7, mediaType: "tv", title: "A Show" })], false, true)
    assertEqual(shared.count(), 2, "A movie and a show sharing an id aren't joined")

    apart = personCredits.Shaped([personCredit({ character: "One" }), personCredit({ character: "Two" })], false, false)
    assertEqual(apart.count(), 2, "Ungrouped, every credit keeps its own entry")
    assertEqual(apart[1]._role, "Two", "and its own role")

    credits = [personCredit({ id: 1, title: "Zebra", releaseDate: "2001-01-01" }), personCredit({ id: 2, title: "apple", releaseDate: "2010-01-01" }), personCredit({ id: 3, title: "Middle", firstAirDate: "1995-01-01" })]
    assertEqual(creditIds(personCredits.SortCredits(credits, personCredits.SORT_ALPHABETICAL)), "2,3,1", "Credits sort by title ignoring case")
    assertEqual(creditIds(personCredits.SortCredits(credits, personCredits.SORT_DATE_ASCENDING)), "3,1,2", "or by date oldest first, a show going by when it first aired")
    assertEqual(creditIds(personCredits.SortCredits(credits, personCredits.SORT_DATE_DESCENDING)), "2,1,3", "or newest first")

    undated = [personCredit({ id: 1, title: "No date" }), personCredit({ id: 2, title: "Dated", releaseDate: "2001-01-01" })]
    assertEqual(creditIds(personCredits.SortCredits(undated, personCredits.SORT_DATE_ASCENDING)), "2,1", "A title with no date sorts to the end")
    assertEqual(creditIds(personCredits.SortCredits(undated, personCredits.SORT_DATE_DESCENDING)), "2,1", "whichever way the rest go")

    sameDay = [personCredit({ id: 1, title: "Beta", releaseDate: "2001-01-01" }), personCredit({ id: 2, title: "Alpha", releaseDate: "2001-01-01" })]
    assertEqual(creditIds(personCredits.SortCredits(sameDay, personCredits.SORT_DATE_ASCENDING)), "2,1", "A shared date falls back to the title")
    assertEqual(creditIds(personCredits.SortCredits(sameDay, personCredits.SORT_DATE_DESCENDING)), "1,2", "turned round with the dates")
    assertEqual(creditIds(personCredits.SortCredits([personCredit({ id: 1, title: "Same" }), personCredit({ id: 2, title: "same" })], personCredits.SORT_ALPHABETICAL)), "1,2", "Credits that tie keep their order")

    library = [{ json: { Id: "a", Name: "Zebra", PremiereDate: "2001-05-01T00:00:00.0000000Z" } }, { json: { Id: "b", Name: "apple", ProductionYear: 2010 } }, { json: { Id: "c", Name: "Middle" } }]
    assertEqual(cardIds(personCredits.SortCards(library, personCredits.SORT_ALPHABETICAL)), "b,c,a", "Library titles sort by name")
    assertEqual(cardIds(personCredits.SortCards(library, personCredits.SORT_DATE_ASCENDING)), "a,b,c", "or by premiere date or year, with undated titles last")
    assertEqual(cardIds(personCredits.SortCards(library, personCredits.SORT_DATE_DESCENDING)), "b,a,c", "either way")
    assertEqual(releaseDay({ PremiereDate: "0001-01-01T00:00:00.0000000Z", ProductionYear: 1999 }), "1999-01-01", "The server's year 1 date counts as none")
end sub

function personCredit(fields as object) as object
    credit = { id: 1, title: "A Title", posterPath: "/a.jpg" }
    credit.Append(fields)
    return credit
end function

function creditIds(credits as object) as string
    ids = []
    for each credit in credits
        ids.push(credit.id.toStr())
    end for
    return ids.Join(",")
end function

sub testLibraryGroupBy()
    assertEqual(groupKeys({ Genres: ["Drama", "Action"] }, "genres"), "Drama,Action", "An item sits in every genre it carries")
    assertEqual(groupKeys({ Genres: [] }, "genres"), "Other", "An item with no genre goes to Other")
    assertEqual(groupKeys({}, "genres"), "Other", "And so does one the server sent no genres for")
    assertEqual(groupKeys({ OfficialRating: " PG-13 " }, "parentalRatings"), "PG-13", "A rating is trimmed")
    assertEqual(groupKeys({ OfficialRating: "" }, "parentalRatings"), "Unrated", "No rating goes to Unrated")
    assertEqual(groupKeys({ ProductionYear: 1994 }, "decade"), "1990s", "A year falls in its decade")
    assertEqual(groupKeys({ ProductionYear: 2000 }, "decade"), "2000s", "A round year starts its decade")
    assertEqual(groupKeys({}, "decade"), "Unknown", "No year goes to Unknown")
    assertEqual(groupKeys({ Studios: [{ Name: "A24" }, { Name: "" }, { Id: "1" }, { Name: "Pixar" }] }, "studio"), "A24,Pixar", "An item sits in every studio with a name")
    assertEqual(groupKeys({ Studios: [] }, "studio"), "Unknown", "No studio goes to Unknown")
    assertEqual(groupKeys({ Genres: ["Drama"] }, "none"), "", "No grouping puts nothing anywhere")

    assertEqual(libraryGroupBy.Ordered(["1990s", "Unknown", "2010s", "2000s"], "decade").join(","), "2010s,2000s,1990s,Unknown", "Decades run newest first with Unknown last")
    assertEqual(libraryGroupBy.Ordered(["R", "Unrated", "G", "PG-13", "NR", "TV-MA", "XYZ"], "parentalRatings").join(","), "G,PG-13,R,TV-MA,XYZ,NR,Unrated", "Ratings run mildest first, ties go by name and Unrated is last")
    assertEqual(libraryGroupBy.Ordered(["Thriller", "Other", "Action", "Comedy"], "genres").join(","), "Action,Comedy,Thriller,Other", "Genres run alphabetically with Other last")
    assertEqual(libraryGroupBy.Ordered(["Unknown", "Pixar", "A24"], "studio").join(","), "A24,Pixar,Unknown", "Studios run alphabetically with Unknown last")

    values = []
    for each option in libraryGroupBy.Options()
        values.push(option.value)
    end for
    assertEqual(values.join(","), "none,decade,genres,parentalRatings,studio", "Group By lists its groupings in the dialog's order")
    assertEqual(libraryGroupBy.Normalize("studio"), "studio", "A stored grouping is kept")
    assertEqual(libraryGroupBy.Normalize("tags"), "none", "One the dialog no longer offers reads as none")
end sub

function groupKeys(json as object, groupBy as string) as string
    return libraryGroupBy.KeysFor(json, groupBy).join(",")
end function

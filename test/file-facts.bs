sub testFileFacts()
    film = {
        MediaType: "Video",
        MediaStreams: [
            { Type: "Subtitle", Index: 4, Language: "eng", IsExternal: true },
            { Type: "Video", Index: 0, Codec: "hevc" },
            { Type: "Audio", Index: 1, Language: "eng" },
            { Type: "Audio", Index: 2, Language: "jpn" }
        ],
        MediaSources: [
            { Id: "a", Name: "1080p", MediaStreams: [{ Type: "Video", Index: 0, Codec: "h264" }] },
            { Id: "b", Name: "4K", Container: "mkv", Size: 2147483648, MediaStreams: [
                { Type: "Subtitle", Index: 4, Language: "eng", IsExternal: true },
                { Type: "Video", Index: 0, Codec: "hevc" },
                { Type: "Audio", Index: 1, Language: "eng" },
                { Type: "Audio", Index: 2, Language: "jpn" }
            ] }
        ]
    }
    picked = fileFacts.PickedSource(film, "b")
    assertEqual(picked.Name, "4K", "The version picked is the one described")
    assertEqual(fileFacts.PickedSource(film, "gone").Name, "1080p", "A version that's gone falls back to the first")
    assertEqual(fileFacts.PickedSource({}, "a"), invalid, "Nothing to pick from describes nothing")

    assertEqual(fileFacts.AudioIndex(film, 3), 2, "The picker's place in the list becomes the track's own index")
    assertEqual(fileFacts.AudioIndex(film, -1), -1, "No pick stays no pick")

    assertEqual(fileFacts.HasInfo(film, picked), true, "A video with listed streams has a file to describe")
    assertEqual(fileFacts.HasInfo({ MediaType: "Audio", MediaSources: [picked] }, picked), false, "Music has no file block")
    assertEqual(fileFacts.HasInfo({ MediaType: "Video", MediaSources: [{ Type: "Placeholder" }] }, picked), false, "A missing episode has nothing to describe")
    assertEqual(fileFacts.HasInfo(film, { MediaStreams: [] }), false, "A source with no streams has nothing to list")

    spec = fileFacts.InfoSpec(film, picked, 2, 4)
    assertEqual(spec.audioLines.count(), 2, "Every audio track is listed")
    assertEqual(spec.audioLines[1].active and not spec.audioLines[0].active, true, "The picked audio track is marked")
    assertEqual(spec.subtitleLines[0].active, true, "The picked subtitle is marked")
    assertEqual(fileFacts.InfoSpec(film, picked, -1, -1).subtitleLines[0].active, false, "No subtitle marks none")
end sub

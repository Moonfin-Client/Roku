' Transcode Audio Codecs takes the picked codecs out of video direct play and the transcodes, so the
' server converts them while the video plays untouched
sub testTranscodeAudio()
    tuned = applyTranscodeAudioCodecs(transcodeAudioProfile(), ["aac", "dts", "pcm"], false)
    codecs = []
    for each entry in tuned.DirectPlayProfiles
        codecs.push(entry.AudioCodec)
    end for
    assertEqual(codecs.Join("|"), "ac3,eac3|eac3|aac", "Transcode audio takes a picked codec out of video direct play under every name")

    tuned = applyTranscodeAudioCodecs(transcodeAudioProfile(), ["aac"], false)
    assertEqual(tuned.TranscodingProfiles[0].AudioCodec, "ac3,eac3", "Transcode audio takes the pick out of the transcode so the server converts it")

    tuned = applyTranscodeAudioCodecs(transcodeAudioProfile(), ["aac", "ac3", "eac3"], false)
    containers = []
    for each entry in tuned.DirectPlayProfiles
        containers.push(entry.Container)
    end for
    assertEqual(containers.Join("|"), "mkv|m4a", "Transcode audio drops a direct play entry it would leave empty")
    codecs = []
    for each entry in tuned.TranscodingProfiles
        codecs.push(entry.AudioCodec)
    end for
    assertEqual(codecs.Join("|"), "aac,ac3,eac3|aac|aac", "Transcode audio never leaves a transcode list empty, since empty means any codec")

    tuned = applyTranscodeAudioCodecs(transcodeAudioStreamed(), ["aac"], false)
    shapes = []
    for each entry in tuned.TranscodingProfiles
        shapes.push(`${entry.Container}:${entry.Context}:${entry.AudioCodec}`)
    end for
    assertEqual(shapes.Join("|"), "mp4:Streaming:mp2,ac3,eac3|mp4:Static:aac", "Transcode audio drops a streamed transcode it empties while another can convert")

    tuned = applyTranscodeAudioCodecs(transcodeAudioStreamed(), ["aac"], true)
    assertEqual(tuned.TranscodingProfiles.Count(), 3, "Transcode audio keeps the TS transcode for a live channel")

    assertEqual(transcodableAudioCodecOf("DCA"), "dts", "Transcode audio reads DCA as DTS")
    assertEqual(transcodableAudioCodecOf("pcm_s24le"), "pcm", "Transcode audio reads every PCM variant as PCM")
    assertEqual(transcodeAudioCodecPicks({ "playback.transcodeAudioCodecs": `["dts"]` })[0], "dts", "Transcode audio reads the stored picks")
    assertEqual(transcodeAudioCodecPicks(invalid).Count(), 0, "Transcode audio picks nothing without settings")

    onlyAac = { TranscodingProfiles: [{ Container: "ts", Type: "Video", AudioCodec: "aac", Context: "Streaming" }, { Container: "mp4", Type: "Video", AudioCodec: "aac,ac3", Context: "Static" }] }
    assertEqual(canTranscodeAudioCodecAway(onlyAac, "aac"), false, "Transcode audio doesn't offer a codec the streamed transcode would only copy")
    assertEqual(canTranscodeAudioCodecAway(onlyAac, "opus"), true, "Transcode audio offers a codec the streamed transcode can convert")
end sub

function transcodeAudioProfile() as object
    return {
        DirectPlayProfiles: [
            { Container: "mp4,m4v", Type: "Video", VideoCodec: "h264,hevc", AudioCodec: "aac,ac3,eac3" },
            { Container: "mkv", Type: "Video", VideoCodec: "h264,hevc", AudioCodec: "aac,dca,dts,dts-hd,dtshd,eac3,pcm_s16le,pcm_s24le" },
            { Container: "m4a", Type: "Audio", AudioCodec: "aac" }
        ],
        TranscodingProfiles: [
            { Container: "ts", Type: "Video", AudioCodec: "aac,ac3,eac3", VideoCodec: "h264", Protocol: "hls" },
            { Container: "mp4", Type: "Video", AudioCodec: "aac", VideoCodec: "h264", Context: "Static" },
            { Container: "aac", Type: "Audio", AudioCodec: "aac" }
        ]
    }
end function

function transcodeAudioStreamed() as object
    return {
        DirectPlayProfiles: [{ Container: "mp4", Type: "Video", VideoCodec: "h264", AudioCodec: "aac,ac3" }],
        TranscodingProfiles: [
            { Container: "mp4", Type: "Video", AudioCodec: "aac,mp2,ac3,eac3", Context: "Streaming", Protocol: "hls" },
            { Container: "ts", Type: "Video", AudioCodec: "aac", Context: "Streaming", Protocol: "hls" },
            { Container: "mp4", Type: "Video", AudioCodec: "aac", Context: "Static" }
        ]
    }
end function

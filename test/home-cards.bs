sub testHomeCards()
    ' Core's TV sizes on a 1920 wide screen: a poster, a thumbnail, a banner and the widened Modern card
    sizes = [
        ["small", [107, 160], [209, 118], [635, 118], [285, 160]],
        ["medium", [134, 200], [261, 147], [794, 147], [356, 200]],
        ["large", [160, 240], [313, 176], [953, 176], [427, 240]],
        ["extraLarge", [187, 280], [366, 206], [1112, 206], [499, 280]],
        ["grandparents", [267, 401], [522, 294], [1588, 294], [712, 401]]
    ]
    for each entry in sizes
        shapes = [homeCards.CardBox(entry[0], 2 / 3), homeCards.CardBox(entry[0], 16 / 9), homeCards.CardBox(entry[0], homeCards.BANNER_RATIO), homeCards.CardBox(entry[0], 16 / 9, true)]
        for i = 0 to 3
            assertEqual(FormatJson(shapes[i]), FormatJson(entry[i + 1]), `${entry[0]} card ${i} is Core's size`)
        end for
    end for
    assertEqual(FormatJson(homeCards.CardBox("huge", 2 / 3)), "[134,200]", "A size nobody knows is Medium")

    assertEqual(homeCards.AspectFor("Movie", "nextup", false, "poster"), 2 / 3, "A poster is 2:3")
    assertEqual(homeCards.AspectFor("MusicAlbum", "latestmedia", false, "poster"), 1.0, "An album poster is square")
    assertEqual(homeCards.AspectFor("Studio", "studios", false, "poster"), 16 / 9, "A studio poster is wide")
    assertEqual(homeCards.AspectFor("Episode", "resume", false, "thumb"), 16 / 9, "A thumbnail is 16:9")
    assertEqual(homeCards.AspectFor("Person", "favorites", false, "thumb"), 1.0, "A person's thumbnail is square")
    assertEqual(homeCards.AspectFor("Person", "favorites", false, "banner"), homeCards.BANNER_RATIO, "A banner keeps its shape for every type")
    assertEqual(homeCards.AspectFor("SeerrBrowse", "seerr_movie_genres", false, "poster"), 16 / 9, "Seerr's browse rows stay wide")
    assertEqual(homeCards.AspectFor("Movie", "mdblist_watching_now", false, "poster"), 16 / 9, "Watching on MDBList stays wide")
    assertEqual(homeCards.AspectFor("MusicAlbum", "audio", true, "thumb"), 1.0, "An audio row stays square")

    assertEqual(homeCards.SizedImageUrl("https://jf.test/Items/1/Images/Primary?maxHeight=270&maxWidth=180&quality=90&Tag=a", 267, 401), "https://jf.test/Items/1/Images/Primary?maxHeight=401&maxWidth=267&quality=90&Tag=a", "Server art is asked for at the card's size")
    assertEqual(homeCards.SizedImageUrl("https://jf.test/Items/1/Images/Banner?Tag=a&MaxWidth=1000", 794, 147), "https://jf.test/Items/1/Images/Banner?Tag=a&MaxWidth=794", "whatever the size it was built with")
    assertEqual(homeCards.SizedImageUrl("https://image.tmdb.org/t/p/w342/poster.jpg", 134, 200), "https://image.tmdb.org/t/p/w342/poster.jpg", "Art from elsewhere is left alone")
    assertEqual(homeCards.SizedImageUrl(invalid, 134, 200), invalid, "and so is no art")

    types = settingsSync.DecodeRowImageTypes("genres:thumb,nextup:Poster, Watchlist : banner,resume:thumb,seerr_trending:wide,broken")
    assertEqual(types.Count(), 3, "Only pairs with a known type arrive, and Continue Watching keeps its own key")
    assertEqual(types.genres, "thumb", "A row's type arrives")
    assertEqual(types.nextup, "poster", "whatever its case")
    assertEqual(types.playlists, "banner", "and the other clients' playlists row is read as it")
    assertEqual(settingsSync.DecodeRowImageTypes(invalid).Count(), 0, "No list leaves every row alone")

    stored = { "ui.home.rowImageType.nextup": "poster", "ui.home.rowImageType.genres": "THUMB", "ui.home.rowImageType.resume": "thumb", "ui.home.rowImageType.studios": "wide", "ui.posterSize": "large" }
    assertEqual(settingsSync.EncodeRowImageTypes(stored), "genres:thumb,nextup:poster", "Every row picked here goes out but Continue Watching")
    assertEqual(settingsSync.EncodeRowImageTypes({}), "", "Nothing picked sends nothing")
    assertEqual(settingsSync.PluginToRoku("Thumb", "imageType"), "thumb", "Continue Watching's type arrives")
    assertEqual(settingsSync.PluginToRoku("wide", "imageType"), invalid, "A type nobody knows leaves the stored one alone")
    assertEqual(settingsSync.RokuToPlugin("banner", "imageType"), "banner", "and goes out as Core's name")
end sub

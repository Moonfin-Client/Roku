sub testSettingsSyncValues()
    ' Issue 342: Moonbase's defaults name Core's split favorites rows
    split = settingsSync.WithCombinedFavorites(["resume", "favoritemovies", "favoriteseries"], ["favoritemovies"])
    assertEqual(FormatJson(split.order), FormatJson(["resume", "favorites", "favoritemovies", "favoriteseries"]), "This app's Favorites row takes the first split row's place")
    assertEqual(FormatJson(split.hidden), FormatJson(["favoritemovies"]), "and is on while any split row is")
    allOff = settingsSync.WithCombinedFavorites(["favoritemovies"], ["favoritemovies"])
    assertEqual(FormatJson(allOff.hidden), FormatJson(["favoritemovies", "favorites"]), "It is off when every split row is")
    own = settingsSync.WithCombinedFavorites(["favorites", "favoritemovies"], ["favorites"])
    assertEqual(FormatJson(own.order), FormatJson(["favorites", "favoritemovies"]), "A layout that names this app's own row keeps it as it is")
    assertEqual(FormatJson(settingsSync.WithCombinedFavorites(["resume"], []).order), FormatJson(["resume"]), "A layout without favorites rows is left alone")

    synced = [["flagged", "Default"], ["foreign", "Smart"], ["forced", "OnlyForced"], ["always", "Always"], ["none", "None"]]
    for each pair in synced
        assertEqual(settingsSync.PluginToRoku(pair[0], "subtitleModeFormat"), pair[1], "Subtitle mode " + pair[0] + " arrives as " + pair[1])
        assertEqual(settingsSync.RokuToPlugin(pair[1], "subtitleModeFormat"), pair[0], "Subtitle mode " + pair[1] + " goes out as " + pair[0])
    end for
    assertEqual(settingsSync.PluginToRoku("default", "subtitleModeFormat"), "Default", "Default as an older build pushed it still arrives")
    assertEqual(settingsSync.PluginToRoku("onlyforced", "subtitleModeFormat"), "OnlyForced", "Only Forced as an older build pushed it still arrives")
    assertEqual(settingsSync.PluginToRoku("sometimes", "subtitleModeFormat"), invalid, "A mode nobody knows leaves the stored one alone")

    assertEqual(settingsSync.PluginToRoku("auto", "audioLanguage"), "anyLanguage", "No audio preference from the other clients arrives as Any Language")
    assertEqual(settingsSync.PluginToRoku("", "audioLanguage"), "anyLanguage", "An empty one too")
    assertEqual(settingsSync.PluginToRoku("eng", "audioLanguage"), "eng", "A language arrives as it is")
    assertEqual(settingsSync.RokuToPlugin("anyLanguage", "audioLanguage"), "auto", "Any Language goes out as the word the other clients store")
    assertEqual(settingsSync.RokuToPlugin("jpn", "audioLanguage"), "jpn", "A language goes out as it is")
    assertEqual(settingsSync.SiloSectionIn("type:hidden_gems") + "," + settingsSync.SiloSectionIn("abc"), "type.hidden_gems,abc", "A Silo row named by its kind loses the colon a row id can't hold")
    assertEqual(settingsSync.SiloSectionOut("type.hidden_gems") + "," + settingsSync.SiloSectionOut("abc"), "type:hidden_gems,abc", "and gets it back on the way out")

    for each style in ["native", "classic", "glass", "docked"]
        assertEqual(settingsSync.PluginToRoku(style, "keyboardStyle"), style, "Keyboard style " + style + " arrives as it is")
        assertEqual(settingsSync.RokuToPlugin(style, "keyboardStyle"), style, "Keyboard style " + style + " goes out as it is")
    end for
    assertEqual(settingsSync.PluginToRoku("Glass", "keyboardStyle"), "glass", "A keyboard style arrives whatever its case")
    assertEqual(settingsSync.PluginToRoku("floating", "keyboardStyle"), invalid, "A keyboard style nobody knows leaves the stored one alone")

    for each order in ["system", "monthDay", "dayMonth"]
        assertEqual(settingsSync.PluginToRoku(order, "dateFormat"), order, "Date format " + order + " arrives as it is")
        assertEqual(settingsSync.RokuToPlugin(order, "dateFormat"), order, "Date format " + order + " goes out as it is")
    end for
    assertEqual(settingsSync.PluginToRoku("yearMonthDay", "dateFormat"), "system", "A date format nobody knows arrives as the locale default")
    assertEqual(settingsSync.PluginToRoku(2, "dateFormat"), "system", "and so does one that isn't text")

    for each style in ["badge", "banner"]
        assertEqual(settingsSync.PluginToRoku(style, "seerrBadgeStyle"), style, "Seerr badge style " + style + " arrives as it is")
        assertEqual(settingsSync.RokuToPlugin(style, "seerrBadgeStyle"), style, "Seerr badge style " + style + " goes out as it is")
    end for
    assertEqual(settingsSync.PluginToRoku("Banner", "seerrBadgeStyle"), "banner", "A Seerr badge style arrives whatever its case")
    assertEqual(settingsSync.PluginToRoku("ribbon", "seerrBadgeStyle"), invalid, "A Seerr badge style nobody knows leaves the stored one alone")

    for each style in ["classic", "modern", "spotlight", "nouveau", "minimalist", "stage", "premiere", "quickLook", "frost"]
        assertEqual(settingsSync.PluginToRoku(style, "detailStyle"), style, "Details style " + style + " arrives as it is")
        assertEqual(settingsSync.RokuToPlugin(style, "detailStyle"), style, "Details style " + style + " goes out as it is")
    end for
    assertEqual(settingsSync.PluginToRoku("v6", "detailStyle"), "stage", "Smart-TV's token for Stage arrives as Stage")
    assertEqual(settingsSync.PluginToRoku("v7", "detailStyle"), "premiere", "Smart-TV's token for Premiere arrives as Premiere")
    assertEqual(settingsSync.PluginToRoku("quicklook", "detailStyle"), "quickLook", "Quick Look arrives in the camel case Moonfin Core and Smart-TV sync, whatever case it was sent in")
    assertEqual(settingsSync.PluginToRoku("Frost", "detailStyle"), "frost", "Frost arrives in lower case, whatever case it was sent in")
    assertEqual(settingsSync.PluginToRoku("cinematic", "detailStyle"), "modern", "A details style nobody knows falls back to Modern")

    for each source in ["random", "recentlyAdded", "recentlyReleased", "newReleases"]
        assertEqual(settingsSync.PluginToRoku(source, "mediaBarSource"), source, "Media bar source " + source + " arrives as it is")
        assertEqual(settingsSync.RokuToPlugin(source, "mediaBarSource"), source, "Media bar source " + source + " goes out as it is")
    end for
    assertEqual(settingsSync.PluginToRoku("recentlyadded", "mediaBarSource"), "recentlyAdded", "A media bar source arrives in the case the other clients store")
    for each source in ["library", "collection", "trending"]
        assertEqual(settingsSync.PluginToRoku(source, "mediaBarSource"), "random", "The " + source + " media bar source arrives as Random")
        assertEqual(settingsSync.RokuToPlugin(source, "mediaBarSource"), "random", "The " + source + " media bar source goes out as Random")
    end for
end sub

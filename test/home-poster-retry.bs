sub testHomePosterRetry()
    savedTop = m.top
    m.top = { itemContent: { json: { type: "Movie" }, posterURL: "poster" } }
    m.artSource = "poster"
    m.itemPoster = { loadStatus: "failed", uri: "poster", width: 200, height: 300 }
    m.backdrop = { visible: false }
    m.itemIcon = { visible: false }
    m.posterMask = {}
    m.posterRetryTimer = { control: "" }
    m.posterRetryUri = ""
    m.posterRetries = 0

    onPosterLoadStatusChanged()
    onPosterLoadStatusChanged()
    assertEqual(m.posterRetryTimer.control, "start", "A Home poster that fails is tried again")
    assertEqual(m.backdrop.visible, false, "and the card waits on the retries before its fallback")
    onPosterLoadStatusChanged()
    assertEqual(m.backdrop.visible, true, "After two retries the card falls back to its name")

    m.itemPoster.loadStatus = "ready"
    onPosterLoadStatusChanged()
    m.itemPoster.loadStatus = "failed"
    m.backdrop.visible = false
    m.posterRetryTimer.control = ""
    onPosterLoadStatusChanged()
    assertEqual(m.posterRetryTimer.control, "start", "A picture that loaded gets its retries back when it fails on a later visit")
    assertEqual(m.backdrop.visible, false, "so the card waits again instead of falling back at once")

    item = CreateObject("roSGNode", "ContentNode")
    m.top = { itemContent: item }
    m.itemPoster = { uri: "new-poster", loadStatus: "failed" }
    m.posterRetryUri = "poster"
    m.posterRetryContent = item
    retryPoster()
    assertEqual(m.itemPoster.uri, "new-poster", "A retry never puts the failed address over one the card was given since")

    m.itemPoster.uri = "poster"
    m.top.itemContent = CreateObject("roSGNode", "ContentNode")
    retryPoster()
    assertEqual(m.posterRetryUri, "", "and a card that now shows another item drops the retry")

    m.top = savedTop
end sub

function isBrowseTile() as boolean
    return false
end function

sub showPosterText(_show as boolean)
end sub

function outsideCardBackdrop() as string
    return ""
end function

' Only a Seerr title's cast opens a person from Seerr. Silo and Emby number their people, and a
' library person can carry a TMDB picture.
sub testSeerrCastMember()
    assertEqual(isSeerrCastMember({ id: "146552216526996788", json: { Id: "146552216526996788", Name: "Simon Baker", Type: "Actor" } }), false, "A Silo person's numeric id opens from the library")
    assertEqual(isSeerrCastMember({ id: "33", json: { Id: "33", _externalImageUrl: "https://image.tmdb.org/t/p/w342/a.jpg" } }), false, "A library person with a TMDB picture opens from the library")
    assertEqual(isSeerrCastMember({ id: "8784", json: { Id: "8784", Name: "Daniel Craig", _seerrPerson: true } }), true, "A Seerr title's cast member opens from Seerr, picture or not")
    assertEqual(isSeerrCastMember({ id: "8784", json: { Id: "8784", _seerrPerson: "true" } }), true, "The mark is read as a boolean")
    assertEqual(isSeerrCastMember({ id: "8784" }), false, "A person with no data isn't a Seerr person")
end sub

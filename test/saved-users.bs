sub testSavedUserOrder()
    savedRegistry = m.registry
    savedServer = m.global.session.server
    m.global.session.server = { id: "s1" }
    ' The stub get_setting gives available_users as jf-user then emby-user
    m.registry = {
        "u-zed": { username: "zed", token: "t", serverId: "s1" },
        "emby-user": { username: "sam", token: "t", serverId: "s1" },
        "u-other": { username: "aaron", token: "t", serverId: "s2" },
        "jf-user": { username: "Sam", token: "t", serverId: "s1" },
        "u-amy": { username: "Amy", token: "t", serverId: "s1" },
        "u-gone": { username: "bob", serverId: "s1" }
    }
    m.registrySections = ["Jellyfin", "u-zed", "emby-user", "u-other", "jf-user", "u-amy", "u-gone"]

    assertEqual(savedUserIds(), "u-amy,jf-user,emby-user,u-zed", "Saved accounts go by name ignoring case, names that tie keep the switcher's order, and other servers and signed out accounts stay off")

    m.registry = {}
    m.registry.SetModeCaseSensitive()
    m.registry["JF-USER"] = { username: "Lee", token: "t", serverId: "s1" }
    m.registrySections = ["JF-USER"]
    assertEqual(savedUserIds(), "JF-USER", "An account saved under an id that differs from available_users only by case still shows")

    m.registry = savedRegistry
    m.global.session.server = savedServer
end sub

function savedUserIds() as string
    ids = []
    for each user in getSavedUsers()
        ids.push(user.id)
    end for
    return ids.Join(",")
end function

function getRegistrySections() as object
    return m.registrySections
end function

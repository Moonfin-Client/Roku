sub testHomeRowGroups()
    assertEqual(homeRowGroups.Group("resume"), "general", "A built-in row with no kind of its own is general")
    assertEqual(homeRowGroups.Group("pluginDynamic:collections:http://server:collection:abc"), "collections", "A picked collection sits with Collections")
    assertEqual(homeRowGroups.Group("studios"), "genres", "Studios sits with the genres")
    assertEqual(homeRowGroups.Group("PluginDynamic:Genres:http://server:genre:abc"), "genres", "A picked genre is matched whatever its case")
    assertEqual(homeRowGroups.Group("pluginDynamic:playlists:http://server:playlist:abc"), "playlists", "A picked playlist sits with Playlists")
    assertEqual(homeRowGroups.Group("seerr_trending"), "seerr", "Seerr rows have their own group")
    assertEqual(homeRowGroups.Group("seerr_shortcuts") + "," + homeRowGroups.Group("radarr_calendar"), "seerr,seerr", "Seerr Browse and the Radarr and Sonarr calendars sit with Seerr")
    assertEqual(homeRowGroups.Group("tmdb_popular_tv") + "," + homeRowGroups.Group("imdb_top_250_movies"), "external,external", "The TMDB and IMDb lists are external")

    rows = [
        { id: "resume", enabled: true },
        { id: "livetv", enabled: false },
        { id: "seerr_trending", enabled: false },
        { id: "nextup", enabled: true },
        { id: "onnow", enabled: false }
    ]
    view = homeRowGroups.View(rows, { general: true }, {})
    shown = []
    for each entry in view
        if isValid(entry.group)
            shown.push(entry.group + "(" + entry.total.ToStr() + ")")
        else
            shown.push(rows[entry.row].id)
        end if
    end for
    assertEqual(shown.Join(","), "resume,nextup,general(2),livetv,onnow,seerr(1)", "Enabled rows lead, then each group's header, with an open group's rows under it")
    assertEqual(homeRowGroups.View(rows, {}, {}).Count(), 4, "A closed group shows only its header")
    assertEqual(homeRowGroups.View(rows, { general: true }, { livetv: true, onnow: true }).Count(), 3, "Rows left out aren't listed, and a group they empty goes too")
end sub

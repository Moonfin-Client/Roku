sub testHomeRowGroups()
    assertEqual(homeRowGroups.Group("resume"), "general", "A built-in row with no kind of its own is general")
    assertEqual(homeRowGroups.Group("pluginDynamic:collections:http://server:collection:abc"), "collections", "A picked collection sits with Collections")
    assertEqual(homeRowGroups.Group("studios"), "genres", "Studios sits with the genres")
    assertEqual(homeRowGroups.Group("PluginDynamic:Genres:http://server:genre:abc"), "genres", "A picked genre is matched whatever its case")
    assertEqual(homeRowGroups.Group("pluginDynamic:playlists:http://server:playlist:abc"), "playlists", "A picked playlist sits with Playlists")
    assertEqual(homeRowGroups.Group("seerr_trending"), "seerr", "Seerr rows have their own group")
    assertEqual(homeRowGroups.Group("seerr_shortcuts") + "," + homeRowGroups.Group("radarr_calendar"), "seerr,seerr", "Seerr Browse and the Radarr and Sonarr calendars sit with Seerr")
    assertEqual(homeRowGroups.Group("tmdb_popular_tv") + "," + homeRowGroups.Group("imdb_top_250_movies"), "tmdb,imdb", "The TMDB and IMDb lists each have a group")
    assertEqual(homeRowGroups.Group("tmdb_netflix") + "," + homeRowGroups.Group("tmdb_korean_dramas"), "streaming,tmdb", "The streaming service charts are on their own")
    assertEqual(homeRowGroups.Group("mdblist_watching_now") + "," + homeRowGroups.Group("mdblist_anticipated_shows") + "," + homeRowGroups.Group("justwatch_top_movies"), "mdblist,mdblist,justwatch", "Watching on MDBList sits with MDBList's lists, and JustWatch has its own group")
    assertEqual(homeRowGroups.SourceLabel("tmdb_netflix") + "," + homeRowGroups.SourceLabel("mdblist_watching_now") + "," + homeRowGroups.SourceLabel("resume"), "TMDB Lists,MDBList,", "A list names where it comes from, as Core does")
    assertEqual(homeRowGroups.EditorLabel("TMDb Popular TV Shows") + "," + homeRowGroups.EditorLabel("IMDb Top 250 Movies") + "," + homeRowGroups.EditorLabel("Popular Anime"), "Popular TV Shows,Top 250 Movies,Popular Anime", "The editor leaves the source to the group")

    rows = [
        { id: "resume", enabled: true },
        { id: "livetv", enabled: false },
        { id: "seerr_trending", enabled: false },
        { id: "nextup", enabled: true },
        { id: "onnow", enabled: false }
    ]
    view = homeRowGroups.View(rows, { general: true }, {})
    shown = []
    for each entry in view
        if isValid(entry.group)
            shown.push(entry.group + "(" + entry.total.ToStr() + ")")
        else
            shown.push(rows[entry.row].id)
        end if
    end for
    assertEqual(shown.Join(","), "resume,nextup,general(2),livetv,onnow,seerr(1)", "Enabled rows lead, then each group's header, with an open group's rows under it")
    assertEqual(homeRowGroups.View(rows, {}, {}).Count(), 4, "A closed group shows only its header")
    assertEqual(homeRowGroups.View(rows, { general: true }, { livetv: true, onnow: true }).Count(), 3, "Rows left out aren't listed, and a group they empty goes too")

    found = [
        { id: "pluginDynamic:collections:http://server:collection:a", source: "collections", itemId: "a", title: "A" },
        { id: "pluginDynamic:collections:http://server:collection:b", source: "collections", itemId: "b", title: "B" }
    ]
    edited = [
        { id: "resume", enabled: true },
        { id: found[1].id, enabled: true },
        { id: "livetv", enabled: false },
        { id: found[0].id, enabled: false }
    ]
    saved = homeRowGroups.ToSave(edited, found)
    assertEqual(saved.order.Join(","), "resume," + found[1].id + ",livetv", "A found row left off isn't saved, one turned on keeps its place")
    assertEqual(saved.hidden.Join(","), "livetv", "Only rows the layout already knew go in the off list")
    assertEqual(saved.picked.Count().ToStr() + saved.picked[0].itemId, "1b", "The found row turned on becomes a picked row")
    unlisted = homeRowGroups.Unlisted([{ id: found[0].id }], found)
    assertEqual(unlisted.Count().ToStr() + unlisted[0].itemId, "1b", "A row already listed, like one picked before, isn't found again")

    picks = [
        { id: "pluginDynamic:collections:http://server:collection:a", source: "collections", itemId: "a", title: "Old A" },
        { id: "pluginDynamic:collections:http://server:collection:z", source: "collections", itemId: "z", title: "Z" },
        { id: "pluginDynamic:collections:http://other:collection:y", source: "collections", itemId: "y", title: "Y" },
        { id: "pluginDynamic:genres:http://server:genre:g", source: "genres", itemId: "g", title: "G" }
    ]
    refreshed = homeRowGroups.Refreshed(picks, found)
    kept = []
    for each pick in refreshed.picks
        kept.push(pick.itemId + "=" + pick.title)
    end for
    assertEqual(kept.Join(","), "a=A,y=Y,g=G", "A renamed pick takes the new name and picks from lists that didn't come back stay")
    assertEqual(refreshed.gone.Join(","), picks[1].id, "A pick its list no longer has is gone")
    assertEqual(homeRowGroups.Refreshed([picks[2]], found).changed, false, "Nothing changes when no list came back for a pick")

    siloFound = [{ id: "pluginDynamic:server:http://silo:server:s1", source: "server", itemId: "s1", title: "Trending" }]
    siloPicks = [
        { id: "pluginDynamic:server:http://silo:server:s9", source: "server", itemId: "s9", title: "Gone" },
        { id: "pluginDynamic:server:http://silo:server:type.hidden_gems", source: "server", itemId: "type.hidden_gems", title: "Hidden Gems" }
    ]
    siloRefreshed = homeRowGroups.Refreshed(siloPicks, siloFound)
    assertEqual(siloRefreshed.gone.Join(",") + "|" + siloRefreshed.picks[0].itemId, siloPicks[0].id + "|type.hidden_gems", "A Silo row named by its kind stays when the server's list doesn't name it")
end sub

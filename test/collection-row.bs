sub testCollectionRow()
    movieA = { Id: "movieA", Type: "Movie", Name: "Alpha", IsFolder: false }
    movieB = { Id: "movieB", Type: "Movie", Name: "Bravo", IsFolder: false }
    series = { Id: "show", Type: "Series", Name: "The Show", IsFolder: true }
    season = { Id: "season2", Type: "Season", Name: "Season 2", SeriesId: "show", SeriesName: "The Show", IsFolder: true }
    episode1 = { Id: "ep1", Type: "Episode", Name: "One", SeriesId: "show", SeriesName: "The Show", IsFolder: false, UserData: { Played: true } }
    episode2 = { Id: "ep2", Type: "Episode", Name: "Two", SeriesId: "show", SeriesName: "The Show", IsFolder: false, ProductionYear: 2026 }

    assertEqual(isPlaylistOrder("playlistOrder"), true, "The Playlist Order choice is told apart from the server sorts")
    assertEqual(isPlaylistOrder("PlaylistOrder"), true, "However a synced value spells it")
    assertEqual(isPlaylistOrder("name"), false, "A server sort is not it")

    playable = playableMembers([series, season, episode1, episode2, movieA, movieB])
    assertEqual(itemIds(playable), "ep1,ep2,movieA,movieB", "Only the movies and episodes of a flat collection are playable")

    arranged = arrangeByStoredOrder(playable, ["movieB", "ep2", "ep1", "movieA"])
    assertEqual(itemIds(arranged), "movieB,ep2,ep1,movieA", "A stored order arranges the items")
    folded = oneCardPerSeries(arranged)
    assertEqual(itemIds(folded), "movieB,show,movieA", "Episodes fold into one series card where it was first put")
    assertEqual(folded[1].Name, "The Show", "The card is the series")
    assertEqual(folded[1].DoesExist("UserData"), false, "The card goes without an episode's watched state")
    assertEqual(folded[1].DoesExist("ProductionYear"), false, "The card goes without an episode's year, since the series has its own")
    assertEqual(itemIds(firstItems(arranged, 2)), "movieB,ep2", "The row keeps to its limit")

    assertEqual(itemIds(arrangeByStoredOrder([episode1, movieA, movieB, episode2], ["movieB"])), "movieB,ep1,movieA,ep2", "Items the stored order leaves out follow in the order the server sent them")

    cards = [{ json: series }, { json: movieA }, { json: episode2 }, { json: movieB }]
    assertEqual(cardIds(collectionPlaylist(cards)), "movieA,ep2,movieB", "A collection plays its titles in the server's order, without its series")
    assertEqual(cardIds(collectionSort.Apply(collectionPlaylist(cards), collectionSort.SORT_CUSTOM, ["movieB", "show", "movieA"])), "movieB,movieA,ep2", "A saved order leads, and what it leaves out follows it")

    mixed = collectionGroups(cards)
    assertEqual(groupSummary(mixed), "Movies:movieA,movieB|Series:show|Other:ep2", "A collection splits into its movies, its shows and the rest, each in the order it came")
    assertEqual(collectionLabel(mixed), "Items", "A collection of more than one kind goes by Items")
    films = collectionGroups([{ json: movieB }, { json: movieA }])
    assertEqual(groupSummary(films), "Movies:movieB,movieA", "A collection of films has only its movies")
    assertEqual(collectionLabel(films), "Movies", "and goes by Movies")
    assertEqual(collectionGroups([]).count(), 0, "An empty collection has nothing to show")

    blockedSeries = {}
    blockedSeries.Append(series)
    blockedSeries.OfficialRating = "TV-MA"
    assertEqual(itemIds(playableMembers([blockedSeries, season, episode1, episode2, movieA])), "movieA", "A blocked series keeps its episodes out")

    testCollectionPeople()

    assertEqual(nearsCollectionEnd(41, 50), false, "A row nine titles from its end waits")
    assertEqual(nearsCollectionEnd(42, 50), true, "A row within 8 titles of its end asks for the next page")
    assertEqual(nearsCollectionEnd(0, 5), true, "A row shorter than that asks as soon as focus is in it")
    assertEqual(nearsCollectionEnd(35, 50, 7), false, "A grid three rows from its end waits")
    assertEqual(nearsCollectionEnd(36, 50, 7), true, "A grid within two rows of its end asks for the next page")
end sub

' Who directed, wrote and acted in a collection
sub testCollectionPeople()
    hope = { people: [
        { Name: "George Lucas", Type: "Director", Id: "lucas" },
        { Name: "George Lucas", Type: "Writer", Id: "lucas" },
        { Name: "Mark Hamill", Type: "Actor", Id: "hamill" },
        { Name: "Harrison Ford", Type: "Actor", Id: "ford" },
        { Name: "John Williams", Type: "Composer", Id: "williams" }
    ] }
    empire = { people: [
        { Name: "Irvin Kershner", Type: "Director", Id: "kershner" },
        { Name: "Leigh Brackett", Type: "Writer", Id: "brackett" },
        { Name: "George Lucas", Type: "Writer", Id: "lucas" },
        { Name: "Mark Hamill", Type: "Actor", Id: "hamill" },
        { Name: "Billy Dee Williams", Type: "GuestStar", Id: "bdw" },
        { Name: "Irvin Kershner", Type: "Actor", Id: "kershner" }
    ] }
    missing = { json: { Id: "seerr-movie-1", SeerrMissing: true } }
    sequel = { people: [{ Name: "Harrison Ford", Type: "Director", Id: "ford" }] }

    firstPage = collectionPeople([hope, missing, empire])
    assertEqual(personNames(firstPage.directors), "George Lucas,Irvin Kershner", "Directors come in the collection's order, each once")
    assertEqual(personNames(firstPage.writers), "George Lucas,Leigh Brackett", "Writers are gathered the same way")
    assertEqual(personNames(firstPage.actors), "Mark Hamill,Harrison Ford,Billy Dee Williams", "Actors and guest stars each come once, without anyone who directed or wrote, and a missing title adds nobody")

    morePages = collectionPeople([hope, missing, empire, sequel])
    assertEqual(personNames(morePages.directors), "George Lucas,Irvin Kershner,Harrison Ford", "A title loaded later adds its director")
    assertEqual(personNames(morePages.actors), "Mark Hamill,Billy Dee Williams", "and someone who directs one title leaves the cast, wherever they acted")
    assertEqual(collectionPeople([missing]).actors.count(), 0, "A collection of missing titles has nobody")
end sub

function personNames(people as object) as string
    names = []
    for each person in people
        names.push(person.Name)
    end for
    return names.Join(",")
end function

function itemIds(items as object) as string
    ids = []
    for each item in items
        ids.push(item.Id)
    end for
    return ids.Join(",")
end function

function cardIds(cards as object) as string
    ids = []
    for each card in cards
        ids.push(card.json.Id)
    end for
    return ids.Join(",")
end function

function groupSummary(groups as object) as string
    summary = []
    for each group in groups
        summary.push(group.title + ":" + cardIds(group.items))
    end for
    return summary.Join("|")
end function

' Stands in for the parental controls: a TV-MA title, or one judged by a TV-MA series, is blocked
namespace parentalControls
    function WithoutBlockedItems(items as object, fallbackRating = "" as dynamic) as object
        kept = []
        for each item in items
            rating = item.OfficialRating ?? fallbackRating
            if rating <> "TV-MA" then kept.push(item)
        end for
        return kept
    end function
end namespace

sub testCollectionRow()
    movieA = { Id: "movieA", Type: "Movie", Name: "Alpha", IsFolder: false }
    movieB = { Id: "movieB", Type: "Movie", Name: "Bravo", IsFolder: false }
    series = { Id: "show", Type: "Series", Name: "The Show", IsFolder: true }
    season = { Id: "season2", Type: "Season", Name: "Season 2", SeriesId: "show", SeriesName: "The Show", IsFolder: true }
    episode1 = { Id: "ep1", Type: "Episode", Name: "One", SeriesId: "show", SeriesName: "The Show", IsFolder: false, UserData: { Played: true } }
    episode2 = { Id: "ep2", Type: "Episode", Name: "Two", SeriesId: "show", SeriesName: "The Show", IsFolder: false }

    assertEqual(isPlaylistOrder("playlistOrder"), true, "The Playlist Order choice is told apart from the server sorts")
    assertEqual(isPlaylistOrder("PlaylistOrder"), true, "However a synced value spells it")
    assertEqual(isPlaylistOrder("name"), false, "A server sort is not it")

    playable = playableMembers([series, season, episode1, episode2, movieA, movieB])
    assertEqual(itemIds(playable), "ep1,ep2,movieA,movieB", "Only the movies and episodes of a flat collection are playable")
    assertEqual(itemIds(playableMembers([series, season, episode1, movieA], true)), "season2,ep1,movieA", "Season entries are included in flat collection order only when enabled")
    assertEqual(itemIds(oneCardPerSeries([movieA, season, episode1, episode2, movieB], true)), "movieA,season2,show,movieB", "A stored playlist order keeps seasons while grouping episodes")

    arranged = arrangeByStoredOrder(playable, ["movieB", "ep2", "ep1", "movieA"])
    assertEqual(itemIds(arranged), "movieB,ep2,ep1,movieA", "A stored order arranges the items")
    folded = oneCardPerSeries(arranged)
    assertEqual(itemIds(folded), "movieB,show,movieA", "Episodes fold into one series card where it was first put")
    assertEqual(folded[1].Name, "The Show", "The card is the series")
    assertEqual(folded[1].DoesExist("UserData"), false, "The card goes without an episode's watched state")
    assertEqual(itemIds(firstItems(arranged, 2)), "movieB,ep2", "The row keeps to its limit")

    season1 = { Id: "season1", Type: "Season", Name: "Season 1", SeriesId: "show", SeriesName: "The Show", IsFolder: true }
    orphanSeason = { Id: "orphan", Type: "Season", Name: "Unlinked Season", IsFolder: true }
    direct = [movieA, season1, season, series, movieB, orphanSeason]
    grouped = seasonCardsForPickedRow(direct, false)
    assertEqual(itemIds(grouped), "movieA,show,movieB", "A picked row groups seasons into one series card by default")
    assertEqual(grouped[1].Name, "The Show", "The grouping retains the series title")
    assertEqual(grouped[1].IsFolder, true, "The series card remains a folder")
    assertEqual(itemIds(seasonCardsForPickedRow(direct, true)), "movieA,season1,season2,show,movieB,orphan", "Opting in keeps individual seasons and their original order")
    assertEqual(itemIds(seasonCardsForPickedRow([season1, season], false)), "show", "A show represented only by seasons gets one series card")
    assertEqual(itemIds(seasonCardsForPickedRow([orphanSeason, movieB], false)), "movieB", "An unlinked season cannot leak into a series-only row")
    assertEqual(itemIds(seasonCardsForPickedRow([episode1, episode2, movieA], false)), "show,movieA", "Episodes still collapse when expanded episodes are off")
    assertEqual(genreRowSeasonTypes("Movie,Series", false), "Movie,Series", "Genre rows exclude seasons by default")
    assertEqual(genreRowSeasonTypes("Movie,Series", true), "Movie,Series,Season", "Opted-in mixed genre rows include seasons")
    assertEqual(genreRowSeasonTypes("Series", true), "Series,Season", "Opted-in TV-only genre rows include seasons")
    assertEqual(genreRowSeasonTypes("Movie", true), "Movie", "Movie-only genre rows never contain seasons")
    assertEqual(genreRowSeasonTypes("Movie", false), "Movie", "Movie-only rows stay unchanged")


    assertEqual(itemIds(arrangeByStoredOrder([episode1, movieA, movieB, episode2], ["movieB"])), "movieB,ep1,movieA,ep2", "Items the stored order leaves out follow in the order the server sent them")

    blockedSeries = {}
    blockedSeries.Append(series)
    blockedSeries.OfficialRating = "TV-MA"
    assertEqual(itemIds(playableMembers([blockedSeries, season, episode1, episode2, movieA])), "movieA", "A blocked series keeps its episodes out")
end sub

function itemIds(items as object) as string
    ids = []
    for each item in items
        ids.push(item.Id)
    end for
    return ids.Join(",")
end function

' Stands in for the parental controls: a TV-MA title, or one judged by a TV-MA series, is blocked
namespace parentalControls
    function WithoutBlockedItems(items as object, fallbackRating = "" as dynamic) as object
        kept = []
        for each item in items
            rating = item.OfficialRating ?? fallbackRating
            if rating <> "TV-MA" then kept.push(item)
        end for
        return kept
    end function
end namespace

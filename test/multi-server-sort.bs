' The rows joined from several servers, sorted again the way one server would have sorted them
sub testMultiServerSort()
    ' Each server's own Recently Released answer, newest first, the way the second arrives after the first
    secondServer = [
        { Id: "s26", Name: "Opus Test", ProductionYear: 2026 },
        { Id: "s25", Name: "Second Beta", ProductionYear: 2025 },
        { Id: "s24", Name: "Second Alpha", ProductionYear: 2024 },
        { Id: "sx", Name: "Second Show" }
    ]
    thirdServer = [
        { Id: "t25", Name: "Third Beta", ProductionYear: 2025 },
        { Id: "t24", Name: "Third Alpha", ProductionYear: 2024 },
        { Id: "tx", Name: "Third Show" }
    ]
    joined = []
    joined.Append(secondServer)
    joined.Append(thirdServer)
    released = { SortBy: "PremiereDate,ProductionYear,SortName", SortOrder: "Descending" }
    assertEqual(mergedIds(libraryScope.Sorted(joined, released)), "s26,t25,s25,t24,s24,tx,sx", "Recently Released mixes the servers newest first, falls back to the year without a date, and breaks a tie on the name from Z to A")

    dated = [
        { Id: "old", Name: "Old", PremiereDate: "2001-05-01T00:00:00.0000000Z" },
        { Id: "none", Name: "Undated" },
        { Id: "new", Name: "New", PremiereDate: "2020-05-01T00:00:00.0000000Z" }
    ]
    assertEqual(mergedIds(libraryScope.Sorted(dated, { SortBy: "PremiereDate,SortName", SortOrder: "Descending" })), "new,old,none", "Newest first puts a title without a date last, like the server")
    assertEqual(mergedIds(libraryScope.Sorted(dated, { SortBy: "PremiereDate,SortName", SortOrder: "Ascending" })), "none,old,new", "and oldest first puts it first")

    favorites = [
        { Id: "s1", Name: "Opus Test", DateCreated: "2026-11-07T14:57:16.2767099Z" },
        { Id: "s2", Name: "Second Beta", DateCreated: "2026-11-06T00:12:04.4173812Z" },
        { Id: "t1", Name: "Third Gamma", DateCreated: "2026-11-06T00:41:50.3795724Z" },
        { Id: "t2", Name: "Third Alpha", DateCreated: "2026-11-06T00:41:49.8645588Z" }
    ]
    assertEqual(mergedIds(libraryScope.Sorted(favorites, { SortBy: "DateCreated,SortName", SortOrder: "Descending" })), "s1,t1,t2,s2", "Favorites by Date Added mix the servers newest first")

    twins = [
        { Id: "b", Name: "bravo", CommunityRating: 7.5 },
        { Id: "a", Name: "Alpha", CommunityRating: 7.5 },
        { Id: "c", Name: "Charlie", CommunityRating: 8.1 }
    ]
    assertEqual(mergedIds(libraryScope.Sorted(twins, { SortBy: "CommunityRating,SortName", SortOrder: "Ascending" })), "a,b,c", "Equal ratings fall back to the name, ignoring case")
    assertEqual(mergedIds(libraryScope.Sorted(twins, { SortBy: "CommunityRating,SortName", SortOrder: "Descending" })), "c,b,a", "and the name turns round with the rest")

    sortNames = [
        { Id: "m", Name: "The Matrix", SortName: "matrix" },
        { Id: "l", Name: "Labyrinth", SortName: "labyrinth" }
    ]
    assertEqual(mergedIds(libraryScope.Sorted(sortNames, { SortBy: "SortName", SortOrder: "Ascending" })), "l,m", "Name order reads the server's sort name, so The Matrix files under M")

    episodesAdded = [
        { Id: "x", Name: "X", DateLastMediaAdded: "2024-01-01T00:00:00Z" },
        { Id: "y", Name: "Y", DateLastMediaAdded: "2025-01-01T00:00:00Z" }
    ]
    assertEqual(mergedIds(libraryScope.Sorted(episodesAdded, { SortBy: "DateLastContentAdded,SortName", SortOrder: "Descending" })), "y,x", "Date Episode Added sorts on when a show last got something new")

    rated = [{ Id: "r", Name: "R", OfficialRating: "R" }, { Id: "g", Name: "G", OfficialRating: "G" }]
    assertEqual(mergedIds(libraryScope.Sorted(rated, { SortBy: "OfficialRating,SortName", SortOrder: "Ascending" })), "r,g", "A sort the merge can't redo keeps the order the servers answered in")
    assertEqual(mergedIds(libraryScope.Sorted(rated, {})), "r,g", "and so does no sort at all")
    assertEqual(libraryScope.Sorted(twins, { SortBy: "Random", SortOrder: "Ascending" }).count(), 3, "Random shuffles the joined list and keeps every title")

    params = withSortFields({ SortBy: "DateCreated,SortName", Fields: "ProviderIds" })
    assertEqual(params.Fields, "ProviderIds,DateCreated,SortName", "Sorting by Date Added asks each server for the date and the sort name")
    assertEqual(withSortFields({ SortBy: "PremiereDate,ProductionYear,SortName", Fields: "Overview,SortName" }).Fields, "Overview,SortName", "A field already asked for isn't asked for twice, and one every answer carries isn't added")
    assertEqual(withSortFields({ SortBy: "DateLastContentAdded,SortName" }).Fields, "SortName,DateLastMediaAdded", "Date Episode Added asks for when a show last got something new, under the name the item carries it")
    assertEqual(withSortFields({ Fields: "Overview" }).Fields, "Overview", "A request without a sort is left alone")
end sub

function mergedIds(items as object) as string
    ids = []
    for each item in items
        ids.push(item.Id)
    end for
    return ids.join(",")
end function

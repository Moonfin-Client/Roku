sub testSettingsMetrics()
    assertEqual(Int(settingsMetrics.Px(420) + 0.5), 701, "A 420 unit panel fills 701 pixels")

    single = settingsMetrics.Body("two", 1, 0, 12, 1.0)
    assertEqual(Int(single.height + 0.5), Int(settingsMetrics.Px(56) + 0.5), "A title on its own is 56 tall")
    caption = settingsMetrics.Body("two", 1, 1, 12, 1.0)
    assertEqual(Int(caption.height + 0.5), Int(settingsMetrics.Px(72) + 0.5), "A line under the title makes 72")
    pixel = settingsMetrics.Body("two", 1, 1, 12, 0.6)
    assertEqual(Int(pixel.titleTop + 0.5), Int(settingsMetrics.Px(25) + 0.5), "The pixel theme's two-line rows sit lower")
    picker = settingsMetrics.Body("three", 1, 1, 11, 1.0)
    assertEqual(Int(picker.height + 0.5), Int(settingsMetrics.Px(88) + 0.5), "A picker's description makes 88")

    wrapped = settingsMetrics.Body("two", 1, 2, 12, 1.0)
    expected = settingsMetrics.Px(16) + settingsMetrics.LineHeight(14, 1.0) + settingsMetrics.LineHeight(12, 1.0) * 2
    assertEqual(Int(wrapped.height + 0.5), Int(expected + 0.5), "A wrapped caption is the text with 8 above and below")
    longTitle = settingsMetrics.Body("two", 2, 1, 12, 1.0)
    assertEqual(Int(longTitle.captionTop + 0.5), Int(settingsMetrics.Px(8) + settingsMetrics.LineHeight(14, 1.0) * 2 + 0.5), "A wrapped title pushes its caption down")

    assertEqual(Int(settingsMetrics.CardHeight(settingsMetrics.Px(72), false) + 0.5), Int(settingsMetrics.Px(88) + 2.5), "A card pads its text column by 8 above and below")
    assertEqual(Int(settingsMetrics.CardHeight(settingsMetrics.Px(72), true) + 0.5), Int(settingsMetrics.Px(80) + 2.5), "A switch or picker card pads by 4")
    assertEqual(Int(settingsMetrics.HeaderBand() + 0.5), Int(settingsMetrics.Px(43.16) + 0.5), "A section heading takes 20 above, its line and 6 below")
    assertEqual(Int(settingsMetrics.BubbleHeight(1) + 0.5), Int((settingsMetrics.Px(8) + 1) * 2 + settingsMetrics.Px(14.67) + 0.5), "A value bubble is one line with its padding")
end sub

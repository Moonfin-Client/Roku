sub testSiloRoomSocket()
    ' Waits are 0.5, 1, 2, then 5 seconds, each up to a quarter longer
    assertEqual(siloRoomSocket.BackoffSeconds(1, 0#), 0.5#, "The first retry waits half a second")
    assertEqual(siloRoomSocket.BackoffSeconds(2, 0#), 1#, "then a second")
    assertEqual(siloRoomSocket.BackoffSeconds(3, 0#), 2#, "then two")
    assertEqual(siloRoomSocket.BackoffSeconds(4, 0#), 5#, "and five after that")
    assertEqual(siloRoomSocket.BackoffSeconds(9, 0#), 5#, "and stays at five")
    assertEqual(siloRoomSocket.BackoffSeconds(1, 1#), 0.625#, "Full jitter adds a quarter")
    assertEqual(siloRoomSocket.BackoffSeconds(4, 1#), 6.25#, "and so does the last wait")

    assertEqual(siloRoomSocket.GivesUp(6, 150#), true, "Six failures and 150 seconds without a healthy socket give up")
    assertEqual(siloRoomSocket.GivesUp(5, 300#), false, "Five failures keep trying")
    assertEqual(siloRoomSocket.GivesUp(6, 149#), false, "and so does a short outage")

    assertEqual(siloRoomSocket.IsRotation(30#), true, "A socket open 30 seconds was the server's rotation")
    assertEqual(siloRoomSocket.IsRotation(29.9#), false, "A shorter one was an outage")

    assertEqual(siloRoomSocket.FinalStatus(409), true, "A 409 ends the party")
    assertEqual(siloRoomSocket.FinalStatus(401), true, "A refused login stops reconnecting")
    assertEqual(siloRoomSocket.FinalStatus(403), true, "and so does a forbidden one")
    assertEqual(siloRoomSocket.FinalStatus(404), true, "and a missing room")
    assertEqual(siloRoomSocket.FinalStatus(410), true, "and a gone one")
    assertEqual(siloRoomSocket.FinalStatus(503), false, "A server error waits and tries again")
    assertEqual(siloRoomSocket.FinalStatus(0), false, "and so does no answer")

    samples = [{ offset: 1#, rtt: 0.3# }, { offset: 2#, rtt: 0.1# }, { offset: 1.5#, rtt: 0.2# }]
    assertEqual(siloRoomSocket.BestSample(samples).offset, 2#, "The fastest round trip is the best sample")
    assertEqual(siloRoomSocket.BestSample([]), invalid, "and there is none before the first")

    best = { offset: 1#, rtt: 0.1# }
    assertEqual(siloRoomSocket.ClockStepped(best, { offset: 1.02#, rtt: 0.1# }), false, "A sample within the allowance keeps the clock")
    assertEqual(siloRoomSocket.ClockStepped(best, { offset: 1.3#, rtt: 0.1# }), true, "A sample past it means the clock stepped")
    assertEqual(siloRoomSocket.ClockStepped(invalid, { offset: 1.3#, rtt: 0.1# }), false, "The first sample steps nothing")

    assertEqual(siloRoomSocket.TooManyOversize([10#, 20#, 30#, 40#], 60#), true, "Four oversized closes in a minute are too many")
    assertEqual(siloRoomSocket.TooManyOversize([10#, 20#, 30#, 40#], 75#), false, "but the first drops out after a minute")
    assertEqual(siloRoomSocket.TooManyOversize([10#, 20#, 30#], 35#), false, "Three are still allowed")
end sub

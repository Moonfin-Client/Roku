sub testSeerrJson()
    winPath = "C:\Users\Media\movies\director ""cut"""
    assertEqual(ParseJson(SeerrFormatJsonValue(winPath)), winPath, "Seerr escapes Windows paths and quotes in scalar strings")

    assertEqual(ParseJson(SeerrFormatJsonValue("Schöne Filme")), "Schöne Filme", "Seerr preserves non-ASCII titles")
    assertEqual(ParseJson(SeerrFormatJsonValue("a" + Chr(0) + Chr(31) + "b")), "a" + Chr(0) + Chr(31) + "b", "Seerr escapes all JSON control bytes")

    controlText = "first" + Chr(10) + Chr(9) + "second"
    assertEqual(ParseJson(SeerrFormatJsonValue(controlText)), controlText, "Seerr escapes newline and tab characters")

    request = SeerrJsonFromPairs([
        { key: "rootFolder", value: winPath },
        { key: "requestedBy", value: "name ""with"" quotes" },
        { key: "items", value: [{ name: "one\two", enabled: true }, invalid, 7] }
    ])
    decoded = ParseJson(request)
    assertEqual(decoded.rootFolder, winPath, "Seerr request rootFolder survives a JSON round-trip")
    assertEqual(decoded.requestedBy, "name ""with"" quotes", "Seerr request escapes quoted strings")
    assertEqual(decoded.items[0].name, "one\two", "Nested Seerr arrays escape backslashes")
    assertEqual(ParseJson(SeerrFormatJsonValue(true)), true, "Seerr serializes true as a boolean")
    assertEqual(ParseJson(SeerrFormatJsonValue(false)), false, "Seerr serializes false as a boolean")
    assertEqual(decoded.items[0].enabled, true, "Seerr booleans remain booleans")
    assertEqual(decoded.items[1], invalid, "Seerr null values remain null")
    assertEqual(decoded.items[2], 7, "Seerr numbers remain numbers")
    assertEqual(InStr(1, request, """rootFolder""") > 0, true, "Seerr retains camelCase keys from ordered pairs")

    escapedKey = SeerrJsonFromPairs([{ key: "user""name", value: "value" }])
    assertEqual(ParseJson(escapedKey)["user""name"], "value", "Seerr escapes quoted JSON keys")

    objectJson = SeerrFormatJson({ path: winPath, metadata: { caption: controlText }, valid: false })
    objectData = ParseJson(objectJson)
    assertEqual(objectData.path, winPath, "Seerr object properties escape Windows paths")
    assertEqual(objectData.metadata.caption, controlText, "Seerr nested object strings escape control characters")
    assertEqual(objectData.valid, false, "Seerr object booleans retain their type")

    details = ParseJson("{""watchProviders"":[{""iso_3166_1"":""GB"",""flatrate"":[{""name"":""Netflix"",""logoPath"":""/gb.jpg""}]},{""iso_3166_1"":""US"",""buy"":[{""name"":""Apple TV""}],""flatrate"":[{""id"":337,""name"":""Disney Plus"",""logoPath"":""/d.jpg""},{""id"":8,""name"":""Netflix"",""logoPath"":""/n.jpg""}]},{""iso_3166_1"":""DE"",""buy"":[{""name"":""Apple TV""}]}]}")
    providers = SeerrStreamingProviders(details, "US")
    assertEqual(providers.count(), 2, "Only the region's flatrate services are listed")
    assertEqual(providers[0].name + "," + providers[1].name, "Disney Plus,Netflix", "Streaming services keep the order Seerr sends")
    assertEqual(providers[1].logoPath, "/n.jpg", "Streaming services keep their logo path")
    assertEqual(SeerrStreamingProviders(details, "DE").count(), 0, "A region with only purchases has no streaming services")
    assertEqual(SeerrStreamingProviders(details, "FR").count(), 0, "A region Seerr has nothing for has no streaming services")
    assertEqual(SeerrStreamingProviders({}, "US").count(), 0, "Details without watch providers have no streaming services")
    assertEqual(SeerrStreamingProviders(invalid, "US").count(), 0, "Missing details have no streaming services")
    malformed = ParseJson("{""watchProviders"":[null,{""iso_3166_1"":null},{""iso_3166_1"":""US"",""flatrate"":[null,{""logoPath"":""/x.jpg""},{""name"":""Max""}]}]}")
    assertEqual(SeerrStreamingProviders(malformed, "US").count(), 1, "Malformed watch provider entries are skipped")
    assertEqual(SeerrStreamingProviders(ParseJson("{""watchProviders"":[{""iso_3166_1"":""US"",""flatrate"":null}]}"), "US").count(), 0, "A null flatrate list has no streaming services")

    saved = m.global
    m.global = {}
    assertEqual(SeerrStreamingRegion(), "US", "The streaming region falls back to the US")
    m.global = { seerrPublicSettings: { streamingRegion: "GB" } }
    assertEqual(SeerrStreamingRegion(), "GB", "The server's streaming region comes before the US")
    m.global = { seerrUserSettings: { streamingRegion: "DE" }, seerrPublicSettings: { streamingRegion: "GB" } }
    assertEqual(SeerrStreamingRegion(), "DE", "The viewer's own streaming region comes first")
    m.global = { seerrUserSettings: { streamingRegion: " " }, seerrPublicSettings: { streamingRegion: "GB" } }
    assertEqual(SeerrStreamingRegion(), "GB", "A blank viewer region counts as unset")
    m.global = { seerrUserSettings: {}, seerrPublicSettings: { streamingRegion: "" } }
    assertEqual(SeerrStreamingRegion(), "US", "Blank regions everywhere fall back to the US")
    m.global = saved
end sub

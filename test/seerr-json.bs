sub testSeerrJson()
    windowsPath = "C:" + Chr(92) + "Users" + Chr(92) + "Media" + Chr(92) + "Movies"
    quotedPath = "Movie " + Chr(34) + "HD" + Chr(34) + Chr(92) + "2"
    controls = "start" + Chr(8) + Chr(9) + Chr(10) + Chr(12) + Chr(13) + Chr(1) + Chr(0) + "end"

    body = SeerrJsonFromPairs([
        { key: "rootFolder", value: windowsPath },
        { key: "requestNote", value: quotedPath },
        { key: "controls", value: controls },
        { key: "labels", value: [windowsPath, quotedPath] },
        { key: "options", value: { path: windowsPath, enabled: true, count: 2 } },
        { key: "optional", value: invalid }
    ])
    data = ParseJson(body)
    assertEqual(data <> invalid, true, "Seerr ordered-pair request is valid JSON")
    if data <> invalid
        assertEqual(data.rootFolder, windowsPath, "Windows folder backslashes survive the request")
        assertEqual(data.requestNote, quotedPath, "Quotes and backslashes survive the request")
        assertEqual(data.controls, controls, "JSON control characters round-trip")
        assertEqual(data.labels[0], windowsPath, "Nested array path is escaped")
        assertEqual(data.labels[1], quotedPath, "Nested array quotes are escaped")
        assertEqual(data.options.path, windowsPath, "Nested object path is escaped")
        assertEqual(data.options.enabled, true, "Boolean values remain booleans")
        assertEqual(data.options.count, 2, "Number values remain numbers")
        assertEqual(data.DoesExist("optional"), true, "Explicit null field remains present")
        assertEqual(data.optional, invalid, "Null value remains null")
    end if
    assertEqual(InStr(1, body, Chr(34) + "rootFolder" + Chr(34)) > 0, true, "Seerr required camelCase keys are preserved")

    nestedKey = "root" + Chr(34) + Chr(92) + "folder"
    nested = {}
    nested.AddReplace(nestedKey, windowsPath)
    nestedJson = SeerrFormatJson(nested)
    nestedResult = ParseJson(nestedJson)
    assertEqual(nestedResult <> invalid, true, "Seerr object keys with quotes and slashes yield valid JSON")
    if nestedResult <> invalid
        assertEqual(nestedResult[nestedKey], windowsPath, "Escaped object keys and paths round-trip")
    end if

    assertEqual(ParseJson(SeerrFormatJsonValue(quotedPath)), quotedPath, "Standalone JSON string escapes quotes")
    assertEqual(ParseJson(SeerrFormatJsonValue(controls)), controls, "Standalone JSON string escapes controls")
end sub

' The audio and subtitle picks kept for a title and its series, and how a series pick finds its
' track again in another episode
sub testTrackMemory()
    forced = { Index: 1, Language: "deu", Title: "Forced" }
    full = { Index: 2, Language: "deu", Title: "Full" }
    eng = { Index: 3, Language: "eng", Title: "English" }

    assertEqual(FormatJson(trackMemory.SeriesPref([forced, full, eng], 2)), "[""deu"",""full"",0]", "A series pick keeps its language, name and place among full tracks in its language")
    assertEqual(trackMemory.SeriesPref([{ Index: 4, Language: "deu", Title: "3 - Forced" }], 4)[1], "forced", "A leading track number is dropped from the name")
    assertEqual(FormatJson(trackMemory.SeriesPref([forced], -1)), "[""none"","""",0]", "Off is kept as off")
    assertEqual(trackMemory.SeriesPref([forced], 99), invalid, "A track that isn't there keeps nothing")
    assertEqual(FormatJson(trackMemory.SeriesPref([{ Index: 5, Title: "Signs and Songs" }], 5)), "["""",""signs and songs"",0]", "An untagged track still keeps its name")
    assertEqual(trackMemory.SeriesPref([{ Index: 5, Language: "Unknown", Title: "Forced" }], 5)[0], "", "A track called Unknown counts as having no language")
    assertEqual(trackMemory.SeriesPref([{ Index: 6, Language: "deu", DisplayTitle: "German - SUBRIP" }], 6)[1], "german - subrip", "The name falls back to the display title")

    pref = trackMemory.SeriesPref([forced, full, eng], 1)
    assertEqual(trackMemory.MatchSeries([{ Index: 7, Language: "deu", Title: "Full" }, { Index: 8, Language: "deu", Title: "Forced" }], pref), 8, "The name picks the same track out of two in one language")
    assertEqual(trackMemory.MatchSeries([{ Index: 9, Language: "ger", Title: "Forced" }], pref), 9, "A differently spelled language tag still answers")
    assertEqual(trackMemory.MatchSeries([{ Index: 4, Language: "deu" }, { Index: 5, Language: "deu" }], pref), 4, "Without a matching name the same place in that language answers")
    second = trackMemory.SeriesPref([{ Index: 1, Language: "eng", Title: "English" }, { Index: 2, Language: "eng", Title: "English" }], 2)
    assertEqual(second[2], 1, "Tracks sharing a name keep their place")
    assertEqual(trackMemory.MatchSeries([{ Index: 4, Language: "eng", Title: "English" }, { Index: 5, Language: "eng", Title: "English" }], second), 5, "and are told apart by it")
    earlier = trackMemory.SeriesPref([{ Index: 10, Language: "eng", Title: "English" }], 10)
    episode = [{ Index: 10, Language: "eng", Title: "English (Forced)", DisplayTitle: "English (Forced) - SUBRIP" }, { Index: 11, Language: "eng", DisplayTitle: "English - SUBRIP" }]
    assertEqual(trackMemory.MatchSeries(episode, earlier), 11, "A full track remembered from another episode skips a forced track listed first")
    assertEqual(trackMemory.MatchSeries([eng], pref), invalid, "Nothing in that language gives no answer")
    untagged = trackMemory.SeriesPref([{ Index: 5, Title: "Forced" }], 5)
    assertEqual(trackMemory.MatchSeries([{ Index: 6, Title: "Forced" }], untagged), 6, "An untagged track is matched on its name alone")
    assertEqual(trackMemory.MatchSeries([{ Index: 6, Language: "Unknown", Title: "Forced" }], untagged), 6, "even when it's called Unknown")
    assertEqual(trackMemory.MatchSeries([{ Index: 6, Language: "deu" }], untagged), invalid, "An untagged track with no name to match gives no answer")
    assertEqual(trackMemory.MatchSeries([forced], ["none", "", 0]), -1, "A series kept as off answers off")
    assertEqual(trackMemory.MatchSeries([forced], invalid), invalid, "Nothing kept leaves the choice alone")
    assertEqual(trackMemory.MatchSeries([forced], ["", "", 0]), invalid, "and so does a pick with neither language nor name")
    assertEqual(trackMemory.MatchSeries([{ Track: { Language: "deu", Description: "Forced" }, Index: 12 }], pref), 12, "The player's subtitle list is read the same way")

    memory = trackMemory.Empty()
    trackMemory.WithPick(memory, "movie", "", "subtitle", 3, [eng])
    assertEqual(FormatJson(memory), "{""series"":[],""titles"":[[""movie"",null,3]]}", "A film's pick is kept for the film alone")
    trackMemory.WithPick(memory, "ep1", "show", "audio", 2, [forced, full])
    assertEqual(FormatJson(memory.series), "[[""show"",[""deu"",""full"",0],null]]", "An episode's pick is kept for its series too")
    trackMemory.WithPick(memory, "ep1", "show", "audio", -1, [forced, full])
    assertEqual(memory.titles[1][1], 2, "An audio pick of no track keeps the title's last one")
    assertEqual(memory.series.count(), 0, "and leaves the series without one")

    memory = trackMemory.Empty()
    trackMemory.WithPick(memory, "ep1", "show", "audio", 2, [forced, full])
    assertEqual(trackMemory.RememberedAudio(memory, "ep1", "show", [full, forced]), 2, "A title's own pick comes first")
    assertEqual(trackMemory.RememberedAudio(memory, "ep2", "show", [{ Index: 7, Language: "deu", Title: "Forced" }, { Index: 8, Language: "deu", Title: "Full" }]), 8, "Another episode gets the series pick")
    assertEqual(trackMemory.RememberedAudio(memory, "ep1", "show", [{ Index: 7, Language: "deu", Title: "Forced" }, { Index: 8, Language: "deu", Title: "Full" }]), 8, "A pick no longer in the file falls back to the series")
    assertEqual(trackMemory.RememberedAudio(memory, "movie", "", [full]), -1, "A film with nothing kept leaves it to the settings")

    trackMemory.WithPick(memory, "ep1", "show", "subtitle", -1, [eng])
    assertEqual(trackMemory.RememberedSubtitle(memory, "ep1", "show", [eng]), SubtitleSelection.NONE, "Subtitles turned off stay off")
    assertEqual(trackMemory.RememberedSubtitle(memory, "ep3", "show", [eng]), SubtitleSelection.NONE, "for the rest of the series too")
    assertEqual(trackMemory.RememberedSubtitle(memory, "movie", "", [eng]), SubtitleSelection.NOTSET, "Nothing kept leaves subtitles to the settings")
    trackMemory.WithPick(memory, "movie", "", "subtitle", 3, [eng])
    assertEqual(trackMemory.RememberedSubtitle(memory, "movie", "", [eng]), 3, "A kept subtitle comes back")

    memory = trackMemory.Empty()
    for i = 1 to TRACK_MEMORY_TITLES + 1
        trackMemory.WithPick(memory, `title${i}`, "", "subtitle", 1, [])
    end for
    trackMemory.WithPick(memory, "title2", "", "audio", 1, [])
    assertEqual(memory.titles.count(), TRACK_MEMORY_TITLES, "Only the latest titles are kept")
    assertEqual(memory.titles[0][0], "title3", "the oldest going first")
    assertEqual(memory.titles[TRACK_MEMORY_TITLES - 1][0], "title2", "and a title picked again counting as new")

    assertEqual(trackMemory.Position([{ Type: "Video", Index: 0 }, { Type: "Audio", Index: 2 }, { Type: "Audio", Index: 1 }], "Audio", 1), 2, "A kept index is found again in the version's list")
end sub

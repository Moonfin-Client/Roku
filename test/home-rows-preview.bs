sub testHomeRowsPreview()
    titles = { merged: "Continue Watching & Next Up", resume: "Continue Watching", nextUp: "Next Up" }
    resume = { id: "resume", title: "Continue Watching", items: [previewCard("a", "Episode", { percent: 40 }), previewCard("b", "Movie", { percent: 10 })] }
    nextUp = { id: "nextup", title: "Next Up", items: [previewCard("c", "Episode", {}), previewCard("a", "Episode", {})] }
    films = { id: "latestmedia", title: "Recently Added in Films", items: [previewCard("d", "Movie", {})] }
    shows = { id: "latestmedia", title: "Recently Added in Shows", items: [previewCard("e", "Series", { unplayed: 3 })] }
    genre = { id: "pluginDynamic:genres:https://jf.test:genre:g1", title: "Comedy", items: [previewCard("f", "Movie", { played: true })] }
    party = { id: "watch_parties", title: "Watch Parties", items: [previewCard("g", "WatchPartyRoom", {})] }
    home = [party, resume, nextUp, films, shows, genre]

    ' Home's rows follow the order the Rows screen gives now, rows switched off since Home loaded go,
    ' and each library's Recently Added keeps its place
    order = ["latestmedia", "plugindynamic:genres:https://jf.test:genre:g1", "nextup", "resume"]
    assertEqual(previewRowTitles(homeRowsPreview.Arrange(home, order, false, titles)), "Watch Parties,Recently Added in Films,Recently Added in Shows,Comedy,Next Up,Continue Watching", "The new order, matched on ids in any case, with Watch Parties first")
    assertEqual(previewRowTitles(homeRowsPreview.Arrange(home, ["resume", "latestmedia"], false, titles)), "Watch Parties,Continue Watching,Recently Added in Films,Recently Added in Shows", "Rows the order leaves out are off")

    ' The merge makes one row of the two, in Continue Watching's place, with nothing twice
    merged = homeRowsPreview.Arrange(home, ["nextup", "resume", "latestmedia"], true, titles)
    assertEqual(previewRowTitles(merged), "Watch Parties,Continue Watching & Next Up,Recently Added in Films,Recently Added in Shows", "Merged in Continue Watching's place")
    assertEqual(previewCardIds(merged[1]), "a,b,c", "Continue Watching's titles first, then Next Up's it doesn't already have")
    assertEqual(previewRowTitles(homeRowsPreview.Arrange(home, ["latestmedia", "nextup"], true, titles)), "Watch Parties,Recently Added in Films,Recently Added in Shows,Continue Watching & Next Up", "With Continue Watching off it takes Next Up's place")
    assertEqual(homeRowsPreview.Arrange(home, ["latestmedia"], true, titles).Count(), 3, "and with both off it isn't there")

    ' Turning the merge off splits a merged row by progress
    mergedHome = [{ id: "resume", title: titles.merged, items: [previewCard("a", "Episode", { percent: 40 }), previewCard("c", "Episode", {}), previewCard("b", "Movie", { percent: 10 })] }, films]
    split = homeRowsPreview.Arrange(mergedHome, ["latestmedia", "nextup", "resume"], false, titles)
    assertEqual(previewRowTitles(split), "Recently Added in Films,Next Up,Continue Watching", "The two rows go back to their own places")
    assertEqual(previewCardIds(split[2]), "a,b", "Continue Watching keeps the titles with progress")
    assertEqual(previewCardIds(split[1]), "c", "and Next Up the rest")
    assertEqual(previewRowTitles(homeRowsPreview.Arrange(mergedHome, ["resume", "nextup"], true, titles)), titles.merged, "A merged row stays merged while the merge is on")

    ' The focused row is the first that shows what the setting changes
    arranged = homeRowsPreview.Arrange(home, ["resume", "nextup", "latestmedia", "pluginDynamic:genres:https://jf.test:genre:g1"], false, titles)
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.rowImageType.latestmedia"), 3, "A row's own image type focuses that row")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.rowImageType.nextup"), 2, "whichever row it is")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.tvshows.disableUnwatchedEpisodeCount"), 4, "The unwatched count goes to a row with a count")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.watchedIndicator"), 4, "and so does the watched mark, which shows a count too")
    arranged[1].items[1].played = true
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.watchedIndicator"), 1, "or to a row with a watched title")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.preferThumbnails"), 1, "Prefer Thumbnails goes to a row with an episode")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.posterLabels"), 0, "A setting no row shows starts at the first row")
    arranged[5].items[0].labels = [{ text: "4K" }]
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.posterLabels"), 5, "Poster labels go to a row Home has labels for")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.genresRowSortBy"), 5, "A sort goes to the rows picked from its list")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.mergeRecentRowsByType"), 3, "The Recently Added merge goes to Recently Added")
    assertEqual(homeRowsPreview.FocusIndex(arranged, "ui.home.classicRowsPadding"), 0, "Padding shows from the first row")

    ' Art falls back the way HomeItem's does
    episode = previewCard("h", "Episode", { poster: "series-poster", thumb: "episode-still", wide: "series-thumb" })
    assertEqual(homeRowsPreview.CardArt(episode, "poster", false), "series-poster", "A poster row leads with the poster")
    assertEqual(homeRowsPreview.CardArt(episode, "thumb", false), "series-thumb", "A thumbnail row shows an episode's series art")
    assertEqual(homeRowsPreview.CardArt(episode, "thumb", true), "episode-still", "unless Prefer Thumbnails is on")
    episode.banner = "series-banner"
    assertEqual(homeRowsPreview.CardArt(episode, "banner", false), "series-banner", "A banner row leads with the banner")
    film = previewCard("i", "Movie", { thumb: "film-thumb", wide: "film-wide" })
    assertEqual(homeRowsPreview.CardArt(film, "poster", false), "film-thumb", "A card with no poster falls back to its wide art")
    assertEqual(homeRowsPreview.CardArt(film, "thumb", false), "film-thumb", "and a film's own thumbnail leads its wide art")

    ' The lines under a card
    named = previewCard("j", "Episode", { name: "Pilot", series: "The Show", season: 1, episode: 2 })
    assertEqual(homeRowsPreview.CardText(named, false).Join("|"), "The Show|S1:E2 - Pilot", "Classic puts the series over the episode")
    assertEqual(homeRowsPreview.CardText(named, true).Join("|"), "The Show - S1E2 Pilot|", "Modern writes one line")
    assertEqual(homeRowsPreview.CardText(previewCard("k", "Movie", { name: "Film", subline: "2014" }), false).Join("|"), "Film|2014", "A film shows its year in Classic")
    assertEqual(homeRowsPreview.CardText(previewCard("k", "Movie", { name: "Film", subline: "2014" }), true).Join("|"), "Film|", "and only its name in Modern")
    assertEqual(homeRowsPreview.CardText(previewCard("l", "Episode", { name: "Special" }), false).Join("|"), "Special|", "An episode with no series or numbers shows its name")

    ' Laid out the way HomeRows sizes the cards, the marks going by the values shown
    marks = { indicatorMode: "never", hideUnplayedCount: true, preferThumbs: false, labels: false }
    look = { modern: false, sizeName: "medium", audioRow: false, modernCards: false, fixedBox: invalid, room: homeRowsPreview.CLASSIC_ROOM, imageType: "thumb" }
    many = { id: "resume", title: "Continue Watching", items: [] }
    for i = 1 to 10
        many.items.push(previewCard(i.ToStr(), "Episode", { percent: 50, unplayed: i - 1 }))
    end for
    laid = homeRowsPreview.Laid(many, look, true, marks, 450)
    assertEqual(laid.cards.Count(), 7, "Cards stop where the row's area ends")
    assertEqual(FormatJson([laid.cards[1].x, laid.cards[1].w, laid.cards[1].h]), "[281,261,147]", "Thumbnails at the card size, 20 apart")
    assertEqual(laid.height, 56 + 118 + 147, "The row stands as tall as HomeRows makes it")
    assertEqual(laid.cards[0].percent, 50, "An episode with progress carries it")
    assertEqual(isValid(laid.cards[0].check), false, "A card with nothing to mark carries no mark")
    assertEqual(laid.cards[1].check.indicatorMode, "never", "The mark takes the mode being shown")
    assertEqual(laid.cards[1].check.hideUnplayedCount, true, "and the count switch")
    series = { id: "latestmedia", title: "Shows", items: [previewCard("s", "Series", { percent: 50, labels: [{ text: "4K" }] })] }
    seriesCard = homeRowsPreview.Laid(series, look, false, marks, 0).cards[0]
    assertEqual(seriesCard.percent, 0, "A show's card has no progress bar")
    assertEqual(isValid(seriesCard.labels), false, "Labels stay off while their setting is")
    marks.labels = true
    assertEqual(homeRowsPreview.Laid(series, look, false, marks, 0).cards[0].labels[0].text, "4K", "and show once it's on")

    modernLook = { modern: true, sizeName: "medium", audioRow: false, modernCards: true, fixedBox: homeCards.CardBox("medium", 2 / 3), room: homeRowsPreview.MODERN_INFO_ROOM, imageType: "poster" }
    focusedRow = homeRowsPreview.Laid(many, modernLook, true, marks, 170)
    assertEqual(FormatJson([focusedRow.cards[0].w, focusedRow.cards[0].h, focusedRow.cards[1].x]), "[356,200,376]", "A focused Modern row widens its first card to 16:9 and moves the rest along")
    assertEqual(isValid(focusedRow.cards[0].overview), true, "and shows its details under it")
    assertEqual(homeRowsPreview.Laid(many, modernLook, false, marks, 170).cards[1].x, 154, "A row without focus keeps its posters")

    ' A Genres sort being tried reorders the Genres row, which Home loads whole
    genres = { id: "genres", title: "Genres", items: [previewCard("k", "Genre", { name: "western" }), previewCard("l", "Genre", { name: "Action" }), previewCard("m", "Genre", { name: "comedy" })] }
    sorted = homeRowsPreview.WithGenresSort([films, genres], "name")
    assertEqual(previewCardIds(sorted[1]), "l,m,k", "By name, in any case")
    assertEqual(previewCardIds(genres), "k,l,m", "without changing the row Home loaded")
    assertEqual(sorted[0].title, films.title, "and the other rows stay as they are")
    assertEqual(homeRowsPreview.WithGenresSort([genres], "random")[0].items.Count(), 3, "Shuffled, every genre is still there")
end sub

function previewCard(id as string, itemType as string, extra as object) as object
    card = { id: id, type: itemType, name: id, poster: "", thumb: "", wide: "", banner: "", backdrop: "", outside: false, percent: 0, played: false, unplayed: 0, favorite: false, series: "", season: invalid, episode: invalid, subline: "", year: "", officialRating: "", genres: [], overview: "", labels: invalid }
    card.Append(extra)
    return card
end function

function previewRowTitles(rows as object) as string
    titles = []
    for each row in rows
        titles.push(row.title)
    end for
    return titles.Join(",")
end function

function previewCardIds(row as object) as string
    ids = []
    for each item in row.items
        ids.push(item.id)
    end for
    return ids.Join(",")
end function

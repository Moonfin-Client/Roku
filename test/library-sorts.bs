sub testLibrarySorts()
    assertEqual(sortValues({}), "SortName,DateCreated,PremiereDate,OfficialRating,DatePlayed,PlayCount,CriticRating,CommunityRating,Runtime,Random", "Other libraries keep the parental rating sort")
    assertEqual(sortValues({ movieOrSeries: true }), "SortName,DateCreated,PremiereDate,DatePlayed,PlayCount,CriticRating,CommunityRating,Runtime,Random", "Movies leave parental rating to Group By")
    assertEqual(sortValues({ movieOrSeries: true, series: true, myRating: true }), "MyRating,SortName,DateCreated,DateLastContentAdded,PremiereDate,DatePlayed,PlayCount,CriticRating,CommunityRating,Runtime,Random", "Shows lead with My Rating when the plugin is there and add episode dates")
    assertEqual(sortValues({ foldery: true, myRating: true }), "SortName,DateCreated,PremiereDate,OfficialRating,DatePlayed,PlayCount,CriticRating,CommunityRating,Runtime,Random,FoldersFirst", "Folder view ends on Folders First")
    assertEqual(sortValues({ songs: true }), "SortName,DateCreated,AlbumArtist,Album,Artist,IndexNumber,PremiereDate,DatePlayed,PlayCount,Runtime,Random", "Songs get their own list")
    assertEqual(sortValues({ music: true, myRating: true }), "MyRating,SortName,DateCreated,PremiereDate,DatePlayed,AlbumArtist,Album,Genre,Runtime,Random", "Music gets album and genre sorts")
    assertEqual(librarySorts.Options({ myList: true })[0].value, "OrderAdded", "My List keeps Order Added first")

    assertEqual(librarySorts.Chosen("Runtime", { songs: true }).label, "Length", "Songs call runtime Length")
    assertEqual(librarySorts.Chosen("Runtime", {}).label, "Runtime", "Everything else calls it Runtime")
    assertEqual(librarySorts.Chosen("PremiereDate", {}).label, "Release Date", "Premiere date reads as Release Date")
    assertEqual(librarySorts.Chosen("Bogus", {}).value, "SortName", "An unknown sort falls back to the first")
    assertEqual(librarySorts.KeyFor("PremiereDate,SortName", {}), "PremiereDate", "A stored field finds its row")
    assertEqual(librarySorts.KeyFor("OfficialRating,SortName", { movieOrSeries: true }), "", "A field the library no longer offers finds nothing")
    assertEqual(librarySorts.KeyFor(invalid, {}), "", "Nothing stored finds nothing")

    ratings = [{ ItemId: "b", Rating: 8 }, { ItemId: "a", Rating: 8 }, { ItemId: "c", Rating: 9.5 }, { ItemId: "d" }, { Rating: 3 }]
    assertEqual(librarySorts.MyRatingOrder(ratings, false).join(","), "c,a,b", "My Rating runs best first with ties by id")
    assertEqual(librarySorts.MyRatingOrder(ratings, true).join(","), "a,b,c", "And worst first the other way")
    assertEqual(librarySorts.MyRatingOrder(invalid, true).count(), 0, "No ratings sort to nothing")

    assertEqual(libraryCard.PosterSize(invalid, invalid), "medium", "Nothing picked draws medium")
    assertEqual(libraryCard.PosterSize("large", "small"), "large", "A size picked for libraries wins")
    assertEqual(libraryCard.PosterSize(invalid, "grandparents"), "extraLarge", "The general size steps Grandparents down to Extra Large")
    assertEqual(libraryCard.PosterSize("bogus", "small"), "small", "An unknown size falls back to the general one")

    banner = libraryCard.Metrics("small", "banner", true, false, true, 1746)
    assertEqual(banner.columns, 2, "Banners run two to a row")
    assertEqual(banner.posterHeight, Int((banner.cellWidth - (banner.padX * 2)) / 5.405), "And keep the banner shape")
    assertEqual(libraryCard.Metrics("large", "banner", true, false, true, 1335).columns, 2, "Even beside the Docked panel")
end sub

function sortValues(kind as object) as string
    values = []
    for each option in librarySorts.Options(kind)
        values.push(option.value)
    end for
    return values.join(",")
end function

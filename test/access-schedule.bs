sub testAccessSchedule()
    HOUR = 3600
    MON = 1
    TUE = 2
    FRI = 5
    SAT = 6
    SUN = 0
    entry = function(name, startHour, endHour)
        return { DayOfWeek: name, StartHour: startHour, EndHour: endHour }
    end function
    read = function(entries)
        return accessSchedule.Read({ AccessSchedules: entries })
    end function

    window = read([entry("Monday", 8, 20)])
    assertEqual(accessSchedule.IsAllowed([], MON, 3 * HOUR), true, "A user with no entries is always allowed")
    assertEqual(accessSchedule.IsAllowed(window, MON, 12 * HOUR), true, "Allowed inside the hours")
    assertEqual(accessSchedule.IsAllowed(window, MON, 8 * HOUR), true, "The start itself is allowed")
    assertEqual(accessSchedule.IsAllowed(window, MON, 20 * HOUR), true, "The end itself is allowed")
    assertEqual(accessSchedule.IsAllowed(window, MON, 8 * HOUR - 1), false, "Not before the start")
    assertEqual(accessSchedule.IsAllowed(window, MON, 20 * HOUR + 1), false, "Not after the end")
    assertEqual(accessSchedule.IsAllowed(window, TUE, 12 * HOUR), false, "Not on another day")

    halves = read([entry("Monday", 8.5, 17.5)])
    assertEqual(accessSchedule.IsAllowed(halves, MON, 8 * HOUR + 1799), false, "Half hours: before 8:30")
    assertEqual(accessSchedule.IsAllowed(halves, MON, 8 * HOUR + 1800), true, "Half hours: at 8:30")
    assertEqual(accessSchedule.IsAllowed(halves, MON, 17 * HOUR + 1800), true, "Half hours: at 17:30")
    assertEqual(accessSchedule.IsAllowed(halves, MON, 17 * HOUR + 1801), false, "Half hours: after 17:30")

    for each day in [MON, FRI, SAT, SUN]
        assertEqual(accessSchedule.IsAllowed(read([entry("Everyday", 8, 20)]), day, 12 * HOUR), true, "Everyday covers every day")
    end for
    assertEqual(accessSchedule.IsAllowed(read([entry("Weekday", 8, 20)]), FRI, 12 * HOUR), true, "Weekday covers Friday")
    assertEqual(accessSchedule.IsAllowed(read([entry("Weekday", 8, 20)]), SAT, 12 * HOUR), false, "Weekday leaves out Saturday")
    assertEqual(accessSchedule.IsAllowed(read([entry("Weekend", 8, 20)]), SUN, 12 * HOUR), true, "Weekend covers Sunday")
    assertEqual(accessSchedule.IsAllowed(read([entry("Weekend", 8, 20)]), MON, 12 * HOUR), false, "Weekend leaves out Monday")

    two = read([entry("Monday", 8, 10), entry("Monday", 18, 20)])
    assertEqual(accessSchedule.IsAllowed(two, MON, 9 * HOUR), true, "Any one entry is enough")
    assertEqual(accessSchedule.IsAllowed(two, MON, 12 * HOUR), false, "Between two entries is closed")

    toMidnight = read([entry("Monday", 18, 24)])
    assertEqual(accessSchedule.IsAllowed(toMidnight, MON, 24 * HOUR - 1), true, "An end of 24 runs to the end of the day")
    assertEqual(accessSchedule.IsAllowed(read([entry("Someday", 0, 24)]), MON, 12 * HOUR), false, "A day name the server doesn't use covers nothing")

    assertEqual(accessSchedule.Read(invalid).Count(), 0, "No policy reads as no entries")
    assertEqual(accessSchedule.Read({}).Count(), 0, "No schedules read as no entries")
    assertEqual(accessSchedule.Read({ AccessSchedules: "nonsense" }).Count(), 0, "Nonsense reads as no entries")
    assertEqual(accessSchedule.Read({ AccessSchedules: [invalid, 5, "x", entry("Monday", 1, 2)] }).Count(), 1, "What is not an entry is left out")

    ' When the user is next let in
    assertEqual(accessSchedule.NextAccess(window, MON, 12 * HOUR), invalid, "Nothing to wait for while allowed")
    sameDay = accessSchedule.NextAccess(window, MON, 7 * HOUR)
    assertEqual(sameDay.seconds, HOUR, "A later start the same day")
    assertEqual(sameDay.dayOffset, 0, "Opens today")
    assertEqual(sameDay.secondOfDay, 8 * HOUR, "Opens at 8:00")
    nextDay = accessSchedule.NextAccess(read([entry("Monday", 8, 20), entry("Tuesday", 9, 20)]), MON, 21 * HOUR)
    assertEqual(nextDay.dayOffset, 1, "The next day an entry covers")
    assertEqual(nextDay.day, TUE, "Opens on Tuesday")
    assertEqual(nextDay.seconds, 12 * HOUR, "From 21:00 to 9:00 the next day")
    weekend = accessSchedule.NextAccess(read([entry("Weekday", 8, 20)]), FRI, 21 * HOUR)
    assertEqual(weekend.dayOffset, 3, "The weekend is skipped")
    assertEqual(weekend.day, MON, "Opens on Monday")
    nextWeek = accessSchedule.NextAccess(window, MON, 21 * HOUR)
    assertEqual(nextWeek.dayOffset, 7, "An entry that only covers today opens a week on")
    earliest = accessSchedule.NextAccess(read([entry("Monday", 15, 20), entry("Monday", 9, 10)]), MON, 6 * HOUR)
    assertEqual(earliest.secondOfDay, 9 * HOUR, "The earliest of several entries")
    assertEqual(accessSchedule.NextAccess(read([entry("Someday", 8, 20)]), MON, 6 * HOUR), invalid, "No entry opens, so no time to name")

    ' When the answer could change
    assertEqual(accessSchedule.SecondsToBoundary(window, MON, 12 * HOUR), 8 * HOUR + 1, "The second after the end while allowed")
    assertEqual(accessSchedule.SecondsToBoundary(read([entry("Monday", 8, 20), entry("Tuesday", 8, 20)]), MON, 21 * HOUR), 11 * HOUR, "The next start while closed")
    assertEqual(accessSchedule.SecondsToBoundary([], MON, 12 * HOUR), invalid, "No entries have no boundary")

    ' Whose answer decides
    assertEqual(accessSchedule.RefusedBy(403), true, "A 403 from /Users/Me is the server turning the user away")
    assertEqual(accessSchedule.RefusedBy(200), false, "An answer from /Users/Me lets the user in")
    for each status in [0, 401, 500]
        assertEqual(accessSchedule.RefusedBy(status), invalid, "Anything else is no answer")
    end for
    assertEqual(accessSchedule.Status(window, false, MON, 21 * HOUR).blocked, false, "The server letting the user in wins over this device's clock")
    refusedHere = accessSchedule.Status(window, true, MON, 12 * HOUR)
    assertEqual(refusedHere.blocked, true, "The server turning the user away wins over this device's clock")
    assertEqual(refusedHere.next, invalid, "No opening is named while this device's clock says the hours are open")
    assertEqual(accessSchedule.Status(window, true, MON, 7 * HOUR).next.secondOfDay, 8 * HOUR, "The opening is named when both clocks agree")
    assertEqual(accessSchedule.Status(window, invalid, MON, 12 * HOUR).blocked, false, "Without an answer this device's clock decides, open")
    noAnswer = accessSchedule.Status(window, invalid, MON, 21 * HOUR)
    assertEqual(noAnswer.blocked, true, "Without an answer this device's clock decides, closed")
    assertEqual(noAnswer.next.dayOffset, 7, "And names the next opening")

    ' The server's clock, whatever zone this device is in. 2026-03-01 is a Sunday.
    deviceNow = 1772407800 ' 2026-03-01T23:30:00Z
    answer = function(utcTime, offset)
        return { utcTime: utcTime, utcOffsetSeconds: offset }
    end function
    ahead = accessSchedule.ServerClock(answer("2026-03-01T23:30:00Z", 19800), deviceNow)
    assertEqual(ahead.skew, 0, "A server agreeing on the instant has no skew")
    assertEqual(ahead.offset, 19800, "The offset is the server's")
    sunday = accessSchedule.ServerWallClock(ahead, deviceNow)
    assertEqual(sunday.day, MON, "Five and a half hours east of UTC it's already Monday")
    assertEqual(sunday.secondOfDay, 5 * HOUR, "And five in the morning")
    behind = accessSchedule.ServerWallClock(accessSchedule.ServerClock(answer("2026-03-01T23:30:00Z", -28800), deviceNow), deviceNow)
    assertEqual(behind.day, SUN, "Eight hours west of UTC it's still Sunday")
    assertEqual(behind.secondOfDay, 15 * HOUR + 1800, "At half past three in the afternoon")
    skewed = accessSchedule.ServerClock(answer("2026-03-01T23:30:30Z", 0), deviceNow)
    assertEqual(skewed.skew, 30, "A server clock ahead of this device's is kept as skew")
    assertEqual(accessSchedule.ServerWallClock(skewed, deviceNow + 90).secondOfDay, 23 * HOUR + 1800 + 120, "And applies as time passes")
    assertEqual(accessSchedule.ServerWallClock(ahead, deviceNow + 1800).day, MON, "The clock keeps running after the look")
    assertEqual(accessSchedule.ServerClock(invalid, deviceNow), invalid, "No answer is no clock")
    assertEqual(accessSchedule.ServerClock({}, deviceNow), invalid, "An answer without a time is no clock")
    assertEqual(accessSchedule.ServerClock(answer("2026-03-01T23:30:00Z", "x"), deviceNow), invalid, "A nonsense offset is no clock")
    assertEqual(accessSchedule.ServerClock(answer("not a time", 0), deviceNow), invalid, "A nonsense time is no clock")
end sub

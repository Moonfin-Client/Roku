' Dates the server sends, where .NET's minimum date stands for one it doesn't have
sub testServerDate()
    assertEqual(isServerDate("2024-03-05T12:00:00.0000000Z"), true, "A real date is a date")
    assertEqual(isServerDate("0001-01-01T00:00:00.0000000Z"), false, ".NET's empty date is no date")
    assertEqual(isServerDate("0001-01-01T00:00:00"), false, "with or without the zone")
    assertEqual(isServerDate(""), false, "An empty string is no date")
    assertEqual(isServerDate(invalid), false, "and nothing is no date")
    assertEqual(isServerDate("not a date"), false, "and words aren't a date")
    assertEqual(liveTvGuide.ParseTime("0001-01-01T00:00:00Z"), 0, "A time the server doesn't have reads as none")
    assertEqual(liveTvGuide.IsUpcomingTimer({ Status: "New", EndDate: "0001-01-01T00:00:00Z" }, 100), true, "so a timer with no end stays on the schedule")
    assertEqual(fileFacts.AddedOn("0001-01-01T00:00:00.0000000Z"), "", "A file with no added date shows none")
    assertEqual(formatPersonDate("0001-01-01T00:00:00.0000000Z"), "", "A person with no birthday shows none")
    assertEqual(personAge("0001-01-01T00:00:00.0000000Z"), 0, "and no age")
    assertEqual(formatPersonDate("1964-09-02T00:00:00.0000000Z"), "September 2, 1964", "A birthday reads as the day the server wrote")
end sub

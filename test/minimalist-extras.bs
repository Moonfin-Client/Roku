' When Minimalist offers its Extras button
sub testMinimalistExtras()
    assertEqual(minimalistRules.ShowsExtrasButton("Movie", 2, false), true, "A film with extras gets the Extras button")
    assertEqual(minimalistRules.ShowsExtrasButton("Video", 1, false), true, "and so does a video")
    assertEqual(minimalistRules.ShowsExtrasButton("Movie", 0, false), false, "Nothing to show means no button")
    assertEqual(minimalistRules.ShowsExtrasButton("Movie", 2, true), false, "Kids Mode leaves it out")
    assertEqual(minimalistRules.ShowsExtrasButton("Series", 2, false), false, "A series keeps its episode tabs instead")
    assertEqual(minimalistRules.ShowsExtrasButton("Season", 2, false), false, "and so does a season")
    assertEqual(minimalistRules.ShowsExtrasButton("Episode", 2, false), false, "and an episode")
end sub

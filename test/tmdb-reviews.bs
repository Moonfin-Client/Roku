sub testTmdbReviews()
    cards = tmdbReviews.Parse({
        success: true,
        totalResults: 3,
        reviews: [
            { id: "1", author: "Brett Pascoe", rating: 9.0, content: "**Great** show." + Chr(10) + Chr(10) + "Second [part](https://example.com).", createdAt: "2021-06-23T10:11:12.000Z", avatarUrl: "https://img/a.jpg", url: "https://www.themoviedb.org/review/1" },
            { id: "2", author: "anna", rating: invalid, content: "Fine", createdAt: "", avatarUrl: invalid },
            { id: "3", author: "Nobody", rating: 7, content: "   " }
        ]
    })
    assertEqual(cards.count(), 2, "A review with no text is left out")
    assertEqual(cards[0].author, "Brett Pascoe", "The author is kept")
    assertEqual(cards[0].rating, "9", "A whole score drops its decimal")
    assertEqual(cards[0].preview, "Great show. Second part.", "The preview reads as plain text on one line")
    assertEqual(Instr(1, cards[0].content, "[part](https://example.com)") > 0, true, "The dialog gets the markdown as written")
    assertEqual(cards[0].DoesExist("url"), false, "The TMDB page address is never kept")
    assertEqual(cards[0].date <> "", true, "The date reads as a day")
    assertEqual(cards[0].avatarUrl, "https://img/a.jpg", "The avatar is kept")
    assertEqual(cards[1].initial, "A", "A reviewer with no picture gets a capital initial")
    assertEqual(cards[1].rating, "", "No score, no rating")
    assertEqual(cards[1].avatarUrl, "", "No avatar reads as empty")
    assertEqual(cards[1].date, "", "No date reads as empty")

    assertEqual(tmdbReviews.RatingText(7.5), "7.5", "A half point is kept")
    assertEqual(tmdbReviews.RatingText(8.333), "8.3", "A score is rounded to one decimal")
    assertEqual(tmdbReviews.RatingText(10), "10", "A whole number stays whole")
    assertEqual(tmdbReviews.RatingText("9"), "", "Text isn't a score")
    assertEqual(tmdbReviews.MetaLine({ rating: "9", date: "" }), "9 / 10", "The score reads out of ten")
    assertEqual(tmdbReviews.MetaLine({ rating: "", date: "" }), "", "Nothing to say leaves the line empty")

    assertEqual(tmdbReviews.Parse({ success: false, error: "TMDB is not configured" }).count(), 0, "A failed answer has no reviews")
    assertEqual(tmdbReviews.Parse({ reviews: [{ author: "x", content: "y" }] }).count(), 0, "An answer that doesn't say it worked has no reviews")
    assertEqual(tmdbReviews.Parse(invalid).count(), 0, "No answer has no reviews")

    show = tmdbReviews.Target({ Type: "Series", ProviderIds: { Tmdb: "105248" } })
    assertEqual(show.mediaType, "tv", "A show asks for tv reviews")
    assertEqual(show.tmdbId, "105248", "The TMDB id is sent as is")
    assertEqual(tmdbReviews.Target({ Type: "Movie", ProviderIds: { Tmdb: "557" } }).mediaType, "movie", "A movie asks for movie reviews")
    assertEqual(tmdbReviews.Target({ Type: "Movie", ProviderIds: {} }), invalid, "No TMDB id, no reviews")
    assertEqual(tmdbReviews.Target({ Type: "Episode", ProviderIds: { Tmdb: "1" } }), invalid, "Only movies and shows have reviews")

    assertEqual(tmdbReviews.InsertAt(["a", "c"], 1, "b").Join(","), "a,b,c", "The reviews slot in between")
    assertEqual(tmdbReviews.InsertAt(["a"], 1, "b").Join(","), "a,b", "The reviews go on the end when nothing follows them")
end sub

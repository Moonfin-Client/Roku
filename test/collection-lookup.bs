sub testCollectionLookup()
    ace = { Id: "box-ace", Name: "Ace Collection", ProviderIds: { Tmdb: "3167" } }
    mine = { Id: "box-mine", Name: "My Picks", ProviderIds: {} }
    alien = { Id: "box-alien", Name: "Alien Collection", ProviderIds: { Tmdb: "8091" } }
    m.collectionServer = { route: invalid, collections: [alien, mine, ace], members: { "box-mine": [{ Id: "movie-1" }, { Id: "movie-2" }], "box-ace": [{ Id: "movie-1" }] }, asked: 0 }
    m.global = {
        hasField: function(name as string) as boolean
            return m.DoesExist(name)
        end function,
        addFields: sub(fields as object)
            m.Append(fields)
        end sub,
        removeField: sub(name as string)
            m.Delete(name)
        end sub
    }
    movie = { Id: "movie-1", ProviderIds: { TmdbCollection: "3167" } }

    assertEqual(collectionIds(findParents(movie)), "box-ace,box-mine", "An old server lists every collection holding the title, the one it names first")
    assertEqual(m.collectionServer.asked, 3, "Every collection was asked what it holds")
    assertEqual(collectionIds(findParents({ Id: "movie-2", ProviderIds: {} })), "box-mine", "A title in a hand made collection alone is found")
    assertEqual(m.collectionServer.asked, 3, "The asking is done once for the session")

    m.collectionServer.route = { Items: [mine, ace] }
    assertEqual(collectionIds(findParents(movie)), "box-ace,box-mine", "Jellyfin 12 answers outright, the named one still first")

    ' Signing out drops what the last account was told, and the next one sees its own collections
    m.global.removeField("collectionOwners")
    m.collectionServer.route = invalid
    m.collectionServer.members = { "box-alien": [{ Id: "movie-2" }] }
    assertEqual(collectionIds(findParents({ Id: "movie-2", ProviderIds: {} })), "box-alien", "The next account asks again instead of reading the last one's answers")
    assertEqual(m.collectionServer.asked, 6, "Every collection was asked again")

    ' A collection's own titles come a page at a time, each from where the last one stopped
    m.collectionServer.members = { "box-big": [{ Id: "a" }, { Id: "b" }, { Id: "c" }, { Id: "d" }, { Id: "e" }] }
    firstPage = collectionPage("box-big", 0, 2, "")
    assertEqual(collectionIds(firstPage.items), "a,b", "The first page holds as many titles as were asked for")
    assertEqual(firstPage.nextIndex, 2, "The next page starts after them")
    assertEqual(firstPage.hasMore, true, "and the server's total says there is one")
    lastPage = collectionPage("box-big", 4, 2, "")
    assertEqual(collectionIds(lastPage.items), "e", "The last page holds what is left")
    assertEqual(lastPage.hasMore, false, "and nothing comes after it")
    rest = collectionPage("box-big", 2, 0, "")
    assertEqual(collectionIds(rest.items), "c,d,e", "Play reads every title left in one go")
    assertEqual(rest.hasMore, false, "which leaves nothing to load")

    m.collectionServer.noTotal = true
    assertEqual(collectionPage("box-big", 0, 2, "").hasMore, true, "A server that sends no total is taken to have more behind a full page")
    assertEqual(collectionPage("box-big", 4, 2, "").hasMore, false, "and none behind a short one")
    m.collectionServer.Delete("noTotal")
    assertEqual(collectionPage("box-gone", 0, 2, "").hasMore, false, "A page that brings nothing ends the run, so nothing keeps asking")
end sub

' Stands in for the server the lookup asks: the Jellyfin 12 route, the list of collections, then
' what each one holds
function fetch(path as string, params as object) as dynamic
    server = m.collectionServer
    if path.Instr("/Collections") >= 0 then return server.route
    if isValid(params.ParentId)
        server.asked = server.asked + 1
        members = server.members[params.ParentId] ?? []
        if not isValid(params.StartIndex) then return { Items: members }

        ' A page from StartIndex, Limit long when there is one
        page = []
        final = members.count() - 1
        if isValid(params.Limit) and params.StartIndex + params.Limit - 1 < final then final = params.StartIndex + params.Limit - 1
        for i = params.StartIndex to final
            page.push(members[i])
        end for
        if server.DoesExist("noTotal") then return { Items: page }
        return { Items: page, TotalRecordCount: members.count() }
    end if
    return { Items: server.collections }
end function

function collectionIds(collections as object) as string
    ids = []
    for each collection in collections
        ids.push(collection.Id)
    end for
    return ids.Join(",")
end function

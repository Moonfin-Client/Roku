sub testHomeReloadSettings()
    assertEqual(homeRowLayout.ReloadsHome("ui.home.displayStudiosRows"), true, "Turning a row type on or off has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.collectionsRowSortBy"), true, "A row's sort has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.rewatchIncludeShows"), true, "A row's options have Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.mergeContinueWatchingNextUp"), true, "Merging Continue Watching and Next Up has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.details.maxdaysnextup"), true, "Next Up's day limit has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.recentlyReleasedSeriesType"), true, "Recently Released's series choice has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.mergeRecentRowsByType"), true, "Merging the Recently Added rows has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.enableMultiServer"), true, "Turning Multi-Server Libraries on or off has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("tmdb.popularmovies"), true, "An External Lists row switch has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("seerr.row.trending"), true, "A Seerr row switch has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("calendar.radarr.enabled"), true, "A calendar row switch has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("imdb.rowsSortBy"), true, "An External Lists sort has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("calendar.merge"), true, "A calendar row option has Home build its rows again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.rowInfoOverlay"), true, "Home Row Info Overlay has Home lay its Classic rows out again")
    assertEqual(homeRowLayout.ReloadsHome("ui.home.rowsStyle"), false, "A setting that only changes how the rows look leaves them loaded")
    assertEqual(homeRowLayout.ReloadsHome("playback.subs.style.color"), false, "A setting outside Home leaves its rows loaded")
    assertEqual(homeRowLayout.ReloadsHome(""), false, "No setting leaves Home's rows loaded")
end sub

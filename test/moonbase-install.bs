sub testMoonbaseInstall()
    jellyfin = moonbaseInstall.Features("jellyfin")
    assertEqual(jellyfin.count(), 8, "Jellyfin gets the full plugin")
    assertEqual(jellyfin[2], "Seerr requests", "with Seerr requests")
    assertEqual(jellyfin[5], "A calendar of what's coming up", "and the calendar")
    assertEqual(moonbaseInstall.Features("emby").count(), 8, "Emby gets the same list")

    plex = moonbaseInstall.Features("plex")
    assertEqual(plex.join("|"), "Settings synced across your devices|Extra ratings and TMDB reviews|A calendar of what's coming up|Your own order for each collection|Custom themes|Messages from your server admin", "Plex gets the smaller set with the calendar")
    siloFeatures = moonbaseInstall.Features("silo")
    assertEqual(siloFeatures.count(), 5, "Silo has no calendar")
    assertEqual(siloFeatures[2], "Your own order for each collection", "but keeps the collection order")

    assertEqual(moonbaseInstall.GuideUrl("emby"), "https://github.com/Moonfin-Client/Plugin/wiki/Installation#emby", "Each server links its own install steps")

    other = ParseJson("{""Name"":""Jellyfin Stable"",""Url"":""https://repo.jellyfin.org/files/plugin/manifest.json"",""Enabled"":true}")
    added = moonbaseInstall.RepositoriesWith([other])
    assertEqual(added.count(), 2, "Moonbase is added next to the server's own repositories")
    assertEqual(added[0].Name, "Jellyfin Stable", "which stay first")
    assertEqual(FormatJson(added[1]).Instr("""Url"":""" + moonbaseInstall.MANIFEST_URL + """") >= 0, true, "and it goes up with the key case the server reads")

    enabled = ParseJson("{""Name"":""Mine"",""Url"":""" + moonbaseInstall.MANIFEST_URL + """,""Enabled"":true}")
    assertEqual(moonbaseInstall.RepositoriesWith([other, enabled]), invalid, "A Moonbase repository that is already on is left alone")

    disabled = ParseJson("{""Name"":""Mine"",""Url"":""" + moonbaseInstall.MANIFEST_URL + """,""Enabled"":false}")
    replaced = moonbaseInstall.RepositoriesWith([disabled, other])
    assertEqual(replaced.count(), 2, "A turned off Moonbase repository is replaced")
    assertEqual(replaced[1].Enabled, true, "by one that is on")
end sub

sub testPersonRole()
    ' Someone who directed and acted in a title is listed once per credit
    item = { People: [
        { Id: "p2", Role: "Fry", Type: "Actor" },
        { Id: "p1", Role: "", Type: "Director" },
        { Id: "p1", Role: " Bender (voice) ", Type: "Actor" }
    ] }
    assertEqual(personRoleIn(item, "p1"), "Bender (voice)", "The matching credit with a role is read, trimmed")
    assertEqual(personRoleIn(item, "p3"), "", "Someone not in the cast has no role")
    assertEqual(personRoleIn({ People: [{ Id: "p1", Role: "Wakka" + Chr(10) + "Kimahri" + Chr(10) }] }, "p1"), "Wakka, Kimahri", "Several roles read as one")
    assertEqual(personRoleIn({}, "p1"), "", "A title without People has no role")
end sub

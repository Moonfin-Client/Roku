sub testSignInRefused()
    m.global.session.server = { url: "https://jellyfin.test", serverType: "jellyfin" }
    refused = signInRefusedMessage()
    assertEqual(passwordLoginError(403), refused, "A 403 from Jellyfin says the account can't sign in right now")
    assertEqual(passwordLoginError(401) <> refused, true, "A wrong password keeps its own message")
    assertEqual(passwordLoginError(500).Instr("500") >= 0, true, "Other failures keep their messages")
    assertEqual(refused.Instr("allowed hours") >= 0, true, "The message names the schedule as one possible reason")

    m.requests = []
    m.responses = [{ status: 403, data: invalid }]
    result = AuthenticateViaQuickConnect("secret")
    assertEqual(result.refused, true, "A refused Quick Connect exchange is reported as refused")
    assertEqual(result.ok, false, "A refused Quick Connect exchange does not sign in")
    assertEqual(m.requests[0].url, "https://jellyfin.test/Users/AuthenticateWithQuickConnect", "The exchange goes to the Quick Connect route")
    assertEqual(ParseJson(m.requests[0].body).secret, "secret", "The exchange sends the approved secret")

    m.responses = [{ status: 500, data: invalid }]
    result = AuthenticateViaQuickConnect("secret")
    assertEqual(result.refused, false, "A server error is not a refusal")
    assertEqual(result.ok, false, "A server error does not sign in")
end sub

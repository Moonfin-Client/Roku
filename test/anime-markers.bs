' The admin can ask for the short Sub, Dub and Sub/Dub audio labels, which change only the audio pill
sub testAnimeMarkers()
    marker = { kind: "Filler", audio: "SubbedAndDubbed" }
    pills = animeMarkers.PillsFor(marker)
    assertEqual(pills.count(), 2, "Anime markers draw the kind and the audio")
    assertEqual(pills[1].label, "Subbed/Dubbed", "Anime markers use the full audio label by default")

    marker.labelStyle = "full"
    assertEqual(animeMarkers.PillsFor(marker)[1].label, "Subbed/Dubbed", "Anime markers keep the full audio label when the plugin asks for it")

    marker.labelStyle = "short"
    pills = animeMarkers.PillsFor(marker)
    assertEqual(pills[0].label, "Filler", "Anime markers leave the kind label alone with short labels")
    assertEqual(pills[1].label, "Sub/Dub", "Anime markers shorten Subbed/Dubbed")
    assertEqual(animeMarkers.PillsFor({ audio: "Subbed", labelStyle: "short" })[0].label, "Sub", "Anime markers shorten Subbed")
    assertEqual(animeMarkers.PillsFor({ audio: "Dubbed", labelStyle: "short" })[0].label, "Dub", "Anime markers shorten Dubbed")
end sub

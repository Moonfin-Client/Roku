sub testAccentFolding()
    assertEqual(accentFolding.Fold("Cançó"), "CanCO", "Accents fold onto the plain letter")
    assertEqual(accentFolding.Fold("Ángel"), "Angel", "A leading accent folds")
    assertEqual(accentFolding.Fold("Æ Ð Ø Þ Ł"), "A D O T L", "Letters with no decomposition still fold")
    assertEqual(accentFolding.Fold("Ω Project 東京 ß"), "Ω Project 東京 ß", "Letters outside the table stay")
    assertEqual(accentFolding.Fold("Plain Name"), "Plain Name", "A plain name comes straight back")
    for each spelling in ["Cançó", "canço", "CANCO"]
        assertEqual(accentFolding.ForSearch(spelling), "canco", "Search folds " + spelling)
    end for
    letters = [
        ["Alien", "A"], ["alien 3", "A"], ["Blade Runner", "B"], ["2001", "#"], ["Ω Project", "#"],
        ["Ángel", "A"], ["Øster", "O"], ["Łódź", "L"], ["東京", "#"], ["  zorro", "Z"], ["", ""]
    ]
    for each pair in letters
        assertEqual(accentFolding.StartLetter(pair[0]), pair[1], "Start letter of " + pair[0])
    end for
end sub

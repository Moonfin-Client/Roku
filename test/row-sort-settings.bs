' The sort and sort order a Home row is given in Row Options, or from another client through the plugin
sub testRowSortSettings()
    assertEqual(rowSortOrderParam("descending"), "Descending", "A row set to descending asks the server for it")
    assertEqual(rowSortOrderParam("Descending"), "Descending", "However a synced value spells it")
    assertEqual(rowSortOrderParam("ascending"), "Ascending", "A row set to ascending asks the server for it")
    assertEqual(rowSortOrderParam(""), "Ascending", "A row with no order goes ascending, as it did before")

    assertEqual(rowSortByParam("dateAdded"), "DateCreated", "Audio by Date Added sorts on when the album was added")
    assertEqual(rowSortByParam("premiereDate"), "PremiereDate", "Audio by Release Date sorts on the album's release")
    assertEqual(rowSortByParam("runtime"), "Runtime", "Audio by Runtime sorts on the album's length")
    assertEqual(rowSortByParam("playCount"), "SortName", "A sort Roku doesn't offer, synced from another client, falls back to the name")

    for each name in ["ui.home.collectionsRowSortOrder", "ui.home.audioRowsSortBy", "ui.home.audioRowsSortOrder"]
        assertEqual(homeRowLayout.ReloadsHome(name), true, name + " has Home build its rows again")
    end for
end sub

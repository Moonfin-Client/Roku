sub testKeyboardLayouts()
    rows = keyboardLayouts.Docked("qwerty", false, false)
    assertEqual(rows.count(), 4, "The dock has four rows")
    for each cells in rows
        assertEqual(cells.count(), 12, "Every dock row has twelve cells")
    end for
    assertEqual(rows[0][1], "q", "The first letter row follows the rail")
    assertEqual(rows[2][8], ",", "The third row keeps Classic's characters without shift and backspace")
    assertEqual(rows[2][10], "@", "The third row ends its characters with the at sign")
    assertEqual(rows[1][11], "BACKSPACE", "Delete covers the first two rows")
    assertEqual(rows[3][8], "SPACE", "Space runs on into the cell a paste key would take")
    assertEqual(keyboardLayouts.Docked("qwerty", false, true)[0][1], "Q", "Capitals come from the shifted rows")
    assertEqual(keyboardLayouts.Docked("qwerty", true, false)[2][10], ".", "The number page drops the semicolon")

    landing = keyboardLayouts.DockedStep(rows, 0, 10, "right")
    assertEqual(landing.col, 11, "Right from the last letter reaches Delete")
    landing = keyboardLayouts.DockedStep(rows, 0, 11, "right")
    assertEqual(landing.col, 0, "Right from the action column wraps to the rail")
    landing = keyboardLayouts.DockedStep(rows, 3, 5, "left")
    assertEqual(landing.col, 0, "Left from space passes the rest of it")
    landing = keyboardLayouts.DockedStep(rows, 3, 5, "right")
    assertEqual(landing.col, 9, "Right from space lands past its last cell")
    landing = keyboardLayouts.DockedStep(rows, 0, 11, "down")
    assertEqual(landing.row, 2, "One press crosses Delete")
    landing = keyboardLayouts.DockedStep(rows, 2, 11, "down")
    assertEqual(landing.row, 2, "Down off the foot stays put")
    landing = keyboardLayouts.DockedStep(rows, 3, 5, "up")
    assertEqual(landing.col, 5, "Up from space keeps the column it was entered at")
    assertEqual(keyboardLayouts.DockedStep(rows, 1, 11, "up"), invalid, "Up from the top of Delete leaves the keys")

    for each grid in [keyboardLayouts.Lower("qwerty"), keyboardLayouts.Upper("azerty"), keyboardLayouts.Numeric()]
        bottomRow = grid[grid.count() - 1]
        assertEqual(bottomRow[bottomRow.count() - 2], "IME", "Classic and Glass have the keyboard key just before Done")
    end for
    assertEqual(keyboardLayouts.KeyUnitSpan("IME"), keyboardLayouts.KeyUnitSpan("DONE"), "The keyboard key is as wide as Done")
    ids = []
    for each style in keyboardLayouts.Styles()
        ids.push(style.id)
    end for
    assertEqual(ids.join(","), "native,classic,glass,docked", "The picker lists the styles in the setting's order")
end sub

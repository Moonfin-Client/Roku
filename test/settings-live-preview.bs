sub testSettingsLivePreview()
    ' The chips sit right with their own widths, and the label takes what's left
    roomy = headerLayout([100, 160, 110, 110], 10, 1040, 24)
    assertEqual(roomy.start, 530, "The chips end at the stage's right edge")
    assertEqual(roomy.labelWidth, 486, "The label runs up to the chips")
    tight = headerLayout([300, 300, 300, 100], 10, 1040, 24)
    assertEqual(tight.start, 10, "Wide chips push the label out")
    assertEqual(tight.labelWidth, 0, "A label with no room goes")
    over = headerLayout([400, 400, 400, 400], 10, 1040, 24)
    assertEqual(over.start, 0, "Chips wider than the stage still start on it, so the first shows whole")

    ' A picker's chips show whole, around the one in the preview, with room for dots where some are left out
    assertEqual(shownChips(optionRange([100, 100, 100], 10, 984, 28, 2)), "0-2", "Chips that fit all show")
    widths = [100, 200, 150, 120, 160, 190, 220]
    assertEqual(shownChips(optionRange(widths, 10, 984, 28, 1)), "0-4", "The row starts at the first chip while the tried one is in it")
    assertEqual(shownChips(optionRange(widths, 10, 984, 28, -1)), "0-4", "A value no option matches leaves the row at its start")
    assertEqual(shownChips(optionRange(widths, 10, 984, 28, 6)), "2-6", "Trying the last option slides the row to it")
    assertEqual(shownChips(optionRange(widths, 10, 984, 28, 5)), "1-5", "A chip in the middle leaves room for dots on both sides")
    assertEqual(optionsFit(widths, 10, 984, 28, 1, 5), true, "The slid row fits with both sets of dots")
    assertEqual(optionsFit(widths, 10, 984, 28, 0, 5), false, "One more chip wouldn't")

    ' The path names the category, each screen and the heading the row is under
    header = { band: "header", text: "Clock" }
    bands = [[header], [], [{ band: "header", text: "Behavior" }], []]
    assertEqual(settingPath(["General"], bands, 1, "24-Hour Clock"), "General › Clock", "A row takes the heading above the rows before it")
    assertEqual(settingPath(["General"], bands, 3, "Show What's New Popup"), "General › Behavior", "A later heading takes over")
    display = { band: "header", text: "Display" }
    closer = { band: "header", text: "" }
    gap = [[display, closer], []]
    assertEqual(settingPath(["Appearance", "Details Page"], gap, 1, "Sections"), "Appearance › Details Page", "An empty heading closes the one before it")
    assertEqual(settingPath(["Appearance", "Seasonal Effects"], [[{ band: "header", text: "Seasonal Effects" }]], 0, "Density"), "Appearance › Seasonal Effects", "A heading named like its screen shows once")
    assertEqual(settingPath(["Appearance", "Details Page"], [[{ band: "header", text: "Theme Music" }]], 0, "Theme Music"), "Appearance › Details Page", "The row's own name isn't repeated")
    assertEqual(settingPath(["Playback", "Player"], [[{ band: "note", text: "A note" }]], 0, "Seek Step"), "Playback › Player", "A note isn't a heading")

    ' The bar's buttons follow their switches in the real order
    values = { "navbar.position": "top", "navbar.show_shuffle": "true", "navbar.show_favorites": "true", "navbar.show_genres": "true", "navbar.show_livetv": "true", "navbar.show_seerr": "false", "navbar.show_libraries": "true", "navbar.show_libraries_individually": "false", "navbar.show_messages": "false", "navbar.show_friends": "false" }
    libraries = [{ id: "a", name: "Movies", collectionType: "movies" }, { id: "b", name: "Live TV", collectionType: "livetv" }]
    nav = { kids: false, libraries: libraries, seerr: true, social: true }
    assertEqual(previewButtonLabels(navbarButtons(values, nav)), "Home,Search,Shuffle,Favorites,Genres,Live TV,Libraries,Settings", "The default bar")
    values["navbar.position"] = "left"
    assertEqual(previewButtonLabels(navbarButtons(values, nav)), "Home,Search,Shuffle,Genres,Favorites,Live TV,Libraries,Settings", "The sidebar puts Genres first")
    values["navbar.position"] = "top"
    values["navbar.show_shuffle"] = "false"
    values["navbar.show_seerr"] = "true"
    values["navbar.show_messages"] = "true"
    values["navbar.show_friends"] = "true"
    values["navbar.show_libraries_individually"] = "true"
    separate = navbarButtons(values, nav)
    assertEqual(previewButtonLabels(separate), "Home,Search,Favorites,Genres,Live TV,Seerr,Movies,Messages,Friends,Settings", "Every switch on, with the guide's library left to its own button")
    assertEqual(separate[6].glyph, "movie_rounded", "A library leads with its Library Order glyph")
    values["navbar.show_livetv"] = "false"
    assertEqual(previewButtonLabels(navbarButtons(values, nav)), "Home,Search,Favorites,Genres,Seerr,Movies,Live TV,Messages,Friends,Settings", "Without the guide button its library comes back")
    values["navbar.show_livetv"] = "true"
    gated = navbarButtons(values, { kids: false, libraries: [], seerr: false, social: false })
    assertEqual(previewButtonLabels(gated), "Home,Search,Favorites,Genres,Messages,Settings", "No Live TV library, Seerr off and no friends leave their buttons out, and Messages only needs its switch")
    kids = navbarButtons(values, { kids: true, libraries: libraries, seerr: true, social: true })
    assertEqual(previewButtonLabels(kids), "Home,Search,Favorites,Genres,Messages,Settings", "Kids Mode keeps only what it allows")
    calendarNav = { kids: false, libraries: libraries, seerr: true, social: true, calendar: true }
    assertEqual(previewButtonLabels(navbarButtons(values, calendarNav)), "Home,Search,Favorites,Genres,Live TV,Seerr,Calendar,Movies,Messages,Friends,Settings", "Calendar follows Seerr once the server offers it")
    values["navbar.show_calendar"] = "false"
    assertEqual(previewButtonLabels(navbarButtons(values, calendarNav)), "Home,Search,Favorites,Genres,Live TV,Seerr,Movies,Messages,Friends,Settings", "and its switch takes it away")
    values["navbar.show_calendar"] = "true"
    calendarNav.kids = true
    assertEqual(previewButtonLabels(navbarButtons(values, calendarNav)), "Home,Search,Favorites,Genres,Messages,Settings", "Kids Mode leaves it out")

    ' The player's buttons pass the same gates and arrangement as the real controls
    assertEqual(previewButtonIds(buttonLayout.OsdCandidates(false, false, false, false, false)), "speed,audio,quality,info", "A pre-roll without chapters, subtitles or a cast offers speed, audio, bitrate and info")
    assertEqual(previewButtonIds(buttonLayout.OsdCandidates(true, true, true, true, true)), "favorite,speed,chapters,episodes,subtitles,audio,castAndCrew,quality,info", "An episode with everything offers Core's whole row")
    assertEqual(buttonLayout.OsdSecondaryX(5), 498, "The second group starts six past five transport buttons, where Core's does")
    assertEqual(buttonLayout.OsdSecondaryX(0), 24, "With no transport buttons it starts at the row's edge")
    assertEqual(previewButtonIds(arrangedOsdButtons({})), "favorite,speed,chapters,episodes,subtitles,audio,castAndCrew,quality,info", "Nothing saved keeps the declared order")
    arranged = arrangedOsdButtons({ "ui.osd.buttonOrder": "[""subtitles"",""speed"",""chapters"",""episodes"",""audio"",""info""]", "ui.osd.hiddenButtons": "[""chapters""]" })
    assertEqual(previewButtonIds(arranged), "favorite,subtitles,speed,episodes,audio,castAndCrew,quality,info", "The saved order leads, hidden buttons drop out and unplaced ones follow what they were declared after")
    editorRows = [{ id: "subtitles", enabled: true }, { id: "speed", enabled: true }, { id: "chapters", enabled: false }]
    open = editorArrangement(editorRows)
    assertEqual(open.order.Join(","), "subtitles,speed,chapters", "An open editor's order is its rows")
    assertEqual(open.hidden.Join(","), "chapters", "and its switched off rows are the hidden ones")

    ' The time labels read the way the player's controls word them
    assertEqual(osdTimeText("elapsed", 252, 604, 0), "4:12", "Elapsed time, without a leading zero as Core writes it")
    assertEqual(osdTimeText("timeRemaining", 252, 604, 0), "-5:52", "Time left")
    assertEqual(osdTimeText("totalDuration", 252, 604, 0), "10:04", "Total length")
    assertEqual(osdTimeText("none", 252, 604, 0), "", "An empty slot")

    ' Each player setting is seen at the point in the episode it changes
    assertEqual(playerMoment("playback.mediasegments.countdown"), "countdown", "The countdown is seen at the intro with its button up")
    assertEqual(playerMoment("playback.mediasegments.intro"), "intro", "The intro action at the intro")
    assertEqual(playerMoment("playback.mediasegments.outro"), "outro", "The outro action in the credits")
    assertEqual(playerMoment("playback.replaceskipoutrowithnextup"), "outro", "and the outro's Up Next card there too")
    assertEqual(playerMoment("playback.nextuptimeout"), "end", "The card's timeout at the end")
    assertEqual(playerMoment("playback.nextupbehavior"), "end", "and the card's look")
    assertEqual(playerMoment("playback.showNextAirDate"), "airDate", "The air date at the end with no next episode")
    assertEqual(playerMoment("playback.trickplay.pauseWhileScrubbing"), "seek", "Pausing while scrubbing mid-scrub")
    assertEqual(playerMoment("playback.subs.style.size"), "playing", "A subtitle style as it plays")
    assertEqual(playerMoment("playback.timeAboveLeft"), "middle", "Anything else mid-episode")

    ' What comes up there follows the player's own rules
    asked = { "playback.mediasegments.intro": "none", "playback.mediasegments.outro": "asktoskip", "playback.nextupbehavior": "extended", "playback.replaceskipoutrowithnextup": "false", "playback.showNextAirDate": "true" }
    assertEqual(promptAt("countdown", asked), "intro", "The countdown shows on Skip Intro even with the intro set to None")
    assertEqual(promptAt("intro", asked), "", "while the intro on its own follows its action")
    asked["playback.mediasegments.intro"] = "asktoskip"
    assertEqual(promptAt("intro", asked), "intro", "and Ask to Skip offers the button")
    assertEqual(promptAt("outro", asked), "outro", "Skip Outro shows while the outro asks")
    asked["playback.replaceskipoutrowithnextup"] = "true"
    assertEqual(promptAt("outro", asked), "nextUp", "The Up Next card takes its place when asked to")
    asked["playback.nextupbehavior"] = "disabled"
    assertEqual(promptAt("outro", asked), "outro", "but with Next Up Display off the button stays")
    assertEqual(promptAt("end", asked), "", "and the end shows no card")
    assertEqual(promptAt("airDate", asked), "", "not even the air date one")
    asked["playback.nextupbehavior"] = "minimal"
    asked["playback.mediasegments.outro"] = "skip"
    assertEqual(promptAt("outro", asked), "", "An outro that skips itself offers nothing to replace")
    assertEqual(promptAt("end", asked), "nextUp", "The Up Next card shows at the end")
    assertEqual(promptAt("airDate", asked), "airDate", "and the air date card when there's no next episode")
    asked["playback.showNextAirDate"] = "false"
    assertEqual(promptAt("airDate", asked), "", "unless that's turned off")
    assertEqual(promptAt("middle", asked), "", "Mid-episode nothing comes up")

    ' The countdown setting picks the ring and the timer the way the player does
    for each pick in [["both", "true true"], ["progressbar", "true false"], ["timer", "false true"], ["none", "false false"]]
        parts = playbackOverlay.CountdownLook(pick[0])
        assertEqual(parts.showRing.ToStr() + " " + parts.showTimer.ToStr(), pick[1], "The " + pick[0] + " countdown")
    end for

    ' A scrub pauses only with Pause While Scrubbing on and a frame to scrub by
    assertEqual(scrubPauses({ "playback.trickplay.enabled": "true", "playback.trickplay.pauseWhileScrubbing": "true" }), true, "Both on pause the scrub")
    assertEqual(scrubPauses({ "playback.trickplay.enabled": "true", "playback.trickplay.pauseWhileScrubbing": "false" }), false, "Pause While Scrubbing off keeps it playing")
    assertEqual(scrubPauses({ "playback.trickplay.enabled": "false", "playback.trickplay.pauseWhileScrubbing": "true" }), false, "and so does no trickplay")

    ' The sample subtitle rises clear of the controls only while they're up
    bothRows = { "playback.timeAboveRight": "endsAt", "playback.timeBelowLeft": "elapsed" }
    assertEqual(subtitleBottom(bothRows, 972, false), 972, "With the controls hidden the subtitle stays where it is")
    assertEqual(subtitleBottom(bothRows, 972, true), 880, "With them up it sits 12 over the Ends at row")
    assertEqual(subtitleBottom({ "playback.timeAboveRight": "endsAt" }, 972, true), 919, "and follows the bar down when the row under it is empty")
    assertEqual(subtitleBottom({ "playback.timeBelowLeft": "elapsed" }, 972, true), 911.5, "With nothing over the bar it sits 12 over the thumb")
    assertEqual(subtitleBottom(bothRows, 600, true), 600, "A subtitle that's already higher stays put")

    ' The sample line takes the style the player draws its own subtitles with
    plain = subtitleStyle.FromSettings({}, "")
    assertEqual(plain.fontSize, 44, "Nothing set is medium")
    assertEqual(plain.bottomPercent, 10, "at the bottom")
    assertEqual(plain.textColor, "#FFFFFFFF", "in white")
    assertEqual(plain.shadowColor, "#000000FF", "with a black outline")
    assertEqual(plain.shadowOffset, 2, "two out")
    assertEqual(plain.backgroundColor, "#00000000", "and no background")
    styled = { "playback.subs.style.size": "xlarge", "playback.subs.style.position": "absolute", "playback.subs.style.positionAbsolute": "70", "playback.subs.style.opacity": "0", "playback.subs.style.color": "#ffff00", "playback.subs.style.shadowBlur": "1.0", "playback.subs.style.backgroundColor": "#0000ff", "playback.subs.style.background": "50" }
    look = subtitleStyle.FromSettings(styled, "")
    assertEqual(look.fontSize, 60, "Extra large")
    assertEqual(look.bottomPercent, 30, "An absolute position counts from the top")
    assertEqual(look.textOpacity, 1, "Zero text opacity reads as full")
    assertEqual(look.textColor, "#FFFF00FF", "The fill color")
    assertEqual(look.shadowOffset, 6, "The biggest shadow pushes the outline out")
    assertEqual(look.backgroundColor, "#0000FF80", "The background takes its opacity")
    assertEqual(subtitleStyle.Rgba("#00000080", 50), "#00000040", "A color's own alpha is scaled by the opacity")
    hdr = subtitleStyle.FromSettings({ "playback.subs.style.size": "small", "playback.subs.style.sizeHdr": "large" }, "Hdr")
    assertEqual(hdr.fontSize, 52, "The HDR style reads its own settings")
    placed = subtitleStyle.Placement({ x: 0, y: 0, width: 400, height: 60 }, 10)
    assertEqual(placed[0], 760, "A cue is centered")
    assertEqual(placed[1], 912, "with its bottom edge the chosen share up from the bottom")

    ' The library copy puts the grid where each real style does
    assertEqual(libraryPreview.Frame("modern").top, 380, "Modern's grid starts under its bar")
    assertEqual(libraryPreview.Frame("docked").left, 498, "Docked's grid starts beside its panel")
    assertEqual(libraryPreview.Frame("docked").room, 856, "and runs down to the bottom margin")
    assertEqual(libraryPreview.Frame("nonsense").top, 316, "Anything else is Classic")
    assertEqual(libraryPreview.RowsShown(740, 292), 3, "A row that only peeks in still shows")
    assertEqual(libraryPreview.RowsShown(584, 292), 2, "Rows that fit exactly add none")
    assertEqual(libraryPreview.PageSize("medium"), 40, "One page fills Classic's grid of untitled posters, the fullest at the medium size")
    assertEqual(libraryPreview.CardShape("landscape", ""), "thumbnail", "Landscape draws thumbs")
    assertEqual(libraryPreview.CardShape("default", "banner"), "banner", "The library's own pick wins")
    assertEqual(libraryPreview.CardShape(invalid, "nonsense"), "poster", "Anything else draws posters")
    stored = { "display.shows.sortField": "DateCreated,SortName", "display.shows.sortAscending": false, "display.shows.filterState": "{""played"":""unplayed""}", "library_letterNav_shows": "off" }
    asked = libraryPreview.Request({ id: "shows", collectionType: "tvshows" }, stored, false)
    assertEqual(asked.task.itemType + "|" + asked.task.excludeItemTypes, "Series|BoxSet", "Shows are asked for without their collections")
    assertEqual(asked.task.sortField + " " + asked.sortLabel + " " + asked.sortOrder, "DateCreated,SortName Date Added Descending", "The saved sort and its label")
    assertEqual(asked.task.filterState.played + " " + asked.playedLabel, "unplayed Unwatched", "The saved filter and its label")
    assertEqual(asked.letters, false, "The letters stay off when the library turned them off")
    assertEqual(asked.task.limit, 40, "It asks for one page")
    grouped = libraryPreview.Request({ id: "movies", collectionType: "movies" }, {}, true)
    assertEqual(grouped.task.itemType + "|" + grouped.task.excludeItemTypes + "|" + grouped.task.collapseBoxSetItems.ToStr(), "Movie,BoxSet||true", "Grouping asks for the collections in place of their movies")
    assertEqual(grouped.sortLabel + " " + grouped.sortOrder + " " + grouped.letters.ToStr(), "Name Ascending true", "Nothing saved sorts by name with the letters on")
    tunes = libraryPreview.Request({ id: "tunes", collectionType: "music" }, { "library_groupBy_tunes": "genres" }, false)
    assertEqual(tunes.task.itemType + "|" + tunes.task.excludeItemTypes + "|" + tunes.letters.ToStr(), "MusicArtist||true", "A music grid lists its artists, never grouped")
    albums = libraryPreview.Request({ id: "tunes", collectionType: "music" }, { "display.tunes.landing": "Albums" }, false)
    assertEqual(albums.task.itemType, "MusicAlbum", "or its albums when that's where it was left")
end sub

function previewButtonIds(buttons as object) as string
    ids = []
    for each button in buttons
        ids.push(button.id)
    end for
    return ids.Join(",")
end function

function shownChips(shown as object) as string
    return shown.firstShown.ToStr() + "-" + shown.lastShown.ToStr()
end function

function previewButtonLabels(buttons as object) as string
    labels = []
    for each button in buttons
        labels.push(button.label)
    end for
    return labels.Join(",")
end function

sub testDetailSections()
    classic = sectionIds(detailSectionLayout.Offered("classic", false))
    assertEqual(classic.Instr("poster") >= 0 and classic.Instr("upNext") >= 0 and classic.Instr("moreEpisodes") >= 0, true, "Classic offers what it draws")
    assertEqual(classic.Instr("chapters") < 0 and classic.Instr("mediaInfo") < 0, true, "Classic leaves out what it has no place for")
    assertEqual(classic.Instr("seerr") < 0, true, "No Seerr switches without Seerr")

    nouveau = sectionIds(detailSectionLayout.Offered("nouveau", true))
    assertEqual(nouveau.Instr("seerrCollection") >= 0 and nouveau.Instr("chapters") >= 0 and nouveau.Instr("mediaInfo") >= 0, true, "Nouveau offers its Seerr banner, chapters and media info")
    assertEqual(nouveau.Instr("seerrStats,seerrStreaming,seerrRecommendations") >= 0, true, "Streaming services sits between Stats and Recommendations")
    assertEqual(nouveau.Instr("tagline") < 0 and nouveau.Instr("poster") < 0 and nouveau.Instr("moreEpisodes") < 0, true, "Nouveau leaves out what it has no place for")

    minimalist = sectionIds(detailSectionLayout.Offered("minimalist", false))
    assertEqual(minimalist.Instr("moreEpisodes") >= 0 and minimalist.Instr("biography") >= 0, true, "Minimalist also offers what Spotlight draws for the pages it hands over")
    assertEqual(minimalist.Instr("poster") < 0, true, "Minimalist leaves out what neither draws")

    stage = sectionIds(detailSectionLayout.Offered("stage", true))
    assertEqual(stage.Instr("tagline") >= 0 and stage.Instr("moreEpisodes") >= 0 and stage.Instr("collections") >= 0 and stage.Instr("seerrSimilar") >= 0, true, "Stage offers what it draws")
    assertEqual(stage.Instr("biography") >= 0 and stage.Instr("playlistOrder") >= 0 and stage.Instr("seerrPersonCrew") >= 0, true, "and what Modern draws for the people and collections it hands over")
    assertEqual(stage.Instr("chapters") < 0 and stage.Instr("reviews") < 0 and stage.Instr("mediaInfo") < 0 and stage.Instr("poster") < 0, true, "Stage leaves out what it has no place for")

    premiere = sectionIds(detailSectionLayout.Offered("premiere", true))
    assertEqual(premiere.Instr("tagline") >= 0 and premiere.Instr("moreEpisodes") >= 0 and premiere.Instr("crew") >= 0 and premiere.Instr("seerrStats") >= 0, true, "Premiere offers what it draws")
    assertEqual(premiere.Instr("biography") >= 0 and premiere.Instr("seerrPersonCrew") >= 0, true, "and what Modern draws for the people and collections it hands over")
    assertEqual(premiere.Instr("seerrCollection") < 0 and premiere.Instr("chapters") < 0 and premiere.Instr("poster") < 0, true, "Premiere leaves out Seerr's collection banner and what it has no place for")

    frost = sectionIds(detailSectionLayout.Offered("frost", true))
    assertEqual(frost.Instr("moreEpisodes") >= 0 and frost.Instr("mediaInfo") >= 0 and frost.Instr("crew") >= 0 and frost.Instr("seerrSimilar") >= 0 and frost.Instr("seerrStats") >= 0 and frost.Instr("seerrStreaming") >= 0, true, "Frost offers what its tabs draw, Seerr's About included")
    assertEqual(frost.Instr("biography") >= 0 and frost.Instr("seerrPersonCrew") >= 0, true, "and what Modern draws for the people and collections it hands over")
    assertEqual(frost.Instr("logo") < 0 and frost.Instr("tagline") < 0 and frost.Instr("collections") < 0 and frost.Instr("seerrCollection") < 0, true, "Frost leaves out the logo, tagline, collections and Seerr's collection banner it has no place for")

    ' Avatar's people and studios: James Cameron directed and wrote it, and four studios run to 80 letters
    avatar = [{ chips: [{ value: "James Cameron" }] }, { chips: [{ value: "James Cameron" }] }, { chips: [{ value: "Dune Entertainment" }, { value: "Lightstorm Entertainment" }, { value: "20th Century Fox" }, { value: "Ingenious Film Partners" }] }]
    shares = columnShares(avatar, true)
    assertEqual(Int(shares[2] * 100 + 0.5), 60, "A long list of studios gets the most room, held at 60 letters' worth")
    assertEqual(Int(shares[0] * 100 + 0.5) = 20 and Int(shares[1] * 100 + 0.5) = 20, true, "and a single name gets 20 letters' worth, so it stays on one line")
    longer = columnShares([{ chips: [{ value: "Christopher McQuarrie" }, { value: "Denis Villeneuve" }] }, { chips: [{ value: "A24" }] }], true)
    assertEqual(Int(longer[0] * 57 + 0.5), 37, "Two directors get a share by their letters")
    even = columnShares(avatar, false)
    assertEqual(even[0] = even[2], true, "Unweighed columns stay even, the way Stage draws them")

    assertEqual(sectionIds(detailSectionLayout.Offered("quickLook", true)), sectionIds(detailSectionLayout.Offered("modern", true)), "Quick Look offers what Modern draws, since its full page is Modern")
    for each limit in [[0, 6], [-1, 6], [2, 3], [5, 6], [9, 6]]
        m.testButtonLimit = limit[0]
        assertEqual(buttonCap().maxVisible, limit[1], `With the button limit at ${limit[0]}, Quick Look's row holds ${limit[1]}`)
    end for

    spotlight = sectionIds(detailSectionLayout.Offered("spotlight", false))
    assertEqual(spotlight.Instr("mediaInfo") >= 0 and spotlight.Instr("versionBadge") >= 0, true, "Spotlight offers its File Details card and version badge")
    assertEqual(sectionIds(detailSectionLayout.Offered("modern", false)).Instr("versionBadge") < 0, true, "Modern draws no version badge")
    assertEqual(sectionIds(detailSectionLayout.Offered("modern", false)).Instr("moreLikeThis,reviews") >= 0, true, "Reviews sit right after More Like This")

    assertEqual(detailSectionLayout.Toggle(["upNext", "fromAnotherClient"], "upNext").Join(","), "fromAnotherClient", "Turning a section back on keeps what other clients stored")
    assertEqual(detailSectionLayout.Toggle(FormatJson(["cast"]), "crew").Join(","), "cast,crew", "Hiding a section adds it to the stored list")

    saved = m.global
    m.global = { session: { user: { settings: { "ui.itemdetail.hiddenSections": FormatJson(["cast"]) } } } }
    assertEqual(detailSectionLayout.Shows("cast"), false, "A hidden section is off")
    assertEqual(detailSectionLayout.Shows("crew"), true, "Everything else stays on")
    m.global = { session: { user: { settings: {} } } }
    assertEqual(detailSectionLayout.Shows("cast"), true, "Nothing stored hides nothing")
    m.global = saved
end sub

' Stands in for the viewer's Action Buttons on Screen setting
function viewerButtonLimit() as integer
    return m.testButtonLimit
end function

function sectionIds(sections as object) as string
    ids = []
    for each section in sections
        ids.push(section.id)
    end for
    return ids.Join(",")
end function

' Stands in for the arrangement helpers, which this interpreter cant load whole
namespace buttonLayout
    function ToIds(stored as dynamic) as object
        if not isValid(stored) then return []
        if type(stored) = "roArray" then return stored
        parsed = ParseJson(stored)
        if type(parsed) = "roArray" then return parsed
        return []
    end function

    function HiddenLookup(stored as dynamic) as object
        off = {}
        for each id in buttonLayout.ToIds(stored)
            off[id] = true
        end for
        return off
    end function
end namespace

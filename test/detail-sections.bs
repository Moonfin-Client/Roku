sub testDetailSections()
    classic = sectionIds(detailSectionLayout.Offered("classic", false))
    assertEqual(classic.Instr("poster") >= 0 and classic.Instr("upNext") >= 0 and classic.Instr("moreEpisodes") >= 0, true, "Classic offers what it draws")
    assertEqual(classic.Instr("chapters") < 0 and classic.Instr("mediaInfo") < 0, true, "Classic leaves out what it has no place for")
    assertEqual(classic.Instr("seerr") < 0, true, "No Seerr switches without Seerr")

    nouveau = sectionIds(detailSectionLayout.Offered("nouveau", true))
    assertEqual(nouveau.Instr("seerrCollection") >= 0 and nouveau.Instr("chapters") >= 0 and nouveau.Instr("mediaInfo") >= 0, true, "Nouveau offers its Seerr banner, chapters and media info")
    assertEqual(nouveau.Instr("tagline") < 0 and nouveau.Instr("poster") < 0 and nouveau.Instr("moreEpisodes") < 0, true, "Nouveau leaves out what it has no place for")

    minimalist = sectionIds(detailSectionLayout.Offered("minimalist", false))
    assertEqual(minimalist.Instr("moreEpisodes") >= 0 and minimalist.Instr("biography") >= 0, true, "Minimalist also offers what Spotlight draws for the pages it hands over")
    assertEqual(minimalist.Instr("poster") < 0 and minimalist.Instr("mediaInfo") < 0, true, "Minimalist leaves out what neither draws")

    assertEqual(detailSectionLayout.Toggle(["upNext", "fromAnotherClient"], "upNext").Join(","), "fromAnotherClient", "Turning a section back on keeps what other clients stored")
    assertEqual(detailSectionLayout.Toggle(FormatJson(["cast"]), "crew").Join(","), "cast,crew", "Hiding a section adds it to the stored list")

    saved = m.global
    m.global = { session: { user: { settings: { "ui.itemdetail.hiddenSections": FormatJson(["cast"]) } } } }
    assertEqual(detailSectionLayout.Shows("cast"), false, "A hidden section is off")
    assertEqual(detailSectionLayout.Shows("crew"), true, "Everything else stays on")
    m.global = { session: { user: { settings: {} } } }
    assertEqual(detailSectionLayout.Shows("cast"), true, "Nothing stored hides nothing")
    m.global = saved
end sub

function sectionIds(sections as object) as string
    ids = []
    for each section in sections
        ids.push(section.id)
    end for
    return ids.Join(",")
end function

' Stands in for the arrangement helpers, which this interpreter cant load whole
namespace buttonLayout
    function ToIds(stored as dynamic) as object
        if not isValid(stored) then return []
        if type(stored) = "roArray" then return stored
        parsed = ParseJson(stored)
        if type(parsed) = "roArray" then return parsed
        return []
    end function

    function HiddenLookup(stored as dynamic) as object
        off = {}
        for each id in buttonLayout.ToIds(stored)
            off[id] = true
        end for
        return off
    end function
end namespace

sub testEpisodeCast()
    assertEqual(episodeCast.formatGuestStarRole(""), "Guest Star", "Empty role becomes Guest Star")
    assertEqual(episodeCast.formatGuestStarRole(invalid), "Guest Star", "Invalid role becomes Guest Star")
    assertEqual(episodeCast.formatGuestStarRole("Guest Star"), "Guest Star", "Guest Star role unchanged")
    assertEqual(episodeCast.formatGuestStarRole("guest star"), "guest star", "Lowercase guest star role unchanged")
    assertEqual(episodeCast.formatGuestStarRole("The Doctor"), "The Doctor (Guest Star)", "Appends Guest Star tag to character")
    assertEqual(episodeCast.formatGuestStarRole("The Doctor (Guest Star)"), "The Doctor (Guest Star)", "Idempotent Guest Star tagging")
    assertEqual(episodeCast.formatGuestStarRole("guesthouse receptionist"), "guesthouse receptionist (Guest Star)", "Does not falsely match guesthouse as guest star")

    assertEqual(episodeCast.formatEpisodeDirectorRole(""), "Episode Director", "Empty director role becomes Episode Director")
    assertEqual(episodeCast.formatEpisodeDirectorRole(invalid), "Episode Director", "Invalid director role becomes Episode Director")
    assertEqual(episodeCast.formatEpisodeDirectorRole("Director"), "Episode Director", "Director becomes Episode Director")
    assertEqual(episodeCast.formatEpisodeDirectorRole("Episode Director"), "Episode Director", "Episode Director unchanged")
    assertEqual(episodeCast.formatEpisodeDirectorRole("Co-Director"), "Co-Director (Episode Director)", "Specific director title tagged with Episode Director")
    assertEqual(episodeCast.formatEpisodeDirectorRole("Co-Director (Episode Director)"), "Co-Director (Episode Director)", "Idempotent Episode Director tagging")

    assertEqual(episodeCast.formatEpisodeWriterRole(""), "Episode Writer", "Empty writer role becomes Episode Writer")
    assertEqual(episodeCast.formatEpisodeWriterRole(invalid), "Episode Writer", "Invalid writer role becomes Episode Writer")
    assertEqual(episodeCast.formatEpisodeWriterRole("Writer"), "Episode Writer", "Writer becomes Episode Writer")
    assertEqual(episodeCast.formatEpisodeWriterRole("Episode Writer"), "Episode Writer", "Episode Writer unchanged")
    assertEqual(episodeCast.formatEpisodeWriterRole("Story"), "Story (Episode Writer)", "Specific writer title tagged with Episode Writer")
    assertEqual(episodeCast.formatEpisodeWriterRole("Story (Episode Writer)"), "Story (Episode Writer)", "Idempotent Episode Writer tagging")

    assertEqual(episodeCast.hasGuestStarTag("Alice (Guest Star)"), true, "Detects guest star tag")
    assertEqual(episodeCast.hasGuestStarTag("guesthouse manager"), false, "guesthouse does not trigger guest star tag")

    assertEqual(episodeCast.personSubtitle("Actor", " Gregory House "), "as Gregory House", "An actor is shown as their character")
    assertEqual(episodeCast.personSubtitle("GuestStar", "Guest Star"), "Guest Star", "A guest star with no character reads Guest Star on its own")
    assertEqual(episodeCast.personSubtitle("Writer", "Screenplay"), "Screenplay", "The crew show their role")
    assertEqual(episodeCast.personSubtitle("Producer", "Executive Producer"), "Producer", "Anyone else shows their credit")
    assertEqual(episodeCast.personSubtitle("Director", invalid), "Director", "and so does a credit with no role")

    personA = { Id: "p1", Name: "John Smith" }
    personB = { Id: "p1", Name: "John Doe" }
    assertEqual(episodeCast.isSamePerson(personA, personB), true, "Matches by Id even if Name differs")

    personC = { Id: "p2", Name: "John Smith" }
    assertEqual(episodeCast.isSamePerson(personA, personC), false, "Distinct people with same Name but different Id not matched")

    personD = { Name: "Jane Smith" }
    personE = { Name: "jane smith" }
    assertEqual(episodeCast.isSamePerson(personD, personE), true, "Matches case-insensitive Name when Id absent")

    personF = { Name: "Jane Doe" }
    assertEqual(episodeCast.isSamePerson(personD, personF), false, "Does not match different Name when Id absent")

    epPeople = [
        { Id: "a1", Name: "Guest Actor 1", Type: "GuestStar", Role: "Villain" },
        { Id: "a2", Name: "Guest Actor 2", Type: "GuestStar", Role: "" },
        { Id: "a3", Name: "Episode Regular 1", Type: "Actor", Role: "Bartender" },
        { Id: "d1", Name: "Director 1", Type: "Director", Role: "Director" },
        { Id: "w1", Name: "Writer 1", Type: "Writer", Role: "Writer" },
        { Id: "p1", Name: "Producer 1", Type: "Producer", Role: "Executive Producer" }
    ]

    parentActors = [
        { Id: "a1", Name: "Guest Actor 1", Type: "GuestStar", Role: "Regular Role" }, ' also credited on the episode
        { Id: "r1", Name: "Regular Actor 1", Type: "Actor", Role: "Hero" },
        { Id: "r2", Name: "Regular Actor 2", Type: "Actor", Role: "Sidekick" }
    ]

    merged = episodeCast.mergeEpisodePeople(epPeople, parentActors)
    assertEqual(merged.Count(), 8, "Merged count has 3 ep actors + 2 parent regulars + 2 crew + 1 other = 8")

    assertEqual(merged[0].Name, "Guest Actor 1", "Episode guest star 1 is first")
    assertEqual(merged[0].Role, "Villain (Guest Star)", "Episode guest star 1 role formatted")

    assertEqual(merged[1].Name, "Guest Actor 2", "Episode guest star 2 is second")
    assertEqual(merged[1].Role, "Guest Star", "Episode guest star 2 empty role formatted as Guest Star")

    assertEqual(merged[2].Name, "Episode Regular 1", "Episode regular actor is third")
    assertEqual(merged[2].Role, "Bartender", "Episode regular actor keeps regular role without Guest Star tag")

    assertEqual(merged[3].Name, "Regular Actor 1", "Regular actor 1 appended next")
    assertEqual(merged[3].Role, "Hero", "Regular actor 1 keeps regular role")

    assertEqual(merged[4].Name, "Regular Actor 2", "Regular actor 2 appended next")
    assertEqual(merged[4].Role, "Sidekick", "Regular actor 2 keeps regular role")

    assertEqual(merged[5].Name, "Director 1", "Episode director placed after cast")
    assertEqual(merged[5].Role, "Episode Director", "Episode director role formatted")

    assertEqual(merged[6].Name, "Writer 1", "Episode writer placed after director")
    assertEqual(merged[6].Role, "Episode Writer", "Episode writer role formatted")

    assertEqual(merged[7].Name, "Producer 1", "Producer placed in other credits")
    assertEqual(merged[7].Role, "Executive Producer", "Producer role untouched")
    assertEqual(merged[7].Type, "Producer", "Producer type untouched")
end sub


sub testAudioQuality()
    flac = { MediaSources: [{ Container: "flac", MediaStreams: [{ Type: "Audio", Codec: "flac", BitDepth: 24, SampleRate: 96000 }] }] }
    assertEqual(audioQualityLabel(flac), "FLAC · 24/96 · Lossless", "A hi-res FLAC shows its depth over kHz and Lossless")

    mp3 = { MediaSources: [{ Container: "mp3", MediaStreams: [{ Type: "Audio", Codec: "mp3", SampleRate: 44100, BitRate: 320000 }] }] }
    assertEqual(audioQualityLabel(mp3), "MP3 · 44.1 kHz · 320k", "A lossy track with no bit depth shows kHz and its bitrate")

    containerOnly = { MediaSources: [{ Container: "m4a", Bitrate: 256000, MediaStreams: [{ Type: "Video", Codec: "mjpeg" }] }] }
    assertEqual(audioQualityLabel(containerOnly), "M4A · 256k", "Without an audio stream the container and the source bitrate stand in")

    assertEqual(audioQualityLabel({ MediaSources: [] }), "", "No media source means no badge")
    assertEqual(audioQualityLabel(invalid), "", "No item means no badge")
end sub

sub testSubtitleProfiles()
    m.testSettingsOn = true
    formats = subtitleProfileFormats()
    assertEqual(inArray(formats, "ass Embed"), true, "ASS stays in the file when its setting is on")
    assertEqual(inArray(formats, "pgssub Embed"), false, "PGS is never left in the file, even with every setting on")

    m.testSettingsOn = false
    assertEqual(inArray(subtitleProfileFormats(), "ass Embed"), false, "ASS is burned in when its setting is off")
end sub

function subtitleProfileFormats() as object
    formats = []
    for each profile in getSubtitleProfiles()
        formats.push(profile.Format + " " + profile.Method)
    end for
    return formats
end function

' Stands in for the user's settings, with every switch on or every switch off
function get_user_setting_bool(key as string, defaultValue as boolean) as boolean
    return m.testSettingsOn = true
end function

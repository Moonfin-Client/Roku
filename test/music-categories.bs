sub testMusicCategories()
    assertEqual(musicCategories.LetterOf({ Name: "The Beatles", SortName: "Beatles" }), "B", "An artist files under its sort name")
    assertEqual(musicCategories.LetterOf({ Name: "Ólafur Arnalds" }), "O", "Accents fold onto the plain letter")
    assertEqual(musicCategories.LetterOf({ Name: "2Pac", SortName: "" }), "#", "Numbers go under #")
    assertEqual(musicCategories.LetterOf({ Name: "" }), "#", "So does an artist with no name")

    initials = ["#", "A", "A", "C", "D", "#"]
    assertEqual(musicCategories.JumpIndex(initials, "A", false), 1, "A letter lands on its first artist")
    assertEqual(musicCategories.JumpIndex(initials, "B", false), 3, "A letter with none lands on the next that has some")
    assertEqual(musicCategories.JumpIndex(initials, "#", false), 0, "# lands on the first run of it")
    assertEqual(musicCategories.JumpIndex(initials, "E", false), -1, "Past the last loaded letter it waits for another page")
    descending = ["#", "D", "C", "A", "#"]
    assertEqual(musicCategories.JumpIndex(descending, "B", true), 3, "Z to A lands on the next letter down")
    assertEqual(musicCategories.JumpIndex(descending, "Z", true), 1, "And past other scripts on to the first plain letter")

    genres = [{ Name: "Ambient", ChildCount: 3 }, { Name: "rock", AlbumCount: 9 }, { Name: "Jazz", AlbumCount: 9 }, { Name: "Folk", AlbumCount: 12& }]
    sorted = musicCategories.ByAlbumCount(genres)
    names = []
    for each genre in sorted
        names.push(genre.Name)
    end for
    assertEqual(names.join(","), "Folk,Jazz,rock,Ambient", "Most albums first, ties by name, a long count sorting with the rest")
    assertEqual(musicCategories.AlbumCount({ Name: "Blues" }), -1, "No count reads as unknown")
    assertEqual(musicCategories.AnyAlbumCount([{ Name: "Blues" }]), false, "A list without counts stays A to Z")

    assertEqual(musicCategories.Duration(24600000000&), "41 min", "Under an hour is minutes")
    assertEqual(musicCategories.Duration(96000000000&), "2 hr 40 min", "Hours and minutes")
    assertEqual(musicCategories.Duration(36000000000&), "1 hr", "A whole hour")
    assertEqual(musicCategories.Duration(invalid), "", "No length, no words")
    assertEqual(musicCategories.CountText(1, "1 song", "{count} songs"), "1 song", "One")
    assertEqual(musicCategories.CountText(214, "1 song", "{count} songs"), "214 songs", "Many")
    assertEqual(musicCategories.CountText(0, "1 song", "{count} songs"), "", "None hides the count")
    assertEqual(musicCategories.Joined(["Mara Quill", "", invalid, "2024"], " · "), "Mara Quill · 2024", "Parts the server left out drop")

    strip = { pinTop: true, enterAt: 2, height: 34, cells: [] }
    header = { pinTop: true, enterAt: 1, height: 64, cells: [] }
    plainHeader = { pinTop: true, height: 64, cells: [] }
    albums = { height: 300, cells: [{ x: 72, y: 0, w: 270, h: 300 }, { x: 372, y: 0, w: 270, h: 300 }, { x: 972, y: 0, w: 270, h: 300 }] }
    below = { height: 300, cells: [{ x: 72, y: 0, w: 270, h: 300 }, { x: 972, y: 0, w: 270, h: 300 }] }
    rightControl = { x: 1700, y: 4, w: 150, h: 60 }
    assertEqual(landingCell(strip, header, { x: 300, y: 5, w: 80, h: 34 }, true), 1, "Down from the strip lands on the header's picked tab")
    assertEqual(landingCell(strip, plainHeader, { x: 300, y: 5, w: 80, h: 34 }, true), 0, "Or on its first control when nothing in it is picked")
    assertEqual(landingCell(header, albums, rightControl, true), 0, "Down from the header's far end starts the content at its first item")
    assertEqual(landingCell(albums, header, albums.cells[2], false), 1, "Up from the content goes back to the header's picked tab")
    assertEqual(landingCell(header, strip, rightControl, false), 2, "And Up from the header to this screen's pill")
    assertEqual(landingCell(albums, below, albums.cells[2], true), 1, "Inside the content Down still lands on the nearest card")
end sub

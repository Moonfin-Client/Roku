sub testRatingSources()
    assertEqual(ratingSourceList.Normalize(FormatJson(["imdb", "metacriticUser", "popcorn", "IMDb"])).Join(","), "imdb,metacriticuser,tomatoes_audience", "A stored list reads in this app's ids, each source once")
    assertEqual(ratingSourceList.Normalize("{}").Count(), 0, "Anything that isn't a list reads as none")

    rows = ratingSourceList.Rows(["tmdb", "imdb"])
    assertEqual(rows.Count(), ratingSourceList.Catalogue().Count(), "Every source is offered")
    assertEqual(rows[0].id + "," + rows[1].id + "," + rows[2].id, "tmdb,imdb,personal", "Turned-on sources lead in their own order, then the rest in catalogue order")
    assertEqual(rows[0].enabled and rows[1].enabled and not rows[2].enabled, true, "Each row knows whether it's on")

    assertEqual(ratingSourceList.Toggle(["tmdb", "imdb"], "stars").Join(","), "tmdb,imdb,stars", "A source turned on joins the end")
    assertEqual(ratingSourceList.Toggle(["tmdb", "imdb"], "tmdb").Join(","), "imdb", "A source turned off leaves the list")

    assertEqual(ratingSourceList.ToStored(["metacriticuser", "myanimelist", "rogerebert", "imdb"]).Join(","), "metacriticUser,myAnimeList,rogerEbert,imdb", "The server keeps the other clients' spellings")
    assertEqual(ratingSourceList.Defaults().Join(","), "stars,imdb,tmdb,tomatoes,metacritic", "A viewer who never picked starts with the usual five")
end sub

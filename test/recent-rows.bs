sub testRecentRows()
    played = { Id: "a", Type: "Movie", UserData: { Played: true } }
    unplayed = { Id: "b", Type: "Movie", UserData: { Played: false } }
    finishedShow = { Id: "c", Type: "Series", ChildCount: 3, UserData: { Played: false, UnplayedItemCount: 0 } }
    newShow = { Id: "d", Type: "Series", ChildCount: 3, UserData: { UnplayedItemCount: 2 } }
    emptyShow = { Id: "e", Type: "Series", ChildCount: 0, UserData: { UnplayedItemCount: 0 } }
    season = { Id: "f", Type: "Season", UserData: { UnplayedItemCount: 0 } }
    noData = { Id: "g", Type: "Movie" }

    assertEqual(recentRows.IsWatched(played), true, "A played title is watched")
    assertEqual(recentRows.IsWatched(unplayed), false, "An unplayed title isn't")
    assertEqual(recentRows.IsWatched(finishedShow), true, "A series with nothing left to watch is watched")
    assertEqual(recentRows.IsWatched(newShow), false, "A series with episodes left isn't")
    assertEqual(recentRows.IsWatched(emptyShow), false, "A series with no episodes yet isn't")
    assertEqual(recentRows.IsWatched(season), true, "A season with nothing left counts even without a child count")
    assertEqual(recentRows.IsWatched(noData), false, "A title with no watched state stays")

    kept = []
    for each item in recentRows.WithoutWatched([played, unplayed, finishedShow, newShow, emptyShow, season, noData])
        kept.push(item.Id)
    end for
    assertEqual(kept.Join(","), "b,d,e,g", "Hide Watched keeps what's still to watch, in order")

    ' A series card can't say which of its episodes were watched, so they go before folding
    episodes = [
        { Id: "e1", Type: "Episode", SeriesId: "s1", SeriesName: "Seen", UserData: { Played: true } },
        { Id: "e2", Type: "Episode", SeriesId: "s2", SeriesName: "New", UserData: { Played: false } }
    ]
    cards = normalizeLatestItems(episodes, true, false, 16, true)
    assertEqual(cards.Count(), 1, "A TV row with Hide Watched shows only the series with something new")
    assertEqual(cards[0].Id, "s2", "and it's the one with the unwatched episode")
    assertEqual(normalizeLatestItems(episodes, true, false, 16).Count(), 2, "Without Hide Watched both series stay")
end sub

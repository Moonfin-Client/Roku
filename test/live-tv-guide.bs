' The guide's episode line
sub testLiveTvGuide()
    assertEqual(liveTvGuide.EpisodeLine({ EpisodeTitle: "Pilot", ParentIndexNumber: 1, IndexNumber: 5 }), "Pilot (S1:E5)", "The episode line puts the numbering after the title")
    assertEqual(liveTvGuide.EpisodeLine({ EpisodeTitle: "Pilot" }), "Pilot", "The episode line is the title alone without numbers")
    assertEqual(liveTvGuide.EpisodeLine({ ParentIndexNumber: 2, IndexNumber: 3 }), "(S2:E3)", "The episode line is the numbering alone without a title")
    assertEqual(liveTvGuide.EpisodeLine({}), "", "The episode line is empty without either")
    assertEqual(liveTvGuide.EpisodeLine({ Name: "College Football", EpisodeTitle: "College Football" }), "", "A title that repeats the program name is left out")
    assertEqual(liveTvGuide.EpisodeLine({ Name: "College Football", EpisodeTitle: "College Football", ParentIndexNumber: 2, IndexNumber: 9 }), "(S2:E9)", "The numbering stays when the repeated title goes")
    assertEqual(liveTvGuide.EpisodeLine({ Name: "College Football", EpisodeTitle: "South Alabama at Kentucky" }), "South Alabama at Kentucky", "A title of its own stays")
    assertEqual(liveTvGuide.EpisodeLine({ EpisodeTitle: "\" + chr(34) + "Raygun\" + chr(34) }), chr(34) + "Raygun" + chr(34), "Escaped quotes in the title are unescaped")
end sub

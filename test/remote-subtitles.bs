sub testRemoteSubtitles()
    ' Issue #1283: a download searches the languages picked in settings
    assertEqual(remoteSubtitles.SearchLanguages(`["hrv","ger"]`, "eng"), "hrv,ger", "The picked languages replace the guess")
    assertEqual(remoteSubtitles.SearchLanguages("[]", "eng"), "eng", "None picked searches the guess")
    assertEqual(remoteSubtitles.SearchLanguages(invalid, "eng"), "eng", "An unset setting searches the guess")
    assertEqual(remoteSubtitles.SearchLanguages(`["eng","ger","hrv","fre","spa","ita","jpn"]`, "eng"), "eng,ger,hrv,fre,spa", "No more than five languages are searched")
end sub

' Dutch is searched under nld whatever the file calls it, and the default subtitle language comes first
sub testRemoteSubtitlesDutch()
    assertEqual(remoteSubtitles.Language(["nl"]), "nld", "Subtitle search reads nl as Dutch")
    assertEqual(remoteSubtitles.Language(["dut"]), "nld", "Subtitle search reads dut as Dutch")
    assertEqual(remoteSubtitles.Language(["dutch"]), "nld", "Subtitle search reads dutch as Dutch")
    assertEqual(remoteSubtitles.Language(["anyLanguage", "fre"]), "fre", "Subtitle search skips the any language setting")
    streams = [{ Type: "Audio", Language: "eng" }, { Type: "Subtitle", Language: "eng" }]
    assertEqual(remoteSubtitles.LanguageFor(streams, -1, 0, "nld"), "nld", "Subtitle search tries the default subtitle language first")
    assertEqual(remoteSubtitles.LanguageFor(streams, -1, 0), "eng", "Subtitle search falls back to the audio without a default language")
end sub

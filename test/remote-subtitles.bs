sub testRemoteSubtitles()
    ' Issue #1283: a download searches the languages picked in settings
    assertEqual(remoteSubtitles.SearchLanguages(`["hrv","ger"]`, "eng"), "hrv,ger", "The picked languages replace the guess")
    assertEqual(remoteSubtitles.SearchLanguages("[]", "eng"), "eng", "None picked searches the guess")
    assertEqual(remoteSubtitles.SearchLanguages(invalid, "eng"), "eng", "An unset setting searches the guess")
    assertEqual(remoteSubtitles.SearchLanguages(`["eng","ger","hrv","fre","spa","ita","jpn"]`, "eng"), "eng,ger,hrv,fre,spa", "No more than five languages are searched")
end sub

' The backdrops a Spotlight person page's cards are drawn on
sub testSpotlightPersonBackdrops()
    builder = { personBackdrops: spotlightBuilderPersonBackdrops, s: {
        personMovies: [{ sdBackgroundImageUrl: "m1" }], personSeries: [], personGuest: [],
        seerrAppearances: [{ sdBackgroundImageUrl: "shared" }, { sdBackgroundImageUrl: "a2" }],
        seerrCrewCredits: [{ sdBackgroundImageUrl: "shared" }]
    } }
    picks = builder.personBackdrops()
    assertEqual(`${picks.filmography},${picks.appearances},${picks.crew}`, "m1,shared,a2", "Each person card takes a backdrop the others haven't")

    builder = { personBackdrops: spotlightBuilderPersonBackdrops, s: { personMovies: [], personSeries: [], personGuest: [], seerrAppearances: [{ sdBackgroundImageUrl: "a1" }], seerrCrewCredits: [{ sdBackgroundImageUrl: "c1" }] } }
    picks = builder.personBackdrops()
    assertEqual(`${picks.appearances},${picks.crew}`, "a1,c1", "A card with nothing in it takes no backdrop from the others")
end sub

' Special features in their number order, then by name
sub testSpecialFeatures()
    names = function(items as object) as string
        found = []
        for each item in items
            found.push(item.Name)
        end for
        return found.join(",")
    end function

    assertEqual(names(sortedFeatures([{ Name: "Third", IndexNumber: 3, ParentIndexNumber: 1 }, { Name: "First", IndexNumber: 1, ParentIndexNumber: 9 }, { Name: "Second", IndexNumber: 2 }])), "First,Second,Third", "Features go by their number and not the parent's")
    assertEqual(names(sortedFeatures([{ Name: "beta", IndexNumber: 1 }, { Name: "Alpha", IndexNumber: 1 }])), "Alpha,beta", "A tie goes by name, whatever the case")
    assertEqual(names(sortedFeatures([{ Name: "Numbered", IndexNumber: 1 }, { Name: "Unnumbered" }])), "Unnumbered,Numbered", "A feature with no number counts as 0 and goes first")
    same = sortedFeatures([{ Name: "Same", IndexNumber: 1, Id: "a" }, { Name: "Same", IndexNumber: 1, Id: "b" }])
    assertEqual(same[0].Id + same[1].Id, "ab", "Two alike keep the server's order")
end sub

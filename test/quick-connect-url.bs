sub testQuickConnectUrl()
    assertEqual(quickConnectUrl.Approval("https://media.example.com", "123456"), "https://media.example.com/web/#/quickconnect?code=123456", "Points at the web client with the code filled in")
    assertEqual(quickConnectUrl.Approval("https://media.example.com", "123 456"), "https://media.example.com/web/#/quickconnect?code=123456", "Drops the spaces the screen puts in the code")
    assertEqual(quickConnectUrl.Approval("https://example.com/jellyfin/", "123456"), "https://example.com/jellyfin/web/#/quickconnect?code=123456", "Keeps a reverse proxy path prefix")
    assertEqual(quickConnectUrl.Approval("https://media.example.com/web/index.html", "123456"), "https://media.example.com/web/#/quickconnect?code=123456", "Does not double the web client path")
    assertEqual(quickConnectUrl.Approval("https://media.example.com/web/", "123456"), "https://media.example.com/web/#/quickconnect?code=123456", "Drops a bare web path")
    assertEqual(quickConnectUrl.Approval("https://example.com/jellyfin/web/index.html", "123456"), "https://example.com/jellyfin/web/#/quickconnect?code=123456", "Keeps the prefix under the web path")
    assertEqual(quickConnectUrl.Approval("http://192.168.1.10:8096", "123456"), "http://192.168.1.10:8096/web/#/quickconnect?code=123456", "Keeps a non default port")
    assertEqual(quickConnectUrl.Approval("  https://media.example.com  ", "123456"), "https://media.example.com/web/#/quickconnect?code=123456", "Trims the address")
    for each noAddress in ["", "   ", "/", invalid, 42]
        assertEqual(quickConnectUrl.Approval(noAddress, "123456"), "", "No link without an address")
    end for
    for each noCode in ["", "  ", "12#45", "1/2", invalid, 42]
        assertEqual(quickConnectUrl.Approval("https://media.example.com", noCode), "", "No link without a usable code")
    end for
end sub

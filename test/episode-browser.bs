' The player's episode browser lists what can play, labels each row and resumes a part watched pick
sub testEpisodeBrowser()
    playable = episodeBrowser.PlayableOnly([
        { id: "on-disk", json: { LocationType: "FileSystem" } },
        { id: "unaired", json: { LocationType: "Virtual" } },
        { id: "missing", json: { IsMissing: true } },
        { id: "bare", json: {} }
    ])
    assertEqual(playable.count(), 2, "Episode browser leaves out missing and unaired episodes")
    assertEqual(playable[0].id, "on-disk", "Episode browser keeps an episode on disk")
    assertEqual(playable[1].id, "bare", "Episode browser keeps an episode the server says nothing about")

    assertEqual(episodeBrowser.RowLine({ json: { ParentIndexNumber: 2, IndexNumber: 5 } }), "Season 2 · Episode 5", "Episode browser names the season and episode")
    assertEqual(episodeBrowser.RowLine({ json: { ParentIndexNumber: 0, IndexNumber: 3 } }), "Specials · Episode 3", "Episode browser calls season zero Specials")
    assertEqual(episodeBrowser.RowLine({ json: { IndexNumber: 4 } }), "Episode 4", "Episode browser leaves out a season the server has no number for")

    assertEqual(episodeBrowser.ResumeTicks({ json: { UserData: { PlaybackPositionTicks: 6000000000&, Played: false } } }), 6000000000&, "Episode browser resumes a part watched episode")
    assertEqual(episodeBrowser.ResumeTicks({ json: { UserData: { PlaybackPositionTicks: 600, Played: true } } }), 0, "Episode browser starts a watched episode over")
    assertEqual(episodeBrowser.ResumeTicks({ json: {} }), 0, "Episode browser starts an unwatched episode from the top")

    assertEqual(episodeBrowser.WatchedFraction({ json: { UserData: { PlayedPercentage: 50 } } }), 0.5, "Episode browser draws the percentage the server sends")
    assertEqual(episodeBrowser.WatchedFraction({ json: { RunTimeTicks: 1000, UserData: { PlaybackPositionTicks: 250 } } }), 0.25, "Episode browser works progress out from the position")
    assertEqual(episodeBrowser.WatchedFraction({ json: {} }), 0, "Episode browser draws no progress for an unstarted episode")
end sub

' The browser's list scrolls only as far as it takes to bring the focused row into view
sub testEpisodeBrowserScroll()
    assertEqual(episodeBrowser.ScrollToShow(300, 100, 214, 600, 2000), 76, "Episode browser scrolls a row above the view to just under the top")
    assertEqual(episodeBrowser.ScrollToShow(0, 500, 214, 600, 2000), 138, "Episode browser scrolls a row below the view to just over the bottom")
    assertEqual(episodeBrowser.ScrollToShow(100, 200, 214, 600, 2000), 100, "Episode browser leaves the list alone for a row already in view")
    assertEqual(episodeBrowser.ScrollToShow(0, 1900, 214, 600, 1500), 1500, "Episode browser never scrolls past the end of the list")
    assertEqual(episodeBrowser.ScrollToShow(50, 10, 214, 600, 1600), 0, "Episode browser never scrolls above the first row")
end sub

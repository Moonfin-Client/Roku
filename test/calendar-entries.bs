sub testCalendarEntries()
    ' Days count from 1970 on the viewer's calendar, so dates round trip without a clock
    assertEqual(calendarEntries.DayNumber(1970, 1, 1), 0, "The first day is day 0")
    nov5 = calendarEntries.DayNumber(2026, 11, 5)
    assertEqual(calendarEntries.DateText(nov5), "2026-11-05", "A day number reads back as its date")
    assertEqual(calendarEntries.DateText(calendarEntries.DayNumber(2024, 2, 29) + 1), "2024-03-01", "Leap days count")
    assertEqual(calendarEntries.DayOfText("2026-11-12T00:00:00Z"), nov5 + 7, "A Radarr release reads its date before any time zone shift")
    assertEqual(calendarEntries.Weekday(nov5), 4, "Nov 5 2026 is a Thursday")
    assertEqual(calendarEntries.DaysInMonth(2026, 2), 28, "February 2026 has 28 days")
    assertEqual(calendarEntries.DaysInMonth(2026, 12), 31, "and December 31")
    assertEqual(calendarEntries.LocalDayOf("2026-11-11"), nov5 + 6, "A bare air date is its own day")
    assertEqual(calendarEntries.LocalDayOf("soon"), -1, "and anything else is no day")

    sonarr = {
        id: 1001, seasonNumber: 38, episodeNumber: 7, title: "TBA", overview: "Springfield",
        airDate: "2026-11-11", airDateUtc: "2026-11-12T01:00:00Z", hasFile: false, runtime: 45,
        finaleType: "season",
        images: [{ coverType: "screenshot", url: "/MediaCover/1/screenshot.jpg", remoteUrl: "https://image.tmdb.org/t/p/original/still.jpg" }],
        moonfinItemId: "series-1", moonfinEpisodeId: invalid, moonfinLibraryIds: ["shows"],
        series: {
            title: "The Simpsons", tvdbId: 71663, tmdbId: 456, imdbId: "tt0096697", network: "FOX", year: 1989, monitored: true,
            images: [
                { coverType: "poster", url: "/MediaCover/1/poster.jpg", remoteUrl: "https://image.tmdb.org/t/p/original/poster.jpg" },
                { coverType: "fanart", url: "/MediaCover/1/fanart.jpg" }
            ]
        }
    }
    episode = calendarEntries.ParseSonarr(sonarr)
    assertEqual(episode.key, "sonarr:1001", "An episode is keyed by its Sonarr id")
    assertEqual(episode.kind, "episode", "Sonarr gives episodes")
    assertEqual(episode.title, "The Simpsons", "The title is the series name")
    assertEqual(episode.episodeTitle, "", "A TBA title is dropped")
    assertEqual(episode.hasTime, true, "airDateUtc carries a time")
    assertEqual(episode.seconds, 1794445200, "and that moment")
    assertEqual(episode.airedBy, episode.seconds, "A timed episode has aired once it starts")
    assertEqual(episode.posterUrl, "https://image.tmdb.org/t/p/w500/poster.jpg", "Posters are asked for at w500")
    assertEqual(episode.stillUrl, "https://image.tmdb.org/t/p/w780/still.jpg", "stills at w780")
    assertEqual(episode.backdropUrl, "", "A local arr path is never used")
    assertEqual(episode.tvdbId, "71663", "Provider ids come from the series")
    assertEqual(episode.tmdbId, "456", "and the TMDB one")
    assertEqual(episode.itemId, "series-1", "The library's series comes along")
    assertEqual(episode.episodeId, "", "An episode the server lacks has no episode id")
    assertEqual(episode.badge, "seasonFinale", "Sonarr's finale type is the badge")
    assertEqual(episode.monitored, true, "Monitored by default")
    assertEqual(episode.runtime, 45, "The episode's own runtime is used")
    assertEqual(calendarEntries.ParseSonarr({ runtime: 0, airDate: "2026-11-05", series: { title: "x", runtime: 24 } }).runtime, 0, "An unaired episode's 0 runtime stays 0")
    assertEqual(calendarEntries.ParseSonarr({ airDate: "2026-11-05", series: { title: "x", runtime: 24 } }).runtime, 24, "and the series' runtime fills in only when the episode has none")
    assertEqual(calendarEntries.InLibrary(episode), false, "An episode without a library episode isn't in the library")

    dayOnly = calendarEntries.ParseSonarr({ seasonNumber: 1, episodeNumber: 1, airDate: "2026-11-05", series: { title: "Sword & Silence", tvdbId: 0, monitored: false } })
    assertEqual(dayOnly.hasTime, false, "A bare air date has no time")
    assertEqual(dayOnly.day, nov5, "and sits on its own day")
    assertEqual(dayOnly.badge, "seriesPremiere", "S1E1 is a series premiere")
    assertEqual(dayOnly.tvdbId, "", "A zero id is no id")
    assertEqual(dayOnly.monitored, false, "An unmonitored series makes its episodes unmonitored")
    assertEqual(dayOnly.key, "sonarr::1:1", "Without a Sonarr id the key falls back to the episode")
    assertEqual(calendarEntries.ParseSonarr({ seasonNumber: 3, episodeNumber: 1, airDate: "2026-11-05", series: { title: "Bleach" } }).badge, "seasonPremiere", "E1 of a later season is a new season")
    assertEqual(calendarEntries.ParseSonarr({ seasonNumber: 0, episodeNumber: 1, airDate: "2026-11-05", series: { title: "Bleach" } }).badge, "", "A special is no premiere")
    assertEqual(calendarEntries.ParseSonarr({ airDate: "2026-11-05" }), invalid, "No series, no entry")
    assertEqual(calendarEntries.ParseSonarr({ series: { title: "x" } }), invalid, "No air date, no entry")
    assertEqual(calendarEntries.ParseSonarr("broken"), invalid, "Anything else, no entry")

    inLibrary = calendarEntries.ParseSonarr({ id: 9, seasonNumber: 38, episodeNumber: 6, airDate: "2026-11-04", hasFile: true, moonfinItemId: "series-1", moonfinEpisodeId: "ep-6", series: { title: "The Simpsons" } })
    assertEqual(calendarEntries.PlayableId(inLibrary), "ep-6", "An episode on the server plays its own id")
    assertEqual(calendarEntries.Status(inLibrary, 0), "ready", "and is ready")

    radarr = {
        id: 7, title: "Sintel", tmdbId: 45745, year: 2010, studio: "Blender", runtime: 15, hasFile: true, monitored: true,
        moonfinItemId: "movie-1", moonfinLibraryIds: ["movies"],
        inCinemas: "2026-10-01T00:00:00Z", digitalRelease: "2026-11-02T00:00:00Z", physicalRelease: "2027-06-01T00:00:00Z",
        images: [{ coverType: "fanart", remoteUrl: "https://image.tmdb.org/t/p/original/fan.jpg" }]
    }
    movies = calendarEntries.ParseRadarr(radarr, nov5 - 14, nov5 + 91)
    assertEqual(movies.Count(), 1, "Only release dates inside the window become entries")
    movie = movies[0]
    assertEqual(movie.key, "radarr:45745:digital", "A movie entry is keyed by its TMDB id and release")
    assertEqual(movie.release, "digital", "It knows which release it is")
    assertEqual(movie.day, nov5 - 3, "on the day Radarr gives")
    assertEqual(movie.hasTime, false, "with no time")
    assertEqual(movie.network, "Blender", "The studio stands in for the network")
    assertEqual(movie.backdropUrl, "https://image.tmdb.org/t/p/w1280/fan.jpg", "Backdrops are asked for at w1280")
    assertEqual(calendarEntries.PlayableId(movie), "movie-1", "A movie with its file plays")
    assertEqual(calendarEntries.ParseRadarr({ title: "Steps", hasFile: false, moonfinItemId: "m", digitalRelease: "2026-11-20T00:00:00Z" }, nov5, nov5 + 30)[0].itemId, "m", "A movie keeps its library id")
    assertEqual(calendarEntries.InLibrary(calendarEntries.ParseRadarr({ title: "Steps", hasFile: false, moonfinItemId: "m", digitalRelease: "2026-11-20T00:00:00Z" }, nov5, nov5 + 30)[0]), false, "but without a file it isn't in the library")
    assertEqual(calendarEntries.ParseRadarr({ title: "", inCinemas: "2026-11-05T00:00:00Z" }, nov5, nov5 + 1).Count(), 0, "A movie with no title gives nothing")
    both = calendarEntries.ParseRadarr({ title: "Hunger Games", tmdbId: 1, inCinemas: "2026-11-18T00:00:00Z", digitalRelease: "2027-01-04T00:00:00Z" }, nov5 - 14, nov5 + 91)
    assertEqual(both.Count(), 2, "Each release date in the window is its own entry")

    ' Filters
    filter = calendarFilter()
    special = calendarEntries.ParseSonarr({ seasonNumber: 0, episodeNumber: 3, airDate: "2026-11-05", moonfinItemId: "series-2", series: { title: "Bleach" } })
    assertEqual(calendarEntries.Allows(episode, filter), true, "Episodes show by default")
    assertEqual(calendarEntries.Allows(special, filter), false, "Specials don't")
    filter.showSpecials = true
    assertEqual(calendarEntries.Allows(special, filter), true, "until they're asked for")
    filter.showEpisodes = false
    assertEqual(calendarEntries.Allows(episode, filter), false, "Episodes can be turned off")
    assertEqual(calendarEntries.Allows(movie, filter), true, "which leaves movies")
    filter = calendarFilter()
    filter.digital = false
    assertEqual(calendarEntries.Allows(movie, filter), false, "A release type can be turned off")
    filter = calendarFilter()
    filter.showMovies = false
    assertEqual(calendarEntries.Allows(movie, filter), false, "and movies too")
    filter = calendarFilter()
    filter.libraryIds = ["movies"]
    assertEqual(calendarEntries.Allows(movie, filter), true, "A picked library keeps its titles")
    assertEqual(calendarEntries.Allows(episode, filter), false, "and hides the others")
    assertEqual(calendarEntries.Allows(dayOnly, filter), false, "and the ones placed in no library")
    filter = calendarFilter()
    filter.myShowsOnly = true
    progress = { "series-1": calendarEntries.ProgressOf({ RecursiveItemCount: 10, UserData: { UnplayedItemCount: 4, Played: false } }), "series-2": calendarEntries.ProgressOf({ RecursiveItemCount: 10, UserData: { UnplayedItemCount: 10 } }) }
    filter.followed = calendarEntries.FollowedIds(progress)
    assertEqual(calendarEntries.Allows(episode, filter), true, "My shows keeps a series the user started")
    assertEqual(calendarEntries.Allows(special, filter), false, "and drops one they haven't")
    assertEqual(calendarEntries.Allows(movie, filter), true, "Movies aren't touched by My shows")
    assertEqual(calendarEntries.ProgressOf({ RecursiveItemCount: 10, UserData: { UnplayedItemCount: 10, IsFavorite: true } }).favorite, true, "A favorite is followed")
    assertEqual(calendarEntries.ProgressOf({ RecursiveItemCount: 10, UserData: { UnplayedItemCount: 10, LastPlayedDate: "2026-01-01" } }).started, true, "A series played once is started")
    assertEqual(calendarEntries.HidesSpoilers(episode, true, progress), true, "Spoiler safe hides a series the user is behind on")
    assertEqual(calendarEntries.HidesSpoilers(episode, false, progress), false, "only when it's on")
    assertEqual(calendarEntries.HidesSpoilers(movie, true, progress), false, "and never a movie")
    assertEqual(calendarEntries.ThumbUrl(episode, true), "https://image.tmdb.org/t/p/w500/poster.jpg", "A hidden still falls back to the series art")

    ' Lists
    a = calendarEntries.ParseSonarr({ id: 1, seasonNumber: 1, episodeNumber: 2, airDate: "2026-11-04", series: { title: "Bravo" } })
    b = calendarEntries.ParseSonarr({ id: 2, seasonNumber: 1, episodeNumber: 1, airDate: "2026-11-06", series: { title: "Alpha" } })
    c = calendarEntries.ParseRadarr({ title: "Charlie", tmdbId: 5, digitalRelease: "2026-11-05T00:00:00Z" }, nov5 - 14, nov5 + 91)[0]
    d = calendarEntries.ParseSonarr({ id: 3, seasonNumber: 1, episodeNumber: 1, airDate: "2026-11-05", series: { title: "Alpha" } })
    list = [b, c, a, d]
    calendarEntries.SortEntries(list)
    assertEqual(calendarTitles(list), "Bravo,Alpha,Charlie,Alpha", "Entries sort by day, then title")
    assertEqual(calendarTitles(calendarEntries.Upcoming(list, nov5)), "Alpha,Charlie,Alpha", "Upcoming starts today")
    assertEqual(calendarTitles(calendarEntries.Recent(list, nov5)), "Bravo", "Recently aired is before today")
    assertEqual(calendarTitles(calendarEntries.RecentAndToday(list, nov5)), "Charlie,Alpha,Bravo", "newest first, with today")
    assertEqual(calendarTitles(calendarEntries.OnDay(list, nov5)), "Alpha,Charlie", "A day lists its own entries")
    assertEqual(calendarEntries.NextUp(list, b.seconds).key, b.key, "The next is the first that hasn't aired, a day counting to its end")
    assertEqual(calendarTitles(calendarEntries.ThisWeek(list, nov5, 0)), "Alpha,Charlie,Alpha", "This week is the next seven days")

    ' Labels
    assertEqual(calendarEntries.Subtitle(episode, false), "S38 E7", "An episode with no name shows its code")
    assertEqual(calendarEntries.Subtitle(inLibrary, false), "S38 E6", "and only its code")
    assertEqual(calendarEntries.Subtitle(movie, false), "Digital · 2010", "A movie shows its release and year")
    assertEqual(calendarEntries.ClockText(21, 0, false), "9:00 PM", "Twelve hour time")
    assertEqual(calendarEntries.ClockText(0, 5, false), "12:05 AM", "Midnight is 12")
    assertEqual(calendarEntries.ClockText(21, 0, true), "21:00", "Twenty four hour time")
    assertEqual(calendarEntries.TimeText(movie, false), "All day", "A movie has no time")
    assertEqual(calendarEntries.DayName(nov5, nov5), "Today", "Today")
    assertEqual(calendarEntries.DayName(nov5 + 1, nov5), "Tomorrow", "Tomorrow")
    assertEqual(calendarEntries.DayName(nov5 - 1, nov5), "Yesterday", "Yesterday")
    assertEqual(calendarEntries.DayName(nov5 + 6, nov5), "Wed, Nov 11", "Any other day is its date")
    assertEqual(calendarEntries.LongDate(nov5), "November 5", "The long date")
    assertEqual(calendarEntries.MonthTitle(2026, 11), "November 2026", "The month title")
    assertEqual(calendarEntries.ReleaseIn(nov5 + 6, nov5), "In 6 days (Nov 11)", "The end card says when the next episode airs")
    assertEqual(calendarEntries.ReleaseIn(nov5, nov5), "Today (Nov 5)", "even today")
    assertEqual(calendarEntries.FullDate(nov5), "Thursday, November 5, 2026", "The full date")

    ' The Date Format setting, read for whoever is signed in
    savedGlobal = m.global
    m.global = { session: { user: { id: "date-user" } } }
    m.registry["date-user"] = { "ui.dateFormat": "monthDay" }
    assertEqual(calendarEntries.ShortDate(nov5 + 14), "Nov 19", "Month first, the short date")
    assertEqual(calendarEntries.ShortDayName(nov5 + 14), "Thu, Nov 19", "the day name")
    assertEqual(calendarEntries.FullDate(nov5 + 14), "Thursday, November 19, 2026", "and the full date")
    assertEqual(calendarEntries.DayName(nov5 + 14, nov5, "dayMonth"), "Thu 19 Nov", "An order read once and passed in wins")
    assertEqual(calendarEntries.FullDate(nov5 + 14, "dayMonth"), "Thursday, 19 November 2026", "for the full date too")
    m.registry["date-user"]["ui.dateFormat"] = "dayMonth"
    assertEqual(calendarEntries.ShortDate(nov5 + 14), "19 Nov", "Day first, the short date")
    assertEqual(calendarEntries.ShortDayName(nov5 + 14), "Thu 19 Nov", "the day name")
    assertEqual(calendarEntries.FullDate(nov5 + 14), "Thursday, 19 November 2026", "and the full date")
    assertEqual(calendarEntries.DayName(nov5 + 14, nov5), "Thu 19 Nov", "The calendar headers follow it")
    assertEqual(calendarEntries.ReleaseIn(nov5 + 14, nov5), "In 14 days (19 Nov)", "and so do the release lines")
    m.registry["date-user"]["ui.dateFormat"] = "yearMonthDay"
    assertEqual(calendarEntries.FullDate(nov5 + 14), "Thursday, November 19, 2026", "An order nobody knows is the locale default")
    m.registry.Delete("date-user")
    m.global = savedGlobal
    assertEqual(calendarEntries.ColorOf(movie, 0, "type", "#00A4DC"), calendarEntries.MOVIE_COLOR, "Movies are amber by type")
    assertEqual(calendarEntries.ColorOf(episode, 0, "type", "#00A4DC"), "#00A4DC", "Episodes take the accent")
    assertEqual(calendarEntries.ColorOf(movie, 0, "status", "#00A4DC"), calendarEntries.READY_COLOR, "In library is green by status")
    assertEqual(calendarEntries.ColorOf(episode, episode.seconds + 1, "status", "#00A4DC"), calendarEntries.MISSING_COLOR, "Aired and missing is orange")
    tags = calendarEntries.TagsOf(episode, episode.seconds + 1, true, "#00A4DC")
    assertEqual(tags.Count(), 2, "A missing finale carries two tags")
    assertEqual(tags[0].label, "Finale", "the badge first")
    assertEqual(tags[1].label, "Missing", "then its status")
    assertEqual(calendarEntries.TagsOf(episode, 0, false, "#00A4DC").Count(), 0, "Badges can be turned off")
    assertEqual(calendarEntries.TagsOf(dayOnly, 0, false, "#00A4DC")[0].label, "Not monitored", "An unmonitored title says so")

    ' The month grid and its countdown
    grid = calendarEntries.GridDays(2026, 11, 0)
    assertEqual(grid.Count(), 35, "November 2026 from Sunday is five weeks")
    assertEqual(calendarEntries.DateText(grid[0]), "2026-11-01", "and starts on the 1st, a Sunday")
    monday = calendarEntries.GridDays(2026, 11, 1)
    assertEqual(monday.Count(), 42, "From Monday it takes six")
    assertEqual(calendarEntries.DateText(monday[0]), "2026-10-26", "starting in October")
    assertEqual(calendarEntries.WeekStartOf("locale", "en_US"), 0, "The US starts on Sunday")
    assertEqual(calendarEntries.WeekStartOf("locale", "de_DE"), 1, "Germany on Monday")
    assertEqual(calendarEntries.WeekStartOf("sunday", "de_DE"), 0, "unless the user picks")
    parts = calendarEntries.CountdownParts(1000 + 2 * 86400 + 3 * 3600 + 61, 1000)
    assertEqual(FormatJson([parts.days, parts.hours, parts.minutes]), "[2,3,2]", "The countdown rounds the minutes up")
    parts = calendarEntries.CountdownParts(0, 1000)
    assertEqual(FormatJson([parts.days, parts.hours, parts.minutes]), "[0,0,0]", "and stops at zero")
end sub

function calendarFilter() as object
    return { showEpisodes: true, showMovies: true, showSpecials: false, cinema: true, digital: true, physical: true, libraryIds: [], myShowsOnly: false, followed: {} }
end function

function calendarTitles(entries as object) as string
    titles = []
    for each entry in entries
        titles.push(entry.title)
    end for
    return titles.Join(",")
end function

sub testSiloPlaybackControl()
    ' The hello list, in the order the protocol gives it
    assertEqual(siloPlaybackControl.Commands().join(","), "pause,unpause,play_pause,stop,display_message,server_restarting,server_shutting_down,terminate", "The hello lists the commands in protocol order")
    assertEqual(siloPlaybackControl.PROTOCOL, "silo.playback-control.v2", "The protocol name")
    assertEqual(siloPlaybackControl.MAX_ATTEMPTS, 10, "Ten retries in a row")
    assertEqual(siloPlaybackControl.STABLE_SECONDS, 30, "A connection up 30 seconds resets the count")
    assertEqual(siloPlaybackControl.GRACE_SECONDS, 5, "A let-go lane waits 5 seconds for its answers")
    assertEqual(siloPlaybackControl.CAPS_TTL_SECONDS, 600, "A usable capability answer is kept 10 minutes")

    ' R2: one spelling of a server, so a session is found the same way on both sides
    assertEqual(siloPlaybackControl.ServerKey("HTTP://Host:8090/"), "http://host:8090", "An upper-case scheme and host with a trailing slash")
    assertEqual(siloPlaybackControl.ServerKey(" host:8090"), "http://host:8090", "A bare host gets http:// and loses its spaces")
    assertEqual(siloPlaybackControl.ServerKey("http://host:8090"), "http://host:8090", "The plain spelling is unchanged")
    assertEqual(siloPlaybackControl.ServerKey("https://Silo.Example/emby//"), "https://silo.example/emby", "The path is kept, its slashes trimmed")
    assertEqual(siloPlaybackControl.ServerKey("   "), "", "A blank server has no key")

    ' §2: ws for http, wss for https, the session id encoded, no query string
    assertEqual(siloPlaybackControl.SocketUrl("http://silo:8090", "s1"), "ws://silo:8090/api/v2/playback/sessions/s1/control/ws", "http becomes ws")
    assertEqual(siloPlaybackControl.SocketUrl("HTTPS://Silo.example/", "s1"), "wss://silo.example/api/v2/playback/sessions/s1/control/ws", "https becomes wss")
    assertEqual(siloPlaybackControl.SocketUrl("http://silo:8090", "x/y"), "ws://silo:8090/api/v2/playback/sessions/x%2Fy/control/ws", "The session id is URL-encoded")

    ' §2: the protocols in order, the way siloParty.Protocols formats them
    assertEqual(siloPlaybackControl.Protocols("abc"), "silo.playback-control.v2, silo.ticket.abc", "The protocol, then the ticket")

    ' R8: renewal a minute before the connection limit or the token expiry, never under 5 s
    assertEqual(siloPlaybackControl.RenewDelaySeconds(14400, 0, 0, 0), 14340#, "The connection limit, less a minute")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(14400, 1300, 600, 1000), 240#, "A token that expires sooner sets the renewal")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(14400, 1300, 0, 1000), 14340#, "A token with no lifetime is ignored")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(14400, 0, 600, 1000), 14340#, "A token with no expiry is ignored")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(14400, 1030, 600, 1000), 5#, "An expiry inside the margin renews in 5 seconds, never sooner")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(100, 0, 0, 0), 40#, "A short limit renews a minute early")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(30, 0, 0, 0), 5#, "A limit under the margin still waits 5 seconds")
    assertEqual(siloPlaybackControl.RenewDelaySeconds(invalid, 0, 0, 0), 14340#, "A missing limit falls back to 14400 seconds")

    ' R10: 1, 2, 4, 8, 16, then 30 (capped), with up to half a second of jitter
    assertEqual(siloPlaybackControl.BackoffSeconds(0, 0#), 1#, "The first wait is a second")
    assertEqual(siloPlaybackControl.BackoffSeconds(1, 0#), 2#, "then two")
    assertEqual(siloPlaybackControl.BackoffSeconds(2, 0#), 4#, "then four")
    assertEqual(siloPlaybackControl.BackoffSeconds(3, 0#), 8#, "then eight")
    assertEqual(siloPlaybackControl.BackoffSeconds(4, 0#), 16#, "then sixteen")
    assertEqual(siloPlaybackControl.BackoffSeconds(5, 0#), 30#, "then the 30 second cap")
    assertEqual(siloPlaybackControl.BackoffSeconds(9, 0#), 30#, "and it stays at the cap")
    assertEqual(siloPlaybackControl.BackoffSeconds(1, 1#), 2.5#, "Full jitter adds half a second")
    assertEqual(siloPlaybackControl.BackoffSeconds(9, 1#), 30.5#, "and the cap still gets it")
    assertEqual(siloPlaybackControl.BackoffSeconds(1, -1#), 2#, "Jitter below zero counts as none")
    assertEqual(siloPlaybackControl.BackoffSeconds(1, 5#), 2.5#, "Jitter above one counts as one")

    ' §2 and R9: 409 and 410 are final, 401 and 403 are the token, the rest retry
    assertEqual(siloPlaybackControl.TicketRefusal(409), "final", "A 409 ends the session for this lane")
    assertEqual(siloPlaybackControl.TicketRefusal(410), "final", "and so does a 410")
    assertEqual(siloPlaybackControl.TicketRefusal(401), "token", "A 401 is the token")
    assertEqual(siloPlaybackControl.TicketRefusal(403), "token", "and so is a 403")
    assertEqual(siloPlaybackControl.TicketRefusal(404), "retry", "A 404 while the server rebuilds retries")
    assertEqual(siloPlaybackControl.TicketRefusal(503), "retry", "and so does a 503")
    assertEqual(siloPlaybackControl.TicketRefusal(0), "retry", "and no answer")

    ' What the lane does after a ticket fails
    assertEqual(siloPlaybackControl.NextAfterTicket("final", false, false), "refused", "A final refusal is never asked again")
    assertEqual(siloPlaybackControl.NextAfterTicket("final", true, true), "refused", "even on a renewal")
    assertEqual(siloPlaybackControl.NextAfterTicket("token", false, false), "gaveUp", "A first open with a refused token waits for a replan")
    assertEqual(siloPlaybackControl.NextAfterTicket("token", true, true), "renewOnClose", "A renewal with a refused token waits for the old close")
    assertEqual(siloPlaybackControl.NextAfterTicket("retry", false, false), "backoff", "A retry backs off")
    assertEqual(siloPlaybackControl.NextAfterTicket("retry", true, true), "backoff", "and so does a renewal")

    ' R11: keep a usable answer or a 404; not allowed:false, not available:false, not a failure
    usable = { available: true, allowed: true, protocol: "silo.playback-control.v2" }
    assertEqual(siloPlaybackControl.CapsUsable(usable), true, "A usable answer counts")
    assertEqual(siloPlaybackControl.CapsUsable({ available: true, protocol: "silo.playback-control.v2" }), true, "An answer with no allowed field counts")
    assertEqual(siloPlaybackControl.CapsUsable({ available: true, allowed: false, protocol: "silo.playback-control.v2" }), false, "allowed:false does not count")
    assertEqual(siloPlaybackControl.CapsUsable({ available: false, allowed: true, protocol: "silo.playback-control.v2" }), false, "available:false does not count")
    assertEqual(siloPlaybackControl.CapsUsable({ available: true, allowed: true, protocol: "silo.other.v1" }), false, "another protocol does not count")
    assertEqual(siloPlaybackControl.CapsUsable(invalid), false, "No answer does not count")
    assertEqual(siloPlaybackControl.CapsUsable("available"), false, "A non-object answer does not count")
    assertEqual(siloPlaybackControl.CapsKeep(200, true), true, "A usable answer is kept")
    assertEqual(siloPlaybackControl.CapsKeep(404, false), true, "A 404 is kept: an older server")
    assertEqual(siloPlaybackControl.CapsKeep(200, false), false, "an unusable answer is not kept")
    assertEqual(siloPlaybackControl.CapsKeep(503, false), false, "a failed read is not kept")
    assertEqual(siloPlaybackControl.CapsKeep(401, false), false, "and neither is a refused login")

    ' §2 frame checks: a command of this session, with an id
    frame = FormatJson({ type: "command", command_id: "c1", session_id: "s1", name: "pause" })
    parsed = siloPlaybackControl.ParseCommand(frame, "s1")
    assertEqual(parsed.id, "c1", "A command keeps its id")
    assertEqual(parsed.name, "pause", "and its name")
    assertEqual(parsed.reason = invalid, true, "A command with no reason has none")
    assertEqual(type(parsed.payload), "roAssociativeArray", "and an empty payload")
    parsed = siloPlaybackControl.ParseCommand(FormatJson({ type: "command", command_id: "c2", session_id: "s1", name: "terminate", reason: "  Maintenance  " }), "s1")
    assertEqual(parsed.reason, "Maintenance", "A reason is trimmed")
    parsed = siloPlaybackControl.ParseCommand(FormatJson({ type: "command", command_id: "c3", session_id: "s1", name: "stop", reason: "   " }), "s1")
    assertEqual(parsed.reason = invalid, true, "A blank reason is none")
    assertEqual(siloPlaybackControl.ParseCommand(FormatJson({ type: "command", command_id: "c4", session_id: "other", name: "pause" }), "s1") = invalid, true, "A command for another session is ignored")
    assertEqual(siloPlaybackControl.ParseCommand(FormatJson({ type: "command", session_id: "s1", name: "pause" }), "s1") = invalid, true, "A command with no id is ignored")
    assertEqual(siloPlaybackControl.ParseCommand(FormatJson({ type: "command", command_id: "", session_id: "s1", name: "pause" }), "s1") = invalid, true, "A command with an empty id is ignored")
    assertEqual(siloPlaybackControl.ParseCommand(FormatJson({ type: "result", command_id: "c5", session_id: "s1" }), "s1") = invalid, true, "A frame that isn't a command is ignored")
    assertEqual(siloPlaybackControl.ParseCommand("not json", "s1") = invalid, true, "Text that isn't JSON is ignored")
    assertEqual(siloPlaybackControl.ParseCommand("[1, 2]", "s1") = invalid, true, "A JSON array is ignored")
    assertEqual(siloPlaybackControl.ParseCommand(frame, "") = invalid, true, "Without a session nothing matches")

    ' R20: what a command does on the player
    action = siloPlaybackControl.ActionOf("pause", invalid)
    assertEqual(action.kind, "pause", "pause pauses")
    assertEqual(siloPlaybackControl.ActionOf("unpause", invalid).kind, "resume", "unpause resumes")
    assertEqual(siloPlaybackControl.ActionOf("play_pause", invalid).kind, "toggle", "play_pause toggles")
    assertEqual(siloPlaybackControl.ActionOf("stop", invalid).kind, "stop", "stop stops")
    assertEqual(siloPlaybackControl.ActionOf("terminate", invalid).kind, "terminate", "terminate ends the session")
    action = siloPlaybackControl.ActionOf("server_restarting", { title: "Restarting", message: "Back in 5 minutes" })
    assertEqual(action.kind, "message", "A restart notice is a message")
    assertEqual(action.title, "Restarting", "its header is the title")
    assertEqual(action.text, "Back in 5 minutes", "and its text is the message")
    action = siloPlaybackControl.ActionOf("display_message", { message: "  Dinner is ready  " })
    assertEqual(action.text, "Dinner is ready", "An untitled message is trimmed")
    assertEqual(action.title, "", "and has no header")
    action = siloPlaybackControl.ActionOf("display_message", { title: "Admin" })
    assertEqual(action.text, "Admin", "A title-only notice shows the title as its text")
    assertEqual(action.title, "", "and no header")
    assertEqual(siloPlaybackControl.ActionOf("display_message", { message: "   " }) = invalid, true, "A blank message is refused")
    assertEqual(siloPlaybackControl.ActionOf("display_message", invalid) = invalid, true, "A message with no payload is refused")
    assertEqual(siloPlaybackControl.ActionOf("seek", invalid) = invalid, true, "A name the lane doesn't run is refused")

    ' §2 frame shapes
    hello = siloPlaybackControl.Hello("s1", "3.2.0")
    assertEqual(hello.type, "hello", "The hello is a hello")
    assertEqual(hello.session_id, "s1", "for this session")
    assertEqual(hello.client.name, "Moonfin", "from Moonfin")
    assertEqual(hello.client.version, "3.2.0", "at this version")
    assertEqual(hello.capabilities.commands.join(","), siloPlaybackControl.Commands().join(","), "listing the commands")
    assertEqual(siloPlaybackControl.Hello("s1", "").client.version, "0", "A missing version is sent as 0")
    ack = siloPlaybackControl.Ack("s1", "c1")
    assertEqual(ack.type, "ack", "The ack is an ack")
    assertEqual(ack.command_id, "c1", "for its command")
    assertEqual(ack.session_id, "s1", "in this session")
    assertEqual(ack.status, "accepted", "and accepted")
    done = siloPlaybackControl.Result("s1", "c1", invalid)
    assertEqual(done.type, "result", "The answer is a result")
    assertEqual(done.status, "completed", "A result with no error completed")
    assertEqual(done.error = invalid, true, "and carries no error")
    refused = siloPlaybackControl.Result("s1", "c2", "not_playing")
    assertEqual(refused.status, "rejected", "A rejection says rejected")
    assertEqual(refused.error, "not_playing", "and names its reason")
    assertEqual(refused.command_id, "c2", "for its command")

    ' R15, R5, R3: one answer for "still plays this session"
    assertEqual(siloPlaybackControl.StillPlays("http://silo:8090", "s1", "http://silo:8090", "s1"), true, "The same server and session still play")
    assertEqual(siloPlaybackControl.StillPlays("http://silo:8090", "s2", "http://silo:8090", "s1"), false, "Another session does not")
    assertEqual(siloPlaybackControl.StillPlays("http://other:8090", "s1", "http://silo:8090", "s1"), false, "The same id on another server does not")
    assertEqual(siloPlaybackControl.StillPlays("", "", "", ""), false, "Nothing playing is not the session")
    assertEqual(siloPlaybackControl.StillPlays("http://silo:8090", "", "http://silo:8090", ""), false, "An empty session never matches")
    assertEqual(siloPlaybackControl.StillPlays("", "s1", "", "s1"), false, "An empty server never matches")
end sub

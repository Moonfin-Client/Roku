' Label colors, the corner cap and which cards get asked about at all
sub testPosterLabels()
    context = posterLabels.Context("http://server/Moonfin/Assets/")

    solid = posterLabels.Entry({ label: "1080p", color: "#0284C7", textColor: "", style: "solid", opacity: 100, size: "medium", corner: "topLeft", shape: "rounded", icon: "" }, context)
    assertEqual(solid.fill, "#0284C7FF", "A solid label fills with the admin's color")
    assertEqual(solid.textColor, "#FFFFFFFF", "and writes white on a dark one")
    assertEqual(solid.border, "", "with no border")
    assertEqual(solid.corner, "topleft", "in the corner the admin picked")
    assertEqual(posterLabels.Entry({ label: "HDR", color: "#FACC15", style: "solid" }, context).textColor, "#000000FF", "A solid label writes black on a light color")

    glass = posterLabels.Entry({ label: "4K", color: "#2563EB", style: "glass", opacity: 50 }, context)
    assertEqual(glass.fill, "#2563EB39", "Opacity fades a glass label's fill")
    assertEqual(glass.border, "#FFFFFF2D", "and its border")
    assertEqual(glass.textColor, "#FFFFFFFF", "but never its text")

    outline = posterLabels.Entry({ label: "HEVC", color: "#000000", style: "outline" }, context)
    assertEqual(outline.fill, "#0000008C", "An outline label sits on a dark scrim")
    assertEqual(outline.border, "#000000FF", "inside a border of the admin's color")
    assertEqual(outline.textColor, "#FFFFFFFF", "and a black one writes white")

    light = posterLabels.Entry({ label: "5.1", color: "#6D28D9", style: "light", size: "small", shape: "pill" }, context)
    assertEqual(light.fill, "#FFFFFFEB", "A light label fills white")
    assertEqual(light.textColor, "#6D28D9FF", "and writes a dark color in that color")
    assertEqual(light.size, 0.8, "Small labels draw at 0.8")
    assertEqual(light.shape, "pill", "and keep the admin's shape")

    assertEqual(posterLabels.Entry({ label: "VFQ", color: "#2563EB", textColor: "#112233" }, context).textColor, "#112233FF", "The admin's text color wins")
    assertEqual(posterLabels.Entry({ label: "X", color: "#2563EB", opacity: 5 }, context).fill, "#2563EB1A", "Opacity never drops under 10")
    assertEqual(posterLabels.Entry({ label: "X", color: "blue" }, context).fill, "#2563EBFF", "A color that doesn't parse falls back to the server's own")

    flag = posterLabels.Entry({ label: "", color: "#2563EB", icon: "flag-jp", corner: "bottomLeft" }, context)
    assertEqual(flag.flag, "http://server/Moonfin/Assets/flag-jp.webp", "A flag is read from Moonbase")
    assertEqual(flag.fill, "", "and a flag alone has no fill")
    assertEqual(posterLabels.Entry({ label: "CAT", icon: "flag-es-ct" }, context).flag, "http://server/Moonfin/Assets/flag-es-ct.webp", "Region flags are known too")
    assertEqual(posterLabels.Entry({ label: "", icon: "flag-zz" }, context), invalid, "A flag this app doesn't know draws nothing on its own")
    assertEqual(posterLabels.Entry({ label: "  ", icon: "rocket" }, context), invalid, "Nor does an icon it doesn't know")
    assertEqual(posterLabels.Entry({ label: "", icon: "hdr_on" }, context).icon, "pkg:/images/posterLabels/hdr_on.webp", "A known icon draws alone")
    assertEqual(posterLabels.Entry({ label: "Atmos", icon: "rocket" }, context).icon, "", "An unknown icon leaves the text")
    assertEqual(posterLabels.Entry({ icon: "star" }, context), invalid, "A label without its text field is left out")

    raw = [
        { label: "A", corner: "topLeft" },
        { label: "B", corner: "bottomRight" },
        { label: "C", corner: "topLeft" },
        { label: "D", corner: "topLeft" },
        { label: "", icon: "flag-zz", corner: "topRight" }
    ]
    shown = posterLabels.Shown(raw, 2, context)
    assertEqual(shown.count(), 3, "Each corner holds the admin's count at most")
    assertEqual(shown[2].text, "C", "and the admin's order wins it")

    home = serverIdentityKey("http://server:8096")
    assertEqual(posterLabels.ItemIdOf({ Id: "abc", Type: "Movie" }, home), "abc", "The server's own movies are asked about")
    assertEqual(posterLabels.ItemIdOf({ Id: "abc", Type: "Episode", _serverUrl: "http://server:8096/" }, home), "abc", "and its episodes, wherever they were stamped")
    assertEqual(posterLabels.ItemIdOf({ Id: "abc", Type: "Series" }, home), "", "A series isn't")
    assertEqual(posterLabels.ItemIdOf({ Id: "123", Type: "Movie", SeerrTmdbId: "123" }, home), "", "Nor is a Seerr title")
    assertEqual(posterLabels.ItemIdOf({ Id: "abc", Type: "Movie", _serverUrl: "http://other:8096" }, home), "", "Nor another server's movie")
end sub

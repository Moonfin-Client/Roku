sub testAchievementUnlocks()
    defaults = achievementsModel.ParseUnlockToastSettings({})
    assertEqual(`${defaults.enabled} ${defaults.minimumRarity} ${defaults.grouped} ${defaults.muteDuringPlayback}`, "true all true false", "Unlock notifications are on, for every rarity, grouped and not held back by playback unless the plugin says otherwise")
    chosen = achievementsModel.ParseUnlockToastSettings({ EnableUnlockToasts: false, UnlockToastGrouping: "individual", MuteToastsDuringPlayback: true })
    assertEqual(`${chosen.enabled} ${chosen.grouped} ${chosen.muteDuringPlayback}`, "false false true", "The plugin's flags are read the way it wrote them")

    rare = achievementsModel.ParseUnlockToastSettings({ MinimumToastRarity: "Rare" })
    assertEqual(achievementsModel.AllowsRarity(rare, "Common"), false, "A common badge falls under a rare minimum")
    assertEqual(achievementsModel.AllowsRarity(rare, "rare"), true, "A rare badge clears it")
    assertEqual(achievementsModel.AllowsRarity(rare, "Legendary"), true, "So does anything rarer")
    assertEqual(achievementsModel.AllowsRarity(defaults, "Common"), true, "With no minimum everything clears")

    shown = { keys: [], seen: {} }
    read = { Now: "2026-10-05T12:00:00Z", Badges: [unlockedBadge("b1", "Common", "2026-10-05T11:59:00Z"), unlockedBadge("b2", "Epic", "2026-10-05T11:59:30Z")] }
    assertEqual(unlockIds(achievementsModel.FreshUnlocks(read, shown, rare)), "b2", "Only what clears the minimum is passed on")
    assertEqual(unlockIds(achievementsModel.FreshUnlocks(read, shown, defaults)), "", "The same unlock is never passed on twice")
    later = { Badges: [unlockedBadge("b2", "Epic", "2026-10-06T08:00:00Z")] }
    assertEqual(unlockIds(achievementsModel.FreshUnlocks(later, shown, defaults)), "b2", "A badge unlocked again later is news again")
    assertEqual(unlockIds(achievementsModel.FreshUnlocks({ Badges: invalid }, shown, defaults)), "", "A read with no badges passes nothing on")

    many = []
    for i = 1 to 405
        many.push(unlockedBadge(`m${i}`, "Common", "2026-10-05T11:00:00Z"))
    end for
    achievementsModel.FreshUnlocks({ Badges: many }, shown, defaults)
    assertEqual(shown.keys.Count(), 400, "Only the latest few hundred unlocks are remembered")
    assertEqual(shown.seen.DoesExist("b1|2026-10-05T11:59:00Z"), false, "The oldest are let go first")
end sub

function unlockedBadge(id as string, rarity as string, at as string) as object
    return { Id: id, Title: id, Rarity: rarity, Unlocked: true, UnlockedAt: at }
end function

function unlockIds(badges as object) as string
    ids = []
    for each badge in badges
        ids.push(badge.id)
    end for
    return ids.Join(",")
end function

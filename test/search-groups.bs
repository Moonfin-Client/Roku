sub testSearchGroups()
    keys = []
    for each group in searchGroups.Catalogue()
        keys.push(group.key)
    end for
    assertEqual(keys[0] + "," + keys[1] + "," + keys[2], "books,audiobooks,movies", "Audiobooks get their own row, after books")

    page = []
    for i = 1 to 99
        page.push("AudioBook")
    end for
    page.push("Movie")
    wanted = searchGroups.Refills(page)
    assertEqual(inArray(wanted, "audiobook"), false, "A group the page already filled isn't searched again")
    assertEqual(inArray(wanted, "movie"), true, "A group the page left short is searched again")
    assertEqual(inArray(wanted, "musicartist,albumartist"), true, "A group asks for every type it shows")
    assertEqual(inArray(wanted, "person") or inArray(wanted, "tvchannel,livetvchannel"), false, "People and channels have their own requests")
    assertEqual(searchGroups.Refills([invalid, "Episode"]).Count(), searchGroups.Catalogue().Count() - 2, "A result with no type is skipped")

    copy = { json: { Id: "a", Name: "Last Letter", Type: "Movie", ProductionYear: 2018 } }
    sameFilm = { json: { Id: "b", Name: "Last Letter", Type: "Movie", ProductionYear: 2018 } }
    otherFilm = { json: { Id: "c", Name: "Last Letter", Type: "Movie", ProductionYear: 2020 } }
    kept = dedupeCopies([copy, sameFilm, otherFilm])
    assertEqual(kept.Count(), 2, "Two copies of one film show once")
    assertEqual(kept[1].json.Id, "c", "A different film with the same title still shows")
    sameYear = { json: { Id: "d", Name: "Halloween", Type: "Movie", ProductionYear: 2018, ProviderIds: { Tmdb: "424139" } } }
    remake = { json: { Id: "e", Name: "Halloween", Type: "Movie", ProductionYear: 2018, ProviderIds: { Tmdb: "999" } } }
    assertEqual(dedupeCopies([sameYear, remake]).Count(), 2, "Films with their own provider ids stay apart even in the same year")
    noYear = { json: { Id: "f", Name: "Home Video", Type: "Video" } }
    otherNoYear = { json: { Id: "g", Name: "Home Video", Type: "Video" } }
    assertEqual(dedupeCopies([noYear, otherNoYear]).Count(), 2, "Items with nothing else to match on are never merged by title alone")
end sub

sub testSearchGroups()
    keys = []
    for each group in searchGroups.Catalogue()
        keys.push(group.key)
    end for
    assertEqual(keys[0] + "," + keys[1] + "," + keys[2], "books,audiobooks,movies", "Audiobooks get their own row, after books")

    page = []
    for i = 1 to 99
        page.push("AudioBook")
    end for
    page.push("Movie")
    wanted = searchGroups.Refills(page)
    assertEqual(inArray(wanted, "audiobook"), false, "A group the page already filled isn't searched again")
    assertEqual(inArray(wanted, "movie"), true, "A group the page left short is searched again")
    assertEqual(inArray(wanted, "musicartist,albumartist"), true, "A group asks for every type it shows")
    assertEqual(inArray(wanted, "person") or inArray(wanted, "tvchannel,livetvchannel"), false, "People and channels have their own requests")
    assertEqual(searchGroups.Refills([invalid, "Episode"]).Count(), searchGroups.Catalogue().Count() - 2, "A result with no type is skipped")
end sub

sub testLogRedaction()
    scrubbed = [
        ["-> GET https://media.example.com:8096/Items/487a/Images/Primary", "-> GET https://[REDACTED]/Items/487a/Images/Primary"],
        ["socket opened wss://media.example.com/socket", "socket opened wss://[REDACTED]/socket"],
        ["GET /Items?api_key=abc123def&Limit=20", "GET /Items?api_key=[REDACTED]&Limit=20"],
        ["Authorization: MediaBrowser Token=""abc123""", "Authorization: [REDACTED]"],
        ["GET /Items?ApiKey=***&Limit=20", "GET /Items?ApiKey=[REDACTED]&Limit=20"],
        ["GET /Videos/1/stream?X-Emby-Token=*** 200 (12ms)", "GET /Videos/1/stream?X-Emby-Token=[REDACTED] 200 (12ms)"],
        ["host: media.example.com", "host: [REDACTED]"],
        ["serverUrl=192.168.1.50:8096", "serverUrl=[REDACTED]:8096"],
        ["Failed host lookup: 'media.example.com'", "Failed host lookup: '[REDACTED]'"],
        ["connect failed to 10.0.0.42 after 3 tries", "connect failed to [REDACTED] after 3 tries"],
        ["bound to fe80::1c2d:3e4f:5a6b:7c8d ok", "bound to [REDACTED] ok"]
    ]
    for each pair in scrubbed
        assertEqual(logRedaction.Redact(pair[0]), pair[1], "Redact " + pair[0])
    end for
    for each kept in ["Subtitle: ass renderer started", "2026-09-07T12:29:24.123Z Information", "App Version 2.8.2", ""]
        assertEqual(logRedaction.Redact(kept), kept, "Keep " + kept)
    end for
end sub

' Spotlight's More Episodes card: where an episode with no season goes, and the order inside a season
sub testSpotlightEpisodes()
    special = { json: { Name: "Special 1", IndexNumber: 1 } }
    assertEqual(spotlightEpisodeSeason(special, 0), 0, "Across the whole run an episode with no season is a special")
    assertEqual(spotlightEpisodeSeason(special, 2), 2, "In one season's list it stays with that season")
    assertEqual(spotlightEpisodeSeason({ json: { ParentIndexNumber: 3 } }, 0), 3, "An episode with a season keeps it")

    ordered = spotlightEpisodeOrder([
        { season: 1, index: 1, name: "pilot", id: "s1e1" },
        { season: 0, index: 1, name: "special 1", id: "special" },
        { season: 1, index: 2, name: "beta", id: "beta" },
        { season: 1, index: 2, name: "alpha", id: "alpha" },
        { season: 1, index: 3, name: "same", id: "first" },
        { season: 1, index: 3, name: "same", id: "second" }
    ])
    ids = []
    for each entry in ordered
        ids.push(entry.id)
    end for
    assertEqual(ids.join(","), "special,s1e1,alpha,beta,first,second", "Specials lead, and episodes sharing a number go by title and then as listed")
end sub

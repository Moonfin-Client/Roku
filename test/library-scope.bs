' Rows that sweep several visible libraries join each library's answer before the limit
sub testLibraryScopeMerge()
    first = []
    second = []
    for i = 1 to 25
        first.push({ Id: "a" + i.toStr(), SortName: "a" + leftPad(i.toStr(), "0", 2) })
        second.push({ Id: "b" + i.toStr(), SortName: "b" + leftPad(i.toStr(), "0", 2) })
    end for

    ' The odds that every one of 25 shuffled picks comes from the first library are about 1 in 6e13
    picked = libraryScope.Merge([{ Items: first }, { Items: second }], { SortBy: "Random", Limit: 25 })
    fromSecond = 0
    for each item in picked.Items
        if item.Id.left(1) = "b" then fromSecond++
    end for
    assertEqual(picked.Items.count(), 25, "A random row still keeps to its limit")
    assertEqual(fromSecond > 0, true, "A random row mixes in albums from every library, not only the first one's 25")

    named = libraryScope.Merge([{ Items: second }, { Items: first }], { SortBy: "SortName", SortOrder: "Ascending", Limit: 25 })
    assertEqual(named.Items[0].Id, "a1", "A sort by name still puts the whole joined list in order")
    assertEqual(named.Items[24].Id, "a25", "A sort by name keeps the first 25 by name")
end sub

sub testPlaylistSortFilter()
    t1 = {
        title: "Song B",
        artists: ["Artist Y"],
        album: "Album 2",
        RunTimeTicks: 1200000000.0,
        ProductionYear: 2021,
        played: false,
        favorite: true,
        type: "Audio",
        json: {
            DateCreated: "2024-02-01T00:00:00Z",
            PremiereDate: "2021-05-01T00:00:00Z",
            CommunityRating: 8.5,
            CriticRating: 75.0,
            UserData: {
                Played: false,
                IsFavorite: true,
                PlayCount: 5,
                LastPlayedDate: "2024-03-01T00:00:00Z"
            }
        }
    }

    t2 = {
        title: "Song A",
        artists: ["Artist Z"],
        album: "Album 1",
        RunTimeTicks: 1800000000.0,
        ProductionYear: 2020,
        played: true,
        favorite: false,
        type: "Audio",
        json: {
            DateCreated: "2024-01-01T00:00:00Z",
            PremiereDate: "2020-01-01T00:00:00Z",
            CommunityRating: 9.0,
            CriticRating: 80.0,
            UserData: {
                Played: true,
                IsFavorite: false,
                PlayCount: 15,
                LastPlayedDate: "2024-04-01T00:00:00Z"
            }
        }
    }

    t3 = {
        title: "Music Video",
        artists: ["Artist X"],
        album: "Videos",
        RunTimeTicks: 2400000000.0,
        ProductionYear: 2023,
        played: false,
        favorite: true,
        type: "Video",
        json: {
            DateCreated: "2024-03-01T00:00:00Z",
            PremiereDate: "2023-08-01T00:00:00Z",
            CommunityRating: 7.0,
            CriticRating: 60.0,
            UserData: {
                Played: false,
                IsFavorite: true,
                PlayCount: 1,
                LastPlayedDate: ""
            }
        }
    }

    tracks = [t1, t2, t3]

    ' 1. Default Playlist Order Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "order", sortDirection: "ascending" })
    assertEqual(res.count(), 3, "Default count")
    assertEqual(res[0].title, "Song B", "Order 1")
    assertEqual(res[1].title, "Song A", "Order 2")
    assertEqual(res[2].title, "Music Video", "Order 3")

    ' 2. Playlist Order Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "order", sortDirection: "descending" })
    assertEqual(res[0].title, "Music Video", "Order Desc 1")
    assertEqual(res[1].title, "Song A", "Order Desc 2")
    assertEqual(res[2].title, "Song B", "Order Desc 3")

    ' 3. Sort by Name Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "name", sortDirection: "ascending" })
    assertEqual(res[0].title, "Music Video", "Name Asc 1")
    assertEqual(res[1].title, "Song A", "Name Asc 2")
    assertEqual(res[2].title, "Song B", "Name Asc 3")

    ' 4. Sort by Name Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "name", sortDirection: "descending" })
    assertEqual(res[0].title, "Song B", "Name Desc 1")
    assertEqual(res[1].title, "Song A", "Name Desc 2")
    assertEqual(res[2].title, "Music Video", "Name Desc 3")

    ' 5. Sort by Artist Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "artist", sortDirection: "ascending" })
    assertEqual(res[0].title, "Music Video", "Artist Asc 1 (Artist X)")
    assertEqual(res[1].title, "Song B", "Artist Asc 2 (Artist Y)")
    assertEqual(res[2].title, "Song A", "Artist Asc 3 (Artist Z)")

    ' 6. Sort by Album Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "album", sortDirection: "ascending" })
    assertEqual(res[0].title, "Song A", "Album Asc 1 (Album 1)")
    assertEqual(res[1].title, "Song B", "Album Asc 2 (Album 2)")
    assertEqual(res[2].title, "Music Video", "Album Asc 3 (Videos)")

    ' 7. Sort by Runtime Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "runtime", sortDirection: "ascending" })
    assertEqual(res[0].title, "Song B", "Runtime Asc 1 (120s)")
    assertEqual(res[1].title, "Song A", "Runtime Asc 2 (180s)")
    assertEqual(res[2].title, "Music Video", "Runtime Asc 3 (240s)")

    ' 8. Sort by Runtime Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "runtime", sortDirection: "descending" })
    assertEqual(res[0].title, "Music Video", "Runtime Desc 1")
    assertEqual(res[1].title, "Song A", "Runtime Desc 2")
    assertEqual(res[2].title, "Song B", "Runtime Desc 3")

    ' 9. Sort by Date Added Ascending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "dateAdded", sortDirection: "ascending" })
    assertEqual(res[0].title, "Song A", "DateAdded Asc 1 (Jan)")
    assertEqual(res[1].title, "Song B", "DateAdded Asc 2 (Feb)")
    assertEqual(res[2].title, "Music Video", "DateAdded Asc 3 (Mar)")

    ' 10. Sort by Premiere Date Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "premiereDate", sortDirection: "descending" })
    assertEqual(res[0].title, "Music Video", "PremiereDate Desc 1 (2023)")
    assertEqual(res[1].title, "Song B", "PremiereDate Desc 2 (2021)")
    assertEqual(res[2].title, "Song A", "PremiereDate Desc 3 (2020)")

    ' 11. Sort by Community Rating Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "communityRating", sortDirection: "descending" })
    assertEqual(res[0].title, "Song A", "Rating Desc 1 (9.0)")
    assertEqual(res[1].title, "Song B", "Rating Desc 2 (8.5)")
    assertEqual(res[2].title, "Music Video", "Rating Desc 3 (7.0)")

    ' 12. Sort by Critic Rating Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "criticRating", sortDirection: "descending" })
    assertEqual(res[0].title, "Song A", "Critic Desc 1 (80)")
    assertEqual(res[1].title, "Song B", "Critic Desc 2 (75)")
    assertEqual(res[2].title, "Music Video", "Critic Desc 3 (60)")

    ' 13. Sort by Play Count Descending
    res = playlistSortFilter.SortAndFilter(tracks, { sortBy: "playCount", sortDirection: "descending" })
    assertEqual(res[0].title, "Song A", "PlayCount Desc 1 (15)")
    assertEqual(res[1].title, "Song B", "PlayCount Desc 2 (5)")
    assertEqual(res[2].title, "Music Video", "PlayCount Desc 3 (1)")

    ' 14. Filter by Played: Unplayed
    res = playlistSortFilter.SortAndFilter(tracks, { playedFilter: "unplayed" })
    assertEqual(res.count(), 2, "Unplayed count")
    assertEqual(res[0].title, "Song B", "Unplayed 1")
    assertEqual(res[1].title, "Music Video", "Unplayed 2")

    ' 15. Filter by Played: Played
    res = playlistSortFilter.SortAndFilter(tracks, { playedFilter: "played" })
    assertEqual(res.count(), 1, "Played count")
    assertEqual(res[0].title, "Song A", "Played 1")

    ' 16. Filter by Favorites Only
    res = playlistSortFilter.SortAndFilter(tracks, { favoriteOnly: true })
    assertEqual(res.count(), 2, "Favorites count")
    assertEqual(res[0].title, "Song B", "Fav 1")
    assertEqual(res[1].title, "Music Video", "Fav 2")

    ' 17. Filter by Media Type: Audio
    res = playlistSortFilter.SortAndFilter(tracks, { mediaTypeFilter: "Audio" })
    assertEqual(res.count(), 2, "Audio count")
    assertEqual(res[0].title, "Song B", "Audio 1")
    assertEqual(res[1].title, "Song A", "Audio 2")

    ' 18. Filter by Media Type: Video
    res = playlistSortFilter.SortAndFilter(tracks, { mediaTypeFilter: "Video" })
    assertEqual(res.count(), 1, "Video count")
    assertEqual(res[0].title, "Music Video", "Video 1")

    ' 19. Combined Filters with 0 results
    res = playlistSortFilter.SortAndFilter(tracks, { playedFilter: "played", favoriteOnly: true })
    assertEqual(res.count(), 0, "No matches count")

    ' 20. Available Media Types
    types = playlistSortFilter.AvailableMediaTypes(tracks)
    assertEqual(types.count(), 2, "Media types count")

    ' 21. IsDefault and ActiveFilterCount
    assertEqual(playlistSortFilter.IsDefault({}), true, "Default empty options")
    assertEqual(playlistSortFilter.IsDefault({ sortBy: "name" }), false, "Not default sort")
    assertEqual(playlistSortFilter.IsDefault({ playedFilter: "played" }), false, "Not default filter")
    assertEqual(playlistSortFilter.ActiveFilterCount({}), 0, "0 active filters")
    assertEqual(playlistSortFilter.ActiveFilterCount({ playedFilter: "unplayed", favoriteOnly: true, mediaTypeFilter: "Audio" }), 3, "3 active filters")
end sub

sub testPlaylistSortFilter()
    ' A server sends whole numbers, longs and fractions in the same field, which sort apart on a
    ' Roku unless they are made one type
    songB = { title: "Song B", played: false, json: { Name: "Song B", SortName: "B Song", MediaType: "Audio", AlbumArtist: "Artist Y", Album: "Album 2", RunTimeTicks: 1800000000, DateCreated: "2024-02-01T00:00:00Z", PremiereDate: "2021-05-01T00:00:00Z", CommunityRating: 8.5, CriticRating: 75, UserData: { IsFavorite: true, PlayCount: 5, LastPlayedDate: "2024-03-01T00:00:00Z", PlaybackPositionTicks: 0 } } }
    songA = { title: "Song A", played: true, json: { Name: "Song A", MediaType: "Audio", Artists: ["Artist Z"], Album: "Album 1", RunTimeTicks: 3000000000&, DateCreated: "2024-01-01T00:00:00Z", ProductionYear: 2020, CommunityRating: 9, CriticRating: 80.5, UserData: { IsFavorite: false, PlayCount: 15, LastPlayedDate: "2024-04-01T00:00:00Z", PlaybackPositionTicks: 0 } } }
    video = { title: "Music Video", played: false, json: { Name: "Music Video", MediaType: "Video", AlbumArtist: "Artist X", Album: "Videos", RunTimeTicks: 2400000000&, DateCreated: "2024-03-01T00:00:00Z", PremiereDate: "2023-08-01T00:00:00Z", CommunityRating: 7.0, CriticRating: 60, UserData: { IsFavorite: true, PlayCount: 1, PlaybackPositionTicks: 12000000 } } }
    rows = [songB, songA, video]

    assertEqual(playlistSorted(rows, "playlistOrder", "ascending"), "Song B,Song A,Music Video", "Playlist order is the server's")
    assertEqual(playlistSorted(rows, "playlistOrder", "descending"), "Music Video,Song A,Song B", "And turns round")
    assertEqual(playlistSorted(rows, "name", "ascending"), "Song B,Music Video,Song A", "Name goes by the sort name first")
    assertEqual(playlistSorted(rows, "name", "descending"), "Song A,Music Video,Song B", "Descending is ascending turned round")
    assertEqual(playlistSorted(rows, "artist", "ascending"), "Music Video,Song B,Song A", "Artist reads the album artist, then the first artist")
    assertEqual(playlistSorted(rows, "album", "ascending"), "Song A,Song B,Music Video", "Album")
    assertEqual(playlistSorted(rows, "runtime", "ascending"), "Song B,Music Video,Song A", "Runtime compares an integer with longs")
    assertEqual(playlistSorted(rows, "dateAdded", "ascending"), "Song A,Song B,Music Video", "Date Added")
    assertEqual(playlistSorted(rows, "premiereDate", "descending"), "Music Video,Song B,Song A", "Release Date falls back to the year")
    assertEqual(playlistSorted(rows, "communityRating", "descending"), "Song A,Song B,Music Video", "Community Rating compares an integer with fractions")
    assertEqual(playlistSorted(rows, "criticRating", "descending"), "Song A,Song B,Music Video", "Critic Rating")
    assertEqual(playlistSorted(rows, "datePlayed", "ascending"), "Music Video,Song B,Song A", "Never played sorts first")
    assertEqual(playlistSorted(rows, "playCount", "descending"), "Song A,Song B,Music Video", "Play Count")

    alpha = { title: "Alpha", json: { Name: "Alpha", Album: "Album 2" } }
    assertEqual(playlistSorted([songB, alpha], "album", "ascending"), "Alpha,Song B", "A tie goes by name")
    assertEqual(playlistSorted([songB, alpha], "album", "descending"), "Song B,Alpha", "And turns round with the rest")

    assertEqual(playlistFiltered(rows, { playedFilter: "watched" }), "Song A", "Watched")
    assertEqual(playlistFiltered(rows, { playedFilter: "unwatched" }), "Song B", "Unwatched leaves out what is under way")
    assertEqual(playlistFiltered(rows, { playedFilter: "inProgress" }), "Music Video", "In Progress")
    assertEqual(playlistFiltered(rows, { favoriteOnly: true }), "Song B,Music Video", "Favorites")
    assertEqual(playlistFiltered(rows, { mediaTypeFilter: "Video" }), "Music Video", "Type")
    assertEqual(playlistFiltered(rows, { playedFilter: "watched", favoriteOnly: true }), "", "Filters add up")
    assertEqual(playlistSortFilter.MediaTypes(rows).join(","), "Audio,Video", "Types in the order they show up")

    seeded = { sortBy: "random", randomSeed: 7 }
    assertEqual(playlistFiltered(rows, seeded), playlistFiltered(rows, seeded), "A seed shuffles the same way each time")
    assertEqual(playlistSortFilter.Shuffled(rows, 123456789).count(), 3, "A shuffle keeps every row")

    state = playlistSortFilter.DefaultState()
    assertEqual(playlistSortFilter.IsDefault(state), true, "Nothing is in use at first")
    playlistSortFilter.PickSort(state, "name")
    assertEqual(state.sortDirection, "ascending", "A new sort starts ascending")
    playlistSortFilter.PickSort(state, "name")
    assertEqual(state.sortDirection, "descending", "Picking it again turns it round")
    choices = playlistSortFilter.SortChoices(state)
    assertEqual(choices[1].description, "Name (Descending)", "The picker names the direction in use")
    assertEqual(isValid(choices[0].selected), false, "And marks only that sort")
    buttons = playlistSortFilter.Buttons(state)
    assertEqual(buttons[0].label + "|" + buttons[0].detail, "Sort: Name|Descending", "The Sort button names the sort and its direction")
    assertEqual(buttons.count(), 3, "Reset shows once something is in use")
    playlistSortFilter.PickSort(state, "random")
    assertEqual(state.sortDirection + "|" + (state.randomSeed > 0).toStr(), "ascending|true", "Random gets a fresh seed")

    state = playlistSortFilter.DefaultState()
    assertEqual(playlistSortFilter.FilterMenu(state, ["Audio"]).count(), 2, "Type only shows for a playlist that mixes them")
    state.playedFilter = "watched"
    assertEqual(playlistSortFilter.FilterSummary(state), "Watched", "One filter names itself")
    state.favoriteOnly = true
    assertEqual(playlistSortFilter.FilterSummary(state), "2 active", "More than one is counted")
    assertEqual(playlistSortFilter.FilterMenu(state, ["Audio", "Video"]).count(), 4, "Clear Filters shows once one is on")
    playlistSortFilter.ClearFilters(state)
    assertEqual(playlistSortFilter.IsDefault(state), true, "Clear Filters turns them all off")
    assertEqual(playlistSortFilter.TypeChoices(state, ["Audio", "Video"])[0].selected, true, "All types is picked when none is")
end sub

function playlistTitles(rows as object) as string
    titles = []
    for each row in rows
        titles.push(row.title)
    end for
    return titles.join(",")
end function

function playlistSorted(rows as object, sortBy as string, sortDirection as string) as string
    state = playlistSortFilter.DefaultState()
    state.sortBy = sortBy
    state.sortDirection = sortDirection
    return playlistTitles(playlistSortFilter.SortAndFilter(rows, state))
end function

function playlistFiltered(rows as object, over as object) as string
    state = playlistSortFilter.DefaultState()
    state.append(over)
    return playlistTitles(playlistSortFilter.SortAndFilter(rows, state))
end function

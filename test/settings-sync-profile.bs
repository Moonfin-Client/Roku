sub testSettingsSyncProfile()
    assertEqual(settingsSync.NormalizeProfile(invalid), "tv", "No pick syncs with this device's own profile")
    assertEqual(settingsSync.NormalizeProfile(""), "tv", "An empty pick syncs with this device's own profile")
    assertEqual(settingsSync.NormalizeProfile("kitchen"), "tv", "A profile the server doesn't keep falls back to this device's own")
    assertEqual(settingsSync.NormalizeProfile(42), "tv", "A pick that isn't text falls back to this device's own profile")
    for each profileId in ["global", "desktop", "mobile", "tv"]
        assertEqual(settingsSync.NormalizeProfile(profileId), profileId, "The " + profileId + " profile is kept")
    end for
    assertEqual(settingsSync.NormalizeProfile(" Desktop "), "desktop", "A pick is read the way the server reads it")
    assertEqual(settingsSync.ProfileTitle("global"), "Global", "Each profile has a name to show")
    assertEqual(settingsSync.ProfileTitle("tv"), "TV", "This device's own profile has its name too")

    savedGlobal = m.global
    m.global = { session: { server: { url: "https://jellyfin.test", serverType: "jellyfin" }, user: { id: "sync-user" } } }
    m.registry["sync-user"] = {}

    assertEqual(settingsSync.ActiveProfile(), "tv", "A device that never picked syncs with its own profile")
    assertEqual(settingsSync.ProfilePush({}).url, "/Moonfin/Settings/Profile/tv", "Pushes go to this device's own profile until another is picked")
    assertEqual(settingsSync.ResolvedPath(settingsSync.ActiveProfile()), "/Moonfin/Settings/Resolved/tv", "Pulls read this device's own profile until another is picked")

    m.registry["sync-user"]["plugin.syncProfile"] = "mobile"
    assertEqual(settingsSync.ActiveProfile(), "mobile", "A picked profile is the one in use")
    push = settingsSync.ProfilePush({ navbarPosition: "left" })
    assertEqual(push.url, "/Moonfin/Settings/Profile/mobile", "Pushes go to the picked profile")
    assertEqual(settingsSync.ResolvedPath(settingsSync.ActiveProfile()), "/Moonfin/Settings/Resolved/mobile", "Pulls read the picked profile")
    sent = ParseJson(push.body)
    assertEqual(sent.clientId, "roku", "A push says which client sent it")
    assertEqual(sent.profile.navbarPosition, "left", "A push carries the settings inside the profile")

    m.registry["sync-user"]["plugin.syncProfile"] = "kitchen"
    assertEqual(settingsSync.ActiveProfile(), "tv", "A stored pick the server doesn't keep falls back to this device's own profile")
    m.registry["sync-user"]["plugin.syncProfile"] = ""
    assertEqual(settingsSync.ActiveProfile(), "tv", "An emptied pick falls back to this device's own profile")

    assertEqual(settingsSync.ResetPath("global"), "/Moonfin/Settings", "Resetting Global drops everything the server keeps for the user")
    assertEqual(settingsSync.ResetPath("desktop"), "/Moonfin/Settings/Profile/desktop", "Resetting a device profile drops only that profile")

    m.playbackRequests = []
    m.playbackResponses = [{ status: 200, data: invalid }, { status: 503, data: invalid }]
    assertEqual(settingsSync.DeleteProfile("global"), true, "The server took the reset")
    assertEqual(m.playbackRequests[0].request.url, "https://jellyfin.test/Moonfin/Settings", "Resetting Global asks for every profile to go")
    assertEqual(m.playbackRequests[0].request.method, "DELETE", "A reset is a delete")
    assertEqual(settingsSync.DeleteProfile("tv"), false, "A refused reset says so")
    assertEqual(m.playbackRequests[1].request.url, "https://jellyfin.test/Moonfin/Settings/Profile/tv", "Resetting a device profile names it")

    m.registry.Delete("sync-user")
    m.global = savedGlobal
end sub

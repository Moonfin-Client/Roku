sub testAfterHours()
    games = afterHours.Games()
    assertEqual(games.count(), 5, "The arcade has five games")
    assertEqual(games[0].id + "," + games[1].id + "," + games[2].id + "," + games[3].id + "," + games[4].id, "buffer-run,fast-forward,cable-crawl,case-stack,pixel-purge", "in the agreed order, with the ids the plugin knows")

    entries = 0
    for each game in games
        groups = afterHours.Cast(game.id)
        assertEqual(groups.count(), 3, game.name + " lists enemies, obstacles and powerups")
        for each group in groups
            entries += group.count()
        end for
        assertEqual(game.remote <> "", true, game.name + " says how the remote plays it")
    end for
    assertEqual(entries, 31, "How to play covers all 31 things in the five games")

    count = afterHours.Press(0, invalid, 1000)
    assertEqual(count, 1, "The first press counts one")
    count = afterHours.Press(count, 1000, 3500)
    assertEqual(count, 2, "A press within three seconds adds to the count")
    assertEqual(afterHours.Press(count, 3500, 7000), 1, "A pause of more than three seconds starts over")
    assertEqual(afterHours.Press(7, 7000, 7100), 1, "The press after the seventh starts over")

    assertEqual(afterHours.PressToast(2), "", "No toast before the third press")
    assertEqual(afterHours.PressToast(3), "4 more presses", "The third press counts down")
    assertEqual(afterHours.PressToast(6), "1 more press", "The sixth press says press")
    assertEqual(afterHours.PressToast(7), "After Hours unlocked", "The seventh press unlocks it")

    board = afterHours.ParseBoard([{ userName: "moviebuff", score: 18420 }, { UserName: "jamie", Score: 15960 }, { userName: "no score" }, "not a row", { userName: "nightowl", score: 12305.0 }, { userName: "fourth", score: 1 }])
    assertEqual(board.count(), 3, "A board keeps three rows and skips anything that isn't one")
    assertEqual(board[1].userName, "jamie", "Keys are read in any case")
    assertEqual(board[2].score, 12305, "Scores come back as whole numbers")
    assertEqual(afterHours.ParseBoard({}).count(), 0, "Anything but a list is an empty board")
    assertEqual(afterHours.ParseBoard(invalid).count(), 0, "No answer is an empty board")

    added = afterHours.AddRun([], "jamie", 400)
    assertEqual(added.rank, 1, "The first run on an empty board is first")
    added = afterHours.AddRun(added.board, "pat", 400)
    assertEqual(added.rank, 2, "A tie goes to the run that got there first")
    added = afterHours.AddRun(added.board, "jamie", 300)
    assertEqual(added.rank, 0, "A worse run than your best doesn't place")
    assertEqual(added.board[0].score, 400, "and keeps the best")
    added = afterHours.AddRun(added.board, "jamie", 500)
    assertEqual(added.rank, 1, "A new best takes its new place")
    assertEqual(added.board.count(), 2, "with one row per name")
    added = afterHours.AddRun(added.board, "sam", 10)
    added = afterHours.AddRun(added.board, "kim", 5)
    assertEqual(added.rank, 0, "A run below the top 3 misses the board")
    assertEqual(added.board.count(), 3, "which keeps three rows")
    assertEqual(added.board[2].userName, "sam", "and leaves the third place alone")

    assertEqual(afterHours.FormatScore(18420), "18,420", "Scores read with thousands separators")
    assertEqual(afterHours.FormatScore(9999999), "9,999,999", "up to the biggest the plugin takes")
    assertEqual(afterHours.FormatScore(412), "412", "and short ones stay short")
    assertEqual(afterHours.ClampScore(12000000), 9999999, "A score is capped where the plugin caps it")
    assertEqual(afterHours.ClampScore(-5), 0, "and never goes below zero")

    assertEqual(afterHours.IsLightColor("#E0B23A"), true, "A sci-fi gold spine takes dark text")
    assertEqual(afterHours.IsLightColor("#8A0F1A"), false, "A horror red spine takes white text")

    shelf = afterHours.Shelf([{ title: "Moana", genres: ["Animation", "Family"] }, { title: "" }, { title: "Alien", genres: ["Horror"] }], ["Spare"])
    assertEqual(shelf.count(), 2, "Case Stack takes the media bar's titles")
    assertEqual(shelf[0].title, "MOANA", "in capitals")
    assertEqual(shelf[1].color, "#8A0F1A", "colored like the gallery glow")
    assertEqual(afterHours.Shelf(invalid, ["Spare", "Bonus"]).count(), 2, "With no media bar titles it uses the fallback")
end sub

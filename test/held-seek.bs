' How far each step of a held Left or Right moves
sub testHeldSeek()
    steps = []
    for each count in [1, 3, 4, 8, 9, 16, 17, 40]
        steps.push(heldSeek.SecondsFor(10, count))
    end for
    assertEqual(FormatJson(steps), "[10,10,30,30,60,60,180,180]", "A hold grows from the set step to 30, 60 and 180 seconds")
    assertEqual(heldSeek.SecondsFor(60, 5), 60, "A hold never moves less than the set step")
    assertEqual(heldSeek.SecondsFor(60, 20), 180, "and still reaches 180 seconds")
end sub

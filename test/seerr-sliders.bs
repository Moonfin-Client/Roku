' The custom sliders a Seerr admin adds, as the Discover screen and Home read them
sub testSeerrSliders()
    slider = seerrSliders.Parse({ id: 3, type: 17, title: " Space ", data: " star wars ", enabled: true })
    assertEqual(slider.id, 3, "A slider keeps its id")
    assertEqual(slider.type, 17, "and its type")
    assertEqual(slider.title, "Space", "and its title without the spaces around it")
    assertEqual(slider.data, "star wars", "and what it searches for")
    assertEqual(seerrSliders.Parse({ id: "3", type: 17 }), invalid, "An id that isnt a number is skipped")
    assertEqual(seerrSliders.Parse({ id: 3, type: 17, enabled: false }).enabled, false, "A slider Seerr switched off says so")
    assertEqual(seerrSliders.Parse({ id: 3, type: 17 }).enabled, true, "A slider is on unless Seerr says otherwise")

    keywords = seerrSliders.Request({ type: 13, data: "9715,210024" })
    assertEqual(keywords.path, "discover/movies", "A movie keyword slider reads Discover's movies")
    assertEqual(keywords.params.keywords, "9715,210024", "with its keywords")
    assertEqual(seerrSliders.Request({ type: 17, data: "Ocean's (2001)!" }).params.query, "Ocean's (2001)!", "A search slider searches for its text")
    assertEqual(seerrSliders.Request({ type: 18, data: "41077" }).path, "discover/movies/studio/41077", "A studio slider reads that studio's movies")
    streaming = seerrSliders.Request({ type: 21, data: "US, 8|337" })
    assertEqual(streaming.path, "discover/tv", "A TV streaming slider reads Discover's shows")
    assertEqual(streaming.params.watchRegion, "US", "in its region")
    assertEqual(streaming.params.watchProviders, "8|337", "on its providers")
    assertEqual(seerrSliders.Request({ type: 1, data: "x" }), invalid, "Seerr's own rows are left to this app")
    assertEqual(seerrSliders.Request({ type: 20, data: "US" }), invalid, "A streaming slider missing its providers has nothing to read")
    assertEqual(seerrSliders.Request({ type: 14, data: "" }), invalid, "A slider without data has nothing to read")

    assertEqual(seerrSliders.IsSupported({ type: 14, data: "28", title: "Action", enabled: true }), true, "A slider that is on, titled and of a known type is offered")
    assertEqual(seerrSliders.IsSupported({ type: 14, data: "28", title: "", enabled: true }), false, "One without a title isnt")
    assertEqual(seerrSliders.IsSupported({ type: 14, data: "28", title: "Action", enabled: false }), false, "Nor one Seerr switched off")

    results = seerrSliders.Results({ results: [{ mediaType: "movie", id: 1 }, { mediaType: "person", id: 2 }, { media_type: "tv", id: 3 }] })
    assertEqual(results.Count(), 2, "Only movies and shows make cards")
    assertEqual(seerrSliders.TotalPages({ totalPages: 4 }), 4, "A slider pages as far as Seerr says")
    assertEqual(seerrSliders.TotalPages(invalid), 1, "and one page without an answer")

    savedGlobal = m.global
    m.global = { session: { server: { url: "http://server:8096/" } } }
    rowId = seerrSliders.RowId(1, 14)
    assertEqual(rowId, "pluginDynamic:seerr:http://server:8096:1:14", "A slider row is named the way the other clients name it")
    fromId = seerrSliders.FromRowId(rowId)
    assertEqual(fromId.server, "http://server:8096", "The row names its server")
    assertEqual(fromId.sliderId, "1", "its slider")
    assertEqual(fromId.sliderType, "14", "and the slider's type")
    assertEqual(seerrSliders.FromRowId("pluginDynamic:collections:http://server:8096:collection:abc"), invalid, "A picked collection isnt a slider row")

    gone = seerrSliders.RowId(2, 18)
    picks = [
        { id: rowId, title: "Old" },
        { id: gone, title: "Gone" },
        { id: "pluginDynamic:seerr:http://other:9:13", title: "Kept" },
        { id: "pluginDynamic:collections:http://server:8096:collection:abc", title: "Collection" }
    ]
    reconciled = seerrSliders.Reconciled(picks, [{ id: 1, type: 14, title: "New", enabled: true }, { id: 2, type: 19, title: "Replaced", enabled: true }])
    titles = []
    for each pick in reconciled.picks
        titles.push(pick.title)
    end for
    assertEqual(titles.Join(","), "New,Kept,Collection", "Rows take Seerr's titles, one it no longer has goes, and other servers are left alone")
    assertEqual(reconciled.gone.Join(","), gone, "A slider replaced by one of another type is gone")
    assertEqual(reconciled.changed, true, "and the change is saved")
    m.global = savedGlobal
end sub

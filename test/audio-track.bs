sub testAudioTrack()
    streams = [
        { Index: 1, Language: "jpn", RokuTrackName: "#uniq:Stereo(1)" },
        { Index: 2, Language: "eng", RokuTrackName: "#uniq:Stereo(2)" }
    ]
    tracks = [
        { Language: "jpn", Name: "#uniq:Stereo(1)", Track: "2" },
        { Language: "eng", Name: "#uniq:Stereo(2)", Track: "3" }
    ]
    assertEqual(rokuAudioTrack(streams[1], tracks, streams), "3", "The English stream is the Roku's track 3, not its Jellyfin index")
    assertEqual(rokuAudioTrack(streams[0], tracks, streams), "2", "The Japanese stream is track 2")

    unnamed = [{ Name: "", Track: "2" }, { Name: "", Track: "3" }]
    assertEqual(rokuAudioTrack(streams[1], unnamed, streams), "3", "Without matching names the place among the audio tracks decides")
    assertEqual(rokuAudioTrack(streams[1], [{ Name: "", Track: "2" }], streams), "", "A list that doesnt line up leaves the track alone")
    assertEqual(rokuAudioTrack(streams[1], [], streams), "", "No tracks yet leaves it alone")

    profiles = [
        { Container: "mp4,mov,m4v", Type: "Video", VideoCodec: "h264", AudioCodec: "aac" },
        { Container: "mkv,webm", Type: "Video", VideoCodec: "h264,hevc", AudioCodec: "aac,ac3,eac3,dts" },
        { Container: "ts", Type: "Video", VideoCodec: "h264", AudioCodec: "" },
        { Container: "mp3,flac", Type: "Audio" }
    ]
    assertEqual(audioPlaysDirect(profiles, "mkv", "dts"), true, "DTS in an MKV plays from the file when the profile lists it")
    assertEqual(audioPlaysDirect(profiles, "mkv", "TrueHD"), false, "TrueHD isnt in the profile, so the server has to transcode it")
    assertEqual(audioPlaysDirect(profiles, "mov,mp4,m4a,3gp,3g2,mj2", "ac3"), false, "AC3 in an MP4 the profile only takes AAC for goes to the server")
    assertEqual(audioPlaysDirect(profiles, "mov,mp4,m4a,3gp,3g2,mj2", "aac"), true, "A container named several ways still finds its profile")
    assertEqual(audioPlaysDirect(profiles, "ts", "mp2"), true, "A profile that names no audio codec takes any")
    assertEqual(audioPlaysDirect([], "mkv", "aac"), false, "No profiles, as when transcoding is forced, plays nothing direct")
    assertEqual(audioPlaysDirect(profiles, "", "aac"), false, "An unknown container plays nothing direct")
end sub

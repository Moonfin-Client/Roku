' How a Seerr request's download adds up
sub testSeerrRequests()
    pack = { downloadId: "S06", size: 19.0, sizeLeft: 5.0 }
    heldBack = { size: 23.0, sizeLeft: 23.0 }
    request = { status: 2, is4k: false, media: { status: 3, downloadStatus: [heldBack, pack, pack, heldBack, { downloadId: "", size: 19.0, sizeLeft: 5.0 }, { downloadId: 0, size: 4.0, sizeLeft: 4.0 }] } }
    summary = SeerrRequestDownloadSummary(request)
    assertEqual(summary.total, 19.0, "A season pack counts once and the releases held back are left out")
    assertEqual(summary.done, 14.0, "so the done part is the pack's alone")
    request.media.downloadStatus = [heldBack, heldBack]
    assertEqual(SeerrRequestDownloadSummary(request), invalid, "Only held back releases is no download")
end sub

sub testMediaBarNewRelease()
    nowDate = CreateObject("roDateTime")
    nowDate.FromISO8601String("2026-11-02T12:00:00Z")
    now = nowDate.AsSeconds()
    day = "2026-10-28"

    assertEqual(newReleaseKind(sameDayEpisodes(3, 8, day), now), "newSeason", "A season out all on one day is a new season")
    assertEqual(newReleaseKind(sameDayEpisodes(1, 6, day), now), "newSeries", "A first season out all at once is a new series")

    weekly = []
    for each aired in ["2026-09-01", "2026-09-08", "2026-09-15", "2026-09-22", "2026-09-29", "2026-10-06"]
        weekly.push(newReleaseEpisode(2, aired, false, invalid))
    end for
    weekly.append(sameDayEpisodes(2, 3, day))
    assertEqual(newReleaseKind(weekly, now), "newEpisodes", "A weekly season ending on three episodes in one day has new episodes")

    split = sameDayEpisodes(4, 4, "2026-07-01")
    split.append(sameDayEpisodes(4, 4, day))
    assertEqual(newReleaseKind(split, now), "newEpisodes", "A split season's second part has new episodes")

    assertEqual(newReleaseKind([newReleaseEpisode(2, "2026-10-19", false, invalid), newReleaseEpisode(2, "2026-10-26", false, invalid), newReleaseEpisode(2, "2026-11-02", false, invalid)], now), "newEpisodes", "A season aired week by week has new episodes")
    assertEqual(newReleaseKind([newReleaseEpisode(2, "2026-11-02", false, invalid)], now), "newEpisodes", "One new episode is new episodes")
    assertEqual(newReleaseKind(sameDayEpisodes(4, 2, day), now), "newEpisodes", "A two episode premiere is not a whole season")

    padded = sameDayEpisodes(3, 5, day)
    padded.push(newReleaseEpisode(3, "2026-12-01", true, invalid))
    assertEqual(newReleaseKind(padded, now), "newSeason", "Episodes not on the server do not count against a drop")

    assertEqual(newReleaseKind(sameDayEpisodes(1, 10, "2005-06-01"), now), "", "An old show added today has nothing new")

    unaired = []
    for i = 1 to 8
        unaired.push(newReleaseEpisode(5, "2026-10-30", true, invalid))
    end for
    unaired.push(newReleaseEpisode(5, "2026-12-01", false, invalid))
    assertEqual(newReleaseKind(unaired, now), "", "Episodes known only from metadata or not aired yet do not count")

    drop = newReleaseInfo(sameDayEpisodes(3, 8, day), now)
    assertEqual(drop.season, 3, "A season out at once names the season")
    assertEqual(mediaBarNewRelease.Detail(drop), "Season 3", "Its detail line is the season")

    latest = newReleaseInfo([newReleaseEpisode(2, "2026-10-23", false, 4), newReleaseEpisode(2, "2026-10-30", false, 5)], now)
    assertEqual(latest.season.toStr() + ":" + latest.episode.toStr(), "2:5", "New episodes name the latest one")
    assertEqual(mediaBarNewRelease.Detail(latest), "S2:E5", "Its detail line is the season and episode")
    assertEqual(mediaBarNewRelease.Label(latest), "New Episodes", "Its label says new episodes")
end sub

function newReleaseEpisode(season as integer, aired as string, virtual as boolean, number as dynamic) as object
    ' Jellyfin writes seven fractional digits
    episode = { ParentIndexNumber: season, SeasonId: "season-" + season.toStr(), PremiereDate: aired + "T00:00:00.0000000Z", LocationType: "FileSystem" }
    if virtual then episode.LocationType = "Virtual"
    if isValid(number) then episode.IndexNumber = number
    return episode
end function

function sameDayEpisodes(season as integer, count as integer, aired as string) as object
    episodes = []
    for i = 1 to count
        episodes.push(newReleaseEpisode(season, aired, false, invalid))
    end for
    return episodes
end function

' The two steps the media bar runs: the recent episodes first, then the whole season when the
' first step asks for it
function newReleaseInfo(season as object, now as integer) as dynamic
    recent = mediaBarNewRelease.RecentlyAired(season, now, 30)
    latestSeason = invalid
    if mediaBarNewRelease.SeasonToCheck(recent) <> "" then latestSeason = season
    return mediaBarNewRelease.ReleaseOf(recent, latestSeason)
end function

function newReleaseKind(season as object, now as integer) as string
    info = newReleaseInfo(season, now)
    if info = invalid then return ""
    return info.kind
end function

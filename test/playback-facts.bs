' Each row as "Section | Label | Value", bold values marked with a star and notes as "Section | note | text"
function playbackFactsLines(sections as object) as string
    lines = []
    for each section in sections
        for each row in section.rows
            if isValid(row.note)
                lines.push(section.title + " | note | " + row.note)
            else
                star = ""
                if row.bold then star = " *"
                lines.push(section.title + " | " + row.label + " | " + row.value + star)
            end if
        end for
    end for
    return lines.Join(Chr(10))
end function

function playbackFactsFilm() as object
    return {
        Container: "mkv",
        Size: 62491541504&,
        Bitrate: 68400000,
        Path: "/media/films/Dune (2021)/Dune.mkv",
        Name: "Dune",
        DefaultAudioStreamIndex: 1,
        MediaStreams: [
            { Type: "Video", Index: 0, Codec: "hevc", Profile: "Main 10", Width: 3840, Height: 2160, RealFrameRate: 23.976025, AverageFrameRate: 23.976025, VideoRange: "HDR", VideoRangeType: "HDR10" },
            { Type: "Audio", Index: 1, Codec: "truehd", Profile: "Dolby TrueHD + Dolby Atmos", Channels: 8, Language: "eng", IsDefault: true, Title: "TrueHD Atmos 7.1" },
            { Type: "Audio", Index: 2, Codec: "ac3", Channels: 6, Language: "fre", IsDefault: false },
            { Type: "Subtitle", Index: 3, Codec: "PGSSUB", Language: "eng", IsForced: false, IsHearingImpaired: true, IsExternal: false },
            { Type: "Subtitle", Index: 4, Codec: "subrip", Language: "fre", IsForced: true, IsExternal: true }
        ]
    }
end function

function playbackFactsInput(overrides as object) as object
    facts = {
        source: playbackFactsFilm(),
        transcoding: invalid,
        url: "https://jellyfin.test/Videos/abc/stream?Static=true&MediaSourceId=abc",
        isTranscoded: false,
        forced: false,
        audioIndex: 1,
        subtitleIndex: -1,
        subtitleBurnedIn: false,
        live: false,
        channel: invalid,
        program: "",
        qualityLimit: 0,
        languages: playbackFacts.LanguageNames([
            { Name: "English", DisplayName: "English", TwoLetterISOLanguageName: "en", ThreeLetterISOLanguageName: "eng", ThreeLetterISOLanguageNames: ["eng"] },
            { Name: "French", DisplayName: "French", TwoLetterISOLanguageName: "fr", ThreeLetterISOLanguageName: "fra", ThreeLetterISOLanguageNames: ["fre", "fra"] }
        ]),
        player: "Roku native player",
        device: "Roku Streaming Stick 4K, Roku OS 15.3.4"
    }
    facts.Append(overrides)
    return facts
end function

sub testPlaybackFacts()
    assertEqual(playbackFacts.BitrateText(20200000), "20.2 Mbps", "Bitrates read in Mbps to one place")
    assertEqual(playbackFacts.BitrateText(20000000), "20.0 Mbps", "A whole Mbps keeps its one place")
    assertEqual(playbackFacts.QualityLimitText(20000000), "20 Mbps", "The quality limit reads in whole Mbps")
    assertEqual(playbackFacts.BitrateText(640000), "640 Kbps", "Below a megabit reads in Kbps")
    assertEqual(playbackFacts.BitrateText(0), "", "No bitrate is no row")
    assertEqual(playbackFacts.FrameRateText({ RealFrameRate: 23.976025, AverageFrameRate: 24 }), "23.976 fps", "The real frame rate leads, to three places")
    assertEqual(playbackFacts.FrameRateText({ AverageFrameRate: 29.97003 }), "29.97 fps", "Trailing zeros go")
    assertEqual(playbackFacts.FrameRateText({ RealFrameRate: 24 }), "24 fps", "A whole frame rate has no point")
    assertEqual(playbackFacts.ResolutionName(3840, 1600), "4K", "A scope 4K file is still 4K")
    assertEqual(playbackFacts.ResolutionName(1920, 800), "1080p", "A scope 1080p file is still 1080p")
    assertEqual(playbackFacts.ResolutionName(1280, 720), "720p", "720p")
    assertEqual(playbackFacts.ResolutionName(720, 480), "SD", "Anything smaller is SD")
    assertEqual(playbackFacts.VideoCodecName("h265"), "HEVC", "h265 reads as HEVC")
    assertEqual(playbackFacts.VideoCodecName("avc"), "H.264", "avc reads as H.264")
    assertEqual(playbackFacts.VideoCodecName("mpeg2video"), "MPEG-2", "MPEG-2")
    assertEqual(playbackFacts.VideoCodecName("prores"), "PRORES", "An unknown codec is upper cased")
    assertEqual(playbackFacts.AudioCodecName("eac3", "Dolby Digital Plus + Dolby Atmos"), "Dolby Digital Plus with Atmos", "Atmos rides on Dolby Digital Plus")
    assertEqual(playbackFacts.AudioCodecName("ac3", ""), "Dolby Digital", "Dolby Digital")
    assertEqual(playbackFacts.AudioCodecName("dts", "DTS-HD MA + DTS:X"), "DTS:X", "DTS:X wins over its core")
    assertEqual(playbackFacts.AudioCodecName("dts", "DTS-HD MA"), "DTS-HD Master Audio", "DTS-HD MA")
    assertEqual(playbackFacts.AudioCodecName("dts", "DTS-HD HRA"), "DTS-HD High Resolution", "DTS-HD HRA")
    assertEqual(playbackFacts.AudioCodecName("dts", "DTS"), "DTS", "Plain DTS")
    assertEqual(playbackFacts.AudioCodecName("dca", "DTS-HD MA"), "DTS-HD Master Audio", "dca is DTS too")
    assertEqual(playbackFacts.AudioCodecName("DCA", ""), "DTS", "dca alone is plain DTS")
    assertEqual(playbackFacts.AudioCodecName("pcm_s24le", ""), "PCM", "Any PCM")
    assertEqual(playbackFacts.AudioCodecName("opus", ""), "Opus", "Opus")
    assertEqual(playbackFacts.AudioCodecName("wmapro", ""), "WMAPRO", "An unknown audio codec is upper cased")
    assertEqual(playbackFacts.ChannelsText(1), "Mono", "Mono")
    assertEqual(playbackFacts.ChannelsText(6), "5.1 surround", "5.1")
    assertEqual(playbackFacts.ChannelsText(3), "3 channels", "Any other count is counted")
    assertEqual(playbackFacts.RangeText({ VideoRangeType: "DOVIWithHDR10", DvProfile: 8 }), "Dolby Vision Profile 8", "Every Dolby Vision type reads as Dolby Vision with its profile")
    assertEqual(playbackFacts.RangeText({ VideoRangeType: "DOVI" }), "Dolby Vision", "Dolby Vision without a known profile")
    assertEqual(playbackFacts.RangeText({ VideoRangeType: "HDR10Plus" }), "HDR10+", "HDR10+")
    assertEqual(playbackFacts.RangeText({ VideoRangeType: "Unknown", VideoRange: "SDR" }), "SDR", "An unknown type falls back to the range")
    assertEqual(playbackFacts.RangeText({ ExtendedVideoType: "HyperLogGamma", VideoRange: "HDR" }), "HLG", "Emby's extended type names HLG")
    assertEqual(playbackFacts.RangeText({ ExtendedVideoType: "None", VideoRange: "HDR 10" }), "HDR10", "Emby's spaced range name")
    assertEqual(playbackFacts.RangeText({ VideoRange: "HDR" }), "HDR", "Some other HDR")
    assertEqual(playbackFacts.SubtitleFormatText("PGSSUB"), "PGS (image)", "PGS")
    assertEqual(playbackFacts.SubtitleFormatText("mov_text"), "MP4 text", "MP4 text")
    assertEqual(playbackFacts.SubtitleFormatText("hdmv_text"), "HDMV_TEXT", "An unknown subtitle format is upper cased")
    assertEqual(playbackFacts.ContainerText({ Path: "/films/Liar Liar (1997).mp4", Container: "mov" }), "MP4", "The file's extension names the container")
    assertEqual(playbackFacts.ContainerText({ Path: "D:\Films\Clip.m4v", Container: "mov,mp4,m4a" }), "M4V", "A Windows path's extension")
    assertEqual(playbackFacts.ContainerText({ Path: "/films/Dune.MKV" }), "MKV", "An extension in any case needs no container beside it")
    assertEqual(playbackFacts.ContainerText({ Path: "/films/Avatar.2009.BluRay", Container: "mkv" }), "MKV", "A dotted folder name isn't an extension")
    assertEqual(playbackFacts.ContainerText({ Path: "/films/Dune.2021", Container: "mkv" }), "MKV", "Nor is a year")
    assertEqual(playbackFacts.ContainerText({ Path: "http://tuner.test/auto/v5", Container: "mov,mp4,m4a,3gp,3g2,mj2" }), "MP4", "Without an extension the mp4 family reads as MP4")
    assertEqual(playbackFacts.ContainerText({ Container: "mpegts" }), "MPEGTS", "Any other container is its first name upper cased")
    assertEqual(playbackFacts.ContainerText({}), "", "No container is no row")
    assertEqual(playbackFacts.SizeText(62491541504&), "58.2 GB", "A gigabyte or more reads in GB to one place")
    assertEqual(playbackFacts.SizeText(769654784), "734 MB", "Less reads in whole MB")
    assertEqual(playbackFacts.FileNameText({ Path: "D:\Films\Dune (2021)\Dune.mkv", Name: "Dune" }), "Dune.mkv", "A Windows path's file name")
    assertEqual(playbackFacts.FileNameText({ Name: "Dune" }), "Dune", "Without a path the source's name")
    assertEqual(playbackFacts.VideoFormatText({ Codec: "h264", Profile: "0" }, { video: false, videoCodec: "" }), "H.264", "A profile of 0 is no profile")
    assertEqual(playbackFacts.VideoFormatText({ Codec: "h264", Profile: 0 }, { video: false, videoCodec: "" }), "H.264", "Whether it's written as text or a number")
    assertEqual(playbackFacts.BitrateRowText({ kind: "transcode" }, { Bitrate: 68400000 }, { Bitrate: 80000000 }, ""), "80.0 Mbps (original 68.4 Mbps)", "A delivered bitrate above the file's still shows the original")
    assertEqual(playbackFacts.BitrateRowText({ kind: "transcode" }, { Bitrate: 68400000 }, { Bitrate: 68420000 }, ""), "68.4 Mbps", "Bitrates that read the same show once")

    url = "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=hevc%2Ch264&transcodeReasons=ContainerBitrateExceedsLimit%2CAudioCodecNotSupported%2CaudioCodecNotSupported&api_key=x"
    assertEqual(playbackFacts.QueryValue(url, "TranscodeReasons"), "ContainerBitrateExceedsLimit,AudioCodecNotSupported,audioCodecNotSupported", "Parameters match whatever their case and decode their commas")
    assertEqual(playbackFacts.ServerReasons(playbackFacts.QueryValue(url, "TranscodeReasons")).Join(","), "ContainerBitrateExceedsLimit,AudioCodecNotSupported", "The address's reasons once each, in the server's order")
    assertEqual(playbackFacts.ServerReasons(["AudioCodecNotSupported", "SubtitleCodecNotSupported"]).Join(","), "AudioCodecNotSupported,SubtitleCodecNotSupported", "The session's array")
    assertEqual(playbackFacts.ServerReasons("VideoCodecNotSupported, AudioCodecNotSupported").Join(","), "VideoCodecNotSupported,AudioCodecNotSupported", "An older server's comma string")
    assertEqual(playbackFacts.ServerReasons(invalid).count(), 0, "No reasons")

    testPlaybackWhyLines()

    names = playbackFactsInput({}).languages
    assertEqual(playbackFacts.TrackText({ Language: "fr" }, names, []), "French", "Two letter codes find the language")
    assertEqual(playbackFacts.TrackText({ Language: "und", Title: "Commentary" }, names, ["Forced"]), "Commentary, Forced", "An unknown language falls back to the title")

    directPlay = "Playback | Play Method | Direct Play *" + Chr(10)
    directPlay += "Playback | note | Playing the original file as is." + Chr(10)
    directPlay += "Playback | Bitrate | 68.4 Mbps" + Chr(10)
    directPlay += "Video | Resolution | 4K (3840×2160)" + Chr(10)
    directPlay += "Video | Frame Rate | 23.976 fps" + Chr(10)
    directPlay += "Video | Format | HEVC Main 10" + Chr(10)
    directPlay += "Video | HDR | HDR10" + Chr(10)
    directPlay += "Audio | Track | English, Default" + Chr(10)
    directPlay += "Audio | Format | Dolby TrueHD with Atmos" + Chr(10)
    directPlay += "Audio | Channels | 7.1 surround" + Chr(10)
    directPlay += "File | Name | Dune.mkv" + Chr(10)
    directPlay += "File | Container | MKV" + Chr(10)
    directPlay += "File | Size | 58.2 GB" + Chr(10)
    directPlay += "Technical | Player | Roku native player" + Chr(10)
    directPlay += "Technical | Device | Roku Streaming Stick 4K, Roku OS 15.3.4"
    ' A TranscodingInfo left on the session can't make a direct play read as a transcode
    stale = { IsVideoDirect: false, IsAudioDirect: false, VideoCodec: "h264", TranscodeReasons: ["ContainerBitrateExceedsLimit"] }
    assertEqual(playbackFactsLines(playbackFacts.Build(playbackFactsInput({ transcoding: stale }))), directPlay, "A 4K HEVC HDR10 TrueHD Atmos direct play")

    jellyfinUrl = "https://jellyfin.test/videos/abc/master.m3u8?DeviceId=d&MediaSourceId=abc&VideoCodec=hevc,h264&AudioCodec=aac,mp3&AudioStreamIndex=1&VideoBitrate=19808000&AudioBitrate=192000&TranscodeReasons=ContainerBitrateExceedsLimit,AudioCodecNotSupported"
    jellyfinInfo = { VideoCodec: "h264", AudioCodec: "aac", IsVideoDirect: false, IsAudioDirect: false, Bitrate: 20200000, Width: 1920, Height: 1080, AudioChannels: 2, TranscodeReasons: ["ContainerBitrateExceedsLimit", "AudioCodecNotSupported"] }
    transcode = "Playback | Play Method | Transcoding *" + Chr(10)
    transcode += "Playback | note | The server is converting the video and audio so this device can play it." + Chr(10)
    transcode += "Playback | Why | 68.4 Mbps is above the 20 Mbps streaming limit" + Chr(10) + "This device can't play Dolby TrueHD audio" + Chr(10)
    transcode += "Playback | Bitrate | 20.2 Mbps (original 68.4 Mbps)" + Chr(10)
    transcode += "Playback | Quality Limit | 20 Mbps" + Chr(10)
    transcode += "Video | Resolution | 1080p (1920×1080, converted from 4K)" + Chr(10)
    transcode += "Video | Frame Rate | 23.976 fps" + Chr(10)
    transcode += "Video | Format | H.264 (converted from HEVC)" + Chr(10)
    transcode += "Video | HDR | HDR10" + Chr(10)
    transcode += "Audio | Track | English, Default" + Chr(10)
    transcode += "Audio | Format | AAC (converted from Dolby TrueHD)" + Chr(10)
    transcode += "Audio | Channels | Stereo (converted from 7.1)" + Chr(10)
    transcode += "File | Name | Dune.mkv" + Chr(10)
    transcode += "File | Container | MKV" + Chr(10)
    transcode += "File | Size | 58.2 GB" + Chr(10)
    transcode += "Technical | Player | Roku native player" + Chr(10)
    transcode += "Technical | Device | Roku Streaming Stick 4K, Roku OS 15.3.4" + Chr(10)
    transcode += "Technical | Transcode Reasons | ContainerBitrateExceedsLimit, AudioCodecNotSupported"
    assertEqual(playbackFactsLines(playbackFacts.Build(playbackFactsInput({ url: jellyfinUrl, isTranscoded: true, transcoding: jellyfinInfo, qualityLimit: 20000000 }))), transcode, "A Jellyfin transcode for its bitrate and audio")

    ' Emby leaves the reasons to the session here, and copies the video while it converts the audio
    embySource = {
        Container: "mkv",
        Bitrate: 12000000,
        Path: "\\nas\films\Robots (2005).mkv",
        MediaStreams: [
            { Type: "Video", Index: 0, Codec: "h264", Profile: "High", Width: 1920, Height: 1040, AverageFrameRate: 23.976, ExtendedVideoType: "None", VideoRange: "SDR" },
            { Type: "Audio", Index: 1, Codec: "dts", Profile: "DTS-HD MA", Channels: 6, Language: "eng", IsDefault: true }
        ]
    }
    embyInfo = { VideoCodec: "h264", AudioCodec: "aac", IsVideoDirect: true, IsAudioDirect: false, Bitrate: 9000000, Width: 1920, Height: 1040, AudioChannels: 2, TranscodeReasons: ["AudioCodecNotSupported"] }
    emby = playbackFactsLines(playbackFacts.Build(playbackFactsInput({ source: embySource, url: "https://emby.test/emby/videos/7/master.m3u8?VideoCodec=h264&AudioCodec=aac", isTranscoded: true, transcoding: embyInfo })))
    embyExpected = "Playback | Play Method | Transcoding *" + Chr(10)
    embyExpected += "Playback | note | The server is converting the audio so this device can play it." + Chr(10)
    embyExpected += "Playback | Why | This device can't play DTS audio" + Chr(10)
    embyExpected += "Playback | Bitrate | 9.0 Mbps (original 12.0 Mbps)" + Chr(10)
    embyExpected += "Video | Resolution | 1080p (1920×1040)" + Chr(10)
    embyExpected += "Video | Frame Rate | 23.976 fps" + Chr(10)
    embyExpected += "Video | Format | H.264 High" + Chr(10)
    embyExpected += "Video | HDR | SDR" + Chr(10)
    embyExpected += "Audio | Track | English, Default" + Chr(10)
    embyExpected += "Audio | Format | AAC (converted from DTS)" + Chr(10)
    embyExpected += "Audio | Channels | Stereo (converted from 5.1)" + Chr(10)
    embyExpected += "File | Name | Robots (2005).mkv" + Chr(10)
    embyExpected += "File | Container | MKV" + Chr(10)
    embyExpected += "Technical | Player | Roku native player" + Chr(10)
    embyExpected += "Technical | Device | Roku Streaming Stick 4K, Roku OS 15.3.4" + Chr(10)
    embyExpected += "Technical | Transcode Reasons | AudioCodecNotSupported"
    assertEqual(emby, embyExpected, "An Emby transcode of the audio only, its reasons from the session")

    remux = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?TranscodeReasons=ContainerNotSupported", isTranscoded: true, transcoding: { VideoCodec: "hevc", AudioCodec: "truehd", IsVideoDirect: true, IsAudioDirect: true, Bitrate: 68000000 } }))
    assertEqual(remux[0].rows[0].value, "Direct Stream", "Both tracks copied is Direct Stream")
    assertEqual(remux[0].rows[1].note, "The server is repackaging the file without converting it.", "Direct Stream's note")
    assertEqual(remux[0].rows[2].value, "This device can't open MKV files", "A remux names the container")
    assertEqual(remux[0].rows[3].value, "68.0 Mbps (original 68.4 Mbps)", "Direct Stream shows what arrives beside the original")

    forced = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8", isTranscoded: true, forced: true }))
    assertEqual(forced[0].rows[1].note, "The server is converting this file so this device can play it.", "A transcode nothing describes still says so")
    assertEqual(forced[0].rows[2].value, "Transcoding is forced in settings", "A forced transcode says it was forced")

    burned = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=hevc,h264&AudioCodec=truehd,aac", isTranscoded: true, subtitleIndex: 3, subtitleBurnedIn: true }))
    assertEqual(playbackFactsLines([burned[3]]), "Subtitles | Track | English, SDH" + Chr(10) + "Subtitles | Format | PGS (image)" + Chr(10) + "Subtitles | Delivery | Burned in by the server", "Burned in subtitles")
    assertEqual(burned[0].rows[1].note, "The server is converting the video so this device can play it.", "Burning subtitles in encodes the video again")
    external = playbackFacts.Build(playbackFactsInput({ subtitleIndex: 4 }))
    assertEqual(playbackFactsLines([external[3]]), "Subtitles | Track | French, Forced" + Chr(10) + "Subtitles | Format | SRT (text)" + Chr(10) + "Subtitles | Delivery | External", "An external subtitle")
    sidecar = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?SubtitleMethod=Encode&TranscodeReasons=AudioCodecNotSupported", isTranscoded: true, subtitleIndex: 4 }))
    assertEqual(sidecar[3].rows[2].value, "External", "Jellyfin's SubtitleMethod=Encode on every transcode address doesn't mean the subtitle is drawn in")
    named = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?SubtitleStreamIndex=3&SubtitleMethod=Encode", isTranscoded: true, subtitleIndex: 3 }))
    assertEqual(named[3].rows[2].value, "Burned in by the server", "An address encoding the chosen subtitle burns it in")
    other = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?SubtitleStreamIndex=4&SubtitleMethod=Encode", isTranscoded: true, subtitleIndex: 3 }))
    assertEqual(other[3].rows[2].value, "Embedded", "An address encoding another subtitle doesn't")
    delivered = playbackFactsFilm()
    delivered.MediaStreams[3].DeliveryMethod = "Encode"
    encoded = playbackFacts.Build(playbackFactsInput({ source: delivered, url: "https://jellyfin.test/videos/abc/master.m3u8", isTranscoded: true, subtitleIndex: 3 }))
    assertEqual(encoded[3].rows[2].value, "Burned in by the server", "A subtitle the server delivers by encoding is burned in")
    reasoned = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?TranscodeReasons=SubtitleCodecNotSupported", isTranscoded: true, subtitleIndex: 3 }))
    assertEqual(reasoned[3].rows[2].value, "Embedded", "The reason alone doesn't say the chosen subtitle is the one burned in")
    assertEqual(reasoned[0].rows[2].value, "PGS subtitles are being burned into the video", "but its Why line still shows")

    ' Without TranscodingInfo the address only lists the profile's codecs, so a listed source codec was copied
    copyUrl = "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=h264,hevc&AudioCodec=aac,ac3&VideoBitrate=139616000&AudioBitrate=640000&TranscodingMaxAudioChannels=6&TranscodeReasons=VideoCodecNotSupported,AudioCodecNotSupported"
    copied = playbackFacts.Build(playbackFactsInput({ url: copyUrl, isTranscoded: true }))
    copiedExpected = "Playback | Play Method | Transcoding *" + Chr(10)
    copiedExpected += "Playback | note | The server is converting the audio so this device can play it." + Chr(10)
    copiedExpected += "Playback | Why | This device can't play HEVC video" + Chr(10) + "This device can't play Dolby TrueHD audio" + Chr(10)
    copiedExpected += "Playback | Bitrate | 68.4 Mbps" + Chr(10)
    copiedExpected += "Video | Resolution | 4K (3840×2160)" + Chr(10)
    copiedExpected += "Video | Frame Rate | 23.976 fps" + Chr(10)
    copiedExpected += "Video | Format | HEVC Main 10" + Chr(10)
    copiedExpected += "Video | HDR | HDR10" + Chr(10)
    copiedExpected += "Audio | Track | English, Default" + Chr(10)
    copiedExpected += "Audio | Format | AAC (converted from Dolby TrueHD)" + Chr(10)
    copiedExpected += "Audio | Channels | 5.1 surround (converted from 7.1)"
    assertEqual(playbackFactsLines([copied[0], copied[1], copied[2]]), copiedExpected, "A codec reason doesn't prove a listed codec was converted, an unlisted one was")

    capped = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=hevc,h264&AudioCodec=truehd,aac&VideoBitrate=20000000&AudioBitrate=640000&TranscodeReasons=ContainerBitrateExceedsLimit", isTranscoded: true }))
    assertEqual(capped[0].rows[1].note, "The server is converting the video so this device can play it.", "A file over the address's video bitrate is encoded again")
    assertEqual(capped[0].rows[2].value, "68.4 Mbps is above the 20 Mbps streaming limit", "The address's target stands in for the limit, rounded down")
    assertEqual(capped[0].rows[3].value, "20.6 Mbps (original 68.4 Mbps)", "The address's rates stand in for the delivered bitrate")
    assertEqual(capped[1].rows[2].value, "HEVC Main 10", "A codec the address lists stays named as the source")
    ranged = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=hevc,h264&AudioCodec=truehd,aac&TranscodeReasons=VideoRangeTypeNotSupported", isTranscoded: true }))
    assertEqual(ranged[0].rows[1].note, "The server is converting the video so this device can play it.", "A range reason means the video is encoded again")
    remuxed = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=hevc,h264&AudioCodec=truehd,aac&TranscodeReasons=ContainerNotSupported", isTranscoded: true }))
    assertEqual(remuxed[0].rows[0].value, "Direct Stream", "Both source codecs listed and nothing else changing reads as Direct Stream")
    ' The session's word wins over the address, which still lists h264 first for a copied HEVC video
    trusted = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=h264,hevc&AudioCodec=aac&VideoBitrate=1000000", isTranscoded: true, transcoding: { IsVideoDirect: true, IsAudioDirect: false, VideoCodec: "hevc", AudioCodec: "aac", AudioChannels: 6 } }))
    assertEqual(trusted[0].rows[1].note, "The server is converting the audio so this device can play it.", "TranscodingInfo decides what was converted")
    assertEqual(trusted[1].rows[2].value, "HEVC Main 10", "A copied video keeps its own format")
    assertEqual(trusted[2].rows[2].value, "5.1 surround (converted from 7.1)", "TranscodingInfo gives the delivered channels")
    leftover = { IsVideoDirect: false, IsAudioDirect: false, VideoCodec: "h264", AudioCodec: "mp3", Width: 1920, Height: 804, TranscodeReasons: ["AudioCodecNotSupported", "VideoRangeTypeNotSupported"] }
    moved = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?VideoCodec=h264,hevc&AudioCodec=mp3&TranscodeReasons=AudioCodecNotSupported", isTranscoded: true, transcoding: leftover }))
    assertEqual(moved[0].rows[1].note, "The server is converting the audio so this device can play it.", "A session whose reasons differ from the address's belongs to another transcode")
    assertEqual(moved[1].rows[0].value, "4K (3840×2160)", "so its size isn't shown as this one's")
    agreeing = { IsVideoDirect: false, IsAudioDirect: false, VideoCodec: "h264", AudioCodec: "mp3", TranscodeReasons: ["containerbitrateexceedslimit", "audiocodecnotsupported"] }
    agreed = playbackFacts.Build(playbackFactsInput({ url: "https://jellyfin.test/videos/abc/master.m3u8?TranscodeReasons=AudioCodecNotSupported,ContainerBitrateExceedsLimit", isTranscoded: true, transcoding: agreeing }))
    assertEqual(agreed[0].rows[1].note, "The server is converting the video and audio so this device can play it.", "The same reasons in any order and case keep the session")
    assertEqual(agreed[agreed.count() - 1].rows[2].value, "AudioCodecNotSupported, ContainerBitrateExceedsLimit", "and the address's reasons lead")
    assertEqual(playbackFacts.SameReasons([], ["AudioCodecNotSupported"]), true, "An address without reasons keeps the session")
    assertEqual(playbackFacts.SameReasons(["AudioCodecNotSupported"], []), true, "A session without reasons is kept")
    assertEqual(playbackFacts.SameReasons(["AudioCodecNotSupported"], ["AudioCodecNotSupported", "ContainerNotSupported"]), false, "An extra reason means another transcode")
    unseen = playbackFacts.Build(playbackFactsInput({ source: { MediaStreams: [] }, url: "https://jellyfin.test/videos/abc/master.m3u8", isTranscoded: true, transcoding: { IsVideoDirect: false, IsAudioDirect: false } }))
    assertEqual(unseen[0].rows[1].note, "The server is converting the video and audio so this device can play it.", "TranscodingInfo decides even when the tracks aren't known")

    liveSource = { Path: "http://tuner.test/auto/v5", Name: "LEGO", MediaStreams: [{ Type: "Video", Index: 0, Codec: "mpeg2video", Width: 1920, Height: 1080, RealFrameRate: 29.97003, VideoRange: "SDR" }, { Type: "Audio", Index: 1, Codec: "ac3", Channels: 2 }] }
    live = playbackFacts.Build(playbackFactsInput({ source: liveSource, live: true, channel: { number: "5", name: "LEGO" }, program: "Ninjago" }))
    assertEqual(live[0].rows[0].label + ": " + live[0].rows[0].value, "Channel: 5 LEGO", "Live TV names the channel first")
    assertEqual(live[0].rows[1].label + ": " + live[0].rows[1].value, "Program: Ninjago", "then the program")
    titles = []
    for each section in live
        titles.push(section.title)
    end for
    assertEqual(titles.Join(","), "Playback,Video,Audio,Technical", "Live TV has no File section")
end sub

' What the Why lines know, with nothing known unless a test says so
function playbackWhyKnown(overrides as object) as object
    known = { video: invalid, audio: invalid, subtitle: invalid, container: "", bitrate: 0, limit: 0 }
    known.Append(overrides)
    return known
end function

sub testPlaybackWhyLines()
    assertEqual(playbackFacts.LevelText("H.264", 51), "5.1", "H.264 writes its level times ten")
    assertEqual(playbackFacts.LevelText("H.264", 40), "4", "A whole level drops its point")
    assertEqual(playbackFacts.LevelText("HEVC", 153), "5.1", "HEVC writes its level times thirty")
    assertEqual(playbackFacts.LevelText("HEVC", 120), "4", "HEVC level 4")
    assertEqual(playbackFacts.LevelText("VC-1", 3), "3", "Any other codec keeps its level")
    assertEqual(playbackFacts.LevelText("HEVC", 0), "", "A level of 0 is no level")
    assertEqual(playbackFacts.StreamingTarget("https://jellyfin.test/videos/abc/master.m3u8?MaxStreamingBitrate=20000000&VideoBitrate=1&AudioBitrate=1"), 20000000, "The whole stream's cap leads")
    assertEqual(playbackFacts.StreamingTarget("https://jellyfin.test/videos/abc/master.m3u8?VideoBitrate=19808000&AudioBitrate=192000"), 20000000, "Else the video and audio rates together")
    assertEqual(playbackFacts.StreamingTarget("https://jellyfin.test/videos/abc/master.m3u8?VideoBitrate=19808000"), 0, "One rate alone is no target")

    film = {
        video: { Codec: "hevc", Profile: "Main 10", Level: 153, BitDepth: 10, Width: 3840, Height: 2160, RealFrameRate: 59.94006, VideoRangeType: "DOVI", DvProfile: 7 },
        audio: { Codec: "truehd", Profile: "Dolby TrueHD + Dolby Atmos", Channels: 8, SampleRate: 96000, BitDepth: 24 },
        subtitle: { Codec: "PGSSUB" },
        container: "MKV",
        bitrate: 68400000,
        limit: 20000000
    }
    every = ["DirectPlayError", "SubtitleCodecNotSupported", "UnknownAudioStreamInfo", "SecondaryAudioNotSupported", "AudioIsExternal", "AudioBitDepthNotSupported", "AudioSampleRateNotSupported", "AudioChannelsNotSupported", "AudioProfileNotSupported", "AudioCodecNotSupported", "VideoRangeTypeNotSupported", "RefFramesNotSupported", "AnamorphicVideoNotSupported", "InterlacedVideoNotSupported", "VideoFramerateNotSupported", "VideoResolutionNotSupported", "VideoBitDepthNotSupported", "VideoLevelNotSupported", "VideoProfileNotSupported", "VideoCodecNotSupported", "ContainerNotSupported", "ContainerBitrateExceedsLimit"]
    expected = [
        "Transcoding is forced in settings",
        "68.4 Mbps is above the 20 Mbps streaming limit",
        "This device can't open MKV files",
        "This device can't play HEVC video",
        "This device can't play HEVC Main 10 video",
        "This device can't play HEVC level 5.1 video",
        "This device can't play 10-bit video",
        "This device can't play 4K video",
        "This device can't play 59.94 fps video",
        "This device can't play interlaced video",
        "This device can't play anamorphic video",
        "This device can't play this video format",
        "This device can't display Dolby Vision Profile 7",
        "This device can't play Dolby TrueHD audio",
        "This device can't play Dolby TrueHD with Atmos",
        "This device can't play 7.1 audio",
        "This device can't play 96 kHz audio",
        "This device can't play 24-bit audio",
        "The audio track is in a separate file",
        "This device can only play the first audio track",
        "This device can't play this audio format",
        "PGS subtitles are being burned into the video",
        "The file couldn't be played directly"
    ]
    assertEqual(playbackFacts.WhyLines(every, true, playbackWhyKnown(film)).Join(Chr(10)), expected.Join(Chr(10)), "Every line in its fixed order, named from the source streams")

    example = playbackFacts.WhyLines(["ContainerBitrateExceedsLimit", "VideoRangeTypeNotSupported", "AudioCodecNotSupported", "SubtitleCodecNotSupported"], false, playbackWhyKnown(film))
    assertEqual(example.Join("|"), "68.4 Mbps is above the 20 Mbps streaming limit|This device can't display Dolby Vision Profile 7|This device can't play Dolby TrueHD audio|PGS subtitles are being burned into the video", "A 4K Dolby Vision file over the quality limit")

    blank = ["containerbitrateexceedslimit", "ContainerNotSupported", "VideoCodecNotSupported", "VideoProfileNotSupported", "VideoLevelNotSupported", "VideoBitDepthNotSupported", "VideoResolutionNotSupported", "VideoFramerateNotSupported", "VideoRangeTypeNotSupported", "AudioCodecNotSupported", "AudioProfileNotSupported", "AudioChannelsNotSupported", "AudioSampleRateNotSupported", "AudioBitDepthNotSupported", "SubtitleCodecNotSupported"]
    assertEqual(playbackFacts.WhyLines(blank, false, playbackWhyKnown({ video: {}, audio: {} })).Join("|"), "The bitrate is above the streaming limit|This device can't play this file type|This device can't play this video format|This device can't display this HDR format|This device can't play this audio format|Subtitles are being burned into the video", "Each line falls back when its value is missing, and identical fallbacks show once")

    bare = playbackWhyKnown({ video: { Codec: "h264", Profile: "0", Level: 0, VideoRangeType: "SDR" }, audio: { Codec: "dts" } })
    assertEqual(playbackFacts.WhyLines(["VideoLevelNotSupported", "VideoProfileNotSupported"], false, bare).Join("|"), "This device can't play H.264 video", "A profile or level of 0 falls back to the codec line, once")
    assertEqual(playbackFacts.WhyLines(["VideoProfileNotSupported", "VideoLevelNotSupported"], false, playbackWhyKnown({ video: { Codec: "hevc", Profile: 0, Level: "0" } })).Join("|"), "This device can't play HEVC video", "Whether the 0 is written as a number or text")
    assertEqual(playbackFacts.WhyLines(["AudioProfileNotSupported"], false, bare).Join("|"), "This device can't play DTS audio", "A missing audio profile falls back to the codec line")
    assertEqual(playbackFacts.WhyLines(["VideoRangeNotSupported"], false, bare).Join("|"), "This device can't display this HDR format", "An SDR range falls back")

    dts = playbackWhyKnown({ audio: { Codec: "dts", Profile: "DTS-HD MA", Channels: 3, SampleRate: 44100 } })
    assertEqual(playbackFacts.WhyLines(["AudioSampleRateNotSupported", "AudioChannelsNotSupported", "AudioProfileNotSupported", "AudioCodecNotSupported"], false, dts).Join("|"), "This device can't play DTS audio|This device can't play DTS-HD Master Audio|This device can't play 3-channel audio|This device can't play 44.1 kHz audio", "DTS names its codec alone, then its full format, counted channels and a fractional rate")
    assertEqual(playbackFacts.WhyLines(["AudioChannelsNotSupported"], false, playbackWhyKnown({ audio: { Channels: 6 } })).Join("|"), "This device can't play 5.1 audio", "Six channels read as 5.1")
    assertEqual(playbackFacts.WhyLines(["AudioProfileNotSupported", "AudioCodecNotSupported"], false, playbackWhyKnown({ audio: { Codec: "dca", Profile: "DTS-HD MA" } })).Join("|"), "This device can't play DTS audio|This device can't play DTS-HD Master Audio", "dca names DTS in both audio lines")

    assertEqual(playbackFacts.WhyLines(["VideoBitrateNotSupported"], false, playbackWhyKnown({ bitrate: 10000000, limit: 20000000 })).Join("|"), "The bitrate is above the streaming limit", "A bitrate under the limit falls back")
    assertEqual(playbackFacts.WhyLines(["BitrateLimitExceeded"], false, playbackWhyKnown({ bitrate: 68400000 })).Join("|"), "The bitrate is above the streaming limit", "No limit falls back")
    assertEqual(playbackFacts.WhyLines(["VideoBitrateExceedsLimit", "ContainerBitrateNotSupported", "AudioBitrateNotSupported"], false, playbackWhyKnown({ bitrate: 68400000, limit: 20640000 })).Join("|"), "68.4 Mbps is above the 20 Mbps streaming limit", "The bitrate reasons share one line, the limit rounded down")
    assertEqual(playbackFacts.WhyLines(["ContainerBitrateExceedsLimit"], false, playbackWhyKnown({ bitrate: 68400000, limit: 800000 })).Join("|"), "The bitrate is above the streaming limit", "A cap under 1 Mbps falls back rather than read as 0 Mbps")

    assertEqual(playbackFacts.WhyLines(["RefFramesNotSupported", "UnknownVideoStreamInfo"], false, playbackWhyKnown(film)).Join("|"), "This device can't play this video format", "Two reasons with the same line show it once")
    assertEqual(playbackFacts.WhyLines(["VideoCodecTagNotSupported", "videocodecnotsupported"], false, playbackWhyKnown(film)).Join("|"), "This device can't play HEVC video", "Reasons match whatever their case")
    assertEqual(playbackFacts.WhyLines(["SubtitleCodecNotSupported"], false, playbackWhyKnown({ subtitle: { Codec: "ass" } })).Join("|"), "ASS subtitles are being burned into the video", "A styled text format loses its kind")
    assertEqual(playbackFacts.WhyLines(["SubtitleCodecNotSupported"], false, playbackWhyKnown({ subtitle: { Codec: "mov_text" } })).Join("|"), "MP4 text subtitles are being burned into the video", "MP4 text has no kind to lose")
end sub

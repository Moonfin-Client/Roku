sub testYoutubeTrailer()
    ids = [
        ["https://www.youtube.com/watch?v=yQy-ANhnUpE", "yQy-ANhnUpE"],
        ["https://youtube.com/watch?feature=share&v=BjRs18rV1FI", "BjRs18rV1FI"],
        ["https://youtu.be/17KJk3ErIx0?t=3", "17KJk3ErIx0"],
        ["https://www.youtube-nocookie.com/embed/Cqg3QmUKTks", "Cqg3QmUKTks"],
        ["https://www.youtube.com/shorts/DfqPjRMsRP0", "DfqPjRMsRP0"],
        ["https://vimeo.com/12345678", ""],
        ["", ""]
    ]
    for each pair in ids
        assertEqual(youtubeTrailer.ExtractIdFromUrl(pair[0]), pair[1], "YouTube id from " + pair[0])
    end for
    assertEqual(youtubeTrailer.ExtractId({ RemoteTrailers: [{ Url: "https://vimeo.com/1" }, { Url: "https://youtu.be/yQy-ANhnUpE" }] }), "yQy-ANhnUpE", "First YouTube trailer wins")
    assertEqual(youtubeTrailer.ExtractId({ RemoteTrailers: invalid }), "", "No trailers, no id")

    visionOs = youtubeTrailer.Clients()[0]
    android = youtubeTrailer.Clients()[1]
    body = ParseJson(youtubeTrailer.PlayerRequestBody("yQy-ANhnUpE", visionOs, "visitor-1"))
    assertEqual(body.context.client.clientName, "VISIONOS", "Client name rides in the context")
    assertEqual(body.context.client.visitorData, "visitor-1", "Visitor id rides in the context")
    assertEqual(body.context.client.platform, invalid, "An empty platform stays out")
    body = ParseJson(youtubeTrailer.PlayerRequestBody("x", android))
    assertEqual(body.context.client.deviceModel, "Pixel 5", "Device details ride along")
    assertEqual(body.context.client.platform, "MOBILE", "Platform rides along")
    assertEqual(body.context.client.visitorData, invalid, "No visitor id without one")
    assertEqual(youtubeTrailer.PlayerRequestUrl(visionOs), "https://www.youtube.com/youtubei/v1/player?prettyPrint=false", "No key for a client without one")
    assertEqual(Instr(1, youtubeTrailer.PlayerRequestUrl(android), "?key=") > 0, true, "Android sends its key")

    turnedAway = { playabilityStatus: { status: "LOGIN_REQUIRED" }, responseContext: { visitorData: "visitor-2" } }
    played = { playabilityStatus: { status: "OK" }, responseContext: { visitorData: "visitor-2" } }
    unavailable = { playabilityStatus: { status: "UNPLAYABLE" }, responseContext: { visitorData: "visitor-2" } }
    assertEqual(youtubeTrailer.VisitorData(turnedAway), "visitor-2", "Visitor id read from any answer")
    assertEqual(youtubeTrailer.ShouldRetryWithVisitor(turnedAway, ""), true, "Turned away with a fresh id asks again")
    assertEqual(youtubeTrailer.ShouldRetryWithVisitor(turnedAway, "visitor-2"), false, "Same id twice doesnt ask again")
    assertEqual(youtubeTrailer.ShouldRetryWithVisitor(played, ""), false, "An answer that played doesnt ask again")
    assertEqual(youtubeTrailer.StaleVisitor(turnedAway, "visitor-2"), true, "A sent id handed back on a bot check is stale")
    assertEqual(youtubeTrailer.StaleVisitor(turnedAway, "visitor-1"), false, "A fresh id isnt stale")
    assertEqual(youtubeTrailer.StaleVisitor(unavailable, "visitor-2"), false, "A video that wont play keeps the id")
    assertEqual(youtubeTrailer.StaleVisitor(turnedAway, ""), false, "Nothing sent, nothing stale")

    muxed = {
        playabilityStatus: { status: "OK" }, streamingData: {
            formats: [
                { url: "low", qualityLabel: "144p", mimeType: "video/mp4; codecs=""avc1.42001E, mp4a.40.2""" },
                { url: "mid", qualityLabel: "360p", mimeType: "video/mp4; codecs=""avc1.42001E, mp4a.40.2""" },
                { url: "silent", qualityLabel: "720p", mimeType: "video/mp4; codecs=""avc1.4d401f""" }
            ]
        }
    }
    stream = youtubeTrailer.PlayerStream(muxed, true)
    assertEqual(stream.url, "mid", "Muxed streams need sound")
    assertEqual(stream.quality, 360, "Quality read from the label")
    assertEqual(stream.format, "mp4", "Muxed stream plays as mp4")
    assertEqual(youtubeTrailer.PlayerStream({ playabilityStatus: { status: "LOGIN_REQUIRED" }, streamingData: muxed.streamingData }, true), invalid, "Refused answers give nothing")
    assertEqual(youtubeTrailer.PlayerStream({ streamingData: { hlsManifestUrl: "manifest" } }, true).format, "hls", "A manifest beats every file")

    captions = {
        captions: {
            playerCaptionsTracklistRenderer: {
                captionTracks: [
                    { baseUrl: "https://yt/auto?lang=fr", languageCode: "fr", kind: "asr" },
                    { baseUrl: "https://yt/written?lang=de&fmt=srv3", languageCode: "de" },
                    { baseUrl: "https://yt/written?lang=en", languageCode: "en" }
                ]
            }
        }
    }
    assertEqual(youtubeTrailer.CaptionTrackUrl(captions, "de-DE"), "https://yt/written?lang=de&fmt=vtt", "Viewer language, its own format swapped for vtt")
    assertEqual(youtubeTrailer.CaptionTrackUrl(captions, "fr"), "https://yt/written?lang=en&fmt=vtt", "Written English beats machine French")
    assertEqual(youtubeTrailer.CaptionTrackUrl({}, "en"), "", "No tracks, no captions")

    dubbed = {
        streamingData: {
            adaptiveFormats: [
                { itag: 137, mimeType: "video/mp4; codecs=""avc1.640028""" },
                { itag: 140, audioTrack: { id: "de-DE.10", audioIsDefault: false } },
                { itag: 140, audioTrack: { id: "en-US.4", audioIsDefault: true } }
            ]
        }
    }
    assertEqual(youtubeTrailer.OriginalAudioLanguage(dubbed), "en-US", "Original soundtrack language")
    assertEqual(youtubeTrailer.OriginalAudioLanguage({ streamingData: { adaptiveFormats: [{ itag: 140 }] } }), "", "No dubs, no language")

    tracks = [
        { Track: "1", Language: "de-DE", Name: "Deutsch (Deutschland) - dubbed-auto" },
        { Track: "8", Language: "en-US", Name: "American English - original" },
        { Track: "9", Language: "de-DE", Name: "Deutsch (Deutschland) - dubbed-auto" },
        { Track: "16", Language: "en-US", Name: "American English - original" }
    ]
    assertEqual(youtubeTrailer.OriginalAudioTrack(tracks, "en-US"), "16", "The last original belongs to the sharp variants")
    assertEqual(youtubeTrailer.OriginalAudioTrack([{ Track: "1", Language: "de" }, { Track: "2", Language: "en" }], "en-US"), "2", "Language stands in for a missing name")
    assertEqual(youtubeTrailer.OriginalAudioTrack(tracks, ""), "", "No language leaves the tracks alone")
    assertEqual(youtubeTrailer.OriginalAudioTrack([tracks[1]], "en-US"), "", "One track has nothing to switch")

    vtt = "WEBVTT" + Chr(10) + "Kind: captions" + Chr(10) + Chr(10) + "00:00:01.500 --> 00:00:03.000 align:start position:0%" + Chr(10) + "<c>Hello</c> there" + Chr(10) + "second line" + Chr(10) + Chr(10) + "01:02.250 --> 01:04.000" + Chr(10) + "Later"
    cues = youtubeTrailer.VttCues(vtt)
    assertEqual(cues.count(), 2, "Two cues read")
    assertEqual(cues[0].start, 1.5, "Cue start in seconds")
    assertEqual(cues[0].text, "Hello there" + Chr(10) + "second line", "Tags gone and lines kept")
    assertEqual(cues[1].start, 62.25, "Hours are optional")
    assertEqual(cues[1].finish, 64.0, "Cue end in seconds")

    segments = youtubeTrailer.SponsorSegments([{ segment: [0, 7.5] }, { segment: [8, 12] }, { segment: [40, 50] }, { bad: true }])
    assertEqual(segments.count(), 3, "Sponsor segments read")
    assertEqual(youtubeTrailer.StartTime(segments), 12.0, "Back to back openings are all skipped")
    assertEqual(youtubeTrailer.StartTime([]), 0.0, "Nothing marked starts at the top")
    assertEqual(youtubeTrailer.StartTime([{ start: 40, finish: 50 }]), 5.0, "Anything marked starts five seconds in")
end sub

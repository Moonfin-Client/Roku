' The device's audio offset, when a load plays Moonbase's moved stream, and the subtitles and start
' point that have to follow the stream's own clock
sub testAudioOffset()
    assertEqual(audioOffset.FromStored(invalid), 0, "No stored offset reads as none")
    assertEqual(audioOffset.FromStored("-300"), -300, "A stored offset reads back")
    assertEqual(audioOffset.FromStored("60000"), AUDIO_OFFSET_LIMIT_MS, "and stays within the limit")
    assertEqual(audioOffset.FromStored(-60000), -AUDIO_OFFSET_LIMIT_MS, "either way")
    assertEqual(audioOffset.FromStored("soon"), 0, "Anything unreadable is none")
    assertEqual(AUDIO_OFFSET_LIMIT_MS, 2000, "The audio moves up to two seconds either way")
    assertEqual(AUDIO_OFFSET_STEP_MS, 50, "in twentieths of a second")
    assertEqual(audioOffset.Detail(0), "None", "No offset reads as None")
    assertEqual(audioOffset.Detail(50), "+0.05s", "An offset shows to the hundredth")
    assertEqual(audioOffset.Detail(-1250), "-1.25s", "either way")

    assertEqual(audioOffset.Applies(300, false, false, true, false, true), true, "An offset plays through Moonbase")
    assertEqual(audioOffset.Applies(0, false, false, true, false, true), false, "No offset plays as usual")
    assertEqual(audioOffset.Applies(300, true, false, true, false, true), false, "Live TV plays as usual")
    assertEqual(audioOffset.Applies(300, false, true, true, false, true), false, "So does Silo, which makes its own stream")
    assertEqual(audioOffset.Applies(300, false, false, false, false, true), false, "and a server without Moonbase")
    assertEqual(audioOffset.Applies(300, false, false, true, true, true), false, "and a title from another server")
    assertEqual(audioOffset.Applies(300, false, false, true, false, false), false, "and video the device can't play as it is")
    assertEqual(audioOffset.Eligible(false, false, true, false, true), true, "A title can take the moved stream with no offset set yet")
    assertEqual(audioOffset.Eligible(true, false, true, false, true), false, "but live TV can't")

    url = "http://jf:8096/Videos/abc/abc/Subtitles/4/0/Stream.vtt?api_key=t"
    assertEqual(audioOffset.ShiftSubtitleUrl(url, 11905560000&), "http://jf:8096/Videos/abc/abc/Subtitles/4/11905560000/Stream.vtt?api_key=t", "Subtitles are asked for from where the stream starts")
    assertEqual(audioOffset.ShiftSubtitleUrl(url, 0&), url, "A stream from the start leaves them alone")
    assertEqual(audioOffset.ShiftSubtitleUrl("http://jf/sub.srt", 50000000&), "http://jf/sub.srt", "An address without a start is left alone")

    assertEqual(audioOffset.PlayStart(1200, 1190.556), 9, "Play begins where the viewer was, a few seconds into a stream cut at the keyframe before")
    assertEqual(audioOffset.PlayStart(0, 0), 0, "A stream from the start plays from its start")
    assertEqual(audioOffset.PlayStart(10, 12), 0, "and never before it")
end sub

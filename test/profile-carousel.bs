sub testProfileCarousel()
    ' "abc" sums to 294 and 294 mod 6 is 0, "ab" sums to 195 and 195 mod 6 is 3
    assertEqual(profileCarousel.InitialsColor("abc"), "#2B6CB0", "A user's color comes from the sum of their id")
    assertEqual(profileCarousel.InitialsColor("ab"), "#6B46C1", "and wraps over the six colors")
    assertEqual(profileCarousel.InitialsColor(""), "#2B6CB0", "An empty id still gets one")

    assertEqual(profileCarousel.Initial("alex"), "A", "The initial is the first letter in capitals")
    assertEqual(profileCarousel.Initial("  sam"), "S", "after any leading spaces")
    assertEqual(profileCarousel.Initial(""), "", "and nothing for no name")

    hero = profileCarousel.Placement(0)
    assertEqual(hero.size, 280, "The middle face is the biggest")
    assertEqual(hero.opacity, 1.0, "and fully drawn")
    assertEqual(profileCarousel.Placement(-1).x, -314, "A neighbor sits to its left")
    assertEqual(profileCarousel.Placement(2).opacity, 0.3, "and the next one out is fainter")
    halfway = profileCarousel.Placement(0.5)
    assertEqual(halfway.x, 157, "Mid slide a face sits halfway between two slots")
    assertEqual(halfway.size, 223.5, "at a size between them")
    assertEqual(profileCarousel.Placement(2.5).opacity, 0.15, "fading out as it heads past the edge")
    assertEqual(profileCarousel.Placement(-7).x, -700, "Faces further out wait past the edge")
    assertEqual(profileCarousel.Placement(7).opacity, 0.0, "unseen")
end sub

sub testSiloWatchParty()
    room = siloParty.BASE + "/rooms/r-1"

    plan = siloParty.Plan({ kind: "create", roomUuid: "room-new" }, "")
    assertEqual(plan.method, "POST", "Creating a party posts a room")
    assertEqual(plan.path, siloParty.BASE + "/rooms", "Creating a party uses the rooms route")
    assertEqual(plan.body.room_id, "room-new", "A new room takes the id the caller picked")
    assertEqual(plan.body.selection_mode, "host_pick", "A new room is picked by the host")
    assertEqual(plan.roomToken, false, "Creating a party has no room token to send yet")
    assertEqual(plan.replay, true, "Creating a party can be replayed, since its id is fixed")

    plan = siloParty.Plan({ kind: "join", body: { code: "k7q29m" } }, "")
    assertEqual(plan.path, siloParty.BASE + "/join", "Joining uses the join route")
    assertEqual(plan.body.code, "K7Q29M", "A typed code goes up in capitals")
    assertEqual(plan.body.join_token, invalid, "A short code isn't sent as a token")
    plan = siloParty.Plan({ kind: "join", body: { code: " eyJhbGciOiJIUzI1NiJ9abc " } }, "")
    assertEqual(plan.body.join_token, "eyJhbGciOiJIUzI1NiJ9abc", "A long text is an invite token")
    assertEqual(plan.body.code, invalid, "An invite token isn't sent as a code")
    plan = siloParty.Plan({ kind: "join", body: { join_token: "tok-1" } }, "")
    assertEqual(plan.body.join_token, "tok-1", "A join token is sent as it is")
    assertEqual(siloParty.Plan({ kind: "join", body: { room_id: "r-1" } }, "") = invalid, true, "A Moonbase room list join has no Silo route")

    plan = siloParty.Plan({ kind: "suggestions", method: "GET", path: "Suggestions" }, "r-1")
    assertEqual(plan.method, "GET", "Suggestions are read")
    assertEqual(plan.path, room + "/suggestions", "Suggestions belong to the room")
    assertEqual(plan.roomToken, true, "Suggestions need the room token")
    assertEqual(plan.paged, true, "Suggestions are read a page at a time")

    plan = siloParty.Plan({ kind: "start", body: { position_seconds: 0 } }, "r-1")
    assertEqual(plan.path, room + "/playback/start", "Start goes to the room's start route")
    assertEqual(plan.body, invalid, "Start sends no body")
    assertEqual(plan.replay, false, "A start is never replayed")

    plan = siloParty.Plan({ kind: "stop" }, "r-1")
    assertEqual(plan.method, "POST", "Stop posts")
    assertEqual(plan.path, room + "/playback/stop", "Stop goes to the room's stop route")

    plan = siloParty.Plan({ kind: "voting", body: { voting: true } }, "r-1")
    assertEqual(plan.method, "PATCH", "Voting changes the selection mode")
    assertEqual(plan.path, room + "/selection-mode", "Voting uses the selection-mode route")
    assertEqual(plan.body.selection_mode, "vote", "Turning voting on picks vote mode")
    plan = siloParty.Plan({ kind: "voting", body: { voting: false } }, "r-1")
    assertEqual(plan.body.selection_mode, "host_pick", "Turning voting off goes back to host pick")

    plan = siloParty.Plan({ kind: "stage", body: { content_id: "movie-1" } }, "r-1")
    assertEqual(plan.method, "PUT", "Staging replaces the staged selection")
    assertEqual(plan.path, room + "/staged-selection", "Staging uses the staged-selection route")
    assertEqual(plan.body.content_id, "movie-1", "Staging names the title")
    assertEqual(plan.body.file_id, invalid, "Staging without a file sends no file")
    plan = siloParty.Plan({ kind: "stage", body: { content_id: "movie-1", file_id: 42 } }, "r-1")
    assertEqual(plan.body.file_id, 42, "Staging with a file sends the file")

    plan = siloParty.Plan({ kind: "suggest", suggestionUuid: "sug-1", body: { content_id: "episode-9", title: "Pilot" } }, "r-1")
    assertEqual(plan.method, "POST", "Suggesting posts")
    assertEqual(plan.path, room + "/suggestions", "Suggesting uses the suggestions route")
    assertEqual(plan.body.suggestion_id, "sug-1", "A suggestion takes the id the caller picked")
    assertEqual(plan.body.content_type, "episode", "An episode suggestion says so")
    assertEqual(plan.body.title, "Pilot", "A suggestion keeps its title")
    assertEqual(plan.body.subtitle, invalid, "No subtitle is sent when there isn't one")
    assertEqual(plan.roomToken, true, "Suggesting needs the room token")
    plan = siloParty.Plan({ kind: "suggest", suggestionUuid: "sug-2", body: { content_id: "movie-3", subtitle: "2024" } }, "r-1")
    assertEqual(plan.body.content_type, "movie", "Anything but an episode is a movie")
    assertEqual(plan.body.title, "", "A suggestion without a title has an empty one")
    assertEqual(plan.body.subtitle, "2024", "A subtitle is sent when there is one")

    plan = siloParty.Plan({ kind: "vote", path: "Suggestions/sug-1/Vote", body: { voted: true } }, "r-1")
    assertEqual(plan.method, "POST", "A vote is cast with a post")
    assertEqual(plan.path, room + "/suggestions/sug-1/vote", "A vote goes to the suggestion's vote route")
    assertEqual(plan.roomToken, true, "A vote needs the room token")
    plan = siloParty.Plan({ kind: "vote", path: "/Rooms/r-1/Suggestions/sug-1/Vote", body: { voted: false } }, "r-1")
    assertEqual(plan.method, "DELETE", "A vote taken back is a delete")
    assertEqual(plan.path, room + "/suggestions/sug-1/vote", "A full Moonbase vote path gives the same route")
    assertEqual(siloParty.Plan({ kind: "vote", path: "Suggestions", body: { voted: true } }, "r-1") = invalid, true, "A vote with no suggestion id has no route")

    plan = siloParty.Plan({ kind: "remove", body: { suggestion_id: "sug-1" } }, "r-1")
    assertEqual(plan.method, "DELETE", "Removing a suggestion deletes it")
    assertEqual(plan.path, room + "/suggestions/sug-1", "Removing a suggestion uses its route")
    assertEqual(plan.roomToken, true, "Removing a suggestion needs the room token")
    assertEqual(siloParty.Plan({ kind: "remove", body: { member_id: "p-2" } }, "r-1") = invalid, true, "Removing a member has no Silo route")

    plan = siloParty.Plan({ kind: "promote", body: { suggestion_id: "sug-1" } }, "r-1")
    assertEqual(plan.path, room + "/suggestions/promote", "Promoting a suggestion uses the promote route")
    assertEqual(plan.body.suggestion_id, "sug-1", "Promoting names the suggestion")
    assertEqual(plan.replay, false, "A promote is never replayed")
    assertEqual(siloParty.Plan({ kind: "promote", body: { member_id: "p-2" } }, "r-1") = invalid, true, "Making a member host has no Silo route")

    plan = siloParty.Plan({ kind: "policy", body: { guest_control_policy: "everyone" } }, "r-1")
    assertEqual(plan.method, "PATCH", "The policy is patched")
    assertEqual(plan.path, room + "/policy", "The policy uses the room's policy route")
    assertEqual(plan.body.guest_control_policy, "guest_play_pause", "Everyone may control playback")
    plan = siloParty.Plan({ kind: "policy", body: { guest_control_policy: "guests_can_pause" } }, "r-1")
    assertEqual(plan.body.guest_control_policy, "guest_play_pause", "Guests who can pause map to guest play and pause")
    plan = siloParty.Plan({ kind: "policy", body: { guest_control_policy: "host_only" } }, "r-1")
    assertEqual(plan.body.guest_control_policy, "host_only", "Host only stays host only")

    plan = siloParty.Plan({ kind: "close" }, "r-1")
    assertEqual(plan.method, "DELETE", "Closing deletes the room")
    assertEqual(plan.path, room, "Closing uses the room's route")

    assertEqual(siloParty.Plan({ kind: "leave" }, "r-1") = invalid, true, "Leaving has no Silo route")
    assertEqual(siloParty.Plan({ kind: "pin", body: { pin: "1234" } }, "r-1") = invalid, true, "Pins have no Silo route")
    assertEqual(siloParty.Plan({ kind: "rooms" }, "") = invalid, true, "A room list has no Silo route")
    assertEqual(siloParty.Plan({ kind: "config" }, "") = invalid, true, "Config has no Silo route")

    raw = {
        room_id: 12,
        phase: "lobby",
        selected_content_id: "movie-5",
        selected_file_id: 7,
        selected_library_id: 3,
        invite_path: "/rooms/join?token=abc",
        anchor_updated_at: "2026-11-09T21:00:00Z",
        members: [
            { profile_id: 4, user_id: 9, is_self: true, lobby_ready: true },
            { profile_id: "p-5", is_self: false, lobby_ready: false }
        ]
    }
    normal = siloParty.NormalizeRoom(raw, "https://silo.example/")
    assertEqual(normal.room_id, "12", "A numeric room id becomes text")
    assertEqual(normal.selected_file_id, "7", "A numeric file id becomes text")
    assertEqual(normal.selected_library_id, "3", "A numeric library id becomes text")
    assertEqual(normal.selected_content_id, "movie-5", "A content id stays text")
    assertEqual(normal.members[0].profile_id, "4", "A numeric member id becomes text")
    assertEqual(normal.members[0].user_id, "9", "A numeric user id becomes text")
    assertEqual(normal.self_member_id, "4", "The self member is the one that is_self")
    assertEqual(normal.content_type, "Movie", "A movie room is a Movie")
    assertEqual(normal.invite_url, "https://silo.example/rooms/join?token=abc", "The invite link is the server's invite path")
    assertEqual(normal.anchor_at, "2026-11-09T21:00:00Z", "The anchor time takes the anchor's update time")
    assertEqual(normal.has_pin, false, "A room without a PIN says so")
    assertEqual(normal.chat_enabled, false, "Chat is off when Silo doesn't say")
    assertEqual(normal.reactions_enabled, false, "Reactions are off when Silo doesn't say")
    assertEqual(normal.members[0].status, "ready", "A lobby member who is ready shows ready")
    assertEqual(normal.members[1].status, "joining", "A lobby member who isn't ready is joining")
    assertEqual(raw.members[0].status, invalid, "The room passed in isn't changed")
    assertEqual(raw.members[0].profile_id, 4, "The room passed in keeps its numbers")

    playing = siloParty.NormalizeRoom({
        room_id: "r-2",
        phase: "playing",
        selected_content_id: "episode-9",
        members: [
            { profile_id: "a", connected: false },
            { profile_id: "b", connected: true, is_buffering: true },
            { profile_id: "c", connected: true, is_syncing: true },
            { profile_id: "d", connected: true, is_ready: true },
            { profile_id: "e", connected: true }
        ]
    })
    assertEqual(playing.content_type, "Episode", "An episode room is an Episode")
    assertEqual(playing.members[0].status, "not_watching", "A member who left the socket isn't watching")
    assertEqual(playing.members[1].status, "buffering", "A buffering member shows buffering")
    assertEqual(playing.members[2].status, "catching_up", "A member syncing shows catching up")
    assertEqual(playing.members[3].status, "in_sync", "A member who is ready shows in sync")
    assertEqual(playing.members[4].status, "joining", "A connected member with nothing to report is joining")

    kept = siloParty.NormalizeRoom({ room_id: "r-3", self_member_id: "x", content_type: "Movie", selected_content_id: "episode-9", members: [{ profile_id: "y", is_self: true }] })
    assertEqual(kept.self_member_id, "x", "A room's own self member id is kept")
    assertEqual(kept.content_type, "Movie", "A room's own content type is kept")
    assertEqual(siloParty.NormalizeRoom({}) = invalid, true, "A room without an id is no room")
    assertEqual(siloParty.NormalizeRoom(invalid) = invalid, true, "No room is no room")

    sorted = siloParty.SortSuggestions([
        { id: 3, content_id: "movie-3", title: "C", vote_count: 1, voted_by_me: false, created_at: "2026-11-01T10:00:00Z" },
        { id: "b", content_id: "movie-2", title: "B", vote_count: 2, voted_by_me: true, created_at: "2026-11-02T10:00:00Z" },
        { id: "aa", content_id: "movie-4", vote_count: 2, created_at: "2026-11-01T10:00:00Z" },
        { id: "a", content_id: "movie-1", vote_count: 2, created_at: "2026-11-01T10:00:00Z" },
        { id: "", content_id: "movie-9", vote_count: 9 },
        { id: "z", vote_count: 9 }
    ])
    assertEqual(sorted.Count(), 4, "A suggestion without an id or content id is dropped")
    assertEqual(sorted[0].id, "a", "The most voted and oldest suggestion comes first")
    assertEqual(sorted[1].id, "aa", "Equal votes and age go by id")
    assertEqual(sorted[2].id, "b", "A newer suggestion with the same votes comes after")
    assertEqual(sorted[2].voted_by_me, true, "Whether the viewer voted is kept")
    assertEqual(sorted[3].id, "3", "A numeric id becomes text, and the fewest votes come last")
    assertEqual(sorted[3].vote_count, 1, "Votes are kept")

    members = {
        items: [
            {
                content_id: "movie-1",
                members: [
                    { profile_id: "p-1", state: "in_progress", position_seconds: 12.5 },
                    { profile_id: "p-2", state: "in_progress", position_seconds: 640.7 },
                    { profile_id: "p-3", state: "in_progress", position_seconds: 300.2 },
                    { profile_id: "p-4", state: "unseen", position_seconds: 0 },
                    { profile_id: "p-5", state: "unseen", position_seconds: 0 }
                ]
            }
        ]
    }
    point = siloParty.ResumePoint(members, "movie-1")
    assertEqual(point.seconds, 300, "The resume point is the earliest position past 30 seconds")
    assertEqual(point.profileId, "p-3", "The resume point names the member whose spot it is")
    assertEqual(point.notStarted, 2, "Members who haven't started are counted")
    assertEqual(siloParty.ResumePoint({ items: [{ content_id: "movie-1", members: [{ profile_id: "p-1", state: "in_progress", position_seconds: 29.9 }] }] }, "movie-1") = invalid, true, "A member under 30 seconds gives no resume point")
    assertEqual(siloParty.ResumePoint({ items: [{ content_id: "movie-1", members: [{ profile_id: "p-1", state: "in_progress", position_seconds: 30 }] }] }, "movie-1").seconds, 30, "Exactly 30 seconds is a resume point")
    assertEqual(siloParty.ResumePoint(members, "movie-2") = invalid, true, "Another title has no resume point")
    assertEqual(siloParty.ResumePoint({ items: [] }, "movie-1") = invalid, true, "An empty answer has no resume point")

    assertEqual(siloParty.SocketUrl("https://silo.example/", "r-1"), "wss://silo.example/api/v2/watch-together/rooms/r-1/ws", "An https server opens a wss socket, without its trailing slash")
    assertEqual(siloParty.SocketUrl("http://192.168.1.10:8990", "r-1"), "ws://192.168.1.10:8990/api/v2/watch-together/rooms/r-1/ws", "An http server opens a ws socket on its port")
    assertEqual(siloParty.Protocols("tkt-1"), "silo.room.v2, silo.ticket.tkt-1", "The ticket rides in the offered protocols")
end sub

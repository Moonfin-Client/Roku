sub testFallbackFont()
    savedGlobal = m.global
    savedRegistry = m.registry
    savedSettingsOn = m.testSettingsOn
    m.registry = { "font-user": { "ui.theme.fontFamily": "NeonPulseDisplay" } }
    m.global = { fallbackFont: "", session: { user: { id: "font-user" } } }
    m.testSettingsOn = true

    assertEqual(fontApply.ActiveFamily(), "NeonPulseDisplay", "With no font downloaded the theme keeps its face")
    assertEqual(fontApply.ThemeTextSize(20), 27, "A theme face still gets its small text bump")

    m.global.fallbackFont = "tmp:/font"
    assertEqual(fontApply.ActiveFamily(), FALLBACK_FONT_FAMILY, "The fallback font stands in for the theme's face")
    assertEqual(fontRegistry.FamilyToFont(FALLBACK_FONT_FAMILY).uri, "tmp:/font", "The fallback family draws the downloaded file")
    assertEqual(fontApply.ThemeTextSize(20), 20, "The fallback font draws at the size asked for")
    assertEqual(fontApply.ThemeBodyTextSize(20), 20, "The overview isn't trimmed for the fallback font")

    m.testSettingsOn = false
    assertEqual(fontApply.ActiveFamily(), "NeonPulseDisplay", "Turning the setting off hands the face back to the theme")

    m.global = savedGlobal
    m.registry = savedRegistry
    m.testSettingsOn = savedSettingsOn
end sub

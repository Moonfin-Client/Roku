' The player's control glyphs, menus and chapter steps
sub testOsdControls()
    assertEqual(osdControls.SeekGlyph(-1, 10), "replay_10_rounded", "Seek back by 10 wears the numbered glyph")
    assertEqual(osdControls.SeekGlyph(1, 30), "forward_30_rounded", "and seek forward by 30 too")
    assertEqual(osdControls.SeekGlyph(1, 5), "forward_5_rounded", "Five has one")
    assertEqual(osdControls.SeekGlyph(-1, 15), "fast_rewind_rounded", "Other lengths get the plain arrows")
    assertEqual(osdControls.SeekGlyph(1, 60), "fast_forward_rounded", "both ways")
    assertEqual(osdControls.SkipSeconds({ "playback.skipForwardLength": "30" }, 1), 30, "Seek forward skips by its own length")
    assertEqual(osdControls.SkipSeconds({}, -1), 10, "and either one is 10 when unset")

    labels = []
    for each speed in osdControls.Speeds()
        labels.push(osdControls.SpeedLabel(speed))
    end for
    assertEqual(labels.Join(","), "0.5x,0.75x,1.0x,1.25x,1.5x,1.75x,2.0x", "Core's speeds up to the 2x a Roku plays, labeled the way Core prints them")
    assertEqual(osdControls.SpeedLabel(3.5), "3.5x", "A speed with one decimal keeps it")
    assertEqual(osdControls.SpeedLabel(1.05), "1.05x", "A speed under a tenth keeps its zero")

    bitrateLabels = []
    for each bps in osdControls.Bitrates()
        bitrateLabels.push(osdControls.BitrateLabel(bps))
    end for
    assertEqual(bitrateLabels.Join(","), "Auto,40 Mbps,20 Mbps,12 Mbps,8 Mbps,4 Mbps,2 Mbps", "Core's bitrates, Auto first")

    starts = [0, 60000, 300000]
    assertEqual(osdControls.PreviousChapterStart(starts, 200000), 60000, "Previous goes to the start of the chapter playing")
    assertEqual(osdControls.PreviousChapterStart(starts, 62000), 0, "and to the one before within three seconds of that start")
    assertEqual(osdControls.PreviousChapterStart(starts, 2000), -1, "with nothing before it the queue decides")
    assertEqual(osdControls.PreviousChapterStart([], 200000), -1, "and without chapters too")
    assertEqual(osdControls.NextChapterStart(starts, 200000), 300000, "Next goes to the next chapter's start")
    assertEqual(osdControls.NextChapterStart(starts, 300000), -1, "and has nowhere to go inside the last one")
end sub

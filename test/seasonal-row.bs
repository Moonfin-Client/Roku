sub testSeasonalRow()
    assertEqual(seasonalRow.CountryParam("auto", "us"), "US", "Automatic sends the device country")
    assertEqual(seasonalRow.CountryParam(invalid, "CA"), "CA", "An unset country setting is Automatic")
    assertEqual(seasonalRow.CountryParam("auto", "OT"), "", "The OT region Roku reports is no country")
    assertEqual(seasonalRow.CountryParam("auto", invalid), "", "No device country leaves the plugin to fall back")
    assertEqual(seasonalRow.CountryParam("other", "US"), "ZZ", "Other asks for holidays with no country")
    assertEqual(seasonalRow.CountryParam("CA", "US"), "CA", "A chosen country wins over the device")
    assertEqual(seasonalRow.CountryParam("usa", "US"), "", "Anything but two letters is left out")

    assertEqual(seasonalRow.HiddenHolidays("[""pride"",""easter""]").count(), 2, "The hidden list is stored as JSON")
    assertEqual(seasonalRow.HiddenHolidays(["pride"]).count(), 1, "A list already parsed is kept")
    assertEqual(seasonalRow.HiddenHolidays("{}").count(), 0, "Anything but a list hides nothing")
    assertEqual(seasonalRow.HiddenHolidays(invalid).count(), 0, "An unset list hides nothing")

    filter = parentalFilter.FromRatings(["R"])
    items = [{ OfficialRating: "PG" }, { OfficialRating: "R" }, { Name: "never looked up" }, { OfficialRating: "" }]
    assertEqual(parentalFilter.WithoutBlockedStrict(items, filter).count(), 1, "A chart row drops blocked and unrated titles")
    assertEqual(parentalFilter.WithoutBlocked(items, filter).count(), 3, "A library row keeps unrated titles")
    assertEqual(parentalFilter.WithoutBlockedStrict(items, parentalFilter.FromRatings([])).count(), 4, "Nothing blocked leaves every title")
end sub

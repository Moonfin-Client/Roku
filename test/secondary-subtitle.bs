' The second subtitle track's list and what's remembered of a pick
function secondaryTestStream(index as integer, overrides = {} as object) as object
    stream = { Index: index, Codec: "srt", Language: "eng", Track: { Description: "Track " + index.toStr() }, IsExternal: false, IsForced: false, IsHearingImpaired: false, IsTextSubtitleStream: true }
    stream.Append(overrides)
    return stream
end function

function secondaryTestIndexes(streams as object) as string
    indexes = []
    for each stream in streams
        indexes.push(stream.Index)
    end for
    return FormatJson(indexes)
end function

sub testSecondarySubtitle()
    assertEqual(secondarySubtitle.IsEligible(secondaryTestStream(1, { Codec: "subrip" })), true, "A second track can be SubRip")
    assertEqual(secondarySubtitle.IsEligible(secondaryTestStream(1, { Codec: "WebVTT" })), true, "or WebVTT")
    assertEqual(secondarySubtitle.IsEligible(secondaryTestStream(1, { Codec: "ass" })), false, "but not ASS")
    assertEqual(secondarySubtitle.IsEligible(secondaryTestStream(1, { Codec: "pgssub", IsTextSubtitleStream: false })), false, "or a picture track")
    assertEqual(secondarySubtitle.IsEligible(secondaryTestStream(1, { IsEmbeddedNative: true })), false, "or text the server can't pull out")

    streams = [secondaryTestStream(1), secondaryTestStream(2, { Language: "spa" }), secondaryTestStream(3, { Language: "fre" }), secondaryTestStream(4, { Codec: "ass" })]
    assertEqual(secondaryTestIndexes(secondarySubtitle.Candidates(streams, 1, "fre", {})), "[3,2]", "The list drops the first track and puts the preferred language on top")
    streams = [secondaryTestStream(5, { IsExternal: true }), secondaryTestStream(2), secondaryTestStream(3)]
    assertEqual(secondaryTestIndexes(secondarySubtitle.Candidates(streams, -1, "anyLanguage", {})), "[2,3,5]", "Without a preferred language it keeps the first track's order")
    assertEqual(secondaryTestIndexes(secondarySubtitle.Candidates(streams, -1, invalid, { "playback.preferExternalSubtitles": true })), "[5,2,3]", "which puts external files first when asked")

    assertEqual(FormatJson(secondarySubtitle.Selection([secondaryTestStream(1)], -1)), FormatJson({ off: true }), "No track is remembered as off")
    assertEqual(FormatJson(secondarySubtitle.Selection([secondaryTestStream(1)], 9)), FormatJson({ off: true }), "and so is a track that isn't there")

    streams = [secondaryTestStream(1), secondaryTestStream(2, { Language: "spa" })]
    saved = ParseJson(FormatJson(secondarySubtitle.Selection(streams, 2)))
    assertEqual(secondarySubtitle.RestoreIndex(saved, streams), 2, "The same track comes back by its index")

    spanish = { Language: "spa", Track: { Description: "Spanish" } }
    saved = secondarySubtitle.Selection([secondaryTestStream(1), secondaryTestStream(2, spanish)], 2)
    assertEqual(secondarySubtitle.RestoreIndex(saved, [secondaryTestStream(4), secondaryTestStream(7, spanish)]), 7, "and is found again when its index moved")

    assertEqual(secondarySubtitle.RestoreIndex({ off: true }, [secondaryTestStream(1)]), -1, "Off comes back as off")
    assertEqual(isValid(secondarySubtitle.RestoreIndex(invalid, [secondaryTestStream(1)])), false, "and nothing saved as nothing")
    saved = secondarySubtitle.Selection([secondaryTestStream(1), secondaryTestStream(2, { Language: "spa" })], 2)
    assertEqual(secondarySubtitle.RestoreIndex(saved, [secondaryTestStream(1)]), -1, "A track that's gone is let go")

    same = { Track: { Description: "Same" } }
    saved = secondarySubtitle.Selection([secondaryTestStream(1, same), secondaryTestStream(2, same)], 2)
    assertEqual(secondarySubtitle.RestoreIndex(saved, [secondaryTestStream(5, same), secondaryTestStream(6, same)]), 6, "Two tracks that look the same fall back to the position")

    assertEqual(secondarySubtitle.ShiftPercent(8), 0, "The default offset leaves the subtitles where they sit")
end sub

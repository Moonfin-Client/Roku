' The stretch of a live stream that can be rewound
sub testLiveWindow()
    window = liveWindow.WindowFor(120)
    assertEqual(FormatJson(window), FormatJson({ start: 0, edge: 90 }), "The live point sits Roku's holdback short of the playlist's end")
    assertEqual(isValid(liveWindow.WindowFor(89)), false, "A stream keeping under a minute behind the live point has no window")
    assertEqual(isValid(liveWindow.WindowFor(90)), true, "and gets one at a minute")
    assertEqual(isValid(liveWindow.WindowFor(-1)), false, "A stream with no duration has none")

    window = { start: 0, edge: 100 }
    assertEqual(liveWindow.Behind(window, 70), 30, "Behind counts back from the live point")
    assertEqual(liveWindow.Behind(window, 120), 0, "and past it there's nothing behind")
    assertEqual(liveWindow.Progress(window, 50), 0.5, "The bar runs from the window's start to the live point")
    assertEqual(liveWindow.Progress(window, 130), 1, "and stops at the live point")
end sub

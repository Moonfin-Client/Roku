sub testTmdbThumbs()
    savedGlobal = m.global

    ' Sign in and the Settings connection test share one builder, so neither drops a flag
    full = moonfinPlugin.InfoFromPing({
        version: "2.5.0",
        settingsSyncEnabled: true,
        mdblistAvailable: true,
        tmdbAvailable: true,
        tmdbThumbsSupported: true,
        tmdbReviewsSupported: true,
        seerrEnabled: true,
        messagesSupported: true,
        clientLogSupported: true,
        recommendationsSupported: true,
        defaultSettings: { theme: "neon" }
    }, "Jellyseerr")
    assertEqual(full.installed, true, "A ping answer means the plugin is installed")
    assertEqual(full.version, "2.5.0", "The plugin version is kept")
    for each flag in ["settingsSyncEnabled", "mdblistAvailable", "tmdbAvailable", "tmdbThumbsSupported", "tmdbReviewsSupported", "seerrEnabled", "messagesSupported", "clientLogSupported", "recommendationsSupported"]
        assertEqual(full[flag], true, "The plugin record keeps " + flag)
    end for
    assertEqual(full.seerrDisplayName, "Jellyseerr", "The Seerr name rides along when Seerr is on")
    assertEqual(full.defaultSettings.theme, "neon", "The admin defaults are kept")

    older = moonfinPlugin.InfoFromPing({ tmdbAvailable: true })
    assertEqual(older.tmdbThumbsSupported, false, "An older plugin reads as having no thumbs")
    assertEqual(older.recommendationsSupported, false, "An older plugin reads as having no recommendations")
    assertEqual(older.tmdbReviewsSupported, false, "An older plugin is never asked for reviews")
    assertEqual(older.version, "unknown", "A missing version reads as unknown")
    assertEqual(older.DoesExist("seerrDisplayName"), false, "No Seerr name without Seerr")
    assertEqual(moonfinPlugin.InfoFromPing(invalid).installed, false, "No answer means no plugin")
    assertEqual(moonfinPlugin.InfoFromPing(invalid).count(), 1, "No answer carries no flags")

    m.global = {
        session: {
            server: { url: "https://jellyfin.test", serverType: "jellyfin" },
            user: { id: "jf-user", settings: { "plugin.enabled": "true" } },
            pluginInfo: full
        }
    }

    url = moonfinPlugin.TmdbThumbURL("movie", 603)
    assertEqual(url.Left(41), "https://jellyfin.test/Moonfin/Tmdb/Thumb?", "Thumbs come from the plugin on the active server")
    assertEqual(url.Instr("type=movie") > 0, true, "A movie thumb asks for a movie")
    assertEqual(url.Instr("tmdbId=603") > 0, true, "A numeric TMDB id is sent as it reads")
    assertEqual(url.Instr("ApiKey=jf-art-token") > 0, true, "Jellyfin thumbs carry the token as ApiKey")
    assertEqual(url.Instr("api_key"), -1, "Jellyfin thumbs leave the legacy token name out")
    assertEqual(url.Instr("imdbId"), -1, "A TMDB id leaves the IMDb id out")

    url = moonfinPlugin.TmdbThumbURL("tv", "", "tt0903747")
    assertEqual(url.Instr("type=tv") > 0, true, "A show thumb asks for tv")
    assertEqual(url.Instr("imdbId=tt0903747") > 0, true, "The IMDb id stands in when there is no TMDB id")
    assertEqual(url.Instr("tmdbId"), -1, "An empty TMDB id isnt sent")

    url = moonfinPlugin.TmdbThumbURL("movie", "603", "tt0133093")
    assertEqual(url.Instr("tmdbId=603") > 0 and url.Instr("imdbId") = -1, true, "The TMDB id wins over the IMDb id")
    assertEqual(url.Instr("scheme="), -1, "An https server lets the plugin redirect to https")

    m.global.session.server = { url: "http://jellyfin.test", serverType: "jellyfin" }
    url = moonfinPlugin.TmdbThumbURL("movie", 603)
    assertEqual(url.Instr("scheme=http") > 0, true, "A plain http server asks for the http TMDB address")
    m.global.session.server = { url: "https://jellyfin.test", serverType: "jellyfin" }

    assertEqual(moonfinPlugin.TmdbThumbURL("person", 603), "", "Only movies and shows have thumbs")
    assertEqual(moonfinPlugin.TmdbThumbURL("Series", 603), "", "A library type isnt a TMDB media type")
    assertEqual(moonfinPlugin.TmdbThumbURL(invalid, 603), "", "No media type means no thumb")
    assertEqual(moonfinPlugin.TmdbThumbURL("movie", "", ""), "", "No id means no thumb")
    assertEqual(moonfinPlugin.TmdbThumbURL("movie", invalid, invalid), "", "Missing ids mean no thumb")

    assertEqual(moonfinPlugin.StudioImageURL(25), "https://jellyfin.test/Moonfin/Tmdb/StudioImage/25?ApiKey=jf-art-token", "Jellyfin studio logos carry the token")
    assertEqual(moonfinPlugin.StudioImageURL(invalid), "", "No company means no logo")

    m.global.session.pluginInfo = older
    assertEqual(moonfinPlugin.AreTmdbThumbsAvailable(), false, "An older plugin hands out no thumbs")
    assertEqual(moonfinPlugin.TmdbThumbURL("movie", 603), "", "An older plugin leaves the plain backdrop")
    m.global.session.pluginInfo = moonfinPlugin.InfoFromPing({ tmdbAvailable: false, tmdbThumbsSupported: true })
    assertEqual(moonfinPlugin.TmdbThumbURL("movie", 603), "", "A plugin without a TMDB key hands out no thumbs")
    m.global.session.pluginInfo = full
    m.global.session.user.settings["plugin.enabled"] = "false"
    assertEqual(moonfinPlugin.TmdbThumbURL("movie", 603), "", "Turning the plugin off turns the thumbs off")
    m.global.session.user.settings["plugin.enabled"] = "true"
    assertEqual(moonfinPlugin.AreTmdbThumbsAvailable(), true, "A current plugin with TMDB hands out thumbs")

    m.global.session.server = { url: "https://emby.test/emby", serverType: "emby" }
    m.global.session.user.id = "emby-user"
    url = moonfinPlugin.TmdbThumbURL("movie", 603)
    assertEqual(url.Left(42), "https://emby.test/emby/Moonfin/Tmdb/Thumb?", "Emby thumbs keep the server's base path")
    assertEqual(url.Instr("api_key=emby-art-token") > 0, true, "Emby thumbs carry the token as api_key")
    assertEqual(url.Instr("ApiKey"), -1, "Emby thumbs dont send ApiKey")
    assertEqual(moonfinPlugin.StudioImageURL(25).Instr("api_key=emby-art-token") > 0, true, "Emby studio logos carry the token as api_key")

    m.global = savedGlobal
end sub

' The launch cache for Home rows: file names and which saved rows are still usable
sub testHomeCache()
    longText = "0123456789"
    for i = 1 to 4
        longText = longText + longText
    end for
    assertEqual(homeCache.SafeName("a/b:c.d e"), "a_b_c_d_e", "SafeName turns slashes, colons, dots and spaces into underscores")
    assertEqual(homeCache.SafeName("Abc123"), "Abc123", "SafeName keeps letters and digits as they are")
    assertEqual(Len(homeCache.SafeName(longText)), 80, "SafeName cuts a long name to 80 characters")

    serverA = homeCache.Dir("http://a.test:8096", "user1")
    serverB = homeCache.Dir("http://b.test:8096", "user1")
    userTwo = homeCache.Dir("http://a.test:8096", "user2")
    assertEqual(serverA = serverB, false, "Two servers never share a row folder")
    assertEqual(serverA = userTwo, false, "Two users on one server never share a row folder")
    assertEqual(homeCache.Dir("HTTP://A.test:8096", "user1"), serverA, "The server address is compared without case")
    assertEqual(Left(serverA, Len(homeCache.ROOT) + 1), homeCache.ROOT + "/", "Row folders sit under the cache root")

    assertEqual(Left(homeCache.FileName("latest", "Movies"), 14), "latest_Movies_", "A row file is named by its id and title")
    assertEqual(Right(homeCache.FileName("latest", "Movies"), 5), ".json", "A row file is JSON")
    assertEqual(homeCache.FileName("latest", "Movies"), homeCache.FileName("latest", "Movies"), "The same row always gets the same file name")
    assertEqual(homeCache.FileName("latest", "Movies") = homeCache.FileName("latest", "Shows"), false, "A different title gets a different file")
    assertEqual(homeCache.FileName("latest", "Фильмы") = homeCache.FileName("latest", "Сериал"), false, "Titles in another script that make the same safe name still get separate files")
    assertEqual(homeCache.SafeKey(longText + "a") = homeCache.SafeKey(longText + "b"), false, "Long names that differ only past the cut still get separate files")
    assertEqual(Len(homeCache.SafeKey(longText + longText)) <= 52, true, "A key stays short however long the text")

    now = 1000000
    cacheRow = { dir: serverA, key: "layout-1", id: "latest", title: "Movies", order: 2 }
    good = homeCache.Record(cacheRow, [{ Id: "a" }], now)
    assertEqual(homeCache.IsFresh(good, "layout-1", now), true, "A row saved just now is fresh")
    assertEqual(homeCache.IsFresh(good, "layout-2", now), false, "A row saved for another layout is not used")
    assertEqual(homeCache.IsFresh(good, "layout-1", now + homeCache.MAX_AGE_SECONDS), true, "A row exactly three days old is still fresh")
    assertEqual(homeCache.IsFresh(good, "layout-1", now + homeCache.MAX_AGE_SECONDS + 1), false, "A row older than three days is stale")
    assertEqual(homeCache.IsFresh(good, "layout-1", now - 1), false, "A row saved in the future is rejected")

    emptyItems = homeCache.Record(cacheRow, [], now)
    assertEqual(homeCache.IsFresh(emptyItems, "layout-1", now), false, "A row with no items is not shown")
    noTitle = homeCache.Record({ dir: serverA, key: "layout-1", id: "latest", order: 2 }, [{ Id: "a" }], now)
    assertEqual(homeCache.IsFresh(noTitle, "layout-1", now), false, "A row without a title is rejected")
    assertEqual(homeCache.IsFresh(invalid, "layout-1", now), false, "Nothing at all is rejected")

    records = [
        { key: "k", order: 2, id: "a" },
        { key: "k", order: 1, id: "b" },
        { key: "k", order: 2, id: "c" },
        { key: "k", order: 1, id: "d" }
    ]
    sorted = homeCache.SortRecords(records)
    assertEqual(sorted[0].id, "b", "Rows sort by order, and the first of two equal orders stays first")
    assertEqual(sorted[1].id, "d", "The second of the order-1 rows follows it")
    assertEqual(sorted[2].id, "a", "Then the first order-2 row")
    assertEqual(sorted[3].id, "c", "and last the second order-2 row")
    assertEqual(records[0].id, "a", "Sorting leaves the array it was given alone")
end sub

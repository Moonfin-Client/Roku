sub testFriendsChat()
    assertEqual(achievementsModel.SameUserId("ca44e8df-5139-4da3-bc13-5461b9ec62d8", "CA44E8DF51394DA3BC135461B9EC62D8"), true, "User ids match with and without their dashes")
    assertEqual(achievementsModel.SameUserId("a", "b"), false, "Different ids dont")
    assertEqual(achievementsModel.SocialAvailable({ available: true, friendsEnabled: true }), true, "Friends are on where the plugin answered and left them on")
    assertEqual(achievementsModel.SocialAvailable({ available: true, friendsEnabled: false }), false, "The admin can switch them off")
    assertEqual(achievementsModel.SocialAvailable({ available: false, friendsEnabled: true }), false, "A server without the plugin has none")

    list = achievementsModel.ParseFriendsList({
        Friends: [{ UserId: "f1", UserName: "Ada", Online: true, NowPlaying: { Id: "m1", Name: "Heat" } }],
        Incoming: [{ UserId: "i1", UserName: "Bob" }],
        Outgoing: [{ UserId: "o1", UserName: "Cy" }],
        SimpleMode: false
    })
    assertEqual(list.friends[0].nowPlaying.name, "Heat", "A friend carries what they are watching")
    assertEqual(achievementsModel.IsFriend(list, "F1"), true, "A friend is found whatever the case of the id")
    assertEqual(achievementsModel.IsPending(list, "o1"), true, "A request either way is pending")
    assertEqual(achievementsModel.IsPending(list, "f1"), false, "A friend is not pending")
    assertEqual(achievementsModel.SocialBadgeCount({ friends: list, threads: [{ unreadCount: 2 }, { unreadCount: 1 }] }), 4, "The button counts requests waiting and unread messages")

    thread = achievementsModel.ParseThread({ conversationId: "c1", type: "group", otherUserName: "Crew", participants: [{ userId: "u1", userName: "Ada" }], lastMessage: "hi", lastFromMe: false, unreadCount: 2, hasAttachment: false })
    assertEqual(`${thread.conversationId} ${thread.isGroup} ${thread.name} ${thread.unreadCount}`, "c1 true Crew 2", "The camelCase chat payloads are read")
    assertEqual(achievementsModel.DisplayNameFor({ threads: [thread] }, "U1"), "Ada", "A group member is named from the chats")
    assertEqual(achievementsModel.ThreadIsPhoto(achievementsModel.ParseThread({ lastMessage: "[image]", hasAttachment: true })), true, "A photo with no words previews as a photo")

    group = achievementsModel.ParseConversation({ id: "c1", type: "group", title: "Crew", participantIds: ["u1", "u2"], createdByUserId: "u1", adminIds: ["u2"] })
    assertEqual(achievementsModel.IsGroupOwner(group, "u1"), true, "Whoever made the group owns it")
    assertEqual(achievementsModel.IsGroupAdmin(group, "u2"), true, "An admin can manage it")
    assertEqual(achievementsModel.IsGroupAdmin(group, "u3"), false, "Anyone else cant")
    assertEqual(achievementsModel.IsGroupMember(group, "U2"), true, "A member is found whatever the case of the id")

    assertEqual(achievementsModel.ParseMessage({ id: "m1", fromUserId: "u1", text: "hi", readBy: ["u1"] }).isRead, false, "A message only its sender read is unread")
    assertEqual(achievementsModel.ParseMessage({ id: "m1", fromUserId: "u1", text: "hi", readBy: ["u1", "u2"] }).isRead, true, "Anyone else reading it counts")
    assertEqual(achievementsModel.ParseMessage({ id: "m1", fromUserId: "u1", text: "hi", readAt: "2026-10-05T10:00:00Z" }).isRead, true, "So does a time it was read")

    before = achievementsModel.ParseThread({ conversationId: "c1", unreadCount: 1, lastAt: "2026-10-05T10:00:00Z" })
    grown = achievementsModel.ParseThread({ conversationId: "c1", unreadCount: 2, lastAt: "2026-10-05T10:01:00Z" })
    assertEqual(achievementsModel.ThreadHasNewFromOthers(grown, before, ""), true, "A chat that grew since the last read is new")
    assertEqual(achievementsModel.ThreadHasNewFromOthers(grown, grown, ""), false, "One that didnt isnt")
    assertEqual(achievementsModel.ThreadHasNewFromOthers(grown, before, "c1"), false, "The chat on screen is being read")
    assertEqual(achievementsModel.ThreadHasNewFromOthers(achievementsModel.ParseThread({ conversationId: "c1", unreadCount: 2, lastFromMe: true }), before, ""), false, "A message the user sent is no news to them")
    assertEqual(achievementsModel.ThreadHasNewFromOthers(achievementsModel.ParseThread({ conversationId: "c2", unreadCount: 1 }), invalid, ""), true, "A chat never seen before is new as a whole")

    privacy = achievementsModel.ParseSocialPrivacy({ AppearOffline: true })
    assertEqual(`${privacy.appearOffline} ${privacy.hideNowPlaying} ${privacy.messageNotifications}`, "true false true", "Message notifications are on unless the plugin says otherwise")
    privacy.messageNotifications = false
    saved = achievementsModel.ApplySocialPrivacy({ AppearOffline: false, EnableUnlockToasts: true }, privacy)
    assertEqual(FormatJson(saved), FormatJson({ AppearOffline: true, EnableUnlockToasts: true, HideNowPlaying: false, HideLastWatched: false, MessageNotifications: false }), "Privacy changes only the friend settings in the preferences")

    users = achievementsModel.ParseSocialUsers([{ Id: "f1", Name: "Ada" }, { Name: "No id" }, "junk"])
    assertEqual(users.count().toStr() + " " + users[0].userName, "1 Ada", "People without an id are left out")
end sub

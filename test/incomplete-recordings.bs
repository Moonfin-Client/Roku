' The Incomplete line a recording's details show, from the plugin's entry for it
sub testIncompleteRecordings()
    thursdayEvening = localIsoString("2026-10-29T20:00:00Z")

    entry = { recordedMinutes: 23, expectedMinutes: 37, state: "scheduled", scheduledStart: thursdayEvening }
    assertEqual(incompleteRecordings.DetailText(entry, false), "Incomplete · 23 of 37 min · Complete showing scheduled Thu 8:00 PM", "The line names the weekday and time of a scheduled complete showing")
    assertEqual(incompleteRecordings.DetailText(entry, true), "Incomplete · 23 of 37 min · Complete showing scheduled Thu 20:00", "The line follows the 24 hour clock")

    assertEqual(incompleteRecordings.DetailText({ recordedMinutes: 5, expectedMinutes: 60, state: "recorded", recordedAt: thursdayEvening }, false), "Incomplete · 5 of 60 min · Complete copy recorded Thu 8:00 PM", "The line says when a complete copy was recorded")
    assertEqual(incompleteRecordings.DetailText({ recordedMinutes: 5, expectedMinutes: 60, state: "notFound" }, false), "Incomplete · 5 of 60 min · No complete showing found", "The line says when no complete showing was found")

    assertEqual(incompleteRecordings.DetailText({ recordedMinutes: 22.6, expectedMinutes: "37", state: "scheduled" }, false), "Incomplete · 23 of 37 min", "A scheduled showing without a date leaves the status off, and the minutes round")
    assertEqual(incompleteRecordings.DetailText({ recordedMinutes: "x", expectedMinutes: 37, state: "recorded", recordedAt: "0001-01-01T00:00:00Z" }, false), "Incomplete · 0 of 37 min", "The year 1 date counts as missing and a malformed count reads as zero")
    assertEqual(incompleteRecordings.DetailText({ recordedMinutes: invalid, expectedMinutes: 37, state: invalid }, false), "Incomplete · 0 of 37 min", "An entry without a state or a count still reads")

    assertEqual(incompleteRecordings.DateSeconds(""), 0, "An empty date is missing")
    assertEqual(incompleteRecordings.DateSeconds(invalid), 0, "No date is missing")
    assertEqual(incompleteRecordings.ShowingTime(incompleteRecordings.DateSeconds(localIsoString("2026-10-29T00:05:00Z")), false), "Thu 12:05 AM", "Midnight reads as 12 on the 12 hour clock")
    assertEqual(incompleteRecordings.ShowingTime(incompleteRecordings.DateSeconds(localIsoString("2026-10-29T12:30:00Z")), false), "Thu 12:30 PM", "Noon reads as 12 PM")
    assertEqual(incompleteRecordings.ShowingTime(incompleteRecordings.DateSeconds(localIsoString("2026-10-29T09:00:00Z")), true), "Thu 09:00", "The 24 hour clock pads the hour")
end sub

' The UTC moment whose local wall clock reads what wallTime spells, the way a test on the device
' would see a showing that starts at that local time
function localIsoString(wallTime as string) as string
    wall = CreateObject("roDateTime")
    wall.FromISO8601String(wallTime)
    target = wall.AsSeconds()

    probe = CreateObject("roDateTime")
    probe.FromSeconds(target)
    probe.ToLocalTime()

    moment = CreateObject("roDateTime")
    moment.FromSeconds(target - (probe.AsSeconds() - target))
    return moment.ToISOString()
end function

' The Record prompt's rules for a program already airing
sub testRecordAiring()
    assertEqual(recordAiring.PromptChannel("16.1", "WPTODT"), "16.1 WPTODT", "A channel reads as its number and name")
    assertEqual(recordAiring.PromptChannel(invalid, " WPTODT "), "WPTODT", "A channel without a number reads as its name")
    assertEqual(recordAiring.PromptChannel("", invalid), "", "A channel with neither reads as nothing")
    assertEqual(recordAiring.PromptChannel(7, "KQED"), "7 KQED", "A numeric channel number still reads")

    assertEqual(recordAiring.DescriptionsDiffer("Same  Thing", "same thing"), false, "Descriptions that differ only in case and spacing match")
    assertEqual(recordAiring.DescriptionsDiffer("", "anything"), false, "A missing description proves nothing")
    assertEqual(recordAiring.DescriptionsDiffer("One plot", "Another plot"), true, "Different descriptions differ")

    now = liveTvGuide.ParseTime(localIsoString("2026-10-28T10:00:00Z"))
    assertEqual(recordAiring.LaterShowingWhen(liveTvGuide.ParseTime(localIsoString("2026-10-29T20:00:00Z")), now), "Tomorrow", "A showing the next day is Tomorrow")
    assertEqual(recordAiring.LaterShowingWhen(liveTvGuide.ParseTime(localIsoString("2026-10-31T20:00:00Z")), now), "Saturday", "A showing within the week is its weekday")
    assertEqual(recordAiring.LaterShowingWhen(liveTvGuide.ParseTime(localIsoString("2026-11-09T20:00:00Z")), now), "Nov 9", "A showing further out is its date")

    program = { Id: "p1", StartDate: "2026-10-29T20:00:00Z", ParentIndexNumber: 42, IndexNumber: 7 }
    started = liveTvGuide.ParseTime("2026-10-29T20:00:00Z")
    assertEqual(recordAiring.OffersCompleteShowing(program, started + 600, true), true, "A started episode can have a complete showing recorded later")
    assertEqual(recordAiring.OffersCompleteShowing(program, started + 60, true), false, "Pressing Record within a minute of the start counts as on time")
    assertEqual(recordAiring.OffersCompleteShowing(program, started + 600, false), false, "Only a viewer who may manage recordings is offered one")
    assertEqual(recordAiring.OffersCompleteShowing({ StartDate: "2026-10-29T20:00:00Z", IndexNumber: 7 }, started + 600, true), false, "Without season and episode numbers there is nothing to find the episode by")

    future = "2026-10-30T20:00:00Z"
    raw = { programId: "p9", name: "Jeopardy!", description: "Tournament of Champions", startDate: future, channelNumber: "16.1", channelName: "WPTODT", alreadyScheduled: true }
    options = recordAiring.Options({ canSearch: true, showing: raw }, started)
    assertEqual(options.canSearch, true, "The plugin can say it searches for complete showings")
    assertEqual(options.showing.start, liveTvGuide.ParseTime(future), "A future showing keeps its start")
    assertEqual(options.showing.alreadyScheduled, true, "A showing someone already set to record says so")
    assertEqual(options.showing.payload.programId, "p9", "The showing goes back to the plugin as it came")
    assertEqual(recordAiring.Options({ canSearch: "true", showing: invalid }, started).canSearch, false, "A flag that isnt a boolean isnt trusted")
    assertEqual(recordAiring.Options({ canSearch: true, showing: { programId: "p9", name: "Jeopardy!", description: "", startDate: future } }, started).showing.description, "", "A showing the plugin can search for may come without a description")
    assertEqual(recordAiring.Options({ canSearch: false, showing: { programId: "p9", name: "Jeopardy!", description: " ", startDate: future } }, started).showing, invalid, "A title only match needs a description to compare")
    assertEqual(recordAiring.Options({ showing: { programId: "p9", name: "Jeopardy!", description: "Plot", startDate: "2026-10-29T19:00:00Z" } }, started).showing, invalid, "A showing that already started is left out")
    assertEqual(recordAiring.Options({ showing: { programId: "p9", name: " ", description: "Plot", startDate: future } }, started).showing, invalid, "A showing without a name is left out")
    assertEqual(recordAiring.Options({ showing: { programId: "p9", name: "Jeopardy!", description: "Plot", startDate: future, channelName: 5 } }, started).showing, invalid, "A channel name that isnt text is left out")

    showing = { description: "Tournament of Champions" }
    assertEqual(recordAiring.IsCautious(invalid, false, "Anything"), false, "With no showing to confirm there is nothing to be careful about")
    assertEqual(recordAiring.IsCautious(showing, true, "Tournament of Champions"), false, "A matched episode with the same description isnt cautious")
    assertEqual(recordAiring.IsCautious(showing, false, "Tournament of Champions"), true, "A title and description match is cautious")
    assertEqual(recordAiring.IsCautious(showing, true, "Kids Week"), true, "A showing whose description differs is cautious")

    assertEqual(recordAiring.LaterOutcome("later", true), "laterShowingOnly", "Only the future showing was booked")
    assertEqual(recordAiring.LaterOutcome("later", false), "laterShowingOnlyFailed", "Nothing was recorded when the future showing couldnt be booked")
    assertEqual(recordAiring.LaterOutcome("both", true), "recordedWithLaterShowing", "Both were set")
    assertEqual(recordAiring.LaterOutcome("both", false), "recordedLaterShowingFailed", "The recording still runs when the future showing couldnt be booked")
    assertEqual(recordAiring.Message("cancelled"), "", "A cancel says nothing")
    assertEqual(recordAiring.Message("laterShowingOnlyFailed"), "Couldn't request the future showing, so nothing will be recorded.", "Each outcome has its toast")
end sub

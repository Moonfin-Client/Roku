sub testPlexTv()
    assertEqual(FormatJson(plexTv.AddressCandidates("192.168.50.45")), FormatJson(["http://192.168.50.45:32400", "http://192.168.50.45"]), "A typed address tries Plex's port first and plain http when no scheme was given")
    assertEqual(FormatJson(plexTv.AddressCandidates("192.168.50.45:32400")), FormatJson(["http://192.168.50.45:32400"]), "A typed port is the only address tried")
    assertEqual(FormatJson(plexTv.AddressCandidates("https://plex.example.com/")), FormatJson(["https://plex.example.com:32400", "https://plex.example.com"]), "A typed https address keeps its scheme")
    assertEqual(plexTv.AddressCandidates("  ").Count(), 0, "Nothing typed has nowhere to look")

    server = plexTv.ServerFromResource({
        "provides": "server",
        "name": "Home",
        "clientIdentifier": "m1",
        "productVersion": "1.43.4.10903-e5521bd8c",
        "accessToken": "srv",
        "connections": [
            { "uri": "https://relay.plex.direct:8443", "relay": true },
            { "uri": "https://45-1-2-3.plex.direct:32400", "local": false },
            { "uri": "https://192-168-1-5.plex.direct:32400", "local": true, "address": "192.168.1.5", "port": 32400 }
        ]
    })
    assertEqual(server.id, "m1", "The server is its machine id")
    assertEqual(server.version, "1.43.4.10903", "The version drops its build hash")
    assertEqual(server.accessToken, "srv", "The server keeps its own token")
    assertEqual(FormatJson(server.connections), FormatJson(["https://192-168-1-5.plex.direct:32400", "http://192.168.1.5:32400", "https://45-1-2-3.plex.direct:32400", "https://relay.plex.direct:8443"]), "Local first with its plain address, then remote, relay last")
    strict = plexTv.ServerFromResource({ "httpsRequired": true, "connections": [{ "uri": "https://192-168-1-5.plex.direct:32400", "local": true, "address": "192.168.1.5", "port": 32400 }] })
    assertEqual(strict.connections.Count(), 1, "A server that requires https gets no plain address")

    uris = ["local", "remote", "relay"]
    assertEqual(plexTv.Settled(uris, [invalid, true, true]), invalid, "A later answer waits on the better address ahead of it")
    assertEqual(plexTv.Settled(uris, [true, invalid, true]), "local", "The best address wins once it answers")
    assertEqual(plexTv.Settled(uris, [false, invalid, true]), invalid, "The remote address still gets its chance")
    assertEqual(plexTv.Settled(uris, [false, false, true]), "relay", "The relay wins once nothing ahead of it answers")
    assertEqual(plexTv.Settled(uris, [false, false, false]), "", "Nothing answering is no address")

    assertEqual(plexTv.MachineIdOf({ "MediaContainer": { "machineIdentifier": "m1" } }), "m1", "The identity answer names the server")
    assertEqual(plexTv.MachineIdOf("not json"), "", "Anything else names nothing")
end sub
